[["1",[["Καὶ",2,8],["τῇ",1,95],["Νωεμὶν",11584,0],["ἀνὴρ",38,5],["γνώριμος",3255,16],["τῷ",1,110],["ἀνδρὶ",38,113],["αὐτῆς",3,83],["ὁ",1,4],["δὲ",14,12],["ἀνὴρ",38,5],["δυνατὸς",356,16],["ἰσχύϊ",181,2],["ἐκ",21,1],["τῆς",1,18],["συγγενείας",1312,19],["Ἐλιμέλεχ",11775,0],["καὶ",2,8],["ὄνομα",57,33],["αὐτῷ",3,49],["Βοόζ",814,105]],"And Noemin had [a friend] an acquaintance of her husband, and the man [was] a mighty man of the kindred of Elimelech, and his name [was] Booz."],["2",[["Καὶ",2,8],["εἶπε",18,3],["Ῥοὺθ",1949,105],["ἡ",1,11],["Μωαβίτις",1879,31],["πρὸς",15,1],["Νωεμὶν",11584,0],["πορεῦθω",49,555],["δὴ",193,12],["εἰς",8,1],["ἀγρὸν",252,7],["καὶ",2,8],["συνάξω",166,157],["ἐν",4,1],["τοῖς",1,138],["στάχυσι",1916,139],["κατόπισθεν",1728,17],["οὗ",120,17],["ἐὰν",45,8],["εὕρω",101,227],["χάριν",368,10],["ἐν",4,1],["ὀφθαλμοῖς",91,139],["αὐτοῦ",3,48],["εἶπε",18,3],["δὲ",14,12],["αὐτῇ",3,99],["πορεύου",49,249],["θύγατερ",97,356]],"And Ruth the Moabitess said to Noemin, Let me go now to the field, and I will glean among the ears behind the man with whomsoever I shall find favour: and she said to her, Go, daughter."],["3",[["Καὶ",2,8],["ἐπορεύθη",49,38],["καὶ",2,8],["ἐλθοῦσα",55,140],["συνέλεξεν",1148,3],["ἐν",4,1],["τῷ",1,110],["ἀγρῷ",252,113],["κατόπισθε",1728,17],["τῶν",1,76],["θεριζόντων",1509,164],["καὶ",2,8],["περιέπεσε",3110,3],["περιπτώματι",5941,53],["τῇ",1,95],["μερίδι",399,2],["τοῦ",1,30],["ἀγροῦ",252,21],["Βοὸζ",814,105],["τοῦ",1,30],["ἐκ",21,1],["τῆς",1,18],["συγγενείας",1312,19],["Ἐλιμέλεχ",11775,0]],"And she went; and came and gleaned in the field behind the reapers; and she happened by chance to come on a portion of the land of Booz, of the kindred of Elimelech."],["4",[["Καὶ",2,8],["ἰδοὺ",51,17],["Βοὸζ",814,105],["ἦλθεν",55,3],["ἐκ",21,1],["Βηθλεὲμ",1263,225],["καὶ",2,8],["εἶπε",18,3],["τοῖς",1,138],["θερίζουσι",1509,352],["Κύριος",7,5],["μεθʼ",29,1],["ὑμῶν",5,136],["καὶ",2,8],["εἶπον",18,141],["αὐτῷ",3,49],["εὐλογήσαι",149,216],["σε",5,161],["Κύριος",7,5]],"And, behold, Booz came from Bethleem, and said to the reapers, The Lord [be] with you: and they said to him, The Lord bless thee."],["5",[["Καὶ",2,8],["εἶπε",18,3],["Βοὸζ",814,105],["τῷ",1,52],["παιδαρίῳ",304,53],["αὐτοῦ",3,48],["τῷ",1,52],["ἐφεστῶτι",631,556],["ἐπὶ",9,1],["τοὺς",1,56],["θερίζοντας",1509,229],["τίνος",39,304],["ἡ",1,11],["νεᾶνις",1520,13],["αὕτη",16,101]],"And Booz said to his servant who was set over the reapers, Whose [is] this damsel?"],["6",[["Καὶ",2,8],["ἀπεκρίθη",234,38],["τὸ",1,32],["παιδάριον",304,33],["τὸ",1,32],["ἐφεστὸς",631,419],["ἐπὶ",9,1],["τοὺς",1,56],["θερίζοντας",1509,229],["καὶ",2,8],["εἶπεν",18,3],["ἡ",1,11],["παῖς",127,5],["ἡ",1,11],["Μωαβίτις",1879,31],["ἐστὶν",10,87],["ἡ",1,11],["ἀποστραφεῖσα",130,302],["μετὰ",29,1],["Νωεμὶν",11584,0],["ἐξ",21,1],["ἀγροῦ",252,21],["Μωάβ",11562,0]],"And his servant who was set over the reapers answered and said, It is the Moabitish damsel who returned with Noemin out of the land of Moab."],["7",[["Καὶ",2,8],["εἶπε",18,3],["συλλέξω",1148,157],["δὴ",193,12],["καὶ",2,8],["συνάξω",166,157],["ἐν",4,1],["τοῖς",1,91],["δράγμασιν",1956,92],["ὄπισθεν",1196,17],["τῶν",1,76],["θεριζόντων",1509,164],["καὶ",2,8],["ἦλθε",55,3],["καὶ",2,8],["ἔστη",78,3],["ἀπὸ",17,1],["πρωΐθεν",2951,17],["καὶ",2,8],["ἕως",42,8],["ἑσπέρας",488,19],["οὐ",12,17],["κατέπαυσεν",778,3],["ἐν",4,1],["τῷ",1,110],["ἀγρῷ",252,113],["μικρόν",367,29]],"And she said, I pray you, let me glean and gather among the sheaves after the reapers: and she came and stood from morning till evening, and rested not [even] a little in the field."],["8",[["Καὶ",2,8],["εἶπε",18,3],["Βοὸζ",814,105],["πρὸς",15,1],["Ῥοὺθ",1949,105],["οὐκ",12,17],["ἤκουσας",54,154],["θύγατερ",97,356],["μὴ",25,8],["πορευθῇς",49,278],["ἐν",4,1],["ἀγρῷ",252,113],["συλλέξαι",1148,100],["ἑτέρῳ",253,111],["καὶ",2,8],["σὺ",5,156],["οὐ",12,17],["πορεύσῃ",49,116],["ἐντεῦθεν",1458,17],["ὧδε",640,17],["κολλήθητι",1246,242],["μετὰ",29,1],["τῶν",1,44],["κορασίων",1552,45],["μου",6,48]],"And Booz said to Ruth, Hast thou not heard, [my] daughter? go not to glean in another field; and depart not thou hence, join thyself here with my damsels."],["9",[["Οἱ",1,128],["ὀφθαλμοί",91,51],["σου",5,146],["εἰς",8,1],["τὸν",1,6],["ἀγρὸν",252,7],["οὗ",120,17],["ἐὰν",45,8],["θερίζωσι",1509,265],["καὶ",2,8],["πορεύσῃ",49,116],["κατόπισθεν",1728,17],["αὐτῶν",3,41],["ἰδοὺ",51,17],["ἐνετειλάμην",143,152],["τοῖς",1,91],["παιδαρίοις",304,92],["τοῦ",1,30],["μὴ",25,8],["ἅψασθαί",465,103],["σου",5,146],["καὶ",2,8],["ὅτε",432,8],["διψήσεις",1161,159],["καὶ",2,8],["πορευθήσῃ",49,373],["εἰς",8,1],["τὰ",1,42],["σκεύη",182,43],["καὶ",2,8],["πίεσαι",212,116],["ὅθεν",1153,17],["ἐὰν",45,8],["ὑδρεύωνται",2553,391],["τὰ",1,42],["παιδάρια",304,43]],"[Let] thine eyes [be] on the field where [my men] shall reap, and thou shalt go after them: behold, I have charged the young men not to touch thee: and when thou shalt thirst, then thou shalt go to the vessels, and drink of that which the young men shall have drawn."],["10",[["Καὶ",2,8],["ἔπεσεν",154,3],["ἐπὶ",9,1],["πρόσωπον",47,33],["αὐτῆς",3,83],["καὶ",2,8],["προσεκύνησεν",298,3],["ἐπὶ",9,1],["τὴν",1,9],["γῆν",26,10],["καὶ",2,8],["εἶπε",18,3],["πρὸς",15,1],["αὐτὸν",3,82],["τί",39,119],["ὅτι",19,8],["εὗρον",101,141],["χάριν",368,10],["ἐν",4,1],["ὀφθαλμοῖς",91,139],["σου",5,146],["τοῦ",1,30],["ἐπιγνῶναί",431,100],["με",6,82],["καὶ",2,8],["ἐγώ",6,179],["εἰμι",10,149],["ξένη",1828,15]],"And she fell upon her face, and did reverence to the ground, and said to him, How is it that I have found grace in thine eyes, that thou shouldest take notice of me, whereas I am a stranger?"],["11",[["Καὶ",2,8],["ἀπεκρίθη",234,38],["Βοὸζ",814,105],["καὶ",2,8],["εἶπεν",18,3],["αὐτῇ",3,99],["ἀπαγγελίᾳ",8965,2],["ἀπηγγέλη",273,38],["μοι",6,99],["ὅσα",103,63],["πεποίηκας",23,172],["μετὰ",29,1],["τῆς",1,18],["πενθερᾶς",2475,19],["σου",5,146],["μετὰ",29,1],["τὸ",1,32],["ἀποθανεῖν",109,100],["τὸν",1,6],["ἄνδρα",38,7],["σου",5,146],["καὶ",2,8],["πῶς",441,12],["κατέλιπες",207,154],["τὸν",1,6],["πατέρα",44,7],["σου",5,146],["καὶ",2,8],["τὴν",1,9],["μητέρα",189,10],["σου",5,146],["καὶ",2,8],["τὴν",1,9],["γῆν",26,10],["γενέσεώς",959,19],["σου",5,146],["καὶ",2,8],["ἐπορεύθης",49,360],["πρὸς",15,1],["λαὸν",35,7],["ὃν",24,106],["οὐκ",12,17],["ᾔδεις",53,523],["ἐχθὲς",1288,17],["καὶ",2,8],["τρίτης",357,78]],"And Booz answered and said to her, It has fully been told me how thou hast dealt with thy mother-in-law after the death of thy husband; and how thou didst leave thy father and thy mother, and the land of thy birth, and camest to a people whom thou knewest not before."],["12",[["Ἀποτίσαι",1365,216],["Κύριος",7,5],["τὴν",1,9],["ἐργασίαν",1070,10],["σου",5,146],["γένοιτο",30,392],["ὁ",1,4],["μισθός",816,5],["σου",5,146],["πλήρης",490,16],["παρὰ",73,1],["Κυρίου",7,21],["Θεοῦ",20,21],["Ἰσραὴλ",27,105],["πρὸς",15,1],["ὃν",24,106],["ἦλθες",55,154],["πεποιθέναι",344,107],["ὑπὸ",122,1],["τὰς",1,39],["πτέρυγας",719,40],["αὐτοῦ",3,48]],"The Lord recompense thy work: may a full reward be given thee of the Lord God of Israel, to whom thou hast come to trust under his wings."],["13",[["Ἡ",1,11],["δὲ",14,12],["εἶπεν",18,3],["εὕροιμι",101,347],["χάριν",368,10],["ἐν",4,1],["ὀφθαλμοῖς",91,139],["σου",5,146],["κύριε",7,250],["ὅτι",19,8],["παρεκάλεσάς",434,154],["με",6,82],["καὶ",2,8],["ὅτι",19,8],["ἐλάλησας",50,154],["ἐπὶ",9,1],["καρδίαν",64,10],["τῆς",1,18],["δούλης",136,19],["σου",5,146],["καὶ",2,8],["ἰδοὺ",51,17],["ἐγὼ",6,158],["ἔσομαι",10,177],["ὡς",36,8],["μία",58,15],["τῶν",1,123],["παιδισκῶν",605,61],["σου",5,146]],"And she said, Let me find grace in thy sight, my lord, because thou hast comforted me, and because thou hast spoken kindly to thy handmaid, and behold, I shall be as one of thy servants."],["14",[["Καὶ",2,8],["εἶπεν",18,3],["αὐτῇ",3,99],["Βοὸζ",814,105],["ἤδη",916,17],["ὥρα",838,13],["τοῦ",1,30],["φαγεῖν",269,100],["πρόσελθε",529,198],["ὧδε",640,17],["καὶ",2,8],["φάγεσαι",147,116],["τῶν",1,76],["ἄρτων",197,77],["καὶ",2,8],["βά