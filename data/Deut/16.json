[["1",[["Φυλάξαι",127,100],["τὸν",1,6],["μῆνα",295,7],["τῶν",1,76],["νέων",513,163],["καὶ",2,8],["ποιήσεις",23,159],["τὸ",1,32],["πάσχα",1098,119],["Κυρίῳ",7,113],["τῷ",1,110],["Θεῷ",20,113],["σου",5,146],["ὅτι",19,8],["ἐν",4,1],["τῷ",1,110],["μηνὶ",295,113],["τῶν",1,76],["νέων",513,163],["ἐξῆλθες",84,154],["ἐξ",21,1],["Αἰγύπτου",93,19],["νυκτός",216,19]],"Observe the month of new [corn], and thou shalt sacrifice the passover to the Lord thy God; because in the month of new corn thou camest out of Egypt by night."],["2",[["Καὶ",2,8],["θύσεις",436,159],["τὸ",1,32],["πάσχα",1098,119],["Κυρίῳ",7,113],["τῷ",1,110],["Θεῷ",20,113],["σου",5,146],["πρόβατα",194,43],["καὶ",2,8],["βόας",408,31],["ἐν",4,1],["τῷ",1,110],["τόπῳ",99,113],["ᾧ",24,202],["ἐὰν",45,8],["ἐκλέξηται",418,236],["Κύριος",7,5],["ὁ",1,4],["Θεός",20,5],["σου",5,146],["αὐτὸν",3,82],["ἐπικληθῆναι",340,174],["τὸ",1,32],["ὄνομα",55,33],["αὐτοῦ",3,48],["ἐκεῖ",76,17]],"And thou shalt sacrifice the passover to the Lord thy God, sheep and oxen in the place which the Lord thy God shall choose to have his name called upon it."],["3",[["Οὐ",12,17],["φαγῇ",153,116],["ἐπʼ",9,1],["αὐτοῦ",3,48],["ζύμην",2723,10],["ἐπτὰ",1558,3],["ἡμέρας",28,19],["φαγῇ",153,116],["ἐπʼ",9,1],["αὐτοῦ",3,48],["ἄζυμα",941,74],["ἄρτον",197,7],["κακώσεως",2096,19],["ὅτι",19,8],["ἐν",4,1],["σπουδῇ",1388,2],["ἐξήλθετε",84,262],["ἐξ",21,1],["Αἰγύπτου",93,19],["ἵνα",101,8],["μνησθῆτε",231,494],["τὴν",1,9],["ἡμέραν",28,10],["τῆς",1,18],["ἐξοδίας",4096,19],["ὑμῶν",5,136],["ἐκ",21,1],["γῆς",26,19],["Αἰγύπτου",93,19],["πάσας",11,109],["τὰς",1,39],["ἡμέρας",28,19],["τῆς",1,18],["ζωῆς",212,19],["ὑμῶν",5,136]],"Thou shalt not eat leaven with it; seven days shalt thou eat unleavened [bread] with it, bread of affliction, because ye came forth out of Egypt in haste; that ye may remember the day of your coming forth out of the land of Egypt all the days of your life."],["4",[["Οὐκ",12,17],["ὀφθήσεται",111,125],["σοι",5,151],["ζύμη",2723,13],["ἐν",4,1],["πᾶσι",11