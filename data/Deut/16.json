5,146]],"And thou shalt rejoice in thy feast, thou, and thy son, and thy daughter, thy man-servant, and thy maid-servant, and the Levite, and the stranger, and the orphan, and the widow that is in thy cities."],["15",[["Ἑπτὰ",179,57],["ἡμέρας",28,19],["ἑορτάσεις",2067,159],["Κυρἱω",0,0],["τῷ",1,110],["Θεῷ",20,113],["σου",5,146],["ἐν",4,1],["τῷ",1,110],["τόπῳ",99,113],["ᾧ",24,202],["ἂν",82,12],["ἐκλέξηται",418,236],["Κύριος",7,5],["ὁ",1,4],["Θεός",20,5],["σου",5,146],["αὐτῷ",3,49],["ἐὰν",45,8],["δὲ",14,12],["εὐλογήσῃ",147,116],["σε",5,161],["Κύριος",7,5],["ὁ",1,4],["Θεός",20,5],["σου",5,146],["ἐν",4,1],["πᾶσι",11,90],["γεννήμασί",740,92],["σου",5,146],["καὶ",2,8],["ἐν",4,1],["πάντι",11,34],["ἔργῳ",104,53],["τῶν",1,123],["χειρῶν",37,61],["σου",5,146],["καὶ",2,8],["ἔσῃ",10,116],["εὐφραινόμενος",242,114]],"Seven days shalt thou keep a feast to the Lord thy God in the place which the Lord thy God shall choose for himself; and if the Lord thy God shall bless thee in all thy fruits, and in every work of thy hands, then thou shalt rejoice."],["16",[["Τρεῖς",173,58],["καιροὺς",132,31],["τοῦ",1,30],["ἐνιαυτοῦ",397,21],["ὀφθήσεται",111,125],["πᾶν",11,29],["ἀρσενικόν",851,29],["σου",5,146],["ἐναντίον",138,17],["Κυρίου",7,21],["τοῦ",1,30],["Θεοῦ",20,21],["σου",5,146],["ἐν",4,1],["τῷ",1,110],["τόπῳ",99,113],["ᾧ",24,202],["ἐὰν",45,8],["ἐκλέξηται",418,236],["αὐτὸν",3,82],["Κύριος",7,5],["ἐν",4,1],["τῇ",1,95],["ἑορτῇ",485,2],["τῶν",1,76],["ἀζύμων",941,163],["καὶ",2,8],["ἐν",4,1],["τῇ",1,95],["ἑορτῇ",485,2],["τῶν",1,123],["ἑβδομάδων",1607,61],["καὶ",2,8],["ἐν",4,1],["τῇ",1,95],["ἑορτῇ",485,2],["τῆς",1,18],["σκηνοπηγίας",2967,19],["οὐκ",12,17],["ὀφθήσῃ",111,379],["ἐνώπιον",114,1],["Κυρίου",7,21],["τοῦ",1,30],["Θεοῦ",20,21],["σου",5,146],["κενός",779,16]],"Three times in the year shall all thy males appear before the Lord thy God in the place which the Lord shall choose in the feast of unleavened bread, and in the feast of weeks, and in the feast of tabernacles: thou shalt not appear before the Lord thy God empty."],["17",[["Ἕκαστος",170,16],["κατὰ",32,1],["δύναμιν",98,10],["τῶν",1,123],["χειρῶν",37,61],["ὑμῶν",5,136],["κατὰ",32,1],["τὴν",1,9],["εὐλογίαν",576,10],["Κυρίου",7,21],["τοῦ",1,30],["Θεοῦ",20,21],["σου",5,146],["ἣν",24,124],["ἔδωκέ",33,3],["σοι",5,151]],"Each one according to his ability, according to the blessing of the Lord thy God which he has given thee."],["18",[["Κριτὰς",747,31],["καὶ",2,8],["γραμματοεισαγωγεῖς",0,0],["ποιήσεις",23,159],["σεαυτῷ",293,49],["ἐν",4,1],["ταῖς",1,70],["πόλεσί",41,71],["σου",5,146],["αἷς",24,282],["Κύριος",7,5],["ὁ",1,4],["Θεός",20,5],["σου",5,146],["δίδωσί",33,87],["σοι",5,151],["κατὰ",32,1],["φυλάς",142,40],["καὶ",2,8],["κρινοῦσι",240,207],["τὸν",1,6],["λαὸν",35,7],["κρίσιν",226,10],["δικαίαν",152,37]],"Thou shalt make for thyself judges and officers in thy cities, which the Lord thy God gives thee in [thy] tribes, and they shall judge the people with righteous judgment:"],["19",[["Οὐκ",12,17],["ἐκκλινοῦσι",393,207],["κρίσιν",226,10],["οὐδὲ",105,12],["λήψονται",46,127],["δῶρον",347,20],["τὰ",1,42],["γὰρ",40,12],["δῶρα",347,43],["ἀποτυφλοῖ",5258,87],["ὀφθαλμοὺς",91,31],["σοφῶν",322,163],["καὶ",2,8],["ἐξαίρει",339,87],["λόγους",48,31],["δικαίων",152,163]],"they shall not wrest judgment, nor favour persons, nor receive a gift; for gifts blind the eyes of the wise, and pervert the words of the righteous."],["20",[["Δικαίως",2355,17],["τὸ",1,32],["δίκαιον",152,29],["διώξῃ",530,116],["ἵνα",101,8],["ζῆτε",117,84],["καὶ",2,8],["εἰσελθόντες",88,188],["κληρονομήσητε",368,118],["τὴν",1,9],["γῆν",26,10],["ἣν",24,124],["Κύριος",7,5],["ὁ",1,4],["Θεός",20,5],["σου",5,146],["δίδωσί",33,87],["σοι",5,151]],"Thou shalt justly pursue justice, that ye may live, and go in and inherit the land which the Lord thy God gives thee."],["21",[["Οὐ",12,17],["φυτεύσεις",1066,159],["σεαυτῷ",293,49],["ἄλσος",1127,20],["πᾶν",11,28],["ξύλον",196,20],["παρὰ",72,1],["τὸ",1,27],["θυσιαστήριον",133,20],["τοῦ",1,30],["Θεοῦ",20,21],["σου",5,146],["οὐ",12,17],["ποιήσεις",23,159],["σεαυτῷ",293,49]],"Thou shalt not plant for thyself a grove; thou shalt not plant for thyself any tree near the altar of thy God."],["22",[["Οὐ",12,17],["στήσεις",78,159],["σεαυτῷ",293,49],["στήλην",1065,10],["ἃ",1,11],["ἐμίσησε",355,3],["Κύριος",7,5],["ὁ",1,4],["Θεός",20,5],["σου",5,146]],"Thou shalt not set up for thyself a pillar, which the Lord thy God hates."]]