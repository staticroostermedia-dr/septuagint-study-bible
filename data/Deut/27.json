[["1",[["Καὶ",2,8],["προσέταξε",791,3],["Μωυσῆς",69,5],["καὶ",2,8],["ἡ",1,11],["γερουσία",1266,13],["Ἰσραὴλ",27,105],["λέγων",31,67],["φυλάσσεσθε",125,382],["πάσας",11,109],["τὰς",1,39],["ἐντολάς",259,40],["ταύτας",16,280],["ὅσας",103,40],["ἐγὼ",6,158],["ἐντέλλομαι",143,251],["ὑμῖν",5,86],["σήμερον",205,17]],"And Moses and the elders of Israel commanded, saying, Keep all these commands, all that I command you this day."],["2",[["Καὶ",2,8],["ἔσται",10,89],["ᾗ",24,102],["ἂν",83,12],["ἡμέρᾳ",28,2],["διαβῆτε",466,118],["τὸν",1,6],["Ἰορδάνην",303,7],["εἰς",8,1],["τὴν",1,9],["γῆν",26,10],["ἣν",24,124],["Κύριος",7,5],["ὁ",1,4],["Θεός",20,5],["σου",5,146],["δίδωσί",33,87],["σοι",5,151],["καὶ",2,8],["στήσεις",78,159],["σεαυτῷ",255,49],["λίθους",195,31],["μεγάλους",66,58],["καὶ",2,8],["κονιάσεις",4278,159],["αὐτοὺς",3,60],["κονίᾳ",3866,2]],"And it shall come to pass in the day when ye shall cross over Jordan into the land which the Lord thy God gives thee, that thou shalt set up for thyself great stones, and shalt plaster them with plaster."],["3",[["Καὶ",2,8],["γράψεις",186,159],["ἐπὶ",9,1],["τῶν",1,76],["λίθων",195,77],["τούτων",16,220],["πάντας",11,58],["τούς",1,56],["λόγους",48,31],["τοῦ",1,30],["νόμου",140,21],["τούτου",16,126],["ὠς",328,20],["ἂν",83,12],["διαβῆτε",466,118],["τὸν",1,6],["Ἰορδάνην",303,7],["ἡνίκα",543,17],["ἂν",83,12],["εἰσέλθητε",86,118],["εἰς",8,1],["τὴν",1,9],["γῆν",26,10],["ἣν",24,124],["Κύριος",7,5],["ὁ",1,4],["Θεὸς",20,5],["τῶν",1,76],["πατέρων",44,77],["σου",5,146],["δίδωσί",33,87],["σοι",5,151],["γῆν",26,10],["ῥέουσαν",667,73],["γάλα",1034,33],["καὶ",2,8],["μέλι",807,33],["ὃν",24,106],["τρόπον",245,7],["εἶπε",18,3],["Κύριος",7,5],["ὁ",1,4],["Θεὸς",20,5],["τῶν",1,76],["πατέρων",44,77],["σού",5,146],["σοί",5,151]],"And thou shalt write on these stones all the words of this law, as soon as ye have crossed Jordan, when ye are entered into the land, which the Lord God of thy fathers gives thee, a land flowing with milk and honey, according as the Lord God of thy fathers said to thee."],["4",[["Καὶ",2,8],["ἔσται",10,89],["ὡς",36,8],["ἂν",83,12],["διαβῆτε",466,118],["τὸν",1,6],["Ἰορδάνην",303,7],["στήσετε",78,348],["τοὺς",1,56],["λίθους",195,31],["τούτους",16,274],["οὓς",24,294],["ἐγὼ",6,158],["ἐντέλλομαί",143,251],["σοι",5,151],["σήμερον",205,17],["ἐν",4,1],["ὄρει",87,53],["Γαιβάλ",11864,0],["καὶ",2,8],["κονιάσεις",4278,159],["αὐτοὺς",3,60],["κονίᾳ",3866,2]],"And it shall be as soon as ye are gone over Jordan, ye shall set up these stones, which I command thee this day, on mount Gæbal, and thou shalt plaster them with plaster."],["5",[["Καὶ",2,8],["οἰκοδομήσεις",126,159],["ἐκεῖ",76,17],["θυσιαστήριον",133,33],["Κυρίῳ",7,113],["τῷ",1,110],["Θεῷ",20,113],["σου",5,146],["θυσιαστήριον",133,33],["ἐκ",21,1],["λίθων",195,77],["οὐκ",12,17],["ἐπιβαλεῖς",724,159],["ἐπʼ",9,1],["αὐτὸ",3,121],["σίδηρον",794,7]],"And thou shalt build there an altar to the Lord thy God, an altar of stones; thou shalt not lift up iron upon it."],["6",[["λίθους",195,31],["ὁλοκλήρους",3221,58],["οἰκοδομήσεις",126,159],["θυσιαστήριον",133,33],["Κυρίῳ",7,113],["τῷ",1,110],["Θεῷ",20,113],["σου",5,146],["καὶ",2,8],["ἀνοίσεις",384,159],["ἐπʼ",9,1],["αὐτὸ",3,121],["ὁλοκαυτώματα",318,43],["Κυρίῳ",7,113],["τῷ",1,110],["Θεῷ",20,113],["σου",5,146]],"Of whole stones shalt thou build an altar to the Lord thy God, and thou shalt offer upon it whole-burnt-offerings to the Lord thy God."],["7",[["Καὶ",2,8],["θύσεις",437,159],["ἐκεῖ",76,17],["θυσίαν",156,10],["σωτηρίου",472,24],["καὶ",2,8],["φάγῃ",269,160],["καὶ",2,8],["ἐμπλησθήσῃ",427,373],["καὶ",2,8],["εὐφρανθήσῃ",244,373],["ἔναντι",232,17],["Κυρίου",7,21],["τοῦ",1,30],["Θεοῦ",20,21],["σου",5,146]],"And thou shalt there offer a peace-offering; and thou shalt eat and be filled, and rejoice before the Lord thy God."],["8",[["Καὶ",2,8],["γράψεις",186,159],["ἐπὶ",9,1],["τῶν",1,76],["λίθων",195,77],["πάντα",11,59],["τὸν",1,6],["νόμον",140,7],["τοῦτον",16,259],["σαφῶς",11516,0],["σφόδρα",150,17]],"And thou shalt write upon the stones all this law very plainly."],["9",[["Καὶ",2,8],["ἐλάλησε",50,3],["Μωυσῆς",69,5],["καὶ",2,8],["οἱ",1,128],["ἱερεῖς",65,31],["οἱ",1,128],["Λευῖται",188,51],["παντὶ",11,111],["Ἰσραὴλ",27,105],["λέγοντες",31,137],["σιώπα",1283,239],["καὶ",2,8],["ἄκουε",54,239],["Ἰσραήλ",27,105],["ἐν",4,1],["τῇ",1,95],["ἡμέρᾳ",28,2],["ταύτῃ",16,200],["γέγονας",30,172],["εἰς",8,1],["λαὸν",35,7],["Κυρίῳ",7,113],["τῷ",1,110],["Θεῷ",20,113],["σου",5,146]],"And Moses and the priests the Levites spoke to all Israel, saying, Be silent and hear, O Israel; this day thou art become a people to the Lord thy God."],["10",[["καὶ",2,8],["εἰσακούσῃ",241,116],["τῆς",1,18],["φωνῆς",95,19],["Κυρίου",7,21],["τοῦ",1,30],["Θεοῦ",20,21],["σου",5,146],["καὶ",2,8],["ποιήσεις",23,159],["πάσας",11,109],["τὰς",1,39],["ἐντολὰς",259,40],["αὐτοῦ",3,48],["καὶ",2,8],["τὰ",1,42],["δικαιώματα",428,43],["αὐτοῦ",3,48],["ὅσα",103,43],["ἐγὼ",6,158],["ἐντέλλομαί",143,251],["σοι",5,151],["σήμερον",205,17]],"And thou shalt hearken to the voice of the Lord thy God, and shalt do all his commands, and his ordinances, as many as I command thee this day."],["11",[["Καὶ",2,8],["ἐνετείλατο",143,26],["Μωυσῆς",69,5],["τῷ",1,110],["λαῷ",35,113],["ἐν",4,1],["τῇ",1,95],["ἡμέρᾳ",28,2],["ἐκείνῃ",80,99],["λέγων",31,67]],"And Moses charged the people on that day, saying,"],["12",[["οὗτοι",16,213],["στήσονται",78,127],["εὐλογεῖν",149,54],["τὸν",1,6],["λαὸν",35,7],["ἐν",4,1],["ὄρει",87,53],["Γαριζίν",12834,0],["διαβάντες",466,190],["τὸν",1,6],["Ἰορδάνην",303,7],["Συμεὼν",934,5],["Λευὶ",702,105],["Ἰουδας",62,105],["Ἰσσάχαρ",0,0],["Ἰωσὴφ",262,105],["καὶ",2,8],["Βενιαμίν",358,105]],"These shall stand to bless the people on mount Garizin having gone over Jordan; Symeon, Levi, Judas, Issachar, Joseph, and Benjamin."],["13",[["Καὶ",2,8],["οὗτοι",16,213],["στήσονται",78,127],["ἐπὶ",9,1],["τῆς",1,18],["κατάρας",1165,19],["ἐν",4,1],["ὄρει",87,53],["Γαιβάλ",11864,0],["Ῥουβὴν",616,105],["Γὰδ",668,105],["καὶ",2,8],["Ἀσὴρ",1067,105],["Ζαβουλὼν",1071,105],["Δὰν",11508,0],["καὶ",2,8],["Νεφθαλί",3032,356]],"And these shall stand for cursing on mount Gæbal; Ruben, Gad, and Aser, Zabulon, Dan, and Nephthali."],["14",[["Καὶ",2,8],["ἀποκριθέντες",234,243],["ἐροῦσιν",165,207],["οἱ",1,128],["Λευῖται",188,51],["παντὶ",11,111],["Ἰσραὴλ",27,105],["φωνῇ",95,2],["μεγάλῃ",66,96]],"And the Levites shall answer and say to all Israel with a loud voice,"],["15",[["ἐπικατάρατος",1069,16],["ἄνθρωπος",43,5],["ὅστις",457,246],["ποιήσει",23,120],["γλυπτὸν",948,28],["καὶ",2,8],["χωνευτὸν",1792,28],["βδέλυγμα",476,20],["Κυρίῳ",7,113],["ἔργον",105,20],["χειρῶν",37,61],["τεχνιτῶν",2292,77],["καὶ",2,8],["θήσει",110,120],["αὐτὸ",3,121],["ἐν",4,1],["ἀποκρύφῳ",1697,111],["καὶ",2,8],["ἀποκριθεὶς",234,206],["πᾶς",11,16],["ὁ",1,4],["λαὸς",35,5],["ἐροῦσι",165,207],["γένοιτο",30,392]],"Cursed [is] the man whosoever shall make a graven or molten image, an abomination to the Lord, the work of the hands of craftsmen, and shall put it in a secret place: and all the people shall answer and say, So be it."],["16",[["Ἐπικατάρατος",1069,16],["ὁ",1,4],["ἀτιμάζων",1400,67],["πατέρα",44,7],["αὐτοῦ",3,48],["ἢ",61,8],["μητέρα",189,10],["αὐτοῦ",3,48],["καὶ",2,8],["ἐροῦσι",165,207],["πᾶς",11,16],["ὁ",1,4],["λαὸς",35,5],["γένοτιο",0,0]],"Cursed is the man that dishonours his father or his mother: and all the people shall say, So be it."],["17",[["Ἐπικατάρατος",1069,16],["ὁ",1,4],["μετατιθεὶς",2027,67],["ὅρια",236,43],["τοῦ",1,30],["πλησὶον",292,17],["καὶ",2,8],["ἐροῦσι",165,207],["πᾶς",11,16],["ὁ",1,4],["λαός",35,5],["γένοιτο",30,392]],"Cursed is he that removes his neighbour's landmarks: and all the people shall say, So be it."],["18",[["Ἐπικατάρατος",1069,16],["ὁ",1,4],["πλανῶν",464,67],["τυφλὸν",1600,59],["ἐν",4,1],["ὁδῷ",68,2],["καὶ",2,8],["ἐροῦσι",165,207],["πᾶς",11,16],["ὁ",1,4],["λαός",35,5],["γένοιτο",30,392]],"Cursed is he that makes the blind to wander in the way: and all the people shall say, So be it."],["19",[["Ἐπικατάρατος",1069,16],["ὃς",24,246],["ἂν",83,12],["ἐκκλίνῃ",394,166],["κρίσιν",229,10],["προσηλύτου",634,21],["καὶ",2,8],["ὀρφανοῦ",957,153],["καὶ",2,8],["χήρας",751,40],["καὶ",2,8],["ἐροῦσι",165,207],["πᾶς",11,16],["ὁ",1,4],["λαός",35,5],["γένοιτο",30,392]],"Cursed is every one that shall pervert the judgment of the stranger, and orphan, and widow: and all the people shall say, So be it."],["20",[["Ἐπικατάρατος",1069,16],["ὁ",1,4],["κοιμώμενος",301,114],["μετὰ",29,1],["γυναικὸς",59,19],["τοῦ",1,30],["πατρὸς",44,21],["αὐτοῦ",3,48],["ὅτι",19,8],["ἀπεκάλυψε",652,3],["συγκάλυμμα",6088,529],["τοῦ",1,30],["πατρὸς",44,21],["αὐτοῦ",3,48],["καὶ",2,8],["ἐροῦσι",165,207],["πᾶς",11,16],["ὁ",1,4],["λαὸς",35,5],["γένοιτο",30,392]],"Cursed is he that lies with his father's wife, because he has uncovered his father's skirt: and all the people shall say, So be it."],["21",[["Ἐπικατάρατος",1069,16],["ὁ",1,4],["κοιμώμενος",301,114],["μετὰ",29,1],["παντὸς",11,88],["κτήνους",223,24],["καὶ",2,8],["ἐροῦσι",165,207],["πᾶς",11,16],["ὁ",1,4],["λαὸς",35,5],["γένοιτο",30,392]],"Cursed is he that lies with any beast: and all the people shall say, So be it."],["22",[["Ἐπικατάρατος",1069,16],["ὁ",1,4],["κοιμώμενος",301,114],["μετὰ",29,1],["ἀδελφῆς",521,19],["ἐκ",21,1],["πατρὸς",44,21],["ἢ",61,8],["μητρὸς",189,19],["αὐτοῦ",3,48],["καὶ",2,8],["ἐροῦσι",165,207],["πᾶς",11,16],["ὁ",1,4],["λαός",35,5],["γένοιτο",30,392]],"Cursed is he that lies with his sister by his father or his mother: and all the people shall say, So be it."],["23",[["Ἐπικατάρατος",1069,16],["ὁ",1,4],["κοιμώμενος",301,114],["μετὰ",29,1],["νύμφης",1060,19],["αὐτοῦ",3,48],["καὶ",2,8],["ἐροῦσι",165,207],["πᾶς",11,16],["ὁ",1,4],["λαός",35,5],["γένοιτο",30,392],["ἐπικατάρατος",1069,16],["ὁ",1,4],["κοιμώμενος",301,114],["μετὰ",29,1],["τῆς",1,18],["ἀδελφῆς",521,19],["τῆς",1,18],["γυναικὸς",59,19],["αὐτοῦ",3,48],["καὶ",2,8],["ἐροῦσι",165,207],["πᾶς",11,16],["ὁ",1,4],["λαὸς",35,5],["γένοιτο",30,392]],"Cursed is he that lies with his daughter-in-law: and all the people shall say, So be it. Cursed is he that lies with his wife's sister: and all the people shall say, So be it."],["24",[["Ἐπικατάρατος",1069,16],["ὁ",1,4],["τύπτων",1209,67],["τὸν",1,6],["πλησίον",292,17],["δόλῳ",919,113],["καὶ",2,8],["ἐροῦσι",165,207],["πᾶς",11,16],["ὁ",1,4],["λαός",35,5],["γένοιτο",30,392]],"Cursed is he that smites his neighbour secretly: and all the people shall say, So be it."],["25",[["Ἐπικατάρατος",1069,16],["ὃς",24,246],["ἂν",83,12],["λάβῃ",46,160],["δῶρα",348,43],["πατάξαι",145,100],["ψυχὴν",63,10],["αἵματος",148,24],["ἀθῴου",1079,88],["καὶ",2,8],["ἐροῦσι",165,207],["πᾶς",11,16],["ὁ",1,4],["λαὸς",35,5],["γένοιτο",30,392]],"Cursed is he whosoever shall have taken a bribe to slay an innocent man: and all the people shall say, So be it."],["26",[["Ἐπικατάρατος",1069,16],["πᾶς",11,16],["ἄνθρωπος",43,5],["ὃς",24,246],["οὐκ",12,17],["ἐμμένει",1990,87],["ἐν",4,1],["πᾶσι",11,215],["τοῖς",1,138],["λόγοις",48,139],["τοῦ",1,30],["νόμου",140,21],["τούτου",16,126],["ποιῆσαι",23,100],["αὐτούς",3,60],["καὶ",2,8],["ἐροῦσι",165,207],["πᾶς",11,16],["ὁ",1,4],["λαὸς",35,5],["γένοιτο",30,392]],"Cursed is every man that continues not in all the words of this law to do them: and all the people shall say, So be it."]]