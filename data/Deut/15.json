[["1",[["Διʼ",54,1],["ἑπτὰ",179,57],["ἐτῶν",80,45],["ποιήσεις",23,159],["ἄφεσιν",987,10]],"Every seven years thou shalt make a release."],["2",[["Καὶ",2,8],["οὕτω",70,17],["τὸ",1,32],["πρόσταγμα",391,33],["τῆς",1,18],["ἀφέσεως",987,19],["ἀφήσεις",504,159],["πᾶν",11,29],["χρέος",4489,33],["ἴδιον",681,29],["ὃ",1,4],["ὀφείλει",2156,87],["σοι",5,151],["ὁ",1,4],["πλησίον",292,17],["καὶ",2,8],["τὸν",1,6],["ἀδελφόν",66,7],["σου",5,146],["οὐκ",12,17],["ἀπαιτήσεις",2322,159],["ἐπικέκληται",340,372],["γὰρ",40,12],["ἄφεσις",987,13],["Κυρίῳ",7,113],["τῷ",1,110],["Θεῷ",20,113],["σου",5,146]],"And this [is] the ordinance of the release: thou shalt remit every private debt which thy neighbour owes thee, and thou shalt not ask payment of it from thy brother; for it has been called a release to the Lord thy God."],["3",[["Τὸν",1,6],["ἀλλότριον",377,59],["ἀπαιτήσεις",2322,159],["ὅσα",102,63],["ἐὰν",45,8],["ἠ",10,297],["σοι",5,151],["παρʼ",72,1],["αὐτῷ",3,49],["τῷ",1,110],["δὲ",14,12],["ἀδελφῷ",66,113],["σου",5,146],["ἄφεσιν",987,10],["ποιήσεις",23,159],["τοῦ",1,23],["χρέους",4489,24],["σου",5,146]],"Of a stranger thou shalt ask again whatsoever he has of thine, but to thy brother thou shalt remit his debt to thee."],["4",[["Ὅτι",19,8],["οὐκ",12,17],["ἔσται",10,89],["ἐν",4,1],["σοὶ",5,151],["ἐνδεὴς",1656,16],["ὅτι",19,8],["εὐλογῶν",147,67],["εὐλογήσει",147,120],["σε",5,161],["Κύριος",7,5],["ὁ",1,4],["Θεός",20,5],["σου",5,146],["ἐν",4,1],["τῇ",1,95],["γῇ",26,2],["ᾗ",24,102],["Κύριος",7,5],["ὁ",1,4],["Θεός",20,5],["σου",5,146],["δίδωσί",33,87],["σοι",5,151],["ἐν",4,1],["κλήρῳ",405,113],["κατακληρονομεῖν",909,54],["σε",5,161],["αὐτήν",3,98]],"For [thus] there shall not be a poor person in the midst of thee, for the Lord thy God will surely bless thee in the land which the Lord thy God gives thee by inheritance, that thou shouldest inherit it."],["5",[["Ἐὰν",45,8],["δὲ",14,12],["ἀκοῇ",1045,2],["εἰσακούσητε",237,118],["τῆς",1,18],["φωνῆς",95,19],["Κυρίου",7,21],["τοῦ",1,30],["Θεοῦ",20,21],["ὑμῶν",5,136],["φυλάσσειν",127,54],["καὶ",2,8],["ποιεῖν",23,54],["πάσας",11,109],["τὰς",1,39],["ἐντολὰς",259,40],["ταύτας",16,281],["ὅσας",102,40],["ἐγὼ",6,158],["ἐντέλλομαί",143,252],["σοι",5,151],["σήμερον",205,17]],"And if ye shall indeed hearken to the voice of the Lord your God, to keep and do all these commandments, as many as I charge thee this day,"],["6",[["ὅτι",19,8],["Κύριος",7,5],["ὁ",1,4],["Θεός",20,5],["σου",5,146],["εὐλόγησέ",147,3],["σε",5,161],["ὃν",24,106],["τρόπον",243,7],["ἐλάλησέ",50,3],["σοι",5,151],["καὶ",2,8],["δανειεῖς",1671,159],["ἔθνεσι",59,92],["πολλοῖς",74,90],["σὺ",5,156],["δὲ",14,12],["οὐ",12,17],["δανειῇ",1671,116],["καὶ",2,8],["ἄρξεις",319,159],["ἐθνῶν",59,45],["πολλῶν",74,79],["σοῦ",5,146],["δὲ",14,12],["οὐκ",12,17],["ἄρξουσιν",319,207]],"(for the Lord thy God has blessed thee in the way of which he spoke to thee,) then thou shalt lend to many nations, but thou shalt not borrow; and thou shalt rule over many nations, but they shall not rule over thee."],["7",[["Ἐὰν",45,8],["δὲ",14,12],["γένηται",30,236],["ἐν",4,1],["σοὶ",5,151],["ἐνδεὴς",1656,16],["ἐκ",21,1],["τῶν",1,76],["ἀδελφῶν",66,77],["σου",5,146],["ἐν",4,1],["μιᾷ",57,96],["τῶν",1,123],["πόλεών",41,61],["σου",5,146],["ἐν",4,1],["τῇ",1,95],["γῇ",26,2],["ᾗ",24,102],["Κύριος",7,5],["ὁ",1,4],["Θεός",20,5],["σου",5,146],["δίδωσί",33,87],["σοι",5,151],["οὐκ",12,17],["ἀποστέρξεις",9116,159],["τὴν",1,9],["καρδίαν",63,10],["σου",5,146],["οὐδʼ",105,12],["οὐ",12,17],["μὴ",25,8],["συσφίγξεις",4440,159],["τὴν",1,9],["χεῖρά",37,10],["σου",5,146],["ἀπὸ",17,1],["τοῦ",1,30],["ἀδελφοῦ",66,21],["σου",5,146],["τοῦ",1,30],["ἐπιδεομένου",2540,425]],"And if there shall be in the midst of thee a poor [man] of thy brethren in one of thy cities in the land, which the Lord thy God gives thee, thou shalt not harden thine heart, neither shalt thou by any means close up thine hand from thy brother who is in want."],["8",[["Ἀνοίγων",820,67],["ἀνοίξεις",2228,40],["τὰς",1,39],["χεῖράς",37,40],["σου",5,146],["αὐτῷ",3,49],["καὶ",2,8],["δάνειον",4225,33],["δανειεῖς",1671,159],["αὐτῷ",3,49],["ὅσον",102,7],["ἐπιδέεται",2540,108],["καθότι",827,17],["ἐνδεεῖται",2843,89]],"Thou shalt surely open thine hands to him, and shalt lend to him as much as he wants according to his need."],["9",[["Πρόσεχε",557,239],["σεαυτῷ",293,49],["μὴ",25,8],["γένηται",30,236],["ῥῆμα",115,33],["κρυπτὸν",1824,29],["ἐν",4,1],["τῇ",1,95],["καρδίᾳ",63,2],["σου",5,146],["ἀνόμημα",2224,20],["λέγων",31,67],["Ἐγγίζει",452,87],["τὸ",1,32],["ἔτος",80,33],["τὸ",1,32],["ἕβδομον",460,29],["ἔτος",80,33],["τῆς",1,18],["ἀφέσεως",987,19],["καὶ",2,8],["πονηρεύσηται",1387,418],["ὁ",1,4],["ὀφθαλμός",91,5],["σου",5,146],["τῷ",1,110],["ἀδελφῷ",66,113],["σου",5,146],["τῷ",1,110],["ἐπιδεομένῳ",2540,240],["καὶ",2,8],["οὐ",12,17],["δώσεις",33,159],["αὐτῷ",3,49],["καὶ",2,8],["καταβοήσεται",3552,89],["κατὰ",32,1],["σοῦ",5,146],["πρὸς",15,1],["Κύριον",7,7],["καὶ",2,8],["ἔσται",10,89],["ἐν",4,1],["σοὶ",5,151],["ἁμαρτία",119,13],["μεγάλη",65,15]],"Take heed to thyself that there be not a secret thing in thine heart, an iniquity, saying, The seventh year, the year of release, draws nigh; and thine eye shall be evil to thy brother that is in want, and thou shalt not give to him, and he shall cry against thee to the Lord, and there shall be great sin in thee."],["10",[["Διδοὺς",33,67],["δώσεις",33,159],["αὐτῷ",3,49],["καὶ",2,8],["δάνειον",4225,33],["δανειεῖς",1671,159],["αὐτῷ",3,49],["ὅσον",102,7],["ἐπιδέεται",2540,108],["καθότι",827,17],["ἐνδεεῖται",2843,89],["καὶ",2,8],["οὐ",12,17],["λυπηθήσῃ",936,379],["τῇ",1,95],["καρδίᾳ",63,2],["σου",5,146],["διδόντος",33,143],["σου",5,146],["αὐτῷ",3,49],["ὅτι",19,8],["διὰ",54,1],["τὸ",1,32],["ῥῆμα",115,33],["τοῦτο",16,122],["εὐλογήσει",147,120],["σε",5,161],["Κύριος",7,5],["ὁ",1,4],["Θεός",20,5],["σου",5,146],["ἐν",4,1],["πᾶσιν",11,90],["τοῖς",1,91],["ἔργοις",104,92],["καὶ",2,8],["ἐν",4,1],["πᾶσι",11,215],["οὗ",120,17],["ἂν",82,12],["ἐπιβάλῃς",724,170],["τὴν",1,9],["χεῖρά",37,10],["σου",5,146]],"Thou shalt surely give to him, and thou shalt lend him as much as he wants, according as he is in need; and thou shalt not grudge in thine heart as thou givest to him, because on this account the Lord thy God will bless thee in all thy works, and in all things on which thou shalt lay thine hand."],["11",[["Οὐ",12,17],["γὰρ",40,12],["μὴ",25,8],["ἐκλίπῃ",321,160],["ἐνδεὴς",1656,16],["ἀπὸ",17,1],["τῆς",1,18],["γῆς",26,19],["σου",5,146],["διὰ",54,1],["τοῦτο",16,122],["ἐγώ",6,158],["σοι",5,151],["ἐντέλλομαι",143,252],["ποιεῖν",23,54],["τὸ",1,32],["ῥῆμα",115,33],["τοῦτο",16,122],["λέγων",31,67],["ἀνοίγων",820,67],["ἀνοίξεις",2228,40],["τὰς",1,39],["χεῖράς",37,40],["σου",5,146],["τῷ",1,110],["ἀδελφῷ",66,113],["σου",5,146],["τῷ",1,110],["πένητι",668,113],["καὶ",2,8],["τῷ",1,110],["ἐπιδεομένῳ",2540,240],["τῷ",1,110],["ἐπὶ",9,1],["τῆς",1,18],["γῆς",26,19],["σου",5,146]],"For the poor shall not fail off thy land, therefore I charge thee to do this thing, saying, Thou shalt surely open thine hands to thy poor brother, and to him that is distressed upon thy land."],["12",[["Ἐὰν",45,8],["δὲ",14,12],["πραθῇ",1350,337],["σοι",5,151],["ὁ",1,4],["ἀδελφός",66,5],["σου",5,146],["ὁ",1,4],["Ἑβραῖος",1090,5],["ἢ",60,8],["Ἐβραία",1090,13],["δουλεύσει",403,120],["σοι",5,151],["ἓξ",528,57],["ἔτη",80,43],["καὶ",2,8],["τῷ",1,110],["ἑβδόμῳ",460,111],["ἐξαποστελεῖς",217,159],["αὐτὸν",3,82],["ἐλεύθερον",1456,59],["ἀπὸ",17,1],["σοῦ",5,146]],"And if thy brother [or sister], a Hebrew man or a Hebrew woman, be sold to thee, he shall serve thee six years, and in the seventh year thou shalt send him out free from thee."],["13",[["Ὅταν",318,8],["δὲ",14,12],["ἐξαποστέλλῃς",217,170],["αὐτὸν",3,82],["ἐλεύθερον",1456,59],["ἀπὸ",17,1],["σοῦ",5,146],["οὐκ",12,17],["ἐξαποστελεῖς",217,159],["αὐτὸν",3,82],["κενόν",779,59]],"And when thou shalt send him out free from thee, thou shalt not send him out empty."],["14",[["Ἐφόδιον",9691,20],["ἐφοδιάσεις",9687,159],["αὐτὸν",3,82],["ἀπὸ",17,1],["τῶν",1,44],["προβάτων",194,45],["σου",5,146],["καὶ",2,8],["ἀπὸ",17,1],["τοῦ",1,30],["σίτου",660,21],["σου",5,146],["καὶ",2,8],["ἀπὸ",17,1],["τοῦ",1,30],["οἴνου",261,21],["σου",5,146],["καθὰ",518,17],["εὐλόγησέ",147,3],["σε",5,161],["Κύριος",7,5],["ὁ",1,4],["Θεός",20,5],["σου",5,146],["δώσεις",33,159],["αὐτῷ",3,49]],"Thou shalt give him provision for the way from thy flock, and from thy corn, and from thy wine; as the Lord thy God has blessed thee, thou shalt give to him."],["15",[["Καὶ",2,8],["μνησθήσῃ",231,379],["ὅτι",19,8],["οἰκέτης",952,5],["ἦσθα",10,216],["ἐν",4,1],["γῇ",26,2],["Αἰγύπτου",93,19],["καὶ",2,8],["ἐλυτρώσατό",548,26],["σε",5,161],["Κύριος",7,5],["ὁ",1,4],["Θεός",20,5],["σοῦ",5,146],["ἐκεῖθεν",428,17],["διὰ",54,1],["τοῦτο",16,122],["ἐγώ",6,158],["σοι",5,151],["ἐντέλλομαι",143,252],["ποιεῖν",23,54],["τὸ",1,32],["ῥῆμα",115,33],["τοῦτο",16,122]],"And thou shalt remember that thou wast a servant in the land of Egypt, and the Lord thy God redeemed thee from thence; therefore I charge thee to do this thing."],["16",[["Ἐὰν",45,8],["δὲ",14,12],["λέγῃ",31,172],["πρὸς",15,1],["σὲ",5,161],["οὐκ",12,17],["ἐξελεύσομαι",84,176],["ἀπὸ",17,1],["σοῦ",5,146],["ὅτι",19,8],["ἠγάπηκέ",0,0],["σε",5,161],["καὶ",2,8],["τὴν",1,9],["οἰκίαν",232,10],["σου",5,146],["ὅτι",19,8],["εὖ",975,17],["ἐστιν",10,87],["αὐτῷ",3,49],["παρὰ",72,1],["σοί",5,151]],"And if he should say to thee, I will not go out from thee, because he continues to love thee and thy house, because he is well with thee;"],["17",[["Καὶ",2,8],["λήψῃ",46,116],["τὸ",1,32],["ὀπήτιον",6655,33],["καὶ",2,8],["τρυπήσεις",4463,159],["τὸ",1,32],["ὠτίον",2342,33],["αὐτοῦ",3,48],["πρὸς",15,1],["τὴν",1,9],["θύραν",277,10],["καὶ",2,8],["ἔσται",10,89],["σοι",5,151],["οἰκέτης",952,5],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["καὶ",2,8],["τὴν",1,9],["παιδίσκην",601,10],["σου",5,146],["ὡσαύτως",1242,17],["ποιήσεις",23,159]],"then thou shalt take an awl, and bore his ear through to the door, and he shall be thy servant for ever; and in like manner shalt thou do to thy maid-servant."],["18",[["Οὐ",12,17],["σκληρὸν",833,28],["ἔσται",10,89],["ἐναντίον",138,17],["σου",5,146],["ἐξαποστελλομένων",217,534],["αὐτῶν",3,187],["ἐλευθέρων",1456,115],["ἀπὸ",17,1],["σου",5,146],["ὅτι",19,8],["ἐπέτειον",9649,59],["μισθὸν",814,7],["τοῦ",1,30],["μισθωτοῦ",1828,21],["ἐδούλευσέ",403,3],["σοι",5,151],["ἓξ",528,57],["ἔτη",80,43],["καὶ",2,8],["εὐλογήσει",147,120],["σε",5,161],["Κύριος",7,5],["ὁ",1,4],["Θεός",20,5],["σου",5,146],["ἐν",4,1],["πᾶσιν",11,215],["οἷς",24,295],["ἐὰν",45,8],["ποιῇς",23,199]],"It shall not seem hard to thee when they are sent out free from thee, because [thy servant] has served thee six years according to the annual hire of a hireling; so the Lord thy God shall bless thee in all things whatsoever thou mayest do."],["19",[["Πᾶν",11,29],["πρωτότοκον",444,29],["ὃ",1,4],["ἐὰν",45,8],["τεχθῇ",251,337],["ἐν",4,1],["ταῖς",1,70],["βουσί",408,139],["σου",5,146],["καὶ",2,8],["ἐν",4,1],["τοῖς",1,91],["προβάτοις",194,92],["σου",5,146],["τὰ",1,42],["ἀρσενικὰ",851,65],["ἁγιάσεις",358,159],["Κυρίῳ",7,113],["τῷ",1,110],["Θεῷ",20,113],["σου",5,146],["οὐκ",12,17],["ἐργᾷ",468,173],["ἐν",4,1],["τῷ",1,110],["πρωτοτόκῳ",444,111],["μόσχῳ",256,113],["σου",5,146],["καὶ",2,8],["οὐ",12,17],["μὴ",25,8],["κείρῃς",1730,170],["τὰ",1,42],["πρωτότοκα",444,65],["τῶν",1,44],["προβάτων",194,45],["σου",5,146]],"Every first-born that shall be born among thy kine and thy sheep, thou shalt sanctify the males to the Lord thy God; thou shalt not work with thy first-born calf, and thou shalt not shear the first-born of thy sheep."],["20",[["Ἔναντι",230,17],["Κυρίου",7,21],["φαγῇ",153,116],["αὐτὸ",3,121],["ἐνιαυτὸν",397,7],["ἐξ",21,1],["ἐνιαυτοῦ",397,21],["ἐν",4,1],["τῷ",1,110],["τόπῳ",99,113],["ᾧ",24,202],["ἐὰν",45,8],["ἐκλέξηται",418,236],["Κύριος",7,5],["ὁ",1,4],["Θεός",20,5],["σου",5,146],["σὺ",5,156],["καὶ",2,8],["ὁ",1,4],["οἶκός",34,5],["σου",5,146]],"Thou shalt eat it before the Lord year by year in the place which the Lord thy God shall choose, thou and thy house."],["21",[["Ἐὰν",45,8],["δὲ",14,12],["ἠ",10,297],["ἐν",4,1],["αὐτῷ",3,49],["μῶμος",1686,5],["χωλὸν",2407,59],["ἢ",60,8],["τυφλον",1601,59],["μῶμον",1686,7],["πονηρὸν",164,59],["οὐ",12,17],["θύσεις",436,159],["αὐτὸ",3,121],["Κυρίῳ",7,113],["τῷ",1,110],["Θεῷ",20,113],["σου",5,146]],"And if there be in it a blemish, if it be lame or blind, an evil blemish, thou shalt not sacrifice it to the Lord thy God."],["22",[["Ἐν",4,1],["ταῖς",1,70],["πόλεσί",41,71],["σου",5,146],["φαγῇ",153,116],["αὐτό",3,121],["ὁ",1,4],["ἀκάθαρτος",370,16],["ἐν",4,1],["σοι",5,151],["καὶ",2,8],["ὁ",1,4],["καθαρὸς",375,16],["ὡσαύτως",1242,17],["ἔδεται",153,89],["ὡς",36,8],["δορκάδα",2166,10],["ἢ",60,8],["ἔλαφον",1869,7]],"Thou shalt eat it in thy cities; the unclean in thee and the clean shall eat it in like manner, as the doe or the stag."],["23",[["Πλὴν",257,1],["αἷμα",148,33],["οὐ",12,17],["φἀγεσθε",0,0],["ἐπὶ",9,1],["τὴν",1,9],["γῆν",26,10],["ἐκχεεῖς",435,159],["αὐτὸ",3,121],["ὡς",36,8],["ὕδωρ",85,33]],"Only ye shall not eat the blood; thou shalt pour it out on the earth as water."]]