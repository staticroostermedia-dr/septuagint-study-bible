[["1",[["Υἱοί",13,51],["ἐστε",10,84],["Κυρίου",7,21],["τοῦ",1,30],["Θεοῦ",20,21],["ὑμῶν",5,136],["οὐκ",12,17],["ἐπιθήσετε",239,348],["φαλάκρωμα",2795,20],["ἀναμέσον",215,28],["τῶν",1,76],["ὀφθαλμῶν",91,77],["ὑμῶν",5,136],["ἐπὶ",9,1],["νεκρῷ",659,111]],"Ye are the children of the Lord your God: ye shall not make any baldness between your eyes for the dead."],["2",[["Ὅτι",19,8],["λαὸς",35,5],["ἅγιος",75,16],["εἶ",10,145],["Κυρίῳ",7,113],["τῷ",1,110],["Θεῷ",20,113],["σου",5,146],["καὶ",2,8],["σε",5,161],["ἐξελέξατο",420,26],["Κύριος",7,5],["ὁ",1,4],["Θεός",20,5],["σου",5,146],["γενέσθαι",30,103],["σε",5,161],["λαὸν",35,7],["αὐτῷ",3,49],["περιούσιον",3922,59],["ἀπὸ",17,1],["πάντων",11,79],["τῶν",1,44],["ἐθνῶν",60,45],["τῶν",1,44],["ἐπὶ",9,1],["προσώπου",47,24],["τῆς",1,18],["γῆς",26,19]],"For thou art a holy people to the Lord thy God, and the Lord thy God has chosen thee to be a peculiar people to himself of all the nations on the face of the earth."],["3",[["Οὐ",12,17],["φάγεσθε",147,117],["πᾶν",11,29],["βδέλυγμα",476,33]],"Ye shall not eat any abominable thing."],["4",[["Ταῦτα",16,248],["κτήνη",223,43],["ἃ",1,11],["φάγεσθε",147,117],["μόσχον",256,7],["ἐκ",21,1],["βοῶν",411,77],["καὶ",2,8],["ἀμνὸν",562,7],["ἐκ",21,1],["προβάτων",194,45],["καὶ",2,8],["χίμαρον",912,7],["ἐξ",21,1],["αἰγῶν",686,77]],"These [are] the beasts which ye shall eat; the calf of the herd, and lamb of the sheep, and kid of the goats;"],["5",[["ἔλαφον",1868,7],["καὶ",2,8],["δορκάδα",2157,10],["καὶ",2,8],["πύγαργον",8201,7],["ὄρυγα",9851,7],["καὶ",2,8],["καμηλοπάρδαλιν",7310,10]],"the stag, and doe, and pygarg, and wild goat, and camelopard."],["6",[["Πᾶν",11,29],["κτῆνος",223,33],["διχηλοῦν",2575,47],["ὁπλὴν",2001,10],["καὶ",2,8],["ὀνυχιστῆρας",3761,31],["ὀνυχίζον",0,0],["δύο",104,57],["χηλῶν",6203,61],["καὶ",2,8],["ἀνάγον",524,36],["μηρυκισμὸν",2602,7],["ἐν",4,1],["τοῖς",1,91],["κτήνεσι",223,92],["ταῦτα",16,248],["φάγεσθε",147,117]],"Every beast that divides the hoofs, and makes claws of two divis