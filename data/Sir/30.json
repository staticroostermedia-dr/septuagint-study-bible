[["1",[["Ὁ",1,4],["ἀγαπῶν",224,67],["τὸν",1,6],["υἱὸν",13,7],["αὐτοῦ",3,48],["ἐνδελεχήσει",6482,120],["μάστιγας",1308,40],["αὐτῷ",3,49],["ἵνα",101,8],["εὐφρανθῇ",242,337],["ἐπʼ",9,1],["ἐσχάτῳ",407,111],["αὐτοῦ",3,48]],"He that loveth his son causeth him oft to feel the rod, that he may have joy of him in the end."],["2",[["Ὁ",1,4],["παιδεύων",654,67],["τὸν",1,6],["υἱὸν",13,7],["αὐτοῦ",3,48],["ὀνήσεται",4665,89],["ἐπʼ",9,1],["αὐτῷ",3,49],["καὶ",2,8],["ἀναμέσον",211,28],["γνωρίμων",3260,115],["ἐπʼ",9,1],["αὐτῷ",3,49],["καυχήσεται",1379,399]],"He that chastiseth his son shall have joy in him, and shall rejoice of him among his acquaintance."],["3",[["Ὁ",1,4],["διδάσκων",543,67],["τὸν",1,6],["υἱὸν",13,7],["αὐτοῦ",3,48],["παραζηλώσει",3110,120],["τὸν",1,6],["ἐχθρὸν",135,7],["καὶ",2,8],["ἔναντι",230,17],["φίλων",334,163],["ἐπʼ",9,1],["αὐτῷ",3,49],["ἀγαλλιάσεται",737,89]],"He that teacheth his son grieveth the enemy: and before his friends he shall rejoice of him."],["4",[["Ἐτελεύτησεν",593,3],["αὐτοῦ",3,48],["ὁ",1,4],["πατὴρ",44,5],["καὶ",2,8],["ὡς",36,8],["οὐκ",12,17],["ἀπέθανεν",108,3],["ὅμοιον",651,28],["γὰρ",40,12],["αὐτῷ",3,49],["κατέλιπε",255,3],["μετʼ",29,1],["αὐτόν",3,82]],"Though his father die, yet he is as though he were not dead: for he hath left one behind him that is like himself."],["5",[["Ἐν",4,1],["τῇ",1,95],["ζωῇ",212,2],["αὐτοῦ",3,48],["εἶδε",276,3],["καὶ",2,8],["εὐφράνθη",242,38],["καὶ",2,8],["ἐν",4,1],["τῇ",1,95],["τελευτῇ",1564,2],["αὐτοῦ",3,48],["οὐκ",12,17],["ἐλυπήθη",936,38]],"While he lived, he saw and rejoiced in him: and when he died, he was not sorrowful."],["6",[["Ἐναντίον",138,17],["ἐχθρῶν",135,77],["κατέλιπεν",1037,3],["ἔκδικον",4648,28],["καὶ",2,8],["τοῖς",1,138],["φίλοις",334,215],["ἀνταποδιδόντα",661,292],["χάριν",366,10]],"He left behind him an avenger against his enemies, and one that shall requite kindness to his friends."],["7",[["Περιψύχων",8024,67],["υἱὸν",13,7],["καταδεσμεύσει",5715,120],["τραύματα",2132,43],["αὐτοῦ",3,48],["καὶ",2,8],["ἐπὶ",9,1],["πάσῃ",11,96],["βοῇ",364,87],["ταραχθήσεται",508,125],["σπλάγχνα",2203,43],["αὐτοῦ",3,48]],"He that maketh too much of his son shall bind up his wounds; and his bowels will be troubled at every cry."],["8",[["Ἵππος",308,5],["ἀδάμαστος",6258,16],["ἀποβαίνει",1799,87],["σκληρὸς",833,16],["καὶ",2,8],["υἱὸς",13,5],["ἀνειμένος",1082,228],["ἐκβαίνει",3006,87],["προαλής",8099,16]],"An horse not broken becometh headstrong: and a child left to himself will be wilful."],["9",[["Τιθήνησον",5129,243],["τέκνον",192,20],["καὶ",2,8],["ἐκθαμβήσει",9363,379],["σε",5,161],["σύμπαιζον",8427,129],["αὐτῷ",3,49],["καὶ",2,8],["λυπήσει",936,120],["σε",5,161]],"Cocker thy child, and he shall make thee afraid: play with him, and he will bring thee to heaviness."],["10",[["Μὴ",25,8],["συγγελάσῃς",8385,170],["αὐτῷ",3,49],["ἵνα",101,8],["μὴ",25,8],["συνοδυνηθῇς",8487,537],["καὶ",2,8],["ἐπʼ",9,1],["ἐσχάτῳ",407,111],["γομφιάσεις",5551,159],["τοὺς",1,56],["ὀδόντας",929,31],["σου",5,146]],"Laugh not with him, lest thou have sorrow with him, and lest thou gnash thy teeth in the end."],["11",[["Μὴ",25,8],["δῷς",33,170],["αὐτῷ",3,49],["ἐξουσίαν",928,10],["ἐν",4,1],["νεότητι",785,2]],"Give him not liberty in youth."],["12",[["Θλάσον",3541,171],["τὰς",1,39],["πλευρὰς",1328,40],["αὐτοῦ",3,48],["ὡς",36,8],["ἔστι",10,87],["νήπιος",1015,16],["μήποτε",966,17],["σκληρυνθεὶς",1283,206],["ἀπειθήσῃ",994,116],["σοι",5,151]],"Beat his sides while he is still young, lest becoming stubborn, he disobey thee."],["13",[["Παίδευσον",654,243],["τὸν",1,6],["υἱόν",13,7],["σου",5,146],["καὶ",2,8],["ἔργασαι",468,296],["ἐναὐτῷ",0,0],["ἵνα",101,8],["μὴ",25,8],["ἐν",4,1],["τῇ",1,95],["ἀσχημοσύνῃ",1083,2],["σου",5,146],["προσκόψῃ",2769,116]],"Train up thy son, and exercise him with work, lest by thy looseness thou stumble."],["13a",[["Καὶ",2,8],["μὴ",25,8],["παρίδῃς",2289,170],["τὰς",1,39],["ἀγνοίας",1855,40],["αὐτοῦ",3,48]],"And overlook not his ignorance."],["13b",[["Κάμψον",2028,171],["τὸν",1,6],["τράχηλον",690,7],["αὐτοῦ",3,48],["ἐν",4,1],["νεότητι",785,2],["ΠΕΡΙ",71,1],["ΥΓΙΕΙΑΣ",0,0]],"Bow down his neck in his youth."],["14",[["Κρείσσων",922,16],["πτωχὸς",496,5],["ὑγιὴς",2866,16],["καὶ",2,8],["ἰσχύων",180,61],["τῇ",1,95],["ἕξει",124,120],["ἢ",60,8],["πλούσιος",954,16],["μεμαστιγωμένος",0,0],["εἰς",8,1],["σῶμα",451,20],["αὐτοῦ",3,48]],"Better is the poor, being sound and strong of constitution, than a rich man that is afflicted in his body."],["15",[["Ὑγιεία",2692,13],["καὶ",2,8],["εὐεξία",7213,13],["βέλτιον",2018,29],["παντὸς",11,88],["χρυσίου",202,24],["καὶ",2,8],["σῶμα",451,20],["εὔρωστον",3847,28],["ἢ",60,8],["ὄλβος",9921,5],["ἀμέτρητος",3166,16]],"Health and good estate of body are above all gold, and a strong body above infinite wealth."],["16",[["Οὐκ",12,17],["ἔστι",10,87],["πλοῦτος",572,5],["βελτίων",2018,16],["ὑγιείας",2692,40],["σώματος",451,24],["καὶ",2,8],["οὐκ",12,17],["ἔστιν",10,87],["εὐφροσύνη",360,13],["ὑπὲρ",139,1],["χαρὰν",1124,10],["καρδίας",63,19]],"There is no riches above a sound body, and no joy above the joy of the heart."],["17",[["Κρείσσων",922,16],["θάνατος",169,5],["ὑπὲρ",139,1],["ζωὴν",212,10],["πικρὰν",1077,37],["ἢ",60,8],["ἀῤῥώστημα",4563,20],["ἔμμονον",4649,28]],"Death is better than a bitter life or continual sickness."],["18",[["Ἀγαθὰ",113,65],["ἐκκεχυμένα",435,404],["ἐπὶ",9,1],["στόματι",123,53],["κεκλεισμένῳ",1472,590],["θέματα",2911,63],["βρωμάτων",714,45],["παρακείμενα",2947,453],["ἐπὶ",9,1],["τάφῳ",865,113]],"Delicacies poured upon a mouth shut up are as messes of meat set upon a grave."],["19",[["Τί",39,119],["συμφέρει",2500,87],["κάρπωσις",3576,13],["εἰδώλῳ",626,53],["οὔτε",476,17],["γὰρ",40,12],["ἔδεται",153,89],["οὔτε",476,17],["μὴ",25,8],["ὀσφρανθῇ",0,0],["οὕτως",70,17],["ὁ",1,4],["ἐκδιωκόμενος",2234,114],["ὑπὸ",122,1],["Κυρίου",7,21]],"What good doeth the offering unto an idol? for neither can it eat nor smell: so is he that is persecuted of the Lord."],["20",[["Βλέπων",469,67],["ἐν",4,1],["ἐν",4,1],["ὀφθαλμοῖς",91,139],["καὶ",2,8],["στενάζων",1446,67],["ὥσπερ",221,17],["εὐνοῦχος",1165,5],["περιλαμβάνων",2484,67],["παρθένον",787,10],["καὶ",2,8],["στενάζων",1446,67]],"He seeth with his eyes and groaneth, as an eunuch that embraceth a virgin and sigheth."],["21",[["Μὴ",25,8],["δῷς",33,170],["εἰς",8,1],["λύπην",1076,10],["τὴν",1,9],["ψυχήν",62,10],["σου",5,146],["καὶ",2,8],["μὴ",25,8],["θλίψῃς",599,170],["σεαυτὸν",293,82],["ἐν",4,1],["βουλῇ",349,2],["σου",5,146]],"Give not over thy mind to heaviness, and afflict not thyself in thine own counsel."],["22",[["Εὐφροσύνη",360,13],["καρδίας",63,19],["ζωὴ",212,13],["ἀνθρώπου",43,21],["καὶ",2,8],["ἀγαλλίαμα",1794,20],["ἀνδρὸς",38,21],["μακροημέρευσις",4314,13]],"The gladness of the heart is the life of man, and the joyfulness of a man prolongeth his days."],["23",[["Ἀγάπα",224,239],["τὴν",1,9],["ψυχήν",62,10],["σου",5,146],["καὶ",2,8],["παρακάλει",432,239],["τὴν",1,9],["καρδίαν",63,10],["σου",5,146],["καὶ",2,8],["λύπην",1076,10],["μακρὰν",638,37],["ἀπόστησον",646,198],["ἀπὸ",17,1],["σοῦ",5,146],["πολλοὺς",74,58],["γὰρ",40,12],["ἀπέκτεινεν",298,3],["ἡ",1,11],["λύπη",1076,13],["καὶ",2,8],["οὐκ",12,17],["ἔστιν",10,87],["ὠφέλεια",2560,13],["ἐν",4,1],["αὐτῇ",3,99]],"Love thine own soul, and comfort thy heart, remove sorrow far from thee: for sorrow hath killed many, and there is no profit therein."],["24",[["Ζῆλος",1095,5],["καὶ",2,8],["θυμὸς",177,5],["ἐλαττοῦσιν",1433,189],["ἡμέρας",28,19],["καὶ",2,8],["πρὸ",235,1],["καιροῦ",132,21],["γῆρας",1267,20],["ἄγει",227,87],["μέριμνα",3313,13]],"Envy and wrath shorten the life, and carefulness bringeth age before the time."],["25",[["Ὡς",36,8],["καλαμώμενος",5703,114],["ὀπίσω",166,17],["τρυγητῶν",3667,77],["ἐν",4,1],["εὐλογίᾳ",576,2],["Κυρίου",7,21],["ἔφθασα",1567,147]],"I awaked up last of all, as one that gathereth after the grape-gatherers: by the blessing of the Lord I profited,"],["26",[["καὶ",2,8],["ὡς",36,8],["τρυγῶν",2307,36],["ἐπλήρωσα",529,147],["ληνόν",1769,7],["Κατανοήσατε",1547,69],["ὅτι",19,8],["οὐκ",12,17],["ἐμοὶ",6,49],["μόνῳ",300,111],["ἐκοπίασα",0,0],["ἀλλὰ",107,17],["πᾶσι",11,215],["τοῖς",1,138],["ζητοῦσι",190,357],["παιδείαν",569,10]],"and filled my winepress like a gatherer of grapes. Consider that I laboured not for myself only, but for all them that seek learning."],["27",[["Ακούσατέ",0,0],["μου",6,48],["μεγιστᾶνες",1827,51],["λαοῦ",35,21],["καὶ",2,8],["οἱ",1,128],["ἡγούμενοι",374,529],["ἐκκλησίας",562,19],["ἐνωτίσασθε",1316,180]],"Hear me, O ye great men of the people, and hearken with your ears, ye rulers of the congregation."],["28",[["Ὑιῷ",0,0],["καὶ",2,8],["γυναικὶ",58,2],["ἀδελφῷ",66,113],["καὶ",2,8],["φίλῳ",334,111],["μὴ",25,8],["δῷς",33,170],["ἐξουσίαν",928,10],["ἐπὶ",9,1],["σὲ",5,161],["ἐν",4,1],["ζωῇ",212,2],["σου",5,146],["καὶ",2,8],["μὴ",25,8],["δῷς",33,170],["ἑτέρῳ",253,111],["τὰ",1,42],["χρήματά",1192,43],["σου",5,146],["ἵνα",101,8],["μὴ",25,8],["μεταμεληθεὶς",7728,206],["δέῃ",1161,172],["περὶ",71,1],["αὐτῶν",3,41]],"Give not thy son and wife, thy brother and friend, power over thee while thou livest, and give not thy goods to another, lest it repent thee, and thou intreat for the same again."],["29",[["Ἕως",42,8],["ἔτι",110,17],["ζῇς",117,145],["καὶ",2,8],["πνοὴ",1637,13],["ἐν",4,1],["σοὶ",5,151],["μὴ",25,8],["ἀλλάξῃς",1149,170],["σεαυτὸν",293,82],["πάσῃ",11,96],["σαρκί",287,2]],"As long as thou livest and hast breath in thee, give not thyself over to any."],["30",[["κρεῖσσον",922,29],["γάρ",40,12],["ἐστι",10,87],["τὰ",1,42],["τέκνα",192,43],["δεηθῆναί",439,174],["σου",5,146],["ἢ",60,8],["σὲ",5,161],["ἐμβλέπειν",1861,54],["εἰς",8,1],["χεῖρας",37,40],["υἱῶν",13,77],["σου",5,146]],"For better it is that thy children should seek to thee, than that thou shouldest stand to their courtesy."],["31",[["Ἐν",4,1],["πᾶσι",11,90],["τοῖς",1,91],["ἔργοις",104,92],["σου",5,146],["γίνου",30,250],["ὑπεράγων",5452,67],["μὴ",25,8],["δῷς",33,170],["μῶμον",1686,7],["ἐν",4,1],["τῇ",1,95],["δόξῃ",141,2],["σου",5,146]],"In all thy works keep to thyself the preeminence; leave not a stain in thine honour."],["32",[["Ἐν",4,1],["ἡμέρᾳ",28,2],["συντελείας",808,19],["ἡμερῶν",28,61],["ζωῆς",212,19],["σου",5,146],["καὶ",2,8],["ἐν",4,1],["καιρῷ",132,113],["τελευτῆς",1564,19],["διάδος",2892,198],["κληρονομίαν",297,10],["ΠΕΡΙ",71,1],["ΔΟΥΛΩΝ",136,61]],"At the time when thou shalt end thy days, and finish thy life, distribute thine inheritance."],["33",[["Χορτάσματα",3159,43],["καί",2,8],["ῥάβδος",492,13],["καὶ",2,8],["φορτία",3672,43],["ὄνῳ",497,113],["ἄρτος",197,5],["καὶ",2,8],["παιδεία",569,13],["καὶ",2,8],["ἔργον",104,33],["οἱκέτῃ",0,0]],"Fodder, a stick, and burdens, [are] for the ass; and bread, correction, and work, for a servant."],["34",[["Ἔργασαι",468,296],["ἐν",4,1],["παιδὶ",126,113],["καὶ",2,8],["εὑρήσεις",106,159],["ἀνάπαυσιν",1046,10],["ἄνες",1082,198],["χεῖρας",37,40],["αὐτῷ",3,49],["καὶ",2,8],["ζητήσει",190,120],["ἐλευθερίαν",3432,10]],"If thou set thy servant to labour, thou shalt find rest: but if thou let him go idle, he will seek liberty."],["35",[["Ζυγὸς",776,5],["καὶ",2,8],["ἱμὰς",4132,5],["κάμψουσι",2028,207],["τράχηλον",690,7],["καὶ",2,8],["οἰκέτῃ",952,113],["κακούργῳ",4261,111],["στρέβλαι",3361,179],["καὶ",2,8],["βάσανοι",842,179]],"A yoke and a collar do bow the neck: so are tortures and torments for an evil servant."],["36",[["Ἔμβαλε",751,198],["αὐτὸν",3,82],["εἰς",8,1],["ἐργασίαν",1071,10],["ἵνα",101,8],["μὴ",25,8],["ἀργῇ",3414,96],["πολλὴν",74,37],["γὰρ",40,12],["κακίαν",431,10],["ἐδίδαξεν",543,3],["ἡ",1,11],["ἀργία",4559,13]],"Send him to labour, that he be not idle; for idleness teacheth much evil."],["37",[["Εἰς",8,1],["ἔργα",104,43],["κατάστησον",313,198],["καθὼς",218,17],["πρέπει",2772,87],["αὐτῷ",3,49],["κᾂν",2095,105],["μὴ",25,8],["πειθαρχῇ",5949,166],["βάρυνον",1027,198],["τὰς",1,39],["πέδας",2299,40],["αὐτοῦ",3,48]],"Set him to work, as is fit for him: if he be not obedient, put on more heavy fetters."],["38",[["Καὶ",2,8],["μὴ",25,8],["περισσεύσῃς",3120,170],["ἐν",4,1],["πάσῃ",11,96],["σαρκὶ",287,2],["καὶ",2,8],["ἄνευ",1103,1],["κρίσεως",226,19],["μὴ",25,8],["ποιήσῃς",23,170],["μηδέν",910,29]],"But be not excessive toward any; and without discretion do nothing."],["39",[["Εἰ",77,8],["ἔστι",10,87],["σοι",5,151],["οἰκέτης",952,5],["ἔστω",10,35],["ὡς",36,8],["σὺ",5,156],["ὅτι",19,8],["ἐν",4,1],["αἵματι",148,53],["ἐκτήσω",533,169],["αὐτόν",3,82]],"If thou have a servant, let him be unto thee as thyself, because thou hast bought him with a price."],["40",[["Εἰ",77,8],["ἔστι",10,87],["σοι",5,151],["οἰκέτῃς",952,139],["ἄγε",227,239],["αὐτὸν",3,82],["ὡς",36,8],["σεαυτὸν",293,82],["ὅτι",19,8],["ὡς",36,8],["ἡ",1,11],["ψυχή",62,13],["σου",5,146],["ἐπιδεήσεις",2540,159],["αὐτοῦ",3,48],["ἐὰν",45,8],["κακώσῃς",764,170],["αὐτὸν",3,82],["καὶ",2,8],["ἀπάρας",850,155],["ἀποδρᾷ",6333,87],["ἐν",4,1],["ποίᾳ",1330,2],["ὁδῷ",67,2],["ζητήσεις",3537,40],["αὐτόν",3,82]],"If thou have a servant, entreat him as a brother: for thou hast need of him, as of thine own soul: if thou entreat him evil, and he run from thee, which way wilt thou go to seek him?"]]