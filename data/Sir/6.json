[["2a",[["Καὶ",2,8],["ἀντὶ",158,1],["φίλου",334,153],["μὴ",25,8],["γίνου",30,250],["ἐχθρός",135,5],["ὄνομα",55,33],["γὰρ",40,12],["πονηρὸν",164,29],["αἰσχύνην",683,10],["καὶ",2,8],["ὄνειδος",973,20],["κληρονομήσει",368,120],["οὕτως",70,17],["ὁ",1,4],["ἁμαρτωλὸς",406,16],["ὁ",1,4],["δίγλωσσος",3836,16]],"Instead of a friend become not an enemy; for [thereby] thou shalt inherit an ill name, shame, and reproach: even so shall a sinner that hath a double tongue."],["2b",[["Μὴ",25,8],["ἐπάρῃς",752,170],["σεαυτὸν",293,82],["ἐν",4,1],["βουλῇ",349,2],["ψυχῆς",62,19],["σου",5,146],["ἵνα",101,8],["μὴ",25,8],["διαρπαγῇ",1181,337],["ὡς",36,8],["ταῦρος",1284,5],["ἡ",1,11],["ψυχή",62,13],["σου",5,146]],"Extol not thyself in the counsel of thine own heart: that thy soul be not torn in pieces as a bull [straying alone]."],["3",[["Τὰ",1,42],["φύλλα",1791,43],["σου",5,146],["καταφάγεσαι",404,116],["καὶ",2,8],["τοὺς",1,56],["καρπούς",446,31],["σου",5,146],["ἀπολέσεις",213,159],["καὶ",2,8],["ἀφήσεις",504,159],["σεαυτὸν",293,82],["ὡς",36,8],["ξύλον",196,33],["ξηρόν",1187,29]],"Thou shalt eat up thy leaves, and lose thy fruit, and leave thyself as a dry tree."],["4",[["Ψυχὴ",62,13],["πονηρὰ",164,15],["ἀπολεῖ",213,120],["τὸν",1,6],["κτησάμενον",533,437],["αὐτήν",3,98],["καὶ",2,8],["ἐπίχαρμα",4110,20],["ἐχθρῶν",135,77],["ποιήσει",23,120],["αὐτόν",3,82]],"A wicked soul shall destroy him that hath it, and shall make him to be laughed to scorn of his enemies."],["5",[["Λάρυγξ",2097,5],["γλυκὺς",2079,16],["πληθυνεῖ",315,120],["φίλους",334,88],["αὐτοῦ",3,144],["καὶ",2,8],["γλῶσσα",385,13],["εὔλαλος",5665,15],["πληθυνεῖ",315,120],["εὐπροσήγορα",7232,74]],"Sweet language will multiply friends: and a fairspeaking tongue will increase kind greetings."],["6",[["Οἱ",1,128],["εἰρηνεύοντές",1959,137],["σοι",5,151],["ἔστωσαν",10,55],["πολλοὶ",74,130],["οἱ",1,128],["δὲ",14,12],["σύμβουλοί",1448,51],["σου",5,146],["εἷς",57,16],["ἀπὸ",17,1],["χιλίων",1485,163]],"Be in peace with many: nevertheless have but one counsellor of a thousand."],["7",[["Εἰ",77,8],["κτᾶσαι",533,166],["φίλον",334,59],["ἐν",4,1],["πειρασμῷ",2293,113],["κτῆσαι",533,275],["αὐτόν",3,82],["καὶ",2,8],["μὴ",25,8],["ταχὺ",1391,17],["ἐμπιστεύσῃς",1750,170],["αὐτῷ",3,49]],"If thou wouldest get a friend, prove him first, and be not hasty to credit him."],["8",[["Ἔστι",10,87],["γὰρ",40,12],["φίλος",334,16],["ἐν",4,1],["καιρῷ",132,113],["αὐτοῦ",3,48],["καὶ",2,8],["οὐ",12,17],["μὴ",25,8],["παραμείνῃ",3113,160],["ἐν",4,1],["ἡμέρᾳ",28,2],["θλίψεώς",437,19],["σου",5,146]],"For some man is a friend for his own occasion, and will not abide in the day of thy trouble."],["9",[["Καὶ",2,8],["ἔστι",10,87],["φίλος",334,16],["μετατιθέμενος",2033,114],["εἰς",8,1],["ἔχθραν",1804,10],["καὶ",2,8],["μάχην",1383,10],["ὀνειδισμοῦ",732,21],["σου",5,146],["ἀποκαλύψει",1453,2]],"And there is a friend, who being turned to enmity and strife will discover thy reproach."],["10",[["Καὶ",2,8],["ἔστι",10,87],["φίλος",334,16],["κοινωνὸς",3566,5],["τραπεζῶν",644,61],["καὶ",2,8],["οὐ",12,17],["μὴ",25,8],["παραμείνῃ",3113,160],["ἐν",4,1],["ἡμέρᾳ",28,2],["θλίψεώς",437,19],["σου",5,146]],"Again, some friend is a companion at the table, and will not continue in the day of thy affliction."],["11",[["Καὶ",2,8],["ἐν",4,1],["τοῖς",1,138],["ἀγαθοῖς",113,215],["σου",5,146],["ἔσται",10,89],["ὡς",36,8],["σὺ",5,156],["καὶ",2,8],["ἐπὶ",9,1],["τοὺς",1,56],["οἰκέτας",952,31],["σου",5,146],["παῤῥησιάσεται",3927,399]],"But in thy prosperity he will be as thyself, and will be bold over thy servants."],["12",[["Ἐὰν",45,8],["ταπεινωθῇς",333,279],["ἔσται",10,89],["κατὰ",32,1],["σοῦ",5,146],["καὶ",2,8],["ἀπὸ",17,1],["τοῦ",1,23],["προσώπου",47,24],["σου",5,146],["κρυβήσεται",378,125]],"If thou be brought low, he will be against thee, and will hide himself from thy face."],["13",[["Ἀπὸ",17,1],["τῶν",1,76],["ἐχθρῶν",135,77],["σου",5,146],["διαχωρίσθητι",1673,242],["καὶ",2,8],["ἀπὸ",17,1],["τῶν",1,76],["φίλων",334,163],["σου",5,146],["πρόσεχε",557,239]],"Separate thyself from thine enemies, and take heed of thy friends."],["14",[["Φίλος",334,16],["πιστὸς",748,16],["σκέπη",1189,13],["κραταιὰ",862,15],["ὁ",1,4],["δὲ",14,12],["εὑρὼν",106,155],["αὐτὸν",3,82],["εὗρε",106,3],["θησαυρόν",577,7]],"A faithful friend is a strong defence: and he that hath found such an one hath found a treasure."],["15",[["Φίλου",334,153],["πιστοῦ",748,153],["οὐκ",12,17],["ἔστιν",10,87],["ἀντάλλαγμα",3172,33],["καὶ",2,8],["οὐκ",12,17],["ἔστι",10,87],["σταθμὸς",970,5],["τῆς",1,18],["καλλονῆς",3279,19],["αὐτοῦ",3,48]],"Nothing doth countervail a faithful friend, and his excellency is invaluable."],["16",[["Φίλος",334,16],["πιστὸς",748,16],["φάρμακον",2402,7],["ζωῆς",212,19],["καὶ",2,8],["οἱ",1,128],["φοβούμενοι",134,356],["Κύριον",7,7],["εὑρήσουσιν",106,207],["αὐτόν",3,82]],"A faithful friend is the medicine of life; and they that fear the Lord shall find him."],["17",[["Ὁ",1,4],["φοβούμενος",134,114],["Κύριον",7,7],["εὐθύνει",2181,87],["φιλίαν",1254,10],["αὐτοῦ",3,48],["ὅτι",19,8],["κατʼ",32,1],["αὐτὸν",3,82],["οὕτως",70,17],["καὶ",2,8],["ὁ",1,4],["πλησίον",292,17],["αὐτοῦ",3,48]],"Whoso feareth the Lord shall direct his friendship aright: for as he is, so shall his neighbour be also."],["18",[["Τέκνον",192,20],["ἐκ",21,1],["νεότητός",785,19],["σου",5,146],["ἐπίλεξαι",1657,275],["παιδείαν",569,10],["καὶ",2,8],["ἕως",42,8],["πολιῶν",2115,61],["εὑρήσεις",106,159],["σοφίαν",238,10]],"My son, gather instruction from thy youth up: so shalt thou find wisdom till thine old age."],["19",[["Ὡς",36,8],["ὁ",1,4],["ἀροτριῶν",2519,67],["καὶ",2,8],["ὁ",1,4],["σπείρων",790,67],["πρόσελθε",538,198],["αὐτῇ",3,99],["καὶ",2,8],["ἀνάμενε",2817,239],["τοὺς",1,56],["ἀγαθοὺς",113,58],["καρποὺς",446,31],["αὐτῆς",3,83],["ἐν",4,1],["γὰρ",40,12],["τῇ",1,95],["ἐργασίᾳ",1071,2],["αὐτῆς",3,83],["ὀλίγον",554,29],["κοπιάσεις",935,159],["καὶ",2,8],["ταχὺ",1391,17],["φάγεσαι",153,116],["γεννημάτων",740,45],["αὐτῆς",3,83]],"Come unto her as one that ploweth and soweth, and wait for her good fruits: for thou shalt not toil much in labouring about her, but thou shalt eat of her fruits right soon."],["20",[["Ὡς",36,8],["τραχεῖά",3377,15],["ἐστι",10,87],["σφόδρα",149,17],["τοῖς",1,138],["ἀπαιδεύτοις",2054,215],["καὶ",2,8],["οὐκ",12,17],["ἐμμενεῖ",1997,120],["ἐν",4,1],["αὐτῇ",3,99],["ἀκάρδιος",4512,16]],"She is very unpleasant to the unlearned: he that is without understanding will not remain with her."],["21",[["Ὡς",36,8],["λίθος",195,5],["δοκιμασίας",7124,40],["ἰσχυρὸς",398,16],["ἔσται",10,89],["ἐπʼ",9,1],["αὐτῷ",3,49],["καὶ",2,8],["οὐ",12,17],["χρονιεῖ",1744,120],["ἀποῤῥίψαι",1215,276],["αὐτήν",3,98]],"She will lie upon him as a mighty stone of trial; and he will cast her from him ere it be long."],["22",[["Σοφία",238,13],["γὰρ",40,12],["κατὰ",32,1],["τὸ",1,32],["ὄνομα",55,33],["αὐτῆς",3,83],["ἐστι",10,87],["καὶ",2,8],["οὐ",12,17],["πολλοῖς",74,215],["ἐστι",10,87],["φανερά",1981,74]],"For wisdom is according to her name, and she is not manifest unto many."],["23",[["Ἄκουσον",53,198],["τέκνον",192,20],["καὶ",2,8],["δέξαι",813,275],["γνώμην",1375,10],["μου",6,48],["καὶ",2,8],["μὴ",25,8],["ἀπαναίνου",4544,588],["τὴν",1,9],["συμβουλίαν",2972,10],["μου",6,48]],"Give ear, my son, receive my advice, and refuse not my counsel,"],["24",[["Καὶ",2,8],["εἰσένεγκον",584,198],["τοὺς",1,56],["πόδας",208,31],["σου",5,146],["εἰς",8,1],["τὰς",1,39],["πέδας",2299,40],["αὐτῆς",3,83],["καὶ",2,8],["εἰς",8,1],["τὸν",1,6],["κλοίον",1733,7],["αὐτῆς",3,83],["τὸν",1,6],["τράχηλόν",690,7],["σου",5,146]],"and put thy feet into her fetters, and thy neck into her chain."],["25",[["Ὑπόθες",2437,198],["τὸν",1,6],["ὦμόν",1011,7],["σοῦ",5,146],["καὶ",2,8],["βάσταξον",3505,198],["αὐτὴν",3,98],["καὶ",2,8],["μὴ",25,8],["προσοχθίσῃς",1833,170],["τοῖς",1,138],["δεσμοῖς",1032,139],["αὐτῆς",3,83]],"Bow down thy shoulder, and bear her, and be not grieved with her bonds."],["26",[["Ἐν",4,1],["πάσῃ",11,96],["ψυχῇ",62,2],["σου",5,146],["πρόσελθε",538,198],["αὐτῇ",3,99],["καὶ",2,8],["ἐν",4,1],["ὅλῃ",233,96],["δυνάμει",98,2],["σου",5,146],["συντήρησον",1447,243],["τὰς",1,39],["ὁδοὺς",67,40],["αὐτῆς",3,83]],"Come unto her with thy whole heart, and keep her ways with all thy power."],["27",[["Ἐξίχνεύσον",6511,243],["καὶ",2,8],["ζήτησον",190,198],["καὶ",2,8],["γνωσθήσεταί",81,125],["σοι",5,151],["καὶ",2,8],["ἐγκρατὴς",2672,16],["γενόμενος",30,245],["μὴ",25,8],["ἀφῇς",504,170],["αὐτήν",3,98]],"Search, and seek, and she shall be made known unto thee: and when thou hast got hold of her, let her not go."],["28",[["Ἐπʼ",9,1],["ἐσχάτων",407,115],["γὰρ",40,12],["εὑρήσεις",106,159],["τὴν",1,9],["ἀνάπαυσιν",1046,10],["αὐτῆς",3,83],["καὶ",2,8],["στραφήσεταί",1079,125],["σοι",5,151],["εἰς",8,1],["εὐφροσύνην",360,10]],"For at the last thou shalt find her rest, and that shall be turned to thy joy."],["29",[["Καὶ",2,8],["ἔσονταί",10,127],["σοι",5,151],["αἱ",1,183],["πέδαι",2299,179],["εἰς",8,1],["σκέπην",1189,10],["ἰσχύος",180,19],["καὶ",2,8],["οἱ",1,128],["κλοιοὶ",1733,51],["αὐτῆς",3,83],["εἰς",8,1],["στολὴν",559,10],["δόξης",141,19]],"Then shall her fetters be a strong defence for thee, and her chains a robe of glory."],["30",[["Κόσμος",742,5],["γὰρ",40,12],["χρύσεός",290,16],["ἐστιν",10,87],["ἐπʼ",9,1],["αὐτῆς",3,83],["καὶ",2,8],["οἱ",1,128],["δεσμοὶ",1032,51],["αὐτῆς",3,83],["κλῶσμα",5772,20],["ὑακίνθινον",1613,28]],"For there is a golden ornament upon her, and her bands are purple lace."],["31",[["Στολὴν",559,10],["δόξης",141,19],["ἐνδύσῃ",515,116],["αὐτὴν",3,98],["καὶ",2,8],["στέφανον",979,7],["ἀγαλλιάματος",1794,24],["περιθήσεις",1016,159],["σεαυτῷ",293,49]],"Thou shalt put her on as a robe of honour, and shalt put her about thee as a crown of joy."],["32",[["Ἐὰν",45,8],["θέλῃς",837,199],["τέκνον",192,20],["παιδευθήσῃ",654,379],["καὶ",2,8],["ἐὰν",45,8],["δῷς",33,170],["τὴν",1,9],["ψυχήν",62,10],["σου",5,146],["πανοῦργος",1906,16],["ἔσῃ",10,116]],"My son, if thou wilt, thou shalt be taught: and if thou wilt apply thy mind, thou shalt be prudent."],["33",[["Ἐὰν",45,8],["ἀγαπήσῃς",224,170],["ἀκούειν",53,54],["ἐκδέξῃ",2422,116],["καὶ",2,8],["ἐὰν",45,8],["κλίνῃς",829,170],["τὸ",1,32],["οὖς",325,33],["σου",5,146],["σοφὸς",322,16],["ἔσῃ",10,116]],"If thou love to hear, thou shalt receive understanding: and if thou bow thine ear, thou shalt be wise."],["34",[["Ἐν",4,1],["πλήθει",199,53],["πρεσβυτέρων",329,77],["στῆθι",78,198],["καὶ",2,8],["τίς",39,150],["σοφός",322,16],["αὐτῷ",3,49],["προσκολλήθητι",2043,242]],"Stand in the multitude of the elders; and cleave unto him that is wise."],["35",[["Πᾶσαν",11,37],["διήγησιν",2580,10],["θείαν",1340,37],["θέλε",837,239],["ἀκούειν",53,54],["καὶ",2,8],["παροιμίαι",3615,179],["συνέσεως",467,19],["μὴ",25,8],["ἐκφευγέτωσάν",1860,55],["σε",5,161]],"Be willing to hear every godly discourse: and let not the parables of understanding escape thee."],["36",[["Ἐὰν",45,8],["ἴδῃς",73,170],["συνετὸν",956,28],["ὄρθριζε",930,239],["πρὸς",15,1],["αὐτὸν",3,82],["καὶ",2,8],["βαθμοὺς",3253,31],["θυρῶν",277,61],["αὐτοῦ",3,48],["ἐκτριβέτω",958,35],["ὁ",1,4],["πούς",208,5],["σου",5,146]],"And if thou seest a man of understanding, get thee betimes unto him, and let thy foot wear the steps of his door."],["37",[["Διανοοῦ",1720,250],["ἐν",4,1],["τοῖς",1,91],["προστάγμασιν",391,92],["Κυρίου",7,21],["καὶ",2,8],["ἐν",4,1],["ταῖς",1,70],["ἐντολαῖς",259,71],["αὐτοῦ",3,48],["μελέτα",1344,239],["διαπαντός",506,17],["αὐτὸς",3,158],["στηριεῖ",1064,120],["τὴν",1,9],["καρδίαν",63,10],["σου",5,146],["καὶ",2,8],["ἡ",1,11],["ἐπιθυμία",701,13],["τῆς",1,18],["σοφίας",238,19],["σου",5,146],["δοθήσεταί",33,125],["σοι",5,151]],"Let thy mind be upon the ordinances of the Lord, and meditate continually in his commandments: he shall establish thine heart, and give thee wisdom at thine own desire."]]