[["2a",[["Καὶ",2,8],["ἀντὶ",158,1],["φίλου",336,153],["μὴ",25,8],["γίνου",30,249],["ἐχθρός",135,5],["ὄνομα",57,33],["γὰρ",40,12],["πονηρὸν",164,29],["αἰσχύνην",685,10],["καὶ",2,8],["ὄνειδος",973,20],["κληρονομήσει",370,120],["οὕτως",71,17],["ὁ",1,4],["ἁμαρτωλὸς",409,16],["ὁ",1,4],["δίγλωσσος",3823,16]],"Instead of a friend become not an enemy; for [thereby] thou shalt inherit an ill name, shame, and reproach: even so shall a sinner that hath a double tongue."],["2b",[["Μὴ",25,8],["ἐπάρῃς",661,170],["σεαυτὸν",255,82],["ἐν",4,1],["βουλῇ",350,2],["ψυχῆς",63,19],["σου",5,146],["ἵνα",102,8],["μὴ",25,8],["διαρπαγῇ",1160,333],["ὡς",36,8],["ταῦρος",1285,5],["ἡ",1,11],["ψυχή",63,13],["σου",5,146]],"Extol not thyself in the counsel of thine own heart: that thy soul be not torn in pieces as a bull [straying alone]."],["3",[["Τὰ",1,42],["φύλλα",1791,43],["σου",5,146],["καταφάγεσαι",407,116],["καὶ",2,8],["τοὺς",1,56],["καρπούς",448,31],["σου",5,146],["ἀπολέσεις",217,159],["καὶ",2,8],["ἀφήσεις",501,159],["σεαυτὸν",255,121],["ὡς",36,8],["ξύλον",196,33],["ξηρόν",1186,29]],"Thou shalt eat up thy leaves, and lose thy fruit, and leave thyself as a dry tree."],["4",[["Ψυχὴ",63,13],["πονηρὰ",164,15],["ἀπολεῖ",217,120],["τὸν",1,6],["κτησάμενον",564,431],["αὐτήν",3,98],["καὶ",2,8],["ἐπίχαρμα",4100,20],["ἐχθρῶν",135,77],["ποιήσει",23,120],["αὐτόν",3,82]],"A wicked soul shall destroy him that hath it, and shall make him to be laughed to scorn of his enemies."],["5",[["Λάρυγξ",2092,5],["γλυκὺς",2073,16],["πληθυνεῖ",316,120],["φίλους",336,88],["αὐτοῦ",3,144],["καὶ",2,8],["γλῶσσα",388,13],["εὔλαλος",5636,15],["πληθυνεῖ",316,120],["εὐπροσήγορα",7180,74]],"Sweet language will multiply friends: and a fairspeaking tongue will increase kind greetings."],["6",[["Οἱ",1,128],["εἰρηνεύοντές",1959,137],["σοι",5,151],["ἔστωσαν",10,55],["πολλοὶ",74,130],["οἱ",1,128],["δὲ",14,12],["σύμβουλοί",1447,51],["σου",5,146],["εἷς",58,16],["ἀπὸ",17,1],["χιλίων",1483,163]],"Be in peace with many: nevertheless have but one counsellor of a thousand."],["7",[["Εἰ",77,8],["κτᾶσαι",564,166],["φίλον",336,59],["ἐν",4,1],["πειρασμῷ",2281,113],["κτῆσαι",564,275],["αὐτόν",3,82],["καὶ",2,8],["μὴ",25,8],["ταχὺ",1389,17],["ἐμπιστεύσῃς",1754,170],["αὐτῷ",3,49]],"If thou wouldest get a friend, prove him first, and be not hasty to credit him."],["8",[["Ἔστι",10,87],["γὰρ",40,12],["φίλος",336,16],["ἐν",4,1],["καιρῷ",132,113],["αὐτοῦ",3,48],["καὶ",2,8],["οὐ",12,17],["μὴ",25,8],["παραμείνῃ",3104,160],["ἐν",4,1],["ἡμέρᾳ",28,2],["θλίψεώς",438,19],["σου",5,146]],"For some man is a friend for his own occasion, and will not abide in the day of thy trouble."],["9",[["Καὶ",2,8],["ἔστι",10,87],["φίλος",336,16],["μετατιθέμενος",2027,114],["εἰς",8,1],["ἔχθραν",1802,10],["καὶ",2,8],["μάχην",1382,10],["ὀνειδισμοῦ",733,21],["σου",5,146],["ἀποκαλύψει",1453,2]],"And there is a friend, who being turned to enmity and strife will discover thy reproach."],["10",[["Καὶ",2,8],["ἔστι",10,87],["φίλος",336,16],["κοινωνὸς",3562,5],["τραπεζῶν",650,61],["καὶ",2,8],["οὐ",12,17],["μὴ",25,8],["παραμείνῃ",3104,160],["ἐν",4,1],["ἡμέρᾳ",28,2],["θλίψεώς",438,19],["σου",5,146]],"Again, some friend is a companion at the table, and will not continue in the day of thy affliction."],["11",[["Καὶ",2,8],["ἐν",4,1],["τοῖς",1,138],["ἀγαθοῖς",114,215],["σου",5,146],["ἔσται",10,89],["ὡς",36,8],["σὺ",5,156],["καὶ",2,8],["ἐπὶ",9,1],["τοὺς",1,56],["οἰκέτας",951,31],["σου",5,146],["παῤῥησιάσεται",3917,394]],"But in thy prosperity he will be as thyself, and will be bold over thy servants."],["12",[["Ἐὰν",45,8],["ταπεινωθῇς",322,278],["ἔσται",10,89],["κατὰ",32,1],["σοῦ",5,146],["καὶ",2,8],["ἀπὸ",17,1],["τοῦ",1,23],["προσώπου",47,24],["σου",5,146],["κρυβήσεται",372,125]],"If thou be brought low, he will be against thee, and will hide himself from thy face."],["13",[["Ἀπὸ",17,1],["τῶν",1,76],["ἐχθρῶν",135,77],["σου",5,146],["διαχωρίσθητι",1587,242],["καὶ",2,8],["ἀπὸ",17,1],["τῶν",1,76],["φίλων",336,163],["σου",5,146],["πρόσεχε",558,239]],"Separate thyself from thine enemies, and take heed of thy friends."],["14",[["Φίλος",336,16],["πιστὸς",750,16],["σκέπη",1188,13],["κραταιὰ",862,15],["ὁ",1,4],["δὲ",14,12],["εὑρὼν",101,155],["αὐτὸν",3,82],["εὗρε",101,3],["θησαυρόν",579,7]],"A faithful friend is a strong defence: and he that hath found such an one hath found a treasure."],["15",[["Φίλου",336,153],["πιστοῦ",750,153],["οὐκ",12,17],["ἔστιν",10,87],["ἀντάλλαγμα",3165,33],["καὶ",2,8],["οὐκ",12,17],["ἔστι",10,87],["σταθμὸς",969,5],["τῆς",1,18],["καλλονῆς",3276,19],["αὐτοῦ",3,48]],"Nothing doth countervail a faithful friend, and his excellency is invaluable."],["16",[["Φίλος",336,16],["πιστὸς",750,16],["φάρμακον",2394,7],["ζωῆς",216,19],["καὶ",2,8],["οἱ",1,128],["φοβούμενοι",134,351],["Κύριον",7,7],["εὑρήσουσιν",101,207],["αὐτόν",3,82]],"A faithful friend is the medicine of life; and they that fear the Lord shall find him."],["17",[["Ὁ",1,4],["φοβούμενος",134,114],["Κύριον",7,7],["εὐθύνει",2348,87],["φιλίαν",1253,10],["αὐτοῦ",3,48],["ὅτι",19,8],["κατʼ",32,1],["αὐτὸν",3,82],["οὕτως",71,17],["καὶ",2,8],["ὁ",1,4],["πλησίον",292,17],["αὐτοῦ",3,48]],"Whoso feareth the Lord shall direct his friendship aright: for as he is, so shall his neighbour be also."],["18",[["Τέκνον",192,20],["ἐκ",21,1],["νεότητός",787,19],["σου",5,146],["ἐπίλεξαι",1657,275],["παιδείαν",571,10],["καὶ",2,8],["ἕως",42,8],["πολιῶν",2108,61],["εὑρήσεις",101,159],["σοφίαν",242,10]],"My son, gather instruction from thy youth up: so shalt thou find wisdom till thine old age."],["19",[["Ὡς",36,8],["ὁ",1,4],["ἀροτριῶν",2407,67],["καὶ",2,8],["ὁ",1,4],["σπείρων",793,67],["πρόσελθε",529,198],["αὐτῇ",3,99],["καὶ",2,8],["ἀνάμενε",2806,239],["τοὺς",1,56],["ἀγαθοὺς",114,58],["καρποὺς",448,31],["αὐτῆς",3,83],["ἐν",4,1],["γὰρ",40,12],["τῇ",1,95],["ἐργασίᾳ",1070,2],["αὐτῆς",3,83],["ὀλίγον",555,29],["κοπιάσεις",921,159],["καὶ",2,8],["ταχὺ",1389,17],["φάγεσαι",147,116],["γεννημάτων",742,45],["αὐτῆς",3,83]],"Come unto her as one that ploweth and soweth, and wait for her good fruits: for thou shalt not toil much in labouring about her, but thou shalt eat of her fruits right soon."],["20",[["Ὡς",36,8],["τραχεῖά",3372,15],["ἐστι",10,87],["σφόδρα",150,17],["τοῖς",1,138],["ἀπαιδεύτοις",2049,215],["καὶ",2,8],["οὐκ",12,17],["ἐμμενεῖ",1990,120],["ἐν",4,1],["αὐτῇ",3,99],["ἀκάρδιος",4489,16]],"She is very unpleasant to the unlearned: he that is without understanding will not remain with her."],["21",[["Ὡς",36,8],["λίθος",195,5],["δοκιμασίας",7078,40],["ἰσχυρὸς",401,16],["ἔσται",10,89],["ἐπʼ",9,1],["αὐτῷ",3,49],["καὶ",2,8],["οὐ",12,17],["χρονιεῖ",1746,120],["ἀποῤῥίψαι",1150,216],["αὐτήν",3,98]],"She will lie upon him as a mighty stone of trial; and he will cast her from him ere it be long."],["22",[["Σοφία",242,13],["γὰρ",40,12],["κατὰ",32,1],["τὸ",1,32],["ὄνομα",57,33],["αὐτῆς",3,83],["ἐστι",10,87],["καὶ",2,8],["οὐ",12,17],["πολλοῖς",74,215],["ἐστι",10,87],["φανερά",1977,74]],"For wisdom is according to her name, and she is not manifest unto many."],["23",[["Ἄκουσον",54,198],["τέκνον",192,20],["καὶ",2,8],["δέξαι",815,275],["γνώμην",1376,10],["μου",6,48],["καὶ",2,8],["μὴ",25,8],["ἀπαναίνου",4520,665],["τὴν",1,9],["συμβουλίαν",2960,10],["μου",6,48]],"Give ear, my son, receive my advice, and refuse not my counsel,"],["24",[["Καὶ",2,8],["εἰσένεγκον",587,198],["τοὺς",1,56],["πόδας",210,31],["σου",5,146],["εἰς",8,1],["τὰς",1,39],["πέδας",2287,40],["αὐτῆς",3,83],["καὶ",2,8],["εἰς",8,1],["τὸν",1,6],["κλοίον",1733,7],["αὐτῆς",3,83],["τὸν",1,6],["τράχηλόν",692,7],["σου",5,146]],"and put thy feet into her fetters, and thy neck into her chain."],["25",[["Ὑπόθες",2432,198],["τὸν",1,6],["ὦμόν",1011,7],["σοῦ",5,146],["καὶ",2,8],["βάσταξον",3502,198],["αὐτὴν",3,98],["καὶ",2,8],["μὴ",25,8],["προσοχθίσῃς",1780,170],["τοῖς",1,138],["δεσμοῖς",1035,139],["αὐτῆς",3,83]],"Bow down thy shoulder, and bear her, and be not grieved with her bonds."],["26",[["Ἐν",4,1],["πάσῃ",11,96],["ψυχῇ",63,2],["σου",5,146],["πρόσελθε",529,198],["αὐτῇ",3,99],["καὶ",2,8],["ἐν",4,1],["ὅλῃ",235,96],["δυνάμει",98,2],["σου",5,146],["συντήρησον",1446,198],["τὰς",1,39],["ὁδοὺς",68,40],["αὐτῆς",3,83]],"Come unto her with thy whole heart, and keep her ways with all thy power."],["27",[["Ἐξίχνεύσον",6477,547],["καὶ",2,8],["ζήτησον",191,198],["καὶ",2,8],["γνωσθήσεταί",79,125],["σοι",5,151],["καὶ",2,8],["ἐγκρατὴς",2669,16],["γενόμενος",30,244],["μὴ",25,8],["ἀφῇς",501,170],["αὐτήν",3,98]],"Search, and seek, and she shall be made known unto thee: and when thou hast got hold of her, let her not go."],["28",[["Ἐπʼ",9,1],["ἐσχάτων",410,115],["γὰρ",40,12],["εὑρήσεις",101,159],["τὴν",1,9],["ἀνάπαυσιν",1048,10],["αὐτῆς",3,83],["καὶ",2,8],["στραφήσεταί",1078,125],["σοι",5,151],["εἰς",8,1],["εὐφροσύνην",360,10]],"For at the last thou shalt find her rest, and that shall be turned to thy joy."],["29",[["Καὶ",2,8],["ἔσονταί",10,127],["σοι",5,151],["αἱ",1,185],["πέδαι",2287,180],["εἰς",8,1],["σκέπην",1188,10],["ἰσχύος",181,19],["καὶ",2,8],["οἱ",1,128],["κλοιοὶ",1733,51],["αὐτῆς",3,83],["εἰς",8,1],["στολὴν",560,10],["δόξης",141,19]],"Then shall her fetters be a strong defence for thee, and her chains a robe of glory."],["30",[["Κόσμος",743,5],["γὰρ",40,12],["χρύσεός",290,16],["ἐστιν",10,87],["ἐπʼ",9,1],["αὐτῆς",3,83],["καὶ",2,8],["οἱ",1,128],["δεσμοὶ",1035,51],["αὐτῆς",3,83],["κλῶσμα",5736,20],["ὑακίνθινον",1614,28]],"For there is a golden ornament upon her, and her bands are purple lace."],["31",[["Στολὴν",560,10],["δόξης",141,19],["ἐνδύσῃ",516,116],["αὐτὴν",3,98],["καὶ",2,8],["στέφανον",980,7],["ἀγαλλιάματος",1794,24],["περιθήσεις",1017,159],["σεαυτῷ",255,49]],"Thou shalt put her on as a robe of honour, and shalt put her about thee as a crown of joy."],["32",[["Ἐὰν",45,8],["θέλῃς",836,199],["τέκνον",192,20],["παιδευθήσῃ",643,373],["καὶ",2,8],["ἐὰν",45,8],["δῷς",33,170],["τὴν",1,9],["ψυχήν",63,10],["σου",5,146],["πανοῦργος",1906,16],["ἔσῃ",10,116]],"My son, if thou wilt, thou shalt be taught: and if thou wilt apply thy mind, thou shalt be prudent."],["33",[["Ἐὰν",45,8],["ἀγαπήσῃς",214,170],["ἀκούειν",54,54],["ἐκδέξῃ",2415,116],["καὶ",2,8],["ἐὰν",45,8],["κλίνῃς",785,170],["τὸ",1,32],["οὖς",328,33],["σου",5,146],["σοφὸς",324,16],["ἔσῃ",10,116]],"If thou love to hear, thou shalt receive understanding: and if thou bow thine ear, thou shalt be wise."],["34",[["Ἐν",4,1],["πλήθει",200,53],["πρεσβυτέρων",332,77],["στῆθι",78,198],["καὶ",2,8],["τίς",39,150],["σοφός",324,16],["αὐτῷ",3,49],["προσκολλήθητι",2038,242]],"Stand in the multitude of the elders; and cleave unto him that is wise."],["35",[["Πᾶσαν",11,37],["διήγησιν",2576,10],["θείαν",1343,37],["θέλε",836,239],["ἀκούειν",54,54],["καὶ",2,8],["παροιμίαι",3607,180],["συνέσεως",469,19],["μὴ",25,8],["ἐκφευγέτωσάν",1861,55],["σε",5,161]],"Be willing to hear every godly discourse: and let not the parables of understanding escape thee."],["36",[["Ἐὰν",45,8],["ἴδῃς",53,170],["συνετὸν",954,28],["ὄρθριζε",931,239],["πρὸς",15,1],["αὐτὸν",3,82],["καὶ",2,8],["βαθμοὺς",3248,31],["θυρῶν",277,61],["αὐτοῦ",3,48],["ἐκτριβέτω",956,35],["ὁ",1,4],["πούς",210,5],["σου",5,146]],"And if thou seest a man of understanding, get thee betimes unto him, and let thy foot wear the steps of his door."],["37",[["Διανοοῦ",1719,249],["ἐν",4,1],["τοῖς",1,91],["προστάγμασιν",393,92],["Κυρίου",7,21],["καὶ",2,8],["ἐν",4,1],["ταῖς",1,70],["ἐντολαῖς",259,71],["αὐτοῦ",3,48],["μελέτα",1347,239],["διαπαντός",510,17],["αὐτὸς",3,158],["στηριεῖ",979,120],["τὴν",1,9],["καρδίαν",64,10],["σου",5,146],["καὶ",2,8],["ἡ",1,11],["ἐπιθυμία",699,13],["τῆς",1,18],["σοφίας",242,19],["σου",5,146],["δοθήσεταί",33,125],["σοι",5,151]],"Let thy mind be upon the ordinances of the Lord, and meditate continually in his commandments: he shall establish thine heart, and give thee wisdom at thine own desire."]]