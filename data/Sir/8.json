[["1",[["Μὴ",25,8],["διαμάχου",4198,249],["μετὰ",29,1],["ἀνθρώπου",43,21],["δυνάστου",803,21],["μήποτε",964,17],["ἐμπέσῃς",994,170],["εἰς",8,1],["τὰς",1,39],["χεῖρας",37,40],["αὐτοῦ",3,48]],"Strive not with a mighty man, lest thou fall into his hands."],["2",[["Μὴ",25,8],["ἔριζε",3452,239],["μετὰ",29,1],["ἀνθρώπου",43,21],["πλουσίου",952,153],["μήποτε",964,17],["ἀντιστήσῃ",796,116],["σου",5,146],["τὴν",1,9],["ὁλκήν",1613,10],["πολλους",74,58],["γὰρ",40,12],["ἀπώλεσε",217,3],["τὸ",1,32],["χρυσίον",202,33],["καὶ",2,8],["καρδίας",64,19],["βασιλέων",22,77],["ἐξέκλινε",394,3]],"Be not at variance with a rich man, lest he overweigh thee: for gold hath destroyed many, and perverted the hearts of kings."],["3",[["Μὴ",25,8],["διαμάχου",4198,249],["μετὰ",29,1],["ἀνθρώπου",43,21],["γλωσσώδους",3800,153],["καὶ",2,8],["μὴ",25,8],["ἐπιστοιβάσῃς",4610,170],["ἐπὶ",9,1],["τὸ",1,32],["πῦρ",118,33],["αὐτοῦ",3,48],["ξύλα",196,63]],"Strive not with a man that is full of tongue, and heap not wood upon his fire."],["4",[["Μὴ",25,8],["πρόσπαιζε",5997,239],["ἀπαιδεύτῳ",2049,111],["ἵνα",102,8],["μὴ",25,8],["ἀτιμάζωνται",1400,391],["οἱ",1,128],["πρόγονοί",2623,51],["σου",5,146]],"Jest not with a rude man, lest thy ancestors be disgraced."],["5",[["Μὴ",25,8],["ὀνείδιζε",945,239],["ἄνθρωπον",43,7],["ἀποστρέφοντα",130,178],["ἀπὸ",17,1],["ἁμαρτίας",119,19],["μνήσθητι",230,242],["ὅτι",19,8],["πάντες",11,130],["ἐσμὲν",10,241],["ἐν",4,1],["ἐπιτιμίοις",2318,586]],"Reproach not a man that turneth from sin, but remember that we are all worthy of punishment."],["6",[["Μὴ",25,8],["ἀτιμάσῃς",1400,170],["ἄνθρωπον",43,7],["ἐν",4,1],["γήρει",3512,53],["αὐτοῦ",3,48],["καὶ",2,8],["γὰρ",40,12],["ἐξ",21,1],["ἡμῶν",6,41],["γηράσκουσι",1411,191]],"Dishonour not a man in his old age: for even some of us wax old."],["7",[["Μὴ",25,8],["ἐπίχαιρε",1938,239],["ἐπὶ",9,1],["νεκρῷ",659,111],["μνήσθητι",230,242],["ὅτι",19,8],["πάντες",11,130],["τελευτῶμεν",581,241]],"Rejoice not over thy greatest enemy being dead, but remember that we die all."],["8",[["Μὴ",25,8],["παρίδῃς",2276,170],["διήγημα",3523,20],["σοφῶν",324,163],["καὶ",2,8],["ἐν",4,1],["ταῖς",1,70],["παροιμίαις",3607,71],["αὐτῶν",3,41],["ἀναστρέφου",522,249],["ὅτι",19,8],["παρʼ",73,1],["αὐτῶν",3,41],["μαθήσῃ",923,116],["παιδείαν",571,10],["καὶ",2,8],["λειτουργῆσαι",534,100],["μεγιστᾶσι",1682,139]],"Despise not the discourse of the wise, but acquaint thyself with their proverbs: for of them thou shalt learn instruction, and how to serve great men with ease."],["9",[["Μὴ",25,8],["ἀστόχει",6345,14],["διηγήματος",3523,24],["γερόντων",1814,77],["καὶ",2,8],["γὰρ",40,12],["αὐτοὶ",3,195],["ἔμαθον",923,147],["παρὰ",73,1],["τῶν",1,76],["πατέρων",44,77],["αὐτῶν",3,41],["ὅτι",19,8],["παρʼ",73,1],["αὐτῶν",3,41],["μαθήσῃ",923,116],["σύνεσιν",469,10],["καὶ",2,8],["ἐν",4,1],["καιρῷ",132,113],["χρείας",1006,19],["δοῦναι",33,100],["ἀπόκρισιν",2406,10]],"Miss not the discourse of the elders: for they also learned of their fathers, and of them thou shalt learn understanding, and to give answer as need requireth."],["10",[["Μὴ",25,8],["ἔκκαιε",941,239],["ἄνθρακας",1402,31],["ἁμαρτωλοῦ",409,153],["μὴ",25,8],["ἐμπυρισθῇς",3430,278],["ἐν",4,1],["πυρὶ",118,53],["φλογὸς",983,19],["αὐτοῦ",3,48]],"Kindle not the coals of a sinner, lest thou be burnt with the flame of his fire."],["11",[["Μὴ",25,8],["ἐξαναστῇς",1292,170],["ἀπὸ",17,1],["προσώπου",47,24],["ὑβριστοῦ",2850,21],["ἵνα",102,8],["μὴ",25,8],["ἐγκαθίσῃ",4564,116],["ὡς",36,8],["ἔνεδρον",1371,20],["τῷ",1,52],["στόματί",123,53],["σου",5,146]],"Rise not up [in anger] at the presence of an injurious person, lest he lie in wait to entrap thee in thy words."],["12",[["Μὴ",25,8],["δανείσῃς",1669,170],["ἀνθρώπῳ",43,113],["ἰσχυροτέρῳ",401,111],["σου",5,146],["καὶ",2,8],["ἐὰν",45,8],["δανείσῃς",1669,170],["ὡς",36,8],["ἀπολωλεκὼς",217,264],["γίνου",30,249]],"Lend not unto him that is mightier than thyself; for if thou lendest him, count it but lost."],["13",[["Μὴ",25,8],["ἐγγυήσῃ",3181,116],["ὑπὲρ",139,1],["δυναμίν",98,10],["σου",5,146],["καὶ",2,8],["ἐὰν",45,8],["ἐγγυήσῃ",3181,116],["ὡς",36,8],["ἀποτίσων",1365,357],["φρόντιζε",2200,239]],"Be not surety above thy power: for if thou be surety, take care to pay it."],["14",[["Μὴ",25,8],["δικάζου",1621,249],["μετὰ",29,1],["κριτοῦ",749,21],["κατὰ",32,1],["γὰρ",40,12],["τὴν",1,9],["δόξαν",141,10],["αὐτοῦ",3,48],["κρινοῦσιν",263,207],["αὐτῷ",3,49]],"Go not to law with a judge; for they will judge for him according to his honour."],["15",[["Μετὰ",29,1],["τολμηροῦ",5105,153],["μὴ",25,8],["πορεύου",49,249],["ἐν",4,1],["ὁδῷ",68,2],["ἵνα",102,8],["μὴ",25,8],["βαρύνηται",1013,236],["κατὰ",32,1],["σοῦ",5,146],["αὐτὸς",3,158],["γὰρ",40,12],["κατὰ",32,1],["τὸ",1,32],["θέλημα",1039,33],["αὐτοῦ",3,48],["ποιήσει",23,120],["καὶ",2,8],["τῇ",1,95],["ἀφροσύνῃ",1401,2],["αὐτοῦ",3,48],["συναπολῇ",2962,116]],"Travel not by the way with a bold fellow, lest he become grievous unto thee: for he will do according to his own will, and thou shalt perish with him through his folly."],["16",[["Μετὰ",29,1],["θυμώδους",3063,153],["μὴ",25,8],["ποιήσῃς",23,170],["μάχην",1382,10],["καὶ",2,8],["μὴ",25,8],["διαπορεύου",1113,249],["μετʼ",29,1],["αὐτοῦ",3,48],["τὴν",1,9],["ἔρημον",160,37],["ὅτι",19,8],["ὡς",36,8],["οὐδὲν",228,29],["ἐν",4,1],["ὀφθαλμοῖς",91,139],["αὐτοῦ",3,48],["αἷμα",148,33],["καὶ",2,8],["ὅπου",1579,17],["οὐκ",12,17],["ἔστι",10,87],["βοήθεια",765,13],["καταβαλεῖ",1074,120],["σε",5,161]],"Strive not with an angry man, and go not with him into a solitary place: for blood is as nothing in his sight; and where there is no help, he will overthrow thee."],["17",[["Μετὰ",29,1],["μωροῦ",1278,153],["μὴ",25,8],["συμβουλεύου",1335,249],["οὐ",12,17],["γὰρ",40,12],["δυνήσεται",185,89],["λόγον",48,7],["στέξαι",8320,100]],"Consult not with a fool; for he cannot keep counsel."],["18",[["Ἐνώπιον",115,1],["ἀλλοτρίου",381,153],["μὴ",25,8],["ποιήσῃς",23,170],["κρυπτὸν",1822,28],["οὐ",12,17],["γὰρ",40,12],["γινώσκεις",79,145],["τί",39,119],["τέξεται",251,89]],"Do no secret thing before a stranger: for thou knowest not what he will bring forth."],["19",[["Παντὶ",11,111],["ἀνθρώπῳ",43,113],["μὴ",25,8],["ἔκφαινε",2825,239],["σὴν",405,10],["καρδίαν",64,10],["καὶ",2,8],["μὴ",25,8],["ἀναφερέτω",384,35],["σοι",5,151],["χάριν",368,10]],"Open not thine heart to every man, lest he requite thee with a shrewd turn."]]