[["1",[["Ἐὰν",45,8],["εὖ",975,17],["ποιῇς",23,199],["γνῶθι",81,198],["τίνι",39,442],["ποιεῖς",23,145],["καὶ",2,8],["ἔσται",10,89],["χάρις",366,13],["τοῖς",1,138],["ἀγαθοῖς",113,215],["σου",5,146]],"When thou wilt do good, know to whom thou doest it; so shalt thou be thanked for thy benefits."],["2",[["Εὐποίησον",3272,243],["εὐσεβεῖ",1246,459],["καὶ",2,8],["εὑρήσεις",106,159],["ἀνταπόδομα",1849,33],["καὶ",2,8],["εἰ",77,8],["μὴ",25,8],["παρʼ",72,1],["αὐτοῦ",3,48],["ἀλλὰ",107,17],["παρὰ",72,1],["ὑψίστου",473,153]],"Do good to the godly man, and thou shalt find a recompence; and if not from him, yet from the most High."],["3",[["Οὐκ",12,17],["ἔστιν",10,87],["ἀγαθὰ",113,65],["τῷ",1,110],["ἐνελεχίζοντι",0,0],["εἰς",8,1],["κακὰ",161,65],["καὶ",2,8],["τῷ",1,110],["ἐλεημοσύνην",943,10],["μὴ",25,8],["χαριζομένῳ",3387,240]],"There can no good come to him that is always occupied in evil, nor to him that giveth no alms."],["4",[["Δὸς",33,198],["τῷ",1,110],["εὐσεβεῖ",1246,111],["καὶ",2,8],["μὴ",25,8],["ἀντιλάβῃ",984,160],["τοῦ",1,30],["ἁμαρτωλοῦ",406,153]],"Give to the godly man, and help not a sinner."],["5",[["Εὐποίησον",3272,243],["τῷ",1,110],["ταπεινῷ",1100,111],["καὶ",2,8],["μὴ",25,8],["δῷς",33,170],["ἀσεβεῖ",246,459],["ἐμπόδισον",3743,198],["τοὺς",1,56],["ἄρτους",197,31],["αὐτοῦ",3,48],["καὶ",2,8],["μὴ",25,8],["δῷς",33,170],["αὐτῷ",3,49],["ἵνα",101,8],["μὴ",25,8],["ἐν",4,1],["αὐτοῖς",3,142],["σε",5,161],["δυναστεύσῃ",2715,116],["διπλάσια",5605,74],["γὰρ",40,12],["κακὰ",161,74],["εὑρήσεις",106,159],["ἐν",4,1],["πᾶσιν",11,215],["ἀγαθοῖς",113,215],["οἷς",24,295],["ἂν",82,12],["ποιήσῃς",23,170],["αὐτῷ",3,49]],"Do well unto him that is lowly, but give not to the ungodly: hold back thy bread, and give it not unto him, lest he overmaster thee thereby: for [else] thou shalt receive twice as much evil for all the good thou shalt have done unto him."],["6",[["Ὅτι",19,8],["καὶ",2,8],["ὁ",1,4],["ὕψιστος",473,16],["ἐμίσησεν",355,3],["ἁμαρτωλούς",406,58],["καὶ",2,8],["τοῖς",1,138],["ἀσεβέσιν",246,215],["ἀποδώσει",311,120],["ἐκδίκησιν",608,10]],"For the most High hateth sinners, and will repay vengeance unto the ungodly, and keepeth them against the mighty day of their punishment."],["7",[["Δὸς",33,198],["τῷ",1,110],["ἀγαθῷ",113,111],["καὶ",2,8],["μὴ",25,8],["ἀντιλάβῃ",984,160],["τοῦ",1,30],["ἁμαρτωλοῦ",406,153]],"Give unto the good, and help not the sinner."],["8",[["Οὐκ",12,17],["ἐκδικηθησεται",700,125],["ἐν",4,1],["ἀγαθοῖς",113,90],["ὁ",1,4],["φίλος",334,16],["καὶ",2,8],["οὐ",12,17],["κρυβήσεται",378,125],["ἐν",4,1],["κακοῖς",161,215],["ὁ",1,4],["ἐχθρός",135,5]],"A friend cannot be known in prosperity: and an enemy cannot be hidden in adversity."],["9",[["Ἐν",4,1],["ἀγαθοῖς",113,90],["ἀνδρὸς",38,21],["οἱ",1,128],["ἐχθροὶ",135,51],["αὐτοῦ",3,48],["ἐν",4,1],["λύπῃ",1076,2],["καὶ",2,8],["ἐν",4,1],["τοῖς",1,138],["κακοῖς",161,215],["αὐτοῦ",3,48],["καὶ",2,8],["ὁ",1,4],["φίλος",334,16],["διαχωρισθήσεται",1673,125]],"In the prosperity of a man enemies will be grieved: but in his adversity even a friend will depart."],["10",[["Μὴ",25,8],["πιστεύσῃς",658,170],["τῷ",1,110],["ἐχθρῷ",135,113],["σου",5,146],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["ὡς",36,8],["γὰρ",40,12],["ὁ",1,4],["χαλκὸς",755,5],["ἰοῦται",4131,108],["οὕτως",70,17],["ἡ",1,11],["πονηρία",729,13],["αὐτοῦ",3,48]],"Never trust thine enemy: for like as iron rusteth, so is his wickedness."],["11",[["Καὶ",2,8],["ἐὰν",45,8],["ταπεινωθῇ",333,337],["καὶ",2,8],["πορεύηται",49,301],["συγκεκυφὼς",5086,265],["ἐπίστησον",623,198],["τὴν",1,9],["ψυχήν",62,10],["σου",5,146],["καὶ",2,8],["φύλαξαι",127,296],["ἀπʼ",17,1],["αὐτοῦ",3,48],["καὶ",2,8],["ἔσῃ",10,116],["αὐτῷ",3,49],["ὡς",36,8],["ἐκμεμαχὼς",0,0],["ἔσοπτρον",6603,20],["καὶ",2,8],["γνώσῃ",81,116],["ὅτι",19,8],["οὐκ",12,17],["εἰς",8,1],["τέλος",369,33],["κατίωσε",7479,3]],"Though he humble himself, and go crouching, yet take good heed and beware of him, and thou shalt be unto him as if thou hadst wiped a looking-glass, and thou shalt know that his rust hath not been altogether wiped away."],["12",[["Μὴ",25,8],["στήσῃς",78,170],["αὐτὸν",3,82],["παρὰ",72,1],["σεαυτὸν",293,82],["μὴ",25,8],["ἀνατρέψας",2818,155],["σε",5,161],["στῇ",78,160],["ἐπὶ",9,1],["τὸν",1,6],["τόπον",99,7],["σου",5,146],["μὴ",25,8],["καθίσης",4898,179],["αὐτὸν",3,82],["ἐκ",21,1],["δεξιῶν",282,79],["σου",5,146],["μήποτε",966,17],["ζητήσῃ",190,160],["τὴν",1,9],["καθέδραν",2089,10],["σου",5,146],["καὶ",2,8],["ἐπʼ",9,1],["ἐσχάτῳ",407,111],["ἐπιγνώσῃ",433,116],["τοὺς",1,56],["λόγους",48,31],["μου",6,48],["καὶ",2,8],["ἐπὶ",9,1],["τῶν",1,44],["ῥημάτων",115,45],["μου",6,48],["κατανυγήσῃ",2588,379]],"Set him not by thee, lest, when he hath overthrown thee, he stand up in thy place; neither let him sit at thy right hand, lest he seek to take thy seat, and thou at the last remember my words, and be pricked therewith."],["13",[["Τίς",39,150],["ἐλεήσει",457,120],["ἐπαοιδὸν",2001,7],["ὀφιόδηκτον",9890,59],["καὶ",2,8],["πάντας",11,58],["τοὺς",1,56],["προσάγοντας",352,229],["θηρίοις",400,92]],"Who will pity a charmer that is bitten with a serpent, or any such as come nigh wild beasts?"],["14",[["Οὕτως",70,17],["τὸν",1,6],["προσπορεύομενον",2044,364],["ἀνδρὶ",38,113],["ἁμαρτωλῷ",406,111],["καὶ",2,8],["συμφυρόμενον",5092,201],["ἐν",4,1],["ταῖς",1,70],["ἁμαρτίαις",119,71],["αὐτοῦ",3,48]],"So one that goeth to a sinner, and is defiled with him in his sins, who will pity?"],["15",[["Ὥραν",839,10],["μετὰ",29,1],["σοῦ",5,146],["διαμενεῖ",1886,120],["καὶ",2,8],["ἐὰν",45,8],["ἐκκλίνῃς",393,170],["οὐ",12,17],["μὴ",25,8],["καρτερήσῃ",2462,116]],"For a while he will abide with thee, but if thou begin to fall, he will not tarry."],["16",[["Καὶ",2,8],["ἐν",4,1],["τοῖς",1,91],["χείλεσιν",361,92],["αὐτοῦ",3,48],["γλυκανεῖ",4749,120],["ὁ",1,4],["ἐχθρὸς",135,5],["καὶ",2,8],["ἐν",4,1],["τῇ",1,95],["καρδία",63,13],["αὐτοῦ",3,48],["βουλεύσεται",637,89],["ἀνατρέψαι",2818,100],["σε",5,161],["εἰς",8,1],["βόθρον",1718,7],["ἐν",4,1],["ὀφθαλμοῖς",91,139],["αὐτοῦ",3,48],["δακρύσει",3053,120],["ὁ",1,4],["ἐχθρὸς",135,5],["καὶ",2,8],["ἐὰν",45,8],["εὕρῃ",106,160],["καιρὸν",132,7],["οὐκ",12,17],["ἐμπλησθήσεται",424,125],["ἀφʼ",17,1],["αἵματος",148,24]],"An enemy speaketh sweetly with his lips, but in his heart he imagineth how to throw thee into a pit: he will weep with his eyes, but if he find opportunity, he will not be satisfied with blood."],["17",[["Κακὰ",161,65],["ἂν",82,12],["ὑπαντήσῃ",4147,116],["σοι",5,151],["εὑρήσεις",106,159],["αὐτὸν",3,82],["ἐκεῖ",76,17],["πρότερόν",495,59],["σου",5,146],["καὶ",2,8],["ὡς",36,8],["βοηθῶν",552,67],["ὑποσχάσει",9989,120],["πτέρναν",2628,10],["σου",5,146]],"If adversity come upon thee, thou shalt find him there first; and though he pretend to help thee, yet shall he undermine thee."],["18",[["Κινήσει",993,120],["τὴν",1,9],["κεφαλὴναὐτοῦ",0,0],["καὶ",2,8],["ἐπικροτήσει",3753,120],["ταῖς",1,70],["χερσὶν",37,71],["αὐτοῦ",3,48],["καὶ",2,8],["πολλὰ",74,65],["διαψιθυρίσει",7073,120],["καὶ",2,8],["ἀλλοιώσει",1289,120],["τὸ",1,32],["πρόσωπον",47,33],["αὐτοῦ",3,48]],"He will shake his head, and clap his hands, and whisper much, and change his countenance."]]