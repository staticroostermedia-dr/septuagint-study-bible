[["1",[["Μακάριος",803,16],["ἀνὴρ",38,5],["ὃς",24,247],["οὐκ",12,17],["ὠλίσθησεν",3222,3],["ἐν",4,1],["στόματι",123,53],["αὐτοῦ",3,48],["καὶ",2,8],["οὐ",12,17],["κατενύγη",2588,38],["ἐν",4,1],["λύπῃ",1076,2],["ἁμαρτίας",119,19]],"Blessed is the man that hath not slipped with his mouth, and is not pricked with the multitude of sins."],["2",[["Μακάριος",803,16],["οὗ",120,17],["οὐ",12,17],["κατέγνω",4264,3],["ἡ",1,11],["ψυχὴ",62,13],["αὐτοῦ",3,48],["καὶ",2,8],["ὃς",24,247],["οὐκ",12,17],["ἔπεσεν",154,3],["ἀπὸ",17,1],["τῆς",1,18],["ἐλπίδος",527,19],["αὐτοῦ",3,48]],"Blessed is he whose conscience hath not condemned him, and who is not fallen from his hope [in the Lord]."],["3",[["Ἀνδρὶ",38,113],["μικρολόγῳ",7747,111],["οὐ",12,17],["καλὸς",264,16],["ὁ",1,4],["πλοῦτος",572,5],["καὶ",2,8],["ἀνθρώπῳ",43,113],["βασκάνῳ",3808,111],["ἱνατί",101,238],["χρήματα",1192,43]],"Riches are not comely for a niggard: and what should an envious man do with money?"],["4",[["Ὁ",1,4],["συνάγων",165,67],["ἀπὸ",17,1],["τῆς",1,18],["ψυχῆς",62,19],["αὐτοῦ",3,48],["συνάγει",165,87],["ἄλλοις",581,300],["καὶ",2,8],["ἐν",4,1],["τοῖς",1,138],["ἀγαθοῖς",113,215],["αὐτοῦ",3,48],["τρυφήσουσιν",2049,355],["ἕτεροι",253,130]],"He that gathereth by defrauding his own soul gathereth for others that shall spend his goods riotously."],["5",[["Ὁ",1,4],["πονηρὸς",164,16],["ἑαυτῷ",92,49],["τίνι",39,442],["ἀγαθὸς",113,16],["ἔσται",10,89],["καὶ",2,8],["οὐ",12,17],["μὴ",25,8],["εὐφρανθήσεται",242,125],["ἐν",4,1],["τοῖς",1,91],["χρήμασιν",1192,92],["αὐτοῦ",3,48]],"He that is evil to himself, to whom will he be good? he shall not take pleasure in his goods."],["6",[["Τοῦ",1,30],["βασκαίνοντος",4182,143],["ἑαυτὸν",92,82],["οὐκ",12,17],["ἔστι",10,87],["πονηρότερος",164,16],["καὶ",2,8],["τοῦτο",16,122],["ἀνταπόδομα",1849,33],["τῆς",1,18],["κακίας",431,19],["αὐτοῦ",3,48]],"There is none worse than he that envieth himself; and this is a recompence of his wickedness."],["7",[["κᾂν",2095,105],["εὐποιῇ",3272,166],["ἐν",4,1],["λήθῃ",1768,166],["ποιεῖ",23,87],["καὶ",2,8],["ἐπʼ",9,1],["ἐσχάτων",407,115],["ἐκφαίνει",2839,87],["τὴν",1,9],["κακίαν",431,10],["αὐτοῦ",3,48]],"And if he doeth good, he doeth it unwillingly; and at the last he will declare his wickedness."],["8",[["Πονηρὸς",164,16],["ὁ",1,4],["βασκαίνων",4182,67],["ὀφθαλμῷ",91,113],["ἀποστρέφων",130,67],["πρόσωπον",47,33],["καὶ",2,8],["ὁ",1,4],["ὑπερορῶν",2558,67],["ψυχάς",62,40]],"The envious man hath a wicked eye; he turneth away his face, and despiseth men."],["9",[["Πλεονέκτου",8042,21],["ὀφθαλμὸς",91,5],["οὐκ",12,17],["ἐμπίπλαται",424,108],["μερίδι",396,2],["καὶ",2,8],["ἀδικία",288,13],["πονηρὰ",164,15],["ἀναξηρανει",4527,120],["ψυχήν",62,10]],"A covetous man's eye is not satisfied with his portion; and the iniquity of the wicked drieth up his soul."],["10",[["Ὀφθαλμὸς",91,5],["πονηρὸς",164,16],["φθονερὸς",8654,16],["ἐπʼ",9,1],["ἄρτῳ",197,113],["καὶ",2,8],["ἐλλιπὴς",9416,16],["ἐπὶ",9,1],["τῆς",1,18],["τραπέζης",644,19],["αὐτοῦ",3,48]],"A wicked eye envieth [his] bread, and he is a niggard at his table."],["11",[["Τέκνον",192,20],["καθὼς",218,17],["ἐὰν",45,8],["ἔχεις",124,145],["εὐποίει",3272,239],["σεαυτόν",293,82],["καὶ",2,8],["προσφορὰς",2384,40],["Κυρίῳ",7,113],["ἀξίως",5237,17],["πρόσαγε",352,239]],"My son, according to thy ability do good to thyself, and give the Lord his due offering."],["12",[["Μνήσθητι",231,242],["ὅτι",19,8],["θάνατος",169,5],["οὐ",12,17],["χρονιεῖ",1744,120],["καὶ",2,8],["διαθήκη",168,13],["ᾅδου",583,21],["οὐχ",12,17],["ὑπεδείχθη",1241,38],["σοι",5,151]],"Remember that death will not be long in coming, and that the covenant of the grave is not shewed unto thee."],["13",[["Πρίν",1227,17],["σε",5,161],["τελευτῆσαι",593,100],["εὐποίει",3272,239],["φίλῳ",334,111],["καὶ",2,8],["κατὰ",32,1],["τὴν",1,9],["ἰσχύν",180,10],["σου",5,146],["ἔκτεινον",419,198],["καὶ",2,8],["δὸς",33,198],["αὐτῷ",3,49]],"Do good unto thy friend before thou die, and according to thy ability stretch out thy hand and give to him."],["14",[["Μὴ",25,8],["ἀφυστερήσῃς",6390,170],["ἀπὸ",17,1],["ἀγαθῆς",113,78],["ἡμέρας",28,19],["καὶ",2,8],["μερὶς",396,13],["ἐπιθυμίας",701,19],["ἀγαθῆς",113,78],["μή",25,8],["σε",5,161],["παρελθάτω",410,46]],"Defraud not thyself of the good day, and let not the part of a good desire overpass thee."],["15",[["Οὐχὶ",326,12],["ἑτέρῳ",253,111],["καταλείψεις",255,159],["τοὺς",1,56],["πόνους",564,31],["σου",5,146],["καὶ",2,8],["τοὺς",1,56],["κόπους",1342,31],["σου",5,146],["εἰς",8,1],["διαίρεσιν",1301,10],["κλήρου",405,21]],"Shalt thou not leave thy travails unto another? and thy labours to be divided by lot?"],["16",[["Δὸς",33,198],["καὶ",2,8],["λάβε",46,198],["καὶ",2,8],["ἀπάτησον",1291,243],["τὴν",1,9],["ψυχήν",62,10],["σου",5,146],["ὅτι",19,8],["οὐκ",12,17],["ἔστιν",10,87],["ἐν",4,1],["ᾅδου",583,21],["ζητῆσαι",190,100],["τρυφήν",1642,10]],"Give, and take, and sanctify thy soul; for there is no seeking of dainties in the grave."],["17",[["Πᾶσα",11,15],["σὰρξ",287,13],["ὡς",36,8],["ἱμάτιον",275,33],["παλαιοῦται",1520,108],["ἡ",1,11],["γὰρ",40,12],["διαθήκη",168,13],["ἀπʼ",17,1],["αἰῶνος",100,21],["θανάτῳ",169,113],["ἀποθανῇ",108,116]],"All flesh waxeth old as a garment: for the covenant from the beginning is, Thou shalt die the death."],["18",[["Ὡς",36,8],["φύλλον",1791,20],["θάλλον",3542,36],["ἐπὶ",9,1],["δένδρου",1339,24],["δασέος",2447,88],["τὰ",1,42],["μὲν",281,12],["καταβάλλει",1075,87],["ἀλλα",107,17],["δὲ",14,12],["φύει",2134,87],["οὕτως",70,17],["γενεὰ",286,13],["σαρκὸς",287,19],["καὶ",2,8],["αἵματος",148,24],["ἡ",1,11],["μὲν",281,12],["τελευτᾷ",593,172],["ἑτέρα",253,15],["δὲ",14,12],["γεννᾶται",222,108]],"As of the green leaves on a thick tree, some fall, and some grow: so is the generation of flesh and blood, one cometh to an end, and another is born."],["19",[["Πᾶν",11,29],["ἔργον",104,33],["σηπόμενον",3150,205],["ἐκλείπει",321,87],["καὶ",2,8],["ὁ",1,4],["ἐργαζόμενος",468,114],["αὐτὸ",3,121],["μετʼ",29,1],["αὐτοῦ",3,48],["ἀπελεύσεται",305,89]],"Every work rotteth and consumeth away, and the worker thereof shall go withal."],["20",[["Μακάριος",803,16],["ἀνὴρ",38,5],["ὃς",24,247],["ἐν",4,1],["σοφίᾳ",238,2],["τελευτήσει",593,120],["καὶ",2,8],["ὃς",24,247],["ἐν",4,1],["συνέσει",467,2],["αὐτοῦ",3,48],["διαλεχθήσεται",3264,125]],"Blessed is the man that doth meditate good things in wisdom, and that reasoneth of holy things by his understanding."],["21",[["ὡ",24,715],["διανοούμενος",1720,114],["τὰς",1,39],["ὁδοὺς",67,40],["αὐτῆς",3,83],["ἐν",4,1],["καρδίᾳ",63,2],["αὐτοῦ",3,48],["καὶ",2,8],["ἐν",4,1],["τοῖς",1,138],["ἀποκρύφοις",1396,450],["αὐτῆς",3,83],["νοηθήσεται",1384,125]],"He that considereth her ways in his heart shall also have understanding in her secrets."],["22",[["Ἔξελθε",84,198],["ὀπίσω",166,17],["αὐτῆς",3,83],["ὡς",36,8],["ἰχνευτὴς",9827,5],["καὶ",2,8],["ἐν",4,1],["ταῖς",1,70],["εἰσόδοις",1002,71],["αὐτῆς",3,83],["ἐνέδρευε",1492,239]],"Go after her as one that traceth, and lie in wait in her ways."],["23",[["Ὁ",1,4],["παρακύπτων",3112,67],["διὰ",54,1],["τῶν",1,123],["θυρίδων",1304,61],["αὐτῆς",3,83],["καὶ",2,8],["ἐπὶ",9,1],["τῶν",1,44],["θυρωμάτων",1625,45],["αὐτῆς",3,83],["ἀκροάσεται",4509,89]],"He that prieth in at her windows shall also hearken at her doors."],["24",[["ὁ",1,4],["καταλύων",861,67],["σύνεγγυς",4446,17],["τοῦ",1,30],["οἴκου",34,21],["αὐτῆς",3,83],["καὶ",2,8],["πήξει",1480,120],["πάσσαλον",1739,7],["ἐν",4,1],["τοῖς",1,138],["τοίχοις",710,139],["αὐτῆς",3,83]],"He that doth lodge near her house shall also fasten a pin in her walls."],["25",[["Στήσει",78,120],["τὴν",1,9],["σκηνὴν",131,10],["αὐτοῦ",3,48],["κατὰ",32,1],["χεῖρας",37,40],["αὐτῆς",3,83],["καὶ",2,8],["καταλύσει",861,120],["ἐν",4,1],["καταλύματι",2464,53],["ἀγαθῶν",113,79]],"He shall pitch his tent nigh unto her, and shall lodge in a lodging where good things are."],["26",[["Θήσει",109,120],["τὰ",1,42],["τέκνα",192,43],["αὐτοῦ",3,48],["ἐν",4,1],["τῇ",1,95],["σκέπῃ",1189,2],["αὐτῆς",3,83],["καὶ",2,8],["ὑπὸ",122,1],["τοὺς",1,56],["κλάδους",1439,31],["αὐτῆς",3,83],["αὐλισθήσεται",991,125]],"He shall set his children under her shelter, and shall lodge under her branches."],["27",[["Σκεπασθήσεται",1212,125],["ὑπʼ",122,1],["αὐτῆς",3,83],["ἀπὸ",17,1],["καύματος",1893,24],["καὶ",2,8],["ἐν",4,1],["τῇ",1,95],["δόξῃ",141,2],["αὐτῆς",3,83],["καταλύσει",861,120]],"By her he shall be covered from heat, and in her glory shall he dwell."]]