[["1",[["Τεκνὸν",192,20],["εἰ",77,8],["προσέρχῃ",529,166],["δουλεύειν",398,54],["Κυρίῳ",7,113],["Θεῷ",20,113],["ἑτοίμασον",371,198],["τὴν",1,9],["ψυχήν",63,10],["σου",5,146],["εἰς",8,1],["πειρασμόν",2281,7]],"My son, if thou come to serve the Lord God, prepare thy soul for temptation."],["2",[["Εὔθυνον",2348,198],["τὴν",1,9],["καρδίαν",64,10],["σου",5,146],["καὶ",2,8],["καρτέρησον",2454,198],["καὶ",2,8],["μὴ",25,8],["σπεύσῃς",846,170],["ἐν",4,1],["καιρῷ",132,113],["ἐπαγωγῆς",2672,19]],"Set thy heart aright, and constantly endure, and make not haste in time of trouble."],["3",[["Κολλήθητι",1246,242],["αὐτῷ",3,49],["καὶ",2,8],["μὴ",25,8],["ἀποστῇς",293,170],["ἵνα",102,8],["αὐξηθῇς",1180,278],["ἐπʼ",9,1],["ἐσχάτων",410,115],["σου",5,146]],"Cleave unto him, and depart not away, that thou mayest be increased at thy last end."],["4",[["Πᾶν",11,29],["ὃ",1,4],["ἐὰν",45,8],["ἐπαχθῇ",417,333],["σοι",5,151],["δέξαι",815,275],["καὶ",2,8],["ἐν",4,1],["ἀλλάγμασι",2816,92],["ταπεινώσεώς",1481,19],["σου",5,146],["μακροθύμησον",2917,198]],"Whatsoever is brought upon thee take cheerfully, and be patient when thou art changed to a low estate."],["5",[["Ὅτι",19,8],["ἐν",4,1],["πυρὶ",118,53],["δοκιμάζεται",1269,108],["χρυσὸς",1602,5],["καὶ",2,8],["ἄνθρωποι",43,51],["δεκτοὶ",1340,130],["ἐν",4,1],["καμίνῳ",1166,2],["ταπεινώσεως",1481,19]],"For gold is tried in the fire, and acceptable men in the furnace of adversity."],["6",[["Πίστευσον",649,198],["αὐτῷ",3,49],["καὶ",2,8],["ἀντιλήψεταί",984,89],["σου",5,146],["εὔθυνον",2348,198],["τὰς",1,39],["ὁδούς",68,40],["σου",5,146],["καὶ",2,8],["ἔλπισον",514,198],["ἐπʼ",9,1],["αὐτόν",3,82]],"Believe in him, and he will help thee; order thy way aright, and trust in him."],["7",[["Οἱ",1,128],["φοβούμενοι",134,351],["τὸν",1,6],["Κύριον",7,7],["ἀναμείνατε",2806,69],["τὸ",1,32],["ἔλεος",183,33],["αὐτοῦ",3,48],["καὶ",2,8],["μὴ",25,8],["ἐκκλίνητε",394,118],["ἵνα",102,8],["μὴ",25,8],["πέσητε",154,118]],"Ye that fear the Lord, wait for his mercy; and go not aside, lest ye fall."],["8",[["Οἱ",1,128],["φοβούμενοι",134,351],["Κύριον",7,7],["πιστεύσατε",649,69],["αὐτῷ",3,49],["καὶ",2,8],["οὐ",12,17],["μὴ",25,8],["πταίσῃ",2187,160],["ὁ",1,4],["μισθὸς",816,5],["ὑμῶν",5,136]],"Ye that fear the Lord, believe him; and your reward shall not fail."],["9",[["Οἱ",1,128],["φοβούμενοι",134,351],["Κύριον",7,7],["ἐλπίσατε",514,69],["εἰς",8,1],["ἀγαθὰ",114,65],["καὶ",2,8],["εἰς",8,1],["εὐφροσύνην",360,10],["αἰῶνος",100,21],["καὶ",2,8],["ἐλέους",183,24]],"Ye that fear the Lord, hope for good, and for everlasting joy and mercy."],["10",[["Ἐμβλέψατε",1862,69],["εἰς",8,1],["ἀρχαίας",1570,109],["γενεὰς",286,40],["καὶ",2,8],["ἴδετε",53,69],["τίς",39,150],["ἐνεπίστευσε",1754,3],["Κυρίῳ",7,113],["καὶ",2,8],["κατῃσχύνθη",696,38],["ἢ",61,8],["τίς",39,150],["ἐνέμεινε",1990,3],["τῷ",1,110],["φόβῳ",333,113],["αὐτοῦ",3,48],["καὶ",2,8],["ἐγκατελείφθη",364,38],["ἢ",61,8],["τίς",39,150],["ἐπεκαλέσατο",341,26],["αὐτὸν",3,82],["καὶ",2,8],["ὑπερεῖδεν",1496,3],["αὐτόν",3,82]],"Look at the generations of old, and see; did ever any trust in the Lord, and was confounded? or did any abide in his fear, and was forsaken? or whom did he ever despise, that called upon him?"],["11",[["Διότι",177,8],["οἰκτίρμων",2102,16],["καὶ",2,8],["ἐλεήμων",1489,16],["ὁ",1,4],["Κύριος",7,5],["καὶ",2,8],["ἀφίησιν",501,87],["ἁμαρτίας",119,19],["καὶ",2,8],["σώζει",172,87],["ἐν",4,1],["καιρῷ",132,113],["θλίψεως",438,19]],"For the Lord is full of compassion and mercy, longsuffering, and very pitiful, and forgiveth sins, and saveth in time of affliction."],["12",[["Οὐαὶ",769,316],["καρδίαις",64,71],["δειλαῖς",2569,287],["καὶ",2,8],["χερσὶ",37,71],["παρειμέναις",2106,358],["καὶ",2,8],["ἁμαρτωλῷ",409,111],["ἐπιβαίνοντι",880,390],["ἐπὶ",9,1],["δύο",104,57],["τρίβους",745,40]],"Woe be to fearful hearts, and faint hands, and the sinner that goeth two ways!"],["13",[["Οὐαὶ",769,316],["καρδίᾳ",64,2],["παρειμένῃ",2106,460],["ὅτι",19,8],["οὐ",12,17],["πιστεύει",649,87],["διὰ",56,1],["τοῦτο",16,122],["οὐ",12,17],["σκεπασθήσεται",1208,125]],"Woe unto him that is fainthearted! for he believeth not; therefore shall he not be defended."],["14",[["Οὐαὶ",769,316],["ὑμῖν",5,86],["τοῖς",1,138],["ἀπολωλεκόσι",217,552],["τὴν",1,9],["ὑπομονὴν",1616,10],["καὶ",2,8],["τί",39,119],["ποιήσετε",23,348],["ὅταν",319,8],["ἐπισκέπτηται",375,297],["ὁ",1,4],["Κύριος",7,5]],"Woe unto you that have lost patience! and what will ye do when the Lord shall visit you?"],["15",[["Οἱ",1,128],["φοβούμενοι",134,351],["Κύριον",7,7],["οὐκ",12,17],["ἀπειθήσουσι",993,207],["ῥημάτων",116,45],["αὐτοῦ",3,48],["καὶ",2,8],["οἱ",1,128],["ἀγαπῶντες",214,137],["αὐτὸν",3,82],["συντηπήσουσι",0,0],["τὰς",1,39],["ὁδοὺς",68,40],["αὐτοῦ",3,48]],"They that fear the Lord will not disobey his word; and they that love him will keep his ways."],["16",[["Οἱ",1,128],["φοβούμενοι",134,351],["Κύριον",7,7],["ζητήσουσιν",191,207],["εὐδοκίαν",1625,10],["αὐτοῦ",3,48],["καὶ",2,8],["οἱ",1,128],["ἀγαπῶντες",214,137],["αὐτὸν",3,82],["ἐμπλησθήσονται",427,135],["τοῦ",1,30],["νόμου",140,21]],"They that fear the Lord will seek that which is wellpleasing unto him; and they that love him shall be filled with the law."],["17",[["Οἱ",1,128],["φοβούμενοι",134,351],["Κύριον",7,7],["ἐτοιμάσουσι",371,0],["καρδίας",64,19],["αὐτῶν",3,41],["καὶ",2,8],["ἐνώπιον",115,1],["αὐτοῦ",3,48],["παπεινώσουσι",0,0],["τὰς",1,39],["ψυχὰς",63,40],["αὐτῶν",3,41]],"They that fear the Lord will prepare their hearts, and humble their souls in his sight,"],["18",[["Ἐμπεσούμεθα",994,132],["εἰς",8,1],["χεῖρας",37,40],["Κυρίου",7,21],["καὶ",2,8],["οὐκ",12,17],["εἰς",8,1],["χεῖρας",37,40],["ἀνθρώπων",43,77],["ὡς",36,8],["γὰρ",40,12],["ἡ",1,11],["μεγαλωσύνη",1473,13],["αὐτοῦ",3,48],["οὕτως",71,17],["καὶ",2,8],["τὸ",1,32],["ἔλεος",183,33],["αὐτοῦ",3,48]],"[saying], We will fall into the hands of the Lord, and not into the hands of men: for as his majesty is, so is his mercy."]]