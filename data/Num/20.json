ῃ",423,116],["διʼ",56,1],["ἐμοῦ",6,48],["καὶ",2,8],["ἐξῆλθεν",82,3],["Ἐδὼμ",0,0],["εἰς",8,1],["συνάντησιν",429,87],["αὐτῷ",3,49],["ἐν",4,1],["ὄχλῳ",1008,113],["βαρεῖ",1031,111],["καὶ",2,8],["ἐν",4,1],["χειρὶ",37,2],["ἰσχυρᾷ",401,96]],"And he said, Thou shalt not pass through me; and Edom went forth to meet him with a great host, and a mighty hand."],["21",[["Καὶ",2,8],["οὐκ",12,17],["ἠθέλησεν",612,3],["Ἐδὼμ",0,0],["δοῦναι",33,100],["τῷ",1,110],["Ἰσραὴλ",27,105],["παρελθεῖν",404,100],["διὰ",56,1],["τῶν",1,44],["ὁρίων",236,45],["αὐτοῦ",3,48],["καὶ",2,8],["ἐξέκλινεν",394,3],["Ἰσραὴλ",27,105],["ἀπʼ",17,1],["αὐτοῦ",3,48]],"So Edom refused to allow Israel to pass through his borders, and Israel turned away from him."],["22",[["Καὶ",2,8],["ἀπῇραν",498,141],["ἐκ",21,1],["Καδης",0,0],["καὶ",2,8],["παρεγένοντο",377,184],["οἱ",1,128],["υἱοὶ",13,51],["Ἰσραὴλ",27,105],["πᾶσα",11,15],["ἡ",1,11],["συναγωγὴ",284,13],["εἰς",8,1],["Ὢρ",985,12],["τὸ",1,32],["ὄρος",87,33]],"And they departed from Cades; and the children of Israel, even the whole congregation, came to Mount Or."],["23",[["Καὶ",2,8],["εἶπε",18,3],["Κύριος",7,5],["πρὸς",15,1],["Μωυσῆν",69,7],["καὶ",2,8],["Ἀαρὼν",159,5],["ἐν",4,1],["Ὢρ",985,12],["τῷ",1,52],["ὄρει",87,53],["ἐπὶ",9,1],["τῶν",1,44],["ὁρίων",236,45],["τῆς",1,18],["γῆς",26,19],["Ἐδὼμ",0,0],["λέγων",31,67]],"And the Lord spoke to Moses and Aaron in mount Or, on the borders of the land of Edom, saying,"],["24",[["προστεθήτω",201,25],["Ἀαρὼν",159,5],["πρὸς",15,1],["τὸν",1,6],["λαὸν",35,7],["αὐτοῦ",3,48],["ὅτι",19,8],["οὐ",12,17],["μὴ",25,8],["εἰσέλθητε",86,118],["εἰς",8,1],["τὴν",1,9],["γῆν",26,10],["ἣν",24,124],["δέδωκα",33,85],["τοῖς",1,138],["υἱοῖς",13,139],["Ἰσραήλ",27,105],["διότι",177,8],["παρωξύνατέ",1044,262],["με",6,82],["ἐπὶ",9,1],["τοῦ",1,23],["ὕδατος",85,24],["τῆς",1,18],["λοιδορίας",3290,19]],"Let Aaron be added to his people; for ye shall certainly not go into the land which I have given the children of Israel, because ye provoked me at the water of 