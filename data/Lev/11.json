],["θνησιμαίων",1344,163],["αὐτῶν",3,41],["ἐπʼ",9,1],["αὐτό",3,121],["ἀκάθαρτόν",374,29],["ἐστιν",10,87],["ὑμῖν",5,86]],"But if water be poured on any seed, and one of their dead bodies fall upon it, it is unclean to you."],["39",[["Ἐὰν",45,8],["δὲ",14,12],["ἀποθάνῃ",109,160],["τῶν",1,44],["κτηνῶν",223,45],["ὅ",1,4],["ἐστιν",10,87],["ὑμῖν",5,86],["φαγεῖν",269,100],["τοῦτο",16,122],["ὁ",1,4],["ἁπτόμενος",465,114],["τῶν",1,76],["θνησιμαίων",1344,163],["αὐτῶν",3,41],["ἀκάθαρτος",374,16],["ἔσται",10,89],["ἕως",42,8],["ἑσπέρας",488,19]],"And if one of the cattle die, which it is lawful for you to eat, he that touches their carcases shall be unclean till evening."],["40",[["καὶ",2,8],["ὁ",1,4],["ἐσθίων",147,67],["ἀπὸ",17,1],["τῶν",1,76],["θνησιμαίων",1344,163],["τούτων",16,220],["πλυνεῖ",967,120],["τὰ",1,42],["ἱμάτια",276,43],["καὶ",2,8],["ἀκάθαρτος",374,16],["ἔσται",10,89],["ἕως",42,8],["ἑσπέρας",488,19],["καὶ",2,8],["ὁ",1,4],["αἴρων",206,67],["ἀπὸ",17,1],["θνησιμαίων",1344,115],["αὐτῶν",3,189],["πλυνεῖ",967,120],["τὰ",1,42],["ἱμάτια",276,43],["καὶ",2,8],["λούσεται",1042,89],["ὕδατι",85,53],["καὶ",2,8],["ἀκάθαρτος",374,16],["ἔσται",10,89],["ἕως",42,8],["ἑσπέρας",488,19]],"And he that eats of their carcases shall wash his garments, and be unclean till evening; and he that carries any of their carcases shall wash his garments, and bathe himself in water, and be unclean till evening."],["41",[["Καὶ",2,8],["πᾶν",11,29],["ἑρπετὸν",1107,33],["ὃ",1,4],["ἕρπει",2426,87],["ἐπὶ",9,1],["τῆς",1,18],["γῆς",26,19],["βδέλυγμα",476,33],["ἔσται",10,89],["τοῦτο",16,122],["ὑμῖν",5,86],["οὐ",12,17],["βρωθήσεται",1111,125]],"And every reptile that creeps on the earth, this shall be an abomination to you; it shall not be eaten."],["42",[["Καὶ",2,8],["πᾶς",11,16],["ὁ",1,4],["πορευόμενος",49,114],["ἐπὶ",9,1],["κοιλίας",547,19],["καὶ",2,8],["πᾶς",11,16],["ὁ",1,4],["πορευόμενος",49,114],["ἐπὶ",9,1],["τέσσαρα",306,74],["διαπαντός",510,17],["ὃ",1,4],["πολυπληθεῖ",4995,87],["ποσὶν",210,139],["ἐν",4,1],["πᾶσι",11,215],["τοῖς",1,138],["ἑρπετοῖς",1107,92],["τοῖς",1,91],["ἕρπουσιν",2426,471],["ἐπὶ",9,1],["τῆς",1,18],["γῆς",26,19],["οὐ",12,17],["φάγεσθε",147,117],["αὐτὸ",3,121],["ὅτι",19,8],["βδέλυγμα",476,33],["ὑμῖν",5,86],["ἐστι",10,87]],"And every [animal] that creeps on its belly, and every one that goes on four [feet] continually, which abounds with feet among all the reptiles creeping upon the earth—ye shall not eat it, for it is an abomination to you."],["43",[["Καὶ",2,8],["οὐ",12,17],["μὴ",25,8],["βδελύξητε",0,0],["τὰς",1,39],["ψυχὰς",63,40],["ὑμῶν",5,136],["ἐν",4,1],["πᾶσι",11,90],["τοῖς",1,91],["ἑρπετοῖς",1107,92],["τοῖς",1,91],["ἕρπουσιν",2426,471],["ἐπὶ",9,1],["τῆς",1,18],["γῆς",26,19],["καὶ",2,8],["οὐ",12,17],["μιανθήσεσθε",468,258],["ἐν",4,1],["τούτοις",16,416],["καὶ",2,8],["οὐκ",12,17],["ἀκάθαρτοι",374,130],["ἔσεσθε",10,117],["ἐν",4,1],["αὐτοῖς",3,142]],"And ye shall not defile your souls with any of the reptiles that creep upon the earth, and ye shall not be polluted with them, and ye shall not be unclean by them."],["44",[["ὅτι",19,8],["ἐγώ",6,158],["εἰμι",10,149],["Κύριος",7,5],["ὁ",1,4],["Θεὸς",20,5],["ὑμῶν",5,136],["καὶ",2,8],["ἁγιασθήσεσθε",329,258],["καὶ",2,8],["ἅγιοι",75,130],["ἔσεσθε",10,117],["ὅτι",19,8],["ἅγιός",75,16],["εἰμι",10,149],["ἐγὼ",6,158],["Κύριος",7,5],["ὁ",1,4],["Θεὸς",20,5],["ὑμῶν",5,136],["καὶ",2,8],["οὐ",12,17],["μιανεῖτε",468,348],["τὰς",1,39],["ψυχὰς",63,40],["ὑμῶν",5,136],["ἐν",4,1],["πᾶσι",11,90],["τοῖς",1,91],["ἑρπετοῖς",1107,92],["τοῖς",1,91],["κινουμένοις",992,343],["ἐπὶ",9,1],["τῆς",1,18],["γῆς",26,19]],"For I am the Lord your God; and ye shall be sanctified, and ye shall be holy, because I the Lord your God am holy; and ye shall not defile your souls with any of the reptiles creeping upon the earth."],["45",[["ὅτι",19,8],["ἐγώ",6,158],["εἰμι",10,149],["Κύριος",7,5],["ὁ",1,4],["ἀναγαγὼν",524,155],["ὑμᾶς",5,209],["ἐκ",21,1],["γῆς",26,19],["Αἰγύπτου",93,19],["εἶναι",10,54],["ὑμῶν",5,136],["Θεός",20,5],["καὶ",2,8],["ἔσεσθε",10,117],["ἅγιοι",75,130],["ὅτι",19,8],["ἅγιός",75,16],["εἰμι",10,149],["ἐγὼ",6,158],["Κύριος",7,5]],"For I am the Lord who brought you up out of the land of Egypt to be your God; and ye shall be holy, for I the Lord am holy."],["46",[["Οὗτος",16,112],["ὁ",1,4],["νόμος",140,5],["περὶ",72,1],["τῶν",1,44],["κτηνῶν",223,45],["καὶ",2,8],["τῶν",1,44],["πετεινῶν",572,45],["καὶ",2,8],["πάσης",11,78],["ψυχῆς",63,19],["τῆς",1,18],["κινουμένης",992,428],["ἐν",4,1],["τῷ",1,52],["ὕδατι",85,53],["καὶ",2,8],["πάσης",11,78],["ψυχῆς",63,19],["ἑρπούσης",2426,212],["ἐπὶ",9,1],["τῆς",1,18],["γῆς",26,19]],"This is the law concerning beasts and birds and every living creature moving in the water, and every living creature creeping on the earth;"],["47",[["διαστεῖλαι",905,100],["ἀναμέσον",215,28],["τῶν",1,76],["ἀκαθάρτων",374,163],["καὶ",2,8],["ἀναμέσον",215,28],["τῶν",1,76],["καθαρῶν",379,163],["καὶ",2,8],["ἀναμέσον",215,28],["τῶν",1,76],["ζωογονούντων",2716,164],["τὰ",1,42],["ἐσθιόμενα",147,203],["καὶ",2,8],["ἀναμέσον",215,28],["τῶν",1,76],["ζωογονούντων",2716,164],["τὰ",1,42],["μὴ",25,8],["ἐσθιόμενα",147,203]],"to distinguish between the unclean and the clean; and between those that bring forth alive, such as should be eaten, and those that bring forth alive, such as should not be eaten."]]