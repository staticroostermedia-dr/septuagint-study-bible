],["ἅγιον",75,28],["ἔσται",10,89],["ὑμῖν",5,86],["ἀπὸ",17,1],["τῶν",1,44],["πεδίων",349,45],["φάγεσθε",147,117],["τὰ",1,42],["γεννήματα",742,43],["αὐτῆς",3,83]],"For it is a jubilee of release; it shall be holy to you, ye shall eat its fruits off the fields."],["13",[["Ἐν",4,1],["τῷ",1,52],["ἔτει",81,53],["τῆς",1,18],["ἀφέσεως",986,19],["σημασίας",1639,19],["αὐτῆς",3,83],["ἐπανελεύσεται",3440,89],["εἰς",8,1],["τὴν",1,9],["ἔγκτησιν",5355,10],["αὐτοῦ",3,48]],"In the year of the release [even] the jubilee of it, shall [each] one return to his possession."],["14",[["Ἐὰν",45,8],["δὲ",14,12],["ἀποδῷ",312,160],["πράσιν",1782,10],["τῷ",1,110],["πλησίον",292,17],["σου",5,146],["ἐὰν",45,8],["δὲ",14,12],["καὶ",2,8],["κτήσῃ",564,116],["παρὰ",73,1],["τοῦ",1,30],["πλησίον",292,17],["σου",5,146],["μὴ",25,8],["θλιβέτω",601,35],["ἄνθρωπος",43,5],["τὸν",1,6],["πλησίον",292,17]],"And if thou shouldest sell a possession to thy neighbour, or if thou shouldest buy of thy neighbour, let not a man oppress his neighbour."],["15",[["Κατὰ",32,1],["ἀριθμὸν",355,7],["ἐτῶν",81,45],["μετὰ",29,1],["τὴν",1,9],["σημασίαν",1639,10],["κτήσῃ",564,116],["παρὰ",73,1],["τοῦ",1,30],["πλησίον",292,17],["κατὰ",32,1],["ἀριθμὸν",355,7],["ἐνιαυτῶν",400,77],["γεννημάτων",742,45],["ἀποδώσεταί",312,89],["σοι",5,151]],"According to the number of years after the jubilee shalt thou buy of thy neighbour, according to the number of years of the fruits shall he sell to thee."],["16",[["Καθότι",826,17],["ἂν",83,12],["πλεῖον",938,29],["τῶν",1,44],["ἐτῶν",81,45],["πληθυνεῖ",316,120],["τὴν",1,9],["ἔγκτησιν",5355,10],["αὐτοῦ",3,48],["καὶ",2,8],["καθότι",826,17],["ἂν",83,12],["ἔλαττον",1931,29],["τῶν",1,44],["ἐτῶν",81,45],["ἐλαττονώσει",3187,120],["τὴν",1,9],["ἔγκτησιν",5355,10],["αὐτοῦ",3,48],["ὅτι",19,8],["ἀριθμὸν",355,7],["γεννημάτων",742,45],["αὐτοῦ",3,48],["οὕτως",71,17],["ἀποδώσεταί",312,89],["σοι",5,151]],"According as [there may be] a greater number of years he shall increase [the value of] his possession, and accordi