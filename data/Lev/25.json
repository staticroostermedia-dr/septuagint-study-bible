,1899,43],["αὐτοῦ",3,48],["ὡς",36,8],["μισθωτός",1826,5]],"And if but a little time be left of the years to the year of release, then shall he reckon to him according to his years, and shall pay his ransom"],["53",[["ἐνιαυτὸς",400,5],["ἐξ",21,1],["ἐνιαυτοῦ",400,21],["ἔσται",10,89],["μετʼ",29,1],["αὐτοῦ",3,48],["οὐ",12,17],["κατατενεῖς",3854,159],["αὐτὸν",3,82],["ἐν",4,1],["τῷ",1,110],["μόχθῳ",1144,113],["ἐνώπιόν",115,1],["σου",5,146]],"as a hireling; he shall be with him from year to year; thou shalt not oppress him with labour before thee."],["54",[["Ἐὰν",45,8],["δὲ",14,12],["μὴ",25,8],["λυτρῶται",535,297],["κατὰ",32,1],["ταῦτα",16,248],["ἐξελεύσεται",82,89],["ἐν",4,1],["τῷ",1,52],["ἔτει",81,53],["τῆς",1,18],["ἀφέσεως",986,19],["αὐτὸς",3,158],["καὶ",2,8],["τὰ",1,42],["παιδία",449,43],["αὐτοῦ",3,48],["μετʼ",29,1],["αὐτοῦ",3,48]],"And if he do not pay his ransom accordingly, he shall go out in the year of his release, he and his children with him."],["55",[["Ὅτι",19,8],["ἐμοὶ",6,49],["οἱ",1,128],["υἱοὶ",13,51],["Ἰσραὴλ",27,105],["οἰκέται",951,51],["εἰσὶ",10,191],["παῖδές",127,51],["μου",6,48],["οὗτοί",16,213],["εἰσιν",10,191],["οὓς",24,294],["ἐξήγαγον",295,141],["ἐκ",21,1],["γῆς",26,19],["Αἰγύπτου",93,19]],"For the children of Israel are my servants: they are my attendants, whom I brought out of the land of Egypt."]]