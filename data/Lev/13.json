"λεπρός",2265,16],["ἐστι",10,87],["μιάνσει",7735,188],["μιανεῖ",468,120],["αὐτὸν",3,82],["ὁ",1,4],["ἱερεὺς",65,5],["ἐν",4,1],["τῇ",1,95],["κεφαλῇ",144,2],["αὐτοῦ",3,48],["ἡ",1,11],["ἁφὴ",761,13],["αὐτοῦ",3,48]],"he is a leprous man: the priest shall surely pronounce him unclean, his plague is in his head."],["45",[["Καὶ",2,8],["ὁ",1,4],["λεπρὸς",2265,16],["ἐν",4,1],["ᾧ",24,202],["ἐστιν",10,87],["ἡ",1,11],["ἁφὴ",761,13],["τὰ",1,42],["ἱμάτια",276,43],["αὐτοῦ",3,48],["ἔστω",10,35],["παραλελυμένα",1735,381],["καὶ",2,8],["ἡ",1,11],["κεφαλὴ",144,13],["αὐτοῦ",3,48],["ἀκάλυπτος",4488,15],["καὶ",2,8],["περὶ",72,1],["τὸ",1,32],["στόμα",123,33],["αὐτοῦ",3,48],["περιβαλέσθω",744,312],["καὶ",2,8],["ἀκάθαρτος",374,16],["κεκλήσεται",128,394]],"And the leper in whom the plague is, let his garments be ungirt, and his head uncovered; and let him have a covering put upon his mouth, and he shall be called unclean."],["46",[["Πάσας",11,109],["τὰς",1,39],["ἡμέρας",28,19],["ὅσας",103,40],["ἐὰν",45,8],["ᾖ",10,173],["ἐπʼ",9,1],["αὐτὸν",3,82],["ἡ",1,11],["ἁφὴ",761,13],["ἀκάθαρτος",374,15],["ὢν",10,67],["ἀκάθαρτος",374,16],["ἔσται",10,89],["κεχωρισμένος",1647,408],["καθήσεται",1272,89],["ἔξω",527,17],["τῆς",1,18],["παρεμβολῆς",190,19],["αὐτοῦ",3,48],["ἔσται",10,89],["ἡ",1,11],["διατριβή",3813,13]],"All the days in which the plague shall be upon him, being unclean, he shall be [esteemed] unclean; he shall dwell apart, his place of sojourn shall be without the camp."],["47",[["Καὶ",2,8],["ἱματίῳ",276,53],["ἐὰν",45,8],["γένηται",30,236],["ἁφὴ",761,13],["ἐν",4,1],["αὐτῷ",3,49],["λέπρας",1631,145],["ἐν",4,1],["ἱματίῳ",276,53],["ἐρέῳ",9598,34],["ἢ",61,8],["ἐν",4,1],["ἱματίῳ",276,53],["στυππυίνῳ",0,0]],"And if a garment have in it the plague of leprosy, a garment of wool, or a garment of flax,"],["48",[["ἢ",61,8],["ἐν",4,1],["στήμονι",2774,113],["ἢ",61,8],["ἐν",4,1],["κρόκῃ",2732,2],["ἢ",61,8],["ἐν",4,1],["τοῖς",1,138],["λινοῖς",2093,215],["ἢ",61,8],["ἐν",4,1],["τοῖς",1,138],["ἐρέοις",165,472],["ἢ",