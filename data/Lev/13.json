,10,87],["ἡ",1,11],["ἁφή",761,13]],"And if it should still appear in the garment, either in the warp or in the woof, or in any article of skin, it is a leprosy bursting forth: that wherein is the plague shall be burnt with fire."],["58",[["Καὶ",2,8],["τὸ",1,32],["ἱμάτιον",276,33],["ἢ",61,8],["ὁ",1,4],["στήμων",2774,5],["ἢ",61,8],["ἡ",1,11],["κρόκη",2732,13],["ἢ",61,8],["πᾶν",11,29],["σκεῦος",182,33],["δερμάτινον",2255,29],["ὃ",1,4],["πλυθήσεται",967,125],["καὶ",2,8],["ἀποστήσεται",293,89],["ἀπʼ",17,1],["αὐτοῦ",3,48],["ἡ",1,11],["ἁφὴ",761,13],["καὶ",2,8],["πλυθήσεται",967,125],["τὸ",1,32],["δέυτερον",271,29],["καὶ",2,8],["καθαρὸν",379,29],["ἔσται",10,89]],"And the garment, or the warp, or the woof, or any article of skin, which shall be washed, and the plague depart from it, shall also be washed again, and shall be clean."],["59",[["Οὗτος",16,112],["ὁ",1,4],["νόμος",140,5],["ἁφῆς",761,19],["λέπρας",1631,145],["ἱματίου",276,24],["ἐρέου",667,355],["ἢ",61,8],["στυππυίνου",0,0],["ἢ",61,8],["στήμονος",2774,21],["ἢ",61,8],["κρόκης",2732,19],["ἢ",61,8],["παντὸς",11,88],["σκεύους",182,24],["δερματίνου",2255,88],["εἰς",8,1],["τὸ",1,32],["καθαρίσαι",482,100],["αὐτὸ",3,121],["ἢ",61,8],["μιᾶναι",468,100],["αὐτό",3,121]],"This is the law of the plague of leprosy of a woollen or linen garment, either of the warp, or woof, or any leathern article, to pronounce it clean or unclean."]]