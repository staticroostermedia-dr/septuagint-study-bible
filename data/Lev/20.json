f any one should lie with his daughter-in-law, let them both be put to death; for they have wrought impiety, they are guilty."],["13",[["Καὶ",2,8],["ὃς",24,246],["ἂν",83,12],["κοιμηθῇ",301,333],["μετὰ",29,1],["ἄρσενος",914,237],["κοίτην",704,10],["γυναικὸς",59,19],["βδέλυγμα",476,33],["ἐποίησαν",23,141],["ἀμφότεροι",459,130],["θανάτῳ",170,113],["θανατούσθωσαν",382,72],["ἔνοχοι",1870,130],["εἰσιν",10,191]],"And whoever shall lie with a male as with a woman, they have both wrought abomination; let them die the death, they are guilty."],["14",[["Ὃς",24,246],["ἂν",83,12],["λάβῃ",46,160],["γυναῖκα",59,10],["καὶ",2,8],["τὴν",1,9],["μητέρα",189,10],["αὐτῆς",3,83],["ἀνόμημά",2212,20],["ἐστιν",10,87],["ἐν",4,1],["πυρὶ",118,53],["κατακαύσουσιν",554,207],["αὐτὸν",3,82],["καὶ",2,8],["αὐτὰς",3,221],["καὶ",2,8],["οὐκ",12,17],["ἔσται",10,89],["ἀνομία",275,13],["ἐν",4,1],["ὑμῖν",5,86]],"Whosoever shall take a woman and her mother, it is iniquity: they shall burn him and them with fire; so there shall not be iniquity among you."],["15",[["Καὶ",2,8],["ὃς",24,246],["ἂν",83,12],["δῷ",33,160],["κοιτασίαν",7488,10],["αὐτοῦ",3,48],["ἐν",4,1],["τετράποδι",1641,111],["θανάτῳ",170,113],["θανάτούσθω",382,340],["καὶ",2,8],["τὸ",1,32],["τετράπουν",1641,59],["ἀποκτενεῖτε",300,348]],"And whosoever shall lie with a beast, let him die the death; and ye shall kill the beast."],["16",[["Καὶ",2,8],["γυνὴ",59,13],["ἥτις",457,421],["προσελεύσεται",529,89],["πρὸς",15,1],["πᾶν",11,29],["κτῆνος",223,33],["βιβασθῆναι",5494,175],["αὐτὴν",3,98],["ὑπʼ",122,1],["αὐτοὺ",3,144],["ἀποκτενεῖτε",300,348],["τὴν",1,9],["γυναῖκα",59,10],["καὶ",2,8],["τὸ",1,32],["κτῆνος",223,33],["θανάτῳ",170,113],["θανατούσθωσαν",382,72],["ἔνοχοί",1870,130],["εἰσιν",10,191]],"And whatever woman shall approach any beast, so as to have connexion with it, ye shall kill the woman and the beast: let them die the death, they are guilty."],["17",[["Ὃς",24,246],["ἂν",83,12],["λάβῃ",46,160],["τὴν",1,9],["ἀδελφὴν",521,10],["αὐτοῦ",3,48],["ἐκ",21,1],["πατρὸς",44,21],["αὐτοῦ",3,48],["ἢ",61,8],["ἐκ",21,1],["μητρὸς",189,19],["αὐτοῦ",3,48],["καὶ",2,8],["ἴδῃ",53,160],["τὴν",1,9],["ἀσχημοσύνην",1082,10],["αὐτῆς",3,83],["καὶ",2,8],["αὕτη",16,101],["ἴδῃ",53,160],["τὴν",1,9],["ἀσχημοσύνην",1082,10],["αὐτοῦ",3,48],["ὄνειδός",973,33],["ἐστιν",10,87],["ἐξολοθρευθήσονται",291,135],["ἐνωπιον",3000,1],["υἱῶν",13,77],["γένους",519,24],["αὐτῶν",3,41],["ἀσχημοσύνην",1082,10],["ἀδελφῆς",521,19],["αὐτοῦ",3,48],["ἀπεκάλυψεν",652,3],["ἁμαρτίαν",119,10],["κομιοῦνται",1592,127]],"Whosoever shall take his sister by his father or by his mother, and shall see her nakedness, and she see his nakedness, it is a reproach: they shall be destroyed before the children of their family; he has uncovered his sister's nakedness, they shall bear their sin."],["18",[["Καὶ",2,8],["ἀνὴρ",38,5],["ὃς",24,246],["ἂν",83,12],["κοιμηθῇ",301,333],["μετὰ",29,1],["γυναικὸς",59,19],["ἀποκαθημένης",3170,477],["καὶ",2,8],["ἀποκαλύψῃ",652,116],["τὴν",1,9],["ἀσχημοσύνην",1082,10],["αὐτῆς",3,83],["τὴν",1,9],["πηγὴν",565,10],["αὐτῆς",3,83],["ἀπεκάλυψε",652,3],["καὶ",2,8],["αὕτη",16,101],["ἀπεκάλυψε",652,3],["τὴν",1,9],["ῥύσιν",1948,10],["τοῦ",1,23],["αἵματος",148,24],["αὐτῆς",3,83],["ἐξολοθρευθήσονται",291,135],["ἀμφότεροι",459,130],["ἐκ",21,1],["τῆς",1,18],["γενεᾶς",286,19],["αὐτῶν",3,41]],"And whatever man shall lie with a woman that is set apart [for a flux], and shall uncover her nakedness, he has uncovered her fountain, and she has uncovered the flux of her blood: they shall both be destroyed from among their generation."],["19",[["Καὶ",2,8],["ἀσχημοσύνην",1082,10],["ἀδελφῆς",521,19],["πατρὸς",44,21],["σου",5,146],["καὶ",2,8],["ἀδελφῆς",521,19],["μητρός",189,19],["σου",5,146],["οὐκ",12,17],["ἀποκαλύψεις",1453,40],["τὴν",1,9],["γὰρ",40,12],["οἰκειότητα",7796,10],["ἀπεκάλυψεν",652,3],["ἁμαρτίαν",119,10],["ἀποίσονται",1396,127]],"And thou shalt not uncover the nakedness of thy father's sister, or of the sister of thy mother; for that man has uncovered the nakedness of one near akin: they shall bear their iniquity."],["20",[["Ὃς",24,246],["ἂν",83,12],["κοιμηθῇ",301,333],["μετὰ",29,1],["τῆς",1,18],["συγγενοῦς",1741,78],["αὐτοῦ",3,48],["ἀσχημοσύνην",1082,10],["τῆς",1,18],["συγγενείας",1312,19],["αὐτοῦ",3,48],["ἀπεκάλυψεν",652,3],["ἄτεκνοι",3722,130],["ἀποθανοῦνται",109,127]],"Whosoever shall lie with his near kinswoman, has uncovered the nakedness of one near akin to him: they shall die childless."],["21",[["Ὃς",24,246],["ἐὰς",1406,0],["λάβῃ",46,160],["γυναῖκα",59,10],["τοῦ",1,30],["ἀδελφοῦ",67,21],["αὐτοῦ",3,48],["ἀκαθαρσία",888,13],["ἐστίν",10,87],["ἀσχημοσύνην",1082,10],["τοῦ",1,30],["ἀδελφοῦ",67,21],["αὐτοῦ",3,48],["ἀπεκάλυψεν",652,3],["ἄτεκνοι",3722,130],["ἀποθανοῦνται",109,127]],"Whoever shall take his brother's wife, it is uncleanness; he has uncovered his brother's nakedness; they shall die childless."],["22",[["Καὶ",2,8],["φυλάξασθε",125,268],["πάντα",11,65],["τὰ",1,42],["προστάγματά",393,43],["μου",6,48],["καὶ",2,8],["τὰ",1,42],["κρίματά",267,43],["μου",6,48],["καὶ",2,8],["ποιήσετε",23,348],["αὐτὰ",3,66],["καὶ",2,8],["οὐ",12,17],["μὴ",25,8],["προσοχθίσῃ",1780,116],["ὑμῖν",5,86],["ἡ",1,11],["γῆ",26,13],["εἰς",8,1],["ἣν",24,124],["ἐγὼ",6,158],["εἰσάγω",389,149],["ὑμᾶς",5,209],["ἐκεῖ",76,17],["κατοικεῖν",89,54],["ἐπʼ",9,1],["αὐτῆς",3,83]],"And keep ye all my ordinances, and my judgments; and ye shall do them, and the land shall not be aggrieved with you, into which I bring you to dwell upon it."],["23",[["Καὶ",2,8],["οὐχὶ",330,12],["πορεύεσθε",49,382],["τοῖς",1,138],["νομίμοις",705,215],["τῶν",1,44],["ἐθνῶν",60,45],["οὓς",24,294],["ἐξαποστέλλω",220,149],["ἀφʼ",17,1],["ὑμῶν",5,136],["ὅτι",19,8],["ταῦτα",16,248],["πάντα",11,65],["ἐποίησαν",23,141],["καὶ",2,8],["ἐβδελυξάμην",1056,325],["αὐτούς",3,60]],"And walk ye not in the customs of the nations which I drive out from before you; for they have done all these things, and I have abhorred them:"],["24",[["Καὶ",2,8],["εἶπα",18,147],["ὑμῖν",5,86],["ὑμεῖς",5,208],["κληρονομήσ