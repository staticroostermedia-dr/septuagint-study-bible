[["1",[["Καὶ",2,8],["εἶπε",18,3],["Κύριος",7,5],["πρὸς",15,1],["Μωυσῆν",69,7],["λέγων",31,67]],"And the Lord spoke to Moses, saying,"],["2",[["λάλησον",50,198],["τοῖς",1,138],["υἱοῖς",13,139],["Ἰσραὴλ",27,105],["καὶ",2,8],["ἐρεῖς",165,159],["πρὸς",15,1],["αὐτοὺς",3,60],["ἐγὼ",6,158],["Κύριος",7,5],["ὁ",1,4],["Θεὸς",20,5],["ὑμῶν",5,136]],"Speak to the children of Israel, and thou shalt say to them, I [am] the Lord your God."],["3",[["Κατὰ",32,1],["τὰ",1,42],["ἐπιτηδεύματα",903,43],["Αἰγύπτου",93,19],["ἐν",4,1],["ᾗ",24,102],["κατῳκήσατε",89,262],["ἐπʼ",9,1],["αὐτῇ",3,99],["οὐ",12,17],["ποιήσετε",23,348],["καὶ",2,8],["κατὰ",32,1],["τὰ",1,42],["ἐπιτηδεύματα",903,43],["γῆς",26,19],["Χαναὰν",544,105],["εἰς",8,1],["ἣν",24,124],["ἐγὼ",6,158],["εἰσάγω",389,149],["ὑμᾶς",5,209],["ἐκεῖ",76,17],["οὐ",12,17],["ποιήσετε",23,348],["καὶ",2,8],["τοῖς",1,138],["νομίμοις",705,215],["αὐτῶν",3,41],["οὐ",12,17],["πορεύσεσθε",49,117]],"Ye shall not do according to the devices of Egypt, in which ye dwelt: and according to the devices of the land of Chanaan, into which I bring you, ye shall not do; and ye shall not walk in their ordinances."],["4",[["Τὰ",1,42],["κρίματά",267,43],["μου",6,48],["ποιήσετε",23,348],["καὶ",2,8],["τὰ",1,42],["προστάγματά",393,43],["μου",6,48],["φυλάξεσθε",125,117],["καὶ",2,8],["πορεύεσθε",49,382],["ἐν",4,1],["αὐτοῖς",3,142],["ἐγὼ",6,158],["Κύριος",7,5],["ὁ",1,4],["Θεὸς",20,5],["ὑμῶν",5,136]],"Ye shall observe my judgments, and shall keep my ordinances, and shall walk in them: I [am] the Lord your God."],["5",[["Καὶ",2,8],["φυλάξεσθε",125,117],["πάντα",11,65],["τὰ",1,42],["προστάγματά",393,43],["μου",6,48],["καὶ",2,8],["πάντα",11,65],["τὰ",1,42],["κρίματά",267,43],["μου",6,48],["καὶ",2,8],["ποιήσετε",23,348],["αὐτά",3,66],["ἃ",1,11],["ποιήσας",23,155],["αὐτὰ",3,66],["ἄνθρωπος",43,5],["ζήσεται",107,89],["ἐν",4,1],["αὐτοῖς",3,142],["ἐγὼ",6,158],["Κύριος",7,5],["ὁ",1,4],["Θεὸς",20,5],["ὑμῶν",5,136]],"So ye shall keep all my ordinances, and all my judgments, and do them; which if a man do, he shall live in them: I [am] the Lord your God."],["6",[["Ἄνθρωπος",43,5],["ἄνθρωπος",43,5],["πρὸς",15,1],["πάντα",11,65],["οἰκεῖα",1967,65],["σαρκὸς",287,19],["αὐτοῦ",3,48],["οὐ",12,17],["προσελεύσεται",529,89],["ἀποκαλύψαι",652,100],["ἀσχημοσύνην",1082,10],["ἐγὼ",6,158],["Κύριος",7,5]],"No man shall draw nigh to any of his near kindred to uncover their nakedness; I [am] the Lord."],["7",[["Ἀσχημοσύνην",1082,10],["πατρός",44,21],["σου",5,146],["καὶ",2,8],["ἀσχημοσύνην",1082,10],["μητρός",189,19],["σου",5,146],["οὐκ",12,17],["ἀποκαλύψεις",1453,40],["μήτηρ",189,13],["γάρ",40,12],["σου",5,146],["ἐστὶν",10,87],["οὐκ",12,17],["ἀποκαλύψεις",1453,40],["τὴν",1,9],["ἀσχημοσύνην",1082,10],["αὐτῆς",3,83]],"Thou shalt not uncover the nakedness of thy father, or the nakedness of thy mother, for she is thy mother; thou shalt not uncover her nakedness."],["8",[["Ἀσχημοσύνην",1082,10],["γυναικὸς",59,19],["πατρός",44,21],["σου",5,146],["οὐκ",12,17],["ἀποκαλύψεις",1453,40],["ἀσχημοσύνη",1082,13],["πατρός",44,21],["σου",5,146],["ἐστίν",10,87]],"Thou shalt not uncover the nakedness of thy father's wife; it is thy father's nakedness."],["9",[["Ἀσχημοσύνην",1082,10],["τῆς",1,18],["ἀδελφῆς",521,19],["σου",5,146],["ἐκ",21,1],["πατρός",44,21],["σου",5,146],["ἢ",61,8],["ἐκ",21,1],["μητρός",189,19],["σου",5,146],["ἐνδογενοῦς",9399,78],["ἢ",61,8],["γεγεννημένης",222,443],["ἔξω",527,17],["οὐκ",12,17],["ἀποκαλύψεις",1453,40],["ἀσχημοσύνην",1082,10],["αὐτῶν",3,41]],"The nakedness of thy sister by thy father or by thy mother, born at home or abroad, their nakedness thou shalt not uncover."],["10",[["Ἀσχημοσύνην",1082,10],["θυγατρὸς",97,19],["υἱοῦ",13,21],["σου",5,146],["ἢ",61,8],["θυγατρὸς",97,19],["θυγατρός",97,19],["σου",5,146],["οὐκ",12,17],["ἀποκαλύψεις",1453,40],["τὴν",1,9],["ἀσχημοσύνην",1082,10],["αὐτῶν",3,41],["ὅτι",19,8],["σὴ",405,13],["ἀσχημοσύνη",1082,13],["ἐστίν",10,87]],"The nakedness of thy son's daughter, or thy daughter's daughter, their nakedness thou shalt not uncover; because it is thy nakedness."],["11",[["Ἀσχημοσύνην",1082,10],["θυγατρὸς",97,19],["γυναικὸς",59,19],["πατρός",44,21],["σου",5,146],["οὐκ",12,17],["ἀποκαλύψεις",1453,40],["ὁμοπατρία",9828,15],["ἀδελφή",521,13],["σου",5,146],["ἐστὶν",10,87],["οὐκ",12,17],["ἀποκαλύψεις",1453,40],["τὴν",1,9],["ἀσχημοσύνην",1082,10],["αὐτῆς",3,83]],"Thou shalt not uncover the nakedness of the daughter of thy father's wife; she is thy sister by the same father: thou shalt not uncover her nakedness."],["12",[["Ἀσχημοσύνην",1082,10],["ἀδελφῆς",521,19],["πατρός",44,21],["σου",5,146],["οὐκ",12,17],["ἀποκαλύψεις",1453,40],["οἰκεία",1967,15],["γὰρ",40,12],["πατρός",44,21],["σου",5,146],["ἐστιν",10,87]],"Thou shalt not uncover the nakedness of thy father's sister, for she is near akin to thy father."],["13",[["Ἀσχημοσύνην",1082,10],["ἀδελφῆς",521,19],["μητρός",189,19],["σου",5,146],["οὐκ",12,17],["ἀποκαλύψεις",1453,40],["οἰκεία",1967,15],["γὰρ",40,12],["μητρός",189,19],["σου",5,146],["ἐστίν",10,87]],"Thou shalt not uncover the nakedness of thy mother's sister, for she is near akin to thy mother."],["14",[["Ἀσχημοσύνην",1082,10],["ἀδελφοῦ",67,21],["τοῦ",1,30],["πατρός",44,21],["σου",5,146],["οὐκ",12,17],["ἀποκαλύψεις",1453,40],["καὶ",2,8],["πρὸς",15,1],["τὴν",1,9],["γυναῖκα",59,10],["αὐτοῦ",3,48],["οὐκ",12,17],["εἰσελεύσῃ",86,116],["συγγενὴς",1741,16],["γάρ",40,12],["σου",5,146],["ἐστίν",10,87]],"Thou shalt not uncover the nakedness of thy father's brother, and thou shalt not go in to his wife; for she is thy relation."],["15",[["Ἀσχημοσύνην",1082,10],["νύμφης",1060,19],["σου",5,146],["οὐκ",12,17],["ἀποκαλύψεις",1453,40],["γυνὴ",59,13],["γὰρ",40,12],["υἱοῦ",13,21],["σου",5,146],["ἐστὶν",10,87],["οὐκ",12,17],["ἀποκαλύψεις",1453,40],["τὴν",1,9],["ἀσχημοσύνην",1082,10],["αὐτῆς",3,83]],"Thou shalt not uncover the nakedness of thy daughter-in-law, for she is thy son's wife, thou shalt not uncover her nakedness."],["16",[["Ἀσχημοσύνην",1082,10],["γυναικὸς",59,19],["ἀδελφοῦ",67,21],["σου",5,146],["οὐκ",12,17],["ἀποκαλύψεις",1453,40],["ἀσχημοσύνη",1082,13],["ἀδελφοῦ",67,21],["σου",5,146],["ἐστίν",10,87]],"Thou shalt not uncover the nakedness of thy brother's wife: it is thy brother's nakedness."],["17",[["Ἀσχημοσύνην",1082,10],["γυναικὸς",59,19],["καὶ",2,8],["θυγατρὸς",97,19],["αὐτῆς",3,83],["οὐκ",12,17],["ἀποκαλύψεις",1453,40],["τὴν",1,9],["θυγατέρα",97,10],["τοῦ",1,30],["υἱοῦ",13,21],["αὐτῆς",3,83],["καὶ",2,8],["τὴν",1,9],["θυγατέρα",97,10],["τῆς",1,18],["θυγατρὸς",97,19],["αὐτῆς",3,83],["οὐ",12,17],["λήψῃ",46,116],["ἀποκαλύψαι",652,100],["τὴν",1,9],["ἀσχημοσύνην",1082,10],["αὐτῶν",3,41],["οἰκεῖαι",1967,187],["γάρ",40,12],["σου",5,146],["εἰσίν",10,191],["ἀσέβημα",4543,20],["ἐστι",10,87]],"The nakedness of a woman and her daughter shalt thou not uncover; her son's daughter, and her daughter's daughter, shalt thou not take, to uncover their nakedness, for they are thy kinswomen: it is impiety."],["18",[["Γυναῖκα",59,10],["ἐπʼ",9,1],["ἀδελφῇ",521,2],["αὐτῆς",3,83],["οὐ",12,17],["λήψῃ",46,116],["ἀντίζηλον",5203,7],["ἀποκαλύψαι",652,100],["τὴν",1,9],["ἀσχημοσύνην",1082,10],["αὐτῆς",3,83],["ἐπʼ",9,1],["αὐτῇ",3,99],["ἔτι",111,17],["ζώσης",107,212],["αὐτῆς",3,83]],"Thou shalt not take a wife in addition to her sister, as a rival, to uncover her nakedness in opposition to her, while she is yet living."],["19",[["Καὶ",2,8],["πρὸς",15,1],["γυναῖκα",59,10],["ἐν",4,1],["χωρισμῷ",4471,113],["ἀκαθαρσίας",888,19],["αὐτῆς",3,83],["οὐκ",12,17],["εἰσελεύσῃ",86,116],["ἀποκαλύψαι",652,100],["τὴν",1,9],["ἀσχημοσύνην",1082,10],["αὐτῆς",3,83]],"And thou shalt not go in to a woman under separation for her uncleanness, to uncover her nakedness."],["20",[["Καὶ",2,8],["πρὸς",15,1],["τὴν",1,9],["γυναῖκα",59,10],["τοῦ",1,30],["πλησίον",292,17],["σου",5,146],["οὐ",12,17],["δώσεις",33,159],["κοίτην",704,10],["σπέρματός",218,24],["σου",5,146],["ἐκμιανθῆναι",4569,175],["πρὸς",15,1],["αὐτήν",3,98]],"And thou shalt not lie with thy neighbour's wife, to defile thyself with her."],["21",[["Καὶ",2,8],["ἀπὸ",17,1],["τοῦ",1,23],["σπέρματός",218,24],["σου",5,146],["οὐ",12,17],["δώσεις",33,159],["λατρεύειν",594,54],["ἄρχοντι",96,113],["καὶ",2,8],["οὐ",12,17],["βεβηλώσεις",608,159],["τὸ",1,32],["ὄνομα",57,33],["τὸ",1,32],["ἅγιον",75,29],["ἐγὼ",6,158],["Κύριος",7,5]],"And thou shalt not give of thy seed to serve a ruler; and thou shalt not profane my holy name; I [am] the Lord."],["22",[["Καὶ",2,8],["μετὰ",29,1],["ἄρσενος",914,237],["οὐ",12,17],["κοιμηθήσῃ",301,373],["κοίτην",704,10],["γυναικείαν",3511,37],["βδέλυγμα",476,33],["γάρ",40,12],["ἐστι",10,87]],"And thou shalt not lie with a man as with a woman, for it is an abomination."],["23",[["Καὶ",2,8],["πρὸς",15,1],["πᾶν",11,59],["τετράπουν",1641,59],["οὐ",12,17],["δώσεις",33,159],["τὴν",1,9],["κοίτην",704,10],["σου",5,146],["εἰς",8,1],["σπερματισμὸν",8266,7],["ἐκμιανθῆναι",4569,175],["πρὸς",15,1],["αὐτό",3,121],["καὶ",2,8],["γυνὴ",59,13],["οὐ",12,17],["στήσεται",78,89],["πρὸς",15,1],["πᾶν",11,59],["τετράπουν",1641,59],["βιβασθῆναι",5494,175],["μυσαρὸν",7719,59],["γάρ",40,12],["ἐστι",10,87]],"Neither shalt thou lie with any quadruped for copulation, to be polluted with it: neither shall a woman present herself before any quadruped to have connexion with it; for it is an abomination."],["24",[["Μὴ",25,8],["μιαίνεσθε",468,68],["ἐν",4,1],["πᾶσι",11,215],["τούτοις",16,193],["ἐν",4,1],["πᾶσι",11,215],["γὰρ",40,12],["τούτοις",16,193],["ἐμίανθησαν",468,94],["τὰ",1,42],["ἔθνη",60,43],["ἃ",1,11],["ἐγὼ",6,179],["ἐξαποστέλλω",220,149],["πρὸ",238,1],["προσώπου",47,24],["ὑμῶν",5,136]],"Do not defile yourselves with any of these things; for in all these things the nations are defiled, which I drive out before you,"],["25",[["καὶ",2,8],["ἐξεμιάνθη",4569,38],["ἡ",1,11],["γῆ",26,13],["καὶ",2,8],["ἀνταπέδωκα",666,147],["ἀδικίαν",288,10],["αὐτοῖς",3,142],["διʼ",56,1],["αὐτὴν",3,98],["καὶ",2,8],["προσώχθισεν",1780,3],["ἡ",1,11],["γῆ",26,13],["τοῖς",1,138],["ἐγκαθημένοις",1860,457],["ἐπʼ",9,1],["αὐτῆς",3,83]],"and the land is polluted; and I have recompensed their iniquity to them because of it, and the land is aggrieved with them that dwell upon it."],["26",[["Καὶ",2,8],["φυλάξεσθε",125,117],["πάντα",11,65],["τὰ",1,42],["νόμιμά",705,65],["μου",6,48],["καὶ",2,8],["πάντα",11,65],["τὰ",1,42],["προστάγματά",393,43],["μου",6,48],["καὶ",2,8],["οὐ",12,17],["ποιήσετε",23,348],["ἀπὸ",17,1],["πάντων",11,79],["τῶν",1,44],["βδελυγμάτων",476,45],["τούτων",16,214],["ὁ",1,4],["ἐγχώριος",3182,16],["καὶ",2,8],["ὁ",1,4],["προσγενόμενος",5989,244],["προσήλυτος",634,5],["ἐν",4,1],["ὑμῖν",5,86]],"And ye shall keep all my statutes and all my ordinances, and ye shall do none of these abominations; neither the native, nor the stranger that joins himself with you:"],["27",[["Πάντα",11,65],["γὰρ",40,12],["τὰ",1,42],["βδελύγματα",476,43],["ταῦτα",16,248],["ἐποίησαν",23,141],["οἱ",1,128],["ἄνθρωποι",43,51],["τῆς",1,18],["γῆς",26,19],["οἱ",1,128],["ὄντες",10,137],["πρότερον",496,29],["ὑμῶν",5,136],["καὶ",2,8],["ἐμιάνθη",468,38],["ἡ",1,11],["γῆ",26,13]],"(for all these abominations the men of the land did who were before you, and the land was defiled,)"],["28",[["καὶ",2,8],["ἵνα",102,8],["μὴ",25,8],["προσοχθίσῃ",1780,116],["ὑμῖν",5,86],["ἡ",1,11],["γῆ",26,13],["ἐν",4,1],["τῷ",1,110],["μιαίνειν",468,54],["ὑμᾶς",5,209],["αὐτὴν",3,98],["ὃν",24,106],["τρόπον",245,7],["προσώχθισε",1780,3],["τοῖς",1,91],["ἔθνεσι",60,92],["τοῖς",1,91],["πρὸ",238,1],["ὑμῶν",5,136]],"and lest the land be aggrieved with you in your polluting it, as it was aggrieved with the nations before you."],["29",[["Ὅτι",19,8],["πᾶς",11,16],["ὃς",24,246],["ἐὰν",45,8],["ποιήσῃ",23,160],["ἀπὸ",17,1],["πάντων",11,79],["τῶν",1,44],["βδελυγμάτων",476,45],["τούτων",16,214],["ἐξολοθρευθήσονται",291,135],["αἱ",1,185],["ψυχαὶ",63,180],["αἱ",1,185],["ποιοῦσαι",23,301],["ἐκ",21,1],["τοῦ",1,30],["λαοῦ",35,21],["αὐτῶν",3,41]],"For whosoever shall do any of these abominations, the souls that do them shall be destroyed from among their people."],["30",[["Καὶ",2,8],["φυλάξετε",125,348],["τὰ",1,42],["προστάγματά",393,43],["μου",6,48],["ὅπως",240,8],["μὴ",25,8],["ποιήσητε",23,118],["ἀπὸ",17,1],["πάντων",11,163],["τῶν",1,76],["νομίμων",705,163],["τῶν",1,76],["ἐβδελυγμένων",1056,412],["ἃ",1,11],["γέγονε",30,165],["πρὸ",238,1],["τοῦ",1,30],["ὑμᾶς",5,209],["καὶ",2,8],["οὐ",12,17],["μιανθήσεσθε",468,258],["ἐν",4,1],["αὐτοῖς",3,142],["ὅτι",19,8],["ἐγὼ",6,158],["Κύριος",7,5],["ὁ",1,4],["Θεὸς",20,5],["ὑμῶν",5,136]],"And ye shall keep mine ordinances, that ye may not do any of the abominable practices, which have taken place before your time: and ye shall not be polluted in them; for I [am] the Lord your God."]]