[["1",[["Καὶ",2,8],["ἐλάλησε",50,3],["Κύριος",7,5],["πρὸς",15,1],["Μωυσῆν",68,7],["λέγων",31,67]],"And the Lord spoke to Moses, saying,"],["2",[["λάλησον",50,243],["τοῖς",1,138],["υἱοῖς",13,139],["Ἰσραὴλ",27,105],["καὶ",2,8],["ἐρεῖς",191,145],["αὐτοῖς",3,142],["ὃς",24,247],["ἂν",82,12],["εὔξηται",666,236],["εὐχὴν",631,10],["ὥστε",345,17],["τιμὴν",721,10],["τῆς",1,18],["ψυχῆς",62,19],["αὐτοῦ",3,48],["τῷ",1,110],["Κυρίῳ",7,113]],"Speak to the children of Israel, and thou shalt say to them, Whosoever shall vow a vow as the valuation of his soul for the Lord,"],["3",[["ἔσται",10,89],["ἡ",1,11],["τιμὴ",721,13],["τοῦ",1,30],["ἄρσενος",915,237],["ἀπὸ",17,1],["εἰκοσαετοῦς",1245,153],["ἕως",42,8],["ἑξηκονταετοῦς",9701,153],["ἔσται",10,89],["αὐτοῦ",3,48],["ἡ",1,11],["τιμὴ",721,13],["πεντήκοντα",449,57],["δίδραχμα",1623,43],["ἀργυρίου",150,24],["τῷ",1,110],["σταθμῷ",970,113],["τῷ",1,110],["ἁγίῳ",75,111]],"the valuation of a male from twenty years old to sixty years old shall be—his valuation shall be fifty didrachms of silver by the standard of the sanctuary."],["4",[["Τῆς",1,18],["δὲ",14,12],["θηλείας",1204,109],["ἔσται",10,89],["ἡ",1,11],["συντίμησις",3658,13],["τριάκοντα",423,57],["δίδραχμα",1623,43]],"And the valuation of a female shall be thirty didrachms."],["5",[["Ἐὰν",45,8],["δὲ",14,12],["ἀπὸ",17,1],["πενταετοῦς",5953,153],["ἕως",42,8],["εἴκοσι",279,57],["ἐτῶν",80,45],["ἔσται",10,89],["ἡ",1,11],["τιμὴ",721,13],["τοῦ",1,30],["ἄρσενος",915,237],["εἴκοσι",279,57],["δίδραχμα",1623,43],["τῆς",1,18],["δὲ",14,12],["θηλείας",1204,109],["δέκα",310,57],["δίδραχμα",1623,43]],"And if it be from five years old to twenty, the valuation of a male shall be twenty didrachms, and of a female ten didrachms."],["6",[["Ἀπὸ",17,1],["δὲ",14,12],["μηνιαίου",2750,153],["ἕως",42,8],["πενταετοῦς",5953,153],["ἔσται",10,89],["ἡ",1,11],["τιμὴ",721,13],["τοῦ",1,30],["ἄρσενος",915,237],["πέντε",280,57],["δίδραχμα",1623,43],["τῆς",1,18],["δὲ",14,12],["θηλείας",1204,109],["τρία",173,65],["δίδραχμα",162