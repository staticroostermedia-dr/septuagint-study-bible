8,19],["αὐτοῦ",3,48]],"And the priest shall offer them one for a sin-offering, and the other for a whole-burnt-offering; and the priest shall make atonement for him before the Lord for his issue."],["16",[["Καὶ",2,8],["ἄνθρωπος",43,5],["ᾧ",24,202],["ἂν",83,12],["ἐξέλθῃ",82,160],["ἐξ",21,1],["αὐτοῦ",3,144],["κοίτη",704,13],["σπέρματος",218,24],["καὶ",2,8],["λούσεται",1042,89],["ὕδατι",85,53],["πᾶν",11,29],["τὸ",1,32],["σῶμα",454,33],["αὐτοῦ",3,48],["καὶ",2,8],["ἀκάθαρτος",374,16],["ἔσται",10,89],["ἕως",42,8],["ἑσπέρας",488,19]],"And the man whose seed of copulation shall happen to go forth from him, shall then wash his whole body, and shall be unclean until evening."],["17",[["Καὶ",2,8],["πᾶν",11,29],["ἱμάτιον",276,33],["καὶ",2,8],["πᾶν",11,29],["δέρμα",669,33],["ἐφʼ",9,1],["ὃ",1,4],["ἂν",83,12],["ᾖ",10,173],["ἐπʼ",9,1],["αὐτὸ",3,121],["κοίτη",704,13],["σπέρματος",218,24],["καὶ",2,8],["πλυθήσεται",967,125],["ὕδατι",85,53],["καὶ",2,8],["ἀκάθαρτον",374,28],["ἔσται",10,89],["ἕως",42,8],["ἑσπέρας",488,19]],"And every garment, and every skin on which there shall be the seed of copulation shall both be washed with water, and be unclean until evening."],["18",[["Καὶ",2,8],["γυνὴ",59,13],["ἐὰν",45,8],["κοιμηθῇ",301,333],["ἀνὴρ",38,5],["μετʼ",29,1],["αὐτῆς",3,83],["κοίτην",704,10],["σπέρματος",218,24],["καὶ",2,8],["λούσονται",1042,127],["ὕδατι",85,53],["καὶ",2,8],["ἀκάθαρτοι",374,130],["ἔσονται",10,127],["ἕως",42,8],["ἑσπέρας",488,19]],"And a woman, if a man shall lie with her with seed of copulation—they shall both bathe themselves in water and shall be unclean until evening."],["19",[["Καὶ",2,8],["γυνὴ",59,13],["ἥτις",457,421],["ἂν",83,12],["ᾖ",10,173],["ῥέουσα",667,183],["αἵματι",148,53],["καὶ",2,8],["ἔσται",10,89],["ἡ",1,11],["ῥύσις",1948,13],["αὐτῆς",3,83],["ἐν",4,1],["τῷ",1,52],["σώματι",454,53],["αὐτῆς",3,83],["ἑπτὰ",180,57],["ἡμέρας",28,19],["ἔσται",10,89],["ἐν",4,1],["τῇ",1,95],["ἀφέδρῳ",2667,2],["αὐτῆς",3,83],["πᾶς",11,16],["ὁ",1,4],["ἁπτόμενος",465,114],["αὐτῆς",3,83],["ἀκάθαρτος",374,16],["ἔσται",10,89],["ἕως",42,8],["ἑσπέρας",488,19]],"And the woman whosoever shall have an issue of blood, when her issue shall be in her body, shall be seven days in her separation; every one that touches her shall be unclean until evening."],["20",[["Καὶ",2,8],["πᾶν",11,29],["ἐφʼ",9,1],["ὃ",1,4],["ἂν",83,12],["κοιτάζηται",3071,297],["ἐπʼ",9,1],["αὐτὸ",3,121],["ἐν",4,1],["τῇ",1,95],["ἀφέδρῳ",2667,2],["αὐτῆς",3,83],["ἀκάθαρτον",374,28],["ἔσται",10,89],["καὶ",2,8],["πᾶν",11,29],["ἐφʼ",9,1],["ὃ",1,4],["ἂν",83,12],["ἐπικαθίσῃ",3197,116],["ἐπʼ",9,1],["αὐτὸ",3,121],["ἀκάθαρτον",374,29],["ἔσται",10,89]],"And every thing whereon she shall lie in her separation, shall be unclean; and whatever she shall sit upon, shall be unclean."],["21",[["Καὶ",2,8],["πᾶς",11,16],["ὃς",24,246],["ἂν",83,12],["ἅψηται",465,236],["τῆς",1,18],["κοίτης",704,19],["αὐτῆς",3,83],["πλυνεῖ",967,120],["τὰ",1,42],["ἱμάτια",276,43],["αὐτοῦ",3,48],["καὶ",2,8],["λούσεται",1042,89],["τὸ",1,32],["σῶμα",454,33],["αὐτοῦ",3,48],["ὕδατι",85,53],["καὶ",2,8],["ἀκάθαρτος",374,16],["ἔσται",10,89],["ἕως",42,8],["ἑσπέρας",488,19]],"And whosoever shall touch her bed shall wash his garments, and bathe his body in water, and shall be unclean until evening."],["22",[["Καὶ",2,8],["πᾶς",11,16],["ὁ",1,4],["ἁπτόμενος",465,114],["παντὸς",11,88],["σκεύους",182,24],["οὗ",120,17],["ἐὰν",45,8],["καθίσῃ",274,160],["ἐπʼ",9,1],["αὐτὸ",3,121],["πλυνεῖ",967,120],["τὰ",1,42],["ἱμάτια",276,43],["αὐτοῦ",3,48],["καὶ",2,8],["λούσεται",1042,89],["ὕδατι",85,53],["καὶ",2,8],["ἀκάθαρτος",374,16],["ἔσται",10,89],["ἕως",42,8],["ἑσπέρας",488,19]],"And every one that touches any vessel on which she shall sit, shall wash his garments and bathe himself in water, and shall be unclean until evening."],["23",[["Ἐὰν",45,8],["δὲ",14,12],["ἐν",4,1],["τῇ",1,95],["κοίτῃ",704,2],["αὐτῆς",3,83],["οὔσης",10,212],["ἢ",61,8],["ἐπὶ",9,1],["τοῦ",1,23],["σκεύους",182,24],["οὗ",120,17],["ἐὰν",45,8],["καθίσῃ",274,160],["ἐπʼ",9,1],["αὐτῷ",3,49],[