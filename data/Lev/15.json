[["1",[["Καὶ",2,8],["ἐλάλησε",50,3],["Κύριος",7,5],["πρὸς",15,1],["Μωυσῆν",69,7],["καὶ",2,8],["Ἀαρὼν",159,5],["λέγων",31,67]],"And the Lord spoke to Moses and Aaron, saying,"],["2",[["λάλησον",50,198],["τοῖς",1,138],["υἱοῖς",13,139],["Ἰσραὴλ",27,105],["καὶ",2,8],["ἐρεῖς",165,159],["αὐτοῖς",3,142],["ἀνδρὶ",38,113],["ἀνδρὶ",38,113],["ᾧ",24,202],["ἐὰν",45,8],["γένηται",30,236],["ῥύσις",1948,13],["ἐκ",21,1],["τοῦ",1,23],["σώματος",454,24],["αὐτοῦ",3,144],["ἡ",1,11],["ῥύσις",1948,13],["αὐτοῦ",3,48],["ἀκάθαρτός",374,15],["ἐστι",10,87]],"Speak to the children of Israel, and thou shalt say to them, Whatever man shall have an issue out of his body, his issue is unclean."],["3",[["Καὶ",2,8],["οὗτος",16,112],["ὁ",1,4],["νόμος",140,5],["τῆς",1,18],["ἀκαθαρσίας",888,19],["αὐτοῦ",3,48],["ῥέων",667,67],["γόνον",6926,7],["ἐκ",21,1],["σώματος",454,24],["αὐτοῦ",3,144],["ἐκ",21,1],["τῆς",1,18],["ῥύσεως",1948,19],["ἧς",24,162],["συνέστηκε",1065,165],["τὸ",1,32],["σῶμα",454,33],["αὐτοῦ",3,48],["διὰ",56,1],["τῆς",1,18],["ῥύσεως",1948,19],["αὕτη",16,101],["ἡ",1,11],["ἀκαθαρσία",888,13],["αὐτοῦ",3,48],["ἐν",4,1],["αὐτῷ",3,49],["πᾶσαι",11,187],["αἱ",1,185],["ἡμέραι",28,2],["ῥύσεως",1948,19],["σώματος",454,24],["αὐτοῦ",3,144],["ᾗ",24,102],["συνέστηκε",1065,165],["τὸ",1,32],["σῶμα",454,33],["αὐτοῦ",3,48],["διὰ",56,1],["τῆς",1,18],["ῥύσεως",1948,19],["ἀκαθαρσία",888,13],["αὐτοῦ",3,48],["ἐστι",10,87]],"And this [is] the law of his uncleanness; whoever has a gonorrhœa out of his body, this is his uncleanness in him by reason of the issue, by which his body is affected through the issue: all the days of the issue of his body, by which his body is affected through the issue, there is his uncleanness."],["4",[["Πᾶσα",11,15],["κοίτη",704,13],["ἐφʼ",9,1],["ἧς",24,162],["ἂν",83,12],["κοιμηθῇ",301,333],["ἐπʼ",9,1],["αὐτῆς",3,83],["ὁ",1,4],["γονοῤῥυὴς",2253,16],["ἀκάθαρτός",374,16],["ἐστι",10,87],["καὶ",2,8],["πᾶν",11,29],["σκεῦος",182,33],["ἐφʼ",9,1],["ὃ",1,4],["ἂν",83,12],["καθίσῃ",274,160],["ἐπʼ",9,1],["αὐτὸ",3,121],["ὁ",1,4],["γονοῤῤυὴς",2253,372],["ἀκάθαρτον",374,28],["ἔσται",10,89]],"Every bed on which he that has the issue shall happen to lie, is unclean; and every seat on which he that has the issue may happen to sit, shall be unclean."],["5",[["Καὶ",2,8],["ἄνθρωπος",43,5],["ὃς",24,246],["ἐὰν",45,8],["ἅψηται",465,236],["τῆς",1,18],["κοίτης",704,19],["αὐτοῦ",3,48],["πλυνεῖ",967,120],["τὰ",1,42],["ἱμάτια",276,43],["αὐτοῦ",3,48],["καὶ",2,8],["λούσεται",1042,89],["ὕδατι",85,53],["καὶ",2,8],["ἀκάθαρτος",374,16],["ἔσται",10,89],["ἕως",42,8],["ἑσπέρας",488,19]],"And the man who shall touch his bed, shall wash his garments, and bathe himself in water, and shall be unclean till evening."],["6",[["Καὶ",2,8],["ὁ",1,4],["καθήμενος",419,407],["ἐπὶ",9,1],["τοῦ",1,23],["σκεύους",182,24],["ἐφʼ",9,1],["ὃ",1,4],["ἂν",83,12],["καθίσῃ",274,160],["ὁ",1,4],["γονοῤῥυὴς",2253,16],["πλυνεῖ",967,120],["τὰ",1,42],["ἱμάτια",276,43],["αὐτοῦ",3,48],["καὶ",2,8],["λούσεται",1042,89],["ὕδατι",85,53],["καὶ",2,8],["ἀκάθαρτος",374,16],["ἔσται",10,89],["ἕως",42,8],["ἑσπέρας",488,19]],"And whosoever sits on the seat on which he that has the issue may have sat, shall wash his garments, and bathe himself in water, and shall be unclean until evening."],["7",[["Καὶ",2,8],["ὁ",1,4],["ἁπτόμενος",465,114],["τοῦ",1,30],["χρωτὸς",2205,21],["τοῦ",1,30],["γονοῤῥυοῦς",2253,153],["πλυνεῖ",967,120],["τὰ",1,42],["ἱμάτια",276,43],["καὶ",2,8],["λούσεται",1042,89],["ὕδατι",85,53],["καὶ",2,8],["ἀκάθαρτος",374,16],["ἔσται",10,89],["ἕως",42,8],["ἑσπέρας",488,19]],"And he that touches the skin of him that has the issue, shall wash his garments and bathe himself in water, and shall be unclean till evening."],["8",[["Ἐὰν",45,8],["δὲ",14,12],["προσσιελίσῃ",8121,116],["ὁ",1,4],["γονοῤῥυὴς",2253,16],["ἐπὶ",9,1],["τὸν",1,6],["καθαρὸν",379,59],["πλυνεῖ",967,120],["τὰ",1,42],["ἱμάτια",276,43],["αὐτοῦ",3,48],["καὶ",2,8],["λούσεται",1042,89],["ὕδατι",85,53],["καὶ",2,8],["ἀκάθαρτος",374,16],["ἔσται",10,89],["ἕως",42,8],["ἑσπέρας",488,19]],"And if he that has the issue should spit upon one that is clean, [that person] shall wash his garments, and bathe himself in water, and be unclean until evening."],["9",[["Καὶ",2,8],["πᾶν",11,29],["ἐπίσαγμα",9587,33],["ὄνου",499,21],["ἐφʼ",9,1],["ὃ",1,4],["ἂν",83,12],["ἐπιβῇ",880,160],["ἐπʼ",9,1],["αὐτὸ",3,121],["ὁ",1,4],["γονοῤῥυὴς",2253,16],["ἀκάθαρτον",374,28],["ἔσται",10,89],["ἕως",42,8],["ἑσπέρας",488,19]],"And every ass's saddle, on which the man with the issue shall have mounted, shall be unclean till evening."],["10",[["Καὶ",2,8],["πᾶς",11,16],["ὁ",1,4],["ἁπτόμενος",465,114],["ὅσα",103,63],["ἂν",83,12],["ᾖ",10,173],["ὑποκάτω",599,17],["αὐτοῦ",3,48],["ἀκάθαρτος",374,16],["ἔσται",10,89],["ἕως",42,8],["ἑσπέρας",488,19],["καὶ",2,8],["ὁ",1,4],["αἴρων",206,67],["αὐτὰ",3,66],["πλυνεῖ",967,120],["τὰ",1,42],["ἱμάτια",276,43],["αὐτοῦ",3,48],["καὶ",2,8],["λούσεται",1042,89],["ὕδατι",85,53],["καὶ",2,8],["ἀκάθαρτος",374,16],["ἔσται",10,89],["ἕως",42,8],["ἑσπέρας",488,19]],"And every one that touches whatsoever shall have been under him shall be unclean until evening; and he that takes them up shall wash his garments, and bathe himself in water, and shall be unclean until evening."],["11",[["Καὶ",2,8],["ὅσων",103,61],["ἐὰν",45,8],["ἅψηται",465,236],["ὁ",1,4],["γονοῤῥυὴς",2253,16],["καὶ",2,8],["τὰς",1,39],["χεῖρας",37,40],["οὐ",12,17],["νένιπται",1776,182],["ὕδατι",85,53],["πλυνεῖ",967,120],["τὰ",1,42],["ἱμάτια",276,43],["καὶ",2,8],["λούσεται",1042,89],["τὸ",1,32],["σῶμα",454,33],["ὕδατι",85,53],["καὶ",2,8],["ἀκάθαρτος",374,16],["ἔσται",10,89],["ἕως",42,8],["ἑσπέρας",488,19]],"And whomsoever he that has the issue shall touch, if he have not rinsed his hands in water, he shall wash his garments, and bathe his body in water, and shall be unclean until evening."],["12",[["Καὶ",2,8],["σκεῦος",182,33],["ὀστράκινον",2236,29],["οὗ",120,17],["ἂν",83,12],["ἅψηται",465,236],["ὁ",1,4],["γονοῤῥυὴς",2253,16],["συντριβήσεται",268,125],["καὶ",2,8],["σκεῦος",182,33],["ξύλιν