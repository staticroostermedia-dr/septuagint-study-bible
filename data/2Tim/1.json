[["1",[["Παῦλος",10586,5],["ἀπόστολος",10080,5],["Χριστοῦ",1072,21],["Ἰησοῦ",211,21],["διὰ",56,1],["θελήματος",1039,24],["θεοῦ",20,21],["κατ᾽",32,1],["ἐπαγγελίαν",3439,10],["ζωῆς",216,19],["τῆς",1,18],["ἐν",4,1],["Χριστῷ",1072,113],["Ἰησοῦ",211,113]],"Paul, an apostle of Jesus Christ through the will of God, according to the promise of the life which is in Christ Jesus,"],["2",[["Τιμοθέῳ",1953,113],["ἀγαπητῷ",1920,34],["τέκνῳ",192,53],["χάρις",368,13],["ἔλεος",183,20],["εἰρήνη",213,13],["ἀπὸ",17,1],["θεοῦ",20,21],["πατρὸς",44,21],["καὶ",2,8],["Χριστοῦ",1072,21],["Ἰησοῦ",211,21],["τοῦ",1,30],["κυρίου",7,21],["ἡμῶν",9994,136]],"to Timothy, my beloved child: Grace, mercy, and peace, from God the Father and Christ Jesus our Lord."],["3",[["Χάριν",368,10],["ἔχω",124,149],["τῷ",1,110],["θεῷ",20,113],["ᾧ",24,202],["λατρεύω",594,149],["ἀπὸ",17,1],["προγόνων",2623,77],["ἐν",4,1],["καθαρᾷ",379,96],["συνειδήσει",6118,2],["ὡς",36,12],["ἀδιάλειπτον",10874,37],["ἔχω",124,149],["τὴν",1,9],["περὶ",72,1],["σοῦ",5,146],["μνείαν",2271,10],["ἐν",4,1],["ταῖς",1,70],["δεήσεσίν",677,71],["μου",9994,146],["νυκτὸς",219,19],["καὶ",2,8],["ἡμέρας",28,19]],"I thank God, whom I serve as my forefathers did, with a pure conscience. How unceasing is my memory of you in my petitions, night and day"],["4",[["ἐπιποθῶν",2537,67],["σε",5,161],["ἰδεῖν",53,100],["μεμνημένος",230,407],["σου",5,146],["τῶν",1,44],["δακρύων",1268,45],["ἵνα",102,8],["χαρᾶς",1125,19],["πληρωθῶ",518,555]],"longing to see you, remembering your tears, that I may be filled with joy;"],["5",[["ὑπόμνησιν",6657,10],["λαβὼν",46,155],["τῆς",1,18],["ἐν",4,1],["σοὶ",5,151],["ἀνυποκρίτου",6289,78],["πίστεως",887,19],["ἥτις",457,421],["ἐνῴκησεν",1403,3],["πρῶτον",315,29],["ἐν",4,1],["τῇ",1,95],["μάμμῃ",7730,2],["σου",5,146],["Λωΐδι",11249,2],["καὶ",2,8],["τῇ",1,95],["μητρί",189,2],["σου",5,146],["Εὐνίκῃ",11250,2],["πέπεισμαι",344,880],["δὲ",14,8],["ὅτι",19,8],["καὶ",2,8],["ἐν",4,1],["σοί",5,151]],"having been reminded of the sincere faith that is in you, which lived first in your grandmother Lois and your mother Eunice and, I am persuaded, in you also."],["6",[["Δι᾽",56,1],["ἣν",24,124],["αἰτίαν",1954,10],["ἀναμιμνῄσκω",1651,149],["σε",5,161],["ἀναζωπυρεῖν",8848,54],["τὸ",1,32],["χάρισμα",10814,33],["τοῦ",1,30],["θεοῦ",20,21],["ὅ",24,677],["ἐστιν",10,87],["ἐν",4,1],["σοὶ",5,151],["διὰ",56,1],["τῆς",1,18],["ἐπιθέσεως",4099,19],["τῶν",1,123],["χειρῶν",37,61],["μου",9994,146]],"For this cause, I remind you that you should stir up the gift of God which is in you through the laying on of my hands."],["7",[["οὐ",12,12],["γὰρ",40,8],["ἔδωκεν",33,3],["ἡμῖν",9994,86],["ὁ",1,4],["θεὸς",20,5],["πνεῦμα",168,33],["δειλίας",3513,19],["ἀλλὰ",108,8],["δυνάμεως",98,19],["καὶ",2,8],["ἀγάπης",1982,19],["καὶ",2,8],["σωφρονισμοῦ",11251,21]],"For God didn’t give us a spirit of fear, but of power, love, and self-control."],["8",[["Μὴ",25,12],["οὖν",227,8],["ἐπαισχυνθῇς",9469,717],["τὸ",1,32],["μαρτύριον",225,33],["τοῦ",1,30],["κυρίου",7,21],["ἡμῶν",9994,136],["μηδὲ",414,8],["ἐμὲ",6,161],["τὸν",1,6],["δέσμιον",2889,7],["αὐτοῦ",3,48],["ἀλλὰ",108,8],["συγκακοπάθησον",11252,198],["τῷ",1,52],["εὐαγγελίῳ",4222,53],["κατὰ",32,1],["δύναμιν",98,10],["θεοῦ",20,21]],"Therefore don’t be ashamed of the testimony of our Lord, nor of me his prisoner; but endure hardship for the Good News according to the power of God,"],["9",[["τοῦ",1,30],["σώσαντος",172,513],["ἡμᾶς",9994,209],["καὶ",2,8],["καλέσαντος",128,513],["κλήσει",5735,2],["ἁγίᾳ",75,96],["οὐ",12,12],["κατὰ",32,1],["τὰ",1,42],["ἔργα",105,43],["ἡμῶν",9994,136],["ἀλλὰ",108,8],["κατὰ",32,1],["ἰδίαν",683,37],["πρόθεσιν",1970,10],["καὶ",2,8],["χάριν",368,10],["τὴν",1,9],["δοθεῖσαν",33,417],["ἡμῖν",9994,86],["ἐν",4,1],["Χριστῷ",1072,113],["Ἰησοῦ",211,113],["πρὸ",238,1],["χρόνων",486,77],["αἰωνίων",391,163]],"who saved us and called us with a holy calling, not according to our works, but according to his own purpose and grace, which was given to us in Christ Jesus before times eternal,"],["10",[["φανερωθεῖσαν",8582,417],["δὲ",14,8],["νῦν",90,17],["διὰ",56,1],["τῆς",1,18],["ἐπιφανείας",2540,19],["τοῦ",1,30],["σωτῆρος",1388,21],["ἡμῶν",9994,136],["Χριστοῦ",1072,21],["Ἰησοῦ",211,21],["καταργήσαντος",4259,513],["μὲν",281,12],["τὸν",1,6],["θάνατον",170,7],["φωτίσαντος",1230,513],["δὲ",14,8],["ζωὴν",216,10],["καὶ",2,8],["ἀφθαρσίαν",4054,10],["διὰ",56,1],["τοῦ",1,23],["εὐαγγελίου",4222,24]],"but has now been revealed by the appearing of our Savior, Christ Jesus, who abolished death, and brought life and immortality to light through the Good News."],["11",[["εἰς",8,1],["ὃ",24,467],["ἐτέθην",110,148],["ἐγὼ",6,156],["κῆρυξ",4291,5],["καὶ",2,8],["ἀπόστολος",10080,5],["καὶ",2,8],["διδάσκαλος",7031,5]],"For this I was appointed as a preacher, an apostle, and a teacher of the Gentiles."],["12",[["δι᾽",56,1],["ἣν",24,124],["αἰτίαν",1954,10],["καὶ",2,8],["ταῦτα",16,248],["πάσχω",1972,149],["ἀλλ᾽",108,8],["οὐκ",12,12],["ἐπαισχύνομαι",9469,768],["οἶδα",10044,85],["γὰρ",40,8],["ᾧ",24,202],["πεπίστευκα",649,85],["καὶ",2,8],["πέπεισμαι",344,880],["ὅτι",19,8],["δυνατός",356,16],["ἐστιν",10,87],["τὴν",1,9],["παραθήκην",4346,10],["μου",9994,146],["φυλάξαι",125,100],["εἰς",8,1],["ἐκείνην",80,234],["τὴν",1,9],["ἡμέραν",28,10]],"For this cause I also suffer these things. Yet I am not ashamed, for I know him whom I have believed, and I am persuaded that he is able to guard that which I have committed to him against that day."],["13",[["Ὑποτύπωσιν",11194,10],["ἔχε",124,239],["ὑγιαινόντων",1715,164],["λόγων",48,77],["ὧν",24,303],["παρ᾽",73,1],["ἐμοῦ",6,88],["ἤκουσας",54,154],["ἐν",4,1],["πίστει",887,2],["καὶ",2,8],["ἀγάπῃ",1982,2],["τῇ",1,95],["ἐν",4,1],["Χριστῷ",1072,113],["Ἰησοῦ",211,113]],"Hold the pattern of sound words which you have heard from me, in faith and love which is in Christ Jesus."],["14",[["τὴν",1,9],["καλὴν",266,37],["παραθήκην",4346,10],["φύλαξον",125,198],["διὰ",56,1],["πνεύματος",168,24],["ἁγίου",75,88],["τοῦ",1,23],["ἐνοικοῦντος",1403,291],["ἐν",4,1],["ἡμῖν",9994,86]],"That good thing which was committed to you, guard through the Holy Spirit who dwells in us."],["15",[["Οἶδας",10044,172],["τοῦτο",16,122],["ὅτι",19,8],["ἀπεστράφησάν",130,94],["με",9994,161],["πάντες",11,130],["οἱ",1,128],["ἐν",4,1],["τῇ",1,95],["Ἀσίᾳ",3180,2],["ὧν",24,303],["ἐστιν",10,87],["Φύγελος",11253,5],["καὶ",2,8],["Ἑρμογένης",11254,5]],"This you know, that all who are in Asia turned away from me, of whom are Phygelus and Hermogenes."],["16",[["δῴη",33,216],["ἔλεος",183,33],["ὁ",1,4],["κύριος",7,5],["τῷ",1,110],["Ὀνησιφόρου",11255,21],["οἴκῳ",34,113],["ὅτι",19,8],["πολλάκις",2947,17],["με",9994,161],["ἀνέψυξεν",4023,3],["καὶ",2,8],["τὴν",1,9],["ἅλυσίν",9222,10],["μου",9994,146],["οὐκ",12,12],["ἐπαισχύνθη",9469,715]],"May the Lord grant mercy to the house of Onesiphorus, for he often refreshed me, and was not ashamed of my chain,"],["17",[["ἀλλὰ",108,8],["γενόμενος",30,770],["ἐν",4,1],["Ῥώμῃ",2240,2],["σπουδαίως",8272,17],["ἐζήτησέν",191,3],["με",9994,161],["καὶ",2,8],["εὗρεν",101,3]],"but when he was in Rome, he sought me diligently and found me"],["18",[["δῴη",33,216],["αὐτῷ",3,49],["ὁ",1,4],["κύριος",7,5],["εὑρεῖν",101,100],["ἔλεος",183,33],["παρὰ",73,1],["κυρίου",7,21],["ἐν",4,1],["ἐκείνῃ",80,200],["τῇ",1,95],["ἡμέρᾳ",28,2],["καὶ",2,8],["ὅσα",103,755],["ἐν",4,1],["Ἐφέσῳ",10672,2],["διηκόνησεν",10016,3],["βέλτιον",2010,29],["σὺ",5,156],["γινώσκεις",79,145]],"(the Lord grant to him to find the Lord’s mercy in that day); and in how many things he served at Ephesus, you know very well."]]