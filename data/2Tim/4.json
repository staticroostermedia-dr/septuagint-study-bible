[["1",[["Διαμαρτύρομαι",1585,768],["ἐνώπιον",115,1],["τοῦ",1,30],["θεοῦ",20,21],["καὶ",2,8],["Χριστοῦ",1072,21],["Ἰησοῦ",211,21],["τοῦ",1,30],["μέλλοντος",1143,143],["κρίνειν",263,54],["ζῶντας",107,229],["καὶ",2,8],["νεκρούς",659,58],["καὶ",2,8],["τὴν",1,9],["ἐπιφάνειαν",2540,10],["αὐτοῦ",3,48],["καὶ",2,8],["τὴν",1,9],["βασιλείαν",157,10],["αὐτοῦ",3,48]],"I command you therefore before God and the Lord Jesus Christ, who will judge the living and the dead at his appearing and his Kingdom:"],["2",[["κήρυξον",1438,198],["τὸν",1,6],["λόγον",48,7],["ἐπίστηθι",631,198],["εὐκαίρως",7169,17],["ἀκαίρως",11278,17],["ἔλεγξον",752,198],["ἐπιτίμησον",2318,198],["παρακάλεσον",434,198],["ἐν",4,1],["πάσῃ",11,96],["μακροθυμίᾳ",3887,2],["καὶ",2,8],["διδαχῇ",7030,2]],"preach the word; be urgent in season and out of season; reprove, rebuke, and exhort with all patience and teaching."],["3",[["ἔσται",10,718],["γὰρ",40,8],["καιρὸς",132,5],["ὅτε",432,1],["τῆς",1,18],["ὑγιαινούσης",1715,212],["διδασκαλίας",4202,19],["οὐκ",12,12],["ἀνέξονται",2211,740],["ἀλλὰ",108,8],["κατὰ",32,1],["τὰς",1,39],["ἰδίας",683,109],["ἐπιθυμίας",699,40],["ἑαυτοῖς",92,142],["ἐπισωρεύσουσιν",11279,207],["διδασκάλους",7031,31],["κνηθόμενοι",11280,772],["τὴν",1,9],["ἀκοήν",1047,10]],"For the time will come when they will not listen to the sound doctrine, but having itching ears, will heap up for themselves teachers after their own lusts,"],["4",[["καὶ",2,8],["ἀπὸ",17,1],["μὲν",281,12],["τῆς",1,18],["ἀληθείας",352,19],["τὴν",1,9],["ἀκοὴν",1047,10],["ἀποστρέψουσιν",130,207],["ἐπὶ",9,1],["δὲ",14,8],["τοὺς",1,56],["μύθους",7745,31],["ἐκτραπήσονται",9331,135]],"and will turn away their ears from the truth, and turn away to fables."],["5",[["Σὺ",5,156],["δὲ",14,8],["νῆφε",11173,239],["ἐν",4,1],["πᾶσιν",11,90],["κακοπάθησον",7302,198],["ἔργον",105,33],["ποίησον",23,198],["εὐαγγελιστοῦ",10721,21],["τὴν",1,9],["διακονίαν",6977,10],["σου",5,146],["πληροφόρησον",7986,198]],"But you be sober in all things, suffer hardship, do the work of an evangelist, and fulfill your ministry."],["6",[["Ἐγὼ",6,156],["γὰρ",40,8],["ἤδη",916,17],["σπένδομαι",1787,572],["καὶ",2,8],["ὁ",1,4],["καιρὸς",132,5],["τῆς",1,18],["ἀναλύσεώς",11281,19],["μου",9994,146],["ἐφέστηκεν",631,165]],"For I am already being offered, and the time of my departure has come."],["7",[["τὸν",1,6],["καλὸν",266,59],["ἀγῶνα",2302,7],["ἠγώνισμαι",3155,869],["τὸν",1,6],["δρόμον",2887,7],["τετέλεκα",1482,85],["τὴν",1,9],["πίστιν",887,10],["τετήρηκα",1358,85]],"I have fought the good fight. I have finished the course. I have kept the faith."],["8",[["λοιπὸν",2461,29],["ἀπόκειταί",4534,728],["μοι",9994,151],["ὁ",1,4],["τῆς",1,18],["δικαιοσύνης",187,19],["στέφανος",980,5],["ὃν",24,106],["ἀποδώσει",312,120],["μοι",9994,151],["ὁ",1,4],["κύριος",7,5],["ἐν",4,1],["ἐκείνῃ",80,200],["τῇ",1,95],["ἡμέρᾳ",28,2],["ὁ",1,4],["δίκαιος",153,16],["κριτής",749,5],["οὐ",12,12],["μόνον",302,29],["δὲ",14,8],["ἐμοί",6,151],["ἀλλὰ",108,8],["καὶ",2,8],["πᾶσιν",11,215],["τοῖς",1,138],["ἠγαπηκόσιν",214,552],["τὴν",1,9],["ἐπιφάνειαν",2540,10],["αὐτοῦ",3,48]],"From now on, the crown of righteousness is stored up for me, which the Lord, the righteous judge, will give to me on that day; and not to me only, but also to all those who have loved his appearing."],["9",[["Σπούδασον",2490,198],["ἐλθεῖν",55,100],["πρός",15,1],["με",9994,161],["ταχέως",1563,17]],"Be diligent to come to me soon,"],["10",[["Δημᾶς",11159,5],["γάρ",40,8],["με",9994,161],["ἐγκατέλιπεν",364,3],["ἀγαπήσας",214,155],["τὸν",1,6],["νῦν",90,17],["αἰῶνα",100,7],["καὶ",2,8],["ἐπορεύθη",49,715],["εἰς",8,1],["Θεσσαλονίκην",10636,10],["Κρήσκης",11282,5],["εἰς",8,1],["Γαλατίαν",10988,10],["Τίτος",6801,5],["εἰς",8,1],["Δαλματίαν",11283,10]],"for Demas left me, having loved this present world, and went to Thessalonica; Crescens to Galatia; and Titus to Dalmatia."],["11",[["Λουκᾶς",11158,5],["ἐστιν",10,87],["μόνος",302,16],["μετ᾽",29,1],["ἐμοῦ",6,88],["Μᾶρκον",10572,7],["ἀναλαβὼν",575,155],["ἄγε",224,239],["μετὰ",29,1],["σεαυτοῦ",10014,48],["ἔστιν",10,87],["γάρ",40,8],["μοι",9994,151],["εὔχρηστος",5639,16],["εἰς",8,1],["διακονίαν",6977,10]],"Only Luke is with me. Take Mark and bring him with you, for he is useful to me for service."],["12",[["Τύχικον",10704,7],["δὲ",14,8],["ἀπέστειλα",84,147],["εἰς",8,1],["Ἔφεσον",10672,10]],"But I sent Tychicus to Ephesus."],["13",[["Τὸν",1,6],["φαιλόνην",11284,7],["ὃν",24,106],["ἀπέλιπον",1604,147],["ἐν",4,1],["Τρῳάδι",10619,2],["παρὰ",73,1],["Κάρπῳ",11285,113],["ἐρχόμενος",55,723],["φέρε",199,239],["καὶ",2,8],["τὰ",1,42],["βιβλία",339,43],["μάλιστα",3593,17],["τὰς",1,39],["μεμβράνας",11286,40]],"Bring the cloak that I left at Troas with Carpus when you come—and the books, especially the parchments."],["14",[["Ἀλέξανδρος",1530,5],["ὁ",1,4],["χαλκεὺς",2128,5],["πολλά",74,65],["μοι",9994,151],["κακὰ",161,65],["ἐνεδείξατο",2528,26],["ἀποδώσει",312,120],["αὐτῷ",3,49],["ὁ",1,4],["κύριος",7,5],["κατὰ",32,1],["τὰ",1,42],["ἔργα",105,43],["αὐτοῦ",3,48]],"Alexander the coppersmith did much evil to me. The Lord will repay him according to his deeds."],["15",[["ὃν",24,106],["καὶ",2,8],["σὺ",5,156],["φυλάσσου",125,493],["λίαν",1898,17],["γὰρ",40,8],["ἀντέστη",796,3],["τοῖς",1,138],["ἡμετέροις",10505,215],["λόγοις",48,139]],"Beware of him, for he greatly opposed our words."],["16",[["Ἐν",4,1],["τῇ",1,95],["πρώτῃ",315,96],["μου",9994,146],["ἀπολογίᾳ",9017,2],["οὐδείς",228,16],["μοι",9994,151],["παρεγένετο",377,737],["ἀλλὰ",108,8],["πάντες",11,130],["με",9994,161],["ἐγκατέλιπον",364,141],["μὴ",25,12],["αὐτοῖς",3,142],["λογισθείη",495,945]],"At my first defense, no one came to help me, but all left me. May it not be held against them."],["17",[["ὁ",1,4],["δὲ",14,8],["κύριός",7,5],["μοι",9994,151],["παρέστη",595,3],["καὶ",2,8],["ἐνεδυνάμωσέν",9400,3],["με",9994,161],["ἵνα",102,8],["δι᾽",56,1],["ἐμοῦ",6,88],["τὸ",1,27],["κήρυγμα",4287,20],["πληροφορηθῇ",7986,333],["καὶ",2,8],["ἀκούσωσιν",54,224],["πάντα",11,74],["τὰ",1,253],["ἔθνη",60,63],["καὶ",2,8],["ἐρρύσθην",337,148],["ἐκ",21,1],["στόματος",123,24],["λέοντος",424,21]],"But the Lord stood by me and strengthened me, that through me the message might be fully proclaimed, and that all the Gentiles might hear. So I was delivered out of the mouth of the lion."],["18",[["ῥύσεταί",337,718],["με",9994,161],["ὁ",1,4],["κύριος",7,5],["ἀπὸ",17,1],["παντὸς",11,88],["ἔργου",105,24],["πονηροῦ",164,88],["καὶ",2,8],["σώσει",172,120],["εἰς",8,1],["τὴν",1,9],["βασιλείαν",157,10],["αὐτοῦ",3,48],["τὴν",1,9],["ἐπουράνιον",4098,37],["ᾧ",24,202],["ἡ",1,11],["δόξα",141,13],["εἰς",8,1],["τοὺς",1,56],["αἰῶνας",100,31],["τῶν",1,76],["αἰώνων",100,77],["ἀμήν",3161,316]],"And the Lord will deliver me from every evil work and will preserve me for his heavenly Kingdom. To him be the glory forever and ever. Amen."],["19",[["Ἄσπασαι",2987,751],["Πρίσκαν",10906,10],["καὶ",2,8],["Ἀκύλαν",10658,7],["καὶ",2,8],["τὸν",1,6],["Ὀνησιφόρου",11255,21],["οἶκον",34,7]],"Greet Prisca and Aquila, and the house of Onesiphorus."],["20",[["Ἔραστος",10683,5],["ἔμεινεν",681,3],["ἐν",4,1],["Κορίνθῳ",10657,2],["Τρόφιμον",10705,7],["δὲ",14,8],["ἀπέλιπον",1604,147],["ἐν",4,1],["Μιλήτῳ",6758,2],["ἀσθενοῦντα",771,178]],"Erastus remained at Corinth, but I left Trophimus at Miletus sick."],["21",[["Σπούδασον",2490,198],["πρὸ",238,1],["χειμῶνος",3383,21],["ἐλθεῖν",55,100],["Ἀσπάζεταί",2987,728],["σε",5,161],["Εὔβουλος",11287,5],["καὶ",2,8],["Πούδης",11288,5],["καὶ",2,8],["Λίνος",5451,5],["καὶ",2,8],["Κλαυδία",11289,13],["καὶ",2,8],["οἱ",1,128],["ἀδελφοὶ",67,51],["πάντες",11,130]],"Be diligent to come before winter. Eubulus salutes you, as do Pudens, Linus, Claudia, and all the brothers."],["22",[["Ὁ",1,4],["κύριος",7,5],["μετὰ",29,1],["τοῦ",1,23],["πνεύματός",168,24],["σου",5,146],["ἡ",1,11],["χάρις",368,13],["μεθ᾽",29,1],["ὑμῶν",5,136]],"The Lord Jesus Christ be with your spirit. Grace be with you. Amen."]]