[["1",[["Τοῦτο",16,122],["δὲ",14,8],["γίνωσκε",79,239],["ὅτι",19,8],["ἐν",4,1],["ἐσχάταις",410,287],["ἡμέραις",28,71],["ἐνστήσονται",2531,740],["καιροὶ",132,51],["χαλεποί",2645,130]],"But know this: that in the last days, grievous times will come."],["2",[["ἔσονται",10,740],["γὰρ",40,8],["οἱ",1,128],["ἄνθρωποι",43,51],["φίλαυτοι",11266,130],["φιλάργυροι",8612,130],["ἀλαζόνες",5172,51],["ὑπερήφανοι",1109,130],["βλάσφημοι",3506,130],["γονεῦσιν",2012,139],["ἀπειθεῖς",3404,130],["ἀχάριστοι",4056,130],["ἀνόσιοι",2984,130]],"For men will be lovers of self, lovers of money, boastful, arrogant, blasphemers, disobedient to parents, unthankful, unholy,"],["3",[["ἄστοργοι",10825,130],["ἄσπονδοι",11267,130],["διάβολοι",1720,130],["ἀκρατεῖς",8788,130],["ἀνήμεροι",11268,130],["ἀφιλάγαθοι",11269,130]],"without natural affection, unforgiving, slanderers, without self-control, fierce, not lovers of good,"],["4",[["προδόται",4364,51],["προπετεῖς",5006,130],["τετυφωμένοι",11211,574],["φιλήδονοι",11270,130],["μᾶλλον",1043,17],["ἢ",61,8],["φιλόθεοι",11271,130]],"traitors, headstrong, conceited, lovers of pleasure rather than lovers of God,"],["5",[["ἔχοντες",124,137],["μόρφωσιν",10831,10],["εὐσεβείας",895,19],["τὴν",1,9],["δὲ",14,8],["δύναμιν",98,10],["αὐτῆς",3,83],["ἠρνημένοι",3710,943],["καὶ",2,8],["τούτους",16,274],["ἀποτρέπου",4533,493]],"holding a form of godliness but having denied its power. Turn away from these, also."],["6",[["ἐκ",21,1],["τούτων",16,220],["γάρ",40,8],["εἰσιν",10,191],["οἱ",1,128],["ἐνδύνοντες",11272,137],["εἰς",8,1],["τὰς",1,39],["οἰκίας",233,40],["καὶ",2,8],["αἰχμαλωτίζοντες",2246,137],["γυναικάρια",11273,43],["σεσωρευμένα",6132,786],["ἁμαρτίαις",119,71],["ἀγόμενα",224,850],["ἐπιθυμίαις",699,71],["ποικίλαις",1558,287]],"For some of these are people who creep into houses and take captive gullible women loaded down with sins, led away by various lusts,"],["7",[["πάντοτε",6027,17],["μανθάνοντα",923,232],["καὶ",2,8],["μηδέποτε",4911,17],["εἰς",8,1],["ἐπίγνωσιν",34