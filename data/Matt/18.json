,372],["τοῖς",1,91],["μὴ",25,12],["πεπλανημένοις",464,797]],"If he finds it, most certainly I tell you, he rejoices over it more than over the ninety-nine which have not gone astray."],["14",[["οὕτως",9989,17],["οὐκ",12,12],["ἔστιν",10,87],["θέλημα",1039,20],["ἔμπροσθεν",390,1],["τοῦ",1,30],["πατρὸς",44,21],["ὑμῶν",5,136],["τοῦ",1,30],["ἐν",4,1],["οὐρανοῖς",94,139],["ἵνα",102,8],["ἀπόληται",596,236],["ἓν",58,28],["τῶν",1,44],["μικρῶν",367,79],["τούτων",16,214]],"Even so it is not the will of your Father who is in heaven that one of these little ones should perish."],["15",[["Ἐὰν",45,8],["δὲ",14,8],["ἁμαρτήσῃ",237,160],["εἰς",8,1],["σὲ",5,161],["ὁ",1,4],["ἀδελφός",67,5],["σου",5,146],["ὕπαγε",6654,239],["ἔλεγξον",752,198],["αὐτὸν",3,82],["μεταξὺ",3893,1],["σοῦ",5,146],["καὶ",2,8],["αὐτοῦ",3,48],["μόνου",302,153],["ἐάν",45,8],["σου",5,146],["ἀκούσῃ",54,160],["ἐκέρδησας",10137,154],["τὸν",1,6],["ἀδελφόν",67,7],["σου",5,146]],"“If your brother sins against you, go, show him his fault between you and him alone. If he listens to you, you have gained back your brother."],["16",[["ἐὰν",45,8],["δὲ",14,8],["μὴ",25,12],["ἀκούσῃ",54,160],["παράλαβε",1385,198],["μετὰ",29,1],["σοῦ",5,146],["ἔτι",111,17],["ἕνα",58,59],["ἢ",61,8],["δύο",104,372],["ἵνα",102,8],["ἐπὶ",9,1],["στόματος",123,24],["δύο",104,372],["μαρτύρων",875,77],["ἢ",61,8],["τριῶν",174,163],["σταθῇ",78,333],["πᾶν",11,28],["ῥῆμα",116,20]],"But if he doesn’t listen, take one or two more with you, that at the mouth of two or three witnesses every word may be established."],["17",[["ἐὰν",45,8],["δὲ",14,8],["παρακούσῃ",3319,160],["αὐτῶν",3,41],["εἰπὲ",9997,198],["τῇ",1,95],["ἐκκλησίᾳ",563,2],["ἐὰν",45,8],["δὲ",14,8],["καὶ",2,8],["τῆς",1,18],["ἐκκλησίας",563,19],["παρακούσῃ",3319,160],["ἔστω",10,35],["σοι",5,151],["ὥσπερ",226,8],["ὁ",1,4],["ἐθνικὸς",10042,16],["καὶ",2,8],["ὁ",1,4],["τελώνης",10041,5]],"If he refuses to listen to them, tell it to the assembly. If he refuses to hear the assembly also, let him be to you as a