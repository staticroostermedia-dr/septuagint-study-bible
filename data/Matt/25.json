[["1",[["Τότε",250,17],["ὁμοιωθήσεται",1175,125],["ἡ",1,11],["βασιλεία",157,13],["τῶν",1,76],["οὐρανῶν",94,77],["δέκα",311,372],["παρθένοις",789,71],["αἵτινες",457,553],["λαβοῦσαι",46,399],["τὰς",1,39],["λαμπάδας",2023,40],["ἑαυτῶν",92,189],["ἐξῆλθον",82,141],["εἰς",8,1],["ὑπάντησιν",9921,10],["τοῦ",1,30],["νυμφίου",2274,21]],"“Then the Kingdom of Heaven will be like ten virgins who took their lamps and went out to meet the bridegroom."],["2",[["πέντε",280,372],["δὲ",14,8],["ἐξ",21,1],["αὐτῶν",3,189],["ἦσαν",10,129],["μωραὶ",1278,187],["καὶ",2,8],["πέντε",280,372],["φρόνιμοι",1211,187]],"Five of them were foolish, and five were wise."],["3",[["αἱ",1,185],["γὰρ",40,8],["μωραὶ",1278,187],["λαβοῦσαι",46,399],["τὰς",1,39],["λαμπάδας",2023,40],["αὐτῶν",3,189],["οὐκ",12,12],["ἔλαβον",46,141],["μεθ᾽",29,1],["ἑαυτῶν",92,189],["ἔλαιον",313,33]],"Those who were foolish, when they took their lamps, took no oil with them,"],["4",[["αἱ",1,185],["δὲ",14,8],["φρόνιμοι",1211,187],["ἔλαβον",46,141],["ἔλαιον",313,33],["ἐν",4,1],["τοῖς",1,91],["ἀγγείοις",1648,92],["μετὰ",29,1],["τῶν",1,123],["λαμπάδων",2023,61],["ἑαυτῶν",92,189]],"but the wise took oil in their vessels with their lamps."],["5",[["χρονίζοντος",1746,143],["δὲ",14,8],["τοῦ",1,30],["νυμφίου",2274,21],["ἐνύσταξαν",2471,141],["πᾶσαι",11,187],["καὶ",2,8],["ἐκάθευδον",1724,129]],"Now while the bridegroom delayed, they all slumbered and slept."],["6",[["Μέσης",113,78],["δὲ",14,8],["νυκτὸς",219,19],["κραυγὴ",828,13],["γέγονεν",30,165],["ἰδοὺ",51,316],["ὁ",1,4],["νυμφίος",2274,5],["ἐξέρχεσθε",82,742],["εἰς",8,1],["ἀπάντησιν",1428,10],["αὐτοῦ",3,48]],"But at midnight there was a cry, ‘Behold! The bridegroom is coming! Come out to meet him!’"],["7",[["τότε",250,17],["ἠγέρθησαν",746,94],["πᾶσαι",11,187],["αἱ",1,185],["παρθένοι",789,180],["ἐκεῖναι",80,196],["καὶ",2,8],["ἐκόσμησαν",1680,141],["τὰς",1,39],["λαμπάδας",2023,40],["ἑαυτῶν",92,189]],"Then all those virgins arose, and trimmed their lamps."],["8",[["αἱ",1,185],["δὲ",14,8],["