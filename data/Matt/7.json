[["1",[["Μὴ",25,12],["κρίνετε",263,307],["ἵνα",102,8],["μὴ",25,12],["κριθῆτε",263,485]],"“Don’t judge, so that you won’t be judged."],["2",[["ἐν",4,1],["ᾧ",24,410],["γὰρ",40,8],["κρίματι",267,53],["κρίνετε",263,84],["κριθήσεσθε",263,258],["καὶ",2,8],["ἐν",4,1],["ᾧ",24,410],["μέτρῳ",717,53],["μετρεῖτε",3299,84],["μετρηθήσεται",3299,125],["ὑμῖν",5,86]],"For with whatever judgment you judge, you will be judged; and with whatever measure you measure, it will be measured to you."],["3",[["τί",10010,119],["δὲ",14,8],["βλέπεις",470,145],["τὸ",1,32],["κάρφος",7546,33],["τὸ",1,32],["ἐν",4,1],["τῷ",1,110],["ὀφθαλμῷ",91,113],["τοῦ",1,30],["ἀδελφοῦ",67,21],["σου",5,146],["τὴν",1,9],["δὲ",14,8],["ἐν",4,1],["τῷ",1,110],["σῷ",10053,111],["ὀφθαλμῷ",91,113],["δοκὸν",3525,10],["οὐ",12,12],["κατανοεῖς",1549,145]],"Why do you see the speck that is in your brother’s eye, but don’t consider the beam that is in your own eye?"],["4",[["ἢ",61,8],["πῶς",10049,12],["ἐρεῖς",10054,159],["τῷ",1,110],["ἀδελφῷ",67,113],["σου",5,146],["ἄφες",501,198],["ἐκβάλω",585,227],["τὸ",1,32],["κάρφος",7546,33],["ἐκ",21,1],["τοῦ",1,30],["ὀφθαλμοῦ",91,21],["σου",5,146],["καὶ",2,8],["ἰδοὺ",51,316],["ἡ",1,11],["δοκὸς",3525,13],["ἐν",4,1],["τῷ",1,110],["ὀφθαλμῷ",91,113],["σοῦ",5,146]],"Or how will you tell your brother, ‘Let me remove the speck from your eye,’ and behold, the beam is in your own eye?"],["5",[["ὑποκριτά",6647,250],["ἔκβαλε",585,198],["πρῶτον",315,29],["ἐκ",21,1],["τοῦ",1,30],["ὀφθαλμοῦ",91,21],["σοῦ",5,146],["τὴν",1,9],["δοκόν",3525,10],["καὶ",2,8],["τότε",250,17],["διαβλέψεις",10055,159],["ἐκβαλεῖν",585,100],["τὸ",1,32],["κάρφος",7546,33],["ἐκ",21,1],["τοῦ",1,30],["ὀφθαλμοῦ",91,21],["τοῦ",1,30],["ἀδελφοῦ",67,21],["σου",5,146]],"You hypocrite! First remove the beam out of your own eye, and then you can see clearly to remove the speck out of your brother’s eye."],["6",[["Μὴ",25,12],["δῶτε",33,118],["τὸ",1,32],["ἅγιον",75,29],["τοῖς",1,138],["κυσὶν",1204,139],["μηδὲ",414,8],["βάλητε",766,118],["τοὺς"