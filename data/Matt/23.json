[["1",[["Τότε",250,17],["ὁ",1,4],["Ἰησοῦς",211,5],["ἐλάλησεν",50,3],["τοῖς",1,138],["ὄχλοις",1008,139],["καὶ",2,8],["τοῖς",1,138],["μαθηταῖς",10025,139],["αὐτοῦ",3,48]],"Then Jesus spoke to the multitudes and to his disciples,"],["2",[["λέγων",31,67],["ἐπὶ",9,1],["τῆς",1,18],["Μωϋσέως",5453,21],["καθέδρας",2083,19],["ἐκάθισαν",274,141],["οἱ",1,128],["γραμματεῖς",632,51],["καὶ",2,8],["οἱ",1,128],["Φαρισαῖοι",10006,51]],"saying, “The scribes and the Pharisees sit on Moses’ seat."],["3",[["πάντα",11,65],["οὖν",227,8],["ὅσα",103,755],["ἐὰν",45,8],["εἴπωσιν",31,224],["ὑμῖν",5,86],["ποιήσατε",23,69],["καὶ",2,8],["τηρεῖτε",1358,307],["κατὰ",32,1],["δὲ",14,8],["τὰ",1,42],["ἔργα",105,43],["αὐτῶν",3,41],["μὴ",25,12],["ποιεῖτε",23,307],["λέγουσιν",31,191],["γὰρ",40,8],["καὶ",2,8],["οὐ",12,12],["ποιοῦσιν",23,191]],"All things therefore whatever they tell you to observe, observe and do, but don’t do their works; for they say, and don’t do."],["4",[["δεσμεύουσιν",2702,191],["δὲ",14,8],["φορτία",3664,43],["βαρέα",1031,65],["καὶ",2,8],["δυσβάστακτα",7093,65],["καὶ",2,8],["ἐπιτιθέασιν",239,191],["ἐπὶ",9,1],["τοὺς",1,56],["ὤμους",1011,31],["τῶν",1,76],["ἀνθρώπων",43,77],["αὐτοὶ",3,195],["δὲ",14,8],["τῷ",1,110],["δακτύλῳ",1182,113],["αὐτῶν",3,41],["οὐ",12,12],["θέλουσιν",612,191],["κινῆσαι",992,100],["αὐτά",3,66]],"For they bind heavy burdens that are grievous to be borne, and lay them on men’s shoulders; but they themselves will not lift a finger to help them."],["5",[["πάντα",11,65],["δὲ",14,8],["τὰ",1,42],["ἔργα",105,43],["αὐτῶν",3,41],["ποιοῦσιν",23,191],["πρὸς",15,1],["τὸ",1,32],["θεαθῆναι",3062,175],["τοῖς",1,138],["ἀνθρώποις",43,139],["πλατύνουσιν",1779,191],["γὰρ",40,8],["τὰ",1,42],["φυλακτήρια",10169,43],["αὐτῶν",3,41],["καὶ",2,8],["μεγαλύνουσιν",604,191],["τὰ",1,42],["κράσπεδα",3868,43]],"But they do all their works to be seen by men. They make their phylacteries broad and enlarge the fringes of their garments,"],["6",[["φιλοῦσιν",1391,191],["δὲ",14,8],["τὴν",1,9],["πρωτοκλισίαν",8148,10],["ἐν",4,1],["τοῖς",1,91],["δείπνοις",4739,92],["καὶ",2,8],["τὰς",1,39],["πρωτοκαθεδρίας",10170,40],["ἐν",4,1],["ταῖς",1,70],["συναγωγαῖς",284,71]],"and love the place of honor at feasts, the best seats in the synagogues,"],["7",[["καὶ",2,8],["τοὺς",1,56],["ἀσπασμοὺς",10171,31],["ἐν",4,1],["ταῖς",1,70],["ἀγοραῖς",2648,71],["καὶ",2,8],["καλεῖσθαι",128,634],["ὑπὸ",122,1],["τῶν",1,76],["ἀνθρώπων",43,77],["ῥαββί",10172,5]],"the salutations in the marketplaces, and to be called ‘Rabbi, Rabbi’ by men."],["8",[["ὑμεῖς",5,208],["δὲ",14,8],["μὴ",25,12],["κληθῆτε",128,485],["ῥαββί",10172,5],["εἷς",58,16],["γάρ",40,8],["ἐστιν",10,87],["ὑμῶν",5,136],["ὁ",1,4],["διδάσκαλος",7031,5],["πάντες",11,130],["δὲ",14,8],["ὑμεῖς",5,208],["ἀδελφοί",67,51],["ἐστε",10,84]],"But you are not to be called ‘Rabbi’, for one is your teacher, the Christ, and all of you are brothers."],["9",[["Καὶ",2,8],["πατέρα",44,7],["μὴ",25,12],["καλέσητε",128,118],["ὑμῶν",5,136],["ἐπὶ",9,1],["τῆς",1,18],["γῆς",26,19],["εἷς",58,16],["γάρ",40,8],["ἐστιν",10,87],["ὑμῶν",5,136],["ὁ",1,4],["πατὴρ",44,5],["ὁ",1,4],["οὐράνιος",3602,16]],"Call no man on the earth your father, for one is your Father, he who is in heaven."],["10",[["μηδὲ",414,8],["κληθῆτε",128,485],["καθηγηταί",10173,51],["ὅτι",19,8],["καθηγητὴς",10173,5],["ὑμῶν",5,136],["ἐστιν",10,87],["εἷς",58,16],["ὁ",1,4],["Χριστός",1072,5]],"Neither be called masters, for one is your master, the Christ."],["11",[["ὁ",1,4],["δὲ",14,8],["μείζων",66,16],["ὑμῶν",5,136],["ἔσται",10,718],["ὑμῶν",5,136],["διάκονος",3263,5]],"But he who is greatest among you will be your servant."],["12",[["ὅστις",457,246],["δὲ",14,8],["ὑψώσει",331,120],["ἑαυτὸν",92,82],["ταπεινωθήσεται",322,125],["καὶ",2,8],["ὅστις",457,246],["ταπεινώσει",322,120],["ἑαυτὸν",92,82],["ὑψωθήσεται",331,125]],"Whoever exalts himself will be humbled, and whoever humbles himself will be exalted."],["13",[["Οὐαὶ",769,316],["δὲ",14,8],["ὑμῖν",5,86],["γραμματεῖς",632,396],["καὶ",2,8],["Φαρισαῖοι",10006,396],["ὑποκριταί",6647,396],["ὅτι",19,8],["κλείετε",1514,84],["τὴν",1,9],["βασιλείαν",157,10],["τῶν",1,76],["οὐρανῶν",94,77],["ἔμπροσθεν",390,1],["τῶν",1,76],["ἀνθρώπων",43,77],["ὑμεῖς",5,208],["γὰρ",40,8],["οὐκ",12,12],["εἰσέρχεσθε",86,754],["οὐδὲ",106,8],["τοὺς",1,56],["εἰσερχομένους",86,729],["ἀφίετε",501,84],["εἰσελθεῖν",86,100]],"“Woe to you, scribes and Pharisees, hypocrites! For you devour widows’ houses, and as a pretense you make long prayers. Therefore you will receive greater condemnation."],["14",[],"“But woe to you, scribes and Pharisees, hypocrites! Because you shut up the Kingdom of Heaven against men; for you don’t enter in yourselves, neither do you allow those who are entering in to enter.",{"s":"g0"}],["15",[["Οὐαὶ",769,316],["ὑμῖν",5,86],["γραμματεῖς",632,396],["καὶ",2,8],["Φαρισαῖοι",10006,396],["ὑποκριταί",6647,396],["ὅτι",19,8],["περιάγετε",3326,84],["τὴν",1,9],["θάλασσαν",137,10],["καὶ",2,8],["τὴν",1,9],["ξηρὰν",1186,37],["ποιῆσαι",23,100],["ἕνα",58,59],["προσήλυτον",634,7],["καὶ",2,8],["ὅταν",319,8],["γένηται",30,745],["ποιεῖτε",23,84],["αὐτὸν",3,82],["υἱὸν",13,7],["γεέννης",10034,19],["διπλότερον",3050,59],["ὑμῶν",5,136]],"Woe to you, scribes and Pharisees, hypocrites! For you travel around by sea and land to make one proselyte; and when he becomes one, you make him twice as much a son of Gehenna as yourselves."],["16",[["Οὐαὶ",769,316],["ὑμῖν",5,86],["ὁδηγοὶ",4128,396],["τυφλοὶ",1600,537],["οἱ",1,538],["λέγοντες",31,619],["ὃς",24,246],["ἂν",83,12],["ὀμόσῃ",347,160],["ἐν",4,1],["τῷ",1,110],["ναῷ",483,113],["οὐδέν",228,28],["ἐστιν",10,87],["ὃς",24,246],["δ᾽",14,8],["ἂν",83,12],["ὀμόσῃ",347,160],["ἐν",4,1],["τῷ",1,110],["χρυσῷ",1602,113],["τοῦ",1,30],["ναοῦ",483,21],["ὀφείλει",2150,87]],"“Woe to you, you blind guides, who say, ‘Whoever swears by the temple, it is nothing; but whoever swears by the gold of the temple, he is obligated.’"],["17",[["μωροὶ",1278,537],["καὶ",2,8],["τυφλοί",1600,537],["τίς",10010,150],["γὰρ",40,8],["μείζων",66,16],["ἐστίν",10,87],["ὁ",1,4],["χρυσὸς",1602,5],["ἢ",61,8],["ὁ",1,4],["ναὸς",483,5],["ὁ",1,4],["ἁγιάσας",329,155],["τὸν",1,6],["χρυσόν",1602,7]],"You blind fools! For which is greater, the gold or the temple that sanctifies the gold?"],["18",[["καὶ",2,8],["ὃς",24,246],["ἂν",83,12],["ὀμόσῃ",347,160],["ἐν",4,1],["τῷ",1,52],["θυσιαστηρίῳ",133,53],["οὐδέν",228,28],["ἐστιν",10,87],["ὃς",24,246],["δ᾽",14,8],["ἂν",83,12],["ὀμόσῃ",347,160],["ἐν",4,1],["τῷ",1,52],["δώρῳ",348,53],["τῷ",1,52],["ἐπάνω",491,1],["αὐτοῦ",3,144],["ὀφείλει",2150,87]],"And, ‘Whoever swears by the altar, it is nothing; but whoever swears by the gift that is on it, he is obligated.’"],["19",[["τυφλοί",1600,537],["τί",10010,238],["γὰρ",40,8],["μεῖζον",66,28],["τὸ",1,27],["δῶρον",348,20],["ἢ",61,8],["τὸ",1,27],["θυσιαστήριον",133,20],["τὸ",1,27],["ἁγιάζον",329,36],["τὸ",1,32],["δῶρον",348,33]],"You blind fools! For which is greater, the gift, or the altar that sanctifies the gift?"],["20",[["ὁ",1,4],["οὖν",227,8],["ὀμόσας",347,155],["ἐν",4,1],["τῷ",1,52],["θυσιαστηρίῳ",133,53],["ὀμνύει",347,87],["ἐν",4,1],["αὐτῷ",3,233],["καὶ",2,8],["ἐν",4,1],["πᾶσιν",11,90],["τοῖς",1,91],["ἐπάνω",491,1],["αὐτοῦ",3,144]],"He therefore who swears by the altar, swears by it and by everything on it."],["21",[["καὶ",2,8],["ὁ",1,4],["ὀμόσας",347,155],["ἐν",4,1],["τῷ",1,110],["ναῷ",483,113],["ὀμνύει",347,87],["ἐν",4,1],["αὐτῷ",3,49],["καὶ",2,8],["ἐν",4,1],["τῷ",1,110],["κατοικοῦντι",89,390],["αὐτόν",3,82]],"He who swears by the temple, swears by it and by him who has been living in it."],["22",[["καὶ",2,8],["ὁ",1,4],["ὀμόσας",347,155],["ἐν",4,1],["τῷ",1,110],["οὐρανῷ",94,113],["ὀμνύει",347,87],["ἐν",4,1],["τῷ",1,110],["θρόνῳ",383,113],["τοῦ",1,30],["θεοῦ",20,21],["καὶ",2,8],["ἐν",4,1],["τῷ",1,110],["καθημένῳ",419,808],["ἐπάνω",491,1],["αὐτοῦ",3,48]],"He who swears by heaven, swears by the throne of God and by him who sits on it."],["23",[["Οὐαὶ",769,316],["ὑμῖν",5,86],["γραμματεῖς",632,396],["καὶ",2,8],["Φαρισαῖοι",10006,396],["ὑπ