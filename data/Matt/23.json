",2,8],["Φαρισαῖοι",10006,396],["ὑποκριταί",6647,396],["ὅτι",19,8],["παρομοιάζετε",10179,84],["τάφοις",865,139],["κεκονιαμένοις",4278,804],["οἵτινες",457,455],["ἔξωθεν",1050,1],["μὲν",281,12],["φαίνονται",832,299],["ὡραῖοι",1296,130],["ἔσωθεν",1610,17],["δὲ",14,8],["γέμουσιν",3256,191],["ὀστέων",473,45],["νεκρῶν",659,163],["καὶ",2,8],["πάσης",11,78],["ἀκαθαρσίας",888,19]],"“Woe to you, scribes and Pharisees, hypocrites! For you are like whitened tombs, which outwardly appear beautiful, but inwardly are full of dead men’s bones and of all uncleanness."],["28",[["οὕτως",71,17],["καὶ",2,8],["ὑμεῖς",5,208],["ἔξωθεν",1050,1],["μὲν",281,12],["φαίνεσθε",832,68],["τοῖς",1,138],["ἀνθρώποις",43,139],["δίκαιοι",153,130],["ἔσωθεν",1610,17],["δέ",14,8],["ἐστε",10,84],["μεστοὶ",4306,130],["ὑποκρίσεως",9927,19],["καὶ",2,8],["ἀνομίας",275,19]],"Even so you also outwardly appear righteous to men, but inwardly you are full of hypocrisy and iniquity."],["29",[["Οὐαὶ",769,316],["ὑμῖν",5,86],["γραμματεῖς",632,396],["καὶ",2,8],["Φαρισαῖοι",10006,396],["ὑποκριταί",6647,396],["ὅτι",19,8],["οἰκοδομεῖτε",126,84],["τοὺς",1,56],["τάφους",865,31],["τῶν",1,76],["προφητῶν",176,77],["καὶ",2,8],["κοσμεῖτε",1680,84],["τὰ",1,42],["μνημεῖα",2176,43],["τῶν",1,76],["δικαίων",153,163]],"“Woe to you, scribes and Pharisees, hypocrites! For you build the tombs of the prophets and decorate the tombs of the righteous,"],["30",[["καὶ",2,8],["λέγετε",31,84],["εἰ",77,8],["ἤμεθα",10,517],["ἐν",4,1],["ταῖς",1,70],["ἡμέραις",28,71],["τῶν",1,76],["πατέρων",44,77],["ἡμῶν",9994,136],["οὐκ",12,12],["ἂν",83,12],["ἤμεθα",10,517],["αὐτῶν",3,41],["κοινωνοὶ",3562,51],["ἐν",4,1],["τῷ",1,52],["αἵματι",148,53],["τῶν",1,76],["προφητῶν",176,77]],"and say, ‘If we had lived in the days of our fathers, we wouldn’t have been partakers with them in the blood of the prophets.’"],["31",[["ὥστε",346,8],["μαρτυρεῖτε",2094,84],["ἑαυτοῖς",92,142],["ὅτι",19,8],["υἱοί",13,51],["ἐστε",10,84],["τῶν",1,76],["φονευσάντων",970,211],["τοὺς",1,56],