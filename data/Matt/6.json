[["1",[["Προσέχετε",558,307],["δὲ",14,8],["τὴν",1,9],["δικαιοσύνην",187,10],["ὑμῶν",5,136],["μὴ",25,12],["ποιεῖν",23,54],["ἔμπροσθεν",390,1],["τῶν",1,76],["ἀνθρώπων",43,77],["πρὸς",15,1],["τὸ",1,32],["θεαθῆναι",3062,175],["αὐτοῖς",3,142],["εἰ",77,8],["δὲ",14,8],["μή",25,12],["γε",353,12],["μισθὸν",816,7],["οὐκ",12,12],["ἔχετε",124,84],["παρὰ",73,1],["τῷ",1,110],["πατρὶ",44,113],["ὑμῶν",5,136],["τῷ",1,110],["ἐν",4,1],["τοῖς",1,138],["οὐρανοῖς",94,139]],"“Be careful that you don’t do your charitable giving before men, to be seen by them, or else you have no reward from your Father who is in heaven."],["2",[["Ὅταν",319,8],["οὖν",227,8],["ποιῇς",23,199],["ἐλεημοσύνην",942,10],["μὴ",25,12],["σαλπίσῃς",845,170],["ἔμπροσθέν",390,1],["σου",5,146],["ὥσπερ",226,8],["οἱ",1,128],["ὑποκριταὶ",6647,51],["ποιοῦσιν",23,191],["ἐν",4,1],["ταῖς",1,70],["συναγωγαῖς",284,71],["καὶ",2,8],["ἐν",4,1],["ταῖς",1,70],["ῥύμαις",5434,71],["ὅπως",240,8],["δοξασθῶσιν",452,266],["ὑπὸ",122,1],["τῶν",1,76],["ἀνθρώπων",43,77],["ἀμὴν",3161,316],["λέγω",31,149],["ὑμῖν",5,86],["ἀπέχουσιν",1255,191],["τὸν",1,6],["μισθὸν",816,7],["αὐτῶν",3,41]],"Therefore, when you do merciful deeds, don’t sound a trumpet before yourself, as the hypocrites do in the synagogues and in the streets, that they may get glory from men. Most certainly I tell you, they have received their reward."],["3",[["σοῦ",5,146],["δὲ",14,8],["ποιοῦντος",23,143],["ἐλεημοσύνην",942,10],["μὴ",25,12],["γνώτω",79,46],["ἡ",1,11],["ἀριστερά",878,15],["σου",5,146],["τί",10010,119],["ποιεῖ",23,87],["ἡ",1,11],["δεξιά",282,15],["σου",5,146]],"But when you do merciful deeds, don’t let your left hand know what your right hand does,"],["4",[["ὅπως",240,8],["ᾖ",10,173],["σου",5,146],["ἡ",1,11],["ἐλεημοσύνη",942,13],["ἐν",4,1],["τῷ",1,52],["κρυπτῷ",1822,34],["καὶ",2,8],["ὁ",1,4],["πατήρ",44,5],["σου",5,146],["ὁ",1,4],["βλέπων",470,67],["ἐν",4,1],["τῷ",1,52],["κρυπτῷ",1822,34],["ἀποδώσει",312,120],["σοι",5,151]],"so that your merciful deeds may be in secret, then your Father who sees in secret will reward you openly."],["5",[["Καὶ",2,8],["ὅταν",319,8],["προσεύχησθε",551,748],["οὐκ",12,12],["ἔσεσθε",10,747],["ὡς",36,12],["οἱ",1,128],["ὑποκριταί",6647,51],["ὅτι",19,8],["φιλοῦσιν",1391,191],["ἐν",4,1],["ταῖς",1,70],["συναγωγαῖς",284,71],["καὶ",2,8],["ἐν",4,1],["ταῖς",1,70],["γωνίαις",1377,71],["τῶν",1,123],["πλατειῶν",925,61],["ἑστῶτες",78,263],["προσεύχεσθαι",551,749],["ὅπως",240,8],["φανῶσιν",832,266],["τοῖς",1,138],["ἀνθρώποις",43,139],["ἀμὴν",3161,316],["λέγω",31,149],["ὑμῖν",5,86],["ἀπέχουσιν",1255,191],["τὸν",1,6],["μισθὸν",816,7],["αὐτῶν",3,41]],"“When you pray, you shall not be as the hypocrites, for they love to stand and pray in the synagogues and in the corners of the streets, that they may be seen by men. Most certainly, I tell you, they have received their reward."],["6",[["σὺ",5,156],["δέ",14,8],["ὅταν",319,8],["προσεύχῃ",551,750],["εἴσελθε",86,198],["εἰς",8,1],["τὸ",1,32],["ταμεῖόν",1528,33],["σου",5,146],["καὶ",2,8],["κλείσας",1514,155],["τὴν",1,9],["θύραν",277,10],["σου",5,146],["πρόσευξαι",551,751],["τῷ",1,110],["πατρί",44,113],["σου",5,146],["τῷ",1,110],["ἐν",4,1],["τῷ",1,52],["κρυπτῷ",1822,34],["καὶ",2,8],["ὁ",1,4],["πατήρ",44,5],["σου",5,146],["ὁ",1,4],["βλέπων",470,67],["ἐν",4,1],["τῷ",1,52],["κρυπτῷ",1822,34],["ἀποδώσει",312,120],["σοι",5,151]],"But you, when you pray, enter into your inner room, and having shut your door, pray to your Father who is in secret; and your Father who sees in secret will reward you openly."],["7",[["προσευχόμενοι",551,741],["δὲ",14,8],["μὴ",25,12],["βατταλογήσητε",10043,118],["ὥσπερ",226,8],["οἱ",1,128],["ἐθνικοί",10042,130],["δοκοῦσιν",801,191],["γὰρ",40,8],["ὅτι",19,8],["ἐν",4,1],["τῇ",1,95],["πολυλογίᾳ",8006,2],["αὐτῶν",3,41],["εἰσακουσθήσονται",241,135]],"In praying, don’t use vain repetitions as the Gentiles do; for they think that they will be heard for their much speaking."],["8",[["μὴ",25,12],["οὖν",227,8],["ὁμοιωθῆτε",1175,485],["αὐτοῖς",3,142],["οἶδεν",10044,165],["γὰρ",40,8],["ὁ",1,4],["πατὴρ",44,5],["ὑμῶν",5,136],["ὧν",24,97],["χρείαν",1006,10],["ἔχετε",124,84],["πρὸ",238,1],["τοῦ",1,23],["ὑμᾶς",5,209],["αἰτῆσαι",617,100],["αὐτόν",3,82]],"Therefore don’t be like them, for your Father knows what things you need before you ask him."],["9",[["Οὕτως",9989,17],["οὖν",227,8],["προσεύχεσθε",551,742],["ὑμεῖς",5,208],["πάτερ",44,250],["ἡμῶν",9994,136],["ὁ",1,752],["ἐν",4,1],["τοῖς",1,138],["οὐρανοῖς",94,139],["ἁγιασθήτω",329,25],["τὸ",1,27],["ὄνομά",57,20],["σου",5,146]],"Pray like this: “‘Our Father in heaven, may your name be kept holy."],["10",[["ἐλθέτω",55,46],["ἡ",1,11],["βασιλεία",157,13],["σου",5,146],["γενηθήτω",30,753],["τὸ",1,27],["θέλημά",1039,20],["σου",5,146],["ὡς",36,12],["ἐν",4,1],["οὐρανῷ",94,113],["καὶ",2,8],["ἐπὶ",9,1],["γῆς",26,19]],"Let your Kingdom come. Let your will be done on earth as it is in heaven."],["11",[["τὸν",1,6],["ἄρτον",197,7],["ἡμῶν",9994,136],["τὸν",1,6],["ἐπιούσιον",10045,59],["δὸς",33,198],["ἡμῖν",9994,86],["σήμερον",205,17]],"Give us today our daily bread."],["12",[["καὶ",2,8],["ἄφες",501,198],["ἡμῖν",9994,86],["τὰ",1,42],["ὀφειλήματα",4642,43],["ἡμῶν",9994,136],["ὡς",36,12],["καὶ",2,8],["ἡμεῖς",9994,208],["ἀφήκαμεν",501,285],["τοῖς",1,138],["ὀφειλέταις",10046,139],["ἡμῶν",9994,136]],"Forgive us our debts, as we also forgive our debtors."],["13",[["καὶ",2,8],["μὴ",25,12],["εἰσενέγκῃς",587,170],["ἡμᾶς",9994,209],["εἰς",8,1],["πειρασμόν",2281,7],["ἀλλὰ",108,8],["ῥῦσαι",337,751],["ἡμᾶς",9994,209],["ἀπὸ",17,1],["τοῦ",1,23],["πονηροῦ",164,88]],"Bring us not into temptation, but deliver us from the evil one. For yours is the Kingdom, the power, and the glory forever. Amen.’"],["14",[["ἐὰν",45,8],["γὰρ",40,8],["ἀφῆτε",501,118],["τοῖς",1,138],["ἀνθρώποις",43,139],["τὰ",1,42],["παραπτώματα",1910,43],["αὐτῶν",3,41],["ἀφήσει",501,120],["καὶ",2,8],["ὑμῖν",5,86],["ὁ",1,4],["πατὴρ",44,5],["ὑμῶν",5,136],["ὁ",1,4],["οὐράνιος",3602,16]],"“For if you forgive men their trespasses, your heavenly Father will also forgive you."],["15",[["ἐὰν",45,8],["δὲ",14,8],["μὴ",25,12],["ἀφῆτε",501,118],["τοῖς",1,138],["ἀνθρώποις",43,139],["οὐδὲ",106,8],["ὁ",1,4],["πατὴρ",44,5],["ὑμῶν",5,136],["ἀφήσει",501,120],["τὰ",1,42],["παραπτώματα",1910,43],["ὑμῶν",5,136]],"But if you don’t forgive men their trespasses, neither will your Father forgive your trespasses."],["16",[["Ὅταν",319,8],["δὲ",14,8],["νηστεύητε",1521,362],["μὴ",25,12],["γίνεσθε",30,742],["ὡς",36,12],["οἱ",1,128],["ὑποκριταὶ",6647,51],["σκυθρωποί",4389,130],["ἀφανίζουσιν",623,191],["γὰρ",40,8],["τὰ",1,42],["πρόσωπα",47,43],["αὐτῶν",3,41],["ὅπως",240,8],["φανῶσιν",832,266],["τοῖς",1,138],["ἀνθρώποις",43,139],["νηστεύοντες",1521,137],["ἀμὴν",3161,316],["λέγω",31,149],["ὑμῖν",5,86],["ἀπέχουσιν",1255,191],["τὸν",1,6],["μισθὸν",816,7],["αὐτῶν",3,41]],"“Moreover when you fast, don’t be like the hypocrites, with sad faces. For they disfigure their faces that they may be seen by men to be fasting. Most certainly I tell you, they have received their reward."],["17",[["σὺ",5,156],["δὲ",14,8],["νηστεύων",1521,67],["ἄλειψαί",1922,275],["σου",5,146],["τὴν",1,9],["κεφαλὴν",144,10],["καὶ",2,8],["τὸ",1,32],["πρόσωπόν",47,33],["σου",5,146],["νίψαι",3310,275]],"But you, when you fast, anoint your head and wash your face,"],["18",[["ὅπως",240,8],["μὴ",25,12],["φανῇς",832,278],["τοῖς",1,138],["ἀνθρώποις",43,139],["νηστεύων",1521,67],["ἀλλὰ",108,8],["τῷ",1,110],["πατρί",44,113],["σου",5,146],["τῷ",1,110],["ἐν",4,1],["τῷ",1,52],["κρυφαίῳ",3566,34],["καὶ",2,8],["ὁ",1,4],["πατήρ",44,5],["σου",5,146],["ὁ",1,4],["βλέπων",470,67],["ἐν",4,1],["τῷ",1,52],["κρυφαίῳ",3566,34],["ἀποδώσει",312,120],["σοι",5,151]],"so that you are not seen by men to be fasting, but by your Father who is in secret; and your Father, who sees in secret, will reward you."],["19",[["Μὴ",25,12],["θησαυρίζετε",2351,307],["ὑμῖν",5,86],["θησαυροὺς",579,31],["ἐπὶ",9,1],["τῆς",1,18],["γῆς",26,19],["ὅπου",1579,1],["σὴς",2118,5],["καὶ",2,8],["βρῶσις",1241,13],["ἀφανίζει",623,87],["καὶ",2,8],["ὅπου",1579,1],["κλέπται",2358,51],["διορύσσουσιν",4207,191],["καὶ",2,8],["κλέπτουσιν",1245,191]],"“Don’t lay up treasures for yourselves on the earth, where moth and rust consume, and where thieves break through and steal;"],["20",[["θησαυρίζετε",2351,307],["δὲ",14,8],["ὑμῖν",5,86],["θησαυροὺς",579,31],["ἐν",4,1],["οὐρανῷ",94,113],["ὅπου",1579,1],["οὔτε",477,8],["σὴς",2118,5],["οὔτε",477,8],["βρῶσις",1241,13],["ἀφανίζει",623,87],["καὶ",2,8],["ὅπου",1579,1],["κλέπται",2358,51],["οὐ",12,12],["διορύσσουσιν",4207,191],["οὐδὲ",106,8],["κλέπτουσιν",1245,191]],"but lay up for yourselves treasures in heaven, where neither moth nor rust consume, and where thieves don’t break through and steal;"],["21",[["ὅπου",1579,8],["γάρ",40,8],["ἐστιν",10,87],["ὁ",1,4],["θησαυρός",579,5],["σου",5,146],["ἐκεῖ",76,17],["ἔσται",10,718],["καὶ",2,8],["ἡ",1,11],["καρδία",64,13],["σου",5,146]],"for where your treasure is, there your heart will be also."],["22",[["Ὁ",1,4],["λύχνος",1059,5],["τοῦ",1,23],["σώματός",454,24],["ἐστιν",10,87],["ὁ",1,4],["ὀφθαλμός",91,5],["ἐὰν",45,8],["οὖν",227,8],["ᾖ",10,173],["ὁ",1,4],["ὀφθαλμός",91,5],["σου",5,146],["ἁπλοῦς",10047,16],["ὅλον",235,28],["τὸ",1,27],["σῶμά",454,20],["σου",5,146],["φωτεινὸν",6191,28],["ἔσται",10,718]],"“The lamp of the body is the eye. If therefore your eye is sound, your whole body will be full of light."],["23",[["ἐὰν",45,8],["δὲ",14,8],["ὁ",1,4],["ὀφθαλμός",91,5],["σου",5,146],["πονηρὸς",164,16],["ᾖ",10,173],["ὅλον",235,28],["τὸ",1,27],["σῶμά",454,20],["σου",5,146],["σκοτεινὸν",2378,28],["ἔσται",10,718],["εἰ",77,8],["οὖν",227,8],["τὸ",1,27],["φῶς",380,20],["τὸ",1,27],["ἐν",4,1],["σοὶ",5,151],["σκότος",506,20],["ἐστίν",10,87],["τὸ",1,27],["σκότος",506,20],["πόσον",2486,238]],"But if your eye is evil, your whole body will be full of darkness. If therefore the light that is in you is darkness, how great is the darkness!"],["24",[["Οὐδεὶς",228,16],["δύναται",185,728],["δυσὶ",104,215],["κυρίοις",7,139],["δουλεύειν",398,54],["ἢ",61,8],["γὰρ",40,8],["τὸν",1,6],["ἕνα",58,59],["μισήσει",351,120],["καὶ",2,8],["τὸν",1,6],["ἕτερον",253,59],["ἀγαπήσει",214,120],["ἢ",61,8],["ἑνὸς",58,153],["ἀνθέξεται",1852,718],["καὶ",2,8],["τοῦ",1,30],["ἑτέρου",253,153],["καταφρονήσει",1677,120],["οὐ",12,12],["δύνασθε",185,754],["θεῷ",20,113],["δουλεύειν",398,54],["καὶ",2,8],["μαμωνᾷ",10048,113]],"“No one can serve two masters, for either he will hate the one and love the other, or else he will be devoted to one and despise the other. You can’t serve both God and Mammon."],["25",[["Διὰ",56,1],["τοῦτο",16,122],["λέγω",31,149],["ὑμῖν",5,86],["μὴ",25,12],["μεριμνᾶτε",2600,307],["τῇ",1,95],["ψυχῇ",63,2],["ὑμῶν",5,136],["τί",10010,119],["φάγητε",269,118],["ἢ",61,8],["τί",10010,119],["πίητε",212,118],["μηδὲ",414,8],["τῷ",1,52],["σώματι",454,53],["ὑμῶν",5,136],["τί",10010,119],["ἐνδύσησθε",516,133],["οὐχὶ",330,12],["ἡ",1,11],["ψυχὴ",63,13],["πλεῖόν",938,28],["ἐστιν",10,87],["τῆς",1,18],["τροφῆς",1390,19],["καὶ",2,8],["τὸ",1,27],["σῶμα",454,20],["τοῦ",1,23],["ἐνδύματος",2543,24]],"Therefore I tell you, don’t be anxious for your life: what you will eat, or what you will drink; nor yet for your body, what you will wear. Isn’t life more than food, and the body more than clothing?"],["26",[["ἐμβλέψατε",1862,69],["εἰς",8,1],["τὰ",1,42],["πετεινὰ",572,43],["τοῦ",1,30],["οὐρανοῦ",94,21],["ὅτι",19,8],["οὐ",12,12],["σπείρουσιν",793,191],["οὐδὲ",106,8],["θερίζουσιν",1509,191],["οὐδὲ",106,8],["συνάγουσιν",166,191],["εἰς",8,1],["ἀποθήκας",2405,40],["καὶ",2,8],["ὁ",1,4],["πατὴρ",44,5],["ὑμῶν",5,136],["ὁ",1,4],["οὐράνιος",3602,16],["τρέφει",1743,87],["αὐτά",3,66],["οὐχ",12,12],["ὑμεῖς",5,208],["μᾶλλον",1043,17],["διαφέρετε",2447,84],["αὐτῶν",3,168]],"See the birds of the sky, that they don’t sow, neither do they reap, nor gather into barns. Your heavenly Father feeds them. Aren’t you of much more value than they?"],["27",[["τίς",10010,150],["δὲ",14,8],["ἐξ",21,1],["ὑμῶν",5,136],["μεριμνῶν",2600,67],["δύναται",185,728],["προσθεῖναι",201,100],["ἐπὶ",9,1],["τὴν",1,9],["ἡλικίαν",1755,10],["αὐτοῦ",3,48],["πῆχυν",246,7],["ἕνα",58,59]],"“Which of you by being anxious, can add one moment to his lifespan?"],["28",[["καὶ",2,8],["περὶ",72,1],["ἐνδύματος",2543,24],["τί",10010,119],["μεριμνᾶτε",2600,84],["καταμάθετε",3066,69],["τὰ",1,42],["κρίνα",2021,43],["τοῦ",1,30],["ἀγροῦ",252,21],["πῶς",10049,12],["αὐξάνουσιν",1180,191],["οὐ",12,12],["κοπιῶσιν",921,191],["οὐδὲ",106,8],["νήθουσιν",7779,191]],"Why are you anxious about clothing? Consider the lilies of the field, how they grow. They don’t toil, neither do they spin,"],["29",[["λέγω",31,149],["δὲ",14,8],["ὑμῖν",5,86],["ὅτι",19,8],["οὐδὲ",106,8],["Σολομὼν",9986,5],["ἐν",4,1],["πάσῃ",11,96],["τῇ",1,95],["δόξῃ",141,2],["αὐτοῦ",3,48],["περιεβάλετο",744,26],["ὡς",36,12],["ἓν",58,28],["τούτων",16,214]],"yet I tell you that even Solomon in all his glory was not dressed like one of these."],["30",[["εἰ",77,8],["δὲ",14,8],["τὸν",1,6],["χόρτον",1046,7],["τοῦ",1,30],["ἀγροῦ",252,21],["σήμερον",205,17],["ὄντα",10,178],["καὶ",2,8],["αὔριον",857,17],["εἰς",8,1],["κλίβανον",7480,7],["βαλλόμενον",766,738],["ὁ",1,4],["θεὸς",20,5],["οὕτως",9989,17],["ἀμφιέννυσιν",10050,87],["οὐ",12,12],["πολλῷ",74,34],["μᾶλλον",1043,17],["ὑμᾶς",5,209],["ὀλιγόπιστοι",10051,537]],"But if God so clothes the grass of the field, which today exists and tomorrow is thrown into the oven, won’t he much more clothe you, you of little faith?"],["31",[["μὴ",25,12],["οὖν",227,8],["μεριμνήσητε",2600,118],["λέγοντες",31,137],["τί",10010,119],["φάγωμεν",269,75],["ἢ",61,8],["τί",10010,119],["πίωμεν",212,75],["ἢ",61,8],["τί",10010,119],["περιβαλώμεθα",744,270]],"“Therefore don’t be anxious, saying, ‘What will we eat?’, ‘What will we drink?’ or, ‘With what will we be clothed?’"],["32",[["πάντα",11,65],["γὰρ",40,8],["ταῦτα",16,248],["τὰ",1,253],["ἔθνη",60,63],["ἐπιζητοῦσιν",1936,191],["οἶδεν",10044,165],["γὰρ",40,8],["ὁ",1,4],["πατὴρ",44,5],["ὑμῶν",5,136],["ὁ",1,4],["οὐράνιος",3602,16],["ὅτι",19,8],["χρῄζετε",8703,84],["τούτων",16,214],["ἁπάντων",772,79]],"For the Gentiles seek after all these things; for your heavenly Father knows that you need all these things."],["33",[["ζητεῖτε",191,307],["δὲ",14,8],["πρῶτον",315,29],["τὴν",1,9],["βασιλείαν",157,10],["τοῦ",1,30],["θεοῦ",20,21],["καὶ",2,8],["τὴν",1,9],["δικαιοσύνην",187,10],["αὐτοῦ",3,48],["καὶ",2,8],["ταῦτα",16,335],["πάντα",11,74],["προστεθήσεται",201,125],["ὑμῖν",5,86]],"But seek first God’s Kingdom and his righteousness; and all these things will be given to you as well."],["34",[["μὴ",25,12],["οὖν",227,8],["μεριμνήσητε",2600,118],["εἰς",8,1],["τὴν",1,9],["αὔριον",857,17],["ἡ",1,11],["γὰρ",40,8],["αὔριον",857,17],["μεριμνήσει",2600,120],["ἑαυτῆς",92,83],["ἀρκετὸν",10052,28],["τῇ",1,95],["ἡμέρᾳ",28,2],["ἡ",1,11],["κακία",433,13],["αὐτῆς",3,83]],"Therefore don’t be anxious for tomorrow, for tomorrow will be anxious for itself. Each day’s own evil is sufficient."]]