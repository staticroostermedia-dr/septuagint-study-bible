[["1",[["Ἰδὼν",112,155],["δὲ",14,8],["τοὺς",1,56],["ὄχλους",1008,31],["ἀνέβη",88,3],["εἰς",8,1],["τὸ",1,32],["ὄρος",87,33],["καὶ",2,8],["καθίσαντος",274,513],["αὐτοῦ",3,48],["προσῆλθαν",529,141],["αὐτῷ",3,49],["οἱ",1,128],["μαθηταὶ",10025,51],["αὐτοῦ",3,48]],"Seeing the multitudes, he went up onto the mountain. When he had sat down, his disciples came to him."],["2",[["καὶ",2,8],["ἀνοίξας",362,155],["τὸ",1,32],["στόμα",123,33],["αὐτοῦ",3,48],["ἐδίδασκεν",545,14],["αὐτοὺς",3,60],["λέγων",31,67]],"He opened his mouth and taught them, saying,"],["3",[["Μακάριοι",806,130],["οἱ",1,128],["πτωχοὶ",497,51],["τῷ",1,52],["πνεύματι",168,53],["ὅτι",19,8],["αὐτῶν",3,41],["ἐστιν",10,87],["ἡ",1,11],["βασιλεία",157,13],["τῶν",1,76],["οὐρανῶν",94,77]],"“Blessed are the poor in spirit, for theirs is the Kingdom of Heaven."],["4",[["Μακάριοι",806,130],["οἱ",1,128],["πενθοῦντες",736,137],["ὅτι",19,8],["αὐτοὶ",3,195],["παρακληθήσονται",434,135]],"Blessed are those who mourn, for they shall be comforted."],["5",[["Μακάριοι",806,130],["οἱ",1,128],["πραεῖς",2286,130],["ὅτι",19,8],["αὐτοὶ",3,195],["κληρονομήσουσιν",370,207],["τὴν",1,9],["γῆν",26,10]],"Blessed are the gentle, for they shall inherit the earth."],["6",[["Μακάριοι",806,130],["οἱ",1,128],["πεινῶντες",1045,137],["καὶ",2,8],["διψῶντες",1161,137],["τὴν",1,9],["δικαιοσύνην",187,10],["ὅτι",19,8],["αὐτοὶ",3,195],["χορτασθήσονται",2397,135]],"Blessed are those who hunger and thirst for righteousness, for they shall be filled."],["7",[["Μακάριοι",806,130],["οἱ",1,128],["ἐλεήμονες",1489,130],["ὅτι",19,8],["αὐτοὶ",3,195],["ἐλεηθήσονται",10027,135]],"Blessed are the merciful, for they shall obtain mercy."],["8",[["Μακάριοι",806,130],["οἱ",1,128],["καθαροὶ",379,130],["τῇ",1,95],["καρδίᾳ",64,2],["ὅτι",19,8],["αὐτοὶ",3,195],["τὸν",1,6],["θεὸν",20,7],["ὄψονται",112,740]],"Blessed are the pure in heart, for they shall see God."],["9",[["Μακάριοι",806,130],["οἱ",1,128],["εἰρηνοποιοί",10029,130],["ὅτι",19,8],["αὐτοὶ",3,195],["υἱοὶ",13,51],["θεοῦ"