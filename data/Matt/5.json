τῷ",1,110],["θέλοντί",612,390],["σοι",5,151],["κριθῆναι",263,175],["καὶ",2,8],["τὸν",1,6],["χιτῶνά",1254,7],["σου",5,146],["λαβεῖν",46,100],["ἄφες",501,198],["αὐτῷ",3,49],["καὶ",2,8],["τὸ",1,32],["ἱμάτιον",276,33]],"If anyone sues you to take away your coat, let him have your cloak also."],["41",[["καὶ",2,8],["ὅστις",457,246],["σε",5,161],["ἀγγαρεύσει",10039,120],["μίλιον",10040,33],["ἕν",58,29],["ὕπαγε",6654,239],["μετ᾽",29,1],["αὐτοῦ",3,48],["δύο",104,372]],"Whoever compels you to go one mile, go with him two."],["42",[["τῷ",1,110],["αἰτοῦντί",617,390],["σε",5,161],["δός",33,198],["καὶ",2,8],["τὸν",1,6],["θέλοντα",612,178],["ἀπὸ",17,1],["σοῦ",5,146],["δανίσασθαι",1669,103],["μὴ",25,12],["ἀποστραφῇς",130,278]],"Give to him who asks you, and don’t turn away him who desires to borrow from you."],["43",[["Ἠκούσατε",54,262],["ὅτι",19,8],["ἐρρέθη",31,38],["ἀγαπήσεις",214,159],["τὸν",1,6],["πλησίον",292,17],["σου",5,146],["καὶ",2,8],["μισήσεις",351,159],["τὸν",1,6],["ἐχθρόν",135,7],["σου",5,146]],"“You have heard that it was said, ‘You shall love your neighbor and hate your enemy.’"],["44",[["ἐγὼ",6,156],["δὲ",14,8],["λέγω",31,149],["ὑμῖν",5,86],["ἀγαπᾶτε",214,307],["τοὺς",1,56],["ἐχθροὺς",135,31],["ὑμῶν",5,136],["καὶ",2,8],["προσεύχεσθε",551,742],["ὑπὲρ",139,1],["τῶν",1,76],["διωκόντων",533,164],["ὑμᾶς",5,209]],"But I tell you, love your enemies, bless those who curse you, do good to those who hate you, and pray for those who mistreat you and persecute you,"],["45",[["ὅπως",240,8],["γένησθε",30,746],["υἱοὶ",13,51],["τοῦ",1,30],["πατρὸς",44,21],["ὑμῶν",5,136],["τοῦ",1,30],["ἐν",4,1],["οὐρανοῖς",94,139],["ὅτι",19,8],["τὸν",1,6],["ἥλιον",323,7],["αὐτοῦ",3,48],["ἀνατέλλει",900,87],["ἐπὶ",9,1],["πονηροὺς",164,58],["καὶ",2,8],["ἀγαθοὺς",114,58],["καὶ",2,8],["βρέχει",2163,87],["ἐπὶ",9,1],["δικαίους",153,58],["καὶ",2,8],["ἀδίκους",406,58]],"that you may be children of your Father who is in heaven. For he makes his sun to rise on the evil and the good, and sends rain on the just and the unjust."],["46",[["ἐὰν",45,8],["γὰρ",40,8],["ἀγαπήσητε",214,118],["τοὺς",1,56],["ἀγαπῶντας",214,229],["ὑμᾶς",5,209],["τίνα",10010,365],["μισθὸν",816,7],["ἔχετε",124,84],["οὐχὶ",330,12],["καὶ",2,8],["οἱ",1,128],["τελῶναι",10041,51],["τὸ",1,32],["αὐτὸ",3,121],["ποιοῦσιν",23,191]],"For if you love those who love you, what reward do you have? Don’t even the tax collectors do the same?"],["47",[["καὶ",2,8],["ἐὰν",45,8],["ἀσπάσησθε",2987,746],["τοὺς",1,56],["ἀδελφοὺς",67,31],["ὑμῶν",5,136],["μόνον",302,29],["τί",10010,119],["περισσὸν",1636,29],["ποιεῖτε",23,84],["οὐχὶ",330,12],["καὶ",2,8],["οἱ",1,128],["ἐθνικοὶ",10042,130],["τὸ",1,32],["αὐτὸ",3,121],["ποιοῦσιν",23,191]],"If you only greet your friends, what more do you do than others? Don’t even the tax collectors do the same?"],["48",[["ἔσεσθε",10,747],["οὖν",227,8],["ὑμεῖς",5,208],["τέλειοι",1919,130],["ὡς",36,12],["ὁ",1,4],["πατὴρ",44,5],["ὑμῶν",5,136],["ὁ",1,4],["οὐράνιος",3602,16],["τέλειός",1919,16],["ἐστιν",10,87]],"Therefore you shall be perfect, just as your Father in heaven is perfect."]]