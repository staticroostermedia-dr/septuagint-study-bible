,["φυλακὴν",485,10],["βληθήσῃ",766,373]],"Agree with your adversary quickly while you are with him on the way; lest perhaps the prosecutor deliver you to the judge, and the judge deliver you to the officer, and you be cast into prison."],["26",[["ἀμὴν",3161,316],["λέγω",31,149],["σοι",5,151],["οὐ",12,12],["μὴ",25,12],["ἐξέλθῃς",82,170],["ἐκεῖθεν",430,17],["ἕως",42,1],["ἂν",83,12],["ἀποδῷς",312,170],["τὸν",1,6],["ἔσχατον",410,59],["κοδράντην",10036,7]],"Most certainly I tell you, you shall by no means get out of there until you have paid the last penny."],["27",[["Ἠκούσατε",54,262],["ὅτι",19,8],["ἐρρέθη",31,38],["οὐ",12,12],["μοιχεύσεις",2466,159]],"“You have heard that it was said, ‘You shall not commit adultery;’"],["28",[["ἐγὼ",6,156],["δὲ",14,8],["λέγω",31,149],["ὑμῖν",5,86],["ὅτι",19,8],["πᾶς",11,16],["ὁ",1,4],["βλέπων",470,67],["γυναῖκα",59,10],["πρὸς",15,1],["τὸ",1,32],["ἐπιθυμῆσαι",915,100],["αὐτὴν",3,98],["ἤδη",916,17],["ἐμοίχευσεν",2466,3],["αὐτὴν",3,98],["ἐν",4,1],["τῇ",1,95],["καρδίᾳ",64,2],["αὐτοῦ",3,48]],"but I tell you that everyone who gazes at a woman to lust after her has committed adultery with her already in his heart."],["29",[["εἰ",77,8],["δὲ",14,8],["ὁ",1,4],["ὀφθαλμός",91,5],["σου",5,146],["ὁ",1,4],["δεξιὸς",282,16],["σκανδαλίζει",5037,87],["σε",5,161],["ἔξελε",413,198],["αὐτὸν",3,82],["καὶ",2,8],["βάλε",766,198],["ἀπὸ",17,1],["σοῦ",5,146],["συμφέρει",2495,87],["γάρ",40,8],["σοι",5,151],["ἵνα",102,8],["ἀπόληται",217,236],["ἓν",58,28],["τῶν",1,44],["μελῶν",1593,45],["σου",5,146],["καὶ",2,8],["μὴ",25,12],["ὅλον",235,28],["τὸ",1,27],["σῶμά",454,20],["σου",5,146],["βληθῇ",766,333],["εἰς",8,1],["γέενναν",10034,10]],"If your right eye causes you to stumble, pluck it out and throw it away from you. For it is more profitable for you that one of your members should perish than for your whole body to be cast into Gehenna."],["30",[["Καὶ",2,8],["εἰ",77,8],["ἡ",1,11],["δεξιά",282,15],["σου",5,146],["χεὶρ",37,13],["σκανδαλίζει",5037,87],["σε",5,161],["ἔκκο