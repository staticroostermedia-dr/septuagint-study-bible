,["ἐζήτουν",191,129],["αὐτὸν",3,82],["οἱ",1,128],["Ἰουδαῖοι",285,51],["ἀποκτεῖναι",300,100],["ὅτι",19,8],["οὐ",12,12],["μόνον",302,29],["ἔλυεν",1381,14],["τὸ",1,32],["σάββατον",442,33],["ἀλλὰ",108,8],["καὶ",2,8],["πατέρα",44,7],["ἴδιον",683,59],["ἔλεγεν",31,14],["τὸν",1,6],["θεὸν",20,7],["ἴσον",944,59],["ἑαυτὸν",92,82],["ποιῶν",23,67],["τῷ",1,110],["θεῷ",20,113]],"For this cause therefore the Jews sought all the more to kill him, because he not only broke the Sabbath, but also called God his own Father, making himself equal with God."],["19",[["ἀπεκρίνατο",234,737],["οὖν",227,8],["ὁ",1,4],["Ἰησοῦς",211,5],["καὶ",2,8],["ἔλεγεν",31,14],["αὐτοῖς",3,142],["ἀμὴν",3161,316],["ἀμὴν",3161,316],["λέγω",31,149],["ὑμῖν",5,86],["οὐ",12,12],["δύναται",185,728],["ὁ",1,4],["υἱὸς",13,5],["ποιεῖν",23,54],["ἀφ᾽",17,1],["ἑαυτοῦ",92,48],["οὐδέν",228,29],["ἐὰν",45,8],["μή",25,12],["τι",39,119],["βλέπῃ",470,173],["τὸν",1,6],["πατέρα",44,7],["ποιοῦντα",23,178],["ἃ",24,755],["γὰρ",40,8],["ἂν",83,12],["ἐκεῖνος",80,112],["ποιῇ",23,173],["ταῦτα",16,248],["καὶ",2,8],["ὁ",1,4],["υἱὸς",13,5],["ὁμοίως",1757,17],["ποιεῖ",23,87]],"Jesus therefore answered them, “Most certainly, I tell you, the Son can do nothing of himself, but what he sees the Father doing. For whatever things he does, these the Son also does likewise."],["20",[["ὁ",1,4],["γὰρ",40,8],["πατὴρ",44,5],["φιλεῖ",1391,87],["τὸν",1,6],["υἱὸν",13,7],["καὶ",2,8],["πάντα",11,65],["δείκνυσιν",870,87],["αὐτῷ",3,49],["ἃ",24,755],["αὐτὸς",3,158],["ποιεῖ",23,87],["καὶ",2,8],["μείζονα",66,65],["τούτων",16,214],["δείξει",870,120],["αὐτῷ",3,49],["ἔργα",105,43],["ἵνα",102,8],["ὑμεῖς",5,208],["θαυμάζητε",963,362]],"For the Father has affection for the Son, and shows him all things that he himself does. He will show him greater works than these, that you may marvel."],["21",[["ὥσπερ",226,8],["γὰρ",40,8],["ὁ",1,4],["πατὴρ",44,5],["ἐγείρει",746,87],["τοὺς",1,56],["νεκροὺς",659,58],["καὶ",2,8],["ζῳοποιεῖ",3533,87],["οὕτως",71,17],["καὶ",2,8],["ὁ",1,4],["