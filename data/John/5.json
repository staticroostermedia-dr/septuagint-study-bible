[["1",[["Μετὰ",29,1],["ταῦτα",16,248],["ἦν",10,14],["ἑορτὴ",487,13],["τῶν",1,76],["Ἰουδαίων",285,77],["καὶ",2,8],["ἀνέβη",88,3],["Ἰησοῦς",211,5],["εἰς",8,1],["Ἱεροσόλυμα",70,43]],"After these things, there was a feast of the Jews, and Jesus went up to Jerusalem."],["2",[["ἔστιν",10,87],["δὲ",14,8],["ἐν",4,1],["τοῖς",1,91],["Ἱεροσολύμοις",70,92],["ἐπὶ",9,1],["τῇ",1,95],["προβατικῇ",5002,96],["κολυμβήθρα",2731,13],["ἡ",1,11],["ἐπιλεγομένη",1657,761],["Ἑβραϊστὶ",9701,17],["Βηθζαθά",10460,13],["πέντε",280,372],["στοὰς",4397,40],["ἔχουσα",124,183]],"Now in Jerusalem by the sheep gate, there is a pool, which is called in Hebrew, “Bethesda”, having five porches."],["3",[["ἐν",4,1],["ταύταις",16,336],["κατέκειτο",4267,721],["πλῆθος",200,20],["τῶν",1,76],["ἀσθενούντων",771,164],["τυφλῶν",1600,163],["χωλῶν",2399,163],["ξηρῶν",1186,163]],"In these lay a great multitude of those who were sick, blind, lame, or paralyzed, waiting for the moving of the water;"],["4",[],"for an angel went down at certain times into the pool and stirred up the water. Whoever stepped in first after the stirring of the water was healed of whatever disease he had.",{"s":"g0"}],["5",[["Ἦν",10,14],["δέ",14,8],["τις",39,150],["ἄνθρωπος",43,5],["ἐκεῖ",76,17],["τριάκοντα",426,372],["καὶ",2,8],["ὀκτὼ",1052,372],["ἔτη",81,43],["ἔχων",124,67],["ἐν",4,1],["τῇ",1,95],["ἀσθενείᾳ",3413,2],["αὐτοῦ",3,48]],"A certain man was there who had been sick for thirty-eight years."],["6",[["τοῦτον",16,259],["ἰδὼν",112,155],["ὁ",1,4],["Ἰησοῦς",211,5],["κατακείμενον",4267,765],["καὶ",2,8],["γνοὺς",79,155],["ὅτι",19,8],["πολὺν",74,59],["ἤδη",916,17],["χρόνον",486,7],["ἔχει",124,87],["λέγει",31,87],["αὐτῷ",3,49],["θέλεις",612,145],["ὑγιὴς",2852,16],["γενέσθαι",30,776]],"When Jesus saw him lying there, and knew that he had been sick for a long time, he asked him, “Do you want to be made well?”"],["7",[["ἀπεκρίθη",234,737],["αὐτῷ",3,49],["ὁ",1,4],["ἀσθενῶν",771,67],["κύριε",7,250],["ἄνθρωπον",43,7],["οὐκ",12,12],["ἔχω",124,149],["