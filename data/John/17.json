e in me through their word,"],["21",[["ἵνα",102,8],["πάντες",11,130],["ἓν",58,28],["ὦσιν",10,265],["καθὼς",221,8],["σύ",5,156],["πάτερ",44,250],["ἐν",4,1],["ἐμοὶ",6,151],["κἀγὼ",10000,8],["ἐν",4,1],["σοί",5,151],["ἵνα",102,8],["καὶ",2,8],["αὐτοὶ",3,195],["ἐν",4,1],["ἡμῖν",9994,86],["ὦσιν",10,265],["ἵνα",102,8],["ὁ",1,4],["κόσμος",743,5],["πιστεύῃ",649,173],["ὅτι",19,8],["σύ",5,156],["με",9994,161],["ἀπέστειλας",84,154]],"that they may all be one; even as you, Father, are in me, and I in you, that they also may be one in us; that the world may believe that you sent me."],["22",[["κἀγὼ",10000,8],["τὴν",1,9],["δόξαν",141,10],["ἣν",24,124],["δέδωκάς",33,172],["μοι",9994,151],["δέδωκα",33,85],["αὐτοῖς",3,142],["ἵνα",102,8],["ὦσιν",10,265],["ἓν",58,28],["καθὼς",221,8],["ἡμεῖς",9994,208],["ἕν",58,28]],"The glory which you have given me, I have given to them, that they may be one, even as we are one,"],["23",[["ἐγὼ",6,156],["ἐν",4,1],["αὐτοῖς",3,142],["καὶ",2,8],["σὺ",5,156],["ἐν",4,1],["ἐμοί",6,151],["ἵνα",102,8],["ὦσιν",10,265],["τετελειωμένοι",1838,574],["εἰς",8,1],["ἕν",58,29],["ἵνα",102,8],["γινώσκῃ",79,173],["ὁ",1,4],["κόσμος",743,5],["ὅτι",19,8],["σύ",5,156],["με",9994,161],["ἀπέστειλας",84,154],["καὶ",2,8],["ἠγάπησας",214,154],["αὐτοὺς",3,60],["καθὼς",221,8],["ἐμὲ",6,161],["ἠγάπησας",214,154]],"I in them, and you in me, that they may be perfected into one, that the world may know that you sent me and loved them, even as you loved me."],["24",[["Πάτερ",44,250],["ὃ",24,467],["δέδωκάς",33,172],["μοι",9994,151],["θέλω",612,149],["ἵνα",102,8],["ὅπου",1579,8],["εἰμὶ",10,149],["ἐγὼ",6,156],["κἀκεῖνοι",10122,213],["ὦσιν",10,265],["μετ᾽",29,1],["ἐμοῦ",6,88],["ἵνα",102,8],["θεωρῶσιν",897,265],["τὴν",1,9],["δόξαν",141,10],["τὴν",1,9],["ἐμὴν",10146,37],["ἣν",24,124],["δέδωκάς",33,172],["μοι",9994,151],["ὅτι",19,8],["ἠγάπησάς",214,154],["με",9994,161],["πρὸ",238,1],["καταβολῆς",7331,19],["κόσμου",743,21]],"Father, I desire that they also whom you have given me be with me where I am, that they may see my glory which you have given me, for you loved me before the foundation of the world."],["25",[["πάτερ",44,250],["δίκαιε",153,309],["καὶ",2,8],["ὁ",1,4],["κόσμος",743,5],["σε",5,161],["οὐκ",12,12],["ἔγνω",79,3],["ἐγὼ",6,156],["δέ",14,8],["σε",5,161],["ἔγνων",79,147],["καὶ",2,8],["οὗτοι",16,213],["ἔγνωσαν",79,141],["ὅτι",19,8],["σύ",5,156],["με",9994,161],["ἀπέστειλας",84,154]],"Righteous Father, the world hasn’t known you, but I knew you; and these knew that you sent me."],["26",[["καὶ",2,8],["ἐγνώρισα",748,147],["αὐτοῖς",3,142],["τὸ",1,32],["ὄνομά",57,33],["σου",5,146],["καὶ",2,8],["γνωρίσω",748,157],["ἵνα",102,8],["ἡ",1,11],["ἀγάπη",1982,13],["ἣν",24,124],["ἠγάπησάς",214,154],["με",9994,161],["ἐν",4,1],["αὐτοῖς",3,142],["ᾖ",10,173],["κἀγὼ",10000,8],["ἐν",4,1],["αὐτοῖς",3,142]],"I made known to them your name, and will make it known; that the love with which you loved me may be in them, and I in them.”"]]