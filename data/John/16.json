[["1",[["Ταῦτα",16,248],["λελάληκα",50,85],["ὑμῖν",5,86],["ἵνα",102,8],["μὴ",25,12],["σκανδαλισθῆτε",5037,485]],"“I have said these things to you so that you wouldn’t be caused to stumble."],["2",[["ἀποσυναγώγους",10469,58],["ποιήσουσιν",23,207],["ὑμᾶς",5,209],["ἀλλ᾽",108,8],["ἔρχεται",55,728],["ὥρα",838,13],["ἵνα",102,8],["πᾶς",11,16],["ὁ",1,4],["ἀποκτείνας",300,155],["ὑμᾶς",5,209],["δόξῃ",801,160],["λατρείαν",2911,10],["προσφέρειν",363,54],["τῷ",1,110],["θεῷ",20,113]],"They will put you out of the synagogues. Yes, the time is coming that whoever kills you will think that he offers service to God."],["3",[["καὶ",2,8],["ταῦτα",16,248],["ποιήσουσιν",23,207],["ὅτι",19,8],["οὐκ",12,12],["ἔγνωσαν",79,141],["τὸν",1,6],["πατέρα",44,7],["οὐδὲ",106,8],["ἐμέ",6,161]],"They will do these things because they have not known the Father nor me."],["4",[["ἀλλὰ",108,8],["ταῦτα",16,248],["λελάληκα",50,85],["ὑμῖν",5,86],["ἵνα",102,8],["ὅταν",319,8],["ἔλθῃ",55,160],["ἡ",1,11],["ὥρα",838,13],["αὐτῶν",3,168],["μνημονεύητε",1900,362],["αὐτῶν",3,168],["ὅτι",19,8],["ἐγὼ",6,156],["εἶπον",31,147],["ὑμῖν",5,86],["ταῦτα",16,248],["δὲ",14,8],["ὑμῖν",5,86],["ἐξ",21,1],["ἀρχῆς",270,19],["οὐκ",12,12],["εἶπον",31,147],["ὅτι",19,8],["μεθ᾽",29,1],["ὑμῶν",5,136],["ἤμην",10,429]],"But I have told you these things so that when the time comes, you may remember that I told you about them. I didn’t tell you these things from the beginning, because I was with you."],["5",[["νῦν",90,17],["δὲ",14,8],["ὑπάγω",6654,149],["πρὸς",15,1],["τὸν",1,6],["πέμψαντά",1597,476],["με",9994,161],["καὶ",2,8],["οὐδεὶς",228,16],["ἐξ",21,1],["ὑμῶν",5,136],["ἐρωτᾷ",822,87],["με",9994,161],["ποῦ",9996,17],["ὑπάγεις",6654,145]],"But now I am going to him who sent me, and none of you asks me, ‘Where are you going?’"],["6",[["ἀλλ᾽",108,8],["ὅτι",19,8],["ταῦτα",16,248],["λελάληκα",50,85],["ὑμῖν",5,86],["ἡ",1,11],["λύπη",1075,13],["πεπλήρωκεν",518,165],["ὑμῶν",5,136],["τὴν",1,9],["καρδίαν",64,10]],"But because I have told you these things, sorrow has filled your heart."],["7",[["ἀλλ᾽",108,8],["ἐγὼ",6,156],["τὴν",1,9],["ἀλήθειαν",352,10],["λέγω",31,149],["ὑμῖν",5,86],["συμφέρει",2495,87],["ὑμῖν",5,86],["ἵνα",102,8],["ἐγὼ",6,156],["ἀπέλθω",297,227],["ἐὰν",45,8],["γὰρ",40,8],["μὴ",25,12],["ἀπέλθω",297,227],["ὁ",1,4],["παράκλητος",10479,5],["οὐκ",12,12],["ἐλεύσεται",55,718],["πρὸς",15,1],["ὑμᾶς",5,209],["ἐὰν",45,8],["δὲ",14,8],["πορευθῶ",49,879],["πέμψω",1597,157],["αὐτὸν",3,82],["πρὸς",15,1],["ὑμᾶς",5,209]],"Nevertheless I tell you the truth: It is to your advantage that I go away; for if I don’t go away, the Counselor won’t come to you. But if I go, I will send him to you."],["8",[["καὶ",2,8],["ἐλθὼν",55,155],["ἐκεῖνος",80,112],["ἐλέγξει",752,120],["τὸν",1,6],["κόσμον",743,7],["περὶ",72,1],["ἁμαρτίας",119,19],["καὶ",2,8],["περὶ",72,1],["δικαιοσύνης",187,19],["καὶ",2,8],["περὶ",72,1],["κρίσεως",229,19]],"When he has come, he will convict the world about sin, about righteousness, and about judgment;"],["9",[["περὶ",72,1],["ἁμαρτίας",119,19],["μέν",281,12],["ὅτι",19,8],["οὐ",12,12],["πιστεύουσιν",649,191],["εἰς",8,1],["ἐμέ",6,161]],"about sin, because they don’t believe in me;"],["10",[["περὶ",72,1],["δικαιοσύνης",187,19],["δέ",14,8],["ὅτι",19,8],["πρὸς",15,1],["τὸν",1,6],["πατέρα",44,7],["ὑπάγω",6654,149],["καὶ",2,8],["οὐκέτι",12,17],["θεωρεῖτέ",897,84],["με",9994,161]],"about righteousness, because I am going to my Father, and you won’t see me any more;"],["11",[["περὶ",72,1],["δὲ",14,8],["κρίσεως",229,19],["ὅτι",19,8],["ὁ",1,4],["ἄρχων",96,5],["τοῦ",1,30],["κόσμου",743,21],["τούτου",16,126],["κέκριται",263,722]],"about judgment, because the prince of this world has been judged."],["12",[["Ἔτι",111,17],["πολλὰ",74,65],["ἔχω",124,149],["ὑμῖν",5,86],["λέγειν",31,54],["ἀλλ᾽",108,8],["οὐ",12,12],["δύνασθε",185,754],["βαστάζειν",3502,54],["ἄρτι",2665,17]],"“I still have many things to tell you, but you can’t bear them now."],["13",[["ὅταν",319,8],["δὲ",14,8],["ἔλθῃ",55,160],["ἐκεῖνος",80,112],["τὸ",1,27],["πνεῦμα",168,20],["τῆς",1,18],["ἀληθείας",352,19],["ὁδηγήσει",1108,120],["ὑμᾶς",5,209],["ἐν",4,1],["τῇ",1,95],["ἀληθείᾳ",352,2],["πάσῃ",11,96],["οὐ",12,12],["γὰρ",40,8],["λαλήσει",50,120],["ἀφ᾽",17,1],["ἑαυτοῦ",92,48],["ἀλλ᾽",108,8],["ὅσα",103,755],["ἀκούσει",54,120],["λαλήσει",50,120],["καὶ",2,8],["τὰ",1,42],["ἐρχόμενα",55,835],["ἀναγγελεῖ",231,120],["ὑμῖν",5,86]],"However, when he, the Spirit of truth, has come, he will guide you into all truth, for he will not speak from himself; but whatever he hears, he will speak. He will declare to you things that are coming."],["14",[["ἐκεῖνος",80,112],["ἐμὲ",6,161],["δοξάσει",452,120],["ὅτι",19,8],["ἐκ",21,1],["τοῦ",1,23],["ἐμοῦ",10146,88],["λήμψεται",46,718],["καὶ",2,8],["ἀναγγελεῖ",231,120],["ὑμῖν",5,86]],"He will glorify me, for he will take from what is mine and will declare it to you."],["15",[["Πάντα",11,74],["ὅσα",103,755],["ἔχει",124,87],["ὁ",1,4],["πατὴρ",44,5],["ἐμά",10146,74],["ἐστιν",10,87],["διὰ",56,1],["τοῦτο",16,122],["εἶπον",31,147],["ὅτι",19,8],["ἐκ",21,1],["τοῦ",1,23],["ἐμοῦ",6,88],["λαμβάνει",46,87],["καὶ",2,8],["ἀναγγελεῖ",231,120],["ὑμῖν",5,86]],"All things that the Father has are mine; therefore I said that he takes of mine and will declare it to you."],["16",[["μικρὸν",367,29],["καὶ",2,8],["οὐκέτι",12,17],["θεωρεῖτέ",897,84],["με",9994,161],["καὶ",2,8],["πάλιν",655,17],["μικρὸν",367,29],["καὶ",2,8],["ὄψεσθέ",112,747],["με",9994,161]],"“A little while, and you will not see me. Again a little while, and you will see me.”"],["17",[["εἶπαν",31,141],["οὖν",227,8],["ἐκ",21,1],["τῶν",1,76],["μαθητῶν",10025,77],["αὐτοῦ",3,48],["πρὸς",15,1],["ἀλλήλους",1192,60],["τί",10010,238],["ἐστιν",10,87],["τοῦτο",16,344],["ὃ",24,467],["λέγει",31,87],["ἡμῖν",9994,86],["μικρὸν",367,29],["καὶ",2,8],["οὐ",12,12],["θεωρεῖτέ",897,84],["με",9994,161],["καὶ",2,8],["πάλιν",655,17],["μικρὸν",367,29],["καὶ",2,8],["ὄψεσθέ",112,747],["με",9994,161],["καὶ",2,8],["ὅτι",19,8],["ὑπάγω",6654,149],["πρὸς",15,1],["τὸν",1,6],["πατέρα",44,7]],"Some of his disciples therefore said to one another, “What is this that he says to us, ‘A little while, and you won’t see me, and again a little while, and you will see me;’ and, ‘Because I go to the Father’?”"],["18",[["ἔλεγον",31,129],["οὖν",227,8],["τί",10010,238],["ἐστιν",10,87],["τοῦτο",16,344],["ὃ",24,467],["λέγει",31,87],["τὸ",1,32],["μικρόν",367,29],["οὐκ",12,12],["οἴδαμεν",1168,311],["τί",10010,119],["λαλεῖ",50,87]],"They said therefore, “What is this that he says, ‘A little while’? We don’t know what he is saying.”"],["19",[["Ἔγνω",79,3],["ὁ",1,4],["Ἰησοῦς",211,5],["ὅτι",19,8],["ἤθελον",612,129],["αὐτὸν",3,82],["ἐρωτᾶν",822,54],["καὶ",2,8],["εἶπεν",31,3],["αὐτοῖς",3,142],["περὶ",72,1],["τούτου",16,298],["ζητεῖτε",191,84],["μετ᾽",29,1],["ἀλλήλων",1192,41],["ὅτι",19,8],["εἶπον",31,147],["μικρὸν",367,29],["καὶ",2,8],["οὐ",12,12],["θεωρεῖτέ",897,84],["με",9994,161],["καὶ",2,8],["πάλιν",655,17],["μικρὸν",367,29],["καὶ",2,8],["ὄψεσθέ",112,747],["με",9994,161]],"Therefore Jesus perceived that they wanted to ask him, and he said to them, “Do you inquire among yourselves concerning this, that I said, ‘A little while, and you won’t see me, and again a little while, and you will see me’?"],["20",[["Ἀμὴν",3161,316],["ἀμὴν",3161,316],["λέγω",31,149],["ὑμῖν",5,86],["ὅτι",19,8],["κλαύσετε",412,348],["καὶ",2,8],["θρηνήσετε",1589,348],["ὑμεῖς",5,208],["ὁ",1,4],["δὲ",14,8],["κόσμος",743,5],["χαρήσεται",698,812],["ὑμεῖς",5,208],["λυπηθήσεσθε",936,258],["ἀλλ᾽",108,8],["ἡ",1,11],["λύπη",1075,13],["ὑμῶν",5,136],["εἰς",8,1],["χαρὰν",1125,10],["γενήσεται",30,718]],"Most certainly I tell you that you will weep and lament, but the world will rejoice. You will be sorrowful, but your sorrow will be turned into joy."],["21",[["ἡ",1,11],["γυνὴ",59,13],["ὅταν",319,8],["τίκτῃ",251,173],["λύπην",1075,10],["ἔχει",124,87],["ὅτι",19,8],["ἦλθεν",55,3],["ἡ",1,11],["ὥρα",838,13],["αὐτῆς",3,83],["ὅταν",319,8],["δὲ",14,8],["γεννήσῃ",222,160],["τὸ",1,32],["παιδίον",449,33],["οὐκέτι",12,17],["μνημονεύει",1900,87],["τῆς",1,18],["θλίψεως",438,19],["διὰ",56,1],["τὴν",1,9],["χαράν",1125,10],["ὅτι",19,8],["ἐγεννήθη",222,38],["ἄνθρωπος",43,5],["εἰς",8,1],["τὸν",1,6],["κόσμον",743,7]],"A woman, when she gives birth, has sorrow because her time has come. But when she has delivered the child, she doesn’t remember the anguish any more, for the joy that a human being is born into the world."],["22",[["Καὶ",2,8],["ὑμεῖς",5,208],["οὖν",227,8],["νῦν",90,17],["μὲν",281,12],["λύπην",1075,10],["ἔχετε",124,84],["πάλιν",655,17],["δὲ",14,8],["ὄψομαι",112,775],["ὑμᾶς",5,209],["καὶ",2,8],["χαρήσεται",698,812],["ὑμῶν",5,136],["ἡ",1,11],["καρδία",64,13],["καὶ",2,8],["τὴν",1,9],["χαρὰν",1125,10],["ὑμῶν",5,136],["οὐδεὶς",228,16],["αἴρει",206,87],["ἀφ᾽",17,1],["ὑμῶν",5,136]],"Therefore you now have sorrow, but I will see you again, and your heart will rejoice, and no one will take your joy away from you."],["23",[["καὶ",2,8],["ἐν",4,1],["ἐκείνῃ",80,200],["τῇ",1,95],["ἡμέρᾳ",28,2],["ἐμὲ",6,161],["οὐκ",12,12],["ἐρωτήσετε",822,348],["οὐδέν",228,29],["Ἀμὴν",3161,316],["ἀμὴν",3161,316],["λέγω",31,149],["ὑμῖν",5,86],["ἄν",83,12],["τι",39,119],["αἰτήσητε",617,118],["τὸν",1,6],["πατέρα",44,7],["ἐν",4,1],["τῷ",1,52],["ὀνόματί",57,53],["μου",9994,146],["δώσει",33,120],["ὑμῖν",5,86]],"“In that day you will ask me no questions. Most certainly I tell you, whatever you may ask of the Father in my name, he will give it to you."],["24",[["ἕως",42,1],["ἄρτι",2665,17],["οὐκ",12,12],["ᾐτήσατε",617,262],["οὐδὲν",228,29],["ἐν",4,1],["τῷ",1,52],["ὀνόματί",57,53],["μου",9994,146],["αἰτεῖτε",617,307],["καὶ",2,8],["λήμψεσθε",46,747],["ἵνα",102,8],["ἡ",1,11],["χαρὰ",1125,13],["ὑμῶν",5,136],["ᾖ",10,173],["πεπληρωμένη",518,557]],"Until now, you have asked nothing in my name. Ask, and you will receive, that your joy may be made full."],["25",[["Ταῦτα",16,248],["ἐν",4,1],["παροιμίαις",3607,71],["λελάληκα",50,85],["ὑμῖν",5,86],["ἔρχεται",55,728],["ὥρα",838,13],["ὅτε",432,1],["οὐκέτι",12,17],["ἐν",4,1],["παροιμίαις",3607,71],["λαλήσω",50,157],["ὑμῖν",5,86],["ἀλλὰ",108,8],["παρρησίᾳ",2610,2],["περὶ",72,1],["τοῦ",1,30],["πατρὸς",44,21],["ἀπαγγελῶ",273,157],["ὑμῖν",5,86]],"“I have spoken these things to you in figures of speech. But the time is coming when I will no more speak to you in figures of speech, but will tell you plainly about the Father."],["26",[["ἐν",4,1],["ἐκείνῃ",80,200],["τῇ",1,95],["ἡμέρᾳ",28,2],["ἐν",4,1],["τῷ",1,52],["ὀνόματί",57,53],["μου",9994,146],["αἰτήσεσθε",617,117],["καὶ",2,8],["οὐ",12,12],["λέγω",31,149],["ὑμῖν",5,86],["ὅτι",19,8],["ἐγὼ",6,156],["ἐρωτήσω",822,157],["τὸν",1,6],["πατέρα",44,7],["περὶ",72,1],["ὑμῶν",5,136]],"In that day you will ask in my name; and I don’t say to you that I will pray to the Father for you,"],["27",[["αὐτὸς",3,158],["γὰρ",40,8],["ὁ",1,4],["πατὴρ",44,5],["φιλεῖ",1391,87],["ὑμᾶς",5,209],["ὅτι",19,8],["ὑμεῖς",5,208],["ἐμὲ",6,161],["πεφιλήκατε",1391,330],["καὶ",2,8],["πεπιστεύκατε",649,330],["ὅτι",19,8],["ἐγὼ",6,156],["παρὰ",73,1],["τοῦ",1,30],["θεοῦ",20,21],["ἐξῆλθον",82,147]],"for the Father himself loves you, because you have loved me, and have believed that I came from God."],["28",[["ἐξῆλθον",82,147],["παρὰ",73,1],["τοῦ",1,30],["πατρὸς",44,21],["καὶ",2,8],["ἐλήλυθα",55,85],["εἰς",8,1],["τὸν",1,6],["κόσμον",743,7],["πάλιν",655,17],["ἀφίημι",501,149],["τὸν",1,6],["κόσμον",743,7],["καὶ",2,8],["πορεύομαι",49,768],["πρὸς",15,1],["τὸν",1,6],["πατέρα",44,7]],"I came from the Father and have come into the world. Again, I leave the world and go to the Father.”"],["29",[["Λέγουσιν",31,191],["οἱ",1,128],["μαθηταὶ",10025,51],["αὐτοῦ",3,48],["ἴδε",713,316],["νῦν",90,17],["ἐν",4,1],["παρρησίᾳ",2610,2],["λαλεῖς",50,145],["καὶ",2,8],["παροιμίαν",3607,10],["οὐδεμίαν",228,37],["λέγεις",31,145]],"His disciples said to him, “Behold, now you are speaking plainly, and using no figures of speech."],["30",[["νῦν",90,17],["οἴδαμεν",10044,241],["ὅτι",19,8],["οἶδας",10044,145],["πάντα",11,65],["καὶ",2,8],["οὐ",12,12],["χρείαν",1006,10],["ἔχεις",124,145],["ἵνα",102,8],["τίς",39,150],["σε",5,161],["ἐρωτᾷ",822,173],["ἐν",4,1],["τούτῳ",16,279],["πιστεύομεν",649,241],["ὅτι",19,8],["ἀπὸ",17,1],["θεοῦ",20,21],["ἐξῆλθες",82,154]],"Now we know that you know all things, and don’t need for anyone to question you. By this we believe that you came from God.”"],["31",[["ἀπεκρίθη",234,737],["αὐτοῖς",3,142],["Ἰησοῦς",211,5],["ἄρτι",2665,17],["πιστεύετε",649,84]],"Jesus answered them, “Do you now believe?"],["32",[["ἰδοὺ",51,316],["ἔρχεται",55,728],["ὥρα",838,13],["καὶ",2,8],["ἐλήλυθεν",55,165],["ἵνα",102,8],["σκορπισθῆτε",1785,485],["ἕκαστος",171,16],["εἰς",8,1],["τὰ",1,42],["ἴδια",683,65],["κἀμὲ",10000,8],["μόνον",302,59],["ἀφῆτε",501,118],["καὶ",2,8],["οὐκ",12,12],["εἰμὶ",10,149],["μόνος",302,16],["ὅτι",19,8],["ὁ",1,4],["πατὴρ",44,5],["μετ᾽",29,1],["ἐμοῦ",6,88],["ἐστιν",10,87]],"Behold, the time is coming, yes, and has now come, that you will be scattered, everyone to his own place, and you will leave me alone. Yet I am not alone, because the Father is with me."],["33",[["ταῦτα",16,248],["λελάληκα",50,85],["ὑμῖν",5,86],["ἵνα",102,8],["ἐν",4,1],["ἐμοὶ",6,151],["εἰρήνην",213,10],["ἔχητε",124,362],["ἐν",4,1],["τῷ",1,110],["κόσμῳ",743,113],["θλῖψιν",438,10],["ἔχετε",124,84],["ἀλλὰ",108,8],["θαρσεῖτε",1302,307],["ἐγὼ",6,156],["νενίκηκα",1441,85],["τὸν",1,6],["κόσμον",743,7]],"I have told you these things, that in me you may have peace. In the world you have trouble; but cheer up! I have overcome the world.”"]]