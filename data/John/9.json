[["1",[["Καὶ",2,8],["παράγων",2277,67],["εἶδεν",53,3],["ἄνθρωπον",43,7],["τυφλὸν",1600,59],["ἐκ",21,1],["γενετῆς",5510,19]],"As he passed by, he saw a man blind from birth."],["2",[["καὶ",2,8],["ἠρώτησαν",822,141],["αὐτὸν",3,82],["οἱ",1,128],["μαθηταὶ",10025,51],["αὐτοῦ",3,48],["λέγοντες",31,137],["ῥαββί",10172,250],["τίς",10010,150],["ἥμαρτεν",237,3],["οὗτος",16,112],["ἢ",61,8],["οἱ",1,128],["γονεῖς",2012,51],["αὐτοῦ",3,48],["ἵνα",102,8],["τυφλὸς",1600,16],["γεννηθῇ",222,333]],"His disciples asked him, “Rabbi, who sinned, this man or his parents, that he was born blind?”"],["3",[["Ἀπεκρίθη",234,737],["Ἰησοῦς",211,5],["οὔτε",477,8],["οὗτος",16,112],["ἥμαρτεν",237,3],["οὔτε",477,8],["οἱ",1,128],["γονεῖς",2012,51],["αὐτοῦ",3,48],["ἀλλ᾽",108,8],["ἵνα",102,8],["φανερωθῇ",8582,333],["τὰ",1,253],["ἔργα",105,63],["τοῦ",1,30],["θεοῦ",20,21],["ἐν",4,1],["αὐτῷ",3,49]],"Jesus answered, “This man didn’t sin, nor did his parents, but that the works of God might be revealed in him."],["4",[["ἡμᾶς",9994,209],["δεῖ",1158,87],["ἐργάζεσθαι",467,749],["τὰ",1,42],["ἔργα",105,43],["τοῦ",1,30],["πέμψαντός",1597,513],["με",9994,161],["ἕως",42,1],["ἡμέρα",28,13],["ἐστίν",10,87],["ἔρχεται",55,728],["νύξ",219,13],["ὅτε",432,1],["οὐδεὶς",228,16],["δύναται",185,728],["ἐργάζεσθαι",467,749]],"I must work the works of him who sent me while it is day. The night is coming, when no one can work."],["5",[["ὅταν",319,8],["ἐν",4,1],["τῷ",1,110],["κόσμῳ",743,113],["ὦ",10,592],["φῶς",380,20],["εἰμι",10,149],["τοῦ",1,30],["κόσμου",743,21]],"While I am in the world, I am the light of the world.”"],["6",[["ταῦτα",16,248],["εἰπὼν",9997,155],["ἔπτυσεν",6021,3],["χαμαὶ",4464,17],["καὶ",2,8],["ἐποίησεν",23,3],["πηλὸν",1386,7],["ἐκ",21,1],["τοῦ",1,23],["πτύσματος",10467,24],["καὶ",2,8],["ἐπέχρισεν",10468,3],["αὐτοῦ",3,48],["τὸν",1,6],["πηλὸν",1386,7],["ἐπὶ",9,1],["τοὺς",1,56],["ὀφθαλμοὺς",91,31]],"When he had said this, he spat on the ground, made mud with the saliva, anointed the blind man’s eyes with the mud,"],["7",[["καὶ",2,8],["εἶπεν",9997,3],["αὐτῷ",3,49],["ὕπαγε",6654,239],["νίψαι",3310,275],["εἰς",8,1],["τὴν",1,9],["κολυμβήθραν",2731,10],["τοῦ",1,30],["Σιλωάμ",6790,21],["ὃ",24,677],["ἑρμηνεύεται",5350,449],["ἀπεσταλμένος",84,228],["ἀπῆλθεν",297,3],["οὖν",227,8],["καὶ",2,8],["ἐνίψατο",3310,26],["καὶ",2,8],["ἦλθεν",55,3],["βλέπων",470,67]],"and said to him, “Go, wash in the pool of Siloam” (which means “Sent”). So he went away, washed, and came back seeing."],["8",[["Οἱ",1,128],["οὖν",227,8],["γείτονες",2072,51],["καὶ",2,8],["οἱ",1,128],["θεωροῦντες",897,137],["αὐτὸν",3,82],["τὸ",1,32],["πρότερον",496,29],["ὅτι",19,8],["προσαίτης",10260,5],["ἦν",10,14],["ἔλεγον",31,129],["οὐχ",12,12],["οὗτός",16,112],["ἐστιν",10,87],["ὁ",1,4],["καθήμενος",419,723],["καὶ",2,8],["προσαιτῶν",8072,67]],"Therefore the neighbors and those who saw that he was blind before said, “Isn’t this he who sat and begged?”"],["9",[["ἄλλοι",584,130],["ἔλεγον",31,129],["ὅτι",19,8],["οὗτός",16,112],["ἐστιν",10,87],["ἄλλοι",584,130],["ἔλεγον",31,129],["οὐχί",330,12],["ἀλλ᾽",108,8],["ὅμοιος",657,16],["αὐτῷ",3,49],["ἐστιν",10,87],["ἐκεῖνος",80,112],["ἔλεγεν",31,14],["ὅτι",19,8],["ἐγώ",6,156],["εἰμι",10,149]],"Others were saying, “It is he.” Still others were saying, “He looks like him.” He said, “I am he.”"],["10",[["ἔλεγον",31,129],["οὖν",227,8],["αὐτῷ",3,49],["πῶς",10049,12],["οὖν",227,8],["ἠνεῴχθησάν",362,94],["σου",5,146],["οἱ",1,128],["ὀφθαλμοί",91,51]],"They therefore were asking him, “How were your eyes opened?”"],["11",[["ἀπεκρίθη",234,737],["ἐκεῖνος",80,112],["ὁ",1,4],["ἄνθρωπος",43,5],["ὁ",1,4],["λεγόμενος",31,714],["Ἰησοῦς",211,5],["πηλὸν",1386,7],["ἐποίησεν",23,3],["καὶ",2,8],["ἐπέχρισέν",10468,3],["μου",9994,146],["τοὺς",1,56],["ὀφθαλμοὺς",91,31],["καὶ",2,8],["εἶπέν",9997,3],["μοι",9994,151],["ὅτι",19,8],["ὕπαγε",6654,239],["εἰς",8,1],["τὸν",1,6],["Σιλωὰμ",6790,7],["καὶ",2,8],["νίψαι",3310,275],["ἀπελθὼν",297,155],["οὖν",227,8],["καὶ",2,8],["νιψάμενος",3310,244],["ἀνέβλεψα",1425,147]],"He answered, “A man called Jesus made mud, anointed my eyes, and said to me, ‘Go to the pool of Siloam and wash.’ So I went away and washed, and I received sight.”"],["12",[["καὶ",2,8],["εἶπαν",9997,141],["αὐτῷ",3,49],["ποῦ",9996,17],["ἐστιν",10,87],["ἐκεῖνος",80,112],["λέγει",31,87],["οὐκ",12,12],["οἶδα",10044,85]],"Then they asked him, “Where is he?” He said, “I don’t know.”"],["13",[["Ἄγουσιν",224,191],["αὐτὸν",3,82],["πρὸς",15,1],["τοὺς",1,56],["Φαρισαίους",10006,31],["τόν",1,6],["ποτε",458,12],["τυφλόν",1600,59]],"They brought him who had been blind to the Pharisees."],["14",[["ἦν",10,14],["δὲ",14,8],["σάββατον",442,20],["ἐν",4,1],["ᾗ",24,102],["ἡμέρᾳ",28,2],["τὸν",1,6],["πηλὸν",1386,7],["ἐποίησεν",23,3],["ὁ",1,4],["Ἰησοῦς",211,5],["καὶ",2,8],["ἀνέῳξεν",362,3],["αὐτοῦ",3,48],["τοὺς",1,56],["ὀφθαλμούς",91,31]],"It was a Sabbath when Jesus made the mud and opened his eyes."],["15",[["πάλιν",655,17],["οὖν",227,8],["ἠρώτων",822,129],["αὐτὸν",3,82],["καὶ",2,8],["οἱ",1,128],["Φαρισαῖοι",10006,51],["πῶς",10049,12],["ἀνέβλεψεν",1425,3],["ὁ",1,4],["δὲ",14,8],["εἶπεν",9997,3],["αὐτοῖς",3,142],["πηλὸν",1386,7],["ἐπέθηκέν",239,3],["μου",9994,146],["ἐπὶ",9,1],["τοὺς",1,56],["ὀφθαλμοὺς",91,31],["καὶ",2,8],["ἐνιψάμην",3310,152],["καὶ",2,8],["βλέπω",470,149]],"Again therefore the Pharisees also asked him how he received his sight. He said to them, “He put mud on my eyes, I washed, and I see.”"],["16",[["ἔλεγον",31,129],["οὖν",227,8],["ἐκ",21,1],["τῶν",1,76],["Φαρισαίων",10006,77],["τινές",39,402],["οὐκ",12,12],["ἔστιν",10,87],["οὗτος",16,112],["παρὰ",73,1],["θεοῦ",20,21],["ὁ",1,4],["ἄνθρωπος",43,5],["ὅτι",19,8],["τὸ",1,32],["σάββατον",442,33],["οὐ",12,12],["τηρεῖ",1358,87],["ἄλλοι",584,130],["δὲ",14,8],["ἔλεγον",31,129],["πῶς",10049,12],["δύναται",185,728],["ἄνθρωπος",43,5],["ἁμαρτωλὸς",409,16],["τοιαῦτα",630,248],["σημεῖα",505,43],["ποιεῖν",23,54],["καὶ",2,8],["σχίσμα",10075,20],["ἦν",10,14],["ἐν",4,1],["αὐτοῖς",3,142]],"Some therefore of the Pharisees said, “This man is not from God, because he doesn’t keep the Sabbath.” Others said, “How can a man who is a sinner do such signs?” So there was division among them."],["17",[["λέγουσιν",31,191],["οὖν",227,8],["τῷ",1,110],["τυφλῷ",1600,111],["πάλιν",655,17],["τί",10010,119],["σὺ",5,156],["λέγεις",31,145],["περὶ",72,1],["αὐτοῦ",3,48],["ὅτι",19,8],["ἠνέῳξέν",362,3],["σου",5,146],["τοὺς",1,56],["ὀφθαλμούς",91,31],["ὁ",1,4],["δὲ",14,8],["εἶπεν",9997,3],["ὅτι",19,8],["προφήτης",176,5],["ἐστίν",10,87]],"Therefore they asked the blind man again, “What do you say about him, because he opened your eyes?” He said, “He is a prophet.”"],["18",[["οὐκ",12,12],["ἐπίστευσαν",649,141],["οὖν",227,8],["οἱ",1,128],["Ἰουδαῖοι",285,51],["περὶ",72,1],["αὐτοῦ",3,48],["ὅτι",19,8],["ἦν",10,14],["τυφλὸς",1600,16],["καὶ",2,8],["ἀνέβλεψεν",1425,3],["ἕως",42,1],["ὅτου",457,563],["ἐφώνησαν",1745,141],["τοὺς",1,56],["γονεῖς",2012,31],["αὐτοῦ",3,48],["τοῦ",1,30],["ἀναβλέψαντος",1425,513]],"The Jews therefore didn’t believe concerning him, that he had been blind and had received his sight, until they called the parents of him who had received his sight,"],["19",[["καὶ",2,8],["ἠρώτησαν",822,141],["αὐτοὺς",3,60],["λέγοντες",31,137],["οὗτός",16,112],["ἐστιν",10,87],["ὁ",1,4],["υἱὸς",13,5],["ὑμῶν",5,136],["ὃν",24,106],["ὑμεῖς",5,208],["λέγετε",31,84],["ὅτι",19,8],["τυφλὸς",1600,16],["ἐγεννήθη",222,38],["πῶς",10049,12],["οὖν",227,8],["βλέπει",470,87],["ἄρτι",2665,17]],"and asked them, “Is this your son, whom you say was born blind? How then does he now see?”"],["20",[["ἀπεκρίθησαν",234,720],["οὖν",227,8],["οἱ",1,128],["γονεῖς",2012,51],["αὐτοῦ",3,48],["καὶ",2,8],["εἶπαν",9997,141],["οἴδαμεν",10044,311],["ὅτι",19,8],["οὗτός",16,112],["ἐστιν",10,87],["ὁ",1,4],["υἱὸς",13,5],["ἡμῶν",9994,136],["καὶ",2,8],["ὅτι",19,8],["τυφλὸς",1600,16],["ἐγεννήθη",222,38]],"His parents answered them, “We know that this is our son, and that he was born blind;"],["21",[["πῶς",10049,12],["δὲ",14,8],["νῦν",90,17],["βλέπει",470,87],["οὐκ",12,12],["οἴδαμεν",10044,241],["ἢ",61,8],["τίς",10010,150],["ἤνοιξεν",362,3],["αὐτοῦ",3,48],["τοὺς",1,56],["ὀφθαλμοὺς",91,31],["ἡμεῖς",9994,208],["οὐκ",12,12],["οἴδαμεν",10044,241],["αὐτὸν",3,82],["ἐρωτήσατε",822,69],["ἡλικίαν",1755,10],["ἔχει",124,87],["αὐτὸς",3,158],["περὶ",72,1],["ἑαυτοῦ",92,48],["λαλήσει",50,120]],"but how he now sees, we don’t know; or who opened his eyes, we don’t know. He is of age. Ask him. He will speak for himself.”"],["22",[["Ταῦτα",16,248],["εἶπαν",9997,141],["οἱ",1,128],["γονεῖς",2012,51],["αὐτοῦ",3,48],["ὅτι",19,8],["ἐφοβοῦντο",134,767],["τοὺς",1,56],["Ἰουδαίους",285,31],["ἤδη",916,17],["γὰρ",40,8],["συνετέθειντο",2778,877],["οἱ",1,128],["Ἰουδαῖοι",285,51],["ἵνα",102,8],["ἐάν",45,8],["τις",39,150],["αὐτὸν",3,82],["ὁμολογήσῃ",2686,160],["χριστόν",1072,7],["ἀποσυνάγωγος",10469,16],["γένηται",30,745]],"His parents said these things because they feared the Jews; for the Jews had already agreed that if any man would confess him as Christ, he would be put out of the synagogue."],["23",[["διὰ",56,1],["τοῦτο",16,122],["οἱ",1,128],["γονεῖς",2012,51],["αὐτοῦ",3,48],["εἶπαν",9997,141],["ὅτι",19,8],["ἡλικίαν",1755,10],["ἔχει",124,87],["αὐτὸν",3,82],["ἐπερωτήσατε",739,69]],"Therefore his parents said, “He is of age. Ask him.”"],["24",[["Ἐφώνησαν",1745,141],["οὖν",227,8],["τὸν",1,6],["ἄνθρωπον",43,7],["ἐκ",21,1],["δευτέρου",271,88],["ὃς",24,246],["ἦν",10,14],["τυφλὸς",1600,16],["καὶ",2,8],["εἶπαν",9997,141],["αὐτῷ",3,49],["δὸς",33,198],["δόξαν",141,10],["τῷ",1,110],["θεῷ",20,113],["ἡμεῖς",9994,208],["οἴδαμεν",10044,311],["ὅτι",19,8],["οὗτος",16,112],["ὁ",1,4],["ἄνθρωπος",43,5],["ἁμαρτωλός",409,16],["ἐστιν",10,87]],"So they called the man who was blind a second time, and said to him, “Give glory to God. We know that this man is a sinner.”"],["25",[["Ἀπεκρίθη",234,737],["οὖν",227,8],["ἐκεῖνος",80,112],["εἰ",77,8],["ἁμαρτωλός",409,16],["ἐστιν",10,87],["οὐκ",12,12],["οἶδα",10044,149],["ἓν",58,29],["οἶδα",10044,149],["ὅτι",19,8],["τυφλὸς",1600,16],["ὢν",10,67],["ἄρτι",2665,17],["βλέπω",470,149]],"He therefore answered, “I don’t know if he is a sinner. One thing I do know: that though I was blind, now I see.”"],["26",[["εἶπον",9997,141],["οὖν",227,8],["αὐτῷ",3,49],["τί",10010,119],["ἐποίησέν",23,3],["σοι",5,151],["πῶς",10049,12],["ἤνοιξέν",362,3],["σου",5,146],["τοὺς",1,56],["ὀφθαλμούς",91,31]],"They said to him again, “What did he do to you? How did he open your eyes?”"],["27",[["Ἀπεκρίθη",234,737],["αὐτοῖς",3,142],["εἶπον",9997,147],["ὑμῖν",5,86],["ἤδη",916,17],["καὶ",2,8],["οὐκ",12,12],["ἠκούσατε",54,262],["τί",10010,119],["πάλιν",655,17],["θέλετε",612,84],["ἀκούειν",54,54],["μὴ",25,12],["καὶ",2,8],["ὑμεῖς",5,208],["θέλετε",612,84],["αὐτοῦ",3,48],["μαθηταὶ",10025,51],["γενέσθαι",30,776]],"He answered them, “I told you already, and you didn’t listen. Why do you want to hear it again? You don’t also want to become his disciples, do you?”"],["28",[["καὶ",2,8],["ἐλοιδόρησαν",3079,141],["αὐτὸν",3,82],["καὶ",2,8],["εἶπον",9997,141],["σὺ",5,156],["μαθητὴς",10025,5],["εἶ",10,145],["ἐκείνου",80,126],["ἡμεῖς",9994,208],["δὲ",14,8],["τοῦ",1,30],["Μωϋσέως",10061,21],["ἐσμὲν",10,241],["μαθηταί",10025,51]],"They insulted him and said, “You are his disciple, but we are disciples of Moses."],["29",[["ἡμεῖς",9994,208],["οἴδαμεν",10044,241],["ὅτι",19,8],["Μωϋσεῖ",10061,113],["λελάληκεν",50,165],["ὁ",1,4],["θεός",20,5],["τοῦτον",16,259],["δὲ",14,8],["οὐκ",12,12],["οἴδαμεν",10044,241],["πόθεν",1170,17],["ἐστίν",10,87]],"We know that God has spoken to Moses. But as for this man, we don’t know where he comes from.”"],["30",[["ἀπεκρίθη",234,737],["ὁ",1,4],["ἄνθρωπος",43,5],["καὶ",2,8],["εἶπεν",9997,3],["αὐτοῖς",3,142],["ἐν",4,1],["τούτῳ",16,279],["γὰρ",40,8],["τὸ",1,27],["θαυμαστόν",1073,28],["ἐστιν",10,87],["ὅτι",19,8],["ὑμεῖς",5,208],["οὐκ",12,12],["οἴδατε",10044,330],["πόθεν",1170,17],["ἐστίν",10,87],["καὶ",2,8],["ἤνοιξέν",362,3],["μου",9994,146],["τοὺς",1,56],["ὀφθαλμούς",91,31]],"The man answered them, “How amazing! You don’t know where he comes from