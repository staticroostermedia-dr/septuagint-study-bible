[["1",[["Ἐγώ",6,156],["εἰμι",10,149],["ἡ",1,11],["ἄμπελος",812,13],["ἡ",1,11],["ἀληθινή",1023,15],["καὶ",2,8],["ὁ",1,4],["πατήρ",44,5],["μου",9994,146],["ὁ",1,4],["γεωργός",2701,5],["ἐστιν",10,87]],"“I am the true vine, and my Father is the farmer."],["2",[["πᾶν",11,29],["κλῆμα",2589,33],["ἐν",4,1],["ἐμοὶ",6,151],["μὴ",25,12],["φέρον",199,47],["καρπὸν",448,7],["αἴρει",206,87],["αὐτό",3,121],["καὶ",2,8],["πᾶν",11,29],["τὸ",1,32],["καρπὸν",448,7],["φέρον",199,47],["καθαίρει",5660,87],["αὐτὸ",3,121],["ἵνα",102,8],["καρπὸν",448,7],["πλείονα",938,59],["φέρῃ",199,173]],"Every branch in me that doesn’t bear fruit, he takes away. Every branch that bears fruit, he prunes, that it may bear more fruit."],["3",[["ἤδη",916,17],["ὑμεῖς",5,208],["καθαροί",379,130],["ἐστε",10,84],["διὰ",56,1],["τὸν",1,6],["λόγον",48,7],["ὃν",24,106],["λελάληκα",50,85],["ὑμῖν",5,86]],"You are already pruned clean because of the word which I have spoken to you."],["4",[["μείνατε",681,69],["ἐν",4,1],["ἐμοὶ",6,151],["κἀγὼ",10000,8],["ἐν",4,1],["ὑμῖν",5,86],["καθὼς",221,8],["τὸ",1,27],["κλῆμα",2589,20],["οὐ",12,12],["δύναται",185,728],["καρπὸν",448,7],["φέρειν",199,54],["ἀφ᾽",17,1],["ἑαυτοῦ",92,144],["ἐὰν",45,8],["μὴ",25,12],["μένῃ",681,173],["ἐν",4,1],["τῇ",1,95],["ἀμπέλῳ",812,2],["οὕτως",9989,17],["οὐδὲ",106,8],["ὑμεῖς",5,208],["ἐὰν",45,8],["μὴ",25,12],["ἐν",4,1],["ἐμοὶ",6,151],["μένητε",681,362]],"Remain in me, and I in you. As the branch can’t bear fruit by itself unless it remains in the vine, so neither can you, unless you remain in me."],["5",[["ἐγώ",6,156],["εἰμι",10,149],["ἡ",1,11],["ἄμπελος",812,13],["ὑμεῖς",5,208],["τὰ",1,253],["κλήματα",2589,63],["ὁ",1,4],["μένων",681,67],["ἐν",4,1],["ἐμοὶ",6,151],["κἀγὼ",10000,8],["ἐν",4,1],["αὐτῷ",3,49],["οὗτος",16,112],["φέρει",199,87],["καρπὸν",448,7],["πολύν",74,59],["ὅτι",19,8],["χωρὶς",2046,1],["ἐμοῦ",6,88],["οὐ",12,12],["δύνασθε",185,754],["ποιεῖν",23,54],["οὐδέν",228,29]],"I am the vine. You are the branches. He who remains in me and I in him bears much fruit, for apart from me you can do nothing."],["6",[["ἐὰν",45,8],["μή",25,12],["τις",39,150],["μένῃ",681,173],["ἐν",4,1],["ἐμοί",6,151],["ἐβλήθη",766,38],["ἔξω",527,1],["ὡς",36,12],["τὸ",1,27],["κλῆμα",2589,20],["καὶ",2,8],["ἐξηράνθη",842,38],["καὶ",2,8],["συνάγουσιν",166,191],["αὐτὰ",3,66],["καὶ",2,8],["εἰς",8,1],["τὸ",1,32],["πῦρ",118,33],["βάλλουσιν",766,191],["καὶ",2,8],["καίεται",671,449]],"If a man doesn’t remain in me, he is thrown out as a branch and is withered; and they gather them, throw them into the fire, and they are burned."],["7",[["ἐὰν",45,8],["μείνητε",681,118],["ἐν",4,1],["ἐμοὶ",6,151],["καὶ",2,8],["τὰ",1,253],["ῥήματά",116,63],["μου",9994,146],["ἐν",4,1],["ὑμῖν",5,86],["μείνῃ",681,160],["ὃ",24,467],["ἐὰν",45,8],["θέλητε",612,362],["αἰτήσασθε",617,268],["καὶ",2,8],["γενήσεται",30,718],["ὑμῖν",5,86]],"If you remain in me, and my words remain in you, you will ask whatever you desire, and it will be done for you."],["8",[["ἐν",4,1],["τούτῳ",16,279],["ἐδοξάσθη",452,38],["ὁ",1,4],["πατήρ",44,5],["μου",9994,146],["ἵνα",102,1],["καρπὸν",448,7],["πολὺν",74,59],["φέρητε",199,362],["καὶ",2,8],["γένησθε",30,746],["ἐμοὶ",10146,130],["μαθηταί",10025,51]],"“In this my Father is glorified, that you bear much fruit; and so you will be my disciples."],["9",[["καθὼς",221,8],["ἠγάπησέν",214,3],["με",9994,161],["ὁ",1,4],["πατήρ",44,5],["κἀγὼ",10000,8],["ὑμᾶς",5,209],["ἠγάπησα",214,147],["μείνατε",681,69],["ἐν",4,1],["τῇ",1,95],["ἀγάπῃ",1982,2],["τῇ",1,95],["ἐμῇ",10146,96]],"Even as the Father has loved me, I also have loved you. Remain in my love."],["10",[["ἐὰν",45,8],["τὰς",1,39],["ἐντολάς",259,40],["μου",9994,146],["τηρήσητε",1358,118],["μενεῖτε",681,348],["ἐν",4,1],["τῇ",1,95],["ἀγάπῃ",1982,2],["μου",9994,146],["καθὼς",221,8],["ἐγὼ",6,156],["τὰς",1,39],["ἐντολὰς",259,40],["τοῦ",1,30],["πατρός",44,21],["μου",9994,146],["τετήρηκα",1358,85],["καὶ",2,8],["μένω",681,149],["αὐτοῦ",3,48],["ἐν",4,1],["τῇ",1,95],["ἀγάπῃ",1982,2]],"If you keep my commandments, you will remain in my love, even as I have kept my Father’s commandments and remain in his love."],["11",[["Ταῦτα",16,248],["λελάληκα",50,85],["ὑμῖν",5,86],["ἵνα",102,8],["ἡ",1,11],["χαρὰ",1125,13],["ἡ",1,11],["ἐμὴ",10146,15],["ἐν",4,1],["ὑμῖν",5,86],["ᾖ",10,173],["καὶ",2,8],["ἡ",1,11],["χαρὰ",1125,13],["ὑμῶν",5,136],["πληρωθῇ",518,333]],"I have spoken these things to you, that my joy may remain in you, and that your joy may be made full."],["12",[["αὕτη",16,101],["ἐστὶν",10,87],["ἡ",1,11],["ἐντολὴ",259,13],["ἡ",1,11],["ἐμὴ",10146,15],["ἵνα",102,1],["ἀγαπᾶτε",214,362],["ἀλλήλους",1192,60],["καθὼς",221,8],["ἠγάπησα",214,147],["ὑμᾶς",5,209]],"“This is my commandment, that you love one another, even as I have loved you."],["13",[["μείζονα",66,37],["ταύτης",16,290],["ἀγάπην",1982,10],["οὐδεὶς",228,16],["ἔχει",124,87],["ἵνα",102,8],["τις",39,150],["τὴν",1,9],["ψυχὴν",63,10],["αὐτοῦ",3,48],["θῇ",110,160],["ὑπὲρ",139,1],["τῶν",1,76],["φίλων",336,163],["αὐτοῦ",3,48]],"Greater love has no one than this, that someone lay down his life for his friends."],["14",[["ὑμεῖς",5,208],["φίλοι",336,130],["μού",9994,146],["ἐστε",10,84],["ἐὰν",45,8],["ποιῆτε",23,362],["ἃ",24,755],["ἐγὼ",6,156],["ἐντέλλομαι",143,768],["ὑμῖν",5,86]],"You are my friends if you do whatever I command you."],["15",[["οὐκέτι",12,17],["λέγω",31,149],["ὑμᾶς",5,209],["δούλους",136,31],["ὅτι",19,8],["ὁ",1,4],["δοῦλος",136,5],["οὐκ",12,12],["οἶδεν",10044,165],["τί",10010,119],["ποιεῖ",23,87],["αὐτοῦ",3,48],["ὁ",1,4],["κύριος",7,5],["ὑμᾶς",5,209],["δὲ",14,8],["εἴρηκα",9993,85],["φίλους",336,58],["ὅτι",19,8],["πάντα",11,65],["ἃ",24,755],["ἤκουσα",54,147],["παρὰ",73,1],["τοῦ",1,30],["πατρός",44,21],["μου",9994,146],["ἐγνώρισα",748,147],["ὑμῖν",5,86]],"No longer do I call you servants, for the servant doesn’t know what his lord does. But I have called you friends, for everything that I heard from my Father, I have made known to you."],["16",[["Οὐχ",12,12],["ὑμεῖς",5,208],["με",9994,161],["ἐξελέξασθε",420,371],["ἀλλ᾽",108,8],["ἐγὼ",6,156],["ἐξελεξάμην",420,152],["ὑμᾶς",5,209],["καὶ",2,8],["ἔθηκα",110,147],["ὑμᾶς",5,209],["ἵνα",102,8],["ὑμεῖς",5,208],["ὑπάγητε",6654,362],["καὶ",2,8],["καρπὸν",448,7],["φέρητε",199,362],["καὶ",2,8],["ὁ",1,4],["καρπὸς",448,5],["ὑμῶν",5,136],["μένῃ",681,173],["ἵνα",102,8],["ὅ",24,467],["τι",39,119],["ἂν",83,12],["αἰτήσητε",617,118],["τὸν",1,6],["πατέρα",44,7],["ἐν",4,1],["τῷ",1,52],["ὀνόματί",57,53],["μου",9994,146],["δῷ",33,160],["ὑμῖν",5,86]],"You didn’t choose me, but I chose you and appointed you, that you should go and bear fruit, and that your fruit should remain; that whatever you will ask of the Father in my name, he may give it to you."],["17",[["Ταῦτα",16,248],["ἐντέλλομαι",143,768],["ὑμῖν",5,86],["ἵνα",102,1],["ἀγαπᾶτε",214,362],["ἀλλήλους",1192,60]],"“I command these things to you, that you may love one another."],["18",[["εἰ",77,8],["ὁ",1,4],["κόσμος",743,5],["ὑμᾶς",5,209],["μισεῖ",351,87],["γινώσκετε",79,84],["ὅτι",19,8],["ἐμὲ",6,161],["πρῶτον",315,29],["ὑμῶν",5,136],["μεμίσηκεν",351,165]],"If the world hates you, you know that it has hated me before it hated you."],["19",[["εἰ",77,8],["ἐκ",21,1],["τοῦ",1,30],["κόσμου",743,21],["ἦτε",10,339],["ὁ",1,4],["κόσμος",743,5],["ἂν",83,12],["τὸ",1,32],["ἴδιον",683,29],["ἐφίλει",1391,14],["ὅτι",19,8],["δὲ",14,8],["ἐκ",21,1],["τοῦ",1,30],["κόσμου",743,21],["οὐκ",12,12],["ἐστέ",10,84],["ἀλλ᾽",108,8],["ἐγὼ",6,156],["ἐξελεξάμην",420,152],["ὑμᾶς",5,209],["ἐκ",21,1],["τοῦ",1,30],["κόσμου",743,21],["διὰ",56,1],["τοῦτο",16,122],["μισεῖ",351,87],["ὑμᾶς",5,209],["ὁ",1,4],["κόσμος",743,5]],"If you were of the world, the world would love its own. But because you are not of the world, since I chose you out of the world, therefore the world hates you."],["20",[["μνημονεύετε",1900,307],["τοῦ",1,30],["λόγου",48,21],["οὗ",24,367],["ἐγὼ",6,156],["εἶπον",9997,147],["ὑμῖν",5,86],["οὐκ",12,12],["ἔστιν",10,87],["δοῦλος",136,5],["μείζων",66,16],["τοῦ",1,30],["κυρίου",7,21],["αὐτοῦ",3,48],["εἰ",77,8],["ἐμὲ",6,161],["ἐδίωξαν",533,141],["καὶ",2,8],["ὑμᾶς",5,209],["διώξουσιν",533,207],["εἰ",77,8],["τὸν",1,6],["λόγον",48,7],["μου",9994,146],["ἐτήρησαν",1358,141],["καὶ",2,8],["τὸν",1,6],["ὑμέτερον",10347,59],["τηρήσουσιν",1358,207]],"Remember the word that I said to you: ‘A servant is not greater than his lord.’ If they persecuted me, they will also persecute you. If they kept my word, they will also keep yours."],["21",[["ἀλλὰ",108,8],["ταῦτα",16,248],["πάντα",11,65],["ποιήσουσιν",23,207],["εἰς",8,1],["ὑμᾶς",5,209],["διὰ",56,1],["τὸ",1,32],["ὄνομά",57,33],["μου",9994,146],["ὅτι",19,8],["οὐκ",12,12],["οἴδασιν",10044,400],["τὸν",1,6],["πέμψαντά",1597,476],["με",9994,161]],"But they will do all these things to you for my name’s sake, because they don’t know him who sent me."],["22",[["Εἰ",77,8],["μὴ",25,12],["ἦλθον",55,147],["καὶ",2,8],["ἐλάλησα",50,147],["αὐτοῖς",3,142],["ἁμαρτίαν",119,10],["οὐκ",12,12],["εἴχοσαν",124,129],["νῦν",90,17],["δὲ",14,8],["πρόφασιν",3634,10],["οὐκ",12,12],["ἔχουσιν",124,191],["περὶ",72,1],["τῆς",1,18],["ἁμαρτίας",119,19],["αὐτῶν",3,41]],"If I had not come and spoken to them, they would not have had sin; but now they have no excuse for their sin."],["23",[["ὁ",1,4],["ἐμὲ",6,161],["μισῶν",351,67],["καὶ",2,8],["τὸν",1,6],["πατέρα",44,7],["μου",9994,146],["μισεῖ",351,87]],"He who hates me, hates my Father also."],["24",[["εἰ",77,8],["τὰ",1,42],["ἔργα",105,43],["μὴ",25,12],["ἐποίησα",23,147],["ἐν",4,1],["αὐτοῖς",3,142],["ἃ",24,755],["οὐδεὶς",228,16],["ἄλλος",584,16],["ἐποίησεν",23,3],["ἁμαρτίαν",119,10],["οὐκ",12,12],["εἴχοσαν",124,129],["νῦν",90,17],["δὲ",14,8],["καὶ",2,8],["ἑωράκασιν",112,400],["καὶ",2,8],["μεμισήκασιν",351,400],["καὶ",2,8],["ἐμὲ",6,161],["καὶ",2,8],["τὸν",1,6],["πατέρα",44,7],["μου",9994,146]],"If I hadn’t done among them the works which no one else did, they wouldn’t have had sin. But now they have seen and also hated both me and my Father."],["25",[["ἀλλ᾽",108,8],["ἵνα",102,8],["πληρωθῇ",518,333],["ὁ",1,4],["λόγος",48,5],["ὁ",1,4],["ἐν",4,1],["τῷ",1,110],["νόμῳ",140,113],["αὐτῶν",3,41],["γεγραμμένος",186,228],["ὅτι",19,8],["ἐμίσησάν",351,141],["με",9994,161],["δωρεάν",10087,17]],"But this happened so that the word may be fulfilled which was written in their law, ‘They hated me without a cause.’"],["26",[["Ὅταν",319,8],["ἔλθῃ",55,160],["ὁ",1,4],["παράκλητος",10479,5],["ὃν",24,106],["ἐγὼ",6,156],["πέμψω",1597,157],["ὑμῖν",5,86],["παρὰ",73,1],["τοῦ",1,30],["πατρός",44,21],["τὸ",1,27],["πνεῦμα",168,20],["τῆς",1,18],["ἀληθείας",352,19],["ὃ",24,677],["παρὰ",73,1],["τοῦ",1,30],["πατρὸς",44,21],["ἐκπορεύεται",365,728],["ἐκεῖνος",80,112],["μαρτυρήσει",2094,120],["περὶ",72,1],["ἐμοῦ",6,88]],"“When the Counselor has come, whom I will send to you from the Father, the Spirit of truth, who proceeds from the Father, he will testify about me."],["27",[["καὶ",2,8],["ὑμεῖς",5,208],["δὲ",14,8],["μαρτυρεῖτε",2094,84],["ὅτι",19,8],["ἀπ᾽",17,1],["ἀρχῆς",270,19],["μετ᾽",29,1],["ἐμοῦ",6,88],["ἐστε",10,84]],"You will also testify, because you have been with me from the beginning."]]