[["1",[["Μὴ",25,12],["ταρασσέσθω",508,878],["ὑμῶν",5,136],["ἡ",1,11],["καρδία",64,13],["πιστεύετε",649,84],["εἰς",8,1],["τὸν",1,6],["θεὸν",20,7],["καὶ",2,8],["εἰς",8,1],["ἐμὲ",6,161],["πιστεύετε",649,84]],"“Don’t let your heart be troubled. Believe in God. Believe also in me."],["2",[["ἐν",4,1],["τῇ",1,95],["οἰκίᾳ",233,2],["τοῦ",1,30],["πατρός",44,21],["μου",9994,146],["μοναὶ",7705,180],["πολλαί",74,187],["εἰσιν",10,191],["εἰ",77,8],["δὲ",14,8],["μή",25,12],["εἶπον",9997,147],["ἂν",83,12],["ὑμῖν",5,86],["ὅτι",19,8],["πορεύομαι",49,768],["ἑτοιμάσαι",371,100],["τόπον",99,7],["ὑμῖν",5,86]],"In my Father’s house are many homes. If it weren’t so, I would have told you. I am going to prepare a place for you."],["3",[["καὶ",2,8],["ἐὰν",45,8],["πορευθῶ",49,879],["καὶ",2,8],["ἑτοιμάσω",371,227],["τόπον",99,7],["ὑμῖν",5,86],["πάλιν",655,17],["ἔρχομαι",55,768],["καὶ",2,8],["παραλήμψομαι",1385,775],["ὑμᾶς",5,209],["πρὸς",15,1],["ἐμαυτόν",10062,82],["ἵνα",102,8],["ὅπου",1579,8],["εἰμὶ",10,149],["ἐγὼ",6,156],["καὶ",2,8],["ὑμεῖς",5,208],["ἦτε",10,362]],"If I go and prepare a place for you, I will come again and will receive you to myself; that where I am, you may be there also."],["4",[["καὶ",2,8],["ὅπου",1579,8],["ἐγὼ",6,156],["ὑπάγω",6654,149],["οἴδατε",10044,84],["τὴν",1,9],["ὁδόν",68,10]],"You know where I go, and you know the way.”"],["5",[["Λέγει",31,87],["αὐτῷ",3,49],["Θωμᾶς",10082,5],["κύριε",7,250],["οὐκ",12,12],["οἴδαμεν",10044,241],["ποῦ",9996,17],["ὑπάγεις",6654,145],["πῶς",10049,12],["δυνάμεθα",185,800],["τὴν",1,9],["ὁδὸν",68,10],["εἰδέναι",10044,54]],"Thomas said to him, “Lord, we don’t know where you are going. How can we know the way?”"],["6",[["λέγει",31,87],["αὐτῷ",3,49],["ὁ",1,4],["Ἰησοῦς",211,5],["ἐγώ",6,156],["εἰμι",10,149],["ἡ",1,11],["ὁδὸς",68,13],["καὶ",2,8],["ἡ",1,11],["ἀλήθεια",352,13],["καὶ",2,8],["ἡ",1,11],["ζωή",216,13],["οὐδεὶς",228,16],["ἔρχεται",55,728],["πρὸς",15,1],["τὸν",1,6],["πατέρα",44,7],["εἰ",77,8],["μὴ",25,12],["δι᾽",56,1],["ἐμοῦ",6,88]],"