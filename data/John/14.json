πιστεύετέ",649,307],["μοι",9994,151],["ὅτι",19,8],["ἐγὼ",6,156],["ἐν",4,1],["τῷ",1,110],["πατρὶ",44,113],["καὶ",2,8],["ὁ",1,4],["πατὴρ",44,5],["ἐν",4,1],["ἐμοί",6,151],["εἰ",77,8],["δὲ",14,8],["μή",25,12],["διὰ",56,1],["τὰ",1,42],["ἔργα",105,43],["αὐτὰ",3,66],["πιστεύετε",649,307]],"Believe me that I am in the Father, and the Father in me; or else believe me for the very works’ sake."],["12",[["Ἀμὴν",3161,316],["ἀμὴν",3161,316],["λέγω",31,149],["ὑμῖν",5,86],["ὁ",1,4],["πιστεύων",649,67],["εἰς",8,1],["ἐμέ",6,161],["τὰ",1,42],["ἔργα",105,43],["ἃ",24,755],["ἐγὼ",6,156],["ποιῶ",23,149],["κἀκεῖνος",10122,112],["ποιήσει",23,120],["καὶ",2,8],["μείζονα",66,65],["τούτων",16,214],["ποιήσει",23,120],["ὅτι",19,8],["ἐγὼ",6,156],["πρὸς",15,1],["τὸν",1,6],["πατέρα",44,7],["πορεύομαι",49,768]],"Most certainly I tell you, he who believes in me, the works that I do, he will do also; and he will do greater works than these, because I am going to my Father."],["13",[["καὶ",2,8],["ὅ",24,467],["τι",39,119],["ἂν",83,12],["αἰτήσητε",617,118],["ἐν",4,1],["τῷ",1,52],["ὀνόματί",57,53],["μου",9994,146],["τοῦτο",16,122],["ποιήσω",23,157],["ἵνα",102,8],["δοξασθῇ",452,333],["ὁ",1,4],["πατὴρ",44,5],["ἐν",4,1],["τῷ",1,110],["υἱῷ",13,113]],"Whatever you will ask in my name, I will do it, that the Father may be glorified in the Son."],["14",[["ἐάν",45,8],["τι",39,119],["αἰτήσητέ",617,118],["με",9994,161],["ἐν",4,1],["τῷ",1,52],["ὀνόματί",57,53],["μου",9994,146],["ἐγὼ",6,156],["ποιήσω",23,157]],"If you will ask anything in my name, I will do it."],["15",[["Ἐὰν",45,8],["ἀγαπᾶτέ",214,362],["με",9994,161],["τὰς",1,39],["ἐντολὰς",259,40],["τὰς",1,39],["ἐμὰς",10146,109],["τηρήσετε",1358,348]],"If you love me, keep my commandments."],["16",[["κἀγὼ",10000,8],["ἐρωτήσω",822,157],["τὸν",1,6],["πατέρα",44,7],["καὶ",2,8],["ἄλλον",584,59],["παράκλητον",10479,7],["δώσει",33,120],["ὑμῖν",5,86],["ἵνα",102,8],["μεθ᾽",29,1],["ὑμῶν",5,136],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["ᾖ",10,173]],"I will pray to the Father, and he will give you another Counselor, that he may be with you forever:"],["17",[["τὸ",1,32],["πνεῦμα",168,33],["τῆς",1,18],["ἀληθείας",352,19],["ὃ",24,467],["ὁ",1,4],["κόσμος",743,5],["οὐ",12,12],["δύναται",185,728],["λαβεῖν",46,100],["ὅτι",19,8],["οὐ",12,12],["θεωρεῖ",897,87],["αὐτὸ",3,121],["οὐδὲ",106,8],["γινώσκει",79,87],["ὑμεῖς",5,208],["γινώσκετε",79,84],["αὐτό",3,121],["ὅτι",19,8],["παρ᾽",73,1],["ὑμῖν",5,86],["μένει",681,87],["καὶ",2,8],["ἐν",4,1],["ὑμῖν",5,86],["ἔσται",10,718]],"the Spirit of truth, whom the world can’t receive, for it doesn’t see him and doesn’t know him. You know him, for he lives with you and will be in you."],["18",[["οὐκ",12,12],["ἀφήσω",501,157],["ὑμᾶς",5,209],["ὀρφανούς",957,58],["ἔρχομαι",55,768],["πρὸς",15,1],["ὑμᾶς",5,209]],"I will not leave you orphans. I will come to you."],["19",[["Ἔτι",111,17],["μικρὸν",367,29],["καὶ",2,8],["ὁ",1,4],["κόσμος",743,5],["με",9994,161],["οὐκέτι",12,17],["θεωρεῖ",897,87],["ὑμεῖς",5,208],["δὲ",14,8],["θεωρεῖτέ",897,84],["με",9994,161],["ὅτι",19,8],["ἐγὼ",6,156],["ζῶ",107,149],["καὶ",2,8],["ὑμεῖς",5,208],["ζήσετε",107,348]],"Yet a little while, and the world will see me no more; but you will see me. Because I live, you will live also."],["20",[["ἐν",4,1],["ἐκείνῃ",80,200],["τῇ",1,95],["ἡμέρᾳ",28,2],["γνώσεσθε",79,747],["ὑμεῖς",5,208],["ὅτι",19,8],["ἐγὼ",6,156],["ἐν",4,1],["τῷ",1,110],["πατρί",44,113],["μου",9994,146],["καὶ",2,8],["ὑμεῖς",5,208],["ἐν",4,1],["ἐμοὶ",6,151],["κἀγὼ",10000,8],["ἐν",4,1],["ὑμῖν",5,86]],"In that day you will know that I am in my Father, and you in me, and I in you."],["21",[["Ὁ",1,4],["ἔχων",124,67],["τὰς",1,39],["ἐντολάς",259,40],["μου",9994,146],["καὶ",2,8],["τηρῶν",1358,67],["αὐτάς",3,221],["ἐκεῖνός",80,112],["ἐστιν",10,87],["ὁ",1,4],["ἀγαπῶν",214,67],["με",9994,161],["ὁ",1,4],["δὲ",14,8],["ἀγαπῶν",214,67],["με",9994,161],["ἀγαπηθήσεται",214,125],["ὑπὸ",122,1],["τοῦ",1,30],["πατρός",44,21],["μου",9994,146],["κἀγὼ",10000,8],["ἀγαπήσω",214,157],["αὐτὸν",3,82],["καὶ",2,8],["ἐμφανίσω",2828,157],["αὐτῷ",3,49],["ἐμαυτόν",10062,82]],"One who has my commandments and keeps them, that person is one who loves me. One who loves me will be loved by my Father, and I will love him, and will reveal myself to him.”"],["22",[["Λέγει",31,87],["αὐτῷ",3,49],["Ἰούδας",62,5],["οὐχ",12,12],["ὁ",1,4],["Ἰσκαριώτης",10086,5],["κύριε",7,250],["καὶ",2,8],["τί",10010,238],["γέγονεν",30,165],["ὅτι",19,8],["ἡμῖν",9994,86],["μέλλεις",1143,145],["ἐμφανίζειν",2828,54],["σεαυτὸν",10014,82],["καὶ",2,8],["οὐχὶ",330,12],["τῷ",1,110],["κόσμῳ",743,113]],"Judas (not Iscariot) said to him, “Lord, what has happened that you are about to reveal yourself to us, and not to the world?”"],["23",[["Ἀπεκρίθη",234,737],["Ἰησοῦς",211,5],["καὶ",2,8],["εἶπεν",9997,3],["αὐτῷ",3,49],["ἐάν",45,8],["τις",39,150],["ἀγαπᾷ",214,173],["με",9994,161],["τὸν",1,6],["λόγον",48,7],["μου",9994,146],["τηρήσει",1358,120],["καὶ",2,8],["ὁ",1,4],["πατήρ",44,5],["μου",9994,146],["ἀγαπήσει",214,120],["αὐτόν",3,82],["καὶ",2,8],["πρὸς",15,1],["αὐτὸν",3,82],["ἐλευσόμεθα",55,874],["καὶ",2,8],["μονὴν",7705,10],["παρ᾽",73,1],["αὐτῷ",3,49],["ποιησόμεθα",23,874]],"Jesus answered him, “If a man loves me, he will keep my word. My Father will love him, and we will come to him and make our home with him."],["24",[["ὁ",1,4],["μὴ",25,12],["ἀγαπῶν",214,67],["με",9994,161],["τοὺς",1,56],["λόγους",48,31],["μου",9994,146],["οὐ",12,12],["τηρεῖ",1358,87],["καὶ",2,8],["ὁ",1,4],["λόγος",48,5],["ὃν",24,106],["ἀκούετε",54,84],["οὐκ",12,12],["ἔστιν",10,87],["ἐμὸς",10146,16],["ἀλλὰ",108,8],["τοῦ",1,30],["πέμψαντός",1597,513],["με",9994,161],["πατρός",44,21]],"He who doesn’t love me doesn’t keep my words. The word which you hear isn’t mine, but the Father’s who sent me."],["25",[["Ταῦτα",16,248],["λελάληκα",50,85],["ὑμῖν",5,86],["παρ᾽",73,1],["ὑμῖν",5,86],["μένων",681,67]],"“I have said these things to you while still living with you."],["26",[["ὁ",1,4],["δὲ",14,8],["παράκλητος",10479,5],["τὸ",1,27],["πνεῦμα",168,20],["τὸ",1,27],["ἅγιον",75,28],["ὃ",24,467],["πέμψει",1597,120],["ὁ",1,4],["πατὴρ",44,5],["ἐν",4,1],["τῷ",1,52],["ὀνόματί",57,53],["μου",9994,146],["ἐκεῖνος",80,112],["ὑμᾶς",5,209],["διδάξει",545,120],["πάντα",11,65],["καὶ",2,8],["ὑπομνήσει",5423,120],["ὑμᾶς",5,209],["πάντα",11,65],["ἃ",24,755],["εἶπον",9997,147],["ὑμῖν",5,86],["ἐγώ",6,156]],"But the Counselor, the Holy Spirit, whom the Father will send in my name, will teach you all things, and will remind you of all that I said to you."],["27",[["Εἰρήνην",213,10],["ἀφίημι",501,149],["ὑμῖν",5,86],["εἰρήνην",213,10],["τὴν",1,9],["ἐμὴν",10146,37],["δίδωμι",33,149],["ὑμῖν",5,86],["οὐ",12,12],["καθὼς",221,8],["ὁ",1,4],["κόσμος",743,5],["δίδωσιν",33,87],["ἐγὼ",6,156],["δίδωμι",33,149],["ὑμῖν",5,86],["μὴ",25,12],["ταρασσέσθω",508,878],["ὑμῶν",5,136],["ἡ",1,11],["καρδία",64,13],["μηδὲ",414,8],["δειλιάτω",1955,35]],"Peace I leave with you. My peace I give to you; not as the world gives, I give to you. Don’t let your heart be troubled, neither let it be fearful."],["28",[["ἠκούσατε",54,262],["ὅτι",19,8],["ἐγὼ",6,156],["εἶπον",9997,147],["ὑμῖν",5,86],["ὑπάγω",6654,149],["καὶ",2,8],["ἔρχομαι",55,768],["πρὸς",15,1],["ὑμᾶς",5,209],["εἰ",77,8],["ἠγαπᾶτέ",214,339],["με",9994,161],["ἐχάρητε",698,802],["ἂν",83,12],["ὅτι",19,8],["πορεύομαι",49,768],["πρὸς",15,1],["τὸν",1,6],["πατέρα",44,7],["ὅτι",19,8],["ὁ",1,4],["πατὴρ",44,5],["μείζων",66,16],["μού",9994,146],["ἐστιν",10,87]],"You heard how I told you, ‘I am going away, and I will come back to you.’ If you loved me, you would have rejoiced because I said ‘I am going to my Father;’ for the Father is greater than I."],["29",[["καὶ",2,8],["νῦν",90,17],["εἴρηκα",9993,85],["ὑμῖν",5,86],["πρὶν",1224,17],["γενέσθαι",30,776],["ἵνα",102,8],["ὅταν",319,8],["γένηται",30,745],["πιστεύσητε",649,118]],"Now I have told you before it happens so that when it happens, you may believe."],["30",[["Οὐκέτι",12,17],["πολλὰ",74,65],["λαλήσω",50,157],["μεθ᾽",29,1],["ὑμῶν",5,136],["ἔρχεται",55,728],["γὰρ",40,8],["ὁ",1,4],["τοῦ",1,30],["κόσμου",743,21],["ἄρχων",96,5],["καὶ",2,8],["ἐν",4,1],["ἐμοὶ",6,151],["οὐκ",12,12],["ἔχει",124,87],["οὐδέν",228,29]],"I will no more speak much with you, for the prince of the world comes, and he has nothing in me."],["31",[["ἀλλ᾽",108,8],["ἵνα",102,8],["γνῷ",79,160],["ὁ",1,4],["κόσμος",743,5],["ὅτι",19,8],["ἀγαπῶ",214,149],["τὸν",1,6],["πατέρα",44,7],["καὶ",2,8],["καθὼς",221,8],["ἐνετείλατό",143,737],["μοι",9994,151],["ὁ",1,4],["πατήρ",44,5],["οὕτως",9989,17],["ποιῶ",23,149],["ἐγείρεσθε",746,382],["ἄγωμεν",224,223],["ἐντεῦθεν",1458,17]],"But that the world may know that I love the Father, and as the Father commanded me, even so I do. Arise, let’s go from here."]]