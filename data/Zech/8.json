[["1",[["Καὶ",2,8],["ἐγένετο",30,26],["λόγος",48,5],["Κυρίου",7,21],["παντοκράτορος",340,21],["λέγων",31,67]],"And the word of the Lord Almighty came, saying,"],["2",[["τάδε",129,248],["λέγει",31,87],["Κύριος",7,5],["παντοκράτωρ",340,5],["ἐζήλωκα",1057,85],["τὴν",1,9],["Ἱερουσαλὴμ",70,20],["καὶ",2,8],["τὴν",1,9],["Σιὼν",334,2],["ζῆλον",1164,7],["μέγαν",66,59],["καὶ",2,8],["θυμῷ",178,113],["μεγάλῳ",66,111],["ἐζήλωκα",1057,85],["αὐτήν",3,98]],"Thus saith the Lord Almighty; I have been jealous for Jerusalem and for Sion with great jealousy, and I have been jealous for her with great fury."],["3",[["Τάδε",129,248],["λέγει",31,87],["Κύριος",7,5],["ἐπιστρέψω",117,157],["ἐπὶ",9,1],["Σιὼν",334,2],["καὶ",2,8],["κατασκηνώσω",805,157],["ἐν",4,1],["μέσῳ",113,34],["Ἱερουσαλὴμ",70,20],["καὶ",2,8],["κληθήσεται",128,125],["ἡ",1,11],["Ἱερουσαλὴμ",70,20],["πόλις",41,13],["ἀληθινὴ",1023,15],["καὶ",2,8],["τὸ",1,32],["ὄρος",87,33],["Κυρίου",7,21],["παντοκράτορος",340,21],["ὄρος",87,33],["ἅγιον",75,29]],"Thus saith the Lord; I will return to Sion, and dwell in the midst of Jerusalem: and Jerusalem shall be called a true city, and the mountain of the Lord Almighty a holy mountain."],["4",[["Τάδε",129,248],["λέγει",31,87],["Κύριος",7,5],["παντοκράτωρ",340,5],["ἔτι",111,17],["καθήσονται",1272,127],["πρεσβύτεροι",332,51],["καὶ",2,8],["πρεσβύτεραι",1419,180],["ἐν",4,1],["ταῖς",1,70],["πλατείαις",925,71],["Ἱερουσαλὴμ",70,20],["ἕκαστος",171,16],["τὴν",1,9],["ῥάβδον",493,10],["αὐτοῦ",3,48],["ἔχων",124,67],["ἐν",4,1],["τῇ",1,95],["χειρὶ",37,2],["αὐτοῦ",3,144],["ἀπὸ",17,1],["πλήθους",200,24],["ἡμερῶν",28,61]],"Thus saith the Lord Almighty; There shall yet dwell old men and old women in the streets of Jerusalem, every one holding his staff in his hand for age."],["5",[["Καὶ",2,8],["αἱ",1,185],["πλατεῖαι",925,180],["τῆς",1,18],["πόλεως",41,19],["πλησθήσονται",924,135],["παιδαρίων",304,45],["καὶ",2,8],["κορασίων",1552,45],["παιζόντων",1418,80],["ἐν",4,1],["ταῖς",1,70],["πλατείαις",925,71],["αὐτῆς",3,83]],"And the broad places of the city shall be filled with boys and girls playing in the streets thereof."],["6",[["Τάδε",129,248],["λέγει",31,87],["Κύριος",7,5],["παντοκράτωρ",340,5],["εἰ",77,8],["ἀδυνατήσει",2400,120],["ἐνώπιον",115,1],["τῶν",1,76],["καταλοίπων",557,163],["τοῦ",1,30],["λαοῦ",35,21],["τούτου",16,126],["ἐν",4,1],["ταῖς",1,70],["ἡμέραις",28,71],["ἐκείναις",80,194],["μὴ",25,8],["καὶ",2,8],["ἐνώπιόν",115,1],["μου",6,48],["ἀδυνατήσει",2400,120],["λέγει",31,87],["Κύριος",7,5],["παντοκράτωρ",340,5]],"Thus saith the Lord Almighty; If it shall be impossible in the sight of the remnant of this people in those days, shall it also be impossible in my sight? saith the Lord Almighty."],["7",[["Τάδε",129,248],["λέγει",31,87],["Κύριος",7,5],["παντοκράτωρ",340,5],["ἰδοὺ",51,17],["ἐγὼ",6,158],["σώζω",172,149],["τὸν",1,6],["λαόν",35,7],["μου",6,83],["ἀπὸ",17,1],["γῆς",26,19],["ἀνατολῶν",345,61],["καὶ",2,8],["ἀπὸ",17,1],["γῆς",26,19],["δυσμῶν",882,61]],"Thus saith the Lord Almighty; Behold, I [will] save my people from the east country, and the west country;"],["8",[["καὶ",2,8],["εἰσάξω",389,157],["αὐτοὺς",3,60],["καὶ",2,8],["κατασκηνώσω",805,157],["ἐν",4,1],["μέσῳ",113,34],["Ἱερουσαλὴμ",70,20],["καὶ",2,8],["ἔσονται",10,127],["ἐμοὶ",6,49],["εἰς",8,1],["λαὸν",35,7],["κᾀγὼ",613,105],["ἔσομαι",10,177],["αὐτοῖς",3,142],["εἰς",8,1],["Θεὸν",20,7],["ἐν",4,1],["ἀληθείᾳ",352,2],["καὶ",2,8],["ἐν",4,1],["δικαιοσύνῃ",187,2]],"and I will bring them in, and cause [them] to dwell in the midst of Jerusalem: and they shall be to me a people, and I will be to them a God, in truth and in righteousness."],["9",[["Τάδε",129,248],["λέγει",31,87],["Κύριος",7,5],["παντοκράτωρ",340,5],["κατισχυέτωσαν",628,55],["αἱ",1,185],["χεῖρες",37,180],["ὑμῶν",5,136],["τῶν",1,76],["ἀκουόντων",54,164],["ἐν",4,1],["ταῖς",1,70],["ἡμέραις",28,71],["ταύταις",16,336],["τοὺς",1,56],["λόγους",48,31],["τούτους",16,274],["ἐκ",21,1],["στόματος",123,24],["τῶν",1,76],["προφητῶν",176,77],["ἀφʼ",17,1],["ἧς",24,162],["ἡ