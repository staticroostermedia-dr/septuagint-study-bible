[["1",[["Θέλω",612,149],["γὰρ",40,8],["ὑμᾶς",5,209],["εἰδέναι",10044,107],["ἡλίκον",11140,365],["ἀγῶνα",2302,7],["ἔχω",124,149],["ὑπὲρ",139,1],["ὑμῶν",5,136],["καὶ",2,8],["τῶν",1,76],["ἐν",4,1],["Λαοδικείᾳ",11141,2],["καὶ",2,8],["ὅσοι",103,455],["οὐχ",12,12],["ἑόρακαν",112,400],["τὸ",1,32],["πρόσωπόν",47,33],["μου",9994,146],["ἐν",4,1],["σαρκί",287,2]],"For I desire to have you know how greatly I struggle for you and for those at Laodicea, and for as many as have not seen my face in the flesh;"],["2",[["ἵνα",102,8],["παρακληθῶσιν",434,266],["αἱ",1,185],["καρδίαι",64,180],["αὐτῶν",3,41],["συμβιβασθέντες",2775,243],["ἐν",4,1],["ἀγάπῃ",1982,2],["καὶ",2,8],["εἰς",8,1],["πᾶν",11,29],["πλοῦτος",574,33],["τῆς",1,18],["πληροφορίας",11142,19],["τῆς",1,18],["συνέσεως",469,19],["εἰς",8,1],["ἐπίγνωσιν",3449,10],["τοῦ",1,23],["μυστηρίου",1773,24],["τοῦ",1,30],["θεοῦ",20,21],["Χριστοῦ",1072,21]],"that their hearts may be comforted, they being knit together in love, and gaining all riches of the full assurance of understanding, that they may know the mystery of God, both of the Father and of Christ,"],["3",[["ἐν",4,1],["ᾧ",24,202],["εἰσιν",10,191],["πάντες",11,130],["οἱ",1,128],["θησαυροὶ",579,51],["τῆς",1,18],["σοφίας",242,19],["καὶ",2,8],["γνώσεως",753,19],["ἀπόκρυφοι",1697,130]],"in whom all the treasures of wisdom and knowledge are hidden."],["4",[["τοῦτο",16,122],["λέγω",31,149],["ἵνα",102,8],["μηδεὶς",908,16],["ὑμᾶς",5,209],["παραλογίζηται",2931,782],["ἐν",4,1],["πιθανολογίᾳ",11143,2]],"Now I say this that no one may delude you with persuasiveness of speech."],["5",[["εἰ",77,8],["γὰρ",40,8],["καὶ",2,8],["τῇ",1,95],["σαρκὶ",287,2],["ἄπειμι",2818,149],["ἀλλὰ",108,8],["τῷ",1,52],["πνεύματι",168,53],["σὺν",310,1],["ὑμῖν",5,86],["εἰμι",10,149],["χαίρων",698,67],["καὶ",2,8],["βλέπων",470,67],["ὑμῶν",5,136],["τὴν",1,9],["τάξιν",1744,10],["καὶ",2,8],["τὸ",1,32],["στερέωμα",1479,33],["τῆς",1,18],["εἰς",8,1],["Χριστὸν",1072,7],["πίστεως",887,19],["ὑμῶν",5,136]],"For though I am absent in the flesh, yet I am with you in the spirit, rejoicing and seeing your order, and the steadfastness of your faith in Christ."],["6",[["Ὡς",36,12],["οὖν",227,8],["παρελάβετε",1385,262],["τὸν",1,6],["Χριστὸν",1072,7],["Ἰησοῦν",211,7],["τὸν",1,6],["κύριον",7,7],["ἐν",4,1],["αὐτῷ",3,49],["περιπατεῖτε",1327,307]],"As therefore you received Christ Jesus the Lord, walk in him,"],["7",[["ἐρριζωμένοι",4669,574],["καὶ",2,8],["ἐποικοδομούμενοι",10934,772],["ἐν",4,1],["αὐτῷ",3,49],["καὶ",2,8],["βεβαιούμενοι",4705,772],["τῇ",1,95],["πίστει",887,2],["καθὼς",221,8],["ἐδιδάχθητε",545,353],["περισσεύοντες",3112,137],["ἐν",4,1],["εὐχαριστίᾳ",4230,2]],"rooted and built up in him and established in the faith, even as you were taught, abounding in it in thanksgiving."],["8",[["Βλέπετε",470,307],["μή",25,12],["τις",39,150],["ὑμᾶς",5,209],["ἔσται",10,718],["ὁ",1,4],["συλαγωγῶν",11144,67],["διὰ",56,1],["τῆς",1,18],["φιλοσοφίας",3987,19],["καὶ",2,8],["κενῆς",780,78],["ἀπάτης",9077,19],["κατὰ",32,1],["τὴν",1,9],["παράδοσιν",4960,10],["τῶν",1,76],["ἀνθρώπων",43,77],["κατὰ",32,1],["τὰ",1,42],["στοιχεῖα",6072,43],["τοῦ",1,30],["κόσμου",743,21],["καὶ",2,8],["οὐ",12,12],["κατὰ",32,1],["Χριστόν",1072,7]],"Be careful that you don’t let anyone rob you through his philosophy and vain deceit, after the tradition of men, after the elemental spirits of the world, and not after Christ."],["9",[["ὅτι",19,8],["ἐν",4,1],["αὐτῷ",3,49],["κατοικεῖ",89,87],["πᾶν",11,28],["τὸ",1,27],["πλήρωμα",2185,20],["τῆς",1,18],["θεότητος",11145,19],["σωματικῶς",11146,17]],"For in him all the fullness of the Deity dwells bodily,"],["10",[["καὶ",2,8],["ἐστὲ",10,84],["ἐν",4,1],["αὐτῷ",3,49],["πεπληρωμένοι",518,574],["ὅς",24,246],["ἐστιν",10,87],["ἡ",1,11],["κεφαλὴ",144,13],["πάσης",11,78],["ἀρχῆς",270,19],["καὶ",2,8],["ἐξουσίας",929,19]],"and in him you are made full, who is the head of all principality and power."],["11",[["ἐν",4,1],["ᾧ",24,202],["καὶ",2,8],["περιετμήθητε",1222,353],["περιτομῇ",4357,2],["ἀχειροποιήτῳ",10275,96],["ἐν",4,1],["τῇ",1,95],["ἀπεκδύσει",11147,2],["τοῦ",1,23],["σώματος",454,24],["τῆς",1,18],["σαρκός",287,19],["ἐν",4,1],["τῇ",1,95],["περιτομῇ",4357,2],["τοῦ",1,30],["Χριστοῦ",1072,21]],"In him you were also circumcised with a circumcision not made with hands, in the putting off of the body of the sins of the flesh, in the circumcision of Christ,"],["12",[["συνταφέντες",10854,243],["αὐτῷ",3,49],["ἐν",4,1],["τῷ",1,110],["βαπτισμῷ",10242,113],["ἐν",4,1],["ᾧ",24,202],["καὶ",2,8],["συνηγέρθητε",6109,353],["διὰ",56,1],["τῆς",1,18],["πίστεως",887,19],["τῆς",1,18],["ἐνεργείας",3193,19],["τοῦ",1,30],["θεοῦ",20,21],["τοῦ",1,30],["ἐγείραντος",746,513],["αὐτὸν",3,82],["ἐκ",21,1],["νεκρῶν",659,163]],"having been buried with him in baptism, in which you were also raised with him through faith in the working of God, who raised him from the dead."],["13",[["Καὶ",2,8],["ὑμᾶς",5,209],["νεκροὺς",659,58],["ὄντας",10,229],["ἐν",4,1],["τοῖς",1,91],["παραπτώμασιν",1910,92],["καὶ",2,8],["τῇ",1,95],["ἀκροβυστίᾳ",2132,2],["τῆς",1,18],["σαρκὸς",287,19],["ὑμῶν",5,136],["συνεζωοποίησεν",11079,3],["ὑμᾶς",5,209],["σὺν",310,1],["αὐτῷ",3,49],["χαρισάμενος",6200,770],["ἡμῖν",9994,86],["πάντα",11,65],["τὰ",1,42],["παραπτώματα",1910,43]],"You were dead through your trespasses and the uncircumcision of your flesh. He made you alive together with him, having forgiven us all our trespasses,"],["14",[["ἐξαλείψας",1085,155],["τὸ",1,32],["καθ᾽",32,1],["ἡμῶν",9994,136],["χειρόγραφον",6201,33],["τοῖς",1,91],["δόγμασιν",1958,92],["ὃ",24,677],["ἦν",10,14],["ὑπεναντίον",1177,28],["ἡμῖν",9994,86],["καὶ",2,8],["αὐτὸ",3,121],["ἦρκεν",206,165],["ἐκ",21,1],["τοῦ",1,23],["μέσου",113,88],["προσηλώσας",8096,155],["αὐτὸ",3,121],["τῷ",1,110],["σταυρῷ",10094,113]],"wiping out the handwriting in ordinances which was against us. He has taken it out of the way, nailing it to the cross."],["15",[["ἀπεκδυσάμενος",11148,770],["τὰς",1,39],["ἀρχὰς",270,40],["καὶ",2,8],["τὰς",1,39],["ἐξουσίας",929,40],["ἐδειγμάτισεν",9990,3],["ἐν",4,1],["παρρησίᾳ",2610,2],["θριαμβεύσας",10999,155],["αὐτοὺς",3,60],["ἐν",4,1],["αὐτῷ",3,49]],"Having stripped the principalities and the powers, he made a show of them openly, triumphing over them in it."],["16",[["Μὴ",25,12],["οὖν",227,8],["τις",39,150],["ὑμᾶς",5,209],["κρινέτω",263,35],["ἐν",4,1],["βρώσει",1241,2],["καὶ",2,8],["ἐν",4,1],["πόσει",8199,2],["ἢ",61,8],["ἐν",4,1],["μέρει",471,53],["ἑορτῆς",487,19],["ἢ",61,8],["νεομηνίας",1522,19],["ἢ",61,8],["σαββάτων",442,45]],"Let no one therefore judge you in eating or drinking, or with respect to a feast day or a new moon or a Sabbath day,"],["17",[["ἅ",24,778],["ἐστιν",10,87],["σκιὰ",978,13],["τῶν",1,44],["μελλόντων",1143,80],["τὸ",1,27],["δὲ",14,8],["σῶμα",454,20],["τοῦ",1,30],["Χριστοῦ",1072,21]],"which are a shadow of the things to come; but the body is Christ’s."],["18",[["μηδεὶς",908,16],["ὑμᾶς",5,209],["καταβραβευέτω",11149,35],["θέλων",612,67],["ἐν",4,1],["ταπεινοφροσύνῃ",10715,2],["καὶ",2,8],["θρησκείᾳ",4242,2],["τῶν",1,76],["ἀγγέλων",208,77],["ἃ",24,755],["ἑόρακεν",112,165],["ἐμβατεύων",3731,67],["εἰκῇ",7134,17],["φυσιούμενος",10935,714],["ὑπὸ",122,1],["τοῦ",1,30],["νοὸς",1442,21],["τῆς",1,18],["σαρκὸς",287,19],["αὐτοῦ",3,48]],"Let no one rob you of your prize by self-abasement and worshiping of the angels, dwelling in the things which he has not seen, vainly puffed up by his fleshly mind,"],["19",[["καὶ",2,8],["οὐ",12,12],["κρατῶν",385,67],["τὴν",1,9],["κεφαλὴν",144,10],["ἐξ",21,1],["οὗ",24,367],["πᾶν",11,28],["τὸ",1,27],["σῶμα",454,20],["διὰ",56,1],["τῶν",1,123],["ἁφῶν",761,61],["καὶ",2,8],["συνδέσμων",2638,77],["ἐπιχορηγούμενον",9567,719],["καὶ",2,8],["συμβιβαζόμενον",2775,719],["αὔξει",1180,87],["τὴν",1,9],["αὔξησιν",6837,10],["τοῦ",1,30],["θεοῦ",20,21]],"and not holding firmly to the Head, from whom all the body, being supplied and knit together through the joints and ligaments, grows with God’s growth."],["20",[["Εἰ",77,8],["ἀπεθάνετε",109,262],["σὺν",310,1],["Χριστῷ",1072,113],["ἀπὸ",17,1],["τῶν",1,44],["στοιχείων",6072,45],["τοῦ",1,30],["κόσμου",743,21],["τί",10010,119],["ὡς",36,12],["ζῶντες",107,137],["ἐν",4,1],["κόσμῳ",743,113],["δογματίζεσθε",3818,698]],"If you died with Christ from the elemental spirits of the world, why, as though living in the world, do you subject yourselves to ordinances,"],["21",[["μὴ",25,12],["ἅψῃ",10060,277],["μηδὲ",414,8],["γεύσῃ",1881,938],["μηδὲ",414,8],["θίγῃς",7253,170]],"“Don’t handle, nor taste, nor touch”"],["22",[["ἅ",24,778],["ἐστιν",10,87],["πάντα",11,74],["εἰς",8,1],["φθορὰν",3377,10],["τῇ",1,95],["ἀποχρήσει",11150,2],["κατὰ",32,1],["τὰ",1,42],["ἐντάλματα",4625,43],["καὶ",2,8],["διδασκαλίας",4202,40],["τῶν",1,76],["ἀνθρώπων",43,77]],"(all of which perish with use), according to the precepts and doctrines of men?"],["23",[["ἅτινά",457,778],["ἐστιν",10,87],["λόγον",48,7],["μὲν",281,12],["ἔχοντα",124,289],["σοφίας",242,19],["ἐν",4,1],["ἐθελοθρησκίᾳ",11151,2],["καὶ",2,8],["ταπεινοφροσύνῃ",10715,2],["καὶ",2,8],["ἀφειδίᾳ",11152,2],["σώματος",454,24],["οὐκ",12,12],["ἐν",4,1],["τιμῇ",720,2],["τινι",39,801],["πρὸς",15,1],["πλησμονὴν",1524,10],["τῆς",1,18],["σαρκός",287,19]],"These things indeed appear like wisdom in self-imposed worship, humility, and severity to the body, but aren’t of any value against the indulgence of the flesh."]]