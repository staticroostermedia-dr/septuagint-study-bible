[["1",[["Καὶ",2,8],["ἀπέστειλαν",84,141],["πρὸς",15,1],["αὐτὸν",3,82],["ἀγγέλους",208,31],["λόγοις",48,139],["εἰρηνικοῖς",935,215],["λέγοντες",31,137]],"So they sent ambassadors unto him to treat of peace, saying,"],["2",[["ἰδοὺ",51,17],["ἡμεῖς",6,195],["οἱ",1,128],["παῖδες",127,51],["Ναβουχοδονόσορ",11547,0],["βασιλέως",22,21],["μεγάλου",66,153],["παρακείμεθα",2934,388],["ἐνώπιόν",115,1],["σου",5,146],["χρῆσαι",928,100],["ἡμῖν",6,142],["καθὼς",221,17],["ἀρεστόν",1397,28],["ἐστι",10,87],["τῷ",1,52],["προσώπῳ",47,53],["σου",5,146]],"Behold, we the servants of Nabuchodonosor the great king lie before thee; use us as shall be good in thy sight."],["3",[["Ἰδοὺ",51,17],["αἱ",1,185],["ἐπαύλεις",1173,180],["ἡμῶν",6,41],["καὶ",2,8],["πᾶν",11,29],["πεδίον",349,33],["πυρῶν",926,67],["καὶ",2,8],["τὰ",1,42],["ποίμνια",707,43],["καὶ",2,8],["τὰ",1,42],["βουκόλια",1717,43],["καὶ",2,8],["πᾶσαι",11,187],["αἱ",1,185],["μάνδραι",2368,180],["τῶν",1,123],["σκηνῶν",131,61],["ἡμῶν",6,189],["παράκεινται",2934,299],["πρὸ",238,1],["προσώπου",47,24],["σου",5,146],["χρῆσαι",928,100],["καθʼ",32,1],["ὃ",1,4],["ἂν",83,12],["ἀρέσκῃ",955,166],["σοι",5,151]],"Behold, our houses, and all our places, and all our fields of wheat, and flocks, and herds, and all the lodges of our tents, lie before thy face; use them as it pleaseth thee."],["4",[["Ἰδοὺ",51,17],["καὶ",2,8],["αἱ",1,185],["πόλεις",41,180],["ἡμῶν",6,41],["καὶ",2,8],["οἱ",1,128],["κατοικοῦντες",89,137],["ἐν",4,1],["αὐταῖς",3,194],["δοῦλοί",136,51],["σου",5,146],["εἰσίν",10,191],["ἐλθὼν",55,155],["ἀπάντησον",1024,547],["αὐταῖς",3,194],["ὡς",36,8],["ἔστιν",10,87],["ἀγαθὸν",114,29],["ἐν",4,1],["ὀφθαλμοῖς",91,139],["σου",5,146]],"Behold, even our cities and the inhabitants thereof are thy servants; come and deal with them as seemeth good unto thee."],["5",[["Καὶ",2,8],["παρεγένοντο",377,184],["οἱ",1,128],["ἄνδρες",38,51],["πρὸς",15,1],["Ὀλοφέρνην",0,0],["καὶ",2,8],["ἀπήγγειλαν",273,141],["αὐτῷ",3,49],["κατὰ",32,1],["τὰ",1,42],["ῥήματα",116,43],["τ