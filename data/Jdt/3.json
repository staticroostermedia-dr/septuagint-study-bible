[["1",[["Καὶ",2,8],["ἀπέστειλαν",83,141],["πρὸς",15,1],["αὐτὸν",3,82],["ἀγγέλους",206,31],["λόγοις",48,139],["εἰρηνικοῖς",934,215],["λέγοντες",31,137]],"So they sent ambassadors unto him to treat of peace, saying,"],["2",[["ἰδοὺ",51,17],["ἡμεῖς",6,193],["οἱ",1,128],["παῖδες",126,51],["Ναβουχοδονόσορ",0,0],["βασιλέως",22,21],["μεγάλου",65,153],["παρακείμεθα",2947,393],["ἐνώπιόν",114,1],["σου",5,146],["χρῆσαι",927,100],["ἡμῖν",6,142],["καθὼς",218,17],["ἀρεστόν",1399,28],["ἐστι",10,87],["τῷ",1,52],["προσώπῳ",47,53],["σου",5,146]],"Behold, we the servants of Nabuchodonosor the great king lie before thee; use us as shall be good in thy sight."],["3",[["Ἰδοὺ",51,17],["αἱ",1,183],["ἐπαύλεις",1174,179],["ἡμῶν",6,41],["καὶ",2,8],["πᾶν",11,29],["πεδίον",348,33],["πυρῶν",939,67],["καὶ",2,8],["τὰ",1,42],["ποίμνια",708,43],["καὶ",2,8],["τὰ",1,42],["βουκόλια",1717,43],["καὶ",2,8],["πᾶσαι",11,185],["αἱ",1,183],["μάνδραι",2376,179],["τῶν",1,123],["σκηνῶν",131,61],["ἡμῶν",6,187],["παράκεινται",2947,303],["πρὸ",235,1],["προσώπου",47,24],["σου",5,146],["χρῆσαι",927,100],["καθʼ",32,1],["ὃ",1,4],["ἂν",82,12],["ἀρέσκῃ",957,166],["σοι",5,151]],"Behold, our houses, and all our places, and all our fields of wheat, and flocks, and herds, and all the lodges of our tents, lie before thy face; use them as it pleaseth thee."],["4",[["Ἰδοὺ",51,17],["καὶ",2,8],["αἱ",1,183],["πόλεις",41,179],["ἡμῶν",6,41],["καὶ",2,8],["οἱ",1,128],["κατοικοῦντες",90,137],["ἐν",4,1],["αὐταῖς",3,192],["δοῦλοί",136,51],["σου",5,146],["εἰσίν",10,189],["ἐλθὼν",56,155],["ἀπάντησον",1047,243],["αὐταῖς",3,192],["ὡς",36,8],["ἔστιν",10,87],["ἀγαθὸν",113,29],["ἐν",4,1],["ὀφθαλμοῖς",91,139],["σου",5,146]],"Behold, even our cities and the inhabitants thereof are thy servants; come and deal with them as seemeth good unto thee."],["5",[["Καὶ",2,8],["παρεγένοντο",372,182],["οἱ",1,128],["ἄνδρες",38,51],["πρὸς",15,1],["Ὀλοφέρνην",0,0],["καὶ",2,8],["ἀπήγγειλαν",272,141],["αὐτῷ",3,49],["κατὰ",32,1],["τὰ",1,42],["ῥήματα",115,43],["ταῦτα