,8,1],["ἀπάτην",1291,129],["αὐτοῦ",3,48]],"For she put off the garment of her widowhood for the exaltation of those that were oppressed in Israel, and anointed her face with ointment, and bound her hair in a tire, and took a linen garment to deceive him."],["9",[["Τὸ",1,32],["σανδάλιον",4383,33],["αὐτῆς",3,83],["ἥρπασεν",1214,3],["ὀφθαλμὸν",91,7],["αὐτοῦ",3,48],["καὶ",2,8],["τὸ",1,32],["κάλλος",886,33],["αὐτῆς",3,83],["ᾐχμαλώτισε",2246,3],["ψυχὴν",63,10],["αὐτοῦ",3,48],["διῆλθεν",423,3],["ὁ",1,4],["ἀκινάκης",8776,5],["τὸν",1,6],["τράχηλον",692,7],["αὐτοῦ",3,48]],"Her sandals ravished his eyes, her beauty took his mind prisoner, and the fauchion passed through his neck."],["10",[["Ἔφριξαν",3379,141],["Πέρσαι",868,51],["τὴν",1,9],["τόλμαν",3981,10],["αὐτῆς",3,83],["καὶ",2,8],["Μῆδοι",1761,51],["τὸ",1,32],["θράσος",2260,29],["αὐτῆς",3,83],["ἐῤῥάχθησαν",1178,94]],"The Persians quaked at her boldness, and the Medes were daunted at her hardiness."],["11",[["Τότε",250,17],["ἠλάλαξαν",1984,141],["οἱ",1,128],["ταπεινοί",322,166],["μου",6,48],["καὶ",2,8],["ἐφοβήθησαν",134,94],["οἱ",1,128],["ἀσθενοῦντές",771,137],["μου",6,48],["καὶ",2,8],["ἐπτοήθησαν",1311,94],["ὕψωσαν",331,141],["τὴν",1,9],["φωνὴν",95,10],["αὐτῶν",3,41],["καὶ",2,8],["ἀνετράπησαν",2807,94]],"Then my afflicted shouted for joy, and my weak ones cried aloud; but they were astonished: these lifted up their voices, but they were overthrown."],["12",[["Υἱοὶ",13,51],["κορασίων",1552,45],["κατεκέντησαν",4824,141],["αὐτοὺς",3,60],["καὶ",2,8],["ὡς",36,8],["παῖδας",127,31],["αὐτομολούντων",2865,164],["ἐτίτρωσκον",1917,129],["αὐτούς",3,60],["ἀπώλοντο",217,184],["ἐκ",21,1],["παρατάξεως",843,19],["Κυρίου",7,21],["μου",6,48]],"The sons of the damsels have pierced them through, and wounded them as fugitives' children: they perished by the battle of my Lord."],["13",[["Ὑμνήσω",855,157],["τῷ",1,110],["Θεῷ",20,113],["μου",6,48],["ὕμνον",1498,7],["καινόν",728,59],["Κύριε",7,250],["μέγας",66,16],["εἶ",10,145],["καὶ",2,8],["ἔνδοξος",732,16],["θαυμαστὸς",1073,16],["ἐν",4,1],["ἰσχύϊ",181,2],["ἀνυπέρβλητος",8940,16]],"I will sing unto my God a new song: O Lord, thou art great and glorious, wonderful in strength, and invincible."],["14",[["Σοὶ",5,151],["δουλευσάτω",398,46],["πᾶσα",11,15],["ἡ",1,11],["κτίσις",2263,13],["σου",5,146],["ὅτι",19,8],["εἶπας",18,154],["καὶ",2,8],["ἐγενήθησαν",30,94],["ἀπέστειλας",84,154],["τὸ",1,32],["πνεῦμά",168,33],["σου",5,146],["καὶ",2,8],["ᾠκοδόμησε",126,3],["καὶ",2,8],["οὐκ",12,17],["ἔστιν",10,87],["ὃς",24,246],["ἀντιστήσεται",796,89],["τῇ",1,95],["φωνῇ",95,2],["σου",5,146]],"Let all creatures serve thee: for thou spakest, and they were made: thou didst send forth thy spirit, and it created them, and there is none that can resist thy voice."],["15",[["Ὄρη",87,63],["γὰρ",40,12],["ἐκ",21,1],["θεμελίων",950,77],["σὺν",310,1],["ὕδασι",85,92],["σαλευθήσεται",678,125],["πέτραι",548,180],["δὲ",14,12],["ἀπὸ",17,1],["προσώπου",47,24],["σου",5,146],["ὡς",36,8],["κηρὸς",3069,5],["τακήσονται",1021,135],["ἐπὶ",9,1],["δὲ",14,12],["τοῖς",1,138],["φοβουμένοις",134,342],["σε",5,161],["σὺ",5,156],["εὐιλατεύεις",4773,145],["αὐτοῖς",3,142]],"For the mountains shall be moved from their foundations with the waters, the rocks shall melt as wax at thy presence: yet thou art merciful to them that fear thee."],["16",[["Ὅτι",19,8],["μικρὸν",367,29],["πᾶσα",11,15],["θυσία",156,13],["εἰς",8,1],["ὀσμὴν",684,10],["εὐωδίας",896,40],["καὶ",2,8],["ἐλάχιστον",2418,29],["πᾶν",11,29],["στέαρ",576,33],["εἰς",8,1],["ὁλοκαύτωμά",318,33],["σοι",5,151],["ὁ",1,4],["δὲ",14,12],["φοβούμενος",134,114],["τὸν",1,6],["Κύριον",7,7],["μέγας",66,16],["διαπαντός",510,17]],"For all sacrifice is too little for a sweet savour unto thee, and all the fat is not sufficient for thy burnt offering: but he that feareth the Lord is great at all times."],["17",[["Οὐαὶ",769,316],["ἔθνεσιν",60,92],["ἐπανισταμένοις",1216,343],["τῷ",1,52],["γένει",519,53],["μου",6,48],["Κύριος",7,5],["παντοκράτωρ",340,5],["ἐκδικήσει",539,120],["αὐ