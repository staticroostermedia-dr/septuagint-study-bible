,34]],"And the portico in front of the house, its length in front of the breadth of the house [was] twenty cubits, and its height a hundred and twenty cubits: and he gilded it within with pure gold."],["5",[["Καὶ",2,8],["τὸν",1,6],["οἶκον",34,7],["τὸν",1,6],["μέγαν",66,59],["ἐξύλωσε",4934,3],["ξύλοις",196,92],["κεδρίνοις",1553,90],["καὶ",2,8],["κατεχρύσωσε",2087,3],["χρυσίῳ",202,53],["καθαρῷ",379,34],["καὶ",2,8],["ἔγλυψεν",2339,3],["ἐπʼ",9,1],["αὐτοῦ",3,48],["φοίνικας",1171,31],["καὶ",2,8],["χαλαστά",6195,63]],"And he lined the great house with cedar wood, and gilded it with pure gold, and carved upon it palm-trees and chains."],["6",[["Καὶ",2,8],["ἐκόσμησε",1680,3],["τὸν",1,6],["οἶκον",34,7],["λίθοις",195,139],["τιμίοις",1189,215],["εἰς",8,1],["δόξαν",141,10],["καὶ",2,8],["ἐχρύσωσε",2799,3],["χρυσίῳ",202,53],["χρυσίου",202,24],["τοῦ",1,23],["ἐκ",21,1],["Φαρουΐμ",13887,0]],"And he garnished the house with precious stones for beauty; and he gilded it with gold of the gold from Pharuim."],["7",[["Καὶ",2,8],["ἐχρύσωσε",2799,3],["τὸν",1,6],["οἶκον",34,7],["καὶ",2,8],["τοὺς",1,56],["τοίχους",709,31],["αὐτοῦ",3,48],["καὶ",2,8],["τοὺς",1,56],["πυλῶνας",1596,31],["καὶ",2,8],["τὰ",1,42],["ὀροφώματα",6616,43],["καὶ",2,8],["τὰ",1,42],["θυρώματα",1626,43],["χρυσίῳ",202,53],["καὶ",2,8],["ἔγλυψε",2339,3],["χερουβὶμ",759,105],["ἐπὶ",9,1],["τῶν",1,76],["τοίχων",709,77]],"And he gilded the house, and its [inner] walls, and the door-posts, and the roofs, and the doors with gold; and he carved cherubs on the walls."],["8",[["Καὶ",2,8],["ἐποίησε",23,3],["τὸν",1,6],["οἶκον",34,7],["τοῦ",1,30],["ἁγίου",75,153],["τῶν",1,76],["ἁγίων",75,163],["μῆκος",648,20],["αὐτοῦ",3,48],["ἐπὶ",9,1],["πρόσωπον",47,33],["πλάτος",966,33],["τοῦ",1,30],["οἴκου",34,21],["πήχεων",246,77],["εἴκοσι",279,57],["καὶ",2,8],["τὸ",1,32],["μῆκος",648,33],["πήχεων",246,77],["εἴκοσι",279,57],["καὶ",2,8],["ἐχρύσωσεν",2799,3],["αὐτὸν",3,82],["χρυσίῳ",202,53],["καθαρῷ",379,34],["εἰς",8,1],["χερουβὶμ",759,105],["εἰς",8,1],["