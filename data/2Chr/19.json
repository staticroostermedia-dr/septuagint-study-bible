[["1",[["Καὶ",2,8],["ἐπέστρεψεν",117,3],["Ἰωσαφὰτ",598,105],["βασιλεὺς",22,5],["Ἰούδα",62,21],["εἰς",8,1],["τὸν",1,6],["οἶκον",34,7],["αὐτοῦ",3,48],["εἰς",8,1],["Ἱερουσαλήμ",70,20]],"And Josaphat king of Juda returned to his house at Jerusalem."],["2",[["Καὶ",2,8],["ἐξῆλθεν",82,3],["εἰς",8,1],["ἀπάντησιν",1428,10],["αὐτοῦ",3,48],["Ἰηοὺ",0,0],["ὁ",1,4],["τοῦ",1,30],["Ἀνανὶ",0,0],["ὁ",1,4],["προφήτης",176,5],["καὶ",2,8],["εἶπεν",18,3],["αὐτῷ",3,49],["βασιλεὺς",22,5],["Ἰωσαφὰτ",598,105],["εἰ",77,8],["ἁμαρτωλῷ",409,111],["σὺ",5,156],["βοηθεῖς",553,145],["ἢ",61,8],["μισουμένῳ",351,240],["ὑπὸ",122,1],["Κυρίου",7,21],["φιλιάζεις",3986,145],["διὰ",56,1],["τοῦτο",16,122],["ἐγένετο",30,26],["ἐπὶ",9,1],["σὲ",5,161],["ὀργὴ",198,13],["παρὰ",73,1],["Κυρίου",7,21]],"And there went out to meet him Jeu the prophet the son of Anani, and said to him, King Josaphat, dost thou help a sinner, or act friendly towards one hated of the Lord? Therefore has wrath come upon thee from the Lord."],["3",[["Ὅτι",19,8],["ἀλλʼ",108,17],["ἢ",61,8],["λόγοι",48,51],["ἀγαθοὶ",114,130],["ηὑρέθησαν",101,94],["ἐν",4,1],["σοὶ",5,151],["ὅτι",19,8],["ἐξῇρας",307,154],["τὰ",1,42],["ἄλση",1128,43],["ἀπὸ",17,1],["τῆς",1,18],["γῆς",26,19],["Ἰούδα",62,21],["καὶ",2,8],["κατηύθυνας",827,154],["τὴν",1,9],["καρδίαν",64,10],["σου",5,146],["ἐκζητῆσαι",460,100],["τὸν",1,6],["Κύριον",7,7]],"Nevertheless [some] good things have been found in thee, forasmuch as thou didst remove the groves from the land of Juda, and didst direct thine heart to seek after the Lord."],["4",[["Καὶ",2,8],["κατῴκησεν",89,3],["Ἰωσαφὰτ",598,105],["εἰς",8,1],["Ἱερουσαλήμ",70,20],["καὶ",2,8],["πάλιν",655,17],["ἐξῆλθεν",82,3],["εἰς",8,1],["τὸν",1,6],["λαὸν",35,7],["ἀπὸ",17,1],["Βηρσαβεὲ",0,0],["ἕως",42,8],["ὄρους",87,24],["Ἐφραὶμ",308,105],["καὶ",2,8],["ἐπέστρεψεν",117,3],["αὐτοὺς",3,60],["ἐπὶ",9,1],["Κύριον",7,7],["Θεὸν",20,7],["τῶν",1,76],["πάτερων",44,77],["αὐτῶν",3,41]],"And Josaphat dwelt in Jerusalem: and he again went out among the people from Bersabee to the mount of Ephraim, and turned them back to the Lord God of their fathers."],["5",[["Καὶ",2,8],["κατέστησε",314,3],["τοὺς",1,56],["κριτὰς",749,31],["ἐν",4,1],["πάσαις",11,287],["ταῖς",1,70],["πόλεσιν",41,71],["Ἰούδα",62,21],["ταῖς",1,70],["ὀχυραῖς",854,287],["ἐν",4,1],["πόλει",41,2],["καὶ",2,8],["πόλει",41,2]],"And he appointed judges in all the strong cities of Juda, city by city."],["6",[["Καὶ",2,8],["εἶπε",18,3],["τοῖς",1,138],["κριταῖς",749,139],["ἴδετε",53,69],["τί",39,119],["ὑμεῖς",5,208],["ποιεῖτε",23,307],["ὅτι",19,8],["οὐκ",12,17],["ἀνθρώπῳ",43,113],["ὑμεῖς",5,208],["κρίνετε",263,307],["ἀλλʼ",108,17],["ἢ",61,8],["τῷ",1,110],["Κυρίῳ",7,113],["καὶ",2,8],["μεθʼ",29,1],["ὑμῶν",5,136],["λόγοι",48,51],["τῆς",1,18],["κρίσεως",229,19]],"And he said to the judges, Take good heed what ye do: for ye judge not for man, but for the Lord, and with you are matters of judgment."],["7",[["Καὶ",2,8],["νῦν",90,17],["γενέσθω",30,312],["φόβος",333,5],["Κυρίου",7,21],["ἐφʼ",9,1],["ὑμᾶς",5,209],["καὶ",2,8],["φυλάσσετε",125,84],["καὶ",2,8],["ποιήσατε",23,69],["ὅτι",19,8],["οὐκ",12,17],["ἔστι",10,87],["μετὰ",29,1],["Κυρίου",7,21],["Θεοῦ",20,21],["ἡμῶν",6,41],["ἀδικία",288,13],["οὐδὲ",106,12],["θαυμάσαι",963,100],["πρόσωπον",47,33],["οὐδὲ",106,12],["λαβεῖν",46,100],["δῶρα",348,43]],"And now let the fear of the Lord be upon you, and be wary, and do [your duty]: for there is no unrighteousness with the Lord our God, neither [is it for him] to respect persons, nor to take bribes."],["8",[["Καί",2,8],["γε",353,12],["ἐν",4,1],["Ἱερουσαλὴμ",70,20],["κατέστησεν",314,3],["Ἰωσαφὰτ",598,105],["τῶν",1,76],["ἱερέων",65,77],["καὶ",2,8],["τῶν",1,76],["Λευιτῶν",188,77],["καὶ",2,8],["τῶν",1,76],["πατριαρχῶν",3323,77],["Ἰσραὴλ",27,105],["εἰς",8,1],["κρίσιν",229,10],["Κυρίου",7,21],["καὶ",2,8],["κρίνειν",263,54],["τοὺς",1,56],["κατοικοῦντας",89,229],["ἐν",4,1],["Ἱερουσαλήμ",70,20]],"Moreover Josaphat appointed in Jerusalem some of the priests, and Levites, and heads of houses of Israel, for the judgment of the Lord, and to judge the dwellers in Jerusalem."],["9",[["Καὶ",2,8],["ἐνετείλατο",143,26],["πρὸς",15,1],["αὐτοὺς",3,60],["λέγων",31,67],["οὕτω",71,17],["ποιήσετε",23,348],["ἐν",4,1],["φόβῳ",333,113],["Κυρίου",7,21],["ἐν",4,1],["ἀληθείᾳ",352,2],["καὶ",2,8],["ἐν",4,1],["πλήρει",490,96],["καρδίᾳ",64,2]],"And he charged them, saying, Thus shall ye do in the fear of the Lord, in truth and with a perfect heart."],["10",[["Πᾶς",11,16],["ἀνὴρ",38,5],["κρίσιν",229,10],["τὴν",1,9],["ἐλθοῦσαν",55,405],["ἐφʼ",9,1],["ὑμᾶς",5,209],["τῶν",1,76],["ἀδελφῶν",67,77],["ὑμῶν",5,136],["τῶν",1,76],["κατοικούντων",89,164],["ἐν",4,1],["ταῖς",1,70],["πόλεσιν",41,71],["αὐτῶν",3,41],["ἀναμέσον",215,28],["αἷμα",148,20],["αἵματος",148,24],["καὶ",2,8],["ἀναμέσον",215,28],["τοῦ",1,23],["προστάγματος",393,24],["καὶ",2,8],["ἐντολῆς",259,19],["καὶ",2,8],["δικαιώματα",428,43],["καὶ",2,8],["κρίματα",267,43],["καὶ",2,8],["διαστελεῖσθε",905,117],["αὐτοῖς",3,142],["καὶ",2,8],["οὐχ",12,17],["ἁμαρτήσονται",237,127],["τῷ",1,110],["κυρίῳ",7,113],["καὶ",2,8],["οὐκ",12,17],["ἔσται",10,89],["ὀργὴ",198,13],["ἐφʼ",9,1],["ὑμᾶς",5,209],["καὶ",2,8],["ἐπὶ",9,1],["τοὺς",1,56],["ἀδελφοὺς",67,31],["ὑμῶν",5,136],["οὕτως",71,17],["ποιήσετε",23,348],["καὶ",2,8],["οὐχ",12,17],["ἁμαρτήσεσθε",237,117]],"Whatsoever man of your brethren that dwell in their cities [shall bring] the cause that comes before you, between blood [and] blood, and between precept and commandment, and ordinances and judgments, ye shall even decide for them; so they shall not sin against the Lord, and there shall not be wrath upon you, and upon your brethren: thus ye shall do, and ye shall not sin."],["11",[["Καὶ",2,8],["ἰδοὺ",51,17],["Ἀμαρίας",0,0],["ὁ",1,4],["ἱερεὺς",65,5],["ἡγούμενος",378,406],["ἐφʼ",9,1],["ὑμᾶς",5,209],["εἰς",8,1],["πάντα",11,59],["λόγον",48,7],["Κυρίου",7,21],["καὶ",2,8],["Ζαβδίας",0,0],["υἱὸς",13,5],["Ἰσμαὴλ",0,0],["ὁ",1,4],["ἡγούμενος",378,406],["εἰς",8,1],["οἶκον",34,7],["Ἰούδα",62,21],["πρὸς",15,1],["πάντα