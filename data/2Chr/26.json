,["καὶ",2,8],["εὐώδωσεν",0,0],["αὐτῷ",3,49],["Κύριος",7,5]],"And he sought the Lord in the days of Zacharias, who understood the fear of the Lord; and in his days he sought the Lord, and the Lord prospered him."],["6",[["Καὶ",2,8],["ἐξῆλθε",84,3],["καὶ",2,8],["ἐπολέμησε",304,3],["πρὸς",15,1],["τοὺς",1,56],["ἀλλοφύλους",203,58],["καὶ",2,8],["κατέσπασε",1726,3],["τὰ",1,42],["τείχη",323,43],["Γὲθ",0,0],["καὶ",2,8],["τὰ",1,42],["τείχη",323,43],["Ἰαβνὴρ",0,0],["καὶ",2,8],["τὰ",1,42],["τείχη",323,43],["Ἀζώτου",1531,19],["καὶ",2,8],["ᾠκοδόμησε",125,3],["πόλεις",41,40],["Ἀζώτου",1531,19],["καὶ",2,8],["ἐν",4,1],["τοῖς",1,138],["ἀλλοφύλοις",203,215]],"And he went out and fought against the Philistines, and pulled down the walls of Geth, and the walls of Jabner, and the walls of Azotus, and he built cities [near] Azotus, and among the Philistines."],["7",[["Καὶ",2,8],["κατίσχυσεν",627,3],["αὐτὸν",3,82],["Κύριος",7,5],["ἐπὶ",9,1],["τοὺς",1,56],["ἀλλοφύλους",203,58],["καὶ",2,8],["ἐπὶ",9,1],["τοὺς",1,56],["Ἄραβας",1220,31],["τοὺς",1,56],["κατοικοῦντας",90,229],["ἐπὶ",9,1],["τῆς",1,18],["πέτρας",546,19],["καὶ",2,8],["ἐπὶ",9,1],["τοὺς",1,56],["Μιναίους",2876,58]],"And the Lord strengthened him against the Philistines, and against the Arabians that dwelt on the rock, and against the Minæans."],["8",[["Καὶ",2,8],["ἔδωκαν",33,141],["οἱ",1,128],["Μιναῖοι",2876,130],["δῶρα",347,43],["τῷ",1,110],["Ὀζίᾳ",0,0],["καὶ",2,8],["ἦν",10,14],["τὸ",1,32],["ὄνομα",55,33],["αὐτοῦ",3,48],["ἕως",42,8],["εἰσόδου",1002,19],["Αἰγύπτου",93,19],["ὅτι",19,8],["κατίσχυσεν",627,3],["ἕως",42,8],["ἄνω",1314,17]],"And the Minæans gave gifts to Ozias; and his fame spread as far as the entering in of Egypt, for he strengthened [himself] exceedingly."],["9",[["Καὶ",2,8],["ᾠκοδόμησεν",125,3],["Ὀζίας",1875,105],["πύργους",709,31],["ἐν",4,1],["Ἱερουσαλὴμ",69,20],["καὶ",2,8],["ἐπὶ",9,1],["τὴν",1,9],["πύλην",162,10],["τῆς",1,18],["γωνίας",1376,19],["καὶ",2,8],["ἐπὶ",9,1],["τὴν",1,9],["πύλην",162,10],["τῆς",1,18],["φάραγ