[["1",[["Ἀρχόμεθα",320,608],["πάλιν",655,17],["ἑαυτοὺς",92,60],["συνιστάνειν",1065,54],["ἢ",61,8],["μὴ",25,12],["χρῄζομεν",8703,241],["ὥς",36,12],["τινες",39,402],["συστατικῶν",11001,115],["ἐπιστολῶν",866,61],["πρὸς",15,1],["ὑμᾶς",5,209],["ἢ",61,8],["ἐξ",21,1],["ὑμῶν",5,136]],"Are we beginning again to commend ourselves? Or do we need, as do some, letters of commendation to you or from you?"],["2",[["ἡ",1,11],["ἐπιστολὴ",866,13],["ἡμῶν",9994,136],["ὑμεῖς",5,208],["ἐστε",10,84],["ἐγγεγραμμένη",9256,557],["ἐν",4,1],["ταῖς",1,70],["καρδίαις",64,71],["ἡμῶν",9994,136],["γινωσκομένη",79,761],["καὶ",2,8],["ἀναγινωσκομένη",795,761],["ὑπὸ",122,1],["πάντων",11,163],["ἀνθρώπων",43,77]],"You are our letter, written in our hearts, known and read by all men,"],["3",[["φανερούμενοι",8582,772],["ὅτι",19,8],["ἐστὲ",10,84],["ἐπιστολὴ",866,13],["Χριστοῦ",1072,21],["διακονηθεῖσα",10016,302],["ὑφ᾽",122,1],["ἡμῶν",9994,136],["ἐγγεγραμμένη",9256,557],["οὐ",12,12],["μέλανι",11002,53],["ἀλλὰ",108,8],["πνεύματι",168,53],["θεοῦ",20,21],["ζῶντος",107,143],["οὐκ",12,12],["ἐν",4,1],["πλαξὶν",1330,71],["λιθίναις",1632,287],["ἀλλ᾽",108,8],["ἐν",4,1],["πλαξὶν",1330,71],["καρδίαις",64,71],["σαρκίναις",3968,287]],"being revealed that you are a letter of Christ, served by us, written not with ink, but with the Spirit of the living God; not in tablets of stone, but in tablets that are hearts of flesh."],["4",[["Πεποίθησιν",7924,10],["δὲ",14,8],["τοιαύτην",630,234],["ἔχομεν",124,241],["διὰ",56,1],["τοῦ",1,30],["Χριστοῦ",1072,21],["πρὸς",15,1],["τὸν",1,6],["θεόν",20,7]],"Such confidence we have through Christ toward God,"],["5",[["οὐχ",12,12],["ὅτι",19,8],["ἀφ᾽",17,1],["ἑαυτῶν",92,41],["ἱκανοί",1007,130],["ἐσμεν",10,241],["λογίσασθαί",495,103],["τι",39,119],["ὡς",36,12],["ἐξ",21,1],["ἑαυτῶν",92,41],["ἀλλ᾽",108,8],["ἡ",1,11],["ἱκανότης",11003,13],["ἡμῶν",9994,136],["ἐκ",21,1],["τοῦ",1,30],["θεοῦ",20,21]],"not that we are sufficient of ourselves to account anything as from ourselves; but our sufficiency is from God,"],["6",[["ὃς",24,246],["καὶ",2,8],["ἱκάνωσεν",2429,3],["ἡμᾶς",9994,209],["διακόνους",3263,31],["καινῆς",728,78],["διαθήκης",169,19],["οὐ",12,12],["γράμματος",1668,24],["ἀλλὰ",108,8],["πνεύματος",168,24],["τὸ",1,27],["γὰρ",40,8],["γράμμα",1668,20],["ἀποκτέννει",300,87],["τὸ",1,27],["δὲ",14,8],["πνεῦμα",168,20],["ζῳοποιεῖ",3533,87]],"who also made us sufficient as servants of a new covenant, not of the letter but of the Spirit. For the letter kills, but the Spirit gives life."],["7",[["εἰ",77,8],["δὲ",14,8],["ἡ",1,11],["διακονία",6977,13],["τοῦ",1,30],["θανάτου",170,21],["ἐν",4,1],["γράμμασιν",1668,92],["ἐντετυπωμένη",11004,557],["λίθοις",195,139],["ἐγενήθη",30,715],["ἐν",4,1],["δόξῃ",141,2],["ὥστε",346,8],["μὴ",25,12],["δύνασθαι",185,749],["ἀτενίσαι",5245,100],["τοὺς",1,56],["υἱοὺς",13,31],["Ἰσραὴλ",27,21],["εἰς",8,1],["τὸ",1,32],["πρόσωπον",47,33],["Μωϋσέως",5453,21],["διὰ",56,1],["τὴν",1,9],["δόξαν",141,10],["τοῦ",1,23],["προσώπου",47,24],["αὐτοῦ",3,48],["τὴν",1,9],["καταργουμένην",4259,727]],"But if the service of death, written engraved on stones, came with glory, so that the children of Israel could not look steadfastly on the face of Moses for the glory of his face, which was passing away,"],["8",[["πῶς",10049,12],["οὐχὶ",330,12],["μᾶλλον",1043,17],["ἡ",1,11],["διακονία",6977,13],["τοῦ",1,23],["πνεύματος",168,24],["ἔσται",10,718],["ἐν",4,1],["δόξῃ",141,2]],"won’t service of the Spirit be with much more glory?"],["9",[["εἰ",77,8],["γὰρ",40,8],["τῇ",1,95],["διακονίᾳ",6977,2],["τῆς",1,18],["κατακρίσεως",11005,19],["δόξα",141,13],["πολλῷ",74,34],["μᾶλλον",1043,17],["περισσεύει",3112,87],["ἡ",1,11],["διακονία",6977,13],["τῆς",1,18],["δικαιοσύνης",187,19],["δόξῃ",141,2]],"For if the service of condemnation has glory, the service of righteousness exceeds much more in glory."],["10",[["καὶ",2,8],["γὰρ",40,8],["οὐ",12,12],["δεδόξασται",452,722],["τὸ",1,27],["δεδοξασμένον",452,773],["ἐν",4,1],["τούτῳ",16,279],["τῷ",1,52],["μέρει",471,53],["εἵνεκεν",447,1],["τῆς",1,18],["ὑπερβαλλούσης",3770,212],["δόξης",141,19]],"For most certainly that which has been made glorious has not been made glorious in this respect, by reason of the glory that surpasses."],["11",[["εἰ",77,8],["γὰρ",40,8],["τὸ",1,27],["καταργούμενον",4259,719],["διὰ",56,1],["δόξης",141,19],["πολλῷ",74,34],["μᾶλλον",1043,17],["τὸ",1,27],["μένον",681,36],["ἐν",4,1],["δόξῃ",141,2]],"For if that which passes away was with glory, much more that which remains is in glory."],["12",[["Ἔχοντες",124,137],["οὖν",227,8],["τοιαύτην",630,234],["ἐλπίδα",530,10],["πολλῇ",74,96],["παρρησίᾳ",2610,2],["χρώμεθα",928,800]],"Having therefore such a hope, we use great boldness of speech,"],["13",[["καὶ",2,8],["οὐ",12,12],["καθάπερ",690,8],["Μωϋσῆς",5453,5],["ἐτίθει",110,14],["κάλυμμα",1963,33],["ἐπὶ",9,1],["τὸ",1,32],["πρόσωπον",47,33],["αὐτοῦ",3,48],["πρὸς",15,1],["τὸ",1,32],["μὴ",25,12],["ἀτενίσαι",5245,100],["τοὺς",1,56],["υἱοὺς",13,31],["Ἰσραὴλ",27,21],["εἰς",8,1],["τὸ",1,32],["τέλος",373,33],["τοῦ",1,23],["καταργουμένου",4259,883]],"and not as Moses, who put a veil on his face so that the children of Israel wouldn’t look steadfastly on the end of that which was passing away."],["14",[["ἀλλ᾽",108,8],["ἐπωρώθη",8183,38],["τὰ",1,253],["νοήματα",5867,63],["αὐτῶν",3,41],["ἄχρι",4062,1],["γὰρ",40,8],["τῆς",1,18],["σήμερον",205,17],["ἡμέρας",28,19],["τὸ",1,27],["αὐτὸ",3,359],["κάλυμμα",1963,20],["ἐπὶ",9,1],["τῇ",1,95],["ἀναγνώσει",4512,2],["τῆς",1,18],["παλαιᾶς",1905,78],["διαθήκης",169,19],["μένει",681,87],["μὴ",25,12],["ἀνακαλυπτόμενον",1848,719],["ὅτι",19,8],["ἐν",4,1],["Χριστῷ",1072,113],["καταργεῖται",4259,449]],"But their minds were hardened, for until this very day at the reading of the old covenant the same veil remains, because in Christ it passes away."],["15",[["ἀλλ᾽",108,8],["ἕως",42,1],["σήμερον",205,17],["ἡνίκα",543,8],["ἂν",83,12],["ἀναγινώσκηται",795,594],["Μωϋσῆς",5453,5],["κάλυμμα",1963,20],["ἐπὶ",9,1],["τὴν",1,9],["καρδίαν",64,10],["αὐτῶν",3,41],["κεῖται",1731,728]],"But to this day, when Moses is read, a veil lies on their heart."],["16",[["ἡνίκα",543,8],["δὲ",14,8],["ἐὰν",45,8],["ἐπιστρέψῃ",117,160],["πρὸς",15,1],["κύριον",7,7],["περιαιρεῖται",863,449],["τὸ",1,27],["κάλυμμα",1963,20]],"But whenever someone turns to the Lord, the veil is taken away."],["17",[["ὁ",1,4],["δὲ",14,8],["κύριος",7,5],["τὸ",1,27],["πνεῦμά",168,20],["ἐστιν",10,87],["οὗ",120,17],["δὲ",14,8],["τὸ",1,27],["πνεῦμα",168,20],["κυρίου",7,21],["ἐλευθερία",3427,13]],"Now the Lord is the Spirit; and where the Spirit of the Lord is, there is liberty."],["18",[["ἡμεῖς",9994,208],["δὲ",14,8],["πάντες",11,130],["ἀνακεκαλυμμένῳ",1848,932],["προσώπῳ",47,53],["τὴν",1,9],["δόξαν",141,10],["κυρίου",7,21],["κατοπτριζόμενοι",11006,520],["τὴν",1,9],["αὐτὴν",3,98],["εἰκόνα",1136,10],["μεταμορφούμεθα",10138,885],["ἀπὸ",17,1],["δόξης",141,19],["εἰς",8,1],["δόξαν",141,10],["καθάπερ",690,8],["ἀπὸ",17,1],["κυρίου",7,21],["πνεύματος",168,24]],"But we all, with unveiled face seeing the glory of the Lord as in a mirror, are transformed into the same image from glory to glory, even as from the Lord, the Spirit."]]