[["1",[["Παῦλος",10586,5],["ἀπόστολος",10080,5],["Χριστοῦ",1072,21],["Ἰησοῦ",211,21],["διὰ",56,1],["θελήματος",1039,24],["θεοῦ",20,21],["καὶ",2,8],["Τιμόθεος",1953,5],["ὁ",1,4],["ἀδελφὸς",67,5],["τῇ",1,95],["ἐκκλησίᾳ",563,2],["τοῦ",1,30],["θεοῦ",20,21],["τῇ",1,95],["οὔσῃ",10,210],["ἐν",4,1],["Κορίνθῳ",10657,2],["σὺν",310,1],["τοῖς",1,138],["ἁγίοις",75,215],["πᾶσιν",11,215],["τοῖς",1,138],["οὖσιν",10,352],["ἐν",4,1],["ὅλῃ",235,96],["τῇ",1,95],["Ἀχαΐᾳ",9249,2]],"Paul, an apostle of Christ Jesus through the will of God, and Timothy our brother, to the assembly of God which is at Corinth, with all the saints who are in the whole of Achaia:"],["2",[["χάρις",368,13],["ὑμῖν",5,86],["καὶ",2,8],["εἰρήνη",213,13],["ἀπὸ",17,1],["θεοῦ",20,21],["πατρὸς",44,21],["ἡμῶν",9994,136],["καὶ",2,8],["κυρίου",7,21],["Ἰησοῦ",211,21],["Χριστοῦ",1072,21]],"Grace to you and peace from God our Father and the Lord Jesus Christ."],["3",[["Εὐλογητὸς",767,16],["ὁ",1,4],["θεὸς",20,5],["καὶ",2,8],["πατὴρ",44,5],["τοῦ",1,30],["κυρίου",7,21],["ἡμῶν",9994,136],["Ἰησοῦ",211,21],["Χριστοῦ",1072,21],["ὁ",1,4],["πατὴρ",44,5],["τῶν",1,76],["οἰκτιρμῶν",1187,77],["καὶ",2,8],["θεὸς",20,5],["πάσης",11,78],["παρακλήσεως",2183,19]],"Blessed be the God and Father of our Lord Jesus Christ, the Father of mercies and God of all comfort,"],["4",[["ὁ",1,4],["παρακαλῶν",434,67],["ἡμᾶς",9994,209],["ἐπὶ",9,1],["πάσῃ",11,96],["τῇ",1,95],["θλίψει",438,2],["ἡμῶν",9994,136],["εἰς",8,1],["τὸ",1,32],["δύνασθαι",185,749],["ἡμᾶς",9994,209],["παρακαλεῖν",434,54],["τοὺς",1,56],["ἐν",4,1],["πάσῃ",11,96],["θλίψει",438,2],["διὰ",56,1],["τῆς",1,18],["παρακλήσεως",2183,19],["ἧς",24,162],["παρακαλούμεθα",434,885],["αὐτοὶ",3,195],["ὑπὸ",122,1],["τοῦ",1,30],["θεοῦ",20,21]],"who comforts us in all our affliction, that we may be able to comfort those who are in any affliction, through the comfort with which we ourselves are comforted by God."],["5",[["ὅτι",19,8],["καθὼς",221,8],["περισσεύει",3112,87],["τὰ",1,253],["παθήματα",10857,63],["τοῦ",1,30],["Χριστοῦ",1072,21],["εἰς",8,1],["ἡμᾶς",9994,209],["οὕτως",71,17],["διὰ",56,1],["τοῦ",1,30],["Χριστοῦ",1072,21],["περισσεύει",3112,87],["καὶ",2,8],["ἡ",1,11],["παράκλησις",2183,13],["ἡμῶν",9994,136]],"For as the sufferings of Christ abound to us, even so our comfort also abounds through Christ."],["6",[["εἴτε",2713,8],["δὲ",14,8],["θλιβόμεθα",601,885],["ὑπὲρ",139,1],["τῆς",1,18],["ὑμῶν",5,136],["παρακλήσεως",2183,19],["καὶ",2,8],["σωτηρίας",425,19],["εἴτε",2713,8],["παρακαλούμεθα",434,885],["ὑπὲρ",139,1],["τῆς",1,18],["ὑμῶν",5,136],["παρακλήσεως",2183,19],["τῆς",1,18],["ἐνεργουμένης",3432,929],["ἐν",4,1],["ὑπομονῇ",1616,2],["τῶν",1,44],["αὐτῶν",3,168],["παθημάτων",10857,45],["ὧν",24,97],["καὶ",2,8],["ἡμεῖς",9994,208],["πάσχομεν",1972,241]],"But if we are afflicted, it is for your comfort and salvation. If we are comforted, it is for your comfort, which produces in you the patient enduring of the same sufferings which we also suffer."],["7",[["καὶ",2,8],["ἡ",1,11],["ἐλπὶς",530,13],["ἡμῶν",9994,136],["βεβαία",3796,15],["ὑπὲρ",139,1],["ὑμῶν",5,136],["εἰδότες",1168,263],["ὅτι",19,8],["ὡς",36,12],["κοινωνοί",3562,51],["ἐστε",10,84],["τῶν",1,44],["παθημάτων",10857,45],["οὕτως",71,17],["καὶ",2,8],["τῆς",1,18],["παρακλήσεως",2183,19]],"Our hope for you is steadfast, knowing that, since you are partakers of the sufferings, so you are also of the comfort."],["8",[["Οὐ",12,12],["γὰρ",40,8],["θέλομεν",612,241],["ὑμᾶς",5,209],["ἀγνοεῖν",1846,54],["ἀδελφοί",67,396],["ὑπὲρ",139,1],["τῆς",1,18],["θλίψεως",438,19],["ἡμῶν",9994,136],["τῆς",1,18],["γενομένης",30,760],["ἐν",4,1],["τῇ",1,95],["Ἀσίᾳ",3180,2],["ὅτι",19,8],["καθ᾽",32,1],["ὑπερβολὴν",9878,10],["ὑπὲρ",139,1],["δύναμιν",98,10],["ἐβαρήθημεν",6847,491],["ὥστε",346,8],["ἐξαπορηθῆναι",9431,175],["ἡμᾶς",9994,209],["καὶ",2,8],["τοῦ",1,23],["ζῆν",107,54]],"For we don’t desire to have you uninformed, brothers, concerning our affliction which happened to us in Asia: that we were weighed down exceedingly, beyond our power, so much that we despaired even of life."],["9",[["ἀλλ᾽",108,8],["αὐτοὶ",3,195],["ἐν",4,1],["ἑαυτοῖς",92,142],["τὸ",1,32],["ἀπόκριμα",10993,33],["τοῦ",1,30],["θανάτου",170,21],["ἐσχήκαμεν",124,311],["ἵνα",102,8],["μὴ",25,12],["πεποιθότες",344,263],["ὦμεν",10,223],["ἐφ᾽",9,1],["ἑαυτοῖς",92,142],["ἀλλ᾽",108,8],["ἐπὶ",9,1],["τῷ",1,110],["θεῷ",20,113],["τῷ",1,110],["ἐγείροντι",746,390],["τοὺς",1,56],["νεκρούς",659,58]],"Yes, we ourselves have had the sentence of death within ourselves, that we should not trust in ourselves, but in God who raises the dead,"],["10",[["ὃς",24,246],["ἐκ",21,1],["τηλικούτου",5103,126],["θανάτου",170,21],["ἐρρύσατο",337,930],["ἡμᾶς",9994,209],["καὶ",2,8],["ῥύσεται",337,718],["εἰς",8,1],["ὃν",24,106],["ἠλπίκαμεν",514,311],["ὅτι",19,8],["καὶ",2,8],["ἔτι",111,17],["ῥύσεται",337,718]],"who delivered us out of so great a death, and does deliver, on whom we have set our hope that he will also still deliver us,"],["11",[["συνυπουργούντων",10994,164],["καὶ",2,8],["ὑμῶν",5,136],["ὑπὲρ",139,1],["ἡμῶν",9994,136],["τῇ",1,95],["δεήσει",677,2],["ἵνα",102,8],["ἐκ",21,1],["πολλῶν",74,79],["προσώπων",47,45],["τὸ",1,27],["εἰς",8,1],["ἡμᾶς",9994,209],["χάρισμα",10814,20],["διὰ",56,1],["πολλῶν",74,163],["εὐχαριστηθῇ",3831,333],["ὑπὲρ",139,1],["ἡμῶν",9994,136]],"you also helping together on our behalf by your supplication; that, for the gift given to us by means of many, thanks may be given by many persons on your behalf."],["12",[["ἡ",1,11],["γὰρ",40,8],["καύχησις",2730,13],["ἡμῶν",9994,136],["αὕτη",16,101],["ἐστίν",10,87],["τὸ",1,27],["μαρτύριον",225,20],["τῆς",1,18],["συνειδήσεως",6118,19],["ἡμῶν",9994,136],["ὅτι",19,8],["ἐν",4,1],["ἁπλότητι",3717,2],["καὶ",2,8],["εἰλικρινείᾳ",10943,2],["τοῦ",1,30],["θεοῦ",20,21],["καὶ",2,8],["οὐκ",12,12],["ἐν",4,1],["σοφίᾳ",242,2],["σαρκικῇ",10902,96],["ἀλλ᾽",108,8],["ἐν",4,1],["χάριτι",368,2],["θεοῦ",20,21],["ἀνεστράφημεν",522,491],["ἐν",4,1],["τῷ",1,110],["κόσμῳ",743,113],["περισσοτέρως",10995,17],["δὲ",14,8],["πρὸς",15,1],["ὑμᾶς",5,209]],"For our boasting is this: the testimony of our conscience that in holiness and sincerity of God, not in fleshly wisdom but in the grace of God, we behaved ourselves in the world, and more abundantly toward you."],["13",[["οὐ",12,12],["γὰρ",40,8],["ἄλλα",584,65],["γράφομεν",186,241],["ὑμῖν",5,86],["ἀλλ᾽",108,8],["ἢ",61,8],["ἃ",24,755],["ἀναγινώσκετε",795,84],["ἢ",61,8],["καὶ",2,8],["ἐπιγινώσκετε",431,84],["ἐλπίζω",514,149],["δὲ",14,8],["ὅτι",19,8],["ἕως",42,1],["τέλους",373,24],["ἐπιγνώσεσθε",431,747]],"For we write no other things to you than what you read or even acknowledge, and I hope you will acknowledge to the end—"],["14",[["καθὼς",221,8],["καὶ",2,8],["ἐπέγνωτε",431,262],["ἡμᾶς",9994,209],["ἀπὸ",17,1],["μέρους",471,24],["ὅτι",19,8],["καύχημα",1627,20],["ὑμῶν",5,136],["ἐσμεν",10,241],["καθάπερ",690,8],["καὶ",2,8],["ὑμεῖς",5,208],["ἡμῶν",9994,136],["ἐν",4,1],["τῇ",1,95],["ἡμέρᾳ",28,2],["τοῦ",1,30],["κυρίου",7,21],["ἡμῶν",9994,136],["Ἰησοῦ",211,21]],"as also you acknowledged us in part—that we are your boasting, even as you also are ours, in the day of our Lord Jesus."],["15",[["Καὶ",2,8],["ταύτῃ",16,200],["τῇ",1,95],["πεποιθήσει",7924,2],["ἐβουλόμην",463,816],["πρότερον",496,29],["πρὸς",15,1],["ὑμᾶς",5,209],["ἐλθεῖν",55,100],["ἵνα",102,8],["δευτέραν",271,37],["χάριν",368,10],["σχῆτε",124,118]],"In this confidence, I was determined to come first to you, that you might have a second benefit,"],["16",[["καὶ",2,8],["δι᾽",56,1],["ὑμῶν",5,136],["διελθεῖν",423,100],["εἰς",8,1],["Μακεδονίαν",10620,10],["καὶ",2,8],["πάλιν",655,17],["ἀπὸ",17,1],["Μακεδονίας",10620,19],["ἐλθεῖν",55,100],["πρὸς",15,1],["ὑμᾶς",5,209],["καὶ",2,8],["ὑφ᾽",122,1],["ὑμῶν",5,136],["προπεμφθῆναι",3931,175],["εἰς",8,1],["τὴν",1,9],["Ἰουδαίαν",492,10]],"and by you to pass into Macedonia, and again from Macedonia to come to you, and to be sent forward by you on my journey to Judea."],["17",[["τοῦτο",16,122],["οὖν",227,8],["βουλόμενος",463,723],["μήτι",10058,12],["ἄρα",985,8],["τῇ",1,95],["ἐλαφρίᾳ",10996,2],["ἐχρησάμην",928,820],["ἢ",61,8],["ἃ",24,755],["βουλεύομαι",641,768],["κατὰ",32,1],["σάρκα",287,10],["βουλεύομαι",641,768],["ἵνα",102,8],["ᾖ",10,173],["παρ᾽",73,1],["ἐμοὶ",6,151],["τὸ",1,27],["ναὶ",3597,12],["ναὶ",3597,12],["καὶ",2,8],["τὸ",1,27],["οὒ",12,12],["οὔ",12,12]],"When I therefore planned this, did I show fickleness? Or the things that I plan, do I plan according to the flesh, that with me there should be the “Yes, yes” and the “No, no?”"],["18",[["πιστὸς",750,16],["δὲ",14,8],["ὁ",1,4],["θεός",20,5],["ὅτι",19,8],["ὁ",1,4],["λόγος",48,5],["ἡμῶν",9994,136],["ὁ",1,4],["πρὸς",15,1],["ὑμᾶς",5,209],["οὐκ",12,12],["ἔστιν",10,87],["ναὶ",3597,12],["καὶ",2,8],["οὔ",12,12]],"But as God is faithful, our word toward you was not “Yes and no.”"],["19",[["ὁ",1,4],["τοῦ",1,30],["θεοῦ",20,21],["γὰρ",40,8],["υἱὸς",13,5],["Ἰησοῦς",211,5],["Χριστὸς",1072,5],["ὁ",1,4],["ἐν",4,1],["ὑμῖν",5,86],["δι᾽",56,1],["ἡμῶν",9994,136],["κηρυχθείς",1438,206],["δι᾽",56,1],["ἐμοῦ",6,88],["καὶ",2,8],["Σιλουανοῦ",10997,21],["καὶ",2,8],["Τιμοθέου",1953,21],["οὐκ",12,12],["ἐγένετο",30,737],["ναὶ",3597,12],["καὶ",2,8],["οὒ",12,12],["ἀλλὰ",108,8],["ναὶ",3597,12],["ἐν",4,1],["αὐτῷ",3,49],["γέγονεν",30,165]],"For the Son of God, Jesus Christ, who was preached among you by us—by me, Silvanus, and Timothy—was not “Yes and no,” but in him is “Yes.”"],["20",[["ὅσαι",103,553],["γὰρ",40,8],["ἐπαγγελίαι",3439,180],["θεοῦ",20,21],["ἐν",4,1],["αὐτῷ",3,49],["τὸ",1,27],["ναί",3597,12],["διὸ",1466,8],["καὶ",2,8],["δι᾽",56,1],["αὐτοῦ",3,48],["τὸ",1,27],["ἀμὴν",3161,316],["τῷ",1,110],["θεῷ",20,113],["πρὸς",15,1],["δόξαν",141,10],["δι᾽",56,1],["ἡμῶν",9994,136]],"For however many are the promises of God, in him is the “Yes.” Therefore also through him is the “Amen”, to the glory of God through us."],["21",[["ὁ",1,4],["δὲ",14,8],["βεβαιῶν",4705,67],["ἡμᾶς",9994,209],["σὺν",310,1],["ὑμῖν",5,86],["εἰς",8,1],["Χριστὸν",1072,7],["καὶ",2,8],["χρίσας",712,155],["ἡμᾶς",9994,209],["θεός",20,5]],"Now he who establishes us with you in Christ and anointed us is God,"],["22",[["ὁ",1,4],["καὶ",2,8],["σφραγισάμενος",1480,244],["ἡμᾶς",9994,209],["καὶ",2,8],["δοὺς",33,155],["τὸν",1,6],["ἀρραβῶνα",5235,7],["τοῦ",1,23],["πνεύματος",168,24],["ἐν",4,1],["ταῖς",1,70],["καρδίαις",64,71],["ἡμῶν",9994,136]],"who also sealed us and gave us the down payment of the Spirit in our hearts."],["23",[["Ἐγὼ",6,156],["δὲ",14,8],["μάρτυρα",875,7],["τὸν",1,6],["θεὸν",20,7],["ἐπικαλοῦμαι",341,700],["ἐπὶ",9,1],["τὴν",1,9],["ἐμὴν",10146,37],["ψυχὴν",63,10],["ὅτι",19,8],["φειδόμενος",610,723],["ὑμῶν",5,136],["οὐκέτι",12,17],["ἦλθον",55,147],["εἰς",8,1],["Κόρινθον",10657,10]],"But I call God for a witness to my soul, that to spare you, I didn’t come to Corinth."],["24",[["οὐχ",12,12],["ὅτι",19,8],["κυριεύομεν",885,241],["ὑμῶν",5,136],["τῆς",1,18],["πίστεως",887,19],["ἀλλὰ",108,8],["συνεργοί",6116,130],["ἐσμεν",10,241],["τῆς",1,18],["χαρᾶς",1125,19],["ὑμῶν",5,136],["τῇ",1,95],["γὰρ",40,8],["πίστει",887,2],["ἑστήκατε",78,330]],"We don’t control your faith, but are fellow workers with you for your joy. For you stand firm in faith."]]