[["1",[["Ἔκρινα",263,147],["γὰρ",40,8],["ἐμαυτῷ",10062,49],["τοῦτο",16,122],["τὸ",1,32],["μὴ",25,12],["πάλιν",655,17],["ἐν",4,1],["λύπῃ",1075,2],["πρὸς",15,1],["ὑμᾶς",5,209],["ἐλθεῖν",55,100]],"But I determined this for myself, that I would not come to you again in sorrow."],["2",[["εἰ",77,8],["γὰρ",40,8],["ἐγὼ",6,156],["λυπῶ",936,149],["ὑμᾶς",5,209],["καὶ",2,8],["τίς",10010,150],["ὁ",1,4],["εὐφραίνων",244,67],["με",9994,161],["εἰ",77,8],["μὴ",25,12],["ὁ",1,4],["λυπούμενος",936,714],["ἐξ",21,1],["ἐμοῦ",6,88]],"For if I make you grieve, then who will make me glad but he who is made to grieve by me?"],["3",[["καὶ",2,8],["ἔγραψα",186,147],["τοῦτο",16,122],["αὐτό",3,121],["ἵνα",102,8],["μὴ",25,12],["ἐλθὼν",55,155],["λύπην",1075,10],["σχῶ",124,227],["ἀφ᾽",17,1],["ὧν",24,303],["ἔδει",1158,14],["με",9994,161],["χαίρειν",698,54],["πεποιθὼς",344,264],["ἐπὶ",9,1],["πάντας",11,58],["ὑμᾶς",5,209],["ὅτι",19,8],["ἡ",1,11],["ἐμὴ",10146,15],["χαρὰ",1125,13],["πάντων",11,163],["ὑμῶν",5,136],["ἐστιν",10,87]],"And I wrote this very thing to you, so that when I came, I wouldn’t have sorrow from them of whom I ought to rejoice; having confidence in you all that my joy would be shared by all of you."],["4",[["ἐκ",21,1],["γὰρ",40,8],["πολλῆς",74,78],["θλίψεως",438,19],["καὶ",2,8],["συνοχῆς",4416,19],["καρδίας",64,19],["ἔγραψα",186,147],["ὑμῖν",5,86],["διὰ",56,1],["πολλῶν",74,79],["δακρύων",1268,45],["οὐχ",12,12],["ἵνα",102,8],["λυπηθῆτε",936,485],["ἀλλὰ",108,8],["τὴν",1,9],["ἀγάπην",1982,10],["ἵνα",102,8],["γνῶτε",79,118],["ἣν",24,124],["ἔχω",124,149],["περισσοτέρως",10995,17],["εἰς",8,1],["ὑμᾶς",5,209]],"For out of much affliction and anguish of heart I wrote to you with many tears, not that you should be made to grieve, but that you might know the love that I have so abundantly for you."],["5",[["Εἰ",77,8],["δέ",14,8],["τις",39,150],["λελύπηκεν",936,165],["οὐκ",12,12],["ἐμὲ",6,161],["λελύπηκεν",936,165],["ἀλλ᾽",108,8],["ἀπὸ",17,1],["μέρους",471,24],["ἵνα",102,8],["μὴ",25,12],["ἐπιβαρῶ",10998,592],["πάντας",11,58],["ὑμᾶς",5,209]],"But if any has caused sorrow, he has caused sorrow not to me, but in part (that I not press too heavily) to you all."],["6",[["ἱκανὸν",1007,28],["τῷ",1,110],["τοιούτῳ",630,286],["ἡ",1,11],["ἐπιτιμία",9560,13],["αὕτη",16,101],["ἡ",1,11],["ὑπὸ",122,1],["τῶν",1,76],["πλειόνων",938,163]],"This punishment which was inflicted by the many is sufficient for such a one;"],["7",[["ὥστε",346,8],["τοὐναντίον",8537,17],["μᾶλλον",1043,17],["ὑμᾶς",5,209],["χαρίσασθαι",6200,776],["καὶ",2,8],["παρακαλέσαι",434,100],["μή",25,12],["πως",441,12],["τῇ",1,95],["περισσοτέρᾳ",10264,96],["λύπῃ",1075,2],["καταποθῇ",1183,333],["ὁ",1,4],["τοιοῦτος",630,112]],"so that, on the contrary, you should rather forgive him and comfort him, lest by any means such a one should be swallowed up with his excessive sorrow."],["8",[["διὸ",1466,8],["παρακαλῶ",434,149],["ὑμᾶς",5,209],["κυρῶσαι",1516,100],["εἰς",8,1],["αὐτὸν",3,82],["ἀγάπην",1982,10]],"Therefore I beg you to confirm your love toward him."],["9",[["εἰς",8,1],["τοῦτο",16,122],["γὰρ",40,8],["καὶ",2,8],["ἔγραψα",186,147],["ἵνα",102,8],["γνῶ",79,227],["τὴν",1,9],["δοκιμὴν",10846,10],["ὑμῶν",5,136],["εἰ",77,8],["εἰς",8,1],["πάντα",11,65],["ὑπήκοοί",4141,130],["ἐστε",10,84]],"For to this end I also wrote, that I might know the proof of you, whether you are obedient in all things."],["10",[["ᾧ",24,202],["δέ",14,8],["τι",39,119],["χαρίζεσθε",6200,754],["κἀγώ",10000,8],["καὶ",2,8],["γὰρ",40,8],["ἐγὼ",6,156],["ὃ",24,467],["κεχάρισμαι",6200,869],["εἴ",77,8],["τι",39,119],["κεχάρισμαι",6200,869],["δι᾽",56,1],["ὑμᾶς",5,209],["ἐν",4,1],["προσώπῳ",47,53],["Χριστοῦ",1072,21]],"Now I also forgive whomever you forgive anything. For if indeed I have forgiven anything, I have forgiven that one for your sakes in the presence of Christ,"],["11",[["ἵνα",102,8],["μὴ",25,12],["πλεονεκτηθῶμεν",4988,282],["ὑπὸ",122,1],["τοῦ",1,30],["σατανᾶ",6785,21],["οὐ",12,12],["γὰρ",40,8],["αὐτοῦ",3,48],["τὰ",1,42],["νοήματα",5867,43],["ἀγνοοῦμεν",1846,241]],"that no advantage may be gained over us by Satan, for we are not ignorant of his schemes."],["12",[["Ἐλθὼν",55,155],["δὲ",14,8],["εἰς",8,1],["τὴν",1,9],["Τρῳάδα",10619,10],["εἰς",8,1],["τὸ",1,32],["εὐαγγέλιον",4222,33],["τοῦ",1,30],["Χριστοῦ",1072,21],["καὶ",2,8],["θύρας",277,19],["μοι",9994,151],["ἀνεῳγμένης",362,931],["ἐν",4,1],["κυρίῳ",7,113]],"Now when I came to Troas for the Good News of Christ, and when a door was opened to me in the Lord,"],["13",[["οὐκ",12,12],["ἔσχηκα",124,85],["ἄνεσιν",3721,10],["τῷ",1,52],["πνεύματί",168,53],["μου",9994,146],["τῷ",1,52],["μὴ",25,12],["εὑρεῖν",101,100],["με",9994,161],["Τίτον",6801,7],["τὸν",1,6],["ἀδελφόν",67,7],["μου",9994,146],["ἀλλ᾽",108,8],["ἀποταξάμενος",4040,244],["αὐτοῖς",3,142],["ἐξῆλθον",82,147],["εἰς",8,1],["Μακεδονίαν",10620,10]],"I had no relief for my spirit, because I didn’t find Titus my brother, but taking my leave of them, I went out into Macedonia."],["14",[["Τῷ",1,110],["δὲ",14,8],["θεῷ",20,113],["χάρις",368,13],["τῷ",1,110],["πάντοτε",6027,17],["θριαμβεύοντι",10999,390],["ἡμᾶς",9994,209],["ἐν",4,1],["τῷ",1,110],["Χριστῷ",1072,113],["καὶ",2,8],["τὴν",1,9],["ὀσμὴν",684,10],["τῆς",1,18],["γνώσεως",753,19],["αὐτοῦ",3,48],["φανεροῦντι",8582,390],["δι᾽",56,1],["ἡμῶν",9994,136],["ἐν",4,1],["παντὶ",11,111],["τόπῳ",99,113]],"Now thanks be to God who always leads us in triumph in Christ, and reveals through us the sweet aroma of his knowledge in every place."],["15",[["ὅτι",19,8],["Χριστοῦ",1072,21],["εὐωδία",896,13],["ἐσμὲν",10,241],["τῷ",1,110],["θεῷ",20,113],["ἐν",4,1],["τοῖς",1,138],["σῳζομένοις",172,915],["καὶ",2,8],["ἐν",4,1],["τοῖς",1,138],["ἀπολλυμένοις",596,342]],"For we are a sweet aroma of Christ to God in those who are being saved and in those who perish:"],["16",[["οἷς",24,292],["μὲν",281,12],["ὀσμὴ",684,13],["ἐκ",21,1],["θανάτου",170,21],["εἰς",8,1],["θάνατον",170,7],["οἷς",24,292],["δὲ",14,8],["ὀσμὴ",684,13],["ἐκ",21,1],["ζωῆς",216,19],["εἰς",8,1],["ζωήν",216,10],["καὶ",2,8],["πρὸς",15,1],["ταῦτα",16,248],["τίς",10010,150],["ἱκανός",1007,16]],"to the one a stench from death to death, to the other a sweet aroma from life to life. Who is sufficient for these things?"],["17",[["οὐ",12,12],["γάρ",40,8],["ἐσμεν",10,241],["ὡς",36,12],["οἱ",1,128],["πολλοὶ",74,130],["καπηλεύοντες",11000,137],["τὸν",1,6],["λόγον",48,7],["τοῦ",1,30],["θεοῦ",20,21],["ἀλλ᾽",108,8],["ὡς",36,12],["ἐξ",21,1],["εἰλικρινείας",10943,19],["ἀλλ᾽",108,8],["ὡς",36,12],["ἐκ",21,1],["θεοῦ",20,21],["κατέναντι",691,1],["θεοῦ",20,21],["ἐν",4,1],["Χριστῷ",1072,113],["λαλοῦμεν",50,241]],"For we are not as so many, peddling the word of God. But as of sincerity, but as of God, in the sight of God, we speak in Christ."]]