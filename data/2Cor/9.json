[["1",[["Περὶ",72,1],["μὲν",281,12],["γὰρ",40,8],["τῆς",1,18],["διακονίας",6977,19],["τῆς",1,18],["εἰς",8,1],["τοὺς",1,56],["ἁγίους",75,58],["περισσόν",1636,28],["μοί",9994,151],["ἐστιν",10,87],["τὸ",1,27],["γράφειν",186,54],["ὑμῖν",5,86]],"It is indeed unnecessary for me to write to you concerning the service to the saints,"],["2",[["οἶδα",1168,85],["γὰρ",40,8],["τὴν",1,9],["προθυμίαν",8054,10],["ὑμῶν",5,136],["ἣν",24,124],["ὑπὲρ",139,1],["ὑμῶν",5,136],["καυχῶμαι",1380,768],["Μακεδόσιν",3238,139],["ὅτι",19,8],["Ἀχαΐα",9249,13],["παρεσκεύασται",2275,687],["ἀπὸ",17,1],["πέρυσι",11023,17],["καὶ",2,8],["τὸ",1,27],["ὑμῶν",5,136],["ζῆλος",1164,20],["ἠρέθισεν",4101,3],["τοὺς",1,56],["πλείονας",938,58]],"for I know your readiness, of which I boast on your behalf to those of Macedonia, that Achaia has been prepared for the past year. Your zeal has stirred up very many of them."],["3",[["ἔπεμψα",1597,147],["δὲ",14,8],["τοὺς",1,56],["ἀδελφούς",67,31],["ἵνα",102,8],["μὴ",25,12],["τὸ",1,27],["καύχημα",1627,20],["ἡμῶν",9994,136],["τὸ",1,27],["ὑπὲρ",139,1],["ὑμῶν",5,136],["κενωθῇ",5725,333],["ἐν",4,1],["τῷ",1,52],["μέρει",471,53],["τούτῳ",16,279],["ἵνα",102,8],["καθὼς",221,8],["ἔλεγον",31,293],["παρεσκευασμένοι",2275,539],["ἦτε",10,362]],"But I have sent the brothers so that our boasting on your behalf may not be in vain in this respect, that, just as I said, you may be prepared,"],["4",[["μή",25,12],["πως",441,12],["ἐὰν",45,8],["ἔλθωσιν",55,224],["σὺν",310,1],["ἐμοὶ",6,151],["Μακεδόνες",3238,51],["καὶ",2,8],["εὕρωσιν",101,224],["ὑμᾶς",5,209],["ἀπαρασκευάστους",11026,58],["καταισχυνθῶμεν",696,282],["ἡμεῖς",9994,208],["ἵνα",102,8],["μὴ",25,12],["λέγω",31,592],["ὑμεῖς",5,208],["ἐν",4,1],["τῇ",1,95],["ὑποστάσει",1877,2],["ταύτῃ",16,200]],"lest by any means, if anyone from Macedonia comes there with me and finds you unprepared, we (to say nothing of you) would be disappointed in this confident boasting."],["5",[["ἀναγκαῖον",4500,28],["οὖν",227,8],["ἡγησάμην",378,820],["παρακαλέσαι",434,100],["τοὺς",1,56],["ἀδελφούς",67,31],["ἵνα",102,8],["προέλθωσιν",2761,224],["εἰς",8,1],["ὑμᾶς",5,209],["καὶ",2,8],["προκαταρτίσωσιν",11027,224],["τὴν",1,9],["προεπηγγελμένην",10813,933],["εὐλογίαν",578,10],["ὑμῶν",5,136],["ταύτην",16,234],["ἑτοίμην",904,37],["εἶναι",10135,54],["οὕτως",71,17],["ὡς",36,12],["εὐλογίαν",578,10],["καὶ",2,8],["μὴ",25,12],["ὡς",36,12],["πλεονεξίαν",3332,10]],"I thought it necessary therefore to entreat the brothers that they would go before to you and arrange ahead of time the generous gift that you promised before, that the same might be ready as a matter of generosity, and not of greediness."],["6",[["τοῦτο",16,122],["δέ",14,8],["ὁ",1,4],["σπείρων",793,67],["φειδομένως",11028,17],["φειδομένως",11028,17],["καὶ",2,8],["θερίσει",1509,120],["καὶ",2,8],["ὁ",1,4],["σπείρων",793,67],["ἐπ᾽",9,1],["εὐλογίαις",578,71],["ἐπ᾽",9,1],["εὐλογίαις",578,71],["καὶ",2,8],["θερίσει",1509,120]],"Remember this: he who sows sparingly will also reap sparingly. He who sows bountifully will also reap bountifully."],["7",[["ἕκαστος",171,16],["καθὼς",221,8],["προῄρηται",2283,687],["τῇ",1,95],["καρδίᾳ",64,2],["μὴ",25,12],["ἐκ",21,1],["λύπης",1075,19],["ἢ",61,8],["ἐξ",21,1],["ἀνάγκης",1126,19],["ἱλαρὸν",3212,59],["γὰρ",40,8],["δότην",7120,7],["ἀγαπᾷ",214,87],["ὁ",1,4],["θεός",20,5]],"Let each man give according as he has determined in his heart, not grudgingly or under compulsion, for God loves a cheerful giver."],["8",[["Δυνατεῖ",10892,87],["δὲ",14,8],["ὁ",1,4],["θεὸς",20,5],["πᾶσαν",11,37],["χάριν",368,10],["περισσεῦσαι",3112,100],["εἰς",8,1],["ὑμᾶς",5,209],["ἵνα",102,8],["ἐν",4,1],["παντὶ",11,34],["πάντοτε",6027,17],["πᾶσαν",11,37],["αὐτάρκειαν",11029,10],["ἔχοντες",124,137],["περισσεύητε",3112,362],["εἰς",8,1],["πᾶν",11,29],["ἔργον",105,33],["ἀγαθὸν",114,29]],"And God is able to make all grace abound to you, that you, always having all sufficiency in everything, may abound to every good work."],["9",[["καθὼς",221,8],["γέγραπται",186,722],["ἐσκόρπισεν",1785,3],["ἔδωκεν",33,3],["τοῖς",1,138],["πένησιν",672,139],["ἡ",1,11],["δικαιοσύνη",187,13],["αὐτοῦ",3,48],["μένει",681,87],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7]],"As it is written, “He has scattered abroad. He has given to the poor. His righteousness remains forever.”"],["10",[["ὁ",1,4],["δὲ",14,8],["ἐπιχορηγῶν",9567,67],["σπόρον",2770,7],["τῷ",1,110],["σπείροντι",793,390],["καὶ",2,8],["ἄρτον",197,7],["εἰς",8,1],["βρῶσιν",1241,10],["χορηγήσει",2204,120],["καὶ",2,8],["πληθυνεῖ",316,120],["τὸν",1,6],["σπόρον",2770,7],["ὑμῶν",5,136],["καὶ",2,8],["αὐξήσει",1180,120],["τὰ",1,42],["γενήματα",4728,43],["τῆς",1,18],["δικαιοσύνης",187,19],["ὑμῶν",5,136]],"Now may he who supplies seed to the sower and bread for food, supply and multiply your seed for sowing, and increase the fruits of your righteousness,"],["11",[["ἐν",4,1],["παντὶ",11,34],["πλουτιζόμενοι",2613,772],["εἰς",8,1],["πᾶσαν",11,37],["ἁπλότητα",3717,10],["ἥτις",457,421],["κατεργάζεται",3067,728],["δι᾽",56,1],["ἡμῶν",9994,136],["εὐχαριστίαν",4230,10],["τῷ",1,110],["θεῷ",20,113]],"you being enriched in everything for all generosity, which produces thanksgiving to God through us."],["12",[["ὅτι",19,8],["ἡ",1,11],["διακονία",6977,13],["τῆς",1,18],["λειτουργίας",1141,19],["ταύτης",16,290],["οὐ",12,12],["μόνον",302,29],["ἐστὶν",10,87],["προσαναπληροῦσα",11030,183],["τὰ",1,42],["ὑστερήματα",3774,43],["τῶν",1,76],["ἁγίων",75,163],["ἀλλὰ",108,8],["καὶ",2,8],["περισσεύουσα",3112,183],["διὰ",56,1],["πολλῶν",74,115],["εὐχαριστιῶν",4230,61],["τῷ",1,110],["θεῷ",20,113]],"For this service of giving that you perform not only makes up for lack among the saints, but abounds also through much giving of thanks to God,"],["13",[["διὰ",56,1],["τῆς",1,18],["δοκιμῆς",10846,19],["τῆς",1,18],["διακονίας",6977,19],["ταύτης",16,290],["δοξάζοντες",452,137],["τὸν",1,6],["θεὸν",20,7],["ἐπὶ",9,1],["τῇ",1,95],["ὑποταγῇ",11031,2],["τῆς",1,18],["ὁμολογίας",3222,19],["ὑμῶν",5,136],["εἰς",8,1],["τὸ",1,32],["εὐαγγέλιον",4222,33],["τοῦ",1,30],["Χριστοῦ",1072,21],["καὶ",2,8],["ἁπλότητι",3717,2],["τῆς",1,18],["κοινωνίας",4860,19],["εἰς",8,1],["αὐτοὺς",3,60],["καὶ",2,8],["εἰς",8,1],["πάντας",11,58]],"seeing that through the proof given by this service, they glorify God for the obedience of your confession to the Good News of Christ and for the generosity of your contribution to them and to all,"],["14",[["καὶ",2,8],["αὐτῶν",3,41],["δεήσει",677,2],["ὑπὲρ",139,1],["ὑμῶν",5,136],["ἐπιποθούντων",2537,164],["ὑμᾶς",5,209],["διὰ",56,1],["τὴν",1,9],["ὑπερβάλλουσαν",3770,73],["χάριν",368,10],["τοῦ",1,30],["θεοῦ",20,21],["ἐφ᾽",9,1],["ὑμῖν",5,86]],"while they themselves also, with supplication on your behalf, yearn for you by reason of the exceeding grace of God in you."],["15",[["χάρις",368,13],["τῷ",1,110],["θεῷ",20,113],["ἐπὶ",9,1],["τῇ",1,95],["ἀνεκδιηγήτῳ",11032,96],["αὐτοῦ",3,48],["δωρεᾷ",1341,2]],"Now thanks be to God for his unspeakable gift!"]]