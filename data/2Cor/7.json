[["1",[["Ταύτας",16,280],["οὖν",227,8],["ἔχοντες",124,137],["τὰς",1,39],["ἐπαγγελίας",3439,40],["ἀγαπητοί",1920,537],["καθαρίσωμεν",482,75],["ἑαυτοὺς",92,60],["ἀπὸ",17,1],["παντὸς",11,153],["μολυσμοῦ",4915,21],["σαρκὸς",287,19],["καὶ",2,8],["πνεύματος",168,24],["ἐπιτελοῦντες",1706,137],["ἁγιωσύνην",4057,10],["ἐν",4,1],["φόβῳ",333,113],["θεοῦ",20,21]],"Having therefore these promises, beloved, let’s cleanse ourselves from all defilement of flesh and spirit, perfecting holiness in the fear of God."],["2",[["Χωρήσατε",2646,69],["ἡμᾶς",9994,209],["οὐδένα",228,59],["ἠδικήσαμεν",760,285],["οὐδένα",228,59],["ἐφθείραμεν",2199,285],["οὐδένα",228,59],["ἐπλεονεκτήσαμεν",4988,285]],"Open your hearts to us. We wronged no one. We corrupted no one. We took advantage of no one."],["3",[["πρὸς",15,1],["κατάκρισιν",11005,10],["οὐ",12,12],["λέγω",31,149],["προείρηκα",2617,85],["γὰρ",40,8],["ὅτι",19,8],["ἐν",4,1],["ταῖς",1,70],["καρδίαις",64,71],["ἡμῶν",9994,136],["ἐστε",10,84],["εἰς",8,1],["τὸ",1,32],["συναποθανεῖν",8398,100],["καὶ",2,8],["συζῆν",10855,54]],"I say this not to condemn you, for I have said before that you are in our hearts to die together and live together."],["4",[["πολλή",74,15],["μοι",9994,151],["παρρησία",2610,13],["πρὸς",15,1],["ὑμᾶς",5,209],["πολλή",74,15],["μοι",9994,151],["καύχησις",2730,13],["ὑπὲρ",139,1],["ὑμῶν",5,136],["πεπλήρωμαι",518,880],["τῇ",1,95],["παρακλήσει",2183,2],["ὑπερπερισσεύομαι",10853,572],["τῇ",1,95],["χαρᾷ",1125,2],["ἐπὶ",9,1],["πάσῃ",11,96],["τῇ",1,95],["θλίψει",438,2],["ἡμῶν",9994,136]],"Great is my boldness of speech toward you. Great is my boasting on your behalf. I am filled with comfort. I overflow with joy in all our affliction."],["5",[["καὶ",2,8],["γὰρ",40,8],["ἐλθόντων",55,211],["ἡμῶν",9994,136],["εἰς",8,1],["Μακεδονίαν",10620,10],["οὐδεμίαν",228,37],["ἔσχηκεν",124,165],["ἄνεσιν",3721,10],["ἡ",1,11],["σὰρξ",287,13],["ἡμῶν",9994,136],["ἀλλ᾽",108,8],["ἐν",4,1],["παντὶ",11,34],["θλιβόμενοι",601,772],["ἔξωθεν",1050,1],["μάχαι",1382,180],["ἔσωθεν",1610,17],["φόβοι",333,51]],"For even when we had come into Macedonia, our flesh had no relief, but we were afflicted on every side. Fightings were outside. Fear was inside."],["6",[["ἀλλ᾽",108,8],["ὁ",1,4],["παρακαλῶν",434,67],["τοὺς",1,56],["ταπεινοὺς",1097,58],["παρεκάλεσεν",434,3],["ἡμᾶς",9994,209],["ὁ",1,4],["θεὸς",20,5],["ἐν",4,1],["τῇ",1,95],["παρουσίᾳ",4349,2],["Τίτου",6801,21]],"Nevertheless, he who comforts the lowly, God, comforted us by the coming of Titus,"],["7",[["οὐ",12,12],["μόνον",302,29],["δὲ",14,8],["ἐν",4,1],["τῇ",1,95],["παρουσίᾳ",4349,2],["αὐτοῦ",3,48],["ἀλλὰ",108,8],["καὶ",2,8],["ἐν",4,1],["τῇ",1,95],["παρακλήσει",2183,2],["ᾗ",24,102],["παρεκλήθη",434,38],["ἐφ᾽",9,1],["ὑμῖν",5,86],["ἀναγγέλλων",231,67],["ἡμῖν",9994,86],["τὴν",1,9],["ὑμῶν",5,136],["ἐπιπόθησιν",11020,10],["τὸν",1,6],["ὑμῶν",5,136],["ὀδυρμόν",6607,7],["τὸν",1,6],["ὑμῶν",5,136],["ζῆλον",1164,7],["ὑπὲρ",139,1],["ἐμοῦ",6,88],["ὥστε",346,8],["με",9994,161],["μᾶλλον",1043,17],["χαρῆναι",698,807]],"and not by his coming only, but also by the comfort with which he was comforted in you while he told us of your longing, your mourning, and your zeal for me, so that I rejoiced still more."],["8",[["ὅτι",19,8],["εἰ",77,8],["καὶ",2,8],["ἐλύπησα",936,147],["ὑμᾶς",5,209],["ἐν",4,1],["τῇ",1,95],["ἐπιστολῇ",866,2],["οὐ",12,12],["μεταμέλομαι",7675,768],["εἰ",77,8],["καὶ",2,8],["μετεμελόμην",7675,816],["βλέπω",470,149],["γὰρ",40,8],["ὅτι",19,8],["ἡ",1,11],["ἐπιστολὴ",866,13],["ἐκείνη",80,101],["εἰ",77,8],["καὶ",2,8],["πρὸς",15,1],["ὥραν",838,10],["ἐλύπησεν",936,3],["ὑμᾶς",5,209]],"For though I grieved you with my letter, I do not regret it, though I did regret it. For I see that my letter made you grieve, though just for a while."],["9",[["νῦν",90,17],["χαίρω",698,149],["οὐχ",12,12],["ὅτι",19,8],["ἐλυπήθητε",936,353],["ἀλλ᾽",108,8],["ὅτι",19,8],["ἐλυπήθητε",936,353],["εἰς",8,1],["μετάνοιαν",3084,10],["ἐλυπήθητε",936,353],["γὰρ",40,8],["κατὰ",32,1],["θεόν",20,7],["ἵνα",102,8],["ἐν",4,1],["μηδενὶ",908,34],["ζημιωθῆτε",3532,485],["ἐξ",21,1],["ἡμῶν",9994,136]],"I now rejoice, not that you were grieved, but that you were grieved to repentance. For you were grieved in a godly way, that you might suffer loss by us in nothing."],["10",[["ἡ",1,11],["γὰρ",40,8],["κατὰ",32,1],["θεὸν",20,7],["λύπη",1075,13],["μετάνοιαν",3084,10],["εἰς",8,1],["σωτηρίαν",425,10],["ἀμεταμέλητον",10882,37],["ἐργάζεται",467,728],["ἡ",1,11],["δὲ",14,8],["τοῦ",1,30],["κόσμου",743,21],["λύπη",1075,13],["θάνατον",170,7],["κατεργάζεται",3067,728]],"For godly sorrow produces repentance leading to salvation, which brings no regret. But the sorrow of the world produces death."],["11",[["ἰδοὺ",51,316],["γὰρ",40,8],["αὐτὸ",3,359],["τοῦτο",16,344],["τὸ",1,27],["κατὰ",32,1],["θεὸν",20,7],["λυπηθῆναι",936,175],["πόσην",2486,583],["κατειργάσατο",3067,737],["ὑμῖν",5,86],["σπουδήν",1387,10],["ἀλλ᾽",108,8],["ἀπολογίαν",9017,10],["ἀλλ᾽",108,8],["ἀγανάκτησιν",11021,10],["ἀλλὰ",108,8],["φόβον",333,7],["ἀλλ᾽",108,8],["ἐπιπόθησιν",11020,10],["ἀλλὰ",108,8],["ζῆλον",1164,7],["ἀλλ᾽",108,8],["ἐκδίκησιν",821,10],["ἐν",4,1],["παντὶ",11,34],["συνεστήσατε",1065,262],["ἑαυτοὺς",92,60],["ἁγνοὺς",2814,58],["εἶναι",10135,54],["τῷ",1,52],["πράγματι",511,53]],"For behold, this same thing, that you were grieved in a godly way, what earnest care it worked in you. Yes, what defense, indignation, fear, longing, zeal, and vindication! In everything you demonstrated yourselves to be pure in the matter."],["12",[["ἄρα",985,8],["εἰ",77,8],["καὶ",2,8],["ἔγραψα",186,147],["ὑμῖν",5,86],["οὐχ",12,12],["ἕνεκεν",447,1],["τοῦ",1,30],["ἀδικήσαντος",760,513],["οὐδὲ",106,8],["ἕνεκεν",447,1],["τοῦ",1,30],["ἀδικηθέντος",760,317],["ἀλλ᾽",108,8],["ἕνεκεν",447,1],["τοῦ",1,23],["φανερωθῆναι",8582,175],["τὴν",1,9],["σπουδὴν",1387,10],["ὑμῶν",5,136],["τὴν",1,9],["ὑπὲρ",139,1],["ἡμῶν",9994,136],["πρὸς",15,1],["ὑμᾶς",5,209],["ἐνώπιον",115,1],["τοῦ",1,30],["θεοῦ",20,21]],"So although I wrote to you, I wrote not for his cause that did the wrong, nor for his cause that suffered the wrong, but that your earnest care for us might be revealed in you in the sight of God."],["13",[["διὰ",56,1],["τοῦτο",16,122],["παρακεκλήμεθα",434,876],["Ἐπὶ",9,1],["δὲ",14,8],["τῇ",1,95],["παρακλήσει",2183,2],["ἡμῶν",9994,136],["περισσοτέρως",10995,17],["μᾶλλον",1043,17],["ἐχάρημεν",698,794],["ἐπὶ",9,1],["τῇ",1,95],["χαρᾷ",1125,2],["Τίτου",6801,21],["ὅτι",19,8],["ἀναπέπαυται",674,722],["τὸ",1,27],["πνεῦμα",168,20],["αὐτοῦ",3,48],["ἀπὸ",17,1],["πάντων",11,163],["ὑμῶν",5,136]],"Therefore we have been comforted. In our comfort we rejoiced the more exceedingly for the joy of Titus, because his spirit has been refreshed by you all."],["14",[["ὅτι",19,8],["εἴ",77,8],["τι",39,119],["αὐτῷ",3,49],["ὑπὲρ",139,1],["ὑμῶν",5,136],["κεκαύχημαι",1380,869],["οὐ",12,12],["κατῃσχύνθην",696,148],["ἀλλ᾽",108,8],["ὡς",36,12],["πάντα",11,65],["ἐν",4,1],["ἀληθείᾳ",352,2],["ἐλαλήσαμεν",50,285],["ὑμῖν",5,86],["οὕτως",9989,17],["καὶ",2,8],["ἡ",1,11],["καύχησις",2730,13],["ἡμῶν",9994,136],["ἡ",1,11],["ἐπὶ",9,1],["Τίτου",6801,21],["ἀλήθεια",352,13],["ἐγενήθη",30,715]],"For if in anything I have boasted to him on your behalf, I was not disappointed. But as we spoke all things to you in truth, so our glorying also which I made before Titus was found to be truth."],["15",[["καὶ",2,8],["τὰ",1,253],["σπλάγχνα",2190,63],["αὐτοῦ",3,48],["περισσοτέρως",10995,17],["εἰς",8,1],["ὑμᾶς",5,209],["ἐστιν",10,87],["ἀναμιμνῃσκομένου",1651,813],["τὴν",1,9],["πάντων",11,163],["ὑμῶν",5,136],["ὑπακοήν",9870,10],["ὡς",36,12],["μετὰ",29,1],["φόβου",333,21],["καὶ",2,8],["τρόμου",1599,21],["ἐδέξασθε",815,779],["αὐτόν",3,82]],"His affection is more abundantly toward you, while he remembers all of your obedience, how with fear and trembling you received him."],["16",[["χαίρω",698,149],["ὅτι",19,8],["ἐν",4,1],["παντὶ",11,34],["θαρρῶ",11009,149],["ἐν",4,1],["ὑμῖν",5,86]],"I rejoice that in everything I am confident concerning you."]]