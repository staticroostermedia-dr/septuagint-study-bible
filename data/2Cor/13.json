[["1",[["Τρίτον",357,29],["τοῦτο",16,122],["ἔρχομαι",55,768],["πρὸς",15,1],["ὑμᾶς",5,209],["ἐπὶ",9,1],["στόματος",123,24],["δύο",104,372],["μαρτύρων",875,77],["καὶ",2,8],["τριῶν",174,163],["σταθήσεται",78,125],["πᾶν",11,28],["ῥῆμα",116,20]],"This is the third time I am coming to you. “At the mouth of two or three witnesses shall every word be established.”"],["2",[["προείρηκα",2617,85],["καὶ",2,8],["προλέγω",8062,149],["ὡς",36,12],["παρὼν",899,67],["τὸ",1,32],["δεύτερον",271,29],["καὶ",2,8],["ἀπὼν",2818,67],["νῦν",90,17],["τοῖς",1,138],["προημαρτηκόσιν",11052,552],["καὶ",2,8],["τοῖς",1,138],["λοιποῖς",523,215],["πᾶσιν",11,215],["ὅτι",19,8],["ἐὰν",45,8],["ἔλθω",55,227],["εἰς",8,1],["τὸ",1,32],["πάλιν",655,17],["οὐ",12,12],["φείσομαι",610,775]],"I have warned previously, and I warn again, as when I was present the second time, so now, being absent, I write to those who have sinned before now and to all the rest that if I come again, I will not spare,"],["3",[["ἐπεὶ",1236,8],["δοκιμὴν",10846,10],["ζητεῖτε",191,84],["τοῦ",1,30],["ἐν",4,1],["ἐμοὶ",6,151],["λαλοῦντος",50,143],["Χριστοῦ",1072,21],["ὃς",24,246],["εἰς",8,1],["ὑμᾶς",5,209],["οὐκ",12,12],["ἀσθενεῖ",771,87],["ἀλλὰ",108,8],["δυνατεῖ",10892,87],["ἐν",4,1],["ὑμῖν",5,86]],"seeing that you seek a proof of Christ who speaks in me who is not weak, but is powerful in you."],["4",[["καὶ",2,8],["γὰρ",40,8],["ἐσταυρώθη",6067,38],["ἐξ",21,1],["ἀσθενείας",3413,19],["ἀλλὰ",108,8],["ζῇ",107,87],["ἐκ",21,1],["δυνάμεως",98,19],["θεοῦ",20,21],["καὶ",2,8],["γὰρ",40,8],["ἡμεῖς",9994,208],["ἀσθενοῦμεν",771,241],["ἐν",4,1],["αὐτῷ",3,49],["ἀλλὰ",108,8],["ζήσομεν",107,269],["σὺν",310,1],["αὐτῷ",3,49],["ἐκ",21,1],["δυνάμεως",98,19],["θεοῦ",20,21],["εἰς",8,1],["ὑμᾶς",5,209]],"For he was crucified through weakness, yet he lives through the power of God. For we also are weak in him, but we will live with him through the power of God toward you."],["5",[["Ἑαυτοὺς",92,60],["πειράζετε",1094,307],["εἰ",77,8],["ἐστὲ",10,84],["ἐν",4,1],["τῇ",1,95],["πίστει",887,2],["ἑαυτοὺς",92,60],["δοκιμάζετε",1269,307],["ἢ",61,8],["οὐκ",12,12],["ἐπιγινώσκετε",431,84],["ἑαυτοὺς",92,60],["ὅτι",19,8],["Ἰησοῦς",211,5],["Χριστὸς",1072,5],["ἐν",4,1],["ὑμῖν",5,86],["εἰ",77,8],["μήτι",10058,12],["ἀδόκιμοί",6231,130],["ἐστε",10,84]],"Examine your own selves, whether you are in the faith. Test your own selves. Or don’t you know about your own selves, that Jesus Christ is in you?—unless indeed you are disqualified."],["6",[["ἐλπίζω",514,149],["δὲ",14,8],["ὅτι",19,8],["γνώσεσθε",79,747],["ὅτι",19,8],["ἡμεῖς",9994,208],["οὐκ",12,12],["ἐσμὲν",10,241],["ἀδόκιμοι",6231,130]],"But I hope that you will know that we aren’t disqualified."],["7",[["εὐχόμεθα",670,800],["δὲ",14,8],["πρὸς",15,1],["τὸν",1,6],["θεὸν",20,7],["μὴ",25,12],["ποιῆσαι",23,100],["ὑμᾶς",5,209],["κακὸν",161,29],["μηδέν",908,29],["οὐχ",12,12],["ἵνα",102,8],["ἡμεῖς",9994,208],["δόκιμοι",3529,130],["φανῶμεν",832,282],["ἀλλ᾽",108,8],["ἵνα",102,8],["ὑμεῖς",5,208],["τὸ",1,32],["καλὸν",266,29],["ποιῆτε",23,362],["ἡμεῖς",9994,208],["δὲ",14,8],["ὡς",36,12],["ἀδόκιμοι",6231,130],["ὦμεν",10,223]],"Now I pray to God that you do no evil; not that we may appear approved, but that you may do that which is honorable, though we may seem to have failed."],["8",[["οὐ",12,12],["γὰρ",40,8],["δυνάμεθά",185,608],["τι",39,119],["κατὰ",32,1],["τῆς",1,18],["ἀληθείας",352,19],["ἀλλ᾽",108,8],["ὑπὲρ",139,1],["τῆς",1,18],["ἀληθείας",352,19]],"For we can do nothing against the truth, but for the truth."],["9",[["χαίρομεν",698,241],["γὰρ",40,8],["ὅταν",319,8],["ἡμεῖς",9994,208],["ἀσθενῶμεν",771,223],["ὑμεῖς",5,208],["δὲ",14,8],["δυνατοὶ",356,130],["ἦτε",10,362],["τοῦτο",16,122],["καὶ",2,8],["εὐχόμεθα",670,800],["τὴν",1,9],["ὑμῶν",5,136],["κατάρτισιν",11053,10]],"For we rejoice when we are weak and you are strong. We also pray for this: your becoming perfect."],["10",[["διὰ",56,1],["τοῦτο",16,122],["ταῦτα",16,248],["ἀπὼν",2818,67],["γράφω",186,149],["ἵνα",102,8],["παρὼν",899,67],["μὴ",25,12],["ἀποτόμως",9062,17],["χρήσωμαι",928,815],["κατὰ",32,1],["τὴν",1,9],["ἐξουσίαν",929,10],["ἣν",24,124],["ὁ",1,4],["κύριος",7,5],["ἔδωκέν",33,3],["μοι",9994,151],["εἰς",8,1],["οἰκοδομὴν",2371,10],["καὶ",2,8],["οὐκ",12,12],["εἰς",8,1],["καθαίρεσιν",5659,10]],"For this cause I write these things while absent, that I may not deal sharply when present, according to the authority which the Lord gave me for building up and not for tearing down."],["11",[["Λοιπόν",2461,29],["ἀδελφοί",67,396],["χαίρετε",698,307],["καταρτίζεσθε",1888,809],["παρακαλεῖσθε",434,809],["τὸ",1,32],["αὐτὸ",3,121],["φρονεῖτε",2297,307],["εἰρηνεύετε",1959,307],["καὶ",2,8],["ὁ",1,4],["θεὸς",20,5],["τῆς",1,18],["ἀγάπης",1982,19],["καὶ",2,8],["εἰρήνης",213,19],["ἔσται",10,718],["μεθ᾽",29,1],["ὑμῶν",5,136]],"Finally, brothers, rejoice! Be perfected. Be comforted. Be of the same mind. Live in peace, and the God of love and peace will be with you."],["12",[["Ἀσπάσασθε",2987,771],["ἀλλήλους",1192,60],["ἐν",4,1],["ἁγίῳ",75,34],["φιλήματι",6192,53],["Ἀσπάζονται",2987,756],["ὑμᾶς",5,209],["οἱ",1,128],["ἅγιοι",75,130],["πάντες",11,130]],"Greet one another with a holy kiss."],["13",[["Ἡ",1,11],["χάρις",368,13],["τοῦ",1,30],["κυρίου",7,21],["Ἰησοῦ",211,21],["Χριστοῦ",1072,21],["καὶ",2,8],["ἡ",1,11],["ἀγάπη",1982,13],["τοῦ",1,30],["θεοῦ",20,21],["καὶ",2,8],["ἡ",1,11],["κοινωνία",4860,13],["τοῦ",1,23],["ἁγίου",75,88],["πνεύματος",168,24],["μετὰ",29,1],["πάντων",11,163],["ὑμῶν",5,136]],"All the saints greet you."],["14",[],"The grace of the Lord Jesus Christ, God’s love, and the fellowship of the Holy Spirit be with you all. Amen.",{"s":"g0"}]]