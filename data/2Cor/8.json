[["1",[["Γνωρίζομεν",748,241],["δὲ",14,8],["ὑμῖν",5,86],["ἀδελφοί",67,396],["τὴν",1,9],["χάριν",368,10],["τοῦ",1,30],["θεοῦ",20,21],["τὴν",1,9],["δεδομένην",33,540],["ἐν",4,1],["ταῖς",1,70],["ἐκκλησίαις",563,71],["τῆς",1,18],["Μακεδονίας",10620,19]],"Moreover, brothers, we make known to you the grace of God which has been given in the assemblies of Macedonia,"],["2",[["ὅτι",19,8],["ἐν",4,1],["πολλῇ",74,96],["δοκιμῇ",10846,2],["θλίψεως",438,19],["ἡ",1,11],["περισσεία",10850,13],["τῆς",1,18],["χαρᾶς",1125,19],["αὐτῶν",3,41],["καὶ",2,8],["ἡ",1,11],["κατὰ",32,1],["βάθους",1502,24],["πτωχεία",1913,13],["αὐτῶν",3,41],["ἐπερίσσευσεν",3112,3],["εἰς",8,1],["τὸ",1,32],["πλοῦτος",574,33],["τῆς",1,18],["ἁπλότητος",3717,19],["αὐτῶν",3,41]],"how in a severe ordeal of affliction, the abundance of their joy and their deep poverty abounded to the riches of their generosity."],["3",[["ὅτι",19,8],["κατὰ",32,1],["δύναμιν",98,10],["μαρτυρῶ",2094,149],["καὶ",2,8],["παρὰ",73,1],["δύναμιν",98,10],["αὐθαίρετοι",4695,130]],"For according to their power, I testify, yes and beyond their power, they gave of their own accord,"],["4",[["μετὰ",29,1],["πολλῆς",74,78],["παρακλήσεως",2183,19],["δεόμενοι",1672,741],["ἡμῶν",9994,136],["τὴν",1,9],["χάριν",368,10],["καὶ",2,8],["τὴν",1,9],["κοινωνίαν",4860,10],["τῆς",1,18],["διακονίας",6977,19],["τῆς",1,18],["εἰς",8,1],["τοὺς",1,56],["ἁγίους",75,58]],"begging us with much entreaty to receive this grace and the fellowship in the service to the saints."],["5",[["καὶ",2,8],["οὐ",12,12],["καθὼς",221,8],["ἠλπίσαμεν",514,285],["ἀλλ᾽",108,8],["ἑαυτοὺς",92,60],["ἔδωκαν",33,141],["πρῶτον",315,29],["τῷ",1,110],["κυρίῳ",7,113],["καὶ",2,8],["ἡμῖν",9994,86],["διὰ",56,1],["θελήματος",1039,24],["θεοῦ",20,21]],"This was not as we had expected, but first they gave their own selves to the Lord, and to us through the will of God."],["6",[["εἰς",8,1],["τὸ",1,32],["παρακαλέσαι",434,100],["ἡμᾶς",9994,209],["Τίτον",6801,7],["ἵνα",102,8],["καθὼς",221,8],["προενήρξατο",11022,737],["οὕτως",9989,17],["καὶ",2,8],["ἐπιτελέσῃ",1706,160],["εἰς",8,1],["ὑμᾶς",5,209],["καὶ",2,8],["τὴν",1,9],["χάριν",368,10],["ταύτην",16,234]],"So we urged Titus, that as he had made a beginning before, so he would also complete in you this grace."],["7",[["ἀλλ᾽",108,8],["ὥσπερ",226,8],["ἐν",4,1],["παντὶ",11,34],["περισσεύετε",3112,84],["πίστει",887,2],["καὶ",2,8],["λόγῳ",48,113],["καὶ",2,8],["γνώσει",753,2],["καὶ",2,8],["πάσῃ",11,96],["σπουδῇ",1387,2],["καὶ",2,8],["τῇ",1,95],["ἐξ",21,1],["ἡμῶν",9994,136],["ἐν",4,1],["ὑμῖν",5,86],["ἀγάπῃ",1982,2],["ἵνα",102,8],["καὶ",2,8],["ἐν",4,1],["ταύτῃ",16,200],["τῇ",1,95],["χάριτι",368,2],["περισσεύητε",3112,362]],"But as you abound in everything—in faith, utterance, knowledge, all earnestness, and in your love to us—see that you also abound in this grace."],["8",[["οὐ",12,12],["κατ᾽",32,1],["ἐπιταγὴν",4095,10],["λέγω",31,149],["ἀλλὰ",108,8],["διὰ",56,1],["τῆς",1,18],["ἑτέρων",253,163],["σπουδῆς",1387,19],["καὶ",2,8],["τὸ",1,32],["τῆς",1,18],["ὑμετέρας",10347,78],["ἀγάπης",1982,19],["γνήσιον",5519,29],["δοκιμάζων",1269,67]],"I speak not by way of commandment, but as proving through the earnestness of others the sincerity also of your love."],["9",[["γινώσκετε",79,84],["γὰρ",40,8],["τὴν",1,9],["χάριν",368,10],["τοῦ",1,30],["κυρίου",7,21],["ἡμῶν",9994,136],["Ἰησοῦ",211,21],["Χριστοῦ",1072,21],["ὅτι",19,8],["δι᾽",56,1],["ὑμᾶς",5,209],["ἐπτώχευσεν",3941,3],["πλούσιος",952,16],["ὤν",10,67],["ἵνα",102,8],["ὑμεῖς",5,208],["τῇ",1,95],["ἐκείνου",80,126],["πτωχείᾳ",1913,2],["πλουτήσητε",2373,118]],"For you know the grace of our Lord Jesus Christ, that though he was rich, yet for your sakes he became poor, that you through his poverty might become rich."],["10",[["καὶ",2,8],["γνώμην",1376,10],["ἐν",4,1],["τούτῳ",16,279],["δίδωμι",33,149],["τοῦτο",16,344],["γὰρ",40,8],["ὑμῖν",5,86],["συμφέρει",2495,87],["οἵτινες",457,455],["οὐ",12,12],["μόνον",302,29],["τὸ",1,32],["ποιῆσαι",23,100],["ἀλλὰ",108,8],["καὶ",2,8],["τὸ",1,32],["θέλειν",612,54],["προενήρξασθε",11022,779],["ἀπὸ",17,1],["πέρυσι",11023,17]],"I give advice in this: it is expedient for you who were the first to start a year ago, not only to do, but also to be willing."],["11",[["νυνὶ",2099,17],["δὲ",14,8],["καὶ",2,8],["τὸ",1,32],["ποιῆσαι",23,100],["ἐπιτελέσατε",1706,69],["ὅπως",240,8],["καθάπερ",690,8],["ἡ",1,11],["προθυμία",8054,13],["τοῦ",1,23],["θέλειν",612,54],["οὕτως",9989,17],["καὶ",2,8],["τὸ",1,27],["ἐπιτελέσαι",1706,100],["ἐκ",21,1],["τοῦ",1,23],["ἔχειν",124,54]],"But now complete the doing also, that as there was the readiness to be willing, so there may be the completion also out of your ability."],["12",[["εἰ",77,8],["γὰρ",40,8],["ἡ",1,11],["προθυμία",8054,13],["πρόκειται",2763,728],["καθὸ",5665,8],["ἐὰν",45,8],["ἔχῃ",124,173],["εὐπρόσδεκτος",10897,15],["οὐ",12,12],["καθὸ",5665,8],["οὐκ",12,12],["ἔχει",124,87]],"For if the readiness is there, it is acceptable according to what you have, not according to what you don’t have."],["13",[["οὐ",12,12],["γὰρ",40,8],["ἵνα",102,8],["ἄλλοις",584,215],["ἄνεσις",3721,13],["ὑμῖν",5,86],["θλῖψις",438,13],["ἀλλ᾽",108,8],["ἐξ",21,1],["ἰσότητος",6589,19]],"For this is not that others may be eased and you distressed,"],["14",[["ἐν",4,1],["τῷ",1,110],["νῦν",90,17],["καιρῷ",132,113],["τὸ",1,27],["ὑμῶν",5,136],["περίσσευμα",7970,20],["εἰς",8,1],["τὸ",1,32],["ἐκείνων",80,220],["ὑστέρημα",3774,33],["ἵνα",102,8],["καὶ",2,8],["τὸ",1,27],["ἐκείνων",80,220],["περίσσευμα",7970,20],["γένηται",30,745],["εἰς",8,1],["τὸ",1,32],["ὑμῶν",5,136],["ὑστέρημα",3774,33],["ὅπως",240,8],["γένηται",30,745],["ἰσότης",6589,13]],"but for equality. Your abundance at this present time supplies their lack, that their abundance also may become a supply for your lack, that there may be equality."],["15",[["καθὼς",221,8],["γέγραπται",186,722],["ὁ",1,4],["τὸ",1,32],["πολὺ",74,29],["οὐκ",12,12],["ἐπλεόνασεν",1523,3],["καὶ",2,8],["ὁ",1,4],["τὸ",1,32],["ὀλίγον",555,29],["οὐκ",12,12],["ἠλαττόνησεν",4080,3]],"As it is written, “He who gathered much had nothing left over, and he who gathered little had no lack.”"],["16",[["Χάρις",368,13],["δὲ",14,8],["τῷ",1,110],["θεῷ",20,113],["τῷ",1,110],["δόντι",33,354],["τὴν",1,9],["αὐτὴν",3,98],["σπουδὴν",1387,10],["ὑπὲρ",139,1],["ὑμῶν",5,136],["ἐν",4,1],["τῇ",1,95],["καρδίᾳ",64,2],["Τίτου",6801,21]],"But thanks be to God, who puts the same earnest care for you into the heart of Titus."],["17",[["ὅτι",19,8],["τὴν",1,9],["μὲν",281,12],["παράκλησιν",2183,10],["ἐδέξατο",815,737],["σπουδαιότερος",8273,16],["δὲ",14,8],["ὑπάρχων",418,67],["αὐθαίρετος",4695,16],["ἐξῆλθεν",82,3],["πρὸς",15,1],["ὑμᾶς",5,209]],"For he indeed accepted our exhortation, but being himself very earnest, he went out to you of his own accord."],["18",[["συνεπέμψαμεν",11024,285],["δὲ",14,8],["μετ᾽",29,1],["αὐτοῦ",3,48],["τὸν",1,6],["ἀδελφόν",67,7],["οὗ",24,367],["ὁ",1,4],["ἔπαινος",2840,5],["ἐν",4,1],["τῷ",1,52],["εὐαγγελίῳ",4222,53],["διὰ",56,1],["πασῶν",11,115],["τῶν",1,123],["ἐκκλησιῶν",563,61]],"We have sent together with him the brother whose praise in the Good News is known throughout all the assemblies."],["19",[["οὐ",12,12],["μόνον",302,29],["δέ",14,8],["ἀλλὰ",108,8],["καὶ",2,8],["χειροτονηθεὶς",10605,206],["ὑπὸ",122,1],["τῶν",1,123],["ἐκκλησιῶν",563,61],["συνέκδημος",10691,5],["ἡμῶν",9994,136],["σὺν",310,1],["τῇ",1,95],["χάριτι",368,2],["ταύτῃ",16,200],["τῇ",1,95],["διακονουμένῃ",10016,841],["ὑφ᾽",122,1],["ἡμῶν",9994,136],["πρὸς",15,1],["τὴν",1,9],["αὐτοῦ",3,48],["τοῦ",1,30],["κυρίου",7,21],["δόξαν",141,10],["καὶ",2,8],["προθυμίαν",8054,10],["ἡμῶν",9994,136]],"Not only so, but he was also appointed by the assemblies to travel with us in this grace, which is served by us to the glory of the Lord himself, and to show our readiness."],["20",[["στελλόμενοι",3359,520],["τοῦτο",16,122],["μή",25,12],["τις",39,150],["ἡμᾶς",9994,209],["μωμήσηται",5845,745],["ἐν",4,1],["τῇ",1,95],["ἁδρότητι",11025,2],["ταύτῃ",16,200],["τῇ",1,95],["διακονουμένῃ",10016,841],["ὑφ᾽",122,1],["ἡμῶν",9994,136]],"We are avoiding this, that any man should blame us concerning this abundance which is administered by us."],["21",[["προνοοῦμεν",3338,241],["γὰρ",40,8],["καλὰ",266,65],["οὐ",12,12],["μόνον",302,29],["ἐνώπιον",115,1],["κυρίου",7,21],["ἀλλὰ",108,8],["καὶ",2,8],["ἐνώπιον",115,1],["ἀνθρώπων",43,77]],"Having regard for honorable things, not only in the sight of the Lord, but also in the sight of men."],["22",[["συνεπέμψαμεν",11024,285],["δὲ",14,8],["αὐτοῖς",3,142],["τὸν",1,6],["ἀδελφὸν",67,7],["ἡμῶν",9994,136],["ὃν",24,106],["ἐδοκιμάσαμεν",1269,285],["ἐν",4,1],["πολλοῖς",74,90],["πολλάκις",2947,17],["σπουδαῖον",8273,59],["ὄντα",10,178],["νυνὶ",2099,17],["δὲ",14,8],["πολὺ",74,29],["σπουδαιότερον",8273,59],["πεποιθήσει",7924,2],["πολλῇ",74,96],["τῇ",1,95],["εἰς",8,1],["ὑμᾶς",5,209]],"We have sent with them our brother whom we have many times proved earnest in many things, but now much more earnest, by reason of the great confidence which he has in you."],["23",[["εἴτε",2713,8],["ὑπὲρ",139,1],["Τίτου",6801,21],["κοινωνὸς",3562,5],["ἐμὸς",10146,16],["καὶ",2,8],["εἰς",8,1],["ὑμᾶς",5,209],["συνεργός",6116,16],["εἴτε",2713,8],["ἀδελφοὶ",67,51],["ἡμῶν",9994,136],["ἀπόστολοι",10080,51],["ἐκκλησιῶν",563,61],["δόξα",141,13],["Χριστοῦ",1072,21]],"As for Titus, he is my partner and fellow worker for you. As for our brothers, they are the apostles of the assemblies, the glory of Christ."],["24",[["τὴν",1,9],["οὖν",227,8],["ἔνδειξιν",10838,10],["τῆς",1,18],["ἀγάπης",1982,19],["ὑμῶν",5,136],["καὶ",2,8],["ἡμῶν",9994,136],["καυχήσεως",2730,19],["ὑπὲρ",139,1],["ὑμῶν",5,136],["εἰς",8,1],["αὐτοὺς",3,60],["ἐνδεικνύμενοι",2528,520],["εἰς",8,1],["πρόσωπον",47,33],["τῶν",1,123],["ἐκκλησιῶν",563,61]],"Therefore show the proof of your love to them before the assemblies, and of our boasting on your behalf."]]