"διὸ",1466,8],["μᾶλλον",1043,17],["ἀδελφοί",67,396],["σπουδάσατε",2490,69],["βεβαίαν",3796,37],["ὑμῶν",5,136],["τὴν",1,9],["κλῆσιν",5735,10],["καὶ",2,8],["ἐκλογὴν",10550,10],["ποιεῖσθαι",23,104],["ταῦτα",16,248],["γὰρ",40,8],["ποιοῦντες",23,137],["οὐ",12,12],["μὴ",25,12],["πταίσητέ",2187,118],["ποτε",458,12]],"Therefore, brothers, be more diligent to make your calling and election sure. For if you do these things, you will never stumble."],["11",[["οὕτως",9989,17],["γὰρ",40,8],["πλουσίως",11155,17],["ἐπιχορηγηθήσεται",9567,125],["ὑμῖν",5,86],["ἡ",1,11],["εἴσοδος",1002,13],["εἰς",8,1],["τὴν",1,9],["αἰώνιον",391,37],["βασιλείαν",157,10],["τοῦ",1,30],["κυρίου",7,21],["ἡμῶν",9994,136],["καὶ",2,8],["σωτῆρος",1388,21],["Ἰησοῦ",211,21],["Χριστοῦ",1072,21]],"For thus you will be richly supplied with the entrance into the eternal Kingdom of our Lord and Savior, Jesus Christ."],["12",[["Διὸ",1466,8],["μελλήσω",1143,157],["ἀεὶ",2401,17],["ὑμᾶς",5,209],["ὑπομιμνῄσκειν",5423,54],["περὶ",72,1],["τούτων",16,214],["καίπερ",2902,8],["εἰδότας",10044,276],["καὶ",2,8],["ἐστηριγμένους",979,803],["ἐν",4,1],["τῇ",1,95],["παρούσῃ",899,210],["ἀληθείᾳ",352,2]],"Therefore I will not be negligent to remind you of these things, though you know them and are established in the present truth."],["13",[["δίκαιον",153,29],["δὲ",14,8],["ἡγοῦμαι",378,768],["ἐφ᾽",9,1],["ὅσον",103,106],["εἰμὶ",10,149],["ἐν",4,1],["τούτῳ",16,279],["τῷ",1,52],["σκηνώματι",682,53],["διεγείρειν",3815,54],["ὑμᾶς",5,209],["ἐν",4,1],["ὑπομνήσει",6657,2]],"I think it right, as long as I am in this tent, to stir you up by reminding you,"],["14",[["εἰδὼς",10044,264],["ὅτι",19,8],["ταχινή",3972,15],["ἐστιν",10,87],["ἡ",1,11],["ἀπόθεσις",11391,13],["τοῦ",1,23],["σκηνώματός",682,24],["μου",9994,146],["καθὼς",221,8],["καὶ",2,8],["ὁ",1,4],["κύριος",7,5],["ἡμῶν",9994,136],["Ἰησοῦς",211,5],["Χριστὸς",1072,5],["ἐδήλωσέν",1670,3],["μοι",9994,151]],"knowing that the putting off of my tent comes swiftly, even as our Lord Jesus Christ made clear to me."],["15",[["σπουδάσω",2490,157],["δὲ",14,8],["καὶ",2,8],["ἑκάστοτε",11411,17],["ἔχειν",124,54],["ὑμᾶς",5,209],["μετὰ",29,1],["τὴν",1,9],["ἐμὴν",10146,37],["ἔξοδον",762,10],["τὴν",1,9],["τούτων",16,214],["μνήμην",2177,10],["ποιεῖσθαι",23,104]],"Yes, I will make every effort that you may always be able to remember these things even after my departure."],["16",[["οὐ",12,12],["γὰρ",40,8],["σεσοφισμένοις",1786,804],["μύθοις",7745,139],["ἐξακολουθήσαντες",3738,190],["ἐγνωρίσαμεν",748,285],["ὑμῖν",5,86],["τὴν",1,9],["τοῦ",1,30],["κυρίου",7,21],["ἡμῶν",9994,136],["Ἰησοῦ",211,21],["Χριστοῦ",1072,21],["δύναμιν",98,10],["καὶ",2,8],["παρουσίαν",4349,10],["ἀλλ᾽",108,8],["ἐπόπται",4614,51],["γενηθέντες",30,724],["τῆς",1,18],["ἐκείνου",80,126],["μεγαλειότητος",4898,19]],"For we didn’t follow cunningly devised fables when we made known to you the power and coming of our Lord Jesus Christ, but we were eyewitnesses of his majesty."],["17",[["λαβὼν",46,155],["γὰρ",40,8],["παρὰ",73,1],["θεοῦ",20,21],["πατρὸς",44,21],["τιμὴν",720,10],["καὶ",2,8],["δόξαν",141,10],["φωνῆς",95,19],["ἐνεχθείσης",199,550],["αὐτῷ",3,49],["τοιᾶσδε",6151,290],["ὑπὸ",122,1],["τῆς",1,18],["μεγαλοπρεποῦς",3294,78],["δόξης",141,19],["ὁ",1,4],["υἱός",13,5],["μου",9994,146],["ὁ",1,4],["ἀγαπητός",1920,16],["μου",9994,146],["οὗτός",16,112],["ἐστιν",10,87],["εἰς",8,1],["ὃν",24,106],["ἐγὼ",6,156],["εὐδόκησα",906,147]],"For he received from God the Father honor and glory when the voice came to him from the Majestic Glory, “This is my beloved Son, in whom I am well pleased.”"],["18",[["καὶ",2,8],["ταύτην",16,234],["τὴν",1,9],["φωνὴν",95,10],["ἡμεῖς",9994,208],["ἠκούσαμεν",54,285],["ἐξ",21,1],["οὐρανοῦ",94,21],["ἐνεχθεῖσαν",199,417],["σὺν",310,1],["αὐτῷ",3,49],["ὄντες",10,137],["ἐν",4,1],["τῷ",1,52],["ἁγίῳ",75,34],["ὄρει",87,53]],"We heard this voice come out of heaven when we were with him on the holy mountain."],["19",[["Καὶ",2,8],["ἔχομεν",124,241],["βεβαιότερον",3796,59],["τὸν",1,6],["προφητικὸν",10928,59],["λόγον",48,7],["ᾧ",24,202],["καλῶς",1273,17],["ποιεῖτε",23,84],["προσέχοντες",558,137],["ὡς",36,12],["λύχνῳ",1059,113],["φαίνοντι",832,390],["ἐν",4,1],["αὐχμηρῷ",11412,111],["τόπῳ",99,113],["ἕως",42,1],["οὗ",24,367],["ἡμέρα",28,13],["διαυγάσῃ",56,160],["καὶ",2,8],["φωσφόρος",11413,16],["ἀνατείλῃ",900,160],["ἐν",4,1],["ταῖς",1,70],["καρδίαις",64,71],["ὑμῶν",5,136]],"We have the more sure word of prophecy; and you do well that you heed it as to a lamp shining in a dark place, until the day dawns and the morning star arises in your hearts,"],["20",[["τοῦτο",16,122],["πρῶτον",315,29],["γινώσκοντες",79,137],["ὅτι",19,8],["πᾶσα",11,15],["προφητεία",2285,13],["γραφῆς",1505,19],["ἰδίας",683,78],["ἐπιλύσεως",11414,19],["οὐ",12,12],["γίνεται",30,728]],"knowing this first, that no prophecy of Scripture is of private interpretation."],["21",[["οὐ",12,12],["γὰρ",40,8],["θελήματι",1039,53],["ἀνθρώπου",43,21],["ἠνέχθη",199,38],["προφητεία",2285,13],["ποτέ",458,12],["ἀλλ᾽",108,8],["ὑπὸ",122,1],["πνεύματος",168,24],["ἁγίου",75,88],["φερόμενοι",199,772],["ἐλάλησαν",50,141],["ἀπὸ",17,1],["θεοῦ",20,21],["ἄνθρωποι",43,51]],"For no prophecy ever came by the will of man, but holy men of God spoke, being moved by the Holy Spirit."]]