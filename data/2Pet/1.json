[["1",[["Συμεὼν",934,5],["Πέτρος",5457,5],["δοῦλος",136,5],["καὶ",2,8],["ἀπόστολος",10080,5],["Ἰησοῦ",211,21],["Χριστοῦ",1072,21],["τοῖς",1,138],["ἰσότιμον",11407,37],["ἡμῖν",9994,86],["λαχοῦσιν",4880,461],["πίστιν",887,10],["ἐν",4,1],["δικαιοσύνῃ",187,2],["τοῦ",1,30],["θεοῦ",20,21],["ἡμῶν",9994,136],["καὶ",2,8],["σωτῆρος",1388,21],["Ἰησοῦ",211,21],["Χριστοῦ",1072,21]],"Simon Peter, a servant and apostle of Jesus Christ, to those who have obtained a like precious faith with us in the righteousness of our God and Savior, Jesus Christ:"],["2",[["Χάρις",368,13],["ὑμῖν",5,86],["καὶ",2,8],["εἰρήνη",213,13],["πληθυνθείη",316,544],["ἐν",4,1],["ἐπιγνώσει",3449,2],["τοῦ",1,30],["θεοῦ",20,21],["καὶ",2,8],["Ἰησοῦ",211,21],["τοῦ",1,30],["κυρίου",7,21],["ἡμῶν",9994,136]],"Grace to you and peace be multiplied in the knowledge of God and of Jesus our Lord,"],["3",[["ὡς",36,12],["πάντα",11,65],["ἡμῖν",9994,86],["τῆς",1,18],["θείας",1343,78],["δυνάμεως",98,19],["αὐτοῦ",3,48],["τὰ",1,42],["πρὸς",15,1],["ζωὴν",216,10],["καὶ",2,8],["εὐσέβειαν",895,10],["δεδωρημένης",4762,477],["διὰ",56,1],["τῆς",1,18],["ἐπιγνώσεως",3449,19],["τοῦ",1,30],["καλέσαντος",128,513],["ἡμᾶς",9994,209],["ἰδίᾳ",683,96],["δόξῃ",141,2],["καὶ",2,8],["ἀρετῇ",1398,2]],"seeing that his divine power has granted to us all things that pertain to life and godliness, through the knowledge of him who called us by his own glory and virtue,"],["4",[["δι᾽",56,1],["ὧν",24,97],["τὰ",1,42],["τίμια",1189,74],["καὶ",2,8],["μέγιστα",66,74],["ἡμῖν",9994,86],["ἐπαγγέλματα",11408,43],["δεδώρηται",4762,687],["ἵνα",102,8],["διὰ",56,1],["τούτων",16,214],["γένησθε",30,746],["θείας",1343,78],["κοινωνοὶ",3562,51],["φύσεως",2974,19],["ἀποφυγόντες",9065,190],["τῆς",1,18],["ἐν",4,1],["τῷ",1,110],["κόσμῳ",743,113],["ἐν",4,1],["ἐπιθυμίᾳ",699,2],["φθορᾶς",3377,19]],"by which he has granted to us his precious and exceedingly great promises; that through these you may become partakers of the divine nature, having escaped from the corruption that is