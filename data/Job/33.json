[["1",[["Οὐ",12,17],["μὴν",295,12],["δὲ",14,12],["ἀλλὰ",107,17],["ἄκουσου",0,0],["Ἰὼβ",811,105],["τὰ",1,42],["ῥήματά",115,43],["μου",6,48],["καὶ",2,8],["λαλιὰν",1826,10],["ἐνωτίζου",1316,360],["μου",6,48]],"Howbeit hear, Job, my words, and hearken to my speech."],["2",[["γὰρ",40,12],["ἤνοιξα",621,147],["τὸ",1,32],["στόμα",123,33],["μου",6,48],["καὶ",2,8],["ἐλάλησεν",50,3],["ἡ",1,11],["γλῶσσά",385,13],["μου",6,48]],"For behold, I have opened my mouth, and my tongue has spoken."],["3",[["Καθαρά",375,15],["μου",6,48],["ἡ",1,11],["καρδία",63,13],["ῥήμασι",115,92],["σύνεσις",467,13],["δὲ",14,12],["χειλέων",361,45],["μου",6,48],["καθαρὰ",375,74],["νοήσει",1384,120]],"My heart [shall be found] pure by [my] words; and the understanding of my lips shall meditate purity."],["4",[["Πνεῦμα",167,20],["θεῖον",1340,28],["τὸ",1,27],["ποιῆσάν",23,221],["με",6,82],["πνοὴ",1637,13],["δὲ",14,12],["παντοκράτορος",338,21],["ἡ",1,11],["διδάσκουσά",543,181],["με",6,82]],"The Divine Spirit is that which formed me, and the breath of the Almighty that which teaches me."],["5",[["Ἐὰν",45,8],["δύνῃ",184,407],["δός",33,198],["μοι",6,49],["ἀπόκρισιν",2415,10],["πρὸς",15,1],["ταῦτα",16,249],["ὑπόμεινον",635,198],["στῆθι",78,198],["κατʼ",32,1],["ἐμὲ",6,82],["καὶ",2,8],["ἐγὼ",6,158],["κατὰ",32,1],["σέ",5,161]],"If thou canst, give me an answer: wait therefore; stand against me, and I [will stand] against thee."],["6",[["Ἐκ",21,1],["πηλοῦ",1386,21],["διήρτισαι",0,0],["σὺ",5,156],["ὡς",36,8],["καὶ",2,8],["ἐγὼ",6,158],["ἐκ",21,1],["τοῦ",1,30],["αὐτοῦ",3,48],["διηρτίσμεθα",7050,393]],"Thou art formed out of the clay as also I: we have been formed out of the same [substance]."],["7",[["Οὐχ",12,17],["ὁ",1,4],["φόβος",330,5],["μου",6,48],["σὲ",5,161],["στροβήσει",4416,120],["οὐδὲ",105,12],["ἡ",1,11],["χείρ",37,13],["μου",6,48],["βαρεῖα",1028,15],["ἔσται",10,89],["ἐπὶ",9,1],["σοί",5,151]],"My fear shall not terrify thee, neither shall my hand be heavy upon thee."],["8",[["Πλὴν",257,1],["εἶπας",18,154],["ἐν",4,1],["ὠσί",325,92],["μου",6,48],["φωνὴν",95,10],["ῥημάτων",115,45],["σου",5,146],["ἀκήκοα",53,85]],"But thou hast said in mine ears, (I have heard the voice of thy words;) because thou sayest, I am pure, not having sinned;"],["9",[["διότι",176,8],["λέγεις",31,145],["καθαρός",375,16],["εἰμι",10,149],["οὐχ",12,17],["ἁμαρτών",244,155],["ἄμεμπτός",2141,16],["εἰμι",10,149],["οὐ",12,17],["γὰρ",40,12],["ἠνόμησα",1427,147]],"I am blameless, for I have not transgressed."],["10",[["Μέμψιν",4331,10],["δὲ",14,12],["κατʼ",32,1],["ἐμοῦ",6,48],["εὗρεν",106,3],["ἥγηται",374,703],["δέ",14,12],["με",6,82],["ὥσπερ",221,17],["ὑπεναντίον",1177,59]],"Yet he has discovered a charge against me, and he has reckoned me as an adversary."],["11",[["Ἔθετο",109,26],["δὲ",14,12],["ἐν",4,1],["ξύλῳ",196,53],["τὸν",1,6],["πόδα",208,7],["μου",6,48],["ἐφύλαξε",127,3],["δέ",14,12],["μου",6,48],["πάσας",11,109],["τὰς",1,39],["ὁδούς",67,40]],"And he has put my foot in the stocks, and has watched all my ways."],["12",[["Πῶς",440,12],["γὰρ",40,12],["λέγεις",31,145],["δίκαιός",152,16],["εἰμι",10,149],["καὶ",2,8],["οὐκ",12,17],["ἐπακήκοέ",595,165],["μου",6,48],["αἰώνιος",388,15],["γάρ",40,12],["ἐστιν",10,87],["ὁ",1,4],["ἐπάνω",490,17],["βροτῶν",2019,77]],"For how sayest thou, I am righteous, yet he has not hearkened to me? for he that is above mortals is eternal."],["13",[["Λέγεις",31,145],["δέ",14,12],["διατί",962,105],["τῆς",1,18],["δίκης",1224,19],["μου",6,83],["οὐκ",12,17],["ἐπακήκοέ",595,165],["μου",6,48],["πᾶν",11,29],["ῥῆμα",115,33]],"But thou sayest, Why has he not heard every word of my cause?"],["14",[["Ἐν",4,1],["γὰρ",40,12],["τῷ",1,110],["ἅπαξ",1315,17],["λαλήσαι",50,276],["ὁ",1,4],["Κύριος",7,5],["ἐν",4,1],["δὲ",14,12],["τῷ",1,110],["δευτέρῳ",270,111]],"For when the Lord speaks once, or a second time,"],["15",[["ἐνύπνιον",647,20],["ἢ",60,8],["ἐν",4,1],["μελέτῃ",2284,2],["νυκτερινῇ",3606,96],["ὡς",36,8],["ὅταν",318,8],["ἐπιπίπτῃ",995,166],["δεινὸς",2269,16],["φόβος",330,5],["ἐπʼ",9,1],["ἀνθρώπους",43,31],["ἐπὶ",9,1],["νυσταγμάτων",7838,45],["ἐπὶ",9,1],["κοίτης",705,19]],"[sending] a dream, or in the meditation of the night; (as when a dreadful alarm happens to fall upon men, in slumberings on the bed:)"],["16",[["Τότε",250,17],["ἀνακαλύπτει",1991,87],["νοῦν",1443,7],["ἀνθρώπων",43,77],["ἐν",4,1],["εἴδεσι",825,92],["φόβου",330,21],["τοιούτοις",629,300],["αὐτοὺς",3,60],["ἐξεφόβησεν",2235,3]],"then opens he the understanding of men: he scares them with such fearful visions:"],["17",[["Ἀποστρέψαι",130,100],["ἄνθρωπον",43,7],["ἀπὸ",17,1],["ἀδικίας",288,19],["τὸ",1,32],["δὲ",14,12],["σῶμα",451,33],["αὐτοῦ",3,144],["ἀπὸ",17,1],["πτώματος",1738,24],["ἐῤῥύσατο",335,26]],"to turn a man from unrighteousness, and he delivers his body from a fall."],["18",[["Ἐφείσατο",607,26],["δὲ",14,12],["τῆς",1,18],["ψυχῆς",62,19],["αὐτοῦ",3,48],["ἀπὸ",17,1],["θανάτου",169,21],["καὶ",2,8],["μὴ",25,8],["πεσεῖν",154,100],["αὐτὸν",3,82],["ἐν",4,1],["πολέμῳ",163,113]],"He spares also his soul from death, and [suffers] him not to fall in war."],["19",[["Πάλιν",649,17],["δὲ",14,12],["ἤλεγξεν",750,3],["αὐτὸν",3,82],["ἐπὶ",9,1],["μαλακίᾳ",2281,179],["ἐπὶ",9,1],["κοίτης",705,19],["καὶ",2,8],["πλῆθος",199,20],["ὀστῶν",472,45],["αὐτοῦ",3,48],["ἐνάρκησε",4333,3]],"And again, he chastens him with sickness on his bed, and the multitude of his bones is benumbed."],["20",[["Πᾶν",11,29],["δὲ",14,12],["βρωτὸν",4736,29],["σίτου",660,21],["οὐ",12,17],["μὴ",25,8],["δύνηται",184,301],["προσδέξασθαι",1018,103],["καὶ",2,8],["ἡ",1,11],["ψυχὴ",62,13],["αὐτοῦ",3,48],["βρῶσιν",1243,10],["ἐπιθυμήσει",916,120]],"And he shall not be able to take any food, though his soul shall desire meat;"],["21",[["ἕως",42,8],["ἂν",82,12],["σαπῶσιν",3150,267],["αὐτοῦ",3,48],["αἱ",1,183],["σάρκες",287,179],["καὶ",2,8],["ἀποδείξῃ",3176,116],["τὰ",1,42],["ὀστᾶ",472,43],["αὐτοῦ",3,48],["κένα",779,65]],"until his flesh shall be consumed, and he shall shew his bones bare."],["22",[["Ἤγγισε",0,0],["δὲ",14,12],["εἰς",8,1],["θάνατον",169,7],["ἡ",1,11],["ψυχὴ",62,13],["αὐτοῦ",3,48],["ἡ",1,11],["δὲ",14,12],["ζωὴ",212,13],["αὐτοῦ",3,48],["ἐν",4,1],["ᾅδῃ",583,113]],"His soul also draws nigh to death, and his life is in Hades."],["23",[["Ἐὰν",45,8],["ὦσι",10,266],["χιλιοι",579,130],["αγγελοι",0,0],["θανατηφόροι",4250,130],["εἷς",57,16],["αὐτῶν",3,41],["οὐ",12,17],["μὴ",25,8],["τρώσῃ",1919,116],["αὐτόν",3,82],["ἐὰν",45,8],["νοήσῃ",1384,116],["τῇ",1,95],["καρδίᾳ",63,2],["ἐπιστραφῆναι",116,174],["πρὸς",15,1],["Κύριον",7,7],["ἀναγγείλῃ",228,160],["δὲ",14,12],["ἀνθρώπῳ",43,113],["τὴν",1,9],["ἑαυτοῦ",92,48],["μέμψιν",4331,10],["τὴν",1,9],["δὲ",14,12],["ἄνοιαν",2419,10],["αὐτοῦ",3,48],["δείξῃ",860,116]],"Though there should be a thousand messengers of death, not one of them shall wound him: if he should purpose in his heart to turn to the Lord, and declare to man his fault, and shew his folly;"],["24",[["ἀνθέξεται",1851,89],["τοῦ",1,30],["μὴ",25,8],["πεσεῖν",154,100],["εἰς",8,1],["θάνατον",169,7],["ἀνανεώσει",2994,120],["δὲ",14,12],["αὐτοῦ",3,48],["τὸ",1,32],["σῶμα",451,33],["ὥσπερ",221,17],["ἀλοιφὴν",4517,10],["ἐπὶ",9,1],["τοίχου",710,21],["τὰ",1,42],["δὲ",14,12],["ὀστᾶ",472,43],["αὐτοῦ",3,48],["ἐμπλήσει",424,120],["μυελοῦ",4941,21]],"he will support him, that he should not perish, and will restore his body as [fresh] plaster upon a wall; and he will fill his bones with marrow."],["25",[["Ἁπαλυνεῖ",5285,120],["δὲ",14,12],["αὐτοῦ",3,48],["τὰς",1,39],["σάρκας",287,40],["ὥσπερ",221,17],["νηπίου",1015,153],["ἀποκαταστήσει",1150,120],["δὲ",14,12],["αὐτὸν",3,82],["ἀνδρωθέντα",6303,483],["ἐν",4,1],["ἀνθρώποις",43,139]],"And he will make his flesh tender as that of a babe, and he will restore him among men in [his] full strength."],["26",[["Εὐξάμενος",666,245],["δὲ",14,12],["πρὸς",15,1],["Κύριον",7,7],["καὶ",2,8],["δεκτὰ",1336,74],["αὐτῷ",3,49],["ἔσται",10,89],["εἰσελεύσεται",88,89],["προσώπῳ",47,53],["ἱλαρῷ",3218,34],["σὺν",309,1],["ἐξηγορίᾳ",6509,2],["ἀποδώσει",311,120],["δὲ",14,12],["ἀνθρώποις",43,139],["δικαιοσύνην",185,10]],"And he shall pray to the Lord, and his prayer shall be accepted of him; he shall enter with a cheerful countenance, with a full expression [of praise]: for he will render to men [their] due."],["27",[["Εἶτα",2457,17],["τότε",250,17],["ἀπομέμψεται",9093,89],["ἄνθρωπος",43,5],["αὐτὸς",3,158],["ἑαυτῷ",92,49],["λέγων",31,67],["οἷα",2036,63],["συνετέλουν",316,129],["καὶ",2,8],["οὐκ",12,17],["ἄξια",1104,65],["ἤτασέ",2241,3],["με",6,82],["ὧν",24,97],["ἥμαρτον",244,147]],"Even then a man shall blame himself, saying, What kind of things have I done? and he has not punished me according to the full amount of my sins."],["28",[["Σῶσον",171,198],["ψυχήν",62,10],["μου",6,48],["τοῦ",1,30],["μὴ",25,8],["ἐλθεῖν",56,100],["εἰς",8,1],["διαφθορὰν",1672,10],["καὶ",2,8],["ἡ",1,11],["ζωή",212,13],["μου",6,48],["φῶς",376,20],["ὄψεται",111,89]],"Deliver my soul, that it may not go to destruction, and my life shall see the light."],["29",[["Ἰδοὺ",51,17],["ταῦτα",16,249],["πάντα",11,65],["ἐργᾶται",468,399],["ὁ",1,4],["ἰσχυρὸς",398,16],["ὁδοὺς",67,40],["τρεῖς",173,109],["μετὰ",29,1],["ἀνδρός",38,21]],"Behold, all these things the Mighty One works in a threefold manner with a man."],["30",[["Καὶ",2,8],["ἐῤῥύσατο",335,26],["τὴν",1,9],["ψυχήν",62,10],["μου",6,48],["ἐκ",21,1],["θανάτου",169,21],["ἵνα",101,8],["ἡ",1,11],["ζωή",212,13],["μου",6,48],["ἐν",4,1],["φωτὶ",376,113],["αἰνῇ",399,166],["αὐτόν",3,82]],"And he has delivered my soul from death, that my life may praise him in the light."],["31",[["Ἐνωτίζου",1316,360],["Ἰὼβ",811,105],["καὶ",2,8],["ἄκουέ",53,239],["μου",6,48],["κώφευσον",2598,243],["καὶ",2,8],["ἐγώ",6,158],["εἰμι",10,149],["λαλήσω",50,157]],"Hearken, Job, and hear me: be silent, and I will speak."],["32",[["Εἰ",77,8],["εἰσί",10,189],["σοι",5,151],["λόγοι",48,51],["ἀποκρίθητί",229,242],["μοι",6,49],["λάλησον",50,243],["θέλω",609,149],["γὰρ",40,12],["δικαιωθῆναί",1134,174],["σε",5,161]],"If thou hast words, answer me: speak, for I desire thee to be justified."],["33",[["Εἰ",77,8],["μὴ",25,8],["σὺ",5,156],["ἄκουσόν",53,198],["μου",6,48],["κώφευσον",2598,243],["καὶ",2,8],["διδάξω",543,157],["σε",5,161]],"If not, do thou hear me: be silent, and I will teach thee."]]