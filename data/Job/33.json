[["1",[["Οὐ",12,17],["μὴν",296,12],["δὲ",14,12],["ἀλλὰ",108,17],["ἄκουσου",0,0],["Ἰὼβ",813,105],["τὰ",1,42],["ῥήματά",116,43],["μου",6,48],["καὶ",2,8],["λαλιὰν",1824,10],["ἐνωτίζου",1316,355],["μου",6,48]],"Howbeit hear, Job, my words, and hearken to my speech."],["2",[["γὰρ",40,12],["ἤνοιξα",362,147],["τὸ",1,32],["στόμα",123,33],["μου",6,48],["καὶ",2,8],["ἐλάλησεν",50,3],["ἡ",1,11],["γλῶσσά",388,13],["μου",6,48]],"For behold, I have opened my mouth, and my tongue has spoken."],["3",[["Καθαρά",379,15],["μου",6,48],["ἡ",1,11],["καρδία",64,13],["ῥήμασι",116,92],["σύνεσις",469,13],["δὲ",14,12],["χειλέων",361,45],["μου",6,48],["καθαρὰ",379,74],["νοήσει",1383,120]],"My heart [shall be found] pure by [my] words; and the understanding of my lips shall meditate purity."],["4",[["Πνεῦμα",168,20],["θεῖον",1343,28],["τὸ",1,27],["ποιῆσάν",23,267],["με",6,82],["πνοὴ",1637,13],["δὲ",14,12],["παντοκράτορος",340,21],["ἡ",1,11],["διδάσκουσά",545,183],["με",6,82]],"The Divine Spirit is that which formed me, and the breath of the Almighty that which teaches me."],["5",[["Ἐὰν",45,8],["δύνῃ",185,401],["δός",33,198],["μοι",6,49],["ἀπόκρισιν",2406,10],["πρὸς",15,1],["ταῦτα",16,248],["ὑπόμεινον",639,198],["στῆθι",78,198],["κατʼ",32,1],["ἐμὲ",6,82],["καὶ",2,8],["ἐγὼ",6,158],["κατὰ",32,1],["σέ",5,161]],"If thou canst, give me an answer: wait therefore; stand against me, and I [will stand] against thee."],["6",[["Ἐκ",21,1],["πηλοῦ",1386,21],["διήρτισαι",5562,334],["σὺ",5,156],["ὡς",36,8],["καὶ",2,8],["ἐγὼ",6,158],["ἐκ",21,1],["τοῦ",1,30],["αὐτοῦ",3,48],["διηρτίσμεθα",5562,388]],"Thou art formed out of the clay as also I: we have been formed out of the same [substance]."],["7",[["Οὐχ",12,17],["ὁ",1,4],["φόβος",333,5],["μου",6,48],["σὲ",5,161],["στροβήσει",4398,120],["οὐδὲ",106,12],["ἡ",1,11],["χείρ",37,13],["μου",6,48],["βαρεῖα",1031,15],["ἔσται",10,89],["ἐπὶ",9,1],["σοί",5,151]],"My fear shall not terrify thee, neither shall my hand be heavy upon thee."],["8",[["Πλὴν",257,1],["εἶπας",18,154],["ἐν",4,1],["ὠσί",328,92],["μου",6,48],["φωνὴν",95,10],["ῥημάτων",116,45],["σου",5,146],["ἀκήκοα",54,85]],"But thou hast said in mine ears, (I have heard the voice of thy words;) because thou sayest,",{"s":"r"}],["9",[["διότι",177,8],["λέγεις",31,145],["καθαρός",379,16],["εἰμι",10,149],["οὐχ",12,17],["ἁμαρτών",237,155],["ἄμεμπτός",2134,16],["εἰμι",10,149],["οὐ",12,17],["γὰρ",40,12],["ἠνόμησα",1426,147]],"I am pure, not having sinned; I am blameless, for I have not transgressed.",{"s":"r"}],["10",[["Μέμψιν",4317,10],["δὲ",14,12],["κατʼ",32,1],["ἐμοῦ",6,48],["εὗρεν",101,3],["ἥγηται",378,687],["δέ",14,12],["με",6,82],["ὥσπερ",226,17],["ὑπεναντίον",1177,59]],"Yet he has discovered a charge against me, and he has reckoned me as an adversary."],["11",[["Ἔθετο",110,26],["δὲ",14,12],["ἐν",4,1],["ξύλῳ",196,53],["τὸν",1,6],["πόδα",210,7],["μου",6,48],["ἐφύλαξε",125,3],["δέ",14,12],["μου",6,48],["πάσας",11,109],["τὰς",1,39],["ὁδούς",68,40]],"And he has put my foot in the stocks, and has watched all my ways."],["12",[["Πῶς",441,12],["γὰρ",40,12],["λέγεις",31,145],["δίκαιός",153,16],["εἰμι",10,149],["καὶ",2,8],["οὐκ",12,17],["ἐπακήκοέ",597,165],["μου",6,48],["αἰώνιος",391,15],["γάρ",40,12],["ἐστιν",10,87],["ὁ",1,4],["ἐπάνω",491,17],["βροτῶν",2011,77]],"For how sayest thou, I am righteous, yet he has not hearkened to me? for he that is above mortals is eternal."],["13",[["Λέγεις",31,145],["δέ",14,12],["διατί",960,105],["τῆς",1,18],["δίκης",1219,19],["μου",6,83],["οὐκ",12,17],["ἐπακήκοέ",597,165],["μου",6,48],["πᾶν",11,29],["ῥῆμα",116,33]],"But thou sayest, Why has he not heard every word of my cause?"],["14",[["Ἐν",4,1],["γὰρ",40,12],["τῷ",1,110],["ἅπαξ",1315,17],["λαλήσαι",50,216],["ὁ",1,4],["Κύριος",7,5],["ἐν",4,1],["δὲ",14,12],["τῷ",1,110],["δευτέρῳ",271,111]],"For when the Lord speaks once, or a second time,"],["15",[["ἐνύπνιον",653,20],["ἢ",61,8],["ἐν",4,1],["μελέτῃ",2269,2],["νυκτερινῇ",3599,96],["ὡς",36,8],["ὅταν",319,8],["ἐπιπίπτῃ",995,166],["δεινὸς",2254,16],["φόβος",333,5],["ἐπʼ",9,1],["ἀνθρώπους",43,31],["ἐπὶ",9,1],["νυσταγμάτων",7782,45],["ἐπὶ",9,1],["κοίτης",704,19]],"[sending] a dream, or in the meditation of the night; (as when a dreadful alarm happens to fall upon men, in slumberings on the bed:)"],["16",[["Τότε",250,17],["ἀνακαλύπτει",1848,87],["νοῦν",1442,7],["ἀνθρώπων",43,77],["ἐν",4,1],["εἴδεσι",949,92],["φόβου",333,21],["τοιούτοις",630,296],["αὐτοὺς",3,60],["ἐξεφόβησεν",2221,3]],"then opens he the understanding of men: he scares them with such fearful visions:"],["17",[["Ἀποστρέψαι",130,100],["ἄνθρωπον",43,7],["ἀπὸ",17,1],["ἀδικίας",288,19],["τὸ",1,32],["δὲ",14,12],["σῶμα",454,33],["αὐτοῦ",3,144],["ἀπὸ",17,1],["πτώματος",1739,24],["ἐῤῥύσατο",337,26]],"to turn a man from unrighteousness, and he delivers his body from a fall."],["18",[["Ἐφείσατο",610,26],["δὲ",14,12],["τῆς",1,18],["ψυχῆς",63,19],["αὐτοῦ",3,48],["ἀπὸ",17,1],["θανάτου",170,21],["καὶ",2,8],["μὴ",25,8],["πεσεῖν",154,100],["αὐτὸν",3,82],["ἐν",4,1],["πολέμῳ",163,113]],"He spares also his soul from death, and [suffers] him not to fall in war."],["19",[["Πάλιν",655,17],["δὲ",14,12],["ἤλεγξεν",752,3],["αὐτὸν",3,82],["ἐπὶ",9,1],["μαλακίᾳ",2266,180],["ἐπὶ",9,1],["κοίτης",704,19],["καὶ",2,8],["πλῆθος",200,20],["ὀστῶν",473,45],["αὐτοῦ",3,48],["ἐνάρκησε",4319,3]],"And again, he chastens him with sickness on his bed, and the multitude of his bones is benumbed."],["20",[["Πᾶν",11,29],["δὲ",14,12],["βρωτὸν",4711,29],["σίτου",665,21],["οὐ",12,17],["μὴ",25,8],["δύνηται",185,297],["προσδέξασθαι",1019,103],["καὶ",2,8],["ἡ",1,11],["ψυχὴ",63,13],["αὐτοῦ",3,48],["βρῶσιν",1241,10],["ἐπιθυμήσει",915,120]],"And he shall not be able to take any food, though his soul shall desire meat;"],["21",[["ἕως",42,8],["ἂν",83,12],["σαπῶσιν",3142,266],["αὐτοῦ",3,48],["αἱ",1,185],["σάρκες",287,180],["καὶ",2,8],["ἀποδείξῃ",3168,116],["τὰ",1,42],["ὀστᾶ",473,43],["αὐτοῦ",3,48],["κένα",780,65]],"until his flesh shall be consumed, and he shall shew his bones bare."],["22",[["Ἤγγισε",0,0],["δὲ",14,12],["εἰς",8,1],["θάνατον",170,7],["ἡ",1,11],["ψυχὴ",63,13],["αὐτοῦ",3,48],["ἡ",1,11],["δὲ",14,12],["ζωὴ",216,13],["αὐτοῦ",3,48],["ἐν",4,1],["ᾅδῃ",586,113]],"His soul also draws nigh to death, and his life is in Hades."],["23",[["Ἐὰν",45,8],["ὦσι",10,265],["χιλιοι",582,130],["αγγελοι",208,0],["θανατηφόροι",4237,130],["εἷς",58,16],["αὐτῶν",3,41],["οὐ",12,17],["μὴ",25,8],["τρώσῃ",1917,116],["αὐτόν",3,82],["ἐὰν",45,8],["νοήσῃ",1383,116],["τῇ",1,95],["καρδίᾳ",64,2],["ἐπιστραφῆναι",117,175],["πρὸς",15,1],["Κύριον",7,7],["ἀναγγείλῃ",231,160],["δὲ",14,12],["ἀνθρώπῳ",43,113],["τὴν",1,9],["ἑαυτοῦ",92,48],["μέμψιν",4317,10],["τὴν",1,9],["δὲ",14,12],["ἄνοιαν",2412,10],["αὐτοῦ",3,48],["δείξῃ",860,116]],"Though there should be a thousand messengers of death, not one of them shall wound him: if he should purpose in his heart to turn to the Lord, and declare to man his fault, and shew his folly;"],["24",[["ἀνθέξεται",1852,89],["τοῦ",1,30],["μὴ",25,8],["πεσεῖν",154,100],["εἰς",8,1],["θάνατον",170,7],["ἀνανεώσει",2981,120],["δὲ",14,12],["αὐτοῦ",3,48],["τὸ",1,32],["σῶμα",454,33],["ὥσπερ",226,17],["ἀλοιφὴν",4493,10],["ἐπὶ",9,1],["τοίχου",709,21],["τὰ",1,42],["δὲ",14,12],["ὀστᾶ",473,43],["αὐτοῦ",3,48],["ἐμπλήσει",427,120],["μυελοῦ",4916,21]],"he will support him, that he should not perish, and will restore his body as [fresh] plaster upon a wall; and he will fill his bones with marrow."],["25",[["Ἁπαλυνεῖ",5254,120],["δὲ",14,12],["αὐτοῦ",3,48],["τὰς",1,39],["σάρκας",287,40],["ὥσπερ",226,17],["νηπίου",1016,153],["ἀποκαταστήσει",1149,120],["δὲ",14,12],["αὐτὸν",3,82],["ἀνδρωθέντα",6272,474],["ἐν",4,1],["ἀνθρώποις",43,139]],"And he will make his flesh tender as that of a babe, and he will restore him among men in [his] full strength."],["26",[["Εὐξάμενος",670,244],["δὲ",14,12],["πρὸς",15,1],["Κύριον",7,7],["καὶ",2,8],["δεκτὰ",1340,74],["αὐτῷ",3,49],["ἔσται",10,89],["εἰσελεύσεται",86,89],["προσώπῳ",47,53],["ἱλαρῷ",3212,34],["σὺν",310,1],["ἐξηγορίᾳ",6475,2],["ἀποδώσει",312,120],["δὲ",14,12],["ἀνθρώποις",43,139],["δικαιοσύνην",187,10]],"And he shall pray to the Lord, and his prayer shall be accepted of him; he shall enter with a cheerful countenance, with a full expression [of praise]: for he will render to men [their] due."],["27",[["Εἶτα",2450,17],["τότε",250,17],["ἀπομέμψεται",9025,89],["ἄνθρωπος",43,5],["αὐτὸς",3,158],["ἑαυτῷ",92,49],["λέγων",31,67],["οἷα",2031,63],["συνετέλουν",317,129],["καὶ",2,8],["οὐκ",12,17],["ἄξια",1102,65],["ἤτασέ",2227,3],["με",6,82],["ὧν",24,97],["ἥμαρτον",237,147]],"Even then a man shall blame himself, saying, What kind of things have I done? and he has not punished me according to the full amount of my sins."],["28",[["Σῶσον",172,198],["ψυχήν",63,10],["μου",6,48],["τοῦ",1,30],["μὴ",25,8],["ἐλθεῖν",55,100],["εἰς",8,1],["διαφθορὰν",1671,10],["καὶ",2,8],["ἡ",1,11],["ζωή",216,13],["μου",6,48],["φῶς",380,20],["ὄψεται",112,89]],"Deliver my soul, that it may not go to destruction, and my life shall see the light."],["29",[["Ἰδοὺ",51,17],["ταῦτα",16,248],["πάντα",11,65],["ἐργᾶται",467,394],["ὁ",1,4],["ἰσχυρὸς",401,16],["ὁδοὺς",68,40],["τρεῖς",174,109],["μετὰ",29,1],["ἀνδρός",38,21]],"Behold, all these things the Mighty One works in a threefold manner with a man."],["30",[["Καὶ",2,8],["ἐῤῥύσατο",337,26],["τὴν",1,9],["ψυχήν",63,10],["μου",6,48],["ἐκ",21,1],["θανάτου",170,21],["ἵνα",102,8],["ἡ",1,11],["ζωή",216,13],["μου",6,48],["ἐν",4,1],["φωτὶ",380,113],["αἰνῇ",402,166],["αὐτόν",3,82]],"And he has delivered my soul from death, that my life may praise him in the light."],["31",[["Ἐνωτίζου",1316,355],["Ἰὼβ",813,105],["καὶ",2,8],["ἄκουέ",54,239],["μου",6,48],["κώφευσον",2594,198],["καὶ",2,8],["ἐγώ",6,158],["εἰμι",10,149],["λαλήσω",50,157]],"Hearken, Job, and hear me: be silent, and I will speak."],["32",[["Εἰ",77,8],["εἰσί",10,191],["σοι",5,151],["λόγοι",48,51],["ἀποκρίθητί",234,242],["μοι",6,49],["λάλησον",50,198],["θέλω",612,149],["γὰρ",40,12],["δικαιωθῆναί",1115,175],["σε",5,161]],"If thou hast words, answer me: speak, for I desire thee to be justified."],["33",[["Εἰ",77,8],["μὴ",25,8],["σὺ",5,156],["ἄκουσόν",54,198],["μου",6,48],["κώφευσον",2594,198],["καὶ",2,8],["διδάξω",545,157],["σε",5,161]],"If not, do thou hear me: be silent, and I will teach thee."]]