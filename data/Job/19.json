[["1",[["Ὑπολαβὼν",1009,155],["δὲ",14,12],["Ἰὼβ",813,105],["λέγει",31,87]],"Then Job answered and said,"],["2",[["Ἕως",42,8],["τίνος",39,304],["ἔγκοπον",5354,37],["ποιήσετε",23,348],["ψυχήν",63,10],["μου",6,48],["καὶ",2,8],["καθαιρεῖτέ",602,84],["με",6,82],["λόγοις",48,139],["γνῶτε",79,118],["μόνον",302,29],["ὅτι",19,8],["ὁ",1,4],["Κύριος",7,5],["ἐποίησέ",23,3],["με",6,82],["οὕτως",71,17]],"How long will ye vex my soul, and destroy me with words? only know that the Lord has dealt with me thus."],["3",[["Καταλαλεῖτέ",2356,84],["μου",6,48],["οὐκ",12,17],["αἰσχυνόμενοί",611,351],["με",6,82],["ἐπίκεισθέ",3748,68],["μοι",6,49]],"Ye speak against me; ye do not feel for me, but bear hard upon me."],["4",[["Ναὶ",3597,17],["δὴ",193,12],["ἐπʼ",9,1],["ἀληθείας",352,19],["ἐγὼ",6,158],["ἐπλανήθην",464,94],["παρʼ",73,1],["ἐμοὶ",6,49],["δὲ",14,12],["αὐλίζεται",990,108],["πλάνος",5953,16]],"Yea verily, I have erred in truth, (but the error abides with myself)"],["4a",[["λαλῆσαι",50,100],["ῥῆματα",0,0],["ἃ",1,11],["οὐκ",12,17],["ἔδει",1158,14],["τὰ",1,42],["δὲ",14,12],["ῥήματά",116,43],["μου",6,48],["πλανᾶται",464,108],["καὶ",2,8],["οὐκ",12,17],["ἐπὶ",9,1],["καιροῦ",132,21]],"in having spoken words which it was not right [to speak]; and my words err, and are unseasonable."],["5",[["Ἔα",10,293],["δὲ",14,12],["ὅτι",19,8],["ἐπʼ",9,1],["ἐμοὶ",6,49],["μεγαλύνεσθε",604,68],["ἐνάλλεσθε",3736,383],["δέ",14,12],["μοι",6,49],["ὀνείδει",973,134]],"But alas! for ye magnify yourselves against me, and insult me with reproach."],["6",[["Γνῶτε",79,118],["οὖν",227,12],["ὅτι",19,8],["Κύριός",7,5],["ἐστιν",10,87],["ὁ",1,4],["ταράξας",508,155],["ὀχύρωμα",775,20],["δὲ",14,12],["αὐτοῦ",3,48],["ἐπʼ",9,1],["ἐμὲ",6,82],["ὕψωσεν",331,3]],"Know then that it is the Lord that has troubled [me], and has raised his bulwark against me."],["7",[["Ἰδοὺ",51,17],["γελῶ",2071,149],["ὀνείδει",973,134],["οὐ",12,17],["λαλήσω",50,157],["κεκράξομαι",592,177],["καὶ",2,8],["οὐδαμοῦ",4334,17],["κρίμα",267,33]],"Behold, I laugh at reproach; I will not speak: [or] I will cry out, but [there is] nowhere judgment."],["8",[["Κύκλῳ",258,17],["περιῳκοδόμημαι",4354,324],["καὶ",2,8],["οὐ",12,17],["μὴ",25,8],["διαβῶ",466,227],["ἐπὶ",9,1],["πρόσωπόν",47,33],["μου",6,48],["σκότος",506,5],["ἔθετο",110,26]],"I am fenced round about, and can by no means escape: he has set darkness before my face."],["9",[["Τὴν",1,9],["δὲ",14,12],["δόξαν",141,10],["ἀπʼ",17,1],["ἐμοῦ",6,48],["ἐξέδυσεν",1488,3],["ἀφεῖλε",369,3],["δὲ",14,12],["στέφανον",980,7],["ἀπὸ",17,1],["κεφαλῆς",144,19],["μου",6,83]],"And he has stripped me of my glory, and has taken the crown from my head."],["10",[["Διέσπασέ",3049,3],["με",6,82],["κύκλῳ",258,17],["καὶ",2,8],["ᾠχόμην",1556,374],["ἐξέκοψε",1193,3],["δὲ",14,12],["ὥσπερ",226,17],["δένδρον",1342,20],["τὴν",1,9],["ἐλπίδα",530,10],["μου",6,48]],"He has torn me round about, and I am gone: and he has cut off my hope like a tree."],["11",[["Δεινῶς",3805,17],["δέ",14,12],["μοι",6,99],["ὀργῇ",198,2],["ἐχρήσατο",928,26],["ἡγήσατο",378,26],["δέ",14,12],["με",6,82],["ὥσπερ",226,17],["ἐχθρόν",135,7]],"And he has dreadfully handled me in anger, and has counted me for an enemy."],["12",[["Ὁμοθυμαδὸν",1262,17],["δὲ",14,12],["ἦλθον",55,141],["τὰ",1,42],["πειρατήρια",3920,43],["αὐτοῦ",3,48],["ἐπʼ",9,1],["ἐμοὶ",6,49],["ταῖς",1,70],["ὁδοῖς",68,71],["μου",6,48],["ἐκύκλωσαν",603,141],["ἐγκάθετοι",6414,130]],"His troops also came upon me with one accord, liers in wait compassed my ways."],["13",[["Ἀπʼ",17,1],["ἐμοῦ",6,48],["ἀδελφοί",67,51],["μου",6,48],["ἀπέστησαν",293,141],["ἔγνωσαν",79,141],["ἀλλοτρίους",381,58],["ἢ",61,8],["ἐμέ",6,82],["φίλοι",336,130],["δέ",14,12],["μου",6,48],["ἀνελεήμονες",2402,130],["γεγόνασιν",30,400]],"My brethren have stood aloof from me; they have recognised strangers [rather] than me: and my friends have become pitiless."],["14",[["Οὐ",12,17],["προσεποιήσαντό",5013,184],["με",6,82],["οἱ",1,128],["ἐγγύτατοί",6405,130],["μου",6,48],["καὶ",2,8],["οἱ",1,128],["εἰδότες",53,263],["μου",6,48],["τὸ",1,32],["ὄνομα",57,33],["ἐπελάθοντό",513,184],["μου",6,48]],"My nearest of kin have not acknowledged me, and they that knew my name, have forgotten me."],["15",[["Γείτονες",2072,51],["οἰκίας",233,19],["θεράπαιναί",3061,180],["τε",209,12],["μοῦ",6,48],["ἀλλογενὴς",1066,16],["ἤμην",10,429],["ἐναντίον",138,17],["αὐτῶν",3,41]],"[As for] my household, and my maid-servants, I was a stranger before them."],["16",[["Θεράποντά",804,7],["μου",6,48],["ἐκάλεσα",128,147],["καὶ",2,8],["οὐχ",12,17],["ὑπήκουσε",867,3],["στόμα",123,33],["δέ",14,12],["μου",6,48],["ἐδέετο",440,22]],"I called my servant, and he hearkened not; and my mouth intreated [him]."],["17",[["Καὶ",2,8],["ἱκέτευον",3018,129],["τὴν",1,9],["γυναῖκά",59,10],["μου",6,48],["προσεκαλούμην",1595,374],["δὲ",14,12],["καλακευων",0,0],["υἱοὺς",13,31],["παλλακίδων",7827,61],["μου",6,48]],"And I besought my wife, and earnestly intreated the sons of my concubines."],["18",[["Οἱ",1,128],["δὲ",14,12],["εἰς",8,1],["τὸν",1,6],["αἰῶνά",100,7],["με",6,82],["ἀπεποιήσαντο",3705,184],["ὅταν",319,8],["ἀναστῶ",121,227],["κατʼ",32,1],["ἐμοῦ",6,48],["λαλοῦσιν",50,191]],"But they rejected me for ever; whenever I rise up, they speak against me."],["19",[["Ἐβδελύξαντό",1056,430],["με",6,82],["οἱ",1,128],["ἰδόντες",53,190],["με",6,82],["οὓς",24,294],["δὴ",193,12],["ἠγαπήκειν",214,149],["ἐπανέστησάν",1216,141],["μοι",6,49]],"They that saw me abhorred me: the very persons whom I had loved, rose up against me."],["20",[["Ἐν",4,1],["δέρματί",669,53],["μου",6,48],["ἐσάπησαν",3142,94],["αἱ",1,185],["σάρκες",287,180],["μου",6,48],["τὰ",1,42],["δὲ",14,12],["ὀστᾶ",473,43],["μου",6,48],["ἐν",4,1],["ὀδοῦσιν",930,139],["ἔχεται",124,108]],"My flesh is corrupt under my skin, and my bones are held in [my] teeth."],["21",[["Ἐλεήσατέ",446,69],["με",6,82],["ἐλεήσατέ",446,69],["με",6,82],["ὦ",646,316],["φίλοι",336,130],["χεὶρ",37,13],["γὰρ",40,12],["Κυρίου",7,21],["ἡ",1,11],["ἁψαμένη",465,366],["μου",6,48],["ἐστί",10,87]],"Pity me, pity me, O friends; for it is the hand of the Lord that has touched me."],["22",[["Διατί",960,105],["με",6,82],["διώκετε",533,307],["ὥσπερ",226,17],["καὶ",2,8],["ὁ",1,4],["Κύριος",7,5],["ἀπὸ",17,1],["δὲ",14,12],["σαρκῶν",287,61],["μου",6,48],["οὐκ",12,17],["ἐμπίπλασθε",427,68]],"Wherefore do ye persecute me as also the Lord [does], and are not satisfied with my flesh?"],["23",[["Τίς",39,150],["γὰρ",40,12],["ἂν",83,12],["δοίη",33,216],["γραφῆναι",186,175],["τὰ",1,42],["ῥήματά",116,43],["μου",6,48],["τεθῆναι",110,175],["δὲ",14,12],["αὐτὰ",3,66],["ἐν",4,1],["βιβλίῳ",339,53],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7]],"For oh that my words were written, and that they were recorded in a book for ever,"],["24",[["ἐν",4,1],["γραφείῳ",6915,53],["σιδηρῷ",1063,34],["καὶ",2,8],["μολίβῳ",3305,113],["ἢ",61,8],["ἐν",4,1],["πέτραις",548,71],["ἐγγλυφῆναι",0,0]],"with an iron pen and lead, or graven in the rocks!"],["25",[["Οἶδα",53,85],["γὰρ",40,12],["ὅτι",19,8],["ἀένναός",3414,16],["ἐστιν",10,87],["ὁ",1,4],["ἐκλύειν",1194,54],["με",6,82],["μέλλων",1143,67]],"For I know that he is eternal who is about to deliver me,"],["26",[["ἐπὶ",9,1],["γῆς",26,19],["ἀναστῆσαι",121,100],["τὸ",1,32],["δέρμα",669,33],["μου",6,48],["τὸ",1,32],["ἀναντλοῦν",8860,47],["ταῦτα",16,248],["παρὰ",73,1],["γὰρ",40,12],["Κυρίου",7,21],["ταῦτά",16,335],["μοι",6,49],["συνετελέσθη",317,38]],"[and] to raise up upon the earth my skin that endures these [sufferings]: for these things have been accomplished to me of the Lord;"],["27",[["ἃ",1,11],["ἐγὼ",6,179],["ἐμαυτῷ",890,49],["συνεπίσταμαι",6114,251],["ἃ",1,11],["ὁ",1,4],["ὀφθαλμός",91,5],["μου",6,48],["ἑώρακε",112,165],["καὶ",2,8],["οὐκ",12,17],["ἄλλος",584,158],["πάντα",11,65],["δέ",14,12],["μοι",6,49],["συντετέλεσται",317,182],["ἐν",4,1],["κόλπῳ",1140,113]],"which I am conscious of in myself, which mine eye has seen, and not another, but all have been fulfilled to me in [my] bosom."],["28",[["Εἰ",77,8],["δὲ",14,12],["καὶ",2,8],["ἐρεῖτε",667,339],["τί",39,119],["ἐροῦμεν",165,269],["ἔναντι",232,17],["αὐτοῦ",3,48],["καὶ",2,8],["ῥίζαν",892,10],["λόγου",48,21],["εὑρήσομεν",101,269],["ἐν",4,1],["αὐτῷ",3,49]],"But if ye shall also say, What shall we say before him, and [so] find the root of the matter in him?"],["29",[["Εὐλαβήθητε",1271,353],["δὴ",193,12],["καὶ",2,8],["ὑμεῖς",5,208],["ἀπὸ",17,1],["ἐπικαλύμματος",4604,24],["θυμὸς",178,5],["γὰρ",40,12],["ἐπʼ",9,1],["ἀνόμους",536,58],["ἐπελεύσεται",542,89],["καὶ",2,8],["τότε",250,17],["γνώσονται",79,127],["ποῦ",478,17],["ἐστιν",10,87],["αὐτῶν",3,41],["ἡ",1,11],["ὕλη",3229,13]],"Do ye also beware of deceit: for wrath will come upon transgressors; and then shall they know where their substance is."]]