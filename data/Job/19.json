[["1",[["Ὑπολαβὼν",1009,155],["δὲ",14,12],["Ἰὼβ",811,105],["λέγει",31,87]],"Then Job answered and said,"],["2",[["Ἕως",42,8],["τίνος",39,308],["ἔγκοπον",5383,37],["ποιήσετε",23,352],["ψυχήν",62,10],["μου",6,48],["καὶ",2,8],["καθαιρεῖτέ",610,84],["με",6,82],["λόγοις",48,139],["γνῶτε",81,118],["μόνον",300,29],["ὅτι",19,8],["ὁ",1,4],["Κύριος",7,5],["ἐποίησέ",23,3],["με",6,82],["οὕτως",70,17]],"How long will ye vex my soul, and destroy me with words? only know that the Lord has dealt with me thus."],["3",[["Καταλαλεῖτέ",2365,84],["μου",6,48],["οὐκ",12,17],["αἰσχυνόμενοί",614,356],["με",6,82],["ἐπίκεισθέ",3760,68],["μοι",6,49]],"Ye speak against me; ye do not feel for me, but bear hard upon me."],["4",[["Ναὶ",3604,17],["δὴ",193,12],["ἐπʼ",9,1],["ἀληθείας",350,19],["ἐγὼ",6,158],["ἐπλανήθην",464,94],["παρʼ",72,1],["ἐμοὶ",6,49],["δὲ",14,12],["αὐλίζεται",991,108],["πλάνος",5983,16]],"Yea verily, I have erred in truth, (but the error abides with myself)"],["4a",[["λαλῆσαι",50,100],["ῥῆματα",0,0],["ἃ",1,11],["οὐκ",12,17],["ἔδει",1161,14],["τὰ",1,42],["δὲ",14,12],["ῥήματά",115,43],["μου",6,48],["πλανᾶται",464,108],["καὶ",2,8],["οὐκ",12,17],["ἐπὶ",9,1],["καιροῦ",132,21]],"in having spoken words which it was not right [to speak]; and my words err, and are unseasonable."],["5",[["Ἔα",10,297],["δὲ",14,12],["ὅτι",19,8],["ἐπʼ",9,1],["ἐμοὶ",6,49],["μεγαλύνεσθε",606,68],["ἐνάλλεσθε",3746,387],["δέ",14,12],["μοι",6,49],["ὀνείδει",973,134]],"But alas! for ye magnify yourselves against me, and insult me with reproach."],["6",[["Γνῶτε",81,118],["οὖν",223,12],["ὅτι",19,8],["Κύριός",7,5],["ἐστιν",10,87],["ὁ",1,4],["ταράξας",508,155],["ὀχύρωμα",772,20],["δὲ",14,12],["αὐτοῦ",3,48],["ἐπʼ",9,1],["ἐμὲ",6,82],["ὕψωσεν",327,3]],"Know then that it is the Lord that has troubled [me], and has raised his bulwark against me."],["7",[["Ἰδοὺ",51,17],["γελῶ",2077,149],["ὀνείδει",973,134],["οὐ",12,17],["λαλήσω",50,157],["κεκράξομαι",590,176],["καὶ",2,8],["οὐδαμοῦ",4349,17],["κρίμα",266,33]],"Behold, I laugh at reproach; I will not speak: [or] I will cry out, but [there is] nowhere judgment."],["8",[["Κύκλῳ",258,17],["περιῳκοδόμημαι",0,0],["καὶ",2,8],["οὐ",12,17],["μὴ",25,8],["διαβῶ",463,227],["ἐπὶ",9,1],["πρόσωπόν",47,33],["μου",6,48],["σκότος",503,5],["ἔθετο",109,26]],"I am fenced round about, and can by no means escape: he has set darkness before my face."],["9",[["Τὴν",1,9],["δὲ",14,12],["δόξαν",141,10],["ἀπʼ",17,1],["ἐμοῦ",6,48],["ἐξέδυσεν",1490,3],["ἀφεῖλε",367,3],["δὲ",14,12],["στέφανον",979,7],["ἀπὸ",17,1],["κεφαλῆς",144,19],["μου",6,83]],"And he has stripped me of my glory, and has taken the crown from my head."],["10",[["Διέσπασέ",3061,3],["με",6,82],["κύκλῳ",258,17],["καὶ",2,8],["ᾠχόμην",1555,380],["ἐξέκοψε",1237,3],["δὲ",14,12],["ὥσπερ",221,17],["δένδρον",1339,20],["τὴν",1,9],["ἐλπίδα",527,10],["μου",6,48]],"He has torn me round about, and I am gone: and he has cut off my hope like a tree."],["11",[["Δεινῶς",3818,17],["δέ",14,12],["μοι",6,99],["ὀργῇ",198,2],["ἐχρήσατο",927,26],["ἡγήσατο",374,26],["δέ",14,12],["με",6,82],["ὥσπερ",221,17],["ἐχθρόν",135,7]],"And he has dreadfully handled me in anger, and has counted me for an enemy."],["12",[["Ὁμοθυμαδὸν",1262,17],["δὲ",14,12],["ἦλθον",56,141],["τὰ",1,42],["πειρατήρια",3930,43],["αὐτοῦ",3,48],["ἐπʼ",9,1],["ἐμοὶ",6,49],["ταῖς",1,70],["ὁδοῖς",67,71],["μου",6,48],["ἐκύκλωσαν",600,141],["ἐγκάθετοι",6446,130]],"His troops also came upon me with one accord, liers in wait compassed my ways."],["13",[["Ἀπʼ",17,1],["ἐμοῦ",6,48],["ἀδελφοί",66,51],["μου",6,48],["ἀπέστησαν",514,141],["ἔγνωσαν",81,141],["ἀλλοτρίους",377,58],["ἢ",60,8],["ἐμέ",6,82],["φίλοι",334,130],["δέ",14,12],["μου",6,48],["ἀνελεήμονες",2411,130],["γεγόνασιν",30,406]],"My brethren have stood aloof from me; they have recognised strangers [rather] than me: and my friends have become pitiless."],["14",[["Οὐ",12,17],["προσεποιήσαντό",5042,182],["με",6,82],["οἱ",1,128],["ἐγγύτατοί",6435,130],["μου",6,48],["καὶ",2,8],["οἱ",1,128],["εἰδότες",73,264],["μου",6,48],["τὸ",1,32],["ὄνομα",55,33],["ἐπελάθοντό",512,182],["μου",6,48]],"My nearest of kin have not acknowledged me, and they that knew my name, have forgotten me."],["15",[["Γείτονες",2078,51],["οἰκίας",232,19],["θεράπαιναί",3073,179],["τε",207,12],["μοῦ",6,48],["ἀλλογενὴς",1067,16],["ἤμην",10,435],["ἐναντίον",138,17],["αὐτῶν",3,41]],"[As for] my household, and my maid-servants, I was a stranger before them."],["16",[["Θεράποντά",801,7],["μου",6,48],["ἐκάλεσα",128,147],["καὶ",2,8],["οὐχ",12,17],["ὑπήκουσε",868,3],["στόμα",123,33],["δέ",14,12],["μου",6,48],["ἐδέετο",439,22]],"I called my servant, and he hearkened not; and my mouth intreated [him]."],["17",[["Καὶ",2,8],["ἱκέτευον",3030,129],["τὴν",1,9],["γυναῖκά",58,10],["μου",6,48],["προσεκαλούμην",1596,380],["δὲ",14,12],["καλακευων",0,0],["υἱοὺς",13,31],["παλλακίδων",7885,61],["μου",6,48]],"And I besought my wife, and earnestly intreated the sons of my concubines."],["18",[["Οἱ",1,128],["δὲ",14,12],["εἰς",8,1],["τὸν",1,6],["αἰῶνά",100,7],["με",6,82],["ἀπεποιήσαντο",3711,182],["ὅταν",318,8],["ἀναστῶ",121,227],["κατʼ",32,1],["ἐμοῦ",6,48],["λαλοῦσιν",50,189]],"But they rejected me for ever; whenever I rise up, they speak against me."],["19",[["Ἐβδελύξαντό",1202,436],["με",6,82],["οἱ",1,128],["ἰδόντες",73,188],["με",6,82],["οὓς",24,298],["δὴ",193,12],["ἠγαπήκειν",224,149],["ἐπανέστησάν",1221,141],["μοι",6,49]],"They that saw me abhorred me: the very persons whom I had loved, rose up against me."],["20",[["Ἐν",4,1],["δέρματί",665,53],["μου",6,48],["ἐσάπησαν",3150,94],["αἱ",1,183],["σάρκες",287,179],["μου",6,48],["τὰ",1,42],["δὲ",14,12],["ὀστᾶ",472,43],["μου",6,48],["ἐν",4,1],["ὀδοῦσιν",929,139],["ἔχεται",124,108]],"My flesh is corrupt under my skin, and my bones are held in [my] teeth."],["21",[["Ἐλεήσατέ",457,69],["με",6,82],["ἐλεήσατέ",457,69],["με",6,82],["ὦ",641,320],["φίλοι",334,130],["χεὶρ",37,13],["γὰρ",40,12],["Κυρίου",7,21],["ἡ",1,11],["ἁψαμένη",462,369],["μου",6,48],["ἐστί",10,87]],"Pity me, pity me, O friends; for it is the hand of the Lord that has touched me."],["22",[["Διατί",962,105],["με",6,82],["διώκετε",530,311],["ὥσπερ",221,17],["καὶ",2,8],["ὁ",1,4],["Κύριος",7,5],["ἀπὸ",17,1],["δὲ",14,12],["σαρκῶν",287,61],["μου",6,48],["οὐκ",12,17],["ἐμπίπλασθε",424,68]],"Wherefore do ye persecute me as also the Lord [does], and are not satisfied with my flesh?"],["23",[["Τίς",39,150],["γὰρ",40,12],["ἂν",82,12],["δοίη",33,276],["γραφῆναι",186,174],["τὰ",1,42],["ῥήματά",115,43],["μου",6,48],["τεθῆναι",109,174],["δὲ",14,12],["αὐτὰ",3,66],["ἐν",4,1],["βιβλίῳ",337,53],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7]],"For oh that my words were written, and that they were recorded in a book for ever,"],["24",[["ἐν",4,1],["γραφείῳ",6962,53],["σιδηρῷ",1063,34],["καὶ",2,8],["μολίβῳ",3310,113],["ἢ",60,8],["ἐν",4,1],["πέτραις",546,71],["ἐγγλυφῆναι",0,0]],"with an iron pen and lead, or graven in the rocks!"],["25",[["Οἶδα",73,85],["γὰρ",40,12],["ὅτι",19,8],["ἀένναός",3418,16],["ἐστιν",10,87],["ὁ",1,4],["ἐκλύειν",1195,54],["με",6,82],["μέλλων",1143,67]],"For I know that he is eternal who is about to deliver me,"],["26",[["ἐπὶ",9,1],["γῆς",26,19],["ἀναστῆσαι",121,100],["τὸ",1,32],["δέρμα",665,33],["μου",6,48],["τὸ",1,32],["ἀναντλοῦν",8923,47],["ταῦτα",16,249],["παρὰ",72,1],["γὰρ",40,12],["Κυρίου",7,21],["ταῦτά",16,339],["μοι",6,49],["συνετελέσθη",316,38]],"[and] to raise up upon the earth my skin that endures these [sufferings]: for these things have been accomplished to me of the Lord;"],["27",[["ἃ",1,11],["ἐγὼ",6,178],["ἐμαυτῷ",891,49],["συνεπίσταμαι",6142,252],["ἃ",1,11],["ὁ",1,4],["ὀφθαλμός",91,5],["μου",6,48],["ἑώρακε",111,165],["καὶ",2,8],["οὐκ",12,17],["ἄλλος",581,158],["πάντα",11,65],["δέ",14,12],["μοι",6,49],["συντετέλεσται",316,372],["ἐν",4,1],["κόλπῳ",1140,113]],"which I am conscious of in myself, which mine eye has seen, and not another, but all have been fulfilled to me in [my] bosom."],["28",[["Εἰ",77,8],["δὲ",14,12],["καὶ",2,8],["ἐρεῖτε",663,343],["τί",39,119],["ἐροῦμεν",191,241],["ἔναντι",230,17],["αὐτοῦ",3,48],["καὶ",2,8],["ῥίζαν",893,10],["λόγου",48,21],["εὑρήσομεν",106,269],["ἐν",4,1],["αὐτῷ",3,49]],"But if ye shall also say, What shall we say before him, and [so] find the root of the matter in him?"],["29",[["Εὐλαβήθητε",1270,358],["δὴ",193,12],["καὶ",2,8],["ὑμεῖς",5,208],["ἀπὸ",17,1],["ἐπικαλύμματος",4628,24],["θυμὸς",177,5],["γὰρ",40,12],["ἐπʼ",9,1],["ἀνόμους",532,58],["ἐπελεύσεται",540,89],["καὶ",2,8],["τότε",250,17],["γνώσονται",81,127],["ποῦ",477,17],["ἐστιν",10,87],["αὐτῶν",3,41],["ἡ",1,11],["ὕλη",3234,13]],"Do ye also beware of deceit: for wrath will come upon transgressors; and then shall they know where their substance is."]]