[["1",[["Ὀλέκομαι",5400,251],["πνεύματι",168,53],["φερόμενος",199,114],["δέομαι",1672,251],["δὲ",14,12],["ταφῆς",2502,19],["καὶ",2,8],["οὐ",12,17],["τυγχάνω",1451,149]],"I perish, carried away by the wind, and I seek for burial, and obtain [it] not."],["2",[["Λίσσομαι",3886,251],["κάμνων",3571,67],["καὶ",2,8],["τί",39,119],["ποιήσας",23,155]],"Weary I intreat; and what have I done? and strangers have stolen my goods."],["3",[["ἔκλεψαν",1245,141],["δέ",14,12],["μου",6,48],["τὰ",1,42],["ὑπάρχοντα",418,232],["ἀλλότριοι",381,130],["Τίς",39,150],["ἐστιν",10,87],["οὕτος",81,20],["τῇ",1,95],["χειρί",37,2],["μου",6,48],["συνδεθήτω",3361,25]],"Who is this? let him join hands with me."],["4",[["Ὅτι",19,8],["καρδίαν",64,10],["αὐτῶν",3,41],["ἔκρυψας",372,154],["ἀπὸ",17,1],["φρονήσεως",833,19],["διὰ",56,1],["τοῦτο",16,122],["οὐ",12,17],["μὴ",25,8],["ὑψώσῃς",331,170],["αὐτούς",3,60]],"For thou hast hid their heart from wisdom; therefore thou shalt not exalt them."],["5",[["Τῇ",1,95],["μερίδι",399,2],["ἀναγγελεῖ",231,120],["κακίας",433,19],["ὀφθαλμοὶ",91,51],["δὲ",14,12],["ἐφʼ",9,1],["υἱοῖς",13,139],["ἐτάκησαν",1021,94]],"He shall promise mischief to [his] companions: but [their] eyes have failed for [their] children."],["6",[["Ἔθου",110,169],["δέ",14,12],["με",6,82],["θρύλλημα",5657,105],["ἐν",4,1],["ἔθνεσι",60,92],["γέλως",1883,5],["δὲ",14,12],["αὐτοῖς",3,142],["ἀπέβην",1797,147]],"But thou hast made me a byword among the nations, and I am become a scorn to them."],["7",[["Πεπώρωνται",8183,254],["γὰρ",40,12],["ἀπὸ",17,1],["ὀργῆς",198,19],["οἱ",1,128],["ὀφθαλμοί",91,51],["μου",6,48],["πεπολιόρκημαι",1688,324],["μεγάλως",66,58],["ὑπὸ",122,1],["πάντων",11,163]],"For my eyes are dimmed through pain; I have been grievously beset by all."],["8",[["Θαῦμα",5646,33],["ἔσχεν",124,3],["ἀληθινοὺς",1023,58],["ἐπὶ",9,1],["τούτῳ",16,279],["δίκαιος",153,16],["δὲ",14,12],["ἐπὶ",9,1],["παρανόμῳ",830,111],["ἐπανασταίη",1216,216]],"Wonder has seized true men upon this; and let the just rise up against the transgressor."],["9",[["Σχοίη",124,216],["δὲ",14,12],["πιστὸς",750,16],["τὴν",1,9],["ἑαυτοῦ",92,48],["ὁδὸν",68,10],["καθαρὸς",379,16],["δὲ",14,12],["χεῖρας",37,40],["ἀναλάβοι",575,216],["θάρσος",2081,20]],"But let the faithful hold on his own way, and let him that is pure of hands take courage."],["10",[["Οὐ",12,17],["μὴν",296,12],["δὲ",14,12],["ἀλλὰ",108,17],["πάντες",11,130],["ἐρείδετε",2838,84],["καὶ",2,8],["δεῦτε",1159,17],["δὴ",193,12],["οὐ",12,17],["γὰρ",40,12],["εὑρίσκω",101,149],["ἐν",4,1],["ὑμῖν",5,86],["ἀληθές",1923,28]],"Howbeit, do ye all strengthen [yourselves] and come now, for I do not find truth in you."],["11",[["Αἱ",1,185],["ἡμέραι",28,2],["μου",6,48],["παρῆλθον",404,141],["ἐν",4,1],["βρόμῳ",4174,113],["ἐῤῥάγη",1178,38],["δὲ",14,12],["τὰ",1,42],["ἄρθρα",6386,43],["τῆς",1,18],["καρδίας",64,19],["μου",6,83]],"My days have passed in groaning, and my heart-strings are broken."],["12",[["Νύκτα",219,10],["εἰς",8,1],["ἡμέραν",28,10],["ἔθηκα",110,147],["φῶς",380,20],["ἐγγὺς",1026,17],["ἀπὸ",17,1],["προσώπου",47,24],["σκότους",506,31]],"I have turned the night into day: the light is short because of darkness."],["13",[["Ἐὰν",45,8],["γὰρ",40,12],["ὑπομείνω",639,227],["ᾅδης",586,5],["μου",6,48],["ὁ",1,4],["οἶκος",34,5],["ἐν",4,1],["δὲ",14,12],["γνοφῳ",1504,113],["ἔστρωταί",2958,182],["μου",6,48],["ἡ",1,11],["στρωμνή",2629,13]],"For if I remain, Hades is my habitation: and my bed has been made in darkness."],["14",[["Θάνατον",170,7],["ἐπεκαλεσάμην",341,152],["πατέρα",44,7],["μου",6,48],["εἶναι",10,54],["μητέρα",189,10],["δέ",14,12],["μου",6,48],["καὶ",2,8],["ἀδελφὴν",521,10],["σαπρίαν",2953,10]],"I have called upon death to be my father, and corruption [to be] my mother and sister."],["15",[["Ποῦ",478,17],["οὖν",227,12],["μου",6,48],["ἔτι",111,17],["ἐστὶν",10,87],["ἡ",1,11],["ἐλπὶς",530,13],["ἢ",61,8],["τὰ",1,42],["ἀγαθά",114,65],["μου",6,48],["ὄψομαι",112,177]],"Where then is yet my hope? or [where] shall I see my good?"],["16",[["Ἢ",61,8],["μετʼ",29,1],["ἐμοῦ",6,48],["εἰς",8,1],["ᾅδην",586,7],["καταβήσονται",175,127],["ἢ",61,8],["ὁμοθυμαδὸν",1262,17],["ἐπὶ",9,1],["χώματος",2299,24],["καταβησόμεθα",175,132]],"Will they go down with me to Hades, or shall we go down together to the tomb?"]]