[["1",[["Ὀλέκομαι",5432,252],["πνεύματι",167,53],["φερόμενος",201,114],["δέομαι",1674,252],["δὲ",14,12],["ταφῆς",2506,19],["καὶ",2,8],["οὐ",12,17],["τυγχάνω",1451,149]],"I perish, carried away by the wind, and I seek for burial, and obtain [it] not."],["2",[["Λίσσομαι",3896,252],["κάμνων",3575,67],["καὶ",2,8],["τί",39,119],["ποιήσας",23,155]],"Weary I intreat; and what have I done? and strangers have stolen my goods."],["3",[["ἔκλεψαν",1247,141],["δέ",14,12],["μου",6,48],["τὰ",1,42],["ὑπάρχοντα",416,232],["ἀλλότριοι",377,130],["Τίς",39,150],["ἐστιν",10,87],["οὕτος",80,20],["τῇ",1,95],["χειρί",37,2],["μου",6,48],["συνδεθήτω",3365,25]],"Who is this? let him join hands with me."],["4",[["Ὅτι",19,8],["καρδίαν",63,10],["αὐτῶν",3,41],["ἔκρυψας",378,154],["ἀπὸ",17,1],["φρονήσεως",834,19],["διὰ",54,1],["τοῦτο",16,122],["οὐ",12,17],["μὴ",25,8],["ὑψώσῃς",327,170],["αὐτούς",3,60]],"For thou hast hid their heart from wisdom; therefore thou shalt not exalt them."],["5",[["Τῇ",1,95],["μερίδι",396,2],["ἀναγγελεῖ",228,120],["κακίας",431,19],["ὀφθαλμοὶ",91,51],["δὲ",14,12],["ἐφʼ",9,1],["υἱοῖς",13,139],["ἐτάκησαν",1019,94]],"He shall promise mischief to [his] companions: but [their] eyes have failed for [their] children."],["6",[["Ἔθου",109,169],["δέ",14,12],["με",6,82],["θρύλλημα",5688,105],["ἐν",4,1],["ἔθνεσι",59,92],["γέλως",1885,5],["δὲ",14,12],["αὐτοῖς",3,142],["ἀπέβην",1799,147]],"But thou hast made me a byword among the nations, and I am become a scorn to them."],["7",[["Πεπώρωνται",0,0],["γὰρ",40,12],["ἀπὸ",17,1],["ὀργῆς",198,19],["οἱ",1,128],["ὀφθαλμοί",91,51],["μου",6,48],["πεπολιόρκημαι",0,0],["μεγάλως",65,58],["ὑπὸ",122,1],["πάντων",11,163]],"For my eyes are dimmed through pain; I have been grievously beset by all."],["8",[["Θαῦμα",5676,33],["ἔσχεν",124,3],["ἀληθινοὺς",1020,58],["ἐπὶ",9,1],["τούτῳ",16,280],["δίκαιος",152,16],["δὲ",14,12],["ἐπὶ",9,1],["παρανόμῳ",832,111],["ἐπανασταίη",1221,276]],"Wonder has seized true men upon this; and let the just rise up against the transgressor."],["9",[["Σχοίη",124,276],["δὲ",14,12],["πιστὸς",748,16],["τὴν",1,9],["ἑαυτοῦ",92,48],["ὁδὸν",67,10],["καθαρὸς",375,16],["δὲ",14,12],["χεῖρας",37,40],["ἀναλάβοι",573,276],["θάρσος",2086,20]],"But let the faithful hold on his own way, and let him that is pure of hands take courage."],["10",[["Οὐ",12,17],["μὴν",295,12],["δὲ",14,12],["ἀλλὰ",107,17],["πάντες",11,130],["ἐρείδετε",2852,84],["καὶ",2,8],["δεῦτε",1162,17],["δὴ",193,12],["οὐ",12,17],["γὰρ",40,12],["εὑρίσκω",106,149],["ἐν",4,1],["ὑμῖν",5,86],["ἀληθές",1926,28]],"Howbeit, do ye all strengthen [yourselves] and come now, for I do not find truth in you."],["11",[["Αἱ",1,183],["ἡμέραι",28,2],["μου",6,48],["παρῆλθον",410,141],["ἐν",4,1],["βρόμῳ",4186,113],["ἐῤῥάγη",1155,38],["δὲ",14,12],["τὰ",1,42],["ἄρθρα",6416,43],["τῆς",1,18],["καρδίας",63,19],["μου",6,83]],"My days have passed in groaning, and my heart-strings are broken."],["12",[["Νύκτα",216,10],["εἰς",8,1],["ἡμέραν",28,10],["ἔθηκα",109,147],["φῶς",376,20],["ἐγγὺς",1022,17],["ἀπὸ",17,1],["προσώπου",47,24],["σκότους",503,31]],"I have turned the night into day: the light is short because of darkness."],["13",[["Ἐὰν",45,8],["γὰρ",40,12],["ὑπομείνω",635,227],["ᾅδης",583,5],["μου",6,48],["ὁ",1,4],["οἶκος",34,5],["ἐν",4,1],["δὲ",14,12],["γνοφῳ",1505,113],["ἔστρωταί",2970,372],["μου",6,48],["ἡ",1,11],["στρωμνή",2634,13]],"For if I remain, Hades is my habitation: and my bed has been made in darkness."],["14",[["Θάνατον",169,7],["ἐπεκαλεσάμην",340,152],["πατέρα",44,7],["μου",6,48],["εἶναι",10,54],["μητέρα",188,10],["δέ",14,12],["μου",6,48],["καὶ",2,8],["ἀδελφὴν",519,10],["σαπρίαν",2966,10]],"I have called upon death to be my father, and corruption [to be] my mother and sister."],["15",[["Ποῦ",477,17],["οὖν",223,12],["μου",6,48],["ἔτι",110,17],["ἐστὶν",10,87],["ἡ",1,11],["ἐλπὶς",527,13],["ἢ",60,8],["τὰ",1,42],["ἀγαθά",113,65],["μου",6,48],["ὄψομαι",111,176]],"Where then is yet my hope? or [where] shall I see my good?"],["16",[["Ἢ",60,8],["μετʼ",29,1],["ἐμοῦ",6,48],["εἰς",8,1],["ᾅδην",583,7],["καταβήσονται",174,127],["ἢ",60,8],["ὁμοθυμαδὸν",1262,17],["ἐπὶ",9,1],["χώματος",2313,24],["καταβησόμεθα",174,132]],"Will they go down with me to Hades, or shall we go down together to the tomb?"]]