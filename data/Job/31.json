[["1",[["Διαθήκην",169,10],["ἐθέμην",110,152],["τοῖς",1,138],["ὀφθαλμοῖς",91,139],["μου",6,48],["καὶ",2,8],["οὐ",12,17],["συνήσω",606,157],["ἐπὶ",9,1],["παρθένον",789,10]],"I made a covenant with mine eyes, and I will not think upon a virgin."],["2",[["Καὶ",2,8],["τί",39,119],["ἐμέρισεν",1348,3],["ὁ",1,4],["Θεὸς",20,5],["ἄνωθεν",1605,17],["καὶ",2,8],["κληρονομία",299,13],["ἱκανοῦ",1007,153],["ἐξ",21,1],["ὑψίστων",474,115]],"Now what portion has God given from above? and is there an inheritance [given] of the Mighty One from the highest?"],["3",[["Οὐαί",769,316],["ἀπώλεια",541,13],["τῷ",1,110],["ἀδίκῳ",406,111],["καὶ",2,8],["ἀπαλλοτρίωσις",6293,13],["τοῖς",1,138],["ποιοῦσιν",23,352],["ἀνομίαν",275,10]],"Alas! destruction to the unrighteous, and rejection to them that do iniquity."],["4",[["Οὐχὶ",330,12],["αὐτὸς",3,158],["ὄψεται",112,89],["ὁδόν",68,10],["μου",6,48],["καὶ",2,8],["πάντα",11,65],["τὰ",1,42],["διαβήματά",2077,43],["μου",6,48],["ἐξαριθμήσεται",1932,89]],"Will he not see my way, and number all my steps?"],["5",[["Εἰ",77,8],["δὲ",14,12],["ἤμην",10,429],["πεπορευμένος",49,408],["μετὰ",29,1],["γελοιαστῶν",6891,77],["εἰ",77,8],["δὲ",14,12],["καὶ",2,8],["ἐσπούδασεν",2490,3],["ὁ",1,4],["πούς",210,5],["μου",6,48],["εἰς",8,1],["δόλον",919,7]],"But if I had gone with scorners, and if too my foot has hasted to deceit:"],["6",[["Ἕσταμαι",78,324],["γὰρ",40,12],["ἐν",4,1],["ζυγῷ",920,113],["δικαίῳ",153,111],["οἶδε",1168,165],["δὲ",14,12],["ὁ",1,4],["Κύριος",7,5],["τὴν",1,9],["ἀκακίαν",2650,10],["μου",6,48]],"(for I am weighed in a just balance, and the Lord knows my innocence:)"],["7",[["Εἰ",77,8],["ἐξέκλινεν",394,3],["ὁ",1,4],["πούς",210,5],["μου",6,83],["ἐκ",21,1],["τῆς",1,18],["ὁδοῦ",68,19],["εἰ",77,8],["δὲ",14,12],["καὶ",2,8],["τῷ",1,110],["ὀφθαλμῷ",91,113],["ἐπηκολούθησεν",2141,3],["ἡ",1,11],["καρδία",64,13],["μου",6,48],["εἰ",77,8],["δὲ",14,12],["καὶ",2,8],["ταῖς",1,70],["χερσί",37,71],["μου",6,48],["ἡψάμην",465,152],["δώρων",348,45]],"if my foot has turned aside out of the way, or if mine heart has followed mine eye, and if too I have touched gifts with my hands;"],["8",[["σπείραιμι",793,347],["ἄρα",985,12],["καὶ",2,8],["ἄλλοι",584,195],["φάγοισαν",147,405],["ἄῤῥιζος",9201,16],["δὲ",14,12],["γενοίμην",30,686],["ἐπὶ",9,1],["γῆς",26,19]],"then let me sow, and let others eat; and let me be uprooted on the earth."],["9",[["Εἰ",77,8],["ἐξηκολούθησεν",3738,3],["ἡ",1,11],["καρδία",64,13],["μου",6,48],["γυναικὶ",59,2],["ἀνδρὸς",38,21],["ἑτέρου",253,153],["εἰ",77,8],["καὶ",2,8],["ἐγκάθετος",6414,16],["ἐγενόμην",30,152],["ἐπὶ",9,1],["θύραις",277,71],["αὐτῆς",3,83]],"If my heart has gone forth after another man's wife, and if I laid wait at her doors;"],["10",[["ἀρέσαι",955,100],["ἄρα",985,12],["καὶ",2,8],["ἡ",1,11],["γυνή",59,13],["μου",6,48],["ἑτέρῳ",253,111],["τὰ",1,42],["δὲ",14,12],["νήπιά",1016,65],["μου",6,48],["ταπεινωθείη",322,544]],"then let my wife also please another, and let my children be brought low."],["11",[["Θυμὸς",178,5],["γὰρ",40,12],["ὀργῆς",198,19],["ἀκατάσχετος",6236,16],["τὸ",1,32],["μιᾶναι",468,100],["ἀνδρὸς",38,21],["γυναῖκα",59,10]],"For the rage of anger is not to be controlled, [in the case] of defiling [another] man's wife."],["12",[["Πῦρ",118,33],["γάρ",40,12],["ἐστι",10,87],["καιόμενον",671,201],["ἐπὶ",9,1],["πάντων",11,79],["τῶν",1,44],["μερῶν",471,45],["οὗδʼ",7808,250],["ἂν",83,12],["ἐπέλθῃ",542,160],["ἐκ",21,1],["ῥιζῶν",892,61],["ἀπώλεσεν",217,3]],"For it is a fire burning on every side, and whomsoever it attacks, it utterly destroys."],["13",[["Εἰ",77,8],["δὲ",14,12],["καὶ",2,8],["ἐφαύλισα",2125,147],["κρίμα",267,33],["θεράποντός",804,21],["μου",6,48],["ἢ",61,8],["θεραπαίνης",3061,19],["κρινομένων",263,468],["αὐτῶν",3,189],["πρὸς",15,1],["μὲ",6,82]],"And if too I despised the judgment of my servant or [my] handmaid, when they pleaded with me;"],["14",[["τί",39,119],["γὰρ",40,12],["ποιήσω",23,227],["ἐὰν",45,8],["ἔτασίν",5373,10],["μου",6,48],["ποιῆται",23,297],["ὁ",1,4],["Κύριος",7,5],["ἐὰν",45,8],["δὲ",14,12],["καὶ",2,8],["ἐπισκοπήν",1106,10],["τινα",39,583],["ἀπόκρισιν",2406,10],["ποιήσομαι",23,177]],"what then shall I do if the Lord should try me? and if also he should at all visit me, can I make an answer?"],["15",[["Πότερον",2487,59],["οὐχ",12,17],["ὡς",36,8],["καὶ",2,8],["ἐγὼ",6,158],["ἐγενόμην",30,152],["ἐν",4,1],["γαστρὶ",777,2],["καὶ",2,8],["ἐκεῖνοι",80,195],["γεγόνασι",30,400],["γεγόναμεν",30,311],["δὲ",14,12],["ἐν",4,1],["τῇ",1,95],["αὐτῇ",3,99],["κοιλίᾳ",547,2]],"Were not they too formed as I also was formed in the womb? yea, we were formed in the same womb."],["16",[["Ἀδύνατοι",1649,130],["δὲ",14,12],["χρείαν",1006,10],["ἥν",24,124],["ποτε",458,12],["εἶχον",124,129],["οὐκ",12,17],["ἀπέτυχον",9060,141],["χήρας",751,40],["δὲ",14,12],["τὸν",1,6],["ὀφθαλμὸν",91,7],["οὐκ",12,17],["ἐξέτηξα",3185,147]],"But the helpless missed not whatever need they had, and I did not cause the eye of the widow to fail."],["17",[["Εἰ",77,8],["δὲ",14,12],["καὶ",2,8],["τὸν",1,6],["ψωμόν",2510,7],["μου",6,48],["ἔφαγον",269,141],["μόνος",302,16],["καὶ",2,8],["οὐχὶ",330,12],["ὀρφανῷ",957,111],["μετέδωκα",3296,147]],"And if too I ate my morsel alone, and did not impart [of it] to the orphan;"],["18",[["Ὅτι",19,8],["ἐκ",21,1],["νεότητός",787,19],["μου",6,83],["ἐξέτρεφον",1573,129],["ὡς",36,8],["πατὴρ",44,5],["καὶ",2,8],["ἐκ",21,1],["γαστρὸς",777,19],["μητρός",189,19],["μου",6,83],["ὡδήγησα",1108,147]],"(for I nourished [them] as a father from my youth, and guided [them] from my mother's womb.)"],["19",[["Εἰ",77,8],["δὲ",14,12],["καὶ",2,8],["ὑπερεῖδον",3477,36],["γυμνὸν",1299,28],["ἀπολλύμενον",217,201],["καὶ",2,8],["οὐκ",12,17],["ἠμφίασα",4498,147],["αὐτόν",3,82]],"And if too I overlooked the naked as he was perishing, and did not clothe him;"],["20",[["Ἀδύνατοι",1649,130],["δὲ",14,12],["εἰ",77,8],["μὴ",25,8],["εὐλόγησάν",149,141],["με",6,82],["ἀπὸ",17,1],["δὲ",14,12],["κουρᾶς",4862,19],["ἀμνῶν",1290,61],["μοῦ",6,83],["ἐθερμάνθησαν",2350,94],["οἱ",1,128],["ὦμοι",1011,51],["αὐτῶν",3,41]],"and if the poor did not bless me, and their shoulders were [not] warmed with the fleece of my lambs;"],["21",[["Εἰ",77,8],["ἐπῆρα",661,147],["ὀρφανῷ",957,111],["χεῖρα",37,10],["πεποιθὼς",344,264],["ὅτι",19,8],["πολλή",74,15],["μοι",6,49],["βοήθεια",765,13],["περίεστιν",3328,87]],"if I lifted my hand against an orphan, trusting that my strength was far superior [to his]:"],["22",[["Ἀποσταίη",293,216],["ἄρα",985,12],["ὁ",1,4],["ὦμός",1011,5],["μου",6,83],["ἀπὸ",17,1],["τῆς",1,18],["κλειδός",4271,19],["ὁ",1,4],["δὲ",14,12],["βραχίων",1032,5],["μου",6,48],["ἀπὸ",17,1],["τοῦ",1,30],["ἀγκῶνος",3678,21],["συντριβείη",268,544]],"let then my shoulder start from the blade-bone, and my arm be crushed off from the elbow."],["23",[["Φόβος",333,5],["γὰρ",40,12],["Κυρίου",7,21],["συνέσχε",1227,3],["με",6,82],["ἀπὸ",17,1],["τοῦ",1,23],["λήμματος",2025,24],["αὐτοῦ",3,144],["οὐχ",12,17],["ὑποίσω",1876,157]],"For the fear of the Lord constrained me, and I cannot bear up by reason of his burden."],["24",[["Εἰ",77,8],["ἔταξα",721,147],["χρυσίον",202,20],["εἰς",8,1],["χοῦν",1289,7],["μου",6,48],["εἰ",77,8],["δὲ",14,12],["καὶ",2,8],["λίθῳ",195,113],["πολυτελεῖ",2282,111],["ἐπεποίθησα",0,0]],"If I made gold my treasure, and if too I trusted the precious stone;"],["25",[["εἰ",77,8],["δὲ",14,12],["καὶ",2,8],["εὐφράνθην",244,148],["πολλοῦ",74,153],["πλούτου",574,21],["μου",6,48],["γενομένου",30,288],["εἰ",77,8],["δὲ",14,12],["καὶ",2,8],["ἐπʼ",9,1],["ἀναριθμήτοις",2515,215],["ἐθέμην",110,152],["χεῖρά",37,10],["μου",6,48]],"and if too I rejoiced when my wealth was abundant, and if too I laid my hand on innumerable [treasures]:"],["26",[["Ἢ",61,8],["οὐχ",12,17],["ὁρῶμεν",112,223],["ἥλιον",323,7],["τὸν",1,6],["ἐπιθαύσκοντα",0,0],["ἐκλείποντα",321,178],["σελήνην",1207,10],["δὲ",14,12],["φθίνουσαν",8591,73],["οὐ",12,17],["γὰρ",40,12],["ἐπʼ",9,1],["αὐτοῖς",3,142],["ἐστί",10,87]],"(do we not see the shining sun eclipsed, and the moon waning? for they have not [power to continue]:)"],["27",[["Καὶ",2,8],["εἰ",77,8],["ἠπατήθη",1291,38],["λάθρα",3077,17],["ἡ",1,11],["καρδία",64,13],["μου",6,48],["εἰ",77,8],["δὲ",14,12],["χεῖρά",37,10],["μου",6,48],["ἐπιθεὶς",239,155],["ἐπὶ",9,1],["στόματί",123,53],["μου",6,48],["ἐφίλησα",1391,147]],"and if my heart was secretly deceived, and if I have laid my hand upon my mouth and kissed it:"],["28",[["Καὶ",2,8],["τοῦτό",16,344],["μοι",6,49],["ἄρα",985,12],["ἀνομία",275,13],["ἡ",1,11],["μεγίστη",66,15],["λογισθείη",495,683],["ὅτι",19,8],["ἐψευσάμην",1099,152],["ἐναντίον",138,17],["Κυρίου",7,21],["τοῦ",1,30],["ὑψίστου",474,153]],"let this also then be reckoned to me as the greatest iniquity: for I [should] have lied against the Lord Most High."],["29",[["Εἰ",77,8],["δὲ",14,12],["καὶ",2,8],["ἐπιχαρὴς",9565,16],["ἐγενόμην",30,152],["πτώματι",1739,53],["ἐχθρῶν",135,77],["μου",6,48],["καὶ",2,8],["εἶπεν",18,3],["ἡ",1,11],["καρδία",64,13],["μου",6,48],["εὖγε",2259,17]],"And if too I was glad at the fall of mine enemies, and mine heart said, Aha!"],["30",[["Ἀκούσαι",54,216],["ἄρα",985,12],["τὸ",1,32],["οὖς",328,33],["μου",6,48],["τὴν",1,9],["κατάραν",1165,10],["μου",6,48],["θρυληθείην",4798,672],["δὲ",14,12],["ἄρα",985,12],["ὑπὸ",122,1],["λαοῦ",35,21],["μου",6,48],["κακούμενος",757,114]],"let then mine ear hear my curse, and let me be a by-word among my people in my affliction."],["31",[["Εἰ",77,8],["δὲ",14,12],["καὶ",2,8],["πολλάκις",2947,17],["εἶπον",18,141],["αἱ",1,185],["θεράπαιναί",3061,180],["μου",6,48],["τίς",39,150],["ἄν",83,12],["δῴη",33,216],["ἡμῖν",6,142],["τῶν",1,123],["σαρκῶν",287,61],["αὐτοῦ",3,48],["πλησθῆναι",909,175],["λίαν",1898,17],["μου",6,48],["χρηστοῦ",1359,153],["ὄντος",10,143]],"And if too my handmaids have often said, Oh that we might be satisfied with his flesh; (whereas I was very kind:"],["32",[["Ἔξω",527,17],["δὲ",14,12],["οὐκ",12,17],["ηὐλίζετο",990,22],["ξένος",1828,15],["ἡ",1,11],["δὲ",14,12],["θύρα",277,13],["μου",6,48],["παντὶ",11,111],["ἐλθόντι",55,354],["ἀνέῳκτο",362,108]],"for the stranger did not lodge without, and my door was opened to every one that came:)"],["33",[["Εἰ",77,8],["δὲ",14,12],["καὶ",2,8],["ἁμαρτὼν",237,155],["ἀκουσίως",2047,17],["ἔκρυψα",372,147],["τὴν",1,9],["ἁμαρτίαν",119,10],["μου",6,48]],"or if too having sinned unintentionally, I hid my sin;"],["34",[["Οὐ",12,17],["γὰρ",40,12],["διετράπην",4749,148],["πολυοχλίαν",4993,10],["πλήθους",200,24],["τοῦ",1,23],["μὴ",25,8],["ἐξαγορεῦσαι",2420,100],["ἐνώπιον",115,1],["αὐτῶν",3,41],["εἰ",77,8],["δὲ",14,12],["καὶ",2,8],["εἴασα",1406,147],["ἀδύνατον",1649,37],["ἐξελθεῖν",82,100],["θύραν",277,10],["μου",6,48],["κόλπῳ",1140,113],["κενῷ",780,111]],"(for I did not stand in awe of a great multitude, so as not to declare boldly before them:) and if too I permitted a poor man to go out of my door with an empty bosom:"],["35",[["Τίς",39,150],["δῴη",33,216],["ἀκούοντά",54,289],["μου",6,48],["χεῖρα",37,10],["δὲ",14,12],["Κυρίου",7,21],["εἰ",77,8],["μὴ",25,8],["ἐδεδοίκειν",3046,149],["συγγραφὴν",3957,10],["δὲ",14,12],["ἣν",24,124],["εἶχον",124,129],["κατά",32,1],["τινος",39,304]],"(Oh that I had a hearer,) and if I had not feared the hand of the Lord; and [as to] the written charge which I had against any one,"],["36",[["ἐπʼ",9,1],["ὤμοις",1011,139],["ἂν",83,12],["περιθέμενος",1017,244],["στέφανον",980,7],["ἀνεγίνωσκον",795,129]],"I would place [it] as a chaplet on my shoulders, and read it."],["37",[["καὶ",2,8],["εἰ",77,8],["μὴ",25,8],["ῥῆξας",1178,154],["αὐτὴν",3,98],["ἀπέδωκα",312,147],["οὐθὲν",228,29],["λαβὼν",46,155],["παρὰ",73,1],["χρεωφειλέτου",6208,21]],"And if I did not read it and return it, having taken nothing from the debtor:"],["38",[["Εἰ",77,8],["ἐπʼ",9,1],["ἐμοί",6,49],["ποτε",458,12],["ἡ",1,11],["γῆ",26,13],["ἐστέναξεν",1445,3],["εἰ",77,8],["δὲ",14,12],["καὶ",2,8],["οἱ",1,128],["αὔλακες",3499,180],["αὐτῆς",3,83],["ἔκλαυσαν",412,141],["ὁμοθυμαδόν",1262,17]],"If at any time the land groaned against me, and if its furrows mourned together;"],["39",[["Εἰ",77,8],["δὲ",14,12],["καὶ",2,8],["τὴν",1,9],["ἰσχὺν",181,10],["αὐτῆς",3,83],["ἔφαγον",269,141],["μόνος",302,16],["ἄνευ",1101,1],["τιμῆς",720,19],["εἰ",77,8],["δὲ",14,12],["καὶ",2,8],["ψυχὴν",63,10],["κυρίου",7,21],["τῆς",1,18],["γῆς",26,19],["ἐκλαβὼν",5289,155],["ἐλύπησα",936,147]],"and if I ate its strength alone without price, and if too I grieved the heart of the owner of the soil, by taking [aught] from [him]:"],["40",[["Ἀντὶ",158,1],["πυροῦ",926,249],["ἄρα",985,12],["ἐξέλθοι",82,216],["μοι",6,49],["κνίδη",7484,13],["ἀντὶ",158,1],["δὲ",14,12],["κριθῆς",1307,19],["βάτος",2872,13],["Καὶ",2,8],["ἐπαύσατο",706,26],["Ἰὼβ",813,105],["ῥήμασιν",116,92]],"then let the nettle come up to me instead of wheat, and a bramble instead of barley. And Job ceased speaking."]]