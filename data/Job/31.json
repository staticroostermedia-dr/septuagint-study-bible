[["1",[["Διαθήκην",168,10],["ἐθέμην",109,152],["τοῖς",1,138],["ὀφθαλμοῖς",91,139],["μου",6,48],["καὶ",2,8],["οὐ",12,17],["συνήσω",602,157],["ἐπὶ",9,1],["παρθένον",787,10]],"I made a covenant with mine eyes, and I will not think upon a virgin."],["2",[["Καὶ",2,8],["τί",39,119],["ἐμέρισεν",1382,3],["ὁ",1,4],["Θεὸς",20,5],["ἄνωθεν",1605,17],["καὶ",2,8],["κληρονομία",297,13],["ἱκανοῦ",1007,153],["ἐξ",21,1],["ὑψίστων",473,115]],"Now what portion has God given from above? and is there an inheritance [given] of the Mighty One from the highest?"],["3",[["Οὐαί",766,320],["ἀπώλεια",539,13],["τῷ",1,110],["ἀδίκῳ",402,111],["καὶ",2,8],["ἀπαλλοτρίωσις",6324,13],["τοῖς",1,138],["ποιοῦσιν",23,357],["ἀνομίαν",274,10]],"Alas! destruction to the unrighteous, and rejection to them that do iniquity."],["4",[["Οὐχὶ",326,12],["αὐτὸς",3,158],["ὄψεται",111,89],["ὁδόν",67,10],["μου",6,48],["καὶ",2,8],["πάντα",11,65],["τὰ",1,42],["διαβήματά",2082,43],["μου",6,48],["ἐξαριθμήσεται",1933,89]],"Will he not see my way, and number all my steps?"],["5",[["Εἰ",77,8],["δὲ",14,12],["ἤμην",10,435],["πεπορευμένος",0,0],["μετὰ",29,1],["γελοιαστῶν",6938,77],["εἰ",77,8],["δὲ",14,12],["καὶ",2,8],["ἐσπούδασεν",2497,3],["ὁ",1,4],["πούς",208,5],["μου",6,48],["εἰς",8,1],["δόλον",920,7]],"But if I had gone with scorners, and if too my foot has hasted to deceit:"],["6",[["Ἕσταμαι",78,408],["γὰρ",40,12],["ἐν",4,1],["ζυγῷ",776,113],["δικαίῳ",152,111],["οἶδε",1145,165],["δὲ",14,12],["ὁ",1,4],["Κύριος",7,5],["τὴν",1,9],["ἀκακίαν",2653,10],["μου",6,48]],"(for I am weighed in a just balance, and the Lord knows my innocence:)"],["7",[["Εἰ",77,8],["ἐξέκλινεν",393,3],["ὁ",1,4],["πούς",208,5],["μου",6,83],["ἐκ",21,1],["τῆς",1,18],["ὁδοῦ",67,19],["εἰ",77,8],["δὲ",14,12],["καὶ",2,8],["τῷ",1,110],["ὀφθαλμῷ",91,113],["ἐπηκολούθησεν",2147,3],["ἡ",1,11],["καρδία",63,13],["μου",6,48],["εἰ",77,8],["δὲ",14,12],["καὶ",2,8],["ταῖς",1,70],["χερσί",37,71],["μου",6,48],["ἡψάμην",462,152],["δώρων",347,45]],"if my foot has turned aside out of the way, or if mine heart has followed mine eye, and if too I have touched gifts with my hands;"],["8",[["σπείραιμι",790,351],["ἄρα",986,12],["καὶ",2,8],["ἄλλοι",581,193],["φάγοισαν",153,412],["ἄῤῥιζος",9276,16],["δὲ",14,12],["γενοίμην",30,708],["ἐπὶ",9,1],["γῆς",26,19]],"then let me sow, and let others eat; and let me be uprooted on the earth."],["9",[["Εἰ",77,8],["ἐξηκολούθησεν",3748,3],["ἡ",1,11],["καρδία",63,13],["μου",6,48],["γυναικὶ",58,2],["ἀνδρὸς",38,21],["ἑτέρου",253,153],["εἰ",77,8],["καὶ",2,8],["ἐγκάθετος",6446,16],["ἐγενόμην",30,152],["ἐπὶ",9,1],["θύραις",277,71],["αὐτῆς",3,83]],"If my heart has gone forth after another man's wife, and if I laid wait at her doors;"],["10",[["ἀρέσαι",957,100],["ἄρα",986,12],["καὶ",2,8],["ἡ",1,11],["γυνή",58,13],["μου",6,48],["ἑτέρῳ",253,111],["τὰ",1,42],["δὲ",14,12],["νήπιά",1015,65],["μου",6,48],["ταπεινωθείη",333,555]],"then let my wife also please another, and let my children be brought low."],["11",[["Θυμὸς",177,5],["γὰρ",40,12],["ὀργῆς",198,19],["ἀκατάσχετος",6267,16],["τὸ",1,32],["μιᾶναι",466,100],["ἀνδρὸς",38,21],["γυναῖκα",58,10]],"For the rage of anger is not to be controlled, [in the case] of defiling [another] man's wife."],["12",[["Πῦρ",118,33],["γάρ",40,12],["ἐστι",10,87],["καιόμενον",667,201],["ἐπὶ",9,1],["πάντων",11,79],["τῶν",1,44],["μερῶν",470,45],["οὗδʼ",7865,251],["ἂν",82,12],["ἐπέλθῃ",540,160],["ἐκ",21,1],["ῥιζῶν",893,61],["ἀπώλεσεν",594,3]],"For it is a fire burning on every side, and whomsoever it attacks, it utterly destroys."],["13",[["Εἰ",77,8],["δὲ",14,12],["καὶ",2,8],["ἐφαύλισα",2308,147],["κρίμα",266,33],["θεράποντός",801,21],["μου",6,48],["ἢ",60,8],["θεραπαίνης",3073,19],["κρινομένων",240,476],["αὐτῶν",3,187],["πρὸς",15,1],["μὲ",6,82]],"And if too I despised the judgment of my servant or [my] handmaid, when they pleaded with me;"],["14",[["τί",39,119],["γὰρ",40,12],["ποιήσω",23,227],["ἐὰν",45,8],["ἔτασίν",5402,10],["μου",6,48],["ποιῆται",23,301],["ὁ",1,4],["Κύριος",7,5],["ἐὰν",45,8],["δὲ",14,12],["καὶ",2,8],["ἐπισκοπήν",1108,10],["τινα",39,600],["ἀπόκρισιν",2415,10],["ποιήσομαι",23,176]],"what then shall I do if the Lord should try me? and if also he should at all visit me, can I make an answer?"],["15",[["Πότερον",2495,59],["οὐχ",12,17],["ὡς",36,8],["καὶ",2,8],["ἐγὼ",6,158],["ἐγενόμην",30,152],["ἐν",4,1],["γαστρὶ",775,2],["καὶ",2,8],["ἐκεῖνοι",79,193],["γεγόνασι",30,406],["γεγόναμεν",30,315],["δὲ",14,12],["ἐν",4,1],["τῇ",1,95],["αὐτῇ",3,99],["κοιλίᾳ",545,2]],"Were not they too formed as I also was formed in the womb? yea, we were formed in the same womb."],["16",[["Ἀδύνατοι",1648,130],["δὲ",14,12],["χρείαν",1006,10],["ἥν",24,124],["ποτε",455,12],["εἶχον",124,129],["οὐκ",12,17],["ἀπέτυχον",9128,141],["χήρας",749,40],["δὲ",14,12],["τὸν",1,6],["ὀφθαλμὸν",91,7],["οὐκ",12,17],["ἐξέτηξα",3191,147]],"But the helpless missed not whatever need they had, and I did not cause the eye of the widow to fail."],["17",[["Εἰ",77,8],["δὲ",14,12],["καὶ",2,8],["τὸν",1,6],["ψωμόν",2514,7],["μου",6,48],["ἔφαγον",268,141],["μόνος",300,16],["καὶ",2,8],["οὐχὶ",326,12],["ὀρφανῷ",959,111],["μετέδωκα",3301,147]],"And if too I ate my morsel alone, and did not impart [of it] to the orphan;"],["18",[["Ὅτι",19,8],["ἐκ",21,1],["νεότητός",785,19],["μου",6,83],["ἐξέτρεφον",1574,129],["ὡς",36,8],["πατὴρ",44,5],["καὶ",2,8],["ἐκ",21,1],["γαστρὸς",775,19],["μητρός",188,19],["μου",6,83],["ὡδήγησα",1110,147]],"(for I nourished [them] as a father from my youth, and guided [them] from my mother's womb.)"],["19",[["Εἰ",77,8],["δὲ",14,12],["καὶ",2,8],["ὑπερεῖδον",3480,36],["γυμνὸν",1299,28],["ἀπολλύμενον",213,201],["καὶ",2,8],["οὐκ",12,17],["ἠμφίασα",4522,147],["αὐτόν",3,82]],"And if too I overlooked the naked as he was perishing, and did not clothe him;"],["20",[["Ἀδύνατοι",1648,130],["δὲ",14,12],["εἰ",77,8],["μὴ",25,8],["εὐλόγησάν",147,141],["με",6,82],["ἀπὸ",17,1],["δὲ",14,12],["κουρᾶς",4888,19],["ἀμνῶν",1290,61],["μοῦ",6,83],["ἐθερμάνθησαν",2359,94],["οἱ",1,128],["ὦμοι",1011,51],["αὐτῶν",3,41]],"and if the poor did not bless me, and their shoulders were [not] warmed with the fleece of my lambs;"],["21",[["Εἰ",77,8],["ἐπῆρα",752,147],["ὀρφανῷ",959,111],["χεῖρα",37,10],["πεποιθὼς",343,265],["ὅτι",19,8],["πολλή",74,15],["μοι",6,49],["βοήθεια",761,13],["περίεστιν",3333,87]],"if I lifted my hand against an orphan, trusting that my strength was far superior [to his]:"],["22",[["Ἀποσταίη",646,276],["ἄρα",986,12],["ὁ",1,4],["ὦμός",1011,5],["μου",6,83],["ἀπὸ",17,1],["τῆς",1,18],["κλειδός",4284,19],["ὁ",1,4],["δὲ",14,12],["βραχίων",1029,5],["μου",6,48],["ἀπὸ",17,1],["τοῦ",1,30],["ἀγκῶνος",3685,21],["συντριβείη",267,555]],"let then my shoulder start from the blade-bone, and my arm be crushed off from the elbow."],["23",[["Φόβος",330,5],["γὰρ",40,12],["Κυρίου",7,21],["συνέσχε",1423,3],["με",6,82],["ἀπὸ",17,1],["τοῦ",1,23],["λήμματος",2031,24],["αὐτοῦ",3,144],["οὐχ",12,17],["ὑποίσω",1877,157]],"For the fear of the Lord constrained me, and I cannot bear up by reason of his burden."],["24",[["Εἰ",77,8],["ἔταξα",783,147],["χρυσίον",202,20],["εἰς",8,1],["χοῦν",1288,7],["μου",6,48],["εἰ",77,8],["δὲ",14,12],["καὶ",2,8],["λίθῳ",195,113],["πολυτελεῖ",2294,111],["ἐπεποίθησα",0,0]],"If I made gold my treasure, and if too I trusted the precious stone;"],["25",[["εἰ",77,8],["δὲ",14,12],["καὶ",2,8],["εὐφράνθην",242,148],["πολλοῦ",74,153],["πλούτου",572,21],["μου",6,48],["γενομένου",30,291],["εἰ",77,8],["δὲ",14,12],["καὶ",2,8],["ἐπʼ",9,1],["ἀναριθμήτοις",2516,215],["ἐθέμην",109,152],["χεῖρά",37,10],["μου",6,48]],"and if too I rejoiced when my wealth was abundant, and if too I laid my hand on innumerable [treasures]:"],["26",[["Ἢ",60,8],["οὐχ",12,17],["ὁρῶμεν",111,223],["ἥλιον",320,7],["τὸν",1,6],["ἐπιθαύσκοντα",0,0],["ἐκλείποντα",321,177],["σελήνην",1211,10],["δὲ",14,12],["φθίνουσαν",8653,73],["οὐ",12,17],["γὰρ",40,12],["ἐπʼ",9,1],["αὐτοῖς",3,142],["ἐστί",10,87]],"(do we not see the shining sun eclipsed, and the moon waning? for they have not [power to continue]:)"],["27",[["Καὶ",2,8],["εἰ",77,8],["ἠπατήθη",1291,38],["λάθρα",3088,17],["ἡ",1,11],["καρδία",63,13],["μου",6,48],["εἰ",77,8],["δὲ",14,12],["χεῖρά",37,10],["μου",6,48],["ἐπιθεὶς",239,155],["ἐπὶ",9,1],["στόματί",123,53],["μου",6,48],["ἐφίλησα",1393,147]],"and if my heart was secretly deceived, and if I have laid my hand upon my mouth and kissed it:"],["28",[["Καὶ",2,8],["τοῦτό",16,348],["μοι",6,49],["ἄρα",986,12],["ἀνομία",274,13],["ἡ",1,11],["μεγίστη",65,15],["λογισθείη",494,706],["ὅτι",19,8],["ἐψευσάμην",1311,152],["ἐναντίον",138,17],["Κυρίου",7,21],["τοῦ",1,30],["ὑψίστου",473,153]],"let this also then be reckoned to me as the greatest iniquity: for I [should] have lied against the Lord Most High."],["29",[["Εἰ",77,8],["δὲ",14,12],["καὶ",2,8],["ἐπιχαρὴς",9635,16],["ἐγενόμην",30,152],["πτώματι",1738,53],["ἐχθρῶν",135,77],["μου",6,48],["καὶ",2,8],["εἶπεν",18,3],["ἡ",1,11],["καρδία",63,13],["μου",6,48],["εὖγε",2274,17]],"And if too I was glad at the fall of mine enemies, and mine heart said, Aha!"],["30",[["Ἀκούσαι",53,276],["ἄρα",986,12],["τὸ",1,32],["οὖς",325,33],["μου",6,48],["τὴν",1,9],["κατάραν",1166,10],["μου",6,48],["θρυληθείην",4826,694],["δὲ",14,12],["ἄρα",986,12],["ὑπὸ",122,1],["λαοῦ",35,21],["μου",6,48],["κακούμενος",764,114]],"let then mine ear hear my curse, and let me be a by-word among my people in my affliction."],["31",[["Εἰ",77,8],["δὲ",14,12],["καὶ",2,8],["πολλάκις",2960,17],["εἶπον",18,141],["αἱ",1,183],["θεράπαιναί",3073,179],["μου",6,48],["τίς",39,150],["ἄν",82,12],["δῴη",33,276],["ἡμῖν",6,142],["τῶν",1,123],["σαρκῶν",287,61],["αὐτοῦ",3,48],["πλησθῆναι",911,174],["λίαν",1899,17],["μου",6,48],["χρηστοῦ",1357,153],["ὄντος",10,143]],"And if too my handmaids have often said, Oh that we might be satisfied with his flesh; (whereas I was very kind:"],["32",[["Ἔξω",525,17],["δὲ",14,12],["οὐκ",12,17],["ηὐλίζετο",991,22],["ξένος",1830,15],["ἡ",1,11],["δὲ",14,12],["θύρα",277,13],["μου",6,48],["παντὶ",11,111],["ἐλθόντι",56,359],["ἀνέῳκτο",621,108]],"for the stranger did not lodge without, and my door was opened to every one that came:)"],["33",[["Εἰ",77,8],["δὲ",14,12],["καὶ",2,8],["ἁμαρτὼν",244,155],["ἀκουσίως",2052,17],["ἔκρυψα",378,147],["τὴν",1,9],["ἁμαρτίαν",119,10],["μου",6,48]],"or if too having sinned unintentionally, I hid my sin;"],["34",[["Οὐ",12,17],["γὰρ",40,12],["διετράπην",4774,148],["πολυοχλίαν",5022,10],["πλήθους",199,24],["τοῦ",1,23],["μὴ",25,8],["ἐξαγορεῦσαι",2427,100],["ἐνώπιον",114,1],["αὐτῶν",3,41],["εἰ",77,8],["δὲ",14,12],["καὶ",2,8],["εἴασα",1407,147],["ἀδύνατον",1648,37],["ἐξελθεῖν",84,100],["θύραν",277,10],["μου",6,48],["κόλπῳ",1140,113],["κενῷ",779,111]],"(for I did not stand in awe of a great multitude, so as not to declare boldly before them:) and if too I permitted a poor man to go out of my door with an empty bosom:"],["35",[["Τίς",39,150],["δῴη",33,276],["ἀκούοντά",53,292],["μου",6,48],["χεῖρα",37,10],["δὲ",14,12],["Κυρίου",7,21],["εἰ",77,8],["μὴ",25,8],["ἐδεδοίκειν",3057,149],["συγγραφὴν",3966,10],["δὲ",14,12],["ἣν",24,124],["εἶχον",124,129],["κατά",32,1],["τινος",39,308]],"(Oh that I had a hearer,) and if I had not feared the hand of the Lord; and [as to] the written charge which I had against any one,"],["36",[["ἐπʼ",9,1],["ὤμοις",1011,139],["ἂν",82,12],["περιθέμενος",1016,245],["στέφανον",979,7],["ἀνεγίνωσκον",792,129]],"I would place [it] as a chaplet on my shoulders, and read it."],["37",[["καὶ",2,8],["εἰ",77,8],["μὴ",25,8],["ῥῆξας",1155,154],["αὐτὴν",3,98],["ἀπέδωκα",311,147],["οὐθὲν",225,29],["λαβὼν",46,155],["παρὰ",72,1],["χρεωφειλέτου",6238,21]],"And if I did not read it and return it, having taken nothing from the debtor:"],["38",[["Εἰ",77,8],["ἐπʼ",9,1],["ἐμοί",6,49],["ποτε",455,12],["ἡ",1,11],["γῆ",26,13],["ἐστέναξεν",1446,3],["εἰ",77,8],["δὲ",14,12],["καὶ",2,8],["οἱ",1,128],["αὔλακες",3502,179],["αὐτῆς",3,83],["ἔκλαυσαν",409,141],["ὁμοθυμαδόν",1262,17]],"If at any time the land groaned against me, and if its furrows mourned together;"],["39",[["Εἰ",77,8],["δὲ",14,12],["καὶ",2,8],["τὴν",1,9],["ἰσχὺν",180,10],["αὐτῆς",3,83],["ἔφαγον",268,141],["μόνος",300,16],["ἄνευ",1103,1],["τιμῆς",721,19],["εἰ",77,8],["δὲ",14,12],["καὶ",2,8],["ψυχὴν",62,10],["κυρίου",7,21],["τῆς",1,18],["γῆς",26,19],["ἐκλαβὼν",5321,155],["ἐλύπησα",936,147]],"and if I ate its strength alone without price, and if too I grieved the heart of the owner of the soil, by taking [aught] from [him]:"],["40",[["Ἀντὶ",158,1],["πυροῦ",939,250],["ἄρα",986,12],["ἐξέλθοι",84,276],["μοι",6,49],["κνίδη",7533,13],["ἀντὶ",158,1],["δὲ",14,12],["κριθῆς",1307,19],["βάτος",2887,13],["Καὶ",2,8],["ἐπαύσατο",707,26],["Ἰὼβ",811,105],["ῥήμασιν",115,92]],"then let the nettle come up to me instead of wheat, and a bramble instead of barley. And Job ceased speaking."]]