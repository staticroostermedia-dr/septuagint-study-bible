[["1",[["Πότερον",2487,28],["οὐχὶ",330,12],["πειρατήριόν",3920,20],["ἐστιν",10,87],["ὁ",1,4],["βίος",726,5],["ἀνθρώπου",43,21],["ἐπὶ",9,1],["τῆς",1,18],["γῆς",26,19],["καὶ",2,8],["ὥσπερ",226,17],["μισθίου",3595,153],["αὐθημερινοῦ",6827,153],["ἡ",1,11],["ζωὴ",216,13],["αὐτοῦ",3,48]],"Is not the life of man upon earth a state of trial? and his existence as that of a hireling by the day?"],["2",[["Ἢ",61,8],["ὥσπερ",226,17],["θεράπων",804,5],["δεδοικὼς",3046,264],["τὸν",1,6],["Κύριον",7,7],["αὐτοῦ",3,48],["καὶ",2,8],["τετευχὼς",1451,264],["σκιᾶς",978,19],["ἢ",61,8],["ὥσπερ",226,17],["μισθωτὸς",1826,5],["ἀναμένων",2806,67],["τὸν",1,6],["μισθὸν",816,7],["αὐτοῦ",3,48]],"Or as a servant that fears his master, and one who has grasped a shadow? or as a hireling waiting for his pay?"],["3",[["Οὕτως",71,17],["κᾀγὼ",613,105],["ὑπέμεινα",639,147],["μῆνας",296,31],["κενοὺς",780,58],["νύκτες",219,180],["δὲ",14,12],["ὀδυνῶν",774,61],["δεδομέναι",33,424],["μοι",6,49],["εἰσίν",10,191]],"So have I also endured months of vanity, and nights of pain have been appointed me."],["4",[["Ἐὰν",45,8],["κοιμηθῶ",301,555],["λέγω",31,149],["πότε",458,12],["ἡμέρα",28,13],["ὡς",36,8],["δʼ",14,12],["ἂν",83,12],["ἀναστῶ",121,227],["πάλιν",655,17],["πότε",458,12],["ἑσπέρα",488,13],["πλήρης",490,15],["δὲ",14,12],["γίνομαι",30,251],["ὀδυνῶν",774,61],["ἀπὸ",17,1],["ἑσπέρας",488,19],["ἕως",42,8],["πρωΐ",504,17]],"Whenever I lie down, I say, When [will it be] day? and whenever I rise up, again [I say] when [will it be] evening? and I am full of pains from evening to morning."],["5",[["Φύρεται",3150,108],["δέ",14,12],["μου",6,48],["τὸ",1,32],["σῶμα",454,33],["ἐν",4,1],["σαπρίᾳ",2953,180],["σκωλήκων",1974,77],["τήκω",1021,149],["δὲ",14,12],["βώλακας",6875,40],["γῆς",26,19],["ἀπὸ",17,1],["ἰχῶρος",5384,21],["ξύων",5870,67]],"And my body is covered with loathsome worms; and I waste away, scraping off clods of dust from my eruption."],["6",[["Ὁ",1,4],["δὲ",14,12],["βίος",726,5],["μου",6,48],["ἔστιν",10,87],["ἐλαφρότερος",4081,16],["λαλιᾶς",1824,19],["ἀπόλωλε",217,165],["δὲ",14,12],["ἐν",4,1],["κενῇ",780,96],["ἐλπίδι",530,2]],"And my life is lighter than a word, and has perished in vain hope."],["7",[["Μνήσθητι",230,242],["οὖν",227,12],["ὅτι",19,8],["πνεῦμά",168,20],["μου",6,48],["ἡ",1,11],["ζωὴ",216,13],["καὶ",2,8],["οὐκ",12,17],["ἔτι",111,17],["ἐπανελεύσεται",3440,89],["ὀφθαλμός",91,5],["μου",6,48],["ἰδεῖν",53,100],["ἀγαθόν",114,29]],"Remember then that my life is breath, and mine eye shall not yet again see good."],["8",[["Οὐ",12,17],["περιβλέψεταί",2939,89],["με",6,82],["ὀφθαλμὸς",91,5],["ὁρῶντός",112,143],["με",6,82],["οἱ",1,128],["ὀφθαλμοί",91,51],["σου",5,146],["ἐν",4,1],["ἐμοί",6,49],["καὶ",2,8],["οὐκ",12,17],["ἔτι",111,17],["εἰμί",10,149]],"The eye of him that sees me shall not see me [again]: thine eyes are upon me, and I am no more."],["9",[["Ὥσπερ",226,17],["νέφος",1555,33],["ἀποκαθαρθὲν",6304,387],["ἀπʼ",17,1],["οὐρανοῦ",94,21],["ἐὰν",45,8],["γὰρ",40,12],["ἄνθρωπος",43,5],["καταβῇ",175,160],["εἰς",8,1],["ᾅδην",586,7],["οὐκ",12,17],["ἔτι",111,17],["μὴ",25,8],["ἀναβῇ",88,160]],"[I am] as a cloud that is cleared away from the sky: for if a man go down to the grave, he shall not come up again:"],["10",[["οὐδʼ",106,12],["οὐ",12,17],["μὴ",25,8],["ἐπιστρέψῃ",117,160],["εἰς",8,1],["τὸν",1,6],["ἴδιον",683,59],["οἶκον",34,7],["οὐδʼ",106,12],["οὐ",12,17],["μὴ",25,8],["ἐπιγνῶ",431,227],["αὐτὸν",3,82],["ἔτι",111,17],["ὁ",1,4],["τόπος",99,5],["αὐτοῦ",3,48]],"and he shall surely not return to his own house, neither shall his place know him any more."],["11",[["Ἀτὰρ",5246,12],["οὖν",227,12],["οὐδὲ",106,12],["ἐγὼ",6,158],["φείσομαι",610,177],["τῷ",1,52],["στόματί",123,53],["μου",6,48],["λαλήσω",50,157],["ἐν",4,1],["ἀνάγκῃ",1126,2],["ὤν",10,67],["ἀνοίξω",362,157],["πικρίαν",1557,10],["ψυχῆς",63,19],["μου",6,83],["συνεχόμενος",1227,114]],"Then neither will I refrain my mouth: I will speak being in distress; being in anguish I will disclose the bitterness of my soul."],["12",[["Πότερον",2487,59],["θάλασσα",137,13],["εἰμὶ",10,149],["ἢ",61,8],["δράκων",1270,5],["ὅτι",19,8],["κατέταξας",4837,154],["ἐπʼ",9,1],["ἐμὲ",6,98],["φυλακήν",485,10]],"Am I a sea, or a serpent, that thou hast set a watch over me?"],["13",[["Εἴπα",18,147],["ὅτι",19,8],["παρακαλέσει",434,120],["με",6,82],["ἡ",1,11],["κλίνη",1221,13],["μου",6,48],["ἀνοίσω",384,157],["δὲ",14,12],["πρὸς",15,1],["ἐμαυτὸν",890,82],["ἰδίᾳ",683,96],["λόγον",48,7],["τῇ",1,95],["κοίτῃ",704,2],["μου",6,48]],"I said that my bed should comfort me, and I would privately counsel with myself on my couch."],["14",[["Ἐκφοβεῖς",2221,145],["με",6,82],["ἐνυπνίοις",653,92],["καὶ",2,8],["ὁράμασί",1873,92],["με",6,82],["καταπλήσσεις",2455,145]],"Thou scarest me with dreams, and dost terrify me with visions."],["15",[["Ἀπαλλάξεις",2659,159],["ἀπὸ",17,1],["πνεύματός",168,24],["μου",6,48],["τὴν",1,9],["ψυχήν",63,10],["μου",6,48],["ἀπὸ",17,1],["δὲ",14,12],["θανάτου",170,21],["τὰ",1,42],["ὀστᾶ",473,43],["μου",6,48]],"Thou wilt separate life from my spirit; and yet [keep] my bones from death."],["16",[["Οὐ",12,17],["γὰρ",40,12],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["ζήσομαι",107,177],["ἵνα",102,8],["μακροθυμήσω",2917,157],["ἀπόστα",293,275],["ἀπʼ",17,1],["ἐμοῦ",6,48],["κενὸς",780,16],["γάρ",40,12],["μου",6,48],["ὁ",1,4],["βίος",726,5]],"For I shall not live for ever, that I should patiently endure: depart from me, for my life [is] vain."],["17",[["Τί",39,119],["γάρ",40,12],["ἐστιν",10,87],["ἄνθρωπος",43,5],["ὅτι",19,8],["ἐμεγάλυνας",604,154],["αὐτόν",3,82],["ἢ",61,8],["ὅτι",19,8],["προσέχεις",558,145],["τὸν",1,6],["νοῦν",1442,7],["εἰς",8,1],["αὐτόν",3,82]],"For what is man, that thou hast magnified him? or that thou givest heed to him?"],["18",[["Ἢ",61,8],["ἐπισκοπὴν",1106,10],["αὐτοῦ",3,48],["ποιήσῃ",23,160],["ἕως",42,8],["τὸ",1,32],["πρωΐ",504,17],["καὶ",2,8],["εἰς",8,1],["ἀνάπαυσιν",1048,10],["αὐτὸν",3,82],["κρινεῖς",263,159]],"Wilt thou visit him till the morning, and judge him till [the time of] rest?"],["19",[["Ἕως",42,8],["τίνος",39,304],["οὐκ",12,17],["ἐᾷς",1406,199],["με",6,82],["οὐδὲ",106,12],["προΐῃ",2620,173],["με",6,82],["ἕως",42,8],["ἂν",83,12],["καταπίω",1183,227],["τὸν",1,6],["πτύελόν",6020,7],["μου",6,48]],"How long dost thou not let me alone, nor let me go, until I shall swallow down my spittle?"],["20",[["Εἰ",77,8],["ἐγὼ",6,158],["ἥμαρτον",237,147],["τί",39,119],["δυνήσομαι",185,177],["πρᾶξαι",1251,100],["ὁ",1,4],["ἐπιστάμενος",1087,114],["τὸν",1,6],["νοῦν",1442,7],["τῶν",1,76],["ἀνθρώπων",43,77],["διατί",960,105],["ἔθου",110,169],["με",6,82],["κατεντευκτήν",7420,7],["σου",5,146],["εἰμὶ",10,149],["δὲ",14,12],["ἐπὶ",9,1],["σοὶ",5,151],["φορτίον",3664,20]],"If I have sinned, what shall I be able to do, O thou that understandest the mind of men? why hast thou made me as thine accuser, and [why] am I a burden to thee?"],["21",[["Διατί",960,105],["οὐκ",12,17],["ἐποιήσω",23,169],["τῆς",1,18],["ἀνομίας",275,19],["μου",6,83],["λήθην",3292,10],["καὶ",2,8],["καθαρισμὸν",2017,7],["τῆς",1,18],["ἁμαρτίας",119,19],["μου",6,83],["νυνὶ",2099,17],["δὲ",14,12],["εἰς",8,1],["γῆν",26,10],["ἀπελεύσομαι",297,177],["ὀρθρίζων",931,67],["δὲ",14,12],["οὐκ",12,17],["ἔτι",111,17],["εἰμί",10,149]],"Why hast thou not forgotten my iniquity, and purged my sin? but now I shall depart to the earth; and in the morning, I am no more."]]