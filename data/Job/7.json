[["1",[["Πότερον",2495,28],["οὐχὶ",326,12],["πειρατήριόν",3930,20],["ἐστιν",10,87],["ὁ",1,4],["βίος",726,5],["ἀνθρώπου",43,21],["ἐπὶ",9,1],["τῆς",1,18],["γῆς",26,19],["καὶ",2,8],["ὥσπερ",221,17],["μισθίου",3602,153],["αὐθημερινοῦ",6873,153],["ἡ",1,11],["ζωὴ",212,13],["αὐτοῦ",3,48]],"Is not the life of man upon earth a state of trial? and his existence as that of a hireling by the day?"],["2",[["Ἢ",60,8],["ὥσπερ",221,17],["θεράπων",801,5],["δεδοικὼς",3057,265],["τὸν",1,6],["Κύριον",7,7],["αὐτοῦ",3,48],["καὶ",2,8],["τετευχὼς",1451,265],["σκιᾶς",978,19],["ἢ",60,8],["ὥσπερ",221,17],["μισθωτὸς",1828,5],["ἀναμένων",2817,67],["τὸν",1,6],["μισθὸν",814,7],["αὐτοῦ",3,48]],"Or as a servant that fears his master, and one who has grasped a shadow? or as a hireling waiting for his pay?"],["3",[["Οὕτως",70,17],["κᾀγὼ",611,105],["ὑπέμεινα",635,147],["μῆνας",295,31],["κενοὺς",779,58],["νύκτες",216,179],["δὲ",14,12],["ὀδυνῶν",771,61],["δεδομέναι",33,462],["μοι",6,49],["εἰσίν",10,189]],"So have I also endured months of vanity, and nights of pain have been appointed me."],["4",[["Ἐὰν",45,8],["κοιμηθῶ",302,569],["λέγω",31,149],["πότε",455,12],["ἡμέρα",28,13],["ὡς",36,8],["δʼ",14,12],["ἂν",82,12],["ἀναστῶ",121,227],["πάλιν",649,17],["πότε",455,12],["ἑσπέρα",486,13],["πλήρης",489,15],["δὲ",14,12],["γίνομαι",30,252],["ὀδυνῶν",771,61],["ἀπὸ",17,1],["ἑσπέρας",486,19],["ἕως",42,8],["πρωΐ",501,17]],"Whenever I lie down, I say, When [will it be] day? and whenever I rise up, again [I say] when [will it be] evening? and I am full of pains from evening to morning."],["5",[["Φύρεται",3677,108],["δέ",14,12],["μου",6,48],["τὸ",1,32],["σῶμα",451,33],["ἐν",4,1],["σαπρίᾳ",2966,179],["σκωλήκων",1979,77],["τήκω",1019,149],["δὲ",14,12],["βώλακας",6922,40],["γῆς",26,19],["ἀπὸ",17,1],["ἰχῶρος",5415,21],["ξύων",5900,67]],"And my body is covered with loathsome worms; and I waste away, scraping off clods of dust from my eruption."],["6",[["Ὁ",1,4],["δὲ",14,12],["βίος",726,5],["μου",6,48],["ἔστιν",10,87],["ἐλαφρότερος",4089,16],["λαλιᾶς",1826,19],["ἀπόλωλε",213,165],["δὲ",14,12],["ἐν",4,1],["κενῇ",779,96],["ἐλπίδι",527,2]],"And my life is lighter than a word, and has perished in vain hope."],["7",[["Μνήσθητι",231,242],["οὖν",223,12],["ὅτι",19,8],["πνεῦμά",167,20],["μου",6,48],["ἡ",1,11],["ζωὴ",212,13],["καὶ",2,8],["οὐκ",12,17],["ἔτι",110,17],["ἐπανελεύσεται",3443,89],["ὀφθαλμός",91,5],["μου",6,48],["ἰδεῖν",73,100],["ἀγαθόν",113,29]],"Remember then that my life is breath, and mine eye shall not yet again see good."],["8",[["Οὐ",12,17],["περιβλέψεταί",2952,89],["με",6,82],["ὀφθαλμὸς",91,5],["ὁρῶντός",111,143],["με",6,82],["οἱ",1,128],["ὀφθαλμοί",91,51],["σου",5,146],["ἐν",4,1],["ἐμοί",6,49],["καὶ",2,8],["οὐκ",12,17],["ἔτι",110,17],["εἰμί",10,149]],"The eye of him that sees me shall not see me [again]: thine eyes are upon me, and I am no more."],["9",[["Ὥσπερ",221,17],["νέφος",1554,33],["ἀποκαθαρθὲν",6335,391],["ἀπʼ",17,1],["οὐρανοῦ",94,21],["ἐὰν",45,8],["γὰρ",40,12],["ἄνθρωπος",43,5],["καταβῇ",174,160],["εἰς",8,1],["ᾅδην",583,7],["οὐκ",12,17],["ἔτι",110,17],["μὴ",25,8],["ἀναβῇ",87,160]],"[I am] as a cloud that is cleared away from the sky: for if a man go down to the grave, he shall not come up again:"],["10",[["οὐδʼ",105,12],["οὐ",12,17],["μὴ",25,8],["ἐπιστρέψῃ",116,160],["εἰς",8,1],["τὸν",1,6],["ἴδιον",681,59],["οἶκον",34,7],["οὐδʼ",105,12],["οὐ",12,17],["μὴ",25,8],["ἐπιγνῶ",433,227],["αὐτὸν",3,82],["ἔτι",110,17],["ὁ",1,4],["τόπος",99,5],["αὐτοῦ",3,48]],"and he shall surely not return to his own house, neither shall his place know him any more."],["11",[["Ἀτὰρ",5277,12],["οὖν",223,12],["οὐδὲ",105,12],["ἐγὼ",6,158],["φείσομαι",607,176],["τῷ",1,52],["στόματί",123,53],["μου",6,48],["λαλήσω",50,157],["ἐν",4,1],["ἀνάγκῃ",1125,2],["ὤν",10,67],["ἀνοίξω",820,157],["πικρίαν",1556,10],["ψυχῆς",62,19],["μου",6,83],["συνεχόμενος",1423,114]],"Then neither will I refrain my mouth: I will speak being in distress; being in anguish I will disclose the bitterness of my soul."],["12",[["Πότερον",2495,59],["θάλασσα",137,13],["εἰμὶ",10,149],["ἢ",60,8],["δράκων",1269,5],["ὅτι",19,8],["κατέταξας",5744,154],["ἐπʼ",9,1],["ἐμὲ",6,98],["φυλακήν",483,10]],"Am I a sea, or a serpent, that thou hast set a watch over me?"],["13",[["Εἴπα",18,147],["ὅτι",19,8],["παρακαλέσει",432,120],["με",6,82],["ἡ",1,11],["κλίνη",1184,13],["μου",6,48],["ἀνοίσω",382,157],["δὲ",14,12],["πρὸς",15,1],["ἐμαυτὸν",891,82],["ἰδίᾳ",681,96],["λόγον",48,7],["τῇ",1,95],["κοίτῃ",705,2],["μου",6,48]],"I said that my bed should comfort me, and I would privately counsel with myself on my couch."],["14",[["Ἐκφοβεῖς",2235,145],["με",6,82],["ἐνυπνίοις",647,92],["καὶ",2,8],["ὁράμασί",1874,92],["με",6,82],["καταπλήσσεις",2589,145]],"Thou scarest me with dreams, and dost terrify me with visions."],["15",[["Ἀπαλλάξεις",2661,159],["ἀπὸ",17,1],["πνεύματός",167,24],["μου",6,48],["τὴν",1,9],["ψυχήν",62,10],["μου",6,48],["ἀπὸ",17,1],["δὲ",14,12],["θανάτου",169,21],["τὰ",1,42],["ὀστᾶ",472,43],["μου",6,48]],"Thou wilt separate life from my spirit; and yet [keep] my bones from death."],["16",[["Οὐ",12,17],["γὰρ",40,12],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["ζήσομαι",117,176],["ἵνα",101,8],["μακροθυμήσω",2932,157],["ἀπόστα",646,275],["ἀπʼ",17,1],["ἐμοῦ",6,48],["κενὸς",779,16],["γάρ",40,12],["μου",6,48],["ὁ",1,4],["βίος",726,5]],"For I shall not live for ever, that I should patiently endure: depart from me, for my life [is] vain."],["17",[["Τί",39,119],["γάρ",40,12],["ἐστιν",10,87],["ἄνθρωπος",43,5],["ὅτι",19,8],["ἐμεγάλυνας",606,154],["αὐτόν",3,82],["ἢ",60,8],["ὅτι",19,8],["προσέχεις",557,145],["τὸν",1,6],["νοῦν",1443,7],["εἰς",8,1],["αὐτόν",3,82]],"For what is man, that thou hast magnified him? or that thou givest heed to him?"],["18",[["Ἢ",60,8],["ἐπισκοπὴν",1108,10],["αὐτοῦ",3,48],["ποιήσῃ",23,160],["ἕως",42,8],["τὸ",1,32],["πρωΐ",501,17],["καὶ",2,8],["εἰς",8,1],["ἀνάπαυσιν",1046,10],["αὐτὸν",3,82],["κρινεῖς",240,159]],"Wilt thou visit him till the morning, and judge him till [the time of] rest?"],["19",[["Ἕως",42,8],["τίνος",39,308],["οὐκ",12,17],["ἐᾷς",1407,199],["με",6,82],["οὐδὲ",105,12],["προΐῃ",2623,172],["με",6,82],["ἕως",42,8],["ἂν",82,12],["καταπίω",1183,227],["τὸν",1,6],["πτύελόν",6048,7],["μου",6,48]],"How long dost thou not let me alone, nor let me go, until I shall swallow down my spittle?"],["20",[["Εἰ",77,8],["ἐγὼ",6,158],["ἥμαρτον",244,147],["τί",39,119],["δυνήσομαι",184,176],["πρᾶξαι",1252,296],["ὁ",1,4],["ἐπιστάμενος",1088,114],["τὸν",1,6],["νοῦν",1443,7],["τῶν",1,76],["ἀνθρώπων",43,77],["διατί",962,105],["ἔθου",109,169],["με",6,82],["κατεντευκτήν",7469,7],["σου",5,146],["εἰμὶ",10,149],["δὲ",14,12],["ἐπὶ",9,1],["σοὶ",5,151],["φορτίον",3672,20]],"If I have sinned, what shall I be able to do, O thou that understandest the mind of men? why hast thou made me as thine accuser, and [why] am I a burden to thee?"],["21",[["Διατί",962,105],["οὐκ",12,17],["ἐποιήσω",23,169],["τῆς",1,18],["ἀνομίας",274,19],["μου",6,83],["λήθην",3297,10],["καὶ",2,8],["καθαρισμὸν",2025,7],["τῆς",1,18],["ἁμαρτίας",119,19],["μου",6,83],["νυνὶ",2106,17],["δὲ",14,12],["εἰς",8,1],["γῆν",26,10],["ἀπελεύσομαι",305,176],["ὀρθρίζων",930,67],["δὲ",14,12],["οὐκ",12,17],["ἔτι",110,17],["εἰμί",10,149]],"Why hast thou not forgotten my iniquity, and purged my sin? but now I shall depart to the earth; and in the morning, I am no more."]]