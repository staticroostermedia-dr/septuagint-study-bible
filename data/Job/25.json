[["1",[["Ὑπολαβὼν",1009,155],["δὲ",14,12],["Βαλδὰδ",0,0],["ὁ",1,4],["Σαυχίτης",0,0],["λέγει",31,87]],"Then Baldad the Sauchite answered and said,"],["2",[["Τί",39,119],["γὰρ",40,12],["προοίμιον",5034,33],["ἢ",60,8],["φόβος",330,5],["παρʼ",72,1],["αὐτοῦ",3,48],["ὁ",1,4],["ποιῶν",23,67],["τὴν",1,9],["σύμπασαν",1355,37],["ἐν",4,1],["ὑψιστῳ",473,111]],"What beginning or fear is his—even he that makes all things in the highest?"],["3",[["Μὴ",25,8],["γάρ",40,12],["τις",39,150],["ὑπολάβοι",1009,276],["ὅτι",19,8],["ἐστὶ",10,87],["παρέλκυσις",5948,13],["πειραταῖς",4992,139],["ἐπὶ",9,1],["τίνας",39,322],["δὲ",14,12],["οὐκ",12,17],["ἐπελεύσεται",540,89],["ἔνεδρα",1370,63],["παρʼ",72,1],["αὐτοῦ",3,48]],"For let none think that there is a respite for robbers: and upon whom will there not come a snare from him?"],["4",[["Πῶς",440,12],["γὰρ",40,12],["ἔσται",10,89],["δίκαιος",152,16],["βροτὸς",2019,5],["ἔναντι",230,17],["Κυρίου",7,21],["ἢ",60,8],["τίς",39,150],["ἂν",82,12],["ἀποκαθαρίσαι",6334,100],["αὐτὸν",3,82],["γεννητὸς",3811,16],["γυναικός",58,19]],"For how shall a mortal be just before the Lord? or who that is born of a woman shall purify himself?"],["5",[["Εἰ",77,8],["σελήνῃ",1211,2],["συντάσσει",450,87],["καὶ",2,8],["οὐκ",12,17],["ἐπιφαύσκει",6558,87],["ἄστρα",1334,63],["δὲ",14,12],["οὐ",12,17],["καθαρὰ",375,74],["ἐναντίον",138,17],["αὐτοῦ",3,48]],"If he gives an order to the moon, then it shines not; and the stars are not pure before him."],["6",[["Ἔα",10,297],["δὲ",14,12],["ἄνθρωπος",43,5],["σαπρία",2966,13],["καὶ",2,8],["υἱὸς",13,5],["ἀνθρώπου",43,21],["σκώληξ",1979,5]],"But alas! man is corruption, and the son of man a worm."]]