[["1",[["Ὑπολαβὼν",1009,155],["δὲ",14,12],["Ἰὼβ",811,105],["λέγει",31,87]],"Then Job answered and said,"],["2",[["Καὶ",2,8],["δὴ",193,12],["οἶδα",73,85],["ὅτι",19,8],["ἐκ",21,1],["χειρός",37,19],["μου",6,83],["ἡ",1,11],["ἔλεγξίς",6589,13],["ἐστι",10,87],["καὶ",2,8],["ἡ",1,11],["χεὶρ",37,13],["αὐτοῦ",3,48],["βαρεῖα",1028,15],["γέγονεν",30,165],["ἐπʼ",9,1],["ἐμῷ",523,113],["στεναγμῷ",1599,113]],"Yea, I know that pleading is out of my reach; and his hand has been made heavy upon my groaning."],["3",[["Τίς",39,150],["δʼ",14,12],["ἄρα",986,12],["γνοίη",81,276],["ὅτι",19,8],["εὕροιμι",106,351],["αὐτὸν",3,82],["καὶ",2,8],["ἔλθοιμι",56,351],["εἰς",8,1],["τέλος",369,33]],"Who would then know that I might find him, and come to an end [of the matter]?"],["4",[["Εἴποιμι",18,351],["δὲ",14,12],["ἐμαυτοῦ",891,48],["κρίμα",266,33],["τὸ",1,32],["δὲ",14,12],["στόμα",123,33],["μου",6,48],["ἐμπλήσαι",424,276],["ἐλέγχων",750,67]],"And I would plead my own cause, and he would fill my mouth with arguments."],["5",[["Γνοίην",81,351],["δὲ",14,12],["ἰάματα",2688,63],["ἅ",1,11],["μοι",6,49],["ἐρεῖ",191,87],["αἰσθοίμην",2569,708],["δὲ",14,12],["τίνα",39,368],["μοι",6,49],["ἀπαγγελεῖ",272,120]],"And I would know the remedies which he would speak to me, and I would perceive what he would tell me."],["6",[["Καὶ",2,8],["ἐν",4,1],["πολλῇ",74,96],["ἰσχύϊ",180,2],["ἐπελεύσεταί",540,89],["μοι",6,99],["εἶτα",2457,17],["ἐν",4,1],["ἀπειλῇ",1701,2],["μοι",6,99],["οὐ",12,17],["χρήσεται",927,89]],"Though he should come on me in [his] great strength, then he would not threaten me;"],["7",[["Ἀλήθεια",350,13],["γὰρ",40,12],["καὶ",2,8],["ἔλεγχος",1660,5],["παρʼ",72,1],["αὐτοῦ",3,48],["ἐξαγάγοι",299,276],["δὲ",14,12],["εἰς",8,1],["τέλος",369,33],["τὸ",1,32],["κρίμα",266,33],["μου",6,48]],"for truth and reproof are from him; and he would bring forth my judgment to an end."],["8",[["Εἰ",77,8],["γὰρ",40,12],["πρῶτος",314,16],["πορεύσομαι",49,176],["καὶ",2,8],["οὐκ",12,17],["ἔτι",110,17],["εἰμὶ",10,149],["τὰ",1,42],["δὲ",14,12],["ἐπʼ",9,1],["ἐσχάτοις",407,215],["τί",39,119],["οἶδα",73,85]],"For if I shall go first, and exist no longer, still what do I know [concerning] the latter end?"],["9",[["Ἀριστερὰ",879,15],["ποιήσαντος",23,521],["αὐτοῦ",3,48],["καὶ",2,8],["οὐ",12,17],["κατέσχον",1057,141],["περιβαλεῖ",743,120],["δεξιὰ",282,15],["καὶ",2,8],["οὐκ",12,17],["ὄψομαι",111,176]],"When he wrought on the left hand, then I observed [it] not: his right hand shall encompass me but I shall not see [it]."],["10",[["Οἶδε",1145,165],["γὰρ",40,12],["ἤδη",917,17],["ὁδόν",67,10],["μου",6,48],["διέκρινε",1507,3],["δέ",14,12],["με",6,82],["ὥσπερ",221,17],["τὸ",1,32],["χρυσίον",202,33]],"For he knows already my way; and he has tried me as gold."],["11",[["Ἐξελεύσομαι",84,176],["δὲ",14,12],["ἐν",4,1],["ἐντάλμασιν",4650,92],["αὐτοῦ",3,48],["ὁδοὺς",67,40],["γὰρ",40,12],["αὐτοῦ",3,48],["ἐφύλαξα",127,147],["καὶ",2,8],["οὐ",12,17],["μὴ",25,8],["ἐκκλίνω",393,149],["ἀπὸ",17,1],["ἐνταλμάτων",4650,45],["αὐτοῦ",3,48]],"And I will go forth according to his commandments, for I have kept his ways; and I shall not turn aside from his commandments,"],["12",[["καὶ",2,8],["οὐ",12,17],["μὴ",25,8],["παρέλθω",410,227],["ἐν",4,1],["δὲ",14,12],["κόλπῳ",1140,113],["μου",6,48],["ἔκρυψα",378,147],["ῥήματα",115,43],["αὐτοῦ",3,48]],"neither shall I transgress; but I have hid his words in my bosom."],["13",[["Εἰ",77,8],["δὲ",14,12],["καὶ",2,8],["αὐτὸς",3,158],["ἔκρινεν",240,3],["οὕτως",70,17],["τίς",39,150],["ἐστιν",10,87],["ὁ",1,4],["ἀντειπὼν",2819,155],["αὐτῷ",3,49],["ὁ",1,4],["γὰρ",40,12],["αὐτὸς",3,158],["ἠθέλησε",837,3],["καὶ",2,8],["ἐποίησε",23,3]],"And if too he has thus judged, who is he that has contradicted, for he has both willed [a thing] and done it."],["15",[["Διὰ",54,1],["τοῦτο",16,122],["ἐπʼ",9,1],["αὐτῷ",3,49],["ἐσπούδακα",0,0],["νουθετούμενος",2756,114],["δὲ",14,12],["ἐφρόντισα",2214,147],["αὐτοῦ",3,48]],"Therefore am I troubled at him; and when I was reproved, I thought of him."],["15a",[["Ἐπὶ",9,1],["τούτῳ",16,280],["ἀπὸ",17,1],["προσώπου",47,24],["αὐτοῦ",3,144],["κατασπουδασθῶ",7436,323],["κατανοήσω",1547,157],["καὶ",2,8],["πτοηθήσομαι",1331,175],["ἐξ",21,1],["αὐτοῦ",3,48]],"Therefore let me take good heed before him: I will consider, and be afraid of him."],["16",[["Κύριος",7,5],["δὲ",14,12],["ἐμαλάκυνε",7682,14],["τὴν",1,9],["καρδίαν",63,10],["μου",6,48],["ὁ",1,4],["δὲ",14,12],["παντοκράτωρ",338,5],["ἐσπούδασέ",2497,3],["με",6,82]],"But the Lord has softened my heart, and the Almighty has troubled me."],["17",[["Οὐ",12,17],["γὰρ",40,12],["ᾔδειν",73,324],["ὅτι",19,8],["ἐπελεύσεταί",540,89],["μοι",6,49],["σκότος",503,5],["πρὸ",235,1],["προσώπου",47,24],["δέ",14,12],["μου",6,48],["ἐκάλυψε",618,3],["γνόφος",1505,5]],"For I knew not that darkness would come upon me, and thick darkness has covered [me] before my face."]]