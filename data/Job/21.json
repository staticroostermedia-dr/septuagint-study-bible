[["1",[["Ὑπολαβὼν",1009,155],["δὲ",14,12],["Ἰὼβ",813,105],["λέγει",31,87]],"But Job answered and said,"],["2",[["Ἀκούσατε",54,69],["ἀκούσατέ",54,69],["μου",6,48],["τῶν",1,76],["λόγων",48,77],["ἵνα",102,8],["μὴ",25,8],["ᾖ",10,173],["μοι",6,49],["παρʼ",73,1],["ὑμῶν",5,136],["αὕτη",16,101],["ἡ",1,11],["παράκλησις",2183,13]],"Hear ye, hear ye my words, that I may not have this consolation from you."],["3",[["Ἄρατέ",206,69],["με",6,82],["ἐγὼ",6,158],["δὲ",14,12],["λαλήσω",50,157],["εἶτʼ",10,631],["οὐ",12,17],["καταγελάσετέ",1767,348],["μου",6,48]],"Raise me, and I will speak; then ye shall not laugh me to scorn."],["4",[["Τί",39,119],["γάρ",40,12],["μὴ",25,8],["ἀνθρώπου",43,21],["μου",6,48],["ἡ",1,11],["ἔλεγξις",6550,13],["ἢ",61,8],["διὰ",56,1],["τί",39,119],["οὐ",12,17],["θυμωθήσομαι",871,176]],"What! is my reproof of man? and why should I not be angry?"],["5",[["Εἰσβλέψαντες",4771,190],["εἰς",8,1],["ἐμὲ",6,98],["θαυμάσετε",963,348],["χεῖρα",37,10],["θέντες",110,190],["ἐπὶ",9,1],["σιαγόνι",1784,2]],"Look upon me, and wonder, laying your hand upon your cheek."],["6",[["Ἐάν",45,8],["τε",209,12],["γὰρ",40,12],["μνησθῶ",230,555],["ἐσπούδακα",2490,85],["ἔχουσι",124,191],["δέ",14,12],["μου",6,48],["τὰς",1,39],["σάρκας",287,40],["ὀδύναι",774,180]],"For even when I remember, I am alarmed, and pains seize my flesh."],["7",[["Διὰ",56,1],["τί",39,119],["ἀσεβεῖς",247,130],["ζῶσι",107,191],["πεπαλαίωνται",1384,254],["δὲ",14,12],["καὶ",2,8],["ἐν",4,1],["πλούτῳ",574,113]],"Wherefore do the ungodly live, and grow old even in wealth?"],["8",[["Ὁ",1,4],["σπόρος",2770,5],["αὐτῶν",3,41],["κατὰ",32,1],["ψυχὴν",63,10],["τὰ",1,42],["δὲ",14,12],["τέκνα",192,43],["αὐτῶν",3,41],["ἐν",4,1],["ὀφθαλμοῖς",91,139]],"Their seed is according to [their] desire, and their children are in [their] sight."],["9",[["Οἱ",1,128],["οἶκοι",34,51],["αὐτῶν",3,41],["εὐθηνοῦσι",2451,191],["φόβος",333,5],["δὲ",14,12],["οὐδαμοῦ",4334,17],["μάστιξ",1308,13],["δὲ",14,12],["παρὰ",73,1],["Κυρίου",7,21],["οὐκ",12,17],["ἔστιν",10,87],["ἐπʼ",9,1],["αὐτοῖς",3,142]],"Their houses are prosperous, neither [have they] any where [cause for] fear, neither is there a scourge from the Lord upon them."],["10",[["Ἡ",1,11],["βοῦς",411,5],["αὐτῶν",3,41],["οὐκ",12,17],["ὠμοτόκησε",9947,3],["διεσώθη",727,38],["δὲ",14,12],["αὐτῶν",3,41],["ἐν",4,1],["γαστρὶ",777,2],["ἔχουσα",124,183],["καὶ",2,8],["οὐκ",12,17],["ἔσφαλε",2781,3]],"Their cow does not cast her calf, and their [beast] with young is safe, and does not miscarry."],["11",[["Μένουσι",681,191],["δὲ",14,12],["ὡς",36,8],["πρόβατα",194,43],["αἰώνια",391,65],["τὰ",1,42],["δὲ",14,12],["παιδία",449,43],["αὐτῶν",3,41],["προσπαίζουσιν",5997,191]],"And they remain as an unfailing flock, and their children play before [them], taking up the psaltery and harp;"],["12",[["ἀναλαβόντες",575,190],["ψαλτήριον",1693,20],["καὶ",2,8],["κιθάραν",1513,10],["καὶ",2,8],["εὐφραίνονται",244,299],["φωνῇ",95,2],["ψαλμοῦ",644,21]],"and they rejoice at the voice of a song."],["13",[["Συνετέλεσαν",317,141],["δὲ",14,12],["ἐν",4,1],["ἀγαθοῖς",114,90],["τὸν",1,6],["βίον",726,7],["αὐτῶν",3,41],["ἐν",4,1],["δὲ",14,12],["ἀναπαύσει",674,120],["ᾅδου",586,21],["ἐκοιμήθησαν",301,94]],"And they spend their days in wealth, and fall asleep in the rest of the grave."],["14",[["Λέγει",31,87],["δὲ",14,12],["Κυρίῳ",7,113],["ἀπόστα",293,275],["ἀπʼ",17,1],["ἐμοῦ",6,48],["ὁδούς",68,40],["σου",5,146],["εἰδέναι",53,107],["οὐ",12,17],["βούλομαι",463,251]],"Yet [such a man] says to the Lord, Depart from me; I desire not to know thy ways."],["15",[["Τί",39,119],["ἱκανὸς",1007,16],["ὅτι",19,8],["δουλεύσομεν",398,269],["αὐτῷ",3,49],["καὶ",2,8],["τίς",39,368],["ὠφέλεια",2556,13],["ὅτι",19,8],["ἀπαντήσομεν",1024,269],["αὐτῷ",3,49]],"What is the Mighty One, that we should serve him? and what profit is there that we should approach him?"],["16",[["Ἐν",4,1],["χερσὶ",37,71],["γὰρ",40,12],["ἦν",10,14],["αὐτῶν",3,41],["τὰ",1,42],["ἀγαθὰ",114,65],["ἔργα",105,43],["δὲ",14,12],["ἀσεβῶν",247,163],["οὐκ",12,17],["ἐφορᾷ",2677,173]],"For their good things were in [their] hands, but he regards not the works of the ungodly."],["17",[["Οὐ",12,17],["μὴν",296,12],["δὲ",14,12],["ἀλλὰ",108,17],["καὶ",2,8],["ἀσεβῶν",247,163],["λύχνος",1059,5],["σβεσθήσεται",1077,125],["ἐπελεύσεται",542,89],["δὲ",14,12],["αὐτοῖς",3,142],["ἡ",1,11],["καταστροφὴ",2173,13],["ὠδῖνες",2005,180],["δὲ",14,12],["αὐτοὺς",3,60],["ἕξουσιν",124,207],["ἀπὸ",17,1],["ὀργῆς",198,19]],"Nevertheless, the lamp of the ungodly also shall be put out, and destruction shall come upon them, and pangs of vengeance shall seize them."],["18",[["Ἔσονται",10,127],["δὲ",14,12],["ὥσπερ",226,17],["ἄχυρα",1857,63],["ὑπʼ",122,1],["ἀνέμου",850,21],["ἢ",61,8],["ὥσπερ",226,17],["κονιορτὸς",1894,5],["ὃν",24,106],["ὑφείλετο",5428,26],["λαίλαψ",3289,13]],"And they shall be as chaff before the wind, or as dust which the storm has taken up."],["19",[["Ἐκλείποι",321,273],["υἱοὺς",13,31],["τὰ",1,42],["ὑπάρχοντα",418,232],["αὐτοῦ",3,48],["ἀνταποδώσει",666,120],["πρὸς",15,1],["αὐτὸν",3,82],["καὶ",2,8],["γνώσεται",79,89]],"Let his substance fail [to supply] his children: [God] shall recompense him, and he shall know it."],["20",[["Ἴδοισαν",53,405],["οἱ",1,128],["ὀφθαλμοὶ",91,51],["αὐτοῦ",3,48],["τὴν",1,9],["ἑαυτοῦ",92,48],["σφαγὴν",1742,10],["ἀπὸ",17,1],["δὲ",14,12],["Κυρίου",7,21],["μὴ",25,8],["διασωθείη",727,544]],"Let his eyes see his own destruction, and let him not be saved by the Lord."],["21",[["Ὅτι",19,8],["τὸ",1,32],["θέλημα",1039,33],["αὐτοῦ",3,48],["ἐν",4,1],["οἴκῳ",34,113],["αὐτοῦ",3,48],["μετʼ",29,1],["αὐτοῦ",3,48],["καὶ",2,8],["ἀριθμοὶ",355,51],["μηνῶν",386,77],["αὐτοῦ",3,48],["διῃρέθησαν",1112,94]],"For his desire is in his house with him, and the number of his months has been suddenly cut off."],["22",[["Πότερον",2487,59],["οὐχὶ",330,12],["ὁ",1,4],["Κύριός",7,5],["ἐστιν",10,87],["ὁ",1,4],["διδάσκων",545,67],["σύνεσιν",469,10],["καὶ",2,8],["ἐπιστήμην",891,10],["αὐτὸς",3,158],["δὲ",14,12],["φόνους",1645,31],["διακρίνει",1506,87]],"Is it not the Lord who teaches understanding and knowledge? and does not he judge murders?"],["23",[["Οὗτος",16,112],["ἀποθανεῖται",109,89],["ἐν",4,1],["κράτει",385,239],["ἁπλοσύνης",9161,19],["αὐτοῦ",3,48],["ὅλος",235,16],["δὲ",14,12],["εὐπαθῶν",5622,67],["καὶ",2,8],["εὐθηνῶν",2451,67]],"One shall die in his perfect strength, and wholly at ease and prosperous;"],["24",[["Τὰ",1,42],["δὲ",14,12],["ἔγκατα",3753,43],["αὐτοὺ",3,144],["πλήρη",490,65],["στέατος",576,24],["μυελὸς",4916,5],["δὲ",14,12],["αὐτοῦ",3,48],["διαχεῖται",1588,108]],"and his inwards are full of fat, and his marrow is diffused [throughout him]."],["25",[["Ὁ",1,4],["δὲ",14,12],["τελευτᾷ",581,173],["ὑπὸ",122,1],["πικρίας",1557,19],["ψυχῆς",63,19],["οὐ",12,17],["φαγὼν",147,155],["οὐδὲν",228,29],["ἀγαθόν",114,29]],"And another dies in bitterness of soul, not eating any good thing."],["26",[["Ὁμοθυμαδὸν",1262,17],["δὲ",14,12],["ἐπὶ",9,1],["γῆς",26,19],["κοιμῶνται",301,299],["σαπρία",2953,13],["δὲ",14,12],["αὐτοὺς",3,60],["ἐκάλυψεν",620,3]],"But they lie down in the earth together, and corruption covers them."],["27",[["Ὥστε",346,17],["οἶδα",53,85],["ὑμᾶς",5,209],["ὅτι",19,8],["τόλμῃ",3981,2],["ἐπίκεισθέ",3748,68],["μοι",6,99]],"So I know you, that ye presumptuously attack me:"],["28",[["Ὥστε",346,17],["ἐρεῖτε",667,339],["ποῦ",478,17],["ἐστιν",10,87],["οἶκος",34,5],["ἄρχοντος",320,143],["καὶ",2,8],["ποῦ",478,17],["ἐστιν",10,87],["ἡ",1,11],["σκέπη",1188,13],["τῶν",1,44],["σκηνωμάτων",682,45],["τῶν",1,44],["ἀσεβῶν",247,79]],"so that ye will say, Where is the house of the prince? and where is the covering of the tabernacles of the ungodly?"],["29",[["Ἐρωτήσατε",822,69],["παραπορευομένους",1250,230],["ὁδὸν",68,10],["καὶ",2,8],["τὰ",1,42],["σημεῖα",505,43],["αὐτῶν",3,41],["οὐκ",12,17],["ἀπαλλοτριώσετε",2658,348]],"Ask those that go by the way, and do not disown their tokens."],["30",[["Ὅτι",19,8],["εἰς",8,1],["ἡμέραν",28,10],["ἀπωλείας",541,19],["κουφίζεται",2591,108],["ὁ",1,4],["πονηρὸς",164,16],["εἰς",8,1],["ἡμέραν",28,10],["ὀργῆς",198,19],["αὐτοῦ",3,48],["ἀπαχθήσονται",1212,135]],"For the wicked hastens to the day of destruction: they shall be led away for the day of his vengeance."],["31",[["Τίς",39,150],["ἀπαγγελεῖ",273,120],["ἐπὶ",9,1],["προσώπου",47,24],["αὐτοῦ",3,144],["τὴν",1,9],["ὁδὸν",68,10],["αὐτοῦ",3,48],["καὶ",2,8],["αὐτὸς",3,158],["ἐποίησε",23,3],["τίς",39,150],["ἀνταποδώσει",666,120],["αὐτῷ",3,49]],"Who will tell him his way to his face, whereas he has done [it]? who shall recompense him?"],["32",[["Καὶ",2,8],["αὐτὸς",3,158],["εἰς",8,1],["τάφους",865,31],["ἀπηνέχθη",1396,38],["καὶ",2,8],["αὐτὸς",3,158],["ἐπὶ",9,1],["σωρῶν",2782,77],["ἠγρύπνησεν",2802,3]],"And he has been led away to the tombs, and he has watched over the heaps."],["33",[["Ἐγλυκάνθησαν",0,0],["αὐτῷ",3,49],["χάλικες",6213,51],["χειμάῤῥου",737,21],["καὶ",2,8],["ὀπίσω",167,17],["αὐτοῦ",3,48],["πᾶς",11,16],["ἄνθρωπος",43,5],["ἀπελεύσεται",297,89],["καὶ",2,8],["ἔμπροσθεν",390,17],["αὐτοῦ",3,48],["ἀναρίθμητοι",2515,130]],"The stones of the valley have been sweet to him, and every man shall depart after him, and [there are] innumerable [ones] before him."],["34",[["Πῶς",441,12],["δὲ",14,12],["παρακαλεῖτέ",434,84],["με",6,82],["κενά",780,74],["τὸ",1,32],["δὲ",14,12],["ἐμὲ",6,82],["καταπαύσασθαι",778,103],["ἀφʼ",17,1],["ὑμῶν",5,136],["οὐδέν",228,29]],"How then do ye comfort me in vain? whereas I have no rest from your molestation."]]