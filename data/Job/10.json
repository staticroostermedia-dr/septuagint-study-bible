[["1",[["Καμνὼν",3571,67],["τῇ",1,95],["ψυχῇ",63,2],["μου",6,48],["στένων",3643,67],["ἐπαφήσω",4597,157],["ἐπʼ",9,1],["αὐτὸν",3,82],["τὰ",1,42],["ῥήματα",116,43],["μου",6,48],["λαλήσω",50,157],["πικρίᾳ",1557,180],["ψυχῆς",63,19],["μου",6,83],["συνεχόμενος",1227,114]],"Weary in my soul, I will pour my words with groans upon him: I will speak being straitened in the bitterness of my soul."],["2",[["καὶ",2,8],["ἐρῶ",165,157],["πρὸς",15,1],["Κύριον",7,7],["μή",25,8],["με",6,82],["ἀσεβεῖν",1256,54],["δίδασκε",545,239],["καὶ",2,8],["διατί",960,105],["με",6,82],["οὕτως",71,17],["ἔκρινας",263,154]],"And I will say to the Lord, Do not teach me to be impious; and wherefore hast thou thus judged me?"],["3",[["Ἢ",61,8],["καλόν",266,28],["σοι",5,151],["ἐὰν",45,8],["ἀδικήσω",760,157],["ὅτι",19,8],["ἀπείπω",4031,227],["ἔργα",105,43],["χειρῶν",37,61],["σου",5,146],["βουλῇ",350,2],["δὲ",14,12],["ἀσεβῶν",247,163],["προσέσχες",558,154]],"Is it good before thee if I be unrighteous? for thou hast disowned the work of thy hands, and attended to the counsel of the ungodly."],["4",[["Ἢ",61,8],["ὥσπερ",226,17],["βροτὸς",2011,5],["ὁρᾷ",112,321],["καθορᾷς",4245,199],["ἢ",61,8],["καθὼς",221,17],["ὁρᾷ",112,321],["ἄνθρωπος",43,5],["βλέψῃ",470,116]],"Or dost thou see as a mortal sees? or wilt thou look as a man sees?"],["5",[["Ἢ",61,8],["ὁ",1,4],["βίος",726,5],["σου",5,146],["ἀνθρώπινός",2656,16],["ἐστιν",10,87],["ἢ",61,8],["τὰ",1,42],["ἔτη",81,43],["σου",5,146],["ἀνδρὸς",38,21]],"Or is thy life human, or thy years [the years] of a man,"],["6",[["ὅτι",19,8],["ἀνεζήτησας",5179,154],["τὴν",1,9],["ἀνομίαν",275,10],["μου",6,48],["καὶ",2,8],["τὰς",1,39],["ἁμαρτίας",119,40],["μου",6,48],["ἐξιχνίασας",2223,154]],"that thou hast enquired into mine iniquity, and searched out my sins?"],["7",[["Οἶδας",53,172],["γὰρ",40,12],["ὅτι",19,8],["οὐκ",12,17],["ἠσέβησα",1256,147],["ἀλλὰ",108,17],["τίς",39,150],["ἐστιν",10,87],["ὁ",1,4],["ἐκ",21,1],["τῶν",1,123],["χειρῶν",37,61],["σου",5,146],["ἐξαιρούμενος",413,114]],"For thou knowest that I have not committed iniquity: but who is he that can deliver out of thy hands?"],["8",[["Αἱ",1,185],["χεῖρές",37,180],["σου",5,146],["ἔπλασάν",910,141],["με",6,82],["καὶ",2,8],["ἐποίησάν",23,141],["με",6,82],["μετὰ",29,1],["ταῦτα",16,248],["μεταβαλών",1349,155],["με",6,82],["ἔπαισας",1418,154]],"Thy hands have formed me and made me; afterwards thou didst change [thy mind], and smite me."],["9",[["Μνήσθητι",230,242],["ὅτι",19,8],["πηλόν",1386,7],["με",6,82],["ἔπλασας",910,154],["εἰς",8,1],["δὲ",14,12],["γῆν",26,10],["με",6,98],["πάλιν",655,17],["ἀποστρέφεις",130,145]],"Remember that thou hast made me [as] clay, and thou dost turn me again to earth."],["10",[["Ἢ",61,8],["οὐχ",12,17],["ὥσπερ",226,17],["γάλα",1034,33],["με",6,82],["ἤμελξας",6256,154],["ἐτύρωσας",0,0],["δέ",14,12],["με",6,82],["ἶσα",944,74],["τυρῷ",6164,113]],"Hast thou not poured me out like milk, and curdled me like cheese?"],["11",[["Δέρμα",669,20],["δὲ",14,12],["καὶ",2,8],["κρέας",629,20],["με",6,82],["ἐνέδυσας",516,154],["ὀστέοις",473,92],["δὲ",14,12],["καὶ",2,8],["νεύροις",2606,92],["με",6,82],["ἔνειρας",9406,154]],"And thou didst clothe me with skin and flesh, and frame me with bones and sinews."],["12",[["Ζωὴν",216,10],["δὲ",14,12],["καὶ",2,8],["ἔλεος",183,33],["ἔθου",110,169],["παρʼ",73,1],["ἐμοὶ",6,49],["ἡ",1,11],["δὲ",14,12],["ἐπισκοπή",1106,13],["σου",5,146],["ἐφυλαξέ",125,3],["μου",6,48],["τὸ",1,32],["πνεῦμα",168,33]],"And thou didst bestow upon me life and mercy, and thy oversight has preserved my spirit."],["13",[["Ταῦτα",16,248],["ἔχων",124,67],["ἐν",4,1],["σεαυτῷ",255,49],["οἶδα",53,85],["ὅτι",19,8],["πάντα",11,65],["δύνασαι",185,166],["ἀδυνατεῖ",2400,87],["δέ",14,12],["σοι",5,151],["οὐθέν",228,29]],"Having these things in thyself, I know that thou canst do all things; for nothing is impossible with thee."],["14",[["Ἐάν",45,8],["τε",209,12],["γὰρ",40,12],["ἁμάρτω",237,227],["φυλάσσεις",125,145],["με",6,82],["ἀπὸ",17,1],["δὲ",14,12],["ἀνομίας",275,19],["οὐκ",12,17],["ἀθῶόν",1079,59],["με",6,82],["πεποίηκας",23,172]],"And if I should sin, thou watchest me; and thou hast not cleared me from iniquity."],["15",[["Ἐάν",45,8],["τε",209,12],["γὰρ",40,12],["ἀσεβήσω",1256,157],["οἴμοι",2103,316],["ἐὰν",45,8],["δὲ",14,12],["ὦ",646,316],["δίκαιος",153,16],["οὐ",12,17],["δύναμαι",185,251],["ἀνακύψαι",8853,100],["πλήρης",490,109],["γὰρ",40,12],["ἀτιμίας",1049,40],["εἰμί",10,149]],"Or if I should be ungodly, woe is me: and if I should be righteous, I cannot lift myself up, for I am full of dishonour."],["16",[["Ἀγρεύομαι",4009,251],["γὰρ",40,12],["ὥσπερ",226,17],["λέων",424,5],["εἰς",8,1],["σφαγήν",1742,10],["πάλιν",655,17],["γὰρ",40,12],["μεταβαλὼν",1349,155],["δεινῶς",3805,17],["με",6,82],["ὀλέκεις",5400,145]],"For I am hunted like a lion for slaughter; for again thou hast changed and art terribly destroying me;"],["17",[["ἐπανακαινίζων",9473,67],["ἐπʼ",9,1],["ἐμὲ",6,98],["τὴν",1,9],["ἔτασίν",5373,10],["μου",6,48],["ὀργῇ",198,2],["δὲ",14,12],["μεγάλῃ",66,96],["μοι",6,99],["ἐχρήσω",928,169],["ἐπήγαγες",417,154],["δὲ",14,12],["ἐπʼ",9,1],["ἐμὲ",6,82],["πειρατήρια",3920,63]],"renewing against me my torture: and thou hast dealt with me in great anger, and thou hast brought trials upon me."],["18",[["Ἱνατί",102,238],["οὖν",227,12],["ἐκ",21,1],["κοιλίας",547,19],["με",6,82],["ἐξήγαγες",295,154],["καὶ",2,8],["οὐκ",12,17],["ἀπέθανον",109,141],["ὀφθαλμὸς",91,5],["δέ",14,12],["με",6,82],["οὐκ",12,17],["εἶδε",53,3]],"Why then didst thou bring me out of the womb? and why did I not die, and no eye see me,"],["19",[["καὶ",2,8],["ὥσπερ",226,17],["οὐκ",12,17],["ὢν",10,67],["ἐγενόμην",30,152],["διατί",960,105],["γὰρ",40,12],["ἐκ",21,1],["γαστρὸς",777,19],["εἰς",8,1],["μνῆμα",1827,33],["οὐκ",12,17],["ἀπηλλάγην",4519,94]],"and I become as if I had not been? for why was I not carried from the womb to the grave?"],["20",[["Ἢ",61,8],["οὐκ",12,17],["ὀλίγος",555,16],["ἐστὶν",10,87],["ὁ",1,4],["βίος",726,5],["τοῦ",1,30],["χρόνου",486,21],["μου",6,48],["ἔασόν",1406,198],["με",6,82],["ἀναπαύσασθαι",674,103],["μικρὸν",367,59]],"Is not the time of my life short? suffer me to rest a little,"],["21",[["πρὸ",238,1],["τοῦ",1,30],["με",6,82],["πορευθῆναι",49,175],["ὅθεν",1153,17],["οὐκ",12,17],["ἀναστρέψω",522,157],["εἰς",8,1],["γῆν",26,10],["σκοτεινὴν",2378,37],["καὶ",2,8],["γνοφερὰν",0,0]],"before I go whence I shall not return, to a land of darkness and gloominess;"],["22",[["εἰς",8,1],["γῆν",26,10],["σκότους",506,31],["αἰωνίου",391,78],["οὗ",120,17],["οὐκ",12,17],["ἔστι",10,87],["φέγγος",1644,33],["οὐδὲ",106,12],["ὁρᾷν",112,54],["ζωὴν",216,10],["βροτῶν",2011,77]],"to a land of perpetual darkness, where there is no light, neither [can any one] see the life of mortals."]]