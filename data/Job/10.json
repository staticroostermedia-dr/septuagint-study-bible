[["1",[["Καμνὼν",3575,67],["τῇ",1,95],["ψυχῇ",62,2],["μου",6,48],["στένων",3650,67],["ἐπαφήσω",4621,157],["ἐπʼ",9,1],["αὐτὸν",3,82],["τὰ",1,42],["ῥήματα",115,43],["μου",6,48],["λαλήσω",50,157],["πικρίᾳ",1556,179],["ψυχῆς",62,19],["μου",6,83],["συνεχόμενος",1423,114]],"Weary in my soul, I will pour my words with groans upon him: I will speak being straitened in the bitterness of my soul."],["2",[["καὶ",2,8],["ἐρῶ",1659,149],["πρὸς",15,1],["Κύριον",7,7],["μή",25,8],["με",6,82],["ἀσεβεῖν",1313,54],["δίδασκε",543,239],["καὶ",2,8],["διατί",962,105],["με",6,82],["οὕτως",70,17],["ἔκρινας",240,154]],"And I will say to the Lord, Do not teach me to be impious; and wherefore hast thou thus judged me?"],["3",[["Ἢ",60,8],["καλόν",264,28],["σοι",5,151],["ἐὰν",45,8],["ἀδικήσω",819,157],["ὅτι",19,8],["ἀπείπω",4040,227],["ἔργα",104,43],["χειρῶν",37,61],["σου",5,146],["βουλῇ",349,2],["δὲ",14,12],["ἀσεβῶν",246,163],["προσέσχες",557,154]],"Is it good before thee if I be unrighteous? for thou hast disowned the work of thy hands, and attended to the counsel of the ungodly."],["4",[["Ἢ",60,8],["ὥσπερ",221,17],["βροτὸς",2019,5],["ὁρᾷ",111,325],["καθορᾷς",4257,199],["ἢ",60,8],["καθὼς",218,17],["ὁρᾷ",111,325],["ἄνθρωπος",43,5],["βλέψῃ",469,116]],"Or dost thou see as a mortal sees? or wilt thou look as a man sees?"],["5",[["Ἢ",60,8],["ὁ",1,4],["βίος",726,5],["σου",5,146],["ἀνθρώπινός",2659,16],["ἐστιν",10,87],["ἢ",60,8],["τὰ",1,42],["ἔτη",80,43],["σου",5,146],["ἀνδρὸς",38,21]],"Or is thy life human, or thy years [the years] of a man,"],["6",[["ὅτι",19,8],["ἀνεζήτησας",5208,154],["τὴν",1,9],["ἀνομίαν",274,10],["μου",6,48],["καὶ",2,8],["τὰς",1,39],["ἁμαρτίας",119,40],["μου",6,48],["ἐξιχνίασας",2237,154]],"that thou hast enquired into mine iniquity, and searched out my sins?"],["7",[["Οἶδας",73,263],["γὰρ",40,12],["ὅτι",19,8],["οὐκ",12,17],["ἠσέβησα",1313,147],["ἀλλὰ",107,17],["τίς",39,150],["ἐστιν",10,87],["ὁ",1,4],["ἐκ",21,1],["τῶν",1,123],["χειρῶν",37,61],["σου",5,146],["ἐξαιρούμενος",411,114]],"For thou knowest that I have not committed iniquity: but who is he that can deliver out of thy hands?"],["8",[["Αἱ",1,183],["χεῖρές",37,179],["σου",5,146],["ἔπλασάν",912,141],["με",6,82],["καὶ",2,8],["ἐποίησάν",23,141],["με",6,82],["μετὰ",29,1],["ταῦτα",16,249],["μεταβαλών",1345,155],["με",6,82],["ἔπαισας",1476,154]],"Thy hands have formed me and made me; afterwards thou didst change [thy mind], and smite me."],["9",[["Μνήσθητι",231,242],["ὅτι",19,8],["πηλόν",1386,7],["με",6,82],["ἔπλασας",912,154],["εἰς",8,1],["δὲ",14,12],["γῆν",26,10],["με",6,98],["πάλιν",649,17],["ἀποστρέφεις",130,145]],"Remember that thou hast made me [as] clay, and thou dost turn me again to earth."],["10",[["Ἢ",60,8],["οὐχ",12,17],["ὥσπερ",221,17],["γάλα",1031,33],["με",6,82],["ἤμελξας",6287,154],["ἐτύρωσας",0,0],["δέ",14,12],["με",6,82],["ἶσα",945,74],["τυρῷ",6195,113]],"Hast thou not poured me out like milk, and curdled me like cheese?"],["11",[["Δέρμα",665,20],["δὲ",14,12],["καὶ",2,8],["κρέας",628,20],["με",6,82],["ἐνέδυσας",515,154],["ὀστέοις",472,92],["δὲ",14,12],["καὶ",2,8],["νεύροις",2608,92],["με",6,82],["ἔνειρας",9474,154]],"And thou didst clothe me with skin and flesh, and frame me with bones and sinews."],["12",[["Ζωὴν",212,10],["δὲ",14,12],["καὶ",2,8],["ἔλεος",182,33],["ἔθου",109,169],["παρʼ",72,1],["ἐμοὶ",6,49],["ἡ",1,11],["δὲ",14,12],["ἐπισκοπή",1108,13],["σου",5,146],["ἐφυλαξέ",127,3],["μου",6,48],["τὸ",1,32],["πνεῦμα",167,33]],"And thou didst bestow upon me life and mercy, and thy oversight has preserved my spirit."],["13",[["Ταῦτα",16,249],["ἔχων",124,67],["ἐν",4,1],["σεαυτῷ",293,49],["οἶδα",73,85],["ὅτι",19,8],["πάντα",11,65],["δύνασαι",184,166],["ἀδυνατεῖ",2408,87],["δέ",14,12],["σοι",5,151],["οὐθέν",225,29]],"Having these things in thyself, I know that thou canst do all things; for nothing is impossible with thee."],["14",[["Ἐάν",45,8],["τε",207,12],["γὰρ",40,12],["ἁμάρτω",244,227],["φυλάσσεις",127,145],["με",6,82],["ἀπὸ",17,1],["δὲ",14,12],["ἀνομίας",274,19],["οὐκ",12,17],["ἀθῶόν",0,0],["με",6,82],["πεποίηκας",0,0]],"And if I should sin, thou watchest me; and thou hast not cleared me from iniquity."],["15",[["Ἐάν",45,8],["τε",207,12],["γὰρ",40,12],["ἀσεβήσω",1313,157],["οἴμοι",2110,320],["ἐὰν",45,8],["δὲ",14,12],["ὦ",641,320],["δίκαιος",152,16],["οὐ",12,17],["δύναμαι",184,252],["ἀνακύψαι",8916,100],["πλήρης",489,109],["γὰρ",40,12],["ἀτιμίας",1048,40],["εἰμί",10,149]],"Or if I should be ungodly, woe is me: and if I should be righteous, I cannot lift myself up, for I am full of dishonour."],["16",[["Ἀγρεύομαι",4018,252],["γὰρ",40,12],["ὥσπερ",221,17],["λέων",421,5],["εἰς",8,1],["σφαγήν",1741,10],["πάλιν",649,17],["γὰρ",40,12],["μεταβαλὼν",1345,155],["δεινῶς",3818,17],["με",6,82],["ὀλέκεις",5432,145]],"For I am hunted like a lion for slaughter; for again thou hast changed and art terribly destroying me;"],["17",[["ἐπανακαινίζων",9542,67],["ἐπʼ",9,1],["ἐμὲ",6,98],["τὴν",1,9],["ἔτασίν",5402,10],["μου",6,48],["ὀργῇ",198,2],["δὲ",14,12],["μεγάλῃ",65,96],["μοι",6,99],["ἐχρήσω",927,169],["ἐπήγαγες",415,154],["δὲ",14,12],["ἐπʼ",9,1],["ἐμὲ",6,82],["πειρατήρια",3930,63]],"renewing against me my torture: and thou hast dealt with me in great anger, and thou hast brought trials upon me."],["18",[["Ἱνατί",101,238],["οὖν",223,12],["ἐκ",21,1],["κοιλίας",545,19],["με",6,82],["ἐξήγαγες",299,154],["καὶ",2,8],["οὐκ",12,17],["ἀπέθανον",108,141],["ὀφθαλμὸς",91,5],["δέ",14,12],["με",6,82],["οὐκ",12,17],["εἶδε",276,3]],"Why then didst thou bring me out of the womb? and why did I not die, and no eye see me,"],["19",[["καὶ",2,8],["ὥσπερ",221,17],["οὐκ",12,17],["ὢν",10,67],["ἐγενόμην",30,152],["διατί",962,105],["γὰρ",40,12],["ἐκ",21,1],["γαστρὸς",775,19],["εἰς",8,1],["μνῆμα",1829,33],["οὐκ",12,17],["ἀπηλλάγην",4543,94]],"and I become as if I had not been? for why was I not carried from the womb to the grave?"],["20",[["Ἢ",60,8],["οὐκ",12,17],["ὀλίγος",554,16],["ἐστὶν",10,87],["ὁ",1,4],["βίος",726,5],["τοῦ",1,30],["χρόνου",484,21],["μου",6,48],["ἔασόν",1407,198],["με",6,82],["ἀναπαύσασθαι",670,103],["μικρὸν",365,59]],"Is not the time of my life short? suffer me to rest a little,"],["21",[["πρὸ",235,1],["τοῦ",1,30],["με",6,82],["πορευθῆναι",49,174],["ὅθεν",1154,17],["οὐκ",12,17],["ἀναστρέψω",520,157],["εἰς",8,1],["γῆν",26,10],["σκοτεινὴν",2386,37],["καὶ",2,8],["γνοφερὰν",0,0]],"before I go whence I shall not return, to a land of darkness and gloominess;"],["22",[["εἰς",8,1],["γῆν",26,10],["σκότους",503,31],["αἰωνίου",388,78],["οὗ",120,17],["οὐκ",12,17],["ἔστι",10,87],["φέγγος",1644,33],["οὐδὲ",105,12],["ὁρᾷν",111,54],["ζωὴν",212,10],["βροτῶν",2019,77]],"to a land of perpetual darkness, where there is no light, neither [can any one] see the life of mortals."]]