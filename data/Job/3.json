[["1",[["Μετὰ",29,1],["τοῦτο",16,122],["ἤνοιξεν",820,3],["Ἰὼβ",811,105],["τὸ",1,32],["στόμα",123,33],["αὐτοῦ",3,48]],"After this Job opened his mouth, and cursed his day,"],["2",[["καὶ",2,8],["κατηράσατο",778,26],["τὴν",1,9],["ἡμέραν",28,10],["αὐτοῦ",3,48],["λέγων",31,67]],"saying,"],["3",[["Ἀπόλοιτο",213,397],["ἡ",1,11],["ἡμέρα",28,13],["ἐν",4,1],["ᾗ",24,102],["ἐγεννήθην",222,94],["καὶ",2,8],["ἡ",1,11],["νὺξ",216,13],["ἐκείνη",79,178],["ᾗ",24,102],["εἶπαν",18,221],["Ἰδοὺ",51,17],["ἄρσεν",915,20]],"Let the day perish in which I was born, and that night in which they said, Behold a man-child!"],["4",[["Ἡ",1,11],["νὺξ",216,13],["ἐκείνη",79,178],["εἴη",10,273],["σκότος",503,5],["καὶ",2,8],["μὴ",25,8],["ἀναζητήσαι",5208,276],["αὐτὴν",3,98],["ὁ",1,4],["Κύριος",7,5],["ἄνωθεν",1605,17],["μηδὲ",412,12],["ἔλθοι",56,276],["εἰς",8,1],["αὐτὴν",3,98],["φέγγος",1644,33]],"Let that night be darkness, and let not the Lord regard it from above, neither let light come upon it."],["5",[["Ἐκλάβοι",5321,276],["δὲ",14,12],["αὐτὴν",3,98],["σκότος",503,5],["καὶ",2,8],["σκιὰ",978,13],["θανάτου",169,21],["ἐπέλθοι",540,276],["ἐπʼ",9,1],["αὐτὴν",3,98],["γνόφος",1505,5]],"But let darkness and the shadow of death seize it; let blackness come upon it;"],["6",[["καταραθείη",778,706],["ἡ",1,11],["ἡμέρα",28,13],["καὶ",2,8],["ἡ",1,11],["νὺξ",216,13],["ἐκείνη",79,178],["ἀπενέγκοιτο",6436,686],["αὐτὴν",3,98],["σκότος",503,5],["μὴ",25,8],["εἴη",10,273],["εἰς",8,1],["ἡμέρας",28,19],["ἐνιαυτοῦ",397,21],["μηδὲ",412,12],["ἀριθμηθείη",1430,555],["εἰς",8,1],["ἡμέρας",28,19],["μηνῶν",381,77]],"let that day and night be cursed, let darkness carry them away; let it not come into the days of the year, neither let it be numbered with the days of the months."],["7",[["Ἀλλὰ",107,17],["ἡ",1,11],["νὺξ",216,13],["ἐκείνη",79,178],["εἴη",10,273],["ὀδύνη",771,13],["καὶ",2,8],["μὴ",25,8],["ἔλθοι",56,276],["ἐπʼ",9,1],["αὐτὴν",3,98],["εὐφροσύνη",360,13],["μηδὲ",412,12],["χαρμονή",4006,13]],"But let that night be pain, and let not mirth come upon it, nor joy."],["8",[["Ἀλλὰ",107,17],["καταράσαιτο",778,397],["αὐτὴν",3,98],["ὁ",1,4],["καταρώμενος",778,114],["τὴν",1,9],["ἡμέραν",28,10],["ἐκείνην",79,98],["ὁ",1,4],["μέλλων",1143,67],["τὸ",1,32],["μέγα",65,29],["κῆτος",2600,33],["χειρώσασθαι",3390,103]],"But let him that curses that day curse it, [even] he that is ready to attack the great whale."],["9",[["Σκοτωθείη",3354,555],["τὰ",1,42],["ἄστρα",1334,43],["τῆς",1,18],["νυκτὸς",216,19],["ἐκείνης",79,83],["ὑπομείναι",635,276],["καὶ",2,8],["εἰς",8,1],["φωτισμὸν",3676,7],["μὴ",25,8],["ἔλθοι",56,276],["καὶ",2,8],["μὴ",25,8],["ἴδοι",276,276],["Ἑωσφόρον",3458,7],["ἀνατέλλοντα",902,177]],"Let the stars of that night be darkened; let it remain [dark], and not come into light; and let it not see the morning star arise:"],["10",[["Ὅτι",19,8],["οὐ",12,17],["συνέκλεισε",1147,3],["πύλας",162,40],["γαστρὸς",775,19],["μητρός",188,19],["μου",6,83],["ἀπήλλαξε",4543,3],["γὰρ",40,12],["ἂν",82,12],["πόνον",564,7],["ἀπὸ",17,1],["ὀφθαλμῶν",91,77],["μου",6,48]],"because it shut not up the gates of my mother's womb, for [so] it would have removed sorrow from my eyes."],["11",[["Διατί",962,105],["γὰρ",40,12],["ἐν",4,1],["κοιλίᾳ",545,2],["οὐκ",12,17],["ἐτελεύτησα",593,147],["ἐκ",21,1],["γαστρὸς",775,19],["δὲ",14,12],["ἐξῆλθον",84,141],["καὶ",2,8],["οὐκ",12,17],["εὐθὺς",1675,17],["ἀπωλόμην",213,152]],"For why died I not in the belly? and [why] did I not come forth from the womb and die immediately?"],["12",[["Ἱνατί",101,238],["δὲ",14,12],["συνήντησάν",426,129],["μοι",6,49],["τὰ",1,42],["γόνατα",1300,43],["ἱνατί",101,238],["δὲ",14,12],["μαστοὺς",1273,31],["ἐθήλασα",1468,147]],"And why did the knees support me? and why did I suck the breasts?"],["13",[["νῦν",89,17],["ἂν",82,12],["κοιμηθεὶς",302,206],["ἡσύχασα",1091,147],["ὑπνώσας",1665,155],["δὲ",14,12],["ἀνεπαυσάμην",670,152]],"Now I should have lain down and been quiet, I should have slept and been at rest,"],["14",[["Νῦν",89,17],["ἂν",82,12],["κοιμηθεὶς",302,206],["ἡσύχασα",1091,147],["ὑπνώσας",1665,155],["δὲ",14,12],["ἀνεπαυσάμην",670,152],["μετὰ",29,1],["βασιλέων",22,77],["βουλευτῶν",5528,77],["γῆς",26,19],["οἳ",1,128],["ἐγαυριῶντο",4742,131],["ἐπὶ",9,1],["ξίφεσιν",2108,92]],"with kings [and] councillors of the earth, who gloried in [their] swords;"],["15",[["ἢ",60,8],["μετὰ",29,1],["ἀρχόντων",96,77],["ὧν",24,307],["πολὺς",74,16],["ὁ",1,4],["χρυσός",1603,5],["οἳ",1,128],["ἔπλησαν",911,141],["τοὺς",1,56],["οἴκους",34,31],["αὐτῶν",3,41],["ἀργυρίου",150,24]],"or with rulers, whose gold was abundant, who filled their houses with silver:"],["16",[["Ἢ",60,8],["ὥσπερ",221,17],["ἔκτρωμα",5390,20],["ἐκπορευόμενον",373,201],["ἐκ",21,1],["μήτρας",1346,19],["μητρὸς",188,19],["ἢ",60,8],["ὥσπερ",221,17],["νήπιοι",1015,130],["οἳ",1,128],["οὐκ",12,17],["εἶδον",73,147],["φῶς",376,20]],"or [I should have been] as an untimely birth proceeding from his mother's womb, or as infants who never saw light."],["17",[["Ἐκεῖ",76,17],["ἀσεβεῖς",246,130],["ἐξέκαυσαν",942,141],["θυμὸν",177,7],["ὀργῆς",198,19],["ἐκεῖ",76,17],["ἀνεπαύσαντο",670,182],["κατάκοποι",4871,179],["τῷ",1,52],["σώματι",451,53]],"There the ungodly have burnt out the fury of rage; there the wearied in body rest."],["18",[["Ὁμοθυμαδὸν",1262,17],["δὲ",14,12],["οἱ",1,128],["αἰώνιοι",388,130],["οὐκ",12,17],["ἤκουσαν",53,141],["φωνὴν",95,10],["φορολόγου",3383,21]],"And the men of old time have together ceased to hear the exactor's voice."],["19",[["Μικρὸς",365,16],["καὶ",2,8],["μέγας",65,16],["ἐκεῖ",76,17],["ἐστι",10,87],["καὶ",2,8],["θεράπων",801,5],["δεδοικὼς",3057,265],["τὸν",1,6],["κύριον",7,7],["αὐτοῦ",3,48]],"The small and great are there, and the servant that feared his lord."],["20",[["Ἱνατί",101,238],["γὰρ",40,12],["δέδοται",33,372],["τοῖς",1,138],["ἐν",4,1],["πικρίᾳ",1556,179],["φῶς",376,20],["ζωὴ",212,13],["δὲ",14,12],["ταῖς",1,70],["ἐν",4,1],["ὀδύναις",771,71],["ψυχαῖς",62,71]],"For why is light given to those who are in bitterness, and life to the souls which are in griefs?"],["21",[["οἳ",1,128],["ἱμείρονται",9844,303],["τοῦ",1,30],["θανάτου",169,21],["καὶ",2,8],["οὐ",12,17],["τυγχάνουσιν",1451,189],["ἀνορύσσοντες",6309,137],["ὥσπερ",221,17],["θησαυροὺς",577,31]],"who desire death, and obtain it not, digging [for it] as [for] treasures;"],["22",[["περιχαρεῖς",5008,130],["δὲ",14,12],["ἐγένοντο",30,182],["ἐὰν",45,8],["κατατύχωσι",7445,224]],"and would be very joyful if they should gain it?"],["23",[["Θάνατος",169,5],["ἀνδρὶ",38,113],["ἀνάπαυμα",5235,20],["συνέκλεισεν",1147,3],["γὰρ",40,12],["ὁ",1,4],["Θεὸς",20,5],["κατʼ",32,1],["αὐτοῦ",3,48]],"Death [is] rest to [such] a man, for God has hedged him in."],["24",[["Πρὸ",235,1],["γὰρ",40,12],["τῶν",1,76],["σίτων",660,77],["μου",6,48],["στεναγμὸς",1599,5],["ἥκει",260,87],["δακρύω",1268,134],["δὲ",14,12],["ἐγὼ",6,158],["συνεχόμενος",1423,114],["φόβῳ",330,113]],"For my groaning comes before my food, and I weep being beset with terror."],["25",[["Φόβος",330,5],["γὰρ",40,12],["ὃν",24,106],["ἐφρόντισα",2214,147],["ἦλθέ",56,3],["μοι",6,49],["καὶ",2,8],["ὃν",24,106],["ἐδεδοίκειν",3057,149],["συνήντησέν",426,3],["μοι",6,49]],"For the terror of which I meditated has come upon me, and that which I had feared has befallen me."],["26",[["Οὔτε",476,17],["εἰρήνευσα",1959,147],["οὔτε",476,17],["ἡσύχασα",1091,147],["οὔτε",476,17],["ἀνεπαυσάμην",670,152],["ἦλθε",56,3],["δέ",14,12],["μοι",6,49],["ὀργή",198,13]],"I was not at peace, nor quiet, nor had I rest; yet wrath came upon me."]]