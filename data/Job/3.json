[["1",[["Μετὰ",29,1],["τοῦτο",16,122],["ἤνοιξεν",362,3],["Ἰὼβ",813,105],["τὸ",1,32],["στόμα",123,33],["αὐτοῦ",3,48]],"After this Job opened his mouth,",{"s":"r"}],["2",[["καὶ",2,8],["κατηράσατο",779,26],["τὴν",1,9],["ἡμέραν",28,10],["αὐτοῦ",3,48],["λέγων",31,67]],"and cursed his day, saying,",{"s":"r"}],["3",[["Ἀπόλοιτο",217,392],["ἡ",1,11],["ἡμέρα",28,13],["ἐν",4,1],["ᾗ",24,102],["ἐγεννήθην",222,94],["καὶ",2,8],["ἡ",1,11],["νὺξ",219,13],["ἐκείνη",80,179],["ᾗ",24,102],["εἶπαν",18,141],["Ἰδοὺ",51,17],["ἄρσεν",914,33]],"Let the day perish in which I was born, and that night in which they said, Behold a man-child!"],["4",[["Ἡ",1,11],["νὺξ",219,13],["ἐκείνη",80,179],["εἴη",10,273],["σκότος",506,5],["καὶ",2,8],["μὴ",25,8],["ἀναζητήσαι",5179,216],["αὐτὴν",3,98],["ὁ",1,4],["Κύριος",7,5],["ἄνωθεν",1605,17],["μηδὲ",414,12],["ἔλθοι",55,216],["εἰς",8,1],["αὐτὴν",3,98],["φέγγος",1644,33]],"Let that night be darkness, and let not the Lord regard it from above, neither let light come upon it."],["5",[["Ἐκλάβοι",5289,216],["δὲ",14,12],["αὐτὴν",3,98],["σκότος",506,5],["καὶ",2,8],["σκιὰ",978,13],["θανάτου",170,21],["ἐπέλθοι",542,216],["ἐπʼ",9,1],["αὐτὴν",3,98],["γνόφος",1504,5]],"But let darkness and the shadow of death seize it; let blackness come upon it;"],["6",[["καταραθείη",779,683],["ἡ",1,11],["ἡμέρα",28,13],["καὶ",2,8],["ἡ",1,11],["νὺξ",219,13],["ἐκείνη",80,179],["ἀπενέγκοιτο",9257,664],["αὐτὴν",3,98],["σκότος",506,5],["μὴ",25,8],["εἴη",10,273],["εἰς",8,1],["ἡμέρας",28,19],["ἐνιαυτοῦ",400,21],["μηδὲ",414,12],["ἀριθμηθείη",1429,544],["εἰς",8,1],["ἡμέρας",28,19],["μηνῶν",386,77]],"let that day and night be cursed, let darkness carry them away; let it not come into the days of the year, neither let it be numbered with the days of the months."],["7",[["Ἀλλὰ",108,17],["ἡ",1,11],["νὺξ",219,13],["ἐκείνη",80,179],["εἴη",10,273],["ὀδύνη",774,13],["καὶ",2,8],["μὴ",25,8],["ἔλθοι",55,216],["ἐπʼ",9,1],["αὐτὴν",3,98],["εὐφροσύνη",360,13],["μηδὲ",414,12],["χαρμονή",3997,13]],"But let that night be pain, and let not mirth come upon it, nor joy."],["8",[["Ἀλλὰ",108,17],["καταράσαιτο",779,392],["αὐτὴν",3,98],["ὁ",1,4],["καταρώμενος",779,114],["τὴν",1,9],["ἡμέραν",28,10],["ἐκείνην",80,98],["ὁ",1,4],["μέλλων",1143,67],["τὸ",1,32],["μέγα",66,29],["κῆτος",2596,33],["χειρώσασθαι",3384,103]],"But let him that curses that day curse it, [even] he that is ready to attack the great whale."],["9",[["Σκοτωθείη",3351,544],["τὰ",1,42],["ἄστρα",1338,43],["τῆς",1,18],["νυκτὸς",219,19],["ἐκείνης",80,83],["ὑπομείναι",639,216],["καὶ",2,8],["εἰς",8,1],["φωτισμὸν",3670,7],["μὴ",25,8],["ἔλθοι",55,216],["καὶ",2,8],["μὴ",25,8],["ἴδοι",53,216],["Ἑωσφόρον",3455,7],["ἀνατέλλοντα",900,178]],"Let the stars of that night be darkened; let it remain [dark], and not come into light; and let it not see the morning star arise:"],["10",[["Ὅτι",19,8],["οὐ",12,17],["συνέκλεισε",1147,3],["πύλας",162,40],["γαστρὸς",777,19],["μητρός",189,19],["μου",6,83],["ἀπήλλαξε",4519,3],["γὰρ",40,12],["ἂν",83,12],["πόνον",566,7],["ἀπὸ",17,1],["ὀφθαλμῶν",91,77],["μου",6,48]],"because it shut not up the gates of my mother's womb, for [so] it would have removed sorrow from my eyes."],["11",[["Διατί",960,105],["γὰρ",40,12],["ἐν",4,1],["κοιλίᾳ",547,2],["οὐκ",12,17],["ἐτελεύτησα",581,147],["ἐκ",21,1],["γαστρὸς",777,19],["δὲ",14,12],["ἐξῆλθον",82,141],["καὶ",2,8],["οὐκ",12,17],["εὐθὺς",1673,17],["ἀπωλόμην",217,152]],"For why died I not in the belly? and [why] did I not come forth from the womb and die immediately?"],["12",[["Ἱνατί",102,238],["δὲ",14,12],["συνήντησάν",429,129],["μοι",6,49],["τὰ",1,42],["γόνατα",1300,43],["ἱνατί",102,238],["δὲ",14,12],["μαστοὺς",1275,31],["ἐθήλασα",1468,147]],"And why did the knees support me? and why did I suck the breasts?"],["13",[["νῦν",90,17],["ἂν",83,12],["κοιμηθεὶς",301,206],["ἡσύχασα",1090,147],["ὑπνώσας",1664,155],["δὲ",14,12],["ἀνεπαυσάμην",674,152]],"Now I should have lain down and been quiet, I should have slept and been at rest,"],["14",[["Νῦν",90,17],["ἂν",83,12],["κοι