[["1",[["Ὑπολαβὼν",1009,155],["δὲ",14,12],["Ἰὼβ",811,105],["λέγει",31,87]],"But Job answered and said,"],["2",[["Εἰ",77,8],["γάρ",40,12],["τις",39,150],["ἱστῶν",2554,77],["στήσαι",78,276],["μου",6,48],["τὴν",1,9],["ὀργὴν",198,10],["τὰς",1,39],["δὲ",14,12],["ὀδύνας",771,40],["μου",6,48],["ἄραι",248,276],["ἐν",4,1],["ζυγῷ",776,113],["ὁμοθυμαδὸν",1262,17]],"Oh that one would indeed weigh the wrath that is upon me, and take up my griefs in a balance together!"],["3",[["καὶ",2,8],["δὴ",193,12],["ἄμμου",434,19],["παραλίας",1972,19],["βαρυτέρα",1028,15],["ἔσται",10,89],["ἀλλʼ",107,17],["ὡς",36,8],["ἔοικε",5398,165],["τὰ",1,42],["ῥήματά",115,43],["μου",6,48],["ἐστὶ",10,87],["φαῦλα",2984,65]],"And verily they would be heavier than the sand by the seashore: but, as it seems, my words are vain."],["4",[["Βέλη",1159,43],["γὰρ",40,12],["Κυρίου",7,21],["ἐν",4,1],["τῷ",1,52],["σώματί",451,53],["μου",6,48],["ἐστὶν",10,87],["ὧν",24,97],["ὁ",1,4],["θυμὸς",177,5],["αὐτῶν",3,41],["ἐκπίνει",4597,87],["μου",6,48],["τὸ",1,32],["αἷμα",148,33],["ὅταν",318,8],["ἄρξωμαι",319,255],["λαλεῖν",50,54],["κεντοῦσί",7508,189],["με",6,82]],"For the arrows of the Lord are in my body, whose violence drinks up my blood: whenever I am going to speak, they pierce me."],["5",[["Τί",39,119],["γάρ",40,12],["μὴ",25,8],["διακενῆς",2711,17],["κεκράξεται",590,89],["ὄνος",497,5],["ἄγριος",1454,16],["ἀλλʼ",107,17],["ἢ",60,8],["τὰ",1,42],["σῖτα",660,43],["ζητῶν",190,67],["εἰ",77,8],["δὲ",14,12],["καὶ",2,8],["ῥήξει",1155,120],["φωνὴν",95,10],["βοῦς",408,5],["ἐπὶ",9,1],["φάτνης",3386,19],["ἔχων",124,67],["τὰ",1,42],["βρώματα",714,43]],"What then? will the wild ass bray for nothing, if he is not seeking food? or again, will the ox low at the manger, when he has fodder?"],["6",[["Εἰ",77,8],["βρωθήσεται",1112,125],["ἄρτος",197,5],["ἄνευ",1103,1],["ἁλός",2143,21],["εἰ",77,8],["δὲ",14,12],["καὶ",2,8],["ἔστι",10,87],["γεῦμα",4193,20],["ἐν",4,1],["ῥήμασι",115,92],["κενοῖς",779,90]],"Shall bread be eaten without salt? or again, is there taste in empty words?"],["7",[["Οὐ",12,17],["δύναται",184,108],["γὰρ",40,12],["παύσασθαί",707,103],["μου",6,48],["ἡ",1,11],["ὀργή",198,13],["βρόμον",4186,7],["γὰρ",40,12],["ὁρῶ",111,149],["τὰ",1,42],["σῖτά",660,43],["μου",6,48],["ὥσπερ",221,17],["ὀσμὴν",682,10],["λέοντος",421,21]],"For my wrath cannot cease; for I perceive my food as the smell of a lion [to be] loathsome."],["8",[["Εἰ",77,8],["γὰρ",40,12],["δώῃ",33,160],["καὶ",2,8],["ἔλθοι",56,276],["μου",6,48],["ἡ",1,11],["αἴτησις",4717,13],["καὶ",2,8],["τὴν",1,9],["ἐλπίδα",527,10],["μου",6,48],["δώῃ",33,160],["ὁ",1,4],["Κύριος",7,5]],"For oh that he would grant [my desire], and my petition might come, and the Lord would grant my hope!"],["9",[["Ἀρξάμενος",319,245],["ὁ",1,4],["Κύριος",7,5],["τρωσάτω",1919,46],["με",6,82],["εἰς",8,1],["τέλος",369,33],["δὲ",14,12],["μή",25,8],["με",6,82],["ἀνελέτω",645,46]],"Let the Lord begin and wound me, but let him not utterly destroy me."],["10",[["Εἴη",10,273],["δέ",14,12],["μου",6,48],["πόλις",41,13],["τάφος",865,5],["ἐφʼ",9,1],["ἧς",24,162],["ἐπὶ",9,1],["τειχέων",323,45],["ἡλλόμην",2835,435],["ἐπʼ",9,1],["αὐτῆς",3,83],["οὐ",12,17],["φείσομαι",607,176],["οὐ",12,17],["γὰρ",40,12],["ἐψευσάμην",1311,152],["ῥήματα",115,43],["ἅγια",75,65],["Θεοῦ",20,21],["μου",6,48]],"Let the grave be my city, upon the walls of which I have leaped: I will not shrink from it; for I have not denied the holy words of my God."],["11",[["Τίς",39,150],["γάρ",40,12],["μου",6,48],["ἡ",1,11],["ἰσχύς",180,13],["ὅτι",19,8],["ὑπομένω",635,149],["τίς",39,150],["μου",6,48],["ὁ",1,4],["χρόνος",484,5],["ὅτι",19,8],["ἀνέχεταί",2223,108],["μου",6,48],["ἡ",1,11],["ψυχή",62,13]],"For what is my strength, that I continue? what is my time, that my soul endures?"],["12",[["Μὴ",25,8],["ἰσχὺς",180,13],["λίθων",195,77],["ἡ",1,11],["ἰσχύς",180,13],["μου",6,48],["ἢ",60,8],["αἱ",1,183],["σάρκες",287,179],["μου",6,48],["εἰσὶ",10,189],["χάλκεαι",612,185]],"Is my strength the strength of stones? or is my flesh of brass?"],["13",[["Ἢ",60,8],["οὐκ",12,17],["ἐπʼ",9,1],["αὐτῷ",3,49],["ἐπεποίθειν",343,149],["βοήθεια",761,13],["δὲ",14,12],["ἀπʼ",17,1],["ἐμοῦ",6,48],["ἄπεστιν",2830,87]],"Or have I not trusted in him? but help is [far] from me."],["14",[["Ἀπείπατό",4040,26],["με",6,82],["ἔλεος",182,33],["ἐπισκοπὴ",1108,13],["δὲ",14,12],["Κυρίου",7,21],["ὑπερεῖδέ",1498,3],["με",6,82]],"Mercy has rejected me; and the visitation of the Lord has disregarded me."],["15",[["Οὐ",12,17],["προσεῖδόν",6018,141],["με",6,82],["οἱ",1,128],["ἐγγύτατοί",6435,130],["μου",6,48],["ὥσπερ",221,17],["χειμάῤῥους",736,31],["ἐκλείπων",321,67],["ἢ",60,8],["ὥσπερ",221,17],["κῦμα",1629,20],["παρῆλθόν",410,141],["με",6,82]],"My nearest relations have not regarded me; they have passed me by like a failing brook, or like a wave."],["16",[["Οἵτινές",454,461],["με",6,82],["διευλαβοῦντο",4779,131],["νῦν",89,17],["ἐπιπεπτώκασί",995,406],["μοι",6,49],["ὥσπερ",221,17],["χιὼν",1646,13],["ἢ",60,8],["κρύσταλλος",2921,5],["πεπηγώς",1480,265]],"They who used to reverence me, now have come against me like snow or congealed ice."],["17",[["Καθὼς",218,17],["τακεῖσα",1019,306],["θέρμης",7327,19],["γενομένης",30,617],["οὐκ",12,17],["ἐπεγνώσθη",433,38],["ὅπερ",6677,699],["ἦν",10,14]],"When it has melted at the approach of heat, it is not known what it was."],["18",[["οὕτω",70,17],["κᾀγὼ",611,105],["κατελείφηθν",0,0],["ὑπὸ",122,1],["πάντων",11,163],["ἀπωλόμην",213,152],["δὲ",14,12],["καὶ",2,8],["ἔξοικος",9752,16],["ἐγενόμην",30,152]],"Thus I also have been deserted of all; and I am ruined, and become an outcast."],["19",[["Ἴδετε",73,69],["ὁδοὺς",67,40],["Θαιμανῶν",0,0],["ἀτραποὺς",4060,40],["Σαβῶν",1978,171],["οἱ",1,128],["διορῶντες",7097,137]],"Behold the ways of the Thæmanites, ye that mark the paths of the Sabæans."],["20",[["Καὶ",2,8],["αἰσχύνην",683,10],["ὀφειλήσουσιν",2156,207],["οἱ",1,128],["ἐπὶ",9,1],["πόλεσι",41,71],["καὶ",2,8],["χρήμασι",1192,92],["πεποιθότες",343,264]],"They too that trust in cities and riches shall come to shame."],["21",[["Ἀτὰρ",5277,12],["δὲ",14,12],["καὶ",2,8],["ὑμεῖς",5,208],["ἐπέβητέ",881,262],["μοι",6,49],["ἀνελεημόνως",2411,17],["ὥστε",345,17],["ἰδόντες",73,188],["τὸ",1,32],["ἐμὸν",523,33],["τραῦμα",2132,33],["φοβήθητε",134,358]],"But ye also have come to me without pity; so that beholding my wound ye are afraid."],["22",[["Τί",39,119],["γάρ",40,12],["μήτι",25,12],["ὑμᾶς",5,209],["ἢτησα",0,0],["ἢ",60,8],["τῆς",1,18],["παρʼ",72,1],["ὑμῶν",5,136],["ἰσχύος",180,19],["ἐπιδέομαι",2540,252]],"What? have I made any demand of you? or do I ask for strength from you,"],["23",[["ὥστε",345,17],["σῶσαί",171,100],["με",6,82],["ἑξ",528,57],["ἐχθρῶν",135,77],["ἢ",60,8],["ἐκ",21,1],["χειρὸς",37,19],["δυναστῶν",800,77],["ῥύσασθαί",335,103],["με",6,82]],"to deliver me from enemies, or to rescue me from the hand of the mighty ones?"],["24",[["Διδάξατέ",543,69],["με",6,82],["ἐγὼ",6,158],["δὲ",14,12],["κωφεύσω",2598,157],["εἴ",77,8],["τι",39,119],["πεπλάνημαι",0,0],["φράσατέ",4001,69],["μοι",6,49]],"Teach ye me, and I will be silent: if in anything I have erred, tell me."],["25",[["Ἀλλʼ",107,17],["ὡς",36,8],["ἔοικε",5398,165],["φαῦλα",2984,65],["ἀληθινοῦ",1020,153],["ῥήματα",115,43],["οὐ",12,17],["γὰρ",40,12],["παρʼ",72,1],["ὑμῶν",5,136],["ἰσχὺν",180,10],["αἰτοῦμαι",615,252]],"But as it seems, the words of a true man are vain, because I do not ask strength of you."],["26",[["Οὐδὲ",105,12],["ἔλεγχος",1660,5],["ὑμῶν",5,136],["ῥήμασί",115,92],["με",6,82],["παύσει",707,120],["οὐδὲ",105,12],["γὰρ",40,12],["ὑμῶν",5,136],["φθέγμα",6203,20],["ῥήματος",115,24],["ἀνέξομαι",2223,176]],"Neither will your reproof cause me to cease my words, for neither will I endure the sound of your speech."],["27",[["Πλὴν",257,1],["ὅτι",19,8],["ἐπʼ",9,1],["ὀρφανῷ",959,111],["ἐπιπίπτετε",995,84],["ἐνάλλεσθε",3746,387],["δὲ",14,12],["ἐπὶ",9,1],["φίλῳ",334,111],["ὑμῶν",5,136]],"Even because ye attack the fatherless, and insult your friend."],["28",[["Νυνὶ",2106,17],["δὲ",14,12],["εἰσβλέψας",4796,155],["εἰς",8,1],["πρόσωπα",47,43],["ὑμῶν",5,136],["οὐ",12,17],["ψεύσομαι",1311,176]],"But now, having looked upon your countenances, I will not lie."],["29",[["Καθίσατε",273,69],["δὴ",193,12],["καὶ",2,8],["μὴ",25,8],["εἴη",10,273],["ἄδικον",402,28],["καὶ",2,8],["πάλιν",649,17],["τῷ",1,110],["δικαίῳ",152,111],["συνέρχεσθε",1917,68]],"Sit down now, and let there not be unrighteousness; and unite again with the just."],["30",[["Οὐ",12,17],["γάρ",40,12],["ἐστιν",10,87],["ἐν",4,1],["γλώσσῃ",385,2],["μουἄδικον",0,0],["ἢ",60,8],["ὁ",1,4],["λάρυγξ",2097,5],["μου",6,48],["οὐχὶ",326,12],["σύνεσιν",467,10],["μελετᾷ",1344,172]],"For there is no injustice in my tongue; and does not my throat meditate understanding?"]]