[["1",[["Ὑπολαβὼν",1009,155],["δὲ",14,12],["Ἰὼβ",813,105],["λέγει",31,87]],"But Job answered and said,"],["2",[["Εἰ",77,8],["γάρ",40,12],["τις",39,150],["ἱστῶν",2550,77],["στήσαι",78,216],["μου",6,48],["τὴν",1,9],["ὀργὴν",198,10],["τὰς",1,39],["δὲ",14,12],["ὀδύνας",774,40],["μου",6,48],["ἄραι",206,216],["ἐν",4,1],["ζυγῷ",920,113],["ὁμοθυμαδὸν",1262,17]],"Oh that one would indeed weigh the wrath that is upon me, and take up my griefs in a balance together!"],["3",[["καὶ",2,8],["δὴ",193,12],["ἄμμου",435,19],["παραλίας",1968,19],["βαρυτέρα",1031,15],["ἔσται",10,89],["ἀλλʼ",108,17],["ὡς",36,8],["ἔοικε",5369,165],["τὰ",1,42],["ῥήματά",116,43],["μου",6,48],["ἐστὶ",10,87],["φαῦλα",2972,65]],"And verily they would be heavier than the sand by the seashore: but, as it seems, my words are vain."],["4",[["Βέλη",1156,43],["γὰρ",40,12],["Κυρίου",7,21],["ἐν",4,1],["τῷ",1,52],["σώματί",454,53],["μου",6,48],["ἐστὶν",10,87],["ὧν",24,97],["ὁ",1,4],["θυμὸς",178,5],["αὐτῶν",3,41],["ἐκπίνει",4574,87],["μου",6,48],["τὸ",1,32],["αἷμα",148,33],["ὅταν",319,8],["ἄρξωμαι",320,255],["λαλεῖν",50,54],["κεντοῦσί",7459,191],["με",6,82]],"For the arrows of the Lord are in my body, whose violence drinks up my blood: whenever I am going to speak, they pierce me."],["5",[["Τί",39,119],["γάρ",40,12],["μὴ",25,8],["διακενῆς",2705,17],["κεκράξεται",592,89],["ὄνος",499,5],["ἄγριος",1454,16],["ἀλλʼ",108,17],["ἢ",61,8],["τὰ",1,42],["σῖτα",665,43],["ζητῶν",191,67],["εἰ",77,8],["δὲ",14,12],["καὶ",2,8],["ῥήξει",1178,120],["φωνὴν",95,10],["βοῦς",411,5],["ἐπὶ",9,1],["φάτνης",3381,19],["ἔχων",124,67],["τὰ",1,42],["βρώματα",714,43]],"What then? will the wild ass bray for nothing, if he is not seeking food? or again, will the ox low at the manger, when he has fodder?"],["6",[["Εἰ",77,8],["βρωθήσεται",1111,125],["ἄρτος",197,5],["ἄνευ",1101,1],["ἁλός",2136,21],["εἰ",77,8],["δὲ",14,12],["καὶ",2,8],["ἔστι",10,87],["γεῦμα",4181,20],["ἐν",4,1],["ῥήμασι",116,92],["κενοῖς",780,90]],"Shall bread be eaten without salt? or again, is there taste in empty words?"],["7",[["Οὐ",12,17],["δύναται",185,108],["γὰρ",40,12],["παύσασθαί",706,103],["μου",6,48],["ἡ",1,11],["ὀργή",198,13],["βρόμον",4174,7],["γὰρ",40,12],["ὁρῶ",112,149],["τὰ",1,42],["σῖτά",665,43],["μου",6,48],["ὥσπερ",226,17],["ὀσμὴν",684,10],["λέοντος",424,21]],"For my wrath cannot cease; for I perceive my food as the smell of a lion [to be] loathsome."],["8",[["Εἰ",77,8],["γὰρ",40,12],["δώῃ",33,160],["καὶ",2,8],["ἔλθοι",55,216],["μου",6,48],["ἡ",1,11],["αἴτησις",4692,13],["καὶ",2,8],["τὴν",1,9],["ἐλπίδα",530,10],["μου",6,48],["δώῃ",33,160],["ὁ",1,4],["Κύριος",7,5]],"For oh that he would grant [my desire], and my petition might come, and the Lord would grant my hope!"],["9",[["Ἀρξάμενος",320,244],["ὁ",1,4],["Κύριος",7,5],["τρωσάτω",1917,46],["με",6,82],["εἰς",8,1],["τέλος",373,33],["δὲ",14,12],["μή",25,8],["με",6,82],["ἀνελέτω",651,46]],"Let the Lord begin and wound me, but let him not utterly destroy me."],["10",[["Εἴη",10,273],["δέ",14,12],["μου",6,48],["πόλις",41,13],["τάφος",865,5],["ἐφʼ",9,1],["ἧς",24,162],["ἐπὶ",9,1],["τειχέων",325,45],["ἡλλόμην",2823,429],["ἐπʼ",9,1],["αὐτῆς",3,83],["οὐ",12,17],["φείσομαι",610,177],["οὐ",12,17],["γὰρ",40,12],["ἐψευσάμην",1099,152],["ῥήματα",116,43],["ἅγια",75,65],["Θεοῦ",20,21],["μου",6,48]],"Let the grave be my city, upon the walls of which I have leaped: I will not shrink from it; for I have not denied the holy words of my God."],["11",[["Τίς",39,150],["γάρ",40,12],["μου",6,48],["ἡ",1,11],["ἰσχύς",181,13],["ὅτι",19,8],["ὑπομένω",639,149],["τίς",39,150],["μου",6,48],["ὁ",1,4],["χρόνος",486,5],["ὅτι",19,8],["ἀνέχεταί",2211,108],["μου",6,48],["ἡ",1,11],["ψυχή",63,13]],"For what is my strength, that I continue? what is my time, that my soul endures?"],["12",[["Μὴ",25,8],["ἰσχὺς",181,13],["λίθων",195,77],["ἡ",1,11],["ἰσχύς",181,13],["μου",6,48],["ἢ",61,8],["αἱ",1,185],["σάρκες",287,180],["μου",6,48],["εἰσὶ",10,191],["χάλκεαι",614,187]],"Is my strength the strength of stones? or is my flesh of brass?"],["13",[["Ἢ",61,8],["οὐκ",12,17],["ἐπʼ",9,1],["αὐτῷ",3,49],["ἐπεποίθειν",344,149],["βοήθεια",765,13],["δὲ",14,12],["ἀπʼ",17,1],["ἐμοῦ",6,48],["ἄπεστιν",2818,87]],"Or have I not trusted in him? but help is [far] from me."],["14",[["Ἀπείπατό",4031,26],["με",6,82],["ἔλεος",183,33],["ἐπισκοπὴ",1106,13],["δὲ",14,12],["Κυρίου",7,21],["ὑπερεῖδέ",1496,3],["με",6,82]],"Mercy has rejected me; and the visitation of the Lord has disregarded me."],["15",[["Οὐ",12,17],["προσεῖδόν",5990,141],["με",6,82],["οἱ",1,128],["ἐγγύτατοί",6405,130],["μου",6,48],["ὥσπερ",226,17],["χειμάῤῥους",737,31],["ἐκλείπων",321,67],["ἢ",61,8],["ὥσπερ",226,17],["κῦμα",1630,20],["παρῆλθόν",404,141],["με",6,82]],"My nearest relations have not regarded me; they have passed me by like a failing brook, or like a wave."],["16",[["Οἵτινές",457,455],["με",6,82],["διευλαβοῦντο",4754,131],["νῦν",90,17],["ἐπιπεπτώκασί",995,400],["μοι",6,49],["ὥσπερ",226,17],["χιὼν",1646,13],["ἢ",61,8],["κρύσταλλος",2906,5],["πεπηγώς",1477,264]],"They who used to reverence me, now have come against me like snow or congealed ice."],["17",[["Καθὼς",221,17],["τακεῖσα",1021,302],["θέρμης",7275,19],["γενομένης",30,601],["οὐκ",12,17],["ἐπεγνώσθη",431,38],["ὅπερ",6635,677],["ἦν",10,14]],"When it has melted at the approach of heat, it is not known what it was."],["18",[["οὕτω",71,17],["κᾀγὼ",613,105],["κατελείφηθν",0,0],["ὑπὸ",122,1],["πάντων",11,163],["ἀπωλόμην",217,152],["δὲ",14,12],["καὶ",2,8],["ἔξοικος",9678,16],["ἐγενόμην",30,152]],"Thus I also have been deserted of all; and I am ruined, and become an outcast."],["19",[["Ἴδετε",53,69],["ὁδοὺς",68,40],["Θαιμανῶν",0,0],["ἀτραποὺς",4052,40],["Σαβῶν",8207,171],["οἱ",1,128],["διορῶντες",7051,137]],"Behold the ways of the Thæmanites, ye that mark the paths of the Sabæans."],["20",[["Καὶ",2,8],["αἰσχύνην",685,10],["ὀφειλήσουσιν",2150,207],["οἱ",1,128],["ἐπὶ",9,1],["πόλεσι",41,71],["καὶ",2,8],["χρήμασι",1190,92],["πεποιθότες",344,263]],"They too that trust in cities and riches shall come to shame."],["21",[["Ἀτὰρ",5246,12],["δὲ",14,12],["καὶ",2,8],["ὑμεῖς",5,208],["ἐπέβητέ",880,262],["μοι",6,49],["ἀνελεημόνως",2402,17],["ὥστε",346,17],["ἰδόντες",53,190],["τὸ",1,32],["ἐμὸν",525,33],["τραῦμα",2124,33],["φοβήθητε",134,353]],"But ye also have come to me without pity; so that beholding my wound ye are afraid."],["22",[["Τί",39,119],["γάρ",40,12],["μήτι",25,12],["ὑμᾶς",5,209],["ἢτησα",0,0],["ἢ",61,8],["τῆς",1,18],["παρʼ",73,1],["ὑμῶν",5,136],["ἰσχύος",181,19],["ἐπιδέομαι",2674,251]],"What? have I made any demand of you? or do I ask for strength from you,"],["23",[["ὥστε",346,17],["σῶσαί",172,100],["με",6,82],["ἑξ",531,57],["ἐχθρῶν",135,77],["ἢ",61,8],["ἐκ",21,1],["χειρὸς",37,19],["δυναστῶν",803,77],["ῥύσασθαί",337,103],["με",6,82]],"to deliver me from enemies, or to rescue me from the hand of the mighty ones?"],["24",[["Διδάξατέ",545,69],["με",6,82],["ἐγὼ",6,158],["δὲ",14,12],["κωφεύσω",2594,157],["εἴ",77,8],["τι",39,119],["πεπλάνημαι",464,324],["φράσατέ",3666,69],["μοι",6,49]],"Teach ye me, and I will be silent: if in anything I have erred, tell me."],["25",[["Ἀλλʼ",108,17],["ὡς",36,8],["ἔοικε",5369,165],["φαῦλα",2972,65],["ἀληθινοῦ",1023,153],["ῥήματα",116,43],["οὐ",12,17],["γὰρ",40,12],["παρʼ",73,1],["ὑμῶν",5,136],["ἰσχὺν",181,10],["αἰτοῦμαι",617,251]],"But as it seems, the words of a true man are vain, because I do not ask strength of you."],["26",[["Οὐδὲ",106,12],["ἔλεγχος",1659,5],["ὑμῶν",5,136],["ῥήμασί",116,92],["με",6,82],["παύσει",706,120],["οὐδὲ",106,12],["γὰρ",40,12],["ὑμῶν",5,136],["φθέγμα",6174,20],["ῥήματος",116,24],["ἀνέξομαι",2211,177]],"Neither will your reproof cause me to cease my words, for neither will I endure the sound of your speech."],["27",[["Πλὴν",257,1],["ὅτι",19,8],["ἐπʼ",9,1],["ὀρφανῷ",957,111],["ἐπιπίπτετε",995,84],["ἐνάλλεσθε",3736,383],["δὲ",14,12],["ἐπὶ",9,1],["φίλῳ",336,111],["ὑμῶν",5,136]],"Even because ye attack the fatherless, and insult your friend."],["28",[["Νυνὶ",2099,17],["δὲ",14,12],["εἰσβλέψας",4771,155],["εἰς",8,1],["πρόσωπα",47,43],["ὑμῶν",5,136],["οὐ",12,17],["ψεύσομαι",1099,177]],"But now, having looked upon your countenances, I will not lie."],["29",[["Καθίσατε",274,69],["δὴ",193,12],["καὶ",2,8],["μὴ",25,8],["εἴη",10,273],["ἄδικον",406,28],["καὶ",2,8],["πάλιν",655,17],["τῷ",1,110],["δικαίῳ",153,111],["συνέρχεσθε",1837,68]],"Sit down now, and let there not be unrighteousness; and unite again with the just."],["30",[["Οὐ",12,17],["γάρ",40,12],["ἐστιν",10,87],["ἐν",4,1],["γλώσσῃ",388,2],["μουἄδικον",0,0],["ἢ",61,8],["ὁ",1,4],["λάρυγξ",2092,5],["μου",6,48],["οὐχὶ",330,12],["σύνεσιν",469,10],["μελετᾷ",1347,173]],"For there is no injustice in my tongue; and does not my throat meditate understanding?"]]