[["1",[["Ἔτι",110,17],["δὲ",14,12],["προσθεὶς",200,155],["Ἰὼβ",811,105],["εἶπε",18,3],["τῷ",1,52],["προοιμίῳ",5034,53]],"And Job continued and said in his parable,"],["2",[["Τίς",39,150],["ἄν",82,12],["με",6,82],["θείη",109,276],["κατὰ",32,1],["μῆνα",295,7],["ἔμπροσθεν",387,17],["ἡμερῶν",28,61],["ὧν",24,190],["με",6,82],["ὁ",1,4],["Θεὸς",20,5],["ἐφύλαξεν",127,3]],"Oh that I were as in months past, wherein God preserved me!"],["3",[["Ὡς",36,8],["ὅτε",430,8],["ηὔγει",6869,14],["ὁ",1,4],["λύχνος",1059,5],["αὐτοῦ",3,48],["ὑπὲρ",139,1],["κεφαλῆς",144,19],["μου",6,83],["ὅτε",430,8],["τῷ",1,110],["φωτὶ",376,113],["αὐτοῦ",3,48],["ἐπορευόμην",49,380],["ἐν",4,1],["σκότει",503,53]],"As when his lamp shone over my head; when by his light I walked through darkness."],["4",[["Ὅτε",430,8],["ἤμην",10,435],["ἐπιβρίθων",9565,67],["ὁδοὺς",67,40],["ὅτε",430,8],["ὁ",1,4],["Θεὸς",20,5],["ἐπισκοπὴν",1108,10],["ἐποιεῖτο",23,22],["τοῦ",1,30],["οἴκου",34,21],["μου",6,48]],"[As] when I steadfastly pursued my ways, when God took care of my house."],["5",[["Ὅτε",430,8],["ἤμην",10,435],["ὑλώδης",9942,16],["λίαν",1899,17],["κύκλῳ",258,17],["δέ",14,12],["μου",6,48],["οἱ",1,128],["παῖδες",126,51]],"When I was very fruitful, and my children were about me;"],["6",[["Ὅτε",430,8],["ἐχέοντο",2810,131],["αἱ",1,183],["ὁδοί",67,179],["μου",6,48],["βουτύρῳ",2883,53],["τὰ",1,42],["δὲ",14,12],["ὄρη",86,43],["μου",6,48],["ἐχέοντο",2810,131],["γάλακτι",1031,53]],"when my ways were moistened with butter, and the mountains flowed for me with milk."],["7",[["Ὅτε",430,8],["ἐξεπορευόμην",373,380],["ὄρθριος",5444,16],["ἐν",4,1],["πόλει",41,2],["ἐν",4,1],["δὲ",14,12],["πλατείαις",925,71],["ἐτίθετό",109,22],["μου",6,48],["ὁ",1,4],["δίφρος",2717,5]],"When I went forth early in the city, and the seat was placed for me in the streets."],["8",[["Ἰδόντες",73,188],["με",6,82],["νεανίσκοι",568,51],["ἐκρύβησαν",378,94],["πρεσβῦται",1097,51],["δὲ",14,12],["πάντες",11,130],["ἔστησαν",78,141]],"The young men saw me, and hid themselves: and all the old men stood up."],["9",[["Ἁδροὶ",2827,130],["δὲ",14,12],["ἐπαύσαντο",707,182],["λαλοῦντες",50,137],["δάκτυλον",1182,7],["ἐπιθέντες",239,188],["ἐπὶ",9,1],["στόματι",123,53]],"And the great men ceased speaking, and laid their finger on their mouth."],["10",[["Οἱ",1,128],["δὲ",14,12],["ἀκούσαντες",53,188],["ἐμακάρισάν",1683,141],["με",6,82],["καὶ",2,8],["γλῶσσα",385,13],["αὐτῶν",3,41],["τῷ",1,110],["λάρυγγι",2097,113],["αὐτῶν",3,41],["ἐκολλήθη",1272,38]],"And they that heard [me] blessed me, and their tongue clave to their throat."],["11",[["Ὅτι",19,8],["οὖς",325,33],["ἤκουσε",53,3],["καὶ",2,8],["ἐμακάρισέ",1683,3],["με",6,82],["ὀφθαλμὸς",91,5],["δὲ",14,12],["ἰδών",73,155],["με",6,82],["ἐξέκλινε",393,3]],"For the ear heard, and blessed me; and the eye saw me, and turned aside."],["12",[["Διέσωσα",727,147],["γὰρ",40,12],["πτωχὸν",496,7],["ἐκ",21,1],["χειρὸς",37,19],["δυνάστου",800,21],["καὶ",2,8],["ὀρφανῷ",959,111],["ᾧ",24,202],["οὐκ",12,17],["ἦν",10,14],["βοηθὸς",948,5],["ἐβοήθησα",552,147]],"For I saved the poor out of the hand of the oppressor, and helped the fatherless who had no helper."],["13",[["Εὐλογία",576,13],["ἀπολλυμένου",213,425],["ἐπʼ",9,1],["ἐμὲ",6,82],["ἔλθοι",56,276],["στόμα",123,33],["δὲ",14,12],["χήρας",749,40],["με",6,82],["εὐλόγησε",147,3]],"Let the blessing of the perishing one come upon me; yea, the mouth of the widow has blessed me."],["14",[["Δικαιοσύνην",185,10],["δὲ",14,12],["ἐνδεδύκειν",515,149],["ἠμφιασάμην",4522,152],["δὲ",14,12],["κρίμα",266,33],["ἶσα",945,74],["διπλοΐδι",2897,2]],"Also I put on righteousness, and clothed myself with judgment like a mantle."],["15",[["Ὀφθαλμὸς",91,5],["ἤμην",10,435],["τυφλῶν",1601,163],["ποὺς",208,5],["δὲ",14,12],["χωλῶν",2407,115]],"I was the eye of the blind, and the foot of the lame."],["16",[["Ἐγὼ",6,158],["ἤμην",10,435],["πατὴρ",44,5],["ἀδυνάτων",1648,163],["δίκην",1224,10],["δὲ",14,12],["ἣν",24,124],["οὐκ",12,17],["ᾔδειν",73,324],["ἐξιχνίασα",2237,147]],"I was the father of the helpless; and I searched out the cause which I knew not."],["17",[["Συνέτριψα",267,147],["δὲ",14,12],["μύλας",4332,40],["ἀδίκων",402,163],["ἐκ",21,1],["μέσου",112,88],["τῶν",1,76],["ὀδόντων",929,77],["αὐτῶν",3,41],["ἅρπαγμα",2059,20],["ἐξήρπασα",6502,147]],"And I broke the jaw-teeth of the unrighteous; I plucked the spoil out of the midst of their teeth."],["18",[["Εἶπα",18,147],["δὲ",14,12],["ἡ",1,11],["ἡλικία",1752,13],["μου",6,48],["γηράσει",1412,120],["ὥσπερ",221,17],["στέλεχος",2635,20],["φοίνικος",1172,21],["πολὺν",74,59],["χρόνον",484,7],["βιώσω",3507,157]],"And I said, My age shall continue as the stem of a palm-tree; I shall live a long while."],["19",[["Ἡ",1,11],["ῥίζα",893,186],["διήνοικται",0,0],["ἐπὶ",9,1],["ὕδατος",85,24],["καὶ",2,8],["δρόσος",1135,13],["αὐλισθήσεται",991,125],["ἐν",4,1],["τῷ",1,110],["θερισμῷ",1303,113],["μου",6,48]],"[My] root was spread out by the water, and the dew would lodge on my crop."],["20",[["Ἡ",1,11],["δόξα",141,186],["μου",6,48],["κενὴ",779,15],["μετʼ",29,1],["ἐμοῦ",6,48],["καὶ",2,8],["τὸ",1,32],["τόξον",712,33],["μου",6,48],["ἐν",4,1],["χειρὶ",37,2],["αὐτοῦ",3,48],["πορεύεται",49,108]],"My glory was fresh in me, and my bow prospered in his hand."],["21",[["Ἐμοῦ",6,48],["ἀκούσαντες",53,188],["προσέσχον",557,141],["ἐσιώπησαν",1282,129],["δὲ",14,12],["ἐπὶ",9,1],["τῇ",1,95],["ἐμῇ",523,2],["βουλῇ",349,2]],"[Men] heard me, and gave heed, and they were silent at my counsel."],["22",[["Ἐπὶ",9,1],["τῷ",1,52],["ἐμῷ",523,53],["ῥήματι",115,53],["οὐ",12,17],["προσέθεντο",200,182],["περιχαρεῖς",5008,130],["δὲ",14,12],["ἐγίνοντο",30,131],["ὁπόταν",9916,17],["αὐτοῖς",3,142],["ἐλάλουν",50,129]],"At my word they spoke not again, and they were very glad whenever I spoke to them."],["23",[["Ὥσπερ",221,17],["γῆ",26,13],["διψῶσα",1163,181],["προσδεχομένη",1018,204],["τὸν",1,6],["ὑετὸν",672,7],["οὕτως",70,17],["οὗτοι",16,213],["τὴν",1,9],["ἐμὴν",523,10],["λαλιάν",1826,10]],"As the thirsty earth expecting the rain, so they [waited for] my speech."],["24",[["Ἐὰν",45,8],["γελάσω",2077,157],["πρὸς",15,1],["αὐτοὺς",3,60],["οὐ",12,17],["μὴ",25,8],["πιστεύσωσι",658,224],["καὶ",2,8],["φῶς",376,20],["τοῦ",1,23],["προσώπου",47,24],["μου",6,48],["οὐκ",12,17],["ἀπέπιπτεν",3179,14]],"Were I to laugh on them, they would not believe [it]; and the light of my face has not failed."],["25",[["Ἐξελεξάμην",418,152],["ὁδὸν",67,10],["αὐτῶν",3,41],["καὶ",2,8],["ἐκάθισα",273,147],["ἄρχων",96,5],["καὶ",2,8],["κατεσκήνουν",802,129],["ὡσεὶ",342,17],["βασιλεὺς",22,5],["ἐν",4,1],["μονοζώνοις",2751,139],["ὃν",24,106],["τρόπον",243,7],["παθεινοὺς",7878,31],["παρακαλῶν",432,67]],"I chose out their way, and sat chief, and dwelt as a king in the midst of warriors, as one comforting mourners."]]