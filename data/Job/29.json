[["1",[["Ἔτι",111,17],["δὲ",14,12],["προσθεὶς",201,155],["Ἰὼβ",813,105],["εἶπε",18,3],["τῷ",1,52],["προοιμίῳ",5005,53]],"And Job continued and said in his parable,"],["2",[["Τίς",39,150],["ἄν",83,12],["με",6,82],["θείη",110,216],["κατὰ",32,1],["μῆνα",296,7],["ἔμπροσθεν",390,17],["ἡμερῶν",28,61],["ὧν",24,192],["με",6,82],["ὁ",1,4],["Θεὸς",20,5],["ἐφύλαξεν",125,3]],"Oh that I were as in months past, wherein God preserved me!"],["3",[["Ὡς",36,8],["ὅτε",432,8],["ηὔγει",6823,14],["ὁ",1,4],["λύχνος",1059,5],["αὐτοῦ",3,48],["ὑπὲρ",139,1],["κεφαλῆς",144,19],["μου",6,83],["ὅτε",432,8],["τῷ",1,110],["φωτὶ",380,113],["αὐτοῦ",3,48],["ἐπορευόμην",49,374],["ἐν",4,1],["σκότει",506,53]],"As when his lamp shone over my head; when by his light I walked through darkness."],["4",[["Ὅτε",432,8],["ἤμην",10,429],["ἐπιβρίθων",9497,67],["ὁδοὺς",68,40],["ὅτε",432,8],["ὁ",1,4],["Θεὸς",20,5],["ἐπισκοπὴν",1106,10],["ἐποιεῖτο",23,22],["τοῦ",1,30],["οἴκου",34,21],["μου",6,48]],"[As] when I steadfastly pursued my ways, when God took care of my house."],["5",[["Ὅτε",432,8],["ἤμην",10,429],["ὑλώδης",9862,16],["λίαν",1898,17],["κύκλῳ",258,17],["δέ",14,12],["μου",6,48],["οἱ",1,128],["παῖδες",127,51]],"When I was very fruitful, and my children were about me;"],["6",[["Ὅτε",432,8],["ἐχέοντο",2800,131],["αἱ",1,185],["ὁδοί",68,180],["μου",6,48],["βουτύρῳ",2868,53],["τὰ",1,42],["δὲ",14,12],["ὄρη",87,43],["μου",6,48],["ἐχέοντο",2800,131],["γάλακτι",1034,53]],"when my ways were moistened with butter, and the mountains flowed for me with milk."],["7",[["Ὅτε",432,8],["ἐξεπορευόμην",365,374],["ὄρθριος",5414,16],["ἐν",4,1],["πόλει",41,2],["ἐν",4,1],["δὲ",14,12],["πλατείαις",925,71],["ἐτίθετό",110,22],["μου",6,48],["ὁ",1,4],["δίφρος",2711,5]],"When I went forth early in the city, and the seat was placed for me in the streets."],["8",[["Ἰδόντες",53,190],["με",6,82],["νεανίσκοι",570,51],["ἐκρύβησαν",372,94],["πρεσβῦται",1095,51],["δὲ",14,12],["πάντες",11,130],["ἔστησαν",78,141]],"The young men saw me, and hid themselves: and all the old men stood up."],["9",[["Ἁδροὶ",2815,130],["δὲ",14,12],["ἐπαύσαντο",706,184],["λαλοῦντες",50,137],["δάκτυλον",1182,7],["ἐπιθέντες",239,190],["ἐπὶ",9,1],["στόματι",123,53]],"And the great men ceased speaking, and laid their finger on their mouth."],["10",[["Οἱ",1,128],["δὲ",14,12],["ἀκούσαντες",54,190],["ἐμακάρισάν",1681,141],["με",6,82],["καὶ",2,8],["γλῶσσα",388,13],["αὐτῶν",3,41],["τῷ",1,110],["λάρυγγι",2092,113],["αὐτῶν",3,41],["ἐκολλήθη",1246,38]],"And they that heard [me] blessed me, and their tongue clave to their throat."],["11",[["Ὅτι",19,8],["οὖς",328,33],["ἤκουσε",54,3],["καὶ",2,8],["ἐμακάρισέ",1681,3],["με",6,82],["ὀφθαλμὸς",91,5],["δὲ",14,12],["ἰδών",53,155],["με",6,82],["ἐξέκλινε",394,3]],"For the ear heard, and blessed me; and the eye saw me, and turned aside."],["12",[["Διέσωσα",727,147],["γὰρ",40,12],["πτωχὸν",497,7],["ἐκ",21,1],["χειρὸς",37,19],["δυνάστου",803,21],["καὶ",2,8],["ὀρφανῷ",957,111],["ᾧ",24,202],["οὐκ",12,17],["ἦν",10,14],["βοηθὸς",947,5],["ἐβοήθησα",553,147]],"For I saved the poor out of the hand of the oppressor, and helped the fatherless who had no helper."],["13",[["Εὐλογία",578,13],["ἀπολλυμένου",217,418],["ἐπʼ",9,1],["ἐμὲ",6,82],["ἔλθοι",55,216],["στόμα",123,33],["δὲ",14,12],["χήρας",751,40],["με",6,82],["εὐλόγησε",149,3]],"Let the blessing of the perishing one come upon me; yea, the mouth of the widow has blessed me."],["14",[["Δικαιοσύνην",187,10],["δὲ",14,12],["ἐνδεδύκειν",516,149],["ἠμφιασάμην",4498,152],["δὲ",14,12],["κρίμα",267,33],["ἶσα",944,74],["διπλοΐδι",2883,2]],"Also I put on righteousness, and clothed myself with judgment like a mantle."],["15",[["Ὀφθαλμὸς",91,5],["ἤμην",10,429],["τυφλῶν",1600,163],["ποὺς",210,5],["δὲ",14,12],["χωλῶν",2399,115]],"I was the eye of the blind, and the foot of the lame."],["16",[["Ἐγὼ",6,158],["ἤμην",10,429],["πατὴρ",44,5],["ἀδυνάτων",1649,163],["δίκην",1219,10],["δὲ",14,12],["ἣν",24,124],["οὐκ",12,17],["ᾔδειν",53,320],["ἐξιχνίασα",2223,147]],"I was the father of the helpless; and I searched out the cause which I knew not."],["17",[["Συνέτριψα",268,147],["δὲ",14,12],["μύλας",4318,40],["ἀδίκων",406,163],["ἐκ",21,1],["μέσου",113,88],["τῶν",1,76],["ὀδόντων",930,77],["αὐτῶν",3,41],["ἅρπαγμα",2053,20],["ἐξήρπασα",6469,147]],"And I broke the jaw-teeth of the unrighteous; I plucked the spoil out of the midst of their teeth."],["18",[["Εἶπα",18,147],["δὲ",14,12],["ἡ",1,11],["ἡλικία",1755,13],["μου",6,48],["γηράσει",1411,120],["ὥσπερ",226,17],["στέλεχος",2630,20],["φοίνικος",1171,21],["πολὺν",74,59],["χρόνον",486,7],["βιώσω",3504,157]],"And I said, My age shall continue as the stem of a palm-tree; I shall live a long while."],["19",[["Ἡ",1,11],["ῥίζα",892,188],["διήνοικται",0,0],["ἐπὶ",9,1],["ὕδατος",85,24],["καὶ",2,8],["δρόσος",1135,13],["αὐλισθήσεται",990,125],["ἐν",4,1],["τῷ",1,110],["θερισμῷ",1303,113],["μου",6,48]],"[My] root was spread out by the water, and the dew would lodge on my crop."],["20",[["Ἡ",1,11],["δόξα",141,188],["μου",6,48],["κενὴ",780,15],["μετʼ",29,1],["ἐμοῦ",6,48],["καὶ",2,8],["τὸ",1,32],["τόξον",711,33],["μου",6,48],["ἐν",4,1],["χειρὶ",37,2],["αὐτοῦ",3,48],["πορεύεται",49,108]],"My glory was fresh in me, and my bow prospered in his hand."],["21",[["Ἐμοῦ",6,48],["ἀκούσαντες",54,190],["προσέσχον",558,141],["ἐσιώπησαν",1283,129],["δὲ",14,12],["ἐπὶ",9,1],["τῇ",1,95],["ἐμῇ",525,2],["βουλῇ",350,2]],"[Men] heard me, and gave heed, and they were silent at my counsel."],["22",[["Ἐπὶ",9,1],["τῷ",1,52],["ἐμῷ",525,53],["ῥήματι",116,53],["οὐ",12,17],["προσέθεντο",201,184],["περιχαρεῖς",4980,130],["δὲ",14,12],["ἐγίνοντο",30,131],["ὁπόταν",9838,17],["αὐτοῖς",3,142],["ἐλάλουν",50,129]],"At my word they spoke not again, and they were very glad whenever I spoke to them."],["23",[["Ὥσπερ",226,17],["γῆ",26,13],["διψῶσα",1161,183],["προσδεχομένη",1019,204],["τὸν",1,6],["ὑετὸν",676,7],["οὕτως",71,17],["οὗτοι",16,213],["τὴν",1,9],["ἐμὴν",525,10],["λαλιάν",1824,10]],"As the thirsty earth expecting the rain, so they [waited for] my speech."],["24",[["Ἐὰν",45,8],["γελάσω",2071,157],["πρὸς",15,1],["αὐτοὺς",3,60],["οὐ",12,17],["μὴ",25,8],["πιστεύσωσι",649,224],["καὶ",2,8],["φῶς",380,20],["τοῦ",1,23],["προσώπου",47,24],["μου",6,48],["οὐκ",12,17],["ἀπέπιπτεν",3172,14]],"Were I to laugh on them, they would not believe [it]; and the light of my face has not failed."],["25",[["Ἐξελεξάμην",420,152],["ὁδὸν",68,10],["αὐτῶν",3,41],["καὶ",2,8],["ἐκάθισα",274,147],["ἄρχων",96,5],["καὶ",2,8],["κατεσκήνουν",805,129],["ὡσεὶ",343,17],["βασιλεὺς",22,5],["ἐν",4,1],["μονοζώνοις",2743,139],["ὃν",24,106],["τρόπον",245,7],["παθεινοὺς",7820,31],["παρακαλῶν",434,67]],"I chose out their way, and sat chief, and dwelt as a king in the midst of warriors, as one comforting mourners."]]