[["1",[["Ἰδοὺ",51,17],["ταῦτα",16,249],["ἑώρακέ",111,165],["μου",6,48],["ὁ",1,4],["ὀφθαλμὸς",91,5],["καὶ",2,8],["ἀκήκοέ",53,165],["μου",6,48],["τὸ",1,32],["οὖς",325,33]],"Behold, mine eye has seen these things, and mine ear has heard [them]."],["2",[["Καὶ",2,8],["οἶδα",73,85],["ὅσα",102,63],["καὶ",2,8],["ὑμεῖς",5,208],["ἐπίστασθε",1088,68],["καὶ",2,8],["οὐκ",12,17],["ἀσυνετώτερός",2520,16],["εἰμι",10,149],["ὑμῶν",5,136]],"And I know all that ye too know; and I have not less understanding than you."],["3",[["Οὐ",12,17],["μὴν",295,12],["δὲ",14,12],["ἀλλʼ",107,17],["ἐγὼ",6,158],["πρὸς",15,1],["Κύριον",7,7],["λαλήσω",50,157],["ἐλέγξω",750,157],["δὲ",14,12],["ἐναντίον",138,17],["αὐτοῦ",3,48],["ἐὰν",45,8],["βούληται",461,301]],"Nevertheless I will speak to the Lord, and I will reason before him, if he will."],["4",[["Ὑμεῖς",5,208],["δὲ",14,12],["ἐστὲ",10,84],["ἰατροὶ",2552,51],["ἄδικοι",402,130],["καὶ",2,8],["ἰαταὶ",9811,51],["κακῶν",161,79],["πάντες",11,130]],"But ye are all bad physicians, and healers of diseases."],["5",[["Εἴη",10,273],["δὲ",14,12],["ὑμῖν",5,86],["κωφεῦσαι",2598,100],["καὶ",2,8],["ἀποβήσεται",1799,89],["ὑμῖν",5,86],["σοφία",238,13]],"But would that ye were silent, and it would be wisdom to you in the end."],["6",[["Ἀκούσατε",53,69],["δὲ",14,12],["ἔλεγχον",1660,7],["τοῦ",1,23],["στόματός",123,24],["μου",6,48],["κρίσιν",226,10],["δὲ",14,12],["χειλέων",361,45],["μου",6,48],["προσέχετε",557,311]],"But hear ye the reasoning of my mouth, and attend to the judgment of my lips."],["7",[["Πότερον",2495,59],["οὐκ",12,17],["ἔναντι",230,17],["Κυρίου",7,21],["λαλεῖτε",50,311],["ἔναντι",230,17],["δὲ",14,12],["αὐτοῦ",3,48],["φθέγγεσθε",2309,68],["δόλον",920,7]],"Do ye not speak before the Lord, and utter deceit before him?"],["8",[["Ἢ",60,8],["ὑποστελεῖσθε",3784,117],["ὑμεῖς",5,208],["δὲ",14,12],["αὐτοὶ",3,193],["κριταὶ",747,51],["γίνεσθε",30,386]],"Or will ye draw back? nay, do ye yourselves be judges."],["9",[["Καλὸν",264,28],["γὰρ",40,12],["ἐὰν",45,8],["ἐξιχνιάσῃ",2237,116],["ὑμᾶς",5,209],["εἰ",77,8],["γὰρ",40,12],["τὰ",1,42],["πάντα",11,65],["ποιοῦντες",23,137],["προστεθήσεσθε",200,258],["αὐτῷ",3,49]],"For [it were] well if he would thoroughly search you: for though doing all things [in your power] ye should attach yourselves to him,"],["10",[["οὐθὲν",225,29],["ἧττον",2338,29],["ἐλέγξει",750,120],["ὑμᾶς",5,209],["εἰ",77,8],["δὲ",14,12],["καὶ",2,8],["κρυφῇ",378,337],["πρόσωπα",47,43],["θαυμάσεσθε",965,117]],"he will not reprove you at all the less: but if moreover ye should secretly respect persons,"],["11",[["πότερον",2495,59],["οὐχ",12,17],["ἡ",1,11],["δῖνα",7093,157],["αὐτοῦ",3,48],["στροβήσει",4416,120],["ὑμᾶς",5,209],["ὁ",1,4],["φόβος",330,5],["δὲ",14,12],["παρʼ",72,1],["αὐτοῦ",3,48],["ἐπιπεσεῖται",995,89],["ὑμῖν",5,86]],"shall not his whirlpool sweep you round, and terror from him fall upon you?"],["12",[["ἀποβήσεται",1799,89],["δὲ",14,12],["ὑμῶν",5,136],["τὸ",1,32],["γαυρίαμα",2888,33],["ἶσα",945,74],["σποδῷ",1228,2],["τὸ",1,32],["δὲ",14,12],["σῶμα",451,33],["πήλινον",6061,29]],"And your glorying shall prove in the end to you like ashes, and your body [like a body] of clay."],["13",[["Κωφεύσατε",2598,69],["ἵνα",101,8],["λαλήσω",50,157],["καὶ",2,8],["ἀναπαύσωμαι",670,255],["θυμοῦ",177,21]],"Be silent, that I may speak, and cease from [mine] anger,"],["14",[["ἀναλαβὼν",573,155],["τὰς",1,39],["σάρκας",287,40],["μου",6,48],["τοῖς",1,138],["ὀδοῦσι",929,139],["ψυχὴν",62,10],["δέ",14,12],["μου",6,48],["θήσω",109,157],["ἐν",4,1],["χειρί",37,2]],"while I may take my flesh in my teeth, and put my life in my hand."],["15",[["Ἐάν",45,8],["με",6,82],["χειρώσηται",3390,236],["ὁ",1,4],["δυνάστης",800,5],["ἐπεὶ",1238,8],["καὶ",2,8],["ἦρκται",319,372],["ἦ",10,297],["μὴν",295,12],["λαλήσω",50,157],["καὶ",2,8],["ἐλέγξω",750,157],["ἐναντίον",138,17],["αὐτοῦ",3,48]],"Though the Mighty One should lay hand upon me, forasmuch as he has begun, verily I will speak, and plead before him."],["16",[["Καὶ",2,8],["τοῦτό",16,348],["μοι",6,49],["ἀποβήσεται",1799,89],["εἰς",8,1],["σωτηρίαν",422,10],["οὐ",12,17],["γὰρ",40,12],["ἐναντίον",138,17],["αὐτοῦ",3,48],["δόλος",920,5],["εἰσελεύσεται",88,89]],"And this shall turn to me for salvation; for fraud shall have no entrance before him."],["17",[["Ἀκούσατε",53,69],["ἀκούσατε",53,69],["τὰ",1,42],["ῥήματά",115,43],["μου",6,48],["ἀναγγελῶ",228,157],["γὰρ",40,12],["ὑμῶν",5,136],["ἀκουόντων",53,164]],"Hear, hear ye my words, for I will declare in your hearing."],["18",[["Ἰδοὺ",51,17],["ἐγὼ",6,158],["ἐγγύς",1022,17],["εἰμι",10,149],["τοῦ",1,23],["κρίματός",266,24],["μου",6,48],["οἶδα",73,85],["ἐγὼ",6,158],["ὅτι",19,8],["δίκαιος",152,16],["ἀναφανοῦμαι",3697,176]],"Behold, I am near my judgment: I know that I shall appear evidently just."],["19",[["Τίς",39,150],["γάρ",40,12],["ἐστιν",10,87],["ὁ",1,4],["κριθησόμενός",240,707],["μοι",6,49],["ὅτι",19,8],["νῦν",89,17],["κωφεύσω",2598,157],["καὶ",2,8],["ἐκλείψω",321,157]],"For who is he that shall plead with me, that I should now be silent, and expire?"],["20",[["Δυεῖν",7136,54],["δέ",14,12],["μοι",6,49],["χρήσῃ",927,116],["τότε",250,17],["ἀπὸ",17,1],["τοῦ",1,23],["προσώπου",47,24],["σου",5,146],["οὐ",12,17],["κρυβήσομαι",378,175]],"But grant me two things: then I will not hide myself from thy face."],["21",[["Τὴν",1,9],["χεῖρα",37,10],["ἀπʼ",17,1],["ἐμοῦ",6,48],["ἀπέχου",1256,250],["καὶ",2,8],["ὁ",1,4],["φόβος",330,5],["σου",5,146],["μή",25,8],["με",6,82],["καταπλησσέτω",2589,35]],"Withhold [thine] hand from me: and let not thy fear terrify me."],["22",[["Εἶτα",2457,17],["καλέσεις",128,159],["ἐγὼ",6,158],["δέ",14,12],["σοι",5,151],["ὑπακούσομαι",868,176],["ἢ",60,8],["λαλήσεις",50,159],["ἐγὼ",6,158],["δέ",14,12],["σοι",5,151],["δώσω",33,157],["ἀνταπόκρισιν",6314,10]],"Then shalt thou call, and I will hearken to thee: or thou shalt speak, and I will give thee an answer."],["23",[["Πόσαι",2494,179],["εἰσὶν",10,189],["αἱ",1,183],["ἁμαρτίαι",119,179],["μου",6,48],["καὶ",2,8],["ἀνομίαι",274,179],["μου",6,48],["δίδαξόν",543,198],["με",6,82],["τίνες",39,409],["εἰσί",10,189]],"How many are my sins and my transgressions? teach me what they are."],["24",[["Διατί",962,105],["ἀπʼ",17,1],["ἐμοῦ",6,48],["κρύπτῃ",378,166],["ἥγησαι",374,438],["δέ",14,12],["με",6,82],["ὑπεναντίον",1177,59],["σοι",5,151]],"Wherefore hidest thou thyself from me, and deemest me thine enemy?"],["25",[["Ἢ",60,8],["ὡς",36,8],["φῦλλον",1791,20],["κινούμενον",993,201],["ὑπὸ",122,1],["ἀνέμου",852,21],["εὐλαβηθήσῃ",1270,173],["ἢ",60,8],["ὡς",36,8],["χόρτῳ",1044,113],["φερομένῳ",201,240],["ὑπὸ",122,1],["πνεύματος",167,24],["ἀντίκεισαί",2222,166],["μοι",6,49]],"Wilt thou be startled [at me], as [at] a leaf shaken by the wind? or wilt thou set thyself against me as against grass borne upon the breeze?"],["26",[["Ὅτι",19,8],["κατέγραψας",2585,154],["κατʼ",32,1],["ἐμοῦ",6,48],["κακὰ",161,65],["περιέθηκας",1016,154],["δέ",14,12],["μοι",6,49],["νεότητος",785,19],["ἁμαρτίας",119,19]],"For thou hast written evil things against me, and thou hast compassed me with the sins of my youth."],["27",[["Ἔθου",109,169],["δέ",14,12],["μου",6,48],["τὸν",1,6],["πόδα",208,7],["ἐν",4,1],["κωλύματι",7610,53],["ἐφύλαξας",127,154],["δέ",14,12],["μου",6,48],["πάντα",11,65],["τὰ",1,42],["ἔργα",104,43],["εἰς",8,1],["δὲ",14,12],["ῥίζας",893,40],["τῶν",1,76],["ποδῶν",208,77],["μου",6,48],["ἀφίκου",2521,169]],"And thou hast placed my foot in the stocks; and thou hast watched all my works, and hast penetrated to my heels."],["28",[["Ὃ",1,4],["παλαιοῦται",1520,108],["ἶσα",945,74],["ἀσκῷ",2225,113],["ἢ",60,8],["ὥσπερ",221,17],["ἱμάτιον",275,33],["σητόβρωτον",8284,29]],"[I am as] that which waxes old like a bottle, or like a moth-eaten garment."]]