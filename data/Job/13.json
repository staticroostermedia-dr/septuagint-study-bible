[["1",[["Ἰδοὺ",51,17],["ταῦτα",16,248],["ἑώρακέ",112,165],["μου",6,48],["ὁ",1,4],["ὀφθαλμὸς",91,5],["καὶ",2,8],["ἀκήκοέ",54,165],["μου",6,48],["τὸ",1,32],["οὖς",328,33]],"Behold, mine eye has seen these things, and mine ear has heard [them]."],["2",[["Καὶ",2,8],["οἶδα",53,85],["ὅσα",103,63],["καὶ",2,8],["ὑμεῖς",5,208],["ἐπίστασθε",1087,68],["καὶ",2,8],["οὐκ",12,17],["ἀσυνετώτερός",2517,16],["εἰμι",10,149],["ὑμῶν",5,136]],"And I know all that ye too know; and I have not less understanding than you."],["3",[["Οὐ",12,17],["μὴν",296,12],["δὲ",14,12],["ἀλλʼ",108,17],["ἐγὼ",6,158],["πρὸς",15,1],["Κύριον",7,7],["λαλήσω",50,157],["ἐλέγξω",752,157],["δὲ",14,12],["ἐναντίον",138,17],["αὐτοῦ",3,48],["ἐὰν",45,8],["βούληται",463,297]],"Nevertheless I will speak to the Lord, and I will reason before him, if he will."],["4",[["Ὑμεῖς",5,208],["δὲ",14,12],["ἐστὲ",10,84],["ἰατροὶ",2548,51],["ἄδικοι",406,130],["καὶ",2,8],["ἰαταὶ",9734,51],["κακῶν",161,79],["πάντες",11,130]],"But ye are all bad physicians, and healers of diseases."],["5",[["Εἴη",10,273],["δὲ",14,12],["ὑμῖν",5,86],["κωφεῦσαι",2594,100],["καὶ",2,8],["ἀποβήσεται",1797,89],["ὑμῖν",5,86],["σοφία",242,13]],"But would that ye were silent, and it would be wisdom to you in the end."],["6",[["Ἀκούσατε",54,69],["δὲ",14,12],["ἔλεγχον",1659,7],["τοῦ",1,23],["στόματός",123,24],["μου",6,48],["κρίσιν",229,10],["δὲ",14,12],["χειλέων",361,45],["μου",6,48],["προσέχετε",558,307]],"But hear ye the reasoning of my mouth, and attend to the judgment of my lips."],["7",[["Πότερον",2487,59],["οὐκ",12,17],["ἔναντι",232,17],["Κυρίου",7,21],["λαλεῖτε",50,307],["ἔναντι",232,17],["δὲ",14,12],["αὐτοῦ",3,48],["φθέγγεσθε",2296,68],["δόλον",919,7]],"Do ye not speak before the Lord, and utter deceit before him?"],["8",[["Ἢ",61,8],["ὑποστελεῖσθε",3772,117],["ὑμεῖς",5,208],["δὲ",14,12],["αὐτοὶ",3,195],["κριταὶ",749,51],["γίνεσθε",30,382]],"Or will ye draw back? nay, do ye yourselves be judges."],["9",[["Καλὸν",266,28],["γὰρ",40,12],["ἐὰν",45,8],["ἐξιχνιάσῃ",2223,116],["ὑμᾶς",5,209],["εἰ",77,8],["γὰρ",40,12],["τὰ",1,42],["πάντα",11,65],["ποιοῦντες",23,137],["προστεθήσεσθε",201,258],["αὐτῷ",3,49]],"For [it were] well if he would thoroughly search you: for though doing all things [in your power] ye should attach yourselves to him,"],["10",[["οὐθὲν",228,29],["ἧττον",2326,29],["ἐλέγξει",752,120],["ὑμᾶς",5,209],["εἰ",77,8],["δὲ",14,12],["καὶ",2,8],["κρυφῇ",372,333],["πρόσωπα",47,43],["θαυμάσεσθε",963,117]],"he will not reprove you at all the less: but if moreover ye should secretly respect persons,"],["11",[["πότερον",2487,59],["οὐχ",12,17],["ἡ",1,11],["δῖνα",7047,157],["αὐτοῦ",3,48],["στροβήσει",4398,120],["ὑμᾶς",5,209],["ὁ",1,4],["φόβος",333,5],["δὲ",14,12],["παρʼ",73,1],["αὐτοῦ",3,48],["ἐπιπεσεῖται",995,89],["ὑμῖν",5,86]],"shall not his whirlpool sweep you round, and terror from him fall upon you?"],["12",[["ἀποβήσεται",1797,89],["δὲ",14,12],["ὑμῶν",5,136],["τὸ",1,32],["γαυρίαμα",2873,33],["ἶσα",944,74],["σποδῷ",1225,2],["τὸ",1,32],["δὲ",14,12],["σῶμα",454,33],["πήλινον",6033,29]],"And your glorying shall prove in the end to you like ashes, and your body [like a body] of clay."],["13",[["Κωφεύσατε",2594,69],["ἵνα",102,8],["λαλήσω",50,157],["καὶ",2,8],["ἀναπαύσωμαι",674,255],["θυμοῦ",178,21]],"Be silent, that I may speak, and cease from [mine] anger,"],["14",[["ἀναλαβὼν",575,155],["τὰς",1,39],["σάρκας",287,40],["μου",6,48],["τοῖς",1,138],["ὀδοῦσι",930,139],["ψυχὴν",63,10],["δέ",14,12],["μου",6,48],["θήσω",110,157],["ἐν",4,1],["χειρί",37,2]],"while I may take my flesh in my teeth, and put my life in my hand."],["15",[["Ἐάν",45,8],["με",6,82],["χειρώσηται",3384,236],["ὁ",1,4],["δυνάστης",803,5],["ἐπεὶ",1236,8],["καὶ",2,8],["ἦρκται",320,182],["ἦ",10,293],["μὴν",296,12],["λαλήσω",50,157],["καὶ",2,8],["ἐλέγξω",752,157],["ἐναντίον",138,17],["αὐτοῦ",3,48]],"Though the Mighty One should lay hand upon me, forasmuch as he has begun, verily I will speak, and plead before him."],["16",[["Καὶ",2,8],["τοῦτό",16,344],["μοι",6,49],["ἀποβήσεται",1797,89],["εἰς",8,1],["σωτηρίαν",425,10],["οὐ",12,17],["γὰρ",40,12],["ἐναντίον",138,17],["αὐτοῦ",3,48],["δόλος",919,5],["εἰσελεύσεται",86,89]],"And this shall turn to me for salvation; for fraud shall have no entrance before him."],["17",[["Ἀκούσατε",54,69],["ἀκούσατε",54,69],["τὰ",1,42],["ῥήματά",116,43],["μου",6,48],["ἀναγγελῶ",231,157],["γὰρ",40,12],["ὑμῶν",5,136],["ἀκουόντων",54,164]],"Hear, hear ye my words, for I will declare in your hearing."],["18",[["Ἰδοὺ",51,17],["ἐγὼ",6,158],["ἐγγύς",1026,17],["εἰμι",10,149],["τοῦ",1,23],["κρίματός",267,24],["μου",6,48],["οἶδα",53,85],["ἐγὼ",6,158],["ὅτι",19,8],["δίκαιος",153,16],["ἀναφανοῦμαι",3691,177]],"Behold, I am near my judgment: I know that I shall appear evidently just."],["19",[["Τίς",39,150],["γάρ",40,12],["ἐστιν",10,87],["ὁ",1,4],["κριθησόμενός",263,685],["μοι",6,49],["ὅτι",19,8],["νῦν",90,17],["κωφεύσω",2594,157],["καὶ",2,8],["ἐκλείψω",321,157]],"For who is he that shall plead with me, that I should now be silent, and expire?"],["20",[["Δυεῖν",7090,54],["δέ",14,12],["μοι",6,49],["χρήσῃ",928,116],["τότε",250,17],["ἀπὸ",17,1],["τοῦ",1,23],["προσώπου",47,24],["σου",5,146],["οὐ",12,17],["κρυβήσομαι",372,176]],"But grant me two things: then I will not hide myself from thy face."],["21",[["Τὴν",1,9],["χεῖρα",37,10],["ἀπʼ",17,1],["ἐμοῦ",6,48],["ἀπέχου",1255,249],["καὶ",2,8],["ὁ",1,4],["φόβος",333,5],["σου",5,146],["μή",25,8],["με",6,82],["καταπλησσέτω",2455,35]],"Withhold [thine] hand from me: and let not thy fear terrify me."],["22",[["Εἶτα",2450,17],["καλέσεις",128,159],["ἐγὼ",6,158],["δέ",14,12],["σοι",5,151],["ὑπακούσομαι",867,177],["ἢ",61,8],["λαλήσεις",50,159],["ἐγὼ",6,158],["δέ",14,12],["σοι",5,151],["δώσω",33,157],["ἀνταπόκρισιν",6283,10]],"Then shalt thou call, and I will hearken to thee: or thou shalt speak, and I will give thee an answer."],["23",[["Πόσαι",2486,180],["εἰσὶν",10,191],["αἱ",1,185],["ἁμαρτίαι",119,180],["μου",6,48],["καὶ",2,8],["ἀνομίαι",275,180],["μου",6,48],["δίδαξόν",545,198],["με",6,82],["τίνες",39,402],["εἰσί",10,191]],"How many are my sins and my transgressions? teach me what they are."],["24",[["Διατί",960,105],["ἀπʼ",17,1],["ἐμοῦ",6,48],["κρύπτῃ",372,166],["ἥγησαι",378,432],["δέ",14,12],["με",6,82],["ὑπεναντίον",1177,59],["σοι",5,151]],"Wherefore hidest thou thyself from me, and deemest me thine enemy?"],["25",[["Ἢ",61,8],["ὡς",36,8],["φῦλλον",1791,20],["κινούμενον",992,201],["ὑπὸ",122,1],["ἀνέμου",850,21],["εὐλαβηθήσῃ",1271,174],["ἢ",61,8],["ὡς",36,8],["χόρτῳ",1046,113],["φερομένῳ",199,240],["ὑπὸ",122,1],["πνεύματος",168,24],["ἀντίκεισαί",2210,166],["μοι",6,49]],"Wilt thou be startled [at me], as [at] a leaf shaken by the wind? or wilt thou set thyself against me as against grass borne upon the breeze?"],["26",[["Ὅτι",19,8],["κατέγραψας",2581,154],["κατʼ",32,1],["ἐμοῦ",6,48],["κακὰ",161,65],["περιέθηκας",1017,154],["δέ",14,12],["μοι",6,49],["νεότητος",787,19],["ἁμαρτίας",119,19]],"For thou hast written evil things against me, and thou hast compassed me with the sins of my youth."],["27",[["Ἔθου",110,169],["δέ",14,12],["μου",6,48],["τὸν",1,6],["πόδα",210,7],["ἐν",4,1],["κωλύματι",7559,53],["ἐφύλαξας",125,154],["δέ",14,12],["μου",6,48],["πάντα",11,65],["τὰ",1,42],["ἔργα",105,43],["εἰς",8,1],["δὲ",14,12],["ῥίζας",892,40],["τῶν",1,76],["ποδῶν",210,77],["μου",6,48],["ἀφίκου",2518,169]],"And thou hast placed my foot in the stocks; and thou hast watched all my works, and hast penetrated to my heels."],["28",[["Ὃ",1,4],["παλαιοῦται",1384,108],["ἶσα",944,74],["ἀσκῷ",2213,113],["ἢ",61,8],["ὥσπερ",226,17],["ἱμάτιον",276,33],["σητόβρωτον",8224,29]],"[I am as] that which waxes old like a bottle, or like a moth-eaten garment."]]