[["1",[["Ὑπολαβὼν",1009,155],["δὲ",14,12],["Ἐλιφὰς",0,0],["ὁ",1,4],["Θαιμανίτης",0,0],["λέγει",31,87]],"Then Eliphaz the Thæmanite answered and said,"],["2",[["Μὴ",25,8],["πολλάκις",2960,17],["σοι",5,151],["λελάληται",0,0],["ἐν",4,1],["κόπῳ",1342,113],["ἰσχὺν",180,10],["δὲ",14,12],["ῥημάτων",115,45],["σου",5,146],["τίς",39,150],["ὑποίσει",1877,120]],"Hast thou been often spoken to in distress? but who shall endure the force of thy words?"],["3",[["Εἰ",77,8],["γὰρ",40,12],["σὺ",5,156],["ἐνουθέτησας",2756,154],["πολλοὺς",74,58],["καὶ",2,8],["χεῖρας",37,40],["ἀσθενοῦς",1853,153],["παρεκάλεσας",432,154]],"For whereas thou hast instructed many, and hast strengthened the hands of the weak one,"],["4",[["ἀσθενοῦντάς",768,229],["τε",207,12],["ἐξανέστησας",1292,154],["ῥήμασι",115,92],["γόνασί",1300,92],["τε",207,12],["ἀδυνατοῦσι",2408,479],["θάρσος",2086,20],["περιέθηκας",1016,154]],"and hast supported the failing with words, and hast imparted courage to feeble knees."],["5",[["Νῦν",89,17],["δὲ",14,12],["ἥκει",260,87],["ἐπὶ",9,1],["σὲ",5,161],["πόνος",564,5],["καὶ",2,8],["ἥψατό",462,26],["σου",5,146],["σὺ",5,156],["ἐσπούδασας",2497,154]],"Yet now [that] pain has come upon thee, and touched thee, thou art troubled."],["6",[["Πότερον",2495,59],["οὐχ",12,17],["ὁ",1,4],["φόβος",330,5],["σου",5,146],["ἐστὶν",10,87],["ἐν",4,1],["ἀφροσύνῃ",1402,2],["καὶ",2,8],["ἡ",1,11],["ἐλπίς",527,13],["σου",5,146],["καὶ",2,8],["ἡ",1,11],["κακία",431,13],["τῆς",1,18],["ὁδοῦ",67,19],["σου",5,146]],"Is not thy fear [founded] in folly, thy hope also, and the mischief of thy way?"],["7",[["Μνήσθητι",231,242],["οὖν",223,12],["τίς",39,150],["καθαρὸς",375,16],["ὢν",10,67],["ἀπώλετο",594,26],["ἢ",60,8],["πότε",455,12],["ἀληθινοὶ",1020,130],["ὁλόῤῥιζοι",6661,130],["ἀπώλοντο",213,182]],"Remember then who has perished, being pure? or when were the true-hearted utterly destroyed?"],["8",[["Καθʼ",32,1],["ὃν",24,106],["τρόπον",243,7],["εἶδον",73,147],["τοὺς",1,56],["ἀροτριῶντας",2519,229],["τὰ",1,42],["ἄτοπα",3422,65],["οἱ",1,128],["δὲ",14,12],["σπείροντες",790,137],["αὐτὰ",3,66],["ὀδύνας",771,40],["θεριοῦσιν",1546,355],["ἑαυτοῖς",92,142]],"Accordingly as I have seen men ploughing barren places, and they that sow them will reap sorrows for themselves."],["9",[["Ἀπὸ",17,1],["προστάγματος",391,24],["Κυρίου",7,21],["ἀπολοῦνται",213,127],["ἀπὸ",17,1],["δὲ",14,12],["πνεύματος",167,24],["ὀργῆς",198,19],["αὐτοῦ",3,144],["ἀφανισθήσονται",675,135]],"They shall perish by the command of the Lord, and shall be utterly consumed by the breath of his wrath."],["10",[["Σθένος",4400,20],["λέοντος",421,21],["φωνὴ",95,13],["δὲ",14,12],["λεαίνης",5832,19],["γαυρίαμα",2888,20],["δὲ",14,12],["δρακόντων",1269,77],["ἐσβέσθη",1078,38]],"The strength of the lion, and the voice of the lioness, and the exulting cry of serpents are quenched."],["11",[["Μυρμηκολέων",7771,5],["ὤλετο",1808,26],["παρὰ",72,1],["τὸ",1,32],["μὴ",25,8],["ἔχειν",124,54],["βορὰν",3805,10],["σκύμνοι",1481,51],["δὲ",14,12],["λεόντων",421,77],["ἔλιπον",3587,141],["ἀλλήλους",1194,60]],"The old lion has perished for want of food, and the lions' whelps have forsaken one another."],["12",[["Εἰ",77,8],["δέ",14,12],["τι",39,119],["ῥῆμα",115,33],["ἀληθινὸν",1020,29],["ἐγεγόνει",30,87],["ἐν",4,1],["λόγοις",48,139],["σου",5,146],["οὐθὲν",225,29],["ἄν",82,12],["σοι",5,151],["τούτων",16,214],["κακὸν",161,29],["ἀπήντησε",1047,3],["πότερον",2495,29],["οὐ",12,17],["δέξεταί",813,89],["μου",6,48],["τὸ",1,32],["οὖς",325,33],["ἐξαίσια",3012,74],["παρʼ",72,1],["αὐτοῦ",3,48]],"But if there had been any truth in thy words, none of these evils would have befallen thee. Shall not mine ear receive excellent [revelations] from him?"],["13",[["Φόβῳ",330,113],["δὲ",14,12],["καὶ",2,8],["ἤχῳ",1805,113],["νυκτερινῇ",3606,96],["ἐπιπίπτων",995,67],["φόβος",330,5],["ἐπʼ",9,1],["ἀνθρώπους",43,31]],"But [as when] terror falls upon men, with dread and a sound in the night,"],["14",[["φρίκη",6215,13],["μοι",6,49],["συνήντησεν",426,3],["καὶ",2,8],["τρόμος",1600,5],["καὶ",2,8],["μεγάλως",65,58],["μου",6,48],["τὰ",1,42],["ὀστᾶ",472,43],["διέσεισε",5593,3]],"horror and trembling seized me, and caused all my bones greatly to shake."],["15",[["καὶ",2,8],["πνεῦμα",167,20],["ἐπὶ",9,1],["πρόσωπόν",47,20],["μου",6,48],["ἐπῆλθεν",540,3],["ἔφριξαν",3384,141],["δέ",14,12],["μου",6,48],["τρίχες",1035,179],["καὶ",2,8],["σάρκες",287,179]],"And a spirit came before my face; and my hair and flesh quivered."],["16",[["Ἀνέστην",121,147],["καὶ",2,8],["οὐκ",12,17],["ἐπέγνων",433,147],["εἶδον",73,147],["καὶ",2,8],["οὐκ",12,17],["ἦν",10,14],["μορφὴ",2752,13],["πρὸ",235,1],["ὀφθαλμῶν",91,77],["μου",6,48],["ἀλλʼ",107,17],["ἢ",60,8],["αὖραν",4724,61],["καὶ",2,8],["φωνὴν",95,10],["ἤκουον",53,129]],"I arose and perceived it not: I looked, and there was no form before my eyes: but I only heard a breath and a voice, [saying],"],["17",[["Τί",39,119],["γάρ",40,12],["μὴ",25,8],["καθαρὸς",375,16],["ἔσται",10,89],["βροτὸς",2019,5],["ἐναντίον",138,17],["τοῦ",1,30],["Κυρίου",7,21],["ἢ",60,8],["ἀπὸ",17,1],["τῶν",1,44],["ἔργων",104,45],["αὐτοῦ",3,48],["ἄμεμπτος",2141,16],["ἀνήρ",38,5]],"What, shall a mortal be pure before the Lord? or a man be blameless in regard to his works?"],["18",[["Εἰ",77,8],["κατὰ",32,1],["παίδων",126,77],["αὐτοῦ",3,48],["οὐ",12,17],["πιστεύει",658,87],["κατὰ",32,1],["δὲ",14,12],["ἀγγέλων",206,77],["αὐτοῦ",3,48],["σκολιόν",1693,28],["τι",39,238],["ἐπενόησε",4631,3]],"Whereas he trusts not in his servants, and perceives perverseness in his angels."],["19",[["Τοὺς",1,56],["δὲ",14,12],["κατοικοῦντας",90,229],["οἰκίας",232,40],["πηλίνας",6061,109],["ἐξ",21,1],["ὧν",24,97],["καὶ",2,8],["αὐτοὶ",3,193],["ἐκ",21,1],["τοῦ",1,30],["αὐτοῦ",3,48],["πηλοῦ",1386,21],["ἐσμεν",10,241],["ἔπαισεν",2197,3],["αὐτοὺς",3,60],["σητὸς",2127,21],["τρόπον",243,7]],"But [as for] them that dwell in houses of clay, of whom we also are formed of the same clay, he smites them like a moth."],["20",[["καὶ",2,8],["ἀπὸ",17,1],["πρωΐθεν",2964,17],["μέχρι",780,1],["ἑσπέρας",486,19],["οὐκ",12,17],["ἔτι",110,17],["εἰσὶ",10,189],["παρὰ",72,1],["τὸ",1,32],["μὴ",25,8],["δύνασθαι",184,104],["αὐτοὺς",3,60],["ἑαυτοῖς",92,142],["βοηθῆσαι",552,100],["ἀπώλοντο",213,182]],"And from morning to evening they no longer exist: they have perished, because they cannot help themselves."],["21",[["Ἐνεφύσησε",3195,3],["γὰρ",40,12],["αὐτοῖς",3,142],["καὶ",2,8],["ἐξηράνθησαν",843,94],["ἀπώλοντο",213,182],["παρὰ",72,1],["τὸ",1,32],["μὴ",25,8],["ἔχειν",124,54],["αὐτοὺς",3,60],["σοφίαν",238,10]],"For he blows upon them, and they are withered: they have perished for lack of wisdom."]]