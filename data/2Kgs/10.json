ῶν",119,61],["Ἰεροβοὰμ",11639,0],["ὃς",24,246],["ἐξήμαρτε",1369,3],["τὸν",1,6],["Ἰσραήλ",27,105]],"But Ju took no heed to walk in the law of the Lord God of Israel with all his heart: he departed not from following the sins of Jeroboam, who made Israel to sin."],["32",[["Ἐν",4,1],["ταῖς",1,70],["ἡμέραις",28,71],["ἐκείναις",80,194],["ἤρξατο",320,26],["Κύριος",7,5],["συγκόπτειν",2382,54],["ἐν",4,1],["τῷ",1,110],["Ἰσραήλ",27,105],["καὶ",2,8],["ἐπάταξεν",145,3],["αὐτοὺς",3,60],["Ἀζαὴλ",11577,0],["ἐν",4,1],["παντὶ",11,34],["ὁρίῳ",236,53],["Ἰσραὴλ",27,105]],"In those days the Lord began to cut Israel short; and Azael smote them in every coast of Israel;"],["33",[["ἀπὸ",17,1],["τοῦ",1,30],["Ἰορδάνου",303,21],["κατʼ",32,1],["ἀνατολὰς",345,40],["ἡλίου",323,21],["πᾶσαν",11,37],["τὴν",1,9],["Γαλαάδ",14954,0],["τοῦ",1,30],["Γαδδὶ",14996,0],["καὶ",2,8],["τοῦ",1,30],["Ῥουβὴν",616,105],["καὶ",2,8],["τοῦ",1,30],["Μανασσῆ",396,250],["ἀπὸ",17,1],["Ἀροὴρ",11613,0],["ἥ",1,11],["ἐστιν",10,87],["ἐπὶ",9,1],["τοῦ",1,23],["χείλους",361,24],["χειμάῤῥου",737,21],["Ἀρνὼν",849,77],["καὶ",2,8],["τὴν",1,9],["Γαλαὰδ",11550,0],["καὶ",2,8],["τὴν",1,9],["Βασάν",991,405]],"from Jordan eastward all the land of Galaad belonging to the Gadites, of Gaddi and that of Ruben, and of Manasses, from Aroer, which is on the brink of the brook of Arnon, and Galaad and Basan."],["34",[["Καὶ",2,8],["τὰ",1,42],["λοιπὰ",523,65],["τῶν",1,76],["λόγων",48,77],["Ἰοὺ",11554,316],["καὶ",2,8],["πάντα",11,65],["ὅσα",103,43],["ἐποίησε",23,3],["καὶ",2,8],["πᾶσα",11,15],["ἡ",1,11],["δυναστεία",918,13],["αὐτοῦ",3,48],["καὶ",2,8],["τὰς",1,39],["συνάψεις",982,159],["ἃς",24,186],["συνῆψεν",982,3],["οὐχὶ",330,12],["ταῦτα",16,248],["γεγραμμένα",186,381],["ἐπὶ",9,1],["βιβλίου",339,24],["λόγων",48,77],["τῶν",1,76],["ἡμερῶν",28,61],["τοῖς",1,138],["βασιλεῦσιν",22,139],["Ἰσραήλ",27,105]],"And the rest of the acts of Ju, and all that he did, and all his might, and the wars wherein he engaged, [are] not these things written in the book of 