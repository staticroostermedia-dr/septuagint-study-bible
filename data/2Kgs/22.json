,17],["σβεσθήσεται",1078,125]],"because they have forsaken me, and burnt incense to other gods, that they might provoke me with the works of their hands: therefore my wrath shall burn forth against this place, and shall not be quenched."],["18",[["Καὶ",2,8],["πρὸς",15,1],["βασιλέα",22,7],["Ἰούδα",61,21],["τὸν",1,6],["ἀποστείλαντα",83,485],["ὑμᾶς",5,209],["ἐπιζητῆσαι",1937,100],["τὸν",1,6],["Κύριον",7,7],["τάδε",129,249],["ἐρεῖτε",663,343],["πρὸς",15,1],["αὐτὸν",3,82],["τάδε",129,249],["λέγει",31,87],["Κύριος",7,5],["ὁ",1,4],["Θεὸς",20,5],["Ἰσραὴλ",27,105],["οἱ",1,128],["λόγοι",48,51],["οὓς",24,298],["ἤκουσας",53,154]],"And to the king of Juda that sent you to enquire of the Lord,—thus shall ye say to him, Thus saith the Lord God of Israel, [As for] the words which thou hast heard;"],["19",[["ἀνθʼ",158,1],["ὧν",24,97],["ὅτι",19,8],["ἡπαλύνθη",5285,38],["ἡ",1,11],["καρδία",63,13],["σου",5,146],["καὶ",2,8],["ἐνετράπης",1153,363],["ἀπὸ",17,1],["προσώπου",47,24],["ὡς",36,8],["ἤκουσας",53,154],["ὅσα",102,63],["ἐλάλησα",50,147],["ἐπὶ",9,1],["τὸν",1,6],["τόπον",99,7],["τοῦτον",16,259],["καὶ",2,8],["ἐπὶ",9,1],["τοὺς",1,56],["ἐνοικοῦντας",1404,229],["αὐτὸν",3,82],["τοῦ",1,30],["εἶναι",10,54],["εἰς",8,1],["ἀφανισμὸν",880,7],["καὶ",2,8],["εἰς",8,1],["κατάραν",1166,10],["καὶ",2,8],["διέῤῥηξας",673,154],["τὰ",1,42],["ἱμάτιά",275,43],["σου",5,146],["καὶ",2,8],["ἔκλαυσας",409,154],["ἐνώπιόν",114,1],["μου",6,48],["καί",2,8],["γε",351,12],["ἐγὼ",6,158],["ἤκουσα",53,147],["λέγει",31,87],["Κύριος",7,5]],"because thy heart was softened, and thou wast humbled before [me], when thou heardest all that I spoke against this place, and against the inhabitants of it, that it should be utterly destroyed and accursed, and thou didst rend thy garments, and weep before me; I also have heard, saith the Lord."],["20",[["Οὐχ",12,17],["οὕτως",70,17],["ἰδοὺ",51,17],["προστίθημί",200,149],["σε",5,161],["πρὸς",15,1],["τοὺς",1,56],["πατέρας",44,31],["σου",5,146],["καὶ",2,8],["συναχθήσῃ",165,379],["εἰς",8,