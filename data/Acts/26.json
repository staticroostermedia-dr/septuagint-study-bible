[["1",[["Ἀγρίππας",10743,5],["δὲ",14,8],["πρὸς",15,1],["τὸν",1,6],["Παῦλον",10586,7],["ἔφη",660,14],["ἐπιτρέπεταί",3445,449],["σοι",5,151],["περὶ",72,1],["σεαυτοῦ",10014,48],["λέγειν",31,54],["τότε",250,17],["ὁ",1,4],["Παῦλος",10586,5],["ἐκτείνας",421,155],["τὴν",1,9],["χεῖρα",37,10],["ἀπελογεῖτο",5223,721]],"Agrippa said to Paul, “You may speak for yourself.” Then Paul stretched out his hand, and made his defense."],["2",[["περὶ",72,1],["πάντων",11,79],["ὧν",24,97],["ἐγκαλοῦμαι",4066,572],["ὑπὸ",122,1],["Ἰουδαίων",285,77],["βασιλεῦ",22,250],["Ἀγρίππα",10743,250],["ἥγημαι",378,869],["ἐμαυτὸν",10062,82],["μακάριον",806,59],["ἐπὶ",9,1],["σοῦ",5,146],["μέλλων",1143,67],["σήμερον",205,17],["ἀπολογεῖσθαι",5223,749]],"“I think myself happy, King Agrippa, that I am to make my defense before you today concerning all the things the Jews accuse me of,"],["3",[["μάλιστα",3593,17],["γνώστην",3802,7],["ὄντα",10,178],["σε",5,161],["πάντων",11,79],["τῶν",1,44],["κατὰ",32,1],["Ἰουδαίους",285,31],["ἐθῶν",3754,45],["τε",209,8],["καὶ",2,8],["ζητημάτων",10607,45],["διὸ",1466,8],["δέομαι",1672,768],["μακροθύμως",10748,17],["ἀκοῦσαί",54,100],["μου",9994,146]],"especially because you are expert in all customs and questions which are among the Jews. Therefore I beg you to hear me patiently."],["4",[["Τὴν",1,9],["μὲν",281,12],["οὖν",227,8],["βίωσίν",6872,10],["μου",9994,146],["τὴν",1,9],["ἐκ",21,1],["νεότητος",787,19],["τὴν",1,9],["ἀπ᾽",17,1],["ἀρχῆς",270,19],["γενομένην",30,863],["ἐν",4,1],["τῷ",1,52],["ἔθνει",60,53],["μου",9994,146],["ἔν",4,1],["τε",209,8],["Ἱεροσολύμοις",70,92],["ἴσασιν",10749,191],["πάντες",11,130],["οἱ",1,128],["Ἰουδαῖοι",285,51]],"“Indeed, all the Jews know my way of life from my youth up, which was from the beginning among my own nation and at Jerusalem;"],["5",[["προγινώσκοντές",5003,137],["με",9994,161],["ἄνωθεν",1605,17],["ἐὰν",45,8],["θέλωσιν",612,265],["μαρτυρεῖν",2094,54],["ὅτι",19,8],["κατὰ",32,1],["τὴν",1,9],["ἀκριβεστάτην",10750,37],["αἵρεσιν",4693,10],["τῆς",1,18],["ἡμετέρας",10505,78],["θρησκείας",4242,19],["ἔζησα",107,147],["Φαρισαῖος",10006,5]],"having known me from the first, if they are willing to testify, that after the strictest sect of our religion I lived a Pharisee."],["6",[["καὶ",2,8],["νῦν",90,17],["ἐπ᾽",9,1],["ἐλπίδι",530,2],["τῆς",1,18],["εἰς",8,1],["τοὺς",1,56],["πατέρας",44,31],["ἡμῶν",9994,136],["ἐπαγγελίας",3439,19],["γενομένης",30,760],["ὑπὸ",122,1],["τοῦ",1,30],["θεοῦ",20,21],["ἕστηκα",78,85],["κρινόμενος",263,714]],"Now I stand here to be judged for the hope of the promise made by God to our fathers,"],["7",[["εἰς",8,1],["ἣν",24,124],["τὸ",1,27],["δωδεκάφυλον",10751,20],["ἡμῶν",9994,136],["ἐν",4,1],["ἐκτενείᾳ",10752,2],["νύκτα",219,10],["καὶ",2,8],["ἡμέραν",28,10],["λατρεῦον",594,36],["ἐλπίζει",514,87],["καταντῆσαι",3850,100],["περὶ",72,1],["ἧς",24,162],["ἐλπίδος",530,19],["ἐγκαλοῦμαι",4066,572],["ὑπὸ",122,1],["Ἰουδαίων",285,77],["βασιλεῦ",22,250]],"which our twelve tribes, earnestly serving night and day, hope to attain. Concerning this hope I am accused by the Jews, King Agrippa!"],["8",[["τί",10010,119],["ἄπιστον",4557,28],["κρίνεται",263,449],["παρ᾽",73,1],["ὑμῖν",5,86],["εἰ",77,8],["ὁ",1,4],["θεὸς",20,5],["νεκροὺς",659,58],["ἐγείρει",746,87]],"Why is it judged incredible with you if God does raise the dead?"],["9",[["Ἐγὼ",6,156],["μὲν",281,12],["οὖν",227,8],["ἔδοξα",801,147],["ἐμαυτῷ",10062,49],["πρὸς",15,1],["τὸ",1,32],["ὄνομα",57,33],["Ἰησοῦ",211,21],["τοῦ",1,30],["Ναζωραίου",10004,21],["δεῖν",1158,54],["πολλὰ",74,65],["ἐναντία",2057,65],["πρᾶξαι",1251,100]],"“I myself most certainly thought that I ought to do many things contrary to the name of Jesus of Nazareth."],["10",[["ὃ",24,467],["καὶ",2,8],["ἐποίησα",23,147],["ἐν",4,1],["Ἱεροσολύμοις",70,92],["καὶ",2,8],["πολλούς",74,58],["τε",209,8],["τῶν",1,76],["ἁγίων",75,163],["ἐγὼ",6,156],["ἐν",4,1],["φυλακαῖς",485,71],["κατέκλεισα",3847,147],["τὴν",1,9],["παρὰ",73,1],["τῶν",1,76],["ἀρχιερέων",1100,77],["ἐξουσίαν",929,10],["λαβών",46,155],["ἀναιρουμένων",651,795],["τε",209,8],["αὐτῶν",3,41],["κατήνεγκα",2262,147],["ψῆφον",4006,10]],"I also did this in Jerusalem. I both shut up many of the saints in prisons, having received authority from the chief priests; and when they were put to death I gave my vote against them."],["11",[["καὶ",2,8],["κατὰ",32,1],["πάσας",11,109],["τὰς",1,39],["συναγωγὰς",284,40],["πολλάκις",2947,17],["τιμωρῶν",2790,67],["αὐτοὺς",3,60],["ἠνάγκαζον",1847,293],["βλασφημεῖν",3250,54],["περισσῶς",3615,17],["τε",209,8],["ἐμμαινόμενος",10753,723],["αὐτοῖς",3,142],["ἐδίωκον",533,293],["ἕως",42,1],["καὶ",2,8],["εἰς",8,1],["τὰς",1,39],["ἔξω",527,1],["πόλεις",41,40]],"Punishing them often in all the synagogues, I tried to make them blaspheme. Being exceedingly enraged against them, I persecuted them even to foreign cities."],["12",[["ἐν",4,1],["οἷς",24,337],["πορευόμενος",49,723],["εἰς",8,1],["τὴν",1,9],["Δαμασκὸν",1012,10],["μετ᾽",29,1],["ἐξουσίας",929,19],["καὶ",2,8],["ἐπιτροπῆς",9561,19],["τῆς",1,18],["τῶν",1,76],["ἀρχιερέων",1100,77]],"“Whereupon as I traveled to Damascus with the authority and commission from the chief priests,"],["13",[["ἡμέρας",28,19],["μέσης",113,78],["κατὰ",32,1],["τὴν",1,9],["ὁδὸν",68,10],["εἶδον",112,147],["βασιλεῦ",22,250],["οὐρανόθεν",7810,17],["ὑπὲρ",139,1],["τὴν",1,9],["λαμπρότητα",3577,10],["τοῦ",1,30],["ἡλίου",323,21],["περιλάμψαν",10307,526],["με",9994,161],["φῶς",380,33],["καὶ",2,8],["τοὺς",1,56],["σὺν",310,1],["ἐμοὶ",6,151],["πορευομένους",49,729]],"at noon, O king, I saw on the way a light from the sky, brighter than the sun, shining around me and those who traveled with me."],["14",[["πάντων",11,163],["τε",209,8],["καταπεσόντων",3280,211],["ἡμῶν",9994,136],["εἰς",8,1],["τὴν",1,9],["γῆν",26,10],["ἤκουσα",54,147],["φωνὴν",95,10],["λέγουσαν",31,73],["πρός",15,1],["με",9994,161],["τῇ",1,95],["Ἑβραΐδι",10726,96],["διαλέκτῳ",7070,2],["Σαοὺλ",155,250],["Σαούλ",155,250],["τί",10010,119],["με",9994,161],["διώκεις",533,145],["σκληρόν",831,28],["σοι",5,151],["πρὸς",15,1],["κέντρα",3875,43],["λακτίζειν",10754,54]],"When we had all fallen to the earth, I heard a voice saying to me in the Hebrew language, ‘Saul, Saul, why are you persecuting me? It is hard for you to kick against the goads.’"],["15",[["ἐγὼ",6,156],["δὲ",14,8],["εἶπα",31,147],["τίς",10010,150],["εἶ",10,145],["κύριε",7,250],["ὁ",1,4],["δὲ",14,8],["κύριος",7,5],["εἶπεν",31,3],["ἐγώ",6,156],["εἰμι",10,149],["Ἰησοῦς",211,5],["ὃν",24,106],["σὺ",5,156],["διώκεις",533,145]],"“I said, ‘Who are you, Lord?’ “He said, ‘I am Jesus, whom you are persecuting."],["16",[["ἀλλ᾽",108,8],["ἀνάστηθι",121,198],["καὶ",2,8],["στῆθι",78,198],["ἐπὶ",9,1],["τοὺς",1,56],["πόδας",210,31],["σου",5,146],["εἰς",8,1],["τοῦτο",16,122],["γὰρ",40,8],["ὤφθην",112,148],["σοι",5,151],["προχειρίσασθαί",4372,103],["σε",5,161],["ὑπηρέτην",4138,7],["καὶ",2,8],["μάρτυρα",875,7],["ὧν",24,97],["τε",209,8],["εἶδές",112,154],["με",9994,161],["ὧν",24,97],["τε",209,8],["ὀφθήσομαί",112,176],["σοι",5,151]],"But arise, and stand on your feet, for I have appeared to you for this purpose: to appoint you a servant and a witness both of the things which you have seen and of the things which I will reveal to you;"],["17",[["ἐξαιρούμενός",413,406],["σε",5,161],["ἐκ",21,1],["τοῦ",1,30],["λαοῦ",35,21],["καὶ",2,8],["ἐκ",21,1],["τῶν",1,44],["ἐθνῶν",60,45],["εἰς",8,1],["οὓς",24,294],["ἐγὼ",6,156],["ἀποστέλλω",84,149],["σε",5,161]],"delivering you from the people and from the Gentiles, to whom I send you,"],["18",[["ἀνοῖξαι",362,100],["ὀφθαλμοὺς",91,31],["αὐτῶν",3,41],["τοῦ",1,23],["ἐπιστρέψαι",117,100],["ἀπὸ",17,1],["σκότους",506,24],["εἰς",8,1],["φῶς",380,33],["καὶ",2,8],["τῆς",1,18],["ἐξουσίας",929,19],["τοῦ",1,30],["σατανᾶ",6785,21],["ἐπὶ",9,1],["τὸν",1,6],["θεόν",20,7],["τοῦ",1,23],["λαβεῖν",46,100],["αὐτοὺς",3,60],["ἄφεσιν",986,10],["ἁμαρτιῶν",119,61],["καὶ",2,8],["κλῆρον",408,7],["ἐν",4,1],["τοῖς",1,138],["ἡγιασμένοις",329,804],["πίστει",887,2],["τῇ",1,95],["εἰς",8,1],["ἐμέ",6,161]],"to open their eyes, that they may turn from darkness to light and from the power of Satan to God, that they may receive remission of sins and an inheritance among those who are sanctified by faith in me.’"],["19",[["Ὅθεν",1153,8],["βασιλεῦ",22,250],["Ἀγρίππα",10743,250],["οὐκ",12,12],["ἐγενόμην",30,820],["ἀπειθὴς",3404,16],["τῇ",1,95],["οὐρανίῳ",3602,96],["ὀπτασίᾳ",3022,2]],"“Therefore, King Agrippa, I was not disobedient to the heavenly vision,"],["20",[["ἀλλὰ",108,8],["τοῖς",1,138],["ἐν",4,1],["Δαμασκῷ",1012,2],["πρῶτόν",315,29],["τε",209,8],["καὶ",2,8],["Ἱεροσολύμοις",70,92],["πᾶσάν",11,37],["τε",209,8],["τὴν",1,9],["χώραν",278,10],["τῆς",1,18],["Ἰουδαίας",492,19],["καὶ",2,8],["τοῖς",1,91],["ἔθνεσιν",60,92],["ἀπήγγελλον",273,293],["μετανοεῖν",1634,54],["καὶ",2,8],["ἐπιστρέφειν",117,100],["ἐπὶ",9,1],["τὸν",1,6],["θεὸν",20,7],["ἄξια",1102,65],["τῆς",1,18],["μετανοίας",3084,19],["ἔργα",105,43],["πράσσοντας",1251,229]],"but declared first to them of Damascus, at Jerusalem, and throughout all the country of Judea, and also to the Gentiles, that they should repent and turn to God, doing works worthy of repentance."],["21",[["ἕνεκα",447,1],["τούτων",16,214],["με",9994,161],["Ἰουδαῖοι",285,51],["συλλαβόμενοι",507,315],["ὄντα",10,178],["ἐν",4,1],["τῷ",1,52],["ἱερῷ",675,53],["ἐπειρῶντο",2474,767],["διαχειρίσασθαι",10521,103]],"For this reason the Jews seized me in the temple and tried to kill me."],["22",[["ἐπικουρίας",9515,19],["οὖν",227,8],["τυχὼν",1451,155],["τῆς",1,18],["ἀπὸ",17,1],["τοῦ",1,30],["θεοῦ",20,21],["ἄχρι",4062,1],["τῆς",1,18],["ἡμέρας",28,19],["ταύτης",16,290],["ἕστηκα",78,85],["μαρτυρόμενος",7635,723],["μικρῷ",367,111],["τε",209,8],["καὶ",2,8],["μεγάλῳ",66,111],["οὐδὲν",228,29],["ἐκτὸς",1702,1],["λέγων",31,67],["ὧν",24,97],["τε",209,8],["οἱ",1,128],["προφῆται",176,51],["ἐλάλησαν",50,141],["μελλόντων",1143,80],["γίνεσθαι",30,749],["καὶ",2,8],["Μωϋσῆς",5453,5]],"Having therefore obtained the help that is from God, I stand to this day testifying both to small and great, saying nothing but what the prophets and Moses said would happen,"],["23",[["εἰ",77,8],["παθητὸς",10755,16],["ὁ",1,4],["χριστός",1072,5],["εἰ",77,8],["πρῶτος",315,16],["ἐξ",21,1],["ἀναστάσεως",4027,19],["νεκρῶν",659,163],["φῶς",380,33],["μέλλει",1143,87],["καταγγέλλειν",5681,54],["τῷ",1,110],["τε",209,8],["λαῷ",35,113],["καὶ",2,8],["τοῖς",1,91],["ἔθνεσιν",60,92]],"how the Christ must suffer, and how, by the resurrection of the dead, he would be first to proclaim light both to these people and to the Gentiles.”"],["24",[["Ταῦτα",16,248],["δὲ",14,8],["αὐτοῦ",3,48],["ἀπολογουμένου",5223,766],["ὁ",1,4],["Φῆστος",10740,5],["μεγάλῃ",66,96],["τῇ",1,95],["φωνῇ",95,2],["φησιν",660,87],["μαίνῃ",3888,730],["Παῦλε",10586,250],["τὰ",1,253],["πολλά",74,74],["σε",5,161],["γράμματα",1668,63],["εἰς",8,1],["μανίαν",3585,10],["περιτρέπει",7961,87]],"As he thus made his defense, Festus said with a loud voice, “Paul, you are crazy! Your great learning is driving you insane!”"],["25",[["ὁ",1,4],["δὲ",14,8],["Παῦλος",10586,5],["οὐ",12,12],["μαίνομαί",3888,768],["φησιν",660,87],["κράτιστε",3074,309],["Φῆστε",10740,250],["ἀλλ᾽",108,8],["ἀληθείας",352,19],["καὶ",2,8],["σωφροσύνης",2964,19],["ῥήματα",116,43],["ἀποφθέγγομαι",4041,768]],"But he said, “I am not crazy, most excellent Festus, but boldly declare words of truth and reasonableness."],["26",[["ἐπίσταται",1087,728],["γὰρ",40,8],["περὶ",72,1],["τούτων",16,214],["ὁ",1,4],["βασιλεύς",22,5],["πρὸς",15,1],["ὃν",24,106],["καὶ",2,8],["παρρησιαζόμενος",3917,723],["λαλῶ",50,149],["λανθάνειν",1768,54],["γὰρ",40,8],["αὐτόν",3,82],["τι",39,119],["τούτων",16,214],["οὐ",12,12],["πείθομαι",344,572],["οὐθέν",228,29],["οὐ",12,12],["γάρ",40,8],["ἐστιν",10,87],["ἐν",4,1],["γωνίᾳ",1377,2],["πεπραγμένον",1251,773],["τοῦτο",16,344]],"For the king knows of these things, to whom also I speak freely. For I am persuaded that none of these things is hidden from him, for this has not been done in a corner."],["27",[["πιστεύεις",649,145],["βασιλεῦ",22,250],["Ἀγρίππα",10743,250],["τοῖς",1,138],["προφήταις",176,139],["οἶδα",1168,85],["ὅτι",19,8],["πιστεύεις",649,145]],"King Agrippa, do you believe the prophets? I know that you believe.”"],["28",[["Ὁ",1,4],["δὲ",14,8],["Ἀγρίππας",10743,5],["πρὸς",15,1],["τὸν",1,6],["Παῦλον",10586,7],["ἐν",4,1],["ὀλίγῳ",555,34],["με",9994,161],["πείθεις",344,145],["Χριστιανὸν",10568,7],["ποιῆσαι",23,100]],"Agrippa said to Paul, “With a little persuasion are you trying to make me a Christian?”"],["29",[["ὁ",1,4],["δὲ",14,8],["Παῦλος",10586,5],["εὐξαίμην",670,908],["ἂν",83,12],["τῷ",1,110],["θεῷ",20,113],["καὶ",2,8],["ἐν",4,1],["ὀλίγῳ",555,34],["καὶ",2,8],["ἐν",4,1],["μεγάλῳ",66,34],["οὐ",12,12],["μόνον",302,59],["σὲ",5,161],["ἀλλὰ",108,8],["καὶ",2,8],["πάντας",11,58],["τοὺς",1,56],["ἀκούοντάς",54,229],["μου",9994,146],["σήμερον",205,17],["γενέσθαι",30,776],["τοιούτους",630,274],["ὁποῖος",9837,150],["καὶ",2,8],["ἐγώ",6,156],["εἰμι",10,149],["παρεκτὸς",10037,1],["τῶν",1,76],["δεσμῶν",1035,77],["τούτων",16,220]],"Paul said, “I pray to God, that whether with little or with much, not only you, but also all that hear me today, might become such as I am, except for these bonds.”"],["30",[["ἀνέστη",121,3],["τε",209,8],["ὁ",1,4],["βασιλεὺς",22,5],["καὶ",2,8],["ὁ",1,4],["ἡγεμὼν",638,5],["ἥ",1,11],["τε",209,8],["Βερνίκη",10744,13],["καὶ",2,8],["οἱ",1,128],["συγκαθήμενοι",8347,741],["αὐτοῖς",3,142]],"The king rose up with the governor and Bernice, and those who sat with them."],["31",[["καὶ",2,8],["ἀναχωρήσαντες",2516,190],["ἐλάλουν",50,129],["πρὸς",15,1],["ἀλλήλους",1192,60],["λέγοντες",31,137],["ὅτι",19,8],["οὐδὲν",228,29],["θανάτου",170,21],["ἢ",61,8],["δεσμῶν",1035,77],["ἄξιόν",1102,29],["τι",39,119],["πράσσει",1251,87],["ὁ",1,4],["ἄνθρωπος",43,5],["οὗτος",16,112]],"When they had withdrawn, they spoke to one another, saying, “This man does nothing worthy of death or of bonds.”"],["32",[["Ἀγρίππας",10743,5],["δὲ",14,8],["τῷ",1,110],["Φήστῳ",10740,113],["ἔφη",660,14],["ἀπολελύσθαι",1395,825],["ἐδύνατο",185,721],["ὁ",1,4],["ἄνθρωπος",43,5],["οὗτος",16,112],["εἰ",77,8],["μὴ",25,12],["ἐπεκέκλητο",341,909],["Καίσαρα",10166,7]],"Agrippa said to Festus, “This man might have been set free if he had not appealed to Caesar.”"]]