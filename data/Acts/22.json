7],["καὶ",2,8],["δέρων",10162,67],["κατὰ",32,1],["τὰς",1,39],["συναγωγὰς",284,40],["τοὺς",1,56],["πιστεύοντας",649,229],["ἐπὶ",9,1],["σέ",5,161]],"I said, ‘Lord, they themselves know that I imprisoned and beat in every synagogue those who believed in you."],["20",[["καὶ",2,8],["ὅτε",432,8],["ἐξεχύννετο",436,833],["τὸ",1,27],["αἷμα",148,20],["Στεφάνου",10526,21],["τοῦ",1,30],["μάρτυρός",875,21],["σου",5,146],["καὶ",2,8],["αὐτὸς",3,158],["ἤμην",10,429],["ἐφεστὼς",631,264],["καὶ",2,8],["συνευδοκῶν",5076,67],["καὶ",2,8],["φυλάσσων",125,67],["τὰ",1,42],["ἱμάτια",276,43],["τῶν",1,76],["ἀναιρούντων",651,164],["αὐτόν",3,82]],"When the blood of Stephen, your witness, was shed, I also was standing by, consenting to his death, and guarding the cloaks of those who killed him.’"],["21",[["καὶ",2,8],["εἶπεν",9997,3],["πρός",15,1],["με",9994,161],["πορεύου",49,726],["ὅτι",19,8],["ἐγὼ",6,156],["εἰς",8,1],["ἔθνη",60,43],["μακρὰν",10068,17],["ἐξαποστελῶ",220,157],["σε",5,161]],"“He said to me, ‘Depart, for I will send you out far from here to the Gentiles.’ ”"],["22",[["Ἤκουον",54,129],["δὲ",14,8],["αὐτοῦ",3,48],["ἄχρι",4062,1],["τούτου",16,126],["τοῦ",1,30],["λόγου",48,21],["καὶ",2,8],["ἐπῆραν",661,141],["τὴν",1,9],["φωνὴν",95,10],["αὐτῶν",3,41],["λέγοντες",31,137],["αἶρε",206,239],["ἀπὸ",17,1],["τῆς",1,18],["γῆς",26,19],["τὸν",1,6],["τοιοῦτον",630,259],["οὐ",12,12],["γὰρ",40,8],["καθῆκεν",1436,14],["αὐτὸν",3,82],["ζῆν",107,54]],"They listened to him until he said that; then they lifted up their voice and said, “Rid the earth of this fellow, for he isn’t fit to live!”"],["23",[["κραυγαζόντων",7505,164],["τε",209,8],["αὐτῶν",3,41],["καὶ",2,8],["ῥιπτούντων",615,164],["τὰ",1,42],["ἱμάτια",276,43],["καὶ",2,8],["κονιορτὸν",1894,7],["βαλλόντων",766,164],["εἰς",8,1],["τὸν",1,6],["ἀέρα",2664,7]],"As they cried out, threw off their cloaks, and threw dust into the air,"],["24",[["ἐκέλευσεν",1512,3],["ὁ",1,4],["χιλίαρχος",1452,5],["εἰσάγεσθαι",389,634],["αὐτὸν",3,82],["εἰς",8,1],["τὴν",1,9],["παρεμβολὴν",190,10],["εἴπας",9997,155],["μάστιξιν",1308,71],["ἀνετάζεσθαι",8892,634],["αὐτόν",3,82],["ἵνα",102,8],["ἐπιγνῷ",431,160],["δι᾽",56,1],["ἣν",24,124],["αἰτίαν",1954,10],["οὕτως",9989,17],["ἐπεφώνουν",5336,129],["αὐτῷ",3,49]],"the commanding officer commanded him to be brought into the barracks, ordering him to be examined by scourging, that he might know for what crime they shouted against him like that."],["25",[["Ὡς",36,12],["δὲ",14,8],["προέτειναν",3121,141],["αὐτὸν",3,82],["τοῖς",1,138],["ἱμᾶσιν",4121,139],["εἶπεν",9997,3],["πρὸς",15,1],["τὸν",1,6],["ἑστῶτα",78,434],["ἑκατόνταρχον",1710,7],["ὁ",1,4],["Παῦλος",10586,5],["εἰ",77,8],["ἄνθρωπον",43,7],["Ῥωμαῖον",2559,7],["καὶ",2,8],["ἀκατάκριτον",10633,59],["ἔξεστιν",10101,87],["ὑμῖν",5,86],["μαστίζειν",4897,54]],"When they had tied him up with straps, Paul asked the centurion who stood by, “Is it lawful for you to scourge a man who is a Roman, and not found guilty?”"],["26",[["ἀκούσας",54,155],["δὲ",14,8],["ὁ",1,4],["ἑκατοντάρχης",1710,5],["προσελθὼν",529,155],["τῷ",1,110],["χιλιάρχῳ",1452,113],["ἀπήγγειλεν",273,3],["λέγων",31,67],["τί",10010,119],["μέλλεις",1143,145],["ποιεῖν",23,54],["ὁ",1,4],["γὰρ",40,8],["ἄνθρωπος",43,5],["οὗτος",16,112],["Ῥωμαῖός",2559,5],["ἐστιν",10,87]],"When the centurion heard it, he went to the commanding officer and told him, “Watch what you are about to do, for this man is a Roman!”"],["27",[["προσελθὼν",529,155],["δὲ",14,8],["ὁ",1,4],["χιλίαρχος",1452,5],["εἶπεν",9997,3],["αὐτῷ",3,49],["λέγε",31,239],["μοι",9994,151],["σὺ",5,156],["Ῥωμαῖος",2559,5],["εἶ",10,145],["ὁ",1,4],["δὲ",14,8],["ἔφη",660,14],["ναί",3597,12]],"The commanding officer came and asked him, “Tell me, are you a Roman?” He said, “Yes.”"],["28",[["ἀπεκρίθη",234,737],["δὲ",14,8],["ὁ",1,4],["χιλίαρχος",1452,5],["ἐγὼ",6,156],["πολλοῦ",74,88],["κεφαλαίου",3861,24],["τὴν",1,9],["πολιτείαν",3116,10],["ταύτην",16,234],["ἐκτησάμην",564,820],["ὁ",1,4],["δὲ",14,8],["Παῦλος",10586,5],["ἔφη",660,14],["ἐγὼ",6,156],["δὲ",14,8],["καὶ",2,8],["γεγέννημαι",222,880]],"The commanding officer answered, “I bought my citizenship for a great price.” Paul said, “But I was born a Roman.”"],["29",[["εὐθέως",1673,17],["οὖν",227,8],["ἀπέστησαν",293,141],["ἀπ᾽",17,1],["αὐτοῦ",3,48],["οἱ",1,128],["μέλλοντες",1143,137],["αὐτὸν",3,82],["ἀνετάζειν",8892,54],["καὶ",2,8],["ὁ",1,4],["χιλίαρχος",1452,5],["δὲ",14,8],["ἐφοβήθη",134,715],["ἐπιγνοὺς",431,155],["ὅτι",19,8],["Ῥωμαῖός",2559,5],["ἐστιν",10,87],["καὶ",2,8],["ὅτι",19,8],["αὐτὸν",3,82],["ἦν",10,14],["δεδεκώς",440,264]],"Immediately those who were about to examine him departed from him, and the commanding officer also was afraid when he realized that he was a Roman, because he had bound him."],["30",[["Τῇ",1,95],["δὲ",14,8],["ἐπαύριον",1705,17],["βουλόμενος",463,723],["γνῶναι",79,100],["τὸ",1,32],["ἀσφαλές",3715,29],["τὸ",1,32],["τί",10010,119],["κατηγορεῖται",3858,449],["ὑπὸ",122,1],["τῶν",1,76],["Ἰουδαίων",285,77],["ἔλυσεν",1381,3],["αὐτὸν",3,82],["καὶ",2,8],["ἐκέλευσεν",1512,3],["συνελθεῖν",1837,100],["τοὺς",1,56],["ἀρχιερεῖς",1100,31],["καὶ",2,8],["πᾶν",11,29],["τὸ",1,32],["συνέδριον",2498,33],["καὶ",2,8],["καταγαγὼν",735,155],["τὸν",1,6],["Παῦλον",10586,7],["ἔστησεν",78,3],["εἰς",8,1],["αὐτούς",3,60]],"But on the next day, desiring to know the truth about why he was accused by the Jews, he freed him from the bonds and commanded the chief priests and all the council to come together, and brought Paul down and set him before them."]]