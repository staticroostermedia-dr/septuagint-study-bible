[["1",[["Ἄνδρες",38,396],["ἀδελφοὶ",67,396],["καὶ",2,8],["πατέρες",44,396],["ἀκούσατέ",54,69],["μου",9994,146],["τῆς",1,18],["πρὸς",15,1],["ὑμᾶς",5,209],["νυνὶ",2099,17],["ἀπολογίας",9017,19]],"“Brothers and fathers, listen to the defense which I now make to you.”"],["2",[["ἀκούσαντες",54,190],["δὲ",14,8],["ὅτι",19,8],["τῇ",1,95],["Ἑβραΐδι",10726,96],["διαλέκτῳ",7070,2],["προσεφώνει",4370,14],["αὐτοῖς",3,142],["μᾶλλον",1043,17],["παρέσχον",2279,141],["ἡσυχίαν",2546,10],["Καὶ",2,8],["φησίν",660,87]],"When they heard that he spoke to them in the Hebrew language, they were even more quiet. He said,"],["3",[["ἐγώ",6,156],["εἰμι",10,149],["ἀνὴρ",38,5],["Ἰουδαῖος",285,16],["γεγεννημένος",222,228],["ἐν",4,1],["Ταρσῷ",6796,2],["τῆς",1,18],["Κιλικίας",3782,19],["ἀνατεθραμμένος",4505,228],["δὲ",14,8],["ἐν",4,1],["τῇ",1,95],["πόλει",41,2],["ταύτῃ",16,200],["παρὰ",73,1],["τοὺς",1,56],["πόδας",210,31],["Γαμαλιὴλ",3485,21],["πεπαιδευμένος",643,228],["κατὰ",32,1],["ἀκρίβειαν",4012,10],["τοῦ",1,30],["πατρῴου",2935,153],["νόμου",140,21],["ζηλωτὴς",3057,5],["ὑπάρχων",418,67],["τοῦ",1,30],["θεοῦ",20,21],["καθὼς",221,8],["πάντες",11,130],["ὑμεῖς",5,208],["ἐστε",10,84],["σήμερον",205,17]],"“I am indeed a Jew, born in Tarsus of Cilicia, but brought up in this city at the feet of Gamaliel, instructed according to the strict tradition of the law of our fathers, being zealous for God, even as you all are today."],["4",[["ὃς",24,246],["ταύτην",16,234],["τὴν",1,9],["ὁδὸν",68,10],["ἐδίωξα",533,147],["ἄχρι",4062,1],["θανάτου",170,21],["δεσμεύων",2702,67],["καὶ",2,8],["παραδιδοὺς",254,67],["εἰς",8,1],["φυλακὰς",485,40],["ἄνδρας",38,31],["τε",209,8],["καὶ",2,8],["γυναῖκας",59,40]],"I persecuted this Way to the death, binding and delivering into prisons both men and women,"],["5",[["ὡς",36,12],["καὶ",2,8],["ὁ",1,4],["ἀρχιερεὺς",1100,5],["μαρτυρεῖ",2094,87],["μοι",9994,151],["καὶ",2,8],["πᾶν",11,28],["τὸ",1,27],["πρεσβυτέριον",10431,20],["παρ᾽",73,1],["ὧν",24,303],["καὶ",2,8],["ἐπιστολὰς",866,40],["δεξάμενος",815,770],["πρὸς",15,1],["τοὺς",1,56],["ἀδελφοὺς",67,31],["εἰς",8,1],["Δαμασκὸν",1012,10],["ἐπορευόμην",49,816],["ἄξων",224,357],["καὶ",2,8],["τοὺς",1,56],["ἐκεῖσε",9287,17],["ὄντας",10,229],["δεδεμένους",440,803],["εἰς",8,1],["Ἰερουσαλὴμ",823,10],["ἵνα",102,8],["τιμωρηθῶσιν",2790,266]],"as also the high priest and all the council of the elders testify, from whom also I received letters to the brothers, and traveled to Damascus to bring them also who were there to Jerusalem in bonds to be punished."],["6",[["ἐγένετο",30,737],["δέ",14,8],["μοι",9994,151],["πορευομένῳ",49,808],["καὶ",2,8],["ἐγγίζοντι",455,390],["τῇ",1,95],["Δαμασκῷ",1012,2],["περὶ",72,1],["μεσημβρίαν",1633,10],["ἐξαίφνης",2831,17],["ἐκ",21,1],["τοῦ",1,30],["οὐρανοῦ",94,21],["περιαστράψαι",7930,100],["φῶς",380,33],["ἱκανὸν",1007,29],["περὶ",72,1],["ἐμέ",6,161]],"“As I made my journey and came close to Damascus, about noon suddenly a great light shone around me from the sky."],["7",[["ἔπεσά",154,147],["τε",209,8],["εἰς",8,1],["τὸ",1,32],["ἔδαφος",1711,33],["καὶ",2,8],["ἤκουσα",54,147],["φωνῆς",95,19],["λεγούσης",31,212],["μοι",9994,151],["Σαοὺλ",155,250],["Σαούλ",155,250],["τί",10010,119],["με",9994,161],["διώκεις",533,145]],"I fell to the ground and heard a voice saying to me, ‘Saul, Saul, why are you persecuting me?’"],["8",[["ἐγὼ",6,156],["δὲ",14,8],["ἀπεκρίθην",234,820],["τίς",10010,150],["εἶ",10,145],["κύριε",7,250],["εἶπέν",9997,3],["τε",209,8],["πρός",15,1],["με",9994,161],["ἐγώ",6,156],["εἰμι",10,149],["Ἰησοῦς",211,5],["ὁ",1,4],["Ναζωραῖος",10004,5],["ὃν",24,106],["σὺ",5,156],["διώκεις",533,145]],"I answered, ‘Who are you, Lord?’ He said to me, ‘I am Jesus of Nazareth, whom you persecute.’"],["9",[["οἱ",1,128],["δὲ",14,8],["σὺν",310,1],["ἐμοὶ",6,151],["ὄντες",10,137],["τὸ",1,32],["μὲν",281,12],["φῶς",380,33],["ἐθεάσαντο",3062,720],["τὴν",1,9],["δὲ",14,8],["φωνὴν",95,10],["οὐκ",12,12],["ἤκουσαν",54,141],["τοῦ",1,30],["λαλοῦντός",50,143],["μοι",9994,151]],"“Those who were with me indeed saw the light and were afraid, but they didn’t understand the voice of him who spoke to me."],["10",[["εἶπον",9997,147],["δέ",14,8],["τί",10010,119],["ποιήσω",23,227],["κύριε",7,250],["ὁ",1,4],["δὲ",14,8],["κύριος",7,5],["εἶπεν",9997,3],["πρός",15,1],["με",9994,161],["ἀναστὰς",121,155],["πορεύου",49,726],["εἰς",8,1],["Δαμασκόν",1012,10],["κἀκεῖ",10035,17],["σοι",5,151],["λαληθήσεται",50,125],["περὶ",72,1],["πάντων",11,79],["ὧν",24,97],["τέτακταί",721,722],["σοι",5,151],["ποιῆσαι",23,100]],"I said, ‘What shall I do, Lord?’ The Lord said to me, ‘Arise, and go into Damascus. There you will be told about all things which are appointed for you to do.’"],["11",[["ὡς",36,12],["δὲ",14,8],["οὐκ",12,12],["ἐνέβλεπον",1862,293],["ἀπὸ",17,1],["τῆς",1,18],["δόξης",141,19],["τοῦ",1,23],["φωτὸς",380,24],["ἐκείνου",80,298],["χειραγωγούμενος",10549,714],["ὑπὸ",122,1],["τῶν",1,76],["συνόντων",2291,164],["μοι",9994,151],["ἦλθον",55,147],["εἰς",8,1],["Δαμασκόν",1012,10]],"When I couldn’t see for the glory of that light, being led by the hand of those who were with me, I came into Damascus."],["12",[["Ἁνανίας",1234,5],["δέ",14,8],["τις",39,150],["ἀνὴρ",38,5],["εὐλαβὴς",5617,16],["κατὰ",32,1],["τὸν",1,6],["νόμον",140,7],["μαρτυρούμενος",2094,714],["ὑπὸ",122,1],["πάντων",11,163],["τῶν",1,76],["κατοικούντων",89,164],["Ἰουδαίων",285,77]],"“One Ananias, a devout man according to the law, well reported of by all the Jews who lived in Damascus,"],["13",[["ἐλθὼν",55,155],["πρός",15,1],["με",9994,161],["καὶ",2,8],["ἐπιστὰς",631,155],["εἶπέν",9997,3],["μοι",9994,151],["Σαοὺλ",155,250],["ἀδελφέ",67,250],["ἀνάβλεψον",1425,198],["κἀγὼ",10000,8],["αὐτῇ",3,99],["τῇ",1,95],["ὥρᾳ",838,2],["ἀνέβλεψα",1425,147],["εἰς",8,1],["αὐτόν",3,82]],"came to me, and standing by me said to me, ‘Brother Saul, receive your sight!’ In that very hour I looked up at him."],["14",[["ὁ",1,4],["δὲ",14,8],["εἶπεν",9997,3],["ὁ",1,4],["θεὸς",20,5],["τῶν",1,76],["πατέρων",44,77],["ἡμῶν",9994,136],["προεχειρίσατό",4372,737],