,["τῷ",1,110],["κυρίῳ",7,113],["μετὰ",29,1],["πάσης",11,78],["ταπεινοφροσύνης",10715,19],["καὶ",2,8],["δακρύων",1268,45],["καὶ",2,8],["πειρασμῶν",2281,77],["τῶν",1,76],["συμβάντων",981,211],["μοι",9994,151],["ἐν",4,1],["ταῖς",1,70],["ἐπιβουλαῖς",3441,71],["τῶν",1,76],["Ἰουδαίων",285,77]],"serving the Lord with all humility, with many tears, and with trials which happened to me by the plots of the Jews;"],["20",[["ὡς",36,12],["οὐδὲν",228,29],["ὑπεστειλάμην",3772,152],["τῶν",1,44],["συμφερόντων",2495,80],["τοῦ",1,23],["μὴ",25,12],["ἀναγγεῖλαι",231,100],["ὑμῖν",5,86],["καὶ",2,8],["διδάξαι",545,100],["ὑμᾶς",5,209],["δημοσίᾳ",4740,96],["καὶ",2,8],["κατ᾽",32,1],["οἴκους",34,31]],"how I didn’t shrink from declaring to you anything that was profitable, teaching you publicly and from house to house,"],["21",[["διαμαρτυρόμενος",1585,723],["Ἰουδαίοις",285,139],["τε",209,8],["καὶ",2,8],["Ἕλλησιν",2545,139],["τὴν",1,9],["εἰς",8,1],["θεὸν",20,7],["μετάνοιαν",3084,10],["καὶ",2,8],["πίστιν",887,10],["εἰς",8,1],["τὸν",1,6],["κύριον",7,7],["ἡμῶν",9994,136],["Ἰησοῦν",211,7],["Χριστόν",1072,7]],"testifying both to Jews and to Greeks repentance toward God and faith toward our Lord Jesus."],["22",[["Καὶ",2,8],["νῦν",90,17],["ἰδοὺ",51,316],["δεδεμένος",440,228],["ἐγὼ",6,156],["τῷ",1,52],["πνεύματι",168,53],["πορεύομαι",49,768],["εἰς",8,1],["Ἰερουσαλὴμ",823,10],["τὰ",1,42],["ἐν",4,1],["αὐτῇ",3,99],["συναντήσοντά",429,902],["μοι",9994,151],["μὴ",25,12],["εἰδώς",1168,264]],"Now, behold, I go bound by the Spirit to Jerusalem, not knowing what will happen to me there;"],["23",[["πλὴν",257,8],["ὅτι",19,8],["τὸ",1,27],["πνεῦμα",168,20],["τὸ",1,27],["ἅγιον",75,28],["κατὰ",32,1],["πόλιν",41,10],["διαμαρτύρεταί",1585,728],["μοι",9994,151],["λέγον",31,36],["ὅτι",19,8],["δεσμὰ",1035,63],["καὶ",2,8],["θλίψεις",438,180],["με",9994,161],["μένουσιν",681,191]],"except that the Holy Spirit testifies in every city, saying that bonds and afflictions wait for me."],["24",[["ἀλλ᾽",108,8],["οὐδενὸς",228,153],["