[["1",[["Ἐγένετο",30,737],["δὲ",14,8],["ἐν",4,1],["τῷ",1,52],["τὸν",1,6],["Ἀπολλῶ",10673,7],["εἶναι",10135,54],["ἐν",4,1],["Κορίνθῳ",10657,2],["Παῦλον",10586,7],["διελθόντα",423,476],["τὰ",1,42],["ἀνωτερικὰ",10677,65],["μέρη",471,43],["κατελθεῖν",4269,100],["εἰς",8,1],["Ἔφεσον",10672,10],["καὶ",2,8],["εὑρεῖν",101,100],["τινας",39,318],["μαθητάς",10025,31]],"While Apollos was at Corinth, Paul, having passed through the upper country, came to Ephesus and found certain disciples."],["2",[["εἶπέν",9997,3],["τε",209,8],["πρὸς",15,1],["αὐτούς",3,60],["εἰ",77,8],["πνεῦμα",168,33],["ἅγιον",75,29],["ἐλάβετε",46,262],["πιστεύσαντες",649,190],["οἱ",1,128],["δὲ",14,8],["πρὸς",15,1],["αὐτόν",3,82],["ἀλλ᾽",108,8],["οὐδ᾽",106,8],["εἰ",77,8],["πνεῦμα",168,20],["ἅγιον",75,28],["ἔστιν",10,87],["ἠκούσαμεν",54,285]],"He said to them, “Did you receive the Holy Spirit when you believed?” They said to him, “No, we haven’t even heard that there is a Holy Spirit.”"],["3",[["εἶπέν",9997,3],["τε",209,8],["εἰς",8,1],["τί",10010,119],["οὖν",227,8],["ἐβαπτίσθητε",4169,353],["οἱ",1,128],["δὲ",14,8],["εἶπαν",9997,141],["εἰς",8,1],["τὸ",1,32],["Ἰωάννου",2148,21],["βάπτισμα",10008,33]],"He said, “Into what then were you baptized?” They said, “Into John’s baptism.”"],["4",[["Εἶπεν",9997,3],["δὲ",14,8],["Παῦλος",10586,5],["Ἰωάννης",2148,5],["ἐβάπτισεν",4169,3],["βάπτισμα",10008,33],["μετανοίας",3084,19],["τῷ",1,110],["λαῷ",35,113],["λέγων",31,67],["εἰς",8,1],["τὸν",1,6],["ἐρχόμενον",55,765],["μετ᾽",29,1],["αὐτὸν",3,82],["ἵνα",102,8],["πιστεύσωσιν",649,224],["τοῦτ᾽",16,344],["ἔστιν",10,87],["εἰς",8,1],["τὸν",1,6],["Ἰησοῦν",211,7]],"Paul said, “John indeed baptized with the baptism of repentance, saying to the people that they should believe in the one who would come after him, that is, in Christ Jesus.”"],["5",[["ἀκούσαντες",54,190],["δὲ",14,8],["ἐβαπτίσθησαν",4169,94],["εἰς",8,1],["τὸ",1,32],["ὄνομα",57,33],["τοῦ",1,30],["κυρίου",7,21],["Ἰησοῦ",211,21]],"When they heard this, they were baptized in the name of the Lord Jesus."],["6",[["καὶ",2,8],["ἐπιθέντος",239,513],["αὐτοῖς",3,142],["τοῦ",1,30],["Παύλου",10586,21],["τὰς",1,39],["χεῖρας",37,40],["ἦλθεν",55,3],["τὸ",1,27],["πνεῦμα",168,20],["τὸ",1,27],["ἅγιον",75,28],["ἐπ᾽",9,1],["αὐτούς",3,60],["ἐλάλουν",50,129],["τε",209,8],["γλώσσαις",388,71],["καὶ",2,8],["ἐπροφήτευον",484,129]],"When Paul had laid his hands on them, the Holy Spirit came on them and they spoke with other languages and prophesied."],["7",[["ἦσαν",10,129],["δὲ",14,8],["οἱ",1,128],["πάντες",11,130],["ἄνδρες",38,51],["ὡσεὶ",343,1],["δώδεκα",556,372]],"They were about twelve men in all."],["8",[["Εἰσελθὼν",86,155],["δὲ",14,8],["εἰς",8,1],["τὴν",1,9],["συναγωγὴν",284,10],["ἐπαρρησιάζετο",3917,721],["ἐπὶ",9,1],["μῆνας",10294,31],["τρεῖς",174,58],["διαλεγόμενος",3259,723],["καὶ",2,8],["πείθων",344,67],["τὰ",1,42],["περὶ",72,1],["τῆς",1,18],["βασιλείας",157,19],["τοῦ",1,30],["θεοῦ",20,21]],"He entered into the synagogue and spoke boldly for a period of three months, reasoning and persuading about the things concerning God’s Kingdom."],["9",[["ὡς",36,12],["δέ",14,8],["τινες",39,402],["ἐσκληρύνοντο",1284,575],["καὶ",2,8],["ἠπείθουν",993,129],["κακολογοῦντες",3543,137],["τὴν",1,9],["ὁδὸν",68,10],["ἐνώπιον",115,1],["τοῦ",1,23],["πλήθους",200,24],["ἀποστὰς",293,155],["ἀπ᾽",17,1],["αὐτῶν",3,41],["ἀφώρισεν",636,3],["τοὺς",1,56],["μαθητὰς",10025,31],["καθ᾽",32,1],["ἡμέραν",28,10],["διαλεγόμενος",3259,723],["ἐν",4,1],["τῇ",1,95],["σχολῇ",5091,2],["Τυράννου",784,21]],"But when some were hardened and disobedient, speaking evil of the Way before the multitude, he departed from them and separated the disciples, reasoning daily in the school of Tyrannus."],["10",[["τοῦτο",16,344],["δὲ",14,8],["ἐγένετο",30,737],["ἐπὶ",9,1],["ἔτη",81,43],["δύο",104,372],["ὥστε",346,8],["πάντας",11,58],["τοὺς",1,56],["κατοικοῦντας",89,229],["τὴν",1,9],["Ἀσίαν",3180,10],["ἀκοῦσαι",54,100],["τὸν",1,6],["λόγον",48,7],["τοῦ",1,30],["κυρίου",7,21],["Ἰουδαίους",285,31],["τε",209,8],["καὶ",2,8],["Ἕλληνας",2545,31]],"This continued for two years, so that all those who lived in Asia heard the word of the Lord Jesus, both Jews and Greeks."],["11",[["δυνάμεις",98,40],["τε",209,8],["οὐ",12,12],["τὰς",1,39],["τυχούσας",1451,900],["ὁ",1,4],["θεὸς",20,5],["ἐποίει",23,14],["διὰ",56,1],["τῶν",1,123],["χειρῶν",37,61],["Παύλου",10586,21]],"God worked special miracles by the hands of Paul,"],["12",[["ὥστε",346,8],["καὶ",2,8],["ἐπὶ",9,1],["τοὺς",1,56],["ἀσθενοῦντας",771,229],["ἀποφέρεσθαι",1396,634],["ἀπὸ",17,1],["τοῦ",1,30],["χρωτὸς",2205,21],["αὐτοῦ",3,48],["σουδάρια",10414,43],["ἢ",61,8],["σιμικίνθια",10678,43],["καὶ",2,8],["ἀπαλλάσσεσθαι",2659,634],["ἀπ᾽",17,1],["αὐτῶν",3,41],["τὰς",1,39],["νόσους",2927,40],["τά",1,42],["τε",209,8],["πνεύματα",168,43],["τὰ",1,42],["πονηρὰ",164,65],["ἐκπορεύεσθαι",365,749]],"so that even handkerchiefs or aprons were carried away from his body to the sick, and the diseases departed from them, and the evil spirits went out."],["13",[["Ἐπεχείρησαν",2541,141],["δέ",14,8],["τινες",39,402],["καὶ",2,8],["τῶν",1,76],["περιερχομένων",2479,762],["Ἰουδαίων",285,163],["ἐξορκιστῶν",10679,77],["ὀνομάζειν",1662,54],["ἐπὶ",9,1],["τοὺς",1,56],["ἔχοντας",124,229],["τὰ",1,42],["πνεύματα",168,43],["τὰ",1,42],["πονηρὰ",164,65],["τὸ",1,32],["ὄνομα",57,33],["τοῦ",1,30],["κυρίου",7,21],["Ἰησοῦ",211,21],["λέγοντες",31,137],["ὁρκίζω",1577,149],["ὑμᾶς",5,209],["τὸν",1,6],["Ἰησοῦν",211,7],["ὃν",24,106],["Παῦλος",10586,5],["κηρύσσει",1438,87]],"But some of the itinerant Jews, exorcists, took on themselves to invoke over those who had the evil spirits the name of the Lord Jesus, saying, “We adjure you by Jesus whom Paul preaches.”"],["14",[["ἦσαν",10,129],["δέ",14,8],["Σκευᾶ",10680,21],["Ἰουδαίου",285,153],["ἀρχιερέως",1100,21],["ἑπτὰ",180,372],["υἱοὶ",13,51],["τοῦτο",16,122],["ποιοῦντες",23,137]],"There were seven sons of one Sceva, a Jewish chief priest, who did this."],["15",[["ἀποκριθὲν",234,901],["δὲ",14,8],["τὸ",1,27],["πνεῦμα",168,20],["τὸ",1,27],["πο