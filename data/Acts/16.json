[["1",[["Κατήντησεν",3850,3],["δὲ",14,8],["καὶ",2,8],["εἰς",8,1],["Δέρβην",10599,10],["καὶ",2,8],["εἰς",8,1],["Λύστραν",10598,10],["καὶ",2,8],["ἰδοὺ",51,316],["μαθητής",10025,5],["τις",39,150],["ἦν",10,14],["ἐκεῖ",76,17],["ὀνόματι",57,53],["Τιμόθεος",1953,5],["υἱὸς",13,5],["γυναικὸς",59,19],["Ἰουδαίας",285,78],["πιστῆς",750,78],["πατρὸς",44,21],["δὲ",14,8],["Ἕλληνος",2545,21]],"He came to Derbe and Lystra; and behold, a certain disciple was there, named Timothy, the son of a Jewess who believed, but his father was a Greek."],["2",[["ὃς",24,246],["ἐμαρτυρεῖτο",2094,833],["ὑπὸ",122,1],["τῶν",1,76],["ἐν",4,1],["Λύστροις",10598,92],["καὶ",2,8],["Ἰκονίῳ",10596,53],["ἀδελφῶν",67,77]],"The brothers who were at Lystra and Iconium gave a good testimony about him."],["3",[["τοῦτον",16,259],["ἠθέλησεν",612,3],["ὁ",1,4],["Παῦλος",10586,5],["σὺν",310,1],["αὐτῷ",3,49],["ἐξελθεῖν",82,100],["καὶ",2,8],["λαβὼν",46,155],["περιέτεμεν",1222,3],["αὐτὸν",3,82],["διὰ",56,1],["τοὺς",1,56],["Ἰουδαίους",285,31],["τοὺς",1,56],["ὄντας",10,229],["ἐν",4,1],["τοῖς",1,138],["τόποις",99,139],["ἐκείνοις",80,193],["ᾔδεισαν",53,385],["γὰρ",40,8],["ἅπαντες",772,130],["ὅτι",19,8],["Ἕλλην",2545,5],["ὁ",1,4],["πατὴρ",44,5],["αὐτοῦ",3,48],["ὑπῆρχεν",418,14]],"Paul wanted to have him go out with him, and he took and circumcised him because of the Jews who were in those parts, for they all knew that his father was a Greek."],["4",[["ὡς",36,12],["δὲ",14,8],["διεπορεύοντο",1113,767],["τὰς",1,39],["πόλεις",41,40],["παρεδίδοσαν",254,129],["αὐτοῖς",3,142],["φυλάσσειν",125,54],["τὰ",1,42],["δόγματα",1958,43],["τὰ",1,42],["κεκριμένα",263,786],["ὑπὸ",122,1],["τῶν",1,76],["ἀποστόλων",10080,77],["καὶ",2,8],["πρεσβυτέρων",332,77],["τῶν",1,76],["ἐν",4,1],["Ἱεροσολύμοις",70,92]],"As they went on their way through the cities, they delivered the decrees to them to keep which had been ordained by the apostles and elders who were at Jerusalem."],["5",[["Αἱ",1,185],["μὲν",281,12],["οὖν",227,8],["ἐκκλησίαι",563,180],["ἐστερεοῦ