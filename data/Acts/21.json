[["1",[["Ὡς",36,12],["δὲ",14,8],["ἐγένετο",30,737],["ἀναχθῆναι",524,175],["ἡμᾶς",9994,209],["ἀποσπασθέντας",3174,469],["ἀπ᾽",17,1],["αὐτῶν",3,41],["εὐθυδρομήσαντες",10621,190],["ἤλθομεν",55,285],["εἰς",8,1],["τὴν",1,9],["Κῶ",5450,10],["τῇ",1,95],["δὲ",14,8],["ἑξῆς",4110,17],["εἰς",8,1],["τὴν",1,9],["Ῥόδον",10717,10],["κἀκεῖθεν",10255,17],["εἰς",8,1],["Πάταρα",10718,43]],"When we had departed from them and had set sail, we came with a straight course to Cos, and the next day to Rhodes, and from there to Patara."],["2",[["καὶ",2,8],["εὑρόντες",101,190],["πλοῖον",1169,33],["διαπερῶν",2880,47],["εἰς",8,1],["Φοινίκην",1541,10],["ἐπιβάντες",880,190],["ἀνήχθημεν",524,491]],"Having found a ship crossing over to Phoenicia, we went aboard and set sail."],["3",[["ἀναφάναντες",3691,190],["δὲ",14,8],["τὴν",1,9],["Κύπρον",4155,10],["καὶ",2,8],["καταλιπόντες",207,190],["αὐτὴν",3,98],["εὐώνυμον",1885,37],["ἐπλέομεν",2945,395],["εἰς",8,1],["Συρίαν",494,10],["καὶ",2,8],["κατήλθομεν",4269,285],["εἰς",8,1],["Τύρον",1199,10],["ἐκεῖσε",9287,17],["γὰρ",40,8],["τὸ",1,27],["πλοῖον",1169,20],["ἦν",10,14],["ἀποφορτιζόμενον",10719,789],["τὸν",1,6],["γόμον",5527,7]],"When we had come in sight of Cyprus, leaving it on the left hand, we sailed to Syria and landed at Tyre, for the ship was there to unload her cargo."],["4",[["Ἀνευρόντες",8893,190],["δὲ",14,8],["τοὺς",1,56],["μαθητὰς",10025,31],["ἐπεμείναμεν",9529,285],["αὐτοῦ",10189,17],["ἡμέρας",28,40],["ἑπτά",180,372],["οἵτινες",457,455],["τῷ",1,110],["Παύλῳ",10586,113],["ἔλεγον",31,129],["διὰ",56,1],["τοῦ",1,23],["πνεύματος",168,24],["μὴ",25,12],["ἐπιβαίνειν",880,54],["εἰς",8,1],["Ἱεροσόλυμα",70,43]],"Having found disciples, we stayed there seven days. These said to Paul through the Spirit that he should not go up to Jerusalem."],["5",[["ὅτε",432,8],["δὲ",14,8],["ἐγένετο",30,737],["ἡμᾶς",9994,209],["ἐξαρτίσαι",9436,100],["τὰς",1,39],["ἡμέρας",28,40],["ἐξελθόντες",82,190],["ἐπορευόμεθα",49,903],["προπεμπόντων",3931,164],["ἡμᾶς",9994,209],["πάντω