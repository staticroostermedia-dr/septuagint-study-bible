[["1",[["Μετὰ",29,1],["ταῦτα",16,248],["χωρισθεὶς",1647,206],["ἐκ",21,1],["τῶν",1,123],["Ἀθηνῶν",10643,61],["ἦλθεν",55,3],["εἰς",8,1],["Κόρινθον",10657,10]],"After these things Paul departed from Athens and came to Corinth."],["2",[["καὶ",2,8],["εὑρών",101,155],["τινα",39,365],["Ἰουδαῖον",285,7],["ὀνόματι",57,53],["Ἀκύλαν",10658,7],["Ποντικὸν",10659,59],["τῷ",1,52],["γένει",519,53],["προσφάτως",3934,17],["ἐληλυθότα",55,434],["ἀπὸ",17,1],["τῆς",1,18],["Ἰταλίας",10660,19],["καὶ",2,8],["Πρίσκιλλαν",10661,10],["γυναῖκα",59,10],["αὐτοῦ",3,48],["διὰ",56,1],["τὸ",1,32],["διατεταχέναι",1507,107],["Κλαύδιον",10570,7],["χωρίζεσθαι",1647,634],["πάντας",11,58],["τοὺς",1,56],["Ἰουδαίους",285,31],["ἀπὸ",17,1],["τῆς",1,18],["Ῥώμης",2240,19],["προσῆλθεν",529,3],["αὐτοῖς",3,142]],"He found a certain Jew named Aquila, a man of Pontus by race, who had recently come from Italy with his wife Priscilla, because Claudius had commanded all the Jews to depart from Rome. He came to them,"],["3",[["καὶ",2,8],["διὰ",56,1],["τὸ",1,32],["ὁμότεχνον",10662,59],["εἶναι",10135,54],["ἔμενεν",681,14],["παρ᾽",73,1],["αὐτοῖς",3,142],["καὶ",2,8],["ἠργάζετο",467,721],["ἦσαν",10,129],["γὰρ",40,8],["σκηνοποιοὶ",10663,51],["τῇ",1,95],["τέχνῃ",2971,2]],"and because he practiced the same trade, he lived with them and worked, for by trade they were tent makers."],["4",[["διελέγετο",3259,721],["δὲ",14,8],["ἐν",4,1],["τῇ",1,95],["συναγωγῇ",284,2],["κατὰ",32,1],["πᾶν",11,29],["σάββατον",442,33],["ἔπειθέν",344,14],["τε",209,8],["Ἰουδαίους",285,31],["καὶ",2,8],["Ἕλληνας",2545,31]],"He reasoned in the synagogue every Sabbath and persuaded Jews and Greeks."],["5",[["Ὡς",36,12],["δὲ",14,8],["κατῆλθον",4269,141],["ἀπὸ",17,1],["τῆς",1,18],["Μακεδονίας",10620,19],["ὅ",1,4],["τε",209,8],["Σιλᾶς",10612,5],["καὶ",2,8],["ὁ",1,4],["Τιμόθεος",1953,5],["συνείχετο",1227,833],["τῷ",1,110],["λόγῳ",48,113],["ὁ",1,4],["Παῦλος",10586,5],["διαμαρτυρόμενος",1585,723],["τοῖς",1,138],["Ἰουδαίοις",285,139],["εἶναι",10135,54],["τὸν",1,6],["χριστὸν",1072,7],["Ἰησοῦν",211,7]],"When Silas and Timothy came down from Macedonia, Paul was compelled by the Spirit, testifying to the Jews that Jesus was the Christ."],["6",[["Ἀντιτασσομένων",3163,599],["δὲ",14,8],["αὐτῶν",3,41],["καὶ",2,8],["βλασφημούντων",3250,164],["ἐκτιναξάμενος",1753,244],["τὰ",1,42],["ἱμάτια",276,43],["εἶπεν",31,3],["πρὸς",15,1],["αὐτούς",3,60],["τὸ",1,27],["αἷμα",148,20],["ὑμῶν",5,136],["ἐπὶ",9,1],["τὴν",1,9],["κεφαλὴν",144,10],["ὑμῶν",5,136],["καθαρὸς",379,16],["ἐγώ",6,156],["ἀπὸ",17,1],["τοῦ",1,30],["νῦν",90,17],["εἰς",8,1],["τὰ",1,42],["ἔθνη",60,43],["πορεύσομαι",49,775]],"When they opposed him and blasphemed, he shook out his clothing and said to them, “Your blood be on your own heads! I am clean. From now on, I will go to the Gentiles!”"],["7",[["Καὶ",2,8],["μεταβὰς",3892,155],["ἐκεῖθεν",430,17],["εἰσῆλθεν",86,3],["εἰς",8,1],["οἰκίαν",233,10],["τινὸς",39,805],["ὀνόματι",57,53],["Ἰούστου",10496,21],["σεβομένου",2117,766],["τὸν",1,6],["θεόν",20,7],["οὗ",24,367],["ἡ",1,11],["οἰκία",233,13],["ἦν",10,14],["συνομοροῦσα",10664,183],["τῇ",1,95],["συναγωγῇ",284,2]],"He departed there and went into the house of a certain man named Justus, one who worshiped God, whose house was next door to the synagogue."],["8",[["Κρίσπος",10665,5],["δὲ",14,8],["ὁ",1,4],["ἀρχισυνάγωγος",10231,5],["ἐπίστευσεν",649,3],["τῷ",1,110],["κυρίῳ",7,113],["σὺν",310,1],["ὅλῳ",235,111],["τῷ",1,110],["οἴκῳ",34,113],["αὐτοῦ",3,48],["καὶ",2,8],["πολλοὶ",74,130],["τῶν",1,76],["Κορινθίων",10666,77],["ἀκούοντες",54,137],["ἐπίστευον",649,129],["καὶ",2,8],["ἐβαπτίζοντο",4169,575]],"Crispus, the ruler of the synagogue, believed in the Lord with all his house. Many of the Corinthians, when they heard, believed and were baptized."],["9",[["Εἶπεν",31,3],["δὲ",14,8],["ὁ",1,4],["κύριος",7,5],["ἐν",4,1],["νυκτὶ",219,2],["δι᾽",56,1],["ὁράματος",1873,24],["τῷ",1,110],["Παύλῳ",10586,113],["μὴ",25,12],["φοβοῦ",134,726],["ἀλλὰ",108,8],["λάλει",50,239],["καὶ",2,8],["μὴ",25,12],["σιωπήσῃς",1283,170]],"The Lord said to Paul in the night by a vision, “Don’t be afraid, but speak and don’t be silent;"],["10",[["διότι",177,8],["ἐγώ",6,156],["εἰμι",10,149],["μετὰ",29,1],["σοῦ",5,146],["καὶ",2,8],["οὐδεὶς",228,16],["ἐπιθήσεταί",239,89],["σοι",5,151],["τοῦ",1,23],["κακῶσαί",757,100],["σε",5,161],["διότι",177,8],["λαός",35,5],["ἐστίν",10,87],["μοι",9994,151],["πολὺς",74,16],["ἐν",4,1],["τῇ",1,95],["πόλει",41,2],["ταύτῃ",16,200]],"for I am with you, and no one will attack you to harm you, for I have many people in this city.”"],["11",[["ἐκάθισεν",274,3],["δὲ",14,8],["ἐνιαυτὸν",400,7],["καὶ",2,8],["μῆνας",10294,31],["ἓξ",531,372],["διδάσκων",545,67],["ἐν",4,1],["αὐτοῖς",3,142],["τὸν",1,6],["λόγον",48,7],["τοῦ",1,30],["θεοῦ",20,21]],"He lived there a year and six months, teaching the word of God among them."],["12",[["Γαλλίωνος",10667,21],["δὲ",14,8],["ἀνθυπάτου",10584,21],["ὄντος",10,143],["τῆς",1,18],["Ἀχαΐας",9249,19],["κατεπέστησαν",10668,141],["ὁμοθυμαδὸν",1262,17],["οἱ",1,128],["Ἰουδαῖοι",285,51],["τῷ",1,110],["Παύλῳ",10586,113],["καὶ",2,8],["ἤγαγον",224,141],["αὐτὸν",3,82],["ἐπὶ",9,1],["τὸ",1,32],["βῆμα",2251,33]],"But when Gallio was proconsul of Achaia, the Jews with one accord rose up against Paul and brought him before the judgment seat,"],["13",[["λέγοντες",31,137],["ὅτι",19,8],["παρὰ",73,1],["τὸν",1,6],["νόμον",140,7],["ἀναπείθει",5184,87],["οὗτος",16,112],["τοὺς",1,56],["ἀνθρώπους",43,31],["σέβεσθαι",2117,749],["τὸν",1,6],["θεόν",20,7]],"saying, “This man persuades men to worship God contrary to the law.”"],["14",[["Μέλλοντος",1143,143],["δὲ",14,8],["τοῦ",1,30],["Παύλου",10586,21],["ἀνοίγειν",362,54],["τὸ",1,32],["στόμα",123,33],["εἶπεν",31,3],["ὁ",1,4],["Γαλλίων",10667,5],["πρὸς",15,1],["τοὺς",1,56],["Ἰουδαίους",285,31],["εἰ",77,8],["μὲν",281,12],["ἦν",10,14],["ἀδίκημά",1921,20],["τι",39,238],["ἢ",61,8],["ῥᾳδιούργημα",10669,20],["πονηρόν",164,28],["ὦ",646,316],["Ἰουδαῖοι",285,396],["κατὰ",32,1],["λόγον",48,7],["ἂν",83,12],["ἀνεσχόμην",2211,152],["ὑμῶν",5,136]],"But when Paul was about to open his mouth, Gallio said to the Jews, “If indeed it were a matter of wrong or of wicked crime, you Jews, it would be reasonable that I should bear with you;"],["15",[["εἰ",77,8],["δὲ",14,8],["ζητήματά",10607,63],["ἐστιν",10,87],["περὶ",72,1],["λόγου",48,21],["καὶ",2,8],["ὀνομάτων",57,45],["καὶ",2,8],["νόμου",140,21],["τοῦ",1,30],["καθ᾽",32,1],["ὑμᾶς",5,209],["ὄψεσθε",112,747],["αὐτοί",3,195],["κριτὴς",749,5],["ἐγὼ",6,156],["τούτων",16,214],["οὐ",12,12],["βούλομαι",463,768],["εἶναι",10135,54]],"but if they are questions about words and names and your own law, look to it yourselves. For I don’t want to be a judge of these matters.”"],["16",[["καὶ",2,8],["ἀπήλασεν",5211,3],["αὐτοὺς",3,60],["ἀπὸ",17,1],["τοῦ",1,23],["βήματος",2251,24]],"So he drove them from the judgment seat."],["17",[["Ἐπιλαβόμενοι",1086,840],["δὲ",14,8],["πάντες",11,130],["Σωσθένην",10670,7],["τὸν",1,6],["ἀρχισυνάγωγον",10231,7],["ἔτυπτον",1209,129],["ἔμπροσθεν",390,1],["τοῦ",1,23],["βήματος",2251,24],["καὶ",2,8],["οὐδὲν",228,28],["τούτων",16,214],["τῷ",1,110],["Γαλλίωνι",10667,113],["ἔμελεν",3594,14]],"Then all the Greeks seized Sosthenes, the ruler of the synagogue, and beat him before the judgment seat. Gallio didn’t care about any of these things."],["18",[["Ὁ",1,4],["δὲ",14,8],["Παῦλος",10586,5],["ἔτι",111,17],["προσμείνας",5995,155],["ἡμέρας",28,40],["ἱκανάς",1007,109],["τοῖς",1,138],["ἀδελφοῖς",67,139],["ἀποταξάμενος",4040,244],["ἐξέπλει",10615,14],["εἰς",8,1],["τὴν",1,9],["Συρίαν",494,10],["καὶ",2,8],["σὺν",310,1],["αὐτῷ",3,49],["Πρίσκιλλα",10661,13],["καὶ",2,8],["Ἀκύλας",10658,5],["κειράμενος",1730,244],["ἐν",4,1],["Κεγχρεαῖς",10671,71],["τὴν",1,9],["κεφαλήν",144,10],["εἶχεν",124,14],["γὰρ",40,8],["εὐχήν",633,10]],"Paul, having stayed after this many more days, took his leave of the brothers, and sailed from there for Syria, together with Priscilla and Aquila. He shaved his head in Cenchreae, for he had a vow."],["19",[["κατήντησαν",3850,141],["δὲ",14,8],["εἰς",8,1],["Ἔφεσον",10672,10],["κἀκείνους",10122,274],["κατέλιπεν",207,3],["αὐτοῦ",10189,17],["αὐτὸς",3,158],["δὲ",14,8],["εἰσελθὼν",86,155],["εἰς",8,1],["τὴν",1,9],["συναγωγὴν",284,10],["διελέξατο",3259,737],["τοῖς",1,138],["Ἰουδαίοις",285,139]],"He came to Ephesus, and he left them there; but he himself entered into the synagogue and reasoned with the Jews."],["20",[["ἐρωτώντων",822,164],["δὲ",14,8],["αὐτῶν",3,41],["ἐπὶ",9,1],["πλείονα",938,59],["χρόνον",486,7],["μεῖναι",681,100],["οὐκ",12,12],["ἐπένευσεν",4606,3]],"When they asked him to stay with them a longer time, he declined;"],["21",[["ἀλλ᾽",108,8],["ἀποταξάμενος",4040,244],["καὶ",2,8],["εἰπών",31,155],["πάλιν",655,17],["ἀνακάμψω",2307,157],["πρὸς",15,1],["ὑμᾶς",5,209],["τοῦ",1,30],["θεοῦ",20,21],["θέλοντος",612,143],["ἀνήχθη",524,38],["ἀπὸ",17,1],["τῆς",1,18],["Ἐφέσου",10672,19]],"but taking his leave of them, he said, “I must by all means keep this coming feast in Jerusalem, but I will return again to you if God wills.” Then he set sail from Ephesus."],["22",[["καὶ",2,8],["κατελθὼν",4269,155],["εἰς",8,1],["Καισάρειαν",10134,10],["ἀναβὰς",88,155],["καὶ",2,8],["ἀσπασάμενος",2987,770],["τὴν",1,9],["ἐκκλησίαν",563,10],["κατέβη",175,3],["εἰς",8,1],["Ἀντιόχειαν",2313,10]],"When he had landed at Caesarea, he went up and greeted the assembly, and went down to Antioch."],["23",[["καὶ",2,8],["ποιήσας",23,155],["χρόνον",486,7],["τινὰ",39,365],["ἐξῆλθεν",82,3],["διερχόμενος",423,723],["καθεξῆς",10289,17],["τὴν",1,9],["Γαλατικὴν",10616,37],["χώραν",278,10],["καὶ",2,8],["Φρυγίαν",10502,10],["ἐπιστηρίζων",2676,67],["πάντας",11,58],["τοὺς",1,56],["μαθητάς",10025,31]],"Having spent some time there, he departed and went through the region of Galatia and Phrygia, in order, establishing all the disciples."],["24",[["Ἰουδαῖος",285,5],["δέ",14,8],["τις",39,150],["Ἀπολλῶς",10673,5],["ὀνόματι",57,53],["Ἀλεξανδρεὺς",6397,5],["τῷ",1,52],["γένει",519,53],["ἀνὴρ",38,5],["λόγιος",10674,16],["κατήντησεν",3850,3],["εἰς",8,1],["Ἔφεσον",10672,10],["δυνατὸς",356,16],["ὢν",10,67],["ἐν",4,1],["ταῖς",1,70],["γραφαῖς",1505,71]],"Now a certain Jew named Apollos, an Alexandrian by race, an eloquent man, came to Ephesus. He was mighty in the Scriptures."],["25",[["οὗτος",16,112],["ἦν",10,14],["κατηχημένος",10291,228],["τὴν",1,9],["ὁδὸν",68,10],["τοῦ",1,30],["κυρίου",7,21],["καὶ",2,8],["ζέων",4794,67],["τῷ",1,52],["πνεύματι",168,53],["ἐλάλει",50,14],["καὶ",2,8],["ἐδίδασκεν",545,14],["ἀκριβῶς",5167,17],["τὰ",1,42],["περὶ",72,1],["τοῦ",1,30],["Ἰησοῦ",211,21],["ἐπιστάμενος",1087,723],["μόνον",302,29],["τὸ",1,32],["βάπτισμα",10008,33],["Ἰωάννου",2148,21]],"This man had been instructed in the way of the Lord; and being fervent in spirit, he spoke and taught accurately the things concerning Jesus, although he knew only the baptism of John."],["26",[["οὗτός",16,112],["τε",209,8],["ἤρξατο",320,737],["παρρησιάζεσθαι",3917,749],["ἐν",4,1],["τῇ",1,95],["συναγωγῇ",284,2],["ἀκούσαντες",54,190],["δὲ",14,8],["αὐτοῦ",3,48],["Πρίσκιλλα",10661,13],["καὶ",2,8],["Ἀκύλας",10658,5],["προσελάβοντο",3119,184],["αὐτὸν",3,82],["καὶ",2,8],["ἀκριβέστερον",10675,29],["αὐτῷ",3,49],["ἐξέθεντο",2316,184],["τὴν",1,9],["ὁδὸν",68,10],["τοῦ",1,30],["θεοῦ",20,21]],"He began to speak boldly in the synagogue. But when Priscilla and Aquila heard him, they took him aside, and explained to him the way of God more accurately."],["27",[["βουλομένου",463,766],["δὲ",14,8],["αὐτοῦ",3,48],["διελθεῖν",423,100],["εἰς",8,1],["τὴν",1,9],["Ἀχαΐαν",9249,10],["προτρεψάμενοι",3935,315],["οἱ",1,128],["ἀδελφοὶ",67,51],["ἔγραψαν",186,141],["τοῖς",1,138],["μαθηταῖς",10025,139],["ἀποδέξασθαι",3169,776],["αὐτόν",3,82],["ὃς",24,246],["παραγενόμενος",377,770],["συνεβάλετο",2961,26],["πολὺ",74,29],["τοῖς",1,138],["πεπιστευκόσιν",649,552],["διὰ",56,1],["τῆς",1,18],["χάριτος",368,19]],"When he had determined to pass over into Achaia, the brothers encouraged him; and wrote to the disciples to receive him. When he had come, he greatly helped those who had believed through grace;"],["28",[["εὐτόνως",7195,17],["γὰρ",40,8],["τοῖς",1,138],["Ἰουδαίοις",285,139],["διακατηλέγχετο",10676,721],["δημοσίᾳ",4740,96],["ἐπιδεικνὺς",2317,67],["διὰ",56,1],["τῶν",1,123],["γραφῶν",1505,61],["εἶναι",10135,54],["τὸν",1,6],["χριστὸν",1072,7],["Ἰησοῦν",211,7]],"for he powerfully refuted the Jews, publicly showing by the Scriptures that Jesus was the Christ."]]