[["1",[["Μετὰ",29,1],["δὲ",14,8],["πέντε",280,372],["ἡμέρας",28,40],["κατέβη",175,3],["ὁ",1,4],["ἀρχιερεὺς",1100,5],["Ἁνανίας",1234,5],["μετὰ",29,1],["πρεσβυτέρων",332,77],["τινῶν",39,796],["καὶ",2,8],["ῥήτορος",10733,21],["Τερτύλλου",10734,21],["τινός",39,805],["οἵτινες",457,455],["ἐνεφάνισαν",2828,141],["τῷ",1,110],["ἡγεμόνι",638,113],["κατὰ",32,1],["τοῦ",1,30],["Παύλου",10586,21]],"After five days, the high priest, Ananias, came down with certain elders and an orator, one Tertullus. They informed the governor against Paul."],["2",[["κληθέντος",128,317],["δὲ",14,8],["αὐτοῦ",3,48],["ἤρξατο",320,737],["κατηγορεῖν",3858,54],["ὁ",1,4],["Τέρτυλλος",10734,5],["λέγων",31,67],["πολλῆς",74,78],["εἰρήνης",213,19],["τυγχάνοντες",1451,137],["διὰ",56,1],["σοῦ",5,146],["καὶ",2,8],["διορθωμάτων",10735,45],["γινομένων",30,906],["τῷ",1,52],["ἔθνει",60,53],["τούτῳ",16,279],["διὰ",56,1],["τῆς",1,18],["σῆς",10053,78],["προνοίας",3123,19]],"When he was called, Tertullus began to accuse him, saying, “Seeing that by you we enjoy much peace, and that prosperity is coming to this nation by your foresight,"],["3",[["πάντῃ",6028,17],["τε",209,8],["καὶ",2,8],["πανταχοῦ",7839,17],["ἀποδεχόμεθα",3169,800],["κράτιστε",3074,309],["Φῆλιξ",10729,250],["μετὰ",29,1],["πάσης",11,78],["εὐχαριστίας",4230,19]],"we accept it in all ways and in all places, most excellent Felix, with all thankfulness."],["4",[["ἵνα",102,8],["δὲ",14,8],["μὴ",25,12],["ἐπὶ",9,1],["πλεῖόν",938,29],["σε",5,161],["ἐγκόπτω",10736,592],["παρακαλῶ",434,149],["ἀκοῦσαί",54,100],["σε",5,161],["ἡμῶν",9994,136],["συντόμως",5079,17],["τῇ",1,95],["σῇ",10053,96],["ἐπιεικείᾳ",3196,2]],"But that I don’t delay you, I entreat you to bear with us and hear a few words."],["5",[["εὑρόντες",101,190],["γὰρ",40,8],["τὸν",1,6],["ἄνδρα",38,7],["τοῦτον",16,259],["λοιμὸν",1518,7],["καὶ",2,8],["κινοῦντα",992,178],["στάσεις",1526,40],["πᾶσιν",11,215],["τοῖς",1,138],["Ἰουδαίοις",285,139],["τοῖς",1,138],["κατὰ",32,1],["τὴν",1,9],["οἰκουμένην",1326,10],["πρωτοστάτην",8151,7],["τε",209,8],["τῆς",1,18],["τῶν",1,76],["Ναζωραίων",10004,77],["αἱρέσεως",4693,19]],"For we have found this man to be a plague, an instigator of insurrections among all the Jews throughout the world, and a ringleader of the sect of the Nazarenes."],["6",[["ὃς",24,246],["καὶ",2,8],["τὸ",1,32],["ἱερὸν",675,33],["ἐπείρασεν",1094,3],["βεβηλῶσαι",608,100],["ὃν",24,106],["καὶ",2,8],["ἐκρατήσαμεν",385,285]],"He even tried to profane the temple, and we arrested him."],["8",[["παρ᾽",73,1],["οὗ",24,367],["δυνήσῃ",185,781],["αὐτὸς",3,158],["ἀνακρίνας",5182,155],["περὶ",72,1],["πάντων",11,79],["τούτων",16,214],["ἐπιγνῶναι",431,100],["ὧν",24,97],["ἡμεῖς",9994,208],["κατηγοροῦμεν",3858,241],["αὐτοῦ",3,48]],"By examining him yourself you may ascertain all these things of which we accuse him.”"],["9",[["συνεπέθεντο",3963,184],["δὲ",14,8],["καὶ",2,8],["οἱ",1,128],["Ἰουδαῖοι",285,51],["φάσκοντες",4460,137],["ταῦτα",16,248],["οὕτως",9989,17],["ἔχειν",124,54]],"The Jews also joined in the attack, affirming that these things were so."],["10",[["Ἀπεκρίθη",234,737],["τε",209,8],["ὁ",1,4],["Παῦλος",10586,5],["νεύσαντος",5858,513],["αὐτῷ",3,49],["τοῦ",1,30],["ἡγεμόνος",638,21],["λέγειν",31,54],["ἐκ",21,1],["πολλῶν",74,79],["ἐτῶν",81,45],["ὄντα",10,178],["σε",5,161],["κριτὴν",749,7],["τῷ",1,52],["ἔθνει",60,53],["τούτῳ",16,279],["ἐπιστάμενος",1087,723],["εὐθύμως",7203,65],["τὰ",1,42],["περὶ",72,1],["ἐμαυτοῦ",10062,48],["ἀπολογοῦμαι",5223,768]],"When the governor had beckoned to him to speak, Paul answered, “Because I know that you have been a judge of this nation for many years, I cheerfully make my defense,"],["11",[["δυναμένου",185,766],["σου",5,146],["ἐπιγνῶναι",431,100],["ὅτι",19,8],["οὐ",12,12],["πλείους",74,187],["εἰσίν",10,191],["μοι",9994,151],["ἡμέραι",28,180],["δώδεκα",556,372],["ἀφ᾽",17,1],["ἧς",24,162],["ἀνέβην",88,147],["προσκυνήσων",298,357],["εἰς",8,1],["Ἰερουσαλήμ",823,10]],"seeing that you can verify that it is not more than twelve days since I went up to worship at Jerusalem."],["12",[["καὶ",2,8],["οὔτε",477,8],["ἐν",4,1],["τῷ",1,52],["ἱερῷ",675,53],["εὗρόν",101,141],["με",9994,161],["πρός",15,1],["τινα",39,365],["διαλεγόμενον",3259,765],["ἢ",61,8],["ἐπίστασιν",9589,10],["ποιοῦντα",23,178],["ὄχλου",1008,21],["οὔτε",477,8],["ἐν",4,1],["ταῖς",1,70],["συναγωγαῖς",284,71],["οὔτε",477,8],["κατὰ",32,1],["τὴν",1,9],["πόλιν",41,10]],"In the temple they didn’t find me disputing with anyone or stirring up a crowd, either in the synagogues or in the city."],["13",[["οὐδὲ",106,8],["παραστῆσαι",595,100],["δύνανταί",185,756],["σοι",5,151],["περὶ",72,1],["ὧν",24,97],["νυνὶ",2099,17],["κατηγοροῦσίν",3858,191],["μου",9994,146]],"Nor can they prove to you the things of which they now accuse me."],["14",[["ὁμολογῶ",2686,149],["δὲ",14,8],["τοῦτό",16,122],["σοι",5,151],["ὅτι",19,8],["κατὰ",32,1],["τὴν",1,9],["ὁδὸν",68,10],["ἣν",24,124],["λέγουσιν",31,191],["αἵρεσιν",4693,10],["οὕτως",9989,17],["λατρεύω",594,149],["τῷ",1,110],["πατρῴῳ",2935,111],["θεῷ",20,113],["πιστεύων",649,67],["πᾶσιν",11,90],["τοῖς",1,91],["κατὰ",32,1],["τὸν",1,6],["νόμον",140,7],["καὶ",2,8],["τοῖς",1,91],["ἐν",4,1],["τοῖς",1,138],["προφήταις",176,139],["γεγραμμένοις",186,797]],"But this I confess to you, that according to the Way, which they call a sect, so I serve the God of our fathers, believing all things which are according to the law, and which are written in the prophets;"],["15",[["ἐλπίδα",530,10],["ἔχων",124,67],["εἰς",8,1],["τὸν",1,6],["θεὸν",20,7],["ἣν",24,124],["καὶ",2,8],["αὐτοὶ",3,195],["οὗτοι",16,213],["προσδέχονται",1019,756],["ἀνάστασιν",4027,10],["μέλλειν",1143,54],["ἔσεσθαι",10,894],["δικαίων",153,163],["τε",209,8],["καὶ",2,8],["ἀδίκων",406,163]],"having hope toward God, which these also themselves look for, that there will be a resurrection of the dead, both of the just and unjust."],["16",[["ἐν",4,1],["τούτῳ",16,279],["καὶ",2,8],["αὐτὸς",3,158],["ἀσκῶ",9117,149],["ἀπρόσκοπον",6325,37],["συνείδησιν",6118,10],["ἔχειν",124,54],["πρὸς",15,1],["τὸν",1,6],["θεὸν",20,7],["καὶ",2,8],["τοὺς",1,56],["ἀνθρώπους",43,31],["διὰ",56,1],["παντός",11,153]],"In this I also practice always having a conscience void of offense toward God and men."],["17",[["δι᾽",56,1],["ἐτῶν",81,45],["δὲ",14,8],["πλειόνων",938,79],["ἐλεημοσύνας",942,40],["ποιήσων",23,357],["εἰς",8,1],["τὸ",1,32],["ἔθνος",60,33],["μου",9994,146],["παρεγενόμην",377,820],["καὶ",2,8],["προσφοράς",2376,40]],"Now after some years, I came to bring gifts for the needy to my nation, and offerings;"],["18",[["ἐν",4,1],["αἷς",24,281],["εὗρόν",101,141],["με",9994,161],["ἡγνισμένον",1337,763],["ἐν",4,1],["τῷ",1,52],["ἱερῷ",675,53],["οὐ",12,12],["μετὰ",29,1],["ὄχλου",1008,21],["οὐδὲ",106,8],["μετὰ",29,1],["θορύβου",2722,21]],"amid which certain Jews from Asia found me purified in the temple, not with a mob, nor with turmoil."],["19",[["τινὲς",39,402],["δὲ",14,8],["ἀπὸ",17,1],["τῆς",1,18],["Ἀσίας",3180,19],["Ἰουδαῖοι",285,130],["οὓς",24,294],["ἔδει",1158,14],["ἐπὶ",9,1],["σοῦ",5,146],["παρεῖναι",899,54],["καὶ",2,8],["κατηγορεῖν",3858,54],["εἴ",77,8],["τι",39,119],["ἔχοιεν",124,657],["πρὸς",15,1],["ἐμέ",6,161]],"They ought to have been here before you and to make accusation if they had anything against me."],["20",[["ἢ",61,8],["αὐτοὶ",3,195],["οὗτοι",16,213],["εἰπάτωσαν",9997,261],["τί",10010,119],["εὗρον",101,141],["ἀδίκημα",1921,33],["στάντος",78,513],["μου",9994,146],["ἐπὶ",9,1],["τοῦ",1,23],["συνεδρίου",2498,24]],"Or else let these men themselves say what injustice they found in me when I stood before the council,"],["21",[["ἢ",61,8],["περὶ",72,1],["μιᾶς",58,78],["ταύτης",16,290],["φωνῆς",95,19],["ἧς",24,162],["ἐκέκραξα",592,147],["ἐν",4,1],["αὐτοῖς",3,142],["ἑστὼς",78,264],["ὅτι",19,8],["περὶ",72,1],["ἀναστάσεως",4027,19],["νεκρῶν",659,163],["ἐγὼ",6,156],["κρίνομαι",263,572],["σήμερον",205,17],["ἐφ᾽",9,1],["ὑμῶν",5,136]],"unless it is for this one thing that I cried standing among them, ‘Concerning the resurrection of the dead I am being judged before you today!’”"],["22",[["Ἀνεβάλετο",3397,26],["δὲ",14,8],["αὐτοὺς",3,60],["ὁ",1,4],["Φῆλιξ",10729,5],["ἀκριβέστερον",10675,29],["εἰδὼς",10044,264],["τὰ",1,42],["περὶ",72,1],["τῆς",1,18],["ὁδοῦ",68,19],["εἴπας",9997,155],["ὅταν",319,8],["Λυσίας",1581,5],["ὁ",1,4],["χιλίαρχος",1452,5],["καταβῇ",175,160],["διαγνώσομαι",2875,775],["τὰ",1,42],["καθ᾽",32,1],["ὑμᾶς",5,209]],"But Felix, having more exact knowledge concerning the Way, deferred them, saying, “When Lysias, the commanding officer, comes down, I will decide your case.”"],["23",[["διαταξάμενος",1507,244],["τῷ",1,110],["ἑκατοντάρχῃ",1710,113],["τηρεῖσθαι",1358,634],["αὐτὸν",3,82],["ἔχειν",124,54],["τε",209,8],["ἄνεσιν",3721,10],["καὶ",2,8],["μηδένα",908,59],["κωλύειν",1440,54],["τῶν",1,76],["ἰδίων",683,163],["αὐτοῦ",3,48],["ὑπηρετεῖν",4654,54],["αὐτῷ",3,49]],"He ordered the centurion that Paul should be kept in custody and should have some privileges, and not to forbid any of his friends to serve him or to visit him."],["24",[["Μετὰ",29,1],["δὲ",14,8],["ἡμέρας",28,40],["τινὰς",39,650],["παραγενόμενος",377,770],["ὁ",1,4],["Φῆλιξ",10729,5],["σὺν",310,1],["Δρουσίλλῃ",10737,2],["τῇ",1,95],["ἰδίᾳ",683,96],["γυναικὶ",59,2],["οὔσῃ",10,210],["Ἰουδαίᾳ",285,2],["μετεπέμψατο",3588,26],["τὸν",1,6],["Παῦλον",10586,7],["καὶ",2,8],["ἤκουσεν",54,3],["αὐτοῦ",3,48],["περὶ",72,1],["τῆς",1,18],["εἰς",8,1],["Χριστὸν",1072,7],["Ἰησοῦν",211,7],["πίστεως",887,19]],"After some days, Felix came with Drusilla his wife, who was a Jewess, and sent for Paul and heard him concerning the faith in Christ Jesus."],["25",[["διαλεγομένου",3259,766],["δὲ",14,8],["αὐτοῦ",3,48],["περὶ",72,1],["δικαιοσύνης",187,19],["καὶ",2,8],["ἐγκρατείας",6410,19],["καὶ",2,8],["τοῦ",1,23],["κρίματος",267,24],["τοῦ",1,23],["μέλλοντος",1143,291],["ἔμφοβος",6553,16],["γενόμενος",30,770],["ὁ",1,4],["Φῆλιξ",10729,5],["ἀπεκρίθη",234,737],["τὸ",1,32],["νῦν",90,17],["ἔχον",124,47],["πορεύου",49,726],["καιρὸν",132,7],["δὲ",14,8],["μεταλαβὼν",2365,155],["μετακαλέσομαί",4903,177],["σε",5,161]],"As he reasoned about righteousness, self-control, and the judgment to come, Felix was terrified, and answered, “Go your way for this time, and when it is convenient for me, I will summon you.”"],["26",[["ἅμα",502,17],["καὶ",2,8],["ἐλπίζων",514,67],["ὅτι",19,8],["χρήματα",1190,63],["δοθήσεται",33,125],["αὐτῷ",3,49],["ὑπὸ",122,1],["τοῦ",1,30],["Παύλου",10586,21],["διὸ",1466,8],["καὶ",2,8],["πυκνότερον",3344,29],["αὐτὸν",3,82],["μεταπεμπόμενος",3588,406],["ὡμίλει",3023,14],["αὐτῷ",3,49]],"Meanwhile, he also hoped that money would be given to him by Paul, that he might release him. Therefore also he sent for him more often and talked with him."],["27",[["Διετίας",10738,19],["δὲ",14,8],["πληρωθείσης",518,550],["ἔλαβεν",46,3],["διάδοχον",3262,7],["ὁ",1,4],["Φῆλιξ",10729,5],["Πόρκιον",10739,7],["Φῆστον",10740,7],["θέλων",612,67],["τε",209,8],["χάριτα",368,10],["καταθέσθαι",3283,103],["τοῖς",1,138],["Ἰουδαίοις",285,139],["ὁ",1,4],["Φῆλιξ",10729,5],["κατέλιπεν",207,3],["τὸν",1,6],["Παῦλον",10586,7],["δεδεμένον",440,763]],"But when two years were fulfilled, Felix was succeeded by Porcius Festus, and desiring to gain favor with the Jews, Felix left Paul in bonds."]]