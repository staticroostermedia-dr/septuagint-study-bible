[["1",[["Κατ᾽",32,1],["ἐκεῖνον",80,259],["δὲ",14,8],["τὸν",1,6],["καιρὸν",132,7],["ἐπέβαλεν",724,3],["Ἡρῴδης",9995,5],["ὁ",1,4],["βασιλεὺς",22,5],["τὰς",1,39],["χεῖρας",37,40],["κακῶσαί",757,100],["τινας",39,318],["τῶν",1,76],["ἀπὸ",17,1],["τῆς",1,18],["ἐκκλησίας",563,19]],"Now about that time, King Herod stretched out his hands to oppress some of the assembly."],["2",[["ἀνεῖλεν",651,3],["δὲ",14,8],["Ἰάκωβον",10019,7],["τὸν",1,6],["ἀδελφὸν",67,7],["Ἰωάννου",2148,21],["μαχαίρῃ",342,2]],"He killed James, the brother of John, with the sword."],["3",[["ἰδὼν",112,155],["δὲ",14,8],["ὅτι",19,8],["ἀρεστόν",1397,28],["ἐστιν",10,87],["τοῖς",1,138],["Ἰουδαίοις",285,139],["προσέθετο",201,26],["συλλαβεῖν",507,100],["καὶ",2,8],["Πέτρον",5457,7],["ἦσαν",10,129],["δὲ",14,8],["αἱ",1,185],["ἡμέραι",28,180],["τῶν",1,44],["ἀζύμων",940,79]],"When he saw that it pleased the Jews, he proceeded to seize Peter also. This was during the days of unleavened bread."],["4",[["ὃν",24,106],["καὶ",2,8],["πιάσας",5948,155],["ἔθετο",110,26],["εἰς",8,1],["φυλακὴν",485,10],["παραδοὺς",254,155],["τέσσαρσιν",306,90],["τετραδίοις",10571,92],["στρατιωτῶν",3355,77],["φυλάσσειν",125,54],["αὐτόν",3,82],["βουλόμενος",463,723],["μετὰ",29,1],["τὸ",1,32],["πάσχα",1096,33],["ἀναγαγεῖν",524,100],["αὐτὸν",3,82],["τῷ",1,110],["λαῷ",35,113]],"When he had arrested him, he put him in prison and delivered him to four squads of four soldiers each to guard him, intending to bring him out to the people after the Passover."],["5",[["Ὁ",1,4],["μὲν",281,12],["οὖν",227,8],["Πέτρος",5457,5],["ἐτηρεῖτο",1358,833],["ἐν",4,1],["τῇ",1,95],["φυλακῇ",485,2],["προσευχὴ",550,13],["δὲ",14,8],["ἦν",10,14],["ἐκτενῶς",4578,17],["γινομένη",30,744],["ὑπὸ",122,1],["τῆς",1,18],["ἐκκλησίας",563,19],["πρὸς",15,1],["τὸν",1,6],["θεὸν",20,7],["περὶ",72,1],["αὐτοῦ",3,48]],"Peter therefore was kept in the prison, but constant prayer was made by the assembly to God for him."],["6",[["ὅτε",432,8],["δὲ",14,8],["ἤμελλεν",1143,14],["προαγαγεῖν",2482,100],["αὐτὸν",3,82],["ὁ",1,4],["Ἡρῴδης",9995,5],["τῇ",1,95],["νυκτὶ",219,2],["ἐκείνῃ",80,200],["ἦν",10,14],["ὁ",1,4],["Πέτρος",5457,5],["κοιμώμενος",301,406],["μεταξὺ",3893,1],["δύο",104,372],["στρατιωτῶν",3355,77],["δεδεμένος",440,228],["ἁλύσεσιν",9222,71],["δυσίν",104,287],["φύλακές",8637,51],["τε",209,8],["πρὸ",238,1],["τῆς",1,18],["θύρας",277,19],["ἐτήρουν",1358,129],["τὴν",1,9],["φυλακήν",485,10]],"The same night when Herod was about to bring him out, Peter was sleeping between two soldiers, bound with two chains. Guards in front of the door kept the prison."],["7",[["καὶ",2,8],["ἰδοὺ",51,316],["ἄγγελος",208,5],["κυρίου",7,21],["ἐπέστη",631,3],["καὶ",2,8],["φῶς",380,20],["ἔλαμψεν",3291,3],["ἐν",4,1],["τῷ",1,52],["οἰκήματι",4941,53],["πατάξας",145,155],["δὲ",14,8],["τὴν",1,9],["πλευρὰν",1328,10],["τοῦ",1,30],["Πέτρου",5457,21],["ἤγειρεν",746,3],["αὐτὸν",3,82],["λέγων",31,67],["ἀνάστα",121,198],["ἐν",4,1],["τάχει",1565,53],["καὶ",2,8],["ἐξέπεσαν",2315,141],["αὐτοῦ",3,48],["αἱ",1,185],["ἁλύσεις",9222,180],["ἐκ",21,1],["τῶν",1,123],["χειρῶν",37,61]],"And behold, an angel of the Lord stood by him, and a light shone in the cell. He struck Peter on the side and woke him up, saying, “Stand up quickly!” His chains fell off his hands."],["8",[["εἶπεν",31,3],["δὲ",14,8],["ὁ",1,4],["ἄγγελος",208,5],["πρὸς",15,1],["αὐτόν",3,82],["ζῶσαι",1818,275],["καὶ",2,8],["ὑπόδησαι",9899,275],["τὰ",1,42],["σανδάλιά",4383,43],["σου",5,146],["ἐποίησεν",23,3],["δὲ",14,8],["οὕτως",71,17],["καὶ",2,8],["λέγει",31,87],["αὐτῷ",3,49],["περιβαλοῦ",744,275],["τὸ",1,32],["ἱμάτιόν",276,33],["σου",5,146],["καὶ",2,8],["ἀκολούθει",2513,239],["μοι",9994,151]],"The angel said to him, “Get dressed and put on your sandals.” He did so. He said to him, “Put on your cloak and follow me.”"],["9",[["καὶ",2,8],["ἐξελθὼν",82,155],["ἠκολούθει",2513,14],["καὶ",2,8],["οὐκ",12,12],["ᾔδει",1168,283],["ὅτι",19,8],["ἀληθές",1923,28],["ἐστιν",10,87],["τὸ",1,27],["γινόμενον",30,789],["διὰ",56,1],["τοῦ",1,30],["ἀγγέλου",208,21],["ἐδόκει",801,14],["δὲ",14,8],["ὅραμα",1873,33],["βλέπειν",470,54]],"And he went out and followed him. He didn’t know that what was being done by the angel was real, but thought he saw a vision."],["10",[["διελθόντες",423,190],["δὲ",14,8],["πρώτην",315,37],["φυλακὴν",485,10],["καὶ",2,8],["δευτέραν",271,37],["ἦλθαν",55,141],["ἐπὶ",9,1],["τὴν",1,9],["πύλην",162,10],["τὴν",1,9],["σιδηρᾶν",1063,37],["τὴν",1,9],["φέρουσαν",199,73],["εἰς",8,1],["τὴν",1,9],["πόλιν",41,10],["ἥτις",457,421],["αὐτομάτη",3497,15],["ἠνοίγη",362,38],["αὐτοῖς",3,142],["καὶ",2,8],["ἐξελθόντες",82,190],["προῆλθον",2761,141],["ῥύμην",5434,10],["μίαν",58,37],["καὶ",2,8],["εὐθέως",1673,17],["ἀπέστη",293,3],["ὁ",1,4],["ἄγγελος",208,5],["ἀπ᾽",17,1],["αὐτοῦ",3,48]],"When they were past the first and the second guard, they came to the iron gate that leads into the city, which opened to them by itself. They went out and went down one street, and immediately the angel departed from him."],["11",[["καὶ",2,8],["ὁ",1,4],["Πέτρος",5457,5],["ἐν",4,1],["ἑαυτῷ",92,49],["γενόμενος",30,770],["εἶπεν",31,3],["νῦν",90,17],["οἶδα",1168,85],["ἀληθῶς",1795,17],["ὅτι",19,8],["ἐξαπέστειλεν",220,3],["κύριος",7,5],["τὸν",1,6],["ἄγγελον",208,7],["αὐτοῦ",3,48],["καὶ",2,8],["ἐξείλατό",413,26],["με",9994,161],["ἐκ",21,1],["χειρὸς",37,19],["Ἡρῴδου",9995,21],["καὶ",2,8],["πάσης",11,78],["τῆς",1,18],["προσδοκίας",3118,19],["τοῦ",1,30],["λαοῦ",35,21],["τῶν",1,76],["Ἰουδαίων",285,77]],"When Peter had come to himself, he said, “Now I truly know that the Lord has sent out his angel and delivered me out of the hand of Herod, and from everything the Jewish people were expecting.”"],["12",[["συνιδών",3362,155],["τε",209,8],["ἦλθεν",55,3],["ἐπὶ",9,1],["τὴν",1,9],["οἰκίαν",233,10],["τῆς",1,18],["Μαρίας",2158,19],["τῆς",1,18],["μητρὸς",189,19],["Ἰωάννου",2148,21],["τοῦ",1,30],["ἐπικαλουμένου",341,813],["Μάρκου",10572,21],["οὗ",120,17],["ἦσαν",10,129],["ἱκανοὶ",1007,130],["συνηθροισμένοι",1336,574],["καὶ",2,8],["προσευχόμενοι",551,741]],"Thinking about that, he came to the house of Mary, the mother of John who was called Mark, where many were gathered together and were praying."],["13",[["κρούσαντος",4866,513],["δὲ",14,8],["αὐτοῦ",3,48],["τὴν",1,9],["θύραν",277,10],["τοῦ",1,30],["πυλῶνος",1596,21],["προσῆλθεν",529,3],["παιδίσκη",605,13],["ὑπακοῦσαι",867,100],["ὀνόματι",57,53],["Ῥόδη",10573,13]],"When Peter knocked at the door of the gate, a servant girl named Rhoda came to answer."],["14",[["καὶ",2,8],["ἐπιγνοῦσα",431,140],["τὴν",1,9],["φωνὴν",95,10],["τοῦ",1,30],["Πέτρου",5457,21],["ἀπὸ",17,1],["τῆς",1,18],["χαρᾶς",1125,19],["οὐκ",12,12],["ἤνοιξεν",362,3],["τὸν",1,6],["πυλῶνα",1596,7],["εἰσδραμοῦσα",7147,140],["δὲ",14,8],["ἀπήγγειλεν",273,3],["ἑστάναι",78,107],["τὸν",1,6],["Πέτρον",5457,7],["πρὸ",238,1],["τοῦ",1,30],["πυλῶνος",1596,21]],"When she recognized Peter’s voice, she didn’t open the gate for joy, but ran in and reported that Peter was standing in front of the gate."],["15",[["οἱ",1,128],["δὲ",14,8],["πρὸς",15,1],["αὐτὴν",3,98],["εἶπαν",31,141],["μαίνῃ",3888,730],["ἡ",1,11],["δὲ",14,8],["διϊσχυρίζετο",10430,721],["οὕτως",71,17],["ἔχειν",124,54],["οἱ",1,128],["δὲ",14,8],["ἔλεγον",31,129],["ὁ",1,4],["ἄγγελός",208,5],["ἐστιν",10,87],["αὐτοῦ",3,48]],"They said to her, “You are crazy!” But she insisted that it was so. They said, “It is his angel.”"],["16",[["ὁ",1,4],["δὲ",14,8],["Πέτρος",5457,5],["ἐπέμενεν",9529,14],["κρούων",4866,67],["ἀνοίξαντες",362,190],["δὲ",14,8],["εἶδαν",112,141],["αὐτὸν",3,82],["καὶ",2,8],["ἐξέστησαν",731,141]],"But Peter continued knocking. When they had opened, they saw him and were amazed."],["17",[["κατασείσας",5704,155],["δὲ",14,8],["αὐτοῖς",3,142],["τῇ",1,95],["χειρὶ",37,2],["σιγᾶν",1915,54],["διηγήσατο",800,737],["αὐτοῖς",3,142],["πῶς",10049,12],["ὁ",1,4],["κύριος",7,5],["αὐτὸν",3,82],["ἐξήγαγεν",295,3],["ἐκ",21,1],["τῆς",1,18],["φυλακῆς",485,19],["εἶπέν",31,3],["τε",209,8],["ἀπαγγείλατε",273,69],["Ἰακώβῳ",10019,113],["καὶ",2,8],["τοῖς",1,138],["ἀδελφοῖς",67,139],["ταῦτα",16,248],["καὶ",2,8],["ἐξελθὼν",82,155],["ἐπορεύθη",49,715],["εἰς",8,1],["ἕτερον",253,59],["τόπον",99,7]],"But he, beckoning to them with his hand to be silent, declared to them how the Lord had brought him out of the prison. He said, “Tell these things to James and to the brothers.” Then he departed and went to another place."],["18",[["Γενομένης",30,760],["δὲ",14,8],["ἡμέρας",28,19],["ἦν",10,14],["τάραχος",3980,5],["οὐκ",12,12],["ὀλίγος",555,16],["ἐν",4,1],["τοῖς",1,138],["στρατιώταις",3355,139],["τί",10010,238],["ἄρα",985,8],["ὁ",1,4],["Πέτρος",5457,5],["ἐγένετο",30,737]],"Now as soon as it was day, there was no small stir among the soldiers about what had become of Peter."],["19",[["Ἡρῴδης",9995,5],["δὲ",14,8],["ἐπιζητήσας",1936,155],["αὐτὸν",3,82],["καὶ",2,8],["μὴ",25,12],["εὑρὼν",101,155],["ἀνακρίνας",5182,155],["τοὺς",1,56],["φύλακας",8637,31],["ἐκέλευσεν",1512,3],["ἀπαχθῆναι",1212,175],["καὶ",2,8],["κατελθὼν",4269,155],["ἀπὸ",17,1],["τῆς",1,18],["Ἰουδαίας",492,19],["εἰς",8,1],["Καισάρειαν",10134,10],["διέτριβεν",3518,14]],"When Herod had sought for him and didn’t find him, he examined the guards, then commanded that they should be put to death. He went down from Judea to Caesarea, and stayed there."],["20",[["ἦν",10,14],["δὲ",14,8],["θυμομαχῶν",10574,67],["Τυρίοις",2864,139],["καὶ",2,8],["Σιδωνίοις",2069,139],["ὁμοθυμαδὸν",1262,17],["δὲ",14,8],["παρῆσαν",899,129],["πρὸς",15,1],["αὐτὸν",3,82],["καὶ",2,8],["πείσαντες",344,190],["Βλάστον",10575,7],["τὸν",1,6],["ἐπὶ",9,1],["τοῦ",1,30],["κοιτῶνος",2359,21],["τοῦ",1,30],["βασιλέως",22,21],["ᾐτοῦντο",617,516],["εἰρήνην",213,10],["διὰ",56,1],["τὸ",1,32],["τρέφεσθαι",1743,634],["αὐτῶν",3,41],["τὴν",1,9],["χώραν",278,10],["ἀπὸ",17,1],["τῆς",1,18],["βασιλικῆς",1298,78]],"Now Herod was very angry with the people of Tyre and Sidon. They came with one accord to him and, having made Blastus, the king’s personal aide, their friend, they asked for peace, because their country depended on the king’s country for food."],["2