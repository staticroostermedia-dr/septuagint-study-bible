[["1",[["Ἐγένετο",30,737],["δὲ",14,8],["ἐν",4,1],["Ἰκονίῳ",10596,53],["κατὰ",32,1],["τὸ",1,32],["αὐτὸ",3,121],["εἰσελθεῖν",86,100],["αὐτοὺς",3,60],["εἰς",8,1],["τὴν",1,9],["συναγωγὴν",284,10],["τῶν",1,76],["Ἰουδαίων",285,77],["καὶ",2,8],["λαλῆσαι",50,100],["οὕτως",71,17],["ὥστε",346,8],["πιστεῦσαι",649,100],["Ἰουδαίων",285,77],["τε",209,8],["καὶ",2,8],["Ἑλλήνων",2545,77],["πολὺ",74,29],["πλῆθος",200,33]],"In Iconium, they entered together into the synagogue of the Jews, and so spoke that a great multitude both of Jews and of Greeks believed."],["2",[["οἱ",1,128],["δὲ",14,8],["ἀπειθήσαντες",993,190],["Ἰουδαῖοι",285,51],["ἐπήγειραν",2142,141],["καὶ",2,8],["ἐκάκωσαν",757,141],["τὰς",1,39],["ψυχὰς",63,40],["τῶν",1,44],["ἐθνῶν",60,45],["κατὰ",32,1],["τῶν",1,76],["ἀδελφῶν",67,77]],"But the disbelieving Jews stirred up and embittered the souls of the Gentiles against the brothers."],["3",[["Ἱκανὸν",1007,59],["μὲν",281,12],["οὖν",227,8],["χρόνον",486,7],["διέτριψαν",3518,141],["παρρησιαζόμενοι",3917,741],["ἐπὶ",9,1],["τῷ",1,110],["κυρίῳ",7,113],["τῷ",1,110],["μαρτυροῦντι",2094,390],["τῷ",1,110],["λόγῳ",48,113],["τῆς",1,18],["χάριτος",368,19],["αὐτοῦ",3,48],["διδόντι",33,390],["σημεῖα",505,43],["καὶ",2,8],["τέρατα",1005,43],["γίνεσθαι",30,749],["διὰ",56,1],["τῶν",1,123],["χειρῶν",37,61],["αὐτῶν",3,41]],"Therefore they stayed there a long time, speaking boldly in the Lord, who testified to the word of his grace, granting signs and wonders to be done by their hands."],["4",[["ἐσχίσθη",2636,38],["δὲ",14,8],["τὸ",1,27],["πλῆθος",200,20],["τῆς",1,18],["πόλεως",41,19],["καὶ",2,8],["οἱ",1,128],["μὲν",281,12],["ἦσαν",10,129],["σὺν",310,1],["τοῖς",1,138],["Ἰουδαίοις",285,139],["οἱ",1,128],["δὲ",14,8],["σὺν",310,1],["τοῖς",1,138],["ἀποστόλοις",10080,139]],"But the multitude of the city was divided. Part sided with the Jews and part with the apostles."],["5",[["ὡς",36,12],["δὲ",14,8],["ἐγένετο",30,737],["ὁρμὴ",2847,13],["τῶν",1,44],["ἐθνῶν",60,45],["τε",209,8],["καὶ",2,8],["Ἰουδαίων",2