[["1",[["Ἐὰν",45,8],["ταῖς",1,70],["γλώσσαις",388,71],["τῶν",1,76],["ἀνθρώπων",43,77],["λαλῶ",50,592],["καὶ",2,8],["τῶν",1,76],["ἀγγέλων",208,77],["ἀγάπην",1982,10],["δὲ",14,8],["μὴ",25,12],["ἔχω",124,592],["γέγονα",30,85],["χαλκὸς",758,5],["ἠχῶν",1660,67],["ἢ",61,8],["κύμβαλον",1823,20],["ἀλαλάζον",1984,36]],"If I speak with the languages of men and of angels, but don’t have love, I have become sounding brass or a clanging cymbal."],["2",[["καὶ",2,8],["ἐὰν",45,8],["ἔχω",124,592],["προφητείαν",2285,10],["καὶ",2,8],["εἰδῶ",10044,925],["τὰ",1,42],["μυστήρια",1773,43],["πάντα",11,65],["καὶ",2,8],["πᾶσαν",11,37],["τὴν",1,9],["γνῶσιν",753,10],["καὶ",2,8],["ἐὰν",45,8],["ἔχω",124,592],["πᾶσαν",11,37],["τὴν",1,9],["πίστιν",887,10],["ὥστε",346,8],["ὄρη",87,43],["μεθιστάναι",1519,54],["ἀγάπην",1982,10],["δὲ",14,8],["μὴ",25,12],["ἔχω",124,592],["οὐθέν",228,28],["εἰμι",10,149]],"If I have the gift of prophecy, and know all mysteries and all knowledge, and if I have all faith, so as to remove mountains, but don’t have love, I am nothing."],["3",[["κἂν",10160,8],["ψωμίσω",1793,227],["πάντα",11,65],["τὰ",1,42],["ὑπάρχοντά",418,232],["μου",9994,146],["καὶ",2,8],["ἐὰν",45,8],["παραδῶ",254,227],["τὸ",1,32],["σῶμά",454,33],["μου",9994,146],["ἵνα",102,8],["καυχήσωμαι",1380,815],["ἀγάπην",1982,10],["δὲ",14,8],["μὴ",25,12],["ἔχω",124,592],["οὐδὲν",228,29],["ὠφελοῦμαι",1499,572]],"If I give away all my goods to feed the poor, and if I give my body to be burned, but don’t have love, it profits me nothing."],["4",[["Ἡ",1,11],["ἀγάπη",1982,13],["μακροθυμεῖ",2917,87],["χρηστεύεται",10974,728],["ἡ",1,11],["ἀγάπη",1982,13],["οὐ",12,12],["ζηλοῖ",1057,87],["ἡ",1,11],["ἀγάπη",1982,13],["οὐ",12,12],["περπερεύεται",10975,728],["οὐ",12,12],["φυσιοῦται",10935,449]],"Love is patient and is kind. Love doesn’t envy. Love doesn’t brag, is not proud,"],["5",[["οὐκ",12,12],["ἀσχημονεῖ",4542,87],["οὐ",12,12],["ζητεῖ",191,87],["τὰ",1,42],["ἑαυτῆς",92,83],["οὐ",12,12],["παροξύνεται",1044,449],["οὐ",12,12],["λογίζεται",495,728],["τὸ",1,32],["κακόν",161,29]],"doesn’t behave itself inappropriately, doesn’t seek its own way, is not provoked, takes no account of evil;"],["6",[["οὐ",12,12],["χαίρει",698,87],["ἐπὶ",9,1],["τῇ",1,95],["ἀδικίᾳ",288,2],["συγχαίρει",6089,87],["δὲ",14,8],["τῇ",1,95],["ἀληθείᾳ",352,2]],"doesn’t rejoice in unrighteousness, but rejoices with the truth;"],["7",[["πάντα",11,65],["στέγει",8320,87],["πάντα",11,65],["πιστεύει",649,87],["πάντα",11,65],["ἐλπίζει",514,87],["πάντα",11,65],["ὑπομένει",639,87]],"bears all things, believes all things, hopes all things, and endures all things."],["8",[["ἡ",1,11],["ἀγάπη",1982,13],["οὐδέποτε",4335,17],["πίπτει",154,87],["Εἴτε",2713,8],["δὲ",14,8],["προφητεῖαι",2285,180],["καταργηθήσονται",4259,135],["εἴτε",2713,8],["γλῶσσαι",388,180],["παύσονται",706,740],["εἴτε",2713,8],["γνῶσις",753,13],["καταργηθήσεται",4259,125]],"Love never fails. But where there are prophecies, they will be done away with. Where there are various languages, they will cease. Where there is knowledge, it will be done away with."],["9",[["ἐκ",21,1],["μέρους",471,24],["γὰρ",40,8],["γινώσκομεν",79,241],["καὶ",2,8],["ἐκ",21,1],["μέρους",471,24],["προφητεύομεν",484,241]],"For we know in part and we prophesy in part;"],["10",[["ὅταν",319,8],["δὲ",14,8],["ἔλθῃ",55,160],["τὸ",1,27],["τέλειον",1919,28],["τὸ",1,27],["ἐκ",21,1],["μέρους",471,24],["καταργηθήσεται",4259,125]],"but when that which is complete has come, then that which is partial will be done away with."],["11",[["ὅτε",432,8],["ἤμην",10,429],["νήπιος",1016,16],["ἐλάλουν",50,293],["ὡς",36,12],["νήπιος",1016,16],["ἐφρόνουν",2297,293],["ὡς",36,12],["νήπιος",1016,16],["ἐλογιζόμην",495,816],["ὡς",36,12],["νήπιος",1016,16],["ὅτε",432,8],["γέγονα",30,85],["ἀνήρ",38,5],["κατήργηκα",4259,85],["τὰ",1,42],["τοῦ",1,30],["νηπίου",1016,153]],"When I was a child, I spoke as a child, I felt as a child, I thought as a child. Now that I have become a man, I have put away childish things."],["12",[["βλέπομεν",470,241],["γὰρ",40,8],["ἄρτι",2665,17],["δι᾽",56,1],["ἐσόπτρου",6564,24],["ἐν",4,1],["αἰνίγματι",3035,53],["τότε",250,17],["δὲ",14,8],["πρόσωπον",47,33],["πρὸς",15,1],["πρόσωπον",47,33],["ἄρτι",2665,17],["γινώσκω",79,149],["ἐκ",21,1],["μέρους",471,24],["τότε",250,17],["δὲ",14,8],["ἐπιγνώσομαι",431,775],["καθὼς",221,8],["καὶ",2,8],["ἐπεγνώσθην",431,148]],"For now we see in a mirror, dimly, but then face to face. Now I know in part, but then I will know fully, even as I was also fully known."],["13",[["Νυνὶ",2099,17],["δὲ",14,8],["μένει",681,87],["πίστις",887,13],["ἐλπίς",530,13],["ἀγάπη",1982,13],["τὰ",1,253],["τρία",174,74],["ταῦτα",16,335],["μείζων",66,15],["δὲ",14,8],["τούτων",16,214],["ἡ",1,11],["ἀγάπη",1982,13]],"But now faith, hope, and love remain—these three. The greatest of these is love."]]