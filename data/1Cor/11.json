[["1",[["Μιμηταί",10941,51],["μου",9994,146],["γίνεσθε",30,742],["καθὼς",221,8],["κἀγὼ",10000,8],["Χριστοῦ",1072,21]],"Be imitators of me, even as I also am of Christ."],["2",[["Ἐπαινῶ",1534,149],["δὲ",14,8],["ὑμᾶς",5,209],["ὅτι",19,8],["πάντα",11,65],["μου",9994,146],["μέμνησθε",230,546],["καὶ",2,8],["καθὼς",221,8],["παρέδωκα",254,147],["ὑμῖν",5,86],["τὰς",1,39],["παραδόσεις",4960,40],["κατέχετε",1040,84]],"Now I praise you, brothers, that you remember me in all things, and hold firm the traditions, even as I delivered them to you."],["3",[["Θέλω",612,149],["δὲ",14,8],["ὑμᾶς",5,209],["εἰδέναι",10044,107],["ὅτι",19,8],["παντὸς",11,153],["ἀνδρὸς",38,21],["ἡ",1,11],["κεφαλὴ",144,13],["ὁ",1,4],["Χριστός",1072,5],["ἐστιν",10,87],["κεφαλὴ",144,13],["δὲ",14,8],["γυναικὸς",59,19],["ὁ",1,4],["ἀνήρ",38,5],["κεφαλὴ",144,13],["δὲ",14,8],["τοῦ",1,30],["Χριστοῦ",1072,21],["ὁ",1,4],["θεός",20,5]],"But I would have you know that the head of every man is Christ, and the head of the woman is man, and the head of Christ is God."],["4",[["Πᾶς",11,16],["ἀνὴρ",38,5],["προσευχόμενος",551,723],["ἢ",61,8],["προφητεύων",484,67],["κατὰ",32,1],["κεφαλῆς",144,19],["ἔχων",124,67],["καταισχύνει",696,87],["τὴν",1,9],["κεφαλὴν",144,10],["αὐτοῦ",3,48]],"Every man praying or prophesying, having his head covered, dishonors his head."],["5",[["πᾶσα",11,15],["δὲ",14,8],["γυνὴ",59,13],["προσευχομένη",551,744],["ἢ",61,8],["προφητεύουσα",484,183],["ἀκατακαλύπτῳ",10966,96],["τῇ",1,95],["κεφαλῇ",144,2],["καταισχύνει",696,87],["τὴν",1,9],["κεφαλὴν",144,10],["αὐτῆς",3,83],["ἓν",58,28],["γάρ",40,8],["ἐστιν",10,87],["καὶ",2,8],["τὸ",1,27],["αὐτὸ",3,359],["τῇ",1,95],["ἐξυρημένῃ",1416,843]],"But every woman praying or prophesying with her head uncovered dishonors her head. For it is one and the same thing as if she were shaved."],["6",[["εἰ",77,8],["γὰρ",40,8],["οὐ",12,12],["κατακαλύπτεται",1548,506],["γυνή",59,13],["καὶ",2,8],["κειράσθω",1730,312],["εἰ",77,8],["δὲ",14,8],["αἰσχρὸν",2439,28],["γυναικὶ",59,2],["τὸ",1,27],["κείρασθαι",1730,103],["ἢ",61,8],["ξυρᾶσθαι",1416,103],["κατακαλυπτέσθω",1548,678]],"For if a woman is not covered, let her hair also be cut off. But if it is shameful for a woman to have her hair cut off or be shaved, let her be covered."],["7",[["Ἀνὴρ",38,5],["μὲν",281,12],["γὰρ",40,8],["οὐκ",12,12],["ὀφείλει",2150,87],["κατακαλύπτεσθαι",1548,384],["τὴν",1,9],["κεφαλὴν",144,10],["εἰκὼν",1136,13],["καὶ",2,8],["δόξα",141,13],["θεοῦ",20,21],["ὑπάρχων",418,67],["ἡ",1,11],["γυνὴ",59,13],["δὲ",14,8],["δόξα",141,13],["ἀνδρός",38,21],["ἐστιν",10,87]],"For a man indeed ought not to have his head covered, because he is the image and glory of God, but the woman is the glory of the man."],["8",[["οὐ",12,12],["γάρ",40,8],["ἐστιν",10,87],["ἀνὴρ",38,5],["ἐκ",21,1],["γυναικὸς",59,19],["ἀλλὰ",108,8],["γυνὴ",59,13],["ἐξ",21,1],["ἀνδρός",38,21]],"For man is not from woman, but woman from man;"],["9",[["καὶ",2,8],["γὰρ",40,8],["οὐκ",12,12],["ἐκτίσθη",786,38],["ἀνὴρ",38,5],["διὰ",56,1],["τὴν",1,9],["γυναῖκα",59,10],["ἀλλὰ",108,8],["γυνὴ",59,13],["διὰ",56,1],["τὸν",1,6],["ἄνδρα",38,7]],"for man wasn’t created for the woman, but woman for the man."],["10",[["διὰ",56,1],["τοῦτο",16,122],["ὀφείλει",2150,87],["ἡ",1,11],["γυνὴ",59,13],["ἐξουσίαν",929,10],["ἔχειν",124,54],["ἐπὶ",9,1],["τῆς",1,18],["κεφαλῆς",144,19],["διὰ",56,1],["τοὺς",1,56],["ἀγγέλους",208,31]],"For this cause the woman ought to have authority over her own head, because of the angels."],["11",[["πλὴν",257,8],["οὔτε",477,8],["γυνὴ",59,13],["χωρὶς",2046,1],["ἀνδρὸς",38,21],["οὔτε",477,8],["ἀνὴρ",38,5],["χωρὶς",2046,1],["γυναικὸς",59,19],["ἐν",4,1],["κυρίῳ",7,113]],"Nevertheless, neither is the woman independent of the man, nor the man independent of the woman, in the Lord."],["12",[["ὥσπερ",226,8],["γὰρ",40,8],["ἡ",1,11],["γυνὴ",59,13],["ἐκ",21,1],["τοῦ",1,30],["ἀνδρὸς",38,21],["οὕτως",9989,17],["καὶ",2,8],["ὁ",1,4],["ἀνὴρ",38,5],["διὰ",56,1],["τῆς",1,18],["γυναικός",59,19],["τὰ",1,253],["δὲ",14,8],["πάντα",11,74],["ἐκ",21,1],["τοῦ",1,30],["θεοῦ",20,21]],"For as woman came from man, so a man also comes through a woman; but all things are from God."],["13",[["ἐν",4,1],["ὑμῖν",5,86],["αὐτοῖς",3,142],["κρίνατε",263,69],["πρέπον",2762,36],["ἐστὶν",10,87],["γυναῖκα",59,10],["ἀκατακάλυπτον",10966,37],["τῷ",1,110],["θεῷ",20,113],["προσεύχεσθαι",551,749]],"Judge for yourselves. Is it appropriate that a woman pray to God unveiled?"],["14",[["οὐδὲ",106,8],["ἡ",1,11],["φύσις",2974,13],["αὐτὴ",3,179],["διδάσκει",545,87],["ὑμᾶς",5,209],["ὅτι",19,8],["ἀνὴρ",38,5],["μὲν",281,12],["ἐὰν",45,8],["κομᾷ",10967,173],["ἀτιμία",1049,13],["αὐτῷ",3,49],["ἐστιν",10,87]],"Doesn’t even nature itself teach you that if a man has long hair, it is a dishonor to him?"],["15",[["γυνὴ",59,13],["δὲ",14,8],["ἐὰν",45,8],["κομᾷ",10967,173],["δόξα",141,13],["αὐτῇ",3,99],["ἐστιν",10,87],["ὅτι",19,8],["ἡ",1,11],["κόμη",2734,13],["ἀντὶ",158,1],["περιβολαίου",2753,24],["δέδοται",33,722],["αὐτῇ",3,99]],"But if a woman has long hair, it is a glory to her, for her hair is given to her for a covering."],["16",[["εἰ",77,8],["δέ",14,8],["τις",39,150],["δοκεῖ",801,87],["φιλόνεικος",8613,16],["εἶναι",10135,54],["ἡμεῖς",9994,208],["τοιαύτην",630,234],["συνήθειαν",4418,10],["οὐκ",12,12],["ἔχομεν",124,241],["οὐδὲ",106,8],["αἱ",1,185],["ἐκκλησίαι",563,180],["τοῦ",1,30],["θεοῦ",20,21]],"But if any man seems to be contentious, we have no such custom, neither do God’s assemblies."],["17",[["Τοῦτο",16,122],["δὲ",14,8],["παραγγέλλων",1907,67],["οὐκ",12,12],["ἐπαινῶ",1534,149],["ὅτι",19,8],["οὐκ",12,12],["εἰς",8,1],["τὸ",1,32],["κρεῖσσον",922,29],["ἀλλ᾽",108,8],["εἰς",8,1],["τὸ",1,32],["ἧσσον",10968,29],["συνέρχεσθε",1837,754]],"But in giving you this command I don’t praise you, because you come together not for the better but for the worse."],["18",[["Πρῶτον",315,29],["μὲν",281,12],["γὰρ",40,8],["συνερχομένων",1837,762],["ὑμῶν",5,136],["ἐν",4,1],["ἐκκλησίᾳ",563,2],["ἀκούω",54,149],["σχίσματα",10075,43],["ἐν",4,1],["ὑμῖν",5,86],["ὑπάρχειν",418,54],["καὶ",2,8],["μέρος",471,33],["τι",39,119],["πιστεύω",649,149]],"For first of all, when you come together in the assembly, I hear that divisions exist among you, and I partly believe it."],["19",[["δεῖ",1158,87],["γὰρ",40,8],["καὶ",2,8],["αἱρέσεις",4693,40],["ἐν",4,1],["ὑμῖν",5,86],["εἶναι",10135,54],["ἵνα",102,8],["καὶ",2,8],["οἱ",1,128],["δόκιμοι",3529,130],["φανεροὶ",1977,130],["γένωνται",30,733],["ἐν",4,1],["ὑμῖν",5,86]],"For there also must be factions among you, that those who are approved may be revealed among you."],["20",[["συνερχομένων",1837,762],["οὖν",227,8],["ὑμῶν",5,136],["ἐπὶ",9,1],["τὸ",1,32],["αὐτὸ",3,121],["οὐκ",12,12],["ἔστιν",10,87],["κυριακὸν",10969,29],["δεῖπνον",4739,33],["φαγεῖν",269,100]],"When therefore you assemble yourselves together, it is not the Lord’s supper that you eat."],["21",[["ἕκαστος",171,16],["γὰρ",40,8],["τὸ",1,32],["ἴδιον",683,29],["δεῖπνον",4739,33],["προλαμβάνει",8061,87],["ἐν",4,1],["τῷ",1,52],["φαγεῖν",269,100],["καὶ",2,8],["ὃς",24,246],["μὲν",281,12],["πεινᾷ",1045,87],["ὃς",24,246],["δὲ",14,8],["μεθύει",2464,87]],"For in your eating each one takes his own supper first. One is hungry, and another is drunken."],["22",[["μὴ",25,12],["γὰρ",40,8],["οἰκίας",233,40],["οὐκ",12,12],["ἔχετε",124,84],["εἰς",8,1],["τὸ",1,32],["ἐσθίειν",147,54],["καὶ",2,8],["πίνειν",212,54],["ἢ",61,8],["τῆς",1,18],["ἐκκλησίας",563,19],["τοῦ",1,30],["θεοῦ",20,21],["καταφρονεῖτε",1677,84],["καὶ",2,8],["καταισχύνετε",696,84],["τοὺς",1,56],["μὴ",25,12],["ἔχοντας",124,229],["τί",10010,119],["εἴπω",9997,227],["ὑμῖν",5,86],["ἐπαινέσω",1534,227],["ὑμᾶς",5,209],["ἐν",4,1],["τούτῳ",16,279],["οὐκ",12,12],["ἐπαινῶ",1534,149]],"What, don’t you have houses to eat and to drink in? Or do you despise God’s assembly and put them to shame who don’t have enough? What shall I tell you? Shall I praise you? In this I don’t praise you."],["23",[["ἐγὼ",6,156],["γὰρ",40,8],["παρέλαβον",1385,147],["ἀπὸ",17,1],["τοῦ",1,30],["κυρίου",7,21],["ὃ",24,467],["καὶ",2,8],["παρέδωκα",254,147],["ὑμῖν",5,86],["ὅτι",19,8],["ὁ",1,4],["κύριος",7,5],["Ἰησοῦς",211,5],["ἐν",4,1],["τῇ",1,95],["νυκτὶ",219,2],["ᾗ",24,102],["παρεδίδετο",254,833],["ἔλαβεν",46,3],["ἄρτον",197,7]],"For I received from the Lord that which also I delivered to you, that the Lord Jesus on the night in which he was betrayed took bread."],["24",[["καὶ",2,8],["εὐχαριστήσας",3831,155],["ἔκλασεν",4274,3],["καὶ",2,8],["εἶπεν",9997,3],["τοῦτό",16,344],["μού",9994,146],["ἐστιν",10,87],["τὸ",1,27],["σῶμα",454,20],["τὸ",1,27],["ὑπὲρ",139,1],["ὑμῶν",5,136],["τοῦτο",16,122],["ποιεῖτε",23,307],["εἰς",8,1],["τὴν",1,9],["ἐμὴν",10146,37],["ἀνάμνησιν",4026,10]],"When he had given thanks, he broke it and said, “Take, eat. This is my body, which is broken for you. Do this in memory of me.”"],["25",[["ὡσαύτως",1240,17],["καὶ",2,8],["τὸ",1,32],["ποτήριον",1355,33],["μετὰ",29,1],["τὸ",1,32],["δειπνῆσαι",5534,100],["λέγων",31,67],["τοῦτο",16,344],["τὸ",1,27],["ποτήριον",1355,20],["ἡ",1,11],["καινὴ",728,15],["διαθήκη",169,13],["ἐστὶν",10,87],["ἐν",4,1],["τῷ",1,52],["ἐμῷ",10146,34],["αἵματι",148,53],["τοῦτο",16,122],["ποιεῖτε",23,307],["ὁσάκις",10970,8],["ἐὰν",45,8],["πίνητε",212,362],["εἰς",8,1],["τὴν",1,9],["ἐμὴν",10146,37],["ἀνάμνησιν",4026,10]],"In the same way he also took the cup after supper, saying, “This cup is the new covenant in my blood. Do this, as often as you drink, in memory of me.”"],["26",[["ὁσάκις",10970,8],["γὰρ",40,8],["ἐὰν",45,8],["ἐσθίητε",147,362],["τὸν",1,6],["ἄρτον",197,7],["τοῦτον",16,259],["καὶ",2,8],["τὸ",1,32],["ποτήριον",1355,33],["πίνητε",212,362],["τὸν",1,6],["θάνατον",170,7],["τοῦ",1,30],["κυρίου",7,21],["καταγγέλλετε",5681,84],["ἄχρι",4062,1],["οὗ",24,367],["ἔλθῃ",55,160]],"For as often as you eat this bread and drink this cup, you proclaim the Lord’s death until he comes."],["27",[["Ὥστε",346,8],["ὃς",24,246],["ἂν",83,12],["ἐσθίῃ",147,173],["τὸν",1,6],["ἄρτον",197,7],["ἢ",61,8],["πίνῃ",212,173],["τὸ",1,32],["ποτήριον",1355,33],["τοῦ",1,30],["κυρίου",7,21],["ἀναξίως",8861,17],["ἔνοχος",1870,16],["ἔσται",10,718],["τοῦ",1,23],["σώματος",454,24],["καὶ",2,8],["τοῦ",1,23],["αἵματος",148,24],["τοῦ",1,30],["κυρίου",7,21]],"Therefore whoever eats this bread or drinks the Lord’s cup in a way unworthy of the Lord will be guilty of the body and the blood of the Lord."],["28",[["δοκιμαζέτω",1269,35],["δὲ",14,8],["ἄνθρωπος",43,5],["ἑαυτόν",92,82],["καὶ",2,8],["οὕτως",9989,17],["ἐκ",21,1],["τοῦ",1,30],["ἄρτου",197,21],["ἐσθιέτω",147,35],["καὶ",2,8],["ἐκ",21,1],["τοῦ",1,23],["ποτηρίου",1355,24],["πινέτω",212,35]],"But let a man examine himself, and so let him eat of the bread and drink of the cup."],["29",[["ὁ",1,4],["γὰρ",40,8],["ἐσθίων",147,67],["καὶ",2,8],["πίνων",212,67],["κρίμα",267,33],["ἑαυτῷ",92,49],["ἐσθίει",147,87],["καὶ",2,8],["πίνει",212,87],["μὴ",25,12],["διακρίνων",1506,67],["τὸ",1,32],["σῶμα",454,33]],"For he who eats and drinks in an unworthy way eats and drinks judgment to himself if he doesn’t discern the Lord’s body."],["30",[["διὰ",56,1],["τοῦτο",16,122],["ἐν",4,1],["ὑμῖν",5,86],["πολλοὶ",74,130],["ἀσθενεῖς",1854,130],["καὶ",2,8],["ἄρρωστοι",6387,130],["καὶ",2,8],["κοιμῶνται",301,495],["ἱκανοί",1007,130]],"For this cause many among you are weak and sickly, and not a few sleep."],["31",[["εἰ",77,8],["δὲ",14,8],["ἑαυτοὺς",92,60],["διεκρίνομεν",1506,395],["οὐκ",12,12],["ἂν",83,12],["ἐκρινόμεθα",263,912]],"For if we discerned ourselves, we wouldn’t be judged."],["32",[["κρινόμενοι",263,772],["δὲ",14,8],["ὑπὸ",122,1],["τοῦ",1,30],["κυρίου",7,21],["παιδευόμεθα",643,885],["ἵνα",102,8],["μὴ",25,12],["σὺν",310,1],["τῷ",1,110],["κόσμῳ",743,113],["κατακριθῶμεν",3848,282]],"But when we are judged, we are disciplined by the Lord, that we may not be condemned with the world."],["33",[["Ὥστε",346,8],["ἀδελφοί",67,396],["μου",9994,146],["συνερχόμενοι",1837,741],["εἰς",8,1],["τὸ",1,32],["φαγεῖν",269,100],["ἀλλήλους",1192,60],["ἐκδέχεσθε",2415,742]],"Therefore, my brothers, when you come together to eat, wait for one another."],["34",[["εἴ",77,8],["τις",39,150],["πεινᾷ",1045,87],["ἐν",4,1],["οἴκῳ",34,113],["ἐσθιέτω",147,35],["ἵνα",102,8],["μὴ",25,12],["εἰς",8,1],["κρίμα",267,33],["συνέρχησθε",1837,748],["τὰ",1,42],["δὲ",14,8],["λοιπὰ",523,65],["ὡς",36,12],["ἂν",83,12],["ἔλθω",55,227],["διατάξομαι",1507,775]],"But if anyone is hungry, let him eat at home, lest your coming together be for judgment. The rest I will set in order whenever I come."]]