[["1",[["Περὶ",72,1],["δὲ",14,8],["τῆς",1,18],["λογείας",10987,19],["τῆς",1,18],["εἰς",8,1],["τοὺς",1,56],["ἁγίους",75,58],["ὥσπερ",226,8],["διέταξα",1507,147],["ταῖς",1,70],["ἐκκλησίαις",563,71],["τῆς",1,18],["Γαλατίας",10988,19],["οὕτως",9989,17],["καὶ",2,8],["ὑμεῖς",5,208],["ποιήσατε",23,69]],"Now concerning the collection for the saints: as I commanded the assemblies of Galatia, you do likewise."],["2",[["κατὰ",32,1],["μίαν",58,37],["σαββάτου",442,24],["ἕκαστος",171,16],["ὑμῶν",5,136],["παρ᾽",73,1],["ἑαυτῷ",92,49],["τιθέτω",110,35],["θησαυρίζων",2351,67],["ὅ",24,467],["τι",39,238],["ἐὰν",45,8],["εὐοδῶται",1037,594],["ἵνα",102,8],["μὴ",25,12],["ὅταν",319,8],["ἔλθω",55,227],["τότε",250,17],["λογεῖαι",10987,180],["γίνωνται",30,849]],"On the first day of every week, let each one of you save as he may prosper, that no collections are made when I come."],["3",[["ὅταν",319,8],["δὲ",14,8],["παραγένωμαι",377,815],["οὓς",24,294],["ἐὰν",45,8],["δοκιμάσητε",1269,118],["δι᾽",56,1],["ἐπιστολῶν",866,61],["τούτους",16,274],["πέμψω",1597,157],["ἀπενεγκεῖν",1396,100],["τὴν",1,9],["χάριν",368,10],["ὑμῶν",5,136],["εἰς",8,1],["Ἰερουσαλήμ",823,10]],"When I arrive, I will send whoever you approve with letters to carry your gracious gift to Jerusalem."],["4",[["ἐὰν",45,8],["δὲ",14,8],["ἄξιον",1102,28],["ᾖ",10,173],["τοῦ",1,23],["κἀμὲ",10000,8],["πορεύεσθαι",49,749],["σὺν",310,1],["ἐμοὶ",6,151],["πορεύσονται",49,740]],"If it is appropriate for me to go also, they will go with me."],["5",[["ἐλεύσομαι",55,775],["δὲ",14,8],["πρὸς",15,1],["ὑμᾶς",5,209],["ὅταν",319,8],["Μακεδονίαν",10620,10],["διέλθω",423,227],["Μακεδονίαν",10620,10],["γὰρ",40,8],["διέρχομαι",423,768]],"I will come to you when I have passed through Macedonia, for I am passing through Macedonia."],["6",[["πρὸς",15,1],["ὑμᾶς",5,209],["δὲ",14,8],["τυχὸν",1451,526],["παραμενῶ",3104,157],["ἢ",61,8],["καὶ",2,8],["παραχειμάσω",10771,157],["ἵνα",102,8],["ὑμεῖς",5,208],["με",9994,161],["προπέμψητε",3931,118],["οὗ",120,17],["ἐὰν",45,8],["πορεύωμαι",49,872]],"But with you it may be that I will stay with you, or even winter with you, that you may send me on my journey wherever I go."],["7",[["οὐ",12,12],["θέλω",612,149],["γὰρ",40,8],["ὑμᾶς",5,209],["ἄρτι",2665,17],["ἐν",4,1],["παρόδῳ",3346,2],["ἰδεῖν",53,100],["ἐλπίζω",514,149],["γὰρ",40,8],["χρόνον",486,7],["τινὰ",39,365],["ἐπιμεῖναι",9529,100],["πρὸς",15,1],["ὑμᾶς",5,209],["ἐὰν",45,8],["ὁ",1,4],["κύριος",7,5],["ἐπιτρέψῃ",3445,160]],"For I do not wish to see you now in passing, but I hope to stay a while with you, if the Lord permits."],["8",[["ἐπιμενῶ",9529,157],["δὲ",14,8],["ἐν",4,1],["Ἐφέσῳ",10672,2],["ἕως",42,1],["τῆς",1,18],["πεντηκοστῆς",10500,19]],"But I will stay at Ephesus until Pentecost,"],["9",[["θύρα",277,13],["γάρ",40,8],["μοι",9994,151],["ἀνέῳγεν",362,165],["μεγάλη",66,15],["καὶ",2,8],["ἐνεργὴς",10989,15],["καὶ",2,8],["ἀντικείμενοι",2210,741],["πολλοί",74,130]],"for a great and effective door has opened to me, and there are many adversaries."],["10",[["Ἐὰν",45,8],["δὲ",14,8],["ἔλθῃ",55,160],["Τιμόθεος",1953,5],["βλέπετε",470,307],["ἵνα",102,8],["ἀφόβως",6363,17],["γένηται",30,745],["πρὸς",15,1],["ὑμᾶς",5,209],["τὸ",1,32],["γὰρ",40,8],["ἔργον",105,33],["κυρίου",7,21],["ἐργάζεται",467,728],["ὡς",36,12],["κἀγώ",10000,8]],"Now if Timothy comes, see that he is with you without fear, for he does the work of the Lord, as I also do."],["11",[["μή",25,12],["τις",39,150],["οὖν",227,8],["αὐτὸν",3,82],["ἐξουθενήσῃ",2534,160],["προπέμψατε",3931,69],["δὲ",14,8],["αὐτὸν",3,82],["ἐν",4,1],["εἰρήνῃ",213,2],["ἵνα",102,8],["ἔλθῃ",55,160],["πρός",15,1],["με",9994,161],["ἐκδέχομαι",2415,768],["γὰρ",40,8],["αὐτὸν",3,82],["μετὰ",29,1],["τῶν",1,76],["ἀδελφῶν",67,77]],"Therefore let no one despise him. But set him forward on his journey in peace, that he may come to me; for I expect him with the brothers."],["12",[["Περὶ",72,1],["δὲ",14,8],["Ἀπολλῶ",10673,21],["τοῦ",1,30],["ἀδελφοῦ",67,21],["πολλὰ",74,65],["παρεκάλεσα",434,147],["αὐτὸν",3,82],["ἵνα",102,8],["ἔλθῃ",55,160],["πρὸς",15,1],["ὑμᾶς",5,209],["μετὰ",29,1],["τῶν",1,76],["ἀδελφῶν",67,77],["καὶ",2,8],["πάντως",4379,17],["οὐκ",12,12],["ἦν",10,14],["θέλημα",1039,20],["ἵνα",102,8],["νῦν",90,17],["ἔλθῃ",55,160],["ἐλεύσεται",55,718],["δὲ",14,8],["ὅταν",319,8],["εὐκαιρήσῃ",10240,160]],"Now concerning Apollos the brother, I strongly urged him to come to you with the brothers, but it was not at all his desire to come now; but he will come when he has an opportunity."],["13",[["Γρηγορεῖτε",3041,307],["στήκετε",6083,307],["ἐν",4,1],["τῇ",1,95],["πίστει",887,2],["ἀνδρίζεσθε",1750,742],["κραταιοῦσθε",729,809]],"Watch! Stand firm in the faith! Be courageous! Be strong!"],["14",[["πάντα",11,74],["ὑμῶν",5,136],["ἐν",4,1],["ἀγάπῃ",1982,2],["γινέσθω",30,859]],"Let all that you do be done in love."],["15",[["Παρακαλῶ",434,149],["δὲ",14,8],["ὑμᾶς",5,209],["ἀδελφοί",67,396],["οἴδατε",10044,330],["τὴν",1,9],["οἰκίαν",233,10],["Στεφανᾶ",10929,21],["ὅτι",19,8],["ἐστὶν",10,87],["ἀπαρχὴ",693,13],["τῆς",1,18],["Ἀχαΐας",9249,19],["καὶ",2,8],["εἰς",8,1],["διακονίαν",6977,10],["τοῖς",1,138],["ἁγίοις",75,215],["ἔταξαν",721,141],["ἑαυτούς",92,60]],"Now I beg you, brothers—you know the house of Stephanas, that it is the first fruits of Achaia, and that they have set themselves to serve the saints—"],["16",[["ἵνα",102,8],["καὶ",2,8],["ὑμεῖς",5,208],["ὑποτάσσησθε",1497,928],["τοῖς",1,138],["τοιούτοις",630,193],["καὶ",2,8],["παντὶ",11,111],["τῷ",1,110],["συνεργοῦντι",6115,390],["καὶ",2,8],["κοπιῶντι",921,390]],"that you also be in subjection to such, and to everyone who helps in the work and labors."],["17",[["Χαίρω",698,149],["δὲ",14,8],["ἐπὶ",9,1],["τῇ",1,95],["παρουσίᾳ",4349,2],["Στεφανᾶ",10929,21],["καὶ",2,8],["Φορτουνάτου",10990,21],["καὶ",2,8],["Ἀχαϊκοῦ",10991,21],["ὅτι",19,8],["τὸ",1,32],["ὑμέτερον",10347,29],["ὑστέρημα",3774,33],["οὗτοι",16,213],["ἀνεπλήρωσαν",2308,141]],"I rejoice at the coming of Stephanas, Fortunatus, and Achaicus; for that which was lacking on your part, they supplied."],["18",[["ἀνέπαυσαν",674,141],["γὰρ",40,8],["τὸ",1,32],["ἐμὸν",10146,29],["πνεῦμα",168,33],["καὶ",2,8],["τὸ",1,32],["ὑμῶν",5,136],["ἐπιγινώσκετε",431,307],["οὖν",227,8],["τοὺς",1,56],["τοιούτους",630,274]],"For they refreshed my spirit and yours. Therefore acknowledge those who are like that."],["19",[["Ἀσπάζονται",2987,756],["ὑμᾶς",5,209],["αἱ",1,185],["ἐκκλησίαι",563,180],["τῆς",1,18],["Ἀσίας",3180,19],["Ἀσπάζεται",2987,728],["ὑμᾶς",5,209],["ἐν",4,1],["κυρίῳ",7,113],["πολλὰ",74,65],["Ἀκύλας",10658,5],["καὶ",2,8],["Πρίσκα",10906,13],["σὺν",310,1],["τῇ",1,95],["κατ᾽",32,1],["οἶκον",34,7],["αὐτῶν",3,41],["ἐκκλησίᾳ",563,2]],"The assemblies of Asia greet you. Aquila and Priscilla greet you warmly in the Lord, together with the assembly that is in their house."],["20",[["ἀσπάζονται",2987,756],["ὑμᾶς",5,209],["οἱ",1,128],["ἀδελφοὶ",67,51],["πάντες",11,130],["Ἀσπάσασθε",2987,771],["ἀλλήλους",1192,60],["ἐν",4,1],["φιλήματι",6192,53],["ἁγίῳ",75,34]],"All the brothers greet you. Greet one another with a holy kiss."],["21",[["Ὁ",1,4],["ἀσπασμὸς",10171,5],["τῇ",1,95],["ἐμῇ",10146,96],["χειρὶ",37,2],["Παύλου",10586,21]],"This greeting is by me, Paul, with my own hand."],["22",[["εἴ",77,8],["τις",39,150],["οὐ",12,12],["φιλεῖ",1391,87],["τὸν",1,6],["κύριον",7,7],["ἤτω",10,35],["ἀνάθεμα",1695,20],["μαράνα θά",10992,5]],"If any man doesn’t love the Lord Jesus Christ, let him be cursed. Come, Lord!"],["23",[["Ἡ",1,11],["χάρις",368,13],["τοῦ",1,30],["κυρίου",7,21],["Ἰησοῦ",211,21],["μεθ᾽",29,1],["ὑμῶν",5,136]],"The grace of the Lord Jesus Christ be with you."],["24",[["ἡ",1,11],["ἀγάπη",1982,13],["μου",9994,146],["μετὰ",29,1],["πάντων",11,163],["ὑμῶν",5,136],["ἐν",4,1],["Χριστῷ",1072,113],["Ἰησοῦ",211,113]],"My love to all of you in Christ Jesus. Amen."]]