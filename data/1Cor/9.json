[["1",[["Οὐκ",12,12],["εἰμὶ",10,149],["ἐλεύθερος",1456,16],["οὐκ",12,12],["εἰμὶ",10,149],["ἀπόστολος",10080,5],["οὐχὶ",330,12],["Ἰησοῦν",211,7],["τὸν",1,6],["κύριον",7,7],["ἡμῶν",9994,136],["ἑόρακα",112,85],["οὐ",12,12],["τὸ",1,27],["ἔργον",105,20],["μου",9994,146],["ὑμεῖς",5,208],["ἐστε",10,84],["ἐν",4,1],["κυρίῳ",7,113]],"Am I not free? Am I not an apostle? Haven’t I seen Jesus Christ, our Lord? Aren’t you my work in the Lord?"],["2",[["εἰ",77,8],["ἄλλοις",584,215],["οὐκ",12,12],["εἰμὶ",10,149],["ἀπόστολος",10080,5],["ἀλλά",108,8],["γε",353,12],["ὑμῖν",5,86],["εἰμι",10,149],["ἡ",1,11],["γὰρ",40,8],["σφραγίς",3141,13],["μου",9994,146],["τῆς",1,18],["ἀποστολῆς",2661,19],["ὑμεῖς",5,208],["ἐστε",10,84],["ἐν",4,1],["κυρίῳ",7,113]],"If to others I am not an apostle, yet at least I am to you; for you are the seal of my apostleship in the Lord."],["3",[["ἡ",1,11],["ἐμὴ",10146,15],["ἀπολογία",9017,13],["τοῖς",1,138],["ἐμὲ",6,161],["ἀνακρίνουσίν",5182,352],["ἐστιν",10,87],["αὕτη",16,101]],"My defense to those who examine me is this:"],["4",[["μὴ",25,12],["οὐκ",12,12],["ἔχομεν",124,241],["ἐξουσίαν",929,10],["φαγεῖν",147,100],["καὶ",2,8],["πεῖν",212,100]],"Have we no right to eat and to drink?"],["5",[["μὴ",25,12],["οὐκ",12,12],["ἔχομεν",124,241],["ἐξουσίαν",929,10],["ἀδελφὴν",521,10],["γυναῖκα",59,10],["περιάγειν",3326,54],["ὡς",36,12],["καὶ",2,8],["οἱ",1,128],["λοιποὶ",523,130],["ἀπόστολοι",10080,51],["καὶ",2,8],["οἱ",1,128],["ἀδελφοὶ",67,51],["τοῦ",1,30],["κυρίου",7,21],["καὶ",2,8],["Κηφᾶς",10440,5]],"Have we no right to take along a wife who is a believer, even as the rest of the apostles, and the brothers of the Lord, and Cephas?"],["6",[["ἢ",61,8],["μόνος",302,16],["ἐγὼ",6,156],["καὶ",2,8],["Βαρναβᾶς",10516,5],["οὐκ",12,12],["ἔχομεν",124,241],["ἐξουσίαν",929,10],["μὴ",25,12],["ἐργάζεσθαι",467,749]],"Or have only Barnabas and I no right to not work?"],["7",[["τίς",10010,150],["στρατεύεται",3641,506],["ἰδίοις",683,90],["ὀψωνίοις",5406,92],["ποτέ",458,12],["τίς",10010,150],["φυτεύει",1022,87],["ἀμπελῶνα",607,7],["καὶ",2,8],["τὸν",1,6],["καρπὸν",448,7],["αὐτοῦ",3,48],["οὐκ",12,12],["ἐσθίει",147,87],["ἢ",61,8],["τίς",10010,150],["ποιμαίνει",953,87],["ποίμνην",5976,10],["καὶ",2,8],["ἐκ",21,1],["τοῦ",1,23],["γάλακτος",1034,24],["τῆς",1,18],["ποίμνης",5976,19],["οὐκ",12,12],["ἐσθίει",147,87]],"What soldier ever serves at his own expense? Who plants a vineyard, and doesn’t eat of its fruit? Or who feeds a flock, and doesn’t drink from the flock’s milk?"],["8",[["μὴ",25,12],["κατὰ",32,1],["ἄνθρωπον",43,7],["ταῦτα",16,248],["λαλῶ",50,149],["ἢ",61,8],["καὶ",2,8],["ὁ",1,4],["νόμος",140,5],["ταῦτα",16,248],["οὐ",12,12],["λέγει",31,87]],"Do I speak these things according to the ways of men? Or doesn’t the law also say the same thing?"],["9",[["ἐν",4,1],["γὰρ",40,8],["τῷ",1,110],["Μωϋσέως",5453,21],["νόμῳ",140,113],["γέγραπται",186,722],["οὐ",12,12],["κημώσεις",8615,159],["βοῦν",411,7],["ἀλοῶντα",2979,178],["μὴ",25,12],["τῶν",1,76],["βοῶν",411,77],["μέλει",3594,87],["τῷ",1,110],["θεῷ",20,113]],"For it is written in the law of Moses, “You shall not muzzle an ox while it treads out the grain.” Is it for the oxen that God cares,"],["10",[["ἢ",61,8],["δι᾽",56,1],["ἡμᾶς",9994,209],["πάντως",4379,17],["λέγει",31,87],["δι᾽",56,1],["ἡμᾶς",9994,209],["γὰρ",40,8],["ἐγράφη",186,38],["ὅτι",19,8],["ὀφείλει",2150,87],["ἐπ᾽",9,1],["ἐλπίδι",530,2],["ὁ",1,4],["ἀροτριῶν",2407,67],["ἀροτριᾶν",2407,54],["καὶ",2,8],["ὁ",1,4],["ἀλοῶν",2979,67],["ἐπ᾽",9,1],["ἐλπίδι",530,2],["τοῦ",1,23],["μετέχειν",2741,54]],"or does he say it assuredly for our sake? Yes, it was written for our sake, because he who plows ought to plow in hope, and he who threshes in hope should partake of his hope."],["11",[["εἰ",77,8],["ἡμεῖς",9994,208],["ὑμῖν",5,86],["τὰ",1,42],["πνευματικὰ",10815,65],["ἐσπείραμεν",793,285],["μέγα",66,28],["εἰ",77,8],["ἡμεῖς",9994,208],["ὑμῶν",5,136],["τὰ",1,42],["σαρκικὰ",10902,65],["θερίσομεν",1509,269]],"If we sowed to you spiritual things, is it a great thing if we reap your fleshly things?"],["12",[["εἰ",77,8],["ἄλλοι",584,130],["τῆς",1,18],["ὑμῶν",5,136],["ἐξουσίας",929,19],["μετέχουσιν",2741,191],["οὐ",12,12],["μᾶλλον",1043,17],["ἡμεῖς",9994,208],["ἀλλ᾽",108,8],["οὐκ",12,12],["ἐχρησάμεθα",928,868],["τῇ",1,95],["ἐξουσίᾳ",929,2],["ταύτῃ",16,200],["ἀλλὰ",108,8],["πάντα",11,65],["στέγομεν",8320,241],["ἵνα",102,8],["μή",25,12],["τινα",39,583],["ἐγκοπὴν",10952,10],["δῶμεν",33,75],["τῷ",1,52],["εὐαγγελίῳ",4222,53],["τοῦ",1,30],["Χριστοῦ",1072,21]],"If others partake of this right over you, don’t we yet more? Nevertheless we didn’t use this right, but we bear all things, that we may cause no hindrance to the Good News of Christ."],["13",[["Οὐκ",12,12],["οἴδατε",1168,330],["ὅτι",19,8],["οἱ",1,128],["τὰ",1,42],["ἱερὰ",1318,65],["ἐργαζόμενοι",467,741],["τὰ",1,42],["ἐκ",21,1],["τοῦ",1,23],["ἱεροῦ",675,24],["ἐσθίουσιν",147,191],["οἱ",1,128],["τῷ",1,52],["θυσιαστηρίῳ",133,53],["παρεδρεύοντες",8086,137],["τῷ",1,52],["θυσιαστηρίῳ",133,53],["συμμερίζονται",10953,756]],"Don’t you know that those who serve around sacred things eat from the things of the temple, and those who wait on the altar have their portion with the altar?"],["14",[["οὕτως",71,17],["καὶ",2,8],["ὁ",1,4],["κύριος",7,5],["διέταξεν",1507,3],["τοῖς",1,138],["τὸ",1,32],["εὐαγγέλιον",4222,33],["καταγγέλλουσιν",5681,352],["ἐκ",21,1],["τοῦ",1,23],["εὐαγγελίου",4222,24],["ζῆν",107,54]],"Even so the Lord ordained that those who proclaim the Good News should live from the Good News."],["15",[["ἐγὼ",6,156],["δὲ",14,8],["οὐ",12,12],["κέχρημαι",928,869],["οὐδενὶ",228,111],["τούτων",16,214],["οὐκ",12,12],["ἔγραψα",186,147],["δὲ",14,8],["ταῦτα",16,248],["ἵνα",102,8],["οὕτως",71,17],["γένηται",30,745],["ἐν",4,1],["ἐμοί",6,151],["καλὸν",266,28],["γάρ",40,8],["μοι",9994,151],["μᾶλλον",1043,17],["ἀποθανεῖν",109,100],["ἢ",61,8],["τὸ",1,32],["καύχημά",1627,33],["μου",9994,146],["οὐδεὶς",228,16],["κενώσει",5725,120]],"But I have used none of these things, and I don’t write these things that it may be done so in my case; for I would rather die, than that anyone should make my boasting void."],["16",[["ἐὰν",45,8],["γὰρ",40,8],["εὐαγγελίζωμαι",1817,922],["οὐκ",12,12],["ἔστιν",10,87],["μοι",9994,151],["καύχημα",1627,20],["ἀνάγκη",1126,13],["γάρ",40,8],["μοι",9994,151],["ἐπίκειται",3748,728],["οὐαὶ",769,316],["γάρ",40,8],["μοί",9994,151],["ἐστιν",10,87],["ἐὰν",45,8],["μὴ",25,12],["εὐαγγελίσωμαι",1817,255]],"For if I preach the Good News, I have nothing to boast about, for necessity is laid on me; but woe is to me if I don’t preach the Good News."],["17",[["εἰ",77,8],["γὰρ",40,8],["ἑκὼν",6538,16],["τοῦτο",16,122],["πράσσω",1251,149],["μισθὸν",816,7],["ἔχω",124,149],["εἰ",77,8],["δὲ",14,8],["ἄκων",6380,16],["οἰκονομίαν",5872,10],["πεπίστευμαι",649,880]],"For if I do this of my own will, I have a reward. But if not of my own will, I have a stewardship entrusted to me."],["18",[["τίς",10010,150],["οὖν",227,8],["μού",9994,146],["ἐστιν",10,87],["ὁ",1,4],["μισθός",816,5],["ἵνα",102,8],["εὐαγγελιζόμενος",1817,406],["ἀδάπανον",10954,29],["θήσω",110,227],["τὸ",1,32],["εὐαγγέλιον",4222,33],["εἰς",8,1],["τὸ",1,32],["μὴ",25,12],["καταχρήσασθαι",5711,776],["τῇ",1,95],["ἐξουσίᾳ",929,2],["μου",9994,146],["ἐν",4,1],["τῷ",1,52],["εὐαγγελίῳ",4222,53]],"What then is my reward? That when I preach the Good News, I may present the Good News of Christ without charge, so as not to abuse my authority in the Good News."],["19",[["Ἐλεύθερος",1456,16],["γὰρ",40,8],["ὢν",10,67],["ἐκ",21,1],["πάντων",11,163],["πᾶσιν",11,215],["ἐμαυτὸν",10062,82],["ἐδούλωσα",3527,147],["ἵνα",102,8],["τοὺς",1,56],["πλείονας",938,58],["κερδήσω",10137,227]],"For though I was free from all, I brought myself under bondage to all, that I might gain the more."],["20",[["καὶ",2,8],["ἐγενόμην",30,820],["τοῖς",1,138],["Ἰουδαίοις",285,139],["ὡς",36,12],["Ἰουδαῖος",285,5],["ἵνα",102,8],["Ἰουδαίους",285,31],["κερδήσω",10137,227],["τοῖς",1,138],["ὑπὸ",122,1],["νόμον",140,7],["ὡς",36,12],["ὑπὸ",122,1],["νόμον",140,7],["μὴ",25,12],["ὢν",10,67],["αὐτὸς",3,158],["ὑπὸ",122,1],["νόμον",140,7],["ἵνα",102,8],["τοὺς",1,56],["ὑπὸ",122,1],["νόμον",140,7],["κερδήσω",10137,227]],"To the Jews I became as a Jew, that I might gain Jews; to those who are under the law, as under the law, that I might gain those who are under the law;"],["21",[["τοῖς",1,138],["ἀνόμοις",536,215],["ὡς",36,12],["ἄνομος",536,16],["μὴ",25,12],["ὢν",10,67],["ἄνομος",536,16],["θεοῦ",20,21],["ἀλλ᾽",108,8],["ἔννομος",6555,16],["Χριστοῦ",1072,21],["ἵνα",102,8],["κερδάνω",10137,227],["τοὺς",1,56],["ἀνόμους",536,58]],"to those who are without law, as without law (not being without law toward God, but under law toward Christ), that I might win those who are without law."],["22",[["ἐγενόμην",30,820],["τοῖς",1,138],["ἀσθενέσιν",1854,215],["ἀσθενὴς",1854,16],["ἵνα",102,8],["τοὺς",1,56],["ἀσθενεῖς",1854,58],["κερδήσω",10137,227],["τοῖς",1,138],["πᾶσιν",11,215],["γέγονα",30,85],["πάντα",11,74],["ἵνα",102,8],["πάντως",4379,17],["τινὰς",39,318],["σώσω",172,227]],"To the weak I became as weak, that I might gain the weak. I have become all things to all men, that I may by all means save some."],["23",[["πάντα",11,65],["δὲ",14,8],["ποιῶ",23,149],["διὰ",56,1],["τὸ",1,32],["εὐαγγέλιον",4222,33],["ἵνα",102,8],["συγκοινωνὸς",10879,5],["αὐτοῦ",3,144],["γένωμαι",30,815]],"Now I do this for the sake of the Good News, that I may be a joint partaker of it."],["24",[["Οὐκ",12,12],["οἴδατε",1168,330],["ὅτι",19,8],["οἱ",1,128],["ἐν",4,1],["σταδίῳ",3642,53],["τρέχοντες",820,137],["πάντες",11,130],["μὲν",281,12],["τρέχουσιν",820,191],["εἷς",58,16],["δὲ",14,8],["λαμβάνει",46,87],["τὸ",1,32],["βραβεῖον",10955,33],["οὕτως",71,17],["τρέχετε",820,307],["ἵνα",102,8],["καταλάβητε",532,118]],"Don’t you know that those who run in a race all run, but one receives the prize? Run like that, so that you may win."],["25",[["πᾶς",11,16],["δὲ",14,8],["ὁ",1,4],["ἀγωνιζόμενος",3155,723],["πάντα",11,65],["ἐγκρατεύεται",10946,728],["ἐκεῖνοι",80,213],["μὲν",281,12],["οὖν",227,8],["ἵνα",102,8],["φθαρτὸν",5120,59],["στέφανον",980,7],["λάβωσιν",46,224],["ἡμεῖς",9994,208],["δὲ",14,8],["ἄφθαρτον",6389,59]],"Every man who strives in the games exercises self-control in all things. Now they do it to receive a corruptible crown, but we an incorruptible."],["26",[["ἐγὼ",6,156],["τοίνυν",1789,8],["οὕτως",71,17],["τρέχω",820,149],["ὡς",36,12],["οὐκ",12,12],["ἀδήλως",10956,17],["οὕτως",71,17],["πυκτεύω",10957,149],["ὡς",36,12],["οὐκ",12,12],["ἀέρα",2664,7],["δέρων",10162,67]],"I therefore run like that, not aimlessly. I fight like that, not beating the air,"],["27",[["ἀλλ᾽",108,8],["ὑπωπιάζω",10405,149],["μου",9994,146],["τὸ",1,32],["σῶμα",454,33],["καὶ",2,8],["δουλαγωγῶ",10958,149],["μή",25,12],["πως",441,12],["ἄλλοις",584,215],["κηρύξας",1438,155],["αὐτὸς",3,158],["ἀδόκιμος",6231,16],["γένωμαι",30,815]],"but I beat my body and bring it into submission, lest by any means, after I have preached to others, I myself should be disqualified."]]