[["1",[["Κἀγώ",10000,8],["ἀδελφοί",67,396],["οὐκ",12,12],["ἠδυνήθην",185,921],["λαλῆσαι",50,100],["ὑμῖν",5,86],["ὡς",36,12],["πνευματικοῖς",10815,215],["ἀλλ᾽",108,8],["ὡς",36,12],["σαρκίνοις",3968,215],["ὡς",36,12],["νηπίοις",1016,215],["ἐν",4,1],["Χριστῷ",1072,113]],"Brothers, I couldn’t speak to you as to spiritual, but as to fleshly, as to babies in Christ."],["2",[["γάλα",1034,33],["ὑμᾶς",5,209],["ἐπότισα",790,147],["οὐ",12,12],["βρῶμα",714,33],["οὔπω",3100,17],["γὰρ",40,8],["ἐδύνασθε",185,832],["ἀλλ᾽",108,8],["οὐδὲ",106,8],["ἔτι",111,17],["νῦν",90,17],["δύνασθε",185,754]],"I fed you with milk, not with solid food, for you weren’t yet ready. Indeed, you aren’t ready even now,"],["3",[["ἔτι",111,17],["γὰρ",40,8],["σαρκικοί",10902,130],["ἐστε",10,84],["ὅπου",1579,8],["γὰρ",40,8],["ἐν",4,1],["ὑμῖν",5,86],["ζῆλος",1164,5],["καὶ",2,8],["ἔρις",5372,13],["οὐχὶ",330,12],["σαρκικοί",10902,130],["ἐστε",10,84],["καὶ",2,8],["κατὰ",32,1],["ἄνθρωπον",43,7],["περιπατεῖτε",1327,84]],"for you are still fleshly. For insofar as there is jealousy, strife, and factions among you, aren’t you fleshly, and don’t you walk in the ways of men?"],["4",[["ὅταν",319,8],["γὰρ",40,8],["λέγῃ",31,173],["τις",39,150],["ἐγὼ",6,156],["μέν",281,12],["εἰμι",10,149],["Παύλου",10586,21],["ἕτερος",253,16],["δὲ",14,8],["ἐγὼ",6,156],["Ἀπολλῶ",10673,21],["οὐκ",12,12],["ἄνθρωποί",43,51],["ἐστε",10,84]],"For when one says, “I follow Paul,” and another, “I follow Apollos,” aren’t you fleshly?"],["5",[["Τί",10010,238],["οὖν",227,8],["ἐστιν",10,87],["Ἀπολλῶς",10673,5],["τί",10010,238],["δέ",14,8],["ἐστιν",10,87],["Παῦλος",10586,5],["διάκονοι",3263,51],["δι᾽",56,1],["ὧν",24,303],["ἐπιστεύσατε",649,262],["καὶ",2,8],["ἑκάστῳ",171,111],["ὡς",36,12],["ὁ",1,4],["κύριος",7,5],["ἔδωκεν",33,3]],"Who then is Apollos, and who is Paul, but servants through whom you believed, and each as the Lord gave to him?"],["6",[["ἐγὼ",6,156],["ἐφύτευσα",1022,147],["Ἀπολλῶς",10673,5],["ἐπότισεν",790,3],["ἀλλ᾽",108,8],["ὁ",1,4],["θεὸς",20,5],["ηὔξανεν",1180,14]],"I planted. Apollos watered. But God gave the increase."],["7",[["ὥστε",346,8],["οὔτε",477,8],["ὁ",1,4],["φυτεύων",1022,67],["ἐστίν",10,87],["τι",39,238],["οὔτε",477,8],["ὁ",1,4],["ποτίζων",790,67],["ἀλλ᾽",108,8],["ὁ",1,4],["αὐξάνων",1180,67],["θεός",20,5]],"So then neither he who plants is anything, nor he who waters, but God who gives the increase."],["8",[["ὁ",1,4],["φυτεύων",1022,67],["δὲ",14,8],["καὶ",2,8],["ὁ",1,4],["ποτίζων",790,67],["ἕν",58,28],["εἰσιν",10,191],["ἕκαστος",171,16],["δὲ",14,8],["τὸν",1,6],["ἴδιον",683,59],["μισθὸν",816,7],["λήμψεται",46,718],["κατὰ",32,1],["τὸν",1,6],["ἴδιον",683,59],["κόπον",1345,7]],"Now he who plants and he who waters are the same, but each will receive his own reward according to his own labor."],["9",[["θεοῦ",20,21],["γάρ",40,8],["ἐσμεν",10,241],["συνεργοί",6116,130],["θεοῦ",20,21],["γεώργιον",3040,20],["θεοῦ",20,21],["οἰκοδομή",2371,13],["ἐστε",10,84]],"For we are God’s fellow workers. You are God’s farming, God’s building."],["10",[["κατὰ",32,1],["τὴν",1,9],["χάριν",368,10],["τοῦ",1,30],["θεοῦ",20,21],["τὴν",1,9],["δοθεῖσάν",33,417],["μοι",9994,151],["ὡς",36,12],["σοφὸς",324,16],["ἀρχιτέκτων",5238,5],["θεμέλιον",950,7],["ἔθηκα",110,147],["ἄλλος",584,16],["δὲ",14,8],["ἐποικοδομεῖ",10934,87],["ἕκαστος",171,16],["δὲ",14,8],["βλεπέτω",470,35],["πῶς",10049,12],["ἐποικοδομεῖ",10934,87]],"According to the grace of God which was given to me, as a wise master builder I laid a foundation, and another builds on it. But let each man be careful how he builds on it."],["11",[["θεμέλιον",950,7],["γὰρ",40,8],["ἄλλον",584,59],["οὐδεὶς",228,16],["δύναται",185,728],["θεῖναι",110,100],["παρὰ",73,1],["τὸν",1,6],["κείμενον",1731,765],["ὅς",24,246],["ἐστιν",10,87],["Ἰησοῦς",211,5],["Χριστός",1072,5]],"For no one can lay any other foundation than that which has been laid, which is Jesus Christ."],["12",[["εἰ",77,8],["δέ",14,8],["τις",39,150],["ἐποικοδομεῖ",10934,87],["ἐπὶ",9,1],["τὸν",1,6],["θεμέλιον",950,7],["χρυσόν",1602,7],["ἄργυρον",2819,7],["λίθους",195,31],["τιμίους",1189,58],["ξύλα",196,43],["χόρτον",1046,7],["καλάμην",2018,10]],"But if anyone builds on the foundation with gold, silver, costly stones, wood, hay, or straw,"],["13",[["ἑκάστου",171,153],["τὸ",1,27],["ἔργον",105,20],["φανερὸν",1977,28],["γενήσεται",30,718],["ἡ",1,11],["γὰρ",40,8],["ἡμέρα",28,13],["δηλώσει",1670,120],["ὅτι",19,8],["ἐν",4,1],["πυρὶ",118,53],["ἀποκαλύπτεται",652,449],["καὶ",2,8],["ἑκάστου",171,153],["τὸ",1,32],["ἔργον",105,33],["ὁποῖόν",9837,238],["ἐστιν",10,87],["τὸ",1,27],["πῦρ",118,20],["αὐτὸ",3,359],["δοκιμάσει",1269,120]],"each man’s work will be revealed. For the Day will declare it, because it is revealed in fire; and the fire itself will test what sort of work each man’s work is."],["14",[["εἴ",77,8],["τινος",39,805],["τὸ",1,27],["ἔργον",105,20],["μενεῖ",681,120],["ὃ",24,467],["ἐποικοδόμησεν",10934,3],["μισθὸν",816,7],["λήμψεται",46,718]],"If any man’s work remains which he built on it, he will receive a reward."],["15",[["εἴ",77,8],["τινος",39,805],["τὸ",1,27],["ἔργον",105,20],["κατακαήσεται",554,125],["ζημιωθήσεται",3532,125],["αὐτὸς",3,158],["δὲ",14,8],["σωθήσεται",172,125],["οὕτως",9989,17],["δὲ",14,8],["ὡς",36,12],["διὰ",56,1],["πυρός",118,24]],"If any man’s work is burned, he will suffer loss, but he himself will be saved, but as through fire."],["16",[["Οὐκ",12,12],["οἴδατε",10044,330],["ὅτι",19,8],["ναὸς",483,5],["θεοῦ",20,21],["ἐστε",10,84],["καὶ",2,8],["τὸ",1,27],["πνεῦμα",168,20],["τοῦ",1,30],["θεοῦ",20,21],["οἰκεῖ",528,87],["ἐν",4,1],["ὑμῖν",5,86]],"Don’t you know that you are God’s temple and that God’s Spirit lives in you?"],["17",[["εἴ",77,8],["τις",39,150],["τὸν",1,6],["ναὸν",483,7],["τοῦ",1,30],["θεοῦ",20,21],["φθείρει",2199,87],["φθερεῖ",2199,120],["τοῦτον",16,259],["ὁ",1,4],["θεός",20,5],["ὁ",1,4],["γὰρ",40,8],["ναὸς",483,5],["τοῦ",1,30],["θεοῦ",20,21],["ἅγιός",75,16],["ἐστιν",10,87],["οἵτινές",457,455],["ἐστε",10,84],["ὑμεῖς",5,208]],"If anyone destroys God’s temple, God will destroy him; for God’s temple is holy, which you are."],["18",[["Μηδεὶς",908,16],["ἑαυτὸν",92,82],["ἐξαπατάτω",6468,35],["εἴ",77,8],["τις",39,150],["δοκεῖ",801,87],["σοφὸς",324,16],["εἶναι",10135,54],["ἐν",4,1],["ὑμῖν",5,86],["ἐν",4,1],["τῷ",1,110],["αἰῶνι",100,113],["τούτῳ",16,286],["μωρὸς",1278,16],["γενέσθω",30,792],["ἵνα",102,8],["γένηται",30,745],["σοφός",324,16]],"Let no one deceive himself. If anyone thinks that he is wise among you in this world, let him become a fool that he may become wise."],["19",[["ἡ",1,11],["γὰρ",40,8],["σοφία",242,13],["τοῦ",1,30],["κόσμου",743,21],["τούτου",16,126],["μωρία",5846,13],["παρὰ",73,1],["τῷ",1,110],["θεῷ",20,113],["ἐστιν",10,87],["γέγραπται",186,722],["γάρ",40,8],["ὁ",1,4],["δρασσόμενος",3054,723],["τοὺς",1,56],["σοφοὺς",324,58],["ἐν",4,1],["τῇ",1,95],["πανουργίᾳ",3315,2],["αὐτῶν",3,41]],"For the wisdom of this world is foolishness with God. For it is written, “He has taken the wise in their craftiness.”"],["20",[["καὶ",2,8],["πάλιν",655,17],["κύριος",7,5],["γινώσκει",79,87],["τοὺς",1,56],["διαλογισμοὺς",1584,31],["τῶν",1,76],["σοφῶν",324,163],["ὅτι",19,8],["εἰσὶν",10,191],["μάταιοι",654,130]],"And again, “The Lord knows the reasoning of the wise, that it is worthless.”"],["21",[["Ὥστε",346,8],["μηδεὶς",908,16],["καυχάσθω",1380,859],["ἐν",4,1],["ἀνθρώποις",43,139],["πάντα",11,74],["γὰρ",40,8],["ὑμῶν",5,136],["ἐστιν",10,87]],"Therefore let no one boast in men. For all things are yours,"],["22",[["εἴτε",2713,8],["Παῦλος",10586,5],["εἴτε",2713,8],["Ἀπολλῶς",10673,5],["εἴτε",2713,8],["Κηφᾶς",10440,5],["εἴτε",2713,8],["κόσμος",743,5],["εἴτε",2713,8],["ζωὴ",216,13],["εἴτε",2713,8],["θάνατος",170,5],["εἴτε",2713,8],["ἐνεστῶτα",2531,508],["εἴτε",2713,8],["μέλλοντα",1143,289],["πάντα",11,74],["ὑμῶν",5,136]],"whether Paul, or Apollos, or Cephas, or the world, or life, or death, or things present, or things to come. All are yours,"],["23",[["ὑμεῖς",5,208],["δὲ",14,8],["Χριστοῦ",1072,21],["Χριστὸς",1072,5],["δὲ",14,8],["θεοῦ",20,21]],"and you are Christ’s, and Christ is God’s."]]