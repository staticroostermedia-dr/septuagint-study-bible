[["1",[["Κἀγὼ",10000,8],["ἐλθὼν",55,155],["πρὸς",15,1],["ὑμᾶς",5,209],["ἀδελφοί",67,396],["ἦλθον",55,147],["οὐ",12,12],["καθ᾽",32,1],["ὑπεροχὴν",4653,10],["λόγου",48,21],["ἢ",61,8],["σοφίας",242,19],["καταγγέλλων",5681,67],["ὑμῖν",5,86],["τὸ",1,32],["μυστήριον",1773,33],["τοῦ",1,30],["θεοῦ",20,21]],"When I came to you, brothers, I didn’t come with excellence of speech or of wisdom, proclaiming to you the testimony of God."],["2",[["οὐ",12,12],["γὰρ",40,8],["ἔκρινά",263,147],["τι",39,119],["εἰδέναι",10044,107],["ἐν",4,1],["ὑμῖν",5,86],["εἰ",77,8],["μὴ",25,12],["Ἰησοῦν",211,7],["Χριστὸν",1072,7],["καὶ",2,8],["τοῦτον",16,259],["ἐσταυρωμένον",6067,763]],"For I determined not to know anything among you except Jesus Christ and him crucified."],["3",[["κἀγὼ",10000,8],["ἐν",4,1],["ἀσθενείᾳ",3413,2],["καὶ",2,8],["ἐν",4,1],["φόβῳ",333,113],["καὶ",2,8],["ἐν",4,1],["τρόμῳ",1599,113],["πολλῷ",74,111],["ἐγενόμην",30,820],["πρὸς",15,1],["ὑμᾶς",5,209]],"I was with you in weakness, in fear, and in much trembling."],["4",[["καὶ",2,8],["ὁ",1,4],["λόγος",48,5],["μου",9994,146],["καὶ",2,8],["τὸ",1,27],["κήρυγμά",4287,20],["μου",9994,146],["οὐκ",12,12],["ἐν",4,1],["πειθοῖς",10932,215],["σοφίας",242,19],["λόγοις",48,139],["ἀλλ᾽",108,8],["ἐν",4,1],["ἀποδείξει",5233,2],["πνεύματος",168,24],["καὶ",2,8],["δυνάμεως",98,19]],"My speech and my preaching were not in persuasive words of human wisdom, but in demonstration of the Spirit and of power,"],["5",[["ἵνα",102,8],["ἡ",1,11],["πίστις",887,13],["ὑμῶν",5,136],["μὴ",25,12],["ᾖ",10,173],["ἐν",4,1],["σοφίᾳ",242,2],["ἀνθρώπων",43,77],["ἀλλ᾽",108,8],["ἐν",4,1],["δυνάμει",98,2],["θεοῦ",20,21]],"that your faith wouldn’t stand in the wisdom of men, but in the power of God."],["6",[["Σοφίαν",242,10],["δὲ",14,8],["λαλοῦμεν",50,241],["ἐν",4,1],["τοῖς",1,138],["τελείοις",1919,215],["σοφίαν",242,10],["δὲ",14,8],["οὐ",12,12],["τοῦ",1,30],["αἰῶνος",100,21],["τούτου",16,126],["οὐδὲ",106,8],["τῶν",1,76],["ἀρχόντων",96,77],["τοῦ",1,30],["αἰῶνος",100,21],["τούτου",16,126],["τῶν",1,76],["καταργουμένων",4259,795]],"We speak wisdom, however, among those who are full grown, yet a wisdom not of this world nor of the rulers of this world who are coming to nothing."],["7",[["ἀλλὰ",108,8],["λαλοῦμεν",50,241],["θεοῦ",20,21],["σοφίαν",242,10],["ἐν",4,1],["μυστηρίῳ",1773,53],["τὴν",1,9],["ἀποκεκρυμμένην",1926,540],["ἣν",24,124],["προώρισεν",10514,3],["ὁ",1,4],["θεὸς",20,5],["πρὸ",238,1],["τῶν",1,76],["αἰώνων",100,77],["εἰς",8,1],["δόξαν",141,10],["ἡμῶν",9994,136]],"But we speak God’s wisdom in a mystery, the wisdom that has been hidden, which God foreordained before the worlds for our glory,"],["8",[["ἣν",24,124],["οὐδεὶς",228,16],["τῶν",1,76],["ἀρχόντων",96,77],["τοῦ",1,30],["αἰῶνος",100,21],["τούτου",16,126],["ἔγνωκεν",79,165],["εἰ",77,8],["γὰρ",40,8],["ἔγνωσαν",79,141],["οὐκ",12,12],["ἂν",83,12],["τὸν",1,6],["κύριον",7,7],["τῆς",1,18],["δόξης",141,19],["ἐσταύρωσαν",6067,141]],"which none of the rulers of this world has known. For had they known it, they wouldn’t have crucified the Lord of glory."],["9",[["ἀλλὰ",108,8],["καθὼς",221,8],["γέγραπται",186,722],["ἃ",24,755],["ὀφθαλμὸς",91,5],["οὐκ",12,12],["εἶδεν",53,3],["καὶ",2,8],["οὖς",328,20],["οὐκ",12,12],["ἤκουσεν",54,3],["καὶ",2,8],["ἐπὶ",9,1],["καρδίαν",64,10],["ἀνθρώπου",43,21],["οὐκ",12,12],["ἀνέβη",88,3],["ἃ",24,755],["ἡτοίμασεν",371,3],["ὁ",1,4],["θεὸς",20,5],["τοῖς",1,138],["ἀγαπῶσιν",214,352],["αὐτόν",3,82]],"But as it is written, “Things which an eye didn’t see, and an ear didn’t hear, which didn’t enter into the heart of man, these God has prepared for those who love him.”"],["10",[["ἡμῖν",9994,86],["δὲ",14,8],["ἀπεκάλυψεν",652,3],["ὁ",1,4],["θεὸς",20,5],["διὰ",56,1],["τοῦ",1,23],["πνεύματος",168,24],["τὸ",1,27],["γὰρ",40,8],["πνεῦμα",168,20],["πάντα",11,65],["ἐραυνᾷ",2321,87],["καὶ",2,8],["τὰ",1,42],["βάθη",1502,43],["τοῦ",1,30],["θεοῦ",20,21]],"But to us, God revealed them through the Spirit. For the Spirit searches all things, yes, the deep things of God."],["11",[["τίς",10010,150],["γὰρ",40,8],["οἶδεν",10044,165],["ἀνθρώπων",43,77],["τὰ",1,42],["τοῦ",1,30],["ἀνθρώπου",43,21],["εἰ",77,8],["μὴ",25,12],["τὸ",1,27],["πνεῦμα",168,20],["τοῦ",1,30],["ἀνθρώπου",43,21],["τὸ",1,27],["ἐν",4,1],["αὐτῷ",3,49],["οὕτως",9989,17],["καὶ",2,8],["τὰ",1,42],["τοῦ",1,30],["θεοῦ",20,21],["οὐδεὶς",228,16],["ἔγνωκεν",79,165],["εἰ",77,8],["μὴ",25,12],["τὸ",1,27],["πνεῦμα",168,20],["τοῦ",1,30],["θεοῦ",20,21]],"For who among men knows the things of a man except the spirit of the man which is in him? Even so, no one knows the things of God except God’s Spirit."],["12",[["ἡμεῖς",9994,208],["δὲ",14,8],["οὐ",12,12],["τὸ",1,32],["πνεῦμα",168,33],["τοῦ",1,30],["κόσμου",743,21],["ἐλάβομεν",46,285],["ἀλλὰ",108,8],["τὸ",1,32],["πνεῦμα",168,33],["τὸ",1,32],["ἐκ",21,1],["τοῦ",1,30],["θεοῦ",20,21],["ἵνα",102,8],["εἰδῶμεν",10044,920],["τὰ",1,42],["ὑπὸ",122,1],["τοῦ",1,30],["θεοῦ",20,21],["χαρισθέντα",6200,327],["ἡμῖν",9994,86]],"But we received not the spirit of the world, but the Spirit which is from God, that we might know the things that were freely given to us by God."],["13",[["ἃ",24,755],["καὶ",2,8],["λαλοῦμεν",50,241],["οὐκ",12,12],["ἐν",4,1],["διδακτοῖς",5568,215],["ἀνθρωπίνης",2656,78],["σοφίας",242,19],["λόγοις",48,139],["ἀλλ᾽",108,8],["ἐν",4,1],["διδακτοῖς",5568,215],["πνεύματος",168,24],["πνευματικοῖς",10815,90],["πνευματικὰ",10815,65],["συγκρίνοντες",2493,137]],"We also speak these things, not in words which man’s wisdom teaches but which the Holy Spirit teaches, comparing spiritual things with spiritual things."],["14",[["ψυχικὸς",5154,16],["δὲ",14,8],["ἄνθρωπος",43,5],["οὐ",12,12],["δέχεται",815,728],["τὰ",1,42],["τοῦ",1,23],["πνεύματος",168,24],["τοῦ",1,30],["θεοῦ",20,21],["μωρία",5846,13],["γὰρ",40,8],["αὐτῷ",3,49],["ἐστιν",10,87],["καὶ",2,8],["οὐ",12,12],["δύναται",185,728],["γνῶναι",79,100],["ὅτι",19,8],["πνευματικῶς",10933,17],["ἀνακρίνεται",5182,449]],"Now the natural man doesn’t receive the things of God’s Spirit, for they are foolishness to him; and he can’t know them, because they are spiritually discerned."],["15",[["ὁ",1,4],["δὲ",14,8],["πνευματικὸς",10815,16],["ἀνακρίνει",5182,87],["τὰ",1,42],["πάντα",11,65],["αὐτὸς",3,158],["δὲ",14,8],["ὑπ᾽",122,1],["οὐδενὸς",228,153],["ἀνακρίνεται",5182,449]],"But he who is spiritual discerns all things, and he himself is to be judged by no one."],["16",[["τίς",10010,150],["γὰρ",40,8],["ἔγνω",79,3],["νοῦν",1442,7],["κυρίου",7,21],["ὃς",24,246],["συμβιβάσει",2775,120],["αὐτόν",3,82],["ἡμεῖς",9994,208],["δὲ",14,8],["νοῦν",1442,7],["Χριστοῦ",1072,21],["ἔχομεν",124,241]],"“For who has known the mind of the Lord that he should instruct him?” But we have Christ’s mind."]]