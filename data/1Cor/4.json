[["1",[["Οὕτως",71,17],["ἡμᾶς",9994,209],["λογιζέσθω",495,859],["ἄνθρωπος",43,5],["ὡς",36,12],["ὑπηρέτας",4138,31],["Χριστοῦ",1072,21],["καὶ",2,8],["οἰκονόμους",2182,31],["μυστηρίων",1773,45],["θεοῦ",20,21]],"So let a man think of us as Christ’s servants and stewards of God’s mysteries."],["2",[["Ὧδε",640,17],["λοιπὸν",2461,29],["ζητεῖται",191,449],["ἐν",4,1],["τοῖς",1,138],["οἰκονόμοις",2182,139],["ἵνα",102,8],["πιστός",750,16],["τις",39,150],["εὑρεθῇ",101,333]],"Here, moreover, it is required of stewards that they be found faithful."],["3",[["ἐμοὶ",6,151],["δὲ",14,8],["εἰς",8,1],["ἐλάχιστόν",2418,29],["ἐστιν",10,87],["ἵνα",102,8],["ὑφ᾽",122,1],["ὑμῶν",5,136],["ἀνακριθῶ",5182,555],["ἢ",61,8],["ὑπὸ",122,1],["ἀνθρωπίνης",2656,78],["ἡμέρας",28,19],["ἀλλ᾽",108,8],["οὐδὲ",106,8],["ἐμαυτὸν",10062,82],["ἀνακρίνω",5182,149]],"But with me it is a very small thing that I should be judged by you, or by a human court. Yes, I don’t even judge my own self."],["4",[["οὐδὲν",228,29],["γὰρ",40,8],["ἐμαυτῷ",10062,49],["σύνοιδα",4428,85],["ἀλλ᾽",108,8],["οὐκ",12,12],["ἐν",4,1],["τούτῳ",16,279],["δεδικαίωμαι",1115,880],["ὁ",1,4],["δὲ",14,8],["ἀνακρίνων",5182,67],["με",9994,161],["κύριός",7,5],["ἐστιν",10,87]],"For I know nothing against myself. Yet I am not justified by this, but he who judges me is the Lord."],["5",[["ὥστε",346,8],["μὴ",25,12],["πρὸ",238,1],["καιροῦ",132,21],["τι",39,119],["κρίνετε",263,307],["ἕως",42,1],["ἂν",83,12],["ἔλθῃ",55,160],["ὁ",1,4],["κύριος",7,5],["ὃς",24,246],["καὶ",2,8],["φωτίσει",1230,120],["τὰ",1,42],["κρυπτὰ",1822,65],["τοῦ",1,23],["σκότους",506,24],["καὶ",2,8],["φανερώσει",8582,120],["τὰς",1,39],["βουλὰς",350,40],["τῶν",1,123],["καρδιῶν",64,61],["καὶ",2,8],["τότε",250,17],["ὁ",1,4],["ἔπαινος",2840,5],["γενήσεται",30,718],["ἑκάστῳ",171,111],["ἀπὸ",17,1],["τοῦ",1,30],["θεοῦ",20,21]],"Therefore judge nothing before the time, until the Lord comes, who will both bring to light the hidden things of darkness and reveal the counsels of the hearts. Then each man will get his praise from God."],["6",[["Ταῦτα",16,248],["δέ",14,8],["ἀδελφοί",67,396],["μετεσχημάτισα",7679,147],["εἰς",8,1],["ἐμαυτὸν",10062,82],["καὶ",2,8],["Ἀπολλῶν",10673,7],["δι᾽",56,1],["ὑμᾶς",5,209],["ἵνα",102,8],["ἐν",4,1],["ἡμῖν",9994,86],["μάθητε",923,118],["τὸ",1,32],["μὴ",25,12],["ὑπὲρ",139,1],["ἃ",24,755],["γέγραπται",186,722],["ἵνα",102,8],["μὴ",25,12],["εἷς",58,16],["ὑπὲρ",139,1],["τοῦ",1,30],["ἑνὸς",58,153],["φυσιοῦσθε",10935,698],["κατὰ",32,1],["τοῦ",1,30],["ἑτέρου",253,153]],"Now these things, brothers, I have in a figure transferred to myself and Apollos for your sakes, that in us you might learn not to think beyond the things which are written, that none of you be puffed up against one another."],["7",[["τίς",10010,150],["γάρ",40,8],["σε",5,161],["διακρίνει",1506,87],["τί",10010,119],["δὲ",14,8],["ἔχεις",124,145],["ὃ",24,467],["οὐκ",12,12],["ἔλαβες",46,154],["εἰ",77,8],["δὲ",14,8],["καὶ",2,8],["ἔλαβες",46,154],["τί",10010,119],["καυχᾶσαι",1380,730],["ὡς",36,12],["μὴ",25,12],["λαβών",46,155]],"For who makes you different? And what do you have that you didn’t receive? But if you did receive it, why do you boast as if you had not received it?"],["8",[["ἤδη",916,17],["κεκορεσμένοι",10793,574],["ἐστέ",10,84],["ἤδη",916,17],["ἐπλουτήσατε",2373,262],["χωρὶς",2046,1],["ἡμῶν",9994,136],["ἐβασιλεύσατε",151,262],["καὶ",2,8],["ὄφελόν",3475,12],["γε",353,12],["ἐβασιλεύσατε",151,262],["ἵνα",102,8],["καὶ",2,8],["ἡμεῖς",9994,208],["ὑμῖν",5,86],["συμβασιλεύσωμεν",10936,75]],"You are already filled. You have already become rich. You have come to reign without us. Yes, and I wish that you did reign, that we also might reign with you!"],["9",[["δοκῶ",801,149],["γάρ",40,8],["ὁ",1,4],["θεὸς",20,5],["ἡμᾶς",9994,209],["τοὺς",1,56],["ἀποστόλους",10080,31],["ἐσχάτους",410,58],["ἀπέδειξεν",3168,3],["ὡς",36,12],["ἐπιθανατίους",10937,58],["ὅτι",19,8],["θέατρον",10688,20],["ἐγενήθημεν",30,794],["τῷ",1,110],["κόσμῳ",743,113],["καὶ",2,8],["ἀγγέλοις",208,139],["καὶ",2,8],["ἀνθρώποις",43,139]],"For I think that God has displayed us, the apostles, last of all, like men sentenced to death. For we are made a spectacle to the world, both to angels and men."],["10",[["ἡμεῖς",9994,208],["μωροὶ",1278,130],["διὰ",56,1],["Χριστὸν",1072,7],["ὑμεῖς",5,208],["δὲ",14,8],["φρόνιμοι",1211,130],["ἐν",4,1],["Χριστῷ",1072,113],["ἡμεῖς",9994,208],["ἀσθενεῖς",1854,130],["ὑμεῖς",5,208],["δὲ",14,8],["ἰσχυροί",401,130],["ὑμεῖς",5,208],["ἔνδοξοι",732,130],["ἡμεῖς",9994,208],["δὲ",14,8],["ἄτιμοι",2666,130]],"We are fools for Christ’s sake, but you are wise in Christ. We are weak, but you are strong. You have honor, but we have dishonor."],["11",[["ἄχρι",4062,1],["τῆς",1,18],["ἄρτι",2665,17],["ὥρας",838,19],["καὶ",2,8],["πεινῶμεν",1045,241],["καὶ",2,8],["διψῶμεν",1161,241],["καὶ",2,8],["γυμνιτεύομεν",10938,241],["καὶ",2,8],["κολαφιζόμεθα",10193,885],["καὶ",2,8],["ἀστατοῦμεν",10939,241]],"Even to this present hour we hunger, thirst, are naked, are beaten, and have no certain dwelling place."],["12",[["καὶ",2,8],["κοπιῶμεν",921,241],["ἐργαζόμενοι",467,741],["ταῖς",1,70],["ἰδίαις",683,287],["χερσίν",37,71],["λοιδορούμενοι",3079,772],["εὐλογοῦμεν",149,241],["διωκόμενοι",533,772],["ἀνεχόμεθα",2211,800]],"We toil, working with our own hands. When people curse us, we bless. Being persecuted, we endure."],["13",[["δυσφημούμενοι",7104,772],["παρακαλοῦμεν",434,241],["ὡς",36,12],["περικαθάρματα",7947,63],["τοῦ",1,30],["κόσμου",743,21],["ἐγενήθημεν",30,794],["πάντων",11,79],["περίψημα",7972,20],["ἕως",42,1],["ἄρτι",2665,17]],"Being defamed, we entreat. We are made as the filth of the world, the dirt wiped off by all, even until now."],["14",[["οὐκ",12,12],["ἐντρέπων",1105,67],["ὑμᾶς",5,209],["γράφω",186,149],["ταῦτα",16,248],["ἀλλ᾽",108,8],["ὡς",36,12],["τέκνα",192,43],["μου",9994,146],["ἀγαπητὰ",1920,65],["νουθετῶν",2608,67]],"I don’t write these things to shame you, but to admonish you as my beloved children."],["15",[["ἐὰν",45,8],["γὰρ",40,8],["μυρίους",3906,58],["παιδαγωγοὺς",10940,31],["ἔχητε",124,362],["ἐν",4,1],["Χριστῷ",1072,113],["ἀλλ᾽",108,8],["οὐ",12,12],["πολλοὺς",74,58],["πατέρας",44,31],["ἐν",4,1],["γὰρ",40,8],["Χριστῷ",1072,113],["Ἰησοῦ",211,113],["διὰ",56,1],["τοῦ",1,23],["εὐαγγελίου",4222,24],["ἐγὼ",6,156],["ὑμᾶς",5,209],["ἐγέννησα",222,147]],"For though you have ten thousand tutors in Christ, you don’t have many fathers. For in Christ Jesus, I became your father through the Good News."],["16",[["Παρακαλῶ",434,149],["οὖν",227,8],["ὑμᾶς",5,209],["μιμηταί",10941,51],["μου",9994,146],["γίνεσθε",30,742]],"I beg you therefore, be imitators of me."],["17",[["διὰ",56,1],["τοῦτο",16,122],["ἔπεμψα",1597,147],["ὑμῖν",5,86],["Τιμόθεον",1953,7],["ὅς",24,246],["ἐστίν",10,87],["μου",9994,146],["τέκνον",192,20],["ἀγαπητὸν",1920,28],["καὶ",2,8],["πιστὸν",750,28],["ἐν",4,1],["κυρίῳ",7,113],["ὃς",24,246],["ὑμᾶς",5,209],["ἀναμνήσει",1651,120],["τὰς",1,39],["ὁδούς",68,40],["μου",9994,146],["τὰς",1,39],["ἐν",4,1],["Χριστῷ",1072,113],["Ἰησοῦ",211,113],["καθὼς",221,8],["πανταχοῦ",7839,17],["ἐν",4,1],["πάσῃ",11,96],["ἐκκλησίᾳ",563,2],["διδάσκω",545,149]],"Because of this I have sent Timothy to you, who is my beloved and faithful child in the Lord, who will remind you of my ways which are in Christ, even as I teach everywhere in every assembly."],["18",[["Ὡς",36,12],["μὴ",25,12],["ἐρχομένου",55,766],["δέ",14,8],["μου",9994,146],["πρὸς",15,1],["ὑμᾶς",5,209],["ἐφυσιώθησάν",10935,94],["τινες",39,402]],"Now some are puffed up, as though I were not coming to you."],["19",[["ἐλεύσομαι",55,775],["δὲ",14,8],["ταχέως",1563,17],["πρὸς",15,1],["ὑμᾶς",5,209],["ἐὰν",45,8],["ὁ",1,4],["κύριος",7,5],["θελήσῃ",612,160],["καὶ",2,8],["γνώσομαι",79,775],["οὐ",12,12],["τὸν",1,6],["λόγον",48,7],["τῶν",1,76],["πεφυσιωμένων",10935,806],["ἀλλὰ",108,8],["τὴν",1,9],["δύναμιν",98,10]],"But I will come to you shortly, if the Lord is willing. And I will know, not the word of those who are puffed up, but the power."],["20",[["οὐ",12,12],["γὰρ",40,8],["ἐν",4,1],["λόγῳ",48,113],["ἡ",1,11],["βασιλεία",157,13],["τοῦ",1,30],["θεοῦ",20,21],["ἀλλ᾽",108,8],["ἐν",4,1],["δυνάμει",98,2]],"For God’s Kingdom is not in word, but in power."],["21",[["Τί",10010,119],["θέλετε",612,84],["ἐν",4,1],["ῥάβδῳ",493,2],["ἔλθω",55,227],["πρὸς",15,1],["ὑμᾶς",5,209],["ἢ",61,8],["ἐν",4,1],["ἀγάπῃ",1982,2],["πνεύματί",168,53],["τε",209,8],["πραΰτητος",5977,19]],"What do you want? Shall I come to you with a rod, or in love and a spirit of gentleness?"]]