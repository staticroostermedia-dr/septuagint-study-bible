[["1",[["Γνωρίζω",748,149],["δὲ",14,8],["ὑμῖν",5,86],["ἀδελφοί",67,396],["τὸ",1,32],["εὐαγγέλιον",4222,33],["ὃ",24,467],["εὐηγγελισάμην",1817,152],["ὑμῖν",5,86],["ὃ",24,467],["καὶ",2,8],["παρελάβετε",1385,262],["ἐν",4,1],["ᾧ",24,410],["καὶ",2,8],["ἑστήκατε",78,330]],"Now I declare to you, brothers, the Good News which I preached to you, which also you received, in which you also stand,"],["2",[["δι᾽",56,1],["οὗ",24,563],["καὶ",2,8],["σῴζεσθε",172,698],["τίνι",10010,784],["λόγῳ",48,113],["εὐηγγελισάμην",1817,152],["ὑμῖν",5,86],["εἰ",77,8],["κατέχετε",1040,84],["ἐκτὸς",1702,1],["εἰ",77,8],["μὴ",25,12],["εἰκῇ",7134,17],["ἐπιστεύσατε",649,262]],"by which also you are saved, if you hold firmly the word which I preached to you—unless you believed in vain."],["3",[["παρέδωκα",254,147],["γὰρ",40,8],["ὑμῖν",5,86],["ἐν",4,1],["πρώτοις",315,90],["ὃ",24,467],["καὶ",2,8],["παρέλαβον",1385,147],["ὅτι",19,8],["Χριστὸς",1072,5],["ἀπέθανεν",109,3],["ὑπὲρ",139,1],["τῶν",1,123],["ἁμαρτιῶν",119,61],["ἡμῶν",9994,136],["κατὰ",32,1],["τὰς",1,39],["γραφὰς",1505,40]],"For I delivered to you first of all that which I also received: that Christ died for our sins according to the Scriptures,"],["4",[["καὶ",2,8],["ὅτι",19,8],["ἐτάφη",392,38],["καὶ",2,8],["ὅτι",19,8],["ἐγήγερται",746,722],["τῇ",1,95],["ἡμέρᾳ",28,2],["τῇ",1,95],["τρίτῃ",357,96],["κατὰ",32,1],["τὰς",1,39],["γραφὰς",1505,40]],"that he was buried, that he was raised on the third day according to the Scriptures,"],["5",[["καὶ",2,8],["ὅτι",19,8],["ὤφθη",10028,38],["Κηφᾷ",10440,113],["εἶτα",2450,17],["τοῖς",1,138],["δώδεκα",556,372]],"and that he appeared to Cephas, then to the twelve."],["6",[["ἔπειτα",6560,17],["ὤφθη",10028,38],["ἐπάνω",491,1],["πεντακοσίοις",818,215],["ἀδελφοῖς",67,139],["ἐφάπαξ",10856,17],["ἐξ",21,1],["ὧν",24,303],["οἱ",1,128],["πλείονες",938,130],["μένουσιν",681,191],["ἕως",42,1],["ἄρτι",2665,17],["τινὲς",39,402],["δὲ",14,8],["ἐκοιμήθησαν",301,94]],"Then he appeared to over five hundred brothers at once, most of whom remain until now, but some have also fallen asleep."],["7",[["ἔπειτα",6560,17],["ὤφθη",10028,38],["Ἰακώβῳ",10019,113],["εἶτα",2450,17],["τοῖς",1,138],["ἀποστόλοις",10080,139],["πᾶσιν",11,215]],"Then he appeared to James, then to all the apostles,"],["8",[["ἔσχατον",410,29],["δὲ",14,8],["πάντων",11,79],["ὡσπερεὶ",10979,8],["τῷ",1,52],["ἐκτρώματι",5361,53],["ὤφθη",10028,38],["κἀμοί",10000,8]],"and last of all, as to the child born at the wrong time, he appeared to me also."],["9",[["ἐγὼ",6,156],["γάρ",40,8],["εἰμι",10,149],["ὁ",1,4],["ἐλάχιστος",2418,16],["τῶν",1,76],["ἀποστόλων",10080,77],["ὃς",24,246],["οὐκ",12,12],["εἰμὶ",10,149],["ἱκανὸς",1007,16],["καλεῖσθαι",128,634],["ἀπόστολος",10080,5],["διότι",177,8],["ἐδίωξα",533,147],["τὴν",1,9],["ἐκκλησίαν",563,10],["τοῦ",1,30],["θεοῦ",20,21]],"For I am the least of the apostles, who is not worthy to be called an apostle, because I persecuted the assembly of God."],["10",[["χάριτι",368,2],["δὲ",14,8],["θεοῦ",20,21],["εἰμι",10,149],["ὅ",24,677],["εἰμι",10,149],["καὶ",2,8],["ἡ",1,11],["χάρις",368,13],["αὐτοῦ",3,48],["ἡ",1,11],["εἰς",8,1],["ἐμὲ",6,161],["οὐ",12,12],["κενὴ",780,15],["ἐγενήθη",30,715],["ἀλλὰ",108,8],["περισσότερον",10096,17],["αὐτῶν",3,41],["πάντων",11,163],["ἐκοπίασα",921,147],["οὐκ",12,12],["ἐγὼ",6,156],["δέ",14,8],["ἀλλ᾽",108,8],["ἡ",1,11],["χάρις",368,13],["τοῦ",1,30],["θεοῦ",20,21],["ἡ",1,11],["σὺν",310,1],["ἐμοί",6,151]],"But by the grace of God I am what I am. His grace which was given to me was not futile, but I worked more than all of them; yet not I, but the grace of God which was with me."],["11",[["εἴτε",2713,8],["οὖν",227,8],["ἐγὼ",6,156],["εἴτε",2713,8],["ἐκεῖνοι",80,213],["οὕτως",9989,17],["κηρύσσομεν",1438,241],["καὶ",2,8],["οὕτως",9989,17],["ἐπιστεύσατε",649,262]],"Whether then it is I or they, so we preach, and so you believed."],["12",[["Εἰ",77,8],["δὲ",14,8],["Χριστὸς",1072,5],["κηρύσσεται",1438,449],["ὅτι",19,8],["ἐκ",21,1],["νεκρῶν",659,163],["ἐγήγερται",746,722],["πῶς",10049,12],["λέγουσιν",31,191],["ἐν",4,1],["ὑμῖν",5,86],["τινες",39,402],["ὅτι",19,8],["ἀνάστασις",4027,13],["νεκρῶν",659,163],["οὐκ",12,12],["ἔστιν",10,87]],"Now if Christ is preached, that he has been raised from the dead, how do some among you say that there is no resurrection of the dead?"],["13",[["εἰ",77,8],["δὲ",14,8],["ἀνάστασις",4027,13],["νεκρῶν",659,163],["οὐκ",12,12],["ἔστιν",10,87],["οὐδὲ",106,8],["Χριστὸς",1072,5],["ἐγήγερται",746,722]],"But if there is no resurrection of the dead, neither has Christ been raised."],["14",[["εἰ",77,8],["δὲ",14,8],["Χριστὸς",1072,5],["οὐκ",12,12],["ἐγήγερται",746,722],["κενὸν",780,28],["ἄρα",985,8],["καὶ",2,8],["τὸ",1,27],["κήρυγμα",4287,20],["ἡμῶν",9994,136],["κενὴ",780,15],["καὶ",2,8],["ἡ",1,11],["πίστις",887,13],["ὑμῶν",5,136]],"If Christ has not been raised, then our preaching is in vain and your faith also is in vain."],["15",[["εὑρισκόμεθα",101,885],["δὲ",14,8],["καὶ",2,8],["ψευδομάρτυρες",10192,51],["τοῦ",1,30],["θεοῦ",20,21],["ὅτι",19,8],["ἐμαρτυρήσαμεν",2094,285],["κατὰ",32,1],["τοῦ",1,30],["θεοῦ",20,21],["ὅτι",19,8],["ἤγειρεν",746,3],["τὸν",1,6],["Χριστὸν",1072,7],["ὃν",24,106],["οὐκ",12,12],["ἤγειρεν",746,3],["εἴπερ",77,8],["ἄρα",985,8],["νεκροὶ",659,130],["οὐκ",12,12],["ἐγείρονται",746,507]],"Yes, we are also found false witnesses of God, because we testified about God that he raised up Christ, whom he didn’t raise up if it is true that the dead are not raised."],["16",[["εἰ",77,8],["γὰρ",40,8],["νεκροὶ",659,130],["οὐκ",12,12],["ἐγείρονται",746,507],["οὐδὲ",106,8],["Χριστὸς",1072,5],["ἐγήγερται",746,722]],"For if the dead aren’t raised, neither has Christ been raised."],["17",[["εἰ",77,8],["δὲ",14,8],["Χριστὸς",1072,5],["οὐκ",12,12],["ἐγήγερται",746,722],["ματαία",654,15],["ἡ",1,11],["πίστις",887,13],["ὑμῶν",5,136],["ἔτι",111,17],["ἐστὲ",10,84],["ἐν",4,1],["ταῖς",1,70],["ἁμαρτίαις",119,71],["ὑμῶν",5,136]],"If Christ has not been raised, your faith is vain; you are still in your sins."],["18",[["ἄρα",985,8],["καὶ",2,8],["οἱ",1,128],["κοιμηθέντες",301,243],["ἐν",4,1],["Χριστῷ",1072,113],["ἀπώλοντο",596,184]],"Then they also who are fallen asleep in Christ have perished."],["19",[["εἰ",77,8],["ἐν",4,1],["τῇ",1,95],["ζωῇ",216,2],["ταύτῃ",16,200],["ἐν",4,1],["Χριστῷ",1072,113],["ἠλπικότες",514,263],["ἐσμὲν",10,241],["μόνον",302,29],["ἐλεεινότεροι",10980,130],["πάντων",11,163],["ἀνθρώπων",43,77],["ἐσμέν",10,241]],"If we have only hoped in Christ in this life, we are of all men most pitiable."],["20",[["Νυνὶ",2099,17],["δὲ",14,8],["Χριστὸς",1072,5],["ἐγήγερται",746,722],["ἐκ",21,1],["νεκρῶν",659,163],["ἀπαρχὴ",693,13],["τῶν",1,76],["κεκοιμημένων",301,558]],"But now Christ has been raised from the dead. He became the first fruit of those who are asleep."],["21",[["Ἐπειδὴ",1995,8],["γὰρ",40,8],["δι᾽",56,1],["ἀνθρώπου",43,21],["θάνατος",170,5],["καὶ",2,8],["δι᾽",56,1],["ἀνθρώπου",43,21],["ἀνάστασις",4027,13],["νεκρῶν",659,163]],"For since death came by man, the resurrection of the dead also came by man."],["22",[["ὥσπερ",226,8],["γὰρ",40,8],["ἐν",4,1],["τῷ",1,110],["Ἀδὰμ",1367,113],["πάντες",11,130],["ἀποθνῄσκουσιν",109,191],["οὕτως",9989,17],["καὶ",2,8],["ἐν",4,1],["τῷ",1,110],["Χριστῷ",1072,113],["πάντες",11,130],["ζῳοποιηθήσονται",3533,135]],"For as in Adam all die, so also in Christ all will be made alive."],["23",[["ἕκαστος",171,16],["δὲ",14,8],["ἐν",4,1],["τῷ",1,52],["ἰδίῳ",683,34],["τάγματι",2198,53],["ἀπαρχὴ",693,13],["Χριστός",1072,5],["ἔπειτα",6560,17],["οἱ",1,128],["τοῦ",1,30],["Χριστοῦ",1072,21],["ἐν",4,1],["τῇ",1,95],["παρουσίᾳ",4349,2],["αὐτοῦ",3,48]],"But each in his own order: Christ the first fruits, then those who are Christ’s at his coming."],["24",[["εἶτα",2450,17],["τὸ",1,27],["τέλος",373,20],["ὅταν",319,1],["παραδιδῷ",254,173],["τὴν",1,9],["βασιλείαν",157,10],["τῷ",1,110],["θεῷ",20,113],["καὶ",2,8],["πατρί",44,113],["ὅταν",319,1],["καταργήσῃ",4259,160],["πᾶσαν",11,37],["ἀρχὴν",270,10],["καὶ",2,8],["πᾶσαν",11,37],["ἐξουσίαν",929,10],["καὶ",2,8],["δύναμιν",98,10]],"Then the end comes, when he will deliver up the Kingdom to God the Father, when he will have abolished all rule and all authority and power."],["25",[["δεῖ",1158,87],["γὰρ",40,8],["αὐτὸν",3,82],["βασιλεύειν",151,54],["ἄχρι",4062,1],["οὗ",24,367],["θῇ",110,160],["πάντας",11,58],["τοὺς",1,56],["ἐχθροὺς",135,31],["ὑπὸ",122,1],["τοὺς",1,56],["πόδας",210,31],["αὐτοῦ",3,48]],"For he must reign until he has put all his enemies under his feet."],["26",[["ἔσχατος",410,16],["ἐχθρὸς",135,5],["καταργεῖται",4259,449],["ὁ",1,4],["θάνατος",170,5]],"The last enemy that will be abolished is death."],["27",[["πάντα",11,65],["γὰρ",40,8],["ὑπέταξεν",1497,3],["ὑπὸ",122,1],["τοὺς",1,56],["πόδας",210,31],["αὐτοῦ",3,48],["ὅταν",319,8],["δὲ",14,8],["εἴπῃ",9997,160],["ὅτι",19,8],["πάντα",11,74],["ὑποτέτακται",1497,722],["δῆλον",3055,28],["ὅτι",19,8],["ἐκτὸς",1702,1],["τοῦ",1,30],["ὑποτάξαντος",1497,513],["αὐτῷ",3,49],["τὰ",1,42],["πάντα",11,65]],"For, “He put all things in subjection under his feet.” But when he says, “All things are put in subjection”, it is evident that he is excepted who subjected all things to him."],["28",[["ὅταν",319,8],["δὲ",14,8],["ὑποταγῇ",1497,333],["αὐτῷ",3,49],["τὰ",1,253],["πάντα",11,74],["τότε",250,17],["καὶ",2,8],["αὐτὸς",3,158],["ὁ",1,4],["υἱὸς",13,5],["ὑποταγήσεται",1497,125],["τῷ",1,110],["ὑποτάξαντι",1497,354],["αὐτῷ",3,49],["τὰ",1,42],["πάντα",11,65],["ἵνα",102,8],["ᾖ",10,173],["ὁ",1,4],["θεὸς",20,5],["τὰ",1,253],["πάντα",11,74],["ἐν",4,1],["πᾶσιν",11,90]],"When all things have been subjected to him, then the Son will also himself be subjected to him who subjected all things to him, that God may be all in all."],["29",[["Ἐπεὶ",1236,8],["τί",10010,119],["ποιήσουσιν",23,207],["οἱ",1,128],["βαπτιζόμενοι",4169,772],["ὑπὲρ",139,1],["τῶν",1,76],["νεκρῶν",659,163],["εἰ",77,8],["ὅλως",10038,17],["νεκροὶ",659,130],["οὐκ",12,12],["ἐγείρονται",746,507],["τί",10010,119],["καὶ",2,8],["βαπτίζονται",4169,507],["ὑπὲρ",139,1],["αὐτῶν",3,41]],"Or else what will they do who are baptized for the dead? If the dead aren’t raised at all, why then are they baptized for the dead?"],["30",[["τί",10010,119],["καὶ",2,8],["ἡμεῖς",9994,208],["κινδυνεύομεν",3559,241],["πᾶσαν",11,37],["ὥραν",838,10]],"Why do we also stand in jeopardy every hour?"],["31",[["καθ᾽",32,1],["ἡμέραν",28,10],["ἀποθνῄσκω",109,149],["νὴ",5865,12],["τὴν",1,9],["ὑμετέραν",10347,37],["καύχησιν",2730,10],["ἀδελφοί",67,396],["ἣν",24,124],["ἔχω",124,149],["ἐν",4,1],["Χριστῷ",1072,113],["Ἰησοῦ",211,113],["τῷ",1,110],["κυρίῳ",7,113],["ἡμῶν",9994,136]],"I affirm, by the boasting in you which I have in Christ Jesus our Lord, I die daily."],["32",[["εἰ",77,8],["κατὰ",32,1],["ἄνθρωπον",43,7],["ἐθηριομάχησα",10981,147],["ἐν",4,1],["Ἐφέσῳ",10672,2],["τί",10010,238],["μοι",9994,151],["τὸ",1,27],["ὄφελος",9852,20],["εἰ",77,8],["νεκροὶ",659,130],["οὐκ",12,12],["ἐγείρονται",746,507],["φάγωμεν",269,75],["καὶ",2,8],["πίωμεν",212,75],["αὔριον",857,17],["γὰρ",40,8],["ἀποθνῄσκομεν",109,241]],"If I fought with animals at Ephesus for human purposes, what does it profit me? If the dead are not raised, then “let’s eat and drink, for tomorrow we die.”"],["33",[["μὴ",25,12],["πλανᾶσθε",464,809],["φθείρουσιν",2199,191],["ἤθη",3462,43],["χρηστὰ",1359,65],["ὁμιλίαι",4645,180],["κακαί",161,187]],"Don’t be deceived! “Evil companionships corrupt good morals.”"],["34",[["ἐκνήψατε",4073,69],["δικαίως",2344,17],["καὶ",2,8],["μὴ",25,12],["ἁμαρτάνετε",237,307],["ἀγνωσίαν",5159,10],["γὰρ",40,8],["θεοῦ",20,21],["τινες",39,402],["ἔχουσιν",124,191],["πρὸς",15,1],["ἐντροπὴν",3435,10],["ὑμῖν",5,86],["λαλῶ",50,149]],"Wake up righteously and don’t sin, for some have no knowledge of God. I say this to your shame."],["35",[["Ἀλλ᾽",108,8],["ἐρεῖ",10054,120],["τις",39,150],["πῶς",10049,12],["ἐγείρονται",746,507],["οἱ",1,128],["νεκροί",659,130],["ποίῳ",1332,743],["δὲ",14,8],["σώματι",454,53],["ἔρχονται",55,756]],"But someone will say, “How are the dead raised?” and, “With what kind of body do they come?”"],["36",[["ἄφρων",439,309],["σὺ",5,156],["ὃ",24,467],["σπείρεις",793,145],["οὐ",12,12],["ζῳοποιεῖται",3533,449],["ἐὰν",45,8],["μὴ",25,12],["ἀποθάνῃ",109,160]],"You foolish one, that which you yourself sow is not made alive unless it dies."],["37",[["καὶ",2,8],["ὃ",24,467],["σπείρεις",793,145],["οὐ",12,12],["τὸ",1,32],["σῶμα",454,33],["τὸ",1,32],["γενησόμενον",30,861],["σπείρεις",793,145],["ἀλλὰ",108,8],["γυμνὸν",1299,59],["κόκκον",5770,7],["εἰ",77,8],["τύχοι",1451,216],["σίτου",665,21],["ἤ",61,8],["τινος",39,860],["τῶν",1,44],["λοιπῶν",523,79]],"That which you sow, you don’t sow the body that will be, but a bare grain, maybe of wheat, or of some other kind."],["38",[["ὁ",1,4],["δὲ",14,8],["θεὸς",20,5],["δίδωσιν",33,87],["αὐτῷ",3,49],["σῶμα",454,33],["καθὼς",221,8],["ἠθέλησεν",612,3],["καὶ",2,8],["ἑκάστῳ",171,111],["τῶν",1,44],["σπερμάτων",218,45],["ἴδιον",683,29],["σῶμα",454,33]],"But God gives it a body even as it pleased him, and to each seed a body of its own."],["39",[["Οὐ",12,12],["πᾶσα",11,15],["σὰρξ",287,13],["ἡ",1,11],["αὐτὴ",3,179],["σὰρξ",287,13],["ἀλλ᾽",108,8],["ἄλλη",584,15],["μὲν",281,12],["ἀνθρώπων",43,77],["ἄλλη",584,15],["δὲ",14,8],["σὰρξ",287,13],["κτηνῶν",223,45],["ἄλλη",584,15],["δὲ",14,8],["σὰρξ",287,13],["πτηνῶν",10982,79],["ἄλλη",584,15],["δὲ",14,8],["ἰχθύων",1372,77]],"All flesh is not the same flesh, but there is one flesh of men, another flesh of animals, another of fish, and another of birds."],["40",[["καὶ",2,8],["σώματα",454,63],["ἐπουράνια",4098,74],["καὶ",2,8],["σώματα",454,63],["ἐπίγεια",10447,74],["ἀλλ᾽",108,8],["ἑτέρα",253,15],["μὲν",281,12],["ἡ",1,11],["τῶν",1,44],["ἐπουρανίων",4098,79],["δόξα",141,13],["ἑτέρα",253,15],["δὲ",14,8],["ἡ",1,11],["τῶν",1,44],["ἐπιγείων",10447,79]],"There are also celestial bodies and terrestrial bodies; but the glory of the celestial differs from that of the terrestrial."],["41",[["ἄλλη",584,15],["δόξα",141,13],["ἡλίου",323,21],["καὶ",2,8],["ἄλλη",584,15],["δόξα",141,13],["σελήνης",1207,19],["καὶ",2,8],["ἄλλη",584,15],["δόξα",141,13],["ἀστέρων",1699,77],["ἀστὴρ",1699,5],["γὰρ",40,8],["ἀστέρος",1699,21],["διαφέρει",2447,87],["ἐν",4,1],["δόξῃ",141,2]],"There is one glory of the sun, another glory of the moon, and another glory of the stars; for one star differs from another star in glory."],["42",[["Οὕτως",9989,17],["καὶ",2,8],["ἡ",1,11],["ἀνάστασις",4027,13],["τῶν",1,76],["νεκρῶν",659,163],["σπείρεται",793,449],["ἐν",4,1],["φθορᾷ",3377,2],["ἐγείρεται",746,449],["ἐν",4,1],["ἀφθαρσίᾳ",4054,2]],"So also is the resurrection of the dead. The body is sown perishable; it is raised imperishable."],["43",[["σπείρεται",793,449],["ἐν",4,1],["ἀτιμίᾳ",1049,2],["ἐγείρεται",746,449],["ἐν",4,1],["δόξῃ",141,2],["σπείρεται",793,449],["ἐν",4,1],["ἀσθενείᾳ",3413,2],["ἐγείρεται",746,449],["ἐν",4,1],["δυνάμει",98,2]],"It is sown in dishonor; it is raised in glory. It is sown in weakness; it is raised in power."],["44",[["σπείρεται",793,449],["σῶμα",454,20],["ψυχικόν",5154,28],["ἐγείρεται",746,449],["σῶμα",454,20],["πνευματικόν",10815,28],["εἰ",77,8],["ἔστιν",10,87],["σῶμα",454,20],["ψυχικόν",5154,28],["ἔστιν",10,87],["καὶ",2,8],["πνευματικόν",10815,28]],"It is sown a natural body; it is raised a spiritual body. There is a natural body and there is also a spiritual body."],["45",[["οὕτως",9989,17],["καὶ",2,8],["γέγραπται",186,722],["ἐγένετο",30,737],["ὁ",1,4],["πρῶτος",315,16],["ἄνθρωπος",43,5],["Ἀδὰμ",1367,5],["εἰς",8,1],["ψυχὴν",63,10],["ζῶσαν",107,73],["ὁ",1,4],["ἔσχατος",410,16],["Ἀδὰμ",1367,5],["εἰς",8,1],["πνεῦμα",168,33],["ζῳοποιοῦν",3533,47]],"So also it is written, “The first man Adam became a living soul.” The last Adam became a life-giving spirit."],["46",[["ἀλλ᾽",108,8],["οὐ",12,12],["πρῶτον",315,28],["τὸ",1,27],["πνευματικὸν",10815,28],["ἀλλὰ",108,8],["τὸ",1,27],["ψυχικόν",5154,28],["ἔπειτα",6560,17],["τὸ",1,27],["πνευματικόν",10815,28]],"However, that which is spiritual isn’t first, but that which is natural, then that which is spiritual."],["47",[["Ὁ",1,4],["πρῶτος",315,16],["ἄνθρωπος",43,5],["ἐκ",21,1],["γῆς",26,19],["χοϊκός",10983,16],["ὁ",1,4],["δεύτερος",271,16],["ἄνθρωπος",43,5],["ἐξ",21,1],["οὐρανοῦ",94,21]],"The first man is of the earth, made of dust. The second man is the Lord from heaven."],["48",[["οἷος",2031,246],["ὁ",1,4],["χοϊκός",10983,16],["τοιοῦτοι",630,213],["καὶ",2,8],["οἱ",1,128],["χοϊκοί",10983,130],["καὶ",2,8],["οἷος",2031,246],["ὁ",1,4],["ἐπουράνιος",4098,16],["τοιοῦτοι",630,213],["καὶ",2,8],["οἱ",1,128],["ἐπουράνιοι",4098,130]],"As is the one made of dust, such are those who are also made of dust; and as is the heavenly, such are they also that are heavenly."],["49",[["καὶ",2,8],["καθὼς",221,8],["ἐφορέσαμεν",3990,285],["τὴν",1,9],["εἰκόνα",1136,10],["τοῦ",1,30],["χοϊκοῦ",10983,153],["φορέσομεν",3990,269],["καὶ",2,8],["τὴν",1,9],["εἰκόνα",1136,10],["τοῦ",1,30],["ἐπουρανίου",4098,153]],"As we have borne the image of those made of dust, let’s also bear the image of the heavenly."],["50",[["Τοῦτο",16,122],["δέ",14,8],["φημι",660,149],["ἀδελφοί",67,396],["ὅτι",19,8],["σὰρξ",287,13],["καὶ",2,8],["αἷμα",148,20],["βασιλείαν",157,10],["θεοῦ",20,21],["κληρονομῆσαι",370,100],["οὐ",12,12],["δύναται",185,728],["οὐδὲ",106,8],["ἡ",1,11],["φθορὰ",3377,13],["τὴν",1,9],["ἀφθαρσίαν",4054,10],["κληρονομεῖ",370,87]],"Now I say this, brothers, that flesh and blood can’t inherit God’s Kingdom; neither does the perishable inherit imperishable."],["51",[["ἰδοὺ",51,316],["μυστήριον",1773,33],["ὑμῖν",5,86],["λέγω",31,149],["πάντες",11,130],["οὐ",12,12],["κοιμηθησόμεθα",301,349],["πάντες",11,130],["δὲ",14,8],["ἀλλαγησόμεθα",1172,349]],"Behold, I tell you a mystery. We will not all sleep, but we will all be changed,"],["52",[["ἐν",4,1],["ἀτόμῳ",10984,34],["ἐν",4,1],["ῥιπῇ",10985,2],["ὀφθαλμοῦ",91,21],["ἐν",4,1],["τῇ",1,95],["ἐσχάτῃ",410,96],["σάλπιγγι",580,2],["σαλπίσει",845,120],["γάρ",40,8],["καὶ",2,8],["οἱ",1,128],["νεκροὶ",659,130],["ἐγερθήσονται",746,135],["ἄφθαρτοι",6389,130],["καὶ",2,8],["ἡμεῖς",9994,208],["ἀλλαγησόμεθα",1172,349]],"in a moment, in the twinkling of an eye, at the last trumpet. For the trumpet will sound and the dead will be raised incorruptible, and we will be changed."],["53",[["δεῖ",1158,87],["γὰρ",40,8],["τὸ",1,32],["φθαρτὸν",5120,29],["τοῦτο",16,122],["ἐνδύσασθαι",516,103],["ἀφθαρσίαν",4054,10],["καὶ",2,8],["τὸ",1,32],["θνητὸν",2895,29],["τοῦτο",16,122],["ἐνδύσασθαι",516,103],["ἀθανασίαν",3391,10]],"For this perishable body must become imperishable, and this mortal must put on immortality."],["54",[["ὅταν",319,8],["δὲ",14,8],["τὸ",1,27],["φθαρτὸν",5120,28],["τοῦτο",16,344],["ἐνδύσηται",516,236],["ἀφθαρσίαν",4054,10],["καὶ",2,8],["τὸ",1,27],["θνητὸν",2895,28],["τοῦτο",16,344],["ἐνδύσηται",516,236],["ἀθανασίαν",3391,10],["τότε",250,17],["γενήσεται",30,718],["ὁ",1,4],["λόγος",48,5],["ὁ",1,4],["γεγραμμένος",186,228],["κατεπόθη",1183,38],["ὁ",1,4],["θάνατος",170,5],["εἰς",8,1],["νῖκος",2100,33]],"But when this perishable body will have become imperishable, and this mortal will have put on immortality, then what is written will happen: “Death is swallowed up in victory.”"],["55",[["ποῦ",9996,17],["σου",5,146],["θάνατε",170,250],["τὸ",1,27],["νῖκος",2100,20],["ποῦ",9996,17],["σου",5,146],["θάνατε",170,250],["τὸ",1,27],["κέντρον",3875,20]],"“Death, where is your sting? Hades, where is your victory?”"],["56",[["τὸ",1,27],["δὲ",14,8],["κέντρον",3875,20],["τοῦ",1,30],["θανάτου",170,21],["ἡ",1,11],["ἁμαρτία",119,13],["ἡ",1,11],["δὲ",14,8],["δύναμις",98,13],["τῆς",1,18],["ἁμαρτίας",119,19],["ὁ",1,4],["νόμος",140,5]],"The sting of death is sin, and the power of sin is the law."],["57",[["Τῷ",1,110],["δὲ",14,8],["θεῷ",20,113],["χάρις",368,13],["τῷ",1,110],["διδόντι",33,390],["ἡμῖν",9994,86],["τὸ",1,32],["νῖκος",2100,33],["διὰ",56,1],["τοῦ",1,30],["κυρίου",7,21],["ἡμῶν",9994,136],["Ἰησοῦ",211,21],["Χριστοῦ",1072,21]],"But thanks be to God, who gives us the victory through our Lord Jesus Christ."],["58",[["ὥστε",346,8],["ἀδελφοί",67,396],["μου",9994,146],["ἀγαπητοί",1920,537],["ἑδραῖοι",10951,130],["γίνεσθε