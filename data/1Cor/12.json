[["1",[["Περὶ",72,1],["δὲ",14,8],["τῶν",1,44],["πνευματικῶν",10815,79],["ἀδελφοί",67,396],["οὐ",12,12],["θέλω",612,149],["ὑμᾶς",5,209],["ἀγνοεῖν",1846,54]],"Now concerning spiritual things, brothers, I don’t want you to be ignorant."],["2",[["οἴδατε",1168,330],["ὅτι",19,8],["ὅτε",432,8],["ἔθνη",60,63],["ἦτε",10,339],["πρὸς",15,1],["τὰ",1,42],["εἴδωλα",627,43],["τὰ",1,42],["ἄφωνα",5274,65],["ὡς",36,12],["ἂν",83,12],["ἤγεσθε",224,923],["ἀπαγόμενοι",1212,772]],"You know that when you were heathen, you were led away to those mute idols, however you might be led."],["3",[["διὸ",1466,8],["γνωρίζω",748,149],["ὑμῖν",5,86],["ὅτι",19,8],["οὐδεὶς",228,16],["ἐν",4,1],["πνεύματι",168,53],["θεοῦ",20,21],["λαλῶν",50,67],["λέγει",31,87],["ἀνάθεμα",1695,20],["Ἰησοῦς",211,5],["καὶ",2,8],["οὐδεὶς",228,16],["δύναται",185,728],["εἰπεῖν",31,100],["κύριος",7,5],["Ἰησοῦς",211,5],["εἰ",77,8],["μὴ",25,12],["ἐν",4,1],["πνεύματι",168,53],["ἁγίῳ",75,34]],"Therefore I make known to you that no man speaking by God’s Spirit says, “Jesus is accursed.” No one can say, “Jesus is Lord,” but by the Holy Spirit."],["4",[["διαιρέσεις",1301,180],["δὲ",14,8],["χαρισμάτων",10814,45],["εἰσίν",10,191],["τὸ",1,27],["δὲ",14,8],["αὐτὸ",3,359],["πνεῦμα",168,20]],"Now there are various kinds of gifts, but the same Spirit."],["5",[["καὶ",2,8],["διαιρέσεις",1301,180],["διακονιῶν",6977,61],["εἰσιν",10,191],["καὶ",2,8],["ὁ",1,4],["αὐτὸς",3,158],["κύριος",7,5]],"There are various kinds of service, and the same Lord."],["6",[["καὶ",2,8],["διαιρέσεις",1301,180],["ἐνεργημάτων",10971,45],["εἰσίν",10,191],["ὁ",1,4],["δὲ",14,8],["αὐτὸς",3,158],["θεὸς",20,5],["ὁ",1,4],["ἐνεργῶν",3432,67],["τὰ",1,42],["πάντα",11,65],["ἐν",4,1],["πᾶσιν",11,215]],"There are various kinds of workings, but the same God who works all things in all."],["7",[["Ἑκάστῳ",171,111],["δὲ",14,8],["δίδοται",33,449],["ἡ",1,11],["φανέρωσις",10972,13],["τοῦ",1,23],["πνεύματος",168,24],["πρὸς",15,1],["τὸ",1,32],["συμφέρον",2495,47]],"But to each one is given the manifestation of the Spirit for the profit of all."],["8",[["ᾧ",24,202],["μὲν",281,12],["γὰρ",40,8],["διὰ",56,1],["τοῦ",1,23],["πνεύματος",168,24],["δίδοται",33,449],["λόγος",48,5],["σοφίας",242,19],["ἄλλῳ",584,111],["δὲ",14,8],["λόγος",48,5],["γνώσεως",753,19],["κατὰ",32,1],["τὸ",1,32],["αὐτὸ",3,121],["πνεῦμα",168,33]],"For to one is given through the Spirit the word of wisdom, and to another the word of knowledge according to the same Spirit,"],["9",[["ἑτέρῳ",253,111],["πίστις",887,13],["ἐν",4,1],["τῷ",1,52],["αὐτῷ",3,233],["πνεύματι",168,53],["ἄλλῳ",584,111],["δὲ",14,8],["χαρίσματα",10814,63],["ἰαμάτων",2683,45],["ἐν",4,1],["τῷ",1,52],["ἑνὶ",58,34],["πνεύματι",168,53]],"to another faith by the same Spirit, and to another gifts of healings by the same Spirit,"],["10",[["ἄλλῳ",584,111],["δὲ",14,8],["ἐνεργήματα",10971,63],["δυνάμεων",98,61],["ἄλλῳ",584,111],["δὲ",14,8],["προφητεία",2285,13],["ἄλλῳ",584,111],["δὲ",14,8],["διακρίσεις",7069,180],["πνευμάτων",168,45],["ἑτέρῳ",253,111],["γένη",519,63],["γλωσσῶν",388,61],["ἄλλῳ",584,111],["δὲ",14,8],["ἑρμηνεία",6543,13],["γλωσσῶν",388,61]],"and to another workings of miracles, and to another prophecy, and to another discerning of spirits, to another different kinds of languages, and to another the interpretation of languages."],["11",[["πάντα",11,65],["δὲ",14,8],["ταῦτα",16,248],["ἐνεργεῖ",3432,87],["τὸ",1,27],["ἓν",58,28],["καὶ",2,8],["τὸ",1,27],["αὐτὸ",3,359],["πνεῦμα",168,20],["διαιροῦν",1112,36],["ἰδίᾳ",683,96],["ἑκάστῳ",171,111],["καθὼς",221,8],["βούλεται",463,728]],"But the one and the same Spirit produces all of these, distributing to each one separately as he desires."],["12",[["Καθάπερ",690,8],["γὰρ",40,8],["τὸ",1,27],["σῶμα",454,20],["ἕν",58,28],["ἐστιν",10,87],["καὶ",2,8],["μέλη",1593,43],["πολλὰ",74,65],["ἔχει",124,87],["πάντα",11,74],["δὲ",14,8],["τὰ",1,253],["μέλη",1593,63],["τοῦ",1,23],["σώματος",454,24],["πολλὰ",74,74],["ὄντα",10,289],["ἕν",58,28],["ἐστιν",10,87],["σῶμα",454,20],["οὕτως",71,17],["καὶ",2,8],["ὁ",1,4],["Χριστός",1072,5]],"For as the body is one and has many members, and all the members of the body, being many, are one body; so also is Christ."],["13",[["καὶ",2,8],["γὰρ",40,8],["ἐν",4,1],["ἑνὶ",58,34],["πνεύματι",168,53],["ἡμεῖς",9994,208],["πάντες",11,130],["εἰς",8,1],["ἓν",58,29],["σῶμα",454,33],["ἐβαπτίσθημεν",4169,491],["εἴτε",2713,8],["Ἰουδαῖοι",285,51],["εἴτε",2713,8],["Ἕλληνες",2545,51],["εἴτε",2713,8],["δοῦλοι",136,51],["εἴτε",2713,8],["ἐλεύθεροι",1456,130],["καὶ",2,8],["πάντες",11,130],["ἓν",58,29],["πνεῦμα",168,33],["ἐποτίσθημεν",790,491]],"For in one Spirit we were all baptized into one body, whether Jews or Greeks, whether bond or free; and were all given to drink into one Spirit."],["14",[["καὶ",2,8],["γὰρ",40,8],["τὸ",1,27],["σῶμα",454,20],["οὐκ",12,12],["ἔστιν",10,87],["ἓν",58,28],["μέλος",1593,20],["ἀλλὰ",108,8],["πολλά",74,74]],"For the body is not one member, but many."],["15",[["ἐὰν",45,8],["εἴπῃ",31,160],["ὁ",1,4],["πούς",210,5],["ὅτι",19,8],["οὐκ",12,12],["εἰμὶ",10,149],["χείρ",37,13],["οὐκ",12,12],["εἰμὶ",10,149],["ἐκ",21,1],["τοῦ",1,23],["σώματος",454,24],["οὐ",12,12],["παρὰ",73,1],["τοῦτο",16,122],["οὐκ",12,12],["ἔστιν",10,87],["ἐκ",21,1],["τοῦ",1,23],["σώματος",454,24]],"If the foot would say, “Because I’m not the hand, I’m not part of the body,” it is not therefore not part of the body."],["16",[["καὶ",2,8],["ἐὰν",45,8],["εἴπῃ",31,160],["τὸ",1,27],["οὖς",328,20],["ὅτι",19,8],["οὐκ",12,12],["εἰμὶ",10,149],["ὀφθαλμός",91,5],["οὐκ",12,12],["εἰμὶ",10,149],["ἐκ",21,1],["τοῦ",1,23],["σώματος",454,24],["οὐ",12,12],["παρὰ",73,1],["τοῦτο",16,122],["οὐκ",12,12],["ἔστιν",10,87],["ἐκ",21,1],["τοῦ",1,23],["σώματος",454,24]],"If the ear would say, “Because I’m not the eye, I’m not part of the body,” it’s not therefore not part of the body."],["17",[["εἰ",77,8],["ὅλον",235,28],["τὸ",1,27],["σῶμα",454,20],["ὀφθαλμός",91,5],["ποῦ",9996,17],["ἡ",1,11],["ἀκοή",1047,13],["εἰ",77,8],["ὅλον",235,28],["ἀκοή",1047,13],["ποῦ",9996,17],["ἡ",1,11],["ὄσφρησις",10973,13]],"If the whole body were an eye, where would the hearing be? If the whole were hearing, where would the smelling be?"],["18",[["νυνὶ",2099,17],["δὲ",14,8],["ὁ",1,4],["θεὸς",20,5],["ἔθετο",110,26],["τὰ",1,42],["μέλη",1593,43],["ἓν",58,29],["ἕκαστον",171,29],["αὐτῶν",3,168],["ἐν",4,1],["τῷ",1,52],["σώματι",454,53],["καθὼς",221,8],["ἠθέλησεν",612,3]],"But now God has set the members, each one of them, in the body, just as he desired."],["19",[["εἰ",77,8],["δὲ",14,8],["ἦν",10,14],["τὰ",1,253],["πάντα",11,74],["ἓν",58,28],["μέλος",1593,20],["ποῦ",9996,17],["τὸ",1,27],["σῶμα",454,20]],"If they were all one member, where would the body be?"],["20",[["νῦν",90,17],["δὲ",14,8],["πολλὰ",74,74],["μὲν",281,12],["μέλη",1593,63],["ἓν",58,28],["δὲ",14,8],["σῶμα",454,20]],"But now they are many members, but one body."],["21",[["οὐ",12,12],["δύναται",185,728],["δὲ",14,8],["ὁ",1,4],["ὀφθαλμὸς",91,5],["εἰπεῖν",31,100],["τῇ",1,95],["χειρί",37,2],["χρείαν",1006,10],["σου",5,146],["οὐκ",12,12],["ἔχω",124,149],["ἢ",61,8],["πάλιν",655,17],["ἡ",1,11],["κεφαλὴ",144,13],["τοῖς",1,138],["ποσίν",210,139],["χρείαν",1006,10],["ὑμῶν",5,136],["οὐκ",12,12],["ἔχω",124,149]],"The eye can’t tell the hand, “I have no need for you,” or again the head to the feet, “I have no need for you.”"],["22",[["ἀλλὰ",108,8],["πολλῷ",74,34],["μᾶλλον",1043,17],["τὰ",1,253],["δοκοῦντα",801,289],["μέλη",1593,63],["τοῦ",1,23],["σώματος",454,24],["ἀσθενέστερα",1854,74],["ὑπάρχειν",418,54],["ἀναγκαῖά",4500,74],["ἐστιν",10,87]],"No, much rather, those members of the body which seem to be weaker are necessary."],["23",[["καὶ",2,8],["ἃ",24,755],["δοκοῦμεν",801,241],["ἀτιμότερα",2666,65],["εἶναι",10135,54],["τοῦ",1,23],["σώματος",454,24],["τούτοις",16,416],["τιμὴν",720,10],["περισσοτέραν",10264,37],["περιτίθεμεν",1017,241],["καὶ",2,8],["τὰ",1,253],["ἀσχήμονα",4051,74],["ἡμῶν",9994,136],["εὐσχημοσύνην",7188,10],["περισσοτέραν",10264,37],["ἔχει",124,87]],"Those parts of the body which we think to be less honorable, on those we bestow more abundant honor; and our unpresentable parts have more abundant modesty,"],["24",[["τὰ",1,253],["δὲ",14,8],["εὐσχήμονα",7189,74],["ἡμῶν",9994,136],["οὐ",12,12],["χρείαν",1006,10],["ἔχει",124,87],["ἀλλὰ",108,8],["ὁ",1,4],["θεὸς",20,5],["συνεκέρασεν",8339,3],["τὸ",1,32],["σῶμα",454,33],["τῷ",1,52],["ὑστερουμένῳ",1947,924],["περισσοτέραν",10264,37],["δοὺς",33,155],["τιμήν",720,10]],"while our presentable parts have no such need. But God composed the body together, giving more abundant honor to the inferior part,"],["25",[["ἵνα",102,8],["μὴ",25,12],["ᾖ",10,173],["σχίσμα",10075,20],["ἐν",4,1],["τῷ",1,52],["σώματι",454,53],["ἀλλὰ",108,8],["τὸ",1,32],["αὐτὸ",3,121],["ὑπὲρ",139,1],["ἀλλήλων",1192,41],["μεριμνῶσιν",2600,265],["τὰ",1,253],["μέλη",1593,63]],"that there should be no division in the body, but that the members should have the same care for one another."],["26",[["καὶ",2,8],["εἴτε",2713,8],["πάσχει",1972,87],["ἓν",58,28],["μέλος",1593,20],["συμπάσχει",10864,87],["πάντα",11,74],["τὰ",1,253],["μέλη",1593,63],["εἴτε",2713,8],["δοξάζεται",452,449],["ἓν",58,28],["μέλος",1593,20],["συγχαίρει",6089,87],["πάντα",11,74],["τὰ",1,253],["μέλη",1593,63]],"When one member suffers, all the members suffer with it. When one member is honored, all the members rejoice with it."],["27",[["Ὑμεῖς",5,208],["δέ",14,8],["ἐστε",10,84],["σῶμα",454,20],["Χριστοῦ",1072,21],["καὶ",2,8],["μέλη",1593,63],["ἐκ",21,1],["μέρους",471,24]],"Now you are the body of Christ, and members individually."],["28",[["καὶ",2,8],["οὓς",24,294],["μὲν",281,12],["ἔθετο",110,26],["ὁ",1,4],["θεὸς",20,5],["ἐν",4,1],["τῇ",1,95],["ἐκκλησίᾳ",563,2],["πρῶτον",315,29],["ἀποστόλους",10080,31],["δεύτερον",271,29],["προφήτας",176,31],["τρίτον",357,29],["διδασκάλους",7031,31],["ἔπειτα",6560,17],["δυνάμεις",98,40],["ἔπειτα",6560,17],["χαρίσματα",10814,43],["ἰαμάτων",2683,45],["ἀντιλήμψεις",2404,40],["κυβερνήσεις",5753,40],["γένη",519,43],["γλωσσῶν",388,61]],"God has set some in the assembly: first apostles, second prophets, third teachers, then miracle workers, then gifts of healings, helps, governments, and various kinds of languages."],["29",[["μὴ",25,12],["πάντες",11,130],["ἀπόστολοι",10080,51],["μὴ",25,12],["πάντες",11,130],["προφῆται",176,51],["μὴ",25,12],["πάντες",11,130],["διδάσκαλοι",7031,51],["μὴ",25,12],["πάντες",11,130],["δυνάμεις",98,180]],"Are all apostles? Are all prophets? Are all teachers? Are all miracle workers?"],["30",[["μὴ",25,12],["πάντες",11,130],["χαρίσματα",10814,43],["ἔχουσιν",124,191],["ἰαμάτων",2683,45],["μὴ",25,12],["πάντες",11,130],["γλώσσαις",388,71],["λαλοῦσιν",50,191],["μὴ",25,12],["πάντες",11,130],["διερμηνεύουσιν",7040,191]],"Do all have gifts of healings? Do all speak with various languages? Do all interpret?"],["31",[["ζηλοῦτε",1057,307],["δὲ",14,8],["τὰ",1,42],["χαρίσματα",10814,43],["τὰ",1,42],["μείζονα",66,65],["Καὶ",2,8],["ἔτι",111,17],["καθ᾽",32,1],["ὑπερβολὴν",9878,10],["ὁδὸν",68,10],["ὑμῖν",5,86],["δείκνυμι",870,149]],"But earnestly desire the best gifts. Moreover, I show a most excellent way to you."]]