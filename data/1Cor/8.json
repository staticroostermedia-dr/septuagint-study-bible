[["1",[["Περὶ",72,1],["δὲ",14,8],["τῶν",1,44],["εἰδωλοθύτων",7130,79],["οἴδαμεν",1168,311],["ὅτι",19,8],["πάντες",11,130],["γνῶσιν",753,10],["ἔχομεν",124,241],["ἡ",1,11],["γνῶσις",753,13],["φυσιοῖ",10935,87],["ἡ",1,11],["δὲ",14,8],["ἀγάπη",1982,13],["οἰκοδομεῖ",126,87]],"Now concerning things sacrificed to idols: We know that we all have knowledge. Knowledge puffs up, but love builds up."],["2",[["εἴ",77,8],["τις",39,150],["δοκεῖ",801,87],["ἐγνωκέναι",79,107],["τι",39,119],["οὔπω",3100,17],["ἔγνω",79,3],["καθὼς",221,8],["δεῖ",1158,87],["γνῶναι",79,100]],"But if anyone thinks that he knows anything, he doesn’t yet know as he ought to know."],["3",[["εἰ",77,8],["δέ",14,8],["τις",39,150],["ἀγαπᾷ",214,87],["τὸν",1,6],["θεόν",20,7],["οὗτος",16,112],["ἔγνωσται",79,722],["ὑπ᾽",122,1],["αὐτοῦ",3,48]],"But anyone who loves God is known by him."],["4",[["Περὶ",72,1],["τῆς",1,18],["βρώσεως",1241,19],["οὖν",227,8],["τῶν",1,44],["εἰδωλοθύτων",7130,79],["οἴδαμεν",1168,311],["ὅτι",19,8],["οὐδὲν",228,28],["εἴδωλον",627,20],["ἐν",4,1],["κόσμῳ",743,113],["καὶ",2,8],["ὅτι",19,8],["οὐδεὶς",228,16],["θεὸς",20,5],["εἰ",77,8],["μὴ",25,12],["εἷς",58,16]],"Therefore concerning the eating of things sacrificed to idols, we know that no idol is anything in the world, and that there is no other God but one."],["5",[["καὶ",2,8],["γὰρ",40,8],["εἴπερ",77,8],["εἰσὶν",10,191],["λεγόμενοι",31,772],["θεοὶ",20,51],["εἴτε",2713,8],["ἐν",4,1],["οὐρανῷ",94,113],["εἴτε",2713,8],["ἐπὶ",9,1],["γῆς",26,19],["ὥσπερ",226,8],["εἰσὶν",10,191],["θεοὶ",20,51],["πολλοὶ",74,130],["καὶ",2,8],["κύριοι",7,51],["πολλοί",74,130]],"For though there are things that are called “gods”, whether in the heavens or on earth—as there are many “gods” and many “lords”—"],["6",[["ἀλλ᾽",108,8],["ἡμῖν",9994,86],["εἷς",58,16],["θεὸς",20,5],["ὁ",1,4],["πατὴρ",44,5],["ἐξ",21,1],["οὗ",24,367],["τὰ",1,253],["πάντα",11,74],["καὶ",2,8],["ἡμεῖς",9994,208],["εἰς",8,1],["αὐτόν",3,82],["καὶ",2,8],["εἷς",58,16],["κύριος",7,5],["Ἰησοῦς",211,5],["Χριστὸς",1072,5],["δι᾽",56,1],["οὗ",24,367],["τὰ",1,253],["πάντα",11,74],["καὶ",2,8],["ἡμεῖς",9994,208],["δι᾽",56,1],["αὐτοῦ",3,48]],"yet to us there is one God, the Father, of whom are all things, and we for him; and one Lord, Jesus Christ, through whom are all things, and we live through him."],["7",[["ἀλλ᾽",108,8],["οὐκ",12,12],["ἐν",4,1],["πᾶσιν",11,215],["ἡ",1,11],["γνῶσις",753,13],["τινὲς",39,402],["δὲ",14,8],["τῇ",1,95],["συνηθείᾳ",4418,2],["ἕως",42,1],["ἄρτι",2665,17],["τοῦ",1,23],["εἰδώλου",627,24],["ὡς",36,12],["εἰδωλόθυτον",7130,29],["ἐσθίουσιν",147,191],["καὶ",2,8],["ἡ",1,11],["συνείδησις",6118,13],["αὐτῶν",3,41],["ἀσθενὴς",1854,15],["οὖσα",10,183],["μολύνεται",1901,449]],"However, that knowledge isn’t in all men. But some, with consciousness of an idol until now, eat as of a thing sacrificed to an idol, and their conscience, being weak, is defiled."],["8",[["βρῶμα",714,20],["δὲ",14,8],["ἡμᾶς",9994,209],["οὐ",12,12],["παραστήσει",595,120],["τῷ",1,110],["θεῷ",20,113],["οὔτε",477,8],["ἐὰν",45,8],["μὴ",25,12],["φάγωμεν",147,75],["ὑστερούμεθα",1947,885],["οὔτε",477,8],["ἐὰν",45,8],["φάγωμεν",147,75],["περισσεύομεν",3112,241]],"But food will not commend us to God. For neither, if we don’t eat are we the worse, nor if we eat are we the better."],["9",[["βλέπετε",470,307],["δὲ",14,8],["μή",25,12],["πως",441,12],["ἡ",1,11],["ἐξουσία",929,13],["ὑμῶν",5,136],["αὕτη",16,101],["πρόσκομμα",2624,20],["γένηται",30,745],["τοῖς",1,138],["ἀσθενέσιν",1854,215]],"But be careful that by no means does this liberty of yours become a stumbling block to the weak."],["10",[["ἐὰν",45,8],["γάρ",40,8],["τις",39,150],["ἴδῃ",112,160],["σὲ",5,161],["τὸν",1,6],["ἔχοντα",124,178],["γνῶσιν",753,10],["ἐν",4,1],["εἰδωλείῳ",4768,53],["κατακείμενον",4267,765],["οὐχὶ",330,12],["ἡ",1,11],["συνείδησις",6118,13],["αὐτοῦ",3,48],["ἀσθενοῦς",1854,153],["ὄντος",10,143],["οἰκοδομηθήσεται",126,125],["εἰς",8,1],["τὸ",1,32],["τὰ",1,42],["εἰδωλόθυτα",7130,65],["ἐσθίειν",147,54]],"For if a man sees you who have knowledge sitting in an idol’s temple, won’t his conscience, if he is weak, be emboldened to eat things sacrificed to idols?"],["11",[["ἀπόλλυται",217,449],["γὰρ",40,8],["ὁ",1,4],["ἀσθενῶν",771,67],["ἐν",4,1],["τῇ",1,95],["σῇ",10053,96],["γνώσει",753,2],["ὁ",1,4],["ἀδελφὸς",67,5],["δι᾽",56,1],["ὃν",24,106],["Χριστὸς",1072,5],["ἀπέθανεν",109,3]],"And through your knowledge, he who is weak perishes, the brother for whose sake Christ died."],["12",[["οὕτως",71,17],["δὲ",14,8],["ἁμαρτάνοντες",237,137],["εἰς",8,1],["τοὺς",1,56],["ἀδελφοὺς",67,31],["καὶ",2,8],["τύπτοντες",1209,137],["αὐτῶν",3,41],["τὴν",1,9],["συνείδησιν",6118,10],["ἀσθενοῦσαν",771,73],["εἰς",8,1],["Χριστὸν",1072,7],["ἁμαρτάνετε",237,84]],"Thus, sinning against the brothers, and wounding their conscience when it is weak, you sin against Christ."],["13",[["διόπερ",3524,8],["εἰ",77,8],["βρῶμα",714,20],["σκανδαλίζει",5037,87],["τὸν",1,6],["ἀδελφόν",67,7],["μου",9994,146],["οὐ",12,12],["μὴ",25,12],["φάγω",147,227],["κρέα",629,43],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["ἵνα",102,8],["μὴ",25,12],["τὸν",1,6],["ἀδελφόν",67,7],["μου",9994,146],["σκανδαλίσω",5037,227]],"Therefore, if food causes my brother to stumble, I will eat no meat forever more, that I don’t cause my brother to stumble."]]