[["1",[["Ἐὰν",45,8],["ἐξαποστείλῃ",217,160],["ἀνὴρ",38,5],["τὴν",1,9],["γυναῖκα",58,10],["αὐτοῦ",3,48],["καὶ",2,8],["ἀπέλθῃ",305,160],["ἀπʼ",17,1],["αὐτοῦ",3,48],["καὶ",2,8],["γένηται",30,236],["ἀνδρὶ",38,113],["ἑτέρῳ",253,111],["μὴ",25,8],["ἀνακάμπτουσα",2321,181],["ἀνακάμψει",2321,120],["πρὸς",15,1],["αὐτὸν",3,82],["ἔτι",110,17],["οὐ",12,17],["μιαινομένη",466,204],["μιανθήσεται",466,125],["ἡ",1,11],["γυνὴ",58,13],["ἐκείνη",79,178],["καὶ",2,8],["σὺ",5,156],["ἐξεπόρνευσας",1106,154],["ἐν",4,1],["ποιμέσι",659,139],["πολλοῖς",74,215],["καὶ",2,8],["ἀνέκαμπτες",2321,216],["πρὸς",15,1],["μὲ",6,82],["λέγει",31,87],["Κύριος",7,5]],"If a man put away his wife, and she depart from him, and become another man's, shall she return to him any more at all? shall not that woman be utterly defiled? yet thou hast gone a-whoring with many shepherds, and hast returned to me, saith the Lord."],["2",[["Ἆρον",248,198],["τοὺς",1,56],["ὀφθαλμούς",91,31],["σου",5,146],["εἰς",8,1],["εὐθεῖαν",1137,37],["καὶ",2,8],["ἴδε",693,17],["ποῦ",477,17],["οὐχὶ",326,12],["ἐξεφύρθης",9409,363],["ἐπὶ",9,1],["ταῖς",1,70],["ὁδοῖς",67,71],["ἐκάθισας",273,154],["αὐτοῖς",3,142],["ὡσεὶ",342,17],["κορώνη",5780,13],["ἐρημουμένη",821,204],["καὶ",2,8],["ἐμίανας",466,154],["τὴν",1,9],["γῆν",26,10],["ἐν",4,1],["ταῖς",1,70],["πορνείαις",1003,71],["σου",5,146],["καὶ",2,8],["ἐν",4,1],["ταῖς",1,70],["κακίαις",431,71],["σου",5,146]],"Lift up thine eyes [to look] straight forward, and see where thou hast not been utterly defiled. Thou hast sat for them by the wayside as a deserted crow, and hast defiled the land with thy fornications and thy wickedness."],["3",[["καὶ",2,8],["ἔσχες",124,154],["ποιμένας",659,31],["πολλοὺς",74,58],["εἰς",8,1],["πρόσκομμα",2627,33],["σεαυτῇ",1559,99],["ὄψις",1129,13],["πόρνης",1146,19],["ἐγένετό",30,26],["σου",5,146],["ἀπηναισχύντησας",9037,154],["πρὸς",15,1],["πάντας",11,58]],"And thou didst retain many shepherds for a stumbling-block to thyself: thou hadst a whore's face, thou didst become shameless toward all."],["4",[["Οὐχ",12,17],["ὡς",36,8],["οἶκόν",34,7],["με",6,82],["ἐκαλέσας",128,154],["καὶ",2,8],["πατέρα",44,7],["καὶ",2,8],["ἀρχηγὸν",1401,7],["τῆς",1,18],["παρθενίας",4981,19],["σου",5,146]],"Hast thou not called me as it were a home, and the father and guide of thy virgin-time?"],["5",[["Μὴ",25,8],["διαμενεῖ",1886,120],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["ἢ",60,8],["φυλαχθήσεται",127,125],["εἰς",8,1],["νῖκος",2107,33],["ἰδοὺ",51,17],["ἐλάλησας",50,154],["καὶ",2,8],["ἐποίησας",23,154],["τὰ",1,42],["πονηρὰ",164,65],["ταῦτα",16,249],["καὶ",2,8],["ἠδυνάσθης",0,0]],"Will [God's anger] continue for ever, or be preserved to the end? Behold, thou hast spoken and done these bad things, and hadst power [to do them]."],["6",[["Καὶ",2,8],["εἶπε",18,3],["Κύριος",7,5],["πρὸς",15,1],["μὲ",6,82],["ἐν",4,1],["ταῖς",1,70],["ἡμέραις",28,71],["Ἰωσείου",0,0],["τοῦ",1,30],["βασιλέως",22,21],["εἶδες",73,154],["ἃ",1,11],["ἐποίησέ",23,3],["μοι",6,49],["ἡ",1,11],["κατοικία",1306,13],["τοῦ",1,30],["Ἰσραήλ",27,105],["ἐπορεύθησαν",49,94],["ἐπὶ",9,1],["πᾶν",11,29],["ὄρος",86,33],["ὑψηλὸν",289,29],["καὶ",2,8],["ὑποκάτω",597,17],["παντὸς",11,88],["ξύλου",196,24],["ἀλσώδους",3401,24],["καὶ",2,8],["ἐπόρνευσαν",2116,141],["ἐκεῖ",76,17]],"And the Lord said to me in the days of Josias the king, Hast thou seen what things the house of Israel has done to me? they have gone on every high mountain, and under every shady tree, and have committed fornication there."],["7",[["Καὶ",2,8],["εἶπα",18,147],["μετὰ",29,1],["τὸ",1,32],["πορνεῦσαι",2116,100],["αὐτὴν",3,98],["ταῦτα",16,249],["πάντα",11,65],["πρὸς",15,1],["μὲ",6,82],["ἀνάστρεψον",520,198],["καὶ",2,8],["οὐκ",12,17],["ἀνέστρεψε",520,3],["καὶ",2,8],["εἶδε",276,3],["τὴν",1,9],["ἀσυνθεσίαν",4564,10],["αὐτῆς",3,83],["ἡ",1,11],["ἀσύνθετος",4568,15],["Ἰούδα",61,21]],"And I said after she had committed all these acts of fornication, Turn again to me. Yet she returned not. And faithless Juda saw her faithlessness."],["8",[["Καὶ",2,8],["εἶδον",73,147],["ὅτι",19,8],["περὶ",71,1],["πάντων",11,163],["ὧν",24,307],["κατελήφθη",537,38],["ἐν",4,1],["οἷς",24,295],["ἐμοιχᾶτο",2375,22],["ἡ",1,11],["κατοικία",1306,13],["Ἰσραὴλ",27,105],["καὶ",2,8],["ἐξαπέστειλα",217,147],["αὐτὴν",3,98],["καὶ",2,8],["ἔδωκα",33,147],["αὐτῇ",3,99],["βιβλίον",337,33],["ἀποστασίου",4553,24],["εἰς",8,1],["τὰς",1,39],["χεῖρας",37,40],["αὐτῆς",3,83],["καὶ",2,8],["οὐκ",12,17],["ἐφοβήθη",134,38],["ἡ",1,11],["ἀσύνθετος",4568,15],["Ἰούδα",61,21],["καὶ",2,8],["ἐπορεύθη",49,38],["καὶ",2,8],["ἐπόρνευσε",2116,3],["καὶ",2,8],["αὐτὴ",3,178]],"And I saw that (for all the sins of which she was convicted, wherein the house of Israel committed adultery, and I put her away, and gave into her hands a bill of divorcement,) yet faithless Juda feared not, but went and herself also committed fornication."],["9",[["και",2,8],["ἐγένετο",30,26],["εἰς",8,1],["οὐθὲν",225,29],["ἡ",1,11],["πορνεία",1003,13],["αὐτῆς",3,83],["καὶ",2,8],["ἐμοίχευσε",2473,3],["τὸ",1,32],["ξύλον",196,33],["καὶ",2,8],["τὸν",1,6],["λίθον",195,7]],"And her fornication was nothing accounted of; and she committed adultery with wood and stone."],["10",[["Καὶ",2,8],["ἐν",4,1],["πᾶσι",11,215],["τούτοις",16,191],["οὐκ",12,17],["ἐπεστράφη",116,38],["πρὸς",15,1],["μὲ",6,82],["ἡ",1,11],["ἀσύνθετος",4568,15],["Ἰούδα",61,21],["ἐξ",21,1],["ὅλης",233,78],["τῆς",1,18],["καρδίας",63,19],["αὐτῆς",3,83],["ἀλλʼ",107,17],["ἐπὶ",9,1],["ψεύδει",1193,134]],"And for all these things faithless Juda turned not to me with all her heart, but falsely."],["11",[["Καὶ",2,8],["εἶπε",18,3],["Κύριος",7,5],["πρὸς",15,1],["μὲ",6,98],["ἐδικαίωσε",1134,3],["τὴν",1,9],["ψυχὴν",62,10],["αὐτοῦ",3,48],["Ἰσραὴλ",27,105],["ἀπὸ",17,1],["τῆς",1,18],["ἀσυνθέτου",4568,153],["Ἰούδα",61,21]],"And the Lord said to me, Israel has justified himself more than faithless Juda."],["12",[["Πορεύου",49,250],["καὶ",2,8],["ἀνάγνωθι",792,198],["τοὺς",1,56],["λόγους",48,31],["τούτους",16,274],["πρὸς",15,1],["Βοῤῥᾶν",384,7],["καὶ",2,8],["ἐρεῖς",191,145],["ἐπιστράφηθι",116,242],["πρὸς",15,1],["μὲ",6,82],["ἡ",1,11],["κατοικία",1306,13],["τοῦ",1,30],["Ἰσραὴλ",27,105],["λέγει",31,87],["Κύριος",7,5],["καὶ",2,8],["μὴ",25,8],["στηριῶ",1064,157],["τὸ",1,32],["πρόσωπόν",47,33],["μου",6,48],["ἐφʼ",9,1],["ὑμᾶς",5,209],["ὅτι",19,8],["ἐλεήμων",1491,16],["ἐγώ",6,158],["εἰμι",10,149],["λέγει",31,87],["Κύριος",7,5],["καὶ",2,8],["οὐ",12,17],["μηνιῶ",7742,149],["ὑμῖν",5,86],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7]],"Go and read these words toward the north, and thou shalt say, Return to me, O house of Israel, saith the Lord; and I will not set my face against you: for I am merciful, saith the Lord, and I will not be angry with you for ever."],["13",[["Πλὴν",257,1],["γνῶθι",81,198],["τὴν",1,9],["ἀδικίαν",288,10],["σου",5,146],["ὅτι",19,8],["εἰς",8,1],["Κύριον",7,7],["τὸν",1,6],["Θεόν",20,7],["σου",5,146],["ἠσέβησας",1313,154],["καὶ",2,8],["διέχεας",1588,154],["τὰς",1,39],["ὁδούς",67,40],["σου",5,146],["εἰς",8,1],["ἀλλοτρίους",377,58],["ὑποκάτω",597,17],["παντὸς",11,88],["ξύλου",196,24],["ἀλσώδους",3401,24],["τῆς",1,18],["δὲ",14,12],["φωνῆς",95,19],["μου",6,83],["οὐχ",12,17],["ὑπήκουσας",868,154],["λέγει",31,87],["Κύριος",7,5]],"Nevertheless, know thine iniquity, that thou hast sinned against the Lord thy God, and hast scattered thy ways to strangers under every shady tree, but thou didst not hearken to my voice, saith the Lord."],["14",[["Ἐπιστράφητε",116,505],["υἱοὶ",13,51],["ἀφεστηκότες",646,264],["λέγει",31,87],["Κύριος",7,5],["διότι",176,8],["ἐγὼ",6,158],["κατακυριεύσω",2091,157],["ὑμῶν",5,136],["καὶ",2,8],["λήψομαι",46,176],["ὑμᾶς",5,209],["ἕνα",57,59],["ἐκ",21,1],["πόλεως",41,19],["καὶ",2,8],["δύο",103,57],["ἐκ",21,1],["πατριᾶς",336,19],["καὶ",2,8],["εἰσάξω",389,157],["ὑμᾶς",5,209],["εἰς",8,1],["Σιὼν",331,2]],"Turn, ye children that have revolted, saith the Lord; for I will rule over you: and I will take you one of a city, and two of a family, and I will bring you in to Sion:"],["15",[["καὶ",2,8],["δώσω",33,157],["ὑμῖν",5,86],["ποιμένας",659,31],["κατὰ",32,1],["τὴν",1,9],["καρδίαν",63,10],["μου",6,48],["καὶ",2,8],["ποιμανοῦσιν",0,0],["ὑμᾶς",5,209],["ποιμαίνοντες",955,137],["μετʼ",29,1],["ἐπιστήμης",892,19]],"and I will give you shepherds after my heart, and they shall certainly tend you with knowledge."],["16",[["Καὶ",2,8],["ἔσται",10,89],["ἐὰν",45,8],["πληθυνθῆτε",315,494],["καὶ",2,8],["αὐξηθῆτε",1179,494],["ἐπὶ",9,1],["τῆς",1,18],["γῆς",26,19],["λέγει",31,87],["Κύριος",7,5],["ἐν",4,1],["ταῖς",1,70],["ἡμέραις",28,71],["ἐκείναις",79,192],["οὐκ",12,17],["ἐροῦσιν",191,189],["ἔτι",110,17],["κιβωτὸς",271,13],["διαθήκης",168,19],["ἁγίου",75,88],["Ἰσραὴλ",27,105],["οὐκ",12,17],["ἀναβήσεται",87,89],["ἐπὶ",9,1],["καρδίαν",63,10],["οὐκ",12,17],["ὀνομασθήσεται",1663,125],["οὐδὲ",105,12],["ἐπισκεφθήσεται",429,399],["καὶ",2,8],["οὐ",12,17],["ποιηθήσεται",23,125],["ἔτι",110,17]],"And it shall come to pass that when ye are multiplied and increased upon the land, saith the Lord, in those days they shall say no more, The ark of the covenant of the Holy One of Israel: it shall not come to mind; it shall not be named; neither shall it be visited; nor shall [this] be done any more."],["17",[["Ἐν",4,1],["ταῖς",1,70],["ἡμέραις",28,71],["ἐκείναις",79,192],["καὶ",2,8],["ἐν",4,1],["τῷ",1,110],["καιρῷ",132,113],["ἐκείνῳ",79,49],["καλέσουσι",128,207],["τὴν",1,9],["Ἱερουσαλὴμ",69,20],["Θρόνον",379,7],["Κυρίου",7,21],["καὶ",2,8],["συναχθήσονται",165,135],["πάντα",11,65],["τὰ",1,42],["ἔθνη",59,43],["εἰς",8,1],["αὐτὴν",3,98],["καὶ",2,8],["οὐ",12,17],["πορεύσονται",49,127],["ἔτι",110,17],["ὀπίσω",166,17],["τῶν",1,44],["ἐνθυμημάτων",1493,45],["τῆς",1,18],["καρδίας",63,19],["αὐτῶν",3,41],["τῆς",1,18],["πονηρᾶς",164,78]],"In those days and at that time they shall call Jerusalem the throne of the Lord; and all the nations shall be gathered to it: and they shall not walk any more after the imaginations of their evil heart."],["18",[["Ἐν",4,1],["ταῖς",1,70],["ἡμέραις",28,71],["ἐκείναις",79,192],["συνελεύσονται",1917,127],["ὁ",1,4],["οἶκος",34,5],["Ἰούδα",61,21],["ἐπὶ",9,1],["τὸν",1,6],["οἶκον",34,7],["τοῦ",1,30],["Ἰσραὴλ",27,105],["καὶ",2,8],["ἥξουσιν",260,207],["ἐπιτοαυτὸ",1405,105],["ἀπὸ",17,1],["γῆς",26,19],["Βοῤῥᾶ",384,5],["καὶ",2,8],["ἀπὸ",17,1],["πασῶν",11,115],["τῶν",1,123],["χωρῶν",278,61],["ἐπὶ",9,1],["τὴν",1,9],["γῆν",26,10],["ἣν",24,124],["κατεκληρονόμησα",909,147],["τοὺς",1,56],["πατέρας",44,31],["αὐτῶν",3,41]],"In those days the house of Juda shall come together to the house of Israel, and they shall come, together, from the land of the north, and from all the countries, to the land, which I caused their fathers to inherit."],["19",[["Καὶ",2,8],["ἐγὼ",6,158],["εἶπα",18,147],["γένοιτο",30,397],["Κύριε",7,251],["ὅτι",19,8],["τάξω",783,157],["σε",5,161],["εἰς",8,1],["τέκνα",192,43],["καὶ",2,8],["δώσω",33,157],["σοι",5,151],["γῆν",26,10],["ἐκλεκτὴν",551,37],["κληρονομίαν",297,10],["Θεοῦ",20,21],["παντοκράτορος",338,21],["ἐθνῶν",59,45],["καὶ",2,8],["εἶπα",18,147],["πατέρα",44,7],["καλέσετέ",128,352],["με",6,82],["καὶ",2,8],["ἀπʼ",17,1],["ἐμοῦ",6,48],["οὐκ",12,17],["ἀποστραφήσεσθε",130,258]],"And I said, So be it, Lord, for [thou saidst], I will set thee among children, and will give thee a choice land, the inheritance of the Almighty God of the Gentiles: and I said, Ye shall call me Father; and ye shall not turn away from me."],["20",[["Πλὴν",257,1],["ὡς",36,8],["ἀθετεῖ",835,87],["γυνὴ",58,13],["εἰς",8,1],["τὸν",1,6],["συνόντα",2303,177],["αὐτῇ",3,99],["οὕτως",70,17],["ἠθέτησεν",835,3],["εἰς",8,1],["ἐμὲ",6,82],["ὁ",1,4],["οἶκος",34,5],["Ἰσραὴλ",27,105],["λέγει",31,87],["Κύριος",7,5]],"But as a wife acts treacherously against her husband, so has the house of Israel dealt treacherously against me, saith the Lord."],["21",[["Φωνὴ",95,13],["ἐκ",21,1],["χειλέων",361,45],["ἠκούσθη",53,38],["κλαυθμοῦ",1207,21],["καὶ",2,8],["δεήσεως",674,19],["υἱῶν",13,77],["Ἰσραὴλ",27,105],["ὅτι",19,8],["ἠδίκησαν",819,141],["ἐν",4,1],["ταῖς",1,70],["ὁδοῖς",67,71],["αὐτῶν",3,41],["ἐπελάθοντο",3018,182],["Θεοῦ",20,21],["ἁγίου",75,153],["αὐτῶν",3,41]],"A voice from the lips was heard, [even] of weeping and supplication of the children of Israel: for they have dealt unrighteously in their ways, they have forgotten God their Holy One."],["22",[["Ἐπιστράφητε",116,505],["υἱοὶ",13,51],["ἐπιστρέφοντες",116,137],["καὶ",2,8],["ἰάσομαι",794,231],["τὰ",1,42],["συντρίμματα",1231,43],["ὑμῶν",5,136],["Ἰδοὺ",51,17],["δοῦλοι",136,51],["ἡμεῖς",6,193],["ἐσόμεθά",10,132],["σοι",5,151],["ὅτι",19,8],["σὺ",5,156],["Κύριος",7,5],["ὁ",1,4],["Θεὸς",20,5],["ἡμῶν",6,41],["εἶ",10,145]],"Turn, ye children that are given to turning, and I will heal your bruises. Behold, we will be thy servants; for thou art the Lord our God."],["23",[["Ὄντως",4142,17],["εἰς",8,1],["ψεῦδος",1193,33],["ἦσαν",10,129],["οἱ",1,128],["βουνοὶ",575,51],["καὶ",2,8],["ἡ",1,11],["δύναμις",98,13],["τῶν",1,44],["ὀρέων",86,45],["πλὴν",257,1],["διὰ",54,1],["Κυρίου",7,21],["Θεοῦ",20,21],["ἡμῶν",6,41],["ἡ",1,11],["σωτηρία",422,13],["τοῦ",1,30],["Ἰσραήλ",27,105]],"Truly the hills and the strength of the mountains were a lying refuge: but by the Lord our God is the salvation of Israel."],["24",[["Ἡ",1,11],["δὲ",14,12],["αἰσχύνη",683,13],["κατηνάλωσε",2092,3],["τοὺς",1,56],["μόχθους",1144,31],["τῶν",1,76],["πατέρων",44,77],["ἡμῶν",6,41],["ἀπὸ",17,1],["νεότητος",785,19],["ἡμῶν",6,41],["τὰ",1,42],["πρόβατα",194,43],["αὐτῶν",3,41],["καὶ",2,8],["τοὺς",1,56],["μόσχους",256,31],["αὐτῶν",3,41],["καὶ",2,8],["τοὺς",1,56],["υἱοὺς",13,31],["αὐτῶν",3,41],["καὶ",2,8],["τὰς",1,39],["θυγατέρας",97,40],["αὐτῶν",3,41]],"But shame has consumed the labours of our fathers from our youth; their sheep and their calves, and their sons and their daughters."],["25",[["Ἐκοιμήθημεν",302,498],["ἐν",4,1],["τῇ",1,95],["αἰσχύνῃ",683,2],["ἡμῶν",6,41],["καὶ",2,8],["ἐπεκάλυψεν",2064,3],["ἡμᾶς",6,60],["ἡ",1,11],["ἀτιμία",1048,13],["ἡμῶν",6,41],["διότι",176,8],["ἔναντι",230,17],["τοῦ",1,30],["Θεοῦ",20,21],["ἡμῶν",6,41],["ἡμάρτομεν",244,288],["ἡμεῖς",6,193],["καὶ",2,8],["οἱ",1,128],["πατέρες",44,51],["ἡμῶν",6,41],["ἀπὸ",17,1],["νεότητος",785,19],["ἡμῶν",6,41],["ἕως",42,8],["τῆς",1,18],["ἡμέρας",28,19],["ταύτης",16,293],["καὶ",2,8],["οὐχ",12,17],["ὑπηκούσαμεν",868,288],["τῆς",1,18],["φωνῆς",95,19],["Κυρίου",7,21],["τοῦ",1,30],["Θεοῦ",20,21],["ἡμῶν",6,41]],"We have lain down in our shame, and our disgrace has covered us: because we and our fathers have sinned before our God, from our youth until this day; and we have not hearkened to the voice of the Lord our God."]]