[["1",[["Καὶ",2,8],["ἐγένετο",30,26],["ἐν",4,1],["τῷ",1,52],["τετάρτῳ",561,34],["ἔτει",81,53],["Σεδεκία",0,0],["βασιλέως",22,21],["Ἰούδα",62,21],["ἐν",4,1],["μηνὶ",296,113],["τῷ",1,110],["πέμπτῳ",844,111],["εἶπέ",18,3],["μοι",6,49],["Ἀνανίας",1234,5],["υἱὸς",13,5],["Ἀζὼρ",6395,105],["ὁ",1,4],["ψευδοπροφήτης",2801,5],["ἀπὸ",17,1],["Γαβαὼν",0,0],["ἐν",4,1],["οἴκῳ",34,113],["Κυρίου",7,21],["κατʼ",32,1],["ὀφθαλμοὺς",91,31],["τῶν",1,76],["ἱερέων",65,77],["καὶ",2,8],["παντὸς",11,153],["τοῦ",1,30],["λαοῦ",35,21],["λέγων",31,67]],"And it came to pass in the fourth year of Sedekias king of Juda, in the fifth month, [that] Ananias the false prophet, the son of Azor, from Gabaon, spoke to me in the house of the Lord, in the sight of the priests and all the people, saying,"],["2",[["Οὕτως",71,17],["εἶπε",18,3],["Κύριος",7,5],["συνέτριψα",268,147],["τὸν",1,6],["ζυγὸν",920,7],["τοῦ",1,30],["βασιλέως",22,21],["Βαβυλῶνος",204,19]],"Thus saith the Lord; I have broken the yoke of the king of Babylon."],["3",[["Ἔτι",111,17],["δύο",104,57],["ἔτη",81,43],["ἡμερῶν",28,61],["καὶ",2,8],["ἐγὼ",6,158],["ἀποστρέψω",130,157],["εἰς",8,1],["τὸν",1,6],["τόπον",99,7],["τοῦτον",16,259],["τὰ",1,42],["σκεύη",182,43],["οἴκου",34,21],["Κυρίου",7,21]],"Yet two full years, and I will return into this place the vessels of the house of the Lord,"],["4",[["καὶ",2,8],["Ἰεχονίαν",1944,7],["καὶ",2,8],["τὴν",1,9],["ἀποικίαν",1362,10],["Ἰούδα",62,21],["ὅτι",19,8],["συντρίψω",268,157],["τὸν",1,6],["ζυγὸν",920,7],["βασιλέως",22,21],["Βαβυλῶνος",204,19]],"and Jechonias, and the captivity of Juda: for I will break the yoke of the king of Babylon."],["5",[["Καὶ",2,8],["εἶπεν",18,3],["Ἱερεμίας",480,5],["πρὸς",15,1],["Ἀνανίαν",1234,7],["κατʼ",32,1],["ὀφθαλμοὺς",91,31],["παντὸς",11,153],["τοῦ",1,30],["λαοῦ",35,21],["καὶ",2,8],["κατʼ",32,1],["ὀφθαλμοὺς",91,31],["τῶν",1,76],["ἱερέων",65,77],["τῶν",1,76],["ἑστηκότων",78,398],["ἐν",4,1],["οἴκῳ",34,113],["Κυρίου",7,21]],"Then Jeremias spoke to Ananias in the sight of all the people, and in the sight of the priests that stood in the house of the Lord,"],["6",[["καὶ",2,8],["εἶπεν",18,3],["Ἱερεμίας",480,5],["ἀληθῶς",1795,17],["οὕτω",71,17],["ποιήσαι",23,216],["Κύριος",7,5],["στήσαι",78,216],["τὸν",1,6],["λόγον",48,7],["σου",5,146],["ὃν",24,106],["σὺ",5,156],["προφητεύεις",484,145],["τοῦ",1,30],["ἐπιστρέψαι",117,100],["τὰ",1,42],["σκεύη",182,43],["οἴκου",34,21],["Κυρίου",7,21],["καὶ",2,8],["πᾶσαν",11,37],["τὴν",1,9],["ἀποικίαν",1362,10],["ἐκ",21,1],["Βαβυλῶνος",204,19],["εἰς",8,1],["τὸν",1,6],["τόπον",99,7],["τοῦτον",16,259]],"and Jeremias said, May the Lord indeed do thus; may he confirm thy word which thou dost prophesy, to return the vessels of the house of the Lord, and all the captivity, out of Babylon to this place."],["7",[["Πλὴν",257,1],["ἀκούσατε",54,69],["τὸν",1,6],["λόγον",48,7],["Κυρίου",7,21],["ὃν",24,106],["ἐγὼ",6,158],["λέγω",31,149],["εἰς",8,1],["τὰ",1,42],["ὦτα",328,43],["ὑμῶν",5,136],["καὶ",2,8],["εἰς",8,1],["τὰ",1,42],["ὦτα",328,43],["παντὸς",11,153],["τοῦ",1,30],["λαοῦ",35,21]],"Nevertheless hear ye the word of the Lord which I speak in your ears, and in the ears of all the people."],["8",[["Οἱ",1,128],["προφῆται",176,51],["οἱ",1,128],["γεγονότες",30,263],["πρότεροί",496,130],["μου",6,48],["καὶ",2,8],["πρότεροι",496,130],["ὑμῶν",5,136],["ἀπὸ",17,1],["τοῦ",1,30],["αἰῶνος",100,21],["καὶ",2,8],["ἐπροφήτευσαν",484,141],["ἐπὶ",9,1],["γῆς",26,19],["πολλῆς",74,78],["καὶ",2,8],["ἐπὶ",9,1],["βασιλείας",157,40],["μεγάλας",66,109],["εἰς",8,1],["πόλεμον",163,7]],"The prophets that were before me and before you of old, also prophesied over much country, and against great kingdoms, concerning war."],["9",[["Ὁ",1,4],["προφήτης",176,5],["ὁ",1,4],["προφητεύσας",484,155],["εἰς",8,1],["εἰρήνην",213,10],["ἐλθόντος",55,513],["τοῦ",1,30],["λόγου",48,21],["γνώσονται",79,127],["τὸν",1,6],["προφήτην",176,7],["ὃν",24,106],["ἀπέστειλεν",84,3],["αὐτοῖς",3,142],["Κύριος",7,5],["ἐν",4,1],["πίστει",887,2]],"[As for] the prophet that has prophesied for peace, when the word has come [to pass], they shall know the prophet whom the Lord has sent them in truth."],["10",[["Καὶ",2,8],["ἔλαβεν",46,3],["Ἀνανίας",1234,5],["ἐν",4,1],["ὀφθαλμοῖς",91,139],["παντὸς",11,153],["τοῦ",1,30],["λαοῦ",35,21],["τοὺς",1,56],["κλοιοὺς",1733,31],["ἀπὸ",17,1],["τοῦ",1,30],["τραχήλου",692,21],["Ἱερεμίου",480,21],["καὶ",2,8],["συνέτριψεν",268,3],["αὐτούς",3,60]],"Then Ananias took the yokes from the neck of Jeremias in the sight of all the people, and broke them to pieces."],["11",[["Καὶ",2,8],["εἶπεν",18,3],["Ἀνανίας",1234,5],["κατʼ",32,1],["ὀφθαλμοὺς",91,31],["παντὸς",11,153],["τοῦ",1,30],["λαοῦ",35,21],["λέγων",31,67],["οὕτως",71,17],["εἶπε",18,3],["Κύριος",7,5],["οὕτως",71,17],["συντρίψω",268,157],["τὸν",1,6],["ζυγὸν",920,7],["βασιλέως",22,21],["Βαβυλῶνος",204,19],["ἀπὸ",17,1],["τραχήλων",692,77],["πάντων",11,163],["τῶν",1,76],["ἐθνῶν",60,45],["καὶ",2,8],["ᾤχετο",1556,22],["Ἱερεμίας",480,5],["εἰς",8,1],["τὴν",1,9],["ὁδὸν",68,10],["αὐτοῦ",3,48]],"And Ananias spoke in the presence of all the people, saying, Thus said the Lord; Thus will I break the yoke of the king of Babylon from the necks of all the nations. And Jeremias went his way."],["12",[["Καὶ",2,8],["ἐγένετο",30,26],["λόγος",48,5],["Κυρίου",7,21],["πρὸς",15,1],["Ἱερεμίαν",480,7],["μετὰ",29,1],["τὸ",1,32],["συντρίψαι",268,216],["Ἀνανίαν",1234,7],["τοὺς",1,56],["κλοιοὺς",1733,31],["ἀπὸ",17,1],["τοῦ",1,30],["τραχήλου",692,21],["αὐτοῦ",3,48],["λέγων",31,67]],"And the word of the Lord came to Jeremias, after that Ananias had broken the yokes off his neck, saying,"],["13",[["Βάδιζε",858,239],["καὶ",2,8],["εἰπὸν",18,267],["πρὸς",15,1],["Ἀνανίαν",1234,7],["λέγων",31,67],["οὕτως",71,17],["εἶπε",18,3],["Κύριος",7,5],["κλοιοὺς",1733,31],["ξυλίνους",1417,58],["συνέτριψας",268,154],["καὶ",2,8],["ποιήσω",23,227],["ἀντʼ",158,1],["αὐτῶν",3,41],["κλοιοὺς",1733,31],["σιδηροῦς",1063,58]],"Go and speak to Ananias, saying, Thus saith the Lord; Thou hast broken the yokes of wood; but I will make instead of them yokes of iron."],["14",[["Ὅτι",19,8],["οὕτως",71,17],["εἶπε",18,3],["Κύριος",7,5],["ζυγὸν",920,7],["σιδηροῦν",1063,59],["ἔθηκα",110,147],["ἐπὶ",9,1],["τὸν",1,6],["τράχηλον",692,7],["πάντων",11,79],["τῶν",1,44],["ἐθνῶν",60,45],["ἐργάζεσθαι",467,104],["τῷ",1,110],["βασιλεῖ",22,113],["Βαβυλῶνος",204,19]],"For thus said the Lord, I have put a yoke of iron on the neck of all the nations, that they may serve the king of Babylon."],["15",[["Καὶ",2,8],["εἶπεν",18,3],["Ἱερεμίας",480,5],["τῷ",1,110],["Ἀνανίᾳ",1234,113],["οὐκ",12,17],["ἀπέσταλκέ",84,165],["σε",5,161],["Κύριος",7,5],["καὶ",2,8],["πεποιθέναι",344,107],["ἐποίησας",23,154],["τὸν",1,6],["λαὸν",35,7],["τοῦτον",16,259],["ἐπʼ",9,1],["ἀδίκῳ",406,111]],"And Jeremias said to Ananias, The Lord has not sent thee; and thou hast caused this people to trust in unrighteousness."],["16",[["Διατοῦτο",0,0],["οὕτως",71,17],["εἶπε",18,3],["Κύριος",7,5],["ἰδοὺ",51,17],["ἐγὼ",6,158],["ἐξαποστέλλω",220,149],["σε",5,161],["ἀπὸ",17,1],["προσώπου",47,24],["τῆς",1,18],["γῆς",26,19],["τούτῳ",16,286],["τῷ",1,110],["ἐνιαυτῷ",400,113],["ἀποθανῇ",109,116]],"Therefore thus said the Lord: Behold, I [will] cast thee off from the face of the earth: this year thou shalt die."],["17",[["Καὶ",2,8],["ἀπέθανεν",109,3],["ἐν",4,1],["τῷ",1,110],["μηνὶ",296,113],["τῷ",1,110],["ἑβδόμῳ",462,111]],"So he died in the seventh month."]]