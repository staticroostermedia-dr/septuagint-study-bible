[["1",[["Ὢ",646,316],["ποιμένες",664,51],["οἱ",1,128],["ἀπολλύοντες",217,137],["καὶ",2,8],["διασκορπίζοντες",1001,137],["τὰ",1,42],["πρόβατα",194,43],["τῆς",1,18],["νομῆς",1205,19],["αὐτῶν",3,41]],"Woe to the shepherds that destroy and scatter the sheep of their pasture!"],["2",[["Διατοῦτο",0,0],["τάδε",129,248],["λέγει",31,87],["Κύριος",7,5],["ἐπὶ",9,1],["τοὺς",1,56],["ποιμαίνοντας",953,229],["τὸν",1,6],["λαόν",35,7],["μου",6,48],["ὑμεῖς",5,208],["διεσκορπίσατε",1001,262],["τὰ",1,42],["πρόβατά",194,43],["μου",6,48],["καὶ",2,8],["ἐξώσατε",1575,262],["αὐτὰ",3,66],["καὶ",2,8],["οὐκ",12,17],["ἐπεσκέψασθε",375,181],["αὐτὰ",3,66],["ἰδοὺ",51,17],["ἐγὼ",6,158],["ἐκδικῶ",539,149],["ἐφʼ",9,1],["ὑμᾶς",5,209],["κατὰ",32,1],["τὰ",1,42],["πονηρὰ",164,65],["ἐπιτηδεύματα",903,43],["ὑμῶν",5,136]],"Therefore thus saith the Lord against them that tend my people; Ye have scattered my sheep, and driven them out, and ye have not visited them: behold, I [will] take vengeance upon you according to your evil practices."],["3",[["Καὶ",2,8],["ἐγὼ",6,158],["εἰσδέξομαι",2079,177],["τοὺς",1,56],["καταλοίπους",557,58],["τοῦ",1,30],["λαοῦ",35,21],["μου",6,48],["ἐπὶ",9,1],["πάσης",11,78],["τῆς",1,18],["γῆς",26,19],["οὗ",120,17],["ἔξωσα",1575,147],["αὐτοὺς",3,60],["ἐκεῖ",76,17],["καὶ",2,8],["καταστήσω",314,157],["αὐτοὺς",3,60],["εἰς",8,1],["τὴν",1,9],["νομὴν",1205,10],["αὐτῶν",3,41],["καὶ",2,8],["αὐξηθήσονται",1180,135],["καὶ",2,8],["πληθυνθήσονται",316,135]],"And I will gather in the remnant of my people in every land, whither I have driven them out, and will set them in their pasture; and they shall increase and be multiplied."],["4",[["Καὶ",2,8],["ἀναστήσω",121,157],["αὐτοῖς",3,142],["ποιμένας",664,31],["οἳ",1,128],["ποιμανοῦσιν",0,0],["αὐτοὺς",3,60],["καὶ",2,8],["οὐ",12,17],["φοβηθήσονται",134,135],["ἔτι",111,17],["οὐδὲ",106,12],["πτοηθήσονται",1311,135],["λέγει",31,87],["Κύριος",7,5]],"And I will raise up shepherds to them, who shall feed them: and they shall fear no more, nor be alarmed, sait