[["1",[["ΤΟ",1,27],["ῥῆμα",115,20],["τοῦ",1,30],["Θεοῦ",20,21],["ὃ",1,4],["ἐγένετο",30,26],["ἐπὶ",9,1],["Ἱερεμίαν",479,7],["τὸν",1,6],["του",39,308],["Χελκίου",1157,21],["ἐκ",21,1],["τῶν",1,76],["ἱερέων",64,77],["ὃς",24,247],["κατῴκει",90,14],["ἐν",4,1],["Ἀναθὼθ",0,0],["ἐν",4,1],["γῇ",26,2],["Βενιαμὶν",357,105]],"The word of God which came to Jeremias the [son] of Chelcias, of the priests, who dwelt in Anathoth in the land of Benjamin:"],["2",[["ὡς",36,8],["ἐγενήθη",30,38],["λόγος",48,5],["τοῦ",1,30],["Θεοῦ",20,21],["πρὸς",15,1],["αὐτὸν",3,82],["ἐν",4,1],["ταῖς",1,70],["ἡμέραις",28,71],["Ἰωσία",770,463],["υἱοῦ",13,21],["Ἀμὼς",1530,5],["βασιλέως",22,21],["Ἰούδα",61,21],["ἔτους",80,24],["τρισκαιδεκάτου",2306,88],["ἐν",4,1],["τῇ",1,95],["βασιλείᾳ",157,2],["αὐτοῦ",3,48]],"[accordingly] as the word of God came to him in the days of Josias son of Amos king of Juda, in the thirteenth year of his reign."],["3",[["Καὶ",2,8],["ἐγένετο",30,26],["ἐν",4,1],["ταῖς",1,70],["ἡμέραις",28,71],["Ἰωακεὶμ",0,0],["υἱοῦ",13,21],["Ἰωσία",770,463],["βασιλέως",22,21],["Ἰούδα",61,21],["ἕως",42,8],["ἑνδεκάτου",1942,88],["ἔτους",80,24],["τοῦ",1,23],["Σεδεκία",0,0],["υἱοῦ",13,21],["Ἰωσία",770,463],["βασιλέως",22,21],["Ἰούδα",61,21],["ἕως",42,8],["τῆς",1,18],["αἰχμαλωσίας",458,19],["Ἱερουσαλὴμ",69,20],["ἐν",4,1],["τῷ",1,110],["πέμπτῳ",845,111],["μηνί",295,113]],"And it was in the days of Joakim son of Josias king of Juda, until the eleventh year of Sedekias king of Juda, [even] until the captivity of Jerusalem in the fifth month."],["4",[["Καὶ",2,8],["ἐγένετο",30,26],["λόγος",48,5],["Κυρίου",7,21],["πρὸς",15,1],["αὐτόν",3,82]],"And the word of the Lord came to him, [saying],"],["5",[["Πρὸ",235,1],["τοῦ",1,30],["με",6,82],["πλάσαι",912,100],["σε",5,161],["ἐν",4,1],["κοιλίᾳ",545,2],["ἐπίσταμαί",1088,252],["σε",5,161],["καὶ",2,8],["πρὸ",235,1],["τοῦ",1,30],["σε",5,161],["ἐξελθεῖν",84,100],["ἐκ",21,1],["μήτρας",1346,19],["ἡγίακά",0,0],["σε",5,161],["προφήτην",175,7],["εἰς",8,1],["ἔθνη",59,43],["τέθει