[["1",[["Ὁ",1,4],["ΛΟΓΟΣ",48,5],["Ὁ",1,4],["ΓΕΝΟΜΕΝΟΣ",30,245],["ΠΑΡΑ",72,1],["ΚΥΡΙΟΥ",7,21],["ΠΡΟΣ",15,1],["ἹΕΡΕΜΙΑΝ",0,0],["ὍΤΕ",430,8],["ἈΠΕΣΤΕΙΛΕ",83,3],["ΠΡΟΣ",15,1],["ΑΥΤΟΝ",0,0],["Ὁ",1,4],["ΒΑΣΙΛΕΥΣ",22,5],["ΣΕΔΕΚΙΑΣ",0,0],["ΤΟΝ",1,6],["ΠΑΣΧΩΡ",0,0],["ΥΙΟΝ",0,0],["ΜΕΓΧΙΟΥ",0,0],["ΚΑΙ",2,8],["ΣΟΦΟΝΙΑΝ",0,0],["ΥΙΟΝ",0,0],["ΒΑΣΑΙΟΥ",0,0],["ΤΟΝ",1,6],["ἹΕΡΕΑ",6634,13],["ΛΕΓΩΝ",31,67]],"The Word that came from the Lord to Jeremias, when King Sedekias sent to him Paschor the Son of Melchias, and Sophonias Son of Basæas, the Priest, saying,"],["2",[["ἐπερώτησον",738,243],["περὶ",71,1],["ἡμῶν",6,41],["τὸν",1,6],["Κύριον",7,7],["ὅτι",19,8],["βασιλεὺς",22,5],["Βαβυλῶνος",204,19],["ἐφέστηκεν",623,165],["ἐφʼ",9,1],["ἡμᾶς",6,60],["εἰ",77,8],["ποιήσει",23,120],["Κύριος",7,5],["κατὰ",32,1],["πάντα",11,65],["τὰ",1,42],["θαυμάσια",885,65],["αὐτοῦ",3,48],["καὶ",2,8],["ἀπελεύσεται",305,89],["ἀφʼ",17,1],["ἡμῶν",6,41]],"Enquire of the Lord for us; for the king of Babylon has risen up against us; if the Lord will do according to all his wonderful works, and [the king] shall depart from us."],["3",[["Καὶ",2,8],["εἶπε",18,3],["πρὸς",15,1],["αὐτοὺς",3,60],["Ἱερεμίας",479,5],["οὕτως",70,17],["ἐρεῖτε",663,343],["πρὸς",15,1],["Σεδεκίαν",0,0],["βασιλέα",22,7],["Ἰούδα",61,21]],"And Jeremias said to them, Thus shall ye say to Sedekias king of Juda,"],["4",[["τὰδε",129,249],["λέγει",31,87],["Κύριος",7,5],["ἰδοὺ",51,17],["ἐγὼ",6,158],["μεταστρέφω",1635,149],["τὰ",1,42],["ὅπλα",760,43],["τὰ",1,42],["πολεμικὰ",2199,65],["ἐν",4,1],["οἷς",24,295],["ὑμεῖς",5,208],["πολεμεῖτε",304,84],["ἐν",4,1],["αὐτοῖς",3,142],["πρὸς",15,1],["τοὺς",1,56],["Χαλδαίους",566,31],["τοὺς",1,56],["συγκεκλεικότας",0,0],["ὑμᾶς",5,209],["ἔξωθεν",1050,17],["τοῦ",1,23],["τείχους",323,24],["καὶ",2,8],["συνάξω",165,157],["αὐτοὺς",3,60],["εἰς",8,1],["τὸ",1,32],["μέσον",112,29],["τῆς",1,18],["πόλεως",41,19],["ταύτης",16,293]],"Thus saith the Lord; Behold, I [will] turn back the weapons of war wherewith ye fight against the Chal