[["1",[["Ἐν",4,1],["ταῖς",1,70],["ἡμέραις",28,71],["ἐκείναις",80,194],["ἀνέστη",121,3],["Ματταθίας",1950,5],["Ἰωάννου",2148,21],["τοῦ",1,30],["Συμεὼν",934,5],["ἱερεὺς",65,5],["τῶν",1,76],["υἱῶν",13,77],["Ἰωαρὶβ",0,0],["ἀπὸ",17,1],["Ἱερουσαλὴμ",70,20],["καὶ",2,8],["ἐκάθισεν",274,3],["ἐν",4,1],["Μωδεΐν",0,0]],"In those days arose Mattathias [the son] of John, [the son] of Simeon, a priest of the sons of Joarib, from Jerusalem, and dwelt in Modin."],["2",[["Καὶ",2,8],["αὐτῷ",3,49],["υἱοὶ",13,51],["πέντε",280,57],["Ἰωαννὰν",0,0],["ὁ",1,4],["ἐπικαλούμενος",341,114],["Καδδὶς",1957,17]],"And he had five sons, Joannan, called Caddis:"],["3",[["Σίμων",663,5],["ὁ",1,4],["καλούμενος",128,114],["Θασσι",0,0]],"Simon, called Thassi:"],["4",[["Ἰούδας",62,5],["ὁ",1,4],["ἐπικαλούμενος",341,114],["Μακκαβαῖος",1374,16]],"Judas, who was called Maccabeus:"],["5",[["Ἐλεάζαρ",662,105],["ὁ",1,4],["ἐπικαλούμενος",341,114],["Αὐαρὰν",0,0],["Ἰωνάθαν",11507,7],["ὁ",1,4],["ἐπικαλούμενος",341,114],["Ἀπφοῦς",0,0]],"Eleazar, called Avaran: and Jonathan, whose surname was Apphus."],["6",[["Καὶ",2,8],["εἶδε",53,3],["τὰς",1,39],["βλασφημίας",3505,40],["τὰς",1,39],["γινομένας",30,308],["ἐν",4,1],["Ἰούδα",62,21],["καὶ",2,8],["ἐν",4,1],["Ἱερουσαλὴμ",70,20]],"And when he saw the blasphemies that were committed in Juda and Jerusalem,"],["7",[["καὶ",2,8],["εἶπεν",18,3],["οἴμοι",2103,316],["ἱνατί",102,238],["τοῦτο",16,344],["ἐγεννήθην",222,94],["ἰδεῖν",53,100],["τὸ",1,32],["σύντριμμα",1229,33],["τοῦ",1,30],["λαοῦ",35,21],["μου",6,48],["καὶ",2,8],["τὸ",1,32],["σύντριμμα",1229,33],["τῆς",1,18],["πόλεως",41,19],["τῆς",1,18],["ἁγίας",75,78],["καὶ",2,8],["καθίσαι",274,100],["ἐκεῖ",76,17],["ἐν",4,1],["τῷ",1,110],["δοθῆναι",33,175],["αὐτὴν",3,98],["ἐν",4,1],["χειρὶ",37,2],["ἐχθρῶν",135,77],["καὶ",2,8],["τὸ",1,32],["ἁγίασμα",835,33],["ἐν",4,1],["χειρὶ",37,2],["ἀλλοτρίων",381,163]],"he said, Woe is me! wherefore was I born to see this misery of my people, and of the holy city, and to dwell there, when it was delivered into the hand of the enemy, and the sanctuary into the hand of strangers?"],["8",[["Ἐγένετο",30,26],["ὁ",1,4],["ναὸς",483,5],["αὐτῆς",3,83],["ὡς",36,8],["ἀνὴρ",38,5],["ἄδοξος",6373,16]],"Her temple is become as a man without glory."],["9",[["τὰ",1,42],["σκεύη",182,43],["τῆς",1,18],["δόξης",141,19],["αὐτῆς",3,83],["αἰχμάλωτα",1617,63],["ἀπήχθη",1212,38],["ἀπεκτάνθη",300,38],["τὰ",1,42],["νήπια",1016,65],["αὐτῆς",3,83],["ἐν",4,1],["ταῖς",1,70],["πλατείαις",925,71],["οἱ",1,128],["νεανίσκοι",570,51],["αὐτῆς",3,83],["ἐν",4,1],["ῥομφαίᾳ",248,2],["ἐχθροῦ",135,21]],"Her glorious vessels are carried away into captivity, her infants are slain in the streets, her young men with the sword of the enemy."],["10",[["Ποῖον",1332,20],["ἔθνος",60,20],["οὐκ",12,17],["ἐκληρονόμησε",370,3],["βασιλείαν",157,10],["αὐτῆς",3,83],["καὶ",2,8],["οὐκ",12,17],["ἐκράτησε",385,3],["τῶν",1,44],["σκύλων",559,45],["αὐτῆς",3,83]],"What nation hath not had a part in [her] kingdom, and gotten of her spoils?"],["11",[["Πᾶς",11,16],["ὁ",1,4],["κόσμος",743,5],["αὐτῆς",3,83],["ἀφῃρέθη",369,38],["ἀντὶ",158,1],["ἐλευθήρας",0,0],["ἐγένετο",30,26],["εἰς",8,1],["δούλην",136,10]],"All her ornaments are taken away; of a free woman she has become a bondslave."],["12",[["Καὶ",2,8],["ἰδοὺ",51,17],["τὰ",1,42],["ἅγια",75,65],["ἡμῶν",6,41],["καὶ",2,8],["ἡ",1,11],["καλλονὴ",3276,13],["ἡμῶν",6,41],["καὶ",2,8],["ἡ",1,11],["δόξα",141,188],["ἡμῶν",6,41],["ἠρημώθη",740,38],["καὶ",2,8],["ἐβεβήλωσαν",608,141],["αὐτὰ",3,66],["τὰ",1,42],["ἔθνη",60,43]],"And, behold, our sanctuary, even our beauty and our glory, is laid waste, and the Gentiles have profaned it."],["13",[["Ἱνατί",102,238],["ἡμῖν",6,142],["ἔτι",111,17],["ζῇν",107,54]],"To what end therefore shall we live any longer?"],["14",[["Καὶ",2,8],["διέῤῥηξε",647,3],["Ματταθίας",1950,5],["καὶ",2,8],["υἱοὶ",13,51],["αὐτοῦ",3,48],["τὰ",1,42],["ἱμάτια",276,43],["αὐτῶν",3,41],["καὶ",2,8],["περιεβάλοντο",744,184],["σάκκους",847,31],["καὶ",2,8],["ἐπένθησαν",736,141],["σφόδρα",150,17]],"Then Mattathias and his sons rent their clothes, and put on sackcloth, and mourned very sore."],["15",[["Καὶ",2,8],["ἦλθον",55,141],["οἱ",1,128],["παρὰ",73,1],["τοῦ",1,30],["βασιλέως",22,21],["οἱ",1,128],["καταναγκάζοντες",7358,137],["τὴν",1,9],["ἀποστασίαν",4528,10],["εἰς",8,1],["Μωδεῒν",0,0],["τὴν",1,9],["πόλιν",41,10],["ἵνα",102,8],["θυσιάσωσι",1138,224]],"In the mean while the king's officers, such as compelled the people to revolt, came into the city Modin, to make them sacrifice."],["16",[["Καὶ",2,8],["πολλοὶ",74,130],["ἀπὸ",17,1],["Ἰσραὴλ",27,105],["πρὸς",15,1],["αὐτοὺς",3,60],["προσῆλθον",529,141],["καὶ",2,8],["Ματταθίας",1950,5],["καὶ",2,8],["οἱ",1,128],["υἱοὶ",13,51],["αὐτοῦ",3,48],["συνήχθησαν",166,94]],"And when many of Israel came unto them, Mattathias also and his sons came together."],["17",[["Καὶ",2,8],["ἀπεκρίθησαν",234,94],["οἱ",1,128],["παρὰ",73,1],["τοῦ",1,30],["βασιλέως",22,21],["καὶ",2,8],["εἰπον",18,267],["τῷ",1,110],["Ματταθίᾳ",1950,113],["λέγοντες",31,137],["ἄρχων",96,5],["καὶ",2,8],["ἔνδοξος",732,16],["καὶ",2,8],["μέγας",66,16],["εἶ",10,145],["ἐν",4,1],["τῇ",1,95],["πόλει",41,2],["ταύτῃ",16,200],["καὶ",2,8],["ἐστηριγμένος",979,408],["ἐν",4,1],["υἱοῖς",13,139],["καὶ",2,8],["ἀδελφοῖς",67,139]],"Then answered the king's officers, and said to Mattathias on this wise, Thou art a ruler, and an honourable and great man in this city, and strengthened with sons and brethren:"],["18",[["Νῦν",90,17],["οὖν",227,12],["πρόσελθε",529,198],["πρῶτος",315,16],["καὶ",2,8],["ποίησον",23,198],["τὸ",1,32],["πρόσταγμα",393,33],["τοῦ",1,30],["βασιλέως",22,21],["ὡς",36,8],["ἐποίησαν",23,141],["πάντα",11,65],["τὰ",1,42],["ἔθνη",60,43],["καὶ",2,8],["οἱ",1,128],["ἄνδρες",38,51],["Ἰούδα",62,21],["καὶ",2,8],["οἱ",1,128],["καταλειφθέντες",207,243],["ἐν",4,1],["Ἱερουσαλήμ",70,20],["καὶ",2,8],["ἔσῃ",10,116],["σὺ",5,156],["καὶ",2,8],["ὁ",1,4],["οἶκός",34,5],["σου",5,146],["τῶν",1,76],["φίλων",336,163],["τοῦ",1,30],["βασιλέως",22,21],["καὶ",2,8],["σὺ",5,156],["καὶ",2,8],["οἱ",1,128],["υἱοί",13,51],["σου",5,146],["δοξασθήσεσθε",452,258],["ἀργυρίῳ",152,53],["καὶ",2,8],["χρυσίῳ",202,53],["καὶ",2,8],["ἀποστολαῖς",2661,71],["πολλαῖς",74,287]],"now therefore come thou first, and fulfil the king's commandment, like as all the nations have done, yea, and the men of Juda also, and such as remain at Jerusalem: so shalt thou and thy house be in the number of the king's friends, and thou and thy children shall be honoured with silver and gold, and many rewards."],["19",[["Καὶ",2,8],["ἀπεκρίθη",234,38],["Ματταθίας",1950,5],["καὶ",2,8],["εἶπε",18,3],["φωνῇ",95,2],["μεγάλῃ",66,96],["εἰ",77,8],["πάντα",11,65],["τὰ",1,42],["ἔθνη",60,43],["τὰ",1,42],["ἐν",4,1],["οἴκῳ",34,113],["τῆς",1,18],["βασιλείας",157,19],["τοῦ",1,30],["βασιλέως",22,21],["ἀκούουσιν",54,191],["αὐτοῦ",3,48],["ἀποστῆναι",293,100],["ἕκαστος",171,16],["ἀπὸ",17,1],["λατρείας",2911,40],["πατέρων",44,77],["αὐτοῦ",3,48],["καὶ",2,8],["ᾑρετίσαντο",1618,184],["ἐν",4,1],["ταῖς",1,70],["ἐντολαῖς",259,71],["αὐτοῦ",3,48]],"Then Mattathias answered and spake with a loud voice, Though all the nations that are under the king's dominion obey him, and fall away every one from the religion of their fathers, and give consent to his commandments:"],["20",[["ἀλλʼ",108,17],["ἐγὼ",6,158],["καὶ",2,8],["οἱ",1,128],["υἱοί",13,51],["μου",6,48],["καὶ",2,8],["οἱ",1,128],["ἀδελφοί",67,51],["μου",6,48],["πορευσόμεθα",49,132],["ἐν",4,1],["διαθήκῃ",169,2],["πατέρων",44,77],["ἡμῶν",6,41]],"yet will I and my sons and my brethren walk in the covenant of our fathers."],["21",[["Ἵλεως",1409,16],["ἡμῖν",6,142],["καταλιπεῖν",207,100],["νόμον",140,7],["καὶ",2,8],["δικαιώματὰ",428,63]],"God forbid that we should forsake the law and the ordinances."],["22",[["Τῶν",1,76],["λόγων",48,77],["τοῦ",1,30],["βασιλέως",22,21],["οὐκ",12,17],["ἀκουσόμεθα",54,132],["τοῦ",1,30],["παρελθεῖν",404,100],["τὴν",1,9],["λατρείαν",2911,10],["ἡμῶν",6,41],["δεξιὰν",282,37],["ἢ",61,8],["ἀριστεράν",878,37]],"We will not hearken to the king's words, to go from our religion, either on the right hand, or the left."],["23",[["Καὶ",2,8],["ὡς",36,8],["ἐπαύσατο",706,26],["λαλῶν",50,67],["τοὺς",1,56],["λόγους",48,31],["τούτους",16,274],["προσῆλθεν",529,3],["ἀνὴρ",38,5],["Ἰουδαῖος",285,5],["ἐν",4,1],["ὀφθαλμοῖς",91,139],["πάντων",11,163],["θυσιᾶσαι",1138,590],["ἐπὶ",9,1],["τοῦ",1,30],["βωμοῦ",1033,21],["τοῦ",1,30],["ἐν",4,1],["Μωδεῒν",0,0],["κατὰ",32,1],["τὸ",1,32],["πρόσταγμα",393,33],["τοῦ",1,30],["βασιλέως",22,21]],"Now when he had left speaking these words, there came one of the Jews in the sight of all to sacrifice on the altar which was at Modin, according to the king's commandment."],["24",[["Καὶ",2,8],["εἶδε",53,3],["Ματταθίας",1950,5],["καὶ",2,8],["ἐζήλωσε",1057,3],["καὶ",2,8],["ἐτρόμησαν",8557,141],["οἱ",1,128],["νεφροὶ",1414,51],["αὐτοῦ",3,48],["καὶ",2,8],["ἀνήνεγκε",384,3],["θυμὸν",178,7],["κατὰ",32,1],["τὸ",1,32],["κρίμα",267,33],["καὶ",2,8],["δραμῶν",820,155],["ἔσφαξεν",635,3],["αὐτὸν",3,82],["ἐπὶ",9,1],["τὸν",1,6],["βωμόν",1033,7]],"Which thing when Mattathias saw, he was inflamed with zeal, and his reins trembled, neither could he forbear to shew his anger according to judgment: wherefore he ran, and slew him upon the altar."],["25",[["Καὶ",2,8],["τὸν",1,6],["ἄνδρα",38,7],["τοῦ",1,30],["βασιλέως",22,21],["τὸν",1,6],["ἀναγκάζοντα",1847,178],["θύειν",437,54],["ἀπέκτεινεν",300,3],["ἐν",4,1],["τῷ",1,110],["καιρῷ",132,113],["ἐκείνῳ",80,49],["καὶ",2,8],["τὸν",1,6],["βωμὸν",1033,7],["καθεῖλε",602,3]],"Also the king's commissioner, who compelled men to sacrifice, he killed at that time, and the altar he pulled down."],["26",[["Καὶ",2,8],["ἐζήλωσε",1057,3],["τῷ",1,110],["νόμῳ",140,113],["καθὼς",221,17],["ἐποίησε",23,3],["Φινεὲς",0,0],["τῷ",1,110],["Ζαμβρὶ",0,0],["υἱῷ",13,113],["Σαλώμ",0,0]],"Thus dealt he zealously for the law of God, like as Phinees did unto Zambri the son of Salom."],["27",[["Καὶ",2,8],["ἀνέκραξε",2306,3],["Ματταθίας",1950,5],["ἐν",4,1],["τῇ",1,95],["πόλει",41,2],["φωνῇ",95,2],["μεγάλῃ",66,9