821,10],["ἐν",4,1],["υἱοῖς",13,139],["Ἰσραήλ",27,105]],"So he made him ready to go up, and there went with him a mighty host of the ungodly to help him, and to be avenged of the children of Israel."],["16",[["Καὶ",2,8],["ἤγγισαν",455,141],["ἕως",42,8],["ἀναβάσεως",1751,19],["Βαιθωρών",15488,0],["καὶ",2,8],["ἐξῆλθεν",82,3],["Ἰούδας",62,5],["εἰς",8,1],["συνάντησιν",429,87],["αὐτῷ",3,49],["ὀλιγοστός",1999,16]],"And when he came near to the going up of Bethhoron, Judas went forth to meet him with a small company:"],["17",[["Ὡς",36,8],["δὲ",14,12],["ἴδον",53,141],["τὴν",1,9],["παρεμβολὴν",190,10],["ἐρχομένην",55,167],["εἰς",8,1],["συνάντησιν",429,87],["αὐτοῖς",3,142],["εἶπον",18,141],["τῷ",1,110],["Ἰούδα",62,21],["πῶς",441,12],["δυνησόμεθα",185,132],["ὀλιγοστοὶ",1999,130],["ὄντες",10,137],["πολεμῆσαι",305,100],["πρὸς",15,1],["πλῆθος",200,20],["τοσοῦτον",1692,82],["ἰσχυρόν",401,59],["καὶ",2,8],["ἡμεῖς",6,195],["ἐκλελύμεθα",1194,332],["ἀσιτοῦντες",6344,137],["σήμερον",205,17]],"who, when they saw the host coming to meet them, said unto Judas, How shall we be able, being so few, to fight against so great a multitude [and] so strong, seeing we are ready to faint with fasting all this day?"],["18",[["Καὶ",2,8],["εἶπεν",18,3],["Ἰούδας",62,5],["εὔκοπόν",5635,28],["ἐστι",10,87],["συγκλεισθῆναι",1147,175],["πολλοὺς",74,58],["ἐν",4,1],["χερσὶν",37,71],["ὀλίγων",555,79],["καὶ",2,8],["οὐκ",12,17],["ἔστι",10,87],["διαφορὰ",4752,13],["ἐναντίον",138,17],["τοῦ",1,30],["Θεοῦ",20,21],["τοῦ",1,30],["οὐρανοῦ",94,21],["σώζειν",172,54],["ἐν",4,1],["πολλοῖς",74,215],["ἢ",61,8],["ἐν",4,1],["ὀλίγοις",555,215]],"Unto whom Judas answered, It is no hard matter for many to be shut up in the hands of a few; and with [the God of] heaven it is all one, to deliver with a great multitude, or a small company;"],["19",[["Ὅτι",19,8],["οὐκ",12,17],["ἐν",4,1],["πλήθει",200,53],["δυνάμεως",98,19],["νίκη",4329,13],["πολέμου",163,21],["ἐστὶν",10,87],["ἀλλʼ",108,17],["ἢ",61,8],["ἐκ",21,1],["τοῦ",1,30],["οὐρανοῦ",94,21],["ἡ",1,11],["ἰσχύς",181,13]],"for the victory of battle standeth not in the multitude of an host; but strength cometh from heaven."],["20",[["Αὐτοὶ",3,195],["ἔρχονται",55,299],["πρὸς",15,1],["ἡμᾶς",6,60],["ἐν",4,1],["πλήθει",200,53],["ὕβρεως",837,19],["καὶ",2,8],["ἀνομίας",275,19],["τοῦ",1,30],["ἐξᾶραι",307,100],["ἡμᾶς",6,221],["καὶ",2,8],["τὰς",1,39],["γυναῖκας",59,40],["ἡμῶν",6,41],["καὶ",2,8],["τὰ",1,42],["τέκνα",192,43],["ἡμῶν",6,41],["τοῦ",1,30],["σκυλεῦσαι",1422,100],["ἡμᾶς",6,60]],"They come against us in much pride and iniquity to destroy us, and our wives and children, and to spoil us:"],["21",[["Ἡμεῖς",6,195],["δὲ",14,12],["πολεμοῦμεν",305,241],["περὶ",72,1],["τῶν",1,123],["ψυχῶν",63,61],["ἡμῶν",6,189],["καὶ",2,8],["τῶν",1,123],["νομίμων",705,115],["ἡμῶν",6,189]],"but we fight for our lives and our laws."],["22",[["Καὶ",2,8],["αὐτὸς",3,158],["συντρίψει",268,120],["αὐτοὺς",3,60],["πρὸ",238,1],["προσώπου",47,24],["ἡμῶν",6,41],["ὑμεῖς",5,208],["δὲ",14,12],["μὴ",25,8],["φοβηθῆτε",134,485],["ἀπʼ",17,1],["αὐτῶν",3,41]],"Wherefore the Lord himself will overthrow them before our face: and as for you, be ye not afraid of them."],["23",[["Ὡς",36,8],["δὲ",14,12],["ἐπαύσατο",706,26],["λαλῶν",50,67],["ἐνήλατο",3736,26],["εἰς",8,1],["αὐτοὺς",3,60],["ἄφνω",2821,17],["καὶ",2,8],["συνετρίβη",268,38],["Σήρων",5458,77],["καὶ",2,8],["ἡ",1,11],["παρεμβολὴ",190,13],["αὐτοῦ",3,48],["ἐνώπιον",115,1],["αὐτοῦ",3,48]],"Now as soon as he had left off speaking, he leaped suddenly upon them, and so Seron and his host were overthrown before him."],["24",[["Καὶ",2,8],["ἐδίωκον",533,293],["αὐτὸν",3,82],["ἐν",4,1],["τῇ",1,95],["καταβάσει",2587,2],["Βαιθωρῶν",15488,0],["ἕως",42,8],["τοῦ",1,23],["πεδίου",349,24],["καὶ",2,8],["ἔπεσον",154,141],["ἀπʼ",17,1],["αὐτῶν",3,41],["εἰς",8,1],["ἄνδρας",38,31],["ὀκτακοσίους",2061,31],["οἱ",1,128],["δὲ",14,12],["λοιποὶ",523,130],["ἔφυγον",264,141],["εἰς",8,1],["γῆν",26,10],["Φυλιστιείμ",0,0]],"And they pursued them from the going down of Bethhoron