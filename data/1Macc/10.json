,5],["καὶ",2,8],["τοὺς",1,56],["συμφυγόντας",4425,466],["εἰς",8,1],["αὐτὸ",3,121],["ἐνεπύρισε",0,0],["πυρί",118,53]],"But Jonathan set fire on Azotus, and the cities round about it, and took their spoils; and the temple of Dagon, with them that were fled into it, he burned with fire."],["85",[["Καὶ",2,8],["ἐγένοντο",30,182],["οἱ",1,128],["πεπτωκότες",154,264],["μαχαίρᾳ",341,2],["σὺν",309,1],["τοῖς",1,138],["ἐμπυρισθεῖσιν",3435,495],["εἰς",8,1],["ἄνδρας",38,31],["ὀκτακισχιλίους",2859,58]],"Thus there were burned and slain with the sword well nigh eight thousand men."],["86",[["Καὶ",2,8],["ἀπῇρεν",850,14],["ἐκεῖθεν",428,17],["Ἰωνάθαν",263,7],["καὶ",2,8],["παρενέβαλεν",328,3],["ἐπὶ",9,1],["Ἀσκάλωνα",1930,7],["καὶ",2,8],["ἐξῆλθον",84,141],["οἱ",1,128],["ἐκ",21,1],["τῆς",1,18],["πόλεως",41,19],["εἰς",8,1],["συνάντησιν",426,87],["αὐτῷ",3,49],["ἐν",4,1],["δόξῃ",141,2],["μεγάλῃ",65,96]],"And from thence Jonathan removed his host, and camped against Ascalon, where the men of the city came forth, and met him with great pomp."],["87",[["Καὶ",2,8],["ἐπέστρεψεν",116,3],["Ἰωνάθαν",263,7],["εἰς",8,1],["Ἱερουσαλὴμ",69,20],["σὺν",309,1],["τοῖς",1,138],["παρʼ",72,1],["αὐτοῦ",3,48],["ἔχοντες",124,137],["σκῦλα",558,43],["πολλά",74,65]],"After this returned Jonathan and his host unto Jerusalem, having many spoils."],["88",[["Καὶ",2,8],["ἐγένετο",30,26],["ὡς",36,8],["ἤκουσεν",53,3],["Ἀλέξανδρος",1528,5],["ὁ",1,4],["βασιλεὺς",22,5],["τοὺς",1,56],["λόγους",48,31],["τούτους",16,274],["καὶ",2,8],["προσέθετο",200,26],["δοξάσαι",465,100],["τὸν",1,6],["Ἰωνάθαν",263,7]],"Now when king Alexander heard these things, he honoured Jonathan yet more,"],["89",[["Καὶ",2,8],["ἀπέστειλεν",83,3],["αὐτῷ",3,49],["πόρπην",5060,10],["χρυσῆν",290,37],["ὡς",36,8],["ἔθος",3765,33],["ἐστὶ",10,87],["δίδοσθαι",33,104],["τοῖς",1,138],["συγγενέσι",1740,215],["τῶν",1,76],["βασιλέων",22,77],["καὶ",2,8],["ἔδωκεν",33,3],["αὐτῷ",3,49],["τὴν",1,9],["Ἀκκαρὼν",0,0],["καὶ",2,8],["πάντα",11,65],["τὰ",1,42],["ὅρια",234,43],["αὐτῆς",3,83],["εἰς",8,1],["κληροδοσίαν",5769,10]],"and sent him a buckle of gold, as the use is to be given to such as are of the king's blood: he gave him also Accaron with the borders thereof in possession."]]