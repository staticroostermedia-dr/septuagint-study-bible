[["1",[["Καταβήτω",174,46],["ἀδελφιδός",1987,105],["μου",6,48],["εἰς",8,1],["κῆπον",1325,7],["αὐτοῦ",3,48],["καὶ",2,8],["φαγέτω",153,46],["καρπὸν",446,7],["ἀκροδρύων",4510,45],["αὐτοῦ",3,48],["εἰσῆλθον",88,141],["εἰς",8,1],["κῆπόν",1325,7],["μου",6,48],["ἀδελφή",519,13],["μου",6,48],["νύμφη",1060,13],["ἐτρύγησα",2307,147],["σμύρναν",2778,10],["μου",6,48],["μετὰ",29,1],["ἀρωμάτων",2058,45],["μου",6,48],["ἔφαγον",268,141],["ἄρτον",197,7],["μου",6,48],["μετὰ",29,1],["μέλιτός",804,24],["μου",6,48],["ἔπιον",215,141],["οἶνόν",261,7],["μου",6,48],["μετὰ",29,1],["γάλακτός",1031,24],["μου",6,48],["φάγετε",153,69],["πλήσιοι",3938,51],["καὶ",2,8],["πίετε",215,69],["καὶ",2,8],["μεθύσθητε",1274,358],["ἀδελφοί",66,51]],"Let my kinsman come down into his garden, and eat the fruit of his choice berries. I am come into my garden, my sister, [my] spouse: I have gathered my myrrh with my spices; I have eaten my bread with my honey; I have drunk my wine with my milk. Eat, O friends, and drink; yea, brethren, drink abundantly."],["2",[["Ἐγὼ",6,158],["καθεύδω",1725,149],["καὶ",2,8],["ἡ",1,11],["καρδία",63,13],["μου",6,48],["ἀγρυπνεῖ",2812,87],["φωνὴ",95,13],["ἀδελφιδοῦ",2814,21],["μου",6,48],["κρούει",4891,87],["ἐπὶ",9,1],["τὴν",1,9],["θύραν",277,10],["ἀνοιξόν",621,171],["μοι",6,49],["ἡ",1,11],["πλησίον",292,17],["μου",6,48],["ἄδελφή",519,13],["μου",6,48],["περιστερά",1278,13],["μου",6,48],["τελεία",1921,15],["μου",6,48],["ὅτι",19,8],["ἡ",1,11],["κεφαλή",144,13],["μου",6,83],["ἐπλήσθη",911,38],["δρόσου",1135,19],["καὶ",2,8],["οἱ",1,128],["βόστρυχοί",5535,51],["μου",6,83],["ψεκάδων",6250,61],["νυκτός",216,19]],"I sleep, but my heart is awake: the voice of my kinsman knocks at the door, [saying], Open, open to me, my companion, my sister, my dove, my perfect one: for my head is filled with dew, and my locks with the drops of the night."],["3",[["Ἐξεδυσάμην",1490,152],["τὸν",1,6],["χιτῶνά",1255,7],["μου",6,48],["πῶς",440,12],["ἐνδύοσμαι",0,0],["αὐτόν",3,82],["ἐνιψάμην",3316,152],["τοὺς",1,56],["πόδας",208,31],["μου",6,48],["πῶς",440,12],["μολυνῶ",2102,157],["αὐτούς",3,60]],"I have put off my coat; how shall I put it on? I have washed my feet, how shall I defile them?"],["4",[["Ἀδελφιδός",1987,105],["μου",6,48],["ἀπέστειλε",83,3],["χεῖρα",37,10],["αὐτοῦ",3,48],["ἀπὸ",17,1],["τῆς",1,18],["ὀπῆς",3774,19],["καὶ",2,8],["ἡ",1,11],["κοιλία",545,13],["μου",6,48],["ἐθροήθη",7311,38],["ἐπʼ",9,1],["αὐτόν",3,82]],"My kinsman put forth his hand by the hole [of the door], and my belly was moved for him."],["5",[["Ἀνέστην",121,147],["ἐγὼ",6,158],["ἀνοῖξαι",820,100],["τῷ",1,110],["ἀδελφιδῷ",2814,113],["μου",6,48],["χεῖρές",37,179],["μου",6,48],["ἔσταξαν",2204,141],["σμύρναν",2778,10],["δάκτυλοί",1182,51],["μου",6,48],["σμύρναν",2778,10],["πλήρη",489,37],["ἐπὶ",9,1],["χεῖρας",37,40],["τοῦ",1,23],["κλείθρου",3081,24]],"I rose up to open to my kinsman; my hands dropped myrrh, my fingers choice myrrh, on the handles of the lock."],["6",[["Ἤνοιξα",621,147],["ἐγὼ",6,158],["τῷ",1,110],["ἀδελφιδῷ",2814,113],["μου",6,48],["ἀδελφιδός",1987,105],["μου",6,48],["παρῆλθε",410,3],["ψυχή",62,13],["μου",6,48],["ἐξῆλθεν",84,3],["ἐν",4,1],["λόγῳ",48,113],["αὐτοῦ",3,48],["ἐζήτησα",190,147],["αὐτὸν",3,82],["καὶ",2,8],["οὐχ",12,17],["εὗρον",106,141],["αὐτὸν",3,82],["ἐκάλεσα",128,147],["αὐτὸν",3,82],["καὶ",2,8],["οὐχ",12,17],["ὑπήκουσέ",868,3],["μου",6,48]],"I opened to my kinsman; my kinsman was gone: my soul failed at his speech: I sought him, but found him not; I called him, but he answered me not."],["7",[["Εὕροσάν",0,0],["με",6,82],["οἱ",1,128],["φύλακες",2216,51],["οἱ",1,128],["κυκλοῦντες",600,137],["ἐν",4,1],["τῇ",1,95],["πόλει",41,2],["ἐπάταξάν",145,141],["με",6,82],["ἐτραυμάτισάν",1565,141],["με",6,82],["ᾖραν",0,0],["τὸ",1,32],["θέριστρόν",3543,33],["μου",6,48],["ἀπʼ",17,1],["ἐμοῦ",6,48],["φύλακες",2216,51],["τῶν",1,44],["τειχέων",323,45]],"The watchmen that go their rounds in the city found me, they smote me, they wounded me; the keepers of the walls took away my veil from me."],["8",[["Ὥρκισα",1578,147],["ὑμᾶς",5,209],["θυγατέρες",97,179],["Ἱερουσαλὴμ",69,20],["ἐν",4,1],["ταῖς",1,70],["δυνάμεσι",98,71],["καὶ",2,8],["ἐν",4,1],["ταῖς",1,70],["ἰσχύσεσι",4660,71],["τοῦ",1,30],["ἀγροῦ",252,21],["ἐὰν",45,8],["εὕρητε",106,118],["τὸν",1,6],["ἀδελφιδόν",0,0],["μου",6,48],["τί",39,119],["ἀπαγγείλητε",272,118],["αὐτῷ",3,49],["ὅτι",19,8],["τετρωμένη",1919,197],["ἀγάπης",1986,19],["ἐγώ",6,178],["εἰμι",10,149]],"I have charged you, O daughters of Jerusalem, by the powers and the virtues of the field: if ye should find my kinsman, what are ye to say to him? That I am wounded with love."],["9",[["Τί",39,119],["ἀδελφιδός",1987,105],["σου",5,146],["ἀπὸ",17,1],["ἀδελφιδοῦ",2814,21],["ἡ",1,11],["καλὴ",264,15],["ἐν",4,1],["γυναιξί",58,71],["τί",39,119],["ἀδελφιδός",1987,105],["σου",5,146],["ἀπὸ",17,1],["ἀδελφιδοῦ",2814,21],["ὅτι",19,8],["οὕτως",70,17],["ὥρκισας",1578,154],["ἡμᾶς",6,60]],"What is thy kinsman [more] than [another] kinsman, O thou beautiful among women? what is thy kinsman [more] than [another] kinsman, that thou hast so charged us?"],["10",[["Ἀδελφιδός",1987,105],["μου",6,48],["λευκὸς",1185,16],["καὶ",2,8],["πυῤῥὸς",3133,5],["ἐκλελοχισμένος",0,0],["ἀπὸ",17,1],["μυριάδων",1142,61]],"My kinsman is white and ruddy, chosen out from myriads."],["11",[["Κεφαλὴ",144,13],["αὐτοῦ",3,48],["χρυσίον",202,20],["κεφὰζ",0,0],["βόστρυχοι",5535,51],["αὐτοῦ",3,48],["ἐλάται",5334,179],["μέλανες",3915,130],["ὡς",36,8],["κόραξ",2742,5]],"His head is [as] very fine gold, his locks are flowing, black as a raven."],["12",[["Ὀφθαλμοὶ",91,51],["αὐτοῦ",3,48],["ὡς",36,8],["περιστεραὶ",1278,179],["ἐπὶ",9,1],["πληρώματα",2198,43],["ὑδάτων",85,45],["λελουσμέναι",0,0],["ἐν",4,1],["γάλακτι",1031,53],["καθήμεναι",417,704],["ἐπὶ",9,1],["πληρώματα",2198,43]],"His eyes are as doves, by the pools of waters, washed with milk, sitting by the pools."],["13",[["Σιαγόνες",1784,179],["αὐτοῦ",3,48],["ὡς",36,8],["φιάλαι",1286,179],["τοῦ",1,23],["ἀρώματος",2058,24],["φύουσαι",2134,305],["μυρ