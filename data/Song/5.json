[["1",[["Καταβήτω",175,46],["ἀδελφιδός",1983,105],["μου",6,48],["εἰς",8,1],["κῆπον",1325,7],["αὐτοῦ",3,48],["καὶ",2,8],["φαγέτω",147,46],["καρπὸν",448,7],["ἀκροδρύων",4487,45],["αὐτοῦ",3,48],["εἰσῆλθον",86,141],["εἰς",8,1],["κῆπόν",1325,7],["μου",6,48],["ἀδελφή",521,13],["μου",6,48],["νύμφη",1060,13],["ἐτρύγησα",2295,147],["σμύρναν",2768,10],["μου",6,48],["μετὰ",29,1],["ἀρωμάτων",2052,45],["μου",6,48],["ἔφαγον",269,141],["ἄρτον",197,7],["μου",6,48],["μετὰ",29,1],["μέλιτός",807,24],["μου",6,48],["ἔπιον",212,141],["οἶνόν",261,7],["μου",6,48],["μετὰ",29,1],["γάλακτός",1034,24],["μου",6,48],["φάγετε",147,69],["πλήσιοι",3927,51],["καὶ",2,8],["πίετε",212,69],["καὶ",2,8],["μεθύσθητε",1276,353],["ἀδελφοί",67,51]],"Let my kinsman come down into his garden, and eat the fruit of his choice berries. I am come into my garden, my sister, [my] spouse: I have gathered my myrrh with my spices; I have eaten my bread with my honey; I have drunk my wine with my milk. Eat, O friends, and drink; yea, brethren, drink abundantly."],["2",[["Ἐγὼ",6,158],["καθεύδω",1724,149],["καὶ",2,8],["ἡ",1,11],["καρδία",64,13],["μου",6,48],["ἀγρυπνεῖ",2802,87],["φωνὴ",95,13],["ἀδελφιδοῦ",11518,21],["μου",6,48],["κρούει",4866,87],["ἐπὶ",9,1],["τὴν",1,9],["θύραν",277,10],["ἀνοιξόν",362,171],["μοι",6,49],["ἡ",1,11],["πλησίον",292,17],["μου",6,48],["ἄδελφή",521,13],["μου",6,48],["περιστερά",1280,13],["μου",6,48],["τελεία",1919,15],["μου",6,48],["ὅτι",19,8],["ἡ",1,11],["κεφαλή",144,13],["μου",6,83],["ἐπλήσθη",909,38],["δρόσου",1135,19],["καὶ",2,8],["οἱ",1,128],["βόστρυχοί",5505,51],["μου",6,83],["ψεκάδων",6220,61],["νυκτός",219,19]],"I sleep, but my heart is awake: the voice of my kinsman knocks at the door, [saying], Open, open to me, my companion, my sister, my dove, my perfect one: for my head is filled with dew, and my locks with the drops of the night."],["3",[["Ἐξεδυσάμην",1488,152],["τὸν",1,6],["χιτῶνά",1254,7],["μου",6,48],["πῶς",441,12],["ἐνδύοσμαι",0,0],["αὐτόν",3,82],["ἐνιψάμην",3310,152],["τοὺς",1,56],["πόδας",210,31],["μου",6,48],["πῶς",441,12],["μολυνῶ",1901,157],["αὐτούς",3,60]],"I have put off my coat; how shall I put it on? I have washed my feet, how shall I defile them?"],["4",[["Ἀδελφιδός",1983,105],["μου",6,48],["ἀπέστειλε",84,3],["χεῖρα",37,10],["αὐτοῦ",3,48],["ἀπὸ",17,1],["τῆς",1,18],["ὀπῆς",3762,19],["καὶ",2,8],["ἡ",1,11],["κοιλία",547,13],["μου",6,48],["ἐθροήθη",7260,38],["ἐπʼ",9,1],["αὐτόν",3,82]],"My kinsman put forth his hand by the hole [of the door], and my belly was moved for him."],["5",[["Ἀνέστην",121,147],["ἐγὼ",6,158],["ἀνοῖξαι",362,100],["τῷ",1,110],["ἀδελφιδῷ",11518,113],["μου",6,48],["χεῖρές",37,180],["μου",6,48],["ἔσταξαν",2191,141],["σμύρναν",2768,10],["δάκτυλοί",1182,51],["μου",6,48],["σμύρναν",2768,10],["πλήρη",490,37],["ἐπὶ",9,1],["χεῖρας",37,40],["τοῦ",1,23],["κλείθρου",3070,24]],"I rose up to open to my kinsman; my hands dropped myrrh, my fingers choice myrrh, on the handles of the lock."],["6",[["Ἤνοιξα",362,147],["ἐγὼ",6,158],["τῷ",1,110],["ἀδελφιδῷ",11518,113],["μου",6,48],["ἀδελφιδός",1983,105],["μου",6,48],["παρῆλθε",404,3],["ψυχή",63,13],["μου",6,48],["ἐξῆλθεν",82,3],["ἐν",4,1],["λόγῳ",48,113],["αὐτοῦ",3,48],["ἐζήτησα",191,147],["αὐτὸν",3,82],["καὶ",2,8],["οὐχ",12,17],["εὗρον",101,141],["αὐτὸν",3,82],["ἐκάλεσα",128,147],["αὐτὸν",3,82],["καὶ",2,8],["οὐχ",12,17],["ὑπήκουσέ",867,3],["μου",6,48]],"I opened to my kinsman; my kinsman was gone: my soul failed at his speech: I sought him, but found him not; I called him, but he answered me not."],["7",[["Εὕροσάν",101,141],["με",6,82],["οἱ",1,128],["φύλακες",2202,51],["οἱ",1,128],["κυκλοῦντες",603,137],["ἐν",4,1],["τῇ",1,95],["πόλει",41,2],["ἐπάταξάν",145,141],["με",6,82],["ἐτραυμάτισάν",1450,141],["με",6,82],["ᾖραν",206,141],["τὸ",1,32],["θέριστρόν",3539,33],["μου",6,48],["ἀπʼ",17,1],["ἐμοῦ",6,48],["φύλακες",2202,51],["τῶν",1,44],["τειχέων",325,45]],"The watchmen that go their rounds in the city found me, they smote me, they wounded me; the keepers of the walls took away my veil from me."],["8",[["Ὥρκισα",1577,147],["ὑμᾶς",5,209],["θυγατέρες",97,180],["Ἱερουσαλὴμ",70,20],["ἐν",4,1],["ταῖς",1,70],["δυνάμεσι",98,71],["καὶ",2,8],["ἐν",4,1],["ταῖς",1,70],["ἰσχύσεσι",4636,71],["τοῦ",1,30],["ἀγροῦ",252,21],["ἐὰν",45,8],["εὕρητε",101,118],["τὸν",1,6],["ἀδελφιδόν",0,0],["μου",6,48],["τί",39,119],["ἀπαγγείλητε",273,118],["αὐτῷ",3,49],["ὅτι",19,8],["τετρωμένη",1917,197],["ἀγάπης",1982,19],["ἐγώ",6,179],["εἰμι",10,149]],"I have charged you, O daughters of Jerusalem, by the powers and the virtues of the field: if ye should find my kinsman, what are ye to say to him? That I am wounded with love."],["9",[["Τί",39,119],["ἀδελφιδός",1983,105],["σου",5,146],["ἀπὸ",17,1],["ἀδελφιδοῦ",11518,21],["ἡ",1,11],["καλὴ",266,15],["ἐν",4,1],["γυναιξί",59,71],["τί",39,119],["ἀδελφιδός",1983,105],["σου",5,146],["ἀπὸ",17,1],["ἀδελφιδοῦ",11518,21],["ὅτι",19,8],["οὕτως",71,17],["ὥρκισας",1577,154],["ἡμᾶς",6,60]],"What is thy kinsman [more] than [another] kinsman, O thou beautiful among women? what is thy kinsman [more] than [another] kinsman, that thou hast so charged us?"],["10",[["Ἀδελφιδός",1983,105],["μου",6,48],["λευκὸς",1184,16],["καὶ",2,8],["πυῤῥὸς",3125,5],["ἐκλελοχισμένος",9306,408],["ἀπὸ",17,1],["μυριάδων",1142,61]],"My kinsman is white and ruddy, chosen out from myriads."],["11",[["Κεφαλὴ",144,13],["αὐτοῦ",3,48],["χρυσίον",202,20],["κεφὰζ",0,0],["βόστρυχοι",5505,51],["αὐτοῦ",3,48],["ἐλάται",5300,180],["μέλανες",3904,130],["ὡς",36,8],["κόραξ",2735,5]],"His head is [as] very fine gold, his locks are flowing, black as a raven."],["12",[["Ὀφθαλμοὶ",91,51],["αὐτοῦ",3,48],["ὡς",36,8],["περιστεραὶ",1280,180],["ἐπὶ",9,1],["πληρώματα",2185,43],["ὑδάτων",85,45],["λελουσμέναι",0,0],["ἐν",4,1],["γάλακτι",1034,53],["καθήμεναι",419,681],["ἐπὶ",9,1],["πληρώματα",2185,43]],"His eyes are as doves, by the pools of waters, washed with milk, sitting by the pools."],["13",[["Σιαγόνες",1784,180],["αὐτοῦ",3,48],["ὡς",36,8],["φιάλαι",1287,180],["τοῦ",1,23],["ἀρώματος",2052,24],["φύουσαι",2127,301],["μυρεψικά",4313,63],["χείλη",361,63],["αὐτοῦ",3,48],["κρίνα",2021,63],["στάζοντα",2191,289],["σμύρναν",2768,10],["πλήρη",490,37]],"His cheeks are as bowls of spices pouring forth perfumes: his lips are lilies, dropping choice myrrh."],["14",[["Χεῖρες",37,180],["αὐτοῦ",3,48],["τορευταὶ",3658,187],["χρυσαῖ",290,187],["πεπληρωμέναι",518,424],["Θαρσίς",0,0],["κοιλία",547,13],["αὐτοῦ",3,48],["πυξίον",4377,20],["ἐλεφάντινον",2826,28],["ἐπὶ",9,1],["λίθου",195,21],["σαπφείρου",2388,19]],"His hands are as turned gold set with beryl: his belly is an ivory tablet on a sapphire stone."],["15",[["Κνῆμαι",3561,180],["αὐτοῦ",3,48],["στύλοι",395,51],["μαρμάρινοι",7633,130],["τεθεμελιωμένοι",1116,370],["ἐπὶ",9,1],["βάσεις",734,40],["χρυσᾶς",290,109],["εἶδος",949,20],["αὐτοῦ",3,48],["ὡς",36,8],["Λίβανος",537,5],["ἐκλεκτὸς",552,16],["ὡς",36,8],["κέδροι",873,180]],"His legs are marble pillars set on golden sockets: his form is as Libanus, choice as the cedars."],["16",[["Φάρυγξ",2973,5],["αὐτοῦ",3,48],["γλυκασμοὶ",4723,51],["καὶ",2,8],["ὅλος",235,16],["ἐπιθυμία",699,13],["οὗτος",16,112],["ἀδελφιδός",1983,105],["μου",6,48],["καὶ",2,8],["οὗτος",16,112],["πλησίον",292,17],["μου",6,48],["θυγατέρες",97,180],["Ἱερουσαλήμ",70,20]],"His throat is most sweet, and altogether desirable. This is my kinsman, and this is my companion, O daughters of Jerusalem."]]