[["1",[["Ἐπίστρεφε",116,239],["ἐπίστρεφε",116,239],["ἡ",1,11],["Σουναμίτις",0,0],["ἐπίστρεφε",116,239],["ἐπίστρεφε",116,239],["καὶ",2,8],["ὀφόμεθα",0,0],["ἐν",4,1],["σοί",5,151],["Τί",39,119],["ὄψεσθε",111,117],["ἐν",4,1],["τῇ",1,95],["Σουναμίτιδι",0,0],["ἡ",1,11],["ἐρχομένη",56,204],["ὡς",36,8],["χοροὶ",1846,51],["τῶν",1,123],["παρεμβολῶν",189,61]],"Return, return, O Sunamite; return, return, and we will look at thee. What will ye see in the Sunamite? She comes as bands of armies."],["2",[["Ὡραιώθησαν",4156,436],["διαβήματά",2082,63],["σου",5,146],["ἐν",4,1],["ὑποδήμασί",1666,92],["σου",5,146],["θύγατερ",97,361],["ναδάβ",0,0],["ῥυθμοὶ",4159,51],["μηρῶν",1275,77],["ὅμοιοι",651,130],["ὁρμίσκοις",4141,139],["ἔργον",104,33],["τεχνίτου",2304,21]],"Thy steps are beautiful in shoes, O daughter of the prince: the joints of [thy] thighs are like chains, the work of the craftsman."],["3",[["Ὀμφαλός",4662,5],["σου",5,146],["κρατὴρ",3084,5],["τορευτὸς",3665,16],["μὴ",25,8],["ὑστερούμενος",1948,114],["κράμα",7566,20],["κοιλία",545,13],["σου",5,146],["θημωνία",3540,105],["σίτου",660,21],["πεφραγμένη",0,0],["ἐν",4,1],["κρίνοις",240,481]],"Thy navel is [as] a turned bowl, not wanting liquor; thy belly is [as] a heap of wheat set about with lilies."],["4",[["Δύο",103,57],["μαστοί",1273,51],["σου",5,146],["ὡς",36,8],["δύο",103,57],["νεβροὶ",3918,51],["δίδυμοι",3489,51],["δορκάδος",2166,19]],"Thy two breasts are as two twin fawns."],["5",[["Ὁ",1,4],["τράχηλός",690,5],["σου",5,146],["ὡς",36,8],["πύργος",709,5],["ἐλεφάντινος",2840,16],["οἱ",1,128],["ὀφθαλμοί",91,51],["σου",5,146],["ὡς",36,8],["λίμναι",3894,179],["ἐν",4,1],["Ἐσεβὼν",0,0],["ἐν",4,1],["πύλαις",162,71],["θυγατρὸς",97,19],["πολλῶν",74,163],["μυκτήρ",2753,5],["σου",5,146],["ὡς",36,8],["πύργος",709,5],["τοῦ",1,30],["Λιβάνου",534,21],["σκοπεύων",3353,67],["πρόσωπον",47,33],["Δαμασκοῦ",1012,21]],"Thy neck is as an ivory tower; thine eyes are as pools in Esebon, by the gates of the daughter of many: thy nose is as the tower of Libanus, looking toward Damascus."],["6",[["Κεφαλή",144,13],["σου",5,146],["ἐπὶ",9,1],["σὲ",5,161],["ὡς",36,8],["Κάρμηλος",1668,5],["καὶ",2,8],["πλόκιον",8053,20],["κεφαλῆς",144,19],["σου",5,146],["ὡς",36,8],["πορφύρα",1062,13],["βασιλεὺς",22,5],["δεδεμένος",439,228],["ἐν",4,1],["παραδρομαῖς",5924,71]],"Thy head upon thee is as Carmel, and the curls of thy hair like scarlet; the king is bound in the galleries."],["7",[["Τί",39,119],["ὡραιώθης",4156,327],["καὶ",2,8],["τί",39,119],["ἡδύνθης",3215,363],["ἀγάπη",1986,13]],"How beautiful art thou, and how sweet art thou, [my] love!"],["8",[["ἐν",4,1],["τρυφαῖς",1642,71],["σου",5,146],["τοῦτο",16,122],["μέγεθός",2104,33],["σου",5,146],["ὡμοιώθης",1197,363],["τῷ",1,110],["φοίνικι",1172,113],["καὶ",2,8],["οἱ",1,128],["μαστοί",1273,51],["σου",5,146],["τοῖς",1,138],["βότρυσιν",2350,71]],"This is thy greatness in thy delights: thou wast made like a palm tree, and thy breasts to clusters."],["9",[["Εἶπα",18,147],["ἀναβήσομαι",87,176],["ἐπὶ",9,1],["τῷ",1,110],["φοίνικι",1172,113],["κρατήσω",383,157],["τῶν",1,44],["ὕψεων",480,45],["αὐτοῦ",3,48],["καὶ",2,8],["ἔσονται",10,127],["δὴ",193,12],["μαστοί",1273,51],["σου",5,146],["ὡς",36,8],["βότρυες",2350,179],["τῆς",1,18],["ἀμπέλου",810,19],["καὶ",2,8],["ὀσμὴ",682,13],["ῥινός",3038,19],["σου",5,146],["ὡς",36,8],["μῆλα",2937,63]],"I said, I will go up to the palm tree, I will take hold of its high boughs: and now shall thy breasts be as clusters of the vine, and the smell of thy nose as apples;"],["10",[["καὶ",2,8],["ὁ",1,4],["λάρυγξ",2097,5],["σου",5,146],["ὡς",36,8],["οἶνος",261,5],["ὁ",1,4],["ἀγαθὸς",113,16],["πορευόμενος",49,114],["τῷ",1,110],["ἀδελφιδῷ",2814,113],["μου",6,48],["εἰς",8,1],["εὐθύτητα",1676,10],["ἱκανούμενος",2434,114],["χείλεσί",361,92],["μου",6,48],["καὶ",2,8],["ὀδοῦσιν",929,139]],"and thy throat as good wine, going well with my kinsman, suiting my lips and teeth."],["11",[["Ἐγὼ",6,158],["τῷ",1,110],["ἀδελφιδῷ",2814,113],["μου",6,48],["καὶ",2,8],["ἐπʼ",9,1],["ἐμὲ",6,82],["ἡ",1,11],["ἐπιστροφὴ",3446,13],["αὐτοῦ",3,48]],"I am my kinsman's, and his desire is toward me."],["12",[["Ἐλθὲ",56,198],["ἀδελφιδέ",0,0],["μου",6,48],["ἐξέλθωμεν",84,75],["εἰς",8,1],["ἀγρὸν",252,7],["αὐλισθῶμεν",991,283],["ἐν",4,1],["κώμαις",676,71]],"Come, my kinsman, let us go forth into the field; let us lodge in the villages."],["13",[["Ὀρθρίσωμεν",930,75],["εἰς",8,1],["ἀμπελῶνας",603,31],["ἴδωμεν",73,75],["εἰ",77,8],["ἤνθησεν",2220,3],["ἡ",1,11],["ἄμπελος",810,13],["ἤνθησεν",2220,3],["ὁ",1,4],["κυπρισμὸς",7581,5],["ἤνθησν",0,0],["αἱ",1,183],["ῥοαί",2164,179],["ἐκεῖ",76,17],["δώσω",33,157],["τοὺς",1,56],["μαστούς",1273,31],["μου",6,48],["σοί",5,151]],"Let us go early into the vineyards; let us see if the vine has flowered, [if] the blossoms have appeared, if the pomegranates have blossomed; there will I give thee my breasts."],["14",[["Οἱ",1,128],["μανδραγόραι",3589,113],["ἔδωκαν",33,141],["ὀσμήν",682,10],["καὶ",2,8],["ἐπὶ",9,1],["θύραις",277,71],["ἡμῶν",6,41],["πάντα",11,65],["ἀκρόδρυα",4510,43],["νέα",513,65],["πρὸς",15,1],["παλαιὰ",1905,65],["ἀδελφιδέ",0,0],["μου",6,48],["ἐτήρησά",1356,147],["σοι",5,151]],"The mandrakes have given a smell, and at our doors [are] all kinds of choice fruits, new and old. O my kinsman, I have kept [them] for thee."]]