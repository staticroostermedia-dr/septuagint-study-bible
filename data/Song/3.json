[["1",[["Ἐπὶ",9,1],["κοίτην",704,10],["μου",6,48],["ἐν",4,1],["νυξὶν",219,71],["ἐζήτησα",191,147],["ὃν",24,106],["ἠγάπησεν",214,3],["ἡ",1,11],["ψυχή",63,13],["μου",6,48],["ἐζήτησα",191,147],["αὐτὸν",3,82],["καὶ",2,8],["οὐχ",12,17],["εὗρον",101,141],["αὐτόν",3,82],["ἐκάλεσα",128,147],["αὐτὸν",3,82],["καὶ",2,8],["οὐχ",12,17],["ὑπήκουσέ",867,3],["μου",6,48]],"By night on my bed I sought him whom my soul loves: I sought him, but found him not; I called him, but he hearkened not to me."],["2",[["Ἀναστήσομαι",121,177],["δὴ",193,12],["καὶ",2,8],["κυκλώσω",603,157],["ἐν",4,1],["τῇ",1,95],["πόλει",41,2],["ἐν",4,1],["ταῖς",1,70],["ἀγοραῖς",2648,71],["καὶ",2,8],["ἐν",4,1],["ταῖς",1,70],["πλατείαις",925,71],["καὶ",2,8],["ζητήσω",191,157],["ὃν",24,106],["ἠγάπησεν",214,3],["ἡ",1,11],["ψυχή",63,13],["μου",6,48],["ἐζήτησα",191,147],["αὐτὸν",3,82],["καὶ",2,8],["οὐχ",12,17],["εὗρον",101,141],["αὐτόν",3,82]],"I will rise now, and go about in the city, in the market-places, and in the streets, and I will seek him whom my soul loves: I sought him, but I found him not."],["3",[["Εὕροσάν",101,141],["με",6,82],["οἱ",1,128],["τηροῦντες",1358,137],["οἱ",1,128],["κυκλοῦντες",603,137],["ἐν",4,1],["τῇ",1,95],["πόλει",41,2],["Μὴ",25,8],["ὃν",24,106],["ἠγάπησεν",214,3],["ἡ",1,11],["ψυχή",63,13],["μου",6,48],["ἴδετε",53,69]],"The watchmen who go their rounds in the city found me. [I said], Have ye seen him whom my soul loves?"],["4",[["Ὡς",36,8],["μικρὸν",367,29],["ὅτε",432,8],["παρῆλθον",404,141],["ἀπʼ",17,1],["αὐτῶν",3,41],["ἕως",42,8],["οὗ",120,17],["εὗρον",101,141],["ὃν",24,106],["ἠγάπησεν",214,3],["ἡ",1,11],["ψυχή",63,13],["μου",6,48],["ἐκράτησα",385,147],["αὐτὸν",3,82],["καὶ",2,8],["οὐκ",12,17],["ἀφῆκα",501,147],["αὐτὸν",3,82],["ἕως",42,8],["οὗ",120,17],["εἰσήγαγον",389,141],["αὐτὸν",3,82],["εἰς",8,1],["οἶκον",34,7],["μητρός",189,19],["μου",6,83],["καὶ",2,8],["εἰς",8,1],["ταμεῖον",1528,20],["τῆς",1,18],["συλλαβούσης",507,501],["με",6,82]],"[It was] as a little [while] after I parted from them, that I found him whom my soul loves: I held him, and did not let him go, until I brought him into my mother's house, and into the chamber of her that conceived me."],["5",[["Ὥρκισα",1577,147],["ὑμᾶς",5,209],["θυγατέρες",97,180],["Ἱερουσαλὴμ",70,20],["ἐν",4,1],["ταῖς",1,70],["δυνάμεσι",98,71],["καὶ",2,8],["ἐν",4,1],["ταῖς",1,70],["ἰσχύσεσι",4636,71],["τοῦ",1,30],["ἀγροῦ",252,21],["ἐὰν",45,8],["ἐγείρητε",746,118],["καὶ",2,8],["ἐξεγείρητε",656,118],["τὴν",1,9],["ἀγάπην",1982,10],["ἕως",42,8],["ἂν",83,12],["θελήσῃ",612,160]],"I have charged you, O daughters of Jerusalem, by the powers and by the virtues of the field, that ye rouse not nor awake [my] love, until he please."],["6",[["Τίς",39,368],["αὕτη",16,101],["ἡ",1,11],["ἀναβαίνουσα",88,183],["ἀπὸ",17,1],["τῆς",1,18],["ἐρήμου",160,78],["ὡς",36,8],["στελέχη",2630,63],["καπνοῦ",1469,21],["τεθυμιαμένη",756,197],["σμύρναν",2768,10],["καὶ",2,8],["λίβανον",537,7],["ἀπὸ",17,1],["πάντων",11,163],["κονιορτῶν",1894,77],["μυρεψοῦ",2921,21]],"Who is this that comes up from the wilderness as pillars of smoke, perfumed with myrrh and frankincense, with all powders of the perfumer?"],["7",[["Ἰδοὺ",51,17],["ἡ",1,11],["κλίνη",1221,13],["τοῦ",1,30],["Σαλωμὼν",173,61],["ἑξήκοντα",881,57],["δυνατοὶ",356,130],["κύκλῳ",258,17],["αὐτῆς",3,83],["ἀπὸ",17,1],["δυνατῶν",356,115],["Ἰσραήλ",27,105]],"Behold Solomon's bed; sixty mighty men of the mighty ones of Israel are round about it."],["8",[["Πάντες",11,130],["κατέχοντες",1040,137],["ῥομφαίαν",248,10],["δεδιδαγμένοι",545,370],["πόλεμον",163,7],["ἀνὴρ",38,5],["ῥομφαία",248,13],["αὐτοῦ",3,48],["ἐπὶ",9,1],["μηρὸν",1277,7],["αὐτοῦ",3,144],["ἀπὸ",17,1],["θάμβους",3840,24],["ἐν",4,1],["νυξί",219,71]],"They all hold a sword, being expert in war: every man [has] his sword upon his thigh because of fear by night."],["9",[["Φορεῖον",4457,20],["ἐποίησεν",23,3],["ἑαυτῷ",92,49],["ὁ",1,4],["βασιλεὺς",22,5],["Σαλωμὼν",173,61],["ἀπὸ",17,1],["ξύλων",196,45],["τοῦ",1,30],["Λιβάνου",537,21]],"King Solomon made himself a litter of woods of Lebanon."],["10",[["Στύλους",395,31],["αὐτοῦ",3,48],["ἐποίησεν",23,3],["ἀργύριον",152,33],["καὶ",2,8],["ἀνάκλιτον",8952,33],["αὐτοῦ",3,48],["χρύσεον",290,29],["ἐπίβασις",4612,13],["αὐτοῦ",3,48],["πορφυρᾶ",3929,15],["ἐντὸς",3192,17],["αὐτοῦ",3,48],["λιθόστρωτον",4885,37],["ἀγάπην",1982,10],["ἀπὸ",17,1],["θυγατέρων",97,61],["Ἱερουσαλήμ",70,20]],"He made the pillars of it silver, the bottom of it gold, the covering of it scarlet, in the midst of it a pavement of love, for the daughters of Jerusalem."],["11",[["Θυγατέρες",97,180],["Σιὼν",334,2],["ἐξέλθατε",82,69],["καὶ",2,8],["ἴδετε",53,69],["ἐν",4,1],["τῷ",1,110],["βασιλεῖ",22,113],["Σαλωμὼν",173,61],["ἐν",4,1],["τῷ",1,110],["στεφάνῳ",980,113],["ᾧ",24,202],["ἐστεφάνωσεν",3354,3],["αὐτὸν",3,82],["ἡ",1,11],["μήτηρ",189,13],["αὐτοῦ",3,48],["ἐν",4,1],["ἡμέρᾳ",28,2],["νυμφεύσεως",7781,19],["αὐτοῦ",3,48],["καὶ",2,8],["ἐν",4,1],["ἡμέρᾳ",28,2],["εὐφροσύνης",360,19],["καρδίας",64,19],["αὐτοῦ",3,48]],"Go forth, ye daughters of Sion, and behold king Solomon, with the crown wherewith his mother crowned him, in the day of his espousals, and in the day of the gladness of his heart."]]