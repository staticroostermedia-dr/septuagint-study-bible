[["1",[["Ποῦ",477,17],["ἀπῆλθεν",305,3],["ὁ",1,4],["ἀδελφιδός",1987,105],["σου",5,146],["ἡ",1,11],["καλὴ",264,15],["ἐν",4,1],["γυναιξὶ",58,71],["ποῦ",477,17],["ἀπέβλεψεν",4042,3],["ὁ",1,4],["ἀδελφιδός",1987,105],["σου",5,146],["καὶ",2,8],["ζητήσομεν",190,269],["αὐτὸν",3,82],["μετὰ",29,1],["σοῦ",5,146]],"Whither is thy kinsman gone, thou beautiful among women? whither has thy kinsman turned aside? [tell us], and we will seek him with thee."],["2",[["Ἀδελφιδός",1987,105],["μου",6,48],["κατέβη",174,3],["εἰς",8,1],["κῆπον",1325,7],["αὐτοῦ",3,48],["εἰς",8,1],["φιάλας",1286,40],["τοῦ",1,23],["ἀρώματος",2058,24],["ποιμαίνειν",955,54],["ἐν",4,1],["κήποις",1325,139],["καὶ",2,8],["συλλέγειν",1148,54],["κρίνα",3292,43]],"My kinsman is gone down to his garden, to the beds of spice, to feed [his flock] in the gardens, and to gather lilies."],["3",[["Ἐγὼ",6,158],["τῷ",1,110],["ἀδελφιδῷ",2814,113],["μου",6,48],["καὶ",2,8],["ἀδελφιδός",1987,105],["μου",6,48],["ἐμοί",6,49],["ὁ",1,4],["ποιμαίνων",955,67],["ἐν",4,1],["τοῖς",1,138],["κρίνοις",240,481]],"I am my kinsman's, and my kinsman is mine, who feeds among the lilies."],["4",[["Καλὴ",264,15],["εἶ",10,145],["ἡ",1,11],["πλησίον",292,17],["μου",6,48],["ὡς",36,8],["εὐδοκία",1624,13],["ὡραῖα",1296,74],["ὡς",36,8],["Ἱερουσαλὴμ",69,20],["θάμβος",3851,20],["ὡς",36,8],["τεταγμέναι",783,431]],"Thou art fair, my companion, as Pleasure, beautiful as Jerusalem, terrible as [armies] set in array."],["5",[["Ἀπόστρεψον",130,198],["ὀφθαλμούς",91,31],["σου",5,146],["ἀπεναντίον",9055,17],["μου",6,48],["ὅτι",19,8],["αὐτοὶ",3,193],["ἀνεπτέρωσάν",6296,141],["με",6,82],["τρίχωμά",4466,20],["σου",5,146],["ὡς",36,8],["ἀγέλαι",2652,179],["τῶν",1,76],["αἰγῶν",684,77],["αἳ",1,183],["ἀνεφάνησαν",3697,94],["ἀπὸ",17,1],["τοῦ",1,30],["Γαλαάδ",0,0]],"Turn away thine eyes from before me, for they have ravished me: thy hair is as flocks of goats which have appeared from Galaad."],["6",[["Ὀδόντες",929,51],["σου",5,146],["ὡς",36,8],["ἀγέλαι",2652,179],["τῶν",1,76],["κεκαρμένων",1730,457],["αἳ",1,183],["ἀνέβησαν",87,141],["ἀπὸ",17,1],["τοῦ",1,23],["λουτροῦ",4911,24],["αἱ",1,183],["πᾶσαι",11,185],["διδυμεύουσαι",5598,305],["καὶ",2,8],["ἀτεκνοῦσα",2226,181],["οὐκ",12,17],["ἔστιν",10,87],["ἐν",4,1],["αὐταῖς",3,192],["ὡς",36,8],["σπαρτίον",2779,20],["τὸ",1,27],["κόκκινον",1117,28],["χείλη",361,43],["σου",5,146],["καὶ",2,8],["ἡ",1,11],["λαλιά",1826,13],["σου",5,146],["ὡραιᾶ",1296,74]],"Thy teeth are as flocks of shorn [sheep], that have gone up from the washing, all of them bearing twins, and there is none barren among them: thy lips are as a thread of scarlet, and thy speech is comely."],["7",[["Ὡς",36,8],["λέπυρον",5833,20],["ῥοᾶς",2164,19],["μῆλόν",2937,20],["σου",5,146],["ἐκτὸς",1706,17],["τῆς",1,18],["σιωπήσεώς",5065,19],["σου",5,146]],"Thy cheek is like the rind of a pomegranate, [being seen] without thy veil."],["8",[["Ἑξήκοντά",882,57],["εἰσι",10,189],["βασίλισσαι",157,179],["καὶ",2,8],["ὀγδοήκοντα",1435,57],["παλλακαὶ",1119,179],["καὶ",2,8],["νεάνιδες",1518,179],["ὧν",24,97],["οὐκ",12,17],["ἔστιν",10,87],["ἀριθμός",353,5]],"There are sixty queens, and eighty concubines, and maidens without number."],["9",[["Μία",57,15],["ἐστὶ",10,87],["περιστερά",1278,13],["μου",6,48],["τελεία",1921,15],["μου",6,48],["μία",57,15],["ἐστὶ",10,87],["τῇ",1,95],["μητρὶ",188,2],["αὐτῆς",3,83],["ἐκλεκτή",551,15],["ἐστι",10,87],["τῇ",1,95],["τεκούσῃ",251,589],["αὐτήν",3,98],["Εἴδοσαν",0,0],["αὐτὴν",3,98],["θυγατέρες",97,179],["καὶ",2,8],["μακαριοῦσιν",1683,207],["αὐτὴν",3,98],["βασίλισσαι",157,179],["καί",2,8],["γε",351,12],["παλλακαὶ",1119,179],["καὶ",2,8],["αἰνέσουσιν",399,207],["αὐτήν",3,98]],"My dove, my perfect one is one; she is the [only] one of her mother; she is the choice of her that bore her. The daughters saw her, and the queens will pronounce her blessed, yea, and the concubines, and they will praise her."],["10",[["Τίς",39,373],["αὕτη",16,101],["ἡ",1,11],["ἐκκύπτουσα",3737,181],["ὡσεὶ",342,17],["ὄρθρος",1436,5],["καλὴ",264,15],["ὡς",36,8],["σελήνη",1211,13],["ἐκλεκτὴ",551,15],["ὡς",36,8],["ὁ",1,4],["ἥλιος",320,5],["θάμβος",3851,20],["ὡς",36,8],["τεταγμέναι",783,431]],"Who is this that looks forth as the morning, fair as the moon, choice as the sun, terrible as [armies] set in array?"],["11",[["Εἰς",8,1],["κῆπον",1325,7],["καρύας",7372,40],["κατέβην",174,147],["ἰδεῖν",73,100],["ἐν",4,1],["γεννήμασι",740,92],["τοῦ",1,30],["χειμάῤῥου",736,21],["ἰδεῖν",73,100],["εἰ",77,8],["ἤνθησεν",2220,3],["ἡ",1,11],["ἄμπελος",810,13],["ἐξήνθησαν",1801,141],["αἱ",1,183],["ῥοαί",2164,179]],"I went down to the garden of nuts, to look at the fruits of the valley, to see if the vine flowered, [if] the pomegranates blossomed."],["12",[["Ἐκεῖ",76,17],["δώσω",33,157],["τοὺς",1,56],["μαστούς",1273,31],["μου",6,48],["σοί",5,151],["οὐκ",12,17],["ἔγνω",81,3],["ἡ",1,11],["ψυχή",62,13],["μου",6,48],["ἔθετο",109,26],["με",6,82],["ἅρματα",359,63],["Ἀμιναδάβ",1489,105]],"There I will give thee my breasts: my soul knew [it] not: it made me as the chariots of Aminadab."]]