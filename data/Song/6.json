[["1",[["Ποῦ",478,17],["ἀπῆλθεν",297,3],["ὁ",1,4],["ἀδελφιδός",1983,105],["σου",5,146],["ἡ",1,11],["καλὴ",266,15],["ἐν",4,1],["γυναιξὶ",59,71],["ποῦ",478,17],["ἀπέβλεψεν",4033,3],["ὁ",1,4],["ἀδελφιδός",1983,105],["σου",5,146],["καὶ",2,8],["ζητήσομεν",191,269],["αὐτὸν",3,82],["μετὰ",29,1],["σοῦ",5,146]],"Whither is thy kinsman gone, thou beautiful among women? whither has thy kinsman turned aside? [tell us], and we will seek him with thee."],["2",[["Ἀδελφιδός",1983,105],["μου",6,48],["κατέβη",175,3],["εἰς",8,1],["κῆπον",1325,7],["αὐτοῦ",3,48],["εἰς",8,1],["φιάλας",1287,40],["τοῦ",1,23],["ἀρώματος",2052,24],["ποιμαίνειν",953,54],["ἐν",4,1],["κήποις",1325,139],["καὶ",2,8],["συλλέγειν",1148,54],["κρίνα",2021,43]],"My kinsman is gone down to his garden, to the beds of spice, to feed [his flock] in the gardens, and to gather lilies."],["3",[["Ἐγὼ",6,158],["τῷ",1,110],["ἀδελφιδῷ",11518,113],["μου",6,48],["καὶ",2,8],["ἀδελφιδός",1983,105],["μου",6,48],["ἐμοί",6,49],["ὁ",1,4],["ποιμαίνων",953,67],["ἐν",4,1],["τοῖς",1,138],["κρίνοις",263,586]],"I am my kinsman's, and my kinsman is mine, who feeds among the lilies."],["4",[["Καλὴ",266,15],["εἶ",10,145],["ἡ",1,11],["πλησίον",292,17],["μου",6,48],["ὡς",36,8],["εὐδοκία",1625,13],["ὡραῖα",1296,74],["ὡς",36,8],["Ἱερουσαλὴμ",70,20],["θάμβος",3840,20],["ὡς",36,8],["τεταγμέναι",721,424]],"Thou art fair, my companion, as Pleasure, beautiful as Jerusalem, terrible as [armies] set in array."],["5",[["Ἀπόστρεψον",130,198],["ὀφθαλμούς",91,31],["σου",5,146],["ἀπεναντίον",8988,17],["μου",6,48],["ὅτι",19,8],["αὐτοὶ",3,195],["ἀνεπτέρωσάν",5186,141],["με",6,82],["τρίχωμά",4445,20],["σου",5,146],["ὡς",36,8],["ἀγέλαι",2649,180],["τῶν",1,76],["αἰγῶν",686,77],["αἳ",1,185],["ἀνεφάνησαν",3691,94],["ἀπὸ",17,1],["τοῦ",1,30],["Γαλαάδ",14954,0]],"Turn away thine eyes from before me, for they have ravished me: thy hair is as flocks of goats which have appeared from Galaad."],["6",[["Ὀδόντες",930,51],["σου",5,146],["ὡς",36,8],["ἀγέλαι",2649,180],["τῶν",1,76],["κεκαρμένων",1730,412],["αἳ",1,185],["ἀνέβησαν",88,141],["ἀπὸ",17,1],["τοῦ",1,23],["λουτροῦ",4887,24],["αἱ",1,185],["πᾶσαι",11,187],["διδυμεύουσαι",5569,301],["καὶ",2,8],["ἀτεκνοῦσα",1928,183],["οὐκ",12,17],["ἔστιν",10,87],["ἐν",4,1],["αὐταῖς",3,194],["ὡς",36,8],["σπαρτίον",2769,20],["τὸ",1,27],["κόκκινον",1118,28],["χείλη",361,43],["σου",5,146],["καὶ",2,8],["ἡ",1,11],["λαλιά",1824,13],["σου",5,146],["ὡραιᾶ",1296,74]],"Thy teeth are as flocks of shorn [sheep], that have gone up from the washing, all of them bearing twins, and there is none barren among them: thy lips are as a thread of scarlet, and thy speech is comely."],["7",[["Ὡς",36,8],["λέπυρον",5800,20],["ῥοᾶς",2155,19],["μῆλόν",2923,20],["σου",5,146],["ἐκτὸς",1702,17],["τῆς",1,18],["σιωπήσεώς",5036,19],["σου",5,146]],"Thy cheek is like the rind of a pomegranate, [being seen] without thy veil."],["8",[["Ἑξήκοντά",881,57],["εἰσι",10,191],["βασίλισσαι",157,180],["καὶ",2,8],["ὀγδοήκοντα",1433,57],["παλλακαὶ",1120,180],["καὶ",2,8],["νεάνιδες",1520,180],["ὧν",24,97],["οὐκ",12,17],["ἔστιν",10,87],["ἀριθμός",355,5]],"There are sixty queens, and eighty concubines, and maidens without number."],["9",[["Μία",58,15],["ἐστὶ",10,87],["περιστερά",1280,13],["μου",6,48],["τελεία",1919,15],["μου",6,48],["μία",58,15],["ἐστὶ",10,87],["τῇ",1,95],["μητρὶ",189,2],["αὐτῆς",3,83],["ἐκλεκτή",552,15],["ἐστι",10,87],["τῇ",1,95],["τεκούσῃ",251,573],["αὐτήν",3,98],["Εἴδοσαν",53,141],["αὐτὴν",3,98],["θυγατέρες",97,180],["καὶ",2,8],["μακαριοῦσιν",1681,207],["αὐτὴν",3,98],["βασίλισσαι",157,180],["καί",2,8],["γε",353,12],["παλλακαὶ",1120,180],["καὶ",2,8],["αἰνέσουσιν",402,207],["αὐτήν",3,98]],"My dove, my perfect one is one; she is the [only] one of her mother; she is the choice of her that bore her. The daughters saw her, and the queens will pronounce her blessed, yea, and the concubines, and they will praise her."],["10",[["Τίς",39,368],["αὕτη",16,101],["ἡ",1,11],["ἐκκύπτουσα",3729,183],["ὡσεὶ",343,17],["ὄρθρος",1434,5],["καλὴ",266,15],["ὡς",36,8],["σελήνη",1207,13],["ἐκλεκτὴ",552,15],["ὡς",36,8],["ὁ",1,4],["ἥλιος",323,5],["θάμβος",3840,20],["ὡς",36,8],["τεταγμέναι",721,424]],"Who is this that looks forth as the morning, fair as the moon, choice as the sun, terrible as [armies] set in array?"],["11",[["Εἰς",8,1],["κῆπον",1325,7],["καρύας",7318,40],["κατέβην",175,147],["ἰδεῖν",53,100],["ἐν",4,1],["γεννήμασι",742,92],["τοῦ",1,30],["χειμάῤῥου",737,21],["ἰδεῖν",53,100],["εἰ",77,8],["ἤνθησεν",2207,3],["ἡ",1,11],["ἄμπελος",812,13],["ἐξήνθησαν",1800,141],["αἱ",1,185],["ῥοαί",2155,180]],"I went down to the garden of nuts, to look at the fruits of the valley, to see if the vine flowered, [if] the pomegranates blossomed."],["12",[["Ἐκεῖ",76,17],["δώσω",33,157],["τοὺς",1,56],["μαστούς",1275,31],["μου",6,48],["σοί",5,151],["οὐκ",12,17],["ἔγνω",79,3],["ἡ",1,11],["ψυχή",63,13],["μου",6,48],["ἔθετο",110,26],["με",6,82],["ἅρματα",359,63],["Ἀμιναδάβ",1487,105]],"There I will give thee my breasts: my soul knew [it] not: it made me as the chariots of Aminadab."]]