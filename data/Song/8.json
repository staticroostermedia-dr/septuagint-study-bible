oken for?"],["9",[["Εἰ",77,8],["τεῖχός",323,20],["ἐστιν",10,87],["οἰκοδομήσωμεν",125,75],["ἐπʼ",9,1],["αὐτὴν",3,98],["ἐπάλξεις",3461,40],["ἀργυρᾶς",587,109],["καὶ",2,8],["εἰ",77,8],["θύρα",277,13],["ἐστὶ",10,87],["διαγράψωμεν",2891,75],["ἐπʼ",9,1],["αὐτὴν",3,98],["σανίδα",4398,10],["κεδρίνην",1550,37]],"If she is a wall, let us build upon her silver bulwarks; and if she is a door, let us carve for her cedar panels."],["10",[["Ἐγὼ",6,158],["τεῖχος",323,33],["καὶ",2,8],["μαστοί",1273,51],["μου",6,48],["ὡς",36,8],["πύργοι",709,51],["ἐγὼ",6,158],["ἤμην",10,435],["ἐν",4,1],["ὀφθαλμοῖς",91,139],["αὐτῶν",3,41],["ὡς",36,8],["εὑρίσκουσα",106,181],["εἰρήνην",210,10]],"I am a wall, and my breasts are as towers; I was in their eyes as one that found peace."],["11",[["Ἀμπελὼν",603,5],["ἐγενήθη",30,38],["τῷ",1,110],["Σαλωμὼν",172,61],["ἐν",4,1],["Βεεθλαμών",0,0],["ἔδωκε",33,3],["τὸν",1,6],["ἀμπελῶνα",603,7],["αὐτοῦ",3,48],["τοῖς",1,138],["τηροῦσιν",1356,357],["ἀνὴρ",38,5],["οἴσει",201,120],["ἐν",4,1],["καρπῷ",446,113],["αὐτοῦ",3,144],["χιλίους",579,58],["ἀργυρίου",150,24]],"Solomon had a vineyard in Beelamon; he let his vineyard to keepers; every one was to bring for its fruit a thousand [pieces] of silver."],["12",[["Ἀμπελών",603,5],["μου",6,48],["ἐμὸς",523,5],["ἐνώπιόν",114,1],["μου",6,48],["οἱ",1,128],["χίλιοι",579,130],["Σαλωμὼν",172,61],["καὶ",2,8],["οἱ",1,128],["διακόσιοι",598,130],["τοῖς",1,138],["τηροῦσι",1356,357],["τὸν",1,6],["καρπὸν",446,7],["αὐτοῦ",3,48]],"My vineyard, even mine, is before me; Solomon [shall have] a thousand, and they that keep its fruit two hundred."],["13",[["Ὁ",1,4],["καθήμενος",417,414],["ἐν",4,1],["κήποις",1325,139],["ἑταῖροι",1868,51],["προσέχοντες",557,137],["τῇ",1,95],["φωνῇ",95,2],["σου",5,146],["ἀκούτισόν",3163,198],["με",6,82]],"Thou that dwellest in the gardens, the companions hearken to thy voice: make me hear [it]."],["14",[["Φύγε",265,198],["ἀδελφιδέ",0,0],["μου",6,48],["καὶ",2,8],["ὁμοιώθητι",1197,242],["τῇ",1,95],["δορκάδι",2166,2],["ἢ",60,8],["τῷ",1,110],["νεβρῷ",3918,113],["τῶν",1,76],["ἐλάφων",1869,77],["ἐπὶ",9,1],["ὄρη",86,63],["τῶν",1,44],["ἀρωμάτων",2058,45]],"Away, my kinsman, and be like a doe or a fawn on the mountains of spices."]]