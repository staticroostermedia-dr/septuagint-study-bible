[["1",[["Τίς",39,150],["δῴη",33,276],["σε",5,161],["ἀδελφιδέ",0,0],["μου",6,48],["θηλάζοντα",1468,292],["μαστοὺς",1273,31],["μητρός",188,19],["μου",6,83],["εὑροῦσά",106,140],["σε",5,161],["ἔξω",525,17],["φιλήσω",1393,157],["σε",5,161],["καί",2,8],["γε",351,12],["οὐκ",12,17],["ἐξουδενώσουσί",1069,207],["μοι",6,49]],"I would that thou, O my kinsman, wert he that sucked the breasts of my mother; when I found thee without, I would kiss thee; yea, they should not despise me."],["2",[["Παραλήψομαί",1385,176],["σε",5,161],["εἰσάξω",389,157],["σε",5,161],["εἰς",8,1],["οἶκον",34,7],["μητρός",188,19],["μου",6,83],["καὶ",2,8],["εἰς",8,1],["ταμεῖον",1526,20],["τῆς",1,18],["συλλαβούσης",510,508],["με",6,82],["ποτιῶ",788,157],["σε",5,161],["ἀπὸ",17,1],["οἴνου",261,21],["τοῦ",1,30],["μυρεψικοῦ",4327,24],["ἀπὸ",17,1],["νάματος",7839,24],["ῥοῶν",3487,61],["μου",6,48]],"I would take thee, I would bring thee into my mother's house, and into the chamber of her that conceived me; I would make thee to drink of spiced wine, of the juice of my pomegranates."],["3",[["Εὐώνυμος",1888,16],["αὐτοῦ",3,48],["ὑπὸ",122,1],["τὴν",1,9],["κεφαλήν",144,10],["μου",6,48],["καὶ",2,8],["ἡ",1,11],["δεξιὰ",282,15],["αὐτοῦ",3,48],["περιλήψεταί",2484,89],["με",6,82]],"His left hand [should be] under my head, and his right hand should embrace me."],["4",[["Ὥρκισα",1578,147],["ὑμᾶς",5,209],["θυγατέρες",97,179],["Ἱερουσαλὴμ",69,20],["ἐν",4,1],["ταῖς",1,70],["ἰσχύσεσι",4660,71],["τοῦ",1,30],["ἀγροῦ",252,21],["ἐὰν",45,8],["ἐγείρητε",745,118],["καὶ",2,8],["ἐὰν",45,8],["ἐξεγείρητε",650,118],["τὴν",1,9],["ἀγάπην",1986,10],["ἕως",42,8],["ἂν",82,12],["θελήσῃ",609,160]],"I have charged you, ye daughters of Jerusalem, by the virtues of the field, that ye stir not up, nor awake [my] love, until he please."],["5",[["Τίς",39,373],["αὕτη",16,101],["ἡ",1,11],["ἀναβαίνουσα",87,181],["λελευκανθισμένη",0,0],["ἐπιστηριζομένη",2850,204],["ἐπὶ",9,1],["τὸν",1,6],["ἀδελφιδὸν",0,0],["αὐτῆς",3,83],["Ὑπὸ",122,1],["μῆλον",2937,20],["ἐξήγ