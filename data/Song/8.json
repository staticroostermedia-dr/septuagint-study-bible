[["1",[["Τίς",39,150],["δῴη",33,216],["σε",5,161],["ἀδελφιδέ",0,0],["μου",6,48],["θηλάζοντα",1468,289],["μαστοὺς",1275,31],["μητρός",189,19],["μου",6,83],["εὑροῦσά",101,140],["σε",5,161],["ἔξω",527,17],["φιλήσω",1391,157],["σε",5,161],["καί",2,8],["γε",353,12],["οὐκ",12,17],["ἐξουδενώσουσί",1068,207],["μοι",6,49]],"I would that thou, O my kinsman, wert he that sucked the breasts of my mother; when I found thee without, I would kiss thee; yea, they should not despise me."],["2",[["Παραλήψομαί",1385,177],["σε",5,161],["εἰσάξω",389,157],["σε",5,161],["εἰς",8,1],["οἶκον",34,7],["μητρός",189,19],["μου",6,83],["καὶ",2,8],["εἰς",8,1],["ταμεῖον",1528,20],["τῆς",1,18],["συλλαβούσης",507,501],["με",6,82],["ποτιῶ",790,157],["σε",5,161],["ἀπὸ",17,1],["οἴνου",261,21],["τοῦ",1,30],["μυρεψικοῦ",4313,24],["ἀπὸ",17,1],["νάματος",7783,24],["ῥοῶν",3484,61],["μου",6,48]],"I would take thee, I would bring thee into my mother's house, and into the chamber of her that conceived me; I would make thee to drink of spiced wine, of the juice of my pomegranates."],["3",[["Εὐώνυμος",1885,16],["αὐτοῦ",3,48],["ὑπὸ",122,1],["τὴν",1,9],["κεφαλήν",144,10],["μου",6,48],["καὶ",2,8],["ἡ",1,11],["δεξιὰ",282,15],["αὐτοῦ",3,48],["περιλήψεταί",2477,89],["με",6,82]],"His left hand [should be] under my head, and his right hand should embrace me."],["4",[["Ὥρκισα",1577,147],["ὑμᾶς",5,209],["θυγατέρες",97,180],["Ἱερουσαλὴμ",70,20],["ἐν",4,1],["ταῖς",1,70],["ἰσχύσεσι",4636,71],["τοῦ",1,30],["ἀγροῦ",252,21],["ἐὰν",45,8],["ἐγείρητε",746,118],["καὶ",2,8],["ἐὰν",45,8],["ἐξεγείρητε",656,118],["τὴν",1,9],["ἀγάπην",1982,10],["ἕως",42,8],["ἂν",83,12],["θελήσῃ",612,160]],"I have charged you, ye daughters of Jerusalem, by the virtues of the field, that ye stir not up, nor awake [my] love, until he please."],["5",[["Τίς",39,368],["αὕτη",16,101],["ἡ",1,11],["ἀναβαίνουσα",88,183],["λελευκανθισμένη",5786,197],["ἐπιστηριζομένη",2676,204],["ἐπὶ",9,1],["τὸν",1,6],["ἀδελφιδὸν",0,0],["αὐτῆς",3,83],["Ὑπὸ",122,1],["μῆλον",2923,20],["ἐξήγειρά",656,147],["σε",5,161],["ἐκεῖ",76,17],["ὠδίνησέ",0,0],["σε",5,161],["ἡ",1,11],["μήτηρ",189,13],["σου",5,146],["ἐκεῖ",76,17],["ὠδίνησέ",0,0],["σε",5,161],["ἡ",1,11],["τεκοῦσά",251,140],["σε",5,161]],"Who is this that comes up all white, leaning on her kinsman? I raised thee up under an apple-tree; there thy mother brought thee forth; there she that bore thee brought thee forth."],["6",[["Θές",110,198],["με",6,82],["ὡς",36,8],["σφραγίδα",0,0],["ἐπὶ",9,1],["τὴν",1,9],["καρδίαν",64,10],["σου",5,146],["ὡς",36,8],["σφραγίδα",0,0],["ἐπὶ",9,1],["τὸν",1,6],["βραχίονά",618,59],["σου",5,146],["ὅτι",19,8],["κραταιὰ",862,15],["ὡς",36,8],["θάνατος",170,5],["ἀγάπη",1982,13],["σκληρὸς",831,16],["ὡς",36,8],["ᾅδης",586,5],["ζῆλος",1164,5],["περίπτερα",4984,74],["αὐτῆς",3,83],["περίπτερα",4984,74],["πυρὸς",118,24],["φλόγες",983,180],["αὐτῆς",3,83]],"Set me as a seal upon thy heart, as a seal upon thine arm; for love is strong as death; jealousy is cruel as the grave, her shafts are shafts of fire, [even] the flames thereof."],["7",[["Ὕδωρ",85,33],["πολὺ",74,29],["οὐ",12,17],["δυνήσεται",185,89],["σβέσαι",1077,100],["τὴν",1,9],["ἀγάπην",1982,10],["καὶ",2,8],["ποταμοὶ",249,51],["οὐ",12,17],["συνκλύσουσιν",5057,207],["αὐτήν",3,98],["ἐὰν",45,8],["δῷ",33,160],["ἀνὴρ",38,5],["πάντα",11,59],["τὸν",1,6],["βίον",726,7],["αὐτοῦ",3,48],["ἐν",4,1],["τῇ",1,95],["ἀγάπῃ",1982,2],["ἐξουδενώσει",1068,120],["ἐξουδενώσουσιν",1068,207],["αὐτόν",3,82]],"Much water will not be able to quench love, and rivers shall not drown it; if a man would give all his substance for love, [men] would utterly despise it."],["8",[["Ἀδελφή",521,13],["ἡμῶν",6,41],["μικρὰ",367,15],["καὶ",2,8],["μαστοὺς",1275,31],["οὐκ",12,17],["ἔχει",124,87],["τί",39,119],["ποιήσωμεν",23,75],["τῇ",1,95],["ἀδελφῇ",521,2],["ἡμῶν",6,41],["ἐν",4,1],["ἡμέρᾳ",28,2],["ᾗ",24,102],["ἐὰν",45,8],["λαληθῇ",50,333],["ἐν",4,1],["αὐτῇ",3,99]],"Our sister is little, and has no breasts; what shall we do for our sister, in the day wherein she shall be spoken for?"],["9",[["Εἰ",77,8],["τεῖχός",325,20],["ἐστιν",10,87],["οἰκοδομήσωμεν",126,75],["ἐπʼ",9,1],["αὐτὴν",3,98],["ἐπάλξεις",3458,40],["ἀργυρᾶς",590,109],["καὶ",2,8],["εἰ",77,8],["θύρα",277,13],["ἐστὶ",10,87],["διαγράψωμεν",2876,75],["ἐπʼ",9,1],["αὐτὴν",3,98],["σανίδα",4384,10],["κεδρίνην",1553,37]],"If she is a wall, let us build upon her silver bulwarks; and if she is a door, let us carve for her cedar panels."],["10",[["Ἐγὼ",6,158],["τεῖχος",325,33],["καὶ",2,8],["μαστοί",1275,51],["μου",6,48],["ὡς",36,8],["πύργοι",708,51],["ἐγὼ",6,158],["ἤμην",10,429],["ἐν",4,1],["ὀφθαλμοῖς",91,139],["αὐτῶν",3,41],["ὡς",36,8],["εὑρίσκουσα",101,183],["εἰρήνην",213,10]],"I am a wall, and my breasts are as towers; I was in their eyes as one that found peace."],["11",[["Ἀμπελὼν",607,5],["ἐγενήθη",30,38],["τῷ",1,110],["Σαλωμὼν",173,61],["ἐν",4,1],["Βεεθλαμών",0,0],["ἔδωκε",33,3],["τὸν",1,6],["ἀμπελῶνα",607,7],["αὐτοῦ",3,48],["τοῖς",1,138],["τηροῦσιν",1358,352],["ἀνὴρ",38,5],["οἴσει",199,120],["ἐν",4,1],["καρπῷ",448,113],["αὐτοῦ",3,144],["χιλίους",582,58],["ἀργυρίου",152,24]],"Solomon had a vineyard in Beelamon; he let his vineyard to keepers; every one was to bring for its fruit a thousand [pieces] of silver."],["12",[["Ἀμπελών",607,5],["μου",6,48],["ἐμὸς",525,5],["ἐνώπιόν",115,1],["μου",6,48],["οἱ",1,128],["χίλιοι",582,130],["Σαλωμὼν",173,61],["καὶ",2,8],["οἱ",1,128],["διακόσιοι",600,130],["τοῖς",1,138],["τηροῦσι",1358,352],["τὸν",1,6],["καρπὸν",448,7],["αὐτοῦ",3,48]],"My vineyard, even mine, is before me; Solomon [shall have] a thousand, and they that keep its fruit two hundred."],["13",[["Ὁ",1,4],["καθήμενος",419,407],["ἐν",4,1],["κήποις",1325,139],["ἑταῖροι",1867,51],["προσέχοντες",558,137],["τῇ",1,95],["φωνῇ",95,2],["σου",5,146],["ἀκούτισόν",3157,198],["με",6,82]],"Thou that dwellest in the gardens, the companions hearken to thy voice: make me hear [it]."],["14",[["Φύγε",264,198],["ἀδελφιδέ",0,0],["μου",6,48],["καὶ",2,8],["ὁμοιώθητι",1175,242],["τῇ",1,95],["δορκάδι",2157,2],["ἢ",61,8],["τῷ",1,110],["νεβρῷ",3907,113],["τῶν",1,76],["ἐλάφων",1868,77],["ἐπὶ",9,1],["ὄρη",87,63],["τῶν",1,44],["ἀρωμάτων",2052,45]],"Away, my kinsman, and be like a doe or a fawn on the mountains of spices."]]