[["1",[["ἌΣΜΑ",2239,20],["ᾀσμάτων",2239,45],["ὅ",1,4],["ἐστι",10,87],["Σαλωμών",173,61]],"The Song of songs, which is Solomon's."],["2",[["Φιλησάτω",1391,46],["με",6,82],["ἀπὸ",17,1],["φιλημάτων",6192,45],["στόματος",123,24],["αὐτοῦ",3,144],["ὅτι",19,8],["ἀγαθοὶ",114,130],["μαστοί",1275,51],["σου",5,146],["ὑπὲρ",139,1],["οἶνον",261,7],["καὶ",2,8],["ὀσμὴ",684,13],["μύρων",2272,45],["σου",5,146],["ὑπὲρ",139,1],["πάντα",11,65],["τὰ",1,42],["ἀρώματα",2052,43]],"Let him kiss me with the kisses of his mouth: for thy breasts are better than wine."],["3",[["μῦρον",4918,36],["ἐκκενωθὲν",2138,426],["ὄνομά",57,20],["σου",5,146],["διὰ",56,1],["τοῦτο",16,122],["νεάνιδες",1520,180],["ἠγάπησάν",214,129],["σε",5,161]],"And the smell of thine ointments is better than all spices: thy name is ointment poured forth; therefore do the young maidens love thee."],["4",[["εἵλκυσάν",1217,141],["σε",5,161],["ὀπίσω",167,17],["σου",5,146],["εἰς",8,1],["ὀσμὴν",684,10],["μύρων",2272,45],["σου",5,146],["δραμοῦμεν",0,0],["εἰσήνεγκέ",587,3],["με",6,82],["ὁ",1,4],["βασιλεὺς",22,5],["εἰς",8,1],["τὸ",1,32],["ταμεῖον",1528,33],["αὐτοῦ",3,48],["ἀγαλλιασώμεθα",738,270],["καὶ",2,8],["εὐφρανθῶμεν",244,282],["ἐν",4,1],["σοί",5,151],["ἀγαπήσομεν",214,269],["μαστούς",1275,31],["σου",5,146],["ὑπὲρ",139,1],["οἶνον",261,7],["εὐθύτης",1674,13],["ἠγάπησέ",214,3],["σε",5,161]],"They have drawn thee: we will run after thee, for the smell of thine ointments: the king has brought me into his closet: let us rejoice and be glad in thee; we will love thy breasts more than wine: righteousness loves thee."],["5",[["Μέλαινά",3904,15],["εἰμι",10,149],["ἐγὼ",6,179],["καὶ",2,8],["καλὴ",266,15],["θυγατέρες",97,180],["Ἱερουσαλὴμ",70,20],["ὡς",36,8],["σκηνώματα",682,63],["Κηδὰρ",0,0],["ὡς",36,8],["δέῤῥεις",1623,180],["Σαλωμών",173,61]],"I am black, but beautiful, ye daughters of Jerusalem, as the tents of Kedar, as the curtains of Solomon."],["6",[["Μὴ",25,8],["βλέψητέ",470,118],["με",6,82],["ὅτι",19,8],["ἐγώ",6,179],["εἰμι",10,149],["μεμελανωμένη",5818,197],["ὅτι",19,8],["παρέβλεψέ",4343,3],["με",6,82],["ὁ",1,4],["ἥλιος",323,5],["υἱοὶ",13,51],["μητρός",189,19],["μου",6,83],["ἐμαχέσαντο",1683,184],["ἐν",4,1],["ἐμοὶ",6,49],["ἔθεντό",110,184],["με",6,98],["φυλάκισσαν",8639,10],["ἐν",4,1],["ἀμπελῶσιν",607,139],["ἀμπελῶνα",607,7],["ἐμὸν",525,7],["οὐκ",12,17],["ἐφύλαξα",125,147]],"Look not upon me, because I am dark, because the sun has looked unfavourably upon me: my mother's sons strove with me; they made me keeper in the vineyards; I have not kept my own vineyard."],["7",[["Ἀπάγγειλόν",273,198],["μοι",6,49],["ὃν",24,106],["ἠγάπησεν",214,3],["ἡ",1,11],["ψυχή",63,13],["μου",6,48],["ποῦ",478,17],["ποιμαίνεις",953,145],["ποῦ",478,17],["κοιτάζεις",3071,145],["ἐν",4,1],["μεσημβρίᾳ",1633,180],["μήποτε",964,17],["γένωμαι",30,255],["ὡς",36,8],["περιβαλλομένη",744,204],["ἐπʼ",9,1],["ἀγέλαις",2649,71],["ἑταίρων",1867,77],["σου",5,146]],"Tell me, [thou] whom my soul loves, where thou tendest thy flock, where thou causest [them] to rest at noon, lest I become as one that is veiled by the flocks of thy companions."],["8",[["Ἐὰν",45,8],["μὴ",25,8],["γνῷς",79,170],["σεαυτὴν",255,98],["ἡ",1,11],["καλὴ",266,15],["ἐν",4,1],["γυναιξὶν",59,71],["ἔξελθε",82,198],["σὺ",5,156],["ἐν",4,1],["πτέρναις",2625,71],["τῶν",1,44],["ποιμνίων",707,45],["καὶ",2,8],["ποίμαινε",953,239],["τὰς",1,39],["ἐρίφους",1576,31],["σου",5,146],["ἐπὶ",9,1],["σκηνώμασι",682,92],["τῶν",1,76],["ποιμένων",664,77]],"If thou know not thyself, thou fair one among women, go thou forth by the footsteps of the flocks, and feed thy kids by the shepherds' tents."],["9",[["Τῇ",1,95],["ἵππῳ",309,113],["μου",6,48],["ἐν",4,1],["ἅρμασε",0,0],["Φαραὼ",184,149],["ὡμοίωσά",1175,147],["σε",5,161],["ἡ",1,11],["πλησίον",292,17],["μου",6,48]],"I have likened thee, my companion, to my horses in the chariots of Pharao."],["10",[["Τί",39,119],["ὡραιώθησαν",4145,430],["σιαγόνες",1784,180],["σου",5,146],["ὡς",36,8],["τρυγόνος",2197,19],["τράχηλός",692,5],["σου",5,146],["ὡς",36,8],["ὁρμίσκοι",4130,51]],"How are thy cheeks beautiful as [those] of a dove, thy neck as chains!"],["11",[["Ὁμοιώματα",1176,63],["χρυσίου",202,24],["ποιήσομέν",23,269],["σοι",5,151],["μετὰ",29,1],["στιγμάτων",8324,45],["τοῦ",1,23],["ἀργυρίου",152,24]],"We will make thee figures of gold with studs of silver."],["12",[["Ἕως",42,8],["οὗ",120,17],["ὁ",1,4],["βασιλεὺς",22,5],["ἐν",4,1],["ἀνακλίσει",0,0],["αὐτοῦ",3,48],["νάρδος",4928,13],["μου",6,48],["ἔδωκεν",33,3],["ὀσμὴν",684,10],["αὐτοῦ",3,48]],"So long as the king was at table, my spikenard gave forth its smell."],["13",[["Ἀπόδεσμος",9079,5],["τῆς",1,18],["στακτῆς",2771,19],["ἀδελφιδός",1983,105],["μου",6,83],["ἐμοὶ",6,49],["ἀυαμέσου",0,0],["τῶν",1,76],["μαστῶν",1275,77],["μου",6,48],["αὐλισθήσεται",990,125]],"My kinsman is to me a bundle of myrrh; he shall lie between my breasts."],["14",[["Βότρυς",2338,5],["τῆς",1,18],["κύπρου",4155,19],["ἀδελφιδός",1983,105],["μου",6,83],["ἐμοὶ",6,49],["ἐν",4,1],["ἀμπελῶσιν",607,139],["Ἐνγαδδί",0,0]],"My kinsman is to me a cluster of camphor in the vineyards of Engaddi."],["15",[["Ἰδοὺ",51,17],["εἶ",10,145],["καλὴ",266,15],["ἡ",1,11],["πλησίον",292,17],["μου",6,48],["ἰδοὺ",51,17],["εἶ",10,145],["καλὴ",266,15],["ὀφθαλμοί",91,51],["σου",5,146],["περιστεραί",1280,180]],"Behold, thou art fair, my companion; behold, thou art fair; thine eyes are doves."],["16",[["Ἰδοὺ",51,17],["εἶ",10,145],["καλὸς",266,16],["ἀδελφιδός",1983,105],["μου",6,48],["καί",2,8],["γε",353,12],["ὡραῖος",1296,16],["πρὸς",15,1],["κλίνῃ",785,166],["ἡμῶν",6,41],["σύσκιος",5099,16]],"Behold, thou art fair, my kinsman, yea, beautiful, overshadowing our bed."],["17",[["Δοκοὶ",3525,180],["οἴκων",34,77],["ἡμῶν",6,41],["κέδροι",873,180],["φατνώματα",3993,63],["ἡμῶν",6,41],["κυπάρισσοι",2460,180]],"The beams of our house are cedars, our ceilings are of cypress."]]