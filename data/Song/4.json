[["1",[["Ἰδοὺ",51,17],["εἶ",10,145],["καλὴ",264,15],["ἡ",1,11],["πλησίον",292,17],["μου",6,48],["ἰδοὺ",51,17],["εἶ",10,145],["καλή",264,15],["ὀφθαλμοί",91,51],["σου",5,146],["περιστεραὶ",1278,179],["ἐκτὸς",1706,17],["τῆς",1,18],["σιωπήσεώς",5065,19],["σου",5,146],["τρίχωμά",4466,20],["σου",5,146],["ὡς",36,8],["ἀγέλαι",2652,179],["τῶν",1,76],["αἰγῶν",684,77],["αἳ",1,183],["ἀπεκαλύφθησαν",662,94],["ἀπὸ",17,1],["τοῦ",1,30],["Γαλαάδ",0,0]],"Behold, thou art fair, my companion; behold, thou art fair; thine eyes are doves, beside thy veil: thy hair is as flocks of goats, that have appeared from Galaad."],["2",[["Ὀδόντες",929,51],["σου",5,146],["ὡς",36,8],["ἀγέλαι",2652,179],["τῶν",1,76],["κεκαρμένων",1730,457],["αἳ",1,183],["ἀνέβησαν",87,141],["ἀπὸ",17,1],["τοῦ",1,23],["λουτροῦ",4911,24],["αἱ",1,183],["πᾶσαι",11,185],["διδυμεύουσαι",5598,305],["καὶ",2,8],["ἀτεκνοῦσα",2226,181],["οὐκ",12,17],["ἔστιν",10,87],["ἐν",4,1],["αὐταῖς",3,192]],"Thy teeth are as flocks of shorn [sheep], that have gone up from the washing; all of them bearing twins, and there is not a barren one among them."],["3",[["Ὡς",36,8],["σπάρτίον",2779,20],["τὸ",1,27],["κόκκικον",0,0],["χείλη",361,43],["σου",5,146],["καὶ",2,8],["ἡ",1,11],["λαλιά",1826,13],["σου",5,146],["ὡραῖα",1296,74],["ὡς",36,8],["λέπυρον",5833,20],["ῥοᾶς",2164,19],["μῆλόν",2937,20],["σου",5,146],["ἐκτὸς",1706,17],["τῆς",1,18],["σιωπήσεώς",5065,19],["σου",5,146]],"Thy lips are as a thread of scarlet, and thy speech is comely: like the rind of a pomegranate is thy cheek without thy veil."],["4",[["Ὡς",36,8],["πύργος",709,5],["Δαυὶδ",52,105],["τράχηλός",690,5],["σου",5,146],["ὁ",1,4],["ᾠκοδομημένος",125,228],["εἰς",8,1],["θαλπιώθ",7284,105],["χίλιοι",579,130],["θυρεοὶ",1724,51],["κρέμανται",1380,303],["ἐπʼ",9,1],["αὐτὸν",3,82],["πᾶσαι",11,185],["βολίδες",2265,179],["τῶν",1,76],["δυνατῶν",354,163]],"Thy neck is as the tower of David, that was built for an armoury: a thousand shields hang upon it, [and] all darts of mighty men."],["5",[["Δύο",103,57],["μαστοί",1273,51],["σου",5,146],["ὡς",36,8],["δύο",103,57],["νεβροὶ",3918,51],["δίδυμοι",3489,51],["δορκάδος",2166,19],["οἱ",1,128],["νεμόμενοι",1903,356],["ἐν",4,1],["κρίνοις",240,481]],"Thy two breasts are as two twin fawns, that feed among the lilies."],["6",[["ἕως",42,8],["οὗ",120,17],["διαπνεύσῃ",4772,116],["ἡμέρα",28,13],["καὶ",2,8],["κινηθῶσιν",993,267],["αἱ",1,183],["σκιαί",978,179],["πορεύσομαι",49,176],["ἐμαυτῷ",891,49],["πρὸς",15,1],["τὸ",1,32],["ὄρος",86,33],["τῆς",1,18],["σμύρνης",2778,19],["καὶ",2,8],["πρὸς",15,1],["τὸν",1,6],["βουνὸν",575,7],["τοῦ",1,30],["λιβάνου",534,21]],"Until the day dawn, and the shadows depart, I will betake me to the mountain of myrrh, and to the hill of frankincense."],["7",[["Ὅλη",233,15],["καλὴ",264,15],["εἶ",10,145],["πλησίον",292,17],["μου",6,48],["καὶ",2,8],["μῶμος",1686,5],["οὐκ",12,17],["ἔστιν",10,87],["ἐν",4,1],["σοί",5,151]],"Thou art all fair, my companion, and there is no spot in thee."],["8",[["Δεῦρο",715,17],["ἀπὸ",17,1],["Λιβάνου",534,21],["νύμφη",1060,13],["δεῦρο",715,17],["ἀπὸ",17,1],["Λιβάνου",534,21],["ἐλεύσῃ",56,116],["καὶ",2,8],["διελεύσῃ",427,116],["ἀπὸ",17,1],["ἀρχῆς",269,19],["Πίστεως",888,19],["ἀπὸ",17,1],["κεφαλῆς",144,19],["Σανὶρ",0,0],["καὶ",2,8],["Ἑρμὼν",3024,171],["ἀπὸ",17,1],["μανδρῶν",2376,61],["λεόντων",421,77],["ἀπὸ",17,1],["ὀρέων",86,45],["παρδάλεων",3135,61]],"Come from Libanus, [my] bride, come from Libanus: thou shalt come and pass from the top of Faith, from the top of Sanir and Hermon, from the lions' dens, from the mountains of the leopards."],["9",[["Ἐκαρδίωσας",5707,154],["ἡμᾶς",6,60],["ἀδελφή",519,13],["μου",6,48],["νύμφη",1060,13],["ἐκαρδίωσας",5707,154],["ἡμᾶς",6,60],["ἑνὶ",57,111],["ἀπὸ",17,1],["ὀφθαλμῶν",91,77],["σου",5,146],["ἐν",4,1],["μιᾷ",57,96],["ἐνθέματι",9743,53],["τραχήλων",690,77],["σου",5,146]],"My sister, [my] spouse, thou hast ravished my heart; thou hast ravished my heart with one of thine eyes, with one chain of thy neck."],["10",[["Τί",39,119],["ἐκαλλιώθησαν",5704,94],["μαστοί",1273,51],["σου",5,146],["ἀδελφή",519,13],["μου",6,48],["νύμφη",1060,13],["τί",39,119],["ἐκαλλιώθησαν",5704,94],["μαστοί",1273,51],["σου",5,146],["ἀπὸ",17,1],["οἴνου",261,21],["καὶ",2,8],["ὀσμὴ",682,13],["ἱματίων",275,45],["σου",5,146],["ὑπὲρ",139,1],["πάντα",11,65],["ἀρώματα",2058,43]],"How beautiful are thy breasts, my sister, my spouse! how much more beautiful are thy breasts than wine, and the smell of thy garments than all spices!"],["11",[["Κηρίον",2917,20],["ἀποστάζουσι",2055,189],["χείλη",361,43],["σου",5,146],["νύμφη",1060,13],["μέλι",804,20],["καὶ",2,8],["γάλα",1031,20],["ὑπὸ",122,1],["τὴν",1,9],["γλῶσσάν",385,10],["σου",5,146],["καὶ",2,8],["ὀσμὴ",682,13],["ἱματίων",275,45],["σου",5,146],["ὡς",36,8],["ὀσμὴ",682,13],["Λιβάνου",534,21]],"Thy lips drop honeycomb, my spouse: honey and milk are under thy tongue; and the smell of thy garments is as the smell of Libanus."],["12",[["Κῆπος",1325,5],["κεκλεισμένος",1472,228],["ἀδελφή",519,13],["μου",6,48],["νύμφη",1060,13],["κῆπος",1325,5],["κεκλεισμένος",1472,228],["πηγὴ",563,13],["ἐσφραγισμένη",0,0]],"My sister, [my] spouse is a garden enclosed; a garden enclosed, a fountain sealed."],["13",[["Ἀποστολαί",2663,179],["σου",5,146],["παράδεισος",1120,5],["ῥοῶν",3487,61],["μετὰ",29,1],["καρποῦ",446,21],["ἀκροδρύων",4510,45],["κύπροι",4167,179],["μετὰ",29,1],["νάρδων",4952,61]],"Thy shoots are a garden of pomegranates, with the fruit of choice berries; camphor, with spikenard:"],["14",[["Νάρδος",4952,13],["καὶ",2,8],["κρόκος",7564,5],["κάλαμος",1473,5],["καὶ",2,8],["κιννάμωμον",5766,33],["μετὰ",29,1],["πάντων",11,79],["ξύλων",196,45],["τοῦ",1,30],["Λιβάνου",534,21],["σμύρνα",2778,13],["ἀλὼθ",6281,105],["μετὰ",29,1],["πάντων",11,79],["πρώτων",495,79],["μύρων",2191,45]],"spikenard and saffron, calamus and cinnamon; with all woods of Libanus, myrrh, aloes, with all chief spices:"],["15",[["πηγὴ",563,13],["κήπου",1325,21],["καὶ",2,8],["φρέαρ",878,33],["ὕδατος",85,24],["ζῶντος",117,294],["καὶ",2,8],["ῥοιζοῦντος",6717,294],["ἀπὸ",17,1],["τοῦ",1,30],["Λιβάνου",534,21]],"a fountain of a garden, and a well of water springing and gurgling from Libanus."],["16",[["Ἐξεγέρθητι",650,242],["βοῤῥᾶ",384,5],["καὶ",2,8],["ἔρχου",56,250],["Νότε",586,251],["καὶ",2,8],["διάπνευσον",4772,198],["κῆπόν",1325,7],["μου",6,48],["καὶ",2,8],["ῥευσάτωσαν",663,261],["ἀρώματά",2058,63],["μου",6,48]],"Awake, O north wind; and come, O south; and blow through my garden, and let my spices flow out."]]