[["1",[["Ἰδοὺ",51,17],["εἶ",10,145],["καλὴ",266,15],["ἡ",1,11],["πλησίον",292,17],["μου",6,48],["ἰδοὺ",51,17],["εἶ",10,145],["καλή",266,15],["ὀφθαλμοί",91,51],["σου",5,146],["περιστεραὶ",1280,180],["ἐκτὸς",1702,17],["τῆς",1,18],["σιωπήσεώς",5036,19],["σου",5,146],["τρίχωμά",4445,20],["σου",5,146],["ὡς",36,8],["ἀγέλαι",2649,180],["τῶν",1,76],["αἰγῶν",686,77],["αἳ",1,185],["ἀπεκαλύφθησαν",652,94],["ἀπὸ",17,1],["τοῦ",1,30],["Γαλαάδ",0,0]],"Behold, thou art fair, my companion; behold, thou art fair; thine eyes are doves, beside thy veil: thy hair is as flocks of goats, that have appeared from Galaad."],["2",[["Ὀδόντες",930,51],["σου",5,146],["ὡς",36,8],["ἀγέλαι",2649,180],["τῶν",1,76],["κεκαρμένων",1730,412],["αἳ",1,185],["ἀνέβησαν",88,141],["ἀπὸ",17,1],["τοῦ",1,23],["λουτροῦ",4887,24],["αἱ",1,185],["πᾶσαι",11,187],["διδυμεύουσαι",5569,301],["καὶ",2,8],["ἀτεκνοῦσα",1928,183],["οὐκ",12,17],["ἔστιν",10,87],["ἐν",4,1],["αὐταῖς",3,194]],"Thy teeth are as flocks of shorn [sheep], that have gone up from the washing; all of them bearing twins, and there is not a barren one among them."],["3",[["Ὡς",36,8],["σπάρτίον",2769,20],["τὸ",1,27],["κόκκικον",0,0],["χείλη",361,43],["σου",5,146],["καὶ",2,8],["ἡ",1,11],["λαλιά",1824,13],["σου",5,146],["ὡραῖα",1296,74],["ὡς",36,8],["λέπυρον",5800,20],["ῥοᾶς",2155,19],["μῆλόν",2923,20],["σου",5,146],["ἐκτὸς",1702,17],["τῆς",1,18],["σιωπήσεώς",5036,19],["σου",5,146]],"Thy lips are as a thread of scarlet, and thy speech is comely: like the rind of a pomegranate is thy cheek without thy veil."],["4",[["Ὡς",36,8],["πύργος",708,5],["Δαυὶδ",52,105],["τράχηλός",692,5],["σου",5,146],["ὁ",1,4],["ᾠκοδομημένος",126,408],["εἰς",8,1],["θαλπιώθ",7232,105],["χίλιοι",582,130],["θυρεοὶ",1723,51],["κρέμανται",1324,299],["ἐπʼ",9,1],["αὐτὸν",3,82],["πᾶσαι",11,187],["βολίδες",2250,180],["τῶν",1,76],["δυνατῶν",356,163]],"Thy neck is as the tower of David, that was built for an armoury: a thousand shields hang upon it, [and] all darts of mighty men."],["5",[["Δύο",104,57],["μαστοί",1275,51],["σου",5,146],["ὡς",36,8],["δύο",104,57],["νεβροὶ",3907,51],["δίδυμοι",3486,51],["δορκάδος",2157,19],["οἱ",1,128],["νεμόμενοι",1903,351],["ἐν",4,1],["κρίνοις",263,586]],"Thy two breasts are as two twin fawns, that feed among the lilies."],["6",[["ἕως",42,8],["οὗ",120,17],["διαπνεύσῃ",4747,116],["ἡμέρα",28,13],["καὶ",2,8],["κινηθῶσιν",992,266],["αἱ",1,185],["σκιαί",978,180],["πορεύσομαι",49,177],["ἐμαυτῷ",890,49],["πρὸς",15,1],["τὸ",1,32],["ὄρος",87,33],["τῆς",1,18],["σμύρνης",2768,19],["καὶ",2,8],["πρὸς",15,1],["τὸν",1,6],["βουνὸν",577,7],["τοῦ",1,30],["λιβάνου",537,21]],"Until the day dawn, and the shadows depart, I will betake me to the mountain of myrrh, and to the hill of frankincense."],["7",[["Ὅλη",235,15],["καλὴ",266,15],["εἶ",10,145],["πλησίον",292,17],["μου",6,48],["καὶ",2,8],["μῶμος",1684,5],["οὐκ",12,17],["ἔστιν",10,87],["ἐν",4,1],["σοί",5,151]],"Thou art all fair, my companion, and there is no spot in thee."],["8",[["Δεῦρο",715,17],["ἀπὸ",17,1],["Λιβάνου",537,21],["νύμφη",1060,13],["δεῦρο",715,17],["ἀπὸ",17,1],["Λιβάνου",537,21],["ἐλεύσῃ",55,116],["καὶ",2,8],["διελεύσῃ",423,116],["ἀπὸ",17,1],["ἀρχῆς",270,19],["Πίστεως",887,19],["ἀπὸ",17,1],["κεφαλῆς",144,19],["Σανὶρ",12318,0],["καὶ",2,8],["Ἑρμὼν",0,0],["ἀπὸ",17,1],["μανδρῶν",2368,61],["λεόντων",424,77],["ἀπὸ",17,1],["ὀρέων",87,45],["παρδάλεων",3127,61]],"Come from Libanus, [my] bride, come from Libanus: thou shalt come and pass from the top of Faith, from the top of Sanir and Hermon, from the lions' dens, from the mountains of the leopards."],["9",[["Ἐκαρδίωσας",5674,154],["ἡμᾶς",6,60],["ἀδελφή",521,13],["μου",6,48],["νύμφη",1060,13],["ἐκαρδίωσας",5674,154],["ἡμᾶς",6,60],["ἑνὶ",58,111],["ἀπὸ",17,1],["ὀφθαλμῶν",91,77],["σου",5,146],["ἐν",4,1],["μιᾷ",58,96],["ἐνθέματι",9669,53],["τραχήλων",692,77],["σου",5,146]],"My sister, [my] spouse, thou hast ravished my heart; thou hast ravished my heart with one of thine eyes, with one chain of thy neck."],["10",[["Τί",39,119],["ἐκαλλιώθησαν",5672,94],["μαστοί",1275,51],["σου",5,146],["ἀδελφή",521,13],["μου",6,48],["νύμφη",1060,13],["τί",39,119],["ἐκαλλιώθησαν",5672,94],["μαστοί",1275,51],["σου",5,146],["ἀπὸ",17,1],["οἴνου",261,21],["καὶ",2,8],["ὀσμὴ",684,13],["ἱματίων",276,45],["σου",5,146],["ὑπὲρ",139,1],["πάντα",11,65],["ἀρώματα",2052,43]],"How beautiful are thy breasts, my sister, my spouse! how much more beautiful are thy breasts than wine, and the smell of thy garments than all spices!"],["11",[["Κηρίον",2903,20],["ἀποστάζουσι",4039,191],["χείλη",361,43],["σου",5,146],["νύμφη",1060,13],["μέλι",807,20],["καὶ",2,8],["γάλα",1034,20],["ὑπὸ",122,1],["τὴν",1,9],["γλῶσσάν",388,10],["σου",5,146],["καὶ",2,8],["ὀσμὴ",684,13],["ἱματίων",276,45],["σου",5,146],["ὡς",36,8],["ὀσμὴ",684,13],["Λιβάνου",537,21]],"Thy lips drop honeycomb, my spouse: honey and milk are under thy tongue; and the smell of thy garments is as the smell of Libanus."],["12",[["Κῆπος",1325,5],["κεκλεισμένος",1514,408],["ἀδελφή",521,13],["μου",6,48],["νύμφη",1060,13],["κῆπος",1325,5],["κεκλεισμένος",1514,408],["πηγὴ",565,13],["ἐσφραγισμένη",1480,197]],"My sister, [my] spouse is a garden enclosed; a garden enclosed, a fountain sealed."],["13",[["Ἀποστολαί",2661,180],["σου",5,146],["παράδεισος",1121,5],["ῥοῶν",3484,61],["μετὰ",29,1],["καρποῦ",448,21],["ἀκροδρύων",4487,45],["κύπροι",4155,180],["μετὰ",29,1],["νάρδων",4928,61]],"Thy shoots are a garden of pomegranates, with the fruit of choice berries; camphor, with spikenard:"],["14",[["Νάρδος",4928,13],["καὶ",2,8],["κρόκος",7514,5],["κάλαμος",1472,5],["καὶ",2,8],["κιννάμωμον",5730,33],["μετὰ",29,1],["πάντων",11,79],["ξύλων",196,45],["τοῦ",1,30],["Λιβάνου",537,21],["σμύρνα",2768,13],["ἀλὼθ",6250,105],["μετὰ",29,1],["πάντων",11,79],["πρώτων",496,79],["μύρων",2272,45]],"spikenard and saffron, calamus and cinnamon; with all woods of Libanus, myrrh, aloes, with all chief spices:"],["15",[["πηγὴ",565,13],["κήπου",1325,21],["καὶ",2,8],["φρέαρ",877,33],["ὕδατος",85,24],["ζῶντος",107,291],["καὶ",2,8],["ῥοιζοῦντος",6674,291],["ἀπὸ",17,1],["τοῦ",1,30],["Λιβάνου",537,21]],"a fountain of a garden, and a well of water springing and gurgling from Libanus."],["16",[["Ἐξεγέρθητι",656,242],["βοῤῥᾶ",387,5],["καὶ",2,8],["ἔρχου",55,249],["Νότε",589,250],["καὶ",2,8],["διάπνευσον",4747,198],["κῆπόν",1325,7],["μου",6,48],["καὶ",2,8],["ῥευσάτωσαν",667,261],["ἀρώματά",2052,63],["μου",6,48]],"Awake, O north wind; and come, O south; and blow through my garden, and let my spices flow out."]]