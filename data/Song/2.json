[["1",[["Ἐγὼ",6,158],["ἄνθος",1527,20],["τοῦ",1,23],["πεδίου",348,24],["κρίνον",240,36],["τῶν",1,123],["κοιλάδων",1058,61]],"I am a flower of the plain, a lily of the valleys."],["2",[["Ὡς",36,8],["κρίνον",240,36],["ἐν",4,1],["μέσῳ",112,34],["ἀκανθῶν",1572,61],["οὕτως",70,17],["ἡ",1,11],["πλησίον",292,17],["μου",6,48],["ἀναμέσον",211,28],["τῶν",1,123],["θυγατέρων",97,61]],"As a lily among thorns, so is my companion among the daughters."],["3",[["Ὡς",36,8],["μῆλον",2937,20],["ἐν",4,1],["τοῖς",1,91],["ξύλοις",196,92],["τοῦ",1,30],["δρυμοῦ",799,21],["οὕτως",70,17],["ἀδελφιδός",1987,105],["μου",6,48],["ἀναμέσον",211,28],["τῶν",1,76],["υἱῶν",13,77],["ἐν",4,1],["τῇ",1,95],["σκιᾷ",978,2],["αὐτοῦ",3,48],["ἐπεθύμησα",916,147],["καὶ",2,8],["ἐκάθισα",273,147],["καὶ",2,8],["καρπὸς",446,5],["αὐτοῦ",3,48],["γλυκὺς",2079,16],["ἐν",4,1],["λάρυγγί",2097,113],["μου",6,48]],"As the apple among the trees of the wood, so is my kinsman among the sons. I desired his shadow, and sat down, and his fruit was sweet in my throat."],["4",[["Εἰσαγάγετέ",389,69],["με",6,82],["εἰς",8,1],["οἶκον",34,7],["τοῦ",1,30],["οἴνου",261,21],["τάξατε",783,69],["ἐπʼ",9,1],["ἐμὲ",6,98],["ἀγάπην",1986,10]],"Bring me into the wine house; set love before me."],["5",[["Στηρίσατέ",1064,69],["με",6,82],["ἐν",4,1],["μύροις",2191,92],["στοιβάσατέ",4411,69],["με",6,82],["ἐν",4,1],["μήλοις",2937,92],["ὅτι",19,8],["τετρωμένη",1919,197],["ἀγάπης",1986,19],["ἐγώ",6,178]],"Strengthen me with perfumes, stay me with apples: for I [am] wounded with love."],["6",[["Εὐώνυμος",1888,16],["αὐτοῦ",3,48],["ὑπὸ",122,1],["τὴν",1,9],["κεφαλήν",144,10],["μου",6,48],["καὶ",2,8],["ἡ",1,11],["δεξιὰ",282,15],["αὐτοῦ",3,48],["περιλήψεταί",2484,89],["με",6,82]],"His left [hand shall be] under my head, and his right hand shall embrace me."],["7",[["Ὥρκισα",1578,147],["ὑμᾶς",5,209],["θυγατέρες",97,179],["Ἱερουσαλὴμ",69,20],["ἐν",4,1],["δυνάμεσι",98,71],["καὶ",2,8],["ἐν",4,1],["ἰσχύσεσι",4660,71],["τοῦ",1,30],["ἀγροῦ",252,21],["ἐὰν",45,8],["ἐγείρητε",745,118],["καὶ",2,8],["ἐξεγείρητε",650,118],["τὴν",1,9],["ἀγάπην",1986,10],["ἕως",42,8],["οὗ",120,17],["θελήσῃ",609,160]],"I have charged you, ye daughters of Jerusalem, by the powers and by the virtues of the field, that ye do not rouse or wake [my] love, until he please."],["8",[["Φωνὴ",95,13],["ἀδελφιδοῦ",2814,21],["μου",6,48],["ἰδοὺ",51,17],["οὗτος",16,112],["ἥκει",260,87],["πηδῶν",5014,67],["ἐπὶ",9,1],["τὰ",1,42],["ὄρη",86,43],["διαλλόμενος",7117,413],["ἐπὶ",9,1],["τοὺς",1,56],["βουνούς",575,31]],"The voice of my kinsman! behold, he comes leaping over the mountains, bounding over the hills."],["9",[["Ὅμοιός",651,16],["ἐστιν",10,87],["ἀδελφιδός",1987,105],["μου",6,48],["τῇ",1,95],["δορκάδι",2166,2],["ἢ",60,8],["νεβρῷ",3918,113],["ἐλάφων",1869,77],["ἐπὶ",9,1],["τὰ",1,42],["ὄρη",86,43],["Βαιθήλ",0,0],["ἰδοὺ",51,17],["οὗτος",16,112],["ὀπίσω",166,17],["τοῦ",1,30],["τοίχου",710,21],["ἡμῶν",6,41],["παρακύπτων",3112,67],["διὰ",54,1],["τῶν",1,123],["θυρίδων",1304,61],["ἐκκύπτων",3737,67],["διὰ",54,1],["τῶν",1,44],["δικτύων",1722,45]],"My kinsman is like a roe or a young hart on the mountains of Bæthel: behold, he is behind our wall, looking through the windows, peeping through the lattices."],["10",[["Ἀποκρίνεται",229,108],["ἀδελφιδός",1987,105],["μου",6,48],["καὶ",2,8],["λέγει",31,87],["μοι",6,49],["ἀνάστα",121,275],["ἐλθὲ",56,198],["ἡ",1,11],["πλησίον",292,17],["μου",6,48],["καλή",264,15],["μου",6,48],["περιστερά",1278,13],["μου",6,48]],"My kinsman answers, and says to me, Rise up, come, my companion, my fair one, my dove."],["11",[["Ὅτι",19,8],["ἰδοὺ",51,17],["ὁ",1,4],["χειμὼν",3389,5],["παρῆλθεν",410,3],["ὁ",1,4],["ὑετὸς",672,5],["ἀπῆλθεν",305,3],["ἐπορεύθη",49,38],["ἑαυτῷ",92,49]],"For, behold, the winter is past, the rain is gone, it has departed."],["12",[["Τὰ",1,42],["ἄνθη",1527,43],["ὤφθη",111,38],["ἐν",4,1],["τῇ",1,95],["γῇ",26,2],["καιρὸς",132,5],["τῆς",1,18],["τομῆς",6183,19],["ἔφθακε",1567,165],["φωνὴ",95,13],["τῆς",1,18],["τρυγόνος",2211,19],["ἠκούσθη",53,38],["ἐν",4,1],["τῇ",1,95],["γῇ",26,2],["ἡμῶν",6,41]],"The flowers are seen in the land; the time of pruning has arrived; the voice of the turtle-dove has been heard in our land."],["13",[["Ἡ",1,11],["συκὴ",1561,13],["ἐξήνεγκεν",622,3],["ὀλύνθους",9922,31],["αὐτῆς",3,83],["αἱ",1,183],["ἄμπελοι",810,179],["κυπρίζουσιν",5791,189],["ἔδωκαν",33,141],["ὀσμήν",682,10],["ἀνάστα",121,275],["ἐλθὲ",56,198],["ἡ",1,11],["πλησίον",292,17],["μου",6,48],["καλή",264,15],["μου",6,48],["περιστερά",1278,13],["μου",6,48],["καὶ",2,8],["ἐλθὲ",56,198]],"The fig-tree has put forth its young figs, the vines put forth the tender grape, they yield a smell: arise, come, my companion, my fair one, my dove; yea, come."],["14",[["Σὺ",5,156],["περιστερά",1278,13],["μου",6,48],["ἐν",4,1],["σκέπῃ",1189,2],["τῆς",1,18],["πέτρας",546,19],["ἐχόμενα",124,203],["τοῦ",1,23],["προτειχίσματος",2963,24],["δεῖξόν",860,171],["μοι",6,49],["τὴν",1,9],["ὄψιν",1129,10],["σου",5,146],["καὶ",2,8],["ἀκούτισόν",3163,198],["με",6,98],["τὴν",1,9],["φωνήν",95,10],["σου",5,146],["ὅτι",19,8],["ἡ",1,11],["φωνή",95,13],["σου",5,146],["ἡδεῖα",2152,15],["καὶ",2,8],["ἡ",1,11],["ὄψις",1129,13],["σου",5,146],["ὡραῖα",1296,74]],"[Thou art] my dove, in the shelter of the rock, near the wall: shew me thy face, and cause me to hear thy voice; for thy voice is sweet, and thy countenance is beautiful."],["15",[["Πιάσατε",5978,69],["ἡμῖν",6,142],["ἀλώπεκας",3165,40],["μικροὺς",365,58],["ἀφανίζοντας",675,229],["ἀμπελῶνας",603,31],["καὶ",2,8],["αἱ",1,183],["ἄμπελοι",810,179],["ἡμῶν",6,41],["κυπρίζουσαι",5791,305]],"Take us the little foxes that spoil the vines: for our vines put forth tender grapes."],["16",[["Ἀδελφιδός",1987,105],["μου",6,48],["ἐμοὶ",6,49],["κᾀγὼ",611,105],["αὐτῷ",3,49],["ὁ",1,4],["ποιμαίνων",955,67],["ἐν",4,1],["τοῖς",1,138],["κρίνοις",240,481]],"My kinsman is mine, and I am his: he feeds [his flock] among the lilies."],["17",[["Ἕως",42,8],["οὗ",120,17],["διαπνεύσῃ",4772,116],["ἡ",1,11],["ἡμέρα",28,13],["καὶ",2,8],["κινηθῶσιν",993,267],["αἱ",1,183],["σκιαί",978,179],["ἀπόστρεψον",130,198],["ὁμοιώθητι",1197,242],["σὺ",5,156],["ἀδελφιδε",0,0],["μου",6,48],["τῷ",1,110],["δόρκωνι",7166,113],["ἢ",60,8],["νεβρῷ",3918,113],["ἐλάφων",1869,77],["ἐπὶ",9,1],["ὄρη",86,63],["κοιλωμάτων",3877,45]],"Until the day dawn, and the shadows depart, turn, my kinsman, be thou like to a roe or young hart on the mountains of the ravines."]]