[["1",[["Ἐγὼ",6,158],["ἄνθος",1529,20],["τοῦ",1,23],["πεδίου",349,24],["κρίνον",2021,20],["τῶν",1,123],["κοιλάδων",1058,61]],"I am a flower of the plain, a lily of the valleys."],["2",[["Ὡς",36,8],["κρίνον",2021,20],["ἐν",4,1],["μέσῳ",113,34],["ἀκανθῶν",1571,61],["οὕτως",71,17],["ἡ",1,11],["πλησίον",292,17],["μου",6,48],["ἀναμέσον",215,28],["τῶν",1,123],["θυγατέρων",97,61]],"As a lily among thorns, so is my companion among the daughters."],["3",[["Ὡς",36,8],["μῆλον",2923,20],["ἐν",4,1],["τοῖς",1,91],["ξύλοις",196,92],["τοῦ",1,30],["δρυμοῦ",802,21],["οὕτως",71,17],["ἀδελφιδός",1983,105],["μου",6,48],["ἀναμέσον",215,28],["τῶν",1,76],["υἱῶν",13,77],["ἐν",4,1],["τῇ",1,95],["σκιᾷ",978,2],["αὐτοῦ",3,48],["ἐπεθύμησα",915,147],["καὶ",2,8],["ἐκάθισα",274,147],["καὶ",2,8],["καρπὸς",448,5],["αὐτοῦ",3,48],["γλυκὺς",2073,16],["ἐν",4,1],["λάρυγγί",2092,113],["μου",6,48]],"As the apple among the trees of the wood, so is my kinsman among the sons. I desired his shadow, and sat down, and his fruit was sweet in my throat."],["4",[["Εἰσαγάγετέ",389,69],["με",6,82],["εἰς",8,1],["οἶκον",34,7],["τοῦ",1,30],["οἴνου",261,21],["τάξατε",721,69],["ἐπʼ",9,1],["ἐμὲ",6,98],["ἀγάπην",1982,10]],"Bring me into the wine house; set love before me."],["5",[["Στηρίσατέ",979,69],["με",6,82],["ἐν",4,1],["μύροις",2272,92],["στοιβάσατέ",3955,69],["με",6,82],["ἐν",4,1],["μήλοις",2923,92],["ὅτι",19,8],["τετρωμένη",1917,197],["ἀγάπης",1982,19],["ἐγώ",6,179]],"Strengthen me with perfumes, stay me with apples: for I [am] wounded with love."],["6",[["Εὐώνυμος",1885,16],["αὐτοῦ",3,48],["ὑπὸ",122,1],["τὴν",1,9],["κεφαλήν",144,10],["μου",6,48],["καὶ",2,8],["ἡ",1,11],["δεξιὰ",282,15],["αὐτοῦ",3,48],["περιλήψεταί",2477,89],["με",6,82]],"His left [hand shall be] under my head, and his right hand shall embrace me."],["7",[["Ὥρκισα",1577,147],["ὑμᾶς",5,209],["θυγατέρες",97,180],["Ἱερουσαλὴμ",70,20],["ἐν",4,1],["δυνάμεσι",98,71],["καὶ",2,8],["ἐν",4,1],["ἰσχύσεσι",4636,71],["τοῦ",1,30],["ἀγροῦ",252,21],["ἐὰν",45,8],["ἐγείρητε",746,118],["καὶ",2,8],["ἐξεγείρητε",656,118],["τὴν",1,9],["ἀγάπην",1982,10],["ἕως",42,8],["οὗ",120,17],["θελήσῃ",612,160]],"I have charged you, ye daughters of Jerusalem, by the powers and by the virtues of the field, that ye do not rouse or wake [my] love, until he please."],["8",[["Φωνὴ",95,13],["ἀδελφιδοῦ",11518,21],["μου",6,48],["ἰδοὺ",51,17],["οὗτος",16,112],["ἥκει",260,87],["πηδῶν",4985,67],["ἐπὶ",9,1],["τὰ",1,42],["ὄρη",87,43],["διαλλόμενος",7071,406],["ἐπὶ",9,1],["τοὺς",1,56],["βουνούς",577,31]],"The voice of my kinsman! behold, he comes leaping over the mountains, bounding over the hills."],["9",[["Ὅμοιός",657,16],["ἐστιν",10,87],["ἀδελφιδός",1983,105],["μου",6,48],["τῇ",1,95],["δορκάδι",2157,2],["ἢ",61,8],["νεβρῷ",3907,113],["ἐλάφων",1868,77],["ἐπὶ",9,1],["τὰ",1,42],["ὄρη",87,43],["Βαιθήλ",0,0],["ἰδοὺ",51,17],["οὗτος",16,112],["ὀπίσω",167,17],["τοῦ",1,30],["τοίχου",709,21],["ἡμῶν",6,41],["παρακύπτων",3103,67],["διὰ",56,1],["τῶν",1,123],["θυρίδων",1304,61],["ἐκκύπτων",3729,67],["διὰ",56,1],["τῶν",1,44],["δικτύων",1721,45]],"My kinsman is like a roe or a young hart on the mountains of Bæthel: behold, he is behind our wall, looking through the windows, peeping through the lattices."],["10",[["Ἀποκρίνεται",234,108],["ἀδελφιδός",1983,105],["μου",6,48],["καὶ",2,8],["λέγει",31,87],["μοι",6,49],["ἀνάστα",121,275],["ἐλθὲ",55,198],["ἡ",1,11],["πλησίον",292,17],["μου",6,48],["καλή",266,15],["μου",6,48],["περιστερά",1280,13],["μου",6,48]],"My kinsman answers, and says to me, Rise up, come, my companion, my fair one, my dove."],["11",[["Ὅτι",19,8],["ἰδοὺ",51,17],["ὁ",1,4],["χειμὼν",3383,5],["παρῆλθεν",404,3],["ὁ",1,4],["ὑετὸς",676,5],["ἀπῆλθεν",297,3],["ἐπορεύθη",49,38],["ἑαυτῷ",92,49]],"For, behold, the winter is past, the rain is gone, it has departed."],["12",[["Τὰ",1,42],["ἄνθη",1529,43],["ὤφθη",112,38],["ἐν",4,1],["τῇ",1,95],["γῇ",26,2],["καιρὸς",132,5],["τῆς",1,18],["τομῆς",6152,19],["ἔφθακε",1566,165],["φωνὴ",95,13],["τῆς",1,18],["τρυγόνος",2197,19],["ἠκούσθη",54,38],["ἐν",4,1],["τῇ",1,95],["γῇ",26,2],["ἡμῶν",6,41]],"The flowers are seen in the land; the time of pruning has arrived; the voice of the turtle-dove has been heard in our land."],["13",[["Ἡ",1,11],["συκὴ",1561,13],["ἐξήνεγκεν",624,3],["ὀλύνθους",9843,31],["αὐτῆς",3,83],["αἱ",1,185],["ἄμπελοι",812,180],["κυπρίζουσιν",5756,191],["ἔδωκαν",33,141],["ὀσμήν",684,10],["ἀνάστα",121,275],["ἐλθὲ",55,198],["ἡ",1,11],["πλησίον",292,17],["μου",6,48],["καλή",266,15],["μου",6,48],["περιστερά",1280,13],["μου",6,48],["καὶ",2,8],["ἐλθὲ",55,198]],"The fig-tree has put forth its young figs, the vines put forth the tender grape, they yield a smell: arise, come, my companion, my fair one, my dove; yea, come."],["14",[["Σὺ",5,156],["περιστερά",1280,13],["μου",6,48],["ἐν",4,1],["σκέπῃ",1188,2],["τῆς",1,18],["πέτρας",548,19],["ἐχόμενα",124,203],["τοῦ",1,23],["προτειχίσματος",2950,24],["δεῖξόν",860,171],["μοι",6,49],["τὴν",1,9],["ὄψιν",1130,10],["σου",5,146],["καὶ",2,8],["ἀκούτισόν",3157,198],["με",6,98],["τὴν",1,9],["φωνήν",95,10],["σου",5,146],["ὅτι",19,8],["ἡ",1,11],["φωνή",95,13],["σου",5,146],["ἡδεῖα",2146,15],["καὶ",2,8],["ἡ",1,11],["ὄψις",1130,13],["σου",5,146],["ὡραῖα",1296,74]],"[Thou art] my dove, in the shelter of the rock, near the wall: shew me thy face, and cause me to hear thy voice; for thy voice is sweet, and thy countenance is beautiful."],["15",[["Πιάσατε",5948,69],["ἡμῖν",6,142],["ἀλώπεκας",3159,40],["μικροὺς",367,58],["ἀφανίζοντας",623,229],["ἀμπελῶνας",607,31],["καὶ",2,8],["αἱ",1,185],["ἄμπελοι",812,180],["ἡμῶν",6,41],["κυπρίζουσαι",5756,301]],"Take us the little foxes that spoil the vines: for our vines put forth tender grapes."],["16",[["Ἀδελφιδός",1983,105],["μου",6,48],["ἐμοὶ",6,49],["κᾀγὼ",613,105],["αὐτῷ",3,49],["ὁ",1,4],["ποιμαίνων",953,67],["ἐν",4,1],["τοῖς",1,138],["κρίνοις",263,586]],"My kinsman is mine, and I am his: he feeds [his flock] among the lilies."],["17",[["Ἕως",42,8],["οὗ",120,17],["διαπνεύσῃ",4747,116],["ἡ",1,11],["ἡμέρα",28,13],["καὶ",2,8],["κινηθῶσιν",992,266],["αἱ",1,185],["σκιαί",978,180],["ἀπόστρεψον",130,198],["ὁμοιώθητι",1175,242],["σὺ",5,156],["ἀδελφιδε",0,0],["μου",6,48],["τῷ",1,110],["δόρκωνι",7119,113],["ἢ",61,8],["νεβρῷ",3907,113],["ἐλάφων",1868,77],["ἐπὶ",9,1],["ὄρη",87,63],["κοιλωμάτων",3867,45]],"Until the day dawn, and the shadows depart, turn, my kinsman, be thou like to a roe or young hart on the mountains of the ravines."]]