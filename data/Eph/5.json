[["1",[["Γίνεσθε",30,742],["οὖν",227,8],["μιμηταὶ",10941,51],["τοῦ",1,30],["θεοῦ",20,21],["ὡς",36,12],["τέκνα",192,63],["ἀγαπητὰ",1920,74]],"Be therefore imitators of God, as beloved children."],["2",[["καὶ",2,8],["περιπατεῖτε",1327,307],["ἐν",4,1],["ἀγάπῃ",1982,2],["καθὼς",221,8],["καὶ",2,8],["ὁ",1,4],["Χριστὸς",1072,5],["ἠγάπησεν",214,3],["ἡμᾶς",9994,209],["καὶ",2,8],["παρέδωκεν",254,3],["ἑαυτὸν",92,82],["ὑπὲρ",139,1],["ἡμῶν",9994,136],["προσφορὰν",2376,10],["καὶ",2,8],["θυσίαν",156,10],["τῷ",1,110],["θεῷ",20,113],["εἰς",8,1],["ὀσμὴν",684,10],["εὐωδίας",896,19]],"Walk in love, even as Christ also loved us and gave himself up for us, an offering and a sacrifice to God for a sweet-smelling fragrance."],["3",[["Πορνεία",1003,13],["δὲ",14,8],["καὶ",2,8],["ἀκαθαρσία",888,13],["πᾶσα",11,15],["ἢ",61,8],["πλεονεξία",3332,13],["μηδὲ",414,8],["ὀνομαζέσθω",1662,878],["ἐν",4,1],["ὑμῖν",5,86],["καθὼς",221,8],["πρέπει",2762,87],["ἁγίοις",75,215]],"But sexual immorality, and all uncleanness or covetousness, let it not even be mentioned among you, as becomes saints;"],["4",[["καὶ",2,8],["αἰσχρότης",11094,13],["καὶ",2,8],["μωρολογία",11095,13],["ἢ",61,8],["εὐτραπελία",11096,13],["ἃ",24,778],["οὐκ",12,12],["ἀνῆκεν",2809,14],["ἀλλὰ",108,8],["μᾶλλον",1043,17],["εὐχαριστία",4230,13]],"nor filthiness, nor foolish talking, nor jesting, which are not appropriate, but rather giving of thanks."],["5",[["τοῦτο",16,122],["γὰρ",40,8],["ἴστε",10044,651],["γινώσκοντες",79,137],["ὅτι",19,8],["πᾶς",11,16],["πόρνος",6034,5],["ἢ",61,8],["ἀκάθαρτος",374,16],["ἢ",61,8],["πλεονέκτης",7982,5],["ὅ",24,677],["ἐστιν",10,87],["εἰδωλολάτρης",10944,5],["οὐκ",12,12],["ἔχει",124,87],["κληρονομίαν",299,10],["ἐν",4,1],["τῇ",1,95],["βασιλείᾳ",157,2],["τοῦ",1,30],["Χριστοῦ",1072,21],["καὶ",2,8],["θεοῦ",20,21]],"Know this for sure, that no sexually immoral person, nor unclean person, nor covetous man (who is an idolater), has any inheritance in the Kingdom of Christ and God."],["6",[["Μηδεὶς",908,16],["ὑμᾶς",5,209],["ἀπατάτω",1291,35],["κενοῖς",780,215],["λόγοις",48,139],["διὰ",56,1],["ταῦτα",16,248],["γὰρ",40,8],["ἔρχεται",55,728],["ἡ",1,11],["ὀργὴ",198,13],["τοῦ",1,30],["θεοῦ",20,21],["ἐπὶ",9,1],["τοὺς",1,56],["υἱοὺς",13,31],["τῆς",1,18],["ἀπειθείας",5212,19]],"Let no one deceive you with empty words, for because of these things the wrath of God comes on the children of disobedience."],["7",[["μὴ",25,12],["οὖν",227,8],["γίνεσθε",30,742],["συμμέτοχοι",11086,130],["αὐτῶν",3,41]],"Therefore don’t be partakers with them."],["8",[["ἦτε",10,339],["γάρ",40,8],["ποτε",458,12],["σκότος",506,20],["νῦν",90,17],["δὲ",14,8],["φῶς",380,20],["ἐν",4,1],["κυρίῳ",7,113],["ὡς",36,12],["τέκνα",192,63],["φωτὸς",380,24],["περιπατεῖτε",1327,307]],"For you were once darkness, but are now light in the Lord. Walk as children of light,"],["9",[["ὁ",1,4],["γὰρ",40,8],["καρπὸς",448,5],["τοῦ",1,23],["φωτὸς",380,24],["ἐν",4,1],["πάσῃ",11,96],["ἀγαθωσύνῃ",2300,2],["καὶ",2,8],["δικαιοσύνῃ",187,2],["καὶ",2,8],["ἀληθείᾳ",352,2]],"for the fruit of the Spirit is in all goodness and righteousness and truth,"],["10",[["δοκιμάζοντες",1269,137],["τί",10010,238],["ἐστιν",10,87],["εὐάρεστον",5629,28],["τῷ",1,110],["κυρίῳ",7,113]],"proving what is well pleasing to the Lord."],["11",[["καὶ",2,8],["μὴ",25,12],["συγκοινωνεῖτε",11097,307],["τοῖς",1,91],["ἔργοις",105,92],["τοῖς",1,91],["ἀκάρποις",5261,90],["τοῦ",1,23],["σκότους",506,24],["μᾶλλον",1043,17],["δὲ",14,8],["καὶ",2,8],["ἐλέγχετε",752,307]],"Have no fellowship with the unfruitful deeds of darkness, but rather even reprove them."],["12",[["τὰ",1,42],["γὰρ",40,8],["κρυφῇ",11098,17],["γινόμενα",30,835],["ὑπ᾽",122,1],["αὐτῶν",3,41],["αἰσχρόν",2439,28],["ἐστιν",10,87],["καὶ",2,8],["λέγειν",31,54]],"For it is a shame even to speak of the things which are done by them in secret."],["13",[["τὰ",1,253],["δὲ",14,8],["πάντα",11,74],["ἐλεγχόμενα",752,822],["ὑπὸ",122,1],["τοῦ",1,23],["φωτὸς",380,24],["φανεροῦται",8582,449]],"But all things, when they are reproved, are reve