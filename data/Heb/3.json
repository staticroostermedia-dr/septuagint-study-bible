[["1",[["Ὅθεν",1153,8],["ἀδελφοὶ",67,396],["ἅγιοι",75,537],["κλήσεως",5735,19],["ἐπουρανίου",4098,78],["μέτοχοι",3093,396],["κατανοήσατε",1549,69],["τὸν",1,6],["ἀπόστολον",10080,7],["καὶ",2,8],["ἀρχιερέα",1100,7],["τῆς",1,18],["ὁμολογίας",3222,19],["ἡμῶν",9994,136],["Ἰησοῦν",211,7]],"Therefore, holy brothers, partakers of a heavenly calling, consider the Apostle and High Priest of our confession: Jesus,"],["2",[["πιστὸν",750,59],["ὄντα",10,178],["τῷ",1,110],["ποιήσαντι",23,354],["αὐτὸν",3,82],["ὡς",36,12],["καὶ",2,8],["Μωϋσῆς",5453,5],["ἐν",4,1],["ὅλῳ",235,111],["τῷ",1,110],["οἴκῳ",34,113],["αὐτοῦ",3,48]],"who was faithful to him who appointed him, as also Moses was in all his house."],["3",[["πλείονος",938,78],["γὰρ",40,8],["οὗτος",16,112],["δόξης",141,19],["παρὰ",73,1],["Μωϋσῆν",5453,7],["ἠξίωται",1127,722],["καθ᾽",32,1],["ὅσον",103,467],["πλείονα",938,37],["τιμὴν",720,10],["ἔχει",124,87],["τοῦ",1,30],["οἴκου",34,21],["ὁ",1,4],["κατασκευάσας",1437,155],["αὐτόν",3,82]],"For he has been counted worthy of more glory than Moses, because he who built the house has more honor than the house."],["4",[["πᾶς",11,16],["γὰρ",40,8],["οἶκος",34,5],["κατασκευάζεται",1437,449],["ὑπό",122,1],["τινος",39,805],["ὁ",1,4],["δὲ",14,8],["πάντα",11,65],["κατασκευάσας",1437,155],["θεός",20,5]],"For every house is built by someone; but he who built all things is God."],["5",[["καὶ",2,8],["Μωϋσῆς",5453,5],["μὲν",281,12],["πιστὸς",750,16],["ἐν",4,1],["ὅλῳ",235,111],["τῷ",1,110],["οἴκῳ",34,113],["αὐτοῦ",3,48],["ὡς",36,12],["θεράπων",804,5],["εἰς",8,1],["μαρτύριον",225,33],["τῶν",1,44],["λαληθησομένων",50,947]],"Moses indeed was faithful in all his house as a servant, for a testimony of those things which were afterward to be spoken,"],["6",[["Χριστὸς",1072,5],["δὲ",14,8],["ὡς",36,12],["υἱὸς",13,5],["ἐπὶ",9,1],["τὸν",1,6],["οἶκον",34,7],["αὐτοῦ",3,48],["οὗ",24,367],["οἶκός",34,5],["ἐσμεν",10,241],["ἡμεῖς",9994,208],["ἐάνπερ",45,8],["τὴν",1,9],["παρρησίαν",2610,10],["καὶ",2,8],["τὸ",1,32],["κα