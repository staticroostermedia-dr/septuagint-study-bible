,13],["πονηρὰ",164,15],["ἀπιστίας",6299,19],["ἐν",4,1],["τῷ",1,52],["ἀποστῆναι",293,100],["ἀπὸ",17,1],["θεοῦ",20,21],["ζῶντος",107,143]],"Beware, brothers, lest perhaps there might be in any one of you an evil heart of unbelief, in falling away from the living God;"],["13",[["ἀλλὰ",108,8],["παρακαλεῖτε",434,307],["ἑαυτοὺς",92,60],["καθ᾽",32,1],["ἑκάστην",171,37],["ἡμέραν",28,10],["ἄχρις",4062,1],["οὗ",24,367],["τὸ",1,27],["σήμερον",205,17],["καλεῖται",128,449],["ἵνα",102,8],["μὴ",25,12],["σκληρυνθῇ",1284,333],["τις",39,150],["ἐξ",21,1],["ὑμῶν",5,136],["ἀπάτῃ",9077,2],["τῆς",1,18],["ἁμαρτίας",119,19]],"but exhort one another day by day, so long as it is called “today”, lest any one of you be hardened by the deceitfulness of sin."],["14",[["μέτοχοι",3093,51],["γὰρ",40,8],["τοῦ",1,30],["Χριστοῦ",1072,21],["γεγόναμεν",30,311],["ἐάνπερ",45,8],["τὴν",1,9],["ἀρχὴν",270,10],["τῆς",1,18],["ὑποστάσεως",1877,19],["μέχρι",781,1],["τέλους",373,24],["βεβαίαν",3796,37],["κατάσχωμεν",1040,75]],"For we have become partakers of Christ, if we hold the beginning of our confidence firm to the end,"],["15",[["ἐν",4,1],["τῷ",1,52],["λέγεσθαι",31,634],["σήμερον",205,17],["ἐὰν",45,8],["τῆς",1,18],["φωνῆς",95,19],["αὐτοῦ",3,48],["ἀκούσητε",54,118],["μὴ",25,12],["σκληρύνητε",1284,118],["τὰς",1,39],["καρδίας",64,40],["ὑμῶν",5,136],["ὡς",36,12],["ἐν",4,1],["τῷ",1,110],["παραπικρασμῷ",7875,113]],"while it is said, “Today if you will hear his voice, don’t harden your hearts, as in the rebellion.”"],["16",[["τίνες",10010,402],["γὰρ",40,8],["ἀκούσαντες",54,190],["παρεπίκραναν",1685,141],["ἀλλ᾽",108,8],["οὐ",12,12],["πάντες",11,130],["οἱ",1,128],["ἐξελθόντες",82,190],["ἐξ",21,1],["Αἰγύπτου",93,19],["διὰ",56,1],["Μωϋσέως",5453,21]],"For who, when they heard, rebelled? Wasn’t it all those who came out of Egypt led by Moses?"],["17",[["τίσιν",10010,934],["δὲ",14,8],["προσώχθισεν",1780,3],["τεσσεράκοντα",512,372],["ἔτη",81,43],["οὐχὶ",330,12],["τοῖς",1,138],["ἁμαρτήσασιν",237,461],["ὧν",24,303],["τὰ",1,253],["κῶλα",3076,63],["ἔπεσεν",154,3],["ἐν",4,1],["τῇ",1,95],["ἐρήμῳ",160,96]],"With whom was he displeased forty years? Wasn’t it with those who sinned, whose bodies fell in the wilderness?"],["18",[["τίσιν",10010,934],["δὲ",14,8],["ὤμοσεν",347,3],["μὴ",25,12],["εἰσελεύσεσθαι",86,894],["εἰς",8,1],["τὴν",1,9],["κατάπαυσιν",2728,10],["αὐτοῦ",3,48],["εἰ",77,8],["μὴ",25,12],["τοῖς",1,138],["ἀπειθήσασιν",993,461]],"To whom did he swear that they wouldn’t enter into his rest, but to those who were disobedient?"],["19",[["καὶ",2,8],["βλέπομεν",470,241],["ὅτι",19,8],["οὐκ",12,12],["ἠδυνήθησαν",185,725],["εἰσελθεῖν",86,100],["δι᾽",56,1],["ἀπιστίαν",6299,10]],"We see that they weren’t able to enter in because of unbelief."]]