[["1",[["Πᾶς",11,16],["γὰρ",40,8],["ἀρχιερεὺς",1100,5],["ἐξ",21,1],["ἀνθρώπων",43,77],["λαμβανόμενος",46,714],["ὑπὲρ",139,1],["ἀνθρώπων",43,77],["καθίσταται",314,449],["τὰ",1,42],["πρὸς",15,1],["τὸν",1,6],["θεόν",20,7],["ἵνα",102,8],["προσφέρῃ",363,173],["δῶρά",348,43],["τε",209,8],["καὶ",2,8],["θυσίας",156,40],["ὑπὲρ",139,1],["ἁμαρτιῶν",119,61]],"For every high priest, being taken from among men, is appointed for men in things pertaining to God, that he may offer both gifts and sacrifices for sins."],["2",[["μετριοπαθεῖν",11317,54],["δυνάμενος",185,723],["τοῖς",1,138],["ἀγνοοῦσιν",1846,352],["καὶ",2,8],["πλανωμένοις",464,915],["ἐπεὶ",1236,8],["καὶ",2,8],["αὐτὸς",3,158],["περίκειται",4982,728],["ἀσθένειαν",3413,10]],"The high priest can deal gently with those who are ignorant and going astray, because he himself is also surrounded with weakness."],["3",[["καὶ",2,8],["δι᾽",56,1],["αὐτὴν",3,98],["ὀφείλει",2150,87],["καθὼς",221,8],["περὶ",72,1],["τοῦ",1,30],["λαοῦ",35,21],["οὕτως",71,17],["καὶ",2,8],["περὶ",72,1],["αὐτοῦ",92,48],["προσφέρειν",363,54],["περὶ",72,1],["ἁμαρτιῶν",119,61]],"Because of this, he must offer sacrifices for sins for the people, as well as for himself."],["4",[["καὶ",2,8],["οὐχ",12,12],["ἑαυτῷ",92,49],["τις",39,150],["λαμβάνει",46,87],["τὴν",1,9],["τιμὴν",720,10],["ἀλλὰ",108,8],["καλούμενος",128,714],["ὑπὸ",122,1],["τοῦ",1,30],["θεοῦ",20,21],["καθώσπερ",11318,8],["καὶ",2,8],["Ἀαρών",159,5]],"Nobody takes this honor on himself, but he is called by God, just like Aaron was."],["5",[["οὕτως",71,17],["καὶ",2,8],["ὁ",1,4],["Χριστὸς",1072,5],["οὐχ",12,12],["ἑαυτὸν",92,82],["ἐδόξασεν",452,3],["γενηθῆναι",30,807],["ἀρχιερέα",1100,7],["ἀλλ᾽",108,8],["ὁ",1,4],["λαλήσας",50,155],["πρὸς",15,1],["αὐτόν",3,82],["υἱός",13,5],["μου",9994,146],["εἶ",10,145],["σύ",5,156],["ἐγὼ",6,156],["σήμερον",205,17],["γεγέννηκά",222,85],["σε",5,161]],"So also Christ didn’t glorify himself to be made a high priest, but it was he who said to him, “You are my Son. Today I have become your father.”"],["6",[["καθὼς",221,8],["καὶ",2,8],["ἐν",4,1],["ἑτέρῳ",253,111],["λέγει",31,87],["σὺ",5,156],["ἱερεὺς",65,5],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["κατὰ",32,1],["τὴν",1,9],["τάξιν",1744,10],["Μελχισέδεκ",5452,21]],"As he says also in another place, “You are a priest forever, after the order of Melchizedek.”"],["7",[["ὃς",24,246],["ἐν",4,1],["ταῖς",1,70],["ἡμέραις",28,71],["τῆς",1,18],["σαρκὸς",287,19],["αὐτοῦ",3,48],["δεήσεις",677,40],["τε",209,8],["καὶ",2,8],["ἱκετηρίας",9763,40],["πρὸς",15,1],["τὸν",1,6],["δυνάμενον",185,765],["σῴζειν",172,54],["αὐτὸν",3,82],["ἐκ",21,1],["θανάτου",170,21],["μετὰ",29,1],["κραυγῆς",828,19],["ἰσχυρᾶς",401,78],["καὶ",2,8],["δακρύων",1268,45],["προσενέγκας",363,155],["καὶ",2,8],["εἰσακουσθεὶς",241,206],["ἀπὸ",17,1],["τῆς",1,18],["εὐλαβείας",4774,19]],"He, in the days of his flesh, having offered up prayers and petitions with strong crying and tears to him who was able to save him from death, and having been heard for his godly fear,"],["8",[["καίπερ",2902,8],["ὢν",10,67],["υἱός",13,5],["ἔμαθεν",923,3],["ἀφ᾽",17,1],["ὧν",24,97],["ἔπαθεν",1972,3],["τὴν",1,9],["ὑπακοήν",9870,10]],"though he was a Son, yet learned obedience by the things which he suffered."],["9",[["καὶ",2,8],["τελειωθεὶς",1838,206],["ἐγένετο",30,737],["πᾶσιν",11,215],["τοῖς",1,138],["ὑπακούουσιν",867,352],["αὐτῷ",3,49],["αἴτιος",3036,16],["σωτηρίας",425,19],["αἰωνίου",391,78]],"Having been made perfect, he became to all of those who obey him the author of eternal salvation,"],["10",[["προσαγορευθεὶς",3339,206],["ὑπὸ",122,1],["τοῦ",1,30],["θεοῦ",20,21],["ἀρχιερεὺς",1100,5],["κατὰ",32,1],["τὴν",1,9],["τάξιν",1744,10],["Μελχισέδεκ",5452,21]],"named by God a high priest after the order of Melchizedek."],["11",[["περὶ",72,1],["οὗ",24,367],["πολὺς",74,16],["ἡμῖν",9994,86],["ὁ",1,4],["λόγος",48,5],["καὶ",2,8],["δυσερμήνευτος",11319,16],["λέγειν",31,54],["ἐπεὶ",1236,8],["νωθροὶ",4926,130],["γεγόνατε",30,330],["ταῖς",1,70],["ἀκοαῖς",1047,71]],"About him we have many words to say, and hard to interpret, seeing you have become dull of hearing."],["12",[["καὶ",2,8],["γὰρ",40,8],["ὀφείλοντες",2150,137],["εἶναι",10135,54],["διδάσκαλοι",7031,51],["διὰ",56,1],["τὸν",1,6],["χρόνον",486,7],["πάλιν",655,17],["χρείαν",1006,10],["ἔχετε",124,84],["τοῦ",1,23],["διδάσκειν",545,54],["ὑμᾶς",5,209],["τινὰ",39,365],["τὰ",1,42],["στοιχεῖα",6072,43],["τῆς",1,18],["ἀρχῆς",270,19],["τῶν",1,44],["λογίων",1248,45],["τοῦ",1,30],["θεοῦ",20,21],["καὶ",2,8],["γεγόνατε",30,330],["χρείαν",1006,10],["ἔχοντες",124,137],["γάλακτος",1034,24],["καὶ",2,8],["οὐ",12,12],["στερεᾶς",2289,78],["τροφῆς",1390,19]],"For although by this time you should be teachers, you again need to have someone teach you the rudiments of the first principles of the revelations of God. You have come to need milk, and not solid food."],["13",[["πᾶς",11,16],["γὰρ",40,8],["ὁ",1,4],["μετέχων",2741,67],["γάλακτος",1034,24],["ἄπειρος",4556,16],["λόγου",48,21],["δικαιοσύνης",187,19],["νήπιος",1016,16],["γάρ",40,8],["ἐστιν",10,87]],"For everyone who lives on milk is not experienced in the word of righteousness, for he is a baby."],["14",[["τελείων",1919,163],["δέ",14,8],["ἐστιν",10,87],["ἡ",1,11],["στερεὰ",2289,15],["τροφὴ",1390,13],["τῶν",1,76],["διὰ",56,1],["τὴν",1,9],["ἕξιν",5375,10],["τὰ",1,42],["αἰσθητήρια",5479,43],["γεγυμνασμένα",6918,786],["ἐχόντων",124,164],["πρὸς",15,1],["διάκρισιν",7069,10],["καλοῦ",266,88],["τε",209,8],["καὶ",2,8],["κακοῦ",161,88]],"But solid food is for those who are full grown, who by reason of use have their senses exercised to discern good and evil."]]