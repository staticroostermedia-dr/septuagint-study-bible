[["1",[["Ἡ",1,11],["φιλαδελφία",5121,13],["μενέτω",681,35]],"Let brotherly love continue."],["2",[["τῆς",1,18],["φιλοξενίας",10889,19],["μὴ",25,12],["ἐπιλανθάνεσθε",3006,742],["διὰ",56,1],["ταύτης",16,290],["γὰρ",40,8],["ἔλαθόν",1768,141],["τινες",39,402],["ξενίσαντες",4330,190],["ἀγγέλους",208,31]],"Don’t forget to show hospitality to strangers, for in doing so, some have entertained angels without knowing it."],["3",[["μιμνῄσκεσθε",230,742],["τῶν",1,76],["δεσμίων",2889,77],["ὡς",36,12],["συνδεδεμένοι",3361,574],["τῶν",1,76],["κακουχουμένων",5669,795],["ὡς",36,12],["καὶ",2,8],["αὐτοὶ",3,195],["ὄντες",10,137],["ἐν",4,1],["σώματι",454,53]],"Remember those who are in bonds, as bound with them, and those who are ill-treated, since you are also in the body."],["4",[["Τίμιος",1189,16],["ὁ",1,4],["γάμος",1882,5],["ἐν",4,1],["πᾶσιν",11,215],["καὶ",2,8],["ἡ",1,11],["κοίτη",704,13],["ἀμίαντος",4017,15],["πόρνους",6034,31],["γὰρ",40,8],["καὶ",2,8],["μοιχοὺς",5840,31],["κρινεῖ",263,120],["ὁ",1,4],["θεός",20,5]],"Let marriage be held in honor among all, and let the bed be undefiled; but God will judge the sexually immoral and adulterers."],["5",[["Ἀφιλάργυρος",11210,16],["ὁ",1,4],["τρόπος",245,5],["ἀρκούμενοι",2662,772],["τοῖς",1,91],["παροῦσιν",899,471],["αὐτὸς",3,158],["γὰρ",40,8],["εἴρηκεν",9993,165],["οὐ",12,12],["μή",25,12],["σε",5,161],["ἀνῶ",1081,227],["οὐδ᾽",106,8],["οὐ",12,12],["μή",25,12],["σε",5,161],["ἐγκαταλίπω",364,227]],"Be free from the love of money, content with such things as you have, for he has said, “I will in no way leave you, neither will I in any way forsake you.”"],["6",[["ὥστε",346,8],["θαρροῦντας",11009,229],["ἡμᾶς",9994,209],["λέγειν",31,54],["κύριος",7,5],["ἐμοὶ",6,151],["βοηθός",947,5],["καὶ",2,8],["οὐ",12,12],["φοβηθήσομαι",134,937],["τί",10010,119],["ποιήσει",23,120],["μοι",9994,151],["ἄνθρωπος",43,5]],"So that with good courage we say, “The Lord is my helper. I will not fear. What can man do to me?”"],["7",[["Μνημονεύετε",1900,307],["τῶν",1,76],["ἡγουμένων",378,762],["ὑμῶν",5,136],["οἵτινες",457,455],["ἐλάλησαν",50,141],["ὑμῖν",5,86],["τὸν",1,6],["λόγον",48,7],["τοῦ",1,30],["θεοῦ",20,21],["ὧν",24,303],["ἀναθεωροῦντες",10652,137],["τὴν",1,9],["ἔκβασιν",5357,10],["τῆς",1,18],["ἀναστροφῆς",6267,19],["μιμεῖσθε",4311,742],["τὴν",1,9],["πίστιν",887,10]],"Remember your leaders, men who spoke to you the word of God, and considering the results of their conduct, imitate their faith."],["8",[["Ἰησοῦς",211,5],["Χριστὸς",1072,5],["ἐχθὲς",1288,17],["καὶ",2,8],["σήμερον",205,17],["ὁ",1,4],["αὐτὸς",3,158],["καὶ",2,8],["εἰς",8,1],["τοὺς",1,56],["αἰῶνας",100,31]],"Jesus Christ is the same yesterday, today, and forever."],["9",[["διδαχαῖς",7030,71],["ποικίλαις",1558,287],["καὶ",2,8],["ξέναις",1828,287],["μὴ",25,12],["παραφέρεσθε",5905,809],["καλὸν",266,28],["γὰρ",40,8],["χάριτι",368,2],["βεβαιοῦσθαι",4705,634],["τὴν",1,9],["καρδίαν",64,10],["οὐ",12,12],["βρώμασιν",714,92],["ἐν",4,1],["οἷς",24,337],["οὐκ",12,12],["ὠφελήθησαν",1499,94],["οἱ",1,128],["περιπατοῦντες",1327,137]],"Don’t be carried away by various and strange teachings, for it is good that the heart be established by grace, not by foods, through which those who were so occupied were not benefited."],["10",[["ἔχομεν",124,241],["θυσιαστήριον",133,33],["ἐξ",21,1],["οὗ",24,563],["φαγεῖν",269,100],["οὐκ",12,12],["ἔχουσιν",124,191],["ἐξουσίαν",929,10],["οἱ",1,128],["τῇ",1,95],["σκηνῇ",131,2],["λατρεύοντες",594,137]],"We have an altar from which those who serve the holy tabernacle have no right to eat."],["11",[["ὧν",24,97],["γὰρ",40,8],["εἰσφέρεται",587,449],["ζῴων",7225,45],["τὸ",1,27],["αἷμα",148,20],["περὶ",72,1],["ἁμαρτίας",119,19],["εἰς",8,1],["τὰ",1,42],["ἅγια",11330,65],["διὰ",56,1],["τοῦ",1,30],["ἀρχιερέως",1100,21],["τούτων",16,214],["τὰ",1,253],["σώματα",454,63],["κατακαίεται",554,449],["ἔξω",527,1],["τῆς",1,18],["παρεμβολῆς",190,19]],"For the bodies of those animals, whose blood is brought into the holy place by the high priest as an offering for sin, are burned outside of the camp."],["12",[["Διὸ",1466,8],["καὶ",2,8],["Ἰησοῦς",211,5],["ἵνα",102,8],["ἁγιάσῃ",329,160],["διὰ",56,1],["τοῦ",1,23],["ἰδίου",683,88],["αἵματος",148,24],["τὸν",1,6],["λαόν",35,7],["ἔξω",527,1],["τῆς",1,18],["πύλης",162,19],["ἔπαθεν",1972,3]],"Therefore Jesus also, that he might sanctify the people through his own blood, suffered outside of the gate."],["13",[["τοίνυν",1789,8],["ἐξερχώμεθα",82,873],["πρὸς",15,1],["αὐτὸν",3,82],["ἔξω",527,1],["τῆς",1,18],["παρεμβολῆς",190,19],["τὸν",1,6],["ὀνειδισμὸν",733,7],["αὐτοῦ",3,48],["φέροντες",199,137]],"Let’s therefore go out to him outside of the camp, bearing his reproach."],["14",[["οὐ",12,12],["γὰρ",40,8],["ἔχομεν",124,241],["ὧδε",640,17],["μένουσαν",681,73],["πόλιν",41,10],["ἀλλὰ",108,8],["τὴν",1,9],["μέλλουσαν",1143,73],["ἐπιζητοῦμεν",1936,241]],"For we don’t have here an enduring city, but we seek that which is to come."],["15",[["δι᾽",56,1],["αὐτοῦ",3,48],["οὖν",227,8],["ἀναφέρωμεν",384,223],["θυσίαν",156,10],["αἰνέσεως",989,19],["διὰ",56,1],["παντὸς",11,153],["τῷ",1,110],["θεῷ",20,113],["τοῦτ᾽",16,344],["ἔστιν",10,87],["καρπὸν",448,7],["χειλέων",361,45],["ὁμολογούντων",2686,164],["τῷ",1,52],["ὀνόματι",57,53],["αὐτοῦ",3,48]],"Through him, then, let’s offer up a sacrifice of praise to God continually, that is, the fruit of lips which proclaim allegiance to his name."],["16",[["τῆς",1,18],["δὲ",14,8],["εὐποιΐας",11351,19],["καὶ",2,8],["κοινωνίας",4860,19],["μὴ",25,12],["ἐπιλανθάνεσθε",3006,742],["τοιαύταις",630,336],["γὰρ",40,8],["θυσίαις",156,71],["εὐαρεστεῖται",4223,449],["ὁ",1,4],["θεός",20,5]],"But don’t forget to be doing good and sharing, for with such sacrifices God is well pleased."],["17",[["Πείθεσθε",344,809],["τοῖς",1,138],["ἡγουμένοις",378,736],["ὑμῶν",5,136],["καὶ",2,8],["ὑπείκετε",9892,307],["αὐτοὶ",3,195],["γὰρ",40,8],["ἀγρυπνοῦσιν",2802,191],["ὑπὲρ",139,1],["τῶν",1,123],["ψυχῶν",63,61],["ὑμῶν",5,136],["ὡς",36,12],["λόγον",48,7],["ἀποδώσοντες",312,580],["ἵνα",102,8],["μετὰ",29,1],["χαρᾶς",1125,19],["τοῦτο",16,122],["ποιῶσιν",23,265],["καὶ",2,8],["μὴ",25,12],["στενάζοντες",1445,137],["ἀλυσιτελὲς",11352,28],["γὰρ",40,8],["ὑμῖν",5,86],["τοῦτο",16,344]],"Obey your leaders and submit to them, for they watch on behalf of your souls, as those who will give account, that they may do this with joy and not with groaning, for that would be unprofitable for you."],["18",[["Προσεύχεσθε",551,742],["περὶ",72,1],["ἡμῶν",9994,136],["πειθόμεθα",344,885],["γὰρ",40,8],["ὅτι",19,8],["καλὴν",266,37],["συνείδησιν",6118,10],["ἔχομεν",124,241],["ἐν",4,1],["πᾶσιν",11,90],["καλῶς",1273,17],["θέλοντες",612,137],["ἀναστρέφεσθαι",522,634]],"Pray for us, for we are persuaded that we have a good conscience, desiring to live honorably in all things."],["19",[["περισσοτέρως",10995,17],["δὲ",14,8],["παρακαλῶ",434,149],["τοῦτο",16,122],["ποιῆσαι",23,100],["ἵνα",102,8],["τάχιον",6167,29],["ἀποκατασταθῶ",1149,555],["ὑμῖν",5,86]],"I strongly urge you to do this, that I may be restored to you sooner."],["20",[["Ὁ",1,4],["δὲ",14,8],["θεὸς",20,5],["τῆς",1,18],["εἰρήνης",213,19],["ὁ",1,4],["ἀναγαγὼν",524,155],["ἐκ",21,1],["νεκρῶν",659,163],["τὸν",1,6],["ποιμένα",664,7],["τῶν",1,44],["προβάτων",194,45],["τὸν",1,6],["μέγαν",66,59],["ἐν",4,1],["αἵματι",148,53],["διαθήκης",169,19],["αἰωνίου",391,78],["τὸν",1,6],["κύριον",7,7],["ἡμῶν",9994,136],["Ἰησοῦν",211,7]],"Now may the God of peace, who brought again from the dead the great shepherd of the sheep with the blood of an eternal covenant, our Lord Jesus,"],["21",[["καταρτίσαι",1888,216],["ὑμᾶς",5,209],["ἐν",4,1],["παντὶ",11,34],["ἀγαθῷ",114,34],["εἰς",8,1],["τὸ",1,32],["ποιῆσαι",23,100],["τὸ",1,32],["θέλημα",1039,33],["αὐτοῦ",3,48],["ποιῶν",23,67],["ἐν",4,1],["ἡμῖν",9994,86],["τὸ",1,32],["εὐάρεστον",5629,29],["ἐνώπιον",115,1],["αὐτοῦ",3,48],["διὰ",56,1],["Ἰησοῦ",211,21],["Χριστοῦ",1072,21],["ᾧ",24,202],["ἡ",1,11],["δόξα",141,13],["εἰς",8,1],["τοὺς",1,56],["αἰῶνας",100,31],["τῶν",1,76],["αἰώνων",100,77],["ἀμήν",3161,316]],"make you complete in every good work to do his will, working in you that which is well pleasing in his sight, through Jesus Christ, to whom be the glory forever and ever. Amen."],["22",[["Παρακαλῶ",434,149],["δὲ",14,8],["ὑμᾶς",5,209],["ἀδελφοί",67,396],["ἀνέχεσθε",2211,742],["τοῦ",1,30],["λόγου",48,21],["τῆς",1,18],["παρακλήσεως",2183,19],["καὶ",2,8],["γὰρ",40,8],["διὰ",56,1],["βραχέων",618,163],["ἐπέστειλα",10609,147],["ὑμῖν",5,86]],"But I exhort you, brothers, endure the word of exhortation, for I have written to you in few words."],["23",[["Γινώσκετε",79,84],["τὸν",1,6],["ἀδελφὸν",67,7],["ἡμῶν",9994,136],["Τιμόθεον",1953,7],["ἀπολελυμένον",1395,763],["μεθ᾽",29,1],["οὗ",24,367],["ἐὰν",45,8],["τάχιον",6167,29],["ἔρχηται",55,782],["ὄψομαι",112,775],["ὑμᾶς",5,209]],"Know that our brother Timothy has been freed, with whom, if he comes shortly, I will see you."],["24",[["Ἀσπάσασθε",2987,771],["πάντας",11,58],["τοὺς",1,56],["ἡγουμένους",378,729],["ὑμῶν",5,136],["καὶ",2,8],["πάντας",11,58],["τοὺς",1,56],["ἁγίους",75,58],["Ἀσπάζονται",2987,756],["ὑμᾶς",5,209],["οἱ",1,128],["ἀπὸ",17,1],["τῆς",1,18],["Ἰταλίας",10660,19]],"Greet all of your leaders and all the saints. The Italians greet you."],["25",[["ἡ",1,11],["χάρις",368,13],["μετὰ",29,1],["πάντων",11,163],["ὑμῶν",5,136]],"Grace be with you all. Amen."]]