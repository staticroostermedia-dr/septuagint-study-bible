υόμενά",365,791],["ἐστιν",10,87],["τὰ",1,253],["κοινοῦντα",10119,289],["τὸν",1,6],["ἄνθρωπον",43,7]],"There is nothing from outside of the man that going into him can defile him; but the things which proceed out of the man are those that defile the man."],["16",[],"If anyone has ears to hear, let him hear!”",{"s":"g0"}],["17",[["καὶ",2,8],["ὅτε",432,8],["εἰσῆλθεν",86,3],["εἰς",8,1],["οἶκον",34,7],["ἀπὸ",17,1],["τοῦ",1,30],["ὄχλου",1008,21],["ἐπηρώτων",739,129],["αὐτὸν",3,82],["οἱ",1,128],["μαθηταὶ",10025,51],["αὐτοῦ",3,48],["τὴν",1,9],["παραβολήν",1061,10]],"When he had entered into a house away from the multitude, his disciples asked him about the parable."],["18",[["καὶ",2,8],["λέγει",31,87],["αὐτοῖς",3,142],["οὕτως",9989,17],["καὶ",2,8],["ὑμεῖς",5,208],["ἀσύνετοί",2517,130],["ἐστε",10,84],["οὐ",12,12],["νοεῖτε",1383,84],["ὅτι",19,8],["πᾶν",11,28],["τὸ",1,27],["ἔξωθεν",1050,1],["εἰσπορευόμενον",376,789],["εἰς",8,1],["τὸν",1,6],["ἄνθρωπον",43,7],["οὐ",12,12],["δύναται",185,728],["αὐτὸν",3,82],["κοινῶσαι",10119,100]],"He said to them, “Are you also without understanding? Don’t you perceive that whatever goes into the man from outside can’t defile him,"],["19",[["ὅτι",19,8],["οὐκ",12,12],["εἰσπορεύεται",376,728],["αὐτοῦ",3,48],["εἰς",8,1],["τὴν",1,9],["καρδίαν",64,10],["ἀλλ᾽",108,8],["εἰς",8,1],["τὴν",1,9],["κοιλίαν",547,10],["καὶ",2,8],["εἰς",8,1],["τὸν",1,6],["ἀφεδρῶνα",10121,7],["ἐκπορεύεται",365,728],["καθαρίζων",482,67],["πάντα",11,65],["τὰ",1,42],["βρώματα",714,43]],"because it doesn’t go into his heart, but into his stomach, then into the latrine, making all foods clean?”"],["20",[["ἔλεγεν",31,14],["δὲ",14,8],["ὅτι",19,8],["τὸ",1,27],["ἐκ",21,1],["τοῦ",1,30],["ἀνθρώπου",43,21],["ἐκπορευόμενον",365,789],["ἐκεῖνο",80,344],["κοινοῖ",10119,87],["τὸν",1,6],["ἄνθρωπον",43,7]],"He said, “That which proceeds out of the man, that defiles the man."],["21",[["ἔσωθεν",1610,17],["γὰρ",40,8],["ἐκ",21,1],["τῆς",1,18],["καρδίας",64,19],["τῶν",1,76],["ἀνθρώπων",43,77],["οἱ",1,128],["διαλογισμοὶ",1584,51],["οἱ",1,128],["κακοὶ",161,130],["ἐκπορεύονται",365,756],["πορνεῖαι",1003,180],["κλοπαί",3560,180],["φόνοι",1645,51]],"For from within, out of the hearts of men, proceed evil thoughts, adulteries, sexual sins, murders, thefts,"],["22",[["μοιχεῖαι",4312,180],["πλεονεξίαι",3332,180],["πονηρίαι",730,180],["δόλος",919,5],["ἀσέλγεια",6347,13],["ὀφθαλμὸς",91,5],["πονηρός",164,16],["βλασφημία",3505,13],["ὑπερηφανία",1131,13],["ἀφροσύνη",1401,13]],"covetings, wickedness, deceit, lustful desires, an evil eye, blasphemy, pride, and foolishness."],["23",[["πάντα",11,74],["ταῦτα",16,335],["τὰ",1,253],["πονηρὰ",164,74],["ἔσωθεν",1610,17],["ἐκπορεύεται",365,728],["καὶ",2,8],["κοινοῖ",10119,87],["τὸν",1,6],["ἄνθρωπον",43,7]],"All these evil things come from within and defile the man.”"],["24",[["Ἐκεῖθεν",430,17],["δὲ",14,8],["ἀναστὰς",121,155],["ἀπῆλθεν",297,3],["εἰς",8,1],["τὰ",1,42],["ὅρια",236,43],["Τύρου",1199,19],["καὶ",2,8],["εἰσελθὼν",86,155],["εἰς",8,1],["οἰκίαν",233,10],["οὐδένα",228,59],["ἤθελεν",612,14],["γνῶναι",79,100],["καὶ",2,8],["οὐκ",12,12],["ἠδυνήθη",185,715],["λαθεῖν",1768,100]],"From there he arose and went away into the borders of Tyre and Sidon. He entered into a house and didn’t want anyone to know it, but he couldn’t escape notice."],["25",[["ἀλλ᾽",108,8],["εὐθὺς",1673,17],["ἀκούσασα",54,140],["γυνὴ",59,13],["περὶ",72,1],["αὐτοῦ",3,48],["ἧς",24,162],["εἶχεν",124,14],["τὸ",1,27],["θυγάτριον",10233,20],["αὐτῆς",3,83],["πνεῦμα",168,33],["ἀκάθαρτον",374,29],["ἐλθοῦσα",55,140],["προσέπεσεν",1737,3],["πρὸς",15,1],["τοὺς",1,56],["πόδας",210,31],["αὐτοῦ",3,48]],"For a woman whose little daughter had an unclean spirit, having heard of him, came and fell down at his feet."],["26",[["ἡ",1,11],["δὲ",14,8],["γυνὴ",59,13],["ἦν",10,14],["Ἑλληνὶς",9703,13],["Συροφοινίκισσα",10246,13],["τῷ",1,52],["γένει",519,53],["καὶ",2,8],["ἠρώτα",822,14],["αὐτὸν",3,82],["ἵνα",102,8],["τὸ",1,32],["δαιμόνιον",2013,33],["ἐκβάλῃ",585,160],["ἐκ",21,1],["τῆς",1,18],["θυγατρὸς",97,19],["αὐτῆς",3,83]],"Now the woman was a Greek, a Syrophoenician by race. She begged him that he would cast the demon out of her daughter."],["27",[["καὶ",2,8],["ἔλεγεν",31,14],["αὐτῇ",3,99],["ἄφες",501,198],["πρῶτον",315,29],["χορτασθῆναι",2397,175],["τὰ",1,42],["τέκνα",192,43],["οὐ",12,12],["γάρ",40,8],["ἐστιν",10,87],["καλὸν",266,28],["λαβεῖν",46,100],["τὸν",1,6],["ἄρτον",197,7],["τῶν",1,44],["τέκνων",192,45],["καὶ",2,8],["τοῖς",1,91],["κυναρίοις",10126,92],["βαλεῖν",766,100]],"But Jesus said to her, “Let the children be filled first, for it is not appropriate to take the children’s bread and throw it to the dogs.”"],["28",[["ἡ",1,11],["δὲ",14,8],["ἀπεκρίθη",234,737],["καὶ",2,8],["λέγει",31,87],["αὐτῷ",3,49],["κύριε",7,250],["καὶ",2,8],["τὰ",1,253],["κυνάρια",10126,63],["ὑποκάτω",599,1],["τῆς",1,18],["τραπέζης",650,19],["ἐσθίουσιν",147,191],["ἀπὸ",17,1],["τῶν",1,44],["ψιχίων",10127,45],["τῶν",1,44],["παιδίων",449,45]],"But she answered him, “Yes, Lord. Yet even the dogs under the table eat the children’s crumbs.”"],["29",[["Καὶ",2,8],["εἶπεν",9997,3],["αὐτῇ",3,99],["διὰ",56,1],["τοῦτον",16,259],["τὸν",1,6],["λόγον",48,7],["ὕπαγε",6654,239],["ἐξελήλυθεν",82,165],["ἐκ",21,1],["τῆς",1,18],["θυγατρός",97,19],["σου",5,146],["τὸ",1,27],["δαιμόνιον",2013,20]],"He said to her, “For this saying, go your way. The demon has gone out of your daughter.”"],["30",[["καὶ",2,8],["ἀπελθοῦσα",297,140],["εἰς",8,1],["τὸν",1,6],["οἶκον",34,7],["αὐτῆς",3,83],["εὗρεν",101,3],["τὸ",1,32],["παιδίον",449,33],["βεβλημένον",766,785],["ἐπὶ",9,1],["τὴν",1,9],["κλίνην",1221,10],["καὶ",2,8],["τὸ",1,32],["δαιμόνιον",2013,33],["ἐξεληλυθός",82,419]],"She went away to her house, and found the child having been laid on the bed, with the demon gone out."],["31",[["Καὶ",2,8],["πάλιν",655,17],["ἐξελθὼν",82,155],["ἐκ",21,1],["τῶν",1,44],["ὁρίων",236,45],["Τύρου",1199,19],["ἦλθεν",55,3],["διὰ",56,1],["Σιδῶνος",1762,19],["εἰς",8,1],["τὴν",1,9],["θάλασσαν",137,10],["τῆς",1,18],["Γαλιλαίας",1580,19],["ἀνὰ",415,1],["μέσον",113,29],["τῶν",1,44],["ὁρίων",236,45],["Δεκαπόλεως",10024,19]],"Again he departed from the borders of Tyre and Sidon, and came to the sea of Galilee through the middle of the region of Decapolis."],["32",[["καὶ",2,8],["φέρουσιν",199,191],["αὐτῷ",3,49],["κωφὸν",2362,59],["καὶ",2,8],["μογιλάλον",7699,59],["καὶ",2,8],["παρακαλοῦσιν",434,191],["αὐτὸν",3,82],["ἵνα",102,8],["ἐπιθῇ",239,160],["αὐτῷ",3,49],["τὴν",1,9],["χεῖρα",37,10]],"They brought to him one who was deaf and had an impediment in his speech. They begged him to lay his hand on him."],["33",[["καὶ",2,8],["ἀπολαβόμενος",3704,244],["αὐτὸν",3,82],["ἀπὸ",17,1],["τοῦ",1,30],["ὄχλου",1008,21],["κατ᾽",32,1],["ἰδίαν",683,37],["ἔβαλεν",766,3],["τοὺς",1,56],["δακτύλους",1182,31],["αὐτοῦ",3,48],["εἰς",8,1],["τὰ",1,42],["ὦτα",328,43],["αὐτοῦ",3,48],["καὶ",2,8],["πτύσας",6021,155],["ἥψατο",10060,737],["τῆς",1,18],["γλώσσης",388,19],["αὐτοῦ",3,48]],"He took him aside from the multitude privately and put his fingers into his ears; and he spat and touched his tongue."],["34",[["καὶ",2,8],["ἀναβλέψας",1425,155],["εἰς",8,1],["τὸν",1,6],["οὐρανὸν",94,7],["ἐστέναξεν",1445,3],["καὶ",2,8],["λέγει",31,87],["αὐτῷ",3,49],["εφφαθα",10247,242],["ὅ",24,677],["ἐστιν",10,87],["διανοίχθητι",1321,242]],"Looking up to heaven, he sighed, and said to him, “Ephphatha!” that is, “Be opened!”"],["35",[["καὶ",2,8],["ἠνοίγησαν",362,94],["αὐτοῦ",3,48],["αἱ",1,185],["ἀκοαί",1047,180],["καὶ",2,8],["ἐλύθη",1381,38],["ὁ",1,4],["δεσμὸς",1035,5],["τῆς",1,18],["γλώσσης",388,19],["αὐτοῦ",3,48],["καὶ",2,8],["ἐλάλει",50,14],["ὀρθῶς",2062,17]],"Immediately his ears were opened, and the impediment of his tongue was released, and he spoke clearly."],["36",[["καὶ",2,8],["διεστείλατο",905,26],["αὐτοῖς",3,142],["ἵνα",102,8],["μηδενὶ",908,111],["λέγωσιν",31,265],["ὅσον",103,467],["δὲ",14,8],["αὐτοῖς",3,142],["διεστέλλετο",905,425],["αὐτοὶ",3,195],["μᾶλλον",1043,17],["περισσότερον",10096,17],["ἐκήρυσσον",1438,129]],"He commanded them