[["1",[["Καὶ",2,8],["συνάγονται",166,507],["πρὸς",15,1],["αὐτὸν",3,82],["οἱ",1,128],["Φαρισαῖοι",10006,51],["καί",2,8],["τινες",39,402],["τῶν",1,76],["γραμματέων",632,77],["ἐλθόντες",55,190],["ἀπὸ",17,1],["Ἱεροσολύμων",70,45]],"Then the Pharisees and some of the scribes gathered together to him, having come from Jerusalem."],["2",[["καὶ",2,8],["ἰδόντες",53,190],["τινὰς",39,318],["τῶν",1,76],["μαθητῶν",10025,77],["αὐτοῦ",3,48],["ὅτι",19,8],["κοιναῖς",1515,287],["χερσίν",37,71],["τοῦτ᾽",16,344],["ἔστιν",10,87],["ἀνίπτοις",10124,287],["ἐσθίουσιν",147,191],["τοὺς",1,56],["ἄρτους",197,31]],"Now when they saw some of his disciples eating bread with defiled, that is unwashed, hands, they found fault."],["3",[["οἱ",1,128],["γὰρ",40,8],["Φαρισαῖοι",10006,51],["καὶ",2,8],["πάντες",11,130],["οἱ",1,128],["Ἰουδαῖοι",285,51],["ἐὰν",45,8],["μὴ",25,12],["πυγμῇ",6022,2],["νίψωνται",3310,222],["τὰς",1,39],["χεῖρας",37,40],["οὐκ",12,12],["ἐσθίουσιν",147,191],["κρατοῦντες",385,137],["τὴν",1,9],["παράδοσιν",4960,10],["τῶν",1,76],["πρεσβυτέρων",332,77]],"(For the Pharisees and all the Jews don’t eat unless they wash their hands and forearms, holding to the tradition of the elders."],["4",[["καὶ",2,8],["ἀπ᾽",17,1],["ἀγορᾶς",2648,19],["ἐὰν",45,8],["μὴ",25,12],["βαπτίσωνται",4169,222],["οὐκ",12,12],["ἐσθίουσιν",147,191],["καὶ",2,8],["ἄλλα",584,74],["πολλά",74,74],["ἐστιν",10,87],["ἃ",24,755],["παρέλαβον",1385,141],["κρατεῖν",385,54],["βαπτισμοὺς",10242,31],["ποτηρίων",1355,45],["καὶ",2,8],["ξεστῶν",10243,77],["καὶ",2,8],["χαλκίων",10244,45],["καὶ",2,8],["κλινῶν",1221,61]],"They don’t eat when they come from the marketplace unless they bathe themselves, and there are many other things which they have received to hold to: washings of cups, pitchers, bronze vessels, and couches.)"],["5",[["Καὶ",2,8],["ἐπερωτῶσιν",739,191],["αὐτὸν",3,82],["οἱ",1,128],["Φαρισαῖοι",10006,51],["καὶ",2,8],["οἱ",1,128],["γραμματεῖς",632,51],["διὰ",56,1],["τί",10010,119],["οὐ",12,12],["περιπατοῦσιν",1327,191],["οἱ",1,128],["μαθηταί",10025,51],["σου",5,146],["κατὰ",32,1],["τὴν",1,9],["παράδοσιν",4960,10],["τῶν",1,76],["πρεσβυτέρων",332,77],["ἀλλὰ",108,8],["κοιναῖς",1515,287],["χερσὶν",37,71],["ἐσθίουσιν",147,191],["τὸν",1,6],["ἄρτον",197,7]],"The Pharisees and the scribes asked him, “Why don’t your disciples walk according to the tradition of the elders, but eat their bread with unwashed hands?”"],["6",[["Ὁ",1,4],["δὲ",14,8],["εἶπεν",9997,3],["αὐτοῖς",3,142],["καλῶς",1273,17],["ἐπροφήτευσεν",484,3],["Ἠσαΐας",1317,5],["περὶ",72,1],["ὑμῶν",5,136],["τῶν",1,76],["ὑποκριτῶν",6647,77],["ὡς",36,12],["γέγραπται",186,722],["οὗτος",16,112],["ὁ",1,4],["λαὸς",35,5],["τοῖς",1,91],["χείλεσίν",361,92],["με",9994,161],["τιμᾷ",1020,87],["ἡ",1,11],["δὲ",14,8],["καρδία",64,13],["αὐτῶν",3,41],["πόρρω",10118,17],["ἀπέχει",1255,87],["ἀπ᾽",17,1],["ἐμοῦ",6,88]],"He answered them, “Well did Isaiah prophesy of you hypocrites, as it is written, ‘This people honors me with their lips, but their heart is far from me."],["7",[["μάτην",1774,17],["δὲ",14,8],["σέβονταί",2117,756],["με",9994,161],["διδάσκοντες",545,137],["διδασκαλίας",4202,40],["ἐντάλματα",4625,43],["ἀνθρώπων",43,77]],"They worship me in vain, teaching as doctrines the commandments of men.’"],["8",[["Ἀφέντες",501,190],["τὴν",1,9],["ἐντολὴν",259,10],["τοῦ",1,30],["θεοῦ",20,21],["κρατεῖτε",385,84],["τὴν",1,9],["παράδοσιν",4960,10],["τῶν",1,76],["ἀνθρώπων",43,77]],"“For you set aside the commandment of God, and hold tightly to the tradition of men—the washing of pitchers and cups, and you do many other such things.”"],["9",[["καὶ",2,8],["ἔλεγεν",31,14],["αὐτοῖς",3,142],["καλῶς",1273,17],["ἀθετεῖτε",834,84],["τὴν",1,9],["ἐντολὴν",259,10],["τοῦ",1,30],["θεοῦ",20,21],["ἵνα",102,8],["τὴν",1,9],["παράδοσιν",4960,10],["ὑμῶν",5,136]],"He said to them, “Full well do you reject the commandment of God, that you may keep your tradition."],["10",[["Μωϋσῆς",10061,5],["γὰρ",40,8],["εἶπεν",9997,3],["τίμα",1020,239],["τὸν",1,6],["πατέρα",44,7],["σου",5,146],["καὶ