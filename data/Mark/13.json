[["1",[["Καὶ",2,8],["ἐκπορευομένου",365,766],["αὐτοῦ",3,48],["ἐκ",21,1],["τοῦ",1,23],["ἱεροῦ",675,24],["λέγει",31,87],["αὐτῷ",3,49],["εἷς",58,16],["τῶν",1,76],["μαθητῶν",10025,77],["αὐτοῦ",3,48],["διδάσκαλε",7031,250],["ἴδε",713,316],["ποταποὶ",10066,402],["λίθοι",195,51],["καὶ",2,8],["ποταπαὶ",10066,496],["οἰκοδομαί",2371,180]],"As he went out of the temple, one of his disciples said to him, “Teacher, see what kind of stones and what kind of buildings!”"],["2",[["Καὶ",2,8],["ὁ",1,4],["Ἰησοῦς",211,5],["εἶπεν",31,3],["αὐτῷ",3,49],["βλέπεις",470,145],["ταύτας",16,280],["τὰς",1,39],["μεγάλας",66,109],["οἰκοδομάς",2371,40],["οὐ",12,12],["μὴ",25,12],["ἀφεθῇ",501,333],["ὧδε",640,17],["λίθος",195,5],["ἐπὶ",9,1],["λίθον",195,7],["ὃς",24,246],["οὐ",12,12],["μὴ",25,12],["καταλυθῇ",861,333]],"Jesus said to him, “Do you see these great buildings? There will not be left here one stone on another, which will not be thrown down.”"],["3",[["Καὶ",2,8],["καθημένου",419,766],["αὐτοῦ",3,48],["εἰς",8,1],["τὸ",1,32],["ὄρος",87,33],["τῶν",1,123],["ἐλαιῶν",2055,61],["κατέναντι",691,1],["τοῦ",1,23],["ἱεροῦ",675,24],["ἐπηρώτα",739,14],["αὐτὸν",3,82],["κατ᾽",32,1],["ἰδίαν",683,37],["Πέτρος",5457,5],["καὶ",2,8],["Ἰάκωβος",10019,5],["καὶ",2,8],["Ἰωάννης",2148,5],["καὶ",2,8],["Ἀνδρέας",10018,5]],"As he sat on the Mount of Olives opposite the temple, Peter, James, John, and Andrew asked him privately,"],["4",[["εἰπὸν",31,198],["ἡμῖν",9994,86],["πότε",10140,12],["ταῦτα",16,335],["ἔσται",10,718],["καὶ",2,8],["τί",10010,119],["τὸ",1,27],["σημεῖον",505,20],["ὅταν",319,8],["μέλλῃ",1143,173],["ταῦτα",16,335],["συντελεῖσθαι",317,634],["πάντα",11,74]],"“Tell us, when will these things be? What is the sign that these things are all about to be fulfilled?”"],["5",[["Ὁ",1,4],["δὲ",14,8],["Ἰησοῦς",211,5],["ἤρξατο",320,737],["λέγειν",31,54],["αὐτοῖς",3,142],["βλέπετε",470,307],["μή",25,12],["τις",39,150],["ὑμᾶς",5,209],["πλανήσῃ",464,160]],"Jesus, answering, began to tell them, “Be careful that no one leads y