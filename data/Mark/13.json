"δὲ",14,8],["λόγοι",48,51],["μου",9994,146],["οὐ",12,12],["μὴ",25,12],["παρελεύσονται",404,740]],"Heaven and earth will pass away, but my words will not pass away."],["32",[["Περὶ",72,1],["δὲ",14,8],["τῆς",1,18],["ἡμέρας",28,19],["ἐκείνης",80,290],["ἢ",61,8],["τῆς",1,18],["ὥρας",838,19],["οὐδεὶς",228,16],["οἶδεν",1168,165],["οὐδὲ",106,8],["οἱ",1,128],["ἄγγελοι",208,51],["ἐν",4,1],["οὐρανῷ",94,113],["οὐδὲ",106,8],["ὁ",1,4],["υἱὸς",13,5],["εἰ",77,8],["μὴ",25,12],["ὁ",1,4],["πατήρ",44,5]],"“But of that day or that hour no one knows—not even the angels in heaven, nor the Son, but only the Father."],["33",[["Βλέπετε",470,307],["ἀγρυπνεῖτε",2802,307],["οὐκ",12,12],["οἴδατε",1168,330],["γὰρ",40,8],["πότε",10140,12],["ὁ",1,4],["καιρός",132,5],["ἐστιν",10,87]],"Watch, keep alert, and pray; for you don’t know when the time is."],["34",[["ὡς",36,12],["ἄνθρωπος",43,5],["ἀπόδημος",10267,16],["ἀφεὶς",501,155],["τὴν",1,9],["οἰκίαν",233,10],["αὐτοῦ",3,48],["καὶ",2,8],["δοὺς",33,155],["τοῖς",1,138],["δούλοις",136,139],["αὐτοῦ",3,48],["τὴν",1,9],["ἐξουσίαν",929,10],["ἑκάστῳ",171,111],["τὸ",1,32],["ἔργον",105,33],["αὐτοῦ",3,48],["καὶ",2,8],["τῷ",1,110],["θυρωρῷ",2721,113],["ἐνετείλατο",143,737],["ἵνα",102,8],["γρηγορῇ",3041,173]],"“It is like a man traveling to another country, having left his house and given authority to his servants, and to each one his work, and also commanded the doorkeeper to keep watch."],["35",[["γρηγορεῖτε",3041,307],["οὖν",227,8],["οὐκ",12,12],["οἴδατε",1168,330],["γὰρ",40,8],["πότε",10140,12],["ὁ",1,4],["κύριος",7,5],["τῆς",1,18],["οἰκίας",233,19],["ἔρχεται",55,728],["ἢ",61,8],["ὀψὲ",4643,17],["ἢ",61,8],["μεσονύκτιον",5822,33],["ἢ",61,8],["ἀλεκτοροφωνίας",10268,19],["ἢ",61,8],["πρωΐ",504,17]],"Watch therefore, for you don’t know when the lord of the house is coming—whether at evening, or at midnight, or when the rooster crows, or in the morning;"],["36",[["μὴ",25,12],["ἐλθὼν",55,155],["ἐξαίφνης",2831,17],["εὕρῃ",101,160],["ὑμᾶς",5,209],["καθεύδοντας",1724,22