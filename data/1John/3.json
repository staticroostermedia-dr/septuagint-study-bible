[["1",[["ἴδετε",53,69],["ποταπὴν",10066,583],["ἀγάπην",1982,10],["δέδωκεν",33,165],["ἡμῖν",9994,86],["ὁ",1,4],["πατήρ",44,5],["ἵνα",102,8],["τέκνα",192,63],["θεοῦ",20,21],["κληθῶμεν",128,282],["καὶ",2,8],["ἐσμέν",10,241],["διὰ",56,1],["τοῦτο",16,122],["ὁ",1,4],["κόσμος",743,5],["οὐ",12,12],["γινώσκει",79,87],["ἡμᾶς",9994,209],["ὅτι",19,8],["οὐκ",12,12],["ἔγνω",79,3],["αὐτόν",3,82]],"See how great a love the Father has given to us, that we should be called children of God! For this cause the world doesn’t know us, because it didn’t know him."],["2",[["Ἀγαπητοί",1920,537],["νῦν",90,17],["τέκνα",192,63],["θεοῦ",20,21],["ἐσμεν",10,241],["καὶ",2,8],["οὔπω",3100,17],["ἐφανερώθη",8582,38],["τί",10010,238],["ἐσόμεθα",10,874],["οἴδαμεν",10044,311],["ὅτι",19,8],["ἐὰν",45,8],["φανερωθῇ",8582,333],["ὅμοιοι",657,130],["αὐτῷ",3,49],["ἐσόμεθα",10,874],["ὅτι",19,8],["ὀψόμεθα",10028,874],["αὐτὸν",3,82],["καθώς",221,8],["ἐστιν",10,87]],"Beloved, now we are children of God. It is not yet revealed what we will be; but we know that when he is revealed, we will be like him, for we will see him just as he is."],["3",[["καὶ",2,8],["πᾶς",11,16],["ὁ",1,4],["ἔχων",124,67],["τὴν",1,9],["ἐλπίδα",530,10],["ταύτην",16,234],["ἐπ᾽",9,1],["αὐτῷ",3,49],["ἁγνίζει",1337,87],["ἑαυτὸν",92,82],["καθὼς",221,8],["ἐκεῖνος",80,112],["ἁγνός",2814,16],["ἐστιν",10,87]],"Everyone who has this hope set on him purifies himself, even as he is pure."],["4",[["Πᾶς",11,16],["ὁ",1,4],["ποιῶν",23,67],["τὴν",1,9],["ἁμαρτίαν",119,10],["καὶ",2,8],["τὴν",1,9],["ἀνομίαν",275,10],["ποιεῖ",23,87],["καὶ",2,8],["ἡ",1,11],["ἁμαρτία",119,13],["ἐστὶν",10,87],["ἡ",1,11],["ἀνομία",275,13]],"Everyone who sins also commits lawlessness. Sin is lawlessness."],["5",[["καὶ",2,8],["οἴδατε",10044,330],["ὅτι",19,8],["ἐκεῖνος",80,112],["ἐφανερώθη",8582,38],["ἵνα",102,8],["τὰς",1,39],["ἁμαρτίας",119,40],["ἄρῃ",206,160],["καὶ",2,8],["ἁμαρτία",119,13],["ἐν",4,1],["αὐτῷ",3,49],["οὐκ",12,12],["ἔστιν",10,87]],"You know that he was revealed to take away our sins, and no sin is in him."],["6",[["πᾶς",11,16],["ὁ",1,4],["ἐν",4,1],["αὐτῷ",3,49],["μένων",681,67],["οὐχ",12,12],["ἁμαρτάνει",237,87],["πᾶς",11,16],["ὁ",1,4],["ἁμαρτάνων",237,67],["οὐχ",12,12],["ἑώρακεν",112,165],["αὐτὸν",3,82],["οὐδὲ",106,8],["ἔγνωκεν",79,165],["αὐτόν",3,82]],"Whoever remains in him doesn’t sin. Whoever sins hasn’t seen him and doesn’t know him."],["7",[["μηδεὶς",908,16],["πλανάτω",464,35],["ὑμᾶς",5,209],["ὁ",1,4],["ποιῶν",23,67],["τὴν",1,9],["δικαιοσύνην",187,10],["δίκαιός",153,16],["ἐστιν",10,87],["καθὼς",221,8],["ἐκεῖνος",80,112],["δίκαιός",153,16],["ἐστιν",10,87]],"Little children, let no one lead you astray. He who does righteousness is righteous, even as he is righteous."],["8",[["ὁ",1,4],["ποιῶν",23,67],["τὴν",1,9],["ἁμαρτίαν",119,10],["ἐκ",21,1],["τοῦ",1,30],["διαβόλου",1720,153],["ἐστίν",10,87],["ὅτι",19,8],["ἀπ᾽",17,1],["ἀρχῆς",270,19],["ὁ",1,4],["διάβολος",1720,16],["ἁμαρτάνει",237,87],["εἰς",8,1],["τοῦτο",16,122],["ἐφανερώθη",8582,38],["ὁ",1,4],["υἱὸς",13,5],["τοῦ",1,30],["θεοῦ",20,21],["ἵνα",102,8],["λύσῃ",1381,160],["τὰ",1,42],["ἔργα",105,43],["τοῦ",1,30],["διαβόλου",1720,153]],"He who sins is of the devil, for the devil has been sinning from the beginning. To this end the Son of God was revealed: that he might destroy the works of the devil."],["9",[["πᾶς",11,16],["ὁ",1,4],["γεγεννημένος",222,228],["ἐκ",21,1],["τοῦ",1,30],["θεοῦ",20,21],["ἁμαρτίαν",119,10],["οὐ",12,12],["ποιεῖ",23,87],["ὅτι",19,8],["σπέρμα",218,20],["αὐτοῦ",3,48],["ἐν",4,1],["αὐτῷ",3,49],["μένει",681,87],["καὶ",2,8],["οὐ",12,12],["δύναται",185,728],["ἁμαρτάνειν",237,54],["ὅτι",19,8],["ἐκ",21,1],["τοῦ",1,30],["θεοῦ",20,21],["γεγέννηται",222,722]],"Whoever is born of God doesn’t commit sin, because his seed remains in him, and he can’t sin, because he is born of God."],["10",[["ἐν",4,1],["τούτῳ",16,279],["φανερά",1977,74],["ἐστιν",10,87],["τὰ",1,253],["τέκνα",192,63],["τοῦ",1,30],["θεοῦ",20,21],["καὶ",2,8],["τὰ",1,253],["τέκνα",192,63],["τοῦ",1,30],["διαβόλου",1720,153],["πᾶς",11,16],["ὁ",1,4],["μὴ",25,12],["ποιῶν",23,67],["δικαιοσύνην",187,10],["οὐκ",12,12],["ἔστιν",10,87],["ἐκ",21,1],["τοῦ",1,30],["θεοῦ",20,21],["καὶ",2,8],["ὁ",1,4],["μὴ",25,12],["ἀγαπῶν",214,67],["τὸν",1,6],["ἀδελφὸν",67,7],["αὐτοῦ",3,48]],"In this the children of God are revealed, and the children of the devil. Whoever doesn’t do righteousness is not of God, neither is he who doesn’t love his brother."],["11",[["ὅτι",19,8],["αὕτη",16,101],["ἐστὶν",10,87],["ἡ",1,11],["ἀγγελία",2301,13],["ἣν",24,124],["ἠκούσατε",54,262],["ἀπ᾽",17,1],["ἀρχῆς",270,19],["ἵνα",102,1],["ἀγαπῶμεν",214,223],["ἀλλήλους",1192,60]],"For this is the message which you heard from the beginning, that we should love one another—"],["12",[["οὐ",12,12],["καθὼς",221,8],["Κάϊν",2006,5],["ἐκ",21,1],["τοῦ",1,30],["πονηροῦ",164,153],["ἦν",10,14],["καὶ",2,8],["ἔσφαξεν",635,3],["τὸν",1,6],["ἀδελφὸν",67,7],["αὐτοῦ",3,48],["καὶ",2,8],["χάριν",10355,1],["τίνος",10010,860],["ἔσφαξεν",635,3],["αὐτόν",3,82],["ὅτι",19,8],["τὰ",1,253],["ἔργα",105,63],["αὐτοῦ",3,48],["πονηρὰ",164,74],["ἦν",10,14],["τὰ",1,253],["δὲ",14,8],["τοῦ",1,30],["ἀδελφοῦ",67,21],["αὐτοῦ",3,48],["δίκαια",153,74]],"unlike Cain, who was of the evil one and killed his brother. Why did he kill him? Because his deeds were evil, and his brother’s righteous."],["13",[["Καὶ",2,8],["μὴ",25,12],["θαυμάζετε",963,307],["ἀδελφοί",67,396],["εἰ",77,8],["μισεῖ",351,87],["ὑμᾶς",5,209],["ὁ",1,4],["κόσμος",743,5]],"Don’t be surprised, my brothers, if the world hates you."],["14",[["ἡμεῖς",9994,208],["οἴδαμεν",10044,311],["ὅτι",19,8],["μεταβεβήκαμεν",3892,311],["ἐκ",21,1],["τοῦ",1,30],["θανάτου",170,21],["εἰς",8,1],["τὴν",1,9],["ζωήν",216,10],["ὅτι",19,8],["ἀγαπῶμεν",214,241],["τοὺς",1,56],["ἀδελφούς",67,31],["ὁ",1,4],["μὴ",25,12],["ἀγαπῶν",214,67],["μένει",681,87],["ἐν",4,1],["τῷ",1,110],["θανάτῳ",170,113]],"We know that we have passed out of death into life, because we love the brothers. He who doesn’t love his brother remains in death."],["15",[["πᾶς",11,16],["ὁ",1,4],["μισῶν",351,67],["τὸν",1,6],["ἀδελφὸν",67,7],["αὐτοῦ",3,48],["ἀνθρωποκτόνος",10466,5],["ἐστίν",10,87],["καὶ",2,8],["οἴδατε",10044,330],["ὅτι",19,8],["πᾶς",11,16],["ἀνθρωποκτόνος",10466,5],["οὐκ",12,12],["ἔχει",124,87],["ζωὴν",216,10],["αἰώνιον",391,37],["ἐν",4,1],["αὐτῷ",3,49],["μένουσαν",681,73]],"Whoever hates his brother is a murderer, and you know that no murderer has eternal life remaining in him."],["16",[["ἐν",4,1],["τούτῳ",16,279],["ἐγνώκαμεν",79,311],["τὴν",1,9],["ἀγάπην",1982,10],["ὅτι",19,8],["ἐκεῖνος",80,112],["ὑπὲρ",139,1],["ἡμῶν",9994,136],["τὴν",1,9],["ψυχὴν",63,10],["αὐτοῦ",3,48],["ἔθηκεν",110,3],["καὶ",2,8],["ἡμεῖς",9994,208],["ὀφείλομεν",2150,241],["ὑπὲρ",139,1],["τῶν",1,76],["ἀδελφῶν",67,77],["τὰς",1,39],["ψυχὰς",63,40],["θεῖναι",110,100]],"By this we know love, because he laid down his life for us. And we ought to lay down our lives for the brothers."],["17",[["Ὃς",24,246],["δ᾽",14,8],["ἂν",83,12],["ἔχῃ",124,173],["τὸν",1,6],["βίον",726,7],["τοῦ",1,30],["κόσμου",743,21],["καὶ",2,8],["θεωρῇ",897,173],["τὸν",1,6],["ἀδελφὸν",67,7],["αὐτοῦ",3,48],["χρείαν",1006,10],["ἔχοντα",124,178],["καὶ",2,8],["κλείσῃ",1514,160],["τὰ",1,42],["σπλάγχνα",2190,43],["αὐτοῦ",3,48],["ἀπ᾽",17,1],["αὐτοῦ",3,48],["πῶς",10049,12],["ἡ",1,11],["ἀγάπη",1982,13],["τοῦ",1,30],["θεοῦ",20,21],["μένει",681,87],["ἐν",4,1],["αὐτῷ",3,49]],"But whoever has the world’s goods and sees his brother in need, then closes his heart of compassion against him, how does God’s love remain in him?"],["18",[["Τεκνία",10478,532],["μὴ",25,12],["ἀγαπῶμεν",214,223],["λόγῳ",48,113],["μηδὲ",414,8],["τῇ",1,95],["γλώσσῃ",388,2],["ἀλλ᾽",108,8],["ἐν",4,1],["ἔργῳ",105,53],["καὶ",2,8],["ἀληθείᾳ",352,2]],"My little children, let’s not love in word only, or with the tongue only, but in deed and truth."],["19",[["καὶ",2,8],["ἐν",4,1],["τούτῳ",16,279],["γνωσόμεθα",79,874],["ὅτι",19,8],["ἐκ",21,1],["τῆς",1,18],["ἀληθείας",352,19],["ἐσμὲν",10,241],["καὶ",2,8],["ἔμπροσθεν",390,1],["αὐτοῦ",3,48],["πείσομεν",344,269],["τὴν",1,9],["καρδίαν",64,10],["ἡμῶν",9994,136]],"And by this we know that we are of the truth and persuade our hearts before him,"],["20",[["ὅτι",19,8],["ἐὰν",45,8],["καταγινώσκῃ",4252,173],["ἡμῶν",9994,136],["ἡ",1,11],["καρδία",64,13],["ὅτι",19,8],["μείζων",66,16],["ἐστὶν",10,87],["ὁ",1,4],["θεὸς",20,5],["τῆς",1,18],["καρδίας",64,19],["ἡμῶν",9994,136],["καὶ",2,8],["γινώσκει",79,87],["πάντα",11,65]],"because if our heart condemns us, God is greater than our heart, and knows all things."],["21",[["Ἀγαπητοί",1920,537],["ἐὰν",45,8],["ἡ",1,11],["καρδία",64,13],["ἡμῶν",9994,136],["μὴ",25,12],["καταγινώσκῃ",4252,173],["παρρησίαν",2610,10],["ἔχομεν",124,241],["πρὸς",15,1],["τὸν",1,6],["θεόν",20,7]],"Beloved, if our hearts don’t condemn us, we have boldness toward God;"],["22",[["καὶ",2,8],["ὃ",24,467],["ἐὰν",45,8],["αἰτῶμεν",617,223],["λαμβάνομεν",46,241],["ἀπ᾽",17,1],["αὐτοῦ",3,48],["ὅτι",19,8],["τὰς",1,39],["ἐντολὰς",259,40],["αὐτοῦ",3,48],["τηροῦμεν",1358,241],["καὶ",2,8],["τὰ",1,42],["ἀρεστὰ",1397,65],["ἐνώπιον",115,1],["αὐτοῦ",3,48],["ποιοῦμεν",23,241]],"so whatever we ask, we receive from him, because we keep his commandments and do the things that are pleasing in his sight."],["23",[["καὶ",2,8],["αὕτη",16,101],["ἐστὶν",10,87],["ἡ",1,11],["ἐντολὴ",259,13],["αὐτοῦ",3,48],["ἵνα",102,1],["πιστεύσωμεν",649,75],["τῷ",1,52],["ὀνόματι",57,53],["τοῦ",1,30],["υἱοῦ",13,21],["αὐτοῦ",3,48],["Ἰησοῦ",211,21],["Χριστοῦ",1072,21],["καὶ",2,8],["ἀγαπῶμεν",214,223],["ἀλλήλους",1192,60],["καθὼς",221,8],["ἔδωκεν",33,3],["ἐντολὴν",259,10],["ἡμῖν",9994,86]],"This is his commandment, that we should believe in the name of his Son, Jesus Christ, and love one another, even as he commanded."],["24",[["καὶ",2,8],["ὁ",1,4],["τηρῶν",1358,67],["τὰς",1,39],["ἐντολὰς",259,40],["αὐτοῦ",3,48],["ἐν",4,1],["αὐτῷ",3,49],["μένει",681,87],["καὶ",2,8],["αὐτὸς",3,158],["ἐν",4,1],["αὐτῷ",3,49],["καὶ",2,8],["ἐν",4,1],["τούτῳ",16,279],["γινώσκομεν",79,241],["ὅτι",19,8],["μένει",681,87],["ἐν",4,1],["ἡμῖν",9994,86],["ἐκ",21,1],["τοῦ",1,23],["πνεύματος",168,24],["οὗ",24,563],["ἡμῖν",9994,86],["ἔδωκεν",33,3]],"He who keeps his commandments remains in him, and he in him. By this we know that he remains in us, by the Spirit which he gave us."]]