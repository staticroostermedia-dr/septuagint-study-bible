[["1",[["Πᾶς",11,16],["ὁ",1,4],["πιστεύων",649,67],["ὅτι",19,8],["Ἰησοῦς",211,5],["ἐστιν",10,87],["ὁ",1,4],["Χριστὸς",1072,5],["ἐκ",21,1],["τοῦ",1,30],["θεοῦ",20,21],["γεγέννηται",222,722],["καὶ",2,8],["πᾶς",11,16],["ὁ",1,4],["ἀγαπῶν",214,67],["τὸν",1,6],["γεννήσαντα",222,476],["ἀγαπᾷ",214,87],["καὶ",2,8],["τὸν",1,6],["γεγεννημένον",222,763],["ἐξ",21,1],["αὐτοῦ",3,48]],"Whoever believes that Jesus is the Christ has been born of God. Whoever loves the Father also loves the child who is born of him."],["2",[["ἐν",4,1],["τούτῳ",16,279],["γινώσκομεν",79,241],["ὅτι",19,8],["ἀγαπῶμεν",214,241],["τὰ",1,42],["τέκνα",192,43],["τοῦ",1,30],["θεοῦ",20,21],["ὅταν",319,8],["τὸν",1,6],["θεὸν",20,7],["ἀγαπῶμεν",214,223],["καὶ",2,8],["τὰς",1,39],["ἐντολὰς",259,40],["αὐτοῦ",3,48],["ποιῶμεν",23,223]],"By this we know that we love the children of God, when we love God and keep his commandments."],["3",[["αὕτη",16,101],["γάρ",40,8],["ἐστιν",10,87],["ἡ",1,11],["ἀγάπη",1982,13],["τοῦ",1,30],["θεοῦ",20,21],["ἵνα",102,1],["τὰς",1,39],["ἐντολὰς",259,40],["αὐτοῦ",3,48],["τηρῶμεν",1358,223],["καὶ",2,8],["αἱ",1,185],["ἐντολαὶ",259,180],["αὐτοῦ",3,48],["βαρεῖαι",1031,187],["οὐκ",12,12],["εἰσίν",10,191]],"For this is loving God, that we keep his commandments. His commandments are not grievous."],["4",[["ὅτι",19,8],["πᾶν",11,28],["τὸ",1,27],["γεγεννημένον",222,773],["ἐκ",21,1],["τοῦ",1,30],["θεοῦ",20,21],["νικᾷ",1441,87],["τὸν",1,6],["κόσμον",743,7],["καὶ",2,8],["αὕτη",16,101],["ἐστὶν",10,87],["ἡ",1,11],["νίκη",4329,13],["ἡ",1,11],["νικήσασα",1441,140],["τὸν",1,6],["κόσμον",743,7],["ἡ",1,11],["πίστις",887,13],["ἡμῶν",9994,136]],"For whatever is born of God overcomes the world. This is the victory that has overcome the world: your faith."],["5",[["τίς",10010,150],["δέ",14,8],["ἐστιν",10,87],["ὁ",1,4],["νικῶν",1441,67],["τὸν",1,6],["κόσμον",743,7],["εἰ",77,8],["μὴ",25,12],["ὁ",1,4],["πιστεύων",649,67],["ὅτι",19,8],["Ἰησοῦς",211,5],["ἐστιν",10,87],["ὁ",1,4],["υἱὸς",13,5],["τοῦ",1,30],["θεοῦ",20,21]],"Who is he who overcomes the world, but he who believes that Jesus is the Son of God?"],["6",[["οὗτός",16,112],["ἐστιν",10,87],["ὁ",1,4],["ἐλθὼν",55,155],["δι᾽",56,1],["ὕδατος",85,24],["καὶ",2,8],["αἵματος",148,24],["Ἰησοῦς",211,5],["Χριστός",1072,5],["οὐκ",12,12],["ἐν",4,1],["τῷ",1,52],["ὕδατι",85,53],["μόνον",302,29],["ἀλλ᾽",108,8],["ἐν",4,1],["τῷ",1,52],["ὕδατι",85,53],["καὶ",2,8],["ἐν",4,1],["τῷ",1,52],["αἵματι",148,53],["καὶ",2,8],["τὸ",1,27],["πνεῦμά",168,20],["ἐστιν",10,87],["τὸ",1,27],["μαρτυροῦν",2094,36],["ὅτι",19,8],["τὸ",1,27],["πνεῦμά",168,20],["ἐστιν",10,87],["ἡ",1,11],["ἀλήθεια",352,13]],"This is he who came by water and blood, Jesus Christ; not with the water only, but with the water and the blood. It is the Spirit who testifies, because the Spirit is the truth."],["7",[["ὅτι",19,8],["τρεῖς",174,130],["εἰσιν",10,191],["οἱ",1,128],["μαρτυροῦντες",2094,137]],"For there are three who testify:"],["8",[["τὸ",1,27],["πνεῦμα",168,20],["καὶ",2,8],["τὸ",1,27],["ὕδωρ",85,20],["καὶ",2,8],["τὸ",1,27],["αἷμα",148,20],["καὶ",2,8],["οἱ",1,128],["τρεῖς",174,130],["εἰς",8,1],["τὸ",1,32],["ἕν",58,29],["εἰσιν",10,191]],"the Spirit, the water, and the blood; and the three agree as one."],["9",[["εἰ",77,8],["τὴν",1,9],["μαρτυρίαν",2737,10],["τῶν",1,76],["ἀνθρώπων",43,77],["λαμβάνομεν",46,241],["ἡ",1,11],["μαρτυρία",2737,13],["τοῦ",1,30],["θεοῦ",20,21],["μείζων",66,15],["ἐστίν",10,87],["ὅτι",19,8],["αὕτη",16,101],["ἐστὶν",10,87],["ἡ",1,11],["μαρτυρία",2737,13],["τοῦ",1,30],["θεοῦ",20,21],["ὅτι",19,8],["μεμαρτύρηκεν",2094,165],["περὶ",72,1],["τοῦ",1,30],["υἱοῦ",13,21],["αὐτοῦ",3,48]],"If we receive the witness of men, the witness of God is greater; for this is God’s testimony which he has testified concerning his Son."],["10",[["ὁ",1,4],["πιστεύων",649,67],["εἰς",8,1],["τὸν",1,6],["υἱὸν",13,7],["τοῦ",1,30],["θεοῦ",20,21],["ἔχει",124,87],["τὴν",1,9],["μαρτυρίαν",2737,10],["ἐν",4,1],["ὁ",1,4],["μὴ",25,12],["πιστεύων",649,67],["τῷ",1,110],["θεῷ",20,113],["ψεύστην",5152,7],["πεποίηκεν",23,165],["αὐτόν",3,82],["ὅτι",19,8],["οὐ",12,12],["πεπίστευκεν",649,165],["εἰς",8,1],["τὴν",1,9],["μαρτυρίαν",2737,10],["ἣν",24,124],["μεμαρτύρηκεν",2094,165],["ὁ",1,4],["θεὸς",20,5],["περὶ",72,1],["τοῦ",1,30],["υἱοῦ",13,21],["αὐτοῦ",3,48]],"He who believes in the Son of God has the testimony in himself. He who doesn’t believe God has made him a liar, because he has not believed in the testimony that God has given concerning his Son."],["11",[["καὶ",2,8],["αὕτη",16,101],["ἐστὶν",10,87],["ἡ",1,11],["μαρτυρία",2737,13],["ὅτι",19,8],["ζωὴν",216,10],["αἰώνιον",391,37],["ἔδωκεν",33,3],["ἡμῖν",9994,86],["ὁ",1,4],["θεός",20,5],["καὶ",2,8],["αὕτη",16,101],["ἡ",1,11],["ζωὴ",216,13],["ἐν",4,1],["τῷ",1,110],["υἱῷ",13,113],["αὐτοῦ",3,48],["ἐστιν",10,87]],"The testimony is this: that God gave to us eternal life, and this life is in his Son."],["12",[["ὁ",1,4],["ἔχων",124,67],["τὸν",1,6],["υἱὸν",13,7],["ἔχει",124,87],["τὴν",1,9],["ζωήν",216,10],["ὁ",1,4],["μὴ",25,12],["ἔχων",124,67],["τὸν",1,6],["υἱὸν",13,7],["τοῦ",1,30],["θεοῦ",20,21],["τὴν",1,9],["ζωὴν",216,10],["οὐκ",12,12],["ἔχει",124,87]],"He who has the Son has the life. He who doesn’t have God’s Son doesn’t have the life."],["13",[["Ταῦτα",16,248],["ἔγραψα",186,147],["ὑμῖν",5,86],["ἵνα",102,8],["εἰδῆτε",1168,622],["ὅτι",19,8],["ζωὴν",216,10],["ἔχετε",124,84],["αἰώνιον",391,37],["τοῖς",1,138],["πιστεύουσιν",649,352],["εἰς",8,1],["τὸ",1,32],["ὄνομα",57,33],["τοῦ",1,30],["υἱοῦ",13,21],["τοῦ",1,30],["θεοῦ",20,21]],"These things I have written to you who believe in the name of the Son of God, that you may know that you have eternal life, and that you may continue to believe in the name of the Son of God."],["14",[["καὶ",2,8],["αὕτη",16,101],["ἐστὶν",10,87],["ἡ",1,11],["παρρησία",2610,13],["ἣν",24,124],["ἔχομεν",124,241],["πρὸς",15,1],["αὐτόν",3,82],["ὅτι",19,8],["ἐάν",45,8],["τι",39,119],["αἰτώμεθα",617,712],["κατὰ",32,1],["τὸ",1,32],["θέλημα",1039,33],["αὐτοῦ",3,48],["ἀκούει",54,87],["ἡμῶν",9994,136]],"This is the boldness which we have toward him, that if we ask anything according to his will, he listens to us."],["15",[["καὶ",2,8],["ἐὰν",45,8],["οἴδαμεν",10044,241],["ὅτι",19,8],["ἀκούει",54,87],["ἡμῶν",9994,136],["ὃ",24,467],["ἐὰν",45,8],["αἰτώμεθα",617,712],["οἴδαμεν",10044,241],["ὅτι",19,8],["ἔχομεν",124,241],["τὰ",1,42],["αἰτήματα",2247,43],["ἃ",24,755],["ᾐτήκαμεν",617,311],["ἀπ᾽",17,1],["αὐτοῦ",3,48]],"And if we know that he listens to us, whatever we ask, we know that we have the petitions which we have asked of him."],["16",[["Ἐάν",45,8],["τις",39,150],["ἴδῃ",112,160],["τὸν",1,6],["ἀδελφὸν",67,7],["αὐτοῦ",3,48],["ἁμαρτάνοντα",237,178],["ἁμαρτίαν",119,10],["μὴ",25,12],["πρὸς",15,1],["θάνατον",170,7],["αἰτήσει",617,120],["καὶ",2,8],["δώσει",33,120],["αὐτῷ",3,49],["ζωήν",216,10],["τοῖς",1,138],["ἁμαρτάνουσιν",237,352],["μὴ",25,12],["πρὸς",15,1],["θάνατον",170,7],["Ἔστιν",10,87],["ἁμαρτία",119,13],["πρὸς",15,1],["θάνατον",170,7],["οὐ",12,12],["περὶ",72,1],["ἐκείνης",80,290],["λέγω",31,149],["ἵνα",102,8],["ἐρωτήσῃ",822,160]],"If anyone sees his brother sinning a sin not leading to death, he shall ask, and God will give him life for those who sin not leading to death. There is sin leading to death. I don’t say that he should make a request concerning this."],["17",[["πᾶσα",11,15],["ἀδικία",288,13],["ἁμαρτία",119,13],["ἐστίν",10,87],["καὶ",2,8],["ἔστιν",10,87],["ἁμαρτία",119,13],["οὐ",12,12],["πρὸς",15,1],["θάνατον",170,7]],"All unrighteousness is sin, and there is sin not leading to death."],["18",[["οἴδαμεν",1168,311],["ὅτι",19,8],["πᾶς",11,16],["ὁ",1,4],["γεγεννημένος",222,228],["ἐκ",21,1],["τοῦ",1,30],["θεοῦ",20,21],["οὐχ",12,12],["ἁμαρτάνει",237,87],["ἀλλ᾽",108,8],["ὁ",1,4],["γεννηθεὶς",222,206],["ἐκ",21,1],["τοῦ",1,30],["θεοῦ",20,21],["τηρεῖ",1358,87],["ἑαυτόν",92,82],["καὶ",2,8],["ὁ",1,4],["πονηρὸς",164,16],["οὐχ",12,12],["ἅπτεται",10060,506],["αὐτοῦ",3,48]],"We know that whoever is born of God doesn’t sin, but he who was born of God keeps himself, and the evil one doesn’t touch him."],["19",[["οἴδαμεν",1168,311],["ὅτι",19,8],["ἐκ",21,1],["τοῦ",1,30],["θεοῦ",20,21],["ἐσμεν",10,241],["καὶ",2,8],["ὁ",1,4],["κόσμος",743,5],["ὅλος",235,16],["ἐν",4,1],["τῷ",1,110],["πονηρῷ",164,111],["κεῖται",1731,728]],"We know that we are of God, and the whole world lies in the power of the evil one."],["20",[["οἴδαμεν",1168,311],["δὲ",14,8],["ὅτι",19,8],["ὁ",1,4],["υἱὸς",13,5],["τοῦ",1,30],["θεοῦ",20,21],["ἥκει",260,87],["καὶ",2,8],["δέδωκεν",33,165],["ἡμῖν",9994,86],["διάνοιαν",755,10],["ἵνα",102,8],["γινώσκωμεν",79,223],["τὸν",1,6],["ἀληθινόν",1023,59],["καὶ",2,8],["ἐσμὲν",10,241],["ἐν",4,1],["τῷ",1,110],["ἀληθινῷ",1023,111],["ἐν",4,1],["τῷ",1,110],["υἱῷ",13,113],["αὐτοῦ",3,48],["Ἰησοῦ",211,113],["Χριστῷ",1072,113],["οὗτός",16,112],["ἐστιν",10,87],["ὁ",1,4],["ἀληθινὸς",1023,16],["θεὸς",20,5],["καὶ",2,8],["ζωὴ",216,13],["αἰώνιος",391,15]],"We know that the Son of God has come and has given us an understanding, that we know him who is true; and we are in him who is true, in his Son Jesus Christ. This is the true God and eternal life."],["21",[["τεκνία",10478,532],["φυλάξατε",125,69],["ἑαυτὰ",92,66],["ἀπὸ",17,1],["τῶν",1,44],["εἰδώλων",627,45]],"Little children, keep yourselves from idols."]]