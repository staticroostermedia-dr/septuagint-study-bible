[["1",[["Τεκνία",10478,532],["μου",9994,146],["ταῦτα",16,248],["γράφω",186,149],["ὑμῖν",5,86],["ἵνα",102,8],["μὴ",25,12],["ἁμάρτητε",237,118],["καὶ",2,8],["ἐάν",45,8],["τις",39,150],["ἁμάρτῃ",237,160],["παράκλητον",10479,7],["ἔχομεν",124,241],["πρὸς",15,1],["τὸν",1,6],["πατέρα",44,7],["Ἰησοῦν",211,7],["Χριστὸν",1072,7],["δίκαιον",153,59]],"My little children, I write these things to you so that you may not sin. If anyone sins, we have a Counselor with the Father, Jesus Christ, the righteous."],["2",[["καὶ",2,8],["αὐτὸς",3,158],["ἱλασμός",3213,5],["ἐστιν",10,87],["περὶ",72,1],["τῶν",1,123],["ἁμαρτιῶν",119,61],["ἡμῶν",9994,136],["οὐ",12,12],["περὶ",72,1],["τῶν",1,123],["ἡμετέρων",10505,115],["δὲ",14,8],["μόνον",302,29],["ἀλλὰ",108,8],["καὶ",2,8],["περὶ",72,1],["ὅλου",235,153],["τοῦ",1,30],["κόσμου",743,21]],"And he is the atoning sacrifice for our sins, and not for ours only, but also for the whole world."],["3",[["καὶ",2,8],["ἐν",4,1],["τούτῳ",16,279],["γινώσκομεν",79,241],["ὅτι",19,8],["ἐγνώκαμεν",79,311],["αὐτόν",3,82],["ἐὰν",45,8],["τὰς",1,39],["ἐντολὰς",259,40],["αὐτοῦ",3,48],["τηρῶμεν",1358,223]],"This is how we know that we know him: if we keep his commandments."],["4",[["Ὁ",1,4],["λέγων",31,67],["ὅτι",19,8],["ἔγνωκα",79,85],["αὐτὸν",3,82],["καὶ",2,8],["τὰς",1,39],["ἐντολὰς",259,40],["αὐτοῦ",3,48],["μὴ",25,12],["τηρῶν",1358,67],["ψεύστης",5152,5],["ἐστίν",10,87],["καὶ",2,8],["ἐν",4,1],["τούτῳ",16,286],["ἡ",1,11],["ἀλήθεια",352,13],["οὐκ",12,12],["ἔστιν",10,87]],"One who says, “I know him,” and doesn’t keep his commandments, is a liar, and the truth isn’t in him."],["5",[["ὃς",24,246],["δ᾽",14,8],["ἂν",83,12],["τηρῇ",1358,173],["αὐτοῦ",3,48],["τὸν",1,6],["λόγον",48,7],["ἀληθῶς",1795,17],["ἐν",4,1],["τούτῳ",16,286],["ἡ",1,11],["ἀγάπη",1982,13],["τοῦ",1,30],["θεοῦ",20,21],["τετελείωται",1838,722],["ἐν",4,1],["τούτῳ",16,279],["γινώσκομεν",79,241],["ὅτι",19,8],["ἐν",4,1],["αὐτῷ",3,49],["ἐσμεν",10,241]],"But God’s love has most certainly been perfected in whoever keeps his word. This is how we know that we are in him:"],["6",[["ὁ",1,4],["λέγων",31,67],["ἐν",4,1],["αὐτῷ",3,49],["μένειν",681,54],["ὀφείλει",2150,87],["καθὼς",221,8],["ἐκεῖνος",80,112],["περιεπάτησεν",1327,3],["καὶ",2,8],["αὐτὸς",3,158],["οὕτως",71,17],["περιπατεῖν",1327,54]],"he who says he remains in him ought himself also to walk just like he walked."],["7",[["Ἀγαπητοί",1920,537],["οὐκ",12,12],["ἐντολὴν",259,10],["καινὴν",728,37],["γράφω",186,149],["ὑμῖν",5,86],["ἀλλ᾽",108,8],["ἐντολὴν",259,10],["παλαιὰν",1905,37],["ἣν",24,124],["εἴχετε",124,339],["ἀπ᾽",17,1],["ἀρχῆς",270,19],["ἡ",1,11],["ἐντολὴ",259,13],["ἡ",1,11],["παλαιά",1905,15],["ἐστιν",10,87],["ὁ",1,4],["λόγος",48,5],["ὃν",24,106],["ἠκούσατε",54,262]],"Brothers, I write no new commandment to you, but an old commandment which you had from the beginning. The old commandment is the word which you heard from the beginning."],["8",[["πάλιν",655,17],["ἐντολὴν",259,10],["καινὴν",728,37],["γράφω",186,149],["ὑμῖν",5,86],["ὅ",24,677],["ἐστιν",10,87],["ἀληθὲς",1923,28],["ἐν",4,1],["αὐτῷ",3,49],["καὶ",2,8],["ἐν",4,1],["ὑμῖν",5,86],["ὅτι",19,8],["ἡ",1,11],["σκοτία",5041,13],["παράγεται",2277,449],["καὶ",2,8],["τὸ",1,27],["φῶς",380,20],["τὸ",1,27],["ἀληθινὸν",1023,28],["ἤδη",916,17],["φαίνει",832,87]],"Again, I write a new commandment to you, which is true in him and in you, because the darkness is passing away and the true light already shines."],["9",[["ὁ",1,4],["λέγων",31,67],["ἐν",4,1],["τῷ",1,52],["φωτὶ",380,53],["εἶναι",10135,54],["καὶ",2,8],["τὸν",1,6],["ἀδελφὸν",67,7],["αὐτοῦ",3,48],["μισῶν",351,67],["ἐν",4,1],["τῇ",1,95],["σκοτίᾳ",5041,2],["ἐστὶν",10,87],["ἕως",42,1],["ἄρτι",2665,17]],"He who says he is in the light and hates his brother is in the darkness even until now."],["10",[["ὁ",1,4],["ἀγαπῶν",214,67],["τὸν",1,6],["ἀδελφὸν",67,7],["αὐτοῦ",3,48],["ἐν",4,1],["τῷ",1,52],["φωτὶ",380,53],["μένει",681,87],["καὶ",2,8],["σκάνδαλον",1834,20],["ἐν",4,1],["αὐτῷ",3,49],["οὐκ",12,12],["ἔστιν",10,87]],"He who loves his brother remains in the light, and there is no occasion for stumbling in him."],["11",[["ὁ",1,4],["δὲ",14,8],["μισῶν",351,67],["τὸν",1,6],["ἀδελφὸν",67,7],["αὐτοῦ",3,48],["ἐν",4,1],["τῇ",1,95],["σκοτίᾳ",5041,2],["ἐστὶν",10,87],["καὶ",2,8],["ἐν",4,1],["τῇ",1,95],["σκοτίᾳ",5041,2],["περιπατεῖ",1327,87],["καὶ",2,8],["οὐκ",12,12],["οἶδεν",1168,165],["ποῦ",9996,17],["ὑπάγει",6654,87],["ὅτι",19,8],["ἡ",1,11],["σκοτία",5041,13],["ἐτύφλωσεν",8573,3],["τοὺς",1,56],["ὀφθαλμοὺς",91,31],["αὐτοῦ",3,48]],"But he who hates his brother is in the darkness, and walks in the darkness, and doesn’t know where he is going, because the darkness has blinded his eyes."],["12",[["Γράφω",186,149],["ὑμῖν",5,86],["τεκνία",10478,532],["ὅτι",19,8],["ἀφέωνται",501,847],["ὑμῖν",5,86],["αἱ",1,185],["ἁμαρτίαι",119,180],["διὰ",56,1],["τὸ",1,32],["ὄνομα",57,33],["αὐτοῦ",3,48]],"I write to you, little children, because your sins are forgiven you for his name’s sake."],["13",[["γράφω",186,149],["ὑμῖν",5,86],["πατέρες",44,396],["ὅτι",19,8],["ἐγνώκατε",79,330],["τὸν",1,6],["ἀπ᾽",17,1],["ἀρχῆς",270,19],["γράφω",186,149],["ὑμῖν",5,86],["νεανίσκοι",570,396],["ὅτι",19,8],["νενικήκατε",1441,330],["τὸν",1,6],["πονηρόν",164,59]],"I write to you, fathers, because you know him who is from the beginning. I write to you, young men, because you have overcome the evil one. I write to you, little children, because you know the Father."],["14",[["Ἔγραψα",186,147],["ὑμῖν",5,86],["παιδία",449,532],["ὅτι",19,8],["ἐγνώκατε",79,330],["τὸν",1,6],["πατέρα",44,7],["ἔγραψα",186,147],["ὑμῖν",5,86],["πατέρες",44,396],["ὅτι",19,8],["ἐγνώκατε",79,330],["τὸν",1,6],["ἀπ᾽",17,1],["ἀρχῆς",270,19],["ἔγραψα",186,147],["ὑμῖν",5,86],["νεανίσκοι",570,396],["ὅτι",19,8],["ἰσχυροί",401,130],["ἐστε",10,84],["καὶ",2,8],["ὁ",1,4],["λόγος",48,5],["τοῦ",1,30],["θεοῦ",20,21],["ἐν",4,1],["ὑμῖν",5,86],["μένει",681,87],["καὶ",2,8],["νενικήκατε",1441,330],["τὸν",1,6],["πονηρόν",164,59]],"I have written to you, fathers, because you know him who is from the beginning. I have written to you, young men, because you are strong, and the word of God remains in you, and you have overcome the evil one."],["15",[["Μὴ",25,12],["ἀγαπᾶτε",214,307],["τὸν",1,6],["κόσμον",743,7],["μηδὲ",414,8],["τὰ",1,42],["ἐν",4,1],["τῷ",1,110],["κόσμῳ",743,113],["ἐάν",45,8],["τις",39,150],["ἀγαπᾷ",214,173],["τὸν",1,6],["κόσμον",743,7],["οὐκ",12,12],["ἔστιν",10,87],["ἡ",1,11],["ἀγάπη",1982,13],["τοῦ",1,30],["πατρὸς",44,21],["ἐν",4,1],["αὐτῷ",3,49]],"Don’t love the world or the things that are in the world. If anyone loves the world, the Father’s love isn’t in him."],["16",[["ὅτι",19,8],["πᾶν",11,28],["τὸ",1,27],["ἐν",4,1],["τῷ",1,110],["κόσμῳ",743,113],["ἡ",1,11],["ἐπιθυμία",699,13],["τῆς",1,18],["σαρκὸς",287,19],["καὶ",2,8],["ἡ",1,11],["ἐπιθυμία",699,13],["τῶν",1,76],["ὀφθαλμῶν",91,77],["καὶ",2,8],["ἡ",1,11],["ἀλαζονεία",3393,13],["τοῦ",1,30],["βίου",726,21],["οὐκ",12,12],["ἔστιν",10,87],["ἐκ",21,1],["τοῦ",1,30],["πατρὸς",44,21],["ἀλλ᾽",108,8],["ἐκ",21,1],["τοῦ",1,30],["κόσμου",743,21],["ἐστίν",10,87]],"For all that is in the world—the lust of the flesh, the lust of the eyes, and the pride of life—isn’t the Father’s, but is the world’s."],["17",[["καὶ",2,8],["ὁ",1,4],["κόσμος",743,5],["παράγεται",2277,449],["καὶ",2,8],["ἡ",1,11],["ἐπιθυμία",699,13],["αὐτοῦ",3,48],["ὁ",1,4],["δὲ",14,8],["ποιῶν",23,67],["τὸ",1,32],["θέλημα",1039,33],["τοῦ",1,30],["θεοῦ",20,21],["μένει",681,87],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7]],"The world is passing away with its lusts, but he who does God’s will remains forever."],["18",[["Παιδία",449,532],["ἐσχάτη",410,15],["ὥρα",838,13],["ἐστίν",10,87],["καὶ",2,8],["καθὼς",221,8],["ἠκούσατε",54,262],["ὅτι",19,8],["ἀντίχριστος",11438,5],["ἔρχεται",55,728],["καὶ",2,8],["νῦν",90,17],["ἀντίχριστοι",11438,51],["πολλοὶ",74,130],["γεγόνασιν",30,400],["ὅθεν",1153,8],["γινώσκομεν",79,241],["ὅτι",19,8],["ἐσχάτη",410,15],["ὥρα",838,13],["ἐστίν",10,87]],"Little children, these are the end times, and as you heard that the Antichrist is coming, even now many antichrists have arisen. By this we know that it is the final hour."],["19",[["ἐξ",21,1],["ἡμῶν",9994,136],["ἐξῆλθαν",82,141],["ἀλλ᾽",108,8],["οὐκ",12,12],["ἦσαν",10,129],["ἐξ",21,1],["ἡμῶν",9994,136],["εἰ",77,8],["γὰρ",40,8],["ἐξ",21,1],["ἡμῶν",9994,136],["ἦσαν",10,129],["μεμενήκεισαν",681,385],["ἂν",83,12],["μεθ᾽",29,1],["ἡμῶν",9994,136],["ἀλλ᾽",108,8],["ἵνα",102,8],["φανερωθῶσιν",8582,266],["ὅτι",19,8],["οὐκ",12,12],["εἰσὶν",10,191],["πάντες",11,130],["ἐξ",21,1],["ἡμῶν",9994,136]],"They went out from us, but they didn’t belong to us; for if they had belonged to us, they would have continued with us. But they left, that they might be revealed that none of them belong to us."],["20",[["καὶ",2,8],["ὑμεῖς",5,208],["χρῖσμα",2975,33],["ἔχετε",124,84],["ἀπὸ",17,1],["τοῦ",1,30],["ἁγίου",75,153],["καὶ",2,8],["οἴδατε",1168,330],["πάντες",11,130]],"You have an anointing from the Holy One, and you all have knowledge."],["21",[["οὐκ",12,12],["ἔγραψα",186,147],["ὑμῖν",5,86],["ὅτι",19,8],["οὐκ",12,12],["οἴδατε",10044,84],["τὴν",1,9],["ἀλήθειαν",352,10],["ἀλλ᾽",108,8],["ὅτι",19,8],["οἴδατε",10044,84],["αὐτὴν",3,98],["καὶ",2,8],["ὅτι",19,8],["πᾶν",11,28],["ψεῦδος",1392,20],["ἐκ",21,1],["τῆς",1,18],["ἀληθείας",352,19],["οὐκ",12,12],["ἔστιν",10,87]],"I have not written to you because you don’t know the truth, but because you know it, and because no lie is of the truth."],["22",[["τίς",10010,150],["ἐστιν",10,87],["ὁ",1,4],["ψεύστης",5152,5],["εἰ",77,8],["μὴ",25,12],["ὁ",1,4],["ἀρνούμενος",3710,723],["ὅτι",19,8],["Ἰησοῦς",211,5],["οὐκ",12,12],["ἔστιν",10,87],["ὁ",1,4],["Χριστός",1072,5],["οὗτός",16,112],["ἐστιν",10,87],["ὁ",1,4],["ἀντίχριστος",11438,5],["ὁ",1,4],["ἀρνούμενος",3710,723],["τὸν",1,6],["πατέρα",44,7],["καὶ",2,8],["τὸν",1,6],["υἱόν",13,7]],"Who is the liar but he who denies that Jesus is the Christ? This is the Antichrist, he who denies the Father and the Son."],["23",[["πᾶς",11,16],["ὁ",1,4],["ἀρνούμενος",3710,723],["τὸν",1,6],["υἱὸν",13,7],["οὐδὲ",106,8],["τὸν",1,6],["πατέρα",44,7],["ἔχει",124,87],["ὁ",1,4],["ὁμολογῶν",2686,67],["τὸν",1,6],["υἱὸν",13,7],["καὶ",2,8],["τὸν",1,6],["πατέρα",44,7],["ἔχει",124,87]],"Whoever denies the Son doesn’t have the Father. He who confesses the Son has the Father also."],["24",[["ὑμεῖς",5,208],["ὃ",24,467],["ἠκούσατε",54,262],["ἀπ᾽",17,1],["ἀρχῆς",270,19],["ἐν",4,1],["ὑμῖν",5,86],["μενέτω",681,35],["ἐὰν",45,8],["ἐν",4,1],["ὑμῖν",5,86],["μείνῃ",681,160],["ὃ",24,467],["ἀπ᾽",17,1],["ἀρχῆς",270,19],["ἠκούσατε",54,262],["καὶ",2,8],["ὑμεῖς",5,208],["ἐν",4,1],["τῷ",1,110],["υἱῷ",13,113],["καὶ",2,8],["ἐν",4,1],["τῷ",1,110],["πατρὶ",44,113],["μενεῖτε",681,348]],"Therefore, as for you, let that remain in you which you heard from the beginning. If that which you heard from the beginning remains in you, you also will remain in the Son, and in the Father."],["25",[["καὶ",2,8],["αὕτη",16,101],["ἐστὶν",10,87],["ἡ",1,11],["ἐπαγγελία",3439,13],["ἣν",24,124],["αὐτὸς",3,158],["ἐπηγγείλατο",2536,737],["ἡμῖν",9994,86],["τὴν",1,9],["ζωὴν",216,10],["τὴν",1,9],["αἰώνιον",391,37]],"This is the promise which he promised us, the eternal life."],["26",[["Ταῦτα",16,248],["ἔγραψα",186,147],["ὑμῖν",5,86],["περὶ",72,1],["τῶν",1,76],["πλανώντων",464,164],["ὑμᾶς",5,209]],"These things I have written to you concerning those who would lead you astray."],["27",[["καὶ",2,8],["ὑμεῖς",5,208],["τὸ",1,27],["χρῖσμα",2975,20],["ὃ",24,467],["ἐλάβετε",46,262],["ἀπ᾽",17,1],["αὐτοῦ",3,48],["μένει",681,87],["ἐν",4,1],["ὑμῖν",5,86],["καὶ",2,8],["οὐ",12,12],["χρείαν",1006,10],["ἔχετε",124,84],["ἵνα",102,8],["τις",39,150],["διδάσκῃ",545,173],["ὑμᾶς",5,209],["ἀλλ᾽",108,8],["ὡς",36,12],["τὸ",1,27],["αὐτοῦ",3,48],["χρῖσμα",2975,20],["διδάσκει",545,87],["ὑμᾶς",5,209],["περὶ",72,1],["πάντων",11,79],["καὶ",2,8],["ἀληθές",1923,28],["ἐστιν",10,87],["καὶ",2,8],["οὐκ",12,12],["ἔστιν",10,87],["ψεῦδος",1392,20],["καὶ",2,8],["καθὼς",221,8],["ἐδίδαξεν",545,3],["ὑμᾶς",5,209],["μένετε",681,84],["ἐν",4,1],["αὐτῷ",3,49]],"As for you, the anointing which you received from him remains in you, and you don’t need for anyone to teach you. But as his anointing teaches you concerning all things, and is true, and is no lie, and even as it taught you, you will remain in him."],["28",[["καὶ",2,8],["νῦν",90,17],["τεκνία",10478,532],["μένετε",681,307],["ἐν",4,1],["αὐτῷ",3,49],["ἵνα",102,8],["ἐὰν",45,8],["φανερωθῇ",8582,333],["σχῶμεν",124,75],["παρρησίαν",2610,10],["καὶ",2,8],["μὴ",25,12],["αἰσχυνθῶμεν",611,282],["ἀπ᾽",17,1],["αὐτοῦ",3,48],["ἐν",4,1],["τῇ",1,95],["παρουσίᾳ",4349,2],["αὐτοῦ",3,48]],"Now, little children, remain in him, that when he appears, we may have boldness and not be ashamed before him at his coming."],["29",[["ἐὰν",45,8],["εἰδῆτε",1168,622],["ὅτι",19,8],["δίκαιός",153,16],["ἐστιν",10,87],["γινώσκετε",79,84],["ὅτι",19,8],["καὶ",2,8],["πᾶς",11,16],["ὁ",1,4],["ποιῶν",23,67],["τὴν",1,9],["δικαιοσύνην",187,10],["ἐξ",21,1],["αὐτοῦ",3,48],["γεγέννηται",222,722]],"If you know that he is righteous, you know that everyone who practices righteousness has been born of him."]]