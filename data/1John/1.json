[["1",[["Ὃ",24,677],["ἦν",10,14],["ἀπ᾽",17,1],["ἀρχῆς",270,19],["ὃ",24,467],["ἀκηκόαμεν",54,311],["ὃ",24,467],["ἑωράκαμεν",112,311],["τοῖς",1,138],["ὀφθαλμοῖς",91,139],["ἡμῶν",9994,136],["ὃ",24,467],["ἐθεασάμεθα",3062,868],["καὶ",2,8],["αἱ",1,185],["χεῖρες",37,180],["ἡμῶν",9994,136],["ἐψηλάφησαν",2206,141],["περὶ",72,1],["τοῦ",1,30],["λόγου",48,21],["τῆς",1,18],["ζωῆς",216,19]],"That which was from the beginning, that which we have heard, that which we have seen with our eyes, that which we saw, and our hands touched, concerning the Word of life"],["2",[["καὶ",2,8],["ἡ",1,11],["ζωὴ",216,13],["ἐφανερώθη",8582,38],["καὶ",2,8],["ἑωράκαμεν",112,311],["καὶ",2,8],["μαρτυροῦμεν",2094,241],["καὶ",2,8],["ἀπαγγέλλομεν",273,241],["ὑμῖν",5,86],["τὴν",1,9],["ζωὴν",216,10],["τὴν",1,9],["αἰώνιον",391,37],["ἥτις",457,421],["ἦν",10,14],["πρὸς",15,1],["τὸν",1,6],["πατέρα",44,7],["καὶ",2,8],["ἐφανερώθη",8582,38],["ἡμῖν",9994,86]],"(and the life was revealed, and we have seen, and testify, and declare to you the life, the eternal life, which was with the Father, and was revealed to us);"],["3",[["ὃ",24,467],["ἑωράκαμεν",112,311],["καὶ",2,8],["ἀκηκόαμεν",54,311],["ἀπαγγέλλομεν",273,241],["καὶ",2,8],["ὑμῖν",5,86],["ἵνα",102,8],["καὶ",2,8],["ὑμεῖς",5,208],["κοινωνίαν",4860,10],["ἔχητε",124,362],["μεθ᾽",29,1],["ἡμῶν",9994,136],["καὶ",2,8],["ἡ",1,11],["κοινωνία",4860,13],["δὲ",14,8],["ἡ",1,11],["ἡμετέρα",10505,15],["μετὰ",29,1],["τοῦ",1,30],["πατρὸς",44,21],["καὶ",2,8],["μετὰ",29,1],["τοῦ",1,30],["υἱοῦ",13,21],["αὐτοῦ",3,48],["Ἰησοῦ",211,21],["Χριστοῦ",1072,21]],"that which we have seen and heard we declare to you, that you also may have fellowship with us. Yes, and our fellowship is with the Father and with his Son, Jesus Christ."],["4",[["καὶ",2,8],["ταῦτα",16,248],["γράφομεν",186,241],["ἡμεῖς",9994,208],["ἵνα",102,8],["ἡ",1,11],["χαρὰ",1125,13],["ἡμῶν",9994,136],["ᾖ",10,173],["πεπληρωμένη",518,557]],"And we write these things to you, that our joy may be fulfilled."],["5",[["καὶ",2,8],["ἔ