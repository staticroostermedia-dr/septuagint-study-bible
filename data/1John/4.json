[["1",[["Ἀγαπητοί",1920,537],["μὴ",25,12],["παντὶ",11,34],["πνεύματι",168,53],["πιστεύετε",649,307],["ἀλλὰ",108,8],["δοκιμάζετε",1269,307],["τὰ",1,42],["πνεύματα",168,43],["εἰ",77,8],["ἐκ",21,1],["τοῦ",1,30],["θεοῦ",20,21],["ἐστιν",10,87],["ὅτι",19,8],["πολλοὶ",74,130],["ψευδοπροφῆται",2801,51],["ἐξεληλύθασιν",82,400],["εἰς",8,1],["τὸν",1,6],["κόσμον",743,7]],"Beloved, don’t believe every spirit, but test the spirits, whether they are of God, because many false prophets have gone out into the world."],["2",[["ἐν",4,1],["τούτῳ",16,279],["γινώσκετε",79,84],["τὸ",1,32],["πνεῦμα",168,33],["τοῦ",1,30],["θεοῦ",20,21],["πᾶν",11,28],["πνεῦμα",168,20],["ὃ",24,677],["ὁμολογεῖ",2686,87],["Ἰησοῦν",211,7],["Χριστὸν",1072,7],["ἐν",4,1],["σαρκὶ",287,2],["ἐληλυθότα",55,434],["ἐκ",21,1],["τοῦ",1,30],["θεοῦ",20,21],["ἐστιν",10,87]],"By this you know the Spirit of God: every spirit who confesses that Jesus Christ has come in the flesh is of God,"],["3",[["καὶ",2,8],["πᾶν",11,28],["πνεῦμα",168,20],["ὃ",24,677],["μὴ",25,12],["ὁμολογεῖ",2686,87],["τὸν",1,6],["Ἰησοῦν",211,7],["ἐκ",21,1],["τοῦ",1,30],["θεοῦ",20,21],["οὐκ",12,12],["ἔστιν",10,87],["καὶ",2,8],["τοῦτό",16,344],["ἐστιν",10,87],["τὸ",1,27],["τοῦ",1,30],["ἀντιχρίστου",11438,21],["ὃ",24,467],["ἀκηκόατε",54,330],["ὅτι",19,8],["ἔρχεται",55,728],["καὶ",2,8],["νῦν",90,17],["ἐν",4,1],["τῷ",1,110],["κόσμῳ",743,113],["ἐστὶν",10,87],["ἤδη",916,17]],"and every spirit who doesn’t confess that Jesus Christ has come in the flesh is not of God; and this is the spirit of the Antichrist, of whom you have heard that it comes. Now it is in the world already."],["4",[["ὑμεῖς",5,208],["ἐκ",21,1],["τοῦ",1,30],["θεοῦ",20,21],["ἐστε",10,84],["τεκνία",10478,532],["καὶ",2,8],["νενικήκατε",1441,330],["αὐτούς",3,60],["ὅτι",19,8],["μείζων",66,16],["ἐστὶν",10,87],["ὁ",1,4],["ἐν",4,1],["ὑμῖν",5,86],["ἢ",61,8],["ὁ",1,4],["ἐν",4,1],["τῷ",1,110],["κόσμῳ",743,113]],"You are of God, little children, and have overcome them, because greater is he who is in you than he who is in the world."],["5",[["αὐτοὶ",3,195],["ἐκ",21,1],["τοῦ",1,30],["κόσμου",743,21],["εἰσίν",10,191],["διὰ",56,1],["τοῦτο",16,122],["ἐκ",21,1],["τοῦ",1,30],["κόσμου",743,21],["λαλοῦσιν",50,191],["καὶ",2,8],["ὁ",1,4],["κόσμος",743,5],["αὐτῶν",3,41],["ἀκούει",54,87]],"They are of the world. Therefore they speak of the world, and the world hears them."],["6",[["ἡμεῖς",9994,208],["ἐκ",21,1],["τοῦ",1,30],["θεοῦ",20,21],["ἐσμεν",10,241],["ὁ",1,4],["γινώσκων",79,67],["τὸν",1,6],["θεὸν",20,7],["ἀκούει",54,87],["ἡμῶν",9994,136],["ὃς",24,246],["οὐκ",12,12],["ἔστιν",10,87],["ἐκ",21,1],["τοῦ",1,30],["θεοῦ",20,21],["οὐκ",12,12],["ἀκούει",54,87],["ἡμῶν",9994,136],["ἐκ",21,1],["τούτου",16,298],["γινώσκομεν",79,241],["τὸ",1,32],["πνεῦμα",168,33],["τῆς",1,18],["ἀληθείας",352,19],["καὶ",2,8],["τὸ",1,32],["πνεῦμα",168,33],["τῆς",1,18],["πλάνης",3622,19]],"We are of God. He who knows God listens to us. He who is not of God doesn’t listen to us. By this we know the spirit of truth, and the spirit of error."],["7",[["Ἀγαπητοί",1920,537],["ἀγαπῶμεν",214,223],["ἀλλήλους",1192,60],["ὅτι",19,8],["ἡ",1,11],["ἀγάπη",1982,13],["ἐκ",21,1],["τοῦ",1,30],["θεοῦ",20,21],["ἐστιν",10,87],["καὶ",2,8],["πᾶς",11,16],["ὁ",1,4],["ἀγαπῶν",214,67],["ἐκ",21,1],["τοῦ",1,30],["θεοῦ",20,21],["γεγέννηται",222,722],["καὶ",2,8],["γινώσκει",79,87],["τὸν",1,6],["θεόν",20,7]],"Beloved, let’s love one another, for love is of God; and everyone who loves has been born of God and knows God."],["8",[["ὁ",1,4],["μὴ",25,12],["ἀγαπῶν",214,67],["οὐκ",12,12],["ἔγνω",79,3],["τὸν",1,6],["θεόν",20,7],["ὅτι",19,8],["ὁ",1,4],["θεὸς",20,5],["ἀγάπη",1982,13],["ἐστίν",10,87]],"He who doesn’t love doesn’t know God, for God is love."],["9",[["ἐν",4,1],["τούτῳ",16,279],["ἐφανερώθη",8582,38],["ἡ",1,11],["ἀγάπη",1982,13],["τοῦ",1,30],["θεοῦ",20,21],["ἐν",4,1],["ἡμῖν",9994,86],["ὅτι",19,8],["τὸν",1,6],["υἱὸν",13,7],["αὐτοῦ",3,48],["τὸν",1,6],["μονογενῆ",3301,59],["ἀπέσταλκεν",84,165],["ὁ",1,4],["θεὸς",20,5],["εἰς",8,1],["τὸν",1,6],["κόσμον",743,7],["ἵνα",102,8],["ζήσωμεν",107,75],["δι᾽",56,1],["αὐτοῦ",3,48]],"By this God’s love was revealed in us, that God has sent his only born Son into the world that we might live through him."],["10",[["ἐν",4,1],["τούτῳ",16,279],["ἐστὶν",10,87],["ἡ",1,11],["ἀγάπη",1982,13],["οὐχ",12,12],["ὅτι",19,8],["ἡμεῖς",9994,208],["ἠγαπήκαμεν",214,311],["τὸν",1,6],["θεόν",20,7],["ἀλλ᾽",108,8],["ὅτι",19,8],["αὐτὸς",3,158],["ἠγάπησεν",214,3],["ἡμᾶς",9994,209],["καὶ",2,8],["ἀπέστειλεν",84,3],["τὸν",1,6],["υἱὸν",13,7],["αὐτοῦ",3,48],["ἱλασμὸν",3213,7],["περὶ",72,1],["τῶν",1,123],["ἁμαρτιῶν",119,61],["ἡμῶν",9994,136]],"In this is love, not that we loved God, but that he loved us, and sent his Son as the atoning sacrifice for our sins."],["11",[["Ἀγαπητοί",1920,537],["εἰ",77,8],["οὕτως",71,17],["ὁ",1,4],["θεὸς",20,5],["ἠγάπησεν",214,3],["ἡμᾶς",9994,209],["καὶ",2,8],["ἡμεῖς",9994,208],["ὀφείλομεν",2150,241],["ἀλλήλους",1192,60],["ἀγαπᾶν",214,54]],"Beloved, if God loved us in this way, we also ought to love one another."],["12",[["θεὸν",20,7],["οὐδεὶς",228,16],["πώποτε",5033,17],["τεθέαται",3062,890],["ἐὰν",45,8],["ἀγαπῶμεν",214,223],["ἀλλήλους",1192,60],["ὁ",1,4],["θεὸς",20,5],["ἐν",4,1],["ἡμῖν",9994,86],["μένει",681,87],["καὶ",2,8],["ἡ",1,11],["ἀγάπη",1982,13],["αὐτοῦ",3,48],["ἐν",4,1],["ἡμῖν",9994,86],["τετελειωμένη",1838,557],["ἐστίν",10,87]],"No one has seen God at any time. If we love one another, God remains in us, and his love has been perfected in us."],["13",[["ἐν",4,1],["τούτῳ",16,279],["γινώσκομεν",79,241],["ὅτι",19,8],["ἐν",4,1],["αὐτῷ",3,49],["μένομεν",681,241],["καὶ",2,8],["αὐτὸς",3,158],["ἐν",4,1],["ἡμῖν",9994,86],["ὅτι",19,8],["ἐκ",21,1],["τοῦ",1,23],["πνεύματος",168,24],["αὐτοῦ",3,48],["δέδωκεν",33,165],["ἡμῖν",9994,86]],"By this we know that we remain in him and he in us, because he has given us of his Spirit."],["14",[["καὶ",2,8],["ἡμεῖς",9994,208],["τεθεάμεθα",3062,965],["καὶ",2,8],["μαρτυροῦμεν",2094,241],["ὅτι",19,8],["ὁ",1,4],["πατὴρ",44,5],["ἀπέσταλκεν",84,165],["τὸν",1,6],["υἱὸν",13,7],["σωτῆρα",1388,7],["τοῦ",1,30],["κόσμου",743,21]],"We have seen and testify that the Father has sent the Son as the Savior of the world."],["15",[["ὃς",24,246],["ἐὰν",45,8],["ὁμολογήσῃ",2686,160],["ὅτι",19,8],["Ἰησοῦς",211,5],["ἐστιν",10,87],["ὁ",1,4],["υἱὸς",13,5],["τοῦ",1,30],["θεοῦ",20,21],["ὁ",1,4],["θεὸς",20,5],["ἐν",4,1],["αὐτῷ",3,49],["μένει",681,87],["καὶ",2,8],["αὐτὸς",3,158],["ἐν",4,1],["τῷ",1,110],["θεῷ",20,113]],"Whoever confesses that Jesus is the Son of God, God remains in him, and he in God."],["16",[["καὶ",2,8],["ἡμεῖς",9994,208],["ἐγνώκαμεν",79,311],["καὶ",2,8],["πεπιστεύκαμεν",649,311],["τὴν",1,9],["ἀγάπην",1982,10],["ἣν",24,124],["ἔχει",124,87],["ὁ",1,4],["θεὸς",20,5],["ἐν",4,1],["ἡμῖν",9994,86],["ὁ",1,4],["θεὸς",20,5],["ἀγάπη",1982,13],["ἐστίν",10,87],["καὶ",2,8],["ὁ",1,4],["μένων",681,67],["ἐν",4,1],["τῇ",1,95],["ἀγάπῃ",1982,2],["ἐν",4,1],["τῷ",1,110],["θεῷ",20,113],["μένει",681,87],["καὶ",2,8],["ὁ",1,4],["θεὸς",20,5],["ἐν",4,1],["αὐτῷ",3,49],["μένει",681,87]],"We know and have believed the love which God has for us. God is love, and he who remains in love remains in God, and God remains in him."],["17",[["ἐν",4,1],["τούτῳ",16,279],["τετελείωται",1838,722],["ἡ",1,11],["ἀγάπη",1982,13],["μεθ᾽",29,1],["ἡμῶν",9994,136],["ἵνα",102,8],["παρρησίαν",2610,10],["ἔχωμεν",124,223],["ἐν",4,1],["τῇ",1,95],["ἡμέρᾳ",28,2],["τῆς",1,18],["κρίσεως",229,19],["ὅτι",19,8],["καθὼς",221,8],["ἐκεῖνός",80,112],["ἐστιν",10,87],["καὶ",2,8],["ἡμεῖς",9994,208],["ἐσμεν",10,241],["ἐν",4,1],["τῷ",1,110],["κόσμῳ",743,113],["τούτῳ",16,286]],"In this, love has been made perfect among us, that we may have boldness in the day of judgment, because as he is, even so we are in this world."],["18",[["φόβος",333,5],["οὐκ",12,12],["ἔστιν",10,87],["ἐν",4,1],["τῇ",1,95],["ἀγάπῃ",1982,2],["ἀλλ᾽",108,8],["ἡ",1,11],["τελεία",1919,15],["ἀγάπη",1982,13],["ἔξω",527,1],["βάλλει",766,87],["τὸν",1,6],["φόβον",333,7],["ὅτι",19,8],["ὁ",1,4],["φόβος",333,5],["κόλασιν",2174,10],["ἔχει",124,87],["ὁ",1,4],["δὲ",14,8],["φοβούμενος",134,723],["οὐ",12,12],["τετελείωται",1838,722],["ἐν",4,1],["τῇ",1,95],["ἀγάπῃ",1982,2]],"There is no fear in love; but perfect love casts out fear, because fear has punishment. He who fears is not made perfect in love."],["19",[["ἡμεῖς",9994,208],["ἀγαπῶμεν",214,241],["ὅτι",19,8],["αὐτὸς",3,158],["πρῶτος",315,16],["ἠγάπησεν",214,3],["ἡμᾶς",9994,209]],"We love him, because he first loved us."],["20",[["ἐάν",45,8],["τις",39,150],["εἴπῃ",31,160],["ὅτι",19,8],["ἀγαπῶ",214,149],["τὸν",1,6],["θεὸν",20,7],["καὶ",2,8],["τὸν",1,6],["ἀδελφὸν",67,7],["αὐτοῦ",3,48],["μισῇ",351,173],["ψεύστης",5152,5],["ἐστίν",10,87],["ὁ",1,4],["γὰρ",40,8],["μὴ",25,12],["ἀγαπῶν",214,67],["τὸν",1,6],["ἀδελφὸν",67,7],["αὐτοῦ",3,48],["ὃν",24,106],["ἑώρακεν",112,165],["τὸν",1,6],["θεὸν",20,7],["ὃν",24,106],["οὐχ",12,12],["ἑώρακεν",112,165],["οὐ",12,12],["δύναται",185,728],["ἀγαπᾶν",214,54]],"If a man says, “I love God,” and hates his brother, he is a liar; for he who doesn’t love his brother whom he has seen, how can he love God whom he has not seen?"],["21",[["καὶ",2,8],["ταύτην",16,234],["τὴν",1,9],["ἐντολὴν",259,10],["ἔχομεν",124,241],["ἀπ᾽",17,1],["αὐτοῦ",3,48],["ἵνα",102,1],["ὁ",1,4],["ἀγαπῶν",214,67],["τὸν",1,6],["θεὸν",20,7],["ἀγαπᾷ",214,173],["καὶ",2,8],["τὸν",1,6],["ἀδελφὸν",67,7],["αὐτοῦ",3,48]],"This commandment we have from him, that he who loves God should also love his brother."]]