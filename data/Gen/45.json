,32],["λαλοῦν",50,47],["πρὸς",15,1],["ὑμᾶς",5,209]],"Behold, your eyes see, and the eyes of my brother Benjamin, that it is my mouth that speaks to you."],["13",[["Ἀπαγγείλατε",273,69],["οὖν",227,12],["τῷ",1,110],["πατρί",44,113],["μου",6,48],["πᾶσαν",11,37],["τὴν",1,9],["δόξαν",141,10],["μου",6,48],["τὴν",1,9],["ἐν",4,1],["Αἰγύπτῳ",93,2],["καὶ",2,8],["ὅσα",103,63],["ἴδετε",53,69],["καὶ",2,8],["ταχύναντες",2120,190],["καταγάγετε",735,69],["τὸν",1,6],["πατέρα",44,7],["μου",6,48],["ὧδε",640,17]],"Report, therefore, to my father all my glory in Egypt, and all things that ye have seen, and make haste and bring down my father hither."],["14",[["Καὶ",2,8],["ἐπιπεσὼν",995,155],["ἐπὶ",9,1],["τὸν",1,6],["τράχηλον",692,7],["Βενιαμὶν",358,105],["τοῦ",1,30],["ἀδελφοῦ",67,21],["αὐτοῦ",3,48],["ἔκλαυσεν",412,3],["ἐπʼ",9,1],["αὐτῷ",3,49],["καὶ",2,8],["Βενιαμὶν",358,105],["ἔκλαυσεν",412,3],["ἐπὶ",9,1],["τῷ",1,110],["τραχήλῳ",692,113],["αὐτοῦ",3,48]],"And he fell on his brother Benjamin's neck, and wept on him; and Benjamin wept on his neck."],["15",[["Καὶ",2,8],["καταφιλήσας",1890,155],["πάντας",11,58],["τοὺς",1,56],["ἀδελφοὺς",67,31],["αὐτοῦ",3,48],["ἔκλαυσεν",412,3],["ἐπʼ",9,1],["αὐτοῖς",3,142],["καὶ",2,8],["μετὰ",29,1],["ταῦτα",16,248],["ἐλάλησαν",50,141],["οἱ",1,128],["ἀδελφοὶ",67,51],["αὐτοῦ",3,48],["πρὸς",15,1],["αὐτόν",3,82]],"And he kissed all his brethren, and wept on them; and after these things his brethren spoke to him."],["16",[["Καὶ",2,8],["διεβοήθη",4743,38],["ἡ",1,11],["φωνὴ",95,13],["εἰς",8,1],["τὸν",1,6],["οἶκον",34,7],["Φαραὼ",184,149],["λέγοντες",31,137],["ἥκασιν",0,0],["οἱ",1,128],["ἀδελφοὶ",67,51],["Ἰωσήφ",262,105],["ἐχάρη",698,38],["δὲ",14,12],["Φαραὼ",184,149],["καὶ",2,8],["ἡ",1,11],["θεραπεία",3536,13],["αὐτοῦ",3,48]],"And the report was carried into the house of Pharao, saying, Joseph's brethren are come; and Pharao was glad, and his household."],["17",[["Εἶπε",18,3],["δὲ",14,12],["Φαραὼ",184,149],["πρὸς",15,1],["Ἰωσὴφ",262,105],["εἰπον",18,267],["τοῖς",1,1