,["καὶ",2,8],["ἰδοὺ",51,17],["ἑπτὰ",179,57],["στάχυες",1916,51],["ἀνέβαινον",87,129],["ἐν",4,1],["τῷ",1,110],["πυθμένι",3644,113],["ἑνὶ",57,111],["ἐκλεκτοὶ",551,130],["καὶ",2,8],["καλοί",264,130]],"And he dreamed again. And, behold, seven ears came up on one stalk, choice and good."],["6",[["Καὶ",2,8],["ἰδοὺ",51,17],["ἑπτὰ",179,57],["στάχυες",1916,51],["λεπτοὶ",1551,51],["καὶ",2,8],["ἀνεμόφθοροι",0,0],["ἀνεφύοντο",5219,131],["μετʼ",29,1],["αὐτούς",3,60]],"And, behold, seven ears thin and blasted with the wind, grew up after them."],["7",[["Καὶ",2,8],["κατέπιον",1183,141],["οἱ",1,128],["ἑπτὰ",179,57],["στάχυες",1916,51],["οἱ",1,128],["λεπτοὶ",1551,51],["καὶ",2,8],["ἀνεμόφθοροι",0,0],["τοὺς",1,56],["ἑπτὰ",179,57],["στάχυας",1916,31],["τοὺς",1,56],["ἐκλεκτοὺς",551,58],["καὶ",2,8],["τοὺς",1,56],["πλήρεις",489,58],["ἠγέρθη",745,38],["δὲ",14,12],["Φαραὼ",183,149],["καὶ",2,8],["ἦν",10,14],["ἐνύπνιον",647,20]],"And the seven thin ears and blasted with the wind devoured the seven choice and full ears; and Pharao awoke, and it was a dream."],["8",[["Ἐγένετο",30,26],["δὲ",14,12],["πρωῒ",501,17],["καὶ",2,8],["ἐταράχθη",508,38],["ἡ",1,11],["ψυχὴ",62,13],["αὐτοῦ",3,48],["καὶ",2,8],["ἀποστείλας",83,155],["ἐκάλεσε",128,3],["πάντας",11,58],["τοὺς",1,56],["ἐξηγητὰς",5351,31],["Αἰγύπτου",93,19],["καὶ",2,8],["πάντας",11,58],["τοὺς",1,56],["σοφοὺς",322,58],["αὐτῆς",3,83],["καὶ",2,8],["διηγήσατο",797,26],["αὐτοῖς",3,142],["Φαραὼ",183,149],["τὸ",1,32],["ἐνύπνιον",647,33],["αὐτοῦ",3,48],["καὶ",2,8],["οὐκ",12,17],["ἦν",10,14],["ὁ",1,4],["ἀπαγγέλλων",272,67],["αὐτὸ",3,121],["τῷ",1,110],["Φαραώ",183,149]],"And it was morning, and his soul was troubled; and he sent and called all the interpreters of Egypt, and all her wise men; and Pharao related to them his dream, and there was no one to interpret it to Pharao."],["9",[["Καὶ",2,8],["ἐλάλησεν",50,3],["ὁ",1,4],["ἀρχιοινοχόος",3416,5],["πρὸς",15,1],["Φαραὼ",183,149],["λέγων",31,67],["τὴν",1,9],["ἁμαρτίαν",119,10],["μου",6,48],["ἀναμιμνήσκω",1650,149],["σήμερον",205,17]],"And the chief cupbearer spoke to Pharao, saying, I this day remember my fault:"],["10",[["Φαραὼ",183,149],["ὠργίσθη",725,38],["τοῖς",1,138],["παισὶν",126,139],["αὐτοῦ",3,48],["καὶ",2,8],["ἔθετο",109,26],["ἡμᾶς",6,60],["ἐν",4,1],["φυλακῇ",483,2],["ἐν",4,1],["τῷ",1,110],["οἴκῳ",34,113],["τοῦ",1,30],["ἀρχιμαγείρου",1749,21],["ἐμέ",6,82],["τε",207,12],["καὶ",2,8],["τὸν",1,6],["ἀρχισιτοποιόν",3718,7]],"Pharao was angry with his servants, and put us in prison in the house of the captain of the guard, both me and the chief baker."],["11",[["Καὶ",2,8],["εἴδομεν",73,288],["ἐνύπνιον",647,20],["ἀμφότεροι",456,130],["ἐν",4,1],["νυκτὶ",216,2],["μιᾷ",57,96],["ἐγὼ",6,158],["καὶ",2,8],["αὐτὸς",3,158],["ἕκαστος",170,16],["κατὰ",32,1],["τὸ",1,32],["αὐτοῦ",3,48],["ἐνύπνιον",647,33],["εἴδομεν",73,288]],"And we had a dream both in one night, I and he; we saw, each according to his dream."],["12",[["Ἦν",10,14],["δὲ",14,12],["ἐκεῖ",76,17],["μεθʼ",29,1],["ἡμῶν",6,41],["νεανίσκος",568,5],["παῖς",126,5],["Ἑβραῖος",1090,5],["τοῦ",1,30],["ἀρχιμαγείρου",1749,21],["καὶ",2,8],["διηγησάμεθα",797,318],["αὐτῷ",3,49],["καὶ",2,8],["συνέκρινεν",2499,3],["ἡμῖν",6,142]],"And there was there with us a young man, a Hebrew servant of the captain of the guard; and we related to him [our dreams], and he interpreted [them] to us."],["13",[["Ἐγενήθη",30,38],["δὲ",14,12],["καθὼς",218,17],["συνέκρινεν",2499,3],["ἡμῖν",6,142],["οὕτω",70,17],["καὶ",2,8],["συνέβη",980,3],["ἐμέ",6,82],["τε",207,12],["ἀποκατασταθῆναι",1150,174],["ἐπὶ",9,1],["τὴν",1,9],["ἀρχήν",269,10],["μου",6,48],["ἐκεῖνον",79,82],["δὲ",14,12],["κρεμασθῆναι",1380,174]],"And it came to pass, as he interpreted them to us, so also it happened, both that I was restored to my office, and that he was hanged."],["14",[["Ἀποστείλας",83,155],["δὲ",14,12],["Φαραὼ",183,149],["ἐκάλεσε",128,3],["τὸν",1,6],["Ἰωσήφ",262,105],["καὶ",2,8],["ἐξήγαγον",299,141],["αὐτὸν",3,82],["ἀπὸ",17,1],["τοῦ",1,23],["ὀχυρώματος",772,24],["καὶ",2,8],["ἐξύρη