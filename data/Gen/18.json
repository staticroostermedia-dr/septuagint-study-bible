εἰς",8,1],["τὸν",1,6],["καιρὸν",132,7],["τοῦτον",16,259],["ἀναστρέψω",522,157],["πρὸς",15,1],["σὲ",5,161],["εἰς",8,1],["ὥρας",838,19],["καὶ",2,8],["ἔσται",10,89],["τῇ",1,95],["Σάῤῥᾳ",999,2],["υἱός",13,5]],"Shall anything be impossible with the Lord? At this time I will return to thee seasonably, and Sarrha shall have a son."],["15",[["Ἠρνήσατο",3710,252],["δὲ",14,12],["Σάῤῥα",999,13],["λέγουσα",31,183],["οὐκ",12,17],["ἐγέλασα",2071,147],["ἐφοβήθη",134,38],["γάρ",40,12],["Καὶ",2,8],["εἶπεν",18,3],["αὐτῇ",3,99],["οὐχὶ",330,12],["ἀλλὰ",108,17],["ἐγέλασας",2071,154]],"But Sarrha denied, saying, I did not laugh, for she was afraid. And he said to her, Nay, but thou didst laugh."],["16",[["Ἐξαναστάντες",1292,190],["δὲ",14,12],["ἐκεῖθεν",430,17],["οἱ",1,128],["ἄνδρες",38,51],["κατέβλεψαν",7330,141],["ἐπὶ",9,1],["πρόσωπον",47,33],["Σοδόμων",1179,45],["καὶ",2,8],["Γομόῤῥας",0,0],["Ἁβραὰμ",294,105],["δὲ",14,12],["συνεπορεύετο",1836,22],["μετʼ",29,1],["αὐτῶν",3,41],["συμπροπέμπων",6099,67],["αὐτούς",3,60]],"And the men having risen up from thence looked towards Sodom and Gomorrha. And Abraam went with them, attending them on their journey."],["17",[["Ὁ",1,4],["δὲ",14,12],["Κύριος",7,5],["εἶπε",18,3],["οὐ",12,17],["μὴ",25,8],["κρύψω",372,157],["ἐγὼ",6,158],["ἀπὸ",17,1],["Ἁβραὰμ",294,105],["τοῦ",1,30],["παιδός",127,21],["μου",6,48],["ἃ",1,11],["ἐγὼ",6,179],["ποιῶ",23,149]],"And the Lord said, Shall I hide from Abraam my servant what things I intend to do?"],["18",[["Ἁβραὰμ",294,105],["δὲ",14,12],["γινόμενος",30,114],["ἔσται",10,89],["εἰς",8,1],["ἔθνος",60,33],["μέγα",66,29],["καὶ",2,8],["πολὺ",74,29],["καὶ",2,8],["ἐνευλογηθήσονται",3433,135],["ἐν",4,1],["αὐτῷ",3,49],["πάντα",11,65],["τὰ",1,42],["ἔθνη",60,43],["τῆς",1,18],["γῆς",26,19]],"But Abraam shall become a great and populous nation, and in him shall all the nations of the earth be blest."],["19",[["Ἤδειν",0,0],["γὰρ",40,12],["ὅτι",19,8],["συντάξει",450,120],["τοῖς",1,138],["υἱοῖς",13,139],["αὐτοῦ",3,48],["καὶ",2,8],["τῷ",1