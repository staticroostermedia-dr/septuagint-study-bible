ὸ",1,32],["σπέρμα",218,33],["μου",6,48],["μηδὲ",414,12],["τὸ",1,32],["ὄνομά",57,33],["μου",6,48],["ἀλλὰ",108,17],["κατὰ",32,1],["τὴν",1,9],["δικαιοσύνην",187,10],["ἣν",24,124],["ἐποίησα",23,147],["μετὰ",29,1],["σοῦ",5,146],["ποιήσεις",23,159],["μετʼ",29,1],["ἐμοῦ",6,48],["καὶ",2,8],["τῇ",1,95],["γᾗ",26,105],["ᾗ",24,102],["σὺ",5,156],["παρῴκησας",782,154],["ἐν",4,1],["αὐτῇ",3,99]],"Now therefore swear to me by God that thou wilt not injure me, nor my seed, nor my name, but according to the righteousness which I have performed with thee thou shalt deal with me, and with the land in which thou hast sojourned."],["24",[["Καὶ",2,8],["εἶπεν",18,3],["Ἁβραὰμ",294,105],["ἐγὼ",6,158],["ὀμοῦμαι",347,177]],"And Abraam said, I will swear."],["25",[["Καὶ",2,8],["ἤλεγξεν",752,3],["Ἁβραὰμ",294,105],["τὸν",1,6],["Ἀβιμέλεχ",0,0],["περὶ",72,1],["τῶν",1,44],["φρεάτων",877,45],["τοῦ",1,23],["ὕδατος",85,24],["ὧν",24,97],["ἀφείλοντο",369,184],["οἱ",1,128],["παῖδες",127,51],["τοῦ",1,30],["Ἀβιμέλεχ",0,0]],"And Abraam reproved Abimelech because of the wells of water, which the servants of Abimelech took away."],["26",[["Καὶ",2,8],["εἶπεν",18,3],["αὐτῷ",3,49],["Ἀβιμέλεχ",0,0],["οὐκ",12,17],["ἔγνων",79,147],["τίς",39,150],["ἐποίησέ",23,3],["σοι",5,151],["τὸ",1,32],["ῥῆμα",116,33],["τοῦτο",16,122],["οὐδὲ",106,12],["σύ",5,156],["μοι",6,49],["ἀπήγγειλας",273,154],["οὐδὲ",106,12],["ἐγὼ",6,158],["ἤκουσα",54,147],["ἀλλʼ",108,17],["ἢ",61,8],["σήμερον",205,17]],"And Abimelech said to him, I know not who has done this thing to thee, neither didst thou tell it me, neither heard I it but only to-day."],["27",[["Καὶ",2,8],["ἔλαβεν",46,3],["Ἁβραὰμ",294,105],["πρόβατα",194,43],["καὶ",2,8],["μόσχους",256,31],["καὶ",2,8],["ἔδωκε",33,3],["τῷ",1,110],["Ἀβιμέλεχ",0,0],["καὶ",2,8],["διέθεντο",619,184],["ἀμφότεροι",459,130],["διαθήκην",169,10]],"And Abraam took sheep and calves, and gave them to Abimelech, and both made a covenant."],["28",[["Καὶ",2,8],["ἔστησεν",78,3],["Ἁβραὰμ",294,105],["ἑπτὰ",180,57],["ἀμνάδας",1650,40],["προβάτων",194,45],["μόνας",302,109]],"And Abraam set seven ewe-lambs by themselves."],["29",[["Καὶ",2,8],["εἶπεν",18,3],["Ἀβιμέλεχ",0,0],["τῷ",1,110],["Ἁβραὰμ",294,105],["τί",39,119],["εἰσιν",10,191],["αἱ",1,185],["ἑπτὰ",180,57],["ἀμνάδες",1650,180],["τῶν",1,44],["προβάτων",194,45],["τούτων",16,214],["ἃς",24,186],["ἔστησας",78,154],["μόνας",302,109]],"And Abimelech said to Abraam, What are these seven ewe-lambs which thou hast set alone?"],["30",[["Καὶ",2,8],["εἶπεν",18,3],["Ἁβραὰμ",294,105],["ὅτι",19,8],["τὰς",1,39],["ἑπτὰ",180,57],["ἀμνάδας",1650,40],["λήψῃ",46,116],["παρʼ",73,1],["ἐμοῦ",6,48],["ἵνα",102,8],["ὦσι",10,265],["μοι",6,49],["εἰς",8,1],["μαρτύριον",225,33],["ὅτι",19,8],["ἐγὼ",6,158],["ὤρυξα",1373,147],["τό",1,32],["φρέαρ",877,33],["τοῦτο",16,122]],"And Abraam said, Thou shalt receive the seven ewe-lambs of me, that they may be for me as a witness, that I dug this well."],["31",[["Διὰ",56,1],["τοῦτο",16,122],["ἐπωνόμασε",1293,3],["τὸ",1,32],["ὄνομα",57,33],["τοῦ",1,30],["τόπου",99,21],["ἐκείνου",80,48],["Φρέαρ",877,33],["ὁρκισμοῦ",3766,21],["ὅτι",19,8],["ἐκεῖ",76,17],["ὤμοσαν",347,141],["ἀμφότεροι",459,130]],"Therefore he named the name of that place, The Well of the Oath, for there they both swore."],["32",[["Καὶ",2,8],["διέθεντο",619,184],["διαθήκην",169,10],["ἐν",4,1],["τῷ",1,52],["φρέατι",877,53],["τοῦ",1,30],["ὁρκισμου",3766,21],["ἀνέστη",121,3],["δὲ",14,12],["Ἀβιμέλεχ",0,0],["Ὁχοζὰθ",12129,0],["ὁ",1,4],["νυμφαγωγὸς",4924,5],["αὐτοῦ",3,48],["καὶ",2,8],["Φίχολ",13854,0],["ὁ",1,4],["ἀρχιστράτηγος",1698,5],["τῆς",1,18],["δυνάμεως",98,19],["αὐτοῦ",3,48],["καὶ",2,8],["ἐπέστρεψαν",117,141],["εἰς",8,1],["τὴν",1,9],["γῆν",26,10],["τῶν",1,76],["Φυλιστιείμ",0,0]],"And they made a covenant at the well of the oath. And there rose up Abimelech, Ochozath his friend, and Phichol the commander-in-chief of his army, and they returned to the land of the Phylistines."],["33",[["Καὶ",2,8],["ἐφύτευσεν",1022,3],["Ἁβραὰμ",294,105],["ἄρουραν",5266,10],["ἐπὶ",9,