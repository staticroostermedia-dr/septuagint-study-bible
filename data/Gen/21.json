,831,28],["ἔστω",10,35],["ἐναντίον",138,17],["σου",5,146],["περὶ",72,1],["τοῦ",1,23],["παιδίου",449,24],["καὶ",2,8],["περὶ",72,1],["τῆς",1,18],["παιδίσκης",605,19],["πάντα",11,65],["ὅσα",103,43],["ἂν",83,12],["εἴπῃ",18,160],["σοι",5,151],["Σάῤῥα",999,13],["ἄκουε",54,239],["τῆς",1,18],["φωνῆς",95,19],["αὐτῆς",3,83],["ὅτι",19,8],["ἐν",4,1],["Ἰσαὰκ",451,105],["κληθήσεταί",128,125],["σοι",5,151],["σπέρμα",218,20]],"But God said to Abraam, Let it not be hard before thee concerning the child, and concerning the bondwoman; in all things whatsoever Sarrha shall say to thee, hear her voice, for in Isaac shall thy seed be called."],["13",[["Καὶ",2,8],["τὸν",1,6],["υἱὸν",13,7],["δὲ",14,12],["τῆς",1,18],["παιδίσκης",605,19],["ταύτης",16,290],["εἰς",8,1],["ἔθνος",60,33],["μέγα",66,29],["ποιήσω",23,227],["αὐτὸν",3,82],["ὅτι",19,8],["σπέρμα",218,20],["σόν",405,20],["ἐστιν",10,87]],"And moreover I will make the son of this bondwoman a great nation, because he is thy seed."],["14",[["Ἀνέστη",121,3],["δὲ",14,12],["Ἁβραὰμ",294,105],["τὸ",1,32],["πρωῒ",504,17],["καὶ",2,8],["ἔλαβεν",46,3],["ἄρτους",197,31],["καὶ",2,8],["ἀσκὸν",2213,7],["ὕδατος",85,24],["καὶ",2,8],["ἔδωκεν",33,3],["τῇ",1,95],["Ἄγαρ",2413,105],["καὶ",2,8],["ἐπέθηκεν",239,3],["ἐπὶ",9,1],["τὸν",1,6],["ὦμον",1011,7],["αὐτῆς",3,83],["τὸ",1,32],["παιδίον",449,33],["καὶ",2,8],["ἀπέστειλεν",84,3],["αὐτήν",3,98],["Ἀπελθοῦσα",297,140],["δὲ",14,12],["ἐπλανᾶτο",464,22],["κατὰ",32,1],["τὴν",1,9],["ἔρημον",160,37],["κατὰ",32,1],["τὸ",1,32],["φρέαρ",877,33],["τοῦ",1,30],["ὅρκου",946,21]],"And Abraam rose up in the morning and took loaves and a skin of water, and gave [them] to Agar, and he put the child on her shoulder, and sent her away, and she having departed wandered in the wilderness near the well of the oath."],["15",[["Ἐξέλιπε",321,3],["δὲ",14,12],["τὸ",1,32],["ὕδωρ",85,33],["ἐκ",21,1],["τοῦ",1,30],["ἀσκου",2213,21],["καὶ",2,8],["ἔῤῥιψε",615,3],["τὸ",1,32],["παιδίον",449,33],["ὑποκάτω",599,17],["μιᾶς",58,78],["ἐλάτης",5300,19]],