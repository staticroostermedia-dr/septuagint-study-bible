[["1",[["Καὶ",2,8],["Κύριος",7,5],["ἐπεσκέψατο",375,252],["τὴν",1,9],["Σάῤῥαν",999,10],["καθὰ",520,17],["εἶπε",18,3],["καὶ",2,8],["ἐποίησε",23,3],["Κύριος",7,5],["τῇ",1,95],["Σάῥῥᾳ",999,105],["καθὰ",520,17],["ἐλάλησε",50,3]],"And the Lord visited Sarrha, as he said, and the Lord did to Sarrha, as he spoke."],["2",[["Καὶ",2,8],["συλλαβοῦσα",507,140],["ἔτεκε",251,3],["τῷ",1,110],["Ἁβραὰμ",294,105],["υἱὸν",13,7],["εἰς",8,1],["τὸ",1,32],["γῆρας",1267,33],["εἰς",8,1],["τὸν",1,6],["καιρὸν",132,7],["καθὰ",520,17],["ἐλάλησεν",50,3],["αὐτῷ",3,49],["Κύριος",7,5]],"And she conceived and bore to Abraam a son in old age, at the set time according as the Lord spoke to him."],["3",[["Καὶ",2,8],["ἐκάλεσεν",128,3],["Ἁβραὰμ",294,105],["τὸ",1,32],["ὄνομα",57,33],["τοῦ",1,30],["υἱοῦ",13,21],["αὐτοῦ",3,48],["τοῦ",1,30],["γενομένου",30,288],["αὐτῷ",3,49],["ὃν",24,106],["ἔτεκεν",251,3],["αὐτῷ",3,49],["Σάῤῥα",999,13],["Ἰσαάκ",451,105]],"And Abraam called the name of his son that was born to him, whom Sarrha bore to him, Isaac."],["4",[["Περιέτεμε",1222,3],["δὲ",14,12],["Ἁβραὰμ",294,105],["τὸν",1,6],["Ἰσαὰκ",451,105],["τῇ",1,95],["ἡμέρᾳ",28,2],["τῇ",1,95],["ὀγδόῃ",1027,96],["καθὰ",520,17],["ἐνετείλατο",143,26],["αὐτῷ",3,49],["ὁ",1,4],["Θεός",20,5]],"And Abraam circumcised Isaac on the eighth day, as God commanded him."],["5",[["Καὶ",2,8],["Ἁβραὰμ",294,105],["ἦν",10,14],["ἑκατὸν",243,57],["ἐτῶν",81,45],["ηνίκα",543,105],["ἐγένετο",30,26],["αὐτῷ",3,49],["Ἰσαὰκ",451,105],["ὁ",1,4],["υἱὸς",13,5],["αὐτοῦ",3,48]],"And Abraam was a hundred years old when Isaac his son was born to him."],["6",[["Εἶπε",18,3],["δὲ",14,12],["Σάῤῥα",999,13],["γέλωτά",1883,7],["μοι",6,49],["ἐποίησε",23,3],["Κύριος",7,5],["ὃς",24,246],["γὰρ",40,12],["ἂν",83,12],["ἀκούσῃ",54,160],["συγχαρεῖταί",6089,89],["μοι",6,49]],"And Sarrha said, The Lord has made laughter for me, for whoever shall hear shall rejoice with me."],["7",[["Καὶ",2,8],["εἶπε",18,3],["τίς",39,150],["ἀναγγελεῖ",231,120],["τῷ",1,110],["Ἁβραὰμ",294,105],["ὅτι"