[["1",[["Ἐγένετο",30,26],["δὲ",14,12],["ἡ",1,11],["ζωὴ",216,13],["Σάῤῥας",999,19],["ἔτη",81,43],["ἑκατὸν",243,57],["εἰκοσιεπτά",3056,105]],"And the life of Sarrha was an hundred and twenty-seven years."],["2",[["Καὶ",2,8],["ἀπέθανε",109,3],["Σάῤῥα",999,13],["ἐν",4,1],["πόλει",41,2],["Ἀρβὸκ",0,0],["ἥ",1,11],["ἐστιν",10,87],["ἐν",4,1],["τῷ",1,52],["κοιλώματι",3867,53],["αὕτη",16,101],["ἔστι",10,87],["Χεβρὼν",703,5],["ἐν",4,1],["τῇ",1,95],["γῇ",26,2],["Χαναάν",544,105],["ἦλθε",55,3],["δὲ",14,12],["Ἁβραὰμ",294,105],["κόψασθαι",593,103],["Σάῤῥαν",999,10],["καὶ",2,8],["πενθῆσαι",736,100]],"And Sarrha died in the city of Arboc, which is in the valley, this is Chebron in the land of Chanaan; and Abraam came to lament for Sarrha and to mourn."],["3",[["Καὶ",2,8],["ἀνέστη",121,3],["Ἁβραὰμ",294,105],["ἀπὸ",17,1],["τοῦ",1,30],["νεκροῦ",659,153],["αὐτοῦ",3,48],["καὶ",2,8],["εἶπεν",18,3],["Ἁβραὰμ",294,105],["τοῖς",1,138],["υἱοῖς",13,139],["τοῦ",1,30],["Χὲτ",0,0],["λέγων",31,67]],"And Abraam stood up from before his dead; and Abraam spoke to the sons of Chet, saying,"],["4",[["Πάροικος",1421,16],["καὶ",2,8],["παρεπίδημος",5909,16],["ἐγώ",6,158],["εἰμι",10,149],["μεθʼ",29,1],["ὑμῶν",5,136],["δότε",33,69],["μοι",6,49],["οὖν",227,12],["κτῆσιν",1274,10],["τάφου",865,21],["μεθʼ",29,1],["ὑμῶν",5,136],["καὶ",2,8],["θάψω",392,157],["τὸν",1,6],["νεκρόν",659,59],["μου",6,48],["ἀπʼ",17,1],["ἐμοῦ",6,48]],"I am a sojourner and a stranger among you, give me therefore possession of a burying-place among you, and I will bury my dead away from me."],["5",[["Ἀπεκρίθησαν",234,94],["δὲ",14,12],["οἱ",1,128],["υἱοὶ",13,51],["Χὲτ",0,0],["πρὸς",15,1],["Ἁβραὰμ",294,105],["λέγοντες",31,137],["μὴ",25,8],["κύριε",7,250]],"And the sons of Chet answered to Abraam, saying, Not so, Sir,"],["6",[["Ἄκουσον",54,198],["δὲ",14,12],["ἡμῶν",6,41],["βασιλεὺς",22,5],["παρὰ",73,1],["Θεοῦ",20,21],["σὺ",5,156],["εἶ",10,145],["ἐν",4,1],["ἡμῖν",6,142],["ἐν",4,1],["τοῖς",1,138],["ἐκλεκτοῖς",552,215],["μνημείοις",2176,92],["ἡμῶν",6,41],["θάψον",392,171],["τὸν",1,6],["νεκρόν",659,59],["σου",5,146],["οὐδεὶς",228,16],["γὰρ",40,12],["ἡμῶν",6,41],["οὐ",12,17],["μὴ",25,8],["κωλύσει",1440,120],["τὸ",1,32],["μνημεῖον",2176,33],["αὐτοῦ",3,48],["ἀπὸ",17,1],["σοῦ",5,146],["τοῦ",1,30],["θάψαι",392,100],["τὸν",1,6],["νεκρόν",659,59],["σου",5,146],["ἐκεῖ",76,17]],"but hear us; thou art in the midst of us a king from God; bury thy dead in our choice sepulchres, for not one of us will by any means withhold his sepulchre from thee, so that thou shouldest not bury thy dead there."],["7",[["Ἀναστὰς",121,155],["δὲ",14,12],["Ἁβραὰμ",294,105],["προσεκύνησε",298,3],["τῷ",1,110],["λαῷ",35,113],["τῆς",1,18],["γῆς",26,19],["τοῖς",1,138],["υἱοῖς",13,139],["τοῦ",1,30],["Χέτ",0,0]],"And Abraam rose up and did obeisance to the people of the land, to the sons of Chet."],["8",[["Καὶ",2,8],["ἐλάλησε",50,3],["πρὸς",15,1],["αὐτοὺς",3,60],["Ἁβραὰμ",294,105],["λέγων",31,67],["εἰ",77,8],["ἔχετε",124,84],["τῇ",1,95],["ψυχῇ",63,2],["ὑμῶν",5,136],["ὥστε",346,17],["θάψαι",392,100],["τὸν",1,6],["νεκρόν",659,59],["μου",6,48],["ἀπὸ",17,1],["προσώπου",47,24],["μου",6,48],["ἀκούσατέ",54,69],["μου",6,48],["καὶ",2,8],["λαλήσατε",50,69],["περὶ",72,1],["ἐμοῦ",6,48],["Ἐφρὼν",0,0],["τῷ",1,110],["τοῦ",1,30],["Σαάρ",0,0]],"And Abraam spoke to them, saying, If ye have it in your mind that I should bury my dead out of my sight, hearken to me, and speak for me to Ephron the son of Saar."],["9",[["Καὶ",2,8],["δότω",33,46],["μοι",6,49],["τὸ",1,32],["σπήλαιον",939,33],["τὸ",1,32],["διπλοῦν",2167,47],["ὅ",1,4],["ἐστιν",10,87],["αὐτῷ",3,49],["τὸ",1,32],["ὂν",10,47],["ἐν",4,1],["μέρει",471,53],["τοῦ",1,30],["ἀγροῦ",252,21],["αὐτοῦ",3,48],["ἀργυρίου",152,24],["τοῦ",1,23],["ἀξίου",1102,88],["δότε",33,69],["μοι",6,49],["αὐτὸ",3,121],["ἐν",4,1],["ὑμῖν",5,86],["εἰς",8,1],["κτῆσιν",1274,10],["μνημείου",2176,24]],"And let him give me the double cave which he has, which is in a part of his field, let him give it me for the money it is worth for possession of a burying-place among you."],["10",[["Ἐφρὼν",0,0],["δὲ",14,12],["ἐκάθητο",419,22],["ἐν",4,1],["μέσῳ",113,34],["τῶν",1,76],["υἱῶν",13,77],["Χέτ",0,0],["ἀποκριθεὶς",234,206],["δὲ",14,12],["Ἐφρὼν",0,0],["ὁ",1,4],["Χετταῖος",1055,16],["πρὸς",15,1],["Ἁβραὰμ",294,105],["εἶπεν",18,3],["ἀκουόντων",54,164],["τῶν",1,76],["υἱῶν",13,77],["Χὲτ",0,0],["καὶ",2,8],["τῶν",1,76],["εἰσπορευομένων",376,295],["εἰς",8,1],["τὴν",1,9],["πόλιν",41,10],["πάντων",11,163],["λέγων",31,67]],"Now Ephron was sitting in the midst of the children of Chet, and Ephron the Chettite answered Abraam and spoke in the hearing of the sons of Chet, and of all who entered the city, saying,"],["11",[["Παρʼ",73,1],["ἐμοὶ",6,49],["γενοῦ",30,275],["κύριε",7,250],["καὶ",2,8],["ἄκουσόν",54,198],["μου",6,48],["τὸν",1,6],["ἀγρὸν",252,7],["καὶ",2,8],["τὸ",1,32],["σπήλαιον",939,33],["τὸ",1,32],["ἐν",4,1],["αὐτῷ",3,49],["σοὶ",5,151],["δίδωμι",33,149],["ἐναντίον",138,17],["πάντων",11,163],["τῶν",1,76],["πολιτῶν",2036,77],["μου",6,48],["δέδωκά",33,85],["σοι",5,151],["θάψον",392,171],["τὸν",1,6],["νεκρόν",659,59],["σου",5,146]],"Attend to me, my lord, and hear me, I give to thee the field and the cave which is in it; I have given it thee before all my countrymen; bury thy dead."],["12",[["Καὶ",2,8],["προσεκύνησεν",298,3],["Ἁβραὰμ",294,105],["ἐναντίον",138,17],["τοῦ",1,30],["λαοῦ",35,21],["τῆς",1,18],["γῆς",26,19]],"And Abraam did obeisance before the people of the land."],["13",[["Καὶ",2,8],["εἶπε",18,3],["τῷ",1,110],["Ἐφρὼν",0,0],["εἰς",8,1],["τὰ",1,42],["ὦτα",328,43],["ἐναντίον",138,17],["τοῦ",1,30],["λαοῦ",35,21],["τῆς",1,18],["γῆς",26,19],["ἐπειδὴ",1995,8],["πρὸς",15,1],["ἐμοῦ",6,48],["εἶ",10,145],["ἄκουσόν",54,198],["μου",6,48],["τὸ",1,32],["ἀργύριον",152,33],["τοῦ",1,30],["ἀγροῦ",252,21],["λάβε",46,198],["παρʼ",73,1],["ἐμοῦ",6,48],["καὶ",2,8],["θάψω",392,157],["τὸν",1,6],["νεκρόν",659,59],["μου",6,48],["ἐκεῖ",76,17]],"And he said in the ears of Ephron before the people of the land, Since thou art on my side, hear me; take the price of the field from me, and I will bury my dead there."],["14",[["Ἀπεκρίθη",234,38],["δὲ",14,12],["Ἐφρὼν",0,0],["τῷ",1,110],["Ἁβραὰμ",294,105],["λέγων",31,67]],"But Ephron answered Abraam, saying,"],["15",[["Οὐχὶ",330,12],["κύριε",7,250],["ἀκήκοα",54,85],["γὰρ",40,12],["γῆ",26,13],["τετρακοσίων",811,79],["διδράχμων",1624,45],["ἀργύριου",152,24],["ἀλλὰ",108,17],["τί",39,119],["ἂν",83,12],["εἴη",10,273],["τοῦτο",16,122],["ἀνὰ",415,1],["μέσον",113,29],["ἐμοῦ",6,48],["καὶ",2,8],["σοῦ",5,146],["σὺ",5,156],["δὲ",14,12],["τὸν",1,6],["νεκρόν",659,59],["σου",5,146],["θάψον",392,171]],"Nay, my lord, I have heard indeed, the land [is worth] four hundred silver didrachms, but what can this be between me and thee? nay, do thou bury thy dead."],["16",[["καὶ",2,8],["ἤκουσεν",54,3],["Ἁβραὰμ",294,105],["τοῦ",1,30],["Ἐφρών",0,0],["καὶ",2,8],["ἀπεκατέστησεν",0,0],["Ἁβραὰμ",294,105],["τῷ",1,110],["Ἐφρὼν",0,0],["τὸ",1,32],["ἀργύριον",152,33],["ὃ",1,4],["ἐλάλησεν",50,3],["εἰς",8,1],["τὰ",1,42],["ὦτα",328,43],["τῶν",1,76],["υἱῶν",13,77],["Χὲτ",0,0],["τετρακόσια",811,65],["δίδραχμα",1624,43],["ἀργυρίου",152,24],["δοκίμου",3529,88],["ἐμπόροις",1609,139]],"And Abraam hearkened to Ephron, and Abraam rendered to Ephron the money, which he mentioned in the ears of the sons of Chet, four hundred didrachms of silver approved with merchants."],["17",[["Καὶ",2,8],["ἔστη",78,3],["ὁ",1,4],["ἀγρὸς",252,5],["Ἐφρών",0,0],["ὃς",24,246],["ἦν",10,14],["ἐν",4,1],["τῷ",1,52],["διπλῷ",4208,53],["σπηλαίῳ",939,53],["ὅς",24,246],["ἐστι",10,87],["κατὰ",32,1],["πρόσωπον",47,33],["Μαμβρῆ",0,0],["ὁ",1,4],["ἀγρὸς",252,5],["καὶ",2,8],["τὸ",1,32],["σπήλαιον",939,33],["ὃ",1,4],["ἦν",10,14],["ἐν",4,1],["αὐτῷ",3,49],["καὶ",2,8],["πᾶν",11,29],["δένδρον",1342,33],["ὃ",1,4],["ἦν",10,14],["ἐν",4,1],["τῷ",1,110],["ἀγρῷ",252,113],["καὶ",2,8],["πᾶν",11,29],["ὅ",1,4],["ἐστιν",10,87],["ἐν",4,1],["τοῖς",1,91],["ὁρίοις",236,92],["αὐτοῦ",3,48],["κύκλῳ",258,17]],"And the field of Ephron, which was in Double Cave, which is opposite Mambre, the field and the cave, which was in it, and every tree which was in the field, and whatever is in its borders round about, were made sure"],["18",[["τῷ",1,110],["Ἁβραὰμ",294,105],["εἰς",8,1],["κτῆσιν",1274,10],["ἐναντίον",138,17],["τῶν",1,76],["υἱῶν",13,77],["Χὲτ",0,0],["καὶ",2,8],["πάντων",11,163],["τῶν",1,76],["εἰσπορευομένων",376,295],["εἰς",8,1],["τὴν",1,9],["πόλιν",41,10]],"to Abraam for a possession, before the sons of Chet, and all that entered into the city."],["19",[["Μετὰ",29,1],["ταῦτα",16,248],["ἔθαψεν",392,3],["Ἁβραὰμ",294,105],["Σάῤῥαν",999,10],["τὴν",1,9],["γυναῖκα",59,10],["αὐτοῦ",3,48],["ἐν",4,1],["τῷ",1,52],["σπηλαίῳ",939,53],["τοῦ",1,30],["ἀγροῦ",252,21],["τῷ",1,110],["διπλῷ",4208,113],["ὅ",1,4],["ἐστιν",10,87],["ἀπέναντι",583,17],["Μαμβρῆ",0,0],["αὕτη",16,101],["ἐστὶ",10,87],["Χεβρὼν",703,5],["ἐν",4,1],["τῇ",1,95],["γῇ",26,2],["Χαναάν",544,105]],"After this Abraam buried Sarrha his wife in the Double Cave of the field, which is opposite Mambre, this is Chebron in the land of Chanaan."],["20",[["Καὶ",2,8],["ἐκυρώθη",1516,38],["ὁ",1,4],["ἀγρὸς",252,5],["καὶ",2,8],["τὸ",1,32],["σπήλαιον",939,33],["ὃ",1,4],["ἦν",10,14],["ἐν",4,1],["αὐτῷ",3,49],["τῷ",1,110],["Ἁβραὰμ",294,105],["εἰς",8,1],["κτῆσιν",1274,10],["τάφου",865,21],["παρὰ",73,1],["τῶν",1,76],["υἱῶν",13,77],["Χέτ",0,0]],"So the field and the cave which was in it were made sure to Abraam for possession of a burying place, by the sons of Chet."]]