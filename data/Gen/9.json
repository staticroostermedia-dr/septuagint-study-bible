[["1",[["Καὶ",2,8],["εὐλόγησεν",147,3],["ὁ",1,4],["Θεὸς",20,5],["τὸν",1,6],["Νῶε",960,105],["καὶ",2,8],["τοὺς",1,56],["υἱοὺς",13,31],["αὐτοῦ",3,48],["καὶ",2,8],["εἶπεν",18,3],["αὐτοῖς",3,142],["αὐξάνεσθε",1179,68],["καὶ",2,8],["πληθύνεσθε",315,68],["καὶ",2,8],["πληρώσατε",529,69],["τὴν",1,9],["γῆν",26,10],["καὶ",2,8],["κατακυριεύσατε",2091,69],["αὐτῆς",3,83]],"And God blessed Noe and his sons, and said to them, Increase and multiply, and fill the earth and have dominion over it."],["2",[["Καὶ",2,8],["ὁ",1,4],["τρόμος",1600,5],["καὶ",2,8],["ὁ",1,4],["φόβος",330,5],["ὑμῶν",5,136],["ἔσται",10,89],["ἐπὶ",9,1],["πᾶσι",11,90],["τοῖς",1,91],["θηρίοις",400,92],["τῆς",1,18],["γῆς",26,19],["ἐπὶ",9,1],["πάντα",11,65],["τὰ",1,42],["πετεινὰ",570,43],["τοῦ",1,30],["οὐρανοῦ",94,21],["καὶ",2,8],["ἐπὶ",9,1],["πάντα",11,65],["τὰ",1,42],["κινούμενα",993,203],["ἐπὶ",9,1],["τῆς",1,18],["γῆς",26,19],["καὶ",2,8],["ἐπὶ",9,1],["πάντας",11,58],["τοὺς",1,56],["ἰχθύας",1371,31],["τῆς",1,18],["θαλάσσης",137,19],["ὑπὸ",122,1],["χεῖρας",37,40],["ὑμῖν",5,86],["δέδωκα",33,85]],"And the dread and the fear of you shall be upon all the wild beasts of the earth, on all the birds of the sky, and on all things moving upon the earth, and upon all the fishes of the sea, I have placed them under your power."],["3",[["Καὶ",2,8],["πᾶν",11,29],["ἑρπετὸν",1109,33],["ὅ",1,4],["ἐστι",10,87],["ζῶν",117,67],["ὑμῖν",5,86],["ἔσται",10,89],["εἰς",8,1],["βρῶσιν",1243,10],["ὡς",36,8],["λάχανα",3893,43],["χόρτου",1044,21],["δέδωκα",33,85],["ὑμῖν",5,86],["τὰ",1,42],["πάντα",11,65]],"And every reptile which is living shall be to you for meat, I have given all things to you as the green herbs."],["4",[["Πλὴν",257,1],["κρέας",628,20],["ἐν",4,1],["αἵματι",148,53],["ψυχῆς",62,19],["οὐ",12,17],["φάγεσθε",153,117]],"But flesh with blood of life ye shall not eat."],["5",[["Καὶ",2,8],["γὰρ",40,12],["τὸ",1,32],["ὑμέτερον",4676,29],["αἷμα",148,33],["τῶν",1,123],["ψυχῶν",62,61],["ὑμῶν",5,136],["ἐκ",21,1],["χειρὸς",37,19],["πάντων",11,79],["τῶν",1,44],["θηρίων",400,45],["ἐκζητήσω",459,157],["αὐτό",3,121],["καὶ",2,8],["ἐκ",21,1],["χειρὸς",37,19],["ἀνθρώπου",43,21],["ἀδελφοῦ",66,21],["ἐκζητήσω",459,157],["τὴν",1,9],["ψυχὴν",62,10],["τοῦ",1,30],["ἀνθρώπου",43,21]],"For your blood of your lives will I require at the hand of all wild beasts, and I will require the life of man at the hand of [his] brother man."],["6",[["Ὁ",1,4],["ἐκχέων",435,67],["αἷμα",148,33],["ἀνθρώπου",43,21],["ἀντὶ",158,1],["τοῦ",1,23],["αἵματος",148,24],["αὐτοῦ",3,144],["ἐκχυθήσεται",435,125],["ὅτι",19,8],["ἐν",4,1],["εἰκόνι",1136,2],["Θεοῦ",20,21],["ἐποίησα",23,147],["τὸν",1,6],["ἄνθρωπον",43,7]],"He that sheds man's blood, instead of that blood shall his own be shed, for in the image of God I made man."],["7",[["Ὑμεῖς",5,208],["δὲ",14,12],["αὐξάνεσθε",1179,68],["καὶ",2,8],["πληθύνεσθε",315,68],["καὶ",2,8],["πληρώσατε",529,69],["τὴν",1,9],["γῆν",26,10],["καὶ",2,8],["κατακυριεύσατε",2091,69],["αὐτῆς",3,83]],"But do ye increase and multiply, and fill the earth, and have dominion over it."],["8",[["Καὶ",2,8],["εἶπεν",18,3],["ὁ",1,4],["Θεὸς",20,5],["τῷ",1,110],["Νῶε",960,105],["καὶ",2,8],["τοῖς",1,138],["υἱοῖς",13,139],["αὐτοῦ",3,48],["μετʼ",29,1],["αὐτοῦ",3,48],["λέγων",31,67]],"And God spoke to Noe, and to his sons with him, saying,"],["9",[["καὶ",2,8],["ἰδοὺ",51,17],["ἐγὼ",6,158],["ἀνίστημι",121,149],["τὴν",1,9],["διαθήκην",168,10],["μου",6,48],["ὑμῖν",5,86],["καὶ",2,8],["τῷ",1,52],["σπέρματι",214,53],["ὑμῶν",5,136],["μεθʼ",29,1],["ὑμᾶς",5,209]],"And behold I establish my covenant with you, and with your seed after you,"],["10",[["καὶ",2,8],["πάσῃ",11,96],["ψυχῇ",62,2],["ζώσῃ",117,210],["μεθʼ",29,1],["ὑμῶν",5,136],["ἀπὸ",17,1],["ὀρνέων",1240,45],["καὶ",2,8],["ἀπὸ",17,1],["κτηνῶν",219,45],["καὶ",2,8],["πᾶσι",11,90],["τοῖς",1,91],["θηρίοις",400,92],["τῆς",1,18],["γῆς",26,19],["ὅσα",102,63],["ἐστὶ",10,87],["μεθʼ",29,1],["ὑμῶν",5,136],["ἀπὸ",17,1],["πάντων",11,163],["τῶν",1,76],["ἐξελθόντων",84,211],["ἐκ",21,1],["τῆς",1,18],["κιβωτοῦ",271,19]],"and with every living creature with you, of birds and of beasts, and with all the wild beasts of the earth, as many as are with you, of all that come out of the ark."],["11",[["Καὶ",2,8],["στήσω",78,157],["τὴν",1,9],["διαθήκην",168,10],["μου",6,48],["πρὸς",15,1],["ὑμᾶς",5,209],["καὶ",2,8],["οὐκ",12,17],["ἀποθανεῖται",108,89],["πᾶσα",11,15],["σὰρξ",287,13],["ἔτι",110,17],["ἀπὸ",17,1],["τοῦ",1,23],["ὕδατος",85,24],["τοῦ",1,23],["κατακλυσμοῦ",1678,21],["καὶ",2,8],["οὐκ",12,17],["ἔτι",110,17],["ἔσται",10,89],["κατακλυσμὸς",1678,5],["ὕδατος",85,24],["καταφθεῖραι",1592,100],["πᾶσαν",11,37],["τὴν",1,9],["γῆν",26,10]],"And I will establish my covenant with you and all flesh shall not any more die by the water of the flood, and there shall no more be a flood of water to destroy all the earth."],["12",[["Καὶ",2,8],["εἶπε",18,3],["Κύριος",7,5],["ὁ",1,4],["Θεὸς",20,5],["πρὸς",15,1],["Νῶε",960,105],["τοῦτο",16,122],["τὸ",1,32],["σημεῖον",502,33],["τῆς",1,18],["διαθήκης",168,19],["ὃ",1,4],["ἐγὼ",6,158],["δίδωμι",33,149],["ἀνὰ",413,1],["μέσον",112,29],["ἐμοῦ",6,48],["καὶ",2,8],["ὑμῶν",5,136],["καὶ",2,8],["ἀνὰ",413,1],["μέσον",112,29],["πάσης",11,78],["ψυχῆς",62,19],["ζώσης",117,212],["ἥ",1,11],["ἐστι",10,87],["μεθʼ",29,1],["ὑμῶν",5,136],["εἰς",8,1],["γενεὰς",286,40],["αἰωνίους",388,109]],"And the Lord God said to Noe, This [is] the sign of the covenant which I set between me and you, and between every living creature which is with you for perpetual generations."],["13",[["Τὸ",1,32],["τόξον",712,33],["μου",6,48],["τίθημι",109,149],["ἐν",4,1],["τῇ",1,95],["νεφέλῃ",443,2],["καὶ",2,8],["ἔσται",10,89],["εἰς",8,1],["σημεῖον",502,33],["διαθήκης",168,19],["ἀνὰ",413,1],["μέσον",112,29],["ἐμοῦ",6,83],["καὶ",2,8],["τῆς",1,18],["γῆς",26,19]],"I set my bow in the cloud, and it shall be for a sign of covenant between me and the earth."],["14",[["Καὶ",2,8],["ἔσται",10,89],["ἐν",4,1],["τῷ",1,110],["συννεφεῖν",8484,54],["με",6,82],["νεφέλας",443,40],["ἐπὶ",9,1],["τὴν",1,9],["γῆν",26,1