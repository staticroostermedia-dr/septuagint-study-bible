[["1",[["ΑΝΤΙΓΡΑΦΟΝ",0,0],["ἐπιστολῆς",866,19],["ἧς",24,162],["ἀπέστειλεν",83,3],["Ἱερεμίας",479,5],["πρὸς",15,1],["τοὺς",1,56],["ἀχθησομένους",227,667],["αἰχμαλώτους",1616,31],["εἰς",8,1],["Βαβυλῶνα",204,10],["ὑπὸ",122,1],["τοῦ",1,30],["βασιλέως",22,21],["τῶν",1,76],["Βαβυλωνίων",2071,163],["ἀναγγεῖλαι",228,100],["αὐτοῖς",3,142],["καθότι",827,17],["ἐπετάγη",1406,38],["αὐτῷ",3,49],["ὑπὸ",122,1],["τοῦ",1,30],["Θεοῦ",20,21]],"A copy of an epistle, which Jeremy sent unto them which were to be led captives into Babylon by the king of the Babylonians, to certify them, as it was commanded him of God."],["2",[["Διὰ",54,1],["τὰς",1,39],["ἁμαρτίας",119,40],["ἃς",24,184],["ἡμαρτήκατε",244,334],["ἐναντίον",138,17],["τοῦ",1,30],["Θεοῦ",20,21],["ἀχθήσεσθε",227,258],["εἰς",8,1],["Βαβυλῶνα",204,10],["αἰχμάλωτοι",1616,51],["ὑπὸ",122,1],["Ναβουχοδονόσορ",0,0],["βασιλέως",22,21],["τῶν",1,76],["Βαβυλωνίων",2071,163]],"Because of the sins which ye have committed before God, ye shall be led away captives into Babylon by Nabuchodonosor king of the Babylonians."],["3",[["Εἰσελθόντες",88,188],["οὖν",223,12],["εἰς",8,1],["Βαβυλῶνα",204,10],["ἔσεσθε",10,117],["ἐκεῖ",76,17],["ἔτη",80,43],["πλείονα",938,65],["καὶ",2,8],["χρόνον",484,7],["μακρὸν",638,59],["ἕως",42,8],["γενεῶν",286,61],["ἑπτά",179,57],["μετὰ",29,1],["τοῦτο",16,122],["δὲ",14,12],["ἐξάξω",299,157],["ὑμᾶς",5,209],["ἐκεῖθεν",428,17],["μετʼ",29,1],["εἰρήνης",210,19]],"So when ye be come unto Babylon, ye shall remain there many years, and for a long season, namely, seven generations: and after that I will bring you away peaceably from thence."],["4",[["Νυνὶ",2106,17],["δὲ",14,12],["ὄψεσθε",111,117],["ἐν",4,1],["Βαβυλῶνι",204,2],["θεοὺς",20,31],["ἀργυροῦς",587,58],["καὶ",2,8],["χρυσοῦς",290,58],["καὶ",2,8],["ξυλίνους",1417,58],["ἐπʼ",9,1],["ὤμοις",1011,139],["αἰρομένους",248,230],["δεικνύντας",860,229],["φόβον",330,7],["τοῖς",1,91],["ἔθνεσιν",59,92]],"Now shall ye see in Babylon gods of silver, and of gold, and of wood, borne upon shoulders, which cause the nations to fear."],["5",[["Εὐλαβήθητε",1270,358],["οὖν",223,12],["μὴ",25,8],["καὶ",2,8],["ὑμεῖς",5,208],["ἀφομοιωθέντες",6387,244],["τοῖς",1,138],["ἀλλοφύλοις",203,215],["ἀφομοιωθῆτε",6387,494],["καὶ",2,8],["φόβος",330,5],["ὑμᾶς",5,209],["λὰβῃ",46,160],["ἐπʼ",9,1],["αὐτοῖς",3,142],["ἰδόντας",276,466],["ὄχλον",1008,7],["ἔμπροσθεν",387,17],["καὶ",2,8],["ὄπισθεν",1198,17],["αὐτῶν",3,41],["προσκυνοῦντας",296,229],["αὐτά",3,66]],"Beware therefore that ye in no wise be like to strangers, neither be ye afraid of them, when ye see the multitude before them and behind them, worshipping them."],["6",[["Εἴπατε",18,262],["δὲ",14,12],["τῇ",1,95],["διανοίᾳ",754,2],["σοὶ",5,151],["δεῖ",1161,14],["προσκυνεῖν",296,54],["δέσποτα",1013,251]],"But say ye in your hearts, O Lord, we must worship thee."],["7",[["Ὁ",1,4],["γὰρ",40,12],["ἄγγελός",206,5],["μου",6,48],["μεθʼ",29,1],["ὑμῶν",5,136],["ἐστιν",10,87],["αὐτός",3,158],["τε",207,12],["ἐκζητῶν",459,67],["τὰς",1,39],["ψυχὰς",62,40],["ὑμῶν",5,136]],"For mine angel is with you, and I myself caring for your souls."],["8",[["Γλῶσσα",385,13],["γὰρ",40,12],["αὐτῶν",3,41],["ἐστι",10,87],["κατεξυσμένη",7418,197],["ὑπὸ",122,1],["τέκτονος",1425,21],["αὐτά",3,66],["τε",207,12],["περίχρυσα",3618,65],["καὶ",2,8],["περιάργυρα",3332,65],["ψευδῆ",547,65],["δʼ",14,12],["ἐστὶ",10,87],["καὶ",2,8],["οὐ",12,17],["δύνανται",184,303],["λαλεῖν",50,54]],"As for their tongue, it is polished by the workman, and they themselves are gilded and laid over with gold; yet are they but false, and cannot speak."],["9",[["Καὶ",2,8],["ὥσπερ",221,17],["παρθένῳ",787,2],["φιλοκόσμῳ",8671,96],["λαμβάνοντες",46,137],["χρυσίον",202,20],["κατασκευάζουσι",1511,189],["στεφάνους",979,31],["ἐπὶ",9,1],["τὰς",1,39],["κεφαλὰς",144,40],["τῶν",1,76],["θεῶν",20,77],["αὐτῶν",3,41]],"And taking gold, as it were for a virgin that loveth to go gay, they make crowns for the heads of their gods."],["10",[["Ἔστι",10,87],["δὲ",14,12],["καὶ",2,8],["ὅτε",430,8],["ὑφαιρούμενοι",5459,356],["οἱ",1,128],["ἱερεῖς",64,31],["ἀπὸ",17,1],["τῶν",1,76],["θεῶν",20,77],["αὐτῶν",3,41],["χρυσίον",202,20],["καὶ",2,8],["ἀργύριον",150,20],["εἰς",8,1],["ἑαυτοὺς",92,60],["καταναλοῦσι",2092,189]],"Sometimes also the priests convey from their gods gold and silver, and bestow it upon themselves."],["11",[["Δώσουσι",33,207],["δὲ",14,12],["ἀπʼ",17,1],["αὐτῶν",3,41],["καὶ",2,8],["ταῖς",1,70],["ἐπὶ",9,1],["τοῦ",1,23],["στέγους",8377,24],["πόρναις",1146,71],["κοσμοῦσί",1767,189],["τε",207,12],["αὐτοὺς",3,60],["ὡς",36,8],["ἀνθρώπους",43,31],["τοῖς",1,91],["ἐνδύμασι",2547,92],["θεοὺς",20,31],["ἀργυροῦς",587,58],["καὶ",2,8],["θεοὺς",20,31],["χρυσοῦς",290,58],["καὶ",2,8],["ξυλίνους",1417,58]],"Yea, they will give thereof to the common harlots, and deck them as men with garments, [being] gods of silver, and gods of gold, and wood."],["12",[["Οὗτοι",16,213],["δὲ",14,12],["οὐ",12,17],["διασώζονται",727,303],["ἀπὸ",17,1],["ἰοῦ",794,360],["καὶ",2,8],["βρωμάτων",714,45],["περιβεβλημένων",743,646],["αὐτῶν",3,168],["ἱματισμὸν",1462,7],["πορφυροῦν",3940,59]],"Yet cannot these gods save themselves from rust and moths, though they be covered with purple raiment."],["13",[["Ἐκμάσσονται",5324,303],["τὸ",1,32],["πρόσωπον",47,33],["αὐτῶν",3,41],["διὰ",54,1],["τὸν",1,6],["ἐκ",21,1],["τῆς",1,18],["οἰκίας",232,19],["κονιορτὸν",1895,7],["ὅς",24,247],["ἐστι",10,87],["πλείων",938,16],["ἐπʼ",9,1],["αὐτοῖς",3,142]],"They wipe their faces because of the dust of the temple, when there is much upon them."],["14",[["Καὶ",2,8],["σκῆπτρον",1445,20],["ἔχει",124,87],["ὡς",36,8],["ἄνθρωπος",43,5],["κριτὴς",747,5],["χώρας",278,19],["ὃς",24,247],["τὸν",1,6],["εἰς",8,1],["αὐτὸν",3,82],["ἁμαρτάνοντα",244,177],["οὐκ",12,17],["ἀνελεῖ",645,120]],"And he that cannot put to death one that offendeth him holdeth a sceptre, as though he were a judge of the country."],["15",[["Ἔχει",124,87],["δὲ",14,12],["ἐγχειρίδιον",3732,20],["δεξιᾷ",282,96],["καὶ",2,8],["πέλεκυν",4393,10],["ἑαυτὸν",92,82],["δὲ",14,12],["ἐκ",21,1],["πολέμον",163,7],["καὶ",2,8],["λῃστῶν",2931,77],["οὐκ",12,17],["ἐξελεῖται",411,89]],"He hath also in his right hand a dagger and an axe: but cannot deliver himself from war and thieves."],["16",[["Ὅθεν",1154,17],["γνώριμοί",3260,130],["εἰσιν",10,189],["οὐκ",12,17],["ὄντες",10,137],["θεοί",20,51],["μὴ",25,8],["οὖν",223,12],["φοβηθῆτε",134,494],["αὐτούς",3,60]],"Whereby they are known not to be gods: therefore fear them not."],["17",[["Ὥσπερ",221,17],["γὰρ",40,12],["σκεῦος",181,33],["ἀνθρώπου",43,21],["συντριβὲν",267,391],["ἀχρεῖον",6395,29],["γῖνεται",30,108],["τοιοῦτοι",629,193],["ὑπάρχουσιν",416,479],["οἱ",1,128],["θεοὶ",20,51],["αὐτῶν",3,41],["καθιδρυμένων",4834,457],["αὐτῶν",3,41],["ἐν",4,1],["τοῖς",1,138],["οἴκοις",34,139],["οἱ",1,128],["ὀφθαλμοὶ",91,51],["αὐτῶν",3,41],["πλήρεις",489,130],["εἰσὶ",10,189],["κονιορτοῦ",1895,21],["ἀπὸ",17,1],["τῶν",1,76],["ποδῶν",208,77],["τῶν",1,76],["εἰσπορευομένων",380,299]],"For like as a vessel that a man useth is nothing worth when it is broken; even so it is with their gods: when they be set up in the temple, their eyes be full of dust through the feet of them that come in."],["18",[["Καὶ",2,8],["ὥσπερ",221,17],["τινὶ",39,442],["ἠδικηκότι",0,0],["βασιλέα",22,7],["περιπεφραγμέναι",0,0],["εἰσὶν",10,189],["αἱ",1,183],["αὐλαὶ",324,179],["ὡς",36,8],["ἐπὶ",9,1],["θανάτῳ",169,113],["ἀπηγμένῳ",1216,467],["τοὺς",1,56],["οἴκους",34,31],["αὐτῶν",3,41],["ὀχυροῦσιν",2157,189],["οἱ",1,128],["ἱερεῖς",64,31],["θυρώμασί",1625,92],["τε",207,12],["καὶ",2,8],["κλείθροις",3081,92],["καὶ",2,8],["μοχλοῖς",1168,139],["ὅπως",236,8],["ὑπὸ",122,1],["τῶν",1,76],["λῃστῶν",2931,77],["μὴ",25,8],["συληθῶσι",8415,267]],"And as the doors are made sure on every side upon him that offendeth the king, as being committed to suffer death; even so the priests make fast their temples with doors, with locks, and bars, lest [their gods] be spoiled with robbers."],["19",[["Λύχνους",1059,31],["καίουσι",667,189],["καὶ",2,8],["πλείους",74,130],["ἢ",60,8],["ἑαυτοῖς",92,142],["ὧν",24,97],["οὐδένα",225,59],["δύνανται",184,303],["ἰδεῖν",73,100]],"They light them candles, yea, more than for themselves, whereof they cannot see one."],["20",[["Ἔστι",10,87],["μὲν",281,12],["ὥσπερ",221,17],["δοκὸς",3528,13],["τῶν",1,76],["ἐκ",21,1],["τῆς",1,18],["οἰκίας",232,19],["τὰς",1,39],["δὲ",14,12],["καρδίας",63,19],["αὐτῶν",3,41],["φασιν",655,189],["ἐκλείχεσθαι",4081,104],["τῶν",1,76],["ἀπὸ",17,1],["τῆς",1,18],["γῆς",26,19],["ἑρπετῶν",1109,45],["κατεσθόντων",3551,80],["αὐτούς",3,60],["τε",207,12],["καὶ",2,8],["τὸν",1,6],["ἱματισμὸν",1462,7],["αὐτῶν",3,41],["οὐκ",12,17],["αἰσθάνονται",2569,502]],"They are as one of the beams of the temple, yet they say their hearts are gnawed upon by things creeping out of the earth; and when they eat them and their clothes, they feel it not."],["21",[["Μεμελανωμένοι",0,0],["τὸ",1,32],["πρόσωπον",47,33],["αὐτῶν",3,41],["ἀπὸ",17,1],["τοῦ",1,30],["καπνοῦ",1469,21],["τοῦ",1,30],["ἐκ",21,1],["τῆς",1,18],["οἰκίας",232,19]],"Their faces are blacked through the smoke that cometh out of the temple."],["22",[["Ἐπὶ",9,1],["τὸ",1,32],["σῶμα",451,33],["αὐτῶν",3,41],["καὶ",2,8],["ἐπὶ",9,1],["τὴν",1,9],["κεφαλὴν",144,10],["αὐτῶν",3,41],["ἐφίπτανται",9679,303],["νυκτερίδες",4341,179],["χελιδόνες",5160,179],["καὶ",2,8],["τὰ",1,42],["ὄρνεα",1240,43],["ὡσαύτως",1242,17],["δὲ",14,12],["καὶ",2,8],["οἱ",1,128],["αἴλουροι",6867,51]],"Upon their bodies and heads sit bats, swallows, and birds, and the cats also."],["23",[["Ὅθεν",1154,17],["γνώσεσθε",81,117],["ὅτι",19,8],["οὐκ",12,17],["εἰσὶ",10,189],["θεοί",20,51],["μὴ",25,8],["οὖν",223,12],["φοβεῖσθε",134,386],["αὐτά",3,66]],"By this ye may know that they are no gods: therefore fear them not."],["24",[["Τὸ",1,32],["γὰρ",40,12],["χρυσίον",202,33],["ὃ",1,4],["περίκεινται",5011,303],["εἰς",8,1],["κάλλος",887,20],["ἐὰν",45,8],["μή",25,8],["τις",39,150],["ἐκμάξῃ",5324,116],["τὸν",1,6],["ἰὸν",10,36],["οὐ",12,17],["μὴ",25,8],["στίλψωσιν",0,0],["οὐδὲ",105,12],["γὰρ",40,12],["ὅτε",430,8],["ἐχωνεύοντο",1845,131],["ᾐσθάνοντο",2569,524]],"Notwithstanding the gold that is about them to make them beautiful, except they wipe off the rust, they will not shine: for neither when they were molten did they feel it."],["25",[["Ἐκ",21,1],["πάσης",11,78],["τιμῆς",721,19],["ἠγορασμένα",0,0],["ἐστὶν",10,87],["ἐν",4,1],["οἷς",24,295],["οὐκ",12,17],["ἔστι",10,87],["πνεῦμα",167,20]],"The things wherein there is no breath are bought for a most high price."],["26",[["Ἄνευ",1103,1],["ποδῶν",208,77],["ἐπʼ",9,1],["ὤμοις",1011,139],["φέρονταὶ",201,303],["ἐνδεικνύμενοι",2531,356],["τὴν",1,9],["ἑαυτῶν",92,41],["ἀτιμίαν",1048,10],["τοῖς",1,138],["ἀνθρώποις",43,139]],"They are borne upon shoulders, having no feet, whereby they declare unto men that they be nothing worth."],["27",[["Αἰσχύνονταί",614,303],["τε",207,12],["καὶ",2,8],["οἱ",1,128],["θεραπεύοντες",1677,137],["αὐτὰ",3,66],["διὰ",54,1],["τὸ",1,32],["εἴποτε",5642,17],["ἐπὶ",9,1],["τὴν",1,9],["γῆν",26,10],["πέσῃ",154,160],["μὴ",25,8],["διʼ",54,1],["αὐτῶν",3,41],["ἀνίστασθαι",121,104],["μήτε",2105,12],["ἐάν",45,8],["τις",39,150],["αὐτὸ",3,121],["ὀρθὸν",1536,29],["στήσῃ",78,116],["διʼ",54,1],["ἑαυτοῦ",92,48],["κινηθήσεται",993,125],["μητε",2105,12],["ἐὰν",45,8],["κλιθῇ",829,337],["οὐ",12,17],["μὴ",25,8],["ὀρθωθῇ",3775,337],["ἀλλʼ",107,17],["ὥσπερ",221,17],["νεκροῖς",653,215],["τὰ",1,42],["δῶρα",347,43],["αὐτοῖς",3,142],["παρατίθεται",1277,108]],"They also that serve them are ashamed: for if they fall to the ground at any time, they cannot rise up again of themselves: neither, if one set them upright, can they move of themselves: neither, if they be bowed down, can they make themselves straight: but they set gifts before them, as unto dead men."],["28",[["Τὰς",1,39],["δὲ",14,12],["θυσίας",156,40],["αὐτῶν",3,41],["ἀποδόμενοι",311,319],["οἱ",1,128],["ἱερεῖς",64,31],["αὐτῶν",3,41],["καταχρῶνται",5746,303],["ὡσαύτως",1242,17],["δὲ",14,12],["καὶ",2,8],["αἱ",1,183],["γυναῖκες",58,179],["ἀπʼ",17,1],["αὐτῶν",3,41],["ταριχεύουσαι",8560,305],["οὐτε",476,17],["πτωχῷ",496,113],["οὔτε",476,17],["ἀδυνάτῳ",1648,111],["μὴ",25,8],["μεταδῶσι",3301,224]],"As for the things that are sacrificed unto them, their priests sell and abuse; in like manner their wives lay up part thereof in salt; but unto the poor and impotent they give nothing of it."],["29",[["Τῶν",1,123],["θυσιῶν",156,61],["αὐτῶν",3,187],["ἀποκαθημένη",3178,623],["καὶ",2,8],["λεχὼ",7634,13],["ἅπτονται",462,303],["γνόντες",81,188],["οὖν",223,12],["ἀπὸ",17,1],["τούτων",16,214],["ὅτι",19,8],["οὐκ",12,17],["εἰσὶ",10,189],["θεοὶ",20,51],["μὴ",25,8],["φοβηθῆτε",134,494],["αὐτούς",3,60]],"Menstruous women and women in childbed eat their sacrifices: by these things ye may know that they are no gods: fear them not."],["30",[["Πόθεν",1171,17],["γὰρ",40,12],["κληθείησαν",128,410],["θεοί",20,51],["ὅτι",19,8],["γυναῖκες",58,179],["παρατιθέασι",1277,189],["θεοῖς",20,139],["ἀργυροῖς",587,215],["και",2,8],["χρυσοῖς",290,215],["καὶ",2,8],["ξυλίνοις",1417,215]],"For how can they be called gods? because women set meat before the gods of silver, gold, and wood."],["31",[["Καὶ",2,8],["ἐν",4,1],["τοῖς",1,138],["οἴκοις",34,139],["αὐτῶν",3,41],["οἱ",1,128],["ἱερεῖς",64,31],["διφρεύουσιν",7103,189],["ἔχοντες",124,137],["τοὺς",1,56],["χιτῶνας",1255,31],["διεῤῥωγότας",673,277],["καὶ",2,8],["τὰς",1,39],["κεφαλὰς",144,40],["καὶ",2,8],["τοὺς",1,56],["πώγωνας",1913,31],["ἐξυρημένους",0,0],["ὧν",24,97],["αἱ",1,183],["κεφαλαὶ",144,179],["ἀκάλυπτοί",4511,185],["εἰσιν",10,189]],"And the priests sit in their temples, having their clothes rent, and their heads and beards shaven, and nothing upon their heads."],["32",[["Ὠρύονται",2694,303],["δὲ",14,12],["βοῶντες",364,137],["ἐναντίον",138,17],["τῶν",1,76],["θεῶν",20,77],["αὐτῶν",3,41],["ὥσπερ",221,17],["τινὲς",39,409],["ἐν",4,1],["περιδείπνῳ",7986,53],["νεκροῦ",653,153]],"They roar and cry before their gods, as men do at the feast when one is dead."],["33",[["Ἀπὸ",17,1],["τοῦ",1,30],["ἱματισμοῦ",1462,21],["αὐτῶν",3,41],["ἀφελόμενοι",367,319],["οἱ",1,128],["ἱερεῖς",64,31],["ἐνδύσουσι",515,207],["τὰς",1,39],["γυναῖκας",58,40],["αὐτῶν",3,41],["καὶ",2,8],["τὰ",1,42],["παιδία",447,43]],"The priests also take off their garments, and clothe their wives and children."],["34",[["Οὔτε",476,17],["ἐὰν",45,8],["κακὸν",161,29],["πάθωσιν",1976,224],["ὑπό",122,1],["τινος",39,308],["οὔτε",476,17],["ἐὰν",45,8],["ἀγαθὸν",113,29],["δυνήσονται",184,127],["ἀνταποδοῦναι",661,100],["οὔτε",476,17],["καταστῆσαι",313,100],["βασιλέα",22,7],["δύνανται",184,303],["οὔτε",476,17],["ἀφελέσθαι",367,103]],"Whether it be evil that one doeth unto them, or good, they are not able to recompense it: they can neither set up a king, nor put him down."],["35",[["Ὡσαύτως",1242,17],["οὔτε",476,17],["πλοῦτον",572,7],["οὔτε",476,17],["χαλκὸν",755,7],["οὐ",12,17],["μὴ",25,8],["δύνωνται",184,396],["διδόναι",33,54],["ἐάν",45,8],["τις",39,150],["εὐχὴν",631,10],["αὐτοῖς",3,142],["εὐξάμενος",666,245],["μὴ",25,8],["ἀποδῷ",311,160],["οὐ",12,17],["μὴ",25,8],["ἐπιζητήσωσιν",1937,224]],"In like manner, they can neither give riches nor money: though a man make a vow unto them, and keep it not, they will not require it."],["36",[["Ἐκ",21,1],["θανάτου",169,21],["ἄνθρωπον",43,7],["οὐ",12,17],["μὴ",25,8],["ῥύσωνται",335,222],["οὔτε",476,17],["ἥττονα",2338,74],["ἀπὸ",17,1],["ἰσχυροῦ",398,153],["μὴ",25,8],["ἐξέλωνται",411,222]],"They can save no man from death, neither deliver the weak from the mighty."],["37",[["Ἄνθρωπον",43,7],["τυφλὸν",1601,59],["εἰς",8,1],["ὅρασιν",505,10],["οὐ",12,17],["μὴ",25,8],["περιστήσωσιν",3625,224],["ἐν",4,1],["ἀνάγκῃ",1125,2],["ἄνθρωπον",43,7],["ὄντα",10,177],["οὐ",12,17],["μὴ",25,8],["ἐξέλωνται",411,222]],"They cannot restore a blind man to his sight, nor help any man in his distress."],["38",[["Χήραν",749,10],["οὐ",12,17],["μὴ",25,8],["ἐλεήσωσιν",457,224],["οὔτε",476,17],["ὀρφανὸν",959,28],["εὖ",975,17],["ποιήσωσι",23,224]],"They can shew no mercy to the widow, nor do good to the fatherless."],["39",[["Τοῖς",1,138],["ἀπὸ",17,1],["τοῦ",1,23],["ὄρους",86,24],["λίθοις",195,139],["ὡμοιωμὲνοι",0,0],["εἰσὶ",10,189],["τὰ",1,42],["ξύλινα",1417,65],["καὶ",2,8],["τὰ",1,42],["περίχρυσα",3618,65],["καὶ",2,8],["τὰ",1,42],["περιάργυρα",3332,65],["οἱ",1,128],["δὲ",14,12],["θεραπεύοντες",1677,137],["αὐτὰ",3,66],["καταισχυνθήσονται",716,135]],"Their gods of wood, and which are overlaid with gold and silver, are like the stones that be hewn out of the mountain: they that worship them shall be confounded."],["40",[["Πῶς",440,12],["οὖν",223,12],["νομιστέον",4339,20],["ἢ",60,8],["κλητέον",4286,20],["ὑπάρχειν",416,54],["αὐτοὺς",3,60],["θεοὺς",20,31],["ἔτι",110,17],["δὲ",14,12],["καὶ",2,8],["αὐτῶν",3,41],["τῶν",1,76],["Χαλδαίων",566,77],["ἀτιμαζόντων",1432,164],["αὐτά",3,66]],"How should a man then think and say that they are gods, when even the Chaldeans themselves dishonour them?"],["41",[["Οἳ",1,128],["ὅταν",318,8],["ἴδωσιν",73,224],["ἐνεὸν",5339,28],["μὴ",25,8],["δυνάμενον",184,201],["λαλῆσαι",50,100],["προσενεγκάμενοι",362,319],["τὸν",1,6],["Βῆλον",774,198],["ἀξιοῦσι",1126,189],["φωνῆσαι",1743,100],["ὠς",325,20],["δυνατοῦ",354,153],["ὄντος",10,143],["αὐτοῦ",3,48],["αἰσθὲσθαι",2569,103]],"Who if they shall see one dumb that cannot speak, they bring him, and intreat Bel that he may speak, as though he were able to understand."],["42",[["Καὶ",2,8],["οὐ",12,17],["δύνανται",184,303],["αὐτοὶ",3,193],["νοήσαντες",1384,188],["καταλιπεῖν",255,100],["αὐτὰ",3,66],["αἴσθησιν",1617,10],["γὰρ",40,12],["οὐκ",12,17],["ἐχουσιν",124,189]],"Yet they cannot understand this themselves, and leave them: for they have no knowledge."],["43",[["Αἱ",1,183],["δὲ",14,12],["γυναῖκες",58,179],["περιθέμεναι",1016,420],["σχοινὶα",1525,43],["ἐν",4,1],["ταῖς",1,70],["ὁδοῖς",67,71],["ἐγκάθηνται",1859,502],["θυμιῶσαι",921,305],["τὰ",1,42],["πίτυρα",7876,43],["ὅτας",0,0],["δέ",14,12],["τις",39,373],["αὐτῶν",3,41],["ἐφελκυσθεῖσα",4117,306],["ὑπό",122,1],["τινος",39,308],["τῶν",1,76],["παραπορευομένων",1251,299],["κοιμηθῇ",302,337],["τὴν",1,9],["π