,["ἑαυτοὺς",92,60],["οἱ",1,128],["ἱερεῖς",64,31],["ποῦ",477,17],["συναποκρυβῶσι",8456,267],["μετʼ",29,1],["αὐτῶν",3,41]],"For when there cometh any war or plague upon them, the priests consult with themselves, where they may be hidden with them."],["49",[["Πῶς",440,12],["οὖν",223,12],["οὐκ",12,17],["ἔστιν",10,87],["αἰσθέσθαι",2569,103],["ὅτι",19,8],["οὐκ",12,17],["εἰσί",10,189],["θεοί",20,51],["οἳ",1,128],["οὔτε",476,17],["σώζουσιν",171,189],["ἑαυτοὺς",92,60],["ἐκ",21,1],["πολέμου",163,21],["οὔτε",476,17],["ἐκ",21,1],["κακῶν",161,79]],"How then cannot men perceive that they be no gods, which can neither save themselves from war, nor from plague?"],["50",[["Ὑπάρχοντα",416,232],["γὰρ",40,12],["ξύλινα",1417,65],["καὶ",2,8],["περίχρυσα",3618,65],["καὶ",2,8],["περιάργυρα",3332,65],["γνωσθήσεται",81,125],["μετὰ",29,1],["ταῦτα",16,249],["ὅτι",19,8],["ἐστὶ",10,87],["ψευδῆ",547,74]],"For seeing they be but of wood, and overlaid with silver and gold, it shall be known hereafter that they are false:"],["51",[["Τοῖς",1,91],["ἔθνεσι",59,92],["πᾶσι",11,90],["τοῖς",1,91],["τε",207,12],["βασιλεῦσι",22,139],["φανερὸν",1981,28],["ἔσται",10,89],["ὃτι",19,8],["οὐκ",12,17],["εἰσὶ",10,189],["θεοὶ",20,51],["ἀλλὰ",107,17],["ἔργα",104,43],["χειρῶν",37,61],["ἀνθρώπων",43,77],["καὶ",2,8],["οὐδὲν",225,29],["Θεοῦ",20,21],["ἔργον",104,33],["ἐν",4,1],["αὐτοῖς",3,142],["ἐστι",10,87]],"and it shall manifestly appear to all nations and kings that they are no gods, but the works of men's hands, and that there is no work of God in them."],["52",[["Τίνι",39,442],["οὖν",223,12],["γνωστέον",6956,20],["ἐστὶν",10,87],["ὅτι",19,8],["οὐκ",12,17],["εἰσὶ",10,189],["θεοί",20,51]],"Who then may not know that they are no gods?"],["53",[["Βασιλὲα",22,7],["γὰρ",40,12],["χώρας",278,19],["οὐ",12,17],["μὴ",25,8],["ἀναστήσωσιν",121,224],["οὔτε",476,17],["ὑετὸν",672,7],["ἀνθρώποις",43,139],["οὐ",12,17],["μὴ",25,8],["δῶσι",33,224]],"For neither can they set up a king in the land, nor give rain unto men."],["54",[["Κρίσιν",226,10],["τε",207,12],["οὐ",12,17],["μὴ",25,8],["διακρίνωσιν",1507,224],["ἑαυτῶν",92,41],["οὐδὲ",105,12],["μὴ",25,8],["ῥύσωνται",335,222],["ἀδίκημα",1924,33],["ἀδὺνατοι",1648,130],["ὄντες",10,137],["ὥσπερ",221,17],["γὰρ",40,12],["κορῶναι",5780,179],["ἀναμέσον",211,28],["τοῦ",1,30],["οὐρανοῦ",94,21],["καὶ",2,8],["τῆς",1,18],["γῆς",26,19]],"Neither can they judge their own cause, nor redress a wrong, being unable: for they are as crows between heaven and earth."],["55",[["Καὶ",2,8],["γὰρ",40,12],["ὅταν",318,8],["ἐμπέσῃ",4090,160],["εἰς",8,1],["οἰκίαν",232,10],["θεῶν",20,77],["ξυλίνων",1417,163],["ἡ",1,11],["περιχρύσων",5009,129],["ἢ",60,8],["περιαργύρων",3332,163],["πῦρ",118,33],["οἱ",1,128],["μὲν",281,12],["ἱερεῖν",0,0],["φεύξονται",265,127],["καὶ",2,8],["διασωθήσονται",727,135],["αὐτοὶ",3,193],["δὲ",14,12],["ὥσπερ",221,17],["δοκοὶ",3528,179],["μέσοι",112,130],["κατακαυθήσονται",553,135]],"Whereupon when fire falleth upon the house of gods of wood, or laid over with gold or silver, their priests will flee away, and escape: but they themselves shall be burned asunder like beams."],["56",[["Βασιλεῖ",22,113],["δὲ",14,12],["καὶ",2,8],["πολεμίοις",1121,215],["οὐ",12,17],["μὴ",25,8],["ἀντιστῶσι",793,266],["πῶς",440,12],["οὖν",223,12],["ἐκδεκτέον",9356,20],["ἢ",60,8],["νομιστέον",4339,20],["ὅτι",19,8],["εἰσὶ",10,189],["θεοί",20,51]],"Moreover they cannot withstand any king or enemies: how can it then be thought or said that they be gods?"],["57",[["Οὔτε",476,17],["ἀπὸ",17,1],["κλεπτῶν",2367,77],["οὔτε",476,17],["ἀπὸ",17,1],["λῃστῶν",2931,77],["οὐ",12,17],["μὴ",25,8],["διασωθῶσι",727,267],["θεοὶ",20,51],["ξύλινον",1417,28],["καὶ",2,8],["περιάργυροι",3332,130],["καὶ",2,8],["περίχρυσοι",3618,130]],"Neither are those gods of wood, and laid over with silver or gold, able to escape either from thieves or robbers."],["58",[["ὧν",24,97],["οἱ",1,128],["ἰσχύοντες",565,137],["περιελοῦνται",863,127],["τὸ",1,32],["χρυσίον",202,33],["καὶ",2,8],["τὸ",1,32],["ἀργύριον",150,33],["καὶ",2,8],["τὸν",1,6],["ἱματισμὸν",1462,7],["τὸν",1,6],["περικείμενον",5011,447],["αὐτοῖς",3,142],["ἀπελεύσονται",305,127],["ἔχοντες",124,137],["οὔτε",476,17],["ἑαυτοῖς",92,142],["οὐ",12,17],["μὴ",25,8],["βοηθήσωσιν",552,224]],"Whose gold, and silver, and garments wherewith they are clothed, they that are strong do take, and go away withal: neither are they able to help themselves."],["59",[["Ὥστε",345,17],["κρεῖσσον",922,29],["εἶναι",10,54],["βασιλέα",22,7],["ἐπιδεικνύμενον",2330,364],["τὴν",1,9],["ἑαυτοῦ",92,48],["ἀνδρείαν",1487,37],["ἢ",60,8],["σκεῦος",181,33],["ἐν",4,1],["οἰκίᾳ",232,2],["χρήσιμον",2406,29],["ἐφʼ",9,1],["ᾧ",24,202],["κεχρήσεται",0,0],["ὁ",1,4],["κεκτημένος",533,228],["ἢ",60,8],["οἱ",1,128],["ψευδεῖς",547,130],["θεοί",20,51],["ἢ",60,8],["καὶ",2,8],["θύρα",277,13],["ἐν",4,1],["οἰκίᾳ",232,2],["διασώζουσα",727,181],["τὰ",1,42],["ἐν",4,1],["αὐτῇ",3,99],["ὄντα",10,177],["ἢ",60,8],["οἱ",1,128],["ψευδεῖς",547,130],["θεοί",20,51],["καὶ",2,8],["ξύλινος",1417,16],["στύλος",392,5],["ἐν",4,1],["βασιλείοις",4183,92],["ἤ",60,8],["οἱ",1,128],["ψευδεῖς",547,130],["θεοί",20,51]],"Therefore it is better to be a king that sheweth his power, or else a profitable vessel in an house, which the owner shall have use of, than such false gods; or to be a door in an house, to keep such things safe as be therein, than such false gods; or a pillar of wood in a palace, than such false gods."],["60",[["Ἥλιος",320,5],["μὲν",281,12],["γὰρ",40,12],["καὶ",2,8],["σελήνη",1211,13],["καὶ",2,8],["ἄστρα",1334,63],["ὄντα",10,292],["λαμπρὰ",3580,74],["καὶ",2,8],["ἀποστελλόμενα",83,64],["ἐπὶ",9,1],["χρείας",1006,19],["εὐήκοά",5660,74],["εἰσιν",10,189]],"For sun, moon, and stars, being bright, and sent to do their offices, are obedient."],["61",[["Ὡσαύτως",1242,17],["καὶ",2,8],["ἀστραπὴ",1854,13],["ὅταν",318,8],["ἐπιφανῇ",1709,116],["εὔοπτός",7259,16],["ἐστι",10,87],["τὸ",1,32],["δʼ",14,12],["αὐτὸ",3,121],["καὶ",2,8],["πνεῦμα",167,33],["ἐν",4,1],["πάσῃ",11,96],["χώρᾳ",278,2],["πνεῖ",3631,87]],"In like manner the lightning when it breaketh forth is easy to be seen: and after the same manner the wind bloweth in every country."],["62",[["Καὶ",2,8],["νεφέλαις",443,71],["ὅταν",318,8],["ἐπιταγῆ",4105,13],["ὑπὸ",122,1],["τοῦ",1,30],["Θεοῦ",20,21],["ἐπιπορεύεσθαι",3755,104],["ἐπιπορεύεσθαι",3755,104],["ἐφʼ",9,1],["ὅλην",233,37],["τὴν",1,9],["οἰκουμένην",1326,10],["συντελοῦσι",316,189],["τὸ",1,32],["ταχθέν",783,391]],"And when God commandeth the clouds to go over the whole world, they do as they are bidden."],["63",[["Τό",1,32],["τε",207,12],["πῦρ",118,33],["ἐξαποσταλὲν",217,391],["ἄνωθεν",1605,17],["ἐξαναλῶσαι",1494,100],["ὄρη",86,63],["καὶ",2,8],["δρυμοὺς",799,31],["ποιεῖ",23,87],["τὸ",1,32],["συνταχθὲν",450,391],["ταῦτα",16,249],["δὲ",14,12],["οὔτε",476,17],["ταῖς",1,70],["εἰδέαις",0,0],["οὔτε",476,17],["ταῖς",1,70],["δυνάμεσιν",98,71],["αὐτῶν",3,41],["ἀφωμοιωμένα",0,0],["ἐστίν",10,87]],"And the fire sent from above to consume hills and woods doeth as it is commanded: but these are like unto them neither in shew nor power."],["64",[["Ὅθεν",1154,17],["οὔτε",476,17],["νομιστέον",4339,20],["οὔτε",476,17],["κλητέον",4286,20],["ὑπάρχειν",416,54],["αὐτοὺς",3,60],["θεοὺς",20,31],["οὐ",12,17],["δυνατῶν",354,163],["ὄντων",10,164],["αὐτῶν",3,41],["οὔτε",476,17],["κλητέον",4286,20],["κρίναι",240,100],["οὔτε",476,17],["εὖ",975,17],["ποιῆσαι",23,100],["ἀνθρώποις",43,139]],"Wherefore it is neither to be supposed nor said that they are gods, seeing they are able neither to judge causes, nor to do good unto men."],["65",[["Γνόντες",81,188],["οὖν",223,12],["ὅτι",19,8],["οὐκ",12,17],["εἰσὶ",10,189],["θεοί",20,51],["μὴ",25,8],["φοβηθῆτε",134,494],["αὐτούς",3,60]],"Knowing therefore that they are no gods, fear them not."],["66",[["Οὔτε",476,17],["γὰρ",40,12],["βασιλεῦσιν",22,139],["οὐ",12,17],["μὴ",25,8],["καταράσωνται",778,222],["οὔτε",476,17],["μὴ",25,8],["εὐλογήσωσι",147,224]],"For they can neither curse nor bless kings:"],["67",[["Σημεῖά",502,63],["τε",207,12],["ἐν",4,1],["ἔθνεσιν",59,92],["ἐν",4,1],["οὐρανῷ",94,113],["οὐ",12,17],["μὴ",25,8],["δείξωσιν",860,224],["οὐδὲ",105,12],["ὡς",36,8],["ὁ",1,4],["ἥλιος",320,5],["λάμψουσιν",3296,355],["οὔτε",476,17],["φωτιοῦσιν",1232,355],["ὡς",36,8],["ἡ",1,11],["σελήνη",1211,13]],"neither can they shew signs in the heavens among the heathen, nor shine as the sun, nor give light as the moon."],["68",[["Τὰ",1,42],["θηρία",400,43],["αὐτῶν",3,41],["ἐστι",10,87],["κρείττω",922,74],["ἃ",1,11],["δύνανται",184,303],["ἐκφυγόντα",1860,381],["εἰς",8,1],["σκέπην",1189,10],["ἑαυτὰ",92,66],["ὠφελῆσαι",1500,100]],"The beasts are better than they: for they can get under a covert, and help themselves."],["69",[["Κατʼ",32,1],["οὐδένα",225,59],["οὖν",223,12],["τρόπον",243,7],["ἡμῖν",6,142],["ἑστι",6571,287],["φανερὸν",1981,28],["ὅτι",19,8],["εἰσὶ",10,189],["θεοί",20,51],["διὸ",1466,8],["μὴ",25,8],["φοβηθῆτε",134,494],["αὐτούς",3,60]],"It is then by no means manifest unto us that they are gods: therefore fear them not."],["70",[["Ὥσοερ",0,0],["γὰρ",40,12],["ἐν",4,1],["σικυηράτῳ",6075,53],["προβασκάνιον",8108,20],["οὐδὲν",225,28],["φυλάσσον",127,36],["οὕτως",70,17],["οἱ",1,128],["θεοὶ",20,51],["αὐτῶν",3,41],["εἰσι",10,189],["ξύλινοι",1417,130],["καὶ",2,8],["περίχρυσον",3618,28],["καὶ",2,8],["περιάργυροι",3332,130]],"For as a scarecrow in a garden of cucumbers keepeth nothing: so are their gods of wood, and laid over with silver and gold."],["71",[["τὸν",1,6],["αὐτὸν",3,82],["τρόπον",243,7],["καὶ",2,8],["τῇ",1,95],["ἐν",4,1],["κήπῳ",1325,113],["ῥάμνῳ",4160,113],["ἐφʼ",9,1],["ἧς",24,162],["πᾶν",11,29],["ὄρνεον",1240,33],["ἐπικάθηται",4625,511],["ὡσαύτως",1242,17],["δὲ",14,12],["καὶ",2,8],["νεκρῷ",653,111],["ἐῤῥιμμένῳ",2004,467],["ἐν",4,1],["σκότει",503,53],["ἀφωμοίωνται",0,0],["οἱ",1,128],["θεοὶ",20,51],["αὐτῶν",3,41],["ξύλινοι",1417,130],["καὶ",2,8],["περίχρυσοι",3618,130],["καὶ",2,8],["περιάργυροι",3332,130]],"And likewise their gods of wood, and laid over with silver and gold, are like to a white thorn in an orchard, that every bird sitteth upon; as also to a dead body, that is cast into the dark."],["72",[["Ἀπό",17,1],["τε",207,12],["τῆς",1,18],["πορφύρας",1062,19],["καὶ",2,8],["τῆς",1,18],["μαρμάρου",7784,21],["τῆς",1,18],["ἐπʼ",9,1],["αὐτοὺς",3,60],["σηπομένης",3150,434],["γνωσθήσονται",81,135],["ὅτι",19,8],["οὐκ",12,17],["εἰσὶ",10,189],["θεοί",20,51],["αὐτά",3,66],["τε",207,12],["ἐξ",21,1],["ὑστέρου",2012,153],["βρωθήσονται",1112,135],["καὶ",2,8],["ἔσται",10,89],["ὄνειδος",973,20],["ἐν",4,1],["τῇ",1,95],["χώρᾳ",278,2]],"And ye shall know them to be no gods by the bright purple that rotteth upon them: and they themselves afterward shall be eaten, and shall be a reproach in the country."],["73",[["Κρεῖσσον",922,29],["οὖ",12,17],["ἄνθρωπος",43,5],["δίκαιος",152,16],["οὐκ",12,17],["ἔχων",124,67],["εἴδωλα",626,43],["ἔσται",10,89],["γὰρ",40,12],["μακρὰν",638,37],["ἀπὸ",17,1],["ὀνειδισμοῦ",732,21]],"Better therefore is the just man that hath no idols: for he shall be far from reproach."]]