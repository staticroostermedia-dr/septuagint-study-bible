[["1",[["Κύριε",7,251],["παντοκράτωρ",338,5],["ὁ",1,4],["Θεὸς",20,5],["Ἰσραὴλ",27,105],["ψυχὴ",62,13],["ἐν",4,1],["στενοῖς",1980,215],["καὶ",2,8],["πνεῦμα",167,20],["ἀκηδιῶν",5194,36],["κέκραγε",590,165],["πρὸς",15,1],["σέ",5,161]],"O Lord Almighty, God of Israel, the soul in anguish, the troubled spirit, crieth unto thee."],["2",[["Ἄκουσον",53,198],["Κύριε",7,251],["καὶ",2,8],["ἐλέησον",457,243],["ὅτι",19,8],["ἡμάρτομεν",244,288],["ἐναντίον",138,17],["σου",5,146]],"Hear, O Lord, and have mercy; for thou art merciful: and have pity upon us, because we have sinned before thee."],["3",[["ὅτι",19,8],["σὺ",5,156],["καθήμενος",417,414],["τὸν",1,6],["αἰῶνα",100,7],["καὶ",2,8],["ἡμεῖς",6,193],["ἀπολλύμενοι",213,356],["τὸν",1,6],["αἰῶνα",100,7]],"For thou endurest for ever, and we perish utterly."],["4",[["Κύριε",7,251],["παντοκράτωρ",338,5],["ὁ",1,4],["Θεὸς",20,5],["Ἰσραὴλ",27,105],["ἄκουσον",53,198],["δὴ",193,12],["τῆς",1,18],["προσευχῆς",549,19],["τῶν",1,76],["τεθνηκότων",585,403],["Ἰσραὴλ",27,105],["καὶ",2,8],["υἱῶν",13,77],["τῶν",1,76],["ἁμαρτανόντων",244,164],["ἐναντίον",138,17],["σου",5,146],["οἳ",1,128],["οὐκ",12,17],["ἤκουσαν",53,141],["τῆς",1,18],["φωνῆς",95,19],["σου",5,146],["Θεοῦ",20,21],["αὐτῶν",3,41],["καὶ",2,8],["ἐκολλήθη",1272,38],["ἡμῖν",6,142],["τὰ",1,42],["κακά",161,65]],"O Lord Almighty, thou God of Israel, hear now the prayers of the dead Israelites, and of their children, which have sinned before thee, and not hearkened unto the voice of thee their God: for the which cause these plagues cleave unto us."],["5",[["Μὴ",25,8],["μνησθῇς",231,279],["ἀδικιῶν",288,61],["πατέρων",44,77],["ἡμῶν",6,41],["ἀλλὰ",107,17],["μνήσθητι",231,242],["χειρός",37,19],["σου",5,146],["καὶ",2,8],["ὀνόματός",55,24],["σου",5,146],["ἐν",4,1],["τῷ",1,110],["καιρῷ",132,113],["τούτῳ",16,289]],"Remember not the iniquities of our forefathers: but think upon thy power and thy name now at this time."],["6",[["ὅτι",19,8],["σὺ",5,156],["Κύριος",7,5],["ὁ",1,4],["Θεὸς",20,5],["ἡμῶν",6,41],["καὶ",2,8],["αἰνέσομέν",399,269],["σε",5,161],["Κύριε",7,251]],"For thou art the Lord our God, and thee, O Lord, will we praise."],["7",[["Ὅτι",19,8],["διὰ",54,1],["τοῦτο",16,122],["ἔδωκας",33,154],["τὸν",1,6],["φόβον",330,7],["σου",5,146],["ἐπὶ",9,1],["καρδίαν",63,10],["ἡμῶν",6,41],["καὶ",2,8],["ἐπικαλεῖσθαι",340,104],["τὸ",1,32],["ὄνομά",55,33],["σου",5,146],["καὶ",2,8],["αἰνέσομέν",399,269],["σε",5,161],["ἐν",4,1],["τῇ",1,95],["ἀποικίᾳ",1360,2],["ἡμῶν",6,41],["ὅτι",19,8],["ἀπεστρέψαμεν",130,288],["ἀπὸ",17,1],["καρδίας",63,19],["ἡμῶν",6,41],["πᾶσαν",11,37],["ἀδικίαν",288,10],["πατέρων",44,77],["ἡμῶν",6,41],["τῶν",1,76],["ἡμαρτηκότων",244,403],["ἐναντίον",138,17],["σου",5,146]],"And for this cause thou hast put thy fear in our hearts, to the intent that we should call upon thy name, and praise thee in our captivity: for we have called to mind all the iniquity of our forefathers, that sinned before thee."],["8",[["Ἰδοὺ",51,17],["ἡμεῖς",6,193],["σήμερον",205,17],["ἐν",4,1],["τῇ",1,95],["ἀποικίᾳ",1360,2],["ἡμῶν",6,41],["οὗ",120,17],["διέσπειρας",762,154],["ἡμᾶς",6,60],["ἐκεῖ",76,17],["εἰς",8,1],["ὀνειδισμὸν",732,7],["καὶ",2,8],["εἰς",8,1],["ἀρὰν",1217,10],["καὶ",2,8],["εἰς",8,1],["ὀφλησιν",9933,10],["κατὰ",32,1],["πάσας",11,109],["τὰς",1,39],["ἀδικίας",288,40],["πατέρων",44,77],["ἡμῶν",6,41],["οἳ",1,128],["ἀπέστησαν",514,141],["ἀπὸ",17,1],["Κυρίου",7,21],["Θεοῦ",20,21],["ἡμῶν",6,41]],"Behold, we are yet this day in our captivity, where thou hast scattered us, for a reproach and a curse, and to be subject to payments, according to all the iniquities of our fathers, which departed from the Lord our God."],["9",[["Ἄκουε",53,239],["Ἰσραὴλ",27,105],["ἐντολὰς",259,40],["ζωῆς",212,19],["ἐνωτίσασθε",1316,180],["γνῶναι",81,100],["φρόνησιν",834,10]],"Hear, Israel, the commandments of life: give ear to understand wisdom."],["10",[["Τί",39,119],["ἐστιν",10,87],["Ἰσραήλ",27,105],["τί",39,119],["ὅτι",19,8],["ἐν",4,1],["γῇ",26,2],["τῶν",1,76],["ἐχθρῶν",135,77],["εἶ",10,145],["ἐπαλαιώθης",1520,363],["ἐν",4,1],["γῇ",26,2],["ἀλλοτρίᾳ",377,96],["συνεμιάνθης",8425,363],["τοῖς",1,138],["νεκροῖς",653,215]],"How happeneth it, Israel, that thou art in thine enemies' land, that thou art waxen old in a strange country, that thou art defiled with the dead,"],["11",[["προσελογίσθης",3945,327],["μετὰ",29,1],["τῶν",1,76],["εἰς",8,1],["ᾅδου",583,21]],"that thou art counted with them that go down into the grave?"],["12",[["ἐγκατέλιπες",363,154],["τὴν",1,9],["πηγὴν",563,10],["τῆς",1,18],["σοφίας",238,19]],"Thou hast forsaken the fountain of wisdom."],["13",[["Τῇ",1,95],["ὁδῷ",67,2],["τοῦ",1,30],["Θεοῦ",20,21],["εἰ",77,8],["ἐπορεύθης",49,363],["κατῴκεις",90,216],["ἂν",82,12],["ἐν",4,1],["εἰρήνῃ",210,2],["τὸν",1,6],["αἰῶνα",100,7]],"For if thou hadst walked in the way of God, thou shouldest have dwelled in peace for ever."],["14",[["Μάθε",923,198],["ποῦ",477,17],["ἐστι",10,87],["φρόνησις",834,13],["ποῦ",477,17],["ἐστιν",10,87],["ἰσχὺς",180,13],["ποῦ",477,17],["ἐστιν",10,87],["σύνεσις",467,13],["τοῦ",1,30],["γνῶναι",81,100],["ἅμα",499,17],["ποῦ",477,17],["ἐστι",10,87],["μακροβίωσις",7679,13],["καὶ",2,8],["ζωὴ",212,13],["ποῦ",477,17],["ἐστι",10,87],["φῶς",376,20],["ὀφθαλμῶν",91,77],["καὶ",2,8],["εἰρήνη",210,13]],"Learn where is wisdom, where is strength, where is understanding; that thou mayest know also where is length of days, and life, where is the light of the eyes, and peace."],["15",[["Τίς",39,150],["εὗρε",106,3],["τὸν",1,6],["τόπον",99,7],["αὐτῆς",3,83],["καὶ",2,8],["τίς",39,150],["εἰσῆλθεν",88,3],["εἰς",8,1],["τοὺς",1,56],["θησαυροὺς",577,31],["αὐτῆς",3,83]],"Who hath found out her place? or who hath come into her treasures?"],["16",[["Ποῦ",477,17],["εἰσιν",10,189],["οἱ",1,128],["ἄρχοντες",96,51],["τῶν",1,44],["ἐθνῶν",59,45],["καὶ",2,8],["οἱ",1,128],["κυριεύοντες",886,137],["τῶν",1,44],["θηρίων",400,45],["τῶν",1,44],["ἐπὶ",9,1],["τῆς",1,18],["γῆς",26,19]],"Where are the princes of the heathen, and such as ruled the beasts upon the earth;"],["17",[["οἱ",1,128],["ἐν",4,1],["τοῖς",1,91],["ὀρνέοις",1240,92],["τοῦ",1,30],["οὐρανοῦ",94,21],["ἐμπαίζοντες",1862,137],["καὶ",2,8],["τὸ",1,32],["ἀργύριον",150,33],["θησαυρίζοντες",2461,137],["καὶ",2,8],["τὸ",1,32],["χρυσίον",202,33],["ᾧ",24,202],["ἐπεποίθεισαν",343,189],["ἄνθρωποι",43,51],["καὶ",2,8],["οὐκ",12,17],["ἔστι",10,87],["τέλος",369,33],["τῆς",1,18],["κτήσεως",1440,19],["αὐτῶν",3,41]],"they that had their pastime with the fowls of the air, and they that hoarded up silver and gold, wherein men trust, and made no end of their getting?"],["18",[["Ὅτι",19,8],["οἱ",1,128],["τὸ",1,32],["ἀργύριον",150,33],["τεκταίνοντες",2507,137],["καὶ",2,8],["μεριμνῶντες",2472,137],["καὶ",2,8],["οὐκ",12,17],["ἔστιν",10,87],["ἐξεύρεσις",6508,13],["τῶν",1,44],["ἔργων",104,45],["αὐτῶν",3,168]],"For they that wrought in silver, and were so careful, and whose works are unsearchable,"],["19",[["Ἠφανίσθησαν",675,94],["καὶ",2,8],["εἰς",8,1],["ᾅδου",583,21],["κατέβησαν",174,141],["καὶ",2,8],["ἄλλοι",581,193],["ἀνέστησαν",121,141],["ἀντʼ",158,1],["αὐτῶν",3,41]],"they are vanished and gone down to the grave, and others are come up in their stead."],["20",[["Νεώτεροι",513,130],["εἶδον",73,147],["φῶς",376,20],["καὶ",2,8],["κατῴκησαν",90,141],["ἐπὶ",9,1],["τῆς",1,18],["γῆς",26,19],["ὁδὸν",67,10],["δὲ",14,12],["ἐπιστήμης",892,19],["οὐκ",12,17],["ἔγνωσαν",81,141]],"Young men have seen light, and dwelt upon the earth; but the way of knowledge have they not known,"],["21",[["οὐδὲ",105,12],["συνῆκαν",602,141],["τρίβους",744,40],["αὐτῆς",3,83],["οὐδὲ",105,12],["ἀντελάβοντο",984,182],["αὐτῆς",3,83],["οἱ",1,128],["υἱοὶ",13,51],["αὐτῶν",3,41],["ἀπὸ",17,1],["τῆς",1,18],["ὁδοῦ",67,19],["αὐτῶν",3,41],["πόῤῥω",2117,17],["ἐγενήθησαν",30,94]],"nor understood the paths thereof, nor laid hold of it: their children were far off from that way."],["22",[["Οὐδὲ",105,12],["ἠκούσθη",53,38],["ἐν",4,1],["Χαναὰν",542,105],["οὐδὲ",105,12],["ὤφθη",111,38],["ἐν",4,1],["Θαιμάν",0,0]],"It hath not been heard of in Chanaan, neither hath it been seen in Theman."],["23",[["Οἵτε",9935,461],["υἱοὶ",13,51],["Ἄγαρ",2420,105],["οἱ",1,128],["ἐκζητοῦντες",459,137],["τὴν",1,9],["σύνεσιν",467,10],["οἱ",1,128],["ἐπὶ",9,1],["τῆς",1,18],["γῆς",26,19],["οἱ",1,128],["ἔμποροι",1609,51],["τῆς",1,18],["Μεῤῥὰν",0,0],["καὶ",2,8],["Θαιμὰν",0,0],["καὶ",2,8],["οἱ",1,128],["μυθολόγοι",7764,51],["καὶ",2,8],["οἱ",1,128],["ἐκζητηταὶ",9362,51],["τῆς",1,18],["συνέσεως",467,19],["ὁδὸν",67,10],["δὲ",14,12],["σοφίας",238,19],["οὐκ",12,17],["ἔγνωσαν",81,141],["οὐδὲ",105,12],["ἐμνήσθησαν",231,94],["τὰς",1,39],["τρίβους",744,40],["αὐτῆς",3,83]],"The Agarenes that seek wisdom upon earth, the merchants of Meran and of Theman, the authors of fables, and searchers out of understanding; none of these have known the way of wisdom, or remembered her paths."],["24",[["Ὦ",641,320],["Ἰσραὴλ",27,105],["ὡς",36,8],["μέγας",65,16],["ὁ",1,4],["οἶκος",34,5],["τοῦ",1,30],["Θεοῦ",20,21],["καὶ",2,8],["ἐπιμήκης",9598,16],["ὁ",1,4],["τόπος",99,5],["τῆς",1,18],["κτήσεως",1440,19],["αὐτοῦ",3,48]],"O Israel, how great is the house of God! and how large is the place of his possession!"],["25",[["Μέγας",65,16],["καὶ",2,8],["οὐκ",12,17],["ἔχει",124,87],["τελευτὴν",1564,10],["ὑψηλὸς",289,16],["καὶ",2,8],["ἀμέτρητος",3166,16]],"Great, and hath none end; high, and unmeasurable."],["26",[["Ἐκεῖ",76,17],["ἐγεννήθησαν",222,94],["οἱ",1,128],["γίγαντες",1160,51],["οἱ",1,128],["ὀνομαστοὶ",1946,51],["ἀπʼ",17,1],["ἀρχῆς",269,19],["γενόμενοι",30,319],["εὐμεγέθεις",5648,130],["ἐπιστάμενοι",623,319],["πόλεμον",163,7]],"There were the giants famous from the beginning, that were of so great stature, and so expert in war."],["27",[["Οὐ",12,17],["τούτους",16,274],["ἐξελέξατο",418,26],["ὁ",1,4],["Θεὸς",20,5],["οὐδὲ",105,12],["ὁδὸν",67,10],["ἐπιστήμης",892,19],["ἔδωκεν",33,3],["αὐτοῖς",3,142]],"Those did not the Lord choose, neither gave he the way of knowledge unto them:"],["28",[["Καὶ",2,8],["ἀπώλοντο",213,182],["παρὰ",72,1],["τὸ",1,32],["μὴ",25,8],["ἔχειν",124,54],["φρόνησιν",834,10],["ἀπώλοντο",213,182],["διὰ",54,1],["τὴν",1,9],["ἀβουλίαν",6253,10],["αὐτῶν",3,41]],"but they were destroyed, because they had no wisdom, and perished through their own foolishness."],["29",[["Τίς",39,150],["ἀνέβη",87,3],["εἰς",8,1],["τὸν",1,6],["οὐρανὸν",94,7],["καὶ",2,8],["ἔλαβεν",46,3],["αὐτὴν",3,98],["καὶ",2,8],["κατεβίβασεν",2729,3],["αὐτὴν",3,98],["ἐκ",21,1],["τῶν",1,123],["νεφελῶν",443,61]],"Who hath gone up into heaven, and taken her, and brought her down from the clouds?"],["30",[["Τίς",39,150],["διέβη",463,3],["πέραν",535,17],["τῆς",1,18],["θαλάσσης",137,19],["καὶ",2,8],["εὗρεν",106,3],["αὐτὴν",3,98],["καὶ",2,8],["οἴσει",201,120],["αὐτὴν",3,98],["χρυσίου",202,24],["ἐκλεκτοῦ",551,88]],"Who hath gone over the sea, and found her, and will bring her for pure gold?"],["31",[["Οὐκ",12,17],["ἔστιν",10,87],["ὁ",1,4],["γινώσκων",81,67],["τὴν",1,9],["ὁδὸν",67,10],["αὐτῆς",3,83],["οὐδὲ",105,12],["ὁ",1,4],["ἐνθυμούμενος",1863,114],["τὴν",1,9],["τρίβον",744,10],["αὐτῆς",3,83]],"No man knoweth her way, nor thinketh of her path."],["32",[["Ἀλλʼ",107,17],["ὁ",1,4],["εἰδὼς",73,265],["τὰ",1,42],["πάντα",11,65],["γινώσκει",81,87],["αὐτὴν",3,98],["ἐξεῦρεν",5350,3],["αὐτὴν",3,98],["τῇ",1,95],["συνέσει",467,2],["αὐτοῦ",3,48],["ὁ",1,4],["κατασκευάσας",1511,155],["τὴν",1,9],["γῆν",26,10],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["χρόνον",484,7],["ἐνέπλησεν",424,3],["αὐτὴν",3,98],["κτηνῶν",219,45],["τετραπόδων",1641,79]],"But he that knoweth all things knoweth her, and hath found her out with his understanding: he that prepared the earth for evermore hath filled it with fourfooted beasts:"],["33",[["Ὁ",1,4],["ἀποστέλλων",83,67],["τὸ",1,27],["φῶς",376,20],["καὶ",2,8],["πορεύεται",49,108],["ἐκάλεσεν",128,3],["αὐτὸ",3,121],["καὶ",2,8],["ὑπήκουσεν",868,3],["αὐτῷ",3,49],["τρόμῳ",1600,113]],"he that sendeth forth light, and it goeth, calleth it [again], and it obeyeth him with fear."],["34",[["Οἱ",1,128],["δὲ",14,12],["ἀστέρες",1703,51],["ἔλαμψαν",3296,141],["ἐν",4,1],["ταῖς",1,70],["φυλακαῖς",483,71],["αὐτῶν",3,41],["καὶ",2,8],["εὐφράνθησαν",242,94],["ἐκάλεσεν",128,3],["αὐτοὺς",3,60],["καὶ",2,8],["εἶπον",18,141],["πάρεσμεν",900,241],["ἔλαμψαν",3296,141],["μετʼ",29,1],["εὐφροσύνης",360,19],["τῷ",1,110],["ποιήσαντι",23,359],["αὐτούς",3,60]],"The stars shined in their watches, and rejoiced: when he calleth them, they say, Here we be; and so with cheerfulness they shewed light unto him that made them."],["35",[["Οὗτος",16,112],["ὁ",1,4],["Θεὸς",20,5],["ἡμῶν",6,41],["οὐ",12,17],["λογισθήσεται",494,399],["ἕτερος",253,16],["πρὸς",15,1],["αὐτόν",3,82]],"This is our God, and there shall none other be accounted of in comparison of him."],["36",[["Ἐξεῦρε",5350,3],["πᾶσαν",11,37],["ὁδὸν",67,10],["ἐπιστήμης",892,19],["καὶ",2,8],["ἔδωκεν",33,3],["αὐτὴν",3,98],["Ἰακὼβ",146,105],["τῷ",1,110],["παιδὶ",126,113],["αὐτοῦ",3,48],["καὶ",2,8],["Ἰσραὴλ",27,105],["τῷ",1,110],["ἠγαπημένῳ",0,0],["ὑπʼ",122,1],["αὐτοῦ",3,48]],"He hath found out all the way of knowledge, and hath given it unto Jacob his servant, and to Israel his beloved."],["37",[["Μετὰ",29,1],["τοῦτο",16,122],["ἐπὶ",9,1],["τῆς",1,18],["γῆς",26,19],["ὤφθη",111,38],["καὶ",2,8],["ἐν",4,1],["τοῖς",1,138],["ἀνθρώποις",43,139],["συνανεστράφη",5094,38]],"Afterward did he shew himself upon earth, and conversed with men."]]