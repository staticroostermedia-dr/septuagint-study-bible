[["1",[["Τί",39,119],["μέλλεις",1143,145],["ὦ",646,316],["τύραννε",784,250],["ἕτοιμοι",904,130],["γάρ",40,12],["ἐσμεν",10,241],["ἀποθνήσκειν",109,54],["ἢ",61,8],["παραβαίνειν",788,54],["τὰς",1,39],["πατρίους",2041,40],["ἡμῶν",6,41],["ἐντολάς",259,40]],"Why delayest thou, O tyrant? for we are readier to die than to transgress the injunctions of our fathers."],["2",[["Καὶ",2,8],["αἰσχυνόμεθα",611,388],["γὰρ",40,12],["τοὺς",1,56],["προγόνους",2623,31],["εἰκότως",7133,17],["εἰ",77,8],["μὴ",25,8],["τῇ",1,95],["τοῦ",1,30],["νόμου",140,21],["εὐπειθείᾳ",4777,2],["καὶ",2,8],["συμβούλῳ",1447,113],["γνώσει",753,2],["χρησαίμεθα",928,660]],"And we should be disgracing our fathers if we did not obey the law, and take knowledge for our guide."],["3",[["Σύμβουλε",1447,250],["τύραννε",784,250],["παρανομίας",2932,40],["μὴ",25,8],["ἡμᾶς",6,221],["μισῶν",351,67],["ὑπὲρ",139,1],["αὐτοὺς",3,60],["ἡμᾶς",6,60],["ἐλέα",183,63]],"O tyrant, counsellor of law-breaking, do not, hating us as thou dost, pity us more than we pity ourselves."],["4",[["Χαλεπώτερον",2645,17],["γὰρ",40,12],["αὐτοὺς",3,60],["τοῦ",1,30],["θανάτου",170,21],["νομίζομεν",2179,241],["εἶναί",10,54],["σου",5,146],["τὸν",1,6],["ἐπὶ",9,1],["τῇ",1,95],["παρανόμῳ",830,96],["σωτηρίᾳ",425,2],["ἡμῶν",6,41],["ἔλεον",183,7]],"For we account your pity of us on the terms of unlawful escape to be worse than death."],["5",[["Ἐκφοβεῖς",2221,145],["δὲ",14,12],["ἡμᾶς",6,60],["τὸν",1,6],["διὰ",56,1],["τῶν",1,123],["βασάνων",841,61],["ἡμῖν",6,142],["θάνατον",170,7],["ἀπειλῶν",1696,61],["ὥσπερ",226,17],["οὐχὶ",330,12],["πρὸ",238,1],["βραχέως",618,17],["παρὰ",73,1],["Ἐλεαζάρου",1942,21],["μαθών",923,155]],"And you think to scare us, by threatening us with death by tortures, as though thou hadst learned nothing by the death of Eleazar."],["6",[["Εἰ",77,8],["δʼ",14,12],["οἱ",1,128],["γέροντες",1814,51],["τῶν",1,76],["Ἑβραίων",1089,77],["διὰ",56,1],["τὴν",1,9],["εὐσέβειαν",895,10],["καὶ",2,8],["βασανισμὸυς",5489,31],["ὑπομείναντες",639,190],["ἀπέθανον",109,141],["ἀποθάνοιμεν",109,393],["ἂν",83,12],["δικαιότερον",153,17],["ἡμεῖς",6,195],["οἱ",1,128],["νέοι",515,130],["τὰς",1,39],["βασάνους",841,40],["τῶν",1,123],["σῶν",405,61],["ἀναγκῶν",1126,61],["ὑπεριδόντες",1496,190],["ἃς",24,186],["καὶ",2,8],["ὁ",1,4],["παιδευτὴς",4339,5],["γέρων",1814,5],["ἐνίκησεν",1441,3]],"But if aged men of the Hebrews have died in the cause of religion after enduring torture, more rightly should we younger men die, scorning your cruel tortures, which our aged instructor overcame."],["7",[["Πείραζε",1094,239],["γαροῦν",0,0],["τύραννε",784,250],["καὶ",2,8],["τὰς",1,39],["ἡμῶν",6,41],["ψυχὰς",63,40],["εἰ",77,8],["θανατώσεις",382,159],["διὰ",56,1],["τὴν",1,9],["εὐσέβειαν",895,10],["μὴ",25,8],["νομίσῃς",2179,170],["ἡμᾶς",6,60],["βλάπτειν",3251,54],["βασανίζων",1435,67]],"Make the attempt, then, O tyrant; and if thou puttest us to death for our religion, think not that thou harmest us by torturing us."],["8",[["Ἡμεῖς",6,195],["μὲν",281,12],["γὰρ",40,12],["διὰ",56,1],["τῆσδε",129,290],["τῆς",1,18],["κακοπαθείας",4248,19],["καὶ",2,8],["ὑπομονῆς",1616,19],["τὰ",1,42],["τῆς",1,18],["ἀρετῆς",1398,19],["ἆθλα",6392,63],["οἴσομεν",199,269]],"For we through this ill-treatment and endurance shall bear off the rewards of virtue."],["9",[["Σὺ",5,156],["δὲ",14,12],["διὰ",56,1],["τὴν",1,9],["ἡμῶν",6,41],["μιαροφονίαν",0,0],["αὐτάρχη",6834,14],["καρτερήσεις",2454,159],["περὶ",72,1],["τῆς",1,18],["θείας",1343,78],["δίκης",1219,19],["αἰώνιον",391,37],["βάσανον",841,10],["διὰ",56,1],["πυρός",118,24]],"But thou, for the wicked and despotic slaughter of us, shalt, from the Divine vengeance, endure eternal torture by fire."],["10",[["Ταῦτα",16,248],["αὐτῶν",3,41],["εἰπόντων",18,211],["οὐ",12,17],["μόνον",302,29],["ὡς",36,8],["κατὰ",32,1],["ἀπειθούντων",993,164],["ἐχαλέπαινεν",6197,14],["ὁ",1,4],["τύραννος",784,5],["ἀλλʼ",108,17],["ὡς",36,8],["καὶ",2,8],["κατὰ",32,1],["ἀχαρίστων",4056,163],["ὠργίσθη",725,38]],"When they had thus spoken, the tyrant was not only exasperated against them as being refractory, but enraged with them as being ungrateful."],["11",[["Ὅθεν",1153,17],["τὸν",1,6],["πρεσβύτατον",1419,7],["αὐτῶν",3,41],["κελευθέντες",1512,243],["παρήγαγον",2277,141],["οἱ",1,128],["μαστισταὶ",0,0],["καὶ",2,8],["διαῤῥήξαντες",647,190],["τὸν",1,6],["χιτῶνα",1254,7],["διέδησαν",6963,141],["τὰς",1,39],["χεῖρας",37,40],["αὐτοῦ",3,48],["καὶ",2,8],["τοὺς",1,56],["βραχίονας",618,58],["ἱμᾶσιν",4121,139],["ἑκατέρωθεν",6536,17]],"So that, at his bidding, the torturers brought forth the eldest of them, and tearing through his tunic, bound his hands and arms on each side with thongs."],["12",[["Ὡς",36,8],["δὲ",14,12],["τύπτοντες",1209,137],["ταῖς",1,70],["μάστιξιν",1308,71],["ἐκοπίασαν",921,141],["μηδὲν",908,29],["ἀνύοντες",8944,137],["ἀνέβαλον",3397,141],["αὐτὸν",3,82],["ἐπὶ",9,1],["τὸν",1,6],["τροχόν",911,7]],"And when they had laboured hard without effect in scourging him, they hurled him upon the wheel."],["13",[["Περὶ",72,1],["ὃν",24,106],["κατατεινόμενος",3854,114],["ὁ",1,4],["εὐγενὴς",2258,16],["νεανίας",2030,5],["ἔξαρθρος",9677,16],["ἐγίνετο",30,22]],"And the noble youth, extended upon this, became dislocated."],["14",[["Καὶ",2,8],["κατὰ",32,1],["πᾶν",11,29],["μέλος",1593,33],["κλώμενος",4274,114],["κατηγόρει",3858,14],["λέγων",31,67]],"And with every member disjointed, he exclaimed in expostulation,"],["15",[["Τύραννε",784,250],["μιαιρώτατε",0,0],["καὶ",2,8],["τῆς",1,18],["οὐρανίου",3602,78],["δίκης",1219,19],["ἐχθρὲ",135,250],["καὶ",2,8],["ὠμόφρον",9949,309],["οὐκ",12,17],["ἀνδροφονήσαντά",8882,476],["με",6,82],["τοῦτον",16,259],["καταικίζεις",3549,145],["τὸν",1,6],["τρόπον",245,7],["οὐδὲ",106,12],["ἀσεβήσαντα",1256,476],["ἀλλα",108,17],["θείου",2893,24],["νόμου",140,21],["προασπίζοντα",5001,289]],"O most accursed tyrant, and enemy of heavenly justice, and cruel-hearted, I am no murderer, nor sacrilegious man, whom thou thus ill-usest; but a defender of the Divine law."],["16",[["Καὶ",2,8],["τῶν",1,76],["δορυφόρων",2707,163],["λεγόντων",31,164],["ὁμολόγησον",2686,198],["φαγεῖν",269,100],["οὕπως",0,0],["ἀπαλλαγῇς",2659,278],["τῶν",1,123],["βασάνων",841,61]],"And when the spearmen said, Consent to eat, that you may be released from your tortures,—"],["17",[["ὁ",1,4],["δὲ",14,12],["εἶπεν",18,3],["οὐχ",12,17],["οὕτως",71,17],["ἰσχυρὸς",401,16],["ὑμῶν",5,136],["ἐστιν",10,87],["ὁ",1,4],["τρόπος",245,5],["ὦ",646,316],["μιαιροὶ",0,0],["διὰκονοι",3263,51],["ὥστε",346,17],["μου",6,48],["τὸν",1,6],["λογισμὸν",500,7],["ἄξαι",224,100],["τέμνετέ",2970,84],["μου",6,48],["μέλη",1593,43],["καὶ",2,8],["πυροῦτε",926,84],["τὰς",1,39],["σάρκας",287,40],["καὶ",2,8],["στρεβλοῦτε",2957,84],["τὰ",1,42],["ἄρθρα",6386,43]],"he answered, Not so powerful, O accursed ministers, is your wheel, as to stifle my reasoning; cut my limbs, and burn my flesh, and twist my joints."],["18",[["Διὰ",56,1],["πασῶν",11,115],["γὰρ",40,12],["ὑμᾶς",5,209],["πείσω",344,157],["τῶν",1,123],["βασάνων",841,61],["ὅτι",19,8],["μόνοι",302,130],["παῖδες",127,51],["Ἑβραίων",1089,77],["ὑπὲρ",139,1],["ἀρετῆς",1398,19],["εἰσιν",10,191],["ἀνίκητοι",3694,130]],"For through all my torments I will convince you that the children of the Hebrews are alone unconquered in behalf of virtue."],["19",[["Ταῦτα",16,248],["λέγοντες",31,137],["εἰς",8,1],["πῦρ",118,33],["ἐπέτρωσαν",7974,141],["καὶ",2,8],["διερεθίζοντες",7039,137],["τὸν",1,6],["τροχὸν",911,7],["προσεπικατέτεινον",8091,129]],"While he was saying this, they heaped up fuel, and setting fire to it, strained him upon the wheel still more."],["20",[["Ἐμολύνετο",1901,22],["δὲ",14,12],["πάντοθεν",2626,17],["αἵματι",148,53],["ὁ",1,4],["τρόχος",911,5],["καὶ",2,8],["ὁ",1,4],["σωρὸς",2782,5],["τῆς",1,18],["ἀνθρακιᾶς",8898,19],["τοῖς",1,138],["τῶν",1,76],["ἰχώρων",5384,77],["ἐσβέννυτο",1077,22],["σταλαγμοῖς",8282,139],["καὶ",2,8],["περὶ",72,1],["τοὺς",1,56],["αὔξονας",0,0],["τοῦ",1,23],["ὀργάνου",1578,24],["περιέῤῥεον",7954,129],["αἱ",1,185],["σάρκες",287,180]],"And the wheel was defiled all over with blood, and the hot ashes were quenched by the droppings of gore, and pieces of flesh were scattered about the axles of the machine."],["21",[["Καὶ",2,8],["περιτετηκμένον",0,0],["ἤδη",916,17],["ἔχων",124,67],["τὸ",1,32],["τῶν",1,44],["ὀστέων",473,45],["πῆγμα",6037,20],["ὁ",1,4],["μεγαλόφρων",4899,5],["καὶ",2,8],["Ἀβραμιαῖος",0,0],["νεανίας",2030,5],["οὐκ",12,17],["ἐστέναξεν",1445,3]],"And although the framework of his bones was now destroyed, the high-minded and Abrahamic youth did not groan."],["22",[["Ἀλλʼ",108,17],["ὥσπερ",226,17],["ἐν",4,1],["πυρὶ",118,53],["μετασχηματιζόμενος",7679,114],["εἰς",8,1],["ἀφθαρσίαν",4054,10],["ὑπέμεινεν",639,3],["εὐγενῶς",2258,17],["τὰς",1,39],["στρέβλας",3358,40]],"But, as though transformed by fire into immortality, he nobly endured the rackings, saying,"],["23",[["Μιμήσασθέ",4311,488],["με",6,82],["ἀδελφοὶ",67,51],["λέγων",31,67],["μή",25,8],["μου",6,48],["τὸν",1,6],["αἰῶνα",100,7],["λειποτακτήσητε",0,0],["μηδʼ",414,12],["ἐξομόσησθέ",5322,133],["μου",6,83],["τὴν",1,9],["τῆς",1,18],["εὐψυχίας",5626,19],["ἀδελφότητα",3681,10],["ἱερὰν",1318,37],["καὶ",2,8],["εὐγενῆ",2258,37],["στρατείαν",6075,10],["στρατεύσασθε",3641,268],["περὶ",72,1],["τῆς",1,18],["εὐσεβείας",895,19]],"Imitate me, O brethren, nor ever desert your station, nor abjure my brotherhood in courage: fight the holy and honourable fight of religion;"],["24",[["Διʼ",56,1],["ἧς",24,162],["ἷλεως",1409,17],["ἡ",1,11],["δικαία",153,15],["καὶ",2,8],["πάτριος",2041,13],["ἡμῶν",6,41],["πρόνοια",3123,13],["τῷ",1,52],["ἔθνει",60,53],["γενηθεῖσα",30,302],["τιμωρήσειεν",2790,216],["τὸν",1,6],["ἀλάστορα",4490,7],["τύραννον",784,7]],"by which means our just and paternal Providence, becoming merciful to the nation, will punish the pestilent tyrant."],["25",[["Καὶ",2,8],["ταῦτα",16,248],["εἰπὼν",18,155],["ὁ",1,4],["ἱεροπρεπὴς",6595,16],["νεανίας",2030,5],["ἀπέῤῥηξεν",5227,3],["τὴν",1,9],["ψυχήν",63,10]],"And saying this, the revered youth abruptly closed his life."],["26",[["Θαυμασάντων",963,211],["δὲ",14,12],["πάντων",11,163],["τὴν",1,9],["καρτεροψυχίαν",7315,10],["αὐτοῦ",3,48],["ἦγον",224,129],["οἱ",1,128],["δορυφόροι",2707,130],["τὸν",1,6],["καθʼ",32,1],["ἡλικίαν",1755,10],["τοῶ",0,0],["προτέρου",496,153],["δεύτερον",271,29],["καὶ",2,8],["σιδηρᾶς",1063,109],["ἐναρμοσάμενοί",6448,315],["χεῖρας",37,40],["ὀξέσιν",1663,215],["τοῖς",1,138],["ὄνυξιν",3025,139],["τοῖς",1,138],["ὀργάνοις",1578,92],["καταπέλτῃ",7370,120],["προσέδησαν",3630,141],["αὐτόν",3,82]],"And when all admired his courageous soul, the spearmen brought forward him who was second in point of age, and having put on iron hands, bound him with pointed hooks to the catapelt."],["27",[["Ὡς",36,8],["δὲ",14,12],["εἰ",77,8],["φαγεῖν",269,100],["βούλοιτο",463,664],["πρὶν",1224,17],["βασανίζεσθαι",1435,104],["πυνθανόμενοι",2484,351],["τὴν",1,9],["εὐγενῆ",2258,37],["γνώμην",1376,10],["ἤκουσαν",54,141]],"And when, on enquiring whether he would eat before he was tortured, they heard his noble sentiment,"],["28",[["ἀπὸ",17,1],["τῶν",1,76],["τενόντων",6140,163],["ταῖς",1,70],["σιδηραῖς",1063,287],["χερσὶν",37,71],["ἐπισπασάμενοι",2836,315],["μέχρι",781,1],["γε",353,12],["τῶν",1,44],["γενείων",5508,45],["τὴν",1,9],["σάρκα",287,10],["πᾶσαν",11,37],["καὶ",2,8],["τὴν",1,9],["τῆς",1,18],["κεφαλῆς",144,19],["δορὰν",4759,10],["οἱ",1,128],["παρδάλειοι",0,0],["θῆρες",3274,51],["ἀπέσυραν",9053,141],["ὁ",1,4],["δὲ",14,12],["ταύτην",16,234],["βαρέως",3501,17],["τὴν",1,9],["ἀλγηδόνα",2304,10],["καρτερῶν",2454,67],["ἔλεγεν",31,14]],"after they with the iron hands had violently dragged all the flesh from the neck to the chin, the panther-like beasts tore off the very skin of his head: but he, bearing with firmness this misery, said,"],["29",[["Ὡς",36,8],["ἡδὺς",2146,16],["πᾶς",11,16],["τρόπος",245,5],["θανάτου",170,21],["διὰ",56,1],["τὴν",1,9],["πάτριον",2041,20],["ἡμῶν",6,41],["εὐσέβειαν",895,10],["ἔφη",660,14],["τε",209,12],["πρὸς",15,1],["τὸν",1,6],["τύραννον",784,7]],"How sweet is every form of death for the religion of our fathers! and he said to the tyrant,"],["30",[["Οὐ",12,17],["δοκεῖς",801,145],["πάντων",11,163],["ὠμότατε",4144,250],["τύραννε",784,250],["πλεῖων",938,250],["ἐμοῦ",6,48],["σε",5,161],["νὺν",90,17],["βασανίζεσθαι",1435,104],["ὁρῶν",112,67],["σου",5,146],["νικώμενον",1441,361],["τὸν",1,6],["τῆς",1,18],["τυραννίδος",3376,19],["ὑπερήφανον",1109,59],["λογισμὸν",500,7],["ὑπὸ",122,1],["τῆς",1,18],["διὰ",56,1],["τὴν",1,9],["εὐσέβειαν",895,10],["ἡμῶν",6,41],["ὑπομονῆς",1616,19]],"Thinkest thou not, most cruel of all tyrants, that thou art now tortured more than I, finding thy overweening conception of tyranny conquered by our patience in behalf of our religion?"],["31",[["Ἐγὼ",6,158],["μὲν",281,12],["γὰρ",40,12],["ταῖς",1,70],["διὰ",56,1],["τὴν",1,9],["ἀρετὴν",1398,10],["ἡδοναῖς",2231,71],["τὸν",1,6],["πόνον",566,7],["ἐπικουφίζομαι",9516,251]],"For I lighten my suffering by the pleasures which are connected with virtue."],["32",[["Σὺ",5,156],["δὲ",14,12],["ἐν",4,1],["ταῖς",1,70],["τῆς",1,18],["ἀσεβείας",722,19],["ἀπειλαῖς",1696,71],["βασανίζῃ",1435,166],["οὐκ",12,17],["ἐκφεύξῃ",1861,116],["δὲ",14,12],["μιαιρότατε",0,0],["τύραννε",784,250],["τὰς",1,39],["τῆς",1,18],["θείας",1343,78],["ὀργῆς",198,19],["δίκας",1219,40]],"But thou art tortured with threatenings for impiety; and thou shalt not escape, most corrupt tyrant, the vengeance of Divine wrath."]]