[["1",[["Ἔλεγον",31,129],["δὲ",14,12],["καὶ",2,8],["τῶν",1,76],["δορυφόρων",2713,163],["τινὲς",39,409],["ὡς",36,8],["ὅτε",430,8],["ἔμελλεν",1143,14],["καὶ",2,8],["αὐτὴ",3,178],["συλλαμβάνεσθαι",510,104],["πρὸς",15,1],["θάνατον",169,7],["ἵνα",101,8],["μὴ",25,8],["ψαύσειέν",8775,276],["τι",39,119],["τοῦ",1,23],["σώματος",451,24],["ἑαυτῆς",92,83],["ἑαυτὴν",92,98],["ἔῤῥιψεν",694,3],["κατὰ",32,1],["τῆς",1,18],["πυρᾶς",3954,19]],"And some of the spearbearers said, that when she herself was about to be seized for the purpose of being put to death, she threw herself upon the pile, rather than that they should touch her person."],["2",[["Ὦ",641,320],["μήτηρ",188,13],["σὺν",309,1],["ἑπτὰ",179,57],["παισὶν",126,139],["καταλύσασα",861,140],["τὴν",1,9],["τοῦ",1,30],["τυράννου",784,21],["βίαν",1504,10],["καὶ",2,8],["ἀκυρώσασα",3398,140],["τὰς",1,39],["κακὰς",161,109],["ἐπινοίας",3205,40],["αὐτοῦ",3,48],["καὶ",2,8],["ἐπιδείξασα",2330,140],["τὴν",1,9],["τῆς",1,18],["πίστεως",888,19],["γενναιότητα",5542,10]],"O thou mother, who together with seven children didst destroy the violence of the tyrant, and render void his wicked intentions, and exhibit the nobleness of faith!"],["3",[["Καθάπερ",688,8],["γὰρ",40,12],["σὺ",5,156],["στέγη",4419,13],["ἐπὶ",9,1],["τοῦ",1,30],["στύλου",392,21],["τῶν",1,76],["παίδων",126,77],["γενναίως",1584,17],["ἱδρυμένη",6633,197],["ἀκλινῶς",6270,17],["ὑπήνεγκας",1877,154],["τὸν",1,6],["διὰ",54,1],["τῶν",1,123],["βασάνων",842,61],["σεισμόν",2496,7]],"For thou, as a house bravely built upon the pillar of thy children, didst bear without swaying, the shock of tortures."],["4",[["Θάῤῥει",1302,239],["τοιγαροῦν",2801,8],["ὦ",641,320],["μήτηρ",188,13],["ἱερόψυχε",9839,313],["τὴν",1,9],["ἐλπίδα",527,10],["τῆς",1,18],["ὑπομονῆς",1615,19],["γενναίως",1584,17],["ἔχουσα",124,181],["πρὸς",15,1],["Θεόν",20,7]],"Be of good cheer, therefore, O holy-minded mother! holding the firm [substance of the] hope of your steadfastness with God."],["5",[["Οὐχ",12,17],["οὕτω",70,17],["σελήνη",1211,13],["κατʼ",32,1],["οὐρανὸν",94,7],["σὺν",309,1],["ἄστροις",1334,92],["σεμνὴ",2774,15],["καθέστηκεν",313,165],["ὡς",36,8],["σὺ",5,156],["τοὺς",1,56],["εἰς",8,1],["ἀστέρας",1703,31],["ἑπτὰ",179,57],["παῖδας",126,31],["φωταγωγήσασα",8702,140],["πρὸς",15,1],["τὴν",1,9],["εὐσέβειαν",896,10],["ἔντιμος",1335,16],["καθέστηκας",313,263],["Θεῷ",20,113],["καὶ",2,8],["ἐστήρισαι",0,0],["ἐν",4,1],["οὐρανῷ",94,113],["σὺν",309,1],["αὐτοῖς",3,142]],"Not so gracious does the moon appear with the stars in heaven, as thou art established honourable before God, and fixed in the firmament with thy sons whom thou didst illuminate with religion to the stars."],["6",[["Ἦν",10,14],["γὰρ",40,12],["ἡ",1,11],["παιδοποιΐα",7883,13],["σου",5,146],["ἀπὸ",17,1],["Ἁβραὰμ",294,105],["τοῦ",1,30],["παιδός",126,21]],"For thy bearing of children was after the fashion of a child of Abraham."],["7",[["Εἰ",77,8],["δὲ",14,12],["ἐξὸν",3210,36],["ἡμῖν",6,142],["ἦν",10,14],["ὥσπερ",221,17],["τινὸς",39,308],["ζωγραφῆσαι",5671,100],["τὴν",1,9],["τῆς",1,18],["ἱστορίας",3468,19],["σου",5,146],["εὐσέβειαν",896,10],["οὐκ",12,17],["ἂν",82,12],["ἔφριττον",3384,129],["οἱ",1,128],["θεωροῦντες",898,137],["μητέρα",188,10],["ἑπτὰ",179,57],["τέκνων",192,45],["διʼ",54,1],["εὐσέβειαν",896,10],["ποικίλας",1557,109],["βασάνους",842,40],["μέχρι",780,1],["θανάτου",169,21],["ὑπομείνασαν",635,412]],"And, were it lawful for us to paint as on a tablet the religion of thy story, the spectators would not shudder at beholding the mother of seven children enduring for the sake of religion various tortures even unto death."],["8",[["Καὶ",2,8],["γὰρ",40,12],["ἄξιον",1104,29],["ἦν",10,14],["καὶ",2,8],["ἐπὶ",9,1],["αὐτοῦ",3,48],["τοῦ",1,30],["ἐπιταφίου",9625,153],["ἀναγράψαι",3694,100],["καὶ",2,8],["ταῦτα",16,249],["τοῖς",1,138],["ἀπὸ",17,1],["τοῦ",1,23],["ἔθνους",59,24],["εἰς",8,1],["μνείαν",2286,10],["λεγόμενα",31,64]],"And it had been a worthy thing to have inscribed upon the tomb itself these words as a memorial to those of the nation,"],["9",[["Ἐνταῦθα",1457,17],["γέρων",1815,5],["ἱερεὺς",64,5],["καὶ",2,8],["γυμὴ",0,0],["γεραιὰ",4191,15],["καὶ",2,8],["ἑπτὰ",179,57],["παῖδες",126,51],["ἐγκεκήδευνται",0,0],["διὰ",54,1],["τυράννου",784,21],["βίαν",1504,10],["τὴν",1,9],["Ἑβραίων",1090,77],["πολιτείαν",3124,10],["καταλῦσαι",861,100],["θέλοντος",837,143]],"Here an aged priest, and an aged woman, and seven sons, are buried through the violence of a tyrant, who wished to destroy the polity of the Hebrews."],["10",[["Οἳ",1,128],["καὶ",2,8],["ἐξεδίκησαν",0,0],["τὸ",1,32],["ἔθνος",59,33],["εἰς",8,1],["Θεὸν",20,7],["ἀφορῶντες",6389,137],["καὶ",2,8],["μέχρι",780,1],["θανάτου",169,21],["τὰς",1,39],["βασάνους",842,40],["ὑπομείναντες",635,188]],"These also avenged their nation, looking unto God, and enduring torments unto death."],["11",[["Ἀληθῶς",1796,17],["γὰρ",40,12],["ἦν",10,14],["ἀγῶν",6255,67],["θεῖος",1340,16],["ὁ",1,4],["διʼ",54,1],["αὐτῶν",3,41],["γεγενημένος",30,228]],"For it was a truly divine contest which was carried through by them."],["12",[["Ἠθλότει",0,0],["γὰρ",40,12],["τότε",250,17],["ἀρετὴ",1400,13],["διʼ",54,1],["ὑπομονῆς",1615,19],["δοκιμάζουσα",1337,181],["τὸ",1,32],["νῖκος",2107,33],["ἐν",4,1],["ἀφθαρσίᾳ",4062,2],["ἐν",4,1],["ζωῇ",212,2],["πολυχρονίῳ",3633,96]],"For at that time virtue presided over the contest, approving the victory through endurance, namely, immortality, eternal life."],["13",[["Ἐλεάζαρ",656,105],["δὲ",14,12],["προηγωνίζετο",8098,22],["ἡ",1,11],["δὲ",14,12],["μήτηρ",188,13],["τῶν",1,76],["ἑπτὰ",179,57],["παίδων",126,77],["ἐνήθλει",9450,14]],"Eleazar was the first to contend: and the mother of the seven children entered the contest; and the brethren contended."],["14",[["οἱ",1,128],["δὲ",14,12],["ἀδελφοὶ",66,51],["ἠγωνίζοντο",3161,131],["ὁ",1,4],["τύραννος",784,5],["ἀντηγωνίζετο",8976,22],["ὁ",1,4],["δὲ",14,12],["κόσμος",742,5],["καὶ",2,8],["ὁ",1,4],["τῶν",1,76],["ἀνθρώπων",43,77],["βίος",726,5],["ἐθεώρει",898,14]],"The tyrant was the opposite; and the world and living men were the spectators."],["15",[["Θεοσέβεια",3538,13],["δὲ",14,12],["ἐνίκα",1442,14],["τοὺς",1,56],["ἑαυτῆς",92,83],["ἀθλητὰς",5191,31],["στεφανοῦσα",3357,181]],"And reverence for God conquered, and crowned her own athletes."],["16",[["Τίνες",39,409],["οὐκ",12,17],["ἐθαύμασαν",965,141],["τοὺς",1,56],["τῆς",1,18],["ἀληθείας",350,19],["νομοθεσίας",4946,19],["ἀθλητὰς",5191,31],["τίνες",39,409],["οὐκ",12,17],["ἐξεπλάγησαν",4083,94]],"Who did not admire those champions of true legislation? who were not astonied?"],["17",[["Αὐτός",3,158],["γέ",351,12],["τοι",5,151],["ὁ",1,4],["τύραννος",784,5],["καὶ",2,8],["ὅλον",233,59],["τὸν",1,6],["συνέδριον",2503,33],["αὐτῶν",3,41],["ἐξεθαύμασαν",5319,141],["αὐτῶν",3,41],["τὴν",1,9],["ὑπομονήν",1615,10]],"The tyrant himself, and all their council, admired their endurance;"],["18",[["Διʼ",54,1],["ἣν",24,124],["καὶ",2,8],["τῷ",1,52],["θείῳ",2907,53],["νῦν",89,17],["παρεστήκασιν",592,406],["θρόνῳ",379,113],["καὶ",2,8],["τὸν",1,6],["μακάριον",803,59],["βιοῦσιν",3507,189],["αἰῶνα",100,7]],"through which, also, they now stand beside the divine throne, and live a blessed life."],["19",[["Καὶ",2,8],["γάρ",40,12],["φησιν",655,87],["ὁ",1,4],["Μωσῆς",2877,19],["καὶ",2,8],["πάντες",11,130],["οἱ",1,128],["ἡγιασμένοι",358,375],["ὑπὸ",122,1],["τὰς",1,39],["χεῖράς",37,40],["σου",5,146]],"For Moses saith, And all the saints are under thy hands."],["20",[["Καὶ",2,8],["οὗτοι",16,213],["οὖν",223,12],["ἁγιασθέντες",358,244],["διὰ",54,1],["Θεὸν",20,7],["τετίμηνται",0,0],["οὐ",12,17],["μόνον",300,29],["οὖν",223,12],["ταύτῃ",16,200],["τῇ",1,95],["τιμῇ",721,2],["ἀλλὰ",107,17],["καὶ",2,8],["τῷ",1,110],["διʼ",54,1],["αὐτοὺς",3,60],["τὸ",1,32],["ἔθνος",59,33],["ἡμῶν",6,41],["τοὺς",1,56],["πολεμίους",1121,58],["μὴ",25,8],["ἐπικρατήσας",1459,155]],"These, therefore, having been sanctified through God, have been honoured not only with this honour, but that also by their means the enemy did not overcome our nation;"],["21",[["καὶ",2,8],["τὸν",1,6],["τύραννον",784,7],["τιμωρηθῆναι",2800,174],["καὶ",2,8],["τὴν",1,9],["πατρίδα",1689,10],["καθαρισθῆναι",488,174]],"and that the tyrant was punished, and their country purified."],["22",[["ὥσπωρ",0,0],["ἀντίψυχον",6311,28],["γεγονότας",30,277],["τῆς",1,18],["τοῦ",1,23],["ἔθνους",59,24],["ἁμαρτίας",119,19],["καὶ",2,8],["διὰ",54,1],["τοῦ",1,23],["αἵματος",148,24],["τῶν",1,76],["εὐσεβῶν",1246,163],["ἐκείνων",79,41],["καὶ",2,8],["τοῦ",1,23],["ἱλαστηρίου",1497,24],["θανάτου",169,21],["αὐτῶν",3,41],["ἡ",1,11],["θεία",1340,15],["πρόνοια",3131,13],["τὸν",1,6],["Ἰσραὴλ",27,105],["προκακωθέντα",8117,490],["διέσωσεν",727,3]],"For they became the antipoise to the sin of the nation; and the Divine Providence saved Israel, aforetime afflicted, by the blood of those pious ones, and their propitiatory death."],["23",[["Πρὸς",15,1],["γὰρ",40,12],["τὴν",1,9],["ἀνδρείαν",1487,37],["αὐτῶν",3,41],["τῆς",1,18],["ἀρετῆς",1400,19],["καὶ",2,8],["τὴν",1,9],["ἐπὶ",9,1],["ταῖς",1,70],["βασάνοις",842,71],["αὐτῶν",3,41],["ὑπομονὴν",1615,10],["ὁ",1,4],["τύραννος",784,5],["ἀφιδὼν",0,0],["Ἀντίοχος",853,5],["ἀνεκήρυξεν",8912,3],["τοῖς",1,138],["στρατιώταις",3358,139],["αὐτοῦ",3,48],["εἰς",8,1],["ὑπόδειγμα",4153,33],["τὴν",1,9],["ἐκείνων",79,41],["ὑπομονήν",1615,10]],"For the tyrant Antiochus, looking to their manly virtue, and to their endurance in torture, proclaimed that endurance as an example to his soldiers."],["24",[["Ἔσχεν",124,3],["τε",207,12],["αὐτοὺς",3,60],["γενναίους",1584,58],["καὶ",2,8],["ἀνδρείους",1487,58],["εἰς",8,1],["πεζομαχίαν",7971,10],["καὶ",2,8],["πολιορκίαν",3632,10],["καὶ",2,8],["ἐκπορθήσας",6463,155],["ἐνίκησεν",1442,3],["πάντας",11,58],["τοὺς",1,56],["πολεμίους",1121,58]],"And they proved to be to him noble and brave for land battles and sieges; and he conquered and stormed the towns of all his enemies."]]