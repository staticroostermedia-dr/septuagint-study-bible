[["1",[["Προσέτι",5044,17],["καὶ",2,8],["ἐπὶ",9,1],["τὸν",1,6],["αἰκισμὸν",3799,7],["ἐποτρύνοντες",6560,137],["ὡς",36,8],["μὴ",25,8],["μόνον",300,29],["τῶν",1,123],["ἀλγηδόνων",2318,61],["περιφρονῆσαι",5006,100],["αὐτοὺς",3,60],["ἀλλὰ",107,17],["καὶ",2,8],["τῆς",1,18],["τῶν",1,76],["ἀδελφῶν",66,77],["φιλαδελφίας",5146,19],["παθῶν",806,45],["κρατῆσαι",383,100]],"And more than this, they even urged them on to this ill-treatment; so that they not only despised pains themselves, but they even got the better of their affections of brotherly love."],["2",[["Ὦ",641,320],["βασιλέως",22,21],["λογισμοὶ",498,51],["βασιλικώτεροι",1298,130],["καὶ",2,8],["ἐλευθέρων",1456,163],["ἐλευθερώτεροι",1456,130]],"O reasonings more royal than a king, and freer than freemen!"],["3",[["Ἱερὰς",1318,109],["καὶ",2,8],["ἐναρμόστους",9493,109],["περὶ",71,1],["τῆς",1,18],["εὐσεβείας",896,19],["τῶν",1,76],["ἑπτὰ",179,57],["ἀδελφῶν",66,77],["συμφωνίας",6131,19]],"Sacred and harmonious concert of the seven brethren as concerning piety!"],["4",[["Οὐδεὶς",225,16],["ἐκ",21,1],["τῶν",1,44],["ἑπτὰ",179,57],["μειρακίων",4318,45],["ἐδειλίασεν",0,0],["οὐδὲ",105,12],["πρὸς",15,1],["τὸν",1,6],["θάνατον",169,7],["ὤκνησεν",3474,3]],"None of the seven youths turned cowardly, or shrank back from death."],["5",[["Ἀλλὰ",107,17],["πάντες",11,130],["ὥσπερ",221,17],["ἐπʼ",9,1],["ἀθανασίας",3397,40],["ὁδὸν",67,10],["τρέχοντες",818,137],["ἐπὶ",9,1],["τὸν",1,6],["διὰ",54,1],["τῶν",1,123],["βασάνων",842,61],["θάνατον",169,7],["ἔσπευδον",847,129]],"But all of them, as though running the road to immortality, hastened on to death through tortures."],["6",[["Καθάπερ",688,8],["γὰρ",40,12],["χεῖρες",37,179],["καὶ",2,8],["πόδες",208,51],["συμφώνως",4445,17],["τοῖς",1,138],["τῆς",1,18],["ψυχῆς",62,19],["ἀφηγήμασιν",9218,92],["κινοῦνται",993,303],["οὕτως",70,17],["οἱ",1,128],["ἱεροὶ",1318,130],["μείρακες",5859,179],["ἐκεῖνοι",79,193],["ὡς",36,8],["ὑπὸ",122,1],["ψυχῆς",62,19],["ἀθανάτου",4502,78],["τῆς",1,18],["εὐσεβείας",896,19],["πρὸς",15,1],["τὸν",1,6],["ὑπὲρ",139,1],["αὐτῆς",3,83],["συνεφώνησαν",4427,141],["θάνατον",169,7]],"For just as hands and feet are moved sympathetically with the directions of the soul, so those holy youths agreed unto death for religion's sake, as through the immortal soul of religion."],["7",[["Ὦ",641,320],["παναγία",5921,15],["ἡ",1,11],["συμφώνον",4445,28],["ἀδελφῶν",66,77],["ἐβδομάς",1607,105],["καθάπερ",688,8],["γὰρ",40,12],["ἑπτὰ",179,57],["τῆς",1,18],["κοσμοποιΐας",7549,19],["ἡμέραι",28,2],["περὶ",71,1],["τὴν",1,9],["εὐσέβειαν",896,10]],"O holy seven of harmonious brethren! for as the seven days of creation, about religion,"],["8",[["οὕτος",80,20],["περὶ",71,1],["τὴν",1,9],["ἑβδομάδα",1607,10],["χορεύοντες",3681,137],["οἱ",1,128],["μείρακες",5859,179],["ἐκύκλουν",600,129],["τὸν",1,6],["τῶν",1,123],["βασάνων",842,61],["φόβον",330,7],["καταλύοντες",861,137]],"so the youths, circling around the number seven, annulled the fear of torments."],["9",[["Νῦν",89,17],["ἡμεῖς",6,193],["ἀκούοντες",53,137],["τῆν",1,9],["θλίψιν",437,10],["τῶν",1,76],["νεανίων",5885,286],["ἐκείνων",79,41],["φρίττομεν",3384,241],["οἱ",1,128],["δὲ",14,12],["οὐ",12,17],["μόνον",300,29],["ὁρῶντες",111,137],["ἀλλʼ",107,17],["οὐδὲ",105,12],["μόνον",300,59],["ἀκούοντες",53,137],["τὸν",1,6],["παραχρῆμα",1908,17],["ἀπειλῆς",1701,19],["λόγον",48,7],["ἀλλὰ",107,17],["καὶ",2,8],["πάσχοντες",1976,137],["ἐκαρτέρουν",2462,129],["καὶ",2,8],["τοῦτο",16,122],["ταῖς",1,70],["διὰ",54,1],["πυρὸς",118,24],["ὀδύναις",771,71]],"We now shudder at the recital of the affliction of those young men; but they not only beheld, and not only heard the immediate execution of the threat, but undergoing it, persevered; and that through the pains of fire."],["10",[["Ὧν",24,97],["τί",39,119],["γένοιτο",30,397],["ἐπαλγέστερον",9541,29],["ὀξεῖα",1664,15],["γὰρ",40,12],["καὶ",2,8],["σύντομος",5118,15],["ἡ",1,11],["τοῦ",1,23],["πυρὸς",118,24],["οὖσα",10,181],["δύναμις",98,13],["ταχέως",1563,17],["διέλυσε",2578,3],["τὰ",1,42],["σώματα",451,43]],"And what could be more painful? for the power of fire, being sharp and quick, speedily dissolved their bodies."],["11",[["Καὶ",2,8],["μὴ",25,8],["θαυμαστὸν",1074,28],["ἡγεῖσθε",374,523],["εἰ",77,8],["ὁ",1,4],["λογισμὸς",498,5],["περιεκράτησεν",3932,3],["τῶν",1,76],["ἀνδρῶν",38,77],["ἐκείνων",79,41],["ἐν",4,1],["ταῖς",1,70],["βασάνοις",842,71],["ὅπου",1580,17],["γε",351,12],["καὶ",2,8],["γυναικὸς",58,19],["νοῦς",1443,5],["πολυτροπωτέρον",5996,28],["ὑπερεφρόνησεν",5451,3],["ἀλγηδόνων",2318,61]],"And think it not wonderful that reasoning bore rule over those men in their torments, when even a woman's mind despised more manifold pains."],["12",[["Ἡ",1,11],["μήτηρ",188,13],["γὰρ",40,12],["τῶν",1,76],["ἑπτὰ",179,57],["νεανίσκων",568,77],["ὑπήνεγκεν",1877,3],["τὰς",1,39],["ἐφʼ",9,1],["ἑνὶ",57,111],["ἐκάστῳ",0,0],["τῶν",1,44],["τέκνων",192,45],["στρέβλας",3361,40]],"For the mother of those seven youths endured the rackings of each of her children."],["13",[["Θεωρεῖτε",898,84],["δὲ",14,12],["πῶς",440,12],["πολύπλοκός",5027,15],["ἐστιν",10,87],["ἡ",1,11],["τῆς",1,18],["φιλοτεκνίας",3997,19],["στοργὴ",4413,13],["ἕλκουσα",1222,181],["πάντα",11,65],["πρὸς",15,1],["τὴν",1,9],["τῶν",1,44],["σπλάγχνων",2203,45],["συμπάθειαν",3147,10]],"And consider how comprehensive is the love of offspring, which draws every one to sympathy of affection,"],["14",[["Ὅπου",1580,17],["γε",351,12],["καὶ",2,8],["τὰ",1,42],["ἄλογα",3186,65],["ζῶα",3071,65],["ὁμοίαν",651,37],["τὴν",1,9],["πρὸς",15,1],["τὰ",1,42],["ἐξ",21,1],["αὐτῶν",3,41],["γεννώμενα",222,64],["συμπάθειαν",3147,10],["καὶ",2,8],["στοργὴν",4413,10],["ἔχει",124,87],["τοῖς",1,138],["ἀνθρώποις",43,139]],"where irrational animals possess a similar sympathy and love for their offspring with men."],["15",[["Καὶ",2,8],["γὰρ",40,12],["τῶν",1,44],["πετεινῶν",570,45],["τὰ",1,42],["μὲν",281,12],["ἥμερα",4128,65],["κατὰ",32,1],["τὰς",1,39],["οἰκίας",232,40],["ὀροφοιτοῦντα",9884,292],["προασπίζει",5030,87],["τῶν",1,76],["νεοττῶν",2287,77]],"The tame birds frequenting the roofs of our houses, defend their fledglings."],["16",[["Τὰ",1,42],["δὲ",14,12],["κατὰ",32,1],["τὰς",1,39],["κορυφὰς",977,40],["ὀρέων",86,45],["καὶ",2,8],["φαράγγων",620,61],["ἀποῤῥῶγας",9102,31],["καὶ",2,8],["δένδρων",1339,45],["ὀπὰς",3774,40],["καὶ",2,8],["τὰς",1,39],["τούτων",16,214],["ἄκρας",890,40],["νοσσοποιησάμενα",0,0],["ἀποτίκτει",6348,87],["καὶ",2,8],["τὸν",1,6],["προσιόντα",4388,177],["κωλύει",1441,87]],"Others build their nests, and hatch their young, in the tops of mountains and in the precipices of valleys, and the holes and tops of trees, and keep off the intruder."],["17",[["Εἰ",77,8],["δὲ",14,12],["καὶ",2,8],["μὴ",25,8],["δύναιντο",184,690],["κωλύειν",1441,54],["περιπτάμενα",8010,691],["κυκλόθεν",604,17],["αὐτῶν",3,41],["ἀλγοῦντα",3400,292],["τῇ",1,95],["στοργῇ",4413,2],["ἀνακαλούμενα",3403,64],["τῇ",1,95],["ἰδίᾳ",681,96],["φωνῇ",95,2],["καθʼ",32,1],["ὃν",24,106],["δύναται",184,108],["τρόπον",243,7],["βοηθεῖ",552,87],["τοῖς",1,91],["τέκνοις",192,92]],"And if not able to do this, they fly circling round them in agony of affection, calling out in their own note, and save their offspring in whatever manner they are able."],["18",[["Καὶ",2,8],["τί",39,119],["δεῖ",1161,14],["τὴν",1,9],["διὰ",54,1],["τῶν",1,76],["ἀλόγων",3186,163],["ζώων",117,36],["ἐπιδεικνύναι",2330,54],["τὴν",1,9],["πρὸς",15,1],["τὰ",1,42],["τέκνα",192,43],["συμπάθειαν",3147,10]],"But why should we point attention to the sympathy toward children shewn by irrational animals?"],["19",[["Ὅπου",1580,17],["γε",351,12],["καὶ",2,8],["μέλισσαι",3312,179],["περὶ",71,1],["τὸν",1,6],["τῆς",1,18],["κηρογονίας",7518,19],["καιρὸν",132,7],["ἐπαμύνονται",5358,303],["τοὺς",1,56],["προσιόντας",4388,229],["καὶ",2,8],["καθάπερ",688,8],["σιδήρῳ",791,113],["τῷ",1,110],["κέντρῳ",3885,53],["πλήσσουσι",1478,189],["τοὺς",1,56],["προσιόντας",4388,229],["τῇ",1,95],["νοσσιᾷ",2609,105],["αὐτῶν",3,41],["καὶ",2,8],["ἐπαμύνονται",5358,303],["ἕως",42,8],["θανάτου",169,21]],"The very bees