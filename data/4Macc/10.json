[["1",[["Καὶ",2,8],["τούτου",16,126],["τὸν",1,6],["ἀοίδιμον",6323,59],["θάνατον",169,7],["καρτερήσαντος",2462,521],["ὁ",1,4],["τρίτος",356,16],["ἤγετο",227,22],["παρακαλούμενος",432,114],["πολλὰ",74,65],["ὑπὸ",122,1],["πολλῶν",74,163],["ὅπως",236,8],["ἀπογευσάμενος",4044,245],["σώζοιτο",171,686]],"Now this one, having endured this praiseworthy death, the third was brought along, and exhorted by many to taste and save his life."],["2",[["Ὁ",1,4],["δὲ",14,12],["ἀναβοήσας",1081,155],["ἔφη",655,14],["ἤ",60,8],["ἀγνοεῖτε",1923,84],["ὅτι",19,8],["αὐτός",3,158],["με",6,82],["τοῖς",1,138],["ἀποθανοῦσιν",108,469],["ἔσπειρεν",790,3],["πατὴρ",44,5],["καὶ",2,8],["ἡ",1,11],["αὐτὴ",3,178],["μήτηρ",188,13],["ἐγέννεσιν",0,0],["καὶ",2,8],["ἐπὶ",9,1],["τοῖς",1,138],["αὐτοῖς",3,142],["ἀνετράφην",4529,148],["δόγμασιν",1958,92]],"But he cried out and said, Know ye not, that the father of those who are dead, begat me also; and that the same mother bare me; and that I was brought up in the same tenets?"],["3",[["Οὐκ",12,17],["ἐξόμνυμαι",5356,252],["τὴν",1,9],["εὐγενῆ",2273,37],["τῆς",1,18],["ἀδελφότητος",3688,19],["συγγένειαν",1309,10]],"I abjure not the noble relationship of my brethren."],["3a",[["Πρὸς",15,1],["ταῦτα",16,249],["εἴ",77,8],["τι",39,119],["ἔχετε",124,84],["κολαστήριον",7539,33],["προσαγάγετε",352,69],["τῷ",1,52],["σώματί",451,53],["μου",6,83],["τῆς",1,18],["γὰρ",40,12],["ψυχῆς",62,19],["μου",6,83],["οὐδʼ",105,12],["ἂν",82,12],["θέλητε",609,365],["ἅψασθαι",462,103],["δύνασθε",184,68]],"Now then, whatever instrument of vengeance ye have, apply it to my body, for ye are not able to touch, even if ye wish it, my soul."],["5",[["Οἱ",1,128],["δὲ",14,12],["πίκρῶς",8037,216],["ἐνέγκαντες",201,188],["τὴν",1,9],["παῤῥησίαν",2612,10],["τοῦ",1,30],["ἀνδρὸς",38,21],["ἀρθρεμβόλοις",9163,92],["ὀργάνοις",1579,92],["τὰς",1,39],["χεῖρας",37,40],["αὐτοῦ",3,48],["καὶ",2,8],["τοὺς",1,56],["πόδας",208,31],["ἐξήρθρουν",9505,129],["καὶ",2,8],["ἐξ",21,1],["ἁρμῶν",6400,77],["ἀναμοχλεύοντες",8919,137],["ἐξεμέλιζον",5322,129]],"But they, highly incensed at his boldness of speech, dislocated his hands and feet with racking engines, and wrenching them from their sockets, dismembered him."],["6",[["καὶ",2,8],["τοὺς",1,56],["δακτύλους",1182,31],["καὶ",2,8],["τοὺς",1,56],["βραχίονας",616,58],["καὶ",2,8],["τὰ",1,42],["σκέλη",2776,43],["καὶ",2,8],["τοὺς",1,56],["ἀγκῶνας",3685,31],["περιέλκων",7987,67]],"And they dragged round his fingers, and his arms, and his legs, and his ankles."],["7",[["Καὶ",2,8],["κατὰ",32,1],["μηδένα",910,59],["τρόπον",243,7],["ἰσχύοντες",565,137],["αὐτὸν",3,82],["ἄγξαι",5289,100],["περισύραντες",5005,188],["τὸ",1,32],["δέρμα",665,33],["σὺν",309,1],["ἄκραις",890,71],["ταῖς",1,70],["τῶν",1,76],["δακτύλων",1182,77],["κορυφαῖς",977,71],["ἀπεσκύθιζον",9114,129],["καὶ",2,8],["εὐθέως",1675,17],["ἦγον",227,129],["ἐπὶ",9,1],["τὸν",1,6],["τροχόν",913,7]],"And not being able by any means to strangle him, they tore off his skin, together with the extreme tips of his fingers, flayed him, and then haled him to the wheel;"],["8",[["Περὶ",71,1],["ὃν",24,106],["ἐκ",21,1],["σφονδύλων",6158,77],["ἐκμελιζόμενος",5322,114],["ἑώρα",111,14],["τὰς",1,39],["ἑαυτοῦ",92,48],["σάρκας",287,40],["περιλακιζομένας",8007,312],["καὶ",2,8],["κατὰ",32,1],["σπλάγχνων",2203,45],["σταγόνας",2968,40],["αἵματος",148,24],["ἀποῤῥεούσας",4549,345]],"around which his vertebral joints were loosened, and he saw his own flesh torn to shreds, and streams of blood flowing from his entrails."],["9",[["Μέλλων",1143,67],["δὲ",14,12],["ἀποθνήσκειν",108,54]],"And when about to die, he said,"],["10",[["ἔφη",655,14],["ἡμεῖς",6,193],["μὲν",281,12],["ὦ",641,320],["μιαιρώτατε",0,0],["τύραννε",784,251],["διὰ",54,1],["παιδείαν",569,10],["καί",2,8],["ἀρετὴν",1400,10],["Θεοῦ",20,21],["ταῦτα",16,249],["πάσχομεν",1976,241]],"We, O accursed tyrant, suffer this for the sake of Divine education and virtue."],["11",[["Σὺ",5,156],["δὲ",14,12],["διὰ",54,1],["τὴν",1,9],["ἀσέβειαν",722,10],["καὶ",2,8],["μιαιφονίαν",7746,10],["ἀκαταλύτους",8830,109],["καρτερήσεις",2462,159],["βασάνους",842,40]],"But thou, for thy impiety and blood-shedding, shalt endure indissoluble torments."],["12",[["Καὶ",2,8],["τούτου",16,126],["θανόντος",585,521],["ἀδελφοπρεπῶς",8807,17],["τὸν",1,6],["τέταρτον",560,59],["ἐπεσπῶντο",2849,131],["λέγοντες",31,137]],"And thus having died worthily of his brethren, they dragged forward the fourth, saying,"],["13",[["Μὴ",25,8],["μανῄς",3900,279],["καὶ",2,8],["σὺ",5,156],["τοῖς",1,138],["ἀδελφοῖς",66,139],["σου",5,146],["τὴν",1,9],["αὐτὴν",3,98],["μανίαν",3591,10],["ἀλλὰ",107,17],["πεισθεὶς",343,206],["τῷ",1,110],["βασιλεῖ",22,113],["σῶζε",171,239],["σεαυτόν",293,82]],"Do not thou share the madness of thy brethren: but give regard to the king, and save thyself."],["14",[["Ὁ",1,4],["δὲ",14,12],["αὐτοῖς",3,142],["ἔφη",655,14],["οὐχ",12,17],["οὕτως",70,17],["καυστικώτερον",5756,17],["ἔχετε",124,84],["κατʼ",32,1],["ἐμοῦ",6,48],["τὸ",1,32],["πῦρ",118,33],["ὥστε",345,17],["με",6,82],["δειλανδρῆσαι",5563,100]],"But he said to them, You have not a fire so scorching as to make me play the coward."],["15",[["Μὰ",5881,12],["τὸν",1,6],["μακάριον",803,59],["τῶν",1,76],["ἀδελφῶν",66,77],["μου",6,48],["θάνατον",169,7],["καὶ",2,8],["τὸν",1,6],["αἰώνιον",388,59],["τοῦ",1,30],["τυράννου",784,21],["ὄλεθρον",1715,7],["καὶ",2,8],["τὸν",1,6],["ἀοίδιμον",6323,59],["τῶν",1,76],["εὐσεβῶν",1246,163],["βίον",726,7],["οὐκ",12,17],["ἀρνήσομαι",3716,231],["τὴν",1,9],["εὐγενῆ",2273,37],["ἀδελφότητα",3688,10]],"By the blessed death of my brethren, and the eternal punishment of the tyrant, and the glorious life of the pious, I will not repudiate the noble brotherhood."],["16",[["Ἐπινόει",4631,239],["τύραννε",784,251],["βασάνους",842,40],["ἵνα",101,8],["καὶ",2,8],["διὰ",54,1],["τούτων",16,214],["μάθῃς",923,170],["ὅτι",19,8],["ἀδελφός",66,5],["εἰμι",10,149],["τῶν",1,76],["προβεβανασισθέντων",0,0]],"Invent, O tyrant, tortures; that you may learn, even through them, that I am the brother of those tormented before."],["17",[["Ταῦτα",16,249],["ἀκούσας",53,155],["ὁ",1,4],["αἱμοβόρος",6862,16],["καὶ",2,8],["φονώδης",8688,16],["καὶ",2,8],["πανμιαιρώτατος",0,0],["Ἀντίοχος",853,5],["ἐκέλευσεν",1512,3],["τὴν",1,9],["γλῶτταν",385,10],["αὐτοῦ",3,48],["ἐκτεμεῖν",4085,100]],"When he had said this, the bloodthirsty, and murderous, and unhallowed Antiochus ordered his tongue to be cut out."],["18",[["Ὁ",1,4],["δὲ",14,12],["ἔφη",655,14],["κᾂν",2095,105],["ἀφέλῃς",367,170],["τὸ",1,32],["τῆς",1,18],["φωνῆς",95,19],["ὄργανον",1579,20],["καὶ",2,8],["σιωπώντων",1282,164],["ἀκούει",53,87],["ὁ",1,4],["Θεός",20,5]],"But he said, Even if you take away the organ of speech, yet God hears the silent."],["19",[["Ἰδοὺ",51,17],["κεχάλασται",2808,372],["ἡ",1,11],["γλῶσσα",385,13],["τέμνε",2982,239],["οὐ",12,17],["γὰρ",40,12],["παρὰ",72,1],["τοῦτο",16,122],["τὸν",1,6],["λογισμὸν",498,7],["ἡμῶν",6,41],["γλωσσοτομήσεις",4750,159]],"Behold, my tongue is extended, cut it off; for not for that shalt thou extirpate our reasoning."],["20",[["Ἡδέως",3028,17],["ὑπὲρ",139,1],["τοῦ",1,30],["Θεοῦ",20,21],["τὰ",1,42],["τοῦ",1,23],["σώματος",451,24],["μέλη",1594,43],["ἀκρωτηριαζόμενα",6272,203]],"Gladly do we lose our limbs in behalf of God."],["21",[["Σὲ",5,161],["δὲ",14,12],["ταχέως",1563,17],["μετελεύσεται",3095,89],["ὁ",1,4],["Θεός",20,5],["τὴν",1,9],["γὰρ",40,12],["τῶν",1,76],["θείων",1340,163],["ὕμνων",1499,77],["μελῳδὸν",7710,37],["γλῶτταν",385,10],["ἐκτέμνεις",4085,145]],"But God shall speedily find you, since you cut off the tongue, the instrument of divine melody."]]