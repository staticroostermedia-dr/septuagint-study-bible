[["1",[["Ὡς",36,8],["δὲ",14,12],["καὶ",2,8],["οὗτος",16,112],["μακαρίως",803,17],["ἐναπέθανεν",4608,3],["καταβληθεὶς",1075,206],["εἰς",8,1],["λέβητα",1343,7],["ὁ",1,4],["ἕβδομος",460,16],["παρεγίνετο",372,22],["πάντων",11,163],["νεώτερος",513,16]],"When he, too, had undergone blessed martyrdom, and died in the caldron into which he had been thrown, the seventh, the youngest of all, came forward:"],["2",[["Ὅν",24,106],["κατοικτειρήσας",5751,155],["ὁ",1,4],["τύραννος",784,5],["καίπερ",2916,12],["δεινῶς",3818,17],["ὑπὸ",122,1],["τῶν",1,76],["ἀδελφῶν",66,77],["αὐτοῦ",3,48],["κακισθεὶς",7355,206],["ὁρῶν",111,67],["ἤση",699,14],["τὰ",1,42],["δεσμὰ",1032,43],["περικείμενον",5011,205]],"whom the tyrant pitying, though he had been dreadfully reproached by his brethren,"],["3",[["πλησιέστερον",0,0],["αὐτὸν",3,82],["μετεπέμψατο",3595,26],["καὶ",2,8],["παρηγορεῖν",7950,54],["ἐπειρᾶτο",2481,22],["λέγων",31,67]],"seeing him already encompassed with chains, had him brought nearer, and endeavoured to counsel him, saying,"],["4",[["Τῆς",1,18],["μὲν",281,12],["τῶν",1,76],["ἀδελφῶν",66,77],["σου",5,146],["ἀπονοίας",5263,40],["τὸ",1,32],["τὲλος",369,33],["ὁρᾷς",111,145],["διὰ",54,1],["γὰρ",40,12],["ἀπείθειαν",5242,10],["στρεβλωθέντες",2969,244],["τεθνήκασιν",585,406],["σὺ",5,156],["εἰ",77,8],["μὲν",281,12],["μὴ",25,8],["πεισθείης",343,687],["τὰλας",4468,16],["βασανισθεὶς",1437,206],["καὶ",2,8],["πασανισθεὶς",0,0],["καὶ",2,8],["αὐτὸς",3,158],["τεθνήξῃ",585,116],["πρὸ",235,1],["ὥρας",839,19]],"Thou seest the end of the madness of thy brethren: for they have died in torture through disobedience; and you, if disobedient, having been miserably tormented, will yourself perish prematurely."],["5",[["Πεισθείης",343,687],["δὲ",14,12],["φίλος",334,16],["ἔσῃ",10,116],["καὶ",2,8],["τῶν",1,76],["ἐπὶ",9,1],["τῆς",1,18],["βασιλείας",157,19],["ἀφηγήσῃ",1364,116],["πραγμάτων",507,45]],"But if you obey, you shall be my friend, and have a charge over the affairs of the kingdom."],["6",[["Καὶ",2,8],["ταῦτα",16,249],["παρακαλῶν",432,67],["τὴν",1,9],["μητέρα",188,10],["τοῦ",1,30],["παιδὸς",126,21],["μετεπέμψατο",3595,26],["ὄπως",9878,31],["αὐτὴν",3,98],["ἐμεήσαν",0,0],["υἱῶν",13,77],["στερηθῖσαν",0,0],["παρορμήσειεν",5945,276],["ἐπὶ",9,1],["τὴν",1,9],["μσωτηρίαν",0,0],["εὐπειθῆ",7231,59],["τὸν",1,6],["περιλειπόμενον",4368,364]],"And having thus exhorted him, he sent for the mother of the boy; that, by condoling with her for the loss of so many sons, he might incline her, through the hope of safety, to render the survivor obedient."],["7",[["Ὁ",1,4],["δὲ",14,12],["τῆν",1,9],["μητρὸς",188,19],["τῇ",1,95],["Ἐβραΐδι",0,0],["φωνῇ",95,2],["προτρεψαμένης",3947,617],["αὐτὸν",3,82],["ὡς",36,8],["ἐροῦμεν",191,241],["μετὰ",29,1],["μικρὸν",365,29],["ὕστερον",2012,29],["ἀπολύσατε",1397,69],["με",6,82],["φησίν",655,87]],"And he, after his mother had urged him on in the Hebrew tongue, (as we shall soon relate) says,"],["8",[["εἴπω",18,227],["τῷ",1,110],["βασιλεῖ",22,113],["καὶ",2,8],["τοῖς",1,138],["σὺν",309,1],["αὐτῷ",3,49],["φίλοις",334,215],["πᾶσιν",11,215]],"Release me, that I may speak to the king and all his friends."],["9",[["Καὶ",2,8],["ἐπιχαρέντες",1939,244],["μάλιστα",3600,17],["ἐπὶ",9,1],["τῇ",1,95],["ἐπαγγελίᾳ",3442,2],["τοῦ",1,30],["παιδὸς",126,21],["ταχέως",1563,17],["ἔλυσαν",1381,141],["αὐτόν",3,82]],"And they, rejoicing exceedingly at the promise of the youth, quickly let him go."],["10",[["Καὶ",2,8],["σραμὼν",0,0],["ἐπὶ",9,1],["πλησίον",292,17],["τῶν",1,44],["τηγάνων",2399,45],["ἔφη",655,14],["ἀνόσιε",2997,313]],"And he, running up to the pans, said,"],["11",[["φησὶν",655,87],["καὶ",2,8],["πάντων",11,163],["τῶν",1,76],["πονηρῶν",164,163],["ἀσεβέστατε",246,313],["τύραννε",784,251],["οὐκ",12,17],["ᾐδέσθης",3499,363],["παρὰ",72,1],["τοῦ",1,30],["Θεοῦ",20,21],["λαβὼν",46,155],["τὰ",1,42],["ἀγαθὰ",113,65],["καὶ",2,8],["τὴν",1,9],["βασιλείαν",157,10],["τούς",1,56],["θεράποντας",801,31],["αὐτοῦ",3,48],["κατακτεῖναι",5722,100],["καὶ",2,8],["τοὺς",1,56],["τῆς",1,18],["εὐσεβείας",896,19],["στρεβλῶσαι",2969,100]],"Impious tyrant, and most blasphemous man, wert thou not ashamed, having received prosperity and a kingdom from God, to slay His servants, and to rack the doers of godliness?"],["12",[["Ἀνθ",0,0],["ὧ",24,370],["ταμιεύεταί",6170,108],["σε",5,161],["ἡ",1,11],["θεια",1340,74],["δίκη",1224,13],["πυκνοτέρῳ",3347,111],["καὶ",2,8],["αἰωνίῳ",388,111],["πυεὶ",8242,134],["καὶ",2,8],["βασάνοις",842,71],["αἳ",1,183],["εἰς",8,1],["ὅλον",233,59],["τὸν",1,6],["αιῶνα",0,0],["οὐκ",12,17],["ἀνήσουσίν",1082,207],["σε",5,161]],"Wherefore the divine vengeance is reserving thee for eternal fire and torments, which shall cling to thee for all time."],["13",[["Οὐκ",12,17],["ᾐδέσθης",3499,363],["ἄνθρωπος",43,5],["ὢν",10,67],["θηριωδέστατε",4823,313],["τοὺς",1,56],["ὁμοιοπαθεῖς",6664,58],["καὶ",2,8],["ἐκ",21,1],["τῶν",1,76],["αὐτῶν",3,41],["γεγονότας",30,277],["στοιξείων",0,0],["γλωττοτομῆσαι",4750,100],["καὶ",2,8],["τοῦτον",16,259],["καταικίσας",3553,155],["τὸν",1,6],["τρόπον",243,7],["βασανίσαι",1437,100]],"Wert thou not ashamed, man as thou art, yet most savage, to cut out the tongues of men of like feeling and origin, and having thus abused to torture them?"],["14",[["Ἀλλʼ",107,17],["οἱ",1,128],["μὴν",295,12],["εὐγενῶς",2273,17],["ἀποθανόντες",108,188],["ἐπλήρωσαν",529,141],["τὴν",1,9],["εἰν",4,1],["τὸν",1,6],["Θεὸν",20,7],["εὐσέβειαν",896,10]],"But they, bravely dying, fulfilled their religion towards God."],["15",[["Σὺ",5,156],["δὲ",14,12],["κακὸς",161,16],["κακῶς",2183,17],["οἰμώξεις",7858,159],["τοὺς",1,56],["τῆς",1,18],["ἀρετῆν",9162,54],["ἀγωνιστὰν",8802,7],["ἀναιτίως",3698,17],["ἀποκτεῖναι",298,100]],"But thou shalt groan according to thy deserts for having slain without cause the champions of virtue."],["16",[["Ὅθεν",1154,17],["καὶ",2,8],["αὐτὸς",3,158],["ἀποθνήσκειν",108,54],["μέλλων",1143,67],["ἔφη",655,14]],"Wherefore, he continued, I myself, being about to die,"],["17",[["οὐκ",12,17],["ἀπαυτομολῶ",6326,149],["τῆς",1,18],["τῶν",1,76],["ἀδελφῶν",66,77],["μου",6,83],["μαρτυρίας",2744,19]],"will not forsake the testimony of my brethren."],["18",[["Ἐπικαλοῦμαι",340,252],["δὲ",14,12],["τὸν",1,6],["πατρῷον",2948,59],["Θεὸν",20,7],["ὅπως",236,8],["ἵλεως",1410,16],["γένει",517,53],["μου",6,48]],"And I call upon the God of my fathers to be merciful to my race."],["19",[["Σὲ",5,161],["δὲ",14,12],["καὶ",2,8],["ἐν",4,1],["τῷ",1,110],["νῦν",89,17],["βίῳ",726,113],["καὶ",2,8],["θανόντα",585,381],["τιμωρήσεται",2800,89]],"But thee, both living and dead, he will punish."],["20",[["Καὶ",2,8],["ταῦτα",16,249],["κατευξάμενος",5749,245],["ἐαυτὸν",0,0],["ἔοιψεν",0,0],["κατὰ",32,1],["τῶν",1,44],["τηγάνων",2399,45],["καὶ",2,8],["οὕτως",70,17],["ἀπέδεκεν",0,0]],"Thus having prayed, he hurled himself into the pans; and so expired."]]