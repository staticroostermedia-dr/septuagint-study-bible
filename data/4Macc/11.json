[["1",[["Ὡς",36,8],["δὲ",14,12],["καὶ",2,8],["οὗτος",16,112],["ταῖς",1,70],["βασάνοις",842,71],["καταικισθεὶς",3553,206],["ἐναπέθανεν",4608,3],["ὁ",1,4],["πέμπτος",845,16],["παρεπήδησεν",7932,3],["λέγων",31,67]],"And when he had died, disfigured in his torments, the fifth leaped forward, and said,"],["2",[["Οὐ",12,17],["μέλλω",1143,149],["τύραννε",784,251],["πρὸς",15,1],["τὸν",1,6],["ὑπὲρ",139,1],["τῆς",1,18],["ἀρετῆς",1400,19],["βασανισμὸν",5520,7],["παραιτεῖσθαι",3111,104]],"I intend not, O tyrant, to get excused from the torment which is in behalf of virtue."],["3",[["Αὐτὸς",3,158],["δʼ",14,12],["ἀπʼ",17,1],["ἐμαυτοῦ",891,48],["παρῆλθον",410,141],["ὅπως",236,8],["κᾀμὲ",0,0],["κατακτείνας",5722,155],["περὶ",71,1],["πλειόνων",938,79],["ἀδικημάτων",1924,45],["ὀφειλήσῃς",2156,170],["τῇ",1,95],["οὐρανίῳ",3609,96],["δίκῃ",1224,2],["τιμωρίαν",2305,10]],"But I have come of my own accord, that by the death of me, you may owe heavenly vengeance a punishment for more crimes."],["4",[["Ὦ",641,320],["μισάρετε",7752,313],["καὶ",2,8],["μισάνθρωπε",7748,313],["τὶ",39,119],["δράσαντας",4223,466],["ἡμᾶς",6,60],["τοῦτον",16,259],["πορθεῖς",8083,145],["τὸν",1,6],["τρόπον",243,7]],"O thou hater of virtue and of men, what have we done that thou thus revellest in our blood?"],["5",[["Ἢ",60,8],["κακόν",161,29],["σοι",5,151],["δοκεῖ",798,87],["ὅτι",19,8],["τὸν",1,6],["πάντων",11,163],["κτιστὴν",7569,37],["εὐσεβοῦμεν",4241,241],["καὶ",2,8],["κατὰ",32,1],["τὸν",1,6],["ἐνάρετον",9445,59],["αὐτοῦ",3,48],["ζῶμεν",117,241],["νόμον",140,7]],"Does it seem evil to thee that we worship the Founder of all things, and live according to his surpassing law?"],["6",[["Ἀλλὰ",107,17],["ταῦτα",16,249],["τιμῶν",1043,67],["οὐ",12,17],["βασάνων",842,61],["ἐστὶν",10,87],["ἄξια",1104,65]],"But this is worthy of honours, not of torments;"],["6a",[["Εἴπερ",77,8],["ᾐσθάνου",2569,588],["ἀνθρώπου",43,21],["πόθων",8239,77],["καὶ",2,8],["ἐλπίδα",527,10],["εἶχες",124,216],["παρὰ",72,1],["Θεῷ",20,113],["σωτηρίου",471,24]],"hadst thou been capable of the higher feelings of men, and possessed the hope of salvation from God."],["6b",[["νῦν",89,17],["ἰδὲ",693,17],["ἀλλότριος",377,16],["ὢν",10,67],["Θεοῦ",20,21],["πολεμεῖς",304,145],["τοὺς",1,56],["εὐσεβοῦντας",4241,229],["εἰς",8,1],["τὸν",1,6],["Θεόν",20,7]],"Behold, now, being alien from God, thou makest war against those who are religious toward God."],["9",[["Τοιαῦτα",629,66],["λέγοντα",31,232],["οἱ",1,128],["δορυφόροι",2713,130],["δήσαντες",439,188],["αὐτὸν",3,82],["εἷλκον",1222,129],["ἐπὶ",9,1],["τὸν",1,6],["καταπέλτην",0,0]],"As he said this, the spearbearers bound him, and drew him to the catapelt:"],["10",[["ἐφʼ",9,1],["ὃ",1,4],["δήσαντες",439,188],["αὐτὸν",3,82],["ἐπὶ",9,1],["τὰ",1,42],["γόνατα",1300,43],["καὶ",2,8],["ταῦτα",16,249],["ποδάγραις",8057,71],["σιδηραῖς",1063,290],["ἐφορμάσαντες",9689,188],["τὴν",1,9],["ὀσφὺν",795,10],["αὐτοῦ",3,48],["ἐπὶ",9,1],["τὸν",1,6],["τροχιαῖον",8621,59],["σφῆνα",6157,7],["κατέκαμψαν",4268,141],["περὶ",71,1],["ὃν",24,106],["ὅλος",233,16],["ἐπὶ",9,1],["τὸν",1,6],["τρονὸν",0,0],["σκορπίου",2775,21],["τρόπον",243,7],["ἀνακλώμενος",8913,628],["ἐξεμελίζετο",5322,22]],"to which binding him at his knees, and fastening them with iron fetters, they bent down his loins upon the wedge of the wheel; and his body was then dismembered, scorpion-fashion."],["11",[["Κατὰ",32,1],["τοῦτον",16,259],["τὸν",1,6],["τρόπον",243,7],["καὶ",2,8],["τὸ",1,32],["πνεῦμα",167,33],["στενοχωρούμενος",3964,114],["καὶ",2,8],["τὸ",1,32],["σῶμα",451,33],["ἀγχόμενος",5289,114],["καλὰς",264,109],["ἔλεγεν",31,14],["ἄκων",6410,16]],"With his breath thus confined, and his body strangled, he said,"],["12",[["ὦ",641,320],["τύραννε",784,251],["χάριτας",366,40],["ἡμῖν",6,142],["χαρίζῃ",3387,166],["διὰ",54,1],["γενναιοτέρων",1584,163],["πόνων",564,77],["ἐπιδείξασθαι",2330,103],["παρέχων",2292,67],["τὴν",1,9],["εἰς",8,1],["τὸν",1,6],["νόμον",140,7],["ἡμῶν",6,41],["καρτερίαν",3549,10]],"A great favour thou bestowest upon us, O tyrant, by enabling us to manifest our adherence to the law by means of nobler sufferings."],["13",[["Τελευτήσαντος",593,521],["δὲ",14,12],["καὶ",2,8],["τούτου",16,126],["ὁ",1,4],["ἕκτος",1259,16],["ἤγετο",227,22],["μειρακίσκος",5850,5],["ὃς",24,247],["πυνθανομένου",2491,425],["τοῦ",1,30],["τύραννου",784,21],["εἰ",77,8],["βούλοιτο",461,686],["φαγὼν",153,155],["ἀπολύεσθαι",1397,104],["ὁ",1,4],["δὲ",14,12],["ἔφη",655,14]],"He also being dead, the sixth, quite a youth, was brought out; and on the tyrant asking him whether he would eat and be delivered, he said,"],["14",[["Ἐγὼ",6,158],["τῇ",1,95],["μὲν",281,12],["ἡλικίᾳ",1752,2],["τῶν",1,76],["ἀδελφῶν",66,77],["μου",6,48],["εἰμὶ",10,149],["νεώτερος",513,16],["τῇ",1,95],["δὲ",14,12],["διανοίᾳ",754,2],["ἡλικιώτης",9792,5]],"I am indeed younger than my brothers, but in understanding I am as old;"],["15",[["Εἰς",8,1],["τὰ",1,42],["αὐτὰ",3,66],["γὰρ",40,12],["καὶ",2,8],["γεννηθέντες",222,244],["καὶ",2,8],["τραφέντες",1742,244],["ὑπὲρ",139,1],["τῶν",1,76],["αὐτῶν",3,41],["καὶ",2,8],["ἀποθνήσκειν",108,54],["ὀφείλομεν",2156,241],["ὁμοίως",1754,17]],"for having been born and reared unto the same end, we are bound to die also in behalf of the same cause."],["16",[["Ὥστε",345,17],["εἰ",77,8],["σοὶ",5,151],["δοκεῖ",798,87],["βασανίξειν",1437,81],["μὴ",25,8],["μιαιροφαγοῦτας",0,0],["βασάνιζε",1437,239]],"So that if thou think proper to torment us for not eating the unclean;—torment!"],["17",[["Ταῦτα",16,249],["αὐτὸν",3,82],["εἰπόντα",18,485],["παρῆγον",2290,129],["ἐπὶ",9,1],["τὸν",1,6],["τροχόν",913,7]],"As he said this, they brought him to the wheel."],["18",[["Ἐφʼ",9,1],["οὗ",120,17],["κατατεινόμενος",3864,114],["εὐμελῶς",5649,17],["καὶ",2,8],["ἐκσφονοδυλιζόμενος",0,0],["ὑπεκαίετο",4681,22]],"Extended upon which, with limbs racked and dislocated, he was gradually roasted from beneath."],["19",[["Καὶ",2,8],["ὀβελίσκους",6646,31],["ὀξεῖς",1664,130],["πυρώσαντες",939,188],["τοῖς",1,138],["νότοις",586,139],["προσέφερον",362,129],["καὶ",2,8],["τὰ",1,42],["πλευπὰ",0,0],["διαπείραντες",7038,188],["ἀπʼ",17,1],["αὐτοῦ",3,48],["σπλάγχνα",2203,43],["διέκαιον",7016,129]],"And having heated sharp spits, they approached them to his back; and having transfixed his sides, they burned away his entrails."],["20",[["Ὁ",1,4],["δὲ",14,12],["βασανιζόμενος",1437,114],["ὦ",641,320],["ἱεροπρεποῦς",6635,153],["αἰῶνος",100,21],["ἔλεγεν",31,14],["ἐφʼ",9,1],["ὃν",24,106],["διὰ",54,1],["τὴν",1,9],["εὐσέβειαν",896,10],["εἰς",8,1],["γυμνασίαν",6964,10],["πόνων",564,77],["ἀδελφοὶ",66,51],["τοσοῦτοι",1696,193],["κληθέντες",128,244],["οὐκ",12,17],["ἐνικήθημεν",1442,498]],"And he, while tormented, said, O period good and holy, in which, for the sake of religion, we brothers have been called to the contest of pain, and have not been conquered."],["21",[["Ἀνίκητος",3700,16],["γάρ",40,12],["ἐστιν",10,87],["ὦ",641,320],["τύραννε",784,251],["ἡ",1,11],["εὐσεβὴς",1246,15],["ἐπιστήμη",892,13]],"For religious understanding, O tyrant, is unconquered."],["22",[["Καλοκᾳγαθίᾳ",0,0],["καθωπλισμένος",3545,414],["τεθνήξομαι",585,231],["κἀγὼ",611,8],["μετὰ",29,1],["τῶν",1,76],["ἀδελφῶν",66,77],["μοῦ",6,48]],"Armed with upright virtue, I also shall depart with my brethren."],["23",[["Μέγαν",65,59],["σοὶ",5,151],["προσβάλλων",2962,67],["καὶ",2,8],["αὐτὸς",3,158],["ἀλάστορα",4513,7],["καινουργὲ",7354,313],["τῶν",1,123],["βασάνων",842,61],["καὶ",2,8],["πολέμιε",1121,313],["τῶν",1,76],["ἀληθῶς",1796,17],["εὐσεβούντων",4241,164]],"I, too, bearing with me a great avenger, O deviser of tortures, and enemy of the truly pious."],["24",[["Ἓξ",528,57],["μειράκια",4318,63],["κατελύσαμέν",861,288],["σου",5,146],["τὴν",1,9],["τυραννίδα",3381,10]],"We six youths have destroyed thy tyranny."],["25",[["Τὸ",1,32],["γὰρ",40,12],["μὴ",25,8],["δυνηθῆναί",184,174],["σε",5,161],["μεταπεῖσαι",7731,100],["τὸν",1,6],["λογισμὸν",498,7],["ἡμῶν",6,41],["μήτε",2105,12],["βιάσασθαι",2264,103],["πρὸς",15,1],["τὴν",1,9],["μιαιροφαγίαν",0,0],["οὐ",12,17],["κατάλυσίς",4872,13],["ἐστιν",10,87],["σοῦ",5,146]],"For is not your inability to overrule our reasoning, and to compel us to eat the unclean, thy destruction?"],["26",[["Τὸ",1,32],["πῦρ",118,33],["σου",5,146],["ψυχρὸν",5181,29],["ἡμῖν",6,142],["καὶ",2,8],["ἄπονοι",9265,130],["οἱ",1,128],["καταπέλται",0,0],["καὶ",2,8],["ἀδύνατος",1648,15],["ἡ",1,11],["βία",1504,13],["σου",5,146]],"Your fire is cold to us, your catapelts are painless, and your violence harmless."],["27",[["Οὐ",12,17],["γὰρ",40,12],["τυράννου",784,21],["ἀλλὰ",107,17],["θείου",2907,24],["νόμου",140,21],["προεστήκασιν",3344,406],["ἡμῶν",6,41],["οἱ",1,128],["δορυφίροι",0,0],["διὰ",54,1],["τοῦτο",16,122],["ἀνίκητον",3700,29],["ἕχομεν",0,0],["τὸν",1,6],["λογι",7646,361],["σμόν",0,0]],"For the guards not of a tyrant but of a divine law are our defenders: through this we keep our reasoning unconquered."]]