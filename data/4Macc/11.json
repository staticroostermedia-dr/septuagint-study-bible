[["1",[["Ὡς",36,8],["δὲ",14,12],["καὶ",2,8],["οὗτος",16,112],["ταῖς",1,70],["βασάνοις",841,71],["καταικισθεὶς",3549,206],["ἐναπέθανεν",4585,3],["ὁ",1,4],["πέμπτος",844,16],["παρεπήδησεν",7874,3],["λέγων",31,67]],"And when he had died, disfigured in his torments, the fifth leaped forward, and said,"],["2",[["Οὐ",12,17],["μέλλω",1143,149],["τύραννε",784,250],["πρὸς",15,1],["τὸν",1,6],["ὑπὲρ",139,1],["τῆς",1,18],["ἀρετῆς",1398,19],["βασανισμὸν",5489,7],["παραιτεῖσθαι",3102,104]],"I intend not, O tyrant, to get excused from the torment which is in behalf of virtue."],["3",[["Αὐτὸς",3,158],["δʼ",14,12],["ἀπʼ",17,1],["ἐμαυτοῦ",890,48],["παρῆλθον",404,141],["ὅπως",240,8],["κᾀμὲ",0,0],["κατακτείνας",5688,155],["περὶ",72,1],["πλειόνων",938,79],["ἀδικημάτων",1921,45],["ὀφειλήσῃς",2150,170],["τῇ",1,95],["οὐρανίῳ",3602,96],["δίκῃ",1219,2],["τιμωρίαν",2293,10]],"But I have come of my own accord, that by the death of me, you may owe heavenly vengeance a punishment for more crimes."],["4",[["Ὦ",646,316],["μισάρετε",7697,309],["καὶ",2,8],["μισάνθρωπε",7693,309],["τὶ",39,119],["δράσαντας",4211,458],["ἡμᾶς",6,60],["τοῦτον",16,259],["πορθεῖς",8023,145],["τὸν",1,6],["τρόπον",245,7]],"O thou hater of virtue and of men, what have we done that thou thus revellest in our blood?"],["5",[["Ἢ",61,8],["κακόν",161,29],["σοι",5,151],["δοκεῖ",801,87],["ὅτι",19,8],["τὸν",1,6],["πάντων",11,163],["κτιστὴν",7519,37],["εὐσεβοῦμεν",4228,241],["καὶ",2,8],["κατὰ",32,1],["τὸν",1,6],["ἐνάρετον",9378,59],["αὐτοῦ",3,48],["ζῶμεν",107,241],["νόμον",140,7]],"Does it seem evil to thee that we worship the Founder of all things, and live according to his surpassing law?"],["6",[["Ἀλλὰ",108,17],["ταῦτα",16,248],["τιμῶν",1020,67],["οὐ",12,17],["βασάνων",841,61],["ἐστὶν",10,87],["ἄξια",1102,65]],"But this is worthy of honours, not of torments;"],["6a",[["Εἴπερ",77,8],["ᾐσθάνου",2565,665],["ἀνθρώπου",43,21],["πόθων",8184,77],["καὶ",2,8],["ἐλπίδα",530,10],["εἶχες",124,217],["παρὰ",73,1],["Θεῷ",20,113],["σωτηρίου",472,24]],"hadst thou been capable of the higher feelings of men, and possessed the hope of salvation from God."],["6b",[["νῦν",90,17],["ἰδὲ",713,17],["ἀλλότριος",381,16],["ὢν",10,67],["Θεοῦ",20,21],["πολεμεῖς",305,145],["τοὺς",1,56],["εὐσεβοῦντας",4228,229],["εἰς",8,1],["τὸν",1,6],["Θεόν",20,7]],"Behold, now, being alien from God, thou makest war against those who are religious toward God."],["9",[["Τοιαῦτα",630,66],["λέγοντα",31,232],["οἱ",1,128],["δορυφόροι",2707,130],["δήσαντες",440,190],["αὐτὸν",3,82],["εἷλκον",1217,129],["ἐπὶ",9,1],["τὸν",1,6],["καταπέλτην",0,0]],"As he said this, the spearbearers bound him, and drew him to the catapelt:"],["10",[["ἐφʼ",9,1],["ὃ",1,4],["δήσαντες",440,190],["αὐτὸν",3,82],["ἐπὶ",9,1],["τὰ",1,42],["γόνατα",1300,43],["καὶ",2,8],["ταῦτα",16,248],["ποδάγραις",7997,71],["σιδηραῖς",1063,287],["ἐφορμάσαντες",9618,190],["τὴν",1,9],["ὀσφὺν",798,10],["αὐτοῦ",3,48],["ἐπὶ",9,1],["τὸν",1,6],["τροχιαῖον",8561,59],["σφῆνα",6128,7],["κατέκαμψαν",4256,141],["περὶ",72,1],["ὃν",24,106],["ὅλος",235,16],["ἐπὶ",9,1],["τὸν",1,6],["τρονὸν",0,0],["σκορπίου",2765,21],["τρόπον",245,7],["ἀνακλώμενος",8850,610],["ἐξεμελίζετο",5290,22]],"to which binding him at his knees, and fastening them with iron fetters, they bent down his loins upon the wedge of the wheel; and his body was then dismembered, scorpion-fashion."],["11",[["Κατὰ",32,1],["τοῦτον",16,259],["τὸν",1,6],["τρόπον",245,7],["καὶ",2,8],["τὸ",1,32],["πνεῦμα",168,33],["στενοχωρούμενος",3954,114],["καὶ",2,8],["τὸ",1,32],["σῶμα",454,33],["ἀγχόμενος",5258,114],["καλὰς",266,109],["ἔλεγεν",31,14],["ἄκων",6380,16]],"With his breath thus confined, and his body strangled, he said,"],["12",[["ὦ",646,316],["τύραννε",784,250],["χάριτας",368,40],["ἡμῖν",6,142],["χαρίζῃ",3151,166],["διὰ",56,1],["γενναιοτέρων",1583,163],["πόνων",566,77],["ἐπιδείξασθαι",2317,103],["παρέχων",2279,67],["τὴν",1,9],["εἰς",8,1],["τὸν",1,6],["νόμον",140,7],["ἡμῶν",6,41],["καρτερίαν",3545,10]],"A great favour thou bestowest upon us, O tyrant, by enabling us to manifest our adherence to the law by means of nobler sufferings."],["13",[["Τελευτήσαντος",581,513],["δὲ",14,12],["καὶ",2,8],["τούτου",16,126],["ὁ",1,4],["ἕκτος",1259,16],["ἤγετο",224,22],["μειρακίσκος",5817,5],["ὃς",24,246],["πυνθανομένου",2484,418],["τοῦ",1,30],["τύραννου",784,21],["εἰ",77,8],["βούλοιτο",463,664],["φαγὼν",147,155],["ἀπολύεσθαι",1395,104],["ὁ",1,4],["δὲ",14,12],["ἔφη",660,14]],"He also being dead, the sixth, quite a youth, was brought out; and on the tyrant asking him whether he would eat and be delivered, he said,"],["14",[["Ἐγὼ",6,158],["τῇ",1,95],["μὲν",281,12],["ἡλικίᾳ",1755,2],["τῶν",1,76],["ἀδελφῶν",67,77],["μου",6,48],["εἰμὶ",10,149],["νεώτερος",515,16],["τῇ",1,95],["δὲ",14,12],["διανοίᾳ",755,2],["ἡλικιώτης",9718,5]],"I am indeed younger than my brothers, but in understanding I am as old;"],["15",[["Εἰς",8,1],["τὰ",1,42],["αὐτὰ",3,66],["γὰρ",40,12],["καὶ",2,8],["γεννηθέντες",222,243],["καὶ",2,8],["τραφέντες",1743,243],["ὑπὲρ",139,1],["τῶν",1,76],["αὐτῶν",3,41],["καὶ",2,8],["ἀποθνήσκειν",109,54],["ὀφείλομεν",2150,241],["ὁμοίως",1757,17]],"for having been born and reared unto the same end, we are bound to die also in behalf of the same cause."],["16",[["Ὥστε",346,17],["εἰ",77,8],["σοὶ",5,151],["δοκεῖ",801,87],["βασανίξειν",1435,81],["μὴ",25,8],["μιαιροφαγοῦτας",0,0],["βασάνιζε",1435,239]],"So that if thou think proper to torment us for not eating the unclean;—torment!"],["17",[["Ταῦτα",16,248],["αὐτὸν",3,82],["εἰπόντα",18,476],["παρῆγον",2277,129],["ἐπὶ",9,1],["τὸν",1,6],["τροχόν",911,7]],"As he said this, they brought him to the wheel."],["18",[["Ἐφʼ",9,1],["οὗ",120,17],["κατατεινόμενος",3854,114],["εὐμελῶς",5619,17],["καὶ",2,8],["ἐκσφονοδυλιζόμενος",0,0],["ὑπεκαίετο",4656,22]],"Extended upon which, with limbs racked and dislocated, he was gradually roasted from beneath."],["19",[["Καὶ",2,8],["ὀβελίσκους",6606,31],["ὀξεῖς",1663,130],["πυρώσαντες",926,190],["τοῖς",1,138],["νότοις",589,139],["προσέφερον",363,129],["καὶ",2,8],["τὰ",1,42],["πλευπὰ",0,0],["διαπείραντες",6993,190],["ἀπʼ",17,1],["αὐτοῦ",3,48],["σπλάγχνα",2190,43],["διέκαιον",6969,129]],"And having heated sharp spits, they approached them to his back; and having transfixed his sides, they burned away his entrails."],["20",[["Ὁ",1,4],["δὲ",14,12],["βασανιζόμενος",1435,114],["ὦ",646,316],["ἱεροπρεποῦς",6595,153],["αἰῶνος",100,21],["ἔλεγεν",31,14],["ἐφʼ",9,1],["ὃν",24,106],["διὰ",56,1],["τὴν",1,9],["εὐσέβειαν",895,10],["εἰς",8,1],["γυμνασίαν",6917,10],["πόνων",566,77],["ἀδελφοὶ",67,51],["τοσοῦτοι",1692,195],["κληθέντες",128,243],["οὐκ",12,17],["ἐνικήθημεν",1441,491]],"And he, while tormented, said, O period good and holy, in which, for the sake of religion, we brothers have been called to the contest of pain, and have not been conquered."],["21",[["Ἀνίκητος",3694,16],["γάρ",40,12],["ἐστιν",10,87],["ὦ",646,316],["τύραννε",784,250],["ἡ",1,11],["εὐσεβὴς",1244,15],["ἐπιστήμη",891,13]],"For religious understanding, O tyrant, is unconquered."],["22",[["Καλοκᾳγαθίᾳ",0,0],["καθωπλισμένος",2898,408],["τεθνήξομαι",588,231],["κἀγὼ",613,8],["μετὰ",29,1],["τῶν",1,76],["ἀδελφῶν",67,77],["μοῦ",6,48]],"Armed with upright virtue, I also shall depart with my brethren."],["23",[["Μέγαν",66,59],["σοὶ",5,151],["προσβάλλων",2949,67],["καὶ",2,8],["αὐτὸς",3,158],["ἀλάστορα",4490,7],["καινουργὲ",7300,309],["τῶν",1,123],["βασάνων",841,61],["καὶ",2,8],["πολέμιε",1122,309],["τῶν",1,76],["ἀληθῶς",1795,17],["εὐσεβούντων",4228,164]],"I, too, bearing with me a great avenger, O deviser of tortures, and enemy of the truly pious."],["24",[["Ἓξ",531,57],["μειράκια",4304,63],["κατελύσαμέν",861,285],["σου",5,146],["τὴν",1,9],["τυραννίδα",3376,10]],"We six youths have destroyed thy tyranny."],["25",[["Τὸ",1,32],["γὰρ",40,12],["μὴ",25,8],["δυνηθῆναί",185,175],["σε",5,161],["μεταπεῖσαι",7677,100],["τὸν",1,6],["λογισμὸν",500,7],["ἡμῶν",6,41],["μήτε",2098,12],["βιάσασθαι",2249,103],["πρὸς",15,1],["τὴν",1,9],["μιαιροφαγίαν",0,0],["οὐ",12,17],["κατάλυσίς",4846,13],["ἐστιν",10,87],["σοῦ",5,146]],"For is not your inability to overrule our reasoning, and to compel us to eat the unclean, thy destruction?"],["26",[["Τὸ",1,32],["πῦρ",118,33],["σου",5,146],["ψυχρὸν",5155,29],["ἡμῖν",6,142],["καὶ",2,8],["ἄπονοι",9192,130],["οἱ",1,128],["καταπέλται",0,0],["καὶ",2,8],["ἀδύνατος",1649,15],["ἡ",1,11],["βία",1503,13],["σου",5,146]],"Your fire is cold to us, your catapelts are painless, and your violence harmless."],["27",[["Οὐ",12,17],["γὰρ",40,12],["τυράννου",784,21],["ἀλλὰ",108,17],["θείου",2893,24],["νόμου",140,21],["προεστήκασιν",3340,400],["ἡμῶν",6,41],["οἱ",1,128],["δορυφίροι",0,0],["διὰ",56,1],["τοῦτο",16,122],["ἀνίκητον",3694,29],["ἕχομεν",0,0],["τὸν",1,6],["λογι",7594,356],["σμόν",0,0]],"For the guards not of a tyrant but of a divine law are our defenders: through this we keep our reasoning unconquered."]]