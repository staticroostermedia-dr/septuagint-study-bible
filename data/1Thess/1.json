[["1",[["Παῦλος",10586,5],["καὶ",2,8],["Σιλουανὸς",10997,5],["καὶ",2,8],["Τιμόθεος",1953,5],["τῇ",1,95],["ἐκκλησίᾳ",563,2],["Θεσσαλονικέων",10700,77],["ἐν",4,1],["θεῷ",20,113],["πατρὶ",44,113],["καὶ",2,8],["κυρίῳ",7,113],["Ἰησοῦ",211,113],["Χριστῷ",1072,113],["χάρις",368,13],["ὑμῖν",5,86],["καὶ",2,8],["εἰρήνη",213,13]],"Paul, Silvanus, and Timothy, to the assembly of the Thessalonians in God the Father and the Lord Jesus Christ: Grace to you and peace from God our Father and the Lord Jesus Christ."],["2",[["Εὐχαριστοῦμεν",3831,241],["τῷ",1,110],["θεῷ",20,113],["πάντοτε",6027,17],["περὶ",72,1],["πάντων",11,163],["ὑμῶν",5,136],["μνείαν",2271,10],["ποιούμενοι",23,520],["ἐπὶ",9,1],["τῶν",1,123],["προσευχῶν",550,61],["ἡμῶν",9994,136],["ἀδιαλείπτως",3682,17]],"We always give thanks to God for all of you, mentioning you in our prayers,"],["3",[["μνημονεύοντες",1900,137],["ὑμῶν",5,136],["τοῦ",1,23],["ἔργου",105,24],["τῆς",1,18],["πίστεως",887,19],["καὶ",2,8],["τοῦ",1,30],["κόπου",1345,21],["τῆς",1,18],["ἀγάπης",1982,19],["καὶ",2,8],["τῆς",1,18],["ὑπομονῆς",1616,19],["τῆς",1,18],["ἐλπίδος",530,19],["τοῦ",1,30],["κυρίου",7,21],["ἡμῶν",9994,136],["Ἰησοῦ",211,21],["Χριστοῦ",1072,21],["ἔμπροσθεν",390,1],["τοῦ",1,30],["θεοῦ",20,21],["καὶ",2,8],["πατρὸς",44,21],["ἡμῶν",9994,136]],"remembering without ceasing your work of faith and labor of love and perseverance of hope in our Lord Jesus Christ, before our God and Father."],["4",[["εἰδότες",1168,263],["ἀδελφοὶ",67,396],["ἠγαπημένοι",214,564],["ὑπὸ",122,1],["τοῦ",1,30],["θεοῦ",20,21],["τὴν",1,9],["ἐκλογὴν",10550,10],["ὑμῶν",5,136]],"We know, brothers loved by God, that you are chosen,"],["5",[["ὅτι",19,8],["τὸ",1,27],["εὐαγγέλιον",4222,20],["ἡμῶν",9994,136],["οὐκ",12,12],["ἐγενήθη",30,715],["εἰς",8,1],["ὑμᾶς",5,209],["ἐν",4,1],["λόγῳ",48,113],["μόνον",302,29],["ἀλλὰ",108,8],["καὶ",2,8],["ἐν",4,1],["δυνάμει",98,2],["καὶ",2,8],["ἐν",4,1],["πνεύματι",168,53],["ἁγίῳ",75,34],["καὶ",2,8],["ἐν",4,1],["πληροφορίᾳ",11142,2],["πολλῇ",74,96],[