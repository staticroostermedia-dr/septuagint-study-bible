[["1",[["Αὐτοὶ",3,195],["γὰρ",40,8],["οἴδατε",1168,330],["ἀδελφοί",67,396],["τὴν",1,9],["εἴσοδον",1002,10],["ἡμῶν",9994,136],["τὴν",1,9],["πρὸς",15,1],["ὑμᾶς",5,209],["ὅτι",19,8],["οὐ",12,12],["κενὴ",780,15],["γέγονεν",30,165]],"For you yourselves know, brothers, our visit to you wasn’t in vain,"],["2",[["ἀλλὰ",108,8],["προπαθόντες",11163,190],["καὶ",2,8],["ὑβρισθέντες",3768,243],["καθὼς",221,8],["οἴδατε",1168,330],["ἐν",4,1],["Φιλίπποις",10623,139],["ἐπαρρησιασάμεθα",3917,868],["ἐν",4,1],["τῷ",1,110],["θεῷ",20,113],["ἡμῶν",9994,136],["λαλῆσαι",50,100],["πρὸς",15,1],["ὑμᾶς",5,209],["τὸ",1,32],["εὐαγγέλιον",4222,33],["τοῦ",1,30],["θεοῦ",20,21],["ἐν",4,1],["πολλῷ",74,111],["ἀγῶνι",2302,113]],"but having suffered before and been shamefully treated, as you know, at Philippi, we grew bold in our God to tell you the Good News of God in much conflict."],["3",[["ἡ",1,11],["γὰρ",40,8],["παράκλησις",2183,13],["ἡμῶν",9994,136],["οὐκ",12,12],["ἐκ",21,1],["πλάνης",3622,19],["οὐδὲ",106,8],["ἐξ",21,1],["ἀκαθαρσίας",888,19],["οὐδὲ",106,8],["ἐν",4,1],["δόλῳ",919,113]],"For our exhortation is not of error, nor of uncleanness, nor in deception."],["4",[["ἀλλὰ",108,8],["καθὼς",221,8],["δεδοκιμάσμεθα",1269,876],["ὑπὸ",122,1],["τοῦ",1,30],["θεοῦ",20,21],["πιστευθῆναι",649,175],["τὸ",1,32],["εὐαγγέλιον",4222,33],["οὕτως",71,17],["λαλοῦμεν",50,241],["οὐχ",12,12],["ὡς",36,12],["ἀνθρώποις",43,139],["ἀρέσκοντες",955,137],["ἀλλὰ",108,8],["θεῷ",20,113],["τῷ",1,110],["δοκιμάζοντι",1269,390],["τὰς",1,39],["καρδίας",64,40],["ἡμῶν",9994,136]],"But even as we have been approved by God to be entrusted with the Good News, so we speak—not as pleasing men, but God, who tests our hearts."],["5",[["οὔτε",477,8],["γάρ",40,8],["ποτε",458,12],["ἐν",4,1],["λόγῳ",48,113],["κολακείας",11164,19],["ἐγενήθημεν",30,794],["καθὼς",221,8],["οἴδατε",1168,330],["οὔτε",477,8],["ἐν",4,1],["προφάσει",3634,2],["πλεονεξίας",3332,19],["θεὸς",20,5],["μάρτυς",875,5]],"For neither were we at any time found using words of flattery, as you know, nor a cloak of covetousness (God is witness),"],["6",[["οὔτε",477,8],["ζητοῦντες",191,137],["ἐξ",21,1],["ἀνθρώπων",43,77],["δόξαν",141,10],["οὔτε",477,8],["ἀφ᾽",17,1],["ὑμῶν",5,136],["οὔτε",477,8],["ἀπ᾽",17,1],["ἄλλων",584,163]],"nor seeking glory from men (neither from you nor from others), when we might have claimed authority as apostles of Christ."],["7",[["δυνάμενοι",185,741],["ἐν",4,1],["βάρει",2871,53],["εἶναι",10135,54],["ὡς",36,12],["Χριστοῦ",1072,21],["ἀπόστολοι",10080,51],["ἀλλ᾽",108,8],["ἐγενήθημεν",30,794],["νήπιοι",1016,130],["ἐν",4,1],["μέσῳ",113,34],["ὑμῶν",5,136],["ὡς",36,12],["ἐὰν",45,8],["τροφὸς",4441,13],["θάλπῃ",4243,173],["τὰ",1,42],["ἑαυτῆς",92,83],["τέκνα",192,43]],"But we were gentle among you, like a nursing mother cherishes her own children."],["8",[["οὕτως",71,17],["ὁμειρόμενοι",11165,741],["ὑμῶν",5,136],["εὐδοκοῦμεν",906,395],["μεταδοῦναι",3296,100],["ὑμῖν",5,86],["οὐ",12,12],["μόνον",302,29],["τὸ",1,32],["εὐαγγέλιον",4222,33],["τοῦ",1,30],["θεοῦ",20,21],["ἀλλὰ",108,8],["καὶ",2,8],["τὰς",1,39],["ἑαυτῶν",92,41],["ψυχάς",63,40],["διότι",177,8],["ἀγαπητοὶ",1920,130],["ἡμῖν",9994,86],["ἐγενήθητε",30,353]],"Even so, affectionately longing for you, we were well pleased to impart to you not the Good News of God only, but also our own souls, because you had become very dear to us."],["9",[["Μνημονεύετε",1900,84],["γάρ",40,8],["ἀδελφοί",67,396],["τὸν",1,6],["κόπον",1345,7],["ἡμῶν",9994,136],["καὶ",2,8],["τὸν",1,6],["μόχθον",1144,7],["νυκτὸς",219,19],["καὶ",2,8],["ἡμέρας",28,19],["ἐργαζόμενοι",467,741],["πρὸς",15,1],["τὸ",1,32],["μὴ",25,12],["ἐπιβαρῆσαί",10998,100],["τινα",39,365],["ὑμῶν",5,136],["ἐκηρύξαμεν",1438,285],["εἰς",8,1],["ὑμᾶς",5,209],["τὸ",1,32],["εὐαγγέλιον",4222,33],["τοῦ",1,30],["θεοῦ",20,21]],"For you remember, brothers, our labor and travail; for working night and day, that we might not burden any of you, we preached to you the Good News of God."],["10",[["ὑμεῖς",5,208],["μάρτυρες",875,51],["καὶ",2,8],["ὁ",1,4],["θεός",20,5],["ὡς",36,12],["ὁσίως",11166,17],["καὶ",2,8],["δικαίως",2344,17],["καὶ",2,8],["ἀμέμπτως",8834,17],["ὑμῖν",5,86],["τοῖς",1,138],["πιστεύουσιν",649,352],["ἐγενήθημεν",30,794]],"You are witnesses with God how holy, righteously, and blamelessly we behaved ourselves toward you who believe."],["11",[["καθάπερ",690,8],["οἴδατε",1168,330],["ὡς",36,12],["ἕνα",58,59],["ἕκαστον",171,59],["ὑμῶν",5,136],["ὡς",36,12],["πατὴρ",44,5],["τέκνα",192,43],["ἑαυτοῦ",92,48]],"As you know, we exhorted, comforted, and implored every one of you, as a father does his own children,"],["12",[["παρακαλοῦντες",434,137],["ὑμᾶς",5,209],["καὶ",2,8],["παραμυθούμενοι",7869,741],["καὶ",2,8],["μαρτυρόμενοι",7635,741],["εἰς",8,1],["τὸ",1,32],["περιπατεῖν",1327,54],["ὑμᾶς",5,209],["ἀξίως",5208,17],["τοῦ",1,30],["θεοῦ",20,21],["τοῦ",1,30],["καλοῦντος",128,143],["ὑμᾶς",5,209],["εἰς",8,1],["τὴν",1,9],["ἑαυτοῦ",92,48],["βασιλείαν",157,10],["καὶ",2,8],["δόξαν",141,10]],"to the end that you should walk worthily of God, who calls you into his own Kingdom and glory."],["13",[["Καὶ",2,8],["διὰ",56,1],["τοῦτο",16,122],["καὶ",2,8],["ἡμεῖς",9994,208],["εὐχαριστοῦμεν",3831,241],["τῷ",1,110],["θεῷ",20,113],["ἀδιαλείπτως",3682,17],["ὅτι",19,8],["παραλαβόντες",1385,190],["λόγον",48,7],["ἀκοῆς",1047,19],["παρ᾽",73,1],["ἡμῶν",9994,136],["τοῦ",1,30],["θεοῦ",20,21],["ἐδέξασθε",815,779],["οὐ",12,12],["λόγον",48,7],["ἀνθρώπων",43,77],["ἀλλὰ",108,8],["καθώς",221,8],["ἐστιν",10,87],["ἀληθῶς",1795,17],["λόγον",48,7],["θεοῦ",20,21],["ὃς",24,246],["καὶ",2,8],["ἐνεργεῖται",3432,506],["ἐν",4,1],["ὑμῖν",5,86],["τοῖς",1,138],["πιστεύουσιν",649,352]],"For this cause we also thank God without ceasing that when you received from us the word of the message of God, you accepted it not as the word of men, but as it is in truth, God’s word, which also works in you who believe."],["14",[["ὑμεῖς",5,208],["γὰρ",40,8],["μιμηταὶ",10941,51],["ἐγενήθητε",30,802],["ἀδελφοί",67,396],["τῶν",1,123],["ἐκκλησιῶν",563,61],["τοῦ",1,30],["θεοῦ",20,21],["τῶν",1,123],["οὐσῶν",10,62],["ἐν",4,1],["τῇ",1,95],["Ἰουδαίᾳ",492,2],["ἐν",4,1],["Χριστῷ",1072,113],["Ἰησοῦ",211,113],["ὅτι",19,8],["τὰ",1,42],["αὐτὰ",3,66],["ἐπάθετε",1972,262],["καὶ",2,8],["ὑμεῖς",5,208],["ὑπὸ",122,1],["τῶν",1,76],["ἰδίων",683,163],["συμφυλετῶν",11167,77],["καθὼς",221,8],["καὶ",2,8],["αὐτοὶ",3,195],["ὑπὸ",122,1],["τῶν",1,76],["Ἰουδαίων",285,77]],"For you, brothers, became imitators of the assemblies of God which are in Judea in Christ Jesus; for you also suffered the same things from your own countrymen, even as they did from the Jews"],["15",[["τῶν",1,76],["καὶ",2,8],["τὸν",1,6],["κύριον",7,7],["ἀποκτεινάντων",300,211],["Ἰησοῦν",211,7],["καὶ",2,8],["τοὺς",1,56],["προφήτας",176,31],["καὶ",2,8],["ἡμᾶς",9994,209],["ἐκδιωξάντων",2220,211],["καὶ",2,8],["θεῷ",20,113],["μὴ",25,12],["ἀρεσκόντων",955,164],["καὶ",2,8],["πᾶσιν",11,215],["ἀνθρώποις",43,139],["ἐναντίων",2057,163]],"who killed both the Lord Jesus and their own prophets, and drove us out, and don’t please God, and are contrary to all men,"],["16",[["κωλυόντων",1440,164],["ἡμᾶς",9994,209],["τοῖς",1,91],["ἔθνεσιν",60,92],["λαλῆσαι",50,100],["ἵνα",102,8],["σωθῶσιν",172,266],["εἰς",8,1],["τὸ",1,32],["ἀναπληρῶσαι",2308,100],["αὐτῶν",3,41],["τὰς",1,39],["ἁμαρτίας",119,40],["πάντοτε",6027,17],["ἔφθασεν",1566,3],["δὲ",14,8],["ἐπ᾽",9,1],["αὐτοὺς",3,60],["ἡ",1,11],["ὀργὴ",198,13],["εἰς",8,1],["τέλος",373,33]],"forbidding us to speak to the Gentiles that they may be saved, to fill up their sins always. But wrath has come on them to the uttermost."],["17",[["Ἡμεῖς",9994,208],["δέ",14,8],["ἀδελφοί",67,396],["ἀπορφανισθέντες",11168,243],["ἀφ᾽",17,1],["ὑμῶν",5,136],["πρὸς",15,1],["καιρὸν",132,7],["ὥρας",838,19],["προσώπῳ",47,53],["οὐ",12,12],["καρδίᾳ",64,2],["περισσοτέρως",10995,17],["ἐσπουδάσαμεν",2490,285],["τὸ",1,32],["πρόσωπον",47,33],["ὑμῶν",5,136],["ἰδεῖν",112,100],["ἐν",4,1],["πολλῇ",74,96],["ἐπιθυμίᾳ",699,2]],"But we, brothers, being bereaved of you for a short season in presence, not in heart, tried even harder to see your face with great desire,"],["18",[["διότι",177,8],["ἠθελήσαμεν",612,285],["ἐλθεῖν",55,100],["πρὸς",15,1],["ὑμᾶς",5,209],["ἐγὼ",6,156],["μὲν",281,12],["Παῦλος",10586,5],["καὶ",2,8],["ἅπαξ",1315,17],["καὶ",2,8],["δίς",1957,17],["καὶ",2,8],["ἐνέκοψεν",10736,3],["ἡμᾶς",9994,209],["ὁ",1,4],["σατανᾶς",6785,5]],"because we wanted to come to you—indeed, I, Paul, once and again—but Satan hindered us."],["19",[["τίς",10010,368],["γὰρ",40,8],["ἡμῶν",9994,136],["ἐλπὶς",530,13],["ἢ",61,8],["χαρὰ",1125,13],["ἢ",61,8],["στέφανος",980,5],["καυχήσεως",2730,19],["ἢ",61,8],["οὐχὶ",330,12],["καὶ",2,8],["ὑμεῖς",5,208],["ἔμπροσθεν",390,1],["τοῦ",1,30],["κυρίου",7,21],["ἡμῶν",9994,136],["Ἰησοῦ",211,21],["ἐν",4,1],["τῇ",1,95],["αὐτοῦ",3,48],["παρουσίᾳ",4349,2]],"For what is our hope, or joy, or crown of rejoicing? Isn’t it even you, before our Lord Jesus at his coming?"],["20",[["ὑμεῖς",5,208],["γάρ",40,8],["ἐστε",10,84],["ἡ",1,11],["δόξα",141,13],["ἡμῶν",9994,136],["καὶ",2,8],["ἡ",1,11],["χαρά",1125,13]],"For you are our glory and our joy."]]