[["1",[["Λοιπὸν",2461,29],["οὖν",227,8],["ἀδελφοί",67,396],["ἐρωτῶμεν",822,241],["ὑμᾶς",5,209],["καὶ",2,8],["παρακαλοῦμεν",434,241],["ἐν",4,1],["κυρίῳ",7,113],["Ἰησοῦ",211,113],["ἵνα",102,8],["καθὼς",221,8],["παρελάβετε",1385,262],["παρ᾽",73,1],["ἡμῶν",9994,136],["τὸ",1,32],["πῶς",10049,12],["δεῖ",1158,87],["ὑμᾶς",5,209],["περιπατεῖν",1327,54],["καὶ",2,8],["ἀρέσκειν",955,54],["θεῷ",20,113],["καθὼς",221,8],["καὶ",2,8],["περιπατεῖτε",1327,84],["ἵνα",102,8],["περισσεύητε",3112,362],["μᾶλλον",1043,17]],"Finally then, brothers, we beg and exhort you in the Lord Jesus, that as you received from us how you ought to walk and to please God, that you abound more and more."],["2",[["οἴδατε",1168,330],["γὰρ",40,8],["τίνας",10010,650],["παραγγελίας",10520,40],["ἐδώκαμεν",33,285],["ὑμῖν",5,86],["διὰ",56,1],["τοῦ",1,30],["κυρίου",7,21],["Ἰησοῦ",211,21]],"For you know what instructions we gave you through the Lord Jesus."],["3",[["τοῦτο",16,344],["γάρ",40,8],["ἐστιν",10,87],["θέλημα",1039,20],["τοῦ",1,30],["θεοῦ",20,21],["ὁ",1,4],["ἁγιασμὸς",3415,5],["ὑμῶν",5,136],["ἀπέχεσθαι",1255,384],["ὑμᾶς",5,209],["ἀπὸ",17,1],["τῆς",1,18],["πορνείας",1003,19]],"For this is the will of God: your sanctification, that you abstain from sexual immorality,"],["4",[["εἰδέναι",1168,107],["ἕκαστον",171,59],["ὑμῶν",5,136],["τὸ",1,32],["ἑαυτοῦ",92,48],["σκεῦος",182,33],["κτᾶσθαι",564,749],["ἐν",4,1],["ἁγιασμῷ",3415,113],["καὶ",2,8],["τιμῇ",720,2]],"that each one of you know how to control his own body in sanctification and honor,"],["5",[["μὴ",25,12],["ἐν",4,1],["πάθει",808,53],["ἐπιθυμίας",699,19],["καθάπερ",690,8],["καὶ",2,8],["τὰ",1,253],["ἔθνη",60,63],["τὰ",1,253],["μὴ",25,12],["εἰδότα",1168,508],["τὸν",1,6],["θεόν",20,7]],"not in the passion of lust, even as the Gentiles who don’t know God,"],["6",[["τὸ",1,32],["μὴ",25,12],["ὑπερβαίνειν",2152,54],["καὶ",2,8],["πλεονεκτεῖν",4988,54],["ἐν",4,1],["τῷ",1,52],["πράγματι",511,53],["τὸν",1,6],["ἀδελφὸν",67,7],["αὐτοῦ",3,48],["διότι",177,8],["ἔκδικος",4623,16],["κύριος",7,5],["περὶ",72,1],["πάντων",11,79],["τούτων",16,214],["καθὼς",221,8],["καὶ",2,8],["προείπαμεν",11070,285],["ὑμῖν",5,86],["καὶ",2,8],["διεμαρτυράμεθα",1585,868]],"that no one should take advantage of and wrong a brother or sister in this matter; because the Lord is an avenger in all these things, as also we forewarned you and testified."],["7",[["οὐ",12,12],["γὰρ",40,8],["ἐκάλεσεν",128,3],["ἡμᾶς",9994,209],["ὁ",1,4],["θεὸς",20,5],["ἐπὶ",9,1],["ἀκαθαρσίᾳ",888,2],["ἀλλ᾽",108,8],["ἐν",4,1],["ἁγιασμῷ",3415,113]],"For God called us not for uncleanness, but in sanctification."],["8",[["τοιγαροῦν",2791,8],["ὁ",1,4],["ἀθετῶν",834,67],["οὐκ",12,12],["ἄνθρωπον",43,7],["ἀθετεῖ",834,87],["ἀλλὰ",108,8],["τὸν",1,6],["θεὸν",20,7],["τὸν",1,6],["καὶ",2,8],["διδόντα",33,178],["τὸ",1,32],["πνεῦμα",168,33],["αὐτοῦ",3,48],["τὸ",1,32],["ἅγιον",75,29],["εἰς",8,1],["ὑμᾶς",5,209]],"Therefore he who rejects this doesn’t reject man, but God, who has also given his Holy Spirit to you."],["9",[["Περὶ",72,1],["δὲ",14,8],["τῆς",1,18],["φιλαδελφίας",5121,19],["οὐ",12,12],["χρείαν",1006,10],["ἔχετε",124,84],["γράφειν",186,54],["ὑμῖν",5,86],["αὐτοὶ",3,195],["γὰρ",40,8],["ὑμεῖς",5,208],["θεοδίδακτοί",11170,130],["ἐστε",10,84],["εἰς",8,1],["τὸ",1,32],["ἀγαπᾶν",214,54],["ἀλλήλους",1192,60]],"But concerning brotherly love, you have no need that one write to you. For you yourselves are taught by God to love one another,"],["10",[["καὶ",2,8],["γὰρ",40,8],["ποιεῖτε",23,84],["αὐτὸ",3,121],["εἰς",8,1],["πάντας",11,58],["τοὺς",1,56],["ἀδελφοὺς",67,31],["τοὺς",1,56],["ἐν",4,1],["ὅλῃ",235,96],["τῇ",1,95],["Μακεδονίᾳ",10620,2],["Παρακαλοῦμεν",434,241],["δὲ",14,8],["ὑμᾶς",5,209],["ἀδελφοί",67,396],["περισσεύειν",3112,54],["μᾶλλον",1043,17]],"for indeed you do it toward all the brothers who are in all Macedonia. But we exhort you, brothers, that you abound more and more;"],["11",[["καὶ",2,8],["φιλοτιμεῖσθαι",8609,749],["ἡσυχάζειν",1090,54],["καὶ",2,8],["πράσσειν",1251,54],["τὰ",1,42],["ἴδια",683,65],["καὶ",2,8],["ἐργάζεσθαι",467,749],["ταῖς",1,70],["ἰδίαις",683,287],["χερσὶν",37,71],["ὑμῶν",5,136],["καθὼς",221,8],["ὑμῖν",5,86],["παρηγγείλαμεν",1907,285]],"and that you make it your ambition to lead a quiet life, and to do your own business, and to work with your own hands, even as we instructed you,"],["12",[["ἵνα",102,8],["περιπατῆτε",1327,362],["εὐσχημόνως",10891,17],["πρὸς",15,1],["τοὺς",1,56],["ἔξω",527,1],["καὶ",2,8],["μηδενὸς",908,88],["χρείαν",1006,10],["ἔχητε",124,362]],"that you may walk properly toward those who are outside, and may have need of nothing."],["13",[["Οὐ",12,12],["θέλομεν",612,241],["δὲ",14,8],["ὑμᾶς",5,209],["ἀγνοεῖν",1846,54],["ἀδελφοί",67,396],["περὶ",72,1],["τῶν",1,76],["κοιμωμένων",301,599],["ἵνα",102,8],["μὴ",25,12],["λυπῆσθε",936,928],["καθὼς",221,8],["καὶ",2,8],["οἱ",1,128],["λοιποὶ",523,130],["οἱ",1,128],["μὴ",25,12],["ἔχοντες",124,137],["ἐλπίδα",530,10]],"But we don’t want you to be ignorant, brothers, concerning those who have fallen asleep, so that you don’t grieve like the rest, who have no hope."],["14",[["εἰ",77,8],["γὰρ",40,8],["πιστεύομεν",649,241],["ὅτι",19,8],["Ἰησοῦς",211,5],["ἀπέθανεν",109,3],["καὶ",2,8],["ἀνέστη",121,3],["οὕτως",71,17],["καὶ",2,8],["ὁ",1,4],["θεὸς",20,5],["τοὺς",1,56],["κοιμηθέντας",301,469],["διὰ",56,1],["τοῦ",1,30],["Ἰησοῦ",211,21],["ἄξει",224,120],["σὺν",310,1],["αὐτῷ",3,49]],"For if we believe that Jesus died and rose again, even so God will bring with him those who have fallen asleep in Jesus."],["15",[["Τοῦτο",16,122],["γὰρ",40,8],["ὑμῖν",5,86],["λέγομεν",31,241],["ἐν",4,1],["λόγῳ",48,113],["κυρίου",7,21],["ὅτι",19,8],["ἡμεῖς",9994,208],["οἱ",1,128],["ζῶντες",107,137],["οἱ",1,128],["περιλειπόμενοι",4353,940],["εἰς",8,1],["τὴν",1,9],["παρουσίαν",4349,10],["τοῦ",1,30],["κυρίου",7,21],["οὐ",12,12],["μὴ",25,12],["φθάσωμεν",1566,75],["τοὺς",1,56],["κοιμηθέντας",301,469]],"For this we tell you by the word of the Lord, that we who are alive, who are left until the coming of the Lord, will in no way precede those who have fallen asleep."],["16",[["ὅτι",19,8],["αὐτὸς",3,158],["ὁ",1,4],["κύριος",7,5],["ἐν",4,1],["κελεύσματι",11171,53],["ἐν",4,1],["φωνῇ",95,2],["ἀρχαγγέλου",11172,21],["καὶ",2,8],["ἐν",4,1],["σάλπιγγι",580,2],["θεοῦ",20,21],["καταβήσεται",175,718],["ἀπ᾽",17,1],["οὐρανοῦ",94,21],["καὶ",2,8],["οἱ",1,128],["νεκροὶ",659,130],["ἐν",4,1],["Χριστῷ",1072,113],["ἀναστήσονται",121,127],["πρῶτον",315,29]],"For the Lord himself will descend from heaven with a shout, with the voice of the archangel and with God’s trumpet. The dead in Christ will rise first,"],["17",[["ἔπειτα",6560,17],["ἡμεῖς",9994,208],["οἱ",1,128],["ζῶντες",107,137],["οἱ",1,128],["περιλειπόμενοι",4353,940],["ἅμα",502,17],["σὺν",310,1],["αὐτοῖς",3,142],["ἁρπαγησόμεθα",1214,349],["ἐν",4,1],["νεφέλαις",444,71],["εἰς",8,1],["ἀπάντησιν",1428,10],["τοῦ",1,30],["κυρίου",7,21],["εἰς",8,1],["ἀέρα",2664,7],["καὶ",2,8],["οὕτως",71,17],["πάντοτε",6027,17],["σὺν",310,1],["κυρίῳ",7,113],["ἐσόμεθα",10,874]],"then we who are alive, who are left, will be caught up together with them in the clouds to meet the Lord in the air. So we will be with the Lord forever."],["18",[["Ὥστε",346,8],["παρακαλεῖτε",434,307],["ἀλλήλους",1192,60],["ἐν",4,1],["τοῖς",1,138],["λόγοις",48,139],["τούτοις",16,193]],"Therefore comfort one another with these words."]]