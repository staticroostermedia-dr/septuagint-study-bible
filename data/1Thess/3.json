[["1",[["Διὸ",1466,8],["μηκέτι",2366,17],["στέγοντες",8320,137],["εὐδοκήσαμεν",906,285],["καταλειφθῆναι",207,175],["ἐν",4,1],["Ἀθήναις",10643,71],["μόνοι",302,130]],"Therefore when we couldn’t stand it any longer, we thought it good to be left behind at Athens alone,"],["2",[["καὶ",2,8],["ἐπέμψαμεν",1597,285],["Τιμόθεον",1953,7],["τὸν",1,6],["ἀδελφὸν",67,7],["ἡμῶν",9994,136],["καὶ",2,8],["συνεργὸν",6116,59],["τοῦ",1,30],["θεοῦ",20,21],["ἐν",4,1],["τῷ",1,52],["εὐαγγελίῳ",4222,53],["τοῦ",1,30],["Χριστοῦ",1072,21],["εἰς",8,1],["τὸ",1,32],["στηρίξαι",979,100],["ὑμᾶς",5,209],["καὶ",2,8],["παρακαλέσαι",434,100],["ὑπὲρ",139,1],["τῆς",1,18],["πίστεως",887,19],["ὑμῶν",5,136]],"and sent Timothy, our brother and God’s servant in the Good News of Christ, to establish you and to comfort you concerning your faith,"],["3",[["τὸ",1,32],["μηδένα",908,59],["σαίνεσθαι",11169,634],["ἐν",4,1],["ταῖς",1,70],["θλίψεσιν",438,71],["ταύταις",16,336],["αὐτοὶ",3,195],["γὰρ",40,8],["οἴδατε",1168,330],["ὅτι",19,8],["εἰς",8,1],["τοῦτο",16,122],["κείμεθα",1731,800]],"that no one would be moved by these afflictions. For you know that we are appointed to this task."],["4",[["καὶ",2,8],["γὰρ",40,8],["ὅτε",432,8],["πρὸς",15,1],["ὑμᾶς",5,209],["ἦμεν",10,395],["προελέγομεν",8062,395],["ὑμῖν",5,86],["ὅτι",19,8],["μέλλομεν",1143,241],["θλίβεσθαι",601,634],["καθὼς",221,8],["καὶ",2,8],["ἐγένετο",30,737],["καὶ",2,8],["οἴδατε",1168,330]],"For most certainly, when we were with you, we told you beforehand that we are to suffer affliction, even as it happened, and you know."],["5",[["διὰ",56,1],["τοῦτο",16,122],["κἀγὼ",10000,8],["μηκέτι",2366,17],["στέγων",8320,67],["ἔπεμψα",1597,147],["εἰς",8,1],["τὸ",1,32],["γνῶναι",79,100],["τὴν",1,9],["πίστιν",887,10],["ὑμῶν",5,136],["μή",25,12],["πως",441,12],["ἐπείρασεν",1094,3],["ὑμᾶς",5,209],["ὁ",1,4],["πειράζων",1094,67],["καὶ",2,8],["εἰς",8,1],["κενὸν",780,29],["γένηται",30,745],["ὁ",1,4],["κόπος",1345,5],["ἡμῶν",9994,136]],"For this cause I also, when I couldn’t stand it any longer, sent that I might know your faith, for fear that by any means the tempter had tempted you, and our labor would have been in vain."],["6",[["ἄρτι",2665,17],["δὲ",14,8],["ἐλθόντος",55,513],["Τιμοθέου",1953,21],["πρὸς",15,1],["ἡμᾶς",9994,209],["ἀφ᾽",17,1],["ὑμῶν",5,136],["καὶ",2,8],["εὐαγγελισαμένου",1817,288],["ἡμῖν",9994,86],["τὴν",1,9],["πίστιν",887,10],["καὶ",2,8],["τὴν",1,9],["ἀγάπην",1982,10],["ὑμῶν",5,136],["καὶ",2,8],["ὅτι",19,8],["ἔχετε",124,84],["μνείαν",2271,10],["ἡμῶν",9994,136],["ἀγαθὴν",114,37],["πάντοτε",6027,17],["ἐπιποθοῦντες",2537,137],["ἡμᾶς",9994,209],["ἰδεῖν",112,100],["καθάπερ",690,8],["καὶ",2,8],["ἡμεῖς",9994,208],["ὑμᾶς",5,209]],"But Timothy has just now come to us from you, and brought us glad news of your faith and love, and that you have good memories of us always, longing to see us, even as we also long to see you."],["7",[["διὰ",56,1],["τοῦτο",16,122],["παρεκλήθημεν",434,491],["ἀδελφοί",67,396],["ἐφ᾽",9,1],["ὑμῖν",5,86],["ἐπὶ",9,1],["πάσῃ",11,96],["τῇ",1,95],["ἀνάγκῃ",1126,2],["καὶ",2,8],["θλίψει",438,2],["ἡμῶν",9994,136],["διὰ",56,1],["τῆς",1,18],["ὑμῶν",5,136],["πίστεως",887,19]],"For this cause, brothers, we were comforted over you in all our distress and affliction through your faith."],["8",[["ὅτι",19,8],["νῦν",90,17],["ζῶμεν",107,241],["ἐὰν",45,8],["ὑμεῖς",5,208],["στήκετε",6083,84],["ἐν",4,1],["κυρίῳ",7,113]],"For now we live, if you stand fast in the Lord."],["9",[["τίνα",10010,583],["γὰρ",40,8],["εὐχαριστίαν",4230,10],["δυνάμεθα",185,800],["τῷ",1,110],["θεῷ",20,113],["ἀνταποδοῦναι",666,100],["περὶ",72,1],["ὑμῶν",5,136],["ἐπὶ",9,1],["πάσῃ",11,96],["τῇ",1,95],["χαρᾷ",1125,2],["ᾗ",24,102],["χαίρομεν",698,241],["δι᾽",56,1],["ὑμᾶς",5,209],["ἔμπροσθεν",390,1],["τοῦ",1,30],["θεοῦ",20,21],["ἡμῶν",9994,136]],"For what thanksgiving can we give again to God for you, for all the joy with which we rejoice for your sakes before our God,"],["10",[["νυκτὸς",219,19],["καὶ",2,8],["ἡμέρας",28,19],["ὑπερεκπερισσοῦ",139,17],["δεόμενοι",1672,741],["εἰς",8,1],["τὸ",1,32],["ἰδεῖν",112,100],["ὑμῶν",5,136],["τὸ",1,32],["πρόσωπον",47,33],["καὶ",2,8],["καταρτίσαι",1888,100],["τὰ",1,42],["ὑστερήματα",3774,43],["τῆς",1,18],["πίστεως",887,19],["ὑμῶν",5,136]],"night and day praying exceedingly that we may see your face and may perfect that which is lacking in your faith?"],["11",[["Αὐτὸς",3,158],["δὲ",14,8],["ὁ",1,4],["θεὸς",20,5],["καὶ",2,8],["πατὴρ",44,5],["ἡμῶν",9994,136],["καὶ",2,8],["ὁ",1,4],["κύριος",7,5],["ἡμῶν",9994,136],["Ἰησοῦς",211,5],["κατευθύναι",827,216],["τὴν",1,9],["ὁδὸν",68,10],["ἡμῶν",9994,136],["πρὸς",15,1],["ὑμᾶς",5,209]],"Now may our God and Father himself, and our Lord Jesus Christ, direct our way to you."],["12",[["ὑμᾶς",5,209],["δὲ",14,8],["ὁ",1,4],["κύριος",7,5],["πλεονάσαι",1523,216],["καὶ",2,8],["περισσεύσαι",3112,216],["τῇ",1,95],["ἀγάπῃ",1982,2],["εἰς",8,1],["ἀλλήλους",1192,60],["καὶ",2,8],["εἰς",8,1],["πάντας",11,58],["καθάπερ",690,8],["καὶ",2,8],["ἡμεῖς",9994,208],["εἰς",8,1],["ὑμᾶς",5,209]],"May the Lord make you to increase and abound in love toward one another and toward all men, even as we also do toward you,"],["13",[["εἰς",8,1],["τὸ",1,32],["στηρίξαι",979,100],["ὑμῶν",5,136],["τὰς",1,39],["καρδίας",64,40],["ἀμέμπτους",2134,109],["ἐν",4,1],["ἁγιωσύνῃ",4057,2],["ἔμπροσθεν",390,1],["τοῦ",1,30],["θεοῦ",20,21],["καὶ",2,8],["πατρὸς",44,21],["ἡμῶν",9994,136],["ἐν",4,1],["τῇ",1,95],["παρουσίᾳ",4349,2],["τοῦ",1,30],["κυρίου",7,21],["ἡμῶν",9994,136],["Ἰησοῦ",211,21],["μετὰ",29,1],["πάντων",11,163],["τῶν",1,76],["ἁγίων",75,163],["αὐτοῦ",3,48],["ἀμήν",3161,316]],"to the end he may establish your hearts blameless in holiness before our God and Father at the coming of our Lord Jesus with all his saints."]]