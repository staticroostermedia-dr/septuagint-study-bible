[["1",[["Περὶ",72,1],["δὲ",14,8],["τῶν",1,76],["χρόνων",486,77],["καὶ",2,8],["τῶν",1,76],["καιρῶν",132,77],["ἀδελφοί",67,396],["οὐ",12,12],["χρείαν",1006,10],["ἔχετε",124,84],["ὑμῖν",5,86],["γράφεσθαι",186,634]],"But concerning the times and the seasons, brothers, you have no need that anything be written to you."],["2",[["αὐτοὶ",3,195],["γὰρ",40,8],["ἀκριβῶς",5167,17],["οἴδατε",1168,330],["ὅτι",19,8],["ἡμέρα",28,13],["κυρίου",7,21],["ὡς",36,12],["κλέπτης",2358,5],["ἐν",4,1],["νυκτὶ",219,2],["οὕτως",71,17],["ἔρχεται",55,728]],"For you yourselves know well that the day of the Lord comes like a thief in the night."],["3",[["ὅταν",319,8],["λέγωσιν",31,265],["εἰρήνη",213,13],["καὶ",2,8],["ἀσφάλεια",2051,13],["τότε",250,17],["αἰφνίδιος",3787,16],["αὐτοῖς",3,142],["ἐφίσταται",631,506],["ὄλεθρος",1714,5],["ὥσπερ",226,8],["ἡ",1,11],["ὠδὶν",2435,13],["τῇ",1,95],["ἐν",4,1],["γαστρὶ",777,2],["ἐχούσῃ",124,210],["καὶ",2,8],["οὐ",12,12],["μὴ",25,12],["ἐκφύγωσιν",1861,224]],"For when they are saying, “Peace and safety,” then sudden destruction will come on them, like birth pains on a pregnant woman. Then they will in no way escape."],["4",[["ὑμεῖς",5,208],["δέ",14,8],["ἀδελφοί",67,396],["οὐκ",12,12],["ἐστὲ",10,84],["ἐν",4,1],["σκότει",506,53],["ἵνα",102,8],["ἡ",1,11],["ἡμέρα",28,13],["ὑμᾶς",5,209],["ὡς",36,12],["κλέπτης",2358,5],["καταλάβῃ",532,160]],"But you, brothers, aren’t in darkness, that the day should overtake you like a thief."],["5",[["πάντες",11,130],["γὰρ",40,8],["ὑμεῖς",5,208],["υἱοὶ",13,51],["φωτός",380,24],["ἐστε",10,84],["καὶ",2,8],["υἱοὶ",13,51],["ἡμέρας",28,19],["οὐκ",12,12],["ἐσμὲν",10,241],["νυκτὸς",219,19],["οὐδὲ",106,8],["σκότους",506,24]],"You are all children of light and children of the day. We don’t belong to the night, nor to darkness,"],["6",[["Ἄρα",985,8],["οὖν",227,8],["μὴ",25,12],["καθεύδωμεν",1724,223],["ὡς",36,12],["οἱ",1,128],["λοιποὶ",523,130],["ἀλλὰ",108,8],["γρηγορῶμεν",3041,223],["καὶ",2,8],["νήφωμεν",11173,223]],"so then let’s not sleep, as the rest do, but let’s watch and be sober."],["7",[["οἱ",1,128],["γὰρ",40,8],["καθεύδοντες",1724,137],["νυκτὸς",219,19],["καθεύδουσιν",1724,191],["καὶ",2,8],["οἱ",1,128],["μεθυσκόμενοι",1276,772],["νυκτὸς",219,19],["μεθύουσιν",2464,191]],"For those who sleep, sleep in the night; and those who are drunk are drunk in the night."],["8",[["ἡμεῖς",9994,208],["δὲ",14,8],["ἡμέρας",28,19],["ὄντες",10,137],["νήφωμεν",11173,223],["ἐνδυσάμενοι",516,315],["θώρακα",2082,7],["πίστεως",887,19],["καὶ",2,8],["ἀγάπης",1982,19],["καὶ",2,8],["περικεφαλαίαν",2754,10],["ἐλπίδα",530,10],["σωτηρίας",425,19]],"But since we belong to the day, let’s be sober, putting on the breastplate of faith and love, and for a helmet, the hope of salvation."],["9",[["ὅτι",19,8],["οὐκ",12,12],["ἔθετο",110,26],["ἡμᾶς",9994,209],["ὁ",1,4],["θεὸς",20,5],["εἰς",8,1],["ὀργὴν",198,10],["ἀλλ᾽",108,8],["εἰς",8,1],["περιποίησιν",4976,10],["σωτηρίας",425,19],["διὰ",56,1],["τοῦ",1,30],["κυρίου",7,21],["ἡμῶν",9994,136],["Ἰησοῦ",211,21],["Χριστοῦ",1072,21]],"For God didn’t appoint us to wrath, but to the obtaining of salvation through our Lord Jesus Christ,"],["10",[["τοῦ",1,30],["ἀποθανόντος",109,513],["ὑπὲρ",139,1],["ἡμῶν",9994,136],["ἵνα",102,8],["εἴτε",2713,8],["γρηγορῶμεν",3041,223],["εἴτε",2713,8],["καθεύδωμεν",1724,223],["ἅμα",502,17],["σὺν",310,1],["αὐτῷ",3,49],["ζήσωμεν",107,75]],"who died for us, that, whether we wake or sleep, we should live together with him."],["11",[["Διὸ",1466,8],["παρακαλεῖτε",434,307],["ἀλλήλους",1192,60],["καὶ",2,8],["οἰκοδομεῖτε",126,307],["εἷς",58,16],["τὸν",1,6],["ἕνα",58,59],["καθὼς",221,8],["καὶ",2,8],["ποιεῖτε",23,84]],"Therefore exhort one another, and build each other up, even as you also do."],["12",[["Ἐρωτῶμεν",822,241],["δὲ",14,8],["ὑμᾶς",5,209],["ἀδελφοί",67,396],["εἰδέναι",1168,107],["τοὺς",1,56],["κοπιῶντας",921,229],["ἐν",4,1],["ὑμῖν",5,86],["καὶ",2,8],["προϊσταμένους",3340,514],["ὑμῶν",5,136],["ἐν",4,1],["κυρίῳ",7,113],["καὶ",2,8],["νουθετοῦντας",2608,229],["ὑμᾶς",5,209]],"But we beg you, brothers, to know those who labor among you, and are over you in the Lord and admonish you,"],["13",[["καὶ",2,8],["ἡγεῖσθαι",378,749],["αὐτοὺς",3,60],["ὑπερεκπερισσοῦ",139,17],["ἐν",4,1],["ἀγάπῃ",1982,2],["διὰ",56,1],["τὸ",1,32],["ἔργον",105,33],["αὐτῶν",3,41],["εἰρηνεύετε",1959,307],["ἐν",4,1],["ἑαυτοῖς",92,142]],"and to respect and honor them in love for their work’s sake. Be at peace among yourselves."],["14",[["Παρακαλοῦμεν",434,241],["δὲ",14,8],["ὑμᾶς",5,209],["ἀδελφοί",67,396],["νουθετεῖτε",2608,307],["τοὺς",1,56],["ἀτάκτους",9209,58],["παραμυθεῖσθε",7869,742],["τοὺς",1,56],["ὀλιγοψύχους",3760,58],["ἀντέχεσθε",1852,742],["τῶν",1,76],["ἀσθενῶν",1854,163],["μακροθυμεῖτε",2917,307],["πρὸς",15,1],["πάντας",11,58]],"We exhort you, brothers: Admonish the disorderly; encourage the faint-hearted; support the weak; be patient toward all."],["15",[["ὁρᾶτε",112,307],["μή",25,12],["τις",39,150],["κακὸν",161,29],["ἀντὶ",158,1],["κακοῦ",161,88],["τινι",39,784],["ἀποδῷ",312,160],["ἀλλὰ",108,8],["πάντοτε",6027,17],["τὸ",1,32],["ἀγαθὸν",114,29],["διώκετε",533,307],["καὶ",2,8],["εἰς",8,1],["ἀλλήλους",1192,60],["καὶ",2,8],["εἰς",8,1],["πάντας",11,58]],"See that no one returns evil for evil to anyone, but always follow after that which is good for one another and for all."],["16",[["πάντοτε",6027,17],["χαίρετε",698,307]],"Always rejoice."],["17",[["ἀδιαλείπτως",3682,17],["προσεύχεσθε",551,742]],"Pray without ceasing."],["18",[["ἐν",4,1],["παντὶ",11,34],["εὐχαριστεῖτε",3831,307],["τοῦτο",16,344],["γὰρ",40,8],["θέλημα",1039,20],["θεοῦ",20,21],["ἐν",4,1],["Χριστῷ",1072,113],["Ἰησοῦ",211,113],["εἰς",8,1],["ὑμᾶς",5,209]],"In everything give thanks, for this is the will of God in Christ Jesus toward you."],["19",[["τὸ",1,32],["πνεῦμα",168,33],["μὴ",25,12],["σβέννυτε",1077,307]],"Don’t quench the Spirit."],["20",[["προφητείας",2285,40],["μὴ",25,12],["ἐξουθενεῖτε",2534,307]],"Don’t despise prophecies."],["21",[["πάντα",11,65],["δὲ",14,8],["δοκιμάζετε",1269,307],["τὸ",1,32],["καλὸν",266,29],["κατέχετε",1040,307]],"Test all things, and hold firmly that which is good."],["22",[["ἀπὸ",17,1],["παντὸς",11,88],["εἴδους",949,24],["πονηροῦ",164,88],["ἀπέχεσθε",1255,852]],"Abstain from every form of evil."],["23",[["αὐτὸς",3,158],["δὲ",14,8],["ὁ",1,4],["θεὸς",20,5],["τῆς",1,18],["εἰρήνης",213,19],["ἁγιάσαι",329,216],["ὑμᾶς",5,209],["ὁλοτελεῖς",11174,58],["καὶ",2,8],["ὁλόκληρον",3221,28],["ὑμῶν",5,136],["τὸ",1,27],["πνεῦμα",168,20],["καὶ",2,8],["ἡ",1,11],["ψυχὴ",63,13],["καὶ",2,8],["τὸ",1,27],["σῶμα",454,20],["ἀμέμπτως",8834,17],["ἐν",4,1],["τῇ",1,95],["παρουσίᾳ",4349,2],["τοῦ",1,30],["κυρίου",7,21],["ἡμῶν",9994,136],["Ἰησοῦ",211,21],["Χριστοῦ",1072,21],["τηρηθείη",1358,544]],"May the God of peace himself sanctify you completely. May your whole spirit, soul, and body be preserved blameless at the coming of our Lord Jesus Christ."],["24",[["πιστὸς",750,16],["ὁ",1,4],["καλῶν",128,67],["ὑμᾶς",5,209],["ὃς",24,246],["καὶ",2,8],["ποιήσει",23,120]],"He who calls you is faithful, who will also do it."],["25",[["Ἀδελφοί",67,396],["προσεύχεσθε",551,742],["καὶ",2,8],["περὶ",72,1],["ἡμῶν",9994,136]],"Brothers, pray for us."],["26",[["Ἀσπάσασθε",2987,771],["τοὺς",1,56],["ἀδελφοὺς",67,31],["πάντας",11,58],["ἐν",4,1],["φιλήματι",6192,53],["ἁγίῳ",75,34]],"Greet all the brothers with a holy kiss."],["27",[["ἐνορκίζω",11175,149],["ὑμᾶς",5,209],["τὸν",1,6],["κύριον",7,7],["ἀναγνωσθῆναι",795,175],["τὴν",1,9],["ἐπιστολὴν",866,10],["πᾶσιν",11,215],["τοῖς",1,138],["ἀδελφοῖς",67,139]],"I solemnly command you by the Lord that this letter be read to all the holy brothers."],["28",[["Ἡ",1,11],["χάρις",368,13],["τοῦ",1,30],["κυρίου",7,21],["ἡμῶν",9994,136],["Ἰησοῦ",211,21],["Χριστοῦ",1072,21],["μεθ᾽",29,1],["ὑμῶν",5,136]],"The grace of our Lord Jesus Christ be with you. Amen."]]