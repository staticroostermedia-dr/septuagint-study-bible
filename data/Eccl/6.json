[["1",[["Ἔστι",10,87],["πονηρία",730,13],["ἣν",24,124],["εἶδον",53,147],["ὑπὸ",122,1],["τὸν",1,6],["ἥλιον",323,7],["καὶ",2,8],["πολλή",74,15],["ἐστιν",10,87],["ὑπὸ",122,1],["τὸν",1,6],["ἄνθρωπον",43,7]],"There is an evil which I have seen under the sun, and it is abundant with man:"],["2",[["Ἀνὴρ",38,5],["ᾧ",24,202],["δώσει",33,120],["αὐτῷ",3,49],["ὁ",1,4],["Θεὸς",20,5],["πλοῦτον",574,7],["καὶ",2,8],["ὑπαρχοντα",418,178],["καὶ",2,8],["δόξαν",141,10],["καὶ",2,8],["οὐκ",12,17],["ἔστιν",10,87],["ὑστερῶν",1947,67],["τῇ",1,95],["ψυχῇ",63,2],["αὐτοῦ",3,48],["ἀπὸ",17,1],["πάντων",11,163],["ὧν",24,303],["ἐπιθυμήσει",915,120],["καὶ",2,8],["οὐκ",12,17],["ἐξουσιάσει",2224,120],["αὐτῷ",3,49],["ὁ",1,4],["Θεὸς",20,5],["τοῦ",1,30],["φαγεῖν",269,100],["ἀπʼ",17,1],["αὐτοῦ",3,48],["ὅτι",19,8],["ἀνὴρ",38,5],["ξένος",1828,16],["φάγεται",269,89],["αὐτόν",3,82],["τοῦτο",16,122],["ματαιότης",937,13],["καὶ",2,8],["ἀῤῥωστία",2311,13],["πονηρά",164,15],["ἐστιν",10,87]],"a man to whom God shall give wealth, and substance, and honour, and he wants nothing for his soul of all things that he shall desire, yet God shall not give him power to eat of it, for a stranger shall devour it: this is vanity, and an evil infirmity."],["3",[["Ἐὰν",45,8],["γεννήσῃ",222,160],["ἀνὴρ",38,5],["ἑκατόν",243,57],["καὶ",2,8],["ἔτη",81,43],["πολλὰ",74,65],["ζήσεται",107,89],["καὶ",2,8],["πλῆθος",200,20],["ὅ",1,4],["τι",39,238],["ἔσονται",10,127],["αἱ",1,185],["ἡμέραι",28,2],["ἐτῶν",81,45],["αὐτοῦ",3,48],["καὶ",2,8],["ψυχὴ",63,13],["αὐτοῦ",3,48],["οὐ",12,17],["πλησθήσεται",909,125],["ἀπὸ",17,1],["τῆς",1,18],["ἀγαθωσύνης",2300,19],["καί",2,8],["γε",353,12],["ταφὴ",2502,13],["οὐκ",12,17],["ἐγένετο",30,26],["αὐτῷ",3,49],["εἶπα",18,147],["ἀγαθὸν",114,59],["ὑπὲρ",139,1],["αὐτὸν",3,82],["τὸ",1,32],["ἔκτρωμα",5361,33]],"If a man beget a hundred [children], and live many years, yea, however abundant the days of his years shall be, yet [if] his soul shall not be satisfied with good, and also he have no burial; I said, An untimely birth is better than he."],["4",[["Ὅτι",19,8],["ἐν",4,1],["ματαιότητι",937,2],["ἦλθε",55,3],["καὶ",2,8],["ἐν",4,1],["σκότει",506,53],["πορεύεται",49,108],["καὶ",2,8],["ἐν",4,1],["σκότει",506,53],["ὄνομα",57,33],["αὐτοῦ",3,48],["καλυφθήσεται",620,125]],"For he came in vanity, and departs in darkness, and his name shall be covered in darkness."],["5",[["Καί",2,8],["γε",353,12],["ἥλιον",323,7],["οὐκ",12,17],["εἶδε",53,3],["καὶ",2,8],["οὐκ",12,17],["ἔγνω",79,3],["ἀναπαύσεις",674,159],["τούτῳ",16,279],["ὑπὲρ",139,1],["τοῦτον",16,259]],"Moreover he has not seen the sun, nor known rest: there is [no more rest] to this one than another."],["6",[["Καὶ",2,8],["ἔζησε",107,3],["χιλίων",1483,79],["ἐτῶν",81,45],["καθόδους",4875,40],["καὶ",2,8],["ἀγαθωσύνην",2300,10],["οὐκ",12,17],["εἶδε",53,3],["μὴ",25,8],["οὐκ",12,17],["εἰς",8,1],["τόπον",99,7],["ἕνα",58,59],["πορεύεται",49,108],["τὰ",1,42],["πάντα",11,65]],"Though he has lived to the return of a thousand years, yet he has seen no good: do not all go to one place?"],["7",[["Πᾶς",11,16],["μόχθος",1144,5],["ἀνθρώπου",43,21],["εἰς",8,1],["στόμα",123,33],["αὐτοῦ",3,48],["καί",2,8],["γε",353,12],["ἡ",1,11],["ψυχὴ",63,13],["οὐ",12,17],["πληρωθήσεται",518,125]],"All the labour of a man is for his mouth, and yet the appetite shall not be satisfied."],["8",[["Ὅτι",19,8],["περίσσεια",2478,147],["τῷ",1,110],["σοφῷ",324,111],["ὑπὲρ",139,1],["τὸν",1,6],["ἄφρονα",439,59],["διότι",177,8],["ὁ",1,4],["πένης",672,5],["οἶδε",1168,165],["πορευθῆναι",49,175],["κατέναντι",691,17],["τῆς",1,18],["ζωῆς",216,19]],"For [what] advantage has the wise man over the fool, since [even] the poor knows how to walk in the direction of life?"],["9",[["Ἀγαθὸν",114,29],["ὅραμα",1873,33],["ὀφθαλμῶν",91,77],["ὑπερπορευόμενον",9884,205],["ψυχῇ",63,2],["καί",2,8],["γε",353,12],["τοῦτο",16,122],["ματαιότης",937,13],["καὶ",2,8],["προαίρεσις",2284,13],["πνεύματος",168,24]],"The sight of the eyes is better than that which wanders in soul: this is also vanity, and waywardness of spirit."],["10",[["Εἰ",77,8],["τι",39,119],["ἐγένετο",30,26],["ἤδη",916,17],["κέκληται",128,182],["ὄνομα",57,33],["αὐτοῦ",3,48],["καὶ",2,8],["ἐγνώσθη",79,38],["ὅ",1,4],["ἐστιν",10,87],["ἄνθρωπος",43,5],["καὶ",2,8],["οὐ",12,17],["δυνήσεται",185,89],["κριθῆναι",263,175],["μετὰ",29,1],["τοῦ",1,30],["ἰσχυροτὲρου",401,153],["ὑπὲρ",139,1],["αὐτόν",3,82]],"If anything has been, its name has already been called: and it is known what man is; neither can he contend with him who is stronger than he."],["11",[["Ὅτι",19,8],["εἰσι",10,191],["λόγοι",48,51],["πολλοὶ",74,130],["πληθύνοντες",316,137],["ματαιότητα",937,10]],"For there are many things which increase vanity."],["12",[["Τί",39,119],["περισσὸν",1636,29],["τῷ",1,110],["ἀνθρώπῳ",43,113],["ὅτι",19,8],["τίς",39,150],["οἶδεν",53,165],["ἀγαθὸν",114,29],["τῷ",1,110],["ἀνθρώπῳ",43,113],["ἐν",4,1],["τῇ",1,95],["ζωῇ",216,2],["ἀριθμὸν",355,7],["ζωῆς",216,19],["ἡμερῶν",28,61],["ματαιότητος",937,19],["αὐτοῦ",3,48],["καὶ",2,8],["ἐποίησεν",23,3],["αὐτὰ",3,66],["ἐν",4,1],["σκιᾷ",978,2],["ὅτι",19,8],["τίς",39,150],["ἀπαγγελεῖ",273,120],["τῷ",1,110],["ἀνθρώπῳ",43,113],["τί",39,119],["ἔσται",10,89],["ὀπίσω",167,17],["αὐτοῦ",3,48],["ὑπὸ",122,1],["τὸν",1,6],["ἥλιον",323,7]],"What advantage has a man? for who knows [what is] good for a man in his life, [during] the number of the life of the days of his vanity? and he has spent them as a shadow; for who shall tell a man what shall be after him under the sun?"]]