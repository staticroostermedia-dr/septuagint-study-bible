,["ἐπέστρεψα",116,147],["ἐγὼ",6,158],["τοῦ",1,30],["ἀποτάξασθαι",5259,103],["τὴν",1,9],["καρδίαν",63,10],["μου",6,48],["ἐν",4,1],["παντὶ",11,111],["μόχθῳ",1144,113],["μου",6,48],["ᾧ",24,202],["ἐμόχθησα",2190,147],["ὑπὸ",122,1],["τὸν",1,6],["ἥλιον",320,7]],"So I went about to dismiss from my heart all my labour wherein I had laboured under the sun."],["21",[["Ὅτι",19,8],["ἐστὶν",10,87],["ἄνθρωπος",43,5],["ὅτι",19,8],["μόχθος",1144,5],["αὐτοῦ",3,48],["ἐν",4,1],["σοφίᾳ",238,2],["καὶ",2,8],["ἐν",4,1],["γνώσει",753,2],["καὶ",2,8],["ἐν",4,1],["ἀνδρίᾳ",5221,179],["καὶ",2,8],["ἄνθρωπος",43,5],["ᾧ",24,202],["οὐκ",12,17],["ἐμόχθησεν",2190,3],["ἐν",4,1],["αὐτῷ",3,49],["δώσει",33,120],["αὐτῷ",3,49],["μερίδα",396,10],["αὐτοῦ",3,48],["καί",2,8],["γε",351,12],["τοῦτο",16,122],["ματαιότης",937,13],["καὶ",2,8],["πονηρία",729,13],["μεγάλη",65,15]],"For there is [such] a man that his labour is in wisdom, and in knowledge, and in fortitude; yet [this] man shall give his portion to one who has not laboured therein. This is also vanity and great evil."],["22",[["ὅτι",19,8],["γίνεται",30,108],["ἐν",4,1],["τῷ",1,110],["ἀνθρώπῳ",43,113],["ἐν",4,1],["παντὶ",11,111],["μόχθῳ",1144,113],["αὐτοῦ",3,48],["καὶ",2,8],["ἐν",4,1],["προαιρέσει",2296,186],["καρδίας",63,19],["αὐτοῦ",3,48],["ᾧ",24,202],["αὐτὸς",3,158],["μοχθεῖ",2190,87],["ὑπὸ",122,1],["τὸν",1,6],["ἥλιον",320,7]],"For it happens to a man in all his labour, and in the purpose of his heart wherein he labours under the sun."],["23",[["Ὅτι",19,8],["πᾶσαι",11,185],["αἱ",1,183],["ἡμέραι",28,2],["αὐτοῦ",3,48],["ἀλγημάτων",5294,45],["καὶ",2,8],["θυμοῦ",177,21],["περισπασμὸς",3119,5],["αὐτοῦ",3,48],["καί",2,8],["γε",351,12],["ἐν",4,1],["νυκτὶ",216,2],["οὐ",12,17],["κοιμᾶται",302,108],["ἡ",1,11],["καρδία",63,13],["αὐτοῦ",3,48],["καί",2,8],["γε",351,12],["τοῦτο",16,122],["ματαιότης",937,13],["ἐστίν",10,87]],"For all his days [are days] of sorrows, and vexation of spirit is his; in the night also his heart rests not. This is also vanity."],["24",[["Οὐκ",12,17],["ἔστιν",10,87],["ἀγαθὸν",113,29],["ἀνθρώπῳ",43,113],["ὃ",1,4],["φάγεται",268,89],["καὶ",2,8],["ὃ",1,4],["πίεται",215,89],["καὶ",2,8],["ὃ",1,4],["δείξει",871,120],["τῇ",1,95],["ψυχῇ",62,2],["αὐτοῦ",3,48],["ἀγαθὸν",113,29],["ἐν",4,1],["μόχθῳ",1144,113],["αὐτοῦ",3,48],["καί",2,8],["γε",351,12],["τοῦτο",16,122],["εἶδον",73,147],["ἐγὼ",6,158],["ὅτι",19,8],["ἀπὸ",17,1],["χειρὸς",37,19],["τοῦ",1,30],["Θεοῦ",20,21],["ἐστιν",10,87]],"A man has nothing [really] good to eat, and to drink, and to shew his soul [as] good in his trouble. This also I saw, that it is from the hand of God."],["25",[["Ὅτι",19,8],["τίς",39,150],["φάγεται",268,89],["καὶ",2,8],["τίς",39,150],["πίεται",215,89],["πάρεξ",2201,1],["αὐτοῦ",3,48]],"For who shall eat, or who shall drink, without him?"],["26",[["Ὅτι",19,8],["τῷ",1,110],["ἀνθρώπῳ",43,113],["τῷ",1,110],["ἀγαθῷ",113,111],["πρὸ",235,1],["προσώπου",47,24],["αὐτοῦ",3,144],["ἔδωκε",33,3],["σοφίαν",238,10],["καὶ",2,8],["γνῶσιν",753,10],["καὶ",2,8],["εὐφροσύνην",360,10],["καὶ",2,8],["τῷ",1,110],["ἁμαρτάνοντι",244,395],["ἔδωκε",33,3],["περισπασμὸν",3119,7],["τοῦ",1,30],["προσθεῖναι",200,100],["καὶ",2,8],["τοῦ",1,30],["συναγαγεῖν",165,100],["τοῦ",1,30],["δοῦναι",33,100],["τῷ",1,110],["ἀγαθῷ",113,111],["πρὸ",235,1],["προσώπου",47,24],["τοῦ",1,30],["Θεοῦ",20,21],["ὅτι",19,8],["καί",2,8],["γε",351,12],["τοῦτο",16,122],["ματαιότης",937,13],["καὶ",2,8],["προαίρεσις",2296,13],["πνεύματος",167,24]],"For [God] has given to the man who is good in his sight, wisdom, and knowledge, and joy: but he has given to the sinner trouble, to add and to heap up, that he may give to him that is good before God; for this is also vanity and waywardness of spirit."]]