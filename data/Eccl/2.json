[["1",[["Εἶπον",18,141],["ἐγὼ",6,158],["ἐν",4,1],["καρδίᾳ",64,2],["μου",6,48],["δεῦρο",715,17],["δὴ",193,12],["πειράσω",1094,157],["σε",5,161],["ἐν",4,1],["εὐφροσύνῃ",360,2],["καὶ",2,8],["ἴδε",713,17],["ἐν",4,1],["ἀγαθῷ",114,34],["καὶ",2,8],["ἰδοὺ",51,17],["καί",2,8],["γε",353,12],["τοῦτο",16,122],["ματαιότης",937,13]],"I said in my heart, Come now, I will prove thee with mirth, and behold thou good: and, behold, this is also vanity."],["2",[["Τῷ",1,110],["γέλωτι",1883,113],["εἶπα",18,147],["περιφορὰν",5936,10],["καὶ",2,8],["τῇ",1,95],["εὐφροσύνῃ",360,2],["τί",39,119],["τοῦτο",16,122],["ποιεῖς",23,145]],"I said to laughter, Madness: and to mirth, Why doest thou this?"],["3",[["Καὶ",2,8],["κατεσκεψάμην",1551,325],["εἰ",77,8],["ἡ",1,11],["καρδία",64,13],["μου",6,48],["ἑλκύσει",1217,160],["ὡς",36,8],["οἶνον",261,7],["τὴν",1,9],["σάρκα",287,10],["μου",6,48],["καὶ",2,8],["καρδία",64,13],["μου",6,48],["ὡδήγησεν",1108,3],["ἐν",4,1],["σοφίᾳ",242,2],["καὶ",2,8],["τοῦ",1,30],["κρατῆσαι",385,100],["ἐπʼ",9,1],["εὐφροσύνην",360,10],["ἕως",42,8],["οὗ",120,17],["ἴδω",53,227],["ποῖον",1332,20],["τὸ",1,27],["ἀγαθὸν",114,28],["τοῖς",1,138],["υἱοῖς",13,139],["τῶν",1,76],["ἀνθρώπων",43,77],["ὃ",1,4],["ποιήσουσιν",23,207],["ὑπὸ",122,1],["τὸν",1,6],["ἥλιον",323,7],["ἀριθμὸν",355,7],["ἡμερῶν",28,61],["ζωῆς",216,19],["αὐτῶν",3,189]],"And I examined whether my heart would excite my flesh as [with] wine, (though my heart guided [me] in wisdom,) and [I desired] to lay hold of mirth, until I should see of what kind is the good to the sons of men, which they should do under the sun all the days of their life."],["4",[["Ἐμεγάλυνα",604,147],["ποίημἀ",1443,105],["μου",6,48],["ᾠκοδόμησά",126,147],["μοι",6,49],["οἴκους",34,31],["ἐφύτευσά",1022,147],["μοι",6,49],["ἀμπελῶνας",607,31]],"I enlarged my work; I built me houses; I planted me vineyards."],["5",[["ἐποίησά",23,147],["μοι",6,49],["κήπους",1325,31],["καὶ",2,8],["παραδείσους",1121,31],["καὶ",2,8],["ἐφύτευσα",1022,147],["ἐν",4,1],["αὐτοῖς",3,142],["ξύλον",196,33],["πᾶν",11,29],["καρποῦ",448,21]],"I made me gardens and orchards, and planted in them every kind of fruit-tree."],["6",[["Ἐποίησά",23,147],["μοι",6,49],["κολυμβήθρας",2731,40],["ὑδάτων",85,45],["τοῦ",1,30],["ποτίσαι",790,100],["ἀπʼ",17,1],["αὐτῶν",3,41],["δρυμὸν",802,7],["βλαστῶντα",6857,178],["ξύλα",196,63]],"I made me pools of water, to water from them the timber-bearing wood."],["7",[["Ἐκτησάμην",564,152],["δούλους",136,31],["καὶ",2,8],["παιδίσκας",605,40],["καὶ",2,8],["οἰκογενεῖς",2609,109],["ἐγένοντό",30,184],["μοι",6,49],["καί",2,8],["γε",353,12],["κτῆσις",1274,13],["βουκολίου",1717,24],["καὶ",2,8],["ποιμνίου",707,24],["πολλὴ",74,15],["ἐγένετό",30,26],["μοι",6,49],["ὑπὲρ",139,1],["πάντας",11,58],["τοὺς",1,56],["γενομένους",30,542],["ἔμπροσθέν",390,17],["μου",6,48],["ἐν",4,1],["Ἱερουσαλήμ",70,20]],"I got servants and maidens, and servants were born to me in the house: also I had abundant possession of flocks and herds, beyond all who were before me in Jerusalem."],["8",[["Συνήγαγόν",166,141],["μοι",6,49],["καί",2,8],["γε",353,12],["ἀργύριον",152,33],["καί",2,8],["γε",353,12],["χρυσίον",202,20],["καὶ",2,8],["περιουσιασμοὺς",5931,31],["βασιλέων",22,77],["καὶ",2,8],["τῶν",1,123],["χωρῶν",278,61],["ἐποίησά",23,147],["μοι",6,49],["ᾄδοντας",856,229],["καὶ",2,8],["ᾀδούσας",856,341],["καὶ",2,8],["ἐντρυφήματα",9420,63],["υἱῶν",13,77],["ἀνθρώπων",43,77],["οἰνοχόον",3601,7],["καὶ",2,8],["οἰνοχόας",5874,109]],"Moreover I collected for myself both silver and gold also, and the peculiar treasures of kings and provinces: I procured me singing men and singing women, and delights of the sons of men, a butler and female cupbearers."],["9",[["Καὶ",2,8],["ἐμεγαλύνθην",604,148],["καὶ",2,8],["προσέθηκα",201,147],["παρὰ",73,1],["πάντας",11,58],["τοὺς",1,56],["γενομένους",30,542],["ἀπὸ",17,1],["ἔμπροσθέν",390,17],["μου",6,48],["ἐν",4,1],["Ἱερουσαλήμ",70,20],["καί",2,8],["γε",353,12],["σοφία",242,13],["μου",6,48],["ἐστάθη",78,38],["μοι",6,49]],"So I became great, and advanced beyond all that were before me in Jerusalem: also my wisdom was established to me."],["10",[["Καὶ",2,8],["πᾶν",11,29],["ὃ",1,4],["ᾔτησαν",617,141],["οἱ",1,128],["ὀφθαλμοί",91,51],["μου",6,48],["οὐκ",12,17],["ἀφεῖλον",369,141],["ἀπʼ",17,1],["αὐτῶν",3,41],["οὐκ",12,17],["ἀπεκώλυσα",2660,147],["τὴν",1,9],["καρδίαν",64,10],["μου",6,83],["ἀπὸ",17,1],["πάσης",11,78],["εὐφροσύνης",360,19],["μου",6,83],["ὅτι",19,8],["καρδία",64,13],["μου",6,48],["εὐφράνθη",244,38],["ἐν",4,1],["παντὶ",11,111],["μόχθῳ",1144,113],["μου",6,48],["καὶ",2,8],["τοῦτο",16,122],["ἐγένετο",30,26],["μερίς",399,13],["μου",6,48],["ἀπὸ",17,1],["παντὸς",11,153],["μόχθου",1144,21],["μου",6,48]],"And whatever mine eyes desired, I withheld not from them, I withheld not my heart from all my mirth: for my heart rejoiced in all my labour; and this was my portion of all my labour."],["11",[["Καὶ",2,8],["ἐπέβλεψα",517,147],["ἐγὼ",6,158],["ἐν",4,1],["πᾶσι",11,90],["ποιήμασί",1443,92],["μου",6,48],["οἷς",24,337],["ἐποίησαν",23,141],["αἱ",1,185],["χεῖρές",37,180],["μου",6,48],["καὶ",2,8],["ἐν",4,1],["μόχθῳ",1144,113],["ᾧ",24,202],["ἐμόχθησα",2178,147],["τοῦ",1,30],["ποιεῖν",23,54],["καὶ",2,8],["ἰδοὺ",51,17],["τὰ",1,42],["πάντα",11,65],["ματαιότης",937,13],["καὶ",2,8],["προαίρεσις",2284,13],["πνεύματος",168,24],["καὶ",2,8],["οὐκ",12,17],["ἔστι",10,87],["περίσσεια",2478,147],["ὑπὸ",122,1],["τὸν",1,6],["ἥλιον",323,7]],"And I looked on all my works which my hands had wrought, and on my labour which I laboured to perform: and, behold, all was vanity and waywardness of spirit, and there is no advantage under the sun."],["12",[["Καὶ",2,8],["ἐπέβλεψα",517,147],["ἐγὼ",6,158],["τοῦ",1,30],["ἰδεῖν",53,100],["σοφίαν",242,10],["καὶ",2,8],["παραφορὰν",7882,10],["καὶ",2,8],["ἀφροσύνην",1401,10],["ὅτι",19,8],["τίς",39,150],["ἄνθρωπος",43,5],["ὅς",24,246],["ἐπελεύσεται",542,89],["ὀπίσω",167,17],["τῆς",1,18],["βουλῆς",350,19],["τὰ",1,42],["ὅσα",103,43],["ἐποίησεν",23,3],["αὐτήν",3,98]],"Then I looked on to see wisdom, and madness, and folly: for who is the man who will follow after counsel, in all things wherein he employs it?"],["13",[["Καὶ",2,8],["εἶδον",53,147],["ἐγὼ",6,158],["ὅτι",19,8],["ἐστὶ",10,87],["περίσσεια",2478,147],["τῇ",1,95],["σοφίᾳ",242,2],["ὑπὲρ",139,1],["τὴν",1,9],["ἀφροσύνην",1401,10],["ὡς",36,8],["περίσσεια",2478,147],["τοῦ",1,30],["φωτὸς",380,21],["ὑπὲρ",139,1],["τὸ",1,32],["σκότος",506,5]],"And I saw that wisdom excels folly, as much as light excels darkness."],["14",[["Τοῦ",1,30],["σοφοῦ",324,153],["οἱ",1,128],["ὀφθαλμοὶ",91,51],["αὐτοῦ",3,48],["ἐν",4,1],["κεφαλῇ",144,2],["αὐτοῦ",3,48],["καὶ",2,8],["ὁ",1,4],["ἄφρων",439,16],["ἐν",4,1],["σκότει",506,53],["πορεύεται",49,108],["καὶ",2,8],["ἔγνων",79,147],["καί",2,8],["γε",353,12],["ἐγὼ",6,158],["ὅτι",19,8],["συνάντημα",2963,20],["ἓν",58,28],["συναντήσεται",429,89],["τοῖς",1,138],["πᾶσιν",11,215],["αὐτοῖς",3,142]],"The wise man's eyes are in his head; but the fool walks in darkness: and I perceived, even I, that one event shall happen to them all."],["15",[["Καὶ",2,8],["εἶπα",18,147],["ἐγὼ",6,158],["ἐν",4,1],["καρδίᾳ",64,2],["μου",6,48],["ὡς",36,8],["συνάντημα",2963,20],["τοῦ",1,30],["ἄφρονος",439,219],["καί",2,8],["γε",353,12],["ἐμοὶ",6,49],["συναντήσεταί",429,89],["μοι",6,49],["καὶ",2,8],["ἱνατί",102,238],["ἐσοφισάμην",1786,152],["ἐγώ",6,158],["περισσὸν",1636,28],["ἐλάλησα",50,147],["ἐν",4,1],["καρδίᾳ",64,2],["μου",6,48],["ὅτι",19,8],["καί",2,8],["γε",353,12],["τοῦτο",16,122],["ματαιότης",937,13],["διότι",177,8],["ὁ",1,4],["ἄφρων",439,16],["ἐκ",21,1],["περισσεύματος",7970,24],["λαλεῖ",50,87]],"And I said in my heart, As the event of the fool is, so shall it be to me, even to me; and to what purpose have I gained wisdom? I said moreover in my heart, This is also vanity, because the fool speaks of his abundance."],["16",[["Ὅτι",19,8],["οὐκ",12,17],["ἔστιν",10,87],["ἡ",1,11],["μνήμη",2177,13],["τοῦ",1,30],["σοφοῦ",324,153],["μετὰ",29,1],["τοῦ",1,30],["ἄφρονος",439,219],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["καθότι",826,17],["ἤδη",916,17],["αἱ",1,185],["ἡμέραι",28,2],["ἐρχόμεναι",55,300],["τὰ",1,42],["πάντα",11,65],["ἐπελήσθη",513,38],["καὶ",2,8],["πῶς",441,12],["ἀποθανεῖται",109,89],["ὁ",1,4],["σοφὸς",324,16],["μετὰ",29,1],["τοῦ",1,30],["ἄφρονος",439,219]],"For there is no remembrance of the wise man with the fool for ever; forasmuch as now [in] the coming days all things are forgotten: and how shall the wise man die with the fool?"],["17",[["Καὶ",2,8],["ἐμίσησα",351,147],["σὺν",310,1],["τὴν",1,9],["ζωήν",216,10],["ὅτι",19,8],["πονηρὸν",164,59],["ἐπʼ",9,1],["ἐμὲ",6,82],["τὸ",1,32],["ποίημα",1443,33],["τὸ",1,32],["πεποιημένον",23,445],["ὑπὸ",122,1],["τὸν",1,6],["ἥλιον",323,7],["ὅτι",19,8],["πάντα",11,59],["ματαιότης",937,13],["καὶ",2,8],["προαίρεσις",2284,13],["πνεύματος",168,24]],"So I hated life; because the work that was wrought under the sun was evil before me: for all is vanity and waywardness of spirit."],["18",[["Καὶ",2,8],["ἐμίσησα",351,147],["ἐγὼ",6,158],["σύμπαντα",1357,59],["μόχθον",1144,7],["μου",6,48],["ὃν",24,106],["ἐγὼ",6,158],["κοπιῶ",921,149],["ὑπὸ",122,1],["τὸν",1,6],["ἥλιον",323,7],["ὅτι",19,8],["ἀφίω",501,592],["αὐτὸν",3,82],["τῷ",1,110],["ἀνθρώπῳ",43,113],["τῷ",1,110],["γινομένῳ",30,240],["μετʼ",29,1],["ἐμέ",6,82]],"And I hated the whole of my labour which I took under the sun; because I must leave it to the man who will come after me."],["19",[["Καὶ",2,8],["τίς",39,150],["εἶδεν",53,3],["εἰ",77,8],["σοφὸς",324,16],["ἔσται",10,89],["ἢ",61,8],["ἄφρων",439,16],["καὶ",2,8],["εἰ",77,8],["ἐξουσιάζεται",2224,108],["ἐν",4,1],["παντὶ",11,111],["μόχθῳ",1144,113],["μου",6,48],["ᾧ",24,202],["ἐμόχθησα",2178,147],["καὶ",2,8],["ᾧ",24,202],["ἐσοφισάμην",1786,152],["ὑπὸ",122,1],["τὸν",1,6],["ἥλιον",323,7],["καί",2,8],["γε",353,12],["τοῦτο",16,122],["ματαιότης",937,13]],"And who knows whether he will be a wise [man] or a fool? and whether he will have power over all my labour in which I laboured, and wherein I grew wise under the sun? this is also vanity."],["20",[["Καὶ",2,8],["ἐπέστρεψα",117,147],["ἐγὼ",6,158],["τοῦ",1,30],["ἀποτάξασθαι",4040,103],["τὴν",1,9],["καρδίαν",64,10],["μου",6,48],["ἐν",4,1],["παντὶ",11,111],["μόχθῳ",1144,113],["μου",6,48],["ᾧ",24,202],["ἐμόχθησα",2178,147],["ὑπὸ",122,1],["τὸν",1,6],["ἥλιον",323,7]],"So I went about to dismiss from my heart all my labour wherein I had laboured under the sun."],["21",[["Ὅτι",19,8],["ἐστὶν",10,87],["ἄνθρωπος",43,5],["ὅτι",19,8],["μόχθος",1144,5],["αὐτοῦ",3,48],["ἐν",4,1],["σοφίᾳ",242,2],["καὶ",2,8],["ἐν",4,1],["γνώσει",753,2],["καὶ",2,8],["ἐν",4,1],["ἀνδρίᾳ",5192,180],["καὶ",2,8],["ἄνθρωπος",43,5],["ᾧ",24,202],["οὐκ",12,17],["ἐμόχθησεν",2178,3],["ἐν",4,1],["αὐτῷ",3,49],["δώσει",33,120],["αὐτῷ",3,49],["μερίδα",399,10],["αὐτοῦ",3,48],["καί",2,8],["γε",353,12],["τοῦτο",16,122],["ματαιότης",937,13],["καὶ",2,8],["πονηρία",730,13],["μεγάλη",66,15]],"For there is [such] a man that his labour is in wisdom, and in knowledge, and in fortitude; yet [this] man shall give his portion to one who has not laboured therein. This is also vanity and great evil."],["22",[["ὅτι",19,8],["γίνεται",30,108],["ἐν",4,1],["τῷ",1,110],["ἀνθρώπῳ",43,113],["ἐν",4,1],["παντὶ",11,111],["μόχθῳ",1144,113],["αὐτοῦ",3,48],["καὶ",2,8],["ἐν",4,1],["προαιρέσει",2284,188],["καρδίας",64,19],["αὐτοῦ",3,48],["ᾧ",24,202],["αὐτὸς",3,158],["μοχθεῖ",2178,87],["ὑπὸ",122,1],["τὸν",1,6],["ἥλιον",323,7]],"For it happens to a man in all his labour, and in the purpose of his heart wherein he labours under the sun."],["23",[["Ὅτι",19,8],["πᾶσαι",11,187],["αἱ",1,185],["ἡμέραι",28,2],["αὐτοῦ",3,48],["ἀλγημάτων",5263,45],["καὶ",2,8],["θυμοῦ",178,21],["περισπασμὸς",3111,5],["αὐτοῦ",3,48],["καί",2,8],["γε",353,12],["ἐν",4,1],["νυκτὶ",219,2],["οὐ",12,17],["κοιμᾶται",301,108],["ἡ",1,11],["καρδία",64,13],["αὐτοῦ",3,48],["καί",2,8],["γε",353,12],["τοῦτο",16,122],["ματαιότης",937,13],["ἐστίν",10,87]],"For all his days [are days] of sorrows, and vexation of spirit is his; in the night also his heart rests not. This is also vanity."],["24",[["Οὐκ",12,17],["ἔστιν",10,87],["ἀγαθὸν",114,29],["ἀνθρώπῳ",43,113],["ὃ",1,4],["φάγεται",269,89],["καὶ",2,8],["ὃ",1,4],["πίεται",212,89],["καὶ",2,8],["ὃ",1,4],["δείξει",870,120],["τῇ",1,95],["ψυχῇ",63,2],["αὐτοῦ",3,48],["ἀγαθὸν",114,29],["ἐν",4,1],["μόχθῳ",1144,113],["αὐτοῦ",3,48],["καί",2,8],["γε",353,12],["τοῦτο",16,122],["εἶδον",53,147],["ἐγὼ",6,158],["ὅτι",19,8],["ἀπὸ",17,1],["χειρὸς",37,19],["τοῦ",1,30],["Θεοῦ",20,21],["ἐστιν",10,87]],"A man has nothing [really] good to eat, and to drink, and to shew his soul [as] good in his trouble. This also I saw, that it is from the hand of God."],["25",[["Ὅτι",19,8],["τίς",39,150],["φάγεται",269,89],["καὶ",2,8],["τίς",39,150],["πίεται",212,89],["πάρεξ",2188,1],["αὐτοῦ",3,48]],"For who shall eat, or who shall drink, without him?"],["26",[["Ὅτι",19,8],["τῷ",1,110],["ἀνθρώπῳ",43,113],["τῷ",1,110],["ἀγαθῷ",114,111],["πρὸ",238,1],["προσώπου",47,24],["αὐτοῦ",3,144],["ἔδωκε",33,3],["σοφίαν",242,10],["καὶ",2,8],["γνῶσιν",753,10],["καὶ",2,8],["εὐφροσύνην",360,10],["καὶ",2,8],["τῷ",1,110],["ἁμαρτάνοντι",237,390],["ἔδωκε",33,3],["περισπασμὸν",3111,7],["τοῦ",1,30],["προσθεῖναι",201,100],["καὶ",2,8],["τοῦ",1,30],["συναγαγεῖν",166,100],["τοῦ",1,30],["δοῦναι",33,100],["τῷ",1,110],["ἀγαθῷ",114,111],["πρὸ",238,1],["προσώπου",47,24],["τοῦ",1,30],["Θεοῦ",20,21],["ὅτι",19,8],["καί",2,8],["γε",353,12],["τοῦτο",16,122],["ματαιότης",937,13],["καὶ",2,8],["προαίρεσις",2284,13],["πνεύματος",168,24]],"For [God] has given to the man who is good in his sight, wisdom, and knowledge, and joy: but he has given to the sinner trouble, to add and to heap up, that he may give to him that is good before God; for this is also vanity and waywardness of spirit."]]