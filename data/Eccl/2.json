[["1",[["Εἶπον",18,141],["ἐγὼ",6,158],["ἐν",4,1],["καρδίᾳ",63,2],["μου",6,48],["δεῦρο",715,17],["δὴ",193,12],["πειράσω",1096,157],["σε",5,161],["ἐν",4,1],["εὐφροσύνῃ",360,2],["καὶ",2,8],["ἴδε",693,17],["ἐν",4,1],["ἀγαθῷ",113,34],["καὶ",2,8],["ἰδοὺ",51,17],["καί",2,8],["γε",351,12],["τοῦτο",16,122],["ματαιότης",937,13]],"I said in my heart, Come now, I will prove thee with mirth, and behold thou good: and, behold, this is also vanity."],["2",[["Τῷ",1,110],["γέλωτι",1885,113],["εἶπα",18,147],["περιφορὰν",5966,10],["καὶ",2,8],["τῇ",1,95],["εὐφροσύνῃ",360,2],["τί",39,119],["τοῦτο",16,122],["ποιεῖς",23,145]],"I said to laughter, Madness: and to mirth, Why doest thou this?"],["3",[["Καὶ",2,8],["κατεσκεψάμην",1548,329],["εἰ",77,8],["ἡ",1,11],["καρδία",63,13],["μου",6,48],["ἑλκύσει",1222,160],["ὡς",36,8],["οἶνον",261,7],["τὴν",1,9],["σάρκα",287,10],["μου",6,48],["καὶ",2,8],["καρδία",63,13],["μου",6,48],["ὡδήγησεν",1110,3],["ἐν",4,1],["σοφίᾳ",238,2],["καὶ",2,8],["τοῦ",1,30],["κρατῆσαι",383,100],["ἐπʼ",9,1],["εὐφροσύνην",360,10],["ἕως",42,8],["οὗ",120,17],["ἴδω",73,227],["ποῖον",1330,20],["τὸ",1,27],["ἀγαθὸν",113,28],["τοῖς",1,138],["υἱοῖς",13,139],["τῶν",1,76],["ἀνθρώπων",43,77],["ὃ",1,4],["ποιήσουσιν",23,207],["ὑπὸ",122,1],["τὸν",1,6],["ἥλιον",320,7],["ἀριθμὸν",353,7],["ἡμερῶν",28,61],["ζωῆς",212,19],["αὐτῶν",3,187]],"And I examined whether my heart would excite my flesh as [with] wine, (though my heart guided [me] in wisdom,) and [I desired] to lay hold of mirth, until I should see of what kind is the good to the sons of men, which they should do under the sun all the days of their life."],["4",[["Ἐμεγάλυνα",606,147],["ποίημἀ",1444,105],["μου",6,48],["ᾠκοδόμησά",125,147],["μοι",6,49],["οἴκους",34,31],["ἐφύτευσά",1066,147],["μοι",6,49],["ἀμπελῶνας",603,31]],"I enlarged my work; I built me houses; I planted me vineyards."],["5",[["ἐποίησά",23,147],["μοι",6,49],["κήπους",1325,31],["καὶ",2,8],["παραδείσους",1120,31],["καὶ",2,8],["ἐφύτευσα",1066,147],["ἐν",4,1],["αὐτοῖς",3,142],["ξύλον",196,33],["πᾶν",11,29],["καρποῦ",446,21]],"I made me gardens and orchards, and planted in them every kind of fruit-tree."],["6",[["Ἐποίησά",23,147],["μοι",6,49],["κολυμβήθρας",2738,40],["ὑδάτων",85,45],["τοῦ",1,30],["ποτίσαι",788,100],["ἀπʼ",17,1],["αὐτῶν",3,41],["δρυμὸν",799,7],["βλαστῶντα",6903,177],["ξύλα",196,63]],"I made me pools of water, to water from them the timber-bearing wood."],["7",[["Ἐκτησάμην",533,152],["δούλους",136,31],["καὶ",2,8],["παιδίσκας",601,40],["καὶ",2,8],["οἰκογενεῖς",2610,109],["ἐγένοντό",30,182],["μοι",6,49],["καί",2,8],["γε",351,12],["κτῆσις",1440,13],["βουκολίου",1717,24],["καὶ",2,8],["ποιμνίου",708,24],["πολλὴ",74,15],["ἐγένετό",30,26],["μοι",6,49],["ὑπὲρ",139,1],["πάντας",11,58],["τοὺς",1,56],["γενομένους",30,552],["ἔμπροσθέν",387,17],["μου",6,48],["ἐν",4,1],["Ἱερουσαλήμ",69,20]],"I got servants and maidens, and servants were born to me in the house: also I had abundant possession of flocks and herds, beyond all who were before me in Jerusalem."],["8",[["Συνήγαγόν",165,141],["μοι",6,49],["καί",2,8],["γε",351,12],["ἀργύριον",150,33],["καί",2,8],["γε",351,12],["χρυσίον",202,20],["καὶ",2,8],["περιουσιασμοὺς",5962,31],["βασιλέων",22,77],["καὶ",2,8],["τῶν",1,123],["χωρῶν",278,61],["ἐποίησά",23,147],["μοι",6,49],["ᾄδοντας",1080,229],["καὶ",2,8],["ᾀδούσας",1080,345],["καὶ",2,8],["ἐντρυφήματα",9489,63],["υἱῶν",13,77],["ἀνθρώπων",43,77],["οἰνοχόον",3608,7],["καὶ",2,8],["οἰνοχόας",5904,109]],"Moreover I collected for myself both silver and gold also, and the peculiar treasures of kings and provinces: I procured me singing men and singing women, and delights of the sons of men, a butler and female cupbearers."],["9",[["Καὶ",2,8],["ἐμεγαλύνθην",606,148],["καὶ",2,8],["προσέθηκα",200,147],["παρὰ",72,1],["πάντας",11,58],["τοὺς",1,56],["γενομένους",30,552],["ἀπὸ",17,1],["ἔμπροσθέν",387,17],["μου",6,48],["ἐν",4,1],["Ἱερουσαλήμ",69,20],["καί",2,8],["γε",351,12],["σοφία",238,13],["μου",6,48],["ἐστάθη",78,38],["μοι",6,49]],"So I became great, and advanced beyond all that were before me in Jerusalem: also my wisdom was established to me."],["10",[["Καὶ",2,8],["πᾶν",11,29],["ὃ",1,4],["ᾔτησαν",615,141],["οἱ",1,128],["ὀφθαλμοί",91,51],["μου",6,48],["οὐκ",12,17],["ἀφεῖλον",367,141],["ἀπʼ",17,1],["αὐτῶν",3,41],["οὐκ",12,17],["ἀπεκώλυσα",2662,147],["τὴν",1,9],["καρδίαν",63,10],["μου",6,83],["ἀπὸ",17,1],["πάσης",11,78],["εὐφροσύνης",360,19],["μου",6,83],["ὅτι",19,8],["καρδία",63,13],["μου",6,48],["εὐφράνθη",242,38],["ἐν",4,1],["παντὶ",11,111],["μόχθῳ",1144,113],["μου",6,48],["καὶ",2,8],["τοῦτο",16,122],["ἐγένετο",30,26],["μερίς",396,13],["μου",6,48],["ἀπὸ",17,1],["παντὸς",11,153],["μόχθου",1144,21],["μου",6,48]],"And whatever mine eyes desired, I withheld not from them, I withheld not my heart from all my mirth: for my heart rejoiced in all my labour; and this was my portion of all my labour."],["11",[["Καὶ",2,8],["ἐπέβλεψα",516,147],["ἐγὼ",6,158],["ἐν",4,1],["πᾶσι",11,90],["ποιήμασί",1444,92],["μου",6,48],["οἷς",24,341],["ἐποίησαν",23,141],["αἱ",1,183],["χεῖρές",37,179],["μου",6,48],["καὶ",2,8],["ἐν",4,1],["μόχθῳ",1144,113],["ᾧ",24,202],["ἐμόχθησα",2190,147],["τοῦ",1,30],["ποιεῖν",23,54],["καὶ",2,8],["ἰδοὺ",51,17],["τὰ",1,42],["πάντα",11,65],["ματαιότης",937,13],["καὶ",2,8],["προαίρεσις",2296,13],["πνεύματος",167,24],["καὶ",2,8],["οὐκ",12,17],["ἔστι",10,87],["περίσσεια",2485,147],["ὑπὸ",122,1],["τὸν",1,6],["ἥλιον",320,7]],"And I looked on all my works which my hands had wrought, and on my labour which I laboured to perform: and, behold, all was vanity and waywardness of spirit, and there is no advantage under the sun."],["12",[["Καὶ",2,8],["ἐπέβλεψα",516,147],["ἐγὼ",6,158],["τοῦ",1,30],["ἰδεῖν",73,100],["σοφίαν",238,10],["καὶ",2,8],["παραφορὰν",7940,10],["καὶ",2,8],["ἀφροσύνην",1402,10],["ὅτι",19,8],["τίς",39,150],["ἄνθρωπος",43,5],["ὅς",24,247],["ἐπελεύσεται",540,89],["ὀπίσω",166,17],["τῆς",1,18],["βουλῆς",349,19],["τὰ",1,42],["ὅσα",102,43],["ἐποίησεν",23,3],["αὐτήν",3,98]],"Then I looked on to see wisdom, and madness, and folly: for who is the man who will follow after counsel, in all things wherein he employs it?"],["13",[["Καὶ",2,8],["εἶδον",73,147],["ἐγὼ",6,158],["ὅτι",19,8],["ἐστὶ",10,87],["περίσσεια",2485,147],["τῇ",1,95],["σοφίᾳ",238,2],["ὑπὲρ",139,1],["τὴν",1,9],["ἀφροσύνην",1402,10],["ὡς",36,8],["περίσσεια",2485,147],["τοῦ",1,30],["φωτὸς",376,21],["ὑπὲρ",139,1],["τὸ",1,32],["σκότος",503,5]],"And I saw that wisdom excels folly, as much as light excels darkness."],["14",[["Τοῦ",1,30],["σοφοῦ",322,153],["οἱ",1,128],["ὀφθαλμοὶ",91,51],["αὐτοῦ",3,48],["ἐν",4,1],["κεφαλῇ",144,2],["αὐτοῦ",3,48],["καὶ",2,8],["ὁ",1,4],["ἄφρων",438,16],["ἐν",4,1],["σκότει",503,53],["πορεύεται",49,108],["καὶ",2,8],["ἔγνων",81,147],["καί",2,8],["γε",351,12],["ἐγὼ",6,158],["ὅτι",19,8],["συνάντημα",2975,20],["ἓν",57,28],["συναντήσεται",426,89],["τοῖς",1,138],["πᾶσιν",11,215],["αὐτοῖς",3,142]],"The wise man's eyes are in his head; but the fool walks in darkness: and I perceived, even I, that one event shall happen to them all."],["15",[["Καὶ",2,8],["εἶπα",18,147],["ἐγὼ",6,158],["ἐν",4,1],["καρδίᾳ",63,2],["μου",6,48],["ὡς",36,8],["συνάντημα",2975,20],["τοῦ",1,30],["ἄφρονος",438,218],["καί",2,8],["γε",351,12],["ἐμοὶ",6,49],["συναντήσεταί",426,89],["μοι",6,49],["καὶ",2,8],["ἱνατί",101,238],["ἐσοφισάμην",1785,152],["ἐγώ",6,158],["περισσὸν",1636,28],["ἐλάλησα",50,147],["ἐν",4,1],["καρδίᾳ",63,2],["μου",6,48],["ὅτι",19,8],["καί",2,8],["γε",351,12],["τοῦτο",16,122],["ματαιότης",937,13],["διότι",176,8],["ὁ",1,4],["ἄφρων",438,16],["ἐκ",21,1],["περισσεύματος",8029,24],["λαλεῖ",50,87]],"And I said in my heart, As the event of the fool is, so shall it be to me, even to me; and to what purpose have I gained wisdom? I said moreover in my heart, This is also vanity, because the fool speaks of his abundance."],["16",[["Ὅτι",19,8],["οὐκ",12,17],["ἔστιν",10,87],["ἡ",1,11],["μνήμη",2189,13],["τοῦ",1,30],["σοφοῦ",322,153],["μετὰ",29,1],["τοῦ",1,30],["ἄφρονος",438,218],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["καθότι