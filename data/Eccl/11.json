[["1",[["Ἀπόστειλον",84,198],["τὸν",1,6],["ἄρτον",197,7],["σου",5,146],["ἐπὶ",9,1],["πρόσωπον",47,33],["τοῦ",1,23],["ὕδατος",85,24],["ὅτι",19,8],["ἐν",4,1],["πλήθει",200,53],["ἡμερῶν",28,61],["εὑρήσεις",101,159],["αὐτόν",3,82]],"Send forth thy bread upon the face of the water: for thou shalt find it after many days."],["2",[["Δὸς",33,198],["μερίδα",399,10],["τοῖς",1,138],["ἑπτὰ",180,57],["καί",2,8],["γε",353,12],["τοῖς",1,138],["ὀκτὼ",1052,57],["ὅτι",19,8],["οὐ",12,17],["γινώσκεις",79,145],["τί",39,119],["ἔσται",10,89],["πονηρὸν",164,29],["ἐπὶ",9,1],["τὴν",1,9],["γῆν",26,10]],"Give a portion to seven, and also to eight; for thou knowest not what evil there shall be upon the earth."],["3",[["Ἐὰν",45,8],["πλησθῶσι",924,266],["τὰ",1,42],["νέφη",1555,43],["ὑετοῦ",676,21],["ἐπὶ",9,1],["τὴν",1,9],["γῆν",26,10],["ἐκχέουσι",436,191],["καὶ",2,8],["ἐὰν",45,8],["πέσῃ",154,160],["ξύλον",196,33],["ἐν",4,1],["τῷ",1,110],["Νότῳ",589,113],["καὶ",2,8],["ἐὰν",45,8],["ἐν",4,1],["τῷ",1,110],["Βοῤῥᾷ",387,113],["τόπῳ",99,113],["οὗ",120,17],["πεσεῖται",154,89],["τὸ",1,32],["ξυλον",196,33],["ἐκεῖ",76,17],["ἔσται",10,89]],"If the clouds be filled with rain, they pour [it] out upon the earth: and if a tree fall southward, or if it fall northward, in the place where the tree shall fall, there it shall be."],["4",[["Τηρῶν",1358,67],["ἄνεμον",850,7],["οὐ",12,17],["σπείρει",793,87],["καὶ",2,8],["βλέπων",470,67],["ἐν",4,1],["ταῖς",1,70],["νεφέλαις",444,71],["οὐ",12,17],["θερίσει",1509,120]],"He that observes the wind sows not; and he that looks at the clouds will not reap."],["5",[["Ἐν",4,1],["οἷς",24,292],["οὐκ",12,17],["ἔστι",10,87],["γινώσκων",79,67],["τίς",39,150],["ἡ",1,11],["ὁδὸς",68,13],["τοῦ",1,23],["πνεύματος",168,24],["ὡς",36,8],["ὀστᾶ",473,63],["ἐν",4,1],["γαστρὶ",777,2],["κυοφορούσης",7530,212],["οὕτως",71,17],["οὐ",12,17],["γνώσῃ",79,116],["τὰ",1,42],["ποιήματα",1443,43],["τοῦ",1,30],["Θεοῦ",20,21],["ὅσα",103,63],["ποιήσει",23,120],["τὰ",1,253],["σύμπαντα",1357,74]],"Among whom none knows what is the way of the wind: as the bones [are hid] in the womb of a pregnant [woman], so thou shalt not know the works of God, [even] all things whatsoever he shall do."],["6",[["Ἐν",4,1],["τῷ",1,110],["πρωῒ",504,17],["σπεῖρον",793,36],["τὸ",1,27],["σπέρμα",218,20],["σου",5,146],["καὶ",2,8],["ἐν",4,1],["ἑσπέρᾳ",488,180],["μὴ",25,8],["ἀφέτω",501,46],["ἡ",1,11],["χείρ",37,13],["σου",5,146],["ὅτι",19,8],["οὐ",12,17],["γινώσκεις",79,145],["ποῖον",1332,7],["στοιχήσει",8295,120],["ἢ",61,8],["τοῦτο",16,122],["ἢ",61,8],["τοῦτο",16,122],["καὶ",2,8],["ἐὰν",45,8],["τὰ",1,42],["δύο",104,57],["ἐπιτοαυτὸ",1404,105],["ἀγαθά",114,65]],"In the morning sow thy seed, and in the evening let not thine hand be slack: for thou knowest not what sort shall prosper, whether this or that, or whether both shall be good alike."],["7",[["Καὶ",2,8],["γλυκὺ",2073,28],["τὸ",1,27],["φῶς",380,20],["καὶ",2,8],["ἀγαθὸν",114,28],["τοῖς",1,138],["ὀφθαλμοῖς",91,139],["τοῦ",1,30],["βλέπειν",470,54],["σὺν",310,1],["τὸν",1,6],["ἥλιον",323,7]],"Moreover the light is sweet, and it is good for the eyes to see the sun."],["8",[["Ὅτ",0,0],["καὶ",2,8],["ἐὰν",45,8],["ἔτη",81,43],["πολλὰ",74,65],["ζήσεται",107,89],["ὁ",1,4],["ἄνθρωπος",43,5],["ἐν",4,1],["πᾶσιν",11,215],["αὐτοῖς",3,142],["εὐφρανθήσεται",244,125],["καὶ",2,8],["μνησθήσεται",230,125],["τὰς",1,39],["ἡμέρας",28,19],["τοῦ",1,30],["σκότους",506,31],["ὅτι",19,8],["πολλαὶ",74,187],["ἔσονται",10,127],["πᾶν",11,29],["τὸ",1,32],["ἐρχόμενον",55,205],["ματαιότης",937,13]],"For even if a man should live many years, [and] rejoice in them all; yet let him remember the days of darkness; for they shall be many. All that comes is vanity."],["9",[["Εὐφραίνου",244,249],["νεανίσκε",570,250],["ἐν",4,1],["νεότητί",787,2],["σου",5,146],["καὶ",2,8],["ἀγαθυνάτω",1694,46],["σε",5,161],["ἡ",1,11],["καρδία",64,13],["σου",5,146],["ἐν",4,1],["ἡμέραις",28,71],["νεότητός",787,19],["σου",5,146],["καὶ",2,8],["περιπάτει",1327,239],["ἐν",4,1],["ὁδοῖς",68,71],["καρδίας",64,19],["σου",5,146],["ἄμωμος",637,16],["καὶ",2,8],["μὴ",25,8],["ἐν",4,1],["ὁράσει",509,2],["ὀφθαλμῶν",91,77],["σου",5,146],["καὶ",2,8],["γνῶθι",79,198],["ὅτι",19,8],["ἐπὶ",9,1],["πᾶσι",11,215],["τούτοις",16,193],["ἄξει",224,120],["σε",5,161],["ὁ",1,4],["Θεὸς",20,5],["ἐν",4,1],["κρίσει",229,2]],"Rejoice, O young man, in thy youth; and let thy heart cheer thee in the days of thy youth, and walk in the ways of thy heart blameless, but not in the sight of thine eyes: yet know that for all these things God will bring thee into judgment."],["10",[["Καὶ",2,8],["ἀπόστησον",293,198],["θυμὸν",178,7],["ἀπὸ",17,1],["καρδίας",64,19],["σου",5,146],["καὶ",2,8],["πάραγε",2277,239],["πονηρίαν",730,10],["ἀπὸ",17,1],["σαρκός",287,19],["σου",5,146],["ὅτι",19,8],["ἡ",1,11],["νεότης",787,13],["καὶ",2,8],["ἡ",1,11],["ἄνοια",2412,13],["ματαιότης",937,13]],"Therefore remove sorrow from thy heart, and put away evil from thy flesh: for youth and folly are vanity."]]