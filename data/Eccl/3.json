["ὁ",1,4],["εὐσεβής",1244,16]],"And moreover I saw under the sun the place of judgment, there was the ungodly one; and the place of righteousness, there was the godly one."],["17",[["Καὶ",2,8],["εἶπα",18,147],["ἐγὼ",6,158],["ἐν",4,1],["καρδίᾳ",64,2],["μου",6,48],["σὺν",310,1],["τὸν",1,6],["δίκαιον",153,59],["καὶ",2,8],["σὺν",310,1],["τὸν",1,6],["ἀσεβῆ",247,59],["κρινεῖ",263,120],["ὁ",1,4],["Θεός",20,5],["ὅτι",19,8],["καιρὸς",132,5],["τῷ",1,52],["παντὶ",11,34],["πράγματι",511,53],["καὶ",2,8],["ἐπὶ",9,1],["παντὶ",11,34],["τῷ",1,52],["ποιήματι",1443,53],["ἐκεῖ",76,17]],"And I said in my heart, God will judge the righteous and the ungodly: for there is a time there for every action and for every work."],["18",[["Εἶπα",18,147],["ἐγὼ",6,158],["ἐν",4,1],["καρδίᾳ",64,2],["μου",6,83],["περὶ",72,1],["λαλιᾶς",1824,19],["υἱῶν",13,77],["τοῦ",1,30],["ἀνθρώπου",43,21],["ὅτι",19,8],["διακρινεῖ",1506,120],["αὐτοὺς",3,60],["ὁ",1,4],["Θεὸς",20,5],["καὶ",2,8],["τοῦ",1,30],["δεῖξαι",870,100],["ὅτι",19,8],["αὐτοὶ",3,195],["κτήνη",223,43],["εἰσί",10,191]],"I said in my heart, concerning the speech of the sons of man, God will judge them, and that to shew that they are beasts."],["19",[["Καί",2,8],["γε",353,12],["αὐτοῖς",3,142],["συνάντημα",2963,20],["υἱῶν",13,77],["τοῦ",1,30],["ἀνθρώπου",43,21],["καὶ",2,8],["συνάντημα",2963,20],["τοῦ",1,23],["κτήνους",223,24],["συνάντημα",2963,20],["ἓν",58,28],["αὐτοῖς",3,142],["ὡς",36,8],["ὁ",1,4],["θάνατος",170,5],["τούτου",16,126],["οὕτως",71,17],["καὶ",2,8],["ὁ",1,4],["θάνατος",170,5],["τούτου",16,126],["καὶ",2,8],["πνεῦμα",168,20],["ἓν",58,28],["τοῖς",1,138],["πᾶσι",11,215],["καὶ",2,8],["τί",39,119],["ἐπερίσσευσεν",3112,3],["ὁ",1,4],["ἄνθρωπος",43,5],["παρὰ",73,1],["τὸ",1,32],["κτῆνος",223,33],["οὐδέν",228,29],["ὅτι",19,8],["πάντα",11,65],["ματαιότης",937,13]],"Also to them is the event of the sons of man, and the event of the brute; one event befalls them: as is the death of the one, so also the death of the other; and there is one breath to all: an