[["1",[["ῬΗΜΑΤΑ",0,0],["Ἐκκλησιαστοῦ",3423,21],["υἱοῦ",13,21],["Δαυὶδ",52,105],["βασιλέως",22,21],["Ἰσραὴλ",27,105],["ἐν",4,1],["Ἱερουσαλήμ",70,20]],"The words of the Preacher, the son of David, king of Israel in Jerusalem."],["2",[["Ματαιότης",937,13],["ματαιοτήτων",937,61],["εἶπεν",18,3],["ὁ",1,4],["Ἐκκλησιαστὴς",3423,5],["ματαιότης",937,13],["ματαιοτήτων",937,61],["τὰ",1,42],["πάντα",11,65],["ματαιότης",937,13]],"Vanity of vanities, said the Preacher, vanity of vanities; all is vanity."],["3",[["Τίς",39,150],["περίσσεια",2478,147],["τῷ",1,110],["ἀνθρώπῳ",43,113],["ἐν",4,1],["παντὶ",11,111],["μόχθῳ",1144,113],["αὐτοῦ",3,48],["ᾧ",24,202],["μοχθεῖ",2178,87],["ὑπὸ",122,1],["τὸν",1,6],["ἥλιον",323,7]],"What advantage [is there] to a man in all his labour that he takes under the sun?"],["4",[["Γενεὰ",286,13],["πορεύεται",49,108],["καὶ",2,8],["γενεὰ",286,13],["ἔρχεται",55,108],["καὶ",2,8],["ἡ",1,11],["γῆ",26,13],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["ἕστηκε",78,165]],"A generation goes, and a generation comes: but the earth stands for ever."],["5",[["Καὶ",2,8],["ἀνατέλλει",900,87],["ὁ",1,4],["ἥλιος",323,5],["καὶ",2,8],["δύνει",2169,87],["ὁ",1,4],["ἥλιος",323,5],["καὶ",2,8],["εἰς",8,1],["τὸν",1,6],["τόπον",99,7],["αὐτοῦ",3,48],["ἕλκει",1217,87]],"And the sun arises, and the sun goes down and draws toward its place;"],["6",[["αὐτὸς",3,158],["ἀνατέλλων",900,67],["ἐκεῖ",76,17],["πορεύεται",49,108],["πρὸς",15,1],["Νότον",589,7],["καὶ",2,8],["κυκλοῖ",603,87],["πρὸς",15,1],["Βοῤῥᾶν",387,7],["κυκλοῖ",603,87],["κυκλῶν",603,67],["πορεύεται",49,108],["τὸ",1,32],["πνεῦμα",168,33],["καὶ",2,8],["ἐπὶ",9,1],["κύκλους",4290,31],["αὐτοῦ",3,48],["ἐπιστρέφει",117,87],["τὸ",1,32],["πνεῦμα",168,33]],"arising there it proceeds southward, and goes round toward the north. The wind goes round and round, and the wind returns to its circuits."],["7",[["Πάντες",11,130],["οἱ",1,128],["χείμαῤῥοι",737,51],["πορεύονται",49,299],["εἰς",8,1],["τὴν",1,9],["θάλασσαν",137,10],["καὶ",2,8],["ἡ",1,11],["θάλασσα",137,13],["οὐκ",12,17],["ἔστιν",10,87],["ἐμπιμπλαμένη",427,204],["εἰς",8,1],["τὸν",1,6],["τόπον",99,7],["οὗ",120,17],["οἱ",1,128],["χείμαῤῥοι",737,51],["πορεύονται",49,299],["ἐκεῖ",76,17],["αὐτοὶ",3,195],["ἐπιστρέφουσι",117,191],["τοῦ",1,30],["πορευθῆναι",49,175]],"All the rivers run into the sea; and yet the sea is not filled: to the place whence the rivers come, thither they return again."],["8",[["Πάντες",11,130],["οἱ",1,128],["λόγοι",48,51],["ἔγκοποι",5354,130],["οὐ",12,17],["δυνήσεται",185,89],["ἀνὴρ",38,5],["τοῦ",1,30],["λαλεῖν",50,54],["καὶ",2,8],["οὐ",12,17],["πλησθήσεται",909,125],["ὀφθαλμὸς",91,5],["τοῦ",1,30],["ὁρᾷν",112,54],["καὶ",2,8],["οὐ",12,17],["πληρωθήσεται",518,125],["οὖς",328,33],["ἀπὸ",17,1],["ἀκροάσεως",4013,19]],"All things are full of labour; a man will not be able to speak [of them]: neither shall the eye be satisfied with seeing, neither shall the ear be filled with hearing."],["9",[["Τί",39,119],["τὸ",1,32],["γεγονός",30,419],["αὐτὸ",3,121],["τὸ",1,32],["γενησόμενον",30,413],["καὶ",2,8],["τί",39,119],["τὸ",1,32],["πεποιημένον",23,445],["αὐτὸ",3,121],["τὸ",1,32],["ποιηθησόμενον",23,679],["καὶ",2,8],["οὐκ",12,17],["ἔστι",10,87],["πᾶν",11,29],["πρόσφατον",3940,29],["ὑπὸ",122,1],["τὸν",1,6],["ἥλιον",323,7]],"What is that which has been? the very thing which shall be: and what is that which has been done? the very thing which shall be done: and there is no new thing under the sun."],["10",[["Ὃς",24,246],["λαλήσει",50,120],["καὶ",2,8],["ἐρεῖ",165,120],["ἴδε",713,17],["τοῦτο",16,122],["καινόν",728,29],["ἐστιν",10,87],["ἤδη",916,17],["γέγονεν",30,165],["ἐν",4,1],["τοῖς",1,138],["αἰῶσι",100,139],["τοῖς",1,138],["γενομένοις",30,582],["ἀπὸ",17,1],["ἔμπροσθεν",390,17],["ἡμῶν",6,41]],"[Who is he] that shall speak and say, Behold, this is new? it has already been in the ages that have passed before us."],["11",[["Οὐκ",12,17],["ἔστι",10,87],["μνήμη",2177,13],["τοῖς",1,138],["πρώτοις",315,215],["καί",2,8],["γε",353,12],["τοῖς",1,138],["ἐσχάτοις",410,215],["γενομένοις",30,582],["οὐκ",12,17],["ἔσται",10,89],["αὐτῶν",3,41],["μνήμη",2177,13],["μετὰ",29,1],["τῶν",1,76],["γενησομένων",30,667],["εἰς",8,1],["τὴν",1,9],["ἐσχάτην",410,37]],"There is no memorial to the first things; neither to the things that have been last shall their memorial be with them that shall be at the last [time]."],["12",[["Ἐγὼ",6,158],["ἐκκλησιαστὴς",3423,5],["ἐγενόμην",30,152],["βασιλεὺς",22,5],["ἐπὶ",9,1],["Ἰσραὴλ",27,105],["ἐν",4,1],["Ἱερουσαλήμ",70,20]],"I the Preacher was king over Israel in Jerusalem."],["13",[["Καὶ",2,8],["ἔδωκα",33,147],["τὴν",1,9],["καρδίαν",64,10],["μου",6,48],["τοῦ",1,30],["ἐκζητῆσαι",460,100],["καὶ",2,8],["τοῦ",1,30],["κατασκέψασθαι",1551,389],["ἐν",4,1],["τῇ",1,95],["σοφίᾳ",242,2],["περὶ",72,1],["πάντων",11,163],["τῶν",1,76],["γινομένων",30,295],["ὑπὸ",122,1],["τὸν",1,6],["οὐρανόν",94,7],["ὅτι",19,8],["περισπασμὸν",3111,7],["πονηρὸν",164,59],["ἔδωκεν",33,3],["ὁ",1,4],["Θεὸς",20,5],["τοῖς",1,138],["υἱοῖς",13,139],["τῶν",1,76],["ἀνθρώπων",43,77],["τοῦ",1,30],["περισπᾶσθαι",3614,104],["ἐν",4,1],["αὐτῷ",3,49]],"And I applied my heart to seek out and examine by wisdom concerning all things that are done under heaven, for God has given to the sons of men an evil trouble to be troubled therewith."],["14",[["Εἶδον",53,147],["σύμπαντα",1357,74],["τὰ",1,253],["ποιήματα",1443,63],["τὰ",1,253],["πεποιημένα",23,441],["ὑπὸ",122,1],["τὸν",1,6],["ἥλιον",323,7],["καὶ",2,8],["ἰδοὺ",51,17],["τὰ",1,42],["πάντα",11,65],["ματαιότης",937,13],["καὶ",2,8],["προαίρεσις",2284,13],["πνεύματος",168,24]],"I beheld all the works that were wrought under the sun; and, behold, all were vanity and waywardness of spirit."],["15",[["Διεστραμμένον",1322,326],["οὐ",12,17],["δυνήσεται",185,89],["ἐπικοσμηθῆναι",9514,175],["καὶ",2,8],["ὑστέρημα",3774,33],["οὐ",12,17],["δυνήσεται",185,89],["ἀριθμηθῆναι",1429,175]],"That which is crooked cannot be made straight: and deficiency cannot be numbered."],["16",[["Ἐλάλησα",50,147],["ἐγὼ",6,158],["ἐν",4,1],["καρδίᾳ",64,2],["μου",6,48],["τῷ",1,110],["λέγειν",31,54],["ἰδοὺ",51,17],["ἐγὼ",6,158],["ἐμεγαλύνθην",604,148],["καὶ",2,8],["προσέθηκα",201,147],["σοφίαν",242,10],["ἐπὶ",9,1],["πᾶσιν",11,215],["οἳ",1,128],["ἐγένοντο",30,184],["ἔμπροσθέν",390,17],["μου",6,48],["ἐν",4,1],["Ἱερουσαλήμ",70,20],["καὶ",2,8],["ἔδωκα",33,147],["καρδίαν",64,10],["μου",6,48],["τοῦ",1,30],["γνῶναι",79,100],["σοφίαν",242,10],["καὶ",2,8],["γνῶσιν",753,10]],"I spoke in my heart, saying, Behold, I am increased, and have acquired wisdom beyond all who were before me in Jerusalem: also I applied my heart to know wisdom and knowledge."],["17",[["Καὶ",2,8],["καρδία",64,13],["μου",6,48],["εἶδε",53,3],["πολλὰ",74,65],["σοφίαν",242,10],["καὶ",2,8],["γνῶσιν",753,10],["παραβολὰς",1061,40],["καὶ",2,8],["ἐπιστήμην",891,10],["ἔγνων",79,147],["ἐγώ",6,158],["ὅτι",19,8],["καί",2,8],["γε",353,12],["τοῦτό",16,344],["ἐστι",10,87],["προαίρεσις",2284,13],["πνεύματος",168,24]],"And my heart knew much—wisdom, and knowledge, parables and understanding: I perceived that this also is waywardness of spirit."],["18",[["Ὅτι",19,8],["ἐν",4,1],["πλήθει",200,53],["σοφίας",242,19],["πλῆθος",200,20],["γνώσεως",753,19],["καὶ",2,8],["ὁ",1,4],["προστιθεὶς",201,67],["γνῶσιν",753,10],["προσθήσει",201,120],["ἄλγημα",5263,20]],"For in the abundance of wisdom is abundance of knowledge; and he that increases knowledge will increase sorrow."]]