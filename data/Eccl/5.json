[["1",[["Μὴ",25,8],["σπεῦδε",846,239],["ἐπὶ",9,1],["στόματί",123,53],["σου",5,146],["καὶ",2,8],["καρδία",64,13],["σου",5,146],["μὴ",25,8],["ταχυνάτω",2120,46],["τοῦ",1,30],["ἐξενέγκαι",624,100],["λόγον",48,7],["πρὸ",238,1],["προσώπου",47,24],["τοῦ",1,30],["Θεοῦ",20,21],["ὅτι",19,8],["ὁ",1,4],["Θεὸς",20,5],["ἐν",4,1],["τῷ",1,110],["οὐρανῷ",94,113],["ἄνω",1314,17],["καὶ",2,8],["σὺ",5,156],["ἐπὶ",9,1],["τῆς",1,18],["γῆς",26,19],["διὰ",56,1],["τοῦτο",16,122],["ἔστωσαν",10,55],["οἱ",1,128],["λόγοι",48,51],["σου",5,146],["ὀλίγοι",555,130]],"Be not hasty with thy mouth, and let not thine heart be swift to utter anything before God; for God is in heaven above, and thou upon earth: therefore let thy words be few."],["2",[["Ὅτι",19,8],["παραγίνεται",377,108],["ἐνύπνιον",653,20],["ἐν",4,1],["πλήθει",200,53],["πειρασμοῦ",2281,21],["καὶ",2,8],["φωνὴ",95,13],["ἄφρονος",439,219],["ἐν",4,1],["πλήθει",200,53],["λόγων",48,77]],"For through the multitude of trial a dream comes; and a fool's voice is with a multitude of words."],["3",[["Καθὼς",221,17],["εὔξῃ",670,116],["εὐχὴν",633,10],["τῷ",1,110],["Θεῷ",20,113],["μὴ",25,8],["χρονίσῃς",1746,170],["τοῦ",1,30],["ἀποδοῦναι",312,100],["αὐτήν",3,98],["ὅτι",19,8],["οὐκ",12,17],["ἔστι",10,87],["θέλημα",1039,33],["ἐν",4,1],["ἄφροσι",439,512],["σὺ",5,156],["οὖν",227,12],["ὅσα",103,63],["ἐὰν",45,8],["εὔξῃ",670,116],["ἀπόδος",312,198]],"Whenever thou shalt vow a vow to God, defer not to pay it; for [he has] no pleasure in fools: pay thou therefore whatsoever thou shalt have vowed."],["4",[["Ἀγαθὸν",114,29],["τὸ",1,32],["μὴ",25,8],["εὔξασθαί",670,103],["σε",5,161],["ἢ",61,8],["τὸ",1,32],["εὔξασθαί",670,103],["σε",5,161],["καὶ",2,8],["μὴ",25,8],["ἀποδοῦναι",312,100]],"[It is] better that thou shouldest not vow, than that thou shouldest vow and not pay."],["5",[["Μὴ",25,8],["δῷς",33,170],["τὸ",1,32],["στόμα",123,33],["σου",5,146],["τοῦ",1,30],["ἐξαμαρτῆσαι",1369,100],["τὴν",1,9],["σάρκα",287,10],["σου",5,146],["καὶ",2,8],["μὴ",25,8],["εἴπῃς",18,170],["πρὸ",238,1],["προσώπου",47,24],["τοῦ",1,30],["Θεοῦ",20,21],["ὅτι",19,8],["ἄγνοιά",1856,13],["ἐστιν",10,87],["ἵνα",102,8],["μὴ",25,8],["ὀργισθῇ",725,333],["ὁ",1,4],["Θεὸς",20,5],["ἐπὶ",9,1],["φωνῇ",95,2],["σου",5,146],["καὶ",2,8],["διαφθείρῃ",688,166],["τὰ",1,42],["ποιήματα",1443,43],["χειρῶν",37,61],["σου",5,146]],"Suffer not thy mouth to lead thy flesh to sin; and say not in the presence of God, It was an error: lest God be angry at thy voice, and destroy the works of thy hands."],["6",[["Ὅτι",19,8],["ἐν",4,1],["πλήθει",200,53],["ἐνυπνίων",653,45],["καὶ",2,8],["ματαιοτήτων",937,61],["καὶ",2,8],["λόγων",48,77],["πολλῶν",74,163],["ὅτι",19,8],["σὺ",5,156],["τὸν",1,6],["Θεὸν",20,7],["φοβοῦ",134,249]],"For [there is evil] in a multitude of dreams and vanities and many words: but fear thou God."],["7",[["Ἐὰν",45,8],["συκοφαντίαν",3961,10],["πένητος",672,21],["καὶ",2,8],["ἁρπαγὴν",3718,10],["κρίματος",267,24],["καὶ",2,8],["δικαιοσύνης",187,19],["ἴδῃς",53,170],["ἐν",4,1],["χώρᾳ",278,2],["μὴ",25,8],["θαυμάσῃς",963,170],["ἐπὶ",9,1],["τῷ",1,52],["πράγματι",511,53],["ὅτι",19,8],["ὑψηλὸς",289,16],["ἐπάνω",491,17],["ὑψηλοῦ",289,153],["φυλάξαι",125,100],["καὶ",2,8],["ὑψηλοὶ",289,130],["ἐπʼ",9,1],["αὐτοῖς",3,142]],"If thou shouldest see the oppression of the poor, and the wresting of judgment and of justice in the land, wonder not at the matter: for [there is] a high one to watch over him that is high, and high ones over them."],["8",[["Καὶ",2,8],["περίσσεια",2478,147],["γῆς",26,19],["ἐπὶ",9,1],["παντί",11,111],["ἐστι",10,87],["βασιλεὺς",22,5],["τοῦ",1,30],["ἀγροῦ",252,21],["εἰργασμένου",467,479]],"Also the abundance of the earth is for every one: the king [is dependent on] the tilled field."],["9",[["Ἀγαπῶν",214,36],["ἀργύριον",152,20],["οὐ",12,17],["πλησθήσεται",909,125],["ἀργυρίου",152,24],["καὶ",2,8],["τίς",39,150],["ἠγάπησεν",214,3],["ἐν",4,1],["πλήθει",200,53],["αὐτῶν",3,41],["γέννημα",742,20],["καί",2,8],["γε",353,12],["τοῦτο",16,122],["ματαιότης",937,13]],"He that loves silver shall not be satisfied with silver: and who has loved gain, in the abundance thereof? this is also vanity."],["10",[["Ἐν",4,1],["πλήθει",200,53],["ἀγαθωσύνης",2300,19],["ἐπληθύνθησαν",316,94],["ἔσθοντες",1460,137],["αὐτήν",3,98],["καὶ",2,8],["τί",39,119],["ἀνδρεία",1485,15],["τῷ",1,110],["παρʼ",73,1],["αὐτῆς",3,83],["ὅτι",19,8],["ἀρχὴ",270,13],["τοῦ",1,30],["ὁρᾷν",112,54],["ὀφθαλμοῖς",91,139],["αὐτοῦ",3,48]],"In the multitude of good they are increased that eat it: and what virtue has the owner, but the right of beholding [it] with his eyes?"],["11",[["Γλυκὺς",2073,16],["ὕπνος",1010,5],["τοῦ",1,30],["δούλου",136,21],["εἰ",77,8],["ὀλίγον",555,29],["καὶ",2,8],["εἰ",77,8],["πολὺ",74,29],["φάγεται",269,89],["καὶ",2,8],["τῷ",1,110],["ἐμπλησθέντι",427,235],["τοῦ",1,30],["πλουτῆσαι",2373,100],["οὐκ",12,17],["ἔστιν",10,87],["ἀφίων",9140,61],["αὐτὸν",3,82],["τοῦ",1,30],["ὑπνῶσαι",1664,100]],"The sleep of a servant is sweet, whether he eat little or much: but to one who is satiated with wealth, there is none that suffers him to sleep."],["12",[["Ἔστιν",10,87],["ἀῤῥωστία",2311,13],["ἣν",24,124],["εἶδον",53,147],["ὑπὸ",122,1],["τὸν",1,6],["ἥλιον",323,7],["πλοῦτον",574,7],["φυλασσόμενον",125,361],["τῷ",1,110],["παρʼ",73,1],["αὐτοῦ",3,48],["εἰς",8,1],["κακίαν",433,10],["αὐτῷ",3,49]],"There is an infirmity which I have seen under the sun, [namely], wealth kept for its owner to his hurt."],["13",[["καὶ",2,8],["ἀπολεῖται",217,89],["ὁ",1,4],["πλοῦτος",574,5],["ἐκεῖνος",80,158],["ἐν",4,1],["περισπασμῷ",3111,113],["πονηρῷ",164,111],["καὶ",2,8],["ἐγέννησεν",222,3],["υἱὸν",13,7],["καὶ",2,8],["οὐκ",12,17],["ἔστιν",10,87],["ἐν",4,1],["χειρὶ",37,2],["αὐτοῦ",3,48],["οὐδέν",228,29]],"And that wealth shall perish in an evil trouble: and [the man] begets a son, and there is nothing in his hand."],["14",[["Καθὼς",221,17],["ἐξῆλθεν",82,3],["ἀπὸ",17,1],["γαστρὸς",777,19],["μητρὸς",189,19],["αὐτοῦ",3,48],["γυμνὸς",1299,16],["ἐπιστρέψει",117,120],["τοῦ",1,30],["πορευθῆναι",49,175],["ὡς",36,8],["ἥκει",260,87],["καὶ",2,8],["οὐδὲν",228,29],["οὐ",12,17],["λήψεται",46,89],["ἐν",4,1],["μόχθῳ",1144,113],["αὐτοῦ",3,48],["ἵνα",102,8],["πορευθῇ",49,333],["ἐν",4,1],["χειρὶ",37,2],["αὐτοῦ",3,48]],"As he came forth naked from his mother's womb, he shall return back as he came, and he shall receive nothing for his labour, that it should go [with him] in his hand."],["15",[["Καί",2,8],["γε",353,12],["τοῦτο",16,122],["πονηρὰ",164,15],["ἀῤῥωστία",2311,13],["ὥσπερ",226,17],["γὰρ",40,12],["παρεγένετο",377,26],["οὕτως",71,17],["καὶ",2,8],["ἀπελεύσεται",297,89],["καὶ",2,8],["τίς",39,368],["ἡ",1,11],["περίσσεια",2478,147],["αὐτοῦ",3,48],["ᾗ",24,102],["μοχθεῖ",2178,87],["εἰς",8,1],["ἄνεμον",850,7]],"And this is also an evil infirmity: for as he came, so also shall he return: and what is his gain, for which he vainly labours?"],["16",[["Καί",2,8],["γε",353,12],["πᾶσαι",11,187],["αἱ",1,185],["ἡμέραι",28,2],["αὐτοῦ",3,48],["ἐν",4,1],["σκότει",506,53],["καὶ",2,8],["ἐν",4,1],["πένθει",736,239],["καὶ",2,8],["θυμῷ",178,113],["πολλῷ",74,111],["καὶ",2,8],["ἀῤῥωστίᾳ",2311,180],["καὶ",2,8],["χόλῳ",5148,113]],"Yea, all his days are in darkness, and in mourning, and much sorrow, and infirmity, and wrath."],["17",[["Ἰδοὺ",51,17],["εἶδον",53,147],["ἐγὼ",6,158],["ἀγαθὸν",114,29],["ὅ",1,4],["ἐστι",10,87],["καλὸν",266,28],["τοῦ",1,30],["φαγεῖν",269,100],["καὶ",2,8],["τοῦ",1,30],["πιεῖν",212,100],["καὶ",2,8],["τοῦ",1,30],["ἰδεῖν",53,100],["ἀγαθωσύνην",2300,10],["ἐν",4,1],["παντὶ",11,111],["μόχθῳ",1144,113],["αὐτοῦ",3,48],["ᾧ",24,202],["ἐὰν",45,8],["μοχθῇ",2178,166],["ὑπὸ",122,1],["τὸν",1,6],["ἥλιον",323,7],["ἀριθμὸν",355,7],["ἡμερῶν",28,61],["ζωῆς",216,19],["αὐτοῦ",3,48],["ὧν",24,97],["ἔδωκεν",33,3],["αὐτῷ",3,49],["ὁ",1,4],["Θεὸς",20,5],["ὅτι",19,8],["αὐτὸ",3,121],["μερὶς",399,13],["αὐτοῦ",3,48]],"Behold, I have seen good, that it is a fine thing [for a man] to eat and to drink, and to see good in all his labour in which he may labour under the sun, [all] the number of the days of his life which God has given to him: for it is his portion."],["18",[["Καί",2,8],["γε",353,12],["πᾶς",11,16],["ἄνθρωπος",43,5],["ᾧ",24,202],["ἔδωκεν",33,3],["αὐτῷ",3,49],["ὁ",1,4],["Θεὸς",20,5],["πλοῦτον",574,7],["καὶ",2,8],["ὑπάρχοντα",418,178],["καὶ",2,8],["ἐξουσίασεν",2224,3],["αὐτῷ",3,49],["φαγεῖν",269,100],["ἀπʼ",17,1],["αὐτοῦ",3,48],["καὶ",2,8],["λαβεῖν",46,100],["τὸ",1,32],["μέρος",471,33],["αὐτοῦ",3,48],["καὶ",2,8],["τοῦ",1,30],["εὐφρανθῆναι",244,175],["ἐν",4,1],["μόχθῳ",1144,113],["αὐτοῦ",3,48],["τοῦτο",16,122],["δόμα",961,33],["Θεοῦ",20,21],["ἐστιν",10,87]],"Yea, and [as for] every man to whom God has given wealth and possessions, and has given him power to eat thereof, and to receive his portion, and to rejoice in his labour; this is the gift of God."],["19",[["Ὅτι",19,8],["οὐ",12,17],["πολλὰ",74,65],["μνησθήσεται",230,125],["τὰς",1,39],["ἡμέρας",28,19],["τῆς",1,18],["ζωῆς",216,19],["αὐτοῦ",3,48],["ὅτι",19,8],["ὁ",1,4],["Θεὸς",20,5],["περισπᾷ",3614,173],["αὐτὸν",3,82],["ἐν",4,1],["εὐφροσύνῃ",360,2],["καρδίας",64,19],["αὐτοῦ",3,48]],"For he shall not much remember the days of his life; for God troubles him in the mirth of his heart."]]