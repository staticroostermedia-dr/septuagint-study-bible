[["1",[["Καὶ",2,8],["ἐπέστρεψα",117,147],["ἐγὼ",6,158],["καὶ",2,8],["εἶδον",53,147],["συμπάσας",1357,109],["τὰς",1,39],["συκοφαντίας",3961,40],["τὰς",1,39],["γενομένας",30,518],["ὑπὸ",122,1],["τὸν",1,6],["ἥλιον",323,7],["καὶ",2,8],["ἰδοὺ",51,17],["δάκρυον",1268,33],["τῶν",1,76],["συκοφαντουμένων",2959,295],["καὶ",2,8],["οὐκ",12,17],["ἔστιν",10,87],["αὐτοῖς",3,142],["παρακαλῶν",434,67],["καὶ",2,8],["ἀπὸ",17,1],["χειρὸς",37,19],["συκοφαντούντων",2959,164],["αὐτοῖς",3,142],["ἰσχὺς",181,13],["καὶ",2,8],["οὐκ",12,17],["ἔστιν",10,87],["αὐτοῖς",3,142],["παρακαλῶν",434,67]],"So I returned, and saw all the oppressions that were done under the sun: and behold the tear of the oppressed, and they had no comforter; and on the side of them that oppressed them was power; but they had no comforter:"],["2",[["Καὶ",2,8],["ἐπῄνεσα",1534,147],["ἐγὼ",6,158],["σύμπαντας",1357,58],["τοὺς",1,56],["τεθνηκότας",588,276],["τοὺς",1,56],["ἤδη",916,17],["ἀποθανόντας",109,458],["ὑπὲρ",139,1],["τοὺς",1,56],["ζῶντας",107,229],["ὅσοι",103,51],["αὐτοὶ",3,195],["ζῶσιν",107,265],["ἕως",42,8],["τοῦ",1,30],["νῦν",90,17]],"and I praised all the dead that had already died more than the living, as many as are alive until now."],["3",[["Καὶ",2,8],["ἀγαθὸς",114,16],["ὑπὲρ",139,1],["τοὺς",1,56],["δύο",104,57],["τούτους",16,274],["ὅστις",457,246],["οὔπω",3100,17],["ἐγένετο",30,26],["ὃς",24,246],["οὐκ",12,17],["εἶδε",53,3],["σὺν",310,1],["πᾶν",11,29],["τὸ",1,32],["ποίημα",1443,33],["τὸ",1,32],["πονηρὸν",164,29],["τὸ",1,32],["πεποιημένον",23,445],["ὑπὸ",122,1],["τὸν",1,6],["ἥλιον",323,7]],"Better also than both these is he who has not yet been, who has not seen all the evil work that is done under the sun."],["4",[["Καὶ",2,8],["εἶδον",53,147],["ἐγὼ",6,158],["σύμπαντα",1357,59],["τὸν",1,6],["μόχθον",1144,7],["καὶ",2,8],["σύμπασαν",1357,37],["ἀνδρίαν",5192,10],["τοῦ",1,23],["ποιήματος",1443,24],["ὅτι",19,8],["αὐτὸ",3,121],["ζῆλος",1164,5],["ἀνδρὸς",38,21],["ἀπὸ",17,1],["τοῦ",1,30],["ἑταίρου",1867,21],["αὐτοῦ",3,48],["καί",2,8],["γε",353,12],["τοῦτο",16,122],["ματαιότης",937,13],["καὶ",2,8],["προαίρεσις",2284,13],["πνεύματος",168,24]],"And I saw all labour, and all the diligent work, that this is a man's envy from his neighbour. This is also vanity and waywardness of spirit."],["5",[["Ὁ",1,4],["ἄφρων",439,16],["περιέβαλε",744,3],["τὰς",1,39],["χεῖρας",37,40],["αὐτοῦ",3,48],["καὶ",2,8],["ἔφαγε",147,3],["τὰς",1,39],["σάρκας",287,40],["αὐτοῦ",3,48]],"The fool folds his hands together, and eats his own flesh."],["6",[["Ἀγαθὸν",114,29],["πλήρωμα",2185,33],["δρακὸς",2708,19],["ἀναπαύσεως",1048,19],["ὑπὲρ",139,1],["πληρώματα",2185,43],["δύο",104,57],["δρακῶν",2708,61],["μόχθου",1144,21],["καὶ",2,8],["προαιρέσεως",2284,19],["πνεύματος",168,24]],"Better is a handful of rest than two handfuls of trouble and waywardness of spirit."],["7",[["Καὶ",2,8],["ἐπέστρεψα",117,147],["ἐγὼ",6,158],["καὶ",2,8],["εἶδον",53,147],["ματαιότητα",937,10],["ὑπὸ",122,1],["τὸν",1,6],["ἥλιον",323,7]],"So I returned, and saw vanity under the sun."],["8",[["Ἔστιν",10,87],["εἷς",58,16],["καὶ",2,8],["οὐκ",12,17],["ἔστι",10,87],["δεύτερος",271,16],["καί",2,8],["γε",353,12],["υἱὸς",13,5],["καί",2,8],["γε",353,12],["ἀδελφὸς",67,5],["οὐκ",12,17],["ἔστιν",10,87],["αὐτῷ",3,49],["καὶ",2,8],["οὐκ",12,17],["ἔστι",10,87],["περασμὸς",4972,5],["τῷ",1,110],["παντὶ",11,111],["μόχθῳ",1144,113],["αὐτοῦ",3,48],["καί",2,8],["γε",353,12],["ὀφθαλμὸς",91,5],["αὐτοῦ",3,48],["οὐκ",12,17],["ἐμπίμπλαται",427,108],["πλούτου",574,21],["καὶ",2,8],["τίνι",39,436],["ἐγὼ",6,158],["μοχθῶ",2178,149],["καὶ",2,8],["στερίσκω",8288,149],["τὴν",1,9],["ψυχήν",63,10],["μου",6,83],["ἀπὸ",17,1],["ἀγαθωσύνης",2300,19],["καί",2,8],["γε",353,12],["τοῦτο",16,122],["ματαιότης",937,13],["καὶ",2,8],["περισπασμὸς",3111,5],["πονηρός",164,16],["ἐστιν",10,87]],"There is one [alone], and there is not a second; yea, he has neither son nor brother: yet there is no end to all his labour; neither is his eye satisfied with wealth; and for whom do I labour, and deprive my soul of good? this is also vanity, and an evil trouble."],["9",[["Ἀγαθοὶ",114,130],["οἱ",1,128],["δύο",104,57],["ὑπὲρ",139,1],["τὸν",1,6],["ἕνα",58,59],["οἷς",24,292],["ἐστὶν",10,87],["αὐτοῖς",3,142],["μισθὸς",816,5],["ἀγαθὸς",114,16],["ἐν",4,1],["μόχθῳ",1144,113],["αὐτῶν",3,41]],"Two [are] better than one, [seeing] they have a good reward for their labour."],["10",[["Ὅτι",19,8],["ἐὰν",45,8],["πέσωσιν",154,224],["ὁ",1,4],["εἷς",58,16],["ἐγερεῖ",746,120],["τὸν",1,6],["μέτοχον",3093,7],["αὐτοῦ",3,48],["καὶ",2,8],["οὐαὶ",769,316],["αὐτῷ",3,49],["τῷ",1,110],["ἑνὶ",58,111],["ὅταν",319,8],["πέσῃ",154,160],["καὶ",2,8],["μὴ",25,8],["ᾖ",10,173],["δεύτερος",271,16],["ἐγεῖραι",746,100],["αὐτόν",3,82]],"For if they fall, the one will lift up his fellow: but woe to him that is alone when he falls, and there is not a second to lift him up."],["11",[["Καί",2,8],["γε",353,12],["ἐὰν",45,8],["κοιμηθῶσι",301,266],["δύο",104,57],["καὶ",2,8],["θέρμη",4674,13],["αὐτοῖς",3,142],["καὶ",2,8],["ὁ",1,4],["εἷς",58,16],["πῶς",441,12],["θερμανθῇ",2350,333]],"Also if two should lie together, they also get heat: but how shall one be warmed [alone]?"],["12",[["Καὶ",2,8],["ἐὰν",45,8],["ἐπικραταιωθῇ",9518,333],["ὁ",1,4],["εἷς",58,16],["οἱ",1,128],["δύο",104,57],["στήσονται",78,127],["κατέναντι",691,17],["αὐτοῦ",3,48],["καὶ",2,8],["τὸ",1,32],["σπαρτίον",2769,33],["τὸ",1,32],["ἔντριτον",9675,29],["οὐ",12,17],["ταχέως",1563,17],["ἀποῤῥαγήσεται",5227,125]],"And if one should prevail against [him], the two shall withstand him; and a threefold cord shall not be quickly broken."],["13",[["Ἀγαθὸς",114,16],["παῖς",127,5],["πένης",672,5],["καὶ",2,8],["σοφὸς",324,16],["ὑπὲρ",139,1],["βασιλέα",22,7],["πρεσβύτερον",1419,7],["καὶ",2,8],["ἄφρονα",439,59],["ὃς",24,246],["οὐκ",12,17],["ἔγνω",79,3],["τοῦ",1,30],["προσέχειν",558,54],["ἔτι",111,17]],"Better is a poor and wise child than an old and foolish king, who knows not how to take heed any longer."],["14",[["Ὅτι",19,8],["ἐξ",21,1],["οἴκου",34,21],["τῶν",1,76],["δεσμίων",2889,77],["ἐξελεύσεται",82,89],["τοῦ",1,30],["βασιλεῦσαι",151,100],["ὅτι",19,8],["καί",2,8],["γε",353,12],["ἐν",4,1],["βασιλείᾳ",157,2],["αὐτοῦ",3,48],["ἐγενήθη",30,38],["πένης",672,5]],"For he shall come forth out of the house of the prisoners to reign, because [he] also that was in his kingdom has become poor."],["15",[["Εἶδον",53,147],["σύμπαντας",1357,58],["τοὺς",1,56],["ζῶντας",107,229],["τοὺς",1,56],["περιπατοῦντας",1327,229],["ὑπὸ",122,1],["τὸν",1,6],["ἥλιον",323,7],["μετὰ",29,1],["τοῦ",1,30],["νεανίσκου",570,21],["τοῦ",1,30],["δευτέρου",271,153],["ὃς",24,246],["στήσεται",78,89],["ἀντʼ",158,1],["αὐτοῦ",3,48]],"I beheld all the living who were walking under the sun, with the second youth who shall stand up in each one's place."],["16",[["Οὐκ",12,17],["ἔστι",10,87],["περασμὸς",4972,5],["τῷ",1,110],["παντὶ",11,111],["λαῷ",35,113],["τοῖς",1,138],["πᾶσιν",11,215],["οἳ",1,128],["ἐγένοντο",30,184],["ἔμπροσθεν",390,17],["αὐτῶν",3,41],["καί",2,8],["γε",353,12],["οἱ",1,128],["ἔσχατοι",410,130],["οὐκ",12,17],["εὐφρανθήσονται",244,135],["ἐπʼ",9,1],["αὐτῷ",3,49],["ὅτι",19,8],["καί",2,8],["γε",353,12],["τοῦτο",16,122],["ματαιότης",937,13],["καὶ",2,8],["προαίρεσις",2284,13],["πνεύματος",168,24]],"There is no end to all the people, to all who were before them: and the last shall not rejoice in him: for this also is vanity and waywardness of spirit."],["17",[["Φύλαξον",125,198],["τὸν",1,6],["πόδα",210,7],["σου",5,146],["ἐν",4,1],["ᾧ",24,202],["ἐὰν",45,8],["πορεύῃ",49,166],["εἰς",8,1],["οἶκον",34,7],["τοῦ",1,30],["Θεοῦ",20,21],["καὶ",2,8],["ἐγγὺς",1026,17],["τοῦ",1,30],["ἀκούειν",54,54],["ὑπὲρ",139,1],["δόμα",961,20],["τῶν",1,76],["ἀφρόνων",439,409],["θυσία",156,13],["σου",5,146],["ὅτι",19,8],["οὐκ",12,17],["εἰσὶν",10,191],["εἰδότες",53,263],["τοῦ",1,30],["ποιῆσαι",23,100],["κακόν",161,29]],"Keep thy foot, whensoever thou goest to the house of God; and [when thou art] near to hear, let thy sacrifice [be] better than the gift of fools: for they know not that they are doing evil."]]