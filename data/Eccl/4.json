"καί",2,8],["γε",351,12],["τοῦτο",16,122],["ματαιότης",937,13],["καὶ",2,8],["προαίρεσις",2296,13],["πνεύματος",167,24]],"And I saw all labour, and all the diligent work, that this is a man's envy from his neighbour. This is also vanity and waywardness of spirit."],["5",[["Ὁ",1,4],["ἄφρων",438,16],["περιέβαλε",743,3],["τὰς",1,39],["χεῖρας",37,40],["αὐτοῦ",3,48],["καὶ",2,8],["ἔφαγε",153,3],["τὰς",1,39],["σάρκας",287,40],["αὐτοῦ",3,48]],"The fool folds his hands together, and eats his own flesh."],["6",[["Ἀγαθὸν",113,29],["πλήρωμα",2198,33],["δρακὸς",2714,19],["ἀναπαύσεως",1046,19],["ὑπὲρ",139,1],["πληρώματα",2198,43],["δύο",103,57],["δρακῶν",2714,61],["μόχθου",1144,21],["καὶ",2,8],["προαιρέσεως",2296,19],["πνεύματος",167,24]],"Better is a handful of rest than two handfuls of trouble and waywardness of spirit."],["7",[["Καὶ",2,8],["ἐπέστρεψα",116,147],["ἐγὼ",6,158],["καὶ",2,8],["εἶδον",73,147],["ματαιότητα",937,10],["ὑπὸ",122,1],["τὸν",1,6],["ἥλιον",320,7]],"So I returned, and saw vanity under the sun."],["8",[["Ἔστιν",10,87],["εἷς",57,16],["καὶ",2,8],["οὐκ",12,17],["ἔστι",10,87],["δεύτερος",270,16],["καί",2,8],["γε",351,12],["υἱὸς",13,5],["καί",2,8],["γε",351,12],["ἀδελφὸς",66,5],["οὐκ",12,17],["ἔστιν",10,87],["αὐτῷ",3,49],["καὶ",2,8],["οὐκ",12,17],["ἔστι",10,87],["περασμὸς",4997,5],["τῷ",1,110],["παντὶ",11,111],["μόχθῳ",1144,113],["αὐτοῦ",3,48],["καί",2,8],["γε",351,12],["ὀφθαλμὸς",91,5],["αὐτοῦ",3,48],["οὐκ",12,17],["ἐμπίμπλαται",424,108],["πλούτου",572,21],["καὶ",2,8],["τίνι",39,442],["ἐγὼ",6,158],["μοχθῶ",2190,149],["καὶ",2,8],["στερίσκω",8347,149],["τὴν",1,9],["ψυχήν",62,10],["μου",6,83],["ἀπὸ",17,1],["ἀγαθωσύνης",2314,19],["καί",2,8],["γε",351,12],["τοῦτο",16,122],["ματαιότης",937,13],["καὶ",2,8],["περισπασμὸς",3119,5],["πονηρός",164,16],["ἐστιν",10,87]],"There is one [alone], and there is not a second; yea, he has neither son nor brother: yet there is no end to all his labour; neither is his eye satisfied with wealth; and for whom do I labour, and deprive my soul of good? this is also vanity, and an evil trouble."],["9",[["Ἀγαθοὶ",113,130],["οἱ",1,128],["δύο",103,57],["ὑπὲρ",139,1],["τὸν",1,6],["ἕνα",57,59],["οἷς",24,295],["ἐστὶν",10,87],["αὐτοῖς",3,142],["μισθὸς",814,5],["ἀγαθὸς",113,16],["ἐν",4,1],["μόχθῳ",1144,113],["αὐτῶν",3,41]],"Two [are] better than one, [seeing] they have a good reward for their labour."],["10",[["Ὅτι",19,8],["ἐὰν",45,8],["πέσωσιν",154,224],["ὁ",1,4],["εἷς",57,16],["ἐγερεῖ",745,120],["τὸν",1,6],["μέτοχον",3102,7],["αὐτοῦ",3,48],["καὶ",2,8],["οὐαὶ",766,320],["αὐτῷ",3,49],["τῷ",1,110],["ἑνὶ",57,111],["ὅταν",318,8],["πέσῃ",154,160],["καὶ",2,8],["μὴ",25,8],["ᾖ",10,172],["δεύτερος",270,16],["ἐγεῖραι",745,100],["αὐτόν",3,82]],"For if they fall, the one will lift up his fellow: but woe to him that is alone when he falls, and there is not a second to lift him up."],["11",[["Καί",2,8],["γε",351,12],["ἐὰν",45,8],["κοιμηθῶσι",302,267],["δύο",103,57],["καὶ",2,8],["θέρμη",4699,13],["αὐτοῖς",3,142],["καὶ",2,8],["ὁ",1,4],["εἷς",57,16],["πῶς",440,12],["θερμανθῇ",2359,337]],"Also if two should lie together, they also get heat: but how shall one be warmed [alone]?"],["12",[["Καὶ",2,8],["ἐὰν",45,8],["ἐπικραταιωθῇ",9586,337],["ὁ",1,4],["εἷς",57,16],["οἱ",1,128],["δύο",103,57],["στήσονται",78,127],["κατέναντι",689,17],["αὐτοῦ",3,48],["καὶ",2,8],["τὸ",1,32],["σπαρτίον",2779,33],["τὸ",1,32],["ἔντριτον",9749,29],["οὐ",12,17],["ταχέως",1563,17],["ἀποῤῥαγήσεται",5257,125]],"And if one should prevail against [him], the two shall withstand him; and a threefold cord shall not be quickly broken."],["13",[["Ἀγαθὸς",113,16],["παῖς",126,5],["πένης",668,5],["καὶ",2,8],["σοφὸς",322,16],["ὑπὲρ",139,1],["βασιλέα",22,7],["πρεσβύτερον",1419,7],["καὶ",2,8],["ἄφρονα",438,59],["ὃς",24,247],["οὐκ",12,17],["ἔγνω",81,3],["τοῦ",1,30],["προσέχειν",557,54],["ἔτι",110,17]],"Better is a poor and wise child than an old and foolish king, who knows not how to take heed any longer."],["14",[["Ὅτι",19,8],["ἐξ",21,1],["οἴκου",34,21],["τῶν",1,76],["δεσμίων",2903,77],["ἐξελεύσεται",84,89],["τοῦ",1,30],["βασιλεῦσαι",151,100],["ὅτι",19,8],["καί",2,8],["γε",351,12],["ἐν",4,1],["βασιλείᾳ",157,2],["αὐτοῦ",3,48],["ἐγενήθη",30,38],["πένης",668,5]],"For he shall come forth out of the house of the prisoners to reign, because [he] also that was in his kingdom has become poor."],["15",[["Εἶδον",73,147],["σύμπαντας",1355,58],["τοὺς",1,56],["ζῶντας",117,229],["τοὺς",1,56],["περιπατοῦντας",1327,229],["ὑπὸ",122,1],["τὸν",1,6],["ἥλιον",320,7],["μετὰ",29,1],["τοῦ",1,30],["νεανίσκου",568,21],["τοῦ",1,30],["δευτέρου",270,153],["ὃς",24,247],["στήσεται",78,89],["ἀντʼ",158,1],["αὐτοῦ",3,48]],"I beheld all the living who were walking under the sun, with the second youth who shall stand up in each one's place."],["16",[["Οὐκ",12,17],["ἔστι",10,87],["περασμὸς",4997,5],["τῷ",1,110],["παντὶ",11,111],["λαῷ",35,113],["τοῖς",1,138],["πᾶσιν",11,215],["οἳ",1,128],["ἐγένοντο",30,182],["ἔμπροσθεν",387,17],["αὐτῶν",3,41],["καί",2,8],["γε",351,12],["οἱ",1,128],["ἔσχατοι",407,130],["οὐκ",12,17],["εὐφρανθήσονται",242,135],["ἐπʼ",9,1],["αὐτῷ",3,49],["ὅτι",19,8],["καί",2,8],["γε",351,12],["τοῦτο",16,122],["ματαιότης",937,13],["καὶ",2,8],["προαίρεσις",2296,13],["πνεύματος",167,24]],"There is no end to all the people, to all who were before them: and the last shall not rejoice in him: for this also is vanity and waywardness of spirit."],["17",[["Φύλαξον",127,198],["τὸν",1,6],["πόδα",208,7],["σου",5,146],["ἐν",4,1],["ᾧ",24,202],["ἐὰν",45,8],["πορεύῃ",49,166],["εἰς",8,1],["οἶκον",34,7],["τοῦ",1,30],["Θεοῦ",20,21],["καὶ",2,8],["ἐγγὺς",1022,17],["τοῦ",1,30],["ἀκούειν",53,54],["ὑπὲρ",139,1],["δόμα",963,20],["τῶν",1,76],["ἀφρόνων",438,416],["θυσία",156,13],["σου",5,146],["ὅτι",19,8],["οὐκ",12,17],["εἰσὶν",10,189],["εἰδότες",73,264],["τοῦ",1,30],["ποιῆσαι",23,100],["κακόν",161,29]],"Keep thy foot, whensoever thou goest to the house of God; and [when thou art] near to hear, let thy sacrifice [be] better than the gift of fools: for they know not that they are doing