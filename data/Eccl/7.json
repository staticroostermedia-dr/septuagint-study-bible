[["1",[["Ἀγαθὸν",113,29],["ὄνομα",55,33],["ὑπὲρ",139,1],["ἔλαιον",312,33],["ἀγαθὸν",113,29],["καὶ",2,8],["ἡμέρα",28,13],["τοῦ",1,30],["θανάτου",169,21],["ὑπὲρ",139,1],["ἡμέραν",28,10],["γεννήσεως",6969,19]],"A good name is better than good oil; and the day of death than the day of birth."],["2",[["Ἀγαθὸν",113,29],["πορευθῆναι",49,174],["εἰς",8,1],["οἶκον",34,7],["πένθους",1004,24],["ἢ",60,8],["ὅτι",19,8],["πορευθῆναι",49,174],["εἰς",8,1],["οἶκον",34,7],["πότου",1353,21],["καθότι",827,17],["τοῦτο",16,122],["τέλος",369,33],["παντὸς",11,153],["ἀνθρώπου",43,21],["καὶ",2,8],["ὁ",1,4],["ζῶν",117,67],["δώσει",33,120],["ἀγαθὸν",113,29],["εἰς",8,1],["καρδίαν",63,10],["αὐτοῦ",3,48]],"[It is] better to go to the house of mourning, than to go to the banquet house: since this is the end of every man; and the living man will apply good [warning] to his heart."],["3",[["Ἀγαθὸν",113,29],["θυμὸς",177,5],["ὑπὲρ",139,1],["γέλωτα",1885,7],["ὅτι",19,8],["ἐν",4,1],["κακίᾳ",431,2],["προσώπου",47,24],["ἀγαθυνθήσεται",1699,125],["καρδία",63,13]],"Sorrow is better than laughter: for by the sadness of the countenance the heart will be made better."],["4",[["Καρδία",63,13],["σοφῶν",322,163],["ἐν",4,1],["οἴκῳ",34,113],["πένθους",1004,24],["καὶ",2,8],["καρδία",63,13],["ἀφρόνων",438,416],["ἐν",4,1],["οἴκῳ",34,113],["εὐφροσύνης",360,19]],"The heart of the wise is in the house of mourning; but the heart of fools is in the house of mirth."],["5",[["Ἀγαθὸν",113,29],["τὸ",1,32],["ἀκοῦσαι",53,100],["ἐπιτίμησιν",2331,87],["σοφοῦ",322,153],["ὑπὲρ",139,1],["ἄνδρα",38,7],["ἁκούοντα",53,177],["ᾆσμα",2254,20],["ἀφρόνων",438,416]],"[It is] better to hear a reproof of a wise man, than for a man to hear the song of fools."],["6",[["Ὡς",36,8],["φωνὴ",95,13],["ἀκανθῶν",1572,61],["ὑπὸ",122,1],["τὸν",1,6],["λέβητα",1343,7],["οὕτως",70,17],["γέλως",1885,5],["τῶν",1,76],["ἀφρόνων",438,416],["καί",2,8],["γε",351,12],["τοῦτο",16,122],["ματαιότης",937,13]],"As the sound of thorns under a caldron, so is the laughter of fools: this is also vanity."],["7",[["Ὅτι",19,8],["ἡ",1,11],["συκοφαντία",3970,13],["περιφέρει",5007,87],["σοφὸν",322,28],["καὶ",2,8],["ἀπόλλυσι",213,87],["τὴν",1,9],["καρδίαν",63,10],["εὐγενείας",4237,40],["αὐτοῦ",3,48]],"For oppression makes a wise man mad, and destroys his noble heart."],["8",[["Ἀγαθὴ",113,15],["ἐσχάτη",407,15],["λόγων",48,77],["ὑπὲρ",139,1],["ἀρχὴν",269,10],["αὐτοῦ",3,48],["ἀγαθὸν",113,29],["μακρόθυμος",1770,16],["ὑπὲρ",139,1],["ὑψηλὸν",289,29],["πνεύματι",167,53]],"The end of a matter is better than the beginning thereof: the patient is better than the high-minded."],["9",[["Μὴ",25,8],["σπεύσῃς",847,170],["ἐν",4,1],["πνεύματί",167,53],["σου",5,146],["τοῦ",1,30],["θυμοῦσθαι",872,104],["ὅτι",19,8],["θυμὸς",177,5],["ἐν",4,1],["κόλπῳ",1140,113],["ἀφρόνων",438,416],["ἀναπαύσεται",670,89]],"Be not hasty in thy spirit to be angry: for anger will rest in the bosom of fools."],["10",[["Μὴ",25,8],["εἴπῃς",18,170],["τί",39,119],["ἐγένετο",30,26],["ὅτι",19,8],["αἱ",1,183],["ἡμέραι",28,2],["αἱ",1,183],["πρότεραι",495,185],["ἦσαν",10,129],["ἀγαθαὶ",113,185],["ὑπὲρ",139,1],["ταύτας",16,281],["ὅτι",19,8],["οὐκ",12,17],["ἐν",4,1],["σοφίᾳ",238,2],["ἐπηρώτησας",738,154],["περὶ",71,1],["τούτου",16,126]],"Say not, What has happened, that the former days were better than these? for thou dost not enquire in wisdom concerning this."],["11",[["Ἀγαθὴ",113,15],["σοφία",238,13],["μετὰ",29,1],["κληρονομίας",297,19],["καὶ",2,8],["περίσσεια",2485,147],["τοῖς",1,138],["θεωροῦσι",898,357],["τὸν",1,6],["ἥλιον",320,7]],"Wisdom is good with an inheritance: and [there is] an advantage [by it] to them that see the sun."],["12",[["Ὅτι",19,8],["ἐν",4,1],["σκιᾷ",978,2],["αὐτῆς",3,83],["ἡ",1,11],["σοφία",238,13],["ὡς",36,8],["σκιὰ",978,13],["ἀργυρίου",150,24],["καὶ",2,8],["περίσσεια",2485,147],["γνώσεως",753,19],["τῆς",1,18],["σοφίας",238,19],["ζωοποιήσει",3536,120],["τὸν",1,6],["παρʼ",72,1],["αὐτῆς",3,83]],"For wisdom in its shadow is as the shadow of silver: and the excellence of the knowledge of wisdom will give life to him that has it."],["13",[["Ἴδε",693,17],["τὰ",1,42],["ποιήματα",1444,43],["τοῦ",1,30],["Θεοῦ",20,21],["ὅτι",19,8],["τίς",39,150],["δυνήσεται",184,89],["κοσμῆσαι",1767,100],["ὃν",24,106],["ἂν",82,12],["ὁ",1,4],["Θεὸς",20,5],["διαστρέψῃ",1322,116],["αὐτόν",3,82]],"Behold the works of God: for who shall be able to straighten him whom God has made crooked?"],["14",[["Ἐν",4,1],["ἡμέρᾳ",28,2],["ἀγαθωσύνης",2314,19],["ζῆθι",0,0],["ἐν",4,1],["ἀγαθῷ",113,34],["καὶ",2,8],["ἴδε",693,17],["ἐν",4,1],["ἡμέρᾳ",28,2],["κακίας",431,19],["ἴδε",693,17],["καί",2,8],["γε",351,12],["σὺν",309,1],["τούτῳ",16,280],["συμφώνως",4445,17],["τοῦτο",16,122],["ἐποίησεν",23,3],["ὁ",1,4],["Θεὸς",20,5],["περὶ",71,1],["λαλιᾶς",1826,19],["ἵνα",101,8],["μὴ",25,8],["εὕρῃ",106,160],["ἄνθρωπος",43,5],["ὀπίσω",166,17],["αὐτοῦ",3,48],["οὐδέν",225,29]],"In the day of prosperity live joyfully, and consider in the day of adversity: consider, [I say], God also has caused the one to agree with the other for [this] reason, that man should find nothing after him."],["15",[["Σύμπαντα",1355,74],["εἶδον",73,147],["ἐν",4,1],["ἡμέραις",28,71],["ματαιότητός",937,19],["μου",6,83],["ἐστὶ",10,87],["δίκαιος",152,16],["ἀπολλύμενος",213,114],["ἐν",4,1],["δικαίῳ",152,111],["αὐτοῦ",3,48],["καί",2,8],["ἐστιν",10,87],["ἀσεβὴς",246,16],["μένων",678,67],["ἐν",4,1],["κακίᾳ",431,2],["αὐτοῦ",3,48]],"I have seen all things in the days of my vanity: there is a just man perishing in his justice, and there is an ungodly man remaining in his wickedness."],["16",[["Μὴ",25,8],["γίνου",30,250],["δίκαιος",152,16],["πολὺ",74,29],["μηδὲ",412,12],["σοφίζου",1785,250],["περισσὰ",1636,74],["μή",25,8],["ποτε",455,12],["ἐκπλαγῇς",4083,279]],"Be not very just; neither be very wise: lest thou be confounded."],["17",[["Μὴ",25,8],["ἀσεβήσῃς",1313,170],["πολὺ",74,29],["καὶ",2,8],["μὴ",25,8],["γίνου",30,250],["σκληρὸς",833,16],["ἵνα",101,8],["μὴ",25,8],["ἀποθάνῃς",108,170],["ἐν",4,1],["οὐ",12,17],["καιρῷ",132,113],["σου",5,146]],"Be not very wicked; and be not stubborn: lest thou shouldest die before thy time."],["18",[["Ἀγαθὸν",113,29],["τὸ",1,32],["ἀντέχεσθαί",1851,104],["σε",5,161],["ἐν",4,1],["τούτῳ",16,280],["καί",2,8],["γε",351,12],["ἀπὸ",17,1],["τούτου",16,126],["μὴ",25,8],["μιάνῃς",466,170],["τὴν",1,9],["χεῖρά",37,10],["σου",5,146],["ὅτι",19,8],["φοβουμένοις",134,346],["τὸν",1,6],["Θεὸν",20,7],["ἐξελεύσεται",84,89],["τὰ",1,42],["πάντα",11,65]],"It is well for thee to hold fast by this; also by this defile not thine hand: for to them that fear God all things shall come forth [well]."],["19",[["Ἡ",1,11],["σοφία",238,13],["βοηθήσει",364,379],["τῷ",1,110],["σοφῷ",322,111],["ὑπὲρ",139,1],["δέκα",310,57],["ἐξουσιάζοντας",2238,229],["τοὺς",1,56],["ὄντας",10,229],["ἐν",4,1],["τῇ",1,95],["πόλει",41,2]],"Wisdom will help the wise man more than ten mighty men which are in the city."],["20",[["Ὅτι",19,8],["ἄνθρωπος",43,5],["οὐκ",12,17],["ἔστι",10,87],["δίκαιος",152,16],["ἐν",4,1],["τῇ",1,95],["γῇ",26,2],["ὃς",24,247],["ποιήσει",23,120],["ἀγαθὸν",113,29],["καὶ",2,8],["οὐχ",12,17],["ἁμαρτήσεται",244,89]],"For there is not a righteous man in the earth, who will do good, and not sin."],["21",[["Καί",2,8],["γε",351,12],["εἰς",8,1],["πάντας",11,58],["λόγους",48,31],["οὓς",24,298],["λαλήσουσιν",50,207],["ἀσεβεῖς",246,58],["μὴ",25,8],["θῇς",109,170],["καρδίαν",63,10],["σου",5,146],["ὅπως",236,8],["μὴ",25,8],["ἀκούσῃς",53,170],["τοῦ",1,30],["δούλου",136,21],["σου",5,146],["καταρωμένου",778,425],["σε",5,161]],"Also take no heed to all the words which ungodly men shall speak; lest thou hear thy servant cursing thee."],["22",[["Ὅτι",19,8],["πλειστάκις",8040,17],["πονηρεύσεταί",1387,399],["σε",5,161],["καὶ",2,8],["καθόδους",4899,40],["πολλὰς",74,109],["κακώσει",764,120],["καρδίαν",63,10],["σου",5,146],["ὅτι",19,8],["ὡς",36,8],["καί",2,8],["γε",351,12],["σὺ",5,156],["κατηράσω",778,169],["ἑτέρους",253,58]],"For many times he shall trespass against thee, and repeatedly shall he afflict thine heart; for thus also hast thou cursed others."],["23",[["Πάντα",11,65],["ταῦτα",16,249],["ἐπείρασα",1096,147],["ἐν",4,1],["σοφίᾳ",238,2],["εἶπα",18,147],["σοφισθήσομαι",1785,175],["καὶ",2,8],["αὕτη",16,101],["ἐμακρύνθη",0,0],["ἀπʼ",17,1],["ἐμοῦ",6,48]],"All these things have I proved in wisdom: I said, I will be wise; but it was far from me."],["24",[["Μακρὰν",638,37],["ὑπὲρ",139,1],["ὃ",1,4],["ἦν",10,14],["καὶ",2,8],["βαθὺ",1882,28],["βάθος",1503,20],["τίς",39,150],["εὑρήσει",106,120],["αὐτό",3,121]],"[That which is] far beyond what was, and a great depth, who shall find it out?"],["25",[["Ἐκύκλωσα",600,147],["ἐγὼ",6,178],["καὶ",2,8],["ἡ",1,11],["καρδία",63,13],["μου",6,48],["τοῦ",1,30],["γνῶναι",81,100],["καὶ",2,8],["τοῦ",1,30],["κατασκέψασθαι",1548,394],["καὶ",2,8],["τοῦ",1,30],["ζητῆσαι",190,100],["σοφίαν",238,10],["καὶ",2,8],["ψῆφον",4015,10],["καὶ",2,8],["τοῦ",1,30],["γνῶναι",81,100],["ἀσεβοῦς",246,153],["ἀφροσύνην",1402,10],["καὶ",2,8],["ὀχληρίαν",9894,10],["καὶ",2,8],["περιφοράν",5966,10]],"I and my heart went round about to know, and to examine, and to seek wisdom, and the account [of things], and to know the folly and trouble and madness of the ungodly man."],["26",[["Καὶ",2,8],["εὑρίσκω",106,149],["ἐγὼ",6,158],["αὐτὴν",3,98],["καὶ",2,8],["ἐρῶ",1659,149],["πικρότερον",1077,59],["ὑπὲρ",139,1],["θάνατον",169,7],["σὺν",309,1],["τὴν",1,9],["γυναῖκα",58,10],["ἥτις",454,428],["ἐστι",10,87],["θήρευμα",4829,20],["καὶ",2,8],["σαγῆναι",3351,179],["καρδία",63,13],["αὐτῆς",3,83],["δεσμὸς",1032,5],["εἰς",8,1],["χεῖρας",37,40],["αὐτῆς",3,83],["ἀγαθὸς",113,16],["πρὸ",235,1],["προσώπου",47,24],["τοῦ",1,30],["Θεοῦ",20,21],["ἐξαιρεθήσεται",411,125],["ἀπʼ",17,1],["αὐτῆς",3,83],["καὶ",2,8],["ἁμαρτάνων",244,67],["συλληφθήσεται",510,125],["ἐν",4,1],["αὐτῇ",3,99]],"And I find her [to be], and I will pronounce [to be] more bitter than death the woman which is a snare, and her heart nets, [who has] a band in her hands: [he that is] good in the sight of God shall be delivered from her; but the sinner shall be caught by her."],["27",[["Ἴδε",693,17],["τοῦτο",16,122],["εὗρον",106,141],["εἶπεν",18,3],["ὁ",1,4],["Ἐκκλησιαστής",3428,5],["μία",57,15],["τῇ",1,95],["μιᾷ",57,96],["τοῦ",1,30],["εὑρεῖν",106,100],["λογισμὸν",498,7]],"Behold, this have I found, said the Preacher, [seeking] by one at a time to find out the account,"],["28",[["ὃν",24,106],["ἐπεζήτησεν",1937,3],["ἡ",1,11],["ψυχή",62,13],["μου",6,48],["καὶ",2,8],["οὐχ",12,17],["εὗρον",106,141],["καὶ",2,8],["ἄνθρωπον",43,7],["ἕνα",57,59],["ἀπὸ",17,1],["χιλίων",1485,163],["εὗρον",106,141],["καὶ",2,8],["γυναῖκα",58,10],["ἐν",4,1],["πᾶσι",11,215],["τούτοις",16,191],["οὐχ",12,17],["εὗρον",106,141]],"which my soul sought after, but I found not: for I have found one man of a thousand; but a woman in all these I have not found."],["29",[["Πλὴν",257,1],["ἴδε",693,17],["τοῦτο",16,122],["εὗρον",106,141],["ὃ",1,4],["ἐποίησεν",23,3],["ὁ",1,4],["Θεὸς",20,5],["σὺν",309,1],["τὸν",1,6],["ἄνθρωπον",43,7],["εὐθῆ",826,59],["καὶ",2,8],["αὐτοὶ",3,193],["ἐζήτησαν",190,141],["λογισμοὺς",498,31],["πολλούς",74,58],["Τίς",39,150],["οἶδε",1145,165],["σοφοὺς",322,58],["καὶ",2,8],["τίς",39,150],["οἶδε",1145,165],["λύσιν",7662,10],["ῥήματος",115,24]],"But, behold, this have I found, that God made man upright; but they have sought out many devices. Who knows the wise? and who knows the interpretation of a saying?"]]