[["1",[["Ἀγαθὸν",114,29],["ὄνομα",57,33],["ὑπὲρ",139,1],["ἔλαιον",313,33],["ἀγαθὸν",114,29],["καὶ",2,8],["ἡμέρα",28,13],["τοῦ",1,30],["θανάτου",170,21],["ὑπὲρ",139,1],["ἡμέραν",28,10],["γεννήσεως",6922,19]],"A good name is better than good oil; and the day of death than the day of birth."],["2",[["Ἀγαθὸν",114,29],["πορευθῆναι",49,175],["εἰς",8,1],["οἶκον",34,7],["πένθους",1004,24],["ἢ",61,8],["ὅτι",19,8],["πορευθῆναι",49,175],["εἰς",8,1],["οἶκον",34,7],["πότου",1356,21],["καθότι",826,17],["τοῦτο",16,122],["τέλος",373,33],["παντὸς",11,153],["ἀνθρώπου",43,21],["καὶ",2,8],["ὁ",1,4],["ζῶν",107,67],["δώσει",33,120],["ἀγαθὸν",114,29],["εἰς",8,1],["καρδίαν",64,10],["αὐτοῦ",3,48]],"[It is] better to go to the house of mourning, than to go to the banquet house: since this is the end of every man; and the living man will apply good [warning] to his heart."],["3",[["Ἀγαθὸν",114,29],["θυμὸς",178,5],["ὑπὲρ",139,1],["γέλωτα",1883,7],["ὅτι",19,8],["ἐν",4,1],["κακίᾳ",433,2],["προσώπου",47,24],["ἀγαθυνθήσεται",1694,125],["καρδία",64,13]],"Sorrow is better than laughter: for by the sadness of the countenance the heart will be made better."],["4",[["Καρδία",64,13],["σοφῶν",324,163],["ἐν",4,1],["οἴκῳ",34,113],["πένθους",1004,24],["καὶ",2,8],["καρδία",64,13],["ἀφρόνων",439,409],["ἐν",4,1],["οἴκῳ",34,113],["εὐφροσύνης",360,19]],"The heart of the wise is in the house of mourning; but the heart of fools is in the house of mirth."],["5",[["Ἀγαθὸν",114,29],["τὸ",1,32],["ἀκοῦσαι",54,100],["ἐπιτίμησιν",2318,87],["σοφοῦ",324,153],["ὑπὲρ",139,1],["ἄνδρα",38,7],["ἁκούοντα",54,178],["ᾆσμα",2239,20],["ἀφρόνων",439,409]],"[It is] better to hear a reproof of a wise man, than for a man to hear the song of fools."],["6",[["Ὡς",36,8],["φωνὴ",95,13],["ἀκανθῶν",1571,61],["ὑπὸ",122,1],["τὸν",1,6],["λέβητα",1346,7],["οὕτως",71,17],["γέλως",1883,5],["τῶν",1,76],["ἀφρόνων",439,409],["καί",2,8],["γε",353,12],["τοῦτο",16,122],["ματαιότης",937,13]],"As the sound of thorns under a caldron, so is the laughter of fools: this is also vanity."],["7",[["Ὅτι",19,8],["ἡ",1,11],["συκοφαντία",3961,13],["περιφέρει",4358,87],["σοφὸν",324,28],["καὶ",2,8],["ἀπόλλυσι",217,87],["τὴν",1,9],["καρδίαν",64,10],["εὐγενείας",4224,40],["αὐτοῦ",3,48]],"For oppression makes a wise man mad, and destroys his noble heart."],["8",[["Ἀγαθὴ",114,15],["ἐσχάτη",410,15],["λόγων",48,77],["ὑπὲρ",139,1],["ἀρχὴν",270,10],["αὐτοῦ",3,48],["ἀγαθὸν",114,29],["μακρόθυμος",1770,16],["ὑπὲρ",139,1],["ὑψηλὸν",289,29],["πνεύματι",168,53]],"The end of a matter is better than the beginning thereof: the patient is better than the high-minded."],["9",[["Μὴ",25,8],["σπεύσῃς",846,170],["ἐν",4,1],["πνεύματί",168,53],["σου",5,146],["τοῦ",1,30],["θυμοῦσθαι",871,104],["ὅτι",19,8],["θυμὸς",178,5],["ἐν",4,1],["κόλπῳ",1140,113],["ἀφρόνων",439,409],["ἀναπαύσεται",674,89]],"Be not hasty in thy spirit to be angry: for anger will rest in the bosom of fools."],["10",[["Μὴ",25,8],["εἴπῃς",18,170],["τί",39,119],["ἐγένετο",30,26],["ὅτι",19,8],["αἱ",1,185],["ἡμέραι",28,2],["αἱ",1,185],["πρότεραι",496,187],["ἦσαν",10,129],["ἀγαθαὶ",114,187],["ὑπὲρ",139,1],["ταύτας",16,280],["ὅτι",19,8],["οὐκ",12,17],["ἐν",4,1],["σοφίᾳ",242,2],["ἐπηρώτησας",739,154],["περὶ",72,1],["τούτου",16,126]],"Say not, What has happened, that the former days were better than these? for thou dost not enquire in wisdom concerning this."],["11",[["Ἀγαθὴ",114,15],["σοφία",242,13],["μετὰ",29,1],["κληρονομίας",299,19],["καὶ",2,8],["περίσσεια",2478,147],["τοῖς",1,138],["θεωροῦσι",897,352],["τὸν",1,6],["ἥλιον",323,7]],"Wisdom is good with an inheritance: and [there is] an advantage [by it] to them that see the sun."],["12",[["Ὅτι",19,8],["ἐν",4,1],["σκιᾷ",978,2],["αὐτῆς",3,83],["ἡ",1,11],["σοφία",242,13],["ὡς",36,8],["σκιὰ",978,13],["ἀργυρίου",152,24],["καὶ",2,8],["περίσσεια",2478,147],["γνώσεως",753,19],["τῆς",1,18],["σοφίας",242,19],["ζωοποιήσει",3533,120],["τὸν",1,6],["παρʼ",73,1],["αὐτῆς",3,83]],"For wisdom in its shadow is as the shadow of silver: and the excellence of the knowledge of wisdom will give life to him that has it."],["13",[["Ἴδε",713,17],["τὰ",1,42],["ποιήματα",1443,43],["τοῦ",1,30],["Θεοῦ",20,21],["ὅτι",19,8],["τίς",39,150],["δυνήσεται",185,89],["κοσμῆσαι",1680,100],["ὃν",24,106],["ἂν",83,12],["ὁ",1,4],["Θεὸς",20,5],["διαστρέψῃ",1322,116],["αὐτόν",3,82]],"Behold the works of God: for who shall be able to straighten him whom God has made crooked?"],["14",[["Ἐν",4,1],["ἡμέρᾳ",28,2],["ἀγαθωσύνης",2300,19],["ζῆθι",0,0],["ἐν",4,1],["ἀγαθῷ",114,34],["καὶ",2,8],["ἴδε",713,17],["ἐν",4,1],["ἡμέρᾳ",28,2],["κακίας",433,19],["ἴδε",713,17],["καί",2,8],["γε",353,12],["σὺν",310,1],["τούτῳ",16,279],["συμφώνως",4426,17],["τοῦτο",16,122],["ἐποίησεν",23,3],["ὁ",1,4],["Θεὸς",20,5],["περὶ",72,1],["λαλιᾶς",1824,19],["ἵνα",102,8],["μὴ",25,8],["εὕρῃ",101,160],["ἄνθρωπος",43,5],["ὀπίσω",167,17],["αὐτοῦ",3,48],["οὐδέν",228,29]],"In the day of prosperity live joyfully, and consider in the day of adversity: consider, [I say], God also has caused the one to agree with the other for [this] reason, that man should find nothing after him."],["15",[["Σύμπαντα",1357,74],["εἶδον",53,147],["ἐν",4,1],["ἡμέραις",28,71],["ματαιότητός",937,19],["μου",6,83],["ἐστὶ",10,87],["δίκαιος",153,16],["ἀπολλύμενος",217,114],["ἐν",4,1],["δικαίῳ",153,111],["αὐτοῦ",3,48],["καί",2,8],["ἐστιν",10,87],["ἀσεβὴς",247,16],["μένων",681,67],["ἐν",4,1],["κακίᾳ",433,2],["αὐτοῦ",3,48]],"I have seen all things in the days of my vanity: there is a just man perishing in his justice, and there is an ungodly man remaining in his wickedness."],["16",[["Μὴ",25,8],["γίνου",30,249],["δίκαιος",153,16],["πολὺ",74,29],["μηδὲ",414,12],["σοφίζου",1786,249],["περισσὰ",1636,74],["μή",25,8],["ποτε",458,12],["ἐκπλαγῇς",4074,278]],"Be not very just; neither be very wise: lest thou be confounded."],["17",[["Μὴ",25,8],["ἀσεβήσῃς",1256,170],["πολὺ",74,29],["καὶ",2,8],["μὴ",25,8],["γίνου",30,249],["σκληρὸς",831,16],["ἵνα",102,8],["μὴ",25,8],["ἀποθάνῃς",109,170],["ἐν",4,1],["οὐ",12,17],["καιρῷ",132,113],["σου",5,146]],"Be not very wicked; and be not stubborn: lest thou shouldest die before thy time."],["18",[["Ἀγαθὸν",114,29],["τὸ",1,32],["ἀντέχεσθαί",1852,104],["σε",5,161],["ἐν",4,1],["τούτῳ",16,279],["καί",2,8],["γε",353,12],["ἀπὸ",17,1],["τούτου",16,126],["μὴ",25,8],["μιάνῃς",468,170],["τὴν",1,9],["χεῖρά",37,10],["σου",5,146],["ὅτι",19,8],["φοβουμένοις",134,342],["τὸν",1,6],["Θεὸν",20,7],["ἐξελεύσεται",82,89],["τὰ",1,42],["πάντα",11,65]],"It is well for thee to hold fast by this; also by this defile not thine hand: for to them that fear God all things shall come forth [well]."],["19",[["Ἡ",1,11],["σοφία",242,13],["βοηθήσει",366,373],["τῷ",1,110],["σοφῷ",324,111],["ὑπὲρ",139,1],["δέκα",311,57],["ἐξουσιάζοντας",2224,229],["τοὺς",1,56],["ὄντας",10,229],["ἐν",4,1],["τῇ",1,95],["πόλει",41,2]],"Wisdom will help the wise man more than ten mighty men which are in the city."],["20",[["Ὅτι",19,8],["ἄνθρωπος",43,5],["οὐκ",12,17],["ἔστι",10,87],["δίκαιος",153,16],["ἐν",4,1],["τῇ",1,95],["γῇ",26,2],["ὃς",24,246],["ποιήσει",23,120],["ἀγαθὸν",114,29],["καὶ",2,8],["οὐχ",12,17],["ἁμαρτήσεται",237,89]],"For there is not a righteous man in the earth, who will do good, and not sin."],["21",[["Καί",2,8],["γε",353,12],["εἰς",8,1],["πάντας",11,58],["λόγους",48,31],["οὓς",24,294],["λαλήσουσιν",50,207],["ἀσεβεῖς",247,58],["μὴ",25,8],["θῇς",110,170],["καρδίαν",64,10],["σου",5,146],["ὅπως",240,8],["μὴ",25,8],["ἀκούσῃς",54,170],["τοῦ",1,30],["δούλου",136,21],["σου",5,146],["καταρωμένου",779,418],["σε",5,161]],"Also take no heed to all the words which ungodly men shall speak; lest thou hear thy servant cursing thee."],["22",[["Ὅτι",19,8],["πλειστάκις",7980,17],["πονηρεύσεταί",1331,394],["σε",5,161],["καὶ",2,8],["καθόδους",4875,40],["πολλὰς",74,109],["κακώσει",757,120],["καρδίαν",64,10],["σου",5,146],["ὅτι",19,8],["ὡς",36,8],["καί",2,8],["γε",353,12],["σὺ",5,156],["κατηράσω",779,169],["ἑτέρους",253,58]],"For many times he shall trespass against thee, and repeatedly shall he afflict thine heart; for thus also hast thou cursed others."],["23",[["Πάντα",11,65],["ταῦτα",16,248],["ἐπείρασα",1094,147],["ἐν",4,1],["σοφίᾳ",242,2],["εἶπα",18,147],["σοφισθήσομαι",1786,176],["καὶ",2,8],["αὕτη",16,101],["ἐμακρύνθη",0,0],["ἀπʼ",17,1],["ἐμοῦ",6,48]],"All these things have I proved in wisdom: I said, I will be wise; but it was far from me."],["24",[["Μακρὰν",642,37],["ὑπὲρ",139,1],["ὃ",1,4],["ἦν",10,14],["καὶ",2,8],["βαθὺ",1880,28],["βάθος",1502,20],["τίς",39,150],["εὑρήσει",101,120],["αὐτό",3,121]],"[That which is] far beyond what was, and a great depth, who shall find it out?"],["25",[["Ἐκύκλωσα",603,147],["ἐγὼ",6,179],["καὶ",2,8],["ἡ",1,11],["καρδία",64,13],["μου",6,48],["τοῦ",1,30],["γνῶναι",79,100],["καὶ",2,8],["τοῦ",1,30],["κατασκέψασθαι",1551,389],["καὶ",2,8],["τοῦ",1,30],["ζητῆσαι",191,100],["σοφίαν",242,10],["καὶ",2,8],["ψῆφον",4006,10],["καὶ",2,8],["τοῦ",1,30],["γνῶναι",79,100],["ἀσεβοῦς",247,153],["ἀφροσύνην",1401,10],["καὶ",2,8],["ὀχληρίαν",9816,10],["καὶ",2,8],["περιφοράν",5936,10]],"I and my heart went round about to know, and to examine, and to seek wisdom, and the account [of things], and to know the folly and trouble and madness of the ungodly man."],["26",[["Καὶ",2,8],["εὑρίσκω",101,149],["ἐγὼ",6,158],["αὐτὴν",3,98],["καὶ",2,8],["ἐρῶ",165,157],["πικρότερον",1076,59],["ὑπὲρ",139,1],["θάνατον",170,7],["σὺν",310,1],["τὴν",1,9],["γυναῖκα",59,10],["ἥτις",457,421],["ἐστι",10,87],["θήρευμα",4802,20],["καὶ",2,8],["σαγῆναι",3348,180],["καρδία",64,13],["αὐτῆς",3,83],["δεσμὸς",1035,5],["εἰς",8,1],["χεῖρας",37,40],["αὐτῆς",3,83],["ἀγαθὸς",114,16],["πρὸ",238,1],["προσώπου",47,24],["τοῦ",1,30],["Θεοῦ",20,21],["ἐξαιρεθήσεται",413,125],["ἀπʼ",17,1],["αὐτῆς",3,83],["καὶ",2,8],["ἁμαρτάνων",237,67],["συλληφθήσεται",507,125],["ἐν",4,1],["αὐτῇ",3,99]],"And I find her [to be], and I will pronounce [to be] more bitter than death the woman which is a snare, and her heart nets, [who has] a band in her hands: [he that is] good in the sight of God shall be delivered from her; but the sinner shall be caught by her."],["27",[["Ἴδε",713,17],["τοῦτο",16,122],["εὗρον",101,141],["εἶπεν",18,3],["ὁ",1,4],["Ἐκκλησιαστής",3423,5],["μία",58,15],["τῇ",1,95],["μιᾷ",58,96],["τοῦ",1,30],["εὑρεῖν",101,100],["λογισμὸν",500,7]],"Behold, this have I found, said the Preacher, [seeking] by one at a time to find out the account,"],["28",[["ὃν",24,106],["ἐπεζήτησεν",1936,3],["ἡ",1,11],["ψυχή",63,13],["μου",6,48],["καὶ",2,8],["οὐχ",12,17],["εὗρον",101,141],["καὶ",2,8],["ἄνθρωπον",43,7],["ἕνα",58,59],["ἀπὸ",17,1],["χιλίων",1483,163],["εὗρον",101,141],["καὶ",2,8],["γυναῖκα",59,10],["ἐν",4,1],["πᾶσι",11,215],["τούτοις",16,193],["οὐχ",12,17],["εὗρον",101,141]],"which my soul sought after, but I found not: for I have found one man of a thousand; but a woman in all these I have not found."],["29",[["Πλὴν",257,1],["ἴδε",713,17],["τοῦτο",16,122],["εὗρον",101,141],["ὃ",1,4],["ἐποίησεν",23,3],["ὁ",1,4],["Θεὸς",20,5],["σὺν",310,1],["τὸν",1,6],["ἄνθρωπον",43,7],["εὐθῆ",825,59],["καὶ",2,8],["αὐτοὶ",3,195],["ἐζήτησαν",191,141],["λογισμοὺς",500,31],["πολλούς",74,58],["Τίς",39,150],["οἶδε",1168,165],["σοφοὺς",324,58],["καὶ",2,8],["τίς",39,150],["οἶδε",1168,165],["λύσιν",7610,10],["ῥήματος",116,24]],"But, behold, this have I found, that God made man upright; but they have sought out many devices. Who knows the wise? and who knows the interpretation of a saying?"]]