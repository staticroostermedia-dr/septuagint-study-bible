[["1",[["Σοφία",242,13],["ἀνθρώπου",43,21],["φωτιεῖ",1230,120],["πρόσωπον",47,33],["αὐτοῦ",3,48],["καὶ",2,8],["ἀναιδὴς",2305,16],["προσώπῳ",47,53],["αὐτοῦ",3,48],["μισηθήσεται",351,125]],"A man's wisdom will lighten his countenance; but a man of shameless countenance will be hated."],["2",[["Στόμα",123,33],["βασιλέως",22,21],["φύλαξον",125,198],["καὶ",2,8],["περὶ",72,1],["λόγου",48,21],["ὅρκου",946,21],["Θεοῦ",20,21]],"Observe the commandment of the king, and [that] because of the word of the oath of God."],["3",[["Μὴ",25,8],["σπουδάσῃς",2490,170],["ἀπὸ",17,1],["προσώπου",47,24],["αὐτοῦ",3,144],["πορεύσῃ",49,116],["μὴ",25,8],["στῇς",78,170],["ἐν",4,1],["λόγῳ",48,113],["πονηρῷ",164,111],["ὅτι",19,8],["πᾶν",11,29],["ὃ",1,4],["ἐὰν",45,8],["θελήσῃ",612,160],["ποιήσει",23,120]],"Be not hasty; thou shalt go forth out of his presence: stand not in an evil matter; for he will do whatsoever he shall please,"],["4",[["καθὼς",221,17],["βασιλεὺς",22,5],["ἐξουσιάζων",2224,67],["καὶ",2,8],["τίς",39,150],["ἐρεῖ",165,120],["αὐτῷ",3,49],["τί",39,119],["ποιεῖς",23,145]],"even as a king having power: and who will say to him, What doest thou?"],["5",[["Ὁ",1,4],["φυλάσσων",125,67],["ἐντολὴν",259,10],["οὐ",12,17],["γνώσεται",79,89],["ῥῆμα",116,33],["πονηρὸν",164,29],["καὶ",2,8],["καιρὸν",132,7],["κρίσεως",229,19],["γινώσκει",79,87],["καρδία",64,13],["σοφοῦ",324,153]],"He that keeps the commandment shall not know an evil thing: and the heart of the wise knows the time of judgment."],["6",[["Ὅτι",19,8],["παντὶ",11,34],["πράγματί",511,53],["ἐστι",10,87],["καιρὸς",132,5],["καὶ",2,8],["κρίσις",229,13],["ὅτι",19,8],["γνῶσις",753,13],["τοῦ",1,30],["ἀνθρώπου",43,21],["πολλὴ",74,15],["ἐπʼ",9,1],["αὐτόν",3,82]],"For to every thing there is time and judgment; for the knowledge of a man is great to him."],["7",[["Ὅτι",19,8],["οὐκ",12,17],["ἔστι",10,87],["γινώσκων",79,67],["τί",39,119],["τὸ",1,32],["ἐσόμενον",10,413],["ὅτι",19,8],["καθὼς",221,17],["ἔσται",10,89],["τίς",39,150],["ἀναγγελεῖ",231,120],["αὐτῷ",3,49]],"For there is no one that knows what is going to be: for who shall tell him how it shall be?"],["8",[["Οὐκ",12,17],["ἔστιν",10,87],["ἄνθρωπος",43,5],["ἐξουσιάζων",2224,67],["ἐν",4,1],["πνεύματι",168,53],["τοῦ",1,30],["κωλύσαι",1440,216],["σὺν",310,1],["τὸ",1,32],["πνεῦμα",168,33],["καὶ",2,8],["οὐκ",12,17],["ἔστιν",10,87],["ἐξουσία",929,13],["ἐν",4,1],["ἡμέρᾳ",28,2],["θανάτου",170,21],["καὶ",2,8],["οὐκ",12,17],["ἔστιν",10,87],["ἀποστολὴ",2661,13],["ἐν",4,1],["ἡμέρᾳ",28,2],["πολέμου",163,21],["καὶ",2,8],["οὐ",12,17],["διασώσει",727,120],["ἀσέβεια",722,13],["τὸν",1,6],["παρʼ",73,1],["αὐτῆς",3,83]],"There is no man that has power over the spirit to retain the spirit; and there is no power in the day of death: and there is no discharge in the day of battle; neither shall ungodliness save her votary."],["9",[["Καὶ",2,8],["σύμπαν",1357,28],["τοῦτο",16,344],["εἶδον",53,147],["καὶ",2,8],["ἔδωκα",33,147],["τὴν",1,9],["καρδίαν",64,10],["μου",6,48],["εἰς",8,1],["πᾶν",11,29],["τὸ",1,32],["ποίημα",1443,33],["ὃ",1,4],["πεποίηται",23,182],["ὑπὸ",122,1],["τὸν",1,6],["ἥλιον",323,7],["τὰ",1,42],["ὅσα",103,43],["ἐξουσιάσατο",2224,26],["ὁ",1,4],["ἄνθρωπος",43,5],["ἐν",4,1],["ἀνθρώπῳ",43,113],["τοῦ",1,30],["κακῶσαι",757,100],["αὐτόν",3,82]],"So I saw all this, and I applied my heart to every work that has been done under the sun; all the things wherein man has power over man to afflict him."],["10",[["Καὶ",2,8],["τότε",250,17],["εἶδον",53,147],["ἀσεβεῖς",247,58],["εἰς",8,1],["τάφους",865,31],["εἰσαχθέντας",389,469],["καὶ",2,8],["ἐκ",21,1],["τοῦ",1,30],["ἁγίου",75,153],["καὶ",2,8],["ἐπορεύθησαν",49,94],["καὶ",2,8],["ἐπῃνέθησαν",1534,94],["ἐν",4,1],["τῇ",1,95],["πόλει",41,2],["ὅτι",19,8],["οὕτως",71,17],["ἐποίησαν",23,141],["καί",2,8],["γε",353,12],["τοῦτο",16,122],["ματαιότης",937,13]],"And then I saw the ungodly carried into the tombs, and [that] out of the holy place: and they departed, and were praised in the city, because they had done thus: this also is vanity."],["11",[["Ὅτι",19,8],["οὐκ",12,17],["ἔστι",10,87],["γινομένη",30,204],["ἀντίῤῥησις",8939,13],["ἀπὸ",17,1],["τῶν",1,76],["ποιούντων",23,164],["τὸ",1,32],["πονηρὸν",164,29],["ταχὺ",1389,17],["διὰ",56,1],["τοῦτο",16,122],["ἐπληροφορήθη",7986,38],["καρδία",64,13],["υἱῶν",13,77],["τοῦ",1,30],["ἀνθρώπου",43,21],["ἐν",4,1],["αὐτοῖς",3,142],["τοῦ",1,30],["ποιῆσαι",23,100],["τὸ",1,32],["πονηρόν",164,29]],"Because there is no contradiction made on the part of those who do evil quickly, therefore the heart of the children of men is fully determined in them to do evil."],["12",[["Ὃς",24,246],["ἥμαρτεν",237,3],["ἐποίησε",23,3],["τὸ",1,32],["πονηρὸν",164,29],["ἀπὸ",17,1],["τότε",250,17],["καὶ",2,8],["ἀπὸ",17,1],["μακρότητος",3081,19],["αὐτῶν",3,41],["ὅτι",19,8],["καὶ",2,8],["γινώσκω",79,149],["ἐγὼ",6,158],["ὅτι",19,8],["ἐστὶν",10,87],["ἀγαθὸν",114,29],["τοῖς",1,138],["φοβουμένοις",134,342],["τὸν",1,6],["Θεὸν",20,7],["ὅπως",240,8],["φοβῶνται",134,391],["ἀπὸ",17,1],["προσώπου",47,24],["αὐτοῦ",3,144]],"He that has sinned has done evil from that time, and long from beforehand: nevertheless I know, that it is well with them that fear God, that they may fear before him:"],["13",[["Καὶ",2,8],["ἀγαθὸν",114,29],["οὐκ",12,17],["ἔσται",10,89],["τῷ",1,110],["ἀσεβεῖ",247,111],["καὶ",2,8],["οὐ",12,17],["μακρυνεῖ",0,0],["ἡμέρας",28,19],["ἐν",4,1],["σκιᾷ",978,2],["ὃς",24,246],["οὐκ",12,17],["ἔστι",10,87],["φοβούμενος",134,114],["ἀπὸ",17,1],["προσώπου",47,24],["τοῦ",1,30],["Θεοῦ",20,21]],"but it shall not be well with the ungodly, and he shall not prolong his days, [which are] as a shadow; forasmuch as he fears not before God."],["14",[["Ἔστι",10,87],["ματαιότης",937,13],["ἣ",1,11],["πεποίηται",23,182],["ἐπὶ",9,1],["τῆς",1,18],["γῆς",26,19],["ὅτι",19,8],["εἰσὶ",10,191],["δίκαιοι",153,130],["ὅτι",19,8],["φθάνει",1566,87],["ἐπʼ",9,1],["αὐτοὺς",3,60],["ὡς",36,8],["ποίημα",1443,20],["τῶν",1,76],["ἀσεβῶν",247,163],["καί",2,8],["εἰσιν",10,191],["ἀσεβεῖς",247,130],["ὅτι",19,8],["φθάνει",1566,87],["πρὸς",15,1],["αὐτοὺς",3,60],["ὡς",36,8],["ποίημα",1443,20],["τῶν",1,76],["δικαίων",153,163],["εἶπα",18,147],["ὅτι",19,8],["καί",2,8],["γε",353,12],["τοῦτο",16,122],["ματαιότης",937,13]],"There is a vanity which is done upon the earth; that there are righteous persons to whom it happens according to the doing of the ungodly; and there are ungodly men, to whom it happens according to the doing of the just: I said, This is also vanity."],["15",[["Καὶ",2,8],["ἐπῄνεσα",1534,147],["ἐγὼ",6,158],["σὺν",310,1],["τὴν",1,9],["εὐφροσύνην",360,10],["ὅτι",19,8],["οὐκ",12,17],["ἔστιν",10,87],["ἀγαθὸν",114,29],["τῷ",1,110],["ἀνθρώπῳ",43,113],["ὑπὸ",122,1],["τὸν",1,6],["ἥλιον",323,7],["ὅτι",19,8],["εἰ",77,8],["μὴ",25,8],["φαγεῖν",269,100],["καὶ",2,8],["τοῦ",1,30],["πιεῖν",212,100],["καὶ",2,8],["τοῦ",1,30],["εὐφρανθῆναι",244,175],["καὶ",2,8],["αὐτὸ",3,121],["συμπροσέσται",6100,89],["αὐτῷ",3,49],["ἐν",4,1],["μόχθῳ",1144,113],["αὐτοῦ",3,48],["ἡμέρας",28,19],["ζωῆς",216,19],["αὐτοῦ",3,48],["ὅσας",103,40],["ἔδωκεν",33,3],["αὐτῷ",3,49],["ὁ",1,4],["Θεὸς",20,5],["ὑπὸ",122,1],["τὸν",1,6],["ἥλιον",323,7]],"Then I praised mirth, because there is no good for a man under the sun, but to eat, and drink, and be merry: and this shall attend him in his labour all the days of his life, which God has given him under the sun."],["16",[["Ἐν",4,1],["οἷς",24,292],["ἔδωκα",33,147],["τὴν",1,9],["καρδίαν",64,10],["μου",6,48],["τοῦ",1,30],["γνῶναι",79,100],["τὴν",1,9],["σοφίαν",242,10],["καὶ",2,8],["τοῦ",1,30],["ἰδεῖν",53,100],["τὸν",1,6],["περισπασμὸν",3111,7],["τὸν",1,6],["πεποιημένον",23,442],["ἐπὶ",9,1],["τῆς",1,18],["γῆς",26,19],["ὅτι",19,8],["καὶ",2,8],["ἐν",4,1],["ἡμέρᾳ",28,2],["καὶ",2,8],["ἐν",4,1],["νυκτὶ",219,2],["ὕπνον",1010,7],["ὀφθαλμοῖς",91,139],["αὐτοῦ",3,48],["οὐκ",12,17],["ἔστι",10,87],["βλέπων",470,67]],"Whereupon I set my heart to know wisdom, and to perceive the trouble that was wrought upon the earth: for there is that neither by day nor night sees sleep with his eyes."],["17",[["Καὶ",2,8],["εἶδον",53,147],["σύμπαντα",1357,74],["τὰ",1,253],["ποιήματα",1443,63],["τοῦ",1,30],["Θεοῦ",20,21],["ὅτι",19,8],["οὐ",12,17],["δυνήσεται",185,89],["ἄνθρωπος",43,5],["τοῦ",1,30],["εὑρεῖν",101,100],["σὺν",310,1],["τὸ",1,32],["ποίημα",1443,33],["τὸ",1,32],["πεποιημένον",23,445],["ὑπὸ",122,1],["τὸν",1,6],["ἥλιον",323,7],["ὅσα",103,63],["ἂν",83,12],["μοχθήσῃ",2178,116],["ἄνθρωπος",43,5],["τοῦ",1,30],["ζητῆσαι",191,100],["καὶ",2,8],["οὐχ",12,17],["εὑρήσει",101,120],["καί",2,8],["γε",353,12],["ὅσα",103,63],["ἂν",83,12],["εἴπῃ",18,160],["σοφὸς",324,16],["τοῦ",1,30],["γνῶναι",79,100],["οὐ",12,17],["δυνήσεται",185,89],["τοῦ",1,30],["εὑρεῖν",101,100],["ὅτι",19,8],["σύμπαν",1357,28],["τοῦτο",16,344],["ἔδωκα",33,147],["εἰς",8,1],["καρδίαν",64,10],["μου",6,48],["καὶ",2,8],["καρδία",64,13],["μου",6,48],["σύμπαν",1357,28],["εἶδε",53,3],["τοῦτο",16,344]],"And I beheld all the works of God, that a man shall not be able to discover the work which is wrought under the sun; whatsoever things a man shall endeavour to seek, however a man may labour to seek it, yet he shall not find it; yea, how much soever a wise man may speak of knowing it, he shall not be able to find it: for I applied all this to my heart, and my heart has seen all this."]]