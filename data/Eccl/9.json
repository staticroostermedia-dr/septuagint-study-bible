[["1",[["Ὡς",36,8],["οἱ",1,128],["δίκαιοι",153,130],["καὶ",2,8],["οἱ",1,128],["σοφοὶ",324,130],["καὶ",2,8],["αἱ",1,185],["ἐργασίαι",1070,180],["αὐτῶν",3,41],["ἐν",4,1],["χειρὶ",37,2],["τοῦ",1,30],["Θεοῦ",20,21],["καί",2,8],["γε",353,12],["ἀγάπην",1982,10],["καί",2,8],["γε",353,12],["μῖσος",2604,20],["οὐκ",12,17],["ἔστιν",10,87],["εἰδὼς",53,264],["ὁ",1,4],["ἄνθρωπος",43,5],["τὰ",1,42],["πάντα",11,65],["πρὸ",238,1],["προσώπου",47,24],["αὐτῶν",3,41]],"[I saw] that the righteous, and the wise, and their works, are in the hand of God: yea, there is no man that knows either love or hatred, [though] all are before their face."],["2",[["Ματαιότης",937,13],["ἐν",4,1],["τοῖς",1,138],["πᾶσι",11,215],["συνάντημα",2963,20],["ἓν",58,28],["τῷ",1,110],["δικαίῳ",153,111],["καὶ",2,8],["τῷ",1,110],["ἀσεβεῖ",247,111],["τῷ",1,110],["ἀγαθῷ",114,111],["καὶ",2,8],["τῷ",1,110],["κακῷ",161,111],["καὶ",2,8],["τῷ",1,110],["καθαρῷ",379,111],["καὶ",2,8],["τῷ",1,110],["ἀκαθάρτῳ",374,111],["καὶ",2,8],["τῷ",1,110],["θυσιάζοντι",1138,390],["καὶ",2,8],["τῷ",1,110],["μὴ",25,8],["θυσιάζοντι",1138,390],["ὡς",36,8],["ὁ",1,4],["ἀγαθὸς",114,16],["ὡς",36,8],["ὁ",1,4],["ἁμαρτάνων",237,67],["ὡς",36,8],["ὁ",1,4],["ὀμνύων",347,67],["καθὼς",221,17],["ὁ",1,4],["τὸν",1,6],["ὅρκον",946,7],["φοβούμενος",134,114]],"Vanity is in all: there is one event to the righteous, and to the wicked; to the good, and to the bad; both to the pure, and to the impure; both to him that sacrifices, and to him that sacrifices not: as is the good, so is the sinner: as is the swearer, even so is he that fears an oath."],["3",[["Τοῦτο",16,122],["πονηρὸν",164,29],["ἐν",4,1],["παντὶ",11,111],["πεποιημένῳ",23,459],["ὑπὸ",122,1],["τὸν",1,6],["ἥλιον",323,7],["ὅτι",19,8],["συνάντημα",2963,20],["ἓν",58,28],["τοῖς",1,138],["πᾶσι",11,215],["καί",2,8],["γε",353,12],["καρδια",7284,63],["υἱῶν",13,77],["τοῦ",1,30],["ἀνθρώπου",43,21],["ἐπληρώθη",518,38],["πονηροῦ",164,153],["καὶ",2,8],["περιφέρεια",5937,13],["ἐν",4,1],["καρδίᾳ",64,2],["αὐτῶν",3,41],["ἐν",4,1],["ζωῇ",216,2],["αὐτῶν",3,41],["καὶ",2,8],["ὀπίσω",167,17],["αὐτῶν",3,41],["πρὸς",15,1],["τοὺς",1,56],["νεκρούς",659,58]],"There is this evil in all that is done under the sun, that there is one event to all: yea, the heart of the sons of men is filled with evil, and madness is in their heart during their life, and after that [they go] to the dead."],["4",[["Ὅτι",19,8],["τίς",39,150],["ὃς",24,246],["κοινωνεῖ",2089,87],["πρὸς",15,1],["πάντας",11,58],["τοὺς",1,56],["ζῶντας",107,229],["ἔστιν",10,87],["ἐλπὶς",530,13],["ὅτι",19,8],["ὁ",1,4],["κύων",1204,5],["ὁ",1,4],["ζῶν",107,67],["αὐτὸς",3,158],["ἀγαθὸς",114,16],["ὑπὲρ",139,1],["τὸν",1,6],["λέοντα",424,7],["τὸν",1,6],["νεκρόν",659,59]],"For who is he that has fellowship with all the living? there is hope [of him]: for a living dog is better than a dead lion."],["5",[["Ὅτι",19,8],["οἱ",1,128],["ζῶντες",107,137],["γνώσονται",79,127],["ὅτι",19,8],["ἀποθανοῦνται",109,127],["καὶ",2,8],["οἱ",1,128],["νεκροὶ",659,130],["οὐκ",12,17],["εἰσὶ",10,191],["γινώσκοντες",79,137],["οὐδέν",228,29],["καὶ",2,8],["οὐκ",12,17],["ἔστιν",10,87],["αὐτοῖς",3,142],["ἔτι",111,17],["μισθὸς",816,5],["ὅτι",19,8],["ἐπελήσθη",513,38],["ἡ",1,11],["μνήμη",2177,13],["αὐτῶν",3,41]],"For the living will know that they shall die: but the dead know nothing, and there is no longer any reward to them; for their memory is lost."],["6",[["Καί",2,8],["γε",353,12],["ἀγάπη",1982,13],["αὐτῶν",3,41],["καί",2,8],["γε",353,12],["μῖσος",2604,20],["αὐτῶν",3,41],["καί",2,8],["γε",353,12],["ζῆλος",1164,5],["αὐτῶν",3,41],["ἤδη",916,17],["ἀπώλετο",217,26],["καί",2,8],["γε",353,12],["μερὶς",399,13],["οὐκ",12,17],["ἔστιν",10,87],["αὐτοῖς",3,142],["ἔτι",111,17],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["ἐν",4,1],["παντὶ",11,111],["τῷ",1,110],["πεποιημένῳ",23,459],["ὑπὸ",122,1],["τὸν",1,6],["ἥλιον",323,7]],"Also their love, and their hatred, and their envy, have now perished; yea, there is no portion for them any more for ever in all that is done under the sun."],["7",[["Δεῦρο",715,17],["φάγε",147,198],["ἐν",4,1],["εὐφροσύνῃ",360,2],["τὸν",1,6],["ἄρτον",197,7],["σου",5,146],["καὶ",2,8],["πίε",212,198],["ἐν",4,1],["καρδίᾳ",64,2],["ἀγαθῇ",114,96],["οἶνόν",261,7],["σου",5,146],["ὅτι",19,8],["ἤδη",916,17],["εὐδόκησεν",906,3],["ὁ",1,4],["Θεὸς",20,5],["τὰ",1,42],["ποιήματά",1443,43],["σου",5,146]],"Go, eat thy bread with mirth, and drink thy wine with a joyful heart; for now God has favourably accepted thy works."],["8",[["Ἐν",4,1],["παντὶ",11,111],["καιρῷ",132,113],["ἔστωσαν",10,55],["ἱμάτιά",276,43],["σου",5,146],["λευκὰ",1184,65],["καὶ",2,8],["ἔλαιον",313,33],["ἐπὶ",9,1],["κεφαλῆς",144,19],["σου",5,146],["μὴ",25,8],["ὑστερησάτω",1947,46]],"Let thy garments be always white; and let not oil be wanting on thine head."],["9",[["Καὶ",2,8],["ἴδε",713,17],["ζωὴν",216,10],["μετὰ",29,1],["γυναικὸς",59,19],["ἧς",24,162],["ἠγάπησας",214,154],["πάσας",11,109],["τὰς",1,39],["ἡμέρας",28,19],["ζωῆς",216,19],["ματαιότητός",937,19],["σου",5,146],["τὰς",1,39],["δοθείσας",33,551],["σοι",5,151],["ὑπὸ",122,1],["τὸν",1,6],["ἥλιον",323,7],["ὅτι",19,8],["αὐτὸ",3,121],["μερίς",399,13],["σου",5,146],["ἐν",4,1],["τῇ",1,95],["ζωῇ",216,2],["σου",5,146],["καὶ",2,8],["ἐν",4,1],["τῷ",1,110],["μόχθῳ",1144,113],["σου",5,146],["ᾧ",24,202],["σὺ",5,156],["μοχθεῖς",2178,145],["ὑπὸ",122,1],["τὸν",1,6],["ἥλιον",323,7]],"And see life with the wife whom thou lovest all the days of the life of thy vanity, which are given thee under the sun: for that is thy portion in thy life, and in thy labour wherein thou labourest under the sun."],["10",[["Πάντα",11,65],["ὅσα",103,43],["ἂν",83,12],["εὕρῃ",101,160],["ἡ",1,11],["χείρ",37,13],["σου",5,146],["τοῦ",1,30],["ποιῆσαι",23,100],["ὡς",36,8],["ἡ",1,11],["δύναμίς",98,13],["σου",5,146],["ποίησον",23,198],["ὅτι",19,8],["οὐκ",12,17],["ἔστι",10,87],["ποίημα",1443,20],["καὶ",2,8],["λογισμὸς",500,5],["καὶ",2,8],["γνῶσις",753,13],["καὶ",2,8],["σοφία",242,13],["ἐν",4,1],["ᾅδῃ",586,113],["ὅπου",1579,17],["σὺ",5,156],["πορεύῃ",49,166],["ἐκεῖ",76,17]],"Whatsoever thine hand shall find to do, do with all thy might; for there is no work, nor device, nor knowledge, nor wisdom, in Hades whither thou goest."],["11",[["Ἐπέστρεψα",117,147],["καὶ",2,8],["εἶδον",53,147],["ὑπὸ",122,1],["τὸν",1,6],["ἥλιον",323,7],["ὅτι",19,8],["οὐ",12,17],["τοῖς",1,138],["κούφοις",1895,215],["ὁ",1,4],["δρόμος",2887,5],["καὶ",2,8],["οὐ",12,17],["τοῖς",1,138],["δυνατοῖς",356,215],["ὁ",1,4],["πόλεμος",163,5],["καί",2,8],["γε",353,12],["οὐ",12,17],["τῷ",1,110],["σοφῷ",324,111],["ἄρτος",197,5],["καί",2,8],["γε",353,12],["οὐ",12,17],["τοῖς",1,138],["συνετοῖς",954,215],["πλοῦτος",574,5],["καί",2,8],["γε",353,12],["οὐ",12,17],["τοῖς",1,138],["γινώσκουσι",79,352],["χάρις",368,13],["ὅτι",19,8],["καιρὸς",132,5],["καὶ",2,8],["ἀπάντημα",9076,20],["συνατήσεται",8404,125],["σύμπασιν",1357,215],["αὐτοῖς",3,142]],"I returned, and saw under the sun, that the race is not to the swift, nor the battle to the strong, nor yet bread to the wise, nor yet wealth to men of understanding, nor yet favour to men of knowledge; for time and chance will happen to them all."],["12",[["Ὅτι",19,8],["καί",2,8],["γε",353,12],["καὶ",2,8],["οὐκ",12,17],["ἔγνω",79,3],["ὁ",1,4],["ἄνθρωπος",43,5],["τὸν",1,6],["καιρὸν",132,7],["αὐτοῦ",3,48],["ὡς",36,8],["οἱ",1,128],["ἰχθύες",1372,51],["οἱ",1,128],["θηρευόμενοι",1887,351],["ἐν",4,1],["ἀμφιβλήστρῳ",4016,53],["κακῷ",161,34],["καὶ",2,8],["ὡς",36,8],["ὄρνεα",1238,63],["τὰ",1,253],["θηρευόμενα",1887,64],["ἐν",4,1],["παγίδι",817,2],["ὡς",36,8],["αὐτὰ",3,66],["παγιδεύονται",5886,299],["οἱ",1,128],["υἱοὶ",13,51],["τοῦ",1,30],["ἀνθρώπου",43,21],["εἰς",8,1],["καιρὸν",132,7],["πονηρὸν",164,59],["ὅταν",319,8],["ἐπιπέσῃ",995,160],["ἐπʼ",9,1],["αὐτοὺς",3,60],["ἄφνω",2821,17]],"For surely man also knows not his time: as fishes that are taken in an evil net, and as birds that are caught in a snare; even thus the sons of men are snared at an evil time, when it falls suddenly upon them."],["13",[["Καί",2,8],["γε",353,12],["τοῦτο",16,122],["εἶδον",53,147],["σοφίαν",242,10],["ὑπὸ",122,1],["τὸν",1,6],["ἥλιον",323,7],["καὶ",2,8],["μεγάλη",66,15],["ἐστι",10,87],["πρὸς",15,1],["μέ",6,82]],"This I also saw [to be] wisdom under the sun, and it is great before me:"],["14",[["Πόλις",41,13],["μικρὰ",367,15],["καὶ",2,8],["ἄνδρες",38,51],["ἐν",4,1],["αὐτῇ",3,99],["ὀλίγοι",555,130],["καὶ",2,8],["ἔλθῃ",55,160],["ἐπʼ",9,1],["αὐτὴν",3,98],["βασιλεὺς",22,5],["μέγας",66,16],["καὶ",2,8],["κυκλώσῃ",603,116],["αὐτὴν",3,98],["καὶ",2,8],["οἰκοδομήσῃ",126,116],["ἐπʼ",9,1],["αὐτὴν",3,98],["χάρακας",2131,31],["μεγάλους",66,58]],"[suppose there were] a little city, and few men in it; and there should come against it a great king, and surround it, and build great mounds against it;"],["15",[["καὶ",2,8],["εὕρῃ",101,160],["ἐν",4,1],["αὐτῇ",3,99],["ἄνδρα",38,7],["πένητα",672,7],["σοφὸν",324,59],["καὶ",2,8],["διασώσῃ",727,160],["αὐτὸς",3,158],["τὴν",1,9],["πόλιν",41,10],["ἐν",4,1],["τῇ",1,95],["σοφίᾳ",242,2],["αὐτοῦ",3,48],["καὶ",2,8],["ἄνθρωπος",43,5],["οὐκ",12,17],["ἐμνήσθη",230,38],["σὺν",310,1],["τοῦ",1,30],["ἀνδρὸς",38,21],["τοῦ",1,30],["πένητος",672,21],["ἐκείνου",80,48]],"and should find in it a poor wise man, and he should save the city through his wisdom: yet no man would remember that poor man."],["16",[["Καὶ",2,8],["εἶπα",18,147],["ἐγὼ",6,179],["ἀγαθὴ",114,15],["σοφία",242,13],["ὑπὲρ",139,1],["δύναμιν",98,10],["καὶ",2,8],["σοφία",242,13],["τοῦ",1,30],["πένητος",672,21],["ἐξουδενωμένη",1068,197],["καὶ",2,8],["οἱ",1,128],["λόγοι",48,51],["αὐτοῦ",3,48],["οὐκ",12,17],["εἰσακουόμενοι",241,351]],"And I said, Wisdom is better than power: yet the wisdom of the poor man is set at nought, and his words not listened to."],["17",[["Λόγοι",48,51],["σοφῶν",324,163],["ἐν",4,1],["ἀναπαύσει",674,120],["ἀκούονται",54,299],["ὑπὲρ",139,1],["κραυγὴν",828,10],["ἐξουσιάζόντων",2224,164],["ἐν",4,1],["ἀφροσύναις",1401,71]],"The words of the wise are heard in quiet more than the cry of them that rule in folly."],["18",[["Ἀγαθὴ",114,15],["σοφία",242,13],["ὑπὲρ",139,1],["σκεύη",182,43],["πολέμου",163,21],["καὶ",2,8],["ἁμαρτάνων",237,67],["εἷς",58,16],["ἀπολέσει",217,120],["ἀγαθωσύνην",2300,10],["πολλήν",74,37]],"Wisdom is better than weapons of war: and one sinner will destroy much good."]]