[["1",[["Παῦλος",10586,5],["δέσμιος",2889,5],["Χριστοῦ",1072,21],["Ἰησοῦ",211,21],["καὶ",2,8],["Τιμόθεος",1953,5],["ὁ",1,4],["ἀδελφὸς",67,5],["Φιλήμονι",11305,113],["τῷ",1,110],["ἀγαπητῷ",1920,111],["καὶ",2,8],["συνεργῷ",6116,111],["ἡμῶν",9994,136]],"Paul, a prisoner of Christ Jesus, and Timothy our brother, to Philemon, our beloved fellow worker,"],["2",[["καὶ",2,8],["Ἀπφίᾳ",11306,2],["τῇ",1,95],["ἀδελφῇ",521,2],["καὶ",2,8],["Ἀρχίππῳ",11162,113],["τῷ",1,110],["συστρατιώτῃ",11116,113],["ἡμῶν",9994,136],["καὶ",2,8],["τῇ",1,95],["κατ᾽",32,1],["οἶκόν",34,7],["σου",5,146],["ἐκκλησίᾳ",563,2]],"to the beloved Apphia, to Archippus our fellow soldier, and to the assembly in your house:"],["3",[["χάρις",368,13],["ὑμῖν",5,86],["καὶ",2,8],["εἰρήνη",213,13],["ἀπὸ",17,1],["θεοῦ",20,21],["πατρὸς",44,21],["ἡμῶν",9994,136],["καὶ",2,8],["κυρίου",7,21],["Ἰησοῦ",211,21],["Χριστοῦ",1072,21]],"Grace to you and peace from God our Father and the Lord Jesus Christ."],["4",[["Εὐχαριστῶ",3831,149],["τῷ",1,110],["θεῷ",20,113],["μου",9994,146],["πάντοτε",6027,17],["μνείαν",2271,10],["σου",5,146],["ποιούμενος",23,406],["ἐπὶ",9,1],["τῶν",1,123],["προσευχῶν",550,61],["μου",9994,146]],"I thank my God always, making mention of you in my prayers,"],["5",[["ἀκούων",54,67],["σου",5,146],["τὴν",1,9],["ἀγάπην",1982,10],["καὶ",2,8],["τὴν",1,9],["πίστιν",887,10],["ἣν",24,124],["ἔχεις",124,145],["πρὸς",15,1],["τὸν",1,6],["κύριον",7,7],["Ἰησοῦν",211,7],["καὶ",2,8],["εἰς",8,1],["πάντας",11,58],["τοὺς",1,56],["ἁγίους",75,58]],"hearing of your love and of the faith which you have toward the Lord Jesus and toward all the saints,"],["6",[["ὅπως",240,8],["ἡ",1,11],["κοινωνία",4860,13],["τῆς",1,18],["πίστεώς",887,19],["σου",5,146],["ἐνεργὴς",10989,15],["γένηται",30,745],["ἐν",4,1],["ἐπιγνώσει",3449,2],["παντὸς",11,88],["ἀγαθοῦ",114,88],["τοῦ",1,23],["ἐν",4,1],["ἡμῖν",9994,86],["εἰς",8,1],["Χριστόν",1072,7]],"that the fellowship of your faith may become effective in the knowledge of every good thing which is in us in Christ Jesus."],["7",[["χαρὰν",1125,10],["γὰρ",40,8],["πολλὴν",74,37],["ἔσχον",124,147],["καὶ",2,8],["παράκλησιν",2183,10],["ἐπὶ",9,1],["τῇ",1,95],["ἀγάπῃ",1982,2],["σου",5,146],["ὅτι",19,8],["τὰ",1,253],["σπλάγχνα",2190,63],["τῶν",1,76],["ἁγίων",75,163],["ἀναπέπαυται",674,722],["διὰ",56,1],["σοῦ",5,146],["ἀδελφέ",67,250]],"For we have much joy and comfort in your love, because the hearts of the saints have been refreshed through you, brother."],["8",[["Διὸ",1466,8],["πολλὴν",74,37],["ἐν",4,1],["Χριστῷ",1072,113],["παρρησίαν",2610,10],["ἔχων",124,67],["ἐπιτάσσειν",1405,54],["σοι",5,151],["τὸ",1,32],["ἀνῆκον",2809,47]],"Therefore though I have all boldness in Christ to command you that which is appropriate,"],["9",[["διὰ",56,1],["τὴν",1,9],["ἀγάπην",1982,10],["μᾶλλον",1043,17],["παρακαλῶ",434,149],["τοιοῦτος",630,112],["ὢν",10,67],["ὡς",36,12],["Παῦλος",10586,5],["πρεσβύτης",1095,5],["νυνὶ",2099,17],["δὲ",14,8],["καὶ",2,8],["δέσμιος",2889,5],["Χριστοῦ",1072,21],["Ἰησοῦ",211,21]],"yet for love’s sake I rather appeal to you, being such a one as Paul, the aged, but also a prisoner of Jesus Christ."],["10",[["παρακαλῶ",434,149],["σε",5,161],["περὶ",72,1],["τοῦ",1,23],["ἐμοῦ",10146,88],["τέκνου",192,24],["ὃν",24,106],["ἐγέννησα",222,147],["ἐν",4,1],["τοῖς",1,138],["δεσμοῖς",1035,139],["Ὀνήσιμον",11156,7]],"I appeal to you for my child Onesimus, whom I have become the father of in my chains,"],["11",[["τόν",1,6],["ποτέ",458,12],["σοι",5,151],["ἄχρηστον",2822,59],["νυνὶ",2099,17],["δὲ",14,8],["καὶ",2,8],["σοὶ",5,151],["καὶ",2,8],["ἐμοὶ",6,151],["εὔχρηστον",5639,59]],"who once was useless to you, but now is useful to you and to me."],["12",[["ὃν",24,106],["ἀνέπεμψά",10432,147],["σοι",5,151],["αὐτόν",3,82],["τοῦτ᾽",16,344],["ἔστιν",10,87],["τὰ",1,42],["ἐμὰ",10146,65],["σπλάγχνα",2190,43]],"I am sending him back. Therefore receive him, that is, my own heart,"],["13",[["ὃν",24,106],["ἐγὼ",6,156],["ἐβουλόμην",463,816],["πρὸς",15,1],["ἐμαυτὸν",10062,82],["κατέχειν",1040,54],["ἵνα",102,8],["ὑπὲρ",139,1],["σοῦ",5,146],["μοι",9994,151],["διακονῇ",10016,173],["ἐν",4,1],["τοῖς",1,138],["δεσμοῖς",1035,139],["τοῦ",1,23],["εὐαγγελίου",4222,24]],"whom I desired to keep with me, that on your behalf he might serve me in my chains for the Good News."],["14",[["χωρὶς",2046,1],["δὲ",14,8],["τῆς",1,18],["σῆς",10053,78],["γνώμης",1376,19],["οὐδὲν",228,29],["ἠθέλησα",612,147],["ποιῆσαι",23,100],["ἵνα",102,8],["μὴ",25,12],["ὡς",36,12],["κατὰ",32,1],["ἀνάγκην",1126,10],["τὸ",1,27],["ἀγαθόν",114,28],["σου",5,146],["ᾖ",10,173],["ἀλλὰ",108,8],["κατὰ",32,1],["ἑκούσιον",2424,29]],"But I was willing to do nothing without your consent, that your goodness would not be as of necessity, but of free will."],["15",[["τάχα",6166,17],["γὰρ",40,8],["διὰ",56,1],["τοῦτο",16,122],["ἐχωρίσθη",1647,38],["πρὸς",15,1],["ὥραν",838,10],["ἵνα",102,8],["αἰώνιον",391,59],["αὐτὸν",3,82],["ἀπέχῃς",1255,199]],"For perhaps he was therefore separated from you for a while that you would have him forever,"],["16",[["οὐκέτι",12,17],["ὡς",36,12],["δοῦλον",136,7],["ἀλλ᾽",108,8],["ὑπὲρ",139,1],["δοῦλον",136,7],["ἀδελφὸν",67,7],["ἀγαπητόν",1920,59],["μάλιστα",3593,17],["ἐμοί",6,151],["πόσῳ",2486,743],["δὲ",14,8],["μᾶλλον",1043,17],["σοὶ",5,151],["καὶ",2,8],["ἐν",4,1],["σαρκὶ",287,2],["καὶ",2,8],["ἐν",4,1],["κυρίῳ",7,113]],"no longer as a slave, but more than a slave, a beloved brother—especially to me, but how much rather to you, both in the flesh and in the Lord."],["17",[["εἰ",77,8],["οὖν",227,8],["με",9994,161],["ἔχεις",124,145],["κοινωνόν",3562,7],["προσλαβοῦ",3119,275],["αὐτὸν",3,82],["ὡς",36,12],["ἐμέ",6,161]],"If then you count me a partner, receive him as you would receive me."],["18",[["εἰ",77,8],["δέ",14,8],["τι",39,119],["ἠδίκησέν",760,3],["σε",5,161],["ἢ",61,8],["ὀφείλει",2150,87],["τοῦτο",16,122],["ἐμοὶ",6,151],["ἐλλόγα",10847,239]],"But if he has wronged you at all or owes you anything, put that to my account."],["19",[["Ἐγὼ",6,156],["Παῦλος",10586,5],["ἔγραψα",186,147],["τῇ",1,95],["ἐμῇ",10146,96],["χειρί",37,2],["ἐγὼ",6,156],["ἀποτίσω",1365,157],["ἵνα",102,8],["μὴ",25,12],["λέγω",31,592],["σοι",5,151],["ὅτι",19,8],["καὶ",2,8],["σεαυτόν",10014,82],["μοι",9994,151],["προσοφείλεις",11307,145]],"I, Paul, write this with my own hand: I will repay it (not to mention to you that you owe to me even your own self besides)."],["20",[["ναί",3597,12],["ἀδελφέ",67,250],["ἐγώ",6,156],["σου",5,146],["ὀναίμην",4640,908],["ἐν",4,1],["κυρίῳ",7,113],["ἀνάπαυσόν",674,198],["μου",9994,146],["τὰ",1,42],["σπλάγχνα",2190,43],["ἐν",4,1],["Χριστῷ",1072,113]],"Yes, brother, let me have joy from you in the Lord. Refresh my heart in the Lord."],["21",[["Πεποιθὼς",344,264],["τῇ",1,95],["ὑπακοῇ",9870,2],["σου",5,146],["ἔγραψά",186,147],["σοι",5,151],["εἰδὼς",1168,264],["ὅτι",19,8],["καὶ",2,8],["ὑπὲρ",139,1],["ἃ",24,755],["λέγω",31,149],["ποιήσεις",23,159]],"Having confidence in your obedience, I write to you, knowing that you will do even beyond what I say."],["22",[["ἅμα",502,17],["δὲ",14,8],["καὶ",2,8],["ἑτοίμαζέ",371,239],["μοι",9994,151],["ξενίαν",10811,10],["ἐλπίζω",514,149],["γὰρ",40,8],["ὅτι",19,8],["διὰ",56,1],["τῶν",1,123],["προσευχῶν",550,61],["ὑμῶν",5,136],["χαρισθήσομαι",6200,176],["ὑμῖν",5,86]],"Also, prepare a guest room for me, for I hope that through your prayers I will be restored to you."],["23",[["Ἀσπάζεταί",2987,728],["σε",5,161],["Ἐπαφρᾶς",11138,5],["ὁ",1,4],["συναιχμάλωτός",10908,5],["μου",9994,146],["ἐν",4,1],["Χριστῷ",1072,113],["Ἰησοῦ",211,113]],"Epaphras, my fellow prisoner in Christ Jesus, greets you,"],["24",[["Μᾶρκος",10572,5],["Ἀρίσταρχος",10690,5],["Δημᾶς",11159,5],["Λουκᾶς",11158,5],["οἱ",1,128],["συνεργοί",6116,130],["μου",9994,146]],"as do Mark, Aristarchus, Demas, and Luke, my fellow workers."],["25",[["ἡ",1,11],["χάρις",368,13],["τοῦ",1,30],["κυρίου",7,21],["Ἰησοῦ",211,21],["Χριστοῦ",1072,21],["μετὰ",29,1],["τοῦ",1,23],["πνεύματος",168,24],["ὑμῶν",5,136]],"The grace of our Lord Jesus Christ be with your spirit. Amen."]]