[["1",[["Καὶ",2,8],["εἶπαν",18,141],["πρὸς",15,1],["Γεδεὼν",1028,5],["ἀνὴρ",38,5],["Ἐφραὶμ",308,105],["τί",39,119],["τὸ",1,32],["ῥῆμα",116,33],["τοῦτο",16,122],["ἐποίησας",23,154],["ἡμῖν",6,142],["τοῦ",1,30],["μὴ",25,8],["καλέσαι",128,100],["ἡμᾶς",6,60],["ὅτε",432,8],["ἐπορεύθης",49,360],["παρατάξασθαι",718,103],["ἐν",4,1],["Μαδιάμ",894,105],["καὶ",2,8],["διελέξαντο",3259,184],["πρὸς",15,1],["αὐτὸν",3,82],["ἰσχυρῶς",401,17]],"And the men of Ephraim said to Gedeon, What [is] this [that] thou hast done to us, in that thou didst not call us when thou wentest to fight with Madiam? and they chode with him sharply."],["2",[["Καὶ",2,8],["εἶπε",18,3],["πρὸς",15,1],["αὐτοὺς",3,60],["τί",39,119],["ἐποίησα",23,147],["νῦν",90,17],["καθὼς",221,17],["ὑμεῖς",5,208],["ἢ",61,8],["οὐχὶ",330,12],["κρείττῶν",922,15],["ἐπιφυλλὶς",3746,13],["Ἐφραὶμ",308,105],["ἢ",61,8],["τρυγητὸς",2504,5],["Ἀβιέζερ",11766,0]],"And he said to them, What have I now done in comparison of you? [is] not the gleaning of Ephraim better than the vintage of Abiezer?"],["3",[["Ἐν",4,1],["χειρὶ",37,2],["ὑμῶν",5,136],["παρέδωκε",254,3],["Κύριος",7,5],["τοὺς",1,56],["ἄρχοντας",96,31],["Μαδιὰμ",894,105],["τὸν",1,6],["Ὠρὴβ",11786,0],["καὶ",2,8],["τὸν",1,6],["Ζήβ",12217,0],["καὶ",2,8],["τί",39,119],["ἠδυνήθην",185,148],["ποιῆσαι",23,100],["ὡς",36,8],["ὑμεῖς",5,208],["τότε",250,17],["ἀνέθη",1081,38],["τὸ",1,32],["πνεῦμα",168,33],["αὐτῶν",3,41],["ἀπʼ",17,1],["αὐτοῦ",3,48],["ἐν",4,1],["τῷ",1,110],["λαλῆσαι",50,100],["αὐτὸν",3,82],["τὸν",1,6],["λόγον",48,7],["τοῦτον",16,259]],"The Lord has delivered into your hand the princes of Madiam, Oreb and Zeb; and what could I do in comparison of you? Then was their spirit calmed toward him, when he spoke this word."],["4",[["Καὶ",2,8],["ἦλθε",55,3],["Γεδεὼν",1028,5],["ἐπὶ",9,1],["τὸν",1,6],["Ἰορδανὴν",303,0],["καὶ",2,8],["διέβη",466,3],["αὐτὸς",3,158],["καὶ",2,8],["οἱ",1,128],["τριακόσιοι",673,130],["ἄνδρες",38,51],["οἱ",1,128],["μετʼ",29,1],["αὐτοῦ",3,48],["πεινῶντες",1045,137],["καὶ",2,8],["διώκοντες",533,137]],"And Gedeon came to Jordan, and went over, himself and the three hundred with him, hungry, yet pursuing."],["5",[["Καὶ",2,8],["εἶπε",18,3],["τοῖς",1,138],["ἀνδράσι",38,139],["Σοκχὼθ",11611,0],["δότε",33,69],["δὴ",193,12],["ἄρτους",197,31],["εἰς",8,1],["τροφὴν",1390,10],["τῷ",1,110],["λαῷ",35,113],["τούτῳ",16,286],["τῷ",1,110],["ἐν",4,1],["ποσί",210,139],["μου",6,48],["ὅτι",19,8],["ἐκλείπουσι",321,191],["καὶ",2,8],["ἰδοὺ",51,17],["ἐγώ",6,158],["εἰμι",10,149],["διώκων",533,67],["ὀπίσω",167,17],["τοῦ",1,30],["Ζεβεὲ",11633,0],["καὶ",2,8],["Σαλμανὰ",11656,0],["βασιλέων",22,77],["Μαδιάμ",894,105]],"And he said to the men of Socchoth, Give, I pray you, bread to feed this people that follow me; because they are faint, and behold, I am following after Zebee and Salmana, kings of Madiam."],["6",[["Καὶ",2,8],["εἶπον",18,141],["οἱ",1,128],["ἄρχοντες",96,51],["Σοκχὼθ",11611,0],["μὴ",25,8],["χεὶρ",37,13],["Ζεβεὲ",11633,0],["καὶ",2,8],["Σαλμανὰ",11656,0],["νῦν",90,17],["ἐν",4,1],["χειρί",37,2],["σου",5,146],["ὅτι",19,8],["δώσομεν",33,269],["τῇ",1,95],["δυνάμει",98,2],["σου",5,146],["ἄρτους",197,31]],"And the princes of Socchoth said, [Are] the hands of Zebee and Salmana now in thy hand, that we should give bread to thy host?"],["7",[["Καὶ",2,8],["εἶπε",18,3],["Γεδεὼν",1028,5],["διὰ",56,1],["τοῦτο",16,122],["ἐν",4,1],["τῷ",1,110],["δοῦναι",33,100],["Κύριον",7,7],["τὸν",1,6],["Ζεβεὲ",11633,0],["καὶ",2,8],["τὸν",1,6],["Σαλμανὰ",11656,0],["ἐν",4,1],["χειρί",37,2],["μου",6,48],["καὶ",2,8],["ἐγὼ",6,158],["ἀλοήσω",2979,157],["τὰς",1,39],["σάρκας",287,40],["ὑμῶν",5,136],["ἐν",4,1],["ταῖς",1,70],["ἀκάνθαις",1571,71],["τῆς",1,18],["ἐρήμου",160,78],["καὶ",2,8],["ἐν",4,1],["ταῖς",1,70],["Βαρκηνίμ",12706,0]],"And Gedeon said, Therefore when the Lord gives Zebee and Salmana into my hand, then will I tear your flesh with the thorns of the wilderness, and the Barkenim."],["8",[["Καὶ",2,8],["ἀνέβη",88,3],["ἐκεῖθεν",430,17],["εἰς",8,1],["Φανουὴλ",3243,105],["καὶ",2,8