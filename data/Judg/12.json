2,8],["ἐτάφη",390,38],["ἐν",4,1],["Αἰλὼμ",0,0],["ἐν",4,1],["γῇ",26,2],["Ζαβουλών",1072,105]],"And Ælom of Zabulon died, and was buried in Ælom in the land of Zabulon."],["13",[["Καὶ",2,8],["ἔκρινε",240,3],["μετʼ",29,1],["αὐτὸν",3,82],["τὸν",1,6],["Ἰσραὴλ",27,105],["Ἀβδὼν",3725,77],["υἱὸς",13,5],["Ἑλλὴλ",0,0],["ὁ",1,4],["Φαραθωνίτης",0,0]],"And after him Abdon the son of Ellel, the Pharathonite, judged Israel."],["14",[["Καὶ",2,8],["ἦσαν",10,129],["αὐτῷ",3,49],["τεσσαράκοντα",509,57],["υἱοὶ",13,51],["καὶ",2,8],["τριάκοντα",423,57],["υἱῶν",13,77],["υἱοὶ",13,51],["ἐπιβαίνοντες",881,137],["ἐπὶ",9,1],["ἑβδομήκοντα",624,57],["πώλους",3350,31],["καὶ",2,8],["ἔκρινε",240,3],["τὸν",1,6],["Ἰσραὴλ",27,105],["ὀκτὼ",1052,57],["ἔτη",80,43]],"And he had forty sons, and thirty grandsons, that rode upon seventy colts: and he judged Israel eight years."],["15",[["Καὶ",2,8],["ἀπέθανεν",108,3],["Ἀβδὼν",3725,77],["υἱὸς",13,5],["Ἐλλὴλ",0,0],["ὁ",1,4],["Φαραθωνίτης",0,0],["καὶ",2,8],["ἐτάφη",390,38],["ἐν",4,1],["Φαραθὼν",0,0],["ἐν",4,1],["γῇ",26,2],["Ἐφραὶμ",307,105],["ἐν",4,1],["ὄρει",86,53],["τοῦ",1,30],["Ἀμαλήκ",1257,105]],"And Abdon the son of Ellel, the Pharathonite, died, and was buried in Pharathon in the land of Ephraim in the mount of Amalec."]]