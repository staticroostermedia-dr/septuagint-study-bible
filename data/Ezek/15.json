[["1",[["Καὶ",2,8],["ἐγένετο",30,26],["λόγος",48,5],["Κυρίου",7,21],["πρὸς",15,1],["μὲ",6,82],["λέγων",31,67]],"And the word of the Lord came to me, saying,"],["2",[["Καὶ",2,8],["σὺ",5,156],["υἱὲ",13,251],["ἀνθρώπου",43,21],["τί",39,119],["ἂν",82,12],["γένοιτο",30,397],["τὸ",1,32],["ξύλον",196,33],["τῆς",1,18],["ἀμπέλου",810,19],["ἐκ",21,1],["πάντων",11,79],["τῶν",1,44],["ξύλων",196,45],["τῶν",1,44],["κλημάτων",2594,45],["τῶν",1,44],["ὄντων",10,80],["ἐν",4,1],["τοῖς",1,91],["ξύλοις",196,92],["τοῦ",1,30],["δρυμοῦ",799,21]],"And thou, son of man—of all the wood of the branches that are among the trees of the forest, what shall be made of the wood of the vine?"],["3",[["Εἰ",77,8],["λήψονται",46,127],["ἐξ",21,1],["αὐτῆς",3,83],["ξύλον",196,33],["τοῦ",1,30],["ποιῆσαι",23,100],["εἰς",8,1],["ἐργασίαν",1071,10],["εἰ",77,8],["λήψονται",46,127],["ἐξ",21,1],["αὐτῆς",3,83],["πάσσαλον",1739,7],["τοῦ",1,30],["κρεμᾶσαι",1380,603],["ἐπʼ",9,1],["αὐτὸν",3,82],["πᾶν",11,59],["σκεῦος",181,33]],"Will they take wood of it to make [it fit] for work? will they take of it a peg to hang any vessel upon it?"],["4",[["Πάρεξ",2201,1],["ὃ",1,4],["πυρὶ",118,53],["δέδοται",33,372],["εἰς",8,1],["ἀναλωσιν",4538,10],["τὴν",1,9],["κατʼ",32,1],["ἐνιαυτὸν",397,7],["κάθαρσιν",4298,10],["ἀπʼ",17,1],["αὐτῆς",3,83],["ἀναλίσκει",1848,87],["τὸ",1,32],["πῦρ",118,33],["καὶ",2,8],["ἐκλείπει",321,87],["εἰς",8,1],["τέλος",369,33],["μὴ",25,8],["χρήσιμον",2406,29],["ἔσται",10,89],["εἰς",8,1],["ἐργασίαν",1071,10]],"It is only given to the fire to be consumed; the fire consumes that which is yearly pruned of it, and it is utterly gone. Will it be useful for [any] work?"],["5",[["Οὐδὲ",105,12],["ἔτι",110,17],["αὐτοῦ",3,48],["ὄντος",10,143],["ὁλοκλήρου",3226,153],["οὐκ",12,17],["ἔσται",10,89],["εἰς",8,1],["ἐργασίαν",1071,10],["μὴ",25,8],["ὅτι",19,8],["ἐὰν",45,8],["καὶ",2,8],["πῦρ",118,33],["αὐτὸ",3,121],["ἀναλώσῃ",1848,116],["εἰς",8,1],["τέλος",369,33],["εἰ",77,8],["ἔτι",110,17],["ἔσται",10,89],["εἰς",8,1],["ἐργασίαν",1071,10]],"Not even while it is yet whole will it be [useful] for [any] work: if the fire shall have utterly consumed it, will it still be [fit] for work?"],["6",[["Διὰ",54,1],["τοῦτο",16,122],["εἰπὸν",18,535],["Τάδε",129,249],["λέγει",31,87],["Κύριος",7,5],["ὃν",24,106],["τρόπον",243,7],["τὸ",1,32],["ξύλον",196,33],["τῆς",1,18],["ἀμπέλου",810,19],["ἐν",4,1],["τοῖς",1,91],["ξύλοις",196,92],["τοῦ",1,30],["δρυμοῦ",799,21],["ὃ",1,4],["δέδωκα",33,85],["αὐτὸ",3,121],["πυρὶ",118,53],["εἰς",8,1],["ἀνάλωσιν",4538,10],["οὕτως",70,17],["δέδωκα",33,85],["τοὺς",1,56],["κατοικοῦντας",90,229],["Ἰερουσαλήμ",823,10]],"Therefore say, Thus saith the Lord, As the vine-tree among the trees of the forest, which I have given up to the fire to be consumed, so have I given up the inhabitants of Jerusalem."],["7",[["Καὶ",2,8],["δώσω",33,157],["τὸ",1,32],["πρόσωπόν",47,33],["μου",6,48],["ἐπʼ",9,1],["αὐτούς",3,60],["ἐκ",21,1],["τοῦ",1,23],["πυρὸς",118,24],["ἐξελεύσονται",84,127],["καὶ",2,8],["πῦρ",118,33],["αὐτοὺς",3,60],["καταφάγεται",404,89],["καὶ",2,8],["ἐπιγνώσονται",433,127],["ὅτι",19,8],["ἐγὼ",6,158],["Κύριος",7,5],["ἐν",4,1],["τῷ",1,110],["στηρίσαι",1064,100],["με",6,82],["τὸ",1,32],["πρόσωπόν",47,33],["μου",6,48],["ἐπʼ",9,1],["αὐτούς",3,60]],"And I will set my face against them; they shall go forth of the fire, and [yet] fire shall devour them; and they shall know that I am the Lord, when I have set my face against them."],["8",[["Καὶ",2,8],["δώσω",33,157],["τὴν",1,9],["γῆν",26,10],["εἰς",8,1],["ἀφανισμὸν",880,7],["ἀνθʼ",158,1],["ὧν",24,97],["παρέπεσον",3326,141],["παραπτώματι",1909,53],["λέγει",31,87],["Κύριος",7,5]],"And I will give up the land to ruin, because they have utterly transgressed, saith the Lord."]]