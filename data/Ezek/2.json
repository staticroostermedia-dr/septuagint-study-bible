[["1",[["Αὕτη",16,101],["ἡ",1,11],["ὅρασις",505,13],["ὁμοιώματος",1176,24],["δόξης",141,19],["Κυρίου",7,21],["καὶ",2,8],["ἴδον",276,141],["καὶ",2,8],["πίπτω",154,149],["ἐπὶ",9,1],["πρόσωπόν",47,33],["μου",6,48],["καὶ",2,8],["ἤκουσα",53,147],["φωνὴν",95,10],["λαλοῦντος",50,143],["καὶ",2,8],["εἶπε",18,3],["πρὸς",15,1],["μὲ",6,82],["υἱὲ",13,251],["ἀνθρώπου",43,21],["στῆθι",78,198],["ἐπὶ",9,1],["τοὺς",1,56],["πόδας",208,31],["σου",5,146],["καὶ",2,8],["λαλήσω",50,157],["πρὸς",15,1],["σέ",5,161]],"This was the appearance of the likeness of the glory of the Lord. And I saw and fell upon my face, and heard the voice of one speaking: and he said to me, Son of man, stand upon thy feet, and I will speak to thee."],["2",[["Καὶ",2,8],["ἦλθεν",56,3],["ἐπʼ",9,1],["ἐμὲ",6,82],["πνεῦμα",167,20],["καὶ",2,8],["ἀνέλαβέ",573,3],["με",6,82],["καὶ",2,8],["ἐξῇρέ",339,14],["με",6,82],["καὶ",2,8],["ἔστησέ",78,3],["με",6,82],["ἐπὶ",9,1],["τοὺς",1,56],["πόδας",208,31],["μου",6,48],["καὶ",2,8],["ἤκουον",53,129],["αὐτοῦ",3,48],["λαλοῦντος",50,143],["πρὸς",15,1],["μέ",6,82]],"And the Spirit came upon me, and took me up, and raised me, and set me on my feet: and I heard him speaking to me."],["3",[["Καὶ",2,8],["εἶπε",18,3],["πρὸς",15,1],["μὲ",6,82],["υἱὲ",13,251],["ἀνθρώπου",43,21],["ἐξαποστέλλω",217,149],["ἐγώ",6,158],["σε",5,161],["πρὸς",15,1],["τὸν",1,6],["οἶκον",34,7],["τοῦ",1,30],["Ἰσραὴλ",27,105],["τοὺς",1,56],["παραπικραίνοντάς",1688,229],["με",6,82],["οἵτινες",454,461],["παρεπίκρανάν",2037,141],["με",6,82],["αὐτοὶ",3,193],["καὶ",2,8],["οἱ",1,128],["πατέρες",44,51],["αὐτῶν",3,41],["ἕως",42,8],["τῆς",1,18],["σήμερον",205,17],["ἡμέρας",28,19]],"And he said to me, Son of man, I send thee forth to the house of Israel, them that provoke me; who have provoked me, they and their fathers, to this day."],["4",[["Καὶ",2,8],["ἐρεῖς",191,145],["πρὸς",15,1],["αὐτοὺς",3,60],["τάδε",129,249],["λέγει",31,87],["Κύριος",7,5]],"And thou shalt say to them, Thus saith the Lord."],["5",[["ἐὰν",45,8],["ἆρα",3004,105],["ἀκούσωσιν",53,224],["ἢ",60,8],["πτοηθῶσι",1331,267],["διότι",176,8],["οἶκος",34,5],["παραπικραίνων",1688,67],["ἐστὶ",10,87],["καὶ",2,8],["γνώσονται",81,127],["ὅτι",19,8],["προφήτης",175,5],["εἶ",10,145],["σὺ",5,156],["ἐν",4,1],["μέσῳ",112,34],["αὐτῶν",3,41]],"Whether then indeed they shall hear or fear, (for it is a provoking house,) yet they shall know that thou art a prophet in the midst of them."],["6",[["Καὶ",2,8],["σὺ",5,156],["υἱὲ",13,251],["ἀνθρώπου",43,21],["μὴ",25,8],["φοβηθῇς",134,279],["αὐτοὺς",3,60],["μηδὲ",412,12],["ἐκστῇς",730,170],["ἀπὸ",17,1],["προσώπου",47,24],["αὐτῶν",3,41],["διότι",176,8],["παροιστρήσουσι",4982,207],["καὶ",2,8],["ἐπισυστήσονται",3757,127],["ἐπὶ",9,1],["σὲ",5,161],["κύκλῳ",258,17],["καὶ",2,8],["ἐν",4,1],["μέσῳ",112,34],["σκορπίων",2775,77],["σὺ",5,156],["κατοικεῖς",90,145],["τοὺς",1,56],["λόγους",48,31],["αὐτῶν",3,41],["μὴ",25,8],["φοβηθῇς",134,279],["καὶ",2,8],["ἀπὸ",17,1],["προσώπου",47,24],["αὐτῶν",3,41],["μὴ",25,8],["ἐκστῇς",730,170],["διότι",176,8],["οἶκος",34,5],["παραπικραίνων",1688,67],["ἐστί",10,87]],"And thou, son of man, fear them not, nor be dismayed at their face; (for they will madden and will rise up against thee round about, and thou dwellest in the midst of scorpions): be not afraid of their words, nor be dismayed at their countenance, for it is a provoking house."],["7",[["Καὶ",2,8],["λαλήσεις",50,159],["τοὺς",1,56],["λόγους",48,31],["μου",6,48],["πρὸς",15,1],["αὐτοὺς",3,60],["ἐὰν",45,8],["ἆρα",3004,105],["ἀκούσωσιν",53,224],["ἢ",60,8],["πτοηθῶσιν",1331,267],["ὅτι",19,8],["οἶκος",34,5],["παραπικραίνων",1688,67],["ἐστί",10,87]],"And thou shalt speak my words to them, whether they will hear or fear: for it is a provoking house."],["8",[["Καὶ",2,8],["σὺ",5,156],["υἱὲ",13,251],["ἀνθρώπου",43,21],["ἄκουε",53,239],["τοῦ",1,30],["λαλοῦντος",50,143],["πρὸς",15,1],["σὲ",5,161],["μὴ",25,8],["γίνου",30,250],["παραπικραίνων",1688,67],["καθὼς",218,17],["ὁ",1,4],["οἶκος",34,5],["ὁ",1,4],["παραπικραίνων",1688,67],["χάνε",4484,198],["τὸ",1,32],["στόμα",123,33],["σου",5,146],["καὶ",2,8],["φάγε",153,198],["ὃ",1,4],["ἐγὼ",6,158],["δίδωμί",33,149],["σοι",5,151]],"And thou, son of man, hear him that speaks to thee; be not thou provoking, as the provoking house: open thy mouth, and eat what I give thee."],["9",[["Καὶ",2,8],["ἴδον",276,141],["καὶ",2,8],["ἰδοὺ",51,17],["χεὶρ",37,13],["ἐκτεταμένη",419,197],["πρὸς",15,1],["μὲ",6,82],["καὶ",2,8],["ἐν",4,1],["αὐτῇ",3,99],["κεφαλὶς",1682,13],["βιβλίου",337,24]],"And I looked, and behold, a hand stretched out to me, and in it a volume of a book."],["10",[["Καὶ",2,8],["ἀνείλησεν",8950,3],["αὐτὴν",3,98],["ἐνώπιόν",114,1],["μου",6,48],["καὶ",2,8],["ἦν",10,14],["ἐν",4,1],["αὐτῇ",3,99],["γεγραμμένα",186,453],["τὰ",1,254],["ἔμπροσθεν",387,17],["καὶ",2,8],["τὰ",1,42],["ὀπίσω",166,17],["καὶ",2,8],["ἐγέγραπτο",186,108],["θρῆνος",1378,5],["καὶ",2,8],["μέλος",1594,20],["καὶ",2,8],["οὐαί",766,320]],"And he unrolled it before me: and in it the front and the back were written [upon]: and there was written [in it] Lamentation, and mournful song, and woe."]]