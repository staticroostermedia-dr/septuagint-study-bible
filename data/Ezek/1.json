,19],["ὀσφύος",795,19],["καὶ",2,8],["ἕως",42,8],["κάτω",1628,17],["ἴδον",276,141],["ὅρασιν",505,10],["πυρὸς",118,24],["καὶ",2,8],["τὸ",1,32],["φέγγος",1644,33],["αὐτοῦ",3,48],["κύκλῳ",258,17]],"And I saw as it were the resemblance of amber from the appearance of the loins and upwards, and from the appearance of the loins and under I saw an appearance of fire, and the brightness thereof round about."],["28",[["ὡς",36,8],["ὅρασις",505,13],["τόξου",712,24],["ὅταν",318,8],["ᾖ",10,172],["ἐν",4,1],["τῇ",1,95],["νεφέλῃ",443,2],["ἐν",4,1],["ἡμέραις",28,71],["ὑετοῦ",672,21],["οὕτως",70,17],["ἡ",1,11],["στάσις",1524,13],["τοῦ",1,23],["φέγγους",1644,24],["κυκλόθεν",604,17]],"As the appearance of the bow when it is in the cloud in days of rain, so was the form of the brightness round about."]]