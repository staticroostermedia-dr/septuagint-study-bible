,23],["προσώπου",47,24],["αὐτῶν",3,41],["ἐπορεύοντο",49,131]],"And the faces of them four turned not when they went; they went every one straight forward."],["10",[["Καὶ",2,8],["ὁμοίωσις",3765,13],["τῶν",1,44],["προσώπων",47,45],["αὐτῶν",3,168],["πρόσωπον",47,33],["ἀνθρώπου",43,21],["καὶ",2,8],["πρόσωπον",47,33],["τοῦ",1,30],["λέοντος",424,21],["ἐκ",21,1],["δεξιῶν",282,79],["τοῖς",1,138],["τέσσαρσι",306,215],["καὶ",2,8],["πρόσωπον",47,33],["μόσχου",256,21],["ἐξ",21,1],["ἀριστερῶν",878,79],["τοῖς",1,138],["τέσσαρσι",306,215],["καὶ",2,8],["πρόσωπον",47,33],["ἀετοῦ",1567,21],["τοῖς",1,138],["τέσσαρσι",306,215]],"And the likeness of their faces was the face of a man, and the face of a lion on the right to the four; and the face of a calf on the left to the four; and the face of an eagle to the four."],["11",[["Καὶ",2,8],["αἱ",1,185],["πτέρυγες",719,180],["αὐτῶν",3,41],["ἐκτεταμέναι",421,424],["ἄνωθεν",1605,17],["τοῖς",1,138],["τέσσαρσιν",306,215],["ἑκατέρῳ",2839,111],["δύο",104,57],["συνεζευγμέναι",6090,424],["πρὸς",15,1],["ἀλλήλας",1192,221],["καὶ",2,8],["δύο",104,57],["ἐπεκάλυπτον",1997,129],["ἐπάνω",491,17],["τοῦ",1,23],["σώματος",454,24],["αὐτῶν",3,41]],"And the four had their wings spread out above; each one [had] two joined to one another, and two covered their bodies."],["12",[["Καὶ",2,8],["ἑκάτερον",2839,28],["κατὰ",32,1],["πρόσωπον",47,20],["αὐτοῦ",3,48],["ἐπορεύετο",49,22],["οὗ",120,17],["ἂν",83,12],["ἦν",10,14],["τὸ",1,32],["πνεῦμα",168,33],["πορευόμενον",49,205],["ἐπορεύοντο",49,131],["καὶ",2,8],["οὐκ",12,17],["ἐπέστρεφον",117,129]],"And each one went straight forward: wherever the spirit was going they went, and turned not back."],["13",[["Καὶ",2,8],["ἐν",4,1],["μέσῳ",113,34],["τῶν",1,76],["ζώων",107,36],["ὅρασις",509,13],["ὡς",36,8],["ἀνθράκων",1402,77],["πυρὸς",118,24],["καιομένων",671,295],["ὡς",36,8],["ὄψις",1130,13],["λαμπάδων",2023,61],["συστρεφομένων",1640,468],["ἀναμέσον",215,28],["τῶν",1,123],["ζώων",107,36],["καὶ",2,8],["φέγγος",1644,20],["τοῦ",1,