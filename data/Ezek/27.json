[["1",[["Καὶ",2,8],["ἐγένετο",30,26],["λόγος",48,5],["Κυρίου",7,21],["πρὸς",15,1],["μὲ",6,82],["λέγων",31,67]],"And the word of the Lord came to me, saying,"],["2",[["Καὶ",2,8],["σὺ",5,156],["υἱὲ",13,250],["ἀνθρώπου",43,21],["λάβε",46,198],["ἐπὶ",9,1],["Σὸρ",11722,0],["θρῆνον",1379,7]],"And thou, son of man, take up a lamentation against Sor;"],["3",[["καὶ",2,8],["ἐρεῖς",165,159],["τῇ",1,95],["Σὸρ",11722,0],["τῇ",1,95],["κατοικούσῃ",89,210],["ἐπὶ",9,1],["τῆς",1,18],["εἰσόδου",1002,19],["τῆς",1,18],["θαλάσσης",137,19],["τῷ",1,52],["ἐμπορίῳ",6443,53],["τῶν",1,76],["λαῶν",35,77],["ἀπὸ",17,1],["νήσων",1206,61],["πολλῶν",74,115],["τάδε",129,248],["λέγει",31,87],["Κύριος",7,5],["τῇ",1,95],["Σόρ",12062,0]],"and thou shalt say to Sor that dwells at the entrance of the sea, to the mart of the nations coming from many islands, Thus saith the Lord to Sor; Thou hast said, I have clothed myself with my beauty."],["4",[["Σὺ",5,156],["εἶπας",18,154],["ἐγὼ",6,158],["περιέθηκα",1017,147],["ἐμαυτῇ",890,99],["κάλλος",886,20],["μου",6,48],["ἐν",4,1],["καρδίᾳ",64,2],["θαλάσσης",137,19],["τῷ",1,110],["Βεελεὶμ",12730,0],["υἱοί",13,51],["σου",5,146],["περιέθηκάν",1017,141],["σοι",5,151],["κάλλος",886,20]],"In the heart of the sea thy sons have put beauty upon thee for Beelim."],["5",[["Κέδρος",873,13],["ἐν",4,1],["Σενεὶρ",13711,0],["ᾠκοδομήθη",126,38],["σοι",5,151],["ταινίαι",8491,180],["σανίδων",4384,61],["κυπαρίσσου",2460,19],["ἐκ",21,1],["τοῦ",1,30],["Λιβάνου",537,21],["ἐλήφθησαν",46,94],["τοῦ",1,30],["ποιῆσαί",23,100],["σοι",5,151],["ἱστοὺς",2550,31],["ἐλατίνους",9350,58]],"Cedar in Senir was employed for thee in building: boards of cypress timber were taken out of Libanus, and wood to make thee masts of fir."],["6",[["ἐκ",21,1],["τῆς",1,18],["Βασανίτιδος",2691,19],["ἐποίησαν",23,141],["τὰς",1,39],["κώπας",7560,40],["σου",5,146],["τὰ",1,42],["ἱερά",1318,65],["σου",5,146],["ἐποίησαν",23,141],["ἐξ",21,1],["ἐλέφαντος",2056,21],["οἴκους",34,31],["ἀλσώδεις",3396,31],["ἀπὸ",17,1],["νήσων",1206,61],["τῶν",1,123],["Χετιείμ",13963,0]],"They made thine oars [of wood] out of the land of Basan; thy sacred utensils they made of ivory, thy shady houses of wood from the isles of Chetiim."],["7",[["Βύσσος",1181,13],["μετὰ",29,1],["ποικιλίας",3334,19],["ἐξ",21,1],["Αἰγύπτου",93,19],["ἐγένετό",30,26],["σοι",5,151],["στρωμνὴ",2629,13],["τοῦ",1,30],["περιθεῖναί",1017,100],["σοι",5,151],["δόξαν",141,10],["καὶ",2,8],["περιβαλεῖν",744,100],["σε",5,161],["ὑάκινθον",1295,7],["καὶ",2,8],["πορφύραν",1062,10],["ἐκ",21,1],["τῶν",1,123],["νήσων",1206,61],["Ἐλεισαὶ",14393,0],["καὶ",2,8],["ἐγένετο",30,26],["περιβόλαιά",2753,63],["σου",5,146]],"Fine linen with embroidery from Egypt supplied thy couch, to put honour upon thee, and to clothe thee with blue and purple from the isles of Elisai; and they became thy coverings."],["8",[["Καὶ",2,8],["οἱ",1,128],["ἄρχοντές",320,137],["σου",5,146],["οἱ",1,128],["κατοικοῦντες",89,137],["Σιδῶνα",1762,10],["καὶ",2,8],["Ἀράδιοι",5279,51],["ἐγένοντο",30,184],["κωπηλάται",3570,51],["σου",5,146],["οἱ",1,128],["σοφοί",324,130],["σου",5,146],["Σὸρ",11722,0],["οἳ",1,128],["ἦσαν",10,129],["ἐν",4,1],["σοὶ",5,151],["οὗτοι",16,213],["κυβερνῆταί",3870,51],["σου",5,146]],"And thy princes were the dwellers in Sidon, and the Aradians were thy rowers: thy wise men, O Sor, who were in thee, these were thy pilots."],["9",[["Οἱ",1,128],["πρεσβύτεροι",332,51],["Βιβλίων",339,45],["καὶ",2,8],["οἱ",1,128],["σοφοὶ",324,130],["αὐτῶν",3,41],["οἳ",1,128],["ἦσαν",10,129],["ἐν",4,1],["σοί",5,151],["οὗτοι",16,213],["ἐνίσχυον",987,129],["τὴν",1,9],["βουλήν",350,10],["σου",5,146],["καὶ",2,8],["πάντα",11,65],["τὰ",1,42],["πλοῖα",1169,43],["τῆς",1,18],["θαλάσσης",137,19],["καὶ",2,8],["οἱ",1,128],["κωπηλάται",3570,51],["αὐτῶν",3,41],["ἐγένοντό",30,184],["σοι",5,151],["ἐπὶ",9,1],["δυσμὰς",882,40],["δυσμῶν",882,61]],"The elders of the Biblians, and their wise men, who were in thee, these helped thy counsel: and all the ships of the sea and their rowers traded for thee to the ut