,66,15]],"And, behold, two great serpents came forth, both ready for conflict, and there came from them a great voice,"],["1f",[["καὶ",2,8],["τῇ",1,95],["φωνῇ",95,2],["αὐτῶν",3,41],["ἡτοιμάσθη",371,38],["πᾶν",11,29],["ἔθνος",60,33],["εἰς",8,1],["πόλεμον",163,7],["ὥστε",346,17],["πολεμῆσαι",305,100],["δικαίων",153,163],["ἔθνος",60,33]],"and by their voice every nation was prepared for battle, even to fight against the nation of the just."],["1g",[["Καὶ",2,8],["ἰδοὺ",51,17],["ἡμέρα",28,13],["σκότους",506,31],["καὶ",2,8],["γνόφου",1504,21],["θλιψις",438,13],["καὶ",2,8],["στενοχωρία",2379,13],["κάκωσις",2091,13],["καὶ",2,8],["τάραχος",3980,5],["μέγας",66,16],["ἐπὶ",9,1],["τῆς",1,18],["γῆς",26,19]],"And, behold, a day of darkness and blackness, tribulation and anguish, affliction and great tumult upon the earth."],["1h",[["Καὶ",2,8],["ἐταράχθη",508,38],["πᾶν",11,29],["ἔθνος",60,33],["δίκαιον",153,29],["φοβούμενοι",134,581],["τὰ",1,42],["ἑαυτῶν",92,41],["κακὰ",161,65],["καὶ",2,8],["ἡτοιμάσθησαν",371,94],["ἀπολέσθαι",596,103],["καὶ",2,8],["ἐβόησαν",366,129],["πρὸς",15,1],["τὸν",1,6],["Θεόν",20,7]],"And all the righteous nation was troubled, fearing their own afflictions; and they prepared to die, and cried to God:"],["1i",[["ἀπὸ",17,1],["δὲ",14,12],["τῆς",1,18],["βοῆς",366,145],["αὐτῶν",3,41],["ἐγένετο",30,26],["ὡσανεὶ",9953,12],["ἀπὸ",17,1],["μικρᾶς",367,78],["πηγῆς",565,19],["ποταμὸς",249,5],["μέγας",66,16],["ὕδωρ",85,33],["πολύ",74,29]],"and from their cry there came as it were a great river from a little fountain, [even] much water."],["1k",[["Καὶ",2,8],["φῶς",380,20],["και",2,8],["ὁ",1,4],["ἥλιος",323,5],["ἀνέτειλε",900,3],["καὶ",2,8],["οἱ",1,128],["ταπεινοὶ",322,166],["ὑψώθησαν",331,94],["καὶ",2,8],["κατέφαγον",407,147],["τοὺς",1,56],["ἐνδόξους",732,58]],"And light and the sun arose, and the lowly were exalted, and devoured the honourable."],["1l",[["Καὶ",2,8],["διεγερθεὶς",3815,206],["Μαρδοχαῖος",840,16],["ὁ",1,4],["ἑωρακὼς",112,264],["τὸ",1,32],["ἐνύπνιον",653,33],