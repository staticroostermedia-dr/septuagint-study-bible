[["1",[["Ἐν",4,1],["γὰρ",40,12],["τῷ",1,110],["δωδεκάτῳ",1622,111],["μηνὶ",296,113],["τρισκαιδεκάτῃ",2294,96],["τοῦ",1,30],["μηνός",386,21],["ὅς",24,246],["ἐστιν",10,87],["Ἀδάρ",1858,105],["παρῆν",899,14],["τὰ",1,42],["γράμματα",1668,43],["τὰ",1,42],["γραφέντα",186,327],["ὑπὸ",122,1],["τοῦ",1,30],["βασιλέως",22,21]],"For in the twelfth month, on the thirteenth day of the month which is Adar, the letters written by the king arrived."],["2",[["Ἐν",4,1],["αὐτῇ",3,99],["τῇ",1,95],["ἡμέρᾳ",28,2],["ἀπώλοντο",217,184],["οἱ",1,128],["ἀντικείμενοι",2210,351],["τοῖς",1,138],["Ἰουδαίοις",285,139],["οὐδεὶς",228,16],["γὰρ",40,12],["ἀντέστη",796,3],["φοβούμενος",134,114],["αὐτούς",3,60]],"In that day the adversaries of the Jews perished: for no one resisted, through fear of them."],["3",[["Οἱ",1,128],["γὰρ",40,12],["ἄρχοντες",96,51],["τῶν",1,76],["σατραπῶν",1333,77],["καὶ",2,8],["οἱ",1,128],["τύραννοι",784,51],["καὶ",2,8],["οἱ",1,128],["βασιλικοὶ",1298,130],["γραμματεῖς",632,31],["ἐτίμων",1020,129],["τοὺς",1,56],["Ἰουδαίους",285,31],["ὁ",1,4],["γὰρ",40,12],["φόβος",333,5],["Μαρδοχαίου",840,153],["ἐνέκειτο",5353,22],["αὐτοῖς",3,142]],"For the chiefs of the satraps, and the princes and the royal scribes, honoured the Jews; for the fear of Mardochæus lay upon them."],["4",[["Προσέπεσε",1737,3],["γὰρ",40,12],["τὸ",1,32],["πρόσταγμα",393,33],["τοῦ",1,30],["βασιλέως",22,21],["ὀνομασθῆναι",1662,175],["ἐν",4,1],["πάσῃ",11,96],["τῇ",1,95],["βασιλείᾳ",157,2]],"For the order of the king was in force, that he should be celebrated in all the kingdom."],["6",[["Καὶ",2,8],["ἐν",4,1],["Σούσοις",2245,92],["τῇ",1,95],["πόλει",41,2],["ἀπέκτειναν",300,141],["οἱ",1,128],["Ἰουδαῖοι",285,51],["ἄνδρας",38,31],["πεντακοσίους",818,58]],"And in the city Susa the Jews slew five hundred men:"],["7",[["τόν",1,6],["τε",209,12],["Φαρσαννὲς",0,0],["καὶ",2,8],["Δελτφὼν",0,0],["καὶ",2,8],["Φασγὰ",0,0],["καὶ",2,8],["Φαραδαθὰ",0,0]],"both Pharsannes, and Delphon and Phasga,"],["8",[["καὶ",2,8],["Βαρεὰ",1031,15],["καὶ",2,8],["Σαρβακὰ",0,0]],"and Pharadatha, and Barea, and Sarbaca,"],["9",[["καὶ",2,8],["Μαρμασιμὰ",0,0],["καὶ",2,8],["Ῥουφαῖον",0,0],["καὶ",2,8],["Ἀρσαῖον",0,0],["καὶ",2,8],["Ζαβουθαῖον",0,0]],"and Marmasima, and Ruphæus, and Arsæus, and Zabuthæus,"],["10",[["τοὺς",1,56],["δέκα",311,57],["υἱοὺς",13,31],["Ἀμὰν",901,37],["Ἀμαδάθοῦ",0,0],["Βουγαίου",5496,21],["τοῦ",1,30],["ἐχθροῦ",135,21],["τῶν",1,76],["Ἰουδαίων",285,77],["καὶ",2,8],["διήρπασαν",1160,141]],"the ten sons of Aman the son of Amadathes the Bugæan, the enemy of the Jews, and they plundered [their property] on the same day:"],["11",[["ἐν",4,1],["αὐτῇ",3,99],["τῇ",1,95],["ἡμέρᾳ",28,2],["ἐπεδόθη",2834,38],["τε",209,12],["ὁ",1,4],["ἀριθμὸς",355,5],["τῷ",1,110],["βασιλεῖ",22,113],["τῶν",1,76],["ἀπολωλότων",217,398],["ἐν",4,1],["Σούσοις",2245,92]],"and the number of them that perished in Susa was rendered to the king."],["12",[["Εἶπε",18,3],["δὲ",14,12],["ὁ",1,4],["βασιλεὺς",22,5],["πρὸς",15,1],["Ἐσθὴρ",0,0],["ἀπώλεσαν",217,141],["οἱ",1,128],["Ἰουδαῖοι",285,51],["ἐν",4,1],["Σούσοις",2245,92],["τῇ",1,95],["πόλει",41,2],["ἄνδρας",38,31],["πεντακοσίους",818,58],["ἐν",4,1],["δὲ",14,12],["τῇ",1,95],["περιχώρῳ",1687,2],["πῶς",441,12],["οἴει",1904,166],["ἐχρήσαντο",928,184],["τί",39,119],["οὖν",227,12],["ἀξιοῖς",1127,145],["ἔτι",111,17],["καὶ",2,8],["ἔσται",10,89],["σοι",5,151]],"And the king said to Esther, The Jews have slain five hundred men in the city Susa; and how, thinkest thou, have they used them in the rest of the country? What then dost thou yet ask, that it may be [done] for thee?"],["13",[["Καὶ",2,8],["εἶπεν",18,3],["Ἐσθὴρ",0,0],["τῷ",1,110],["βασιλεῖ",22,113],["δοθήτω",33,25],["τοῖς",1,138],["Ἰουδαίοις",285,139],["χρῆσθαι",928,104],["ὡσαύτως",1240,17],["τὴν",1,9],["αὔριον",857,17],["ὥστε",346,17],["τοὺς",1,56],["δέκα",311,57],["υἱοὺς",13,31],["Ἀμὰν",901,37],["κρεμάσαι",1324,433]],"And Esther said to the king, Let it be granted to the Jews so to treat them to-morrow as to hang the ten sons of Aman."],["14",[["Καὶ",2,8],["ἐπέτρεψεν",3445,3],["οὕτως",71,17],["γενέσθαι",30,103],["καὶ",2,8],["ἐξέθηκε",2316,3],["τοῖς",1,138],["Ἰουδαίοις",285,139],["τῆς",1,18],["πόλεως",41,19],["τὰ",1,42],["σώματα",454,43],["τῶν",1,76],["υἱῶν",13,77],["Ἀμὰν",901,37],["κρεμάσαι",1324,433]],"And he permitted it to be so done; and he gave up to the Jews of the city the bodies of the sons of Aman to hang."],["15",[["Καὶ",2,8],["συνήχθησαν",166,94],["οἱ",1,128],["Ἰουδαῖοι",285,51],["ἐν",4,1],["Σούσοις",2245,92],["τῇ",1,95],["τεσσαρεσκαιδεκάτῃ",1449,96],["τοῦ",1,30],["Ἀδὰρ",1858,105],["καὶ",2,8],["ἀπέκτειναν",300,141],["ἄνδρας",38,31],["τριακοσίους",673,58],["καὶ",2,8],["οὐδὲν",228,29],["διήρπασαν",1160,141]],"And the Jews assembled in Susa on the fourteenth [day] of Adar, and slew three hundred men, but plundered no property."],["16",[["Οἱ",1,128],["δὲ",14,12],["λοιποὶ",523,130],["τῶν",1,76],["Ἰουδαίων",285,77],["οἱ",1,128],["ἐν",4,1],["τῇ",1,95],["βασιλείᾳ",157,2],["συνήχθησαν",166,94],["καὶ",2,8],["ἑαυτοῖς",92,142],["ἐβοήθουν",553,129],["καὶ",2,8],["ἀνεπαύσαντο",674,184],["ἀπὸ",17,1],["τῶν",1,76],["πολεμίων",1122,163],["ἀπώλεσαν",217,141],["γὰρ",40,12],["αὐτῶν",3,41],["μυρίους",3906,58],["πεντακισχιλίους",1736,58],["τῇ",1,95],["τρισκαιδεκάτῃ",2294,96],["τοῦ",1,30],["Ἀδὰρ",1858,105],["καὶ",2,8],["οὐδὲν",228,29],["διήρπασαν",1160,141]],"And the rest of the Jews who were in the kingdom assembled, and helped one another, and obtained rest from their enemies: for they destroyed fifteen thousand of them on the thirteenth [day] of Adar, but took no spoil."],["17",[["Καὶ",2,8],["ἀνεπαύσαντο",674,184],["τῇ",1,95],["τεσσαρεσκαιδεκάτῃ",1449,96],["τοῦ",1,30],["αὐτοῦ",3,48],["μηνός",386,21],["καὶ",2,8],["ἦγον",224,129],["αὐτὴν",3,98],["ἡμέραν",28,10],["ἀναπαύσεως",1048,19],["μετὰ",29,1],["χαρᾶς",1125,19],["καὶ",2,8],["εὐφροσύνης",360,19]],"And they rested on the fourteenth of the same month, and kept it as a day of rest with joy and gladness."],["18",[["Οἱ",1,128],["δὲ",14,12],["Ἰουδαῖοι",285,51],["ἐν",4,1],["Σούσοις",2245,92],["τῇ",1,95],["πόλει",41,2],["συνήχθησαν",166,94],["καὶ",2,8],["τῇ",1,95],["τεσσαρεσκαιδεκάτῃ",1449,96],["καὶ",2,8],["ἀνεπαύσαντο",674,184],["ἦγον",224,129],["δὲ",14,12],["καὶ",2,8],["τὴν",1,9],["πεντεκαιδεκάτην",1829,37],["μετὰ",29,1],["χαρᾶς",1125,19],["καὶ",2,8],["εὐφροσύνης",360,19]],"And the Jews in the city Susa assembled also on the fourteenth [day] and rested; and they kept also the fifteenth with joy and gladness."],["19",[["Διὰ",56,1],["τοῦτο",16,122],["οὖν",227,12],["οἱ",1,128],["Ἰουδαῖοι",285,51],["οἱ",1,128],["διεσπαρμένοι",754,370],["ἐν",4,1],["πάσῃ",11,96],["χώρᾳ",278,2],["τῇ",1,95],["ἔξω",527,17],["ἄγουσι",224,191],["τὴν",1,9],["τεσσαρεσκαιδεκάτην",1449,37],["τοῦ",1,30],["Ἀδὰρ",1858,105],["ἡμέραν",28,10],["ἀγαθὴν",114,37],["μετʼ",29,1],["εὐφροσύνης",360,19],["ἀποστέλλοντες",84,137],["μερίδας",399,40],["ἕκαστος",171,16],["τῷ",1,110],["πλησίον",292,17]],"On this account then [it is that] the Jews dispersed in every foreign land keep the fourteenth of Adar [as] a holy day with joy, sending portions each to his neighbour."],["20",[["Ἔγραψεν",186,3],["δὲ",14,12],["Μαρδοχαῖος",840,16],["τοὺς",1,56],["λόγους",48,31],["τούτους",16,274],["εἰς",8,1],["βιβλίον",339,33],["καὶ",2,8],["ἐξαπέστειλε",220,3],["τοῖς",1,138],["Ἰουδαίοις",285,139],["ὅσοι",103,51],["ἦσαν",10,129],["ἐν",4,1],["τῇ",1,95],["Ἀρταξέρξου",1368,21],["βασιλείᾳ",157,2],["τοῖς",1,138],["ἐγγὺς",1026,17],["καὶ",2,8],["τοῖς",1,138],["μακράν",642,37]],"And Mardochæus wrote these things in a book, and sent them to the Jews, as many as were in the kingdom of Artaxerxes, both them that were near and them that were afar off,"],["21",[["στῆσαι",78,100],["τὰς",1,39],["ἡμέρας",28,19],["ταύτας",16,280],["ἀγαθάς",114,109],["ἄγειν",224,54],["τε",209,12],["τὴν",1,9],["τεσσαρεσκαιδεκάτην",1449,37],["καὶ",2,8],["τὴν",1,9],["πεντεκαιδεκάτην",1829,37],["τοῦ",1,30],["Ἀδάρ",1858,105]],"to establish these [as] joyful days, and to keep the fourteenth and fifteenth of Adar;"],["22",[["Ἐν",4,1],["γὰρ",40,12],["ταύταις",16,336],["ταῖς",1,70],["ἡμέραις",28,71],["ἀνεπαύσαντο",674,184],["οἱ",1,128],["Ἰουδαῖοι",285,51],["ἀπὸ",17,1],["τῶν",1,76],["ἐχθρῶν",135,77],["αὐτῶν",3,41],["καὶ",2,8],["τὸν",1,6],["μῆνα",296,7],["ἐν",4,1],["ᾧ",24,202],["ἐστράφη",1078,38],["αὐτοῖς",3,142],["ὃς",24,246],["ἦν",10,14],["Ἀδὰρ",1858,105],["ἀπὸ",17,1],["πένθους",1004,24],["εἰς",8,1],["χαρὰν",1125,10],["καὶ",2,8],["ἀπὸ",17,1],["ὀδύνης",774,19],["εἰς",8,1],["ἀγαθὴν",114,37],["ἡμέραν",28,10],["ἄγειν",224,54],["ὅλον",235,28],["ἀγαθὰς",114,109],["ἡμέρας",28,19],["γάμων",1882,77],["καὶ",2,8],["εὐφροσύνης",360,19],["ἐξαποστέλλοντας",220,229],["μερίδας",399,40],["τοῖς",1,138],["φίλοις",336,215],["καὶ",2,8],["τοῖς",1,138],["πτωχοῖς",497,139]],"for on these days the Jews obtained rest from their enemies: and [as to] the month, which was Adar, in which a change was made for them, from mourning to joy, and from sorrow to a good day, to spend the whole of it [in] good days of feasting and gladness, sending portions to their friends, and to the poor."],["23",[["Καὶ",2,8],["προσεδέξαντο",1019,184],["οἱ",1,128],["Ἰουδαῖοι",285,51],["καθὼς",221,17],["ἔγραψεν",186,3],["αὐτοῖς",3,142],["ὁ",1,4],["Μαρδοχαῖος",840,16]],"And the Jews consented [to this] accordingly as Mardochæus wrote to them,"],["24",[["Πῶς",441,12],["Ἀμὰν",901,37],["Ἀμαδαθοῦ",0,0],["ὁ",1,4],["Μακεδὼν",3238,5],["ἐπολέμει",305,14],["αὐτοὺς",3,60],["καθὼς",221,17],["ἔθετο",110,26],["ψήφισμα",3677,20],["καὶ",2,8],["κλῆρον",408,7],["ἀφανίσαι",623,100],["αὐτοὺς",3,60]],"[shewing] how Aman the son of Amadathes the Macedonian fought against them, how he made a decree and cast lots to destroy them utterly;"],["25",[["καὶ",2,8],["ὡς",36,8],["εἰσῆλθε",86,3],["πρὸς",15,1],["τὸν",1,6],["βασιλέα",22,7],["λέγων",31,67],["κρεμάσαι",1324,433],["τὸν",1,6],["Μαρδοχαῖον",840,59],["ὅσα",103,63],["δὲ",14,12],["ἐπεχείρησεν",2541,3],["ἐπάξαι",417,100],["ἐπὶ",9,1],["τοὺς",1,56],["Ἰουδαίους",285,31],["κακὰ",161,65],["ἐπʼ",9,1],["αὐτὸν",3,82],["ἐγένοντο",30,184],["καὶ",2,8],["ἐκρεμάσθη",1324,38],["αὐτὸς",3,158],["καὶ",2,8],["τὰ",1,42],["τέκνα",192,43],["αὐτοῦ",3,48]],"also how he went in to the king, telling [him] to hang Mardochæus: but all the calamities he tried to bring upon the Jews came upon himself, and he was hanged, and his children."],["26",[["Διὰ",56,1],["τοῦτο",16,122],["ἐπεκλήθησαν",341,94],["αἱ",1,185],["ἡμέραι",28,2],["αὗται",16,196],["Φρουραὶ",2045,180],["διὰ",56,1],["τοὺς",1,56],["κλήρους",408,31],["ὅτι",19,8],["τῇ",1,95],["διαλέκτῳ",7070,2],["αὐτῶν",3,41],["καλοῦνται",128,127],["Φρουραί",2045,180],["διὰ",56,1],["τοὺς",1,56],["λόγους",48,31],["τῆς",1,18],["ἐπιστολῆς",866,19],["ταύτης",16,290],["καὶ",2,8],["ὅσα",103,63],["πεπόνθασι",1972,400],["διὰ",56,1],["ταῦτα",16,248],["καὶ",2,8],["ὅσα",103,43],["αὐτοῖς",3,142],["ἐγένετο",30,26]],"Therefore these days were called Phruræ, because of the lots; (for in their language they are called Phruræ;) because of the words of this letter, and [because of] all they suffered on this account, and all that happened to them."],["27",[["καὶ",2,8],["ἔστησε",78,3],["καὶ",2,8],["προσεδέχοντο",1019,131],["οἱ",1,128],["Ἰουδαῖοι",285,51],["ἐφʼ",9,1],["ἑαυτοῖς",92,142],["καὶ",2,8],["ἐπὶ",9,1],["τῷ",1,52],["σπέρματι",218,53],["αὐτῶν",3,41],["καὶ",2,8],["ἐπὶ",9,1],["τοῖς",1,138],["προστεθειμένοις",201,437],["ἐπʼ",9,1],["αὐτῶν",3,41],["οὐδὲ",106,12],["μὴν",296,12],["ἄλλως",2817,17],["χρήσονται",928,127],["αἱ",1,185],["δὲ",14,12],["ἡμέραι",28,2],["αὗται",16,196],["μνημόσυνον",716,33],["ἐπιτελούμενον",1706,205],["κατὰ",32,1],["γενεὰν",286,10],["καὶ",2,8],["γενεὰν",286,10],["καὶ",2,8],["πόλιν",41,10],["καὶ",2,8],["πατριὰν",338,10],["καὶ",2,8],["χώραν",278,10]],"And [Mardochæus] established it, and the Jews took upon themselves, and upon their seed, and upon those that were joined to them [to observe it], neither would they on any account behave differently: but these days [were to be] a memorial kept in every generation, and city, and family, and province."],["28",[["Αἱ",1,185],["δὲ",14,12],["ἡμέραι",28,2],["αὗται",16,196],["τῶν",1,76],["Φρουραὶ",2045,180],["ἀχθήσονται",224,135],["εἰς",8,1],["τὸν",1,6],["ἅπαντα",772,59],["χρόνον",486,7],["καὶ",2,8],["τὸ",1,32],["μνημόσυνον",716,33],["αὐτῶν",3,41],["οὐ",12,17],["μὴ",25,8],["ἐκλίπῃ",321,160],["ἐκ",21,1],["τῶν",1,123],["γενεῶν",286,61]],"And these days of the Phruræ, [said they], shall be kept for ever, and their memorial shall not fail in any generation."],["29",[["Καὶ",2,8],["ἔγραψεν",186,3],["Ἐσθὴρ",0,0],["ἡ",1,11],["βασίλισσα",1265,13],["θυγάτηρ",97,13],["Ἀμιναδὰβ",1487,105],["καὶ",2,8],["Μαρδοχαῖος",840,16],["ὁ",1,4],["Ἰουδαῖος",285,5],["ὅσα",103,63],["ἐποίησαν",23,141],["τό",1,32],["τε",209,12],["στερέωμα",1479,33],["τῆς",1,18],["ἐπιστολῆς",866,19],["τῶν",1,76],["Φρουραί",2045,180]],"And queen Esther, the daughter of Aminadab, and Mardochæus the Jew, wrote all that they had done, and the confirmation of the letter of Phruræ."],["31",[["Καὶ",2,8],["Μαρδοχαῖος",840,16],["καὶ",2,8],["Ἐσθὴρ",0,0],["ἡ",1,11],["βασίλισσα",1265,13],["ἔστησαν",78,141],["ἑαυτοῖς",92,142],["καθʼ",32,1],["ἑαυτῶν",92,41],["καὶ",2,8],["τότε",250,17],["στήσαντες",78,190],["κατὰ",32,1],["τῆς",1,18],["ὑγιείας",2687,19],["ἑαυτῶν",92,41],["καὶ",2,8],["τὴν",1,9],["βουλὴν",350,10],["αὐτῶν",3,41]],"And Mardochæus and Esther the queen appointed [a fast] for themselves privately, even at that time also having formed their plan against their own health."],["32",[["Καὶ",2,8],["Ἐσθὴρ",0,0],["λόγῳ",48,113],["ἔστησεν",78,3],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["καὶ",2,8],["ἐγράφη",186,38],["εἰς",8,1],["μνημόσυνον",716,33]],"And Esther established it by a command for ever, and it was written for a memorial."]]