[["1",[["Ἐν",4,1],["γὰρ",40,12],["τῷ",1,110],["δωδεκάτῳ",1621,111],["μηνὶ",295,113],["τρισκαιδεκάτῃ",2306,96],["τοῦ",1,30],["μηνός",381,21],["ὅς",24,247],["ἐστιν",10,87],["Ἀδάρ",1857,105],["παρῆν",900,14],["τὰ",1,42],["γράμματα",1670,43],["τὰ",1,42],["γραφέντα",186,330],["ὑπὸ",122,1],["τοῦ",1,30],["βασιλέως",22,21]],"For in the twelfth month, on the thirteenth day of the month which is Adar, the letters written by the king arrived."],["2",[["Ἐν",4,1],["αὐτῇ",3,99],["τῇ",1,95],["ἡμέρᾳ",28,2],["ἀπώλοντο",213,182],["οἱ",1,128],["ἀντικείμενοι",2222,356],["τοῖς",1,138],["Ἰουδαίοις",285,139],["οὐδεὶς",225,16],["γὰρ",40,12],["ἀντέστη",793,3],["φοβούμενος",134,114],["αὐτούς",3,60]],"In that day the adversaries of the Jews perished: for no one resisted, through fear of them."],["3",[["Οἱ",1,128],["γὰρ",40,12],["ἄρχοντες",96,51],["τῶν",1,76],["σατραπῶν",1332,77],["καὶ",2,8],["οἱ",1,128],["τύραννοι",784,51],["καὶ",2,8],["οἱ",1,128],["βασιλικοὶ",1298,130],["γραμματεῖς",630,31],["ἐτίμων",1043,129],["τοὺς",1,56],["Ἰουδαίους",285,31],["ὁ",1,4],["γὰρ",40,12],["φόβος",330,5],["Μαρδοχαίου",841,153],["ἐνέκειτο",5382,22],["αὐτοῖς",3,142]],"For the chiefs of the satraps, and the princes and the royal scribes, honoured the Jews; for the fear of Mardochæus lay upon them."],["4",[["Προσέπεσε",1780,3],["γὰρ",40,12],["τὸ",1,32],["πρόσταγμα",391,33],["τοῦ",1,30],["βασιλέως",22,21],["ὀνομασθῆναι",1663,174],["ἐν",4,1],["πάσῃ",11,96],["τῇ",1,95],["βασιλείᾳ",157,2]],"For the order of the king was in force, that he should be celebrated in all the kingdom."],["6",[["Καὶ",2,8],["ἐν",4,1],["Σούσοις",2260,92],["τῇ",1,95],["πόλει",41,2],["ἀπέκτειναν",298,141],["οἱ",1,128],["Ἰουδαῖοι",285,51],["ἄνδρας",38,31],["πεντακοσίους",816,58]],"And in the city Susa the Jews slew five hundred men:"],["7",[["τόν",1,6],["τε",207,12],["Φαρσαννὲς",0,0],["καὶ",2,8],["Δελτφὼν",0,0],["καὶ",2,8],["Φασγὰ",0,0],["καὶ",2,8],["Φαραδαθὰ",0,0]],"both Pharsannes, and Delphon and Phasga,"],["8",[["καὶ",2,8],["Βαρεὰ",1028,15],["καὶ",2,8],["Σαρβακὰ",0,0]],"and Pharadatha, and Barea, and Sarbaca,"],["9",[["καὶ",2,8],["Μαρμασιμὰ",0,0],["καὶ",2,8],["Ῥουφαῖον",0,0],["καὶ",2,8],["Ἀρσαῖον",0,0],["καὶ",2,8],["Ζαβουθαῖον",0,0]],"and Marmasima, and Ruphæus, and Arsæus, and Zabuthæus,"],["10",[["τοὺς",1,56],["δέκα",310,57],["υἱοὺς",13,31],["Ἀμὰν",903,37],["Ἀμαδάθοῦ",0,0],["Βουγαίου",5527,21],["τοῦ",1,30],["ἐχθροῦ",135,21],["τῶν",1,76],["Ἰουδαίων",285,77],["καὶ",2,8],["διήρπασαν",1181,141]],"the ten sons of Aman the son of Amadathes the Bugæan, the enemy of the Jews, and they plundered [their property] on the same day:"],["11",[["ἐν",4,1],["αὐτῇ",3,99],["τῇ",1,95],["ἡμέρᾳ",28,2],["ἐπεδόθη",2847,38],["τε",207,12],["ὁ",1,4],["ἀριθμὸς",353,5],["τῷ",1,110],["βασιλεῖ",22,113],["τῶν",1,76],["ἀπολωλότων",213,403],["ἐν",4,1],["Σούσοις",2260,92]],"and the number of them that perished in Susa was rendered to the king."],["12",[["Εἶπε",18,3],["δὲ",14,12],["ὁ",1,4],["βασιλεὺς",22,5],["πρὸς",15,1],["Ἐσθὴρ",0,0],["ἀπώλεσαν",213,141],["οἱ",1,128],["Ἰουδαῖοι",285,51],["ἐν",4,1],["Σούσοις",2260,92],["τῇ",1,95],["πόλει",41,2],["ἄνδρας",38,31],["πεντακοσίους",816,58],["ἐν",4,1],["δὲ",14,12],["τῇ",1,95],["περιχώρῳ",1690,2],["πῶς",440,12],["οἴει",1904,166],["ἐχρήσαντο",927,182],["τί",39,119],["οὖν",223,12],["ἀξιοῖς",1126,145],["ἔτι",110,17],["καὶ",2,8],["ἔσται",10,89],["σοι",5,151]],"And the king said to Esther, The Jews have slain five hundred men in the city Susa; and how, thinkest thou, have they used them in the rest of the country? What then dost thou yet ask, that it may be [done] for thee?"],["13",[["Καὶ",2,8],["εἶπεν",18,3],["Ἐσθὴρ",0,0],["τῷ",1,110],["βασιλεῖ",22,113],["δοθήτω",33,25],["τοῖς",1,138],["Ἰουδαίοις",285,139],["χρῆσθαι",927,104],["ὡσαύτως",1242,17],["τὴν",1,9],["αὔριον",857,17],["ὥστε",345,17],["τοὺς",1,56],["δέκα",310,57],["υἱοὺς",13,31],["Ἀμὰν",903,37],["κρεμάσαι",1380,440]],"And Esther said to the king, Let it be granted to the Jews so to treat them to-morrow as to hang the ten sons of Aman."],["14",