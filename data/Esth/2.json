[["1",[["Καὶ",2,8],["μετὰ",29,1],["τοὺς",1,56],["λόγους",48,31],["τούτους",16,274],["ἐκόπασεν",1628,3],["ὁ",1,4],["βασιλεὺς",22,5],["τοῦ",1,30],["θυμοῦ",178,21],["καὶ",2,8],["οὐκ",12,17],["ἔτι",111,17],["ἐμνήσθη",230,38],["τῆς",1,18],["Ἀστίν",12091,0],["μνημονεύων",1900,67],["οἷα",2031,63],["ἐλάλησε",50,3],["καὶ",2,8],["ὡς",36,8],["κατέκρινεν",3848,3],["αὐτήν",3,98]],"And after this the king's anger was pacified, and he no more mentioned Astin, bearing in mind what she had said, and how he had condemned her."],["2",[["Καὶ",2,8],["εἶπαν",18,141],["οἱ",1,128],["διάκονοι",3263,51],["τοῦ",1,30],["βασιλέως",22,21],["ζητηθήτω",191,25],["τῷ",1,110],["βασιλεῖ",22,113],["κοράσια",1552,63],["ἄφθορα",9216,74],["καλὰ",266,74],["τῷ",1,52],["εἴδει",949,53]],"Then the servants of the king said, Let there be sought for the king chaste [and] beautiful young virgins."],["3",[["Καὶ",2,8],["καταστήσει",314,120],["ὁ",1,4],["βασιλεὺς",22,5],["κωμάρχας",7534,31],["ἐν",4,1],["πάσαις",11,287],["ταῖς",1,70],["χώραις",278,71],["τῆς",1,18],["βασιλείας",157,19],["αὐτοῦ",3,48],["καὶ",2,8],["ἐπιλεξάτωσαν",1657,261],["κοράσια",1552,63],["παρθενικὰ",5912,63],["καλὰ",266,74],["τῷ",1,52],["εἴδει",949,53],["εἰς",8,1],["Σοῦσαν",15438,73],["τὴν",1,9],["πόλιν",41,10],["εἰς",8,1],["τὸν",1,6],["γυναικῶνα",4188,7],["καὶ",2,8],["παραδοθήτωσαν",254,50],["τῷ",1,110],["εὐνούχῳ",1163,113],["τοῦ",1,30],["βασιλέως",22,21],["τῷ",1,110],["φύλακι",2202,113],["τῶν",1,123],["γυναικῶν",59,61],["καὶ",2,8],["δοθήτω",33,25],["σμῆγμα",4392,20],["καὶ",2,8],["ἡ",1,11],["λοιπὴ",523,15],["ἐπιμέλεια",2835,13]],"And let the king appoint local governors in all the provinces of his kingdom, and let them select fair [and] chaste young damsels [and bring them] to the city Susa, into the women's apartment, and let them be consigned to the king's chamberlain, the keeper of the women; and let things for purification and other attendance be given [to them]."],["4",[["Καὶ",2,8],["ἡ",1,11],["γυνὴ",59,13],["ἣ",1,11],["ἂν",83,12],["ἀρέσῃ",955,160],["τῷ",1,110],["βασιλεῖ",22,113],["βασιλεύσει",151,120],["ἀντὶ",158,1],["Ἀστίν",12091,0],["καὶ",2,8],["ἤρεσε",955,3],["τῷ",1,110],["βασιλεῖ",22,113],["τὸ",1,32],["πρᾶγμα",511,33],["καὶ",2,8],["ἐποίησεν",23,3],["οὕτως",71,17]],"And let the woman who shall please the king be queen instead of Astin. And the thing pleased the king; and he did so."],["5",[["Καὶ",2,8],["ἄνθρωπος",43,5],["ἦν",10,14],["Ἰουδαῖος",285,5],["ἐν",4,1],["Σούσοις",2245,92],["τῇ",1,95],["πόλει",41,2],["καὶ",2,8],["ὄνομα",57,33],["αὐτοῦ",3,48],["Μαρδοχαῖος",11560,16],["ὁ",1,4],["τοῦ",1,30],["Ἰαΐρου",0,0],["τοῦ",1,30],["Σεμείου",0,0],["τοῦ",1,30],["Κισαίου",15439,0],["ἐκ",21,1],["φυλῆς",142,19],["Βενιαμίν",358,105]],"Now there was a Jew in the city Susa, and his name was Mardochæus, the [son] of Jairus, [the son] of Semeias, [the son] of Cisæus, of the tribe of Benjamin;"],["6",[["ὃς",24,246],["ἦν",10,14],["αἰχμάλωτος",1617,5],["ἐξ",21,1],["Ἱερουσαλὴμ",70,20],["ἣν",24,124],["ᾐχμαλώτευσε",1110,3],["Ναβουχοδονόσορ",11547,0],["βασιλεὺς",22,5],["Βαβυλῶνος",204,19]],"who had been brought a prisoner from Jerusalem, which Nabuchodonosor king of Babylon had carried into captivity."],["7",[["Καὶ",2,8],["ἦν",10,14],["τούτῳ",16,279],["παῖς",127,5],["θρεπτή",7258,13],["θυγάτηρ",97,13],["Ἀμιναδὰβ",1487,105],["ἀδελφοῦ",67,21],["πατρὸς",44,21],["αὐτοῦ",3,48],["καὶ",2,8],["ὄνομα",57,33],["αὐτῇ",3,99],["Ἐσθήρ",0,0],["ἐν",4,1],["δὲ",14,12],["τῷ",1,110],["μεταλλάξαι",2465,100],["αὐτῆς",3,83],["τοὺς",1,56],["γονεῖς",2012,31],["ἐπαίδευσεν",643,3],["αὐτὴν",3,98],["ἑαυτῷ",92,49],["εἰς",8,1],["γυναῖκα",59,10],["καὶ",2,8],["ἦν",10,14],["τὸ",1,32],["κοράσιον",1552,33],["καλὸν",266,29],["τῷ",1,52],["εἴδει",949,53]],"And he had a foster-child, daughter of Aminadab his father's brother, and her name [was] Esther; and when her parents were dead, he brought her up for a wife for himself: and the damsel was beautiful."],["8",[["Καὶ",2,8],["ὅτε",432,8],["ἠκούσθη",54,38],["τὸ",1,32],["τοῦ",1,30],["βασιλέως",22,21],["πρόσταγμα",