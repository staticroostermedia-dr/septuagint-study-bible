[["1",[["Μνήσθητι",231,242],["Κύριε",7,251],["ὅ",1,4],["τι",39,119],["ἐγενήθη",30,38],["ἡμῖν",6,142],["ἐπίβλεψον",516,198],["καὶ",2,8],["ἴδε",693,17],["τὸν",1,6],["ὀνειδισμὸν",732,7],["ἡμῶν",6,41]],"Remember, O Lord, what has happened to us: behold, and look on our reproach."],["2",[["Κληρονομία",297,13],["ἡμῶν",6,41],["μετεστράθη",0,0],["ἀλλοτρίοις",377,215],["οἱ",1,128],["οἶκοι",34,51],["ἡμῶν",6,41],["ξένοις",1830,215]],"Our inheritance has been turned away to aliens, our houses to strangers:"],["3",[["Ὀρφανοὶ",959,130],["ἐγενήθημεν",30,498],["οὐχ",12,17],["ὑπάρχει",416,87],["πατὴρ",44,5],["μητέρες",188,179],["ἡμῶν",6,41],["ὡς",36,8],["αἱ",1,183],["χῆραι",749,179]],"we are become orphans, we have no father, our mothers are as widows."],["4",[["Ὕδωρ",85,33],["ἡμῶν",6,41],["ἐν",4,1],["ἀργυρίῳ",150,53],["ἐπίομεν",215,288],["ξύλα",196,63],["ἡμῶν",6,41],["ἐν",4,1],["ἀλλάγματι",2828,53],["ἦλθεν",56,3],["ἐπὶ",9,1],["τὸν",1,6],["τράχηλον",690,7],["ἡμῶν",6,41]],"We have drunk our water for money; our wood is sold to us [for a burden] on our neck:"],["5",[["ἐδιώχθημεν",530,498],["ἐκοπιάσαμεν",0,0],["οὐκ",12,17],["ἀνεπαύθημεν",670,498]],"we have been persecuted, we have laboured, we have had no rest."],["6",[["Αἴγυπτος",93,13],["ἔδωκε",33,3],["χεῖρα",37,10],["Ἀσσοὺρ",0,0],["εἰς",8,1],["πλησμονὴν",1522,10],["αὐτῶν",3,41]],"Egypt gave the hand [to us], Assur to their own satisfaction."],["7",[["Οἱ",1,128],["πατέρες",44,51],["ἡμῶν",6,41],["ἥμαρτον",244,147],["οὐχ",12,17],["ὑπάρχουσιν",416,479],["ἡμεῖς",6,193],["τὰ",1,42],["ἀνομήματα",2224,43],["αὐτῶν",3,41],["ὑπέσχομεν",5456,288]],"Our fathers sinned, [and] are not: we have borne their iniquities."],["8",[["Δοῦλοι",136,51],["ἐκυρίευσαν",886,141],["ἡμῶν",6,41],["λυτρούμενος",548,114],["οὐκ",12,17],["ἔστιν",10,87],["ἐκ",21,1],["τῆς",1,18],["χειρὸς",37,19],["αὐτῶν",3,41]],"Servants have ruled over us: there is none to ransom [us] out of their hand."],["9",[["Ἐν",4,1],["ταῖς",1,70],["ψυχαῖς",62,71],["ἡμῶν",6,41],["εἰσοίσομεν",584,269],["ἄρτον",197,7],["ἡμῶν",6,41],["ἀπὸ",17,1],["προσώπου",47,24],["ῥομφαίας",247,19],["τῆς",1,18],["ἐρήμου",160,78]],"We shall bring in our bread with [danger of] our lives, because of the sword of the wilderness."],["10",[["Τὸ",1,32],["δέρμα",665,33],["ἡμῶν",6,41],["ὡς",36,8],["κλίβανος",2596,5],["ἐπελιώθη",7976,253],["συνεσπάσθησαν",8506,94],["ἀπὸ",17,1],["προσώπου",47,24],["καταιγίδων",1470,61],["λιμοῦ",500,21]],"Our skin is blackened like an oven; they are convulsed, because of the storms of famine."],["11",[["Γυναῖκας",58,40],["ἐν",4,1],["Σιὼν",331,2],["ἐταπείνωσαν",333,141],["παρθένους",787,40],["ἐν",4,1],["πόλεσιν",41,71],["Ἰούδα",61,21]],"They humbled the women in Sion, the virgins in the cities of Juda."],["12",[["Ἄρχοντες",96,51],["ἐν",4,1],["χερσὶν",37,71],["αὐτῶν",3,41],["ἐκρεμάσθησαν",1380,94],["πρεσβύτεροι",329,51],["οὐκ",12,17],["ἐδοξάσθησαν",465,94]],"Princes were hanged up by their hands: the elders were not honoured."],["13",[["Ἐκλεκτοὶ",551,130],["κλαυθμὸν",1207,7],["ἀνέλαβον",573,141],["καὶ",2,8],["νεανίσκοι",568,51],["ἐν",4,1],["ξύλῳ",196,53],["ἠσθένησαν",768,141]],"The chosen men lifted up [the voice in] weeping, and the youths fainted under the wood."],["14",[["Καὶ",2,8],["πρεσβύται",1097,113],["ἀπὸ",17,1],["πύλης",162,19],["κατέπαυσαν",777,141],["ἐκλεκτοὶ",551,130],["ἐκ",21,1],["ψαλμῶν",639,77],["αὐτῶν",3,41],["κατέπαυσαν",777,141]],"And the elders ceased from the gate, the chosen men ceased from their music."],["15",[["Κατέλυσε",861,3],["χαρὰ",1124,13],["καρδίας",63,19],["ἡμῶν",6,41],["ἐστράφη",1079,38],["εἰς",8,1],["πένθος",1004,33],["ὁ",1,4],["χορὸς",1846,5],["ἡμῶν",6,41]],"The joy of our heart has ceased; our dance is turned into mourning."],["16",[["Ἔπεσεν",154,3],["ὁ",1,4],["στέφανος",979,5],["ἡμῶν",6,41],["τῆς",1,18],["κεφαλῆς",144,19],["οὐαὶ",766,320],["δὲ",14,12],["ἡμῖν",6,142],["ὅτι",19,8],["ἡμάρτομεν",244,288]],"The crown has fallen [from] our head: yea, woe to us! for we have sinned."],["17",[["Περὶ",71,1],["τούτου",16,126],["ἐγενήθη",30,38],["ὀδύνη",771,13],["ὀδυνηρὰ",4135,15],["ἡ",1,11],["καρδία",63,13],["ἡμῶν",6,41],["περὶ",71,1],["τούτου",16,126],["ἐσκότασαν",3961,129],["οἱ",1,128],["ὀφθαλμοὶ",91,51],["ἡμῶν",6,41]],"For this has grief come; our heart is sorrowful: for this our eyes are darkened."],["18",[["Ἐπʼ",9,1],["ὄρος",86,33],["Σιὼν",331,2],["ὅτι",19,8],["ἠφανίσθη",675,38],["ἀλώπεκες",3165,179],["διῆλθον",427,141],["ἐν",4,1],["αὐτῇ",3,99]],"Over the mountain of Sion, because it is made desolate, foxes have walked therein."],["19",[["Σὺ",5,156],["δὲ",14,12],["Κύριε",7,251],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["κατοικήσεις",90,159],["ὁ",1,4],["θρόνος",379,5],["σου",5,146],["εἰς",8,1],["γενεὰν",286,10],["καὶ",2,8],["γενεάν",286,10]],"But thou, O Lord, shalt dwell for ever; thy throne [shall endure] to generation and generation."],["20",[["Ἱνατί",101,238],["εἰς",8,1],["νῖκος",2107,20],["ἐπιλήσῃ",512,116],["ἡμῶν",6,41],["καταλείψεις",255,159],["ἡμᾶς",6,60],["εἰς",8,1],["μακρότητα",3091,10],["ἡμερῶν",28,61]],"Wherefore wilt thou utterly forget us, and abandon us a long time?"],["21",[["Ἐπίστρεψον",116,198],["ἡμᾶς",6,60],["Κύριε",7,251],["πρὸς",15,1],["σὲ",5,161],["καὶ",2,8],["ἐπιστραφησόμεθα",116,353],["καὶ",2,8],["ἀνακαίνισον",4028,198],["ἡμέρας",28,19],["ἡμῶν",6,41],["καθὼς",218,17],["ἔμπροσθεν",387,17]],"Turn us, O Lord, to thee, and we shall be turned; and renew our days as before."],["22",[["Ὅτι",19,8],["ἀπωθούμενος",767,114],["ἀπώσω",767,157],["ἡμᾶς",6,60],["ὠργίσθης",725,363],["ἐφʼ",9,1],["ἡμᾶς",6,60],["ἕως",42,8],["σθόδρα",0,0]],"For thou hast indeed rejected us; thou hast been very wroth against us."]]