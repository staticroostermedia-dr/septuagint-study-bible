[["1",[["Μνήσθητι",230,242],["Κύριε",7,250],["ὅ",1,4],["τι",39,119],["ἐγενήθη",30,38],["ἡμῖν",6,142],["ἐπίβλεψον",517,198],["καὶ",2,8],["ἴδε",713,17],["τὸν",1,6],["ὀνειδισμὸν",733,7],["ἡμῶν",6,41]],"Remember, O Lord, what has happened to us: behold, and look on our reproach."],["2",[["Κληρονομία",299,13],["ἡμῶν",6,41],["μετεστράθη",0,0],["ἀλλοτρίοις",381,215],["οἱ",1,128],["οἶκοι",34,51],["ἡμῶν",6,41],["ξένοις",1828,215]],"Our inheritance has been turned away to aliens, our houses to strangers:"],["3",[["Ὀρφανοὶ",957,130],["ἐγενήθημεν",30,491],["οὐχ",12,17],["ὑπάρχει",418,87],["πατὴρ",44,5],["μητέρες",189,180],["ἡμῶν",6,41],["ὡς",36,8],["αἱ",1,185],["χῆραι",751,180]],"we are become orphans, we have no father, our mothers are as widows."],["4",[["Ὕδωρ",85,33],["ἡμῶν",6,41],["ἐν",4,1],["ἀργυρίῳ",152,53],["ἐπίομεν",212,285],["ξύλα",196,63],["ἡμῶν",6,41],["ἐν",4,1],["ἀλλάγματι",2816,53],["ἦλθεν",55,3],["ἐπὶ",9,1],["τὸν",1,6],["τράχηλον",692,7],["ἡμῶν",6,41]],"We have drunk our water for money; our wood is sold to us [for a burden] on our neck:"],["5",[["ἐδιώχθημεν",533,491],["ἐκοπιάσαμεν",921,285],["οὐκ",12,17],["ἀνεπαύθημεν",674,491]],"we have been persecuted, we have laboured, we have had no rest."],["6",[["Αἴγυπτος",93,13],["ἔδωκε",33,3],["χεῖρα",37,10],["Ἀσσοὺρ",0,0],["εἰς",8,1],["πλησμονὴν",1524,10],["αὐτῶν",3,41]],"Egypt gave the hand [to us], Assur to their own satisfaction."],["7",[["Οἱ",1,128],["πατέρες",44,51],["ἡμῶν",6,41],["ἥμαρτον",237,147],["οὐχ",12,17],["ὑπάρχουσιν",418,471],["ἡμεῖς",6,195],["τὰ",1,42],["ἀνομήματα",2212,43],["αὐτῶν",3,41],["ὑπέσχομεν",5425,285]],"Our fathers sinned, [and] are not: we have borne their iniquities."],["8",[["Δοῦλοι",136,51],["ἐκυρίευσαν",885,141],["ἡμῶν",6,41],["λυτρούμενος",535,114],["οὐκ",12,17],["ἔστιν",10,87],["ἐκ",21,1],["τῆς",1,18],["χειρὸς",37,19],["αὐτῶν",3,41]],"Servants have ruled over us: there is none to ransom [us] out of their hand."],["9",[["Ἐν",4,1],["ταῖς",1,70],["ψυχαῖς",63,71],["ἡμῶν",6,41],["εἰσοίσομεν",587,269],["ἄρτον",197,7],["ἡμῶν",6,41],["ἀπὸ",17,1],["προσώπου",47,24],["ῥομφαίας",248,19],["τῆς",1,18],["ἐρήμου",160,78]],"We shall bring in our bread with [danger of] our lives, because of the sword of the wilderness."],["10",[["Τὸ",1,32],["δέρμα",669,33],["ἡμῶν",6,41],["ὡς",36,8],["κλίβανος",2592,5],["ἐπελιώθη",7915,252],["συνεσπάσθησαν",8447,94],["ἀπὸ",17,1],["προσώπου",47,24],["καταιγίδων",1470,61],["λιμοῦ",503,21]],"Our skin is blackened like an oven; they are convulsed, because of the storms of famine."],["11",[["Γυναῖκας",59,40],["ἐν",4,1],["Σιὼν",334,2],["ἐταπείνωσαν",322,141],["παρθένους",789,40],["ἐν",4,1],["πόλεσιν",41,71],["Ἰούδα",62,21]],"They humbled the women in Sion, the virgins in the cities of Juda."],["12",[["Ἄρχοντες",96,51],["ἐν",4,1],["χερσὶν",37,71],["αὐτῶν",3,41],["ἐκρεμάσθησαν",1324,94],["πρεσβύτεροι",332,51],["οὐκ",12,17],["ἐδοξάσθησαν",452,94]],"Princes were hanged up by their hands: the elders were not honoured."],["13",[["Ἐκλεκτοὶ",552,130],["κλαυθμὸν",1203,7],["ἀνέλαβον",575,141],["καὶ",2,8],["νεανίσκοι",570,51],["ἐν",4,1],["ξύλῳ",196,53],["ἠσθένησαν",771,141]],"The chosen men lifted up [the voice in] weeping, and the youths fainted under the wood."],["14",[["Καὶ",2,8],["πρεσβύται",1095,113],["ἀπὸ",17,1],["πύλης",162,19],["κατέπαυσαν",778,141],["ἐκλεκτοὶ",552,130],["ἐκ",21,1],["ψαλμῶν",644,77],["αὐτῶν",3,41],["κατέπαυσαν",778,141]],"And the elders ceased from the gate, the chosen men ceased from their music."],["15",[["Κατέλυσε",861,3],["χαρὰ",1125,13],["καρδίας",64,19],["ἡμῶν",6,41],["ἐστράφη",1078,38],["εἰς",8,1],["πένθος",1004,33],["ὁ",1,4],["χορὸς",1844,5],["ἡμῶν",6,41]],"The joy of our heart has ceased; our dance is turned into mourning."],["16",[["Ἔπεσεν",154,3],["ὁ",1,4],["στέφανος",980,5],["ἡμῶν",6,41],["τῆς",1,18],["κεφαλῆς",144,19],["οὐαὶ",769,316],["δὲ",14,12],["ἡμῖν",6,142],["ὅτι",19,8],["ἡμάρτομεν",237,285]],"The crown has fallen [from] our head: yea, woe to us! for we have sinned."],["17",[["Περὶ",72,1],["τούτου",16,126],["ἐγενήθη",30,38],["ὀδύνη",774,13],["ὀδυνηρὰ",4124,15],["ἡ",1,11],["καρδία",64,13],["ἡμῶν",6,41],["περὶ",72,1],["τούτου",16,126],["ἐσκότασαν",3950,141],["οἱ",1,128],["ὀφθαλμοὶ",91,51],["ἡμῶν",6,41]],"For this has grief come; our heart is sorrowful: for this our eyes are darkened."],["18",[["Ἐπʼ",9,1],["ὄρος",87,33],["Σιὼν",334,2],["ὅτι",19,8],["ἠφανίσθη",623,38],["ἀλώπεκες",3159,180],["διῆλθον",423,141],["ἐν",4,1],["αὐτῇ",3,99]],"Over the mountain of Sion, because it is made desolate, foxes have walked therein."],["19",[["Σὺ",5,156],["δὲ",14,12],["Κύριε",7,250],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["κατοικήσεις",89,159],["ὁ",1,4],["θρόνος",383,5],["σου",5,146],["εἰς",8,1],["γενεὰν",286,10],["καὶ",2,8],["γενεάν",286,10]],"But thou, O Lord, shalt dwell for ever; thy throne [shall endure] to generation and generation."],["20",[["Ἱνατί",102,238],["εἰς",8,1],["νῖκος",2100,20],["ἐπιλήσῃ",513,116],["ἡμῶν",6,41],["καταλείψεις",207,159],["ἡμᾶς",6,60],["εἰς",8,1],["μακρότητα",3081,10],["ἡμερῶν",28,61]],"Wherefore wilt thou utterly forget us, and abandon us a long time?"],["21",[["Ἐπίστρεψον",117,198],["ἡμᾶς",6,60],["Κύριε",7,250],["πρὸς",15,1],["σὲ",5,161],["καὶ",2,8],["ἐπιστραφησόμεθα",117,349],["καὶ",2,8],["ἀνακαίνισον",4019,198],["ἡμέρας",28,19],["ἡμῶν",6,41],["καθὼς",221,17],["ἔμπροσθεν",390,17]],"Turn us, O Lord, to thee, and we shall be turned; and renew our days as before."],["22",[["Ὅτι",19,8],["ἀπωθούμενος",770,114],["ἀπώσω",770,157],["ἡμᾶς",6,60],["ὠργίσθης",725,360],["ἐφʼ",9,1],["ἡμᾶς",6,60],["ἕως",42,8],["σθόδρα",0,0]],"For thou hast indeed rejected us; thou hast been very wroth against us."]]