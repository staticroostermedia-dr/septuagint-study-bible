νου",3540,479],["ναοῦ",483,21],["φόβος",333,5]],"For the care that they took for their wives, and their children, their brethren, and kinsfolks, was in least account with them: but the greatest and principal fear was for the holy temple."],["19",[["Ἦν",10,14],["δὲ",14,12],["καὶ",2,8],["τοῖς",1,138],["ἐν",4,1],["τῇ",1,95],["πόλει",41,2],["κατειλημμένοις",532,437],["οὐ",12,17],["πάρεργος",7815,15],["ἀγωνία",5160,13],["ταρασσομένοις",508,342],["τῆς",1,18],["ἐν",4,1],["ὑπαίθρῳ",6663,34],["προσβολῆς",5988,19]],"Also they that were in the city took not the least care, being troubled for the conflict abroad."],["20",[["Καὶ",2,8],["πάντων",11,163],["ἤδη",916,17],["προσδοκώντων",2758,164],["τὴν",1,9],["ἐσομένην",10,643],["κρίσιν",229,10],["καὶ",2,8],["ἤδη",916,17],["συμμιξάντων",2632,211],["τῶν",1,76],["πολεμίων",1122,163],["καὶ",2,8],["τῆς",1,18],["στρατιᾶς",1226,19],["ἐκταγείσης",4579,550],["καὶ",2,8],["τῶν",1,44],["θηρίων",403,45],["ἐπὶ",9,1],["μέρος",471,33],["εὔκαιρον",3832,29],["ἀποκατασταθέντων",1149,245],["τῆς",1,18],["τε",209,12],["ἵππου",309,21],["κατὰ",32,1],["κέρας",569,33],["τεταγμένης",721,443]],"And now, when as all looked what should be the trial, and the enemies were already come near, and the army was set in array, and the beasts conveniently placed, and the horsemen set in wings,"],["21",[["Συνιδὼν",3362,155],["ὁ",1,4],["Μακκαβαῖος",1374,16],["τὴν",1,9],["τῶν",1,44],["πληθῶν",200,45],["παρουσίαν",4349,10],["καὶ",2,8],["τῶν",1,44],["ὅπλων",764,45],["τὴν",1,9],["ποικίλην",1558,37],["παρασκευὴν",4348,10],["τήν",1,9],["τε",209,12],["τῶν",1,44],["θηρίων",403,45],["ἀγριότητα",8741,10],["προτείνας",3121,155],["τὰς",1,39],["χεῖρας",37,40],["εἰς",8,1],["τὸν",1,6],["οὐρανὸν",94,7],["ἐπεκαλέσατο",341,26],["τὸν",1,6],["τερατοποιὸν",6146,59],["Κύριον",7,7],["τὸν",1,6],["κατόπτην",7437,7],["γινώσκων",79,67],["ὅτι",19,8],["οὐκ",12,17],["ἔστι",10,87],["διʼ",56,1],["ὅπλων",764,45],["ἡ",1,11],["νίκη",4329,13],["καθὼς",221,17],["δὲ",14,12],["ἂν",83,12],["αὐτῷ",3,49],["κριθεί