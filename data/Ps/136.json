[["1",[["Τῷ",1,110],["Δαυὶδ",52,105],["Ἱερεμίου",479,21],["Ἐπὶ",9,1],["τῶν",1,76],["ποταμῶν",249,77],["Βαβυλῶνος",204,19],["ἐκεῖ",76,17],["ἐκαθίσαμεν",273,288],["καὶ",2,8],["ἐκλαύσαμεν",409,288],["ἐν",4,1],["τῷ",1,110],["μνησθῆναι",231,174],["ἡμᾶς",6,60],["τῆς",1,18],["Σιών",331,2]],"For David, [a Psalm] of Jeremias. By the rivers of Babylon, there we sat; and wept when we remembered Sion."],["2",[["Ἐπὶ",9,1],["ταῖς",1,70],["ἰτέαις",5414,71],["ἐν",4,1],["μέσῳ",112,34],["αὐτῆς",3,83],["ἐκρεμάσαμεν",1380,288],["τὰ",1,42],["ὄργανα",1579,43],["ἡμῶν",6,41]],"We hung our harps on the willows in the midst of it."],["3",[["Ὅτι",19,8],["ἐκεῖ",76,17],["ἐπηρώτησαν",738,141],["ἡμᾶς",6,60],["οἱ",1,128],["αἰχμαλωτεύσαντες",1158,188],["ἡμᾶς",6,60],["λόγους",48,31],["ᾠδῶν",2562,77],["καὶ",2,8],["οἱ",1,128],["ἀπαγαγόντες",1216,188],["ἡμᾶς",6,60],["ὕμνον",1499,7],["ᾄσατε",1080,69],["ἡμῖν",6,142],["ἐκ",21,1],["τῶν",1,76],["ᾠδῶν",2562,77],["Σιών",331,2]],"For there they that had taken us captive asked of us the words of a song; and they that had carried us away [asked] a hymn, [saying], Sing us [one] of the songs of Sion."],["4",[["Πῶς",440,12],["ᾄσωμεν",1080,75],["τὴν",1,9],["ᾠδὴν",773,10],["Κυρίου",7,21],["ἐπὶ",9,1],["γῆς",26,19],["ἀλλοτρίας",377,78]],"How should we sing the Lord's song in a strange land?"],["5",[["Ἐὰν",45,8],["ἐπιλάθωμαί",512,255],["σου",5,146],["Ἱερουσαλήμ",69,20],["ἐπιλησθείη",512,555],["ἡ",1,11],["δεξιά",282,15],["μου",6,48]],"If I forget thee, O Jerusalem, let my right hand forget [its skill]."],["6",[["Κολληθείη",1272,555],["ἡ",1,11],["γλῶσσά",385,13],["μου",6,48],["τῷ",1,110],["λάρυγγί",2097,113],["μου",6,48],["ἐὰν",45,8],["μή",25,8],["σου",5,146],["μνησθῷ",0,0],["ἐὰν",45,8],["μὴ",25,8],["προανατάξωμαι",8102,255],["τὴν",1,9],["Ἱερουσαλὴμ",69,20],["ἐν",4,1],["ἀρχῇ",269,2],["τῆς",1,18],["εὐφροσύνης",360,19],["μου",6,83]],"May my tongue cleave to my throat, if I do not remember thee; if I do not prefer Jerusalem as the chief of my joy."],["7",[["Μνήσθητι",231,242],["Κύριε",7,251],["τῶν",1,76],["υἱῶν",13,77],["Ἐδὼμ",0,0],["τὴν",1,9],["ἡμέραν",28,10],["Ἱερουσαλήμ",69,20],["τῶν",1,76],["λεγόντων",31,164],["ἐκκενοῦτε",2145,84],["ἐκκενοῦτε",2145,84],["ἕως",42,8],["τῶν",1,76],["θεμελίων",950,77],["αὐτῇς",3,192]],"Remember, O Lord, the children of Edom in the day of Jerusalem; who said, Rase [it], rase [it], even to its foundations."],["8",[["Θυγάτηρ",97,13],["Βαβυλῶνος",204,19],["ἡ",1,11],["ταλαίπωρος",2796,15],["μακάριος",803,15],["ὃς",24,247],["ἀνταποδώσει",661,120],["σοι",5,151],["τὸ",1,32],["ἀνταπόδομά",1849,33],["σου",5,146],["ὃ",1,4],["ἀνταπέδωκας",661,154],["ἡμῖν",6,142]],"Wretched daughter of Babylon! blessed [shall he be] who shall reward thee as thou hast rewarded us."],["9",[["Μακάριος",803,16],["ὃς",24,247],["κρατήσει",383,120],["καὶ",2,8],["ἐδαφιεῖ",3733,120],["τὰ",1,42],["νήπιά",1015,65],["σου",5,146],["πρὸς",15,1],["τὴν",1,9],["πέτραν",546,10]],"Blessed [shall he be] who shall seize and dash thine infants against the rock."]]