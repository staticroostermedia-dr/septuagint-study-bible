[["1",[["Τῷ",1,110],["Δαυὶδ",52,105],["Ἱερεμίου",480,21],["Ἐπὶ",9,1],["τῶν",1,76],["ποταμῶν",249,77],["Βαβυλῶνος",204,19],["ἐκεῖ",76,17],["ἐκαθίσαμεν",274,285],["καὶ",2,8],["ἐκλαύσαμεν",412,285],["ἐν",4,1],["τῷ",1,110],["μνησθῆναι",230,175],["ἡμᾶς",6,60],["τῆς",1,18],["Σιών",334,2]],"For David, [a Psalm] of Jeremias. By the rivers of Babylon, there we sat; and wept when we remembered Sion."],["2",[["Ἐπὶ",9,1],["ταῖς",1,70],["ἰτέαις",5383,71],["ἐν",4,1],["μέσῳ",113,34],["αὐτῆς",3,83],["ἐκρεμάσαμεν",1324,285],["τὰ",1,42],["ὄργανα",1578,43],["ἡμῶν",6,41]],"We hung our harps on the willows in the midst of it."],["3",[["Ὅτι",19,8],["ἐκεῖ",76,17],["ἐπηρώτησαν",739,141],["ἡμᾶς",6,60],["οἱ",1,128],["αἰχμαλωτεύσαντες",1110,190],["ἡμᾶς",6,60],["λόγους",48,31],["ᾠδῶν",2558,77],["καὶ",2,8],["οἱ",1,128],["ἀπαγαγόντες",1212,190],["ἡμᾶς",6,60],["ὕμνον",1498,7],["ᾄσατε",856,69],["ἡμῖν",6,142],["ἐκ",21,1],["τῶν",1,76],["ᾠδῶν",2558,77],["Σιών",334,2]],"For there they that had taken us captive asked of us the words of a song; and they that had carried us away [asked] a hymn, [saying], Sing us [one] of the songs of Sion."],["4",[["Πῶς",441,12],["ᾄσωμεν",856,75],["τὴν",1,9],["ᾠδὴν",776,10],["Κυρίου",7,21],["ἐπὶ",9,1],["γῆς",26,19],["ἀλλοτρίας",381,78]],"How should we sing the Lord's song in a strange land?"],["5",[["Ἐὰν",45,8],["ἐπιλάθωμαί",513,255],["σου",5,146],["Ἱερουσαλήμ",70,20],["ἐπιλησθείη",513,544],["ἡ",1,11],["δεξιά",282,15],["μου",6,48]],"If I forget thee, O Jerusalem, let my right hand forget [its skill]."],["6",[["Κολληθείη",1246,544],["ἡ",1,11],["γλῶσσά",388,13],["μου",6,48],["τῷ",1,110],["λάρυγγί",2092,113],["μου",6,48],["ἐὰν",45,8],["μή",25,8],["σου",5,146],["μνησθῷ",230,555],["ἐὰν",45,8],["μὴ",25,8],["προανατάξωμαι",8042,255],["τὴν",1,9],["Ἱερουσαλὴμ",70,20],["ἐν",4,1],["ἀρχῇ",270,2],["τῆς",1,18],["εὐφροσύνης",360,19],["μου",6,83]],"May my tongue cleave to my throat, if I do not remember thee; if I do not prefer Jerusalem as the chief of my joy."],["7",[["Μνήσθητι",230,242],["Κύριε",7,250],["τῶν",1,76],["υἱῶν",13,77],["Ἐδὼμ",0,0],["τὴν",1,9],["ἡμέραν",28,10],["Ἱερουσαλήμ",70,20],["τῶν",1,76],["λεγόντων",31,164],["ἐκκενοῦτε",2138,84],["ἐκκενοῦτε",2138,84],["ἕως",42,8],["τῶν",1,76],["θεμελίων",950,77],["αὐτῇς",3,194]],"Remember, O Lord, the children of Edom in the day of Jerusalem; who said, Rase [it], rase [it], even to its foundations."],["8",[["Θυγάτηρ",97,13],["Βαβυλῶνος",204,19],["ἡ",1,11],["ταλαίπωρος",2786,15],["μακάριος",806,15],["ὃς",24,246],["ἀνταποδώσει",666,120],["σοι",5,151],["τὸ",1,32],["ἀνταπόδομά",1850,33],["σου",5,146],["ὃ",1,4],["ἀνταπέδωκας",666,154],["ἡμῖν",6,142]],"Wretched daughter of Babylon! blessed [shall he be] who shall reward thee as thou hast rewarded us."],["9",[["Μακάριος",806,16],["ὃς",24,246],["κρατήσει",385,120],["καὶ",2,8],["ἐδαφιεῖ",3725,120],["τὰ",1,42],["νήπιά",1016,65],["σου",5,146],["πρὸς",15,1],["τὴν",1,9],["πέτραν",548,10]],"Blessed [shall he be] who shall seize and dash thine infants against the rock."]]