[["1",[["Εἰς",8,1],["τὸ",1,32],["τέλος",369,33],["ψαλμὸς",639,5],["τῷ",1,110],["Δαυὶδ",52,105],["ἐκστάσεως",1533,19]],"For the end, a Psalm of David, [an utterance] of extreme fear."],["2",[["Ἐπὶ",9,1],["σοὶ",5,151],["Κύριε",7,251],["ἤλπισα",511,147],["μὴ",25,8],["καταισχυνθείην",716,694],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["ἐν",4,1],["τῇ",1,95],["δικαιοσύνῃ",185,2],["σου",5,146],["ῥῦσαί",335,275],["με",6,82],["καὶ",2,8],["ἐξελοῦ",411,275],["με",6,82]],"O Lord, I have hoped in thee; let me never be ashamed: deliver me in thy righteousness and rescue me."],["3",[["Κλῖνον",829,36],["πρὸς",15,1],["μὲ",6,82],["τὸ",1,32],["οὖς",325,33],["σου",5,146],["τὰχυνον",2129,198],["τοῦ",1,30],["ἐξελέσθαι",411,103],["με",6,82],["γενοῦ",30,275],["μοι",6,49],["εἰς",8,1],["Θεὸν",20,7],["ὑπερασπιστὴν",1876,7],["καὶ",2,8],["εἰς",8,1],["οἶκον",34,7],["καταφυγῆς",1681,19],["τοῦ",1,30],["σῶσαί",171,100],["με",6,82]],"Incline thine ear to me; make haste to rescue me: be thou to me for a protecting God, and for a house of refuge to save me."],["4",[["Ὅτι",19,8],["κραταίωμά",4292,20],["μου",6,48],["καὶ",2,8],["καταφυγή",1681,13],["μου",6,48],["εἶ",10,145],["σὺ",5,156],["καὶ",2,8],["ἕνεκεν",445,1],["τοῦ",1,23],["ὀνόματός",55,24],["σου",5,146],["ὁδηγήσεις",1110,159],["με",6,82],["καὶ",2,8],["διαθρέψεις",2081,159],["με",6,82]],"For thou art my strength and my refuge; and thou shalt guide me for thy name's sake, and maintain me."],["5",[["Ἐξάξεις",299,159],["με",6,82],["ἐκ",21,1],["παγίδος",815,19],["ταύτης",16,293],["ἧς",24,162],["ἔκρυψάν",378,141],["μοι",6,49],["ὅτι",19,8],["σὺ",5,156],["εἶ",10,145],["ὁ",1,4],["ὑπερασπιστής",1876,5],["μου",6,48],["Κύριε",7,251]],"Thou shalt bring me out of the snare which they have hidden for me; for thou, O Lord, art my defender."],["6",[["Εἰς",8,1],["χεῖράς",37,40],["σου",5,146],["παραθήσομαι",1277,176],["τὸ",1,32],["πνεῦμά",167,33],["μου",6,48],["ἐλυτρώσω",548,169],["με",6,82],["Κύριε",7,251],["ὁ",1,4],["Θεὸς",20,5],["τῆς",1,18],["ἀληθέιας",0,0]],"Into thine hands I will commit my spirit: thou hast redeemed me, O Lord God of truth."],["7",[["Ἐμίσησας",355,154],["τοὺς",1,56],["διαφυλάσσοντας",1587,229],["ματαιότητας",937,40],["διακενῆς",2711,17],["ἐγὼ",6,158],["δὲ",14,12],["ἐπὶ",9,1],["τῷ",1,110],["Κυρίῳ",7,113],["ἤλπισα",511,147]],"Thou hast hated them that idly persist in vanities: but I have hoped in the Lord."],["8",[["Ἀγαλλιάσομαι",737,176],["καὶ",2,8],["εὐφρανθήσομαι",242,175],["ἐπὶ",9,1],["τῷ",1,52],["ἐλέει",182,53],["σου",5,146],["ὅτι",19,8],["ἐπεῖδες",1866,154],["τὴν",1,9],["ταπείνωσίν",1483,10],["μου",6,48],["ἔσωσας",171,154],["ἐκ",21,1],["τῶν",1,123],["ἀναγκῶν",1125,61],["τὴν",1,9],["ψυχήν",62,10],["μου",6,48]],"I will exult and be glad in thy mercy: for thou hast looked upon mine affliction; thou hast saved my soul from distresses."],["9",[["Καὶ",2,8],["οὐ",12,17],["συνέκλεισάς",1147,154],["με",6,82],["εἰς",8,1],["χεῖρας",37,40],["ἐχθροῦ",135,21],["ἔστησας",78,154],["ἐν",4,1],["εὐρυχώρῳ",2720,111],["τοὺς",1,56],["πόδας",208,31],["μου",6,48]],"And thou hast not shut me up into the hands of the enemy: thou hast set my feet in a wide place."],["10",[["Ἐλέησόν",457,243],["με",6,82],["Κύριε",7,251],["ὅτι",19,8],["θλίβομαι",599,252],["ἐταράχθη",508,38],["ἐν",4,1],["θυμῷ",177,113],["ὁ",1,4],["ὀφθαλμός",91,5],["μου",6,48],["ἡ",1,11],["ψυχή",62,13],["μου",6,48],["καὶ",2,8],["ἡ",1,11],["γαστήρ",775,13],["μου",6,48]],"Pity me, O Lord, for I am afflicted: my eye is troubled with indignation, my soul and my belly."],["11",[["Ὅτι",19,8],["ἐξέλιπεν",321,3],["ἐν",4,1],["ὀδύνῃ",771,2],["ἡ",1,11],["ζωή",212,13],["μου",6,48],["καὶ",2,8],["τὰ",1,42],["ἔτη",80,43],["μου",6,48],["ἐν",4,1],["στεναγμοῖς",1599,139],["ἠσθένησεν",768,3],["ἐν",4,1],["πτωχείᾳ",1912,2],["ἡ",1,11],["ἰσχύς",180,13],["μου",6,48],["καὶ",2,8],["τὰ",1,42],["ὀστᾶ",472,43],["μου",6,48],["ἐταράχθησαν",508,94]],"For my life is spent with grief, and my years with groanings: my strength has been weakened through poverty, and my bones are troubled."],["12",[["Πα