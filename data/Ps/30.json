,52],["ἐλέει",183,53],["σου",5,146]],"and from them that persecute me. Make thy face to shine upon thy servant: save me in thy mercy."],["18",[["Κύριε",7,250],["μὴ",25,8],["καταισχυνθείην",696,672],["ὅτι",19,8],["ἐπεκαλεσάμην",341,152],["σε",5,161],["αἰσχυνθείησαν",611,403],["οἱ",1,128],["ἀσεβεῖς",247,130],["καὶ",2,8],["καταχθείησαν",735,403],["εἰς",8,1],["ᾅδου",586,21]],"O Lord, let me not be ashamed, for I have called upon thee: let the ungodly be ashamed, and brought down to Hades."],["19",[["Ἄλαλα",6381,74],["γενηθήτω",30,25],["τὰ",1,253],["χείλη",361,63],["τὰ",1,253],["δόλια",1545,74],["τὰ",1,253],["λαλοῦντα",50,289],["κατὰ",32,1],["τοῦ",1,30],["δικαίου",153,153],["ἀνομίαν",275,10],["ἐν",4,1],["ὑπερηφανίᾳ",1131,180],["καὶ",2,8],["ἐξουδενώσει",1068,120]],"Let the deceitful lips become dumb, which speak iniquity against the righteous with pride and scorn."],["20",[["Ὡς",36,8],["πολὺ",74,29],["τὸ",1,32],["πλῆθος",200,33],["τῆς",1,18],["χρηστότητός",1845,19],["σου",5,146],["Κύριε",7,250],["ἧς",24,162],["ἔκρυψας",372,154],["τοῖς",1,138],["φοβουμένοις",134,342],["σε",5,161],["ἐξειργάσω",5313,322],["τοῖς",1,138],["ἐλπίζουσιν",514,352],["ἐπὶ",9,1],["σὲ",5,161],["ἐναντίον",138,17],["τῶν",1,76],["υἱῶν",13,77],["τῶν",1,76],["ἀνθρώπων",43,77]],"How abundant is the multitude of thy goodness, O Lord, which thou hast laid up for them that fear thee! thou hast wrought [it] out for them that hope on thee, in the presence of the sons of men."],["21",[["Κατακρύψεις",2019,159],["αὐτοὺς",3,60],["ἐν",4,1],["ἀποκρύφῳ",1697,111],["τοῦ",1,23],["προσώπου",47,24],["σου",5,146],["ἀπὸ",17,1],["ταραχῆς",1562,19],["ἀνθρώπων",43,77],["σκεπάσεις",1208,159],["αὐτοὺς",3,60],["ἐν",4,1],["σκηνῇ",131,2],["ἀπὸ",17,1],["ἀντιλογίας",1851,19],["γλωσσῶν",388,61]],"Thou wilt hide them in the secret of thy presence from the vexation of man: thou wilt screen them in a tabernacle from the contradiction of tongues."],["22",[["Εὐλογητὸς",767,16],["Κύριος",7,5],["ὅτι",19,8],["ἐθαυμάστωσε",3060,3],["τὸ",1,32],["ἔλεος",183,33],["αὐτοῦ",3,48],["ἐν",4,1],["πόλει",41,2],["περιοχῆς",1594,19]],"Blessed be the Lord: for he has magnified his mercy in a fortified city."],["23",[["Ἐγὼ",6,158],["δὲ",14,12],["εἶπα",18,147],["ἐν",4,1],["τῇ",1,95],["ἐκστάσει",1535,2],["μου",6,48],["ἀπέῤῥιμμαι",1150,324],["ἀπὸ",17,1],["προσώπου",47,24],["τῶν",1,76],["ὀφθαλμῶν",91,77],["σου",5,146],["διὰ",56,1],["τοῦτο",16,122],["εἰσήκουσας",241,154],["Κύριε",7,250],["τῆς",1,18],["φωνῆς",95,19],["τῆς",1,18],["δεήσεώς",677,19],["μου",6,83],["ἐν",4,1],["τῷ",1,110],["κεκραγέναι",592,107],["με",6,82],["πρὸς",15,1],["σέ",5,161]],"But I said in my extreme fear, I am cast out from the sight of thine eyes: therefore thou didst hearken, O Lord, to the voice of my supplication when I cried to thee."],["24",[["Ἀγαπήσατε",214,69],["τὸν",1,6],["Κύριον",7,7],["πάντες",11,130],["οἱ",1,128],["ὅσιοι",917,130],["αὐτοῦ",3,48],["ὅτι",19,8],["ἀληθείας",352,19],["ἐκζητεῖ",460,87],["Κύριος",7,5],["καὶ",2,8],["ἀνταποδίδωσι",666,87],["τοῖς",1,138],["περισσῶς",3615,17],["ποιοῦσιν",23,352],["ὑπερηφανίαν",1131,10]],"Love the Lord, all ye his saints: for the Lord seeks for truth, and renders [a reward] to them that deal very proudly."],["25",[["Ἀνδρίζεσθε",1750,68],["καὶ",2,8],["κραταιούσθω",729,340],["ἡ",1,11],["καρδία",64,13],["ὑμῶν",5,136],["πάντες",11,130],["οἱ",1,128],["ἐλπίζοντες",514,137],["ἐπὶ",9,1],["Κύριον",7,7]],"Be of good courage, and let your heart be strengthened, all ye that hope in the Lord."]]