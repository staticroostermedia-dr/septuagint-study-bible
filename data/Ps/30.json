[["1",[["Εἰς",8,1],["τὸ",1,32],["τέλος",373,33],["ψαλμὸς",644,5],["τῷ",1,110],["Δαυὶδ",52,105],["ἐκστάσεως",1535,19]],"For the end, a Psalm of David, [an utterance] of extreme fear."],["2",[["Ἐπὶ",9,1],["σοὶ",5,151],["Κύριε",7,250],["ἤλπισα",514,147],["μὴ",25,8],["καταισχυνθείην",696,672],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["ἐν",4,1],["τῇ",1,95],["δικαιοσύνῃ",187,2],["σου",5,146],["ῥῦσαί",337,275],["με",6,82],["καὶ",2,8],["ἐξελοῦ",413,275],["με",6,82]],"O Lord, I have hoped in thee; let me never be ashamed: deliver me in thy righteousness and rescue me."],["3",[["Κλῖνον",785,36],["πρὸς",15,1],["μὲ",6,82],["τὸ",1,32],["οὖς",328,33],["σου",5,146],["τὰχυνον",2120,198],["τοῦ",1,30],["ἐξελέσθαι",413,103],["με",6,82],["γενοῦ",30,275],["μοι",6,49],["εἰς",8,1],["Θεὸν",20,7],["ὑπερασπιστὴν",1875,7],["καὶ",2,8],["εἰς",8,1],["οἶκον",34,7],["καταφυγῆς",1678,19],["τοῦ",1,30],["σῶσαί",172,100],["με",6,82]],"Incline thine ear to me; make haste to rescue me: be thou to me for a protecting God, and for a house of refuge to save me."],["4",[["Ὅτι",19,8],["κραταίωμά",4280,20],["μου",6,48],["καὶ",2,8],["καταφυγή",1678,13],["μου",6,48],["εἶ",10,145],["σὺ",5,156],["καὶ",2,8],["ἕνεκεν",447,1],["τοῦ",1,23],["ὀνόματός",57,24],["σου",5,146],["ὁδηγήσεις",1108,159],["με",6,82],["καὶ",2,8],["διαθρέψεις",2076,159],["με",6,82]],"For thou art my strength and my refuge; and thou shalt guide me for thy name's sake, and maintain me."],["5",[["Ἐξάξεις",295,159],["με",6,82],["ἐκ",21,1],["παγίδος",817,19],["ταύτης",16,290],["ἧς",24,162],["ἔκρυψάν",372,141],["μοι",6,49],["ὅτι",19,8],["σὺ",5,156],["εἶ",10,145],["ὁ",1,4],["ὑπερασπιστής",1875,5],["μου",6,48],["Κύριε",7,250]],"Thou shalt bring me out of the snare which they have hidden for me; for thou, O Lord, art my defender."],["6",[["Εἰς",8,1],["χεῖράς",37,40],["σου",5,146],["παραθήσομαι",1279,177],["τὸ",1,32],["πνεῦμά",168,33],["μου",6,48],["ἐλυτρώσω",535,169],["με",6,82],["Κύριε",7,250],["ὁ",1,4],["Θεὸς",20,5],["τῆς",1,18],["ἀληθέιας",0,0]],"Into thine hands I will commit my spirit: thou hast redeemed me, O Lord God of truth."],["7",[["Ἐμίσησας",351,154],["τοὺς",1,56],["διαφυλάσσοντας",1544,229],["ματαιότητας",937,40],["διακενῆς",2705,17],["ἐγὼ",6,158],["δὲ",14,12],["ἐπὶ",9,1],["τῷ",1,110],["Κυρίῳ",7,113],["ἤλπισα",514,147]],"Thou hast hated them that idly persist in vanities: but I have hoped in the Lord."],["8",[["Ἀγαλλιάσομαι",738,177],["καὶ",2,8],["εὐφρανθήσομαι",244,176],["ἐπὶ",9,1],["τῷ",1,52],["ἐλέει",183,53],["σου",5,146],["ὅτι",19,8],["ἐπεῖδες",1865,154],["τὴν",1,9],["ταπείνωσίν",1481,10],["μου",6,48],["ἔσωσας",172,154],["ἐκ",21,1],["τῶν",1,123],["ἀναγκῶν",1126,61],["τὴν",1,9],["ψυχήν",63,10],["μου",6,48]],"I will exult and be glad in thy mercy: for thou hast looked upon mine affliction; thou hast saved my soul from distresses."],["9",[["Καὶ",2,8],["οὐ",12,17],["συνέκλεισάς",1147,154],["με",6,82],["εἰς",8,1],["χεῖρας",37,40],["ἐχθροῦ",135,21],["ἔστησας",78,154],["ἐν",4,1],["εὐρυχώρῳ",2714,111],["τοὺς",1,56],["πόδας",210,31],["μου",6,48]],"And thou hast not shut me up into the hands of the enemy: thou hast set my feet in a wide place."],["10",[["Ἐλέησόν",446,198],["με",6,82],["Κύριε",7,250],["ὅτι",19,8],["θλίβομαι",601,251],["ἐταράχθη",508,38],["ἐν",4,1],["θυμῷ",178,113],["ὁ",1,4],["ὀφθαλμός",91,5],["μου",6,48],["ἡ",1,11],["ψυχή",63,13],["μου",6,48],["καὶ",2,8],["ἡ",1,11],["γαστήρ",777,13],["μου",6,48]],"Pity me, O Lord, for I am afflicted: my eye is troubled with indignation, my soul and my belly."],["11",[["Ὅτι",19,8],["ἐξέλιπεν",321,3],["ἐν",4,1],["ὀδύνῃ",774,2],["ἡ",1,11],["ζωή",216,13],["μου",6,48],["καὶ",2,8],["τὰ",1,42],["ἔτη",81,43],["μου",6,48],["ἐν",4,1],["στεναγμοῖς",1598,139],["ἠσθένησεν",771,3],["ἐν",4,1],["πτωχείᾳ",1913,2],["ἡ",1,11],["ἰσχύς",181,13],["μου",6,48],["καὶ",2,8],["τὰ",1,42],["ὀστᾶ",473,43],["μου",6,48],["ἐταράχθησαν",508,94]],"For my life is spent with grief, and my years with groanings: my strength has been weakened through poverty, and my bones are troubled."],["12",[["Πα