[["1",[["Ψαλμὸς",644,5],["τῷ",1,110],["Δαυίδ",52,105],["Πρὸς",15,1],["σὲ",5,161],["Κύριε",7,250],["ᾖρα",206,147],["τὴν",1,9],["ψυχήν",63,10],["μου",6,48]],"A Psalm of David. To thee, O Lord, have I lifted up my soul."],["2",[["Ὁ",1,4],["Θεός",20,5],["μου",6,48],["ἐπὶ",9,1],["σοὶ",5,151],["πέποιθα",344,85],["μὴ",25,8],["καταισχυνθείην",696,672],["μηδὲ",414,12],["καταγελασάτωσάν",1767,261],["μου",6,48],["οἱ",1,128],["ἐχθροί",135,51],["μου",6,48]],"O my God, I have trusted in thee: let me not be confounded, neither let mine enemies laugh me to scorn."],["3",[["καὶ",2,8],["γὰρ",40,12],["πάντες",11,130],["οἱ",1,128],["ὑπομένοντές",639,137],["σε",5,161],["οὐ",12,17],["μὴ",25,8],["καταισχυνθῶσιν",696,266],["αἰσχυνθήτωσαν",611,50],["οἱ",1,128],["ἀνομοῦντες",1426,137],["διακενῆς",2705,17]],"For none of them that wait on thee shall in any wise be ashamed: let them be ashamed that transgress without cause."],["4",[["Τὰς",1,39],["ὁδούς",68,40],["σου",5,146],["Κύριε",7,250],["γνώρισόν",748,198],["μοι",6,49],["καὶ",2,8],["τὰς",1,39],["τρίβους",745,40],["σου",5,146],["δίδαξόν",545,198],["με",6,82]],"Shew me thy ways, O Lord; and teach me thy paths."],["5",[["Ὁδήγησόν",1108,198],["με",6,98],["ἐπὶ",9,1],["τὴν",1,9],["ἀλήθειάν",352,10],["σου",5,146],["καὶ",2,8],["δίδαξόν",545,198],["με",6,82],["ὅτι",19,8],["σὺ",5,156],["εἶ",10,145],["ὁ",1,4],["Θεὸς",20,5],["ὁ",1,4],["σωτήρ",1388,5],["μου",6,48],["καὶ",2,8],["σὲ",5,161],["ὑπέμεινα",639,147],["ὅλην",235,37],["τὴν",1,9],["ἡμέραν",28,10]],"Lead me in thy truth, and teach me: for thou art God my Saviour: and I have waited on thee all the day."],["6",[["Μνήσθητι",230,242],["τῶν",1,76],["οἰκτιρμῶν",1187,77],["σου",5,146],["Κύριε",7,250],["καὶ",2,8],["τὰ",1,42],["ἐλέη",183,43],["σου",5,146],["ὅτι",19,8],["ἀπὸ",17,1],["τοῦ",1,30],["αἰῶνος",100,21],["εἰσίν",10,191]],"Remember thy compassions, O Lord, and thy mercies, for they are from everlasting."],["7",[["Ἁμαρτίας",119,19],["νεότητός",787,19],["μου",6,83],["καὶ",2,8],["ἀγνοίας",1856,19],["μου",6,83],["μὴ",25,8],["μνησθῇς",230,278],["κατὰ",32,1],["τὸ",1,32],["ἔλεός",183,33],["σου",5,146],["μνήσθητί",230,242],["μου",6,83],["ἕνεκεν",447,1],["τῆς",1,18],["χρηστότητος",1845,19],["σου",5,146],["Κύριε",7,250]],"Remember not the sins of my youth, nor [my sins] of ignorance: remember me according to thy mercy, for thy goodness' sake, O Lord."],["8",[["Χρηστὸς",1359,16],["καὶ",2,8],["εὐθὴς",825,16],["ὁ",1,4],["Κύριος",7,5],["διὰ",56,1],["τοῦτο",16,122],["νομοθετήσει",2746,120],["ἁμαρτάνοντας",237,229],["ἐν",4,1],["ὁδῷ",68,2]],"Good and upright is the Lord: therefore will he instruct sinners in [the] way."],["9",[["Ὁδηγήσει",1108,120],["πρᾳεῖς",2286,130],["ἐν",4,1],["κρίσει",229,2],["διδάξει",545,120],["πρᾳεῖς",2286,130],["ὁδοὺς",68,40],["αὐτοῦ",3,48]],"The meek will he guide in judgment: the meek will he teach his ways."],["10",[["Πᾶσαι",11,187],["αἱ",1,185],["ὁδοὶ",68,180],["Κυρίου",7,21],["ἔλεος",183,33],["καὶ",2,8],["ἀλήθεια",352,13],["τοῖς",1,138],["ἐκζητοῦσι",460,352],["τὴν",1,9],["διαθήκην",169,10],["αὐτοῦ",3,48],["καὶ",2,8],["τὰ",1,42],["μαρτύρια",225,43],["αὐτοῦ",3,48]],"All the ways of the Lord are mercy and truth to them that seek his covenant and his testimonies."],["11",[["Ἕνεκα",447,1],["τοῦ",1,23],["ὀνόματός",57,24],["σου",5,146],["Κύριε",7,250],["καὶ",2,8],["ἱλάσῃ",2549,116],["τῇ",1,95],["ἁμαρτίᾳ",119,2],["μου",6,48],["πολλὴ",74,15],["γάρ",40,12],["ἐστι",10,87]],"For thy name's sake, O Lord, do thou also be merciful to my sin; for it is great."],["12",[["Τίς",39,150],["ἐστιν",10,87],["ἄνθρωπος",43,5],["ὁ",1,4],["φοβούμενος",134,114],["τὸν",1,6],["Κύριον",7,7],["νομοθετήσει",2746,120],["αὐτῷ",3,49],["ἐν",4,1],["ὁδῷ",68,2],["ᾗ",24,102],["ᾑρετίσατο",1618,26]],"Who is the man that fears the Lord? he shall instruct him in the way which he has chosen."],["13",[["Ἡ",1,11],["ψυχὴ",63,13],["αὐτοῦ",3,48],["ἐν",4,1],["ἀγαθοῖς",114,90],["αὐλισθήσεται",990,125],["καὶ",2,8],["τὸ",1,32],["σπέρμα",218,33],["αὐτοῦ",3,48],["κληρονομήσει",370,120],["γῆν",26,10]],"His soul shall dwell in prosperity; and his seed shall inherit the earth."],["14",[["Κραταίωμα",4280,20],["Κύριος",7,5],["τῶν",1,76],["φοβουμένων",134,295],["αὐτὸν",3,82],["καὶ",2,8],["ἡ",1,11],["διαθήκη",169,13],["αὐτοῦ",3,48],["τοῦ",1,30],["δηλῶσαι",1670,100],["αὐτοῖς",3,142]],"The Lord is the strength of them that fear him; and his covenant is to manifest [truth] to them."],["15",[["Οἱ",1,128],["ὀφθαλμοί",91,51],["μου",6,48],["διαπαντὸς",510,17],["πρὸς",15,1],["τὸν",1,6],["Κύριον",7,7],["ὅτι",19,8],["αὐτὸς",3,158],["ἐκσπάσει",2054,120],["ἐκ",21,1],["παγίδος",817,19],["τοὺς",1,56],["πόδας",210,31],["μου",6,48]],"Mine eyes are continually to the Lord; for he shall draw my feet out of the snare."],["16",[["Ἐπίβλεψον",517,198],["ἐπʼ",9,1],["ἐμὲ",6,82],["καὶ",2,8],["ἐλέησόν",446,198],["με",6,82],["ὅτι",19,8],["μονογενὴς",3301,16],["καὶ",2,8],["πτωχός",497,5],["εἰμι",10,149],["ἐγώ",6,158]],"Look upon me, and have mercy upon me; for I am an only child and poor."],["17",[["Αἱ",1,185],["θλίψεις",438,180],["τῆς",1,18],["καρδίας",64,19],["μου",6,83],["ἐπληθύνθησαν",316,94],["ἐκ",21,1],["τῶν",1,123],["ἀναγκῶν",1126,61],["μου",6,48],["ἐξάγαγέ",295,198],["με",6,82]],"The afflictions of my heart have been multiplied; deliver me from my distresses."],["18",[["Ἴδε",713,17],["τὴν",1,9],["ταπείνωσίν",1481,10],["μου",6,48],["καὶ",2,8],["τὸν",1,6],["κόπον",1345,7],["μου",6,48],["καὶ",2,8],["ἄφες",501,198],["πάσας",11,109],["τὰς",1,39],["ἁμαρτίας",119,40],["μου",6,48]],"Look upon mine affliction and my trouble; and forgive all my sins."],["19",[["Ἴδε",713,17],["τοὺς",1,56],["ἐχθρούς",135,31],["μου",6,48],["ὅτι",19,8],["ἐπληθύνθησαν",316,94],["καὶ",2,8],["μῖσος",2604,20],["ἄδικον",406,28],["ἐμίσησάν",351,141],["με",6,82]],"Look upon mine enemies; for they have been multiplied; and they have hated me with unjust hatred."],["20",[["Φύλαξον",125,198],["τὴν",1,9],["ψυχήν",63,10],["μου",6,48],["καὶ",2,8],["ῥῦσαί",337,275],["με",6,82],["μὴ",25,8],["καταισχυνθείην",696,672],["ὅτι",19,8],["ἤλπισα",514,147],["ἐπὶ",9,1],["σέ",5,161]],"Keep my soul, and deliver me: let me not be ashamed; for I have hoped in thee."],["21",[["Ἄκακοι",2520,130],["καὶ",2,8],["εὐθεῖς",825,130],["ἐκολλῶντό",1246,131],["μοι",6,49],["ὅτι",19,8],["ὑπέμεινά",639,147],["σε",5,161],["Κύριε",7,250]],"The harmless and upright joined themselves to me: for I waited for thee, O Lord."],["22",[["Λύτρωσαι",535,275],["ὁ",1,4],["Θεὸς",20,5],["τὸν",1,6],["Ἰσραὴλ",27,105],["ἐκ",21,1],["πασῶν",11,115],["τῶν",1,123],["θλίψεων",438,61],["αὐτοῦ",3,48]],"Deliver Israel, O God, out of all his afflictions."]]