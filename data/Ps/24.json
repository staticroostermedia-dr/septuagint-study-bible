[["1",[["Ψαλμὸς",639,5],["τῷ",1,110],["Δαυίδ",52,105],["Πρὸς",15,1],["σὲ",5,161],["Κύριε",7,251],["ᾖρα",0,0],["τὴν",1,9],["ψυχήν",62,10],["μου",6,48]],"A Psalm of David. To thee, O Lord, have I lifted up my soul."],["2",[["Ὁ",1,4],["Θεός",20,5],["μου",6,48],["ἐπὶ",9,1],["σοὶ",5,151],["πέποιθα",343,85],["μὴ",25,8],["καταισχυνθείην",716,694],["μηδὲ",412,12],["καταγελασάτωσάν",1766,261],["μου",6,48],["οἱ",1,128],["ἐχθροί",135,51],["μου",6,48]],"O my God, I have trusted in thee: let me not be confounded, neither let mine enemies laugh me to scorn."],["3",[["καὶ",2,8],["γὰρ",40,12],["πάντες",11,130],["οἱ",1,128],["ὑπομένοντές",635,137],["σε",5,161],["οὐ",12,17],["μὴ",25,8],["καταισχυνθῶσιν",716,267],["αἰσχυνθήτωσαν",614,50],["οἱ",1,128],["ἀνομοῦντες",1427,137],["διακενῆς",2711,17]],"For none of them that wait on thee shall in any wise be ashamed: let them be ashamed that transgress without cause."],["4",[["Τὰς",1,39],["ὁδούς",67,40],["σου",5,146],["Κύριε",7,251],["γνώρισόν",746,198],["μοι",6,49],["καὶ",2,8],["τὰς",1,39],["τρίβους",744,40],["σου",5,146],["δίδαξόν",543,198],["με",6,82]],"Shew me thy ways, O Lord; and teach me thy paths."],["5",[["Ὁδήγησόν",1110,243],["με",6,98],["ἐπὶ",9,1],["τὴν",1,9],["ἀλήθειάν",350,10],["σου",5,146],["καὶ",2,8],["δίδαξόν",543,198],["με",6,82],["ὅτι",19,8],["σὺ",5,156],["εἶ",10,145],["ὁ",1,4],["Θεὸς",20,5],["ὁ",1,4],["σωτήρ",1390,5],["μου",6,48],["καὶ",2,8],["σὲ",5,161],["ὑπέμεινα",635,147],["ὅλην",233,37],["τὴν",1,9],["ἡμέραν",28,10]],"Lead me in thy truth, and teach me: for thou art God my Saviour: and I have waited on thee all the day."],["6",[["Μνήσθητι",231,242],["τῶν",1,76],["οἰκτιρμῶν",1188,77],["σου",5,146],["Κύριε",7,251],["καὶ",2,8],["τὰ",1,42],["ἐλέη",182,43],["σου",5,146],["ὅτι",19,8],["ἀπὸ",17,1],["τοῦ",1,30],["αἰῶνος",100,21],["εἰσίν",10,189]],"Remember thy compassions, O Lord, and thy mercies, for they are from everlasting."],["7",[["Ἁμαρτίας",119,19],["νεότητός",785,19],["μου",6,83],["καὶ",2,8],["ἀγνοίας",1855,19],["μου",6,83],["μὴ",25,8],["μνησθῇς",231,279],["κατὰ",32,1],["τὸ",1,32],["ἔλεός",182,33],["σου",5,146],["μνήσθητί",231,242],["μου",6,83],["ἕνεκεν",445,1],["τῆς",1,18],["χρηστότητος",1847,19],["σου",5,146],["Κύριε",7,251]],"Remember not the sins of my youth, nor [my sins] of ignorance: remember me according to thy mercy, for thy goodness' sake, O Lord."],["8",[["Χρηστὸς",1357,16],["καὶ",2,8],["εὐθὴς",826,16],["ὁ",1,4],["Κύριος",7,5],["διὰ",54,1],["τοῦτο",16,122],["νομοθετήσει",2755,120],["ἁμαρτάνοντας",244,229],["ἐν",4,1],["ὁδῷ",67,2]],"Good and upright is the Lord: therefore will he instruct sinners in [the] way."],["9",[["Ὁδηγήσει",1110,120],["πρᾳεῖς",2298,130],["ἐν",4,1],["κρίσει",226,2],["διδάξει",543,120],["πρᾳεῖς",2298,130],["ὁδοὺς",67,40],["αὐτοῦ",3,48]],"The meek will he guide in judgment: the meek will he teach his ways."],["10",[["Πᾶσαι",11,185],["αἱ",1,183],["ὁδοὶ",67,179],["Κυρίου",7,21],["ἔλεος",182,33],["καὶ",2,8],["ἀλήθεια",350,13],["τοῖς",1,138],["ἐκζητοῦσι",459,357],["τὴν",1,9],["διαθήκην",168,10],["αὐτοῦ",3,48],["καὶ",2,8],["τὰ",1,42],["μαρτύρια",220,43],["αὐτοῦ",3,48]],"All the ways of the Lord are mercy and truth to them that seek his covenant and his testimonies."],["11",[["Ἕνεκα",445,1],["τοῦ",1,23],["ὀνόματός",55,24],["σου",5,146],["Κύριε",7,251],["καὶ",2,8],["ἱλάσῃ",2553,116],["τῇ",1,95],["ἁμαρτίᾳ",119,2],["μου",6,48],["πολλὴ",74,15],["γάρ",40,12],["ἐστι",10,87]],"For thy name's sake, O Lord, do thou also be merciful to my sin; for it is great."],["12",[["Τίς",39,150],["ἐστιν",10,87],["ἄνθρωπος",43,5],["ὁ",1,4],["φοβούμενος",134,114],["τὸν",1,6],["Κύριον",7,7],["νομοθετήσει",2755,120],["αὐτῷ",3,49],["ἐν",4,1],["ὁδῷ",67,2],["ᾗ",24,102],["ᾑρετίσατο",1669,26]],"Who is the man that fears the Lord? he shall instruct him in the way which he has chosen."],["13",[["Ἡ",1,11],["ψυχὴ",62,13],["αὐτοῦ",3,48],["ἐν",4,1],["ἀγαθοῖς",113,90],["αὐλισθήσεται",991,125],["καὶ",2,8],["τὸ",1,32],["σπέρμα",214,33],["αὐτοῦ",3,48],["κληρονομήσει",368,120],["γῆν",26,10]],"His soul shall dwell in prosperity; and his seed shall inherit the earth."],["14",[["Κραταίωμα",4292,20],["Κύριος",7,5],["τῶν",1,76],["φοβουμένων",134,299],["αὐτὸν",3,82],["καὶ",2,8],["ἡ",1,11],["διαθήκη",168,13],["αὐτοῦ",3,48],["τοῦ",1,30],["δηλῶσαι",1719,100],["αὐτοῖς",3,142]],"The Lord is the strength of them that fear him; and his covenant is to manifest [truth] to them."],["15",[["Οἱ",1,128],["ὀφθαλμοί",91,51],["μου",6,48],["διαπαντὸς",506,17],["πρὸς",15,1],["τὸν",1,6],["Κύριον",7,7],["ὅτι",19,8],["αὐτὸς",3,158],["ἐκσπάσει",2060,120],["ἐκ",21,1],["παγίδος",815,19],["τοὺς",1,56],["πόδας",208,31],["μου",6,48]],"Mine eyes are continually to the Lord; for he shall draw my feet out of the snare."],["16",[["Ἐπίβλεψον",516,198],["ἐπʼ",9,1],["ἐμὲ",6,82],["καὶ",2,8],["ἐλέησόν",457,243],["με",6,82],["ὅτι",19,8],["μονογενὴς",3306,16],["καὶ",2,8],["πτωχός",496,5],["εἰμι",10,149],["ἐγώ",6,158]],"Look upon me, and have mercy upon me; for I am an only child and poor."],["17",[["Αἱ",1,183],["θλίψεις",437,179],["τῆς",1,18],["καρδίας",63,19],["μου",6,83],["ἐπληθύνθησαν",315,94],["ἐκ",21,1],["τῶν",1,123],["ἀναγκῶν",1125,61],["μου",6,48],["ἐξάγαγέ",299,198],["με",6,82]],"The afflictions of my heart have been multiplied; deliver me from my distresses."],["18",[["Ἴδε",693,17],["τὴν",1,9],["ταπείνωσίν",1483,10],["μου",6,48],["καὶ",2,8],["τὸν",1,6],["κόπον",1342,7],["μου",6,48],["καὶ",2,8],["ἄφες",504,198],["πάσας",11,109],["τὰς",1,39],["ἁμαρτίας",119,40],["μου",6,48]],"Look upon mine affliction and my trouble; and forgive all my sins."],["19",[["Ἴδε",693,17],["τοὺς",1,56],["ἐχθρούς",135,31],["μου",6,48],["ὅτι",19,8],["ἐπληθύνθησαν",315,94],["καὶ",2,8],["μῖσος",2606,20],["ἄδικον",402,28],["ἐμίσησάν",355,141],["με",6,82]],"Look upon mine enemies; for they have been multiplied; and they have hated me with unjust hatred."],["20",[["Φύλαξον",127,198],["τὴν",1,9],["ψυχήν",62,10],["μου",6,48],["καὶ",2,8],["ῥῦσαί",335,275],["με",6,82],["μὴ",25,8],["καταισχυνθείην",716,694],["ὅτι",19,8],["ἤλπισα",511,147],["ἐπὶ",9,1],["σέ",5,161]],"Keep my soul, and deliver me: let me not be ashamed; for I have hoped in thee."],["21",[["Ἄκακοι",2523,130],["καὶ",2,8],["εὐθεῖς",826,130],["ἐκολλῶντό",1272,131],["μοι",6,49],["ὅτι",19,8],["ὑπέμεινά",635,147],["σε",5,161],["Κύριε",7,251]],"The harmless and upright joined themselves to me: for I waited for thee, O Lord."],["22",[["Λύτρωσαι",548,296],["ὁ",1,4],["Θεὸς",20,5],["τὸν",1,6],["Ἰσραὴλ",27,105],["ἐκ",21,1],["πασῶν",11,115],["τῶν",1,123],["θλίψεων",437,61],["αὐτοῦ",3,48]],"Deliver Israel, O God, out of all his afflictions."]]