[["1",[["Ἀλληλούϊα",1749,105],["Ἀγγαίου",1988,153],["καὶ",2,8],["Ζαχαρίου",893,21],["Αἰνεῖτε",402,307],["τὸν",1,6],["Κύριον",7,7],["ὅτι",19,8],["ἀγαθὸν",114,59],["ψαλμός",644,5],["τῷ",1,110],["Θεῷ",20,113],["ἡμῶν",6,41],["ἡδυνθείη",3209,544],["αἴνεσις",989,13]],"Alleluia, [a Psalm] of Aggæus and Zacharias. Praise ye the Lord: for psalmody is a good thing; let praise be sweetly sung to our God."],["2",[["Οἰκοδομῶν",126,67],["Ἱερουσαλὴμ",70,20],["ὁ",1,4],["Κύριος",7,5],["καὶ",2,8],["τὰς",1,39],["διασπορὰς",3048,40],["τοῦ",1,30],["Ἰσραὴλ",27,105],["ἐπισυνάξει",1129,120]],"The Lord builds up Jerusalem; and he will gather together the dispersed of Israel."],["3",[["Ὁ",1,4],["ἰώμενος",797,114],["τοὺς",1,56],["συντετριμμένους",268,369],["τὴν",1,9],["καρδίαν",64,10],["καὶ",2,8],["δεσμεύων",2702,67],["τὰ",1,42],["συντρίμματα",1229,43],["αὐτῶν",3,41]],"He heals the broken in heart, and binds up their wounds."],["4",[["Ὁ",1,4],["ἀριθμῶν",355,77],["πλήθη",200,63],["ἄστρων",1338,45],["καὶ",2,8],["πᾶσιν",11,215],["αὐτοῖς",3,142],["ὀνόματα",57,43],["καλῶν",266,79]],"He numbers the multitudes of stars; and calls them all by names."],["5",[["Μέγας",66,16],["ὁ",1,4],["Κύριος",7,5],["ἡμῶν",6,41],["καὶ",2,8],["μεγάλη",66,15],["ἡ",1,11],["ἰσχὺς",181,13],["αὐτοῦ",3,48],["καὶ",2,8],["τῆς",1,18],["συνέσεως",469,19],["αὐτοῦ",3,48],["οὐκ",12,17],["ἔστιν",10,87],["ἀριθμός",355,5]],"Great is our Lord, and great is his strength; and his understanding is infinite."],["6",[["Ἀναλαμβάνων",575,67],["πρᾳεῖς",2286,130],["ὁ",1,4],["Κύριος",7,5],["ταπεινῶν",322,67],["δὲ",14,12],["ἁμαρτωλοὺς",409,58],["ἕως",42,8],["τῆς",1,18],["γῆς",26,19]],"The Lord lifts up the meek; but brings sinners down to the ground."],["7",[["Ἐξάρξατε",2225,69],["τῷ",1,110],["Κυρίῳ",7,113],["ἐν",4,1],["ἐξομολογήσει",479,120],["ψάλατε",913,69],["τῷ",1,110],["Θεῷ",20,113],["ἡμῶν",6,41],["ἐν",4,1],["κιθάρᾳ",1513,2]],"Begin [the song] with thanksgiving to the Lord; sing praises on the harp to our God:"],["8",[["Τῷ",1,110],["περιβάλλ