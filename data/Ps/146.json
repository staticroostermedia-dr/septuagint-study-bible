[["1",[["Ἀλληλούϊα",1746,105],["Ἀγγαίου",1994,153],["καὶ",2,8],["Ζαχαρίου",894,21],["Αἰνεῖτε",399,311],["τὸν",1,6],["Κύριον",7,7],["ὅτι",19,8],["ἀγαθὸν",113,59],["ψαλμός",639,5],["τῷ",1,110],["Θεῷ",20,113],["ἡμῶν",6,41],["ἡδυνθείη",3215,555],["αἴνεσις",990,13]],"Alleluia, [a Psalm] of Aggæus and Zacharias. Praise ye the Lord: for psalmody is a good thing; let praise be sweetly sung to our God."],["2",[["Οἰκοδομῶν",125,67],["Ἱερουσαλὴμ",69,20],["ὁ",1,4],["Κύριος",7,5],["καὶ",2,8],["τὰς",1,39],["διασπορὰς",3060,40],["τοῦ",1,30],["Ἰσραὴλ",27,105],["ἐπισυνάξει",1128,120]],"The Lord builds up Jerusalem; and he will gather together the dispersed of Israel."],["3",[["Ὁ",1,4],["ἰώμενος",794,114],["τοὺς",1,56],["συντετριμμένους",267,374],["τὴν",1,9],["καρδίαν",63,10],["καὶ",2,8],["δεσμεύων",2708,67],["τὰ",1,42],["συντρίμματα",1231,43],["αὐτῶν",3,41]],"He heals the broken in heart, and binds up their wounds."],["4",[["Ὁ",1,4],["ἀριθμῶν",353,77],["πλήθη",199,63],["ἄστρων",1334,45],["καὶ",2,8],["πᾶσιν",11,215],["αὐτοῖς",3,142],["ὀνόματα",55,43],["καλῶν",264,79]],"He numbers the multitudes of stars; and calls them all by names."],["5",[["Μέγας",65,16],["ὁ",1,4],["Κύριος",7,5],["ἡμῶν",6,41],["καὶ",2,8],["μεγάλη",65,15],["ἡ",1,11],["ἰσχὺς",180,13],["αὐτοῦ",3,48],["καὶ",2,8],["τῆς",1,18],["συνέσεως",467,19],["αὐτοῦ",3,48],["οὐκ",12,17],["ἔστιν",10,87],["ἀριθμός",353,5]],"Great is our Lord, and great is his strength; and his understanding is infinite."],["6",[["Ἀναλαμβάνων",573,67],["πρᾳεῖς",2298,130],["ὁ",1,4],["Κύριος",7,5],["ταπεινῶν",333,67],["δὲ",14,12],["ἁμαρτωλοὺς",406,58],["ἕως",42,8],["τῆς",1,18],["γῆς",26,19]],"The Lord lifts up the meek; but brings sinners down to the ground."],["7",[["Ἐξάρξατε",2329,69],["τῷ",1,110],["Κυρίῳ",7,113],["ἐν",4,1],["ἐξομολογήσει",478,120],["ψάλατε",901,69],["τῷ",1,110],["Θεῷ",20,113],["ἡμῶν",6,41],["ἐν",4,1],["κιθάρᾳ",1513,2]],"Begin [the song] with thanksgiving to the Lord; sing praises on the harp to our God:"],["8",[["Τῷ",1,110],["περιβάλλ