[["1",[["Στηλογραφία",3640,13],["τῷ",1,110],["Δαυίδ",52,105],["Φύλαξον",125,198],["με",6,82],["Κύριε",7,250],["ὅτι",19,8],["ἐπὶ",9,1],["σοὶ",5,151],["ἤλπισα",514,147]],"A writing of David. Keep me, O Lord; for I have hoped in thee."],["2",[["Εἶπα",18,147],["τῷ",1,110],["Κυρίῳ",7,113],["Κύριός",7,5],["μου",6,48],["εἶ",10,145],["σὺ",5,156],["ὅτι",19,8],["τῶν",1,76],["ἀγαθῶν",114,163],["μου",6,48],["οὐ",12,17],["χρείαν",1006,10],["ἔχεις",124,145]],"I said to the Lord, Thou art my Lord; for thou hast no need of my goodness."],["3",[["Τοῖς",1,138],["ἁγίοις",75,215],["τοῖς",1,138],["ἐν",4,1],["τῇ",1,95],["γῇ",26,2],["αὐτοῦ",3,48],["ἐθαυμάστωσε",3060,3],["πάντα",11,65],["τὰ",1,42],["θελήματα",1039,43],["αὐτοῦ",3,48],["ἐν",4,1],["αὐτοῖς",3,142]],"On behalf of the saints that are in his land, he has magnified all his pleasure in them."],["4",[["Ἐπληθύνθησαν",316,94],["αἱ",1,185],["ἀσθένειαι",3413,180],["αὐτῶν",3,41],["μετὰ",29,1],["ταῦτα",16,248],["ἐτάχυναν",2120,141],["οὐ",12,17],["μὴ",25,8],["συναγάγω",166,227],["τὰς",1,39],["συναγωγὰς",284,40],["αὐτῶν",3,168],["ἐξ",21,1],["αἱμάτων",148,45],["οὐδὲ",106,12],["μὴ",25,8],["μνησθῶ",230,555],["τῶν",1,44],["ὀνομάτων",57,45],["αὐτῶν",3,168],["διὰ",56,1],["χειλέων",361,45],["μου",6,48]],"Their weaknesses have been multiplied; afterward they hasted. I will by no means assemble their bloody meetings, neither will I make mention of their names with my lips."],["5",[["Κύριος",7,5],["μερὶς",399,13],["τῆς",1,18],["κληρονομίας",299,19],["μου",6,83],["καὶ",2,8],["τοῦ",1,23],["ποτηρίου",1355,24],["μου",6,48],["σὺ",5,156],["εἶ",10,145],["ὁ",1,4],["ἀποκαθιστῶν",6305,67],["τὴν",1,9],["κληρονομίαν",299,10],["μου",6,48],["ἐμοί",6,49]],"The Lord is the portion of mine inheritance and of my cup: thou art he that restores my inheritance to me."],["6",[["Σχοινία",1527,43],["ἐπέπεσάν",9488,141],["μοι",6,49],["ἐν",4,1],["τοῖς",1,138],["κρατίστοις",3074,215],["καὶ",2,8],["γὰρ",40,12],["ἡ",1,11],["κληρονομία",299,13],["μου",6,48],["κρατίστη",3074,15],["μοι",6,49],["ἐστίν",10,87]],"The lines have fallen to me in the best places, yea, I have a most excellent heritage."],["7",[["Εὐλογήσω",149,157],["τὸν",1,6],["Κύριον",7,7],["τὸν",1,6],["συνετίσαντά",2194,476],["με",6,82],["ἔτι",111,17],["δὲ",14,12],["καὶ",2,8],["ἕως",42,8],["νυκτὸς",219,19],["ἐπαίδευσάν",643,141],["με",6,82],["οἱ",1,128],["νεφροί",1414,51],["μου",6,48]],"I will bless the Lord who has instructed me; my reins too have chastened me even till night."],["8",[["Προωρώμην",8069,374],["τὸν",1,6],["Κύριον",7,7],["ἐνώπιόν",115,1],["μου",6,48],["διαπαντὸς",510,17],["ὅτι",19,8],["ἐκ",21,1],["δεξιῶν",282,79],["μου",6,48],["ἐστὶν",10,87],["ἵνα",102,8],["μὴ",25,8],["σαλευθῶ",678,555]],"I foresaw the Lord always before my face; for he is on my right hand, that I should not be moved."],["9",[["Διὰ",56,1],["τοῦτο",16,122],["ηὐφράνθη",244,38],["ἡ",1,11],["καρδία",64,13],["μου",6,48],["καὶ",2,8],["ἠγαλλιάσατο",738,26],["ἡ",1,11],["γλῶσσά",388,13],["μου",6,48],["ἔτι",111,17],["δὲ",14,12],["καὶ",2,8],["ἡ",1,11],["σάρξ",287,13],["μου",6,48],["κατασκηνώσει",805,120],["ἐπʼ",9,1],["ἐλπίδι",530,2]],"Therefore my heart rejoiced and my tongue exulted; moreover also my flesh shall rest in hope:"],["10",[["Ὅτι",19,8],["οὐκ",12,17],["ἐγκαταλείψεις",364,159],["τὴν",1,9],["ψυχήν",63,10],["μου",6,48],["εἰς",8,1],["ᾅδην",586,7],["οὐδὲ",106,12],["δώσεις",33,159],["τὸν",1,6],["ὅσιόν",917,59],["σου",5,146],["ἰδεῖν",53,100],["διαφθοράν",1671,10]],"because thou wilt not leave my soul in hell, neither wilt thou suffer thine Holy One to see corruption."],["11",[["Ἐγνώρισάς",748,154],["μοι",6,49],["ὁδοὺς",68,40],["ζωῆς",216,19],["πληρώσεις",518,159],["με",6,82],["εὐφροσύνης",360,19],["μετὰ",29,1],["τοῦ",1,23],["προσώπου",47,24],["σου",5,146],["τερπνότητες",6149,180],["ἐν",4,1],["τῇ",1,95],["δεξιᾷ",282,96],["σου",5,146],["εἰς",8,1],["τέλος",373,33]],"Thou hast made known to me the ways of life; thou wilt fill me with joy with thy countenance: at thy right hand [there are] delights for ever."]]