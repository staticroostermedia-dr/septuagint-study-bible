[["1",[["Ψαλμὸς",644,5],["ᾠδῆς",776,19],["εἰς",8,1],["τὴν",1,9],["ἡμέραν",28,10],["τοῦ",1,23],["σαββάτου",442,24]],"A Psalm of a Song for the Sabbath-day."],["2",[["Ἀγαθὸν",114,29],["τὸ",1,32],["ἐξομολογεῖσθαι",479,104],["τῷ",1,110],["Κυρίῳ",7,113],["καὶ",2,8],["ψάλλειν",913,54],["τῷ",1,52],["ὀνόματί",57,53],["σου",5,146],["ὕψιστε",474,309]],"It is a good thing to give thanks to the Lord, and to sing praises to thy name, O thou Most High;"],["3",[["τοῦ",1,30],["ἀναγγέλλειν",231,54],["τοπρωῒ",0,0],["τὸ",1,32],["ἔλεός",183,33],["σου",5,146],["καὶ",2,8],["τὴν",1,9],["ἀλήθειάν",352,10],["σου",5,146],["κατὰ",32,1],["νύκτα",219,10]],"to proclaim thy mercy in the morning, and thy truth by night,"],["4",[["ἐν",4,1],["δεκαχόρδῳ",4735,34],["ψαλτηρίῳ",1693,53],["μετʼ",29,1],["ᾠδῆς",776,19],["ἐν",4,1],["κιθάρᾳ",1513,2]],"on a psaltery of ten strings, with a song on the harp."],["5",[["Ὅτι",19,8],["εὔφρανάς",244,154],["με",6,82],["Κύριε",7,250],["ἐν",4,1],["τῷ",1,52],["ποιήματί",1443,53],["σου",5,146],["καὶ",2,8],["ἐν",4,1],["τοῖς",1,91],["ἔργοις",105,92],["τῶν",1,123],["χειρῶν",37,61],["σου",5,146],["ἀγαλλιάσομαι",738,177]],"For thou, O Lord, hast made me glad with thy work: and in the operations of thy hands will I exult."],["6",[["Ὡς",36,8],["ἐμεγαλύνθη",604,38],["τὰ",1,42],["ἔργα",105,43],["σου",5,146],["Κύριε",7,250],["σφόδρα",150,17],["ἐβαθύνθησαν",5484,94],["οἱ",1,128],["διαλογισμοί",1584,51],["σου",5,146]],"How have thy works been magnified, O Lord! thy thoughts are very deep."],["7",[["Ἀνὴρ",38,5],["ἄφρων",439,16],["οὐ",12,17],["γνώσεται",79,89],["καὶ",2,8],["ἀσύνετος",2517,15],["οὐ",12,17],["συνήσει",606,120],["ταῦτα",16,248]],"A foolish man will not know, and a senseless man will not understand this."],["8",[["Ἐν",4,1],["τῷ",1,110],["ἀνατεῖλαι",900,100],["τοὺς",1,56],["ἁμαρτωλοὺς",409,58],["ὡσεὶ",343,17],["χόρτον",1046,7],["καὶ",2,8],["διέκυψαν",2706,141],["πάντες",11,130],["οἱ",1,128],["ἐργαζόμενοι",467,351],["τὴν",1,9],["ἀνομίαν",275,10],["ὅπως",240,8],["ἂν",83,12],["ἐξολοθρευθῶσιν",291,266],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["τοῦ",1,30],["αἰῶνος",100,21]],"When the sinners spring up as the grass, and all the workers of iniquity have watched; [it is] that they may be utterly destroyed for ever."],["9",[["Σὺ",5,156],["δὲ",14,12],["ὕψιστος",474,16],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["Κύριε",7,250]],"But thou, O Lord, art most high for ever."],["10",[["Ὅτι",19,8],["ἰδοὺ",51,17],["οἱ",1,128],["ἐχθροί",135,51],["σου",5,146],["ἀπολοῦνται",217,127],["καὶ",2,8],["διασκορπισθήσονται",1001,135],["πάντες",11,130],["οἱ",1,128],["ἐργαζόμενοι",467,351],["τὴν",1,9],["ἀνομίαν",275,10]],"For, behold, thine enemies shall perish; and all the workers of iniquity shall be scattered."],["11",[["Καὶ",2,8],["ὑψωθήσεται",331,125],["ὡς",36,8],["μονοκέρωτος",0,0],["τὸ",1,32],["κέρας",569,33],["μου",6,48],["καὶ",2,8],["τὸ",1,32],["γῆράς",1267,33],["μου",6,48],["ἐν",4,1],["ἐλέῳ",183,113],["πίονι",1973,113]],"But my horn shall be exalted as [the horn] of a unicorn; and mine old age with rich mercy."],["12",[["Καὶ",2,8],["ἐπεῖδεν",1865,3],["ὁ",1,4],["ὀφθαλμός",91,5],["μου",6,48],["ἐν",4,1],["τοῖς",1,138],["ἐχθροῖς",135,139],["μου",6,48],["καὶ",2,8],["ἐν",4,1],["τοῖς",1,138],["ἐπανισταμένοις",1216,342],["ἐπʼ",9,1],["ἐμὲ",6,82],["πονηρευομένοις",1331,342],["ἀκούσεται",54,89],["τὸ",1,32],["οὖς",328,33],["μου",6,48]],"And mine eye has seen mine enemies, and mine ear shall hear the wicked that rise up against me."],["13",[["Δίκαιος",153,16],["ὡς",36,8],["φοῖνιξ",1171,5],["ἀνθήσει",2207,120],["ὡς",36,8],["ἡ",1,11],["κέδρος",873,13],["ἡ",1,11],["ἐν",4,1],["τῷ",1,110],["Λιβάνῳ",537,113],["πληθυνθήσεται",316,125]],"The righteous shall flourish as a palm-tree: he shall be increased as the cedar in Libanus."],["14",[["Πεφυτευμένοι",1022,370],["ἐν",4,1],["τῷ",1,110],["οἴκῳ",34,113],["Κυρίου",7,21],["ἐν",4,1],["ταῖς",1,70],["αὐλαῖς",327,71],["τοῦ",1,30],["Θεοῦ",20,21],["ἡμῶν",6,41],["ἐξανθήσουσι",1800,207]],"They that are planted in the house of the Lord shall flourish in the courts of our God."],["15",[["Τότε",250,17],["πληθυνθήσονται",316,135],["ἐν",4,1],["γήρει",3512,53],["πίονι",1973,113],["καὶ",2,8],["εὐπαθοῦντες",5622,137],["ἔσονται",10,127]],"Then shall they be increased in a fine old age; and they shall be prosperous; that they may declare"],["16",[["τοῦ",1,30],["ἀναγγεῖλαι",231,100],["ὅτι",19,8],["εὐθὴς",825,16],["Κύριος",7,5],["ὁ",1,4],["Θεός",20,5],["μου",6,48],["καὶ",2,8],["οὐκ",12,17],["ἔστιν",10,87],["ἀδικία",288,13],["ἐν",4,1],["αὐτῷ",3,49]],"that the Lord my God is righteous, and there is no iniquity in him."]]