[["1",[["Ψαλμὸς",639,5],["ᾠδῆς",773,19],["εἰς",8,1],["τὴν",1,9],["ἡμέραν",28,10],["τοῦ",1,23],["σαββάτου",441,24]],"A Psalm of a Song for the Sabbath-day."],["2",[["Ἀγαθὸν",113,29],["τὸ",1,32],["ἐξομολογεῖσθαι",478,104],["τῷ",1,110],["Κυρίῳ",7,113],["καὶ",2,8],["ψάλλειν",901,54],["τῷ",1,52],["ὀνόματί",55,53],["σου",5,146],["ὕψιστε",473,313]],"It is a good thing to give thanks to the Lord, and to sing praises to thy name, O thou Most High;"],["3",[["τοῦ",1,30],["ἀναγγέλλειν",228,54],["τοπρωῒ",0,0],["τὸ",1,32],["ἔλεός",182,33],["σου",5,146],["καὶ",2,8],["τὴν",1,9],["ἀλήθειάν",350,10],["σου",5,146],["κατὰ",32,1],["νύκτα",216,10]],"to proclaim thy mercy in the morning, and thy truth by night,"],["4",[["ἐν",4,1],["δεκαχόρδῳ",4761,34],["ψαλτηρίῳ",1698,53],["μετʼ",29,1],["ᾠδῆς",773,19],["ἐν",4,1],["κιθάρᾳ",1513,2]],"on a psaltery of ten strings, with a song on the harp."],["5",[["Ὅτι",19,8],["εὔφρανάς",242,154],["με",6,82],["Κύριε",7,251],["ἐν",4,1],["τῷ",1,52],["ποιήματί",1444,53],["σου",5,146],["καὶ",2,8],["ἐν",4,1],["τοῖς",1,91],["ἔργοις",104,92],["τῶν",1,123],["χειρῶν",37,61],["σου",5,146],["ἀγαλλιάσομαι",737,176]],"For thou, O Lord, hast made me glad with thy work: and in the operations of thy hands will I exult."],["6",[["Ὡς",36,8],["ἐμεγαλύνθη",606,38],["τὰ",1,42],["ἔργα",104,43],["σου",5,146],["Κύριε",7,251],["σφόδρα",149,17],["ἐβαθύνθησαν",5515,94],["οἱ",1,128],["διαλογισμοί",1585,51],["σου",5,146]],"How have thy works been magnified, O Lord! thy thoughts are very deep."],["7",[["Ἀνὴρ",38,5],["ἄφρων",438,16],["οὐ",12,17],["γνώσεται",81,89],["καὶ",2,8],["ἀσύνετος",2520,15],["οὐ",12,17],["συνήσει",602,120],["ταῦτα",16,249]],"A foolish man will not know, and a senseless man will not understand this."],["8",[["Ἐν",4,1],["τῷ",1,110],["ἀνατεῖλαι",902,100],["τοὺς",1,56],["ἁμαρτωλοὺς",406,58],["ὡσεὶ",342,17],["χόρτον",1044,7],["καὶ",2,8],["διέκυψαν",2712,141],["πάντες",11,130],["οἱ",1,128],["ἐργαζόμενοι",468,356],["τὴν",1,9],["ἀνομίαν",274,10],["ὅπως",236,8],["ἂν",82,12],["ἐξολοθρευθῶσιν",291,267],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["τοῦ",1,30],["αἰῶνος",100,21]],"When the sinners spring up as the grass, and all the workers of iniquity have watched; [it is] that they may be utterly destroyed for ever."],["9",[["Σὺ",5,156],["δὲ",14,12],["ὕψιστος",473,16],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["Κύριε",7,251]],"But thou, O Lord, art most high for ever."],["10",[["Ὅτι",19,8],["ἰδοὺ",51,17],["οἱ",1,128],["ἐχθροί",135,51],["σου",5,146],["ἀπολοῦνται",213,127],["καὶ",2,8],["διασκορπισθήσονται",1001,135],["πάντες",11,130],["οἱ",1,128],["ἐργαζόμενοι",468,356],["τὴν",1,9],["ἀνομίαν",274,10]],"For, behold, thine enemies shall perish; and all the workers of iniquity shall be scattered."],["11",[["Καὶ",2,8],["ὑψωθήσεται",327,125],["ὡς",36,8],["μονοκέρωτος",0,0],["τὸ",1,32],["κέρας",567,33],["μου",6,48],["καὶ",2,8],["τὸ",1,32],["γῆράς",1267,33],["μου",6,48],["ἐν",4,1],["ἐλέῳ",182,113],["πίονι",1977,113]],"But my horn shall be exalted as [the horn] of a unicorn; and mine old age with rich mercy."],["12",[["Καὶ",2,8],["ἐπεῖδεν",1866,3],["ὁ",1,4],["ὀφθαλμός",91,5],["μου",6,48],["ἐν",4,1],["τοῖς",1,138],["ἐχθροῖς",135,139],["μου",6,48],["καὶ",2,8],["ἐν",4,1],["τοῖς",1,138],["ἐπανισταμένοις",1221,346],["ἐπʼ",9,1],["ἐμὲ",6,82],["πονηρευομένοις",1387,346],["ἀκούσεται",53,89],["τὸ",1,32],["οὖς",325,33],["μου",6,48]],"And mine eye has seen mine enemies, and mine ear shall hear the wicked that rise up against me."],["13",[["Δίκαιος",152,16],["ὡς",36,8],["φοῖνιξ",1172,5],["ἀνθήσει",2220,120],["ὡς",36,8],["ἡ",1,11],["κέδρος",874,13],["ἡ",1,11],["ἐν",4,1],["τῷ",1,110],["Λιβάνῳ",534,113],["πληθυνθήσεται",315,125]],"The righteous shall flourish as a palm-tree: he shall be increased as the cedar in Libanus."],["14",[["Πεφυτευμένοι",0,0],["ἐν",4,1],["τῷ",1,110],["οἴκῳ",34,113],["Κυρίου",7,21],["ἐν",4,1],["ταῖς",1,70],["αὐλαῖς",324,71],["τοῦ",1,30],["Θεοῦ",20,21],["ἡμῶν",6,41],["ἐξανθήσουσι",1801,207]],"They that are planted in the house of the Lord shall flourish in the courts of our God."],["15",[["Τότε",250,17],["πληθυνθήσονται",315,135],["ἐν",4,1],["γήρει",3515,53],["πίονι",1977,113],["καὶ",2,8],["εὐπαθοῦντες",5652,137],["ἔσονται",10,127]],"Then shall they be increased in a fine old age; and they shall be prosperous; that they may declare"],["16",[["τοῦ",1,30],["ἀναγγεῖλαι",228,100],["ὅτι",19,8],["εὐθὴς",826,16],["Κύριος",7,5],["ὁ",1,4],["Θεός",20,5],["μου",6,48],["καὶ",2,8],["οὐκ",12,17],["ἔστιν",10,87],["ἀδικία",288,13],["ἐν",4,1],["αὐτῷ",3,49]],"that the Lord my God is righteous, and there is no iniquity in him."]]