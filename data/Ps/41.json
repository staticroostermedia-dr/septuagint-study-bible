[["1",[["Εἰς",8,1],["τὸ",1,32],["τέλος",373,33],["εἰς",8,1],["σύνεσιν",469,10],["τοῖς",1,138],["υἱοῖς",13,139],["Κορέ",874,250]],"For the end, [a Psalm] for instruction, for the sons of Core."],["2",[["Ὃν",24,106],["τρόπον",245,7],["ἐπιποθεῖ",2537,87],["ἡ",1,11],["ἔλαφος",1868,5],["ἐπὶ",9,1],["τὰς",1,39],["πηγὰς",565,40],["τῶν",1,44],["ὑδάτων",85,45],["οὕτως",71,17],["ἐπιποθεῖ",2537,87],["ἡ",1,11],["ψυχή",63,13],["μου",6,48],["πρὸς",15,1],["σὲ",5,161],["ὁ",1,4],["Θεός",20,5]],"As the hart earnestly desires the fountains of water, so my soul earnestly longs for thee, O God."],["3",[["Ἐδίψησεν",1161,3],["ἡ",1,11],["ψυχή",63,13],["μου",6,48],["πρὸς",15,1],["τὸν",1,6],["Θεὸν",20,7],["τὸν",1,6],["ζῶντα",107,178],["πότε",458,12],["ἥξω",260,157],["καὶ",2,8],["ὀφθήσομαι",112,176],["τῷ",1,52],["προσώπῳ",47,53],["τοῦ",1,30],["Θεοῦ",20,21]],"My soul has thirsted for the living God: when shall I come and appear before God?"],["4",[["Ἐγενήθη",30,38],["τὰ",1,42],["δάκρυά",1268,43],["μου",6,48],["ἐμοὶ",6,49],["ἄρτος",197,5],["ἡμέρας",28,19],["καὶ",2,8],["νυκτὸς",219,19],["ἐν",4,1],["τῷ",1,110],["λέγεσθαί",31,104],["μοι",6,49],["καθʼ",32,1],["ἑκάστην",171,37],["ἡμέραν",28,10],["ποῦ",478,17],["ἐστιν",10,87],["ὁ",1,4],["Θεός",20,5],["σου",5,146]],"My tears have been bread to me day and night, while they daily said to me, Where is thy God?"],["5",[["Ταῦτα",16,248],["ἐμνήσθην",230,148],["καὶ",2,8],["ἐξέχεα",436,147],["ἐπʼ",9,1],["ἐμὲ",6,98],["τὴν",1,9],["ψυχήν",63,10],["μου",6,48],["ὅτι",19,8],["διελεύσομαι",423,177],["ἐν",4,1],["τόπῳ",99,113],["σκηνῆς",131,19],["θαυμαστῆς",1073,78],["ἕως",42,8],["τοῦ",1,30],["οἴκου",34,21],["τοῦ",1,30],["Θεοῦ",20,21],["ἐν",4,1],["φωνῇ",95,2],["ἀγαλλιάσεως",1981,19],["καὶ",2,8],["ἐξομολογήσεως",1934,19],["ἤχου",1803,21],["ἑορταζόντων",2060,164]],"I remembered these things, and poured out my soul in me, for I will go to the place of thy wondrous tabernacle, [even] to the house of God, with a voice of exultation and thanksgiving and of the sound of those who keep festival."],["6",[["Ἱνατί",102,238],["περίλυπος",3619,15],["εἶ",10,145],["ἡ",1,11],["ψυχή",63,13],["μου",6,48],["καὶ",2,8],["ἱνατί",102,238],["συνταράσσεις",2042,145],["με",6,82],["ἔλπισον",514,198],["ἐπὶ",9,1],["τὸν",1,6],["Θεὸν",20,7],["ὅτι",19,8],["ἐξομολογήσομαι",479,177],["αὐτῷ",3,49],["σωτήριον",472,33],["τοῦ",1,23],["προσώπου",47,24],["μου",6,48]],"Wherefore art thou very sad, O my soul? and wherefore dost thou trouble me? hope in God; for I will give thanks to him; [he is] the salvation of my countenance."],["7",[["Ὁ",1,4],["Θεός",20,5],["μου",6,48],["πρὸς",15,1],["ἐμαυτὸν",890,82],["ἡ",1,11],["ψυχή",63,13],["μου",6,48],["ἐταράχθη",508,38],["διὰ",56,1],["τοῦτο",16,122],["μνησθήσομαί",230,176],["σου",5,146],["ἐκ",21,1],["γῆς",26,19],["Ἰορδάνου",303,21],["καὶ",2,8],["Ἐρμωνιεὶμ",0,0],["ἀπὸ",17,1],["ὄρους",87,24],["μικροῦ",367,88]],"O my God, my soul has been troubled within me: therefore will I remember thee from the land of Jordan, and of the Ermonites, from the little hill."],["8",[["Ἄβυσσος",1083,13],["ἄβυσσον",1083,10],["ἐπικαλεῖται",341,108],["εἰς",8,1],["φωνὴν",95,10],["τῶν",1,76],["καταῤῥακτῶν",2584,77],["σου",5,146],["πάντες",11,130],["οἱ",1,128],["μετεωρισμοί",3298,51],["σου",5,146],["καὶ",2,8],["τὰ",1,42],["κύματά",1630,43],["σου",5,146],["ἐπʼ",9,1],["ἐμὲ",6,82],["διῆλθον",423,141]],"Deep calls to deep at the voice of thy cataracts: all thy billows and thy waves have gone over me."],["9",[["Ἡμέρας",28,19],["ἐντελεῖται",143,89],["Κύριος",7,5],["τὸ",1,32],["ἔλεος",183,33],["αὐτοῦ",3,48],["καὶ",2,8],["νυκτὸς",219,19],["δηλώσει",1670,120],["παρʼ",73,1],["ἐμοὶ",6,49],["προσευχὴ",550,13],["τῷ",1,110],["Θεῷ",20,113],["τῆς",1,18],["ζωῆς",216,19],["μου",6,83]],"By day the Lord will command his mercy, and manifest [it] by night: with me [is] prayer to the God of my life."],["10",[["ἐρῶ",165,157],["τῷ",1,110],["Θεῷ",20,113],["ἀντιλήπτωρ",2209,5],["μου",6,48],["εἶ",10,145],["διατί",960,105],["μου",6,48],["ἐπελάθου",513,169],["ἱνατί",102,238],["σκυθρωπάζων",3352,67],["πορεύομαι",49,251],["ἐν",4,1],["τῷ",1,110],["ἐκθλίβειν",1930,54],["τὸν",1,6],["ἐχθρόν",135,7],["μου",6,48]],"I will say to God, Thou art my helper; why hast thou forgotten me? wherefore do I go sad of countenance, while the enemy oppresses [me]?"],["11",[["Ἐν",4,1],["τῷ",1,110],["καταθλᾶσθαι",5684,104],["τὰ",1,42],["ὀστᾶ",473,43],["μου",6,48],["ὠνείδισάν",945,141],["με",6,82],["οἱ",1,128],["θλίβοντές",601,137],["με",6,82],["ἐν",4,1],["τῷ",1,110],["λέγειν",31,54],["αὐτούς",3,60],["μοι",6,49],["καθʼ",32,1],["ἑκάστην",171,37],["ἡμέραν",28,10],["ποῦ",478,17],["ἐστιν",10,87],["ὁ",1,4],["Θεός",20,5],["σου",5,146]],"While my bones were breaking, they that afflicted me reproached me; while they said to me daily, Where is thy God?"],["12",[["Ἱνατί",102,238],["περίλυπος",3619,15],["εἶ",10,145],["ἡ",1,11],["ψυχή",63,13],["μου",6,48],["καὶ",2,8],["ἱνατί",102,238],["συνταράσσεις",2042,145],["με",6,82],["ἔλπισον",514,198],["ἐπὶ",9,1],["τὸν",1,6],["Θεὸν",20,7],["ὅτι",19,8],["ἐξομολογήσομαι",479,177],["αὐτῷ",3,49],["ἡ",1,11],["σωτηρία",425,13],["τοῦ",1,23],["προσώπου",47,24],["μου",6,48],["καὶ",2,8],["ὁ",1,4],["Θεός",20,5],["μου",6,48]],"Wherefore art thou very sad, O my soul? and wherefore dost thou trouble me? hope in God; for I will give thanks to him; [he is] the health of my countenance, and my God."]]