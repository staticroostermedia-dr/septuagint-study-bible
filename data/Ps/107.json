[["1",[["Ὠδὴ",776,105],["ψαλμοῦ",644,21],["τῷ",1,110],["Δαυίδ",52,105]],"Song of a Psalm by David."],["2",[["Ἑτοίμη",904,15],["ἡ",1,11],["καρδία",64,13],["μου",6,48],["ὁ",1,4],["Θεὸς",20,5],["ἑτοίμη",904,15],["ἡ",1,11],["καρδία",64,13],["μου",6,48],["ᾄσομαι",856,177],["καὶ",2,8],["ψαλῶ",913,157],["ἐν",4,1],["τῇ",1,95],["δόξῃ",141,2],["μου",6,48]],"O God, my heart is ready, my heart is ready; I will sing and sing psalms with my glory."],["3",[["Ἐξεγέρθητι",656,242],["ψαλτήριον",1693,20],["καὶ",2,8],["κιθάρα",1513,13],["ἐξεγερθήσομαι",656,176],["ὄρθρου",1434,21]],"Awake, psaltery and harp; I will awake early."],["4",[["Ἐξομολογήσομαί",479,177],["σοι",5,151],["ἐν",4,1],["λαοῖς",35,139],["Κύριε",7,250],["ψαλῶ",913,157],["σοι",5,151],["ἐν",4,1],["ἔθνεσιν",60,92]],"I will give thanks to thee, O Lord, among the people; I will sing praise to thee among the Gentiles."],["5",[["Ὅτι",19,8],["μέγα",66,29],["ἐπάνω",491,17],["τῶν",1,76],["οὐρανῶν",94,77],["τὸ",1,32],["ἔλεός",183,33],["σου",5,146],["καὶ",2,8],["ἕως",42,8],["τῶν",1,123],["νεφελῶν",444,61],["ἡ",1,11],["ἀλήθειά",352,13],["σου",5,146]],"For thy mercy is great above the heavens, and thy truth [reaches] to the clouds."],["6",[["Ὑψώθητι",331,242],["ἐπὶ",9,1],["τοὺς",1,56],["οὐρανοὺς",94,31],["ὁ",1,4],["Θεὸς",20,5],["καὶ",2,8],["ἐπὶ",9,1],["πᾶσαν",11,37],["τὴν",1,9],["γῆν",26,10],["ἡ",1,11],["δόξα",141,188],["σου",5,146]],"Be thou exalted, O God, above the heavens; and thy glory above all the earth."],["7",[["Ὅπως",240,8],["ἂν",83,12],["ῥυσθῶσιν",337,266],["οἱ",1,128],["ἀγαπητοί",1920,130],["σου",5,146],["σῶσον",172,198],["τῇ",1,95],["δεξιᾷ",282,96],["σου",5,146],["καὶ",2,8],["ἐπάκουσόν",597,198],["μου",6,48]],"That thy beloved [ones] may be delivered, save with thy right hand, and hear me.",{"s":"r"}],["8",[["Ὁ",1,4],["Θεὸς",20,5],["ἐλάλησεν",50,3],["ἐν",4,1],["τῷ",1,110],["ἁγίῳ",75,111],["αὐτοῦ",3,48],["ὑψωθήσομαι",331,176],["καὶ",2,8],["διαμεριῶ",2075,157],["Σίκιμα",2965,105],["καὶ",2,8],["τὴν",1,9],["κοιλάδα",1058,10],["τῶν",1,123],["σκηνῶν",131,61],["διαμετρήσω",1242,157]],"God has spoken in his sanctuary; I will be exalted, and will divide Sicima, and will measure out the valley of tents.",{"s":"r"}],["9",[["Ἐμός",525,5],["ἐστι",10,87],["Γαλαὰδ",0,0],["καὶ",2,8],["ἐμός",525,5],["ἐστι",10,87],["Μανασσῆς",396,5],["καὶ",2,8],["Ἐφραίμ",308,105],["ἀντίληψις",2404,13],["τῆς",1,18],["κεφαλῆς",144,19],["μου",6,83],["Ἰούδας",62,5],["βασιλεύς",22,5],["μου",6,48]],"Galaad is mine; and Manasses is mine; and Ephraim is the help of mine head; Judas is my king;"],["10",[["Μωὰβ",0,0],["λέβης",1346,5],["τῆς",1,18],["ἐλπίδος",530,19],["μου",6,83],["ἐπὶ",9,1],["τὴν",1,9],["Ἰδουμαίαν",1319,37],["ἐπιβαλῶ",724,157],["τὸ",1,32],["ὑπόδημά",1665,33],["μου",6,48],["ἐμοὶ",6,49],["ἀλλόφυλοι",203,130],["ὑπετάγησαν",1497,94]],"Moab is the caldron of my hope; over Idumea will I cast my sandal; the Philistines are made subject to me."],["11",[["Τίς",39,150],["ἀπάξει",1212,120],["με",6,98],["εἰς",8,1],["πόλιν",41,10],["περιοχῆς",1594,19],["ἢ",61,8],["τίς",39,150],["ὁδηγήσει",1108,120],["με",6,82],["ἕως",42,8],["τῆς",1,18],["Ἰδουμαίας",1218,19]],"Who will bring me into the fortified city? or who will guide me to Idumea?"],["12",[["Οὐχὶ",330,12],["σὺ",5,156],["ὁ",1,4],["Θεὸς",20,5],["ὁ",1,4],["ἀπωσάμενος",770,244],["ἡμᾶς",6,60],["καὶ",2,8],["οὐκ",12,17],["ἐξελεύσῃ",82,116],["ὁ",1,4],["Θεὸς",20,5],["ἐν",4,1],["ταῖς",1,70],["δυνάμεσιν",98,71],["ἡμῶν",6,41]],"Wilt not thou, O God, who hast rejected us? and wilt not thou, O God, go forth with our hosts?"],["13",[["Δὸς",33,198],["ἡμῖν",6,142],["βοήθειαν",765,10],["ἐκ",21,1],["θλίψεως",438,19],["καὶ",2,8],["ματαία",654,15],["σωτηρία",425,13],["ἀνθρώπου",43,21]],"Give us help from tribulation: for vain is the help of man."],["14",[["Ἐν",4,1],["τῷ",1,110],["Θεῷ",20,113],["ποιήσομεν",23,269],["δύναμιν",98,10],["καὶ",2,8],["αὐτὸς",3,158],["ἐξουδενώσει",1068,120],["τοὺς",1,56],["ἐχθροὺς",135,31],["ἡμῶν",6,41]],"Through God we shall do valiantly; and he will bring to nought our enemies."]]