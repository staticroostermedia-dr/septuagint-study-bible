[["1",[["Ὠδὴ",773,105],["ψαλμοῦ",639,21],["τῷ",1,110],["Δαυίδ",52,105]],"Song of a Psalm by David."],["2",[["Ἑτοίμη",906,15],["ἡ",1,11],["καρδία",63,13],["μου",6,48],["ὁ",1,4],["Θεὸς",20,5],["ἑτοίμη",906,15],["ἡ",1,11],["καρδία",63,13],["μου",6,48],["ᾄσομαι",1080,176],["καὶ",2,8],["ψαλῶ",901,157],["ἐν",4,1],["τῇ",1,95],["δόξῃ",141,2],["μου",6,48]],"O God, my heart is ready, my heart is ready; I will sing and sing psalms with my glory."],["3",[["Ἐξεγέρθητι",650,242],["ψαλτήριον",1698,20],["καὶ",2,8],["κιθάρα",1513,13],["ἐξεγερθήσομαι",650,175],["ὄρθρου",1436,21]],"Awake, psaltery and harp; I will awake early."],["4",[["Ἐξομολογήσομαί",478,176],["σοι",5,151],["ἐν",4,1],["λαοῖς",35,139],["Κύριε",7,251],["ψαλῶ",901,157],["σοι",5,151],["ἐν",4,1],["ἔθνεσιν",59,92]],"I will give thanks to thee, O Lord, among the people; I will sing praise to thee among the Gentiles."],["5",[["Ὅτι",19,8],["μέγα",65,29],["ἐπάνω",490,17],["τῶν",1,76],["οὐρανῶν",94,77],["τὸ",1,32],["ἔλεός",182,33],["σου",5,146],["καὶ",2,8],["ἕως",42,8],["τῶν",1,123],["νεφελῶν",443,61],["ἡ",1,11],["ἀλήθειά",350,13],["σου",5,146]],"For thy mercy is great above the heavens, and thy truth [reaches] to the clouds."],["6",[["Ὑψώθητι",327,242],["ἐπὶ",9,1],["τοὺς",1,56],["οὐρανοὺς",94,31],["ὁ",1,4],["Θεὸς",20,5],["καὶ",2,8],["ἐπὶ",9,1],["πᾶσαν",11,37],["τὴν",1,9],["γῆν",26,10],["ἡ",1,11],["δόξα",141,186],["σου",5,146]],"Be thou exalted, O God, above the heavens; and thy glory above all the earth."],["7",[["Ὅπως",236,8],["ἂν",82,12],["ῥυσθῶσιν",335,267],["οἱ",1,128],["ἀγαπητοί",1922,130],["σου",5,146],["σῶσον",171,198],["τῇ",1,95],["δεξιᾷ",282,96],["σου",5,146],["καὶ",2,8],["ἐπάκουσόν",595,198],["μου",6,48]],"That thy beloved [ones] may be delivered, save with thy right hand, and hear me. God has spoken in his sanctuary;"],["8",[["Ὁ",1,4],["Θεὸς",20,5],["ἐλάλησεν",50,3],["ἐν",4,1],["τῷ",1,110],["ἁγίῳ",75,111],["αὐτοῦ",3,48],["ὑψωθήσομαι",327,175],["καὶ",2,8],["διαμεριῶ",2174,157],["Σίκιμα",2977,105],["καὶ",2,8],["τὴν",1,9],["κοιλάδα",1058,10],["τῶν",1,123],["σκηνῶν",131,61],["διαμετρήσω",1244,157]],"I will be exalted, and will divide Sicima, and will measure out the valley of tents."],["9",[["Ἐμός",523,5],["ἐστι",10,87],["Γαλαὰδ",0,0],["καὶ",2,8],["ἐμός",523,5],["ἐστι",10,87],["Μανασσῆς",394,5],["καὶ",2,8],["Ἐφραίμ",307,105],["ἀντίληψις",2413,13],["τῆς",1,18],["κεφαλῆς",144,19],["μου",6,83],["Ἰούδας",61,5],["βασιλεύς",22,5],["μου",6,48]],"Galaad is mine; and Manasses is mine; and Ephraim is the help of mine head; Judas is my king;"],["10",[["Μωὰβ",0,0],["λέβης",1343,5],["τῆς",1,18],["ἐλπίδος",527,19],["μου",6,83],["ἐπὶ",9,1],["τὴν",1,9],["Ἰδουμαίαν",1319,37],["ἐπιβαλῶ",724,157],["τὸ",1,32],["ὑπόδημά",1666,33],["μου",6,48],["ἐμοὶ",6,49],["ἀλλόφυλοι",203,130],["ὑπετάγησαν",1756,94]],"Moab is the caldron of my hope; over Idumea will I cast my sandal; the Philistines are made subject to me."],["11",[["Τίς",39,150],["ἀπάξει",1216,120],["με",6,98],["εἰς",8,1],["πόλιν",41,10],["περιοχῆς",1595,19],["ἢ",60,8],["τίς",39,150],["ὁδηγήσει",1110,120],["με",6,82],["ἕως",42,8],["τῆς",1,18],["Ἰδουμαίας",1223,19]],"Who will bring me into the fortified city? or who will guide me to Idumea?"],["12",[["Οὐχὶ",326,12],["σὺ",5,156],["ὁ",1,4],["Θεὸς",20,5],["ὁ",1,4],["ἀπωσάμενος",767,245],["ἡμᾶς",6,60],["καὶ",2,8],["οὐκ",12,17],["ἐξελεύσῃ",84,116],["ὁ",1,4],["Θεὸς",20,5],["ἐν",4,1],["ταῖς",1,70],["δυνάμεσιν",98,71],["ἡμῶν",6,41]],"Wilt not thou, O God, who hast rejected us? and wilt not thou, O God, go forth with our hosts?"],["13",[["Δὸς",33,198],["ἡμῖν",6,142],["βοήθειαν",761,10],["ἐκ",21,1],["θλίψεως",437,19],["καὶ",2,8],["ματαία",648,15],["σωτηρία",422,13],["ἀνθρώπου",43,21]],"Give us help from tribulation: for vain is the help of man."],["14",[["Ἐν",4,1],["τῷ",1,110],["Θεῷ",20,113],["ποιήσομεν",23,269],["δύναμιν",98,10],["καὶ",2,8],["αὐτὸς",3,158],["ἐξουδενώσει",1069,120],["τοὺς",1,56],["ἐχθροὺς",135,31],["ἡμῶν",6,41]],"Through God we shall do valiantly; and he will bring to nought our enemies."]]