",2,8],["ἐπελάθοντο",3018,182],["τῶν",1,123],["εὐεργεσιῶν",3534,61],["αὐτοῦ",3,48],["καὶ",2,8],["τῶν",1,76],["θαυμασίων",885,163],["αὐτοῦ",3,48],["ὧν",24,307],["ἔδειξεν",871,3],["αὐτοῖς",3,142]],"And they forgot his benefits, and his miracles which he [had] shewed them;"],["12",[["ἐναντίον",138,17],["τῶν",1,76],["πατέρων",44,77],["αὐτῶν",3,41],["ἃ",1,11],["ἐποίησε",23,3],["θαυμάσια",885,65],["ἐν",4,1],["γῇ",26,2],["Αἰγύπτῳ",93,2],["ἐν",4,1],["πεδίῳ",348,53],["Τάνεως",3247,19]],"the miracles which he wrought before their fathers, in the land of Egypt, in the plain of Tanes."],["13",[["Διέῤῥηξε",673,3],["θάλασσαν",137,10],["καὶ",2,8],["διήγαγεν",1764,3],["αὐτοὺς",3,60],["ἔστησεν",78,3],["ὕδατα",85,43],["ὡσεὶ",342,17],["ἀσκόν",2225,7]],"He clave the sea, and led them through: he made the waters to stand as [in] a bottle."],["14",[["Καὶ",2,8],["ὡδήγησεν",1110,3],["αὐτοὺς",3,60],["ἐν",4,1],["νεφέλῃ",443,2],["ἡμέρας",28,19],["καὶ",2,8],["ὅλην",233,37],["τὴν",1,9],["νύκτα",216,10],["ἐν",4,1],["φωτισμῷ",3676,113],["πυρός",118,24]],"And he guided them with a cloud by day, and all the night with a light of fire."],["15",[["Διέῤῥηξε",673,3],["πέτραν",546,10],["ἐν",4,1],["ἐρήμῳ",160,96],["καὶ",2,8],["ἐπότισεν",788,3],["αὐτοὺς",3,60],["ὡς",36,8],["ἐν",4,1],["ἀβύσσῳ",1084,2],["πολλῇ",74,96]],"He clave a rock in the wilderness, and made them drink as in a great deep."],["16",[["Καὶ",2,8],["ἐξήγαγεν",299,3],["ὕδωρ",85,33],["ἐκ",21,1],["πέτρας",546,19],["καὶ",2,8],["κατήγαγεν",741,3],["ὡς",36,8],["ποταμοὺς",249,31],["ὕδατα",85,43]],"And he brought water out of the rock, and caused waters to flow down as rivers."],["17",[["Καὶ",2,8],["προσέθεντο",200,182],["ἔτι",110,17],["τοῦ",1,30],["ἁμαρτάνειν",244,54],["αὐτῷ",3,49],["παρεπικραναν",2037,221],["τὸν",1,6],["ὕψιστον",473,59],["ἐν",4,1],["ἀνύδρῳ",1705,111]],"And they sinned yet more against him; they provoked the Most High in the wilderness."],["18",[["καὶ",2,8],["ἐξεπείρασαν",4595,141],["τὸν",1,6],["Θεὸν",20,7],["ἐν",4,1],["ταῖς",1,70],["καρδίαις",63,71],["αὐτῶν",3,41],["τοῦ",1,30],["αἰτῆσαι",615,100],["βρώματα",714,43],["ταῖς",1,70],["ψυχαῖς",62,71],["αὐτῶν",3,41]],"And they tempted God in their hearts, in asking meat for [the desire of] their souls."],["19",[["Καὶ",2,8],["κατελάλησαν",2365,141],["τοῦ",1,30],["Θεοῦ",20,21],["καὶ",2,8],["εἶπαν",18,221],["μὴ",25,8],["δυνήσεται",184,89],["ὁ",1,4],["Θεὸς",20,5],["ἑτοιμάσαι",371,100],["τράπεζαν",644,10],["ἐν",4,1],["ἐρήμῳ",160,96]],"They spoke also against God, and said, Will God be able to prepare a table in the wilderness?"],["20",[["Ἐπεὶ",1238,8],["ἐπάταξε",145,3],["πέτραν",546,10],["καὶ",2,8],["ἐῤῥύησαν",663,94],["ὕδατα",85,43],["καὶ",2,8],["χείμαῤῥοι",736,51],["κατεκλύσθησαν",2363,94],["μὴ",25,8],["καὶ",2,8],["ἄρτον",197,7],["δυνήσεται",184,89],["δοῦναι",33,100],["ἢ",60,8],["ἑτοιμάσαι",371,100],["τράπεζαν",644,10],["τῷ",1,110],["λαῷ",35,113],["αὐτοῦ",3,48]],"Forasmuch as he smote the rock, and the waters flowed, and the torrents ran abundantly; will he be able also to give bread, or prepare a table for his people?"],["21",[["Διὰ",54,1],["τοῦτο",16,122],["ἤκουσε",53,3],["Κύριος",7,5],["καὶ",2,8],["ἀνεβάλετο",3402,26],["καὶ",2,8],["πῦρ",118,33],["ἀνήφθη",1798,38],["ἐν",4,1],["Ἰακὼβ",146,105],["καὶ",2,8],["ὀργὴ",198,13],["ἀνέβη",87,3],["ἐπὶ",9,1],["τὸν",1,6],["Ἰσραήλ",27,105]],"Therefore the Lord heard, and was provoked: and fire was kindled in Jacob, and wrath went up against Israel."],["22",[["Ὅτι",19,8],["οὐκ",12,17],["ἐπίστευσαν",658,141],["ἐν",4,1],["τῷ",1,110],["Θεῷ",20,113],["οὐδὲ",105,12],["ἤλπισαν",511,141],["ἐπὶ",9,1],["τὸ",1,32],["σωτήριον",471,33],["αὐτοῦ",3,48]],"Because they believed not in God, and trusted not in his salvation."],["23",[["Καὶ",2,8],["ἐνετείλατο",143,26],["νεφέλαις",443,71],["ὑπεράνωθεν",6685,378],["καὶ",2,8],["θύρας",277,19],["οὐρανοῦ",94,21],["ἀνέῳξε",621,3]],"Yet he commanded the clouds from above, and opened the doors of heaven,"],["24",[["καὶ",2,8],["ἔβρεξεν",2172,3],["αὐτοῖς",3,142],["μάννα",2475,456],["φαγεῖν",268,100],["καὶ",2,8],["ἄρτον",197,7],["οὐρανοῦ",94,21],["ἔδωκεν",33,3],["αὐτοῖς",3,142]],"and rained upon them manna to eat, and gave them the bread of heaven."],["25",[["Ἄρτον",197,7],["ἀγγέλων",206,77],["ἔφαγεν",268,3],["ἄνθρωπος",43,5],["ἐπισιτισμὸν",2543,7],["ἀπέστειλεν",83,3],["αὐτοῖς",3,142],["εἰς",8,1],["πλησμονήν",1522,10]],"Man ate angels' bread; he sent them provision to the full."],["26",[["Ἀπῇρε",850,14],["Νότον",586,7],["ἐξ",21,1],["οὐρανοῦ",94,21],["καὶ",2,8],["ἐπήγαγεν",415,3],["ἐν",4,1],["τῇ",1,95],["δυναστείᾳ",919,2]],"He removed the south wind from heaven; and by his might he brought in the south-west wind."],["27",[["αὐτοῦ",3,48],["Λίβα",1014,7],["Καὶ",2,8],["ἔβρεξεν",2172,3],["ἐπ",0,0],["αὐτοὺς",3,60],["ὡσεὶ",342,17],["χοῦν",1288,7],["σάρκας",287,40],["καὶ",2,8],["ὡσεῖ",342,17],["ἄμμον",434,10],["θαλασσῶν",137,61],["πετεινὰ",570,63],["πτερωτά",3643,74]],"And he rained upon them flesh like dust, and feathered birds like the sand of the seas."],["28",[["Καὶ",2,8],["ἐπέπεσον",995,141],["εἰς",8,1],["μέσον",112,29],["τῆς",1,18],["παρεμβολῆς",189,19],["αὐτῶν",3,41],["κύκλῳ",258,17],["τῶν",1,44],["σκηνωμάτων",680,45],["αὐτῶν",3,168]],"And they fell into the midst of their camp, round about their tents."],["29",[["Καὶ",2,8],["ἐφάγοσαν",0,0],["καὶ",2,8],["ἐνεπλήσθησαν",424,94],["σφόδρα",149,17],["καὶ",2,8],["τὴν",1,9],["ἐπιθυμίαν",701,10],["αὐτῶν",3,41],["ἤνεγκεν",201,3],["αὐτοῖς",3,142]],"So they ate, and were completely filled; and he gave them their desire."],["30",[["Οὐκ",12,17],["ἐστερήθησαν",2121,94],["ἀπὸ",17,1],["τῆς",1,18],["ἐπιθυμίας",701,19],["αὐτῶν",3,41],["ἔτι",110,17],["τῆς",1,18],["βρώσεως",1243,19]],"They were not disappointed of their desire: [but] when their food was yet in their mouth,"],["31",[["αὐτῶν",3,41],["οὔσης",10,212],["ἐν",4,1],["τῷ",1,52],["στόματι",123,53],["αὐτῶν",3,41],["καὶ",2,8],["ὀργὴ",198,13],["τοῦ",1,30],["Θεοῦ",20,21],["ἀνέβη",87,3],["ἐπʼ",9,1],["αὐτοὺς",3,60],["καὶ",2,8],["ἀπέκτεινεν",298,3],["ἐν",4,1],["τοῖς",1,138],["πίοσιν",1977,139],["αὐτῶν",3,41],["καὶ",2,8],["τοὺς",1,56],["ἐκλεκτοὺς",551,58],["τοῦ",1,30],["Ἰσραὴλ",27,105],["συνεπόδισεν",3364,3]],"then the indignation of God rose up against them, and slew the fattest of them, and overthrew the choice men of Israel."],["32",[["Εν",10,129],["πᾶσι",11,215],["τούτοις",16,191],["ἥμαρτον",244,147],["ἔτι",110,17],["καὶ",2,8],["οὐκ",12,17],["ἐπίστευσαν",658,141],["τοῖς",1,138]],"In the midst of all this they sinned yet more, and believed not his miracles."],["33",[["θαυμασίοις",885,215],["αὐτοῦ",3,48],["Καὶ",2,8],["ἐξέλιπον",321,141],["ἐν",4,1],["ματαιότητι",937,2],["αἱ",1,183],["ἡμέραι",28,2],["αὐτῶν",3,41],["καὶ",2,8],["τὰ",1,42],["ἔτη",80,43],["αὐτῶν",3,41],["μετὰ",29,1],["σπουδῆς",1388,19]],"And their days were consumed in vanity, and their years with anxiety."],["34",[["Ὅταν",318,8],["ἀπέκτεινεν",298,3],["αὐτοὺς",3,60],["ἐζήτουν",190,129],["αὐτὸν",3,82],["καὶ",2,8],["ἐπέστρεφον",116,129],["καὶ",2,8]],"When he slew them, they sought him: and they returned and called betimes upon God."],["35",[["ὤρθριζον",930,129],["πρὸς",15,1],["τὸν",1,6],["Θεόν",20,7],["Καὶ",2,8],["ἐμνήσθησαν",231,94],["ὅτι",19,8],["ὁ",1,4],["Θεὸς",20,5],["βοηθὸς",948,5],["αὐτῶν",3,41],["ἐστι",10,87],["καὶ",2,8],["ὁ",1,4],["Θεὸς",20,5],["ὁ",1,4],["ὕψιστος",473,16],["λυτρωτὴς",4310,5],["αὐτῶν",3,41],["ἐστι",10,87]],"And they remembered that God was their helper, and the most high God was their redeemer."],["36",[["Καὶ",2,8],["ἠγάπησαν",224,141],["αὐτὸν",3,82],["ἐν",4,1],["τῷ",1,52],["στόματι",123,53],["αὐτῶν",3,41],["καὶ",2,8],["τῇ",1,95],["γλώσσῃ",385,2],["αὐτῶν",3,41]],"Yet they loved him [only] with their mouth, and lied to him with their tongue."],["37",[["ἐψεύσαντο",1311,182],["αὐτῷ",3,49],["ἡ",1,11],["δὲ",14,12],["καρδία",63,13],["αὐτῶν",3,41],["οὐκ",12,17],["εὐθεῖα",1137,15],["μετʼ",29,1],["αὐτοῦ",3,48],["οὐδὲ",105,12],["ἐπιστώθησαν",2114,94],["ἐν",4,1],["τῇ",1,95],["διαθήκῃ",168,2],["αὐτοῦ",3,48]],"For their heart [was] not right with him, neither were they steadfast in his covenant."],["38",[["Αὐτὸς",3,158],["δέ",14,12],["ἐστιν",10,87],["οἰκτίρμων",2109,16],["καὶ",2,8],["ἱλάσεται",2553,89],["ταῖς",1,70],["ἁμαρτίαις",119,71],["αὐτῶν",3,41],["καὶ",2,8],["οὐ",12,17],["διαφθερεῖ",686,120],["καὶ",2,8],["πληθυνεῖ",315,120],["τοῦ",1,30],["ἀποστρέψαι",130,100],["τὸν",1,6],["θυμὸν",177,7],["αὐτοῦ",3,48],["καὶ",2,8],["οὐχὶ",326,12],["ἐκκαύσει",942,120],["πᾶσαν",11,37],["τὴν",1,9],["ὀργὴν",198,10],["αὐτοῦ",3,48]],"But he is compassionate, and will forgive their sins, and will not destroy [them]: yea, he will frequently turn away his wrath, and will not kindle all his anger."],["39",[["Καὶ",2,8],["ἐμνήσθη",231,38],["ὅτι",19,8],["σάρξ",287,13],["εἰσι",10,189],["πνεῦμα",167,20],["πορευόμενον",49,201],["καὶ",2,8],["οὐκ",12,17],["ἐπιστρέφον",116,36]],"And he remembered that they are flesh; a wind that passes away, and returns not."],["40",[["Ποσάκις",3941,17],["παρεπίκραναν",2037,141],["αὐτὸν",3,82],["ἐν",4,1],["τῇ",1,95],["ἐρήμῳ",160,96],["παρώργισαν",953,141]],"How often did they provoke him in the wilderness, [and] anger him in a dry land!"],["41",[["αὐτὸν",3,82],["ἐν",4,1],["γῇ",26,2],["ἀνύδρῳ",1705,96],["Καὶ",2,8],["ἐπέστρεψαν",116,141],["καὶ",2,8],["ἐπείρασαν",1096,141],["τὸν",1,6],["Θεὸν",20,7],["καὶ",2,8],["τὸν",1,6],["ἅγιον",75,59],["τοῦ",1,30],["Ἰσραὴλ",27,105],["παρώξυναν",1041,141]],"Yea, they turned back, and tempted God, and provoked the Holy One of Israel."],["42",[["Οὐκ",12,17],["ἐμνήσθησαν",231,94],["τῆς",1,18],["χειρὸς",37,19],["αὐτοῦ",3,48],["ἡμέρας",28,19],["ἧς",24,162],["ἐλυτρώσατο",548,26],["αὐτοὺς",3,60],["ἐκ",21,1],["χειρὸς",37,19],["θλίβοντος",599,143]],"They remembered not his hand, the day in which he delivered them from the hand of the oppressor."],["43",[["Ὡς",36,8],["ἔθετο",109,26],["ἐν",4,1],["Αἰγύπτῳ",93,2],["τὰ",1,42],["σημεῖα",502,43],["αὐτοῦ",3,48],["καὶ",2,8],["τὰ",1,42]],"How he had wrought his signs in Egypt, and his wonders in the field of Tanes:"],["44",[["τέρατα",1005,43],["αὐτοῦ",3,48]