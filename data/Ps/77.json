[["1",[["Συνέσεως",469,19],["τῷ",1,110],["Ἀσάφ",1103,5],["Προσέχετε",558,307],["λαός",35,5],["μου",6,48],["τὸν",1,6],["νόμον",140,7],["μου",6,48],["κλίνατε",785,69],["τὸ",1,32],["οὖς",328,33],["ὑμῶν",5,136],["εἰς",8,1],["τὰ",1,42],["ῥήματα",116,43],["τοῦ",1,23],["στόματός",123,24],["μου",6,48]],"[A Psalm] of instruction for Asaph. Give heed, O my people, to my law: incline your ear to the words of my mouth."],["2",[["Ἀνοίξω",362,157],["ἐν",4,1],["παραβολαῖς",1061,71],["τὸ",1,32],["στόμα",123,33],["μου",6,48],["φθέγξομαι",2296,177],["προβλήματα",2622,63],["ἀπʼ",17,1],["ἀρχῆς",270,19]],"I will open my mouth in parables: I will utter dark sayings [which have been] from the beginning."],["3",[["Ὅσα",103,63],["ἠκούσαμεν",54,285],["καὶ",2,8],["ἔγνωμεν",79,285],["αὐτὰ",3,66],["καὶ",2,8],["οἱ",1,128],["πατέρες",44,51],["ἡμῶν",6,41],["διηγήσαντο",800,184],["ἡμῖν",6,142]],"All which we have heard and known, and our fathers have declared to us."],["4",[["Οὐκ",12,17],["ἐκρύβη",372,38],["ἀπὸ",17,1],["τῶν",1,44],["τέκνων",192,45],["αὐτῶν",3,168],["εἰς",8,1],["γενεὰν",286,10],["ἑτέραν",253,37],["ἀπαγγέλλοντες",273,137],["τὰς",1,39],["αἰνέσεις",402,159],["Κυρίου",7,21],["καὶ",2,8],["τὰς",1,39],["δυναστείας",918,40],["αὐτοῦ",3,48],["καὶ",2,8],["τὰ",1,42],["θαυμάσια",884,65],["αὐτοῦ",3,48],["ἃ",1,11],["ἐποίησε",23,3]],"They were not hid from their children to a second generation; [the fathers] declaring the praises of the Lord, and his mighty acts, and his wonders which he wrought."],["5",[["Καὶ",2,8],["ἀνέστησε",121,3],["μαρτύριον",225,33],["ἐν",4,1],["Ἰακὼβ",146,105],["καὶ",2,8],["νόμον",140,7],["ἔθετο",110,26],["ἐν",4,1],["Ἰσραήλ",27,105],["ὃν",24,106],["ἐνετείλατο",143,26],["τοῖς",1,138],["πατράσιν",44,139],["ἡμῶν",6,41],["γνωρίσαι",748,100],["αὐτὸν",3,82],["τοῖς",1,138],["υἱοῖς",13,139],["αὐτῶν",3,41]],"And he raised up a testimony in Jacob, and appointed a law in Israel, which he commanded our fathers, to make it known to their children:"],["6",[["ὅπως",240,8],["ἂν",83,12],["γν