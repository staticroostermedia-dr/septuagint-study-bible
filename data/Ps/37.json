[["1",[["Φαλμὸς",0,0],["τῷ",1,110],["Δαυὶδ",52,105],["εἰς",8,1],["ἀνάμνησιν",4026,10],["περὶ",72,1],["σαββάτου",442,24]],"A Psalm of David for remembrance concerning the Sabbath-day."],["2",[["Κύριε",7,250],["μὴ",25,8],["τῷ",1,110],["θυμῷ",178,113],["σου",5,146],["ἐλέγξῃς",752,170],["με",6,82],["μηδὲ",414,12],["τῇ",1,95],["ὀργῇ",198,2],["σου",5,146],["παιδεύσῃς",643,170],["με",6,82]],"O Lord, rebuke me not in thy wrath, neither chasten me in thine anger."],["3",[["Ὅτι",19,8],["τὰ",1,42],["βέλη",1156,43],["σου",5,146],["ἐνεπάγησάν",2997,94],["μοι",6,49],["καὶ",2,8],["ἐπεστήριξας",2676,154],["ἐπʼ",9,1],["ἐμὲ",6,98],["τὴν",1,9],["χεῖρά",37,10],["σου",5,146]],"For thy weapons are fixed in me, and thou hast pressed thy hand heavily upon me."],["4",[["Οὐκ",12,17],["ἔστιν",10,87],["ἴασις",1463,13],["ἐν",4,1],["τῇ",1,95],["σαρκί",287,2],["μου",6,48],["ἀπὸ",17,1],["προσώπου",47,24],["τῆς",1,18],["ὀργῆς",198,19],["σου",5,146],["οὐκ",12,17],["ἔστιν",10,87],["εἰρήνη",213,13],["τοῖς",1,91],["ὀστέοις",473,92],["μου",6,48],["ἀπὸ",17,1],["προσώπου",47,24],["τῶν",1,123],["ἁμαρτιῶν",119,61],["μου",6,48]],"For there is no health in my flesh because of thine anger; there is no peace to my bones because of my sins."],["5",[["Ὅτι",19,8],["αἱ",1,185],["ἀνομίαι",275,180],["μου",6,48],["ὑπερῇραν",3769,141],["τὴν",1,9],["κεφαλήν",144,10],["μου",6,48],["ὡσεὶ",343,17],["φορτίον",3664,20],["βαρὺ",1031,28],["ἐβαρύνθησαν",1013,94],["ἐπʼ",9,1],["ἐμέ",6,82]],"For my transgressions have gone over mine head: they have pressed heavily upon me like a weighty burden."],["6",[["Προσώζεσαν",0,0],["καὶ",2,8],["ἐσάπησαν",3142,94],["οἱ",1,128],["μώλωπές",2922,51],["μου",6,48],["ἀπὸ",17,1],["προσώπου",47,24],["τῆς",1,18],["ἀφροσύνης",1401,19],["μου",6,83]],"My bruises have become noisome and corrupt, because of my foolishness."],["7",[["Ἐταλαιπώρησα",2119,147],["καὶ",2,8],["κατεκάμφθην",4256,148],["ἕως",42,8],["τέλους",373,24],["ὅλην",235,37],["τὴν",1,9],["ἡμέραν",28,10],["σκυθρωπάζων",3352,67],["ἐπορευόμην",49,374]],"I have been wretched and bowed down continually: I went with a mourning countenance all the day."],["8",[["Ὅτι",19,8],["ἡ",1,11],["ψυχή",63,13],["μου",6,48],["ἐπλησθη",924,38],["ἐμπαιγμῶν",3732,77],["καὶ",2,8],["οὐκ",12,17],["ἔστιν",10,87],["ἴασις",1463,13],["ἐν",4,1],["τῇ",1,95],["σαρκί",287,2],["μου",6,48]],"For my soul is filled with mockings; and there is no health in my flesh."],["9",[["Ἐκακώθην",757,148],["καὶ",2,8],["ἐταπεινώθην",322,148],["ἕως",42,8],["σφόδρα",150,17],["ὠρυόμην",2689,374],["ἀπὸ",17,1],["στεναγμοῦ",1598,21],["τῆς",1,18],["καρδίας",64,19],["μου",6,83]],"I have been afflicted and brought down exceedingly: I have roared for the groaning of my heart."],["10",[["Καὶ",2,8],["ἐναντίον",138,17],["σου",5,146],["πᾶσα",11,15],["ἡ",1,11],["ἐπιθυμία",699,13],["μου",6,48],["καὶ",2,8],["ὁ",1,4],["στεναγμός",1598,5],["μου",6,48],["οὐκ",12,17],["ἀπεκρύβη",1926,38],["ἀπὸ",17,1],["σοῦ",5,146]],"But all my desire is before thee; and my groaning is not hidden from thee."],["11",[["Ἡ",1,11],["καρδία",64,13],["μου",6,48],["ἐταράχθη",508,38],["ἐγκατέλιπέ",364,3],["με",6,82],["ἡ",1,11],["ἰσχύς",181,13],["μου",6,48],["καὶ",2,8],["τὸ",1,27],["φῶς",380,20],["τῶν",1,76],["ὀφθαλμῶν",91,77],["μου",6,48],["οὐκ",12,17],["ἔστι",10,87],["μετʼ",29,1],["ἐμοῦ",6,48]],"My heart is troubled, my strength has failed me; and the light of mine eyes is not with me."],["12",[["Οἱ",1,128],["φίλοι",336,130],["μου",6,48],["καὶ",2,8],["οἱ",1,128],["πλησίον",292,17],["μου",6,83],["ἐξ",21,1],["ἐναντίας",2057,78],["μου",6,83],["ἤγγισαν",455,141],["καὶ",2,8],["ἔστησαν",78,141],["καὶ",2,8],["οἱ",1,128],["ἔγγιστά",3420,74],["μου",6,48],["μακρόθεν",1249,17],["ἔστησαν",78,141]],"My friends and my neighbours drew near before me, and stood still; and my nearest of kin stood afar off."],["13",[["καὶ",2,8],["ἐξεβιάζοντο",5285,131],["οἱ",1,128],["ζητοῦντες",191,137],["τὴν",1,9],["ψυχήν",63,10],["μου",6,48],["καὶ",2,8],["οἱ",1,128],["ζητοῦντες",191,137],["τὰ",1,42],["κακά",161,65],["μοι",6,49],["ἐλάλησαν",50,141],["ματαιότητας",937,40],["καὶ",2,8],["δολιότητας",3526,40],["ὅλην",235,37],["τὴν",1,9],["ἡμέραν",28,10],["ἐμελέτησαν",1347,141]],"While they pressed hard upon me that sought my soul: and they that sought my hurt spoke vanities, and devised deceits all the day."],["14",[["Ἐγὼ",6,158],["δὲ",14,12],["ὡσεὶ",343,17],["κωφὸς",2362,16],["οὐκ",12,17],["ἤκουον",54,129],["καὶ",2,8],["ὡσεὶ",343,17],["ἄλαλος",6381,16],["οὐκ",12,17],["ἀνοίγων",362,67],["τὸ",1,32],["στόμα",123,33],["αὐτοῦ",3,48]],"But I, as a deaf man, heard not; and was as a dumb man not opening his mouth."],["15",[["Καὶ",2,8],["ἐγενόμην",30,152],["ὡσεὶ",343,17],["ἄνθρωπος",43,5],["οὐκ",12,17],["ἀκούων",54,67],["καὶ",2,8],["οὐκ",12,17],["ἔχων",124,67],["ἐν",4,1],["τῷ",1,52],["στόματι",123,53],["αὐτοῦ",3,48],["ἐλεγμούς",1798,31]],"And I was as a man that hears not, and who has no reproofs in his mouth."],["16",[["Ὅτι",19,8],["ἐπὶ",9,1],["σοὶ",5,151],["Κύριε",7,250],["ἤλπισα",514,147],["σὺ",5,156],["εἰσακούσῃ",241,116],["Κύριε",7,250],["ὁ",1,4],["Θεός",20,5],["μου",6,48]],"For I hoped in thee, O Lord: thou wilt hear, O Lord my God."],["17",[["Ὅτι",19,8],["εἶπα",18,147],["μή",25,8],["ποτε",458,12],["ἐπιχαρῶσί",1938,266],["μοι",6,49],["οἱ",1,128],["ἐχθροί",135,51],["μου",6,48],["καὶ",2,8],["ἐν",4,1],["τῷ",1,110],["σαλευθῆναι",678,175],["πόδας",210,31],["μου",6,48],["ἐπʼ",9,1],["ἐμὲ",6,82],["ἐμεγαλοῤῥημόνησαν",3586,141]],"For I said, Lest mine enemies rejoice against me: for when my feet were moved, they spoke boastingly against me."],["18",[["Ὅτι",19,8],["ἐγὼ",6,158],["εἰς",8,1],["μάστιγας",1308,40],["ἕτοιμος",904,15],["καὶ",2,8],["ἡ",1,11],["ἀλγηδών",2304,13],["μου",6,48],["ἐνώπιόν",115,1],["μου",6,48],["διαπαντός",510,17]],"For I am ready for plagues, and my grief is continually before me."],["19",[["Ὅτι",19,8],["τὴν",1,9],["ἀνομίαν",275,10],["μου",6,48],["ἀναγγελῶ",231,157],["καὶ",2,8],["μεριμνήσω",2600,157],["ὑπὲρ",139,1],["τῆς",1,18],["ἁμαρτίας",119,19],["μου",6,83]],"For I will declare mine iniquity, and be distressed for my sin."],["20",[["Οἱ",1,128],["δὲ",14,12],["ἐχθροί",135,51],["μου",6,48],["ζῶσι",107,191],["καὶ",2,8],["κεκραταίωνται",729,254],["ὑπὲρ",139,1],["ἐμὲ",6,82],["καὶ",2,8],["ἐπληθύνθησαν",316,94],["οἱ",1,128],["μισοῦντές",351,137],["με",6,82],["ἀδίκως",406,17]],"But mine enemies live, and are mightier than I: and they that hate me unjustly are multiplied."],["21",[["Οἱ",1,128],["ἀνταποδιδόντες",666,137],["κακὰ",161,65],["ἀντὶ",158,1],["ἀγαθῶν",114,79],["ἐνδιέβαλλόν",4082,129],["με",6,82],["ἐπεὶ",1236,8],["κατεδίωκον",621,129],["δικαιοσύνην",187,10]],"They that reward evil for good slandered me; because I followed righteousness."],["22",[["Μὴ",25,8],["ἐγκαταλίπῃς",364,170],["με",6,82],["Κύριε",7,250],["ὁ",1,4],["Θεός",20,5],["μου",6,48],["μὴ",25,8],["ἀποστῇς",293,170],["ἀπʼ",17,1],["ἐμοῦ",6,48]],"Forsake me not, O Lord my God: depart not from me."],["23",[["Πρόσχες",1689,154],["εἰς",8,1],["τὴν",1,9],["βοήθειάν",765,10],["μου",6,83],["Κύριε",7,250],["τῆς",1,18],["σωτηρίας",425,19],["μου",6,83]],"Draw nigh to my help, O Lord of my salvation."]]