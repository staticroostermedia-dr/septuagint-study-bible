[["1",[["Φαλμὸς",0,0],["τῷ",1,110],["Δαυὶδ",52,105],["εἰς",8,1],["ἀνάμνησιν",4035,10],["περὶ",71,1],["σαββάτου",441,24]],"A Psalm of David for remembrance concerning the Sabbath-day."],["2",[["Κύριε",7,251],["μὴ",25,8],["τῷ",1,110],["θυμῷ",177,113],["σου",5,146],["ἐλέγξῃς",750,170],["με",6,82],["μηδὲ",412,12],["τῇ",1,95],["ὀργῇ",198,2],["σου",5,146],["παιδεύσῃς",654,170],["με",6,82]],"O Lord, rebuke me not in thy wrath, neither chasten me in thine anger."],["3",[["Ὅτι",19,8],["τὰ",1,42],["βέλη",1159,43],["σου",5,146],["ἐνεπάγησάν",3009,94],["μοι",6,49],["καὶ",2,8],["ἐπεστήριξας",2850,154],["ἐπʼ",9,1],["ἐμὲ",6,98],["τὴν",1,9],["χεῖρά",37,10],["σου",5,146]],"For thy weapons are fixed in me, and thou hast pressed thy hand heavily upon me."],["4",[["Οὐκ",12,17],["ἔστιν",10,87],["ἴασις",1463,13],["ἐν",4,1],["τῇ",1,95],["σαρκί",287,2],["μου",6,48],["ἀπὸ",17,1],["προσώπου",47,24],["τῆς",1,18],["ὀργῆς",198,19],["σου",5,146],["οὐκ",12,17],["ἔστιν",10,87],["εἰρήνη",210,13],["τοῖς",1,91],["ὀστέοις",472,92],["μου",6,48],["ἀπὸ",17,1],["προσώπου",47,24],["τῶν",1,123],["ἁμαρτιῶν",119,61],["μου",6,48]],"For there is no health in my flesh because of thine anger; there is no peace to my bones because of my sins."],["5",[["Ὅτι",19,8],["αἱ",1,183],["ἀνομίαι",274,179],["μου",6,48],["ὑπερῇραν",0,0],["τὴν",1,9],["κεφαλήν",144,10],["μου",6,48],["ὡσεὶ",342,17],["φορτίον",3672,20],["βαρὺ",1028,28],["ἐβαρύνθησαν",1027,94],["ἐπʼ",9,1],["ἐμέ",6,82]],"For my transgressions have gone over mine head: they have pressed heavily upon me like a weighty burden."],["6",[["Προσώζεσαν",0,0],["καὶ",2,8],["ἐσάπησαν",3150,94],["οἱ",1,128],["μώλωπές",2936,51],["μου",6,48],["ἀπὸ",17,1],["προσώπου",47,24],["τῆς",1,18],["ἀφροσύνης",1402,19],["μου",6,83]],"My bruises have become noisome and corrupt, because of my foolishness."],["7",[["Ἐταλαιπώρησα",2128,147],["καὶ",2,8],["κατεκάμφθην",4268,256],["ἕως",42,8],["τέλους",369,24],["ὅλην",233,37],["τὴν",1,9],["ἡμέραν",28,10],["σκυθρωπάζων",3355,67],["ἐπορευόμην",49,380]],"I have been wretched and bowed down continually: I went with a mourning countenance all the day."],["8",[["Ὅτι",19,8],["ἡ",1,11],["ψυχή",62,13],["μου",6,48],["ἐπλησθη",924,38],["ἐμπαιγμῶν",3741,77],["καὶ",2,8],["οὐκ",12,17],["ἔστιν",10,87],["ἴασις",1463,13],["ἐν",4,1],["τῇ",1,95],["σαρκί",287,2],["μου",6,48]],"For my soul is filled with mockings; and there is no health in my flesh."],["9",[["Ἐκακώθην",764,148],["καὶ",2,8],["ἐταπεινώθην",333,148],["ἕως",42,8],["σφόδρα",149,17],["ὠρυόμην",2694,380],["ἀπὸ",17,1],["στεναγμοῦ",1599,21],["τῆς",1,18],["καρδίας",63,19],["μου",6,83]],"I have been afflicted and brought down exceedingly: I have roared for the groaning of my heart."],["10",[["Καὶ",2,8],["ἐναντίον",138,17],["σου",5,146],["πᾶσα",11,15],["ἡ",1,11],["ἐπιθυμία",701,13],["μου",6,48],["καὶ",2,8],["ὁ",1,4],["στεναγμός",1599,5],["μου",6,48],["οὐκ",12,17],["ἀπεκρύβη",1396,38],["ἀπὸ",17,1],["σοῦ",5,146]],"But all my desire is before thee; and my groaning is not hidden from thee."],["11",[["Ἡ",1,11],["καρδία",63,13],["μου",6,48],["ἐταράχθη",508,38],["ἐγκατέλιπέ",363,3],["με",6,82],["ἡ",1,11],["ἰσχύς",180,13],["μου",6,48],["καὶ",2,8],["τὸ",1,27],["φῶς",376,20],["τῶν",1,76],["ὀφθαλμῶν",91,77],["μου",6,48],["οὐκ",12,17],["ἔστι",10,87],["μετʼ",29,1],["ἐμοῦ",6,48]],"My heart is troubled, my strength has failed me; and the light of mine eyes is not with me."],["12",[["Οἱ",1,128],["φίλοι",334,130],["μου",6,48],["καὶ",2,8],["οἱ",1,128],["πλησίον",292,17],["μου",6,83],["ἐξ",21,1],["ἐναντίας",2063,78],["μου",6,83],["ἤγγισαν",452,141],["καὶ",2,8],["ἔστησαν",78,141],["καὶ",2,8],["οἱ",1,128],["ἔγγιστά",3425,74],["μου",6,48],["μακρόθεν",1250,17],["ἔστησαν",78,141]],"My friends and my neighbours drew near before me, and stood still; and my nearest of kin stood afar off."],["13",[["καὶ",2,8],["ἐξεβιάζοντο",5317,131],["οἱ",1,128],["ζητοῦντες",190,137],["τὴν",1,9],["ψυχήν",62,10],["μου",6,48],["καὶ",2,8],["οἱ",1,128],["ζητοῦντες",190,137],["τὰ",1,42],["κακά",161,65],["μοι",6,49],["ἐλάλησαν",50,141],["ματαιότητας",937,40],["καὶ",2,8],["δολιότητας",3529,40],["ὅλην",233,37],["τὴν",1,9],["ἡμέραν",28,10],["ἐμελέτησαν",1344,141]],"While they pressed hard upon me that sought my soul: and they that sought my hurt spoke vanities, and devised deceits all the day."],["14",[["Ἐγὼ",6,158],["δὲ",14,12],["ὡσεὶ",342,17],["κωφὸς",2370,16],["οὐκ",12,17],["ἤκουον",53,129],["καὶ",2,8],["ὡσεὶ",342,17],["ἄλαλος",6411,16],["οὐκ",12,17],["ἀνοίγων",820,67],["τὸ",1,32],["στόμα",123,33],["αὐτοῦ",3,48]],"But I, as a deaf man, heard not; and was as a dumb man not opening his mouth."],["15",[["Καὶ",2,8],["ἐγενόμην",30,152],["ὡσεὶ",342,17],["ἄνθρωπος",43,5],["οὐκ",12,17],["ἀκούων",53,67],["καὶ",2,8],["οὐκ",12,17],["ἔχων",124,67],["ἐν",4,1],["τῷ",1,52],["στόματι",123,53],["αὐτοῦ",3,48],["ἐλεγμούς",1800,31]],"And I was as a man that hears not, and who has no reproofs in his mouth."],["16",[["Ὅτι",19,8],["ἐπὶ",9,1],["σοὶ",5,151],["Κύριε",7,251],["ἤλπισα",511,147],["σὺ",5,156],["εἰσακούσῃ",237,116],["Κύριε",7,251],["ὁ",1,4],["Θεός",20,5],["μου",6,48]],"For I hoped in thee, O Lord: thou wilt hear, O Lord my God."],["17",[["Ὅτι",19,8],["εἶπα",18,147],["μή",25,8],["ποτε",455,12],["ἐπιχαρῶσί",1939,267],["μοι",6,49],["οἱ",1,128],["ἐχθροί",135,51],["μου",6,48],["καὶ",2,8],["ἐν",4,1],["τῷ",1,110],["σαλευθῆναι",679,174],["πόδας",208,31],["μου",6,48],["ἐπʼ",9,1],["ἐμὲ",6,82],["ἐμεγαλοῤῥημόνησαν",3593,141]],"For I said, Lest mine enemies rejoice against me: for when my feet were moved, they spoke boastingly against me."],["18",[["Ὅτι",19,8],["ἐγὼ",6,158],["εἰς",8,1],["μάστιγας",1308,40],["ἕτοιμος",906,15],["καὶ",2,8],["ἡ",1,11],["ἀλγηδών",2318,13],["μου",6,48],["ἐνώπιόν",114,1],["μου",6,48],["διαπαντός",506,17]],"For I am ready for plagues, and my grief is continually before me."],["19",[["Ὅτι",19,8],["τὴν",1,9],["ἀνομίαν",274,10],["μου",6,48],["ἀναγγελῶ",228,157],["καὶ",2,8],["μεριμνήσω",2472,157],["ὑπὲρ",139,1],["τῆς",1,18],["ἁμαρτίας",119,19],["μου",6,83]],"For I will declare mine iniquity, and be distressed for my sin."],["20",[["Οἱ",1,128],["δὲ",14,12],["ἐχθροί",135,51],["μου",6,48],["ζῶσι",117,189],["καὶ",2,8],["κεκραταίωνται",0,0],["ὑπὲρ",139,1],["ἐμὲ",6,82],["καὶ",2,8],["ἐπληθύνθησαν",315,94],["οἱ",1,128],["μισοῦντές",355,137],["με",6,82],["ἀδίκως",402,17]],"But mine enemies live, and are mightier than I: and they that hate me unjustly are multiplied."],["21",[["Οἱ",1,128],["ἀνταποδιδόντες",661,137],["κακὰ",161,65],["ἀντὶ",158,1],["ἀγαθῶν",113,79],["ἐνδιέβαλλόν",4091,129],["με",6,82],["ἐπεὶ",1238,8],["κατεδίωκον",619,129],["δικαιοσύνην",185,10]],"They that reward evil for good slandered me; because I followed righteousness."],["22",[["Μὴ",25,8],["ἐγκαταλίπῃς",363,170],["με",6,82],["Κύριε",7,251],["ὁ",1,4],["Θεός",20,5],["μου",6,48],["μὴ",25,8],["ἀποστῇς",2055,159],["ἀπʼ",17,1],["ἐμοῦ",6,48]],"Forsake me not, O Lord my God: depart not from me."],["23",[["Πρόσχες",1692,154],["εἰς",8,1],["τὴν",1,9],["βοήθειάν",761,10],["μου",6,83],["Κύριε",7,251],["τῆς",1,18],["σωτηρίας",422,19],["μου",6,83]],"Draw nigh to my help, O Lord of my salvation."]]