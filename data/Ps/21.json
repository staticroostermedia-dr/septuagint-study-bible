[["1",[["Εἰς",8,1],["τὸ",1,32],["τέλος",369,33],["ὑπὲρ",139,1],["τῆς",1,18],["ἀντιλήψεως",2413,19],["τῆς",1,18],["ἑωθινῆς",3209,78],["ψαλμὸς",639,5],["τῷ",1,110],["Δαυίδ",52,105]],"For the end, concerning the morning aid, a Psalm of David."],["2",[["Ὁ",1,4],["Θεός",20,5],["ὁ",1,4],["Θεός",20,5],["μου",6,48],["πρόσχες",1692,154],["μοι",6,49],["ἱνατί",101,238],["ἐγκατέλιπές",363,154],["με",6,98],["μακρὰν",638,37],["ἀπὸ",17,1],["τῆς",1,18],["σωτηρίας",422,19],["μου",6,83],["οἱ",1,128],["λόγοι",48,51],["τῶν",1,44],["παραπτωμάτων",1909,45],["μου",6,48]],"O God, my God, attend to me: why hast thou forsaken me? the account of my transgressions is far from my salvation."],["3",[["Ο",1,105],["Θεός",20,5],["μου",6,83],["κεκράξομαι",590,176],["ἡμέρας",28,19],["πρὸς",15,1],["σὲ",5,161],["καὶ",2,8],["οὐκ",12,17],["εἰσακούσῃ",237,116],["καὶ",2,8],["νυκτὸς",216,19],["καὶ",2,8],["οὐκ",12,17],["εἰς",8,1],["ἄνοιαν",2419,10],["ἐμοί",6,49]],"O my God, I will cry to thee by day, but thou wilt not hear: and by night, and [it shall] not [be accounted] for folly to me."],["4",[["Σὺ",5,156],["δὲ",14,12],["ἐν",4,1],["ἁγίῳ",75,34],["κατοικεῖς",90,145],["ὁ",1,4],["ἔπαινος",2854,5],["τοῦ",1,30],["Ἰσραήλ",27,105]],"But thou, the praise of Israel, dwellest in a sanctuary."],["5",[["Ἐπὶ",9,1],["σοὶ",5,151],["ἤλπισαν",511,141],["οἱ",1,128],["πατέρες",44,51],["ἡμῶν",6,41],["ἤλπισαν",511,141],["καὶ",2,8],["ἐῤῥύσω",335,169],["αὐτούς",3,60]],"Our fathers hoped in thee; they hoped, and thou didst deliver them."],["6",[["Πρὸς",15,1],["σὲ",5,161],["ἐκέκραξαν",0,0],["καὶ",2,8],["ἐσώθησαν",171,94],["ἐπὶ",9,1],["σοὶ",5,151],["ἤλπισαν",511,141],["καὶ",2,8],["οὐ",12,17],["κατῃσχύνθησαν",716,94]],"They cried to thee, and were saved: they hoped in thee, and were not ashamed."],["7",[["Ἐγὼ",6,158],["δέ",14,12],["εἰμι",10,149],["σκώληξ",1979,5],["καὶ",2,8],["οὐκ",12,17],["ἄνθρωπος",43,5],["ὄνειδος",973,20],["ἀνθρώπων",43,77],["καὶ",2,8],["ἐξουδένημα",0,0],["λαοῦ",35,21]],"But I am a worm, and not a man; a reproach of men, and scorn of the people."],["8",[["Πάντες",11,130],["οἱ",1,128],["θεωροῦντές",898,137],["με",6,82],["ἐξεμυκτήρισάν",5323,141],["με",6,82],["ἐλάλησαν",50,141],["ἐν",4,1],["χείλεσιν",361,92],["ἐκίνησαν",993,141],["κεφαλὴν",144,10]],"All that saw me mocked me: they spoke with [their] lips, they shook the head, [saying],"],["9",[["ἤλπισεν",511,3],["ἐπὶ",9,1],["Κύριον",7,7],["ῥυσάσθω",335,316],["αὐτὸν",3,82],["σωσάτω",171,46],["αὐτὸν",3,82],["ὅτι",19,8],["θέλει",609,87],["αὐτόν",3,82]],"He hoped in the Lord: let him deliver him, let him save him, because he takes pleasure in him."],["10",[["Ὅτι",19,8],["σὺ",5,156],["εἶ",10,145],["ὁ",1,4],["ἐκσπάσας",2060,155],["με",6,82],["ἐκ",21,1],["γαστρὸς",775,19],["ἡ",1,11],["ἐλπίς",527,13],["μου",6,48],["ἀπὸ",17,1],["μαστῶν",1273,77],["τῆς",1,18],["μητρός",188,19],["μου",6,83]],"For thou art he that drew me out of the womb; my hope from my mother's breasts."],["11",[["ἐπὶ",9,1],["σὲ",5,161],["ἐπεῤῥίφην",2542,148],["ἐκ",21,1],["μήτρας",1346,19],["ἐκ",21,1],["κοιλίας",545,19],["μητρός",188,19],["μου",6,83],["Θεός",20,5],["μου",6,83],["εἶ",10,145],["σύ",5,156]],"I was cast on thee from the womb: thou art my God from my mother's belly."],["12",[["Μὴ",25,8],["ἀποστῇς",2055,159],["ἀπʼ",17,1],["ἐμοῦ",6,48],["ὅτι",19,8],["θλίψις",437,40],["ἐγγὺς",1022,17],["ὅτι",19,8],["οὐκ",12,17],["ἔστιν",10,87],["ὁ",1,4],["βοηθῶν",552,67]],"Stand not aloof from me; for affliction is near; for there is no helper."],["13",[["Περιεκύκλωσάν",2381,141],["με",6,82],["μόσχοι",256,51],["πολλοί",74,130],["ταῦροι",1284,51],["πίονες",1977,51],["περιέσχον",1349,141],["με",6,82]],"Many bullocks have compassed me: fat bulls have beset me round."],["14",[["Ἤνοιξαν",621,141],["ἐπʼ",9,1],["ἐμὲ",6,82],["τὸ",1,32],["στόμα",123,33],["αὐτῶν",3,41],["ὡς",36,8],["λέων",421,5],["ὁ",1,4],["ἁρπάζων",1219,67],["καὶ",2,8],["ὠρυόμενος",2694,114]],"They have opened their mouth against me, as a ravening and roaring lion."],["15",[["Ὡσεὶ",342,17],["ὕδωρ",85,33],["ἐξεχύθην",435,148],["καὶ",2,8],["διεσκορπίσθη",1001,38],["πάντα",11,65],["τὰ",1,42],["ὀστᾶ",472,43],["μου",6,48],["ἐγενήθη",30,38],["ἡ",1,11],["καρδία",63,13],["μου",6,48],["ὡσεὶ",342,17],["κηρὸς",3080,5],["τηκόμενος",1019,114],["ἐν",4,1],["μέσῳ",112,34],["τῆς",1,18],["κοιλίας",545,19],["μου",6,83]],"I am poured out like water, and all my bones are loosened: my heart in the midst of my belly is become like melting wax."],["16",[["Ἐξηράνθη",843,38],["ὡσεὶ",342,17],["ὄστρακον",2862,20],["ἡ",1,11],["ἰσχύς",180,13],["μου",6,48],["καὶ",2,8],["ἡ",1,11],["γλῶσσά",385,13],["μου",6,48],["κεκόλληται",0,0],["τῷ",1,110],["λάρυγγί",2097,113],["μου",6,48],["καὶ",2,8],["εἰς",8,1],["χοῦν",1288,7],["θανάτου",169,21],["κατήγαγές",741,154],["με",6,82]],"My strength is dried up like a potsherd; and my tongue is glued to my throat; and thou hast brought me down to the dust of death."],["17",[["Ὅτι",19,8],["ἐκύκλωσάν",600,141],["με",6,82],["κύνες",1208,51],["πολλοὶ",74,130],["συναγωγὴ",284,13],["πονηρευομένων",1387,476],["περιέσχον",1349,141],["με",6,82],["ὤρυξαν",1372,141],["χεῖράς",37,40],["μου",6,48],["καὶ",2,8],["πόδας",208,31]],"For many dogs have compassed me: the assembly of the wicked doers has beset me round: they pierced my hands and my feet."],["18",[["ἐξηρίθμησαν",1933,141],["πάντα",11,65],["τὰ",1,42],["ὀστᾶ",472,43],["μου",6,48],["αὐτοὶ",3,193],["δὲ",14,12],["κατενόησαν",1547,141],["καὶ",2,8],["ἐπεῖδόν",1866,141],["με",6,82]],"They counted all my bones; and they observed and looked upon me."],["19",[["Διεμερίσαντο",2174,182],["τὰ",1,42],["ἱμάτιά",275,43],["μου",6,48],["ἑαυτοῖς",92,142],["καὶ",2,8],["ἐπὶ",9,1],["τὸν",1,6],["ἱματισμόν",1462,7],["μου",6,48],["ἔβαλον",774,141],["κλῆρον",405,7]],"They parted my garments [among] themselves, and cast lots upon my raiment."],["20",[["Σὺ",5,156],["δὲ",14,12],["Κύριε",7,251],["μὴ",25,8],["μακρύνῃς",0,0],["τὴν",1,9],["βοήθειάν",761,10],["μου",6,48],["εἰς",8,1],["τὴν",1,9],["ἀντίληψίν",2413,10],["μου",6,48],["πρόσχες",1692,154]],"But thou, O Lord, remove not my help afar off: be ready for mine aid."],["21",[["Ῥῦσαι",335,275],["ἀπὸ",17,1],["ῥομφαίας",247,40],["τὴν",1,9],["ψυχήν",62,10],["μου",6,48],["καὶ",2,8],["ἐκ",21,1],["χειρὸς",37,19],["κυνὸς",1208,21],["τὴν",1,9],["μονογενῆ",3306,37],["μου",6,48]],"Deliver my soul from the sword; my only-begotten one from the power of the dog."],["22",[["Σῶσόν",171,198],["με",6,82],["ἐκ",21,1],["στόματος",123,24],["λέοντος",421,21],["καὶ",2,8],["ἀπὸ",17,1],["κεράτων",567,45],["μονοκερώτων",0,0],["τὴν",1,9],["ταπείνωσίν",1483,10],["μου",6,48]],"Save me from the lion's mouth; and [regard] my lowliness from the horns of the unicorns."],["23",[["Διηγήσομαι",797,176],["τὸ",1,32],["ὄνομά",55,33],["σου",5,146],["τοῖς",1,138],["ἀδελφοῖς",66,139],["μου",6,48],["ἐν",4,1],["μέσῳ",112,34],["ἐκκλησίας",562,19],["ὑμνήσω",856,157],["σε",5,161]],"I will declare thy name to my brethren: in the midst of the church will I sing praise to thee."],["24",[["Οἱ",1,128],["φοβούμενοι",134,356],["Κύριον",7,7],["αἰνέσατε",399,69],["αὐτὸν",3,82],["ἅπαν",769,28],["τὸ",1,27],["σπέρμα",214,20],["Ἰακὼβ",146,105],["δοξάσατε",465,69],["αὐτὸν",3,82],["φοβηθήτωσαν",134,50],["αὐτὸν",3,82],["ἅπαν",769,28],["τὸ",1,27],["σπέρμα",214,20],["Ἰσραήλ",27,105]],"Ye that fear the Lord, praise him; all ye seed of Jacob, glorify him: let all the seed of Israel fear him."],["25",[["Οτι",19,105],["οὐκ",12,17],["ἐξουδένωσεν",1069,3],["οὐδὲ",105,12],["προσώχθισε",1833,3],["τῇ",1,95],["δεήσει",674,2],["τοῦ",1,30],["πτωχοῦ",496,21],["οὐδὲ",105,12],["ἀπέστρεψε",130,3],["τὸ",1,32],["πρόσωπον",47,33],["αὐτοῦ",3,48],["ἀπʼ",17,1],["ἐμοῦ",6,48],["καὶ",2,8],["ἐν",4,1],["τῷ",1,110],["κεκραγέναι",590,107],["με",6,82],["πρὸς",15,1],["αὐτὸν",3,82],["εἰσήκουσέ",237,3],["μου",6,48]],"For he has not despised nor been angry at the supplication of the poor; nor turned away his face from me; but when I cried to him, he heard me."],["26",[["Παρὰ",72,1],["σοῦ",5,146],["ὁ",1,4],["ἔπαινός",2854,5],["μου",6,48],["ἐν",4,1],["ἐκκλησίᾳ",562,2],["μεγάλῃ",65,96],["τὰς",1,39],["εὐχάς",631,40],["μου",6,48],["ἀποδώσω",311,157],["ἐνώπιον",114,1],["τῶν",1,76],["φοβουμένων",134,299],["αὐτόν",3,82]],"My praise is of thee in the great congregation: I will pay my vows before them that fear him."],["27",[["Φάγονται",153,127],["πένητες",668,51],["καὶ",2,8],["ἐμπλησθήσονται",424,135],["καὶ",2,8],["αἰνέσουσι",399,207],["Κύριον",7,7],["οἱ",1,128],["ἐκζητοῦντες",459,137],["αὐτὸν",3,82],["ζήσονται",117,127],["αἱ",1,183],["καρδίαι",63,2],["αὐτῶν",3,41],["εἰς",8,1],["αἰῶνα",100,7],["αἰῶνος",100,21]],"The poor shall eat and be satisfied; and they shall praise the Lord that seek him: their heart shall live for ever."],["28",[["Μνησθήσονται",231,135],["καὶ",2,8],["ἐπιστραφήσονται",116,135],["πρὸς",15,1],["Κύριον",7,7],["πάντα",11,59],["τὰ",1,42],["πέρατα",877,43],["τῆς",1,18],["γῆς",26,19],["καὶ",2,8],["προσκυνήσουσιν",296,207],["ἐνώπιον",114,1],["αὐτοῦ",3,48],["πᾶσαι",11,185],["αἱ",1,183],["πατριαὶ",336,179],["τῶν",1,44],["ἐθνῶν",59,45]],"All the ends of the earth shall remember and turn to the Lord: and all the kindreds of the nations shall worship before him."],["29",[["Ὅτι",19,8],["τοῦ",1,30],["Κυρίου",7,21],["ἡ",1,11],["βασιλεία",157,13],["καὶ",2,8],["αὐτὸς",3,158],["δεσπόζει",2022,87],["τῶν",1,44],["ἐθνῶν",59,45]],"For the kingdom is the Lord's; and he is the governor of the nations."],["30",[["Ἔφαγον",268,141],["καὶ",2,8],["προσεκύνησαν",296,141],["πάντες",11,130],["οἱ",1,128],["πίονες",1977,51],["τῆς",1,18],["γῆς",26,19],["ἐνώπιον",114,1],["αὐτοῦ",3,48],["προπεσοῦνται",3125,127],["πάντες",11,130],["οἱ",1,128],["καταβαίνοντες",174,137],["εἰς",8,1],["τὴν",1,9],["γῆν",26,10],["καὶ",2,8],["ἡ",1,11],["ψυχή",62,13],["μου",6,48],["αὐτῷ",3,49],["ζῇ",117,87]],"All the fat ones of the earth have eaten and worshipped: all that go down to the earth shall fall down before him: my soul also lives to him."],["31",[["καὶ",2,8],["τὸ",1,32],["σπέρμα",214,33],["μου",6,48],["δουλεύσει",403,120],["αὐτῷ",3,49],["ἀναγγελήσεται",0,0],["τῷ",1,110],["Κυρίῳ",7,113],["γενεὰ",286,13],["ἡ",1,11],["ἐρχομένη",56,204]],"And my seed shall serve him: the generation that is coming shall be reported to the Lord."],["32",[["Καὶ",2,8],["ἀναγγελοῦσι",228,207],["τὴν",1,9],["δικαιοσύνην",185,10],["αὐτοῦ",3,48],["λαῷ",35,113],["τῷ",1,110],["τεχθησομένῳ",251,693],["ὃν",24,106],["ἐποίησεν",23,3],["ὁ",1,4],["Κύριος",7,5]],"And they shall report his righteousness to the people that shall be born, whom the Lord has made."]]