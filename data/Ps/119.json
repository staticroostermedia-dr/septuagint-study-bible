[["1",[["Ὠδὴ",776,105],["τῶν",1,76],["ἀναβαθμῶν",1484,77],["Πρὸς",15,1],["Κύριον",7,7],["ἐν",4,1],["τῷ",1,110],["θλίβεσθαί",601,104],["με",6,82],["ἐκέκραξα",592,147],["καὶ",2,8],["εἰσήκουσέ",241,3],["μου",6,48]],"A Song of Degrees. In mine affliction I cried to the Lord, and he hearkened to me."],["2",[["Κύριε",7,250],["ῥῦσαι",337,275],["τὴν",1,9],["ψυχήν",63,10],["μου",6,48],["ἀπὸ",17,1],["χειλέων",361,45],["ἀδίκων",406,79],["καὶ",2,8],["ἀπὸ",17,1],["γλώσσης",388,19],["δολίας",1545,78]],"Deliver my soul, O Lord, from unjust lips, and from a deceitful tongue."],["3",[["Τί",39,119],["δοθείη",33,544],["σοι",5,151],["καὶ",2,8],["τί",39,119],["προστεθείη",201,544],["σοι",5,151],["πρὸς",15,1],["γλῶσσαν",388,10],["δολίαν",1545,37]],"What should be given to thee, and what should be added to thee, for [thy] crafty tongue?"],["4",[["Τὰ",1,42],["βέλη",1156,43],["τοῦ",1,30],["δυνατοῦ",356,153],["ἠκονημένα",3684,197],["σὺν",310,1],["τοῖς",1,138],["ἄνθραξι",1402,139],["τοῖς",1,138],["ἐρημικοῖς",6529,215]],"Sharpened weapons of the mighty, with coals of the desert."],["5",[["Οἴμοι",2103,316],["ὅτι",19,8],["ἡ",1,11],["παροικία",2105,13],["μου",6,48],["ἐμακρύνθη",0,0],["κατεσκήνωσα",805,147],["μετὰ",29,1],["τῶν",1,44],["σκηνωμάτων",682,45],["Κηδάρ",12247,0]],"Woe is me, that my sojourning is prolonged; I have tabernacled among the tents of Kedar."],["6",[["Πολλὰ",74,65],["παρῴκησεν",782,3],["ἡ",1,11],["ψυχή",63,13],["μου",6,48],["μετὰ",29,1],["τῶν",1,76],["μισούντων",351,164],["τὴν",1,9],["εἰρήνην",213,10]],"My soul has long been a sojourner;"],["7",[["Ἤμην",10,429],["εἰρηνικός",935,16],["ὅταν",319,8],["ἐλάλουν",50,129],["αὐτοῖς",3,142],["ἐπολέμουν",305,129],["με",6,98],["δωρεάν",1341,10]],"I was peaceable among them that hated peace; when I spoke to them, they warred against me without a cause."]]