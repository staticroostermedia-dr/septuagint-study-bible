[["1",[["Ὠδὴ",773,105],["τῶν",1,76],["ἀναβαθμῶν",1486,77],["Πρὸς",15,1],["Κύριον",7,7],["ἐν",4,1],["τῷ",1,110],["θλίβεσθαί",599,104],["με",6,82],["ἐκέκραξα",590,147],["καὶ",2,8],["εἰσήκουσέ",237,3],["μου",6,48]],"A Song of Degrees. In mine affliction I cried to the Lord, and he hearkened to me."],["2",[["Κύριε",7,251],["ῥῦσαι",335,275],["τὴν",1,9],["ψυχήν",62,10],["μου",6,48],["ἀπὸ",17,1],["χειλέων",361,45],["ἀδίκων",402,79],["καὶ",2,8],["ἀπὸ",17,1],["γλώσσης",385,19],["δολίας",1543,78]],"Deliver my soul, O Lord, from unjust lips, and from a deceitful tongue."],["3",[["Τί",39,119],["δοθείη",33,555],["σοι",5,151],["καὶ",2,8],["τί",39,119],["προστεθείη",200,555],["σοι",5,151],["πρὸς",15,1],["γλῶσσαν",385,10],["δολίαν",1543,37]],"What should be given to thee, and what should be added to thee, for [thy] crafty tongue?"],["4",[["Τὰ",1,42],["βέλη",1159,43],["τοῦ",1,30],["δυνατοῦ",354,153],["ἠκονημένα",0,0],["σὺν",309,1],["τοῖς",1,138],["ἄνθραξι",1403,139],["τοῖς",1,138],["ἐρημικοῖς",6567,215]],"Sharpened weapons of the mighty, with coals of the desert."],["5",[["Οἴμοι",2110,320],["ὅτι",19,8],["ἡ",1,11],["παροικία",2112,13],["μου",6,48],["ἐμακρύνθη",0,0],["κατεσκήνωσα",802,147],["μετὰ",29,1],["τῶν",1,44],["σκηνωμάτων",680,45],["Κηδάρ",0,0]],"Woe is me, that my sojourning is prolonged; I have tabernacled among the tents of Kedar."],["6",[["Πολλὰ",74,65],["παρῴκησεν",781,3],["ἡ",1,11],["ψυχή",62,13],["μου",6,48],["μετὰ",29,1],["τῶν",1,76],["μισούντων",355,164],["τὴν",1,9],["εἰρήνην",210,10]],"My soul has long been a sojourner;"],["7",[["Ἤμην",10,435],["εἰρηνικός",934,16],["ὅταν",318,8],["ἐλάλουν",50,129],["αὐτοῖς",3,142],["ἐπολέμουν",304,129],["με",6,98],["δωρεάν",1338,10]],"I was peaceable among them that hated peace; when I spoke to them, they warred against me without a cause."]]