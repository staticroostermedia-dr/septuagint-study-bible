[["1",[["Ἀλληλούϊα",1749,105],["Ἐξομολογεῖσθε",479,382],["τῷ",1,110],["Κυρίῳ",7,113],["ὅτι",19,8],["χρηστὸς",1359,16],["ὅτι",19,8],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["τὸ",1,32],["ἔλεος",183,33],["αὐτοῦ",3,48]],"Alleluia. Give thanks to the Lord, for he is good; for his mercy [endures] for ever."],["2",[["Εἰπάτωσαν",18,261],["οἱ",1,128],["λελυτρωμένοι",535,370],["ὑπὸ",122,1],["Κυρίου",7,21],["οὓς",24,294],["ἐλυτρώσατο",535,26],["ἐκ",21,1],["χειρὸς",37,19],["ἐχθροῦ",135,21]],"Let them say [so] who have been redeemed by the Lord, whom he has redeemed from the hand of the enemy;"],["3",[["καὶ",2,8],["ἐκ",21,1],["τῶν",1,123],["χωρῶν",278,61],["συνήγαγεν",166,3],["αὐτούς",3,60],["ἀπὸ",17,1],["ἀνατολῶν",345,61],["καὶ",2,8],["δυσμῶν",882,61],["καὶ",2,8],["βοῤῥᾶ",387,5],["καὶ",2,8],["θαλάσσης",137,19]],"and gathered them out of the countries, from the east, and west, and north, and south."],["4",[["Ἐπλανήθησαν",464,94],["ἐν",4,1],["τῇ",1,95],["ἐρήμῳ",160,96],["ἐν",4,1],["ἀνύδρῳ",1701,96],["ὁδὸν",68,10],["πόλεως",41,19],["κατοικητηρίου",2020,24],["οὐχ",12,17],["εὗρον",101,141]],"They wandered in the wilderness in a dry land; they found no way to a city of habitation."],["5",[["Πεινῶντες",1045,137],["καὶ",2,8],["διψῶντες",1161,137],["ἡ",1,11],["ψυχὴ",63,13],["αὐτῶν",3,41],["ἐν",4,1],["αὐτοῖς",3,142],["ἐξέλιπε",321,3]],"Hungry and thirsty, their soul fainted in them."],["6",[["Καὶ",2,8],["ἐκέκραξαν",0,0],["πρὸς",15,1],["Κύριον",7,7],["ἐν",4,1],["τῷ",1,110],["θλίβεσθαι",601,104],["αὐτοὺς",3,60],["καὶ",2,8],["ἐκ",21,1],["τῶν",1,123],["ἀναγκῶν",1126,61],["αὐτῶν",3,189],["ἐῤῥύσατο",337,26],["αὐτούς",3,60]],"Then they cried to the Lord in their affliction, and he delivered them out of their distresses."],["7",[["Καὶ",2,8],["ὡδήγησεν",1108,3],["αὐτοὺς",3,60],["εἰς",8,1],["ὁδὸν",68,10],["εὐθεῖαν",1137,37],["τοῦ",1,30],["πορευθῆναι",49,175],["εἰς",8,1],["πόλιν",41,10],["κατοικητηρίου",2020,24]],"And he guided them into a straight path, that they might go to a city of habitation."],["8",[["Ἐξομολογησάσθωσαν",479,533],["τῷ",1,110],["Κυρίῳ",7,113],["τὰ",1,42],["ἐλέη",183,43],["αὐτοῦ",3,48],["καὶ",2,8],["τὰ",1,42],["θαυμάσια",884,65],["αὐτοῦ",3,48],["τοῖς",1,138],["υἱοῖς",13,139],["τῶν",1,76],["ἀνθρώπων",43,77]],"Let them acknowledge to the Lord his mercies, and his wonderful works to the children of men."],["9",[["Ὅτι",19,8],["ἐχόρτασε",2397,3],["ψυχὴν",63,10],["κενὴν",780,37],["καὶ",2,8],["πεινῶσαν",1045,73],["ἐνέπλησεν",427,3],["ἀγαθῶν",114,79]],"For he satisfies the empty soul, and fills the hungry [soul] with good things,"],["10",[["Καθημένους",419,439],["ἐν",4,1],["σκότει",506,53],["καὶ",2,8],["σκιᾷ",978,2],["θανάτου",170,21],["πεπεδημένους",2280,369],["ἐν",4,1],["πτωχείᾳ",1913,2],["καὶ",2,8],["σιδήρῳ",794,113]],"[even] them that sit in darkness and the shadow of death, fettered in poverty and iron;"],["11",[["Ὅτι",19,8],["παρεπίκραναν",1685,141],["τὰ",1,42],["λόγια",1248,43],["τοῦ",1,30],["Θεοῦ",20,21],["καὶ",2,8],["τὴν",1,9],["βουλὴν",350,10],["τοῦ",1,30],["ὑψίστου",474,153],["παρώξυναν",1044,141]],"because they rebelled against the words of God, and provoked the counsel of the Most High."],["12",[["Καὶ",2,8],["ἐταπεινώθη",322,38],["ἐν",4,1],["κόποις",1345,139],["ἡ",1,11],["καρδία",64,13],["αὐτῶν",3,41],["ἠσθένησαν",771,141],["καὶ",2,8],["οὐκ",12,17],["ἦν",10,14],["ὁ",1,4],["βοηθῶν",553,67]],"So their heart was brought low with troubles; they were weak, and there was no helper."],["13",[["Καὶ",2,8],["ἐκέκραξαν",0,0],["πρὸς",15,1],["Κύριον",7,7],["ἐν",4,1],["τῷ",1,110],["θλίβεσθαι",601,104],["αὐτοὺς",3,60],["καὶ",2,8],["ἐκ",21,1],["τῶν",1,123],["ἀναγκῶν",1126,61],["αὐτῶν",3,189],["ἔσωσεν",172,3],["αὐτούς",3,60]],"Then they cried to the Lord in their affliction, and he saved them out of their distresses."],["14",[["Καὶ",2,8],["ἐξήγαγεν",295,3],["αὐτοὺς",3,60],["ἐκ",21,1],["σκότους",506,31],["καὶ",2,8],["σκιᾶς",978,19],["θανάτου",170,21],["καὶ",2,8],["τοὺς",1,56],["δεσμοὺς",1035,31],["αὐτῶν",3,41],["διέῤῥηξεν",647,3]],"And he brought them out of darkness and the shadow of death, and broke their bonds asunder."],["15",[["Ἐξομολογησάσθωσαν",479,533],["τῷ",1,110],["Κυρίῳ",7,113],["τὰ",1,42],["ἐλέη",183,43],["αὐτοῦ",3,48],["καὶ",2,8],["τὰ",1,42],["θαυμάσια",884,65],["αὐτοῦ",3,48],["τοῖς",1,138],["υἱοῖς",13,139],["τῶν",1,76],["ἀνθρώπων",43,77]],"Let them acknowledge to the Lord his mercies, and his wonders to the children of men."],["16",[["Ὅτι",19,8],["συνέτριψε",268,3],["πύλας",162,40],["χαλκᾶς",2128,31],["καὶ",2,8],["μοχλοὺς",1167,31],["σιδηροὺς",794,31],["συνέθλασεν",3647,3]],"For he broke to pieces the brazen gates, and crushed the iron bars."],["17",[["Ἀντελάβετο",984,26],["αὐτῶν",3,41],["ἐξ",21,1],["ὁδοῦ",68,19],["ἀνομίας",275,19],["αὐτῶν",3,41],["διὰ",56,1],["γὰρ",40,12],["τὰς",1,39],["ἀνομίας",275,40],["αὐτῶν",3,41],["ἐταπεινώθησαν",322,94]],"He helped them out of the way of their iniquity; for they were brought low because of their iniquities."],["18",[["Πᾶν",11,29],["βρῶμα",714,33],["ἐβδελύξατο",1056,252],["ἡ",1,11],["ψυχὴ",63,13],["αὐτῶν",3,41],["καὶ",2,8],["ἤγγισαν",455,141],["ἕως",42,8],["τῶν",1,123],["πυλῶν",162,61],["τοῦ",1,30],["θανάτου",170,21]],"Their soul abhorred all meat; and they drew near to the gates of death."],["19",[["Καὶ",2,8],["ἐκέκραξαν",0,0],["πρὸς",15,1],["Κύριον",7,7],["ἐν",4,1],["τῷ",1,110],["θλίβεσθαι",601,104],["αὐτοὺς",3,60],["καὶ",2,8],["ἐκ",21,1],["τῶν",1,123],["ἀναγκῶν",1126,61],["αὐτῶν",3,189],["ἔσωσεν",172,3],["αὐτούς",3,60]],"Then they cried to the Lord in their affliction, and he saved them out of their distresses."],["20",[["Ἀπέστειλε",84,3],["τὸν",1,6],["λόγον",48,7],["αὐτοῦ",3,48],["καὶ",2,8],["ἰάσατο",797,252],["αὐτοὺς",3,60],["καὶ",2,8],["ἐῤῥύσατο",337,26],["αὐτοὺς",3,60],["ἐκ",21,1],["τῶν",1,123],["διαφθορῶν",1671,61],["αὐτῶν",3,189]],"He sent his word, and healed them, and delivered them out of their destructions."],["21",[["Ἐξομολογησάσθωσαν",479,533],["τῷ",1,110],["Κυρίῳ",7,113],["τὰ",1,42],["ἐλέη",183,43],["αὐτοῦ",3,48],["καὶ",2,8],["τὰ",1,42],["θαυμάσια",884,65],["αὐτοῦ",3,48],["τοῖς",1,138],["υἱοῖς",13,139],["τῶν",1,76],["ἀνθρώπων",43,77]],"Let them acknowledge to the Lord his mercies, and his wonderful works to the children of men."],["22",[["Καὶ",2,8],["θυσάτωσαν",437,261],["αὐτῷ",3,49],["θυσίαν",156,10],["αἰνέσεως",989,19],["καὶ",2,8],["ἐξαγγειλάτωσαν",2532,261],["τὰ",1,42],["ἔργα",105,43],["αὐτοῦ",3,48],["ἐν",4,1],["ἀγαλλιάσει",1981,2]],"And let them offer to him the sacrifice of praise, and proclaim his works with exultation."],["23",[["Οἱ",1,128],["καταβαίνοντες",175,137],["εἰς",8,1],["θάλασσαν",137,10],["ἐν",4,1],["πλοίοις",1169,92],["ποιοῦντες",23,137],["ἐργασίαν",1070,10],["ἐν",4,1],["ὕδασι",85,92],["πολλοῖς",74,90]],"They that go down to the sea in ships, doing business in many waters;"],["24",[["αὐτοὶ",3,195],["εἶδον",53,147],["τὰ",1,42],["ἔργα",105,43],["Κυρίου",7,21],["καὶ",2,8],["τὰ",1,42],["θαυμάσια",884,65],["αὐτοῦ",3,48],["ἐν",4,1],["τῷ",1,110],["βυθῷ",3507,113]],"these [men] have seen the works of the Lord, and his wonders in the deep."],["25",[["Εἶπε",18,3],["καὶ",2,8],["ἔστη",78,3],["πνεῦμα",168,20],["καταιγίδος",1470,19],["καὶ",2,8],["ὑψώθη",331,38],["τὰ",1,42],["κύματα",1630,43],["αὐτῆς",3,83]],"He speaks, and the stormy wind arises, and its waves are lifted up."],["26",[["Ἀναβαίνουσιν",88,191],["ἕως",42,8],["τῶν",1,76],["οὐρανῶν",94,77],["καὶ",2,8],["καταβαίνουσιν",175,191],["ἕως",42,8],["τῶν",1,123],["ἀβύσσων",1083,61],["ἡ",1,11],["ψυχὴ",63,13],["αὐτῶν",3,41],["ἐν",4,1],["κακοῖς",161,215],["ἐτήκετο",1021,22]],"They go up to the heavens, and go down to the depths; their soul melts because of troubles."],["27",[["ἐταράχθησαν",508,94],["ἐσαλεύθησαν",678,94],["ὡς",36,8],["ὁ",1,4],["μεθύων",2464,67],["καὶ",2,8],["πᾶσα",11,15],["ἡ",1,11],["σοφία",242,13],["αὐτῶν",3,41],["κατεπόθη",1183,38]],"They are troubled, they stagger as a drunkard, and all their wisdom is swallowed up."],["28",[["Καὶ",2,8],["ἐκέκραξαν",0,0],["πρὸς",15,1],["Κύριον",7,7],["ἐν",4,1],["τῷ",1,110],["θλίβεσθαι",601,104],["αὐτ