[["1",[["Ἀλληλούϊα",1746,105],["Ἐξομολογεῖσθε",478,386],["τῷ",1,110],["Κυρίῳ",7,113],["ὅτι",19,8],["χρηστὸς",1357,16],["ὅτι",19,8],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["τὸ",1,32],["ἔλεος",182,33],["αὐτοῦ",3,48]],"Alleluia. Give thanks to the Lord, for he is good; for his mercy [endures] for ever."],["2",[["Εἰπάτωσαν",18,261],["οἱ",1,128],["λελυτρωμένοι",0,0],["ὑπὸ",122,1],["Κυρίου",7,21],["οὓς",24,298],["ἐλυτρώσατο",548,26],["ἐκ",21,1],["χειρὸς",37,19],["ἐχθροῦ",135,21]],"Let them say [so] who have been redeemed by the Lord, whom he has redeemed from the hand of the enemy;"],["3",[["καὶ",2,8],["ἐκ",21,1],["τῶν",1,123],["χωρῶν",278,61],["συνήγαγεν",165,3],["αὐτούς",3,60],["ἀπὸ",17,1],["ἀνατολῶν",344,61],["καὶ",2,8],["δυσμῶν",883,61],["καὶ",2,8],["βοῤῥᾶ",384,5],["καὶ",2,8],["θαλάσσης",137,19]],"and gathered them out of the countries, from the east, and west, and north, and south."],["4",[["Ἐπλανήθησαν",464,94],["ἐν",4,1],["τῇ",1,95],["ἐρήμῳ",160,96],["ἐν",4,1],["ἀνύδρῳ",1705,96],["ὁδὸν",67,10],["πόλεως",41,19],["κατοικητηρίου",2027,24],["οὐχ",12,17],["εὗρον",106,141]],"They wandered in the wilderness in a dry land; they found no way to a city of habitation."],["5",[["Πεινῶντες",1042,137],["καὶ",2,8],["διψῶντες",1163,137],["ἡ",1,11],["ψυχὴ",62,13],["αὐτῶν",3,41],["ἐν",4,1],["αὐτοῖς",3,142],["ἐξέλιπε",321,3]],"Hungry and thirsty, their soul fainted in them."],["6",[["Καὶ",2,8],["ἐκέκραξαν",0,0],["πρὸς",15,1],["Κύριον",7,7],["ἐν",4,1],["τῷ",1,110],["θλίβεσθαι",599,104],["αὐτοὺς",3,60],["καὶ",2,8],["ἐκ",21,1],["τῶν",1,123],["ἀναγκῶν",1125,61],["αὐτῶν",3,187],["ἐῤῥύσατο",335,26],["αὐτούς",3,60]],"Then they cried to the Lord in their affliction, and he delivered them out of their distresses."],["7",[["Καὶ",2,8],["ὡδήγησεν",1110,3],["αὐτοὺς",3,60],["εἰς",8,1],["ὁδὸν",67,10],["εὐθεῖαν",1137,37],["τοῦ",1,30],["πορευθῆναι",49,174],["εἰς",8,1],["πόλιν",41,10],["κατοικητηρίου",2027,24]],"And he guided them into a straight path, that they might go to a city of habitation."],["