[["1",[["Εἰς",8,1],["Σαλωμών",172,61],["Ὁ",1,4],["Θεὸς",20,5],["τὸ",1,32],["κρίμα",266,33],["σου",5,146],["τῷ",1,110],["βασιλεῖ",22,113],["δὸς",33,198],["καὶ",2,8],["τὴν",1,9],["δικαιοσύνην",185,10],["σου",5,146],["τῷ",1,110],["υἱῷ",13,113],["τοῦ",1,30],["βασιλέως",22,21]],"For Solomon. O God, give thy judgment to the king, and thy righteousness to the king's son;"],["2",[["κρίνειν",240,54],["τὸν",1,6],["λαόν",35,7],["σου",5,146],["ἐν",4,1],["δικαιοσύνῃ",185,2],["καὶ",2,8],["τοὺς",1,56],["πτωχούς",496,31],["σου",5,146],["ἐν",4,1],["κρίσει",226,2]],"[that he may] judge thy people with righteousness, and thy poor with judgment."],["3",[["Ἀναλαβέτω",573,46],["τὰ",1,42],["ὄρη",86,43],["εἰρήνην",210,10],["τῷ",1,110],["λαῷ",35,113],["σου",5,146],["καὶ",2,8],["οἱ",1,128],["βουνοί",575,51]],"Let the mountains and the hills raise peace to thy people:"],["4",[["ἐν",4,1],["δικαιοσύνῃ",185,2],["κρινεῖ",240,120],["τοὺς",1,56],["πτωχοὺς",496,31],["τοῦ",1,30],["λαοῦ",35,21],["καὶ",2,8],["σώσει",171,120],["τοὺς",1,56],["υἱοὺς",13,31],["τῶν",1,76],["πενήτων",668,77],["καὶ",2,8],["ταπεινώσει",333,120],["συκοφάντην",6120,7]],"he shall judge the poor of the people in righteousness, and save the children of the needy; and shall bring low the false accuser."],["5",[["καὶ",2,8],["συμπαραμενεῖ",8431,120],["τῷ",1,110],["ἡλίῳ",320,113],["καὶ",2,8],["πρὸ",235,1],["τῆς",1,18],["σελήνης",1211,19],["γενεὰς",286,40],["γενεῶν",286,61]],"And he shall continue as long as the sun, and before the moon for ever."],["6",[["Καταβήσεται",174,89],["ὡς",36,8],["ὑετὸς",672,5],["ἐπὶ",9,1],["πόκον",2965,7],["καὶ",2,8],["ὡσεὶ",342,17],["σταγόνες",2968,179],["στάζουσαι",2204,305],["ἐπὶ",9,1],["τὴν",1,9],["γῆν",26,10]],"He shall come down as rain upon a fleece; and as drops falling upon the earth."],["7",[["Ἀνατελεῖ",902,120],["ἐν",4,1],["ταῖς",1,70],["ἡμέραις",28,71],["αὐτοῦ",3,48],["δικαιοσύνη",185,13],["καὶ",2,8],["πλῆθος",199,20],["εἰρήνης",210,19],["ἕως",42,8],["οὗ",120,17],["ἀνταναιρεθῇ",2995,337],["ἡ",1,11],["σελήνη",1211,13]],"In his days shall righteousness spring up; and abundance of peace till the moon be removed."],["8",[["Καὶ",2,8],["κατακυριεύσει",2091,120],["ἀπὸ",17,1],["θαλάσσης",137,19],["ἕως",42,8],["θαλάσσης",137,19],["καὶ",2,8],["ἀπὸ",17,1],["ποταμοῦ",249,21],["ἕως",42,8],["περάτων",877,45],["τῆς",1,18],["οἰκουμένης",1326,19]],"And he shall have dominion from sea to sea, and from the river to the ends of the earth."],["9",[["Ἐνώπιον",114,1],["αὐτοῦ",3,48],["προπεσοῦνται",3125,127],["Αἰθίοπες",1538,51],["καὶ",2,8],["οἱ",1,128],["ἐχθροὶ",135,51],["αὐτοῦ",3,48],["χοῦν",1288,7],["λείξουσι",3892,207]],"The Ethiopians shall fall down before him; and his enemies shall lick the dust."],["10",[["Βασιλεῖς",22,51],["Θαρσὶς",0,0],["καὶ",2,8],["αἱ",1,183],["νῆσοι",1210,179],["δῶρα",347,43],["προσοίσουσι",362,207],["βασιλεῖς",22,51],["Ἀράβων",1220,77],["καὶ",2,8],["Σαβὰ",1978,157],["δῶρα",347,43],["προσάξουσι",352,207]],"The kings of Tharsis, and the isles, shall bring presents: the kings of the Arabians and Saba shall offer gifts."],["11",[["Καὶ",2,8],["προσκυνήσουσιν",296,207],["αὐτῷ",3,49],["πάντες",11,130],["οἱ",1,128],["βασιλεῖς",22,51],["πάντα",11,65],["τὰ",1,42],["ἔθνη",59,43],["δουλεύσουσιν",403,207],["αὐτῷ",3,49]],"And all kings shall worship him; all the Gentiles shall serve him."],["12",[["Ὅτι",19,8],["ἐῤῥύσατο",335,26],["πτωχὸν",496,7],["ἐκ",21,1],["δυνάστου",800,21],["καὶ",2,8],["πένητα",668,7],["ᾧ",24,202],["οὐχ",12,17],["ὑπῆρχε",416,165],["βοηθός",948,5]],"For he has delivered the poor from the oppressor; and the needy who had no helper."],["13",[["Φείσεται",607,89],["πτωχοῦ",496,21],["καὶ",2,8],["πένητος",668,21],["καὶ",2,8],["ψυχὰς",62,40],["πένητων",668,77],["σώσει",171,120]],"He shall spare the poor and needy, and shall deliver the souls of the needy."],["14",[["Ἐκ",21,1],["τόκου",1841,21],["καὶ",2,8],["ἐξ",21,1],["ἀδικίας",288,40],["λυτρώσεται",548,89],["τὰς",1,39],["ψυχὰς",62,40],["αὐτῶν",3,41],["καὶ",2,8],["ἔντιμον",1335,28],["τὸ",1,27],["ὄνομα",55,20],["αὐτῶν",3,41],["ἐνώπιον",114,1],["αὐτοῦ",3,48]],"He shall redeem their souls from usury and injustice: and their name [shall be] precious before him."],["15",[["Καὶ",2,8],["ζήσεται",117,89],["καὶ",2,8],["δοθήσεται",33,125],["αὐτῷ",3,49],["ἐκ",21,1],["τοῦ",1,23],["χρυσίου",202,24],["τῆς",1,18],["Ἀραβίας",1220,19],["καὶ",2,8],["προσεύξονται",550,127],["περὶ",71,1],["αὐτοῦ",3,48],["διαπαντός",506,17],["ὅλην",233,37],["τὴν",1,9],["ἡμέραν",28,10],["εὐλογήσουσιν",147,207],["αὐτόν",3,82]],"And he shall live, and there shall be given him of the gold of Arabia: and [men] shall pray for him continually; [and] all the day shall they praise him."],["16",[["Ἔσται",10,89],["στήριγμα",2122,20],["ἐν",4,1],["τῇ",1,95],["γῇ",26,2],["ἐπʼ",9,1],["ἄκρων",723,45],["τῶν",1,44],["ὀρέων",86,45],["ὑπεραρθήσεται",5450,125],["ὑπὲρ",139,1],["τὸν",1,6],["Λίβανον",534,7],["ὁ",1,4],["καρπὸς",446,5],["αὐτοῦ",3,48],["καὶ",2,8],["ἐξανθήσουσιν",1801,207],["ἐκ",21,1],["πόλεως",41,19],["ὡσεὶ",342,17],["χόρτος",1044,5],["τῆς",1,18],["γῆς",26,19]],"There shall be an establishment on the earth on the tops of the mountains: the fruit thereof shall be exalted above Libanus, and they of the city shall flourish as grass of the earth."],["17",[["Ἔστω",10,35],["τὸ",1,32],["ὄνομα",55,33],["αὐτοῦ",3,48],["εὐλογημένον",147,451],["εἰς",8,1],["τοὺς",1,56],["αἰῶνας",100,31],["πρὸ",235,1],["τοῦ",1,30],["ἡλίου",320,21],["διαμενεῖ",1886,120],["τὸ",1,32],["ὄνομα",55,33],["αὐτοῦ",3,48],["καὶ",2,8],["εὐλογηθήσονται",147,135],["ἐν",4,1],["αὐτῷ",3,49],["πᾶσαι",11,185],["αἱ",1,183],["φυλαὶ",142,179],["τῆς",1,18],["γῆς",26,19],["πάντα",11,65],["τὰ",1,42],["ἔθνη",59,43],["μακαριοῦσιν",1683,207],["αὐτόν",3,82]],"Let his name be blessed for ever: his name shall endure longer than the sun: and all the tribes of the earth shall be blessed in him: all nations shall call him blessed."],["18",[["Εὐλογητὸς",763,16],["Κύριος",7,5],["ὁ",1,4],["Θεὸς",20,5],["τοῦ",1,30],["Ἰσραὴλ",27,105],["ὁ",1,4],["ποιῶν",23,67],["θαυμάσια",885,65],["μόνος",300,16]],"Blessed is the Lord God of Israel, who alone does wonders."],["19",[["καὶ",2,8],["εὐλογητὸν",763,28],["τὸ",1,27],["ὄνομα",55,20],["τῆς",1,18],["δόξης",141,19],["αὐτοῦ",3,48],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["καὶ",2,8],["εἰς",8,1],["αἰῶνα",100,7],["τοῦ",1,30],["αἰῶνος",100,21],["καὶ",2,8],["πληρωθήσεται",529,125],["τῆς",1,18],["δόξης",141,19],["αὐτοῦ",3,48],["πᾶσα",11,15],["ἡ",1,11],["γῆ",26,13],["γένοιτο",30,397],["γένοιτο",30,397]],"And blessed is his glorious name for ever, even for ever and ever: and all the earth shall be filled with his glory. So be it, so be it."],["20",[["Ἐξέλιπον",321,141],["οἱ",1,128],["ὕμνοι",1499,51],["Δαυὶδ",52,105],["τοῦ",1,30],["υἱοῦ",13,21],["Ἰεσσαί",1239,105]],"The hymns of David the son of Jessæ are ended."]]