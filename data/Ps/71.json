[["1",[["Εἰς",8,1],["Σαλωμών",173,61],["Ὁ",1,4],["Θεὸς",20,5],["τὸ",1,32],["κρίμα",267,33],["σου",5,146],["τῷ",1,110],["βασιλεῖ",22,113],["δὸς",33,198],["καὶ",2,8],["τὴν",1,9],["δικαιοσύνην",187,10],["σου",5,146],["τῷ",1,110],["υἱῷ",13,113],["τοῦ",1,30],["βασιλέως",22,21]],"For Solomon. O God, give thy judgment to the king, and thy righteousness to the king's son;"],["2",[["κρίνειν",263,54],["τὸν",1,6],["λαόν",35,7],["σου",5,146],["ἐν",4,1],["δικαιοσύνῃ",187,2],["καὶ",2,8],["τοὺς",1,56],["πτωχούς",497,31],["σου",5,146],["ἐν",4,1],["κρίσει",229,2]],"[that he may] judge thy people with righteousness, and thy poor with judgment."],["3",[["Ἀναλαβέτω",575,46],["τὰ",1,42],["ὄρη",87,43],["εἰρήνην",213,10],["τῷ",1,110],["λαῷ",35,113],["σου",5,146],["καὶ",2,8],["οἱ",1,128],["βουνοί",577,51]],"Let the mountains and the hills raise peace to thy people:"],["4",[["ἐν",4,1],["δικαιοσύνῃ",187,2],["κρινεῖ",263,120],["τοὺς",1,56],["πτωχοὺς",497,31],["τοῦ",1,30],["λαοῦ",35,21],["καὶ",2,8],["σώσει",172,120],["τοὺς",1,56],["υἱοὺς",13,31],["τῶν",1,76],["πενήτων",672,77],["καὶ",2,8],["ταπεινώσει",322,120],["συκοφάντην",6092,7]],"he shall judge the poor of the people in righteousness, and save the children of the needy; and shall bring low the false accuser."],["5",[["καὶ",2,8],["συμπαραμενεῖ",8372,120],["τῷ",1,110],["ἡλίῳ",323,113],["καὶ",2,8],["πρὸ",238,1],["τῆς",1,18],["σελήνης",1207,19],["γενεὰς",286,40],["γενεῶν",286,61]],"And he shall continue as long as the sun, and before the moon for ever."],["6",[["Καταβήσεται",175,89],["ὡς",36,8],["ὑετὸς",676,5],["ἐπὶ",9,1],["πόκον",2952,7],["καὶ",2,8],["ὡσεὶ",343,17],["σταγόνες",2956,180],["στάζουσαι",2191,301],["ἐπὶ",9,1],["τὴν",1,9],["γῆν",26,10]],"He shall come down as rain upon a fleece; and as drops falling upon the earth."],["7",[["Ἀνατελεῖ",900,120],["ἐν",4,1],["ταῖς",1,70],["ἡμέραις",28,71],["αὐτοῦ",3,48],["δικαιοσύνη",187,13],["καὶ",2,8],["πλῆθος",200,20],["εἰρήνης",213,19],["ἕως",42,8],["οὗ",120,17],["ἀνταναιρεθῇ",2982,333],["ἡ",1,11],["σελήνη",1207,13]],"In his days shall righteousness spring up; and abundance of peace till the moon be removed."],["8",[["Καὶ",2,8],["κατακυριεύσει",2084,120],["ἀπὸ",17,1],["θαλάσσης",137,19],["ἕως",42,8],["θαλάσσης",137,19],["καὶ",2,8],["ἀπὸ",17,1],["ποταμοῦ",249,21],["ἕως",42,8],["περάτων",876,45],["τῆς",1,18],["οἰκουμένης",1326,19]],"And he shall have dominion from sea to sea, and from the river to the ends of the earth."],["9",[["Ἐνώπιον",115,1],["αὐτοῦ",3,48],["προπεσοῦνται",3117,127],["Αἰθίοπες",1539,51],["καὶ",2,8],["οἱ",1,128],["ἐχθροὶ",135,51],["αὐτοῦ",3,48],["χοῦν",1289,7],["λείξουσι",3882,207]],"The Ethiopians shall fall down before him; and his enemies shall lick the dust."],["10",[["Βασιλεῖς",22,51],["Θαρσὶς",11634,0],["καὶ",2,8],["αἱ",1,185],["νῆσοι",1206,180],["δῶρα",348,43],["προσοίσουσι",363,207],["βασιλεῖς",22,51],["Ἀράβων",1215,77],["καὶ",2,8],["Σαβὰ",11589,0],["δῶρα",348,43],["προσάξουσι",354,207]],"The kings of Tharsis, and the isles, shall bring presents: the kings of the Arabians and Saba shall offer gifts."],["11",[["Καὶ",2,8],["προσκυνήσουσιν",298,207],["αὐτῷ",3,49],["πάντες",11,130],["οἱ",1,128],["βασιλεῖς",22,51],["πάντα",11,65],["τὰ",1,42],["ἔθνη",60,43],["δουλεύσουσιν",398,207],["αὐτῷ",3,49]],"And all kings shall worship him; all the Gentiles shall serve him."],["12",[["Ὅτι",19,8],["ἐῤῥύσατο",337,26],["πτωχὸν",497,7],["ἐκ",21,1],["δυνάστου",803,21],["καὶ",2,8],["πένητα",672,7],["ᾧ",24,202],["οὐχ",12,17],["ὑπῆρχε",418,165],["βοηθός",947,5]],"For he has delivered the poor from the oppressor; and the needy who had no helper."],["13",[["Φείσεται",610,89],["πτωχοῦ",497,21],["καὶ",2,8],["πένητος",672,21],["καὶ",2,8],["ψυχὰς",63,40],["πένητων",672,77],["σώσει",172,120]],"He shall spare the poor and needy, and shall deliver the souls of the needy."],["14",[["Ἐκ",21,1],["τόκου",1839,21],["καὶ",2,8],["ἐξ",21,1],["ἀδικίας",288,40],["λυτρώσεται",535,89],["τὰς",1,39],["ψυχὰς",63,40],["αὐτῶν",3,41],["καὶ",2,8],["ἔντιμον",1339,28],["τὸ",1,27],["ὄνομα",57,20],["αὐτῶν",3,41],["ἐνώπιον",115,1],["αὐτοῦ",3,48]],"He shall redeem their souls from usury and injustice: and their name [shall be] precious before him."],["15",[["Καὶ",2,8],["ζήσεται",107,89],["καὶ",2,8],["δοθήσεται",33,125],["αὐτῷ",3,49],["ἐκ",21,1],["τοῦ",1,23],["χρυσίου",202,24],["τῆς",1,18],["Ἀραβίας",1215,19],["καὶ",2,8],["προσεύξονται",551,127],["περὶ",72,1],["αὐτοῦ",3,48],["διαπαντός",510,17],["ὅλην",235,37],["τὴν",1,9],["ἡμέραν",28,10],["εὐλογήσουσιν",149,207],["αὐτόν",3,82]],"And he shall live, and there shall be given him of the gold of Arabia: and [men] shall pray for him continually; [and] all the day shall they praise him."],["16",[["Ἔσται",10,89],["στήριγμα",2113,20],["ἐν",4,1],["τῇ",1,95],["γῇ",26,2],["ἐπʼ",9,1],["ἄκρων",723,45],["τῶν",1,44],["ὀρέων",87,45],["ὑπεραρθήσεται",3769,125],["ὑπὲρ",139,1],["τὸν",1,6],["Λίβανον",537,7],["ὁ",1,4],["καρπὸς",448,5],["αὐτοῦ",3,48],["καὶ",2,8],["ἐξανθήσουσιν",1800,207],["ἐκ",21,1],["πόλεως",41,19],["ὡσεὶ",343,17],["χόρτος",1046,5],["τῆς",1,18],["γῆς",26,19]],"There shall be an establishment on the earth on the tops of the mountains: the fruit thereof shall be exalted above Libanus, and they of the city shall flourish as grass of the earth."],["17",[["Ἔστω",10,35],["τὸ",1,32],["ὄνομα",57,33],["αὐτοῦ",3,48],["εὐλογημένον",149,482],["εἰς",8,1],["τοὺς",1,56],["αἰῶνας",100,31],["πρὸ",238,1],["τοῦ",1,30],["ἡλίου",323,21],["διαμενεῖ",1884,120],["τὸ",1,32],["ὄνομα",57,33],["αὐτοῦ",3,48],["καὶ",2,8],["εὐλογηθήσονται",149,135],["ἐν",4,1],["αὐτῷ",3,49],["πᾶσαι",11,187],["αἱ",1,185],["φυλαὶ",142,180],["τῆς",1,18],["γῆς",26,19],["πάντα",11,65],["τὰ",1,42],["ἔθνη",60,43],["μακαριοῦσιν",1681,207],["αὐτόν",3,82]],"Let his name be blessed for ever: his name shall endure longer than the sun: and all the tribes of the earth shall be blessed in him: all nations shall call him blessed."],["18",[["Εὐλογητὸς",767,16],["Κύριος",7,5],["ὁ",1,4],["Θεὸς",20,5],["τοῦ",1,30],["Ἰσραὴλ",27,105],["ὁ",1,4],["ποιῶν",23,67],["θαυμάσια",884,65],["μόνος",302,16]],"Blessed is the Lord God of Israel, who alone does wonders."],["19",[["καὶ",2,8],["εὐλογητὸν",767,28],["τὸ",1,27],["ὄνομα",57,20],["τῆς",1,18],["δόξης",141,19],["αὐτοῦ",3,48],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["καὶ",2,8],["εἰς",8,1],["αἰῶνα",100,7],["τοῦ",1,30],["αἰῶνος",100,21],["καὶ",2,8],["πληρωθήσεται",518,125],["τῆς",1,18],["δόξης",141,19],["αὐτοῦ",3,48],["πᾶσα",11,15],["ἡ",1,11],["γῆ",26,13],["γένοιτο",30,392],["γένοιτο",30,392]],"And blessed is his glorious name for ever, even for ever and ever: and all the earth shall be filled with his glory. So be it, so be it."],["20",[["Ἐξέλιπον",321,141],["οἱ",1,128],["ὕμνοι",1498,51],["Δαυὶδ",52,105],["τοῦ",1,30],["υἱοῦ",13,21],["Ἰεσσαί",1237,105]],"The hymns of David the son of Jessæ are ended."]]