[["1",[["Εἰς",8,1],["τὸ",1,32],["τέλος",373,33],["τῷ",1,110],["Ἰδιθοὺν",0,0],["ᾠδὴ",776,13],["τῷ",1,110],["Δαυίδ",52,105]],"For the end, a Song of David, to Idithun."],["2",[["Εἶπα",18,147],["φυλάξω",125,157],["τὰς",1,39],["ὁδούς",68,40],["μου",6,48],["τοῦ",1,30],["μὴ",25,8],["ἁμαρτάνειν",237,54],["ἐν",4,1],["γλώσσῃ",388,2],["μου",6,48],["ἐθέμην",110,152],["τῷ",1,52],["στόματί",123,53],["μου",6,48],["φυλακὴν",485,10],["ἐν",4,1],["τῷ",1,110],["συστῆναι",1065,100],["τὸν",1,6],["ἁμαρτωλὸν",409,59],["ἐναντίον",138,17],["μου",6,48]],"I said, I will take heed to my ways, that I sin not with my tongue: I set a guard on my mouth, while the sinner stood in my presence."],["3",[["Ἐκωφώθην",0,0],["καὶ",2,8],["ἐταπεινώθην",322,148],["καὶ",2,8],["ἐσίγησα",1915,147],["ἐξ",21,1],["ἀγαθῶν",114,79],["καὶ",2,8],["τὸ",1,32],["ἄλγημά",5263,33],["μου",6,48],["ἀνεκαινίσθη",4019,38]],"I was dumb, and humbled myself, and kept silence from good [words]; and my grief was renewed."],["4",[["Ἐθερμάνθη",2350,38],["ἡ",1,11],["καρδία",64,13],["μου",6,48],["ἐντός",3192,17],["μου",6,48],["καὶ",2,8],["ἐν",4,1],["τῇ",1,95],["μελέτῃ",2269,2],["μου",6,48],["ἐκκαυθήσεται",941,125],["πῦρ",118,33],["ἐλάλησα",50,147],["ἐν",4,1],["γλώσσῃ",388,2],["μου",6,48]],"My heart grew hot within me, and a fire would kindle in my meditation: I spoke with my tongue,"],["5",[["Γνώρισόν",748,198],["μοι",6,49],["Κύριε",7,250],["τὸ",1,32],["πέρας",876,33],["μου",6,48],["καὶ",2,8],["τὸν",1,6],["ἀριθμὸν",355,7],["τῶν",1,123],["ἡμερῶν",28,61],["μου",6,48],["τίς",39,150],["ἐστιν",10,87],["ἵνα",102,8],["γνῶ",79,227],["τί",39,119],["ὑστερῶ",1947,149],["ἐγώ",6,158]],"O Lord, make me to know mine end, and the number of my days, what it is; that I may know what I lack."],["6",[["Ἰδοὺ",51,17],["παλαιὰς",1905,109],["ἔθου",110,169],["τὰς",1,39],["ἡμέρας",28,19],["μου",6,83],["καὶ",2,8],["ὑπόστασίς",1877,13],["μου",6,48],["ὡσεὶ",343,17],["οὐθὲν",228,29],["ἐνώπιόν",115,1],["σου",5,146],["πλὴν",257,1],["τὰ",1,42],["σύμπαντα",1357,65],["ματαιότης",937,13],["πᾶς",11,16],["ἄνθρωπος",43,5],["ζῶν",107,67],["διάψαλμα",689,20]],"Behold, thou hast made my days old; and my existence [is] as nothing before thee: nay, every man living [is] altogether vanity. Pause."],["7",[["Μέντοιγε",7732,105],["ἐν",4,1],["εἰκόνι",1136,2],["διαπορεύεται",1113,108],["ἄνθρωπος",43,5],["πλὴν",257,1],["μάτην",1774,17],["ταράσσεται",508,108],["θησαυρίζει",2351,87],["καὶ",2,8],["οὐ",12,17],["γινώσκει",79,87],["τίνι",39,436],["συνάξει",166,120],["αὐτά",3,66]],"Surely man walks in a shadow; nay, he is disquieted in vain: he lays up treasures, and knows not for whom he shall gather them."],["8",[["Καὶ",2,8],["νῦν",90,17],["τίς",39,368],["ἡ",1,11],["ὑπομονή",1616,13],["μου",6,48],["οὐχὶ",330,12],["ὁ",1,4],["Κύριος",7,5],["καὶ",2,8],["ἡ",1,11],["ὑπόστασίς",1877,13],["μου",6,48],["παρὰ",73,1],["σοί",5,151],["ἐστι",10,87],["διάψαλμα",689,20]],"And now what [is] my expectation? [is it] not the Lord? and my ground [of hope] is with thee. Pause."],["9",[["Ἀπὸ",17,1],["πασῶν",11,115],["τῶν",1,123],["ἀνομιῶν",275,61],["μου",6,48],["ῥῦσαί",337,275],["με",6,82],["ὄνειδος",973,20],["ἄφρονι",439,310],["ἔδωκάς",33,154],["με",6,82]],"Deliver me from all my transgressions: thou hast made me a reproach to the foolish."],["10",[["Ἐκωφώθην",0,0],["καὶ",2,8],["οὐκ",12,17],["ἤνοιξα",362,147],["τὸ",1,32],["στόμα",123,33],["μου",6,48],["ὅτι",19,8],["σὺ",5,156],["εἶ",10,145],["ὁ",1,4],["ποιήσας",23,155],["με",6,82]],"I was dumb, and opened not my mouth; for thou art he that made me."],["11",[["Ἀπόστησον",293,198],["ἀπʼ",17,1],["ἐμοῦ",6,48],["τὰς",1,39],["μάστιγάς",1308,40],["σου",5,146],["ἀπὸ",17,1],["τῆς",1,18],["ἰσχύος",181,19],["τῆς",1,18],["χειρός",37,19],["σου",5,146],["ἐγὼ",6,158],["ἐξέλιπον",321,141]],"Remove thy scourges from me: I have fainted by reason of the strength of thine hand."],["12",[["Ἐν",4,1],["ἐλεγμοῖς",1798,139],["ὑπὲρ",139,1],["ἀνομίας",275,19],["ἐπαίδευσας",643,154],["ἄνθρωπον",43,7],["καὶ",2,8],["ἐξέτηξας",3185,154],["ὡς",36,8],["ἀράχνην",4048,10],["τὴν",1,9],["ψυχὴν",63,10],["αὐτοῦ",3,48],["πλὴν",257,1],["μάτην",1774,17],["ταράσσεται",508,108],["πᾶς",11,16],["ἄνθρωπος",43,5],["διάψαλμα",689,20]],"Thou chastenest man with rebukes for iniquity, and thou makest his life to consume away like a spider's web: nay, every man is disquieted in vain. Pause."],["13",[["Εἰσάκουσον",241,198],["τῆς",1,18],["προσευχῆς",550,19],["μου",6,83],["Κύριε",7,250],["καὶ",2,8],["τῆς",1,18],["δεήσεώς",677,19],["μου",6,83],["ἐνώτισαι",1316,334],["τῶν",1,44],["δακρύων",1268,45],["μου",6,48],["μὴ",25,8],["παρασιωπήσῃς",1908,170],["ὅτι",19,8],["πάροικος",1421,16],["ἐγώ",6,158],["εἰμι",10,149],["ἐν",4,1],["τῇ",1,95],["γῇ",26,2],["καὶ",2,8],["παρεπίδημος",5909,16],["καθὼς",221,17],["πάντες",11,130],["οἱ",1,128],["πατέρες",44,51],["μου",6,48]],"O Lord, hearken to my prayer and my supplication: attend to my tears: be not silent, for I am a sojourner in the land, and a stranger, as all my fathers [were]."],["14",[["Ἄνες",1081,198],["μοι",6,49],["ἵνα",102,8],["ἀναψύξω",4023,157],["πρὸ",238,1],["τοῦ",1,30],["με",6,82],["ἀπελθεῖν",297,100],["καὶ",2,8],["οὐκέτι",12,17],["μὴ",25,8],["ὑπάρξω",418,157]],"Spare me, that I may be refreshed, before I depart, and be no more."]]