[["1",[["Εἰς",8,1],["τὸ",1,32],["τέλος",369,33],["μὴ",25,8],["διαφθείρῃς",686,170],["τῷ",1,110],["Δαυὶδ",52,105],["εἰς",8,1],["στηλογραφίαν",3647,10],["ὁπότε",3229,17],["ἀπέστειλε",83,3],["Σαοὺλ",155,251],["καὶ",2,8],["ἐφύλαξε",127,3],["τὸν",1,6],["οἶκον",34,7],["αὐτοῦ",3,48],["τοῦ",1,30],["θανατῶσαι",386,100],["αὐτόν",3,82]],"For the end. Destroy not: by David for a memorial, when Saul sent, and watched his house to kill him."],["2",[["Ἐξελοῦ",411,275],["με",6,82],["ἐκ",21,1],["τῶν",1,76],["ἐχθρῶν",135,77],["μου",6,48],["ὁ",1,4],["Θεὸς",20,5],["καὶ",2,8],["ἐκ",21,1],["τῶν",1,76],["ἐπανισταμένων",1221,299],["ἐπʼ",9,1],["ἐμὲ",6,82],["λύτρωσαί",548,296],["με",6,82]],"Deliver me from mine enemies, O God; and ransom me from those that rise up against me."],["3",[["Ῥῦσαί",335,275],["με",6,82],["ἐκ",21,1],["τῶν",1,76],["ἐργαζομένων",468,299],["τὴν",1,9],["ἀνομίαν",274,10],["καὶ",2,8],["ἐξ",21,1],["ἀνδρῶν",38,77],["αἱμάτων",148,45],["σῶσόν",171,198],["με",6,82]],"Deliver me from the workers of iniquity, and save me from bloody men."],["4",[["Ὅτι",19,8],["ἰδοὺ",51,17],["ἐθήρευσαν",1890,141],["τὴν",1,9],["ψυχήν",62,10],["μου",6,48],["ἐπέθεντο",239,182],["ἐπʼ",9,1],["ἐμὲ",6,82],["κραταιοί",734,166],["οὔτε",476,17],["ἡ",1,11],["ἀνομία",274,13],["μου",6,48],["οὔτε",476,17],["ἡ",1,11],["ἁμαρτία",119,13],["μου",6,48],["Κύριε",7,251]],"For, behold, they have hunted after my soul; violent men have set upon me: neither [is it] my iniquity, nor my sin, O Lord."],["5",[["Ανευ",1103,105],["ἀνομίας",274,19],["ἔδραμον",818,141],["καὶ",2,8],["κατεύθυνα",828,147],["ἐξεγέρθητι",650,242],["εἰς",8,1],["συνάντησίν",426,87],["μου",6,48],["καὶ",2,8],["ἴδε",693,17]],"Without iniquity I ran and directed [my course aright]: awake to help me, and behold."],["6",[["Καὶ",2,8],["σὺ",5,156],["Κύριε",7,251],["ὁ",1,4],["Θεὸς",20,5],["τῶν",1,123],["δυνάμεων",98,61],["ὁ",1,4],["Θεὸς",20,5],["τοῦ",1,30],["Ἰσραὴλ",27,105],["πρόσχες",1692,154],["τοῦ",1,30],["ἐπισκέψασθαι",429,394],["πάντα",11,65],["τὰ",1,42],["ἔθνη",59,43],["μὴ",25,8],["οἰκτειρήσῃς",1687,170],["πάντας",11,58],["τοὺς",1,56],["ἐργαζομένους",468,230],["τὴν",1,9],["ἀνομίαν",274,10],["διάψαλμα",687,20]],"And thou, Lord God of hosts, the God of Israel, draw nigh to visit all the heathen; pity not any that work iniquity. Pause."],["7",[["Ἐπιστρέψουσιν",116,207],["εἰς",8,1],["ἑσπέραν",486,10],["καὶ",2,8],["λιμώξουσιν",5825,207],["ὡς",36,8],["κύων",1208,5],["καὶ",2,8],["κυκλώσουσιν",600,207],["πόλιν",41,10]],"They shall return at evening, and hunger like a dog, and go round about the city."],["8",[["Ἰδοὺ",51,17],["ἀποφθέγξονται",4049,127],["ἐν",4,1],["τῷ",1,52],["στόματι",123,53],["αὐτῶν",3,41],["καὶ",2,8],["ῥομφαία",247,13],["ἐν",4,1],["τοῖς",1,91],["χείλεσιν",361,92],["αὐτῶν",3,41],["ὅτι",19,8],["τίς",39,150],["ἤκουσε",53,3]],"Behold, they shall utter a voice with their mouth, and a sword is in their lips; for who, [say they], has heard?"],["9",[["Καὶ",2,8],["δὺ",2179,3],["Κύριε",7,251],["ἐκγελάσῃ",3735,116],["αὐτοὺς",3,60],["ἐξουδενώσεις",1069,159],["τάντα",0,0],["τὰ",1,42],["ἔθνη",59,43]],"But thou, Lord, wilt laugh them to scorn; thou wilt utterly set at nought all the heathen."],["10",[["Τὸ",1,32],["κράτος",1139,33],["μου",6,48],["πρὸς",15,1],["σὲ",5,161],["φυλάξω",127,157],["ὅτι",19,8],["σὺ",5,156],["ὁ",1,4],["Θεὸς",20,5],["ἀντιλήμπτωρ",0,0],["μου",6,48],["εἶ",10,145]],"I will keep my strength, [looking] to thee; for thou, O God, art my helper."],["11",[["Ὁ",1,4],["Θεός",20,5],["μου",6,48],["τὸ",1,32],["ἔλεος",182,33],["αὐτοῦ",3,48],["προφθάσει",1834,120],["με",6,82],["ὁ",1,4],["Θεός",20,5],["μου",6,48],["δείξει",871,120],["μοι",6,49],["ἐν",4,1],["τοῖς",1,138],["ἐχθροῖς",135,139],["μου",6,48]],"[As for] my God, his mercy shall go before me: my God will shew me [vengeance] on mine enemies."],["12",[["Μὴ",25,8],["ἀποκτείνῃς",298,170],["αὐτοὺς",3,60],["μήποτε",966,17],["ἐπιλάθωνται",512,222],["τοῦ",1,30],["νόμου",140,21],["σου",5,146],["διασκόρπισον",1001,198],["αὐτοὺς",3,60],["ἐν",4,1],["τῇ",1,95],["δυνάμει",98,2],["σου",5,146],["καὶ",2,8],["κατάγαγε",741,198],["αὐτοὺς",3,60],["ὁ",1,4],["ὑπερασπιστής",1876,5],["μου",6,48],["Κύριε",7,251]],"Slay them not, lest they forget thy law; scatter them by thy power; and bring them down, O Lord, my defender."],["13",[["Ἁμαρτίαν",119,10],["στόματος",123,24],["αὐτῶν",3,168],["λόγον",48,7],["χειλέων",361,45],["αὐτῶν",3,168],["καὶ",2,8],["συλληφθήτωσαν",510,50],["ἐν",4,1],["τῇ",1,95],["ὑπερηφανίᾳ",1130,2],["αὐτῶν",3,41],["καὶ",2,8],["ἐξ",21,1],["ἀρᾶς",1217,19],["καὶ",2,8],["ψεύδους",1193,24],["διαγγελήσονται",0,0]],"[For] the sin of their mouth, [and] the word of their lips, let them be even taken in their pride."],["14",[["συντέλειαι",808,179],["ἐν",4,1],["ὀργῇ",198,2],["συντελείας",808,19],["καὶ",2,8],["οὐ",12,17],["μὴ",25,8],["ὑπάρξουσι",416,207],["καὶ",2,8],["γνώσονται",81,127],["ὅτι",19,8],["ὁ",1,4],["Θεὸς",20,5],["τοῦ",1,30],["Ἰακὼβ",146,105],["δεσπόζει",2022,87],["τῶν",1,44],["περάτων",877,45],["τῆς",1,18],["γῆς",26,19],["διάψαλμα",687,20]],"And for [their] cursing and falsehood shall utter destruction be denounced: [they shall fall] by the wrath of utter destruction, and shall not be; so shall they know that the God of Jacob is Lord of the ends of the earth. Pause."],["15",[["Ἐπιστρέψουσιν",116,207],["εἰς",8,1],["ἑσπέραν",486,10],["καὶ",2,8],["λιμώξουσιν",5825,207],["ὡς",36,8],["κύων",1208,5],["καὶ",2,8],["κυκλώσουσι",600,207],["πόλιν",41,10]],"They shall return at evening, and be hungry as a dog, and go round about the city."],["16",[["Αὐτοὶ",3,193],["διασκορπισθήσονται",1001,135],["τοῦ",1,30],["φαγεῖν",268,100],["ἐὰν",45,8],["δὲ",14,12],["μὴ",25,8],["χορτασθῶσι",2405,267],["καὶ",2,8],["γογγύσουσιν",2267,207]],"They shall be scattered hither and thither for meat; and if they be not satisfied, they shall even murmur."],["17",[["Ἐγὼ",6,158],["δὲ",14,12],["ᾄσομαι",1080,176],["τῇ",1,95],["δυνάμει",98,2],["σου",5,146],["καὶ",2,8],["ἀγαλλιάσομαι",737,176],["τοπρωῒ",0,0],["τὸ",1,32],["ἔλεός",182,33],["σου",5,146],["ὅτι",19,8],["ἐγενήθης",30,363],["ἀντιλήπτωρ",2221,5],["μου",6,48],["καὶ",2,8],["καταφυγή",1681,13],["μου",6,48],["ἐν",4,1],["ἡμέρᾳ",28,2],["θλίψεώς",437,19],["μου",6,83]],"But I will sing to thy strength, and in the morning will I exult [in] thy mercy; for thou hast been my supporter, and my refuge in the day of mine affliction."],["18",[["Βοηθός",948,5],["μου",6,48],["σοὶ",5,151],["ψαλῶ",901,157],["ὁ",1,4],["Θεός",20,5],["μου",6,48],["ἀντιλήμπτωρ",0,0],["μου",6,48],["εἶ",10,145],["ὁ",1,4],["Θεός",20,5],["μου",6,48],["τὸ",1,32],["ἔλεός",182,33],["μου",6,48]],"[Thou art] my helper; to thee, my God, will I sing; thou art my supporter, O my God, [and] my mercy."]]