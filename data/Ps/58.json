[["1",[["Εἰς",8,1],["τὸ",1,32],["τέλος",373,33],["μὴ",25,8],["διαφθείρῃς",688,170],["τῷ",1,110],["Δαυὶδ",52,105],["εἰς",8,1],["στηλογραφίαν",3640,10],["ὁπότε",3224,17],["ἀπέστειλε",84,3],["Σαοὺλ",155,250],["καὶ",2,8],["ἐφύλαξε",125,3],["τὸν",1,6],["οἶκον",34,7],["αὐτοῦ",3,48],["τοῦ",1,30],["θανατῶσαι",382,100],["αὐτόν",3,82]],"For the end. Destroy not: by David for a memorial, when Saul sent, and watched his house to kill him."],["2",[["Ἐξελοῦ",413,275],["με",6,82],["ἐκ",21,1],["τῶν",1,76],["ἐχθρῶν",135,77],["μου",6,48],["ὁ",1,4],["Θεὸς",20,5],["καὶ",2,8],["ἐκ",21,1],["τῶν",1,76],["ἐπανισταμένων",1216,295],["ἐπʼ",9,1],["ἐμὲ",6,82],["λύτρωσαί",535,275],["με",6,82]],"Deliver me from mine enemies, O God; and ransom me from those that rise up against me."],["3",[["Ῥῦσαί",337,275],["με",6,82],["ἐκ",21,1],["τῶν",1,76],["ἐργαζομένων",467,295],["τὴν",1,9],["ἀνομίαν",275,10],["καὶ",2,8],["ἐξ",21,1],["ἀνδρῶν",38,77],["αἱμάτων",148,45],["σῶσόν",172,198],["με",6,82]],"Deliver me from the workers of iniquity, and save me from bloody men."],["4",[["Ὅτι",19,8],["ἰδοὺ",51,17],["ἐθήρευσαν",1887,141],["τὴν",1,9],["ψυχήν",63,10],["μου",6,48],["ἐπέθεντο",239,184],["ἐπʼ",9,1],["ἐμὲ",6,82],["κραταιοί",729,166],["οὔτε",477,17],["ἡ",1,11],["ἀνομία",275,13],["μου",6,48],["οὔτε",477,17],["ἡ",1,11],["ἁμαρτία",119,13],["μου",6,48],["Κύριε",7,250]],"For, behold, they have hunted after my soul; violent men have set upon me: neither [is it] my iniquity, nor my sin, O Lord."],["5",[["Ανευ",1101,105],["ἀνομίας",275,19],["ἔδραμον",820,141],["καὶ",2,8],["κατεύθυνα",827,147],["ἐξεγέρθητι",656,242],["εἰς",8,1],["συνάντησίν",429,87],["μου",6,48],["καὶ",2,8],["ἴδε",713,17]],"Without iniquity I ran and directed [my course aright]: awake to help me, and behold."],["6",[["Καὶ",2,8],["σὺ",5,156],["Κύριε",7,250],["ὁ",1,4],["Θεὸς",20,5],["τῶν",1,123],["δυνάμεων",98,61],["ὁ",1,4],["Θεὸς",20,5],["τοῦ",1,30],["Ἰσραὴλ",27,105],["πρόσχες",1689,154],["τοῦ",1,30],["ἐπισκέψασθαι",375,389],["πάντα",11,65],["τὰ",1,42],["ἔθνη",60,43],["μὴ",25,8],["οἰκτειρήσῃς",1309,170],["πάντας",11,58],["τοὺς",1,56],["ἐργαζομένους",467,230],["τὴν",1,9],["ἀνομίαν",275,10],["διάψαλμα",689,20]],"And thou, Lord God of hosts, the God of Israel, draw nigh to visit all the heathen; pity not any that work iniquity. Pause."],["7",[["Ἐπιστρέψουσιν",117,207],["εἰς",8,1],["ἑσπέραν",488,10],["καὶ",2,8],["λιμώξουσιν",5792,207],["ὡς",36,8],["κύων",1204,5],["καὶ",2,8],["κυκλώσουσιν",603,207],["πόλιν",41,10]],"They shall return at evening, and hunger like a dog, and go round about the city."],["8",[["Ἰδοὺ",51,17],["ἀποφθέγξονται",4041,127],["ἐν",4,1],["τῷ",1,52],["στόματι",123,53],["αὐτῶν",3,41],["καὶ",2,8],["ῥομφαία",248,13],["ἐν",4,1],["τοῖς",1,91],["χείλεσιν",361,92],["αὐτῶν",3,41],["ὅτι",19,8],["τίς",39,150],["ἤκουσε",54,3]],"Behold, they shall utter a voice with their mouth, and a sword is in their lips; for who, [say they], has heard?"],["9",[["Καὶ",2,8],["δὺ",2169,3],["Κύριε",7,250],["ἐκγελάσῃ",3727,116],["αὐτοὺς",3,60],["ἐξουδενώσεις",1068,159],["τάντα",0,0],["τὰ",1,42],["ἔθνη",60,43]],"But thou, Lord, wilt laugh them to scorn; thou wilt utterly set at nought all the heathen."],["10",[["Τὸ",1,32],["κράτος",1139,33],["μου",6,48],["πρὸς",15,1],["σὲ",5,161],["φυλάξω",125,157],["ὅτι",19,8],["σὺ",5,156],["ὁ",1,4],["Θεὸς",20,5],["ἀντιλήμπτωρ",0,0],["μου",6,48],["εἶ",10,145]],"I will keep my strength, [looking] to thee; for thou, O God, art my helper."],["11",[["Ὁ",1,4],["Θεός",20,5],["μου",6,48],["τὸ",1,32],["ἔλεος",183,33],["αὐτοῦ",3,48],["προφθάσει",1831,120],["με",6,82],["ὁ",1,4],["Θεός",20,5],["μου",6,48],["δείξει",870,120],["μοι",6,49],["ἐν",4,1],["τοῖς",1,138],["ἐχθροῖς",135,139],["μου",6,48]],"[As for] my God, his mercy shall go before me: my God will shew me [vengeance] on mine enemies."],["12",[["Μὴ",25,8],["ἀποκτείνῃς",300,170],["αὐτοὺς",3,60],["μήποτε",964,17],["ἐπιλάθωνται",513,222],["τοῦ",1,30],["νόμου",140,21],["σου",5,146],["διασκόρπισον",1001,198],["αὐτοὺς",3,60],["ἐν",4,1],["τῇ",1,95],["δυνάμει",98,2],["σου",5,146],["καὶ",2,8],["κατάγαγε",735,198],["αὐτοὺς",3,60],["ὁ",1,4],["ὑπερασπιστής",1875,5],["μου",6,48],["Κύριε",7,250]],"Slay them not, lest they forget thy law; scatter them by thy power; and bring them down, O Lord, my defender."],["13",[["Ἁμαρτίαν",119,10],["στόματος",123,24],["αὐτῶν",3,168],["λόγον",48,7],["χειλέων",361,45],["αὐτῶν",3,168],["καὶ",2,8],["συλληφθήτωσαν",507,50],["ἐν",4,1],["τῇ",1,95],["ὑπερηφανίᾳ",1131,2],["αὐτῶν",3,41],["καὶ",2,8],["ἐξ",21,1],["ἀρᾶς",1213,19],["καὶ",2,8],["ψεύδους",1392,24],["διαγγελήσονται",0,0]],"[For] the sin of their mouth, [and] the word of their lips, let them be even taken in their pride."],["14",[["συντέλειαι",810,180],["ἐν",4,1],["ὀργῇ",198,2],["συντελείας",810,19],["καὶ",2,8],["οὐ",12,17],["μὴ",25,8],["ὑπάρξουσι",418,207],["καὶ",2,8],["γνώσονται",79,127],["ὅτι",19,8],["ὁ",1,4],["Θεὸς",20,5],["τοῦ",1,30],["Ἰακὼβ",146,105],["δεσπόζει",2014,87],["τῶν",1,44],["περάτων",876,45],["τῆς",1,18],["γῆς",26,19],["διάψαλμα",689,20]],"And for [their] cursing and falsehood shall utter destruction be denounced: [they shall fall] by the wrath of utter destruction, and shall not be; so shall they know that the God of Jacob is Lord of the ends of the earth. Pause."],["15",[["Ἐπιστρέψουσιν",117,207],["εἰς",8,1],["ἑσπέραν",488,10],["καὶ",2,8],["λιμώξουσιν",5792,207],["ὡς",36,8],["κύων",1204,5],["καὶ",2,8],["κυκλώσουσι",603,207],["πόλιν",41,10]],"They shall return at evening, and be hungry as a dog, and go round about the city."],["16",[["Αὐτοὶ",3,195],["διασκορπισθήσονται",1001,135],["τοῦ",1,30],["φαγεῖν",269,100],["ἐὰν",45,8],["δὲ",14,12],["μὴ",25,8],["χορτασθῶσι",2397,266],["καὶ",2,8],["γογγύσουσιν",2252,207]],"They shall be scattered hither and thither for meat; and if they be not satisfied, they shall even murmur."],["17",[["Ἐγὼ",6,158],["δὲ",14,12],["ᾄσομαι",856,177],["τῇ",1,95],["δυνάμει",98,2],["σου",5,146],["καὶ",2,8],["ἀγαλλιάσομαι",738,177],["τοπρωῒ",0,0],["τὸ",1,32],["ἔλεός",183,33],["σου",5,146],["ὅτι",19,8],["ἐγενήθης",30,360],["ἀντιλήπτωρ",2209,5],["μου",6,48],["καὶ",2,8],["καταφυγή",1678,13],["μου",6,48],["ἐν",4,1],["ἡμέρᾳ",28,2],["θλίψεώς",438,19],["μου",6,83]],"But I will sing to thy strength, and in the morning will I exult [in] thy mercy; for thou hast been my supporter, and my refuge in the day of mine affliction."],["18",[["Βοηθός",947,5],["μου",6,48],["σοὶ",5,151],["ψαλῶ",913,157],["ὁ",1,4],["Θεός",20,5],["μου",6,48],["ἀντιλήμπτωρ",0,0],["μου",6,48],["εἶ",10,145],["ὁ",1,4],["Θεός",20,5],["μου",6,48],["τὸ",1,32],["ἔλεός",183,33],["μου",6,48]],"[Thou art] my helper; to thee, my God, will I sing; thou art my supporter, O my God, [and] my mercy."]]