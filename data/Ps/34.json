[["1",[["Τῷ",1,110],["Δαυίδ",52,105],["Δικάσον",1621,548],["Κύριε",7,250],["τοὺς",1,56],["ἀδικοῦντάς",760,229],["με",6,82],["πολέμησον",305,198],["τοὺς",1,56],["πολεμοῦντάς",305,229],["με",6,82]],"[A Psalm] of David. Judge thou, O Lord, them that injure me, fight against them that fight against me."],["2",[["Ἐπιλαβοῦ",1086,275],["ὅπλου",764,24],["καὶ",2,8],["θυρεοῦ",1723,21],["καὶ",2,8],["ἀνάστηθι",121,198],["εἰς",8,1],["βοήθειάν",765,10],["μοι",6,49]],"Take hold of shield and buckler, and arise for my help."],["3",[["Ἔκχεον",436,198],["ῥομφαίαν",248,10],["καὶ",2,8],["σύγκλεισον",1147,198],["ἐξεναντίας",1104,217],["τῶν",1,76],["καταδιωκόντων",621,164],["με",6,82],["εἰπὸν",18,267],["τῇ",1,95],["ψυχῇ",63,2],["μου",6,48],["σωτηρία",425,13],["σου",5,146],["ἐγώ",6,179],["εἰμι",10,149]],"Bring forth a sword, and stop [the way] against them that persecute me: say to my soul, I am thy salvation."],["4",[["Αἰσχυνθείησαν",611,403],["καὶ",2,8],["ἐντραπείησαν",1105,403],["οἱ",1,128],["ζητοῦντες",191,137],["τὴν",1,9],["ψυχήν",63,10],["μου",6,48],["ἀποστραφείησαν",130,403],["εἰς",8,1],["τὰ",1,42],["ὀπίσω",167,17],["καὶ",2,8],["καταισχυνθείησαν",696,403],["οἱ",1,128],["λογιζόμενοί",495,351],["μοι",6,49],["κακά",161,65]],"Let them that seek my soul be ashamed and confounded: let them that devise evils against me be turned back and put to shame."],["5",[["Γενηθήτωσαν",30,50],["ὡσεὶ",343,17],["χοῦς",1098,5],["κατὰ",32,1],["πρόσωπον",47,33],["ἀνέμου",850,21],["καὶ",2,8],["ἄγγελος",208,5],["Κυρίου",7,21],["ἐκθλίβων",1930,67],["αὐτούς",3,60]],"Let them be as dust before the wind, and an angel of the Lord afflicting them."],["6",[["Γενηθήτω",30,25],["ἡ",1,11],["ὁδὸς",68,13],["αὐτῶν",3,41],["σκότος",506,5],["καὶ",2,8],["ὀλίσθημα",3021,20],["καὶ",2,8],["ἄγγελος",208,5],["Κυρίου",7,21],["καταδιώκων",621,67],["αὐτούς",3,60]],"Let their way be dark and slippery, and an angel of the Lord persecuting them."],["7",[["Ὅτι",19,8],["δωρεὰν",1341,10],["ἔκρυψάν",372,141],["μοι",6,49],["διαφθορὰν",1671,10],["παγίδος",817,19],["αὐτῶν",3,41],["μάτην",1774,17],["ὠνείδισαν",945,141],["τὴν",1,9],["ψυχήν",63,10],["μου",6,48]],"For without cause they have hid for me their destructive snare: without a cause they have reproached my soul."],["8",[["Ἐλθέτω",55,46],["αὐτοῖς",3,142],["παγὶς",817,13],["ἣν",24,124],["οὐ",12,17],["γινώσκουσι",79,191],["καὶ",2,8],["ἡ",1,11],["θήρα",1510,13],["ἣν",24,124],["ἔκρυψαν",372,141],["συλλαβέτω",507,46],["αὐτοὺς",3,60],["καὶ",2,8],["ἐν",4,1],["τῇ",1,95],["παγίδι",817,2],["πεσοῦνται",154,127],["ἐν",4,1],["αὐτῇ",3,99]],"Let a snare which they know not come upon them: and the gin which they hid take them; and let them fall into the very same snare."],["9",[["Ἡ",1,11],["δὲ",14,12],["ψυχή",63,13],["μου",6,48],["ἀγαλλιάσεται",738,89],["ἐπὶ",9,1],["τῷ",1,110],["Κυρίῳ",7,113],["τερφθήσεται",1601,125],["ἐπὶ",9,1],["τῷ",1,110],["σωτηρίῳ",1788,111],["αὐτοῦ",3,48]],"But my soul shall exult in the Lord: it shall delight in his salvation."],["10",[["Πάντα",11,65],["τὰ",1,42],["ὀστᾶ",473,43],["μου",6,48],["ἐροῦσι",165,207],["Κύριε",7,250],["τίς",39,150],["ὅμοιός",657,16],["σοι",5,151],["ῥυόμενος",337,114],["πτωχὸν",497,7],["ἐκ",21,1],["χειρὸς",37,19],["στερεωτέρων",2289,115],["αὐτοῦ",3,48],["καὶ",2,8],["πτωχὸν",497,7],["καὶ",2,8],["πένητα",672,7],["ἀπὸ",17,1],["τῶν",1,76],["διαρπαζόντων",1160,164],["αὐτόν",3,82]],"All my bones shall say, O Lord, who is like to thee? delivering the poor out of the hand of them that are stronger than he, yea, the poor and needy one from them that spoil him."],["11",[["Ἀναστάντες",121,190],["μάρτυρες",875,51],["ἄδικοι",406,130],["ἃ",1,11],["οὐκ",12,17],["ἐγίνωσκον",79,129],["ἐπηρώτων",739,129],["με",6,82]],"Unjust witnesses arose, and asked me of things I knew not."],["12",[["Ἀνταπεδίδοσάν",666,129],["μοι",6,49],["πονηρὰ",164,15],["ἀντὶ",158,1],["καλῶν",266,79],["καὶ",2,8],["ἀτεκνίαν",4545,10],["τῇ",1,95],["ψυχῇ",63,2],["μου",6,48]],"They rewarded me evil for good, and bereavement to my soul."],["13",[["Ἐγὼ",6,158],["δὲ",14,12],["ἐν",4,1],["τῷ",1,110],["αὐτοὺς",3,60],["παρενοχλεῖν",3105,54],["μοι",6,49],["ἐνεδυόμην",516,374],["σάκκον",847,7],["καὶ",2,8],["ἐταπείνουν",322,129],["ἐν",4,1],["νηστείᾳ",1415,2],["τὴν",1,9],["ψυχήν",63,10],["μου",6,48],["καὶ",2,8],["ἡ",1,11],["προσευχή",550,13],["μου",6,48],["εἰς",8,1],["κόλπον",1140,7],["μου",6,48],["ἀποστραφήσεται",130,125]],"But I, when they troubled me, put on sackcloth, and humbled my soul with fasting: and my prayer shall return to my [own] bosom."],["14",[["Ὡς",36,8],["πλησίον",292,17],["ὡς",36,8],["ἀδελφὸν",67,7],["ἡμέτερον",1712,7],["οὕτως",71,17],["εὐηρέστουν",0,0],["ὡς",36,8],["πενθῶν",736,67],["καὶ",2,8],["σκυθρωπάξων",3352,357],["οὕτως",71,17],["ἐταπεινούμην",322,374]],"I behaved agreeably towards them as [if it had been] our neighbour [or] brother: I humbled myself as one mourning and sad of countenance."],["15",[["Καὶ",2,8],["κατʼ",32,1],["ἐμοῦ",6,48],["εὐφράνθησαν",244,94],["καὶ",2,8],["συνήχθησαν",166,94],["συνήχθησαν",166,94],["ἐπʼ",9,1],["ἐμὲ",6,82],["μάστιγες",1308,180],["καὶ",2,8],["οὐκ",12,17],["ἔγνων",79,147],["διεσχίσθησαν",5566,94],["καὶ",2,8],["οὐ",12,17],["κατενύγησαν",5698,94]],"Yet they rejoiced against me, and plagues were plentifully brought against me, and I knew [it] not: they were scattered, but repented not."],["16",[["Ἐπείρασάν",1094,141],["με",6,82],["ἐξεμυκτήρισάν",5291,141],["με",6,82],["μυκτηρισμὸν",3302,7],["ἔβρυξαν",3793,141],["ἐπʼ",9,1],["ἐμὲ",6,82],["τοὺς",1,56],["ὀδόντας",930,31],["αὐτῶν",3,41]],"They tempted me, they sneered at me most contemptuously, they gnashed their teeth upon me."],["17",[["Κύριε",7,250],["πότε",458,12],["ἐπόψῃ",2677,0],["ἀποκατάστησον",1149,198],["τὴν",1,9],["ψυχήν",63,10],["μου",6,83],["ἀπὸ",17,1],["τῆς",1,18],["κακουργίας",4810,19],["αὐτῶν",3,41],["ἀπὸ",17,1],["λεόντων",424,77],["τὴν",1,9],["μονογενῆ",3301,37],["μου",6,48]],"O Lord, when wilt thou look upon me? Deliver my soul from their mischief, mine only-begotten one from the lions."],["18",[["Ἐξομολογήσομαί",479,177],["σοι",5,151],["καὶ",2,8],["ἐν",4,1],["ἐκκλησίᾳ",563,2],["πολλῇ",74,96],["ἐν",4,1],["λαῷ",35,113],["βαρεῖ",1031,111],["αἰνέσω",402,157],["σε",5,161]],"I will give thanks to thee even in a great congregation: in an abundant people I will praise thee."],["19",[["Μὴ",25,8],["ἐπιχαρείησάν",1938,403],["μοι",6,49],["οἱ",1,128],["ἐχθραίνοντές",2678,137],["μοι",6,49],["ματαίως",654,17],["οἱ",1,128],["μισοῦντές",351,137],["με",6,98],["δωρεὰν",1341,10],["καὶ",2,8],["διανεύοντες",5555,137],["ὀφθαλμοῖς",91,139]],"Let not them that are mine enemies without a cause rejoice against me; who hate me for nothing, and wink with their eyes."],["20",[["Ὅτι",19,8],["ἐμοὶ",6,49],["μὲν",281,12],["εἰρηνικὰ",935,74],["ἐλάλουν",50,129],["καὶ",2,8],["ἐπʼ",9,1],["ὀργῇ",198,2],["δόλους",919,31],["διελογίζοντο",2573,131]],"For to me they spoke peaceably, but imagined deceits in [their] anger."],["21",[["Καὶ",2,8],["ἐπλάτυναν",1779,141],["ἐπʼ",9,1],["ἐμὲ",6,82],["τὸ",1,32],["στόμα",123,33],["αὐτῶν",3,41],["εἶπαν",18,141],["εὖγε",2259,17],["εὖγε",2259,17],["εἶδον",53,147],["οἱ",1,128],["ὀφθαλμοὶ",91,51],["ἡμῶν",6,41]],"And they opened wide their mouth upon me; they said, Aha, aha, our eyes have seen [it]."],["22",[["Εἶδες",53,154],["Κύριε",7,250],["μὴ",25,8],["παρασιωπήσῃς",1908,170],["Κύριε",7,250],["μὴ",25,8],["ἀποστῇς",293,170],["ἀπʼ",17,1],["ἐμοῦ",6,48]],"Thou hast seen [it], O Lord: keep not silence: O Lord, withdraw not [thyself] from me."],["23",[["Ἐξεγέρθητι",656,242],["Κύριε",7,250],["καὶ",2,8],["πρόσχες",1689,154],["τῇ",1,95],["κρίσει",229,2],["μου",6,48],["ὁ",1,4],["Θεός",20,5],["μου",6,48],["καὶ",2,8],["ὁ",1,4],["Κύριός",7,5],["μου",6,48],["εἰς",8,1],["τὴν",1,9],["δίκην",1219,10],["μου",6,48]],"Awake, O Lord, and attend to my judgment, [even] to my cause, my God and my Lord."],["24",[["Κρῖνόν",263,568],["με",6,82],["Κύριε",7,250],["κατὰ",32,1],["τὴν",1,9],["δικαιοσύνην",187,10],["σου",5,146],["Κύριε",7,250],["ὁ",1,4],["Θεός",20,5],["μου",6,48],["καὶ",2,8],["μὴ",25,8],["ἐπιχαρείησάν",1938,403],["μοι",6,49]],"Judge me, O Lord, according to thy righteousness, O Lord my God; and let them not rejoice against me."],["25",[["Μὴ",25,8],["εἴποισαν",18,405],["ἐν",4,1],["καρδίαις",64,71],["αὐτῶν",3,41],["εὖγε",2259,17],["εὖγε",2259,17],["τῇ",1,95],["ψυχῇ",63,2],["ἡμῶν",6,41],["μηδὲ",414,12],["εἴποιεν",18,652],["κατεπίομεν",1183,285],["αὐτόν",3,82]],"Let them not say in their hearts, Aha, aha, [it is pleasing] to our soul: neither let them say, We have devoured him."],["26",[["Αἰσχυνθείησαν",611,403],["καὶ",2,8],["ἐντραπείησαν",1105,403],["ἅμα",502,17],["οἱ",1,128],["ἐπιχαίροντες",1938,137],["τοῖς",1,138],["κακοῖς",161,215],["μου",6,48],["ἐνδυσάσθωσαν",516,533],["αἰσχύνην",685,10],["καὶ",2,8],["ἐντροπὴν",3435,10],["οἱ",1,128],["μεγαλοῤῥημονοῦντες",3586,137],["ἐπʼ",9,1],["ἐμέ",6,82]],"Let them be confounded and ashamed together that rejoice at my afflictions: let them be clothed with shame and confusion that speak great swelling words against me."],["27",[["Ἀγαλλιάσαιντο",738,545],["καὶ",2,8],["εὐφρανθείησαν",244,403],["οἱ",1,128],["θέλοντες",612,137],["τὴν",1,9],["δικαιοσύνην",187,10],["μου",6,48],["καὶ",2,8],["εἰπάτωσαν",18,261],["διαπαντὸς",510,17],["μεγαλυνθείη",604,544],["ὁ",1,4],["Κύριος",7,5],["οἱ",1,128],["θέλοντες",612,137],["τὴν",1,9],["εἰρήνην",213,10],["τοῦ",1,30],["δούλου",136,21],["αὐτοῦ",3,48]],"Let them that rejoice in my righteousness exult and be glad: and let them say continually, The Lord be magnified, who desire the peace of his servant."],["28",[["Καὶ",2,8],["ἡ",1,11],["γλῶσσά",388,13],["μου",6,48],["μελετήσει",1347,120],["τὴν",1,9],["δικαιοσύνην",187,10],["σου",5,146],["ὅλην",235,37],["τὴν",1,9],["ἡμέραν",28,10],["τὸν",1,6],["ἔπαινόν",2840,7],["σου",5,146]],"And my tongue shall meditate on thy righteousness, [and] on thy praise all the day."]]