[["1",[["Τῷ",1,110],["Δαυίδ",52,105],["Δικάσον",1620,559],["Κύριε",7,251],["τοὺς",1,56],["ἀδικοῦντάς",819,229],["με",6,82],["πολέμησον",304,243],["τοὺς",1,56],["πολεμοῦντάς",304,229],["με",6,82]],"[A Psalm] of David. Judge thou, O Lord, them that injure me, fight against them that fight against me."],["2",[["Ἐπιλαβοῦ",1087,275],["ὅπλου",760,24],["καὶ",2,8],["θυρεοῦ",1724,21],["καὶ",2,8],["ἀνάστηθι",121,198],["εἰς",8,1],["βοήθειάν",761,10],["μοι",6,49]],"Take hold of shield and buckler, and arise for my help."],["3",[["Ἔκχεον",435,198],["ῥομφαίαν",247,10],["καὶ",2,8],["σύγκλεισον",1147,198],["ἐξεναντίας",1107,216],["τῶν",1,76],["καταδιωκόντων",619,164],["με",6,82],["εἰπὸν",18,221],["τῇ",1,95],["ψυχῇ",62,2],["μου",6,48],["σωτηρία",422,13],["σου",5,146],["ἐγώ",6,178],["εἰμι",10,149]],"Bring forth a sword, and stop [the way] against them that persecute me: say to my soul, I am thy salvation."],["4",[["Αἰσχυνθείησαν",614,410],["καὶ",2,8],["ἐντραπείησαν",1153,410],["οἱ",1,128],["ζητοῦντες",190,137],["τὴν",1,9],["ψυχήν",62,10],["μου",6,48],["ἀποστραφείησαν",130,410],["εἰς",8,1],["τὰ",1,42],["ὀπίσω",166,17],["καὶ",2,8],["καταισχυνθείησαν",716,410],["οἱ",1,128],["λογιζόμενοί",494,356],["μοι",6,49],["κακά",161,65]],"Let them that seek my soul be ashamed and confounded: let them that devise evils against me be turned back and put to shame."],["5",[["Γενηθήτωσαν",30,50],["ὡσεὶ",342,17],["χοῦς",1101,5],["κατὰ",32,1],["πρόσωπον",47,33],["ἀνέμου",852,21],["καὶ",2,8],["ἄγγελος",206,5],["Κυρίου",7,21],["ἐκθλίβων",1931,67],["αὐτούς",3,60]],"Let them be as dust before the wind, and an angel of the Lord afflicting them."],["6",[["Γενηθήτω",30,25],["ἡ",1,11],["ὁδὸς",67,13],["αὐτῶν",3,41],["σκότος",503,5],["καὶ",2,8],["ὀλίσθημα",3033,20],["καὶ",2,8],["ἄγγελος",206,5],["Κυρίου",7,21],["καταδιώκων",619,67],["αὐτούς",3,60]],"Let their way be dark and slippery, and an angel of the Lord persecuting them."],["7",[["Ὅτι",19,8],["δωρεὰν",1338,10],["ἔκρυψάν",378,141],["μοι",6,49],["διαφθορὰν",1672,10],["παγίδος",815,19],["αὐτῶν",3,41],["μάτην",1774,17],["ὠνείδισαν",946,141],["τὴν",1,9],["ψυχήν",62,10],["μου",6,48]],"For without cause they have hid for me their destructive snare: without a cause they have reproached my soul."],["8",[["Ἐλθέτω",56,46],["αὐτοῖς",3,142],["παγὶς",815,13],["ἣν",24,124],["οὐ",12,17],["γινώσκουσι",81,189],["καὶ",2,8],["ἡ",1,11],["θήρα",1509,13],["ἣν",24,124],["ἔκρυψαν",378,141],["συλλαβέτω",510,46],["αὐτοὺς",3,60],["καὶ",2,8],["ἐν",4,1],["τῇ",1,95],["παγίδι",815,2],["πεσοῦνται",154,127],["ἐν",4,1],["αὐτῇ",3,99]],"Let a snare which they know not come upon them: and the gin which they hid take them; and let them fall into the very same snare."],["9",[["Ἡ",1,11],["δὲ",14,12],["ψυχή",62,13],["μου",6,48],["ἀγαλλιάσεται",737,89],["ἐπὶ",9,1],["τῷ",1,110],["Κυρίῳ",7,113],["τερφθήσεται",1602,125],["ἐπὶ",9,1],["τῷ",1,110],["σωτηρίῳ",1787,111],["αὐτοῦ",3,48]],"But my soul shall exult in the Lord: it shall delight in his salvation."],["10",[["Πάντα",11,65],["τὰ",1,42],["ὀστᾶ",472,43],["μου",6,48],["ἐροῦσι",191,189],["Κύριε",7,251],["τίς",39,150],["ὅμοιός",651,16],["σοι",5,151],["ῥυόμενος",335,114],["πτωχὸν",496,7],["ἐκ",21,1],["χειρὸς",37,19],["στερεωτέρων",2301,115],["αὐτοῦ",3,48],["καὶ",2,8],["πτωχὸν",496,7],["καὶ",2,8],["πένητα",668,7],["ἀπὸ",17,1],["τῶν",1,76],["διαρπαζόντων",1181,164],["αὐτόν",3,82]],"All my bones shall say, O Lord, who is like to thee? delivering the poor out of the hand of them that are stronger than he, yea, the poor and needy one from them that spoil him."],["11",[["Ἀναστάντες",121,188],["μάρτυρες",876,51],["ἄδικοι",402,130],["ἃ",1,11],["οὐκ",12,17],["ἐγίνωσκον",81,129],["ἐπηρώτων",738,129],["με",6,82]],"Unjust witnesses arose, and asked me of things I knew not."],["12",[["Ἀνταπεδίδοσάν",661,129],["μοι",6,49],["πονηρὰ",164,15],["ἀντὶ",158,1],["καλῶν",264,79],["καὶ",2,8],["ἀτεκνίαν",4569,10],["τῇ",1,95],["ψυχῇ",62,2],["μου",6,48]],"They rewarded me evil for good, and bereavement to my soul."],["13",[["Ἐγὼ",6,158],["δὲ",14,12],["ἐν",4,1],["τῷ",1,110],["αὐτοὺς",3,60],["παρενοχλεῖν",3114,54],["μοι",6,49],["ἐνεδυόμην",515,380],["σάκκον",848,7],["καὶ",2,8],["ἐταπείνουν",333,129],["ἐν",4,1],["νηστείᾳ",1416,2],["τὴν",1,9],["ψυχήν",62,10],["μου",6,48],["καὶ",2,8],["ἡ",1,11],["προσευχή",549,13],["μου",6,48],["εἰς",8,1],["κόλπον",1140,7],["μου",6,48],["ἀποστραφήσεται",130,125]],"But I, when they troubled me, put on sackcloth, and humbled my soul with fasting: and my prayer shall return to my [own] bosom."],["14",[["Ὡς",36,8],["πλησίον",292,17],["ὡς",36,8],["ἀδελφὸν",66,7],["ἡμέτερον",1713,7],["οὕτως",70,17],["εὐηρέστουν",0,0],["ὡς",36,8],["πενθῶν",735,67],["καὶ",2,8],["σκυθρωπάξων",3355,286],["οὕτως",70,17],["ἐταπεινούμην",333,380]],"I behaved agreeably towards them as [if it had been] our neighbour [or] brother: I humbled myself as one mourning and sad of countenance."],["15",[["Καὶ",2,8],["κατʼ",32,1],["ἐμοῦ",6,48],["εὐφράνθησαν",242,94],["καὶ",2,8],["συνήχθησαν",165,94],["συνήχθησαν",165,94],["ἐπʼ",9,1],["ἐμὲ",6,82],["μάστιγες",1308,179],["καὶ",2,8],["οὐκ",12,17],["ἔγνων",81,147],["διεσχίσθησαν",5595,94],["καὶ",2,8],["οὐ",12,17],["κατενύγησαν",5731,94]],"Yet they rejoiced against me, and plagues were plentifully brought against me, and I knew [it] not: they were scattered, but repented not."],["16",[["Ἐπείρασάν",1096,141],["με",6,82],["ἐξεμυκτήρισάν",5323,141],["με",6,82],["μυκτηρισμὸν",3307,7],["ἔβρυξαν",3806,141],["ἐπʼ",9,1],["ἐμὲ",6,82],["τοὺς",1,56],["ὀδόντας",929,31],["αὐτῶν",3,41]],"They tempted me, they sneered at me most contemptuously, they gnashed their teeth upon me."],["17",[["Κύριε",7,251],["πότε",455,12],["ἐπόψῃ",3759,116],["ἀποκατάστησον",1150,198],["τὴν",1,9],["ψυχήν",62,10],["μου",6,83],["ἀπὸ",17,1],["τῆς",1,18],["κακουργίας",4838,19],["αὐτῶν",3,41],["ἀπὸ",17,1],["λεόντων",421,77],["τὴν",1,9],["μονογενῆ",3306,37],["μου",6,48]],"O Lord, when wilt thou look upon me? Deliver my soul from their mischief, mine only-begotten one from the lions."],["18",[["Ἐξομολογήσομαί",478,176],["σοι",5,151],["καὶ",2,8],["ἐν",4,1],["ἐκκλησίᾳ",562,2],["πολλῇ",74,96],["ἐν",4,1],["λαῷ",35,113],["βαρεῖ",1028,111],["αἰνέσω",399,157],["σε",5,161]],"I will give thanks to thee even in a great congregation: in an abundant people I will praise thee."],["19",[["Μὴ",25,8],["ἐπιχαρείησάν",1939,410],["μοι",6,49],["οἱ",1,128],["ἐχθραίνοντές",2682,137],["μοι",6,49],["ματαίως",648,17],["οἱ",1,128],["μισοῦντές",355,137],["με",6,98],["δωρεὰν",1338,10],["καὶ",2,8],["διανεύοντες",5586,137],["ὀφθαλμοῖς",91,139]],"Let not them that are mine enemies without a cause rejoice against me; who hate me for nothing, and wink with their eyes."],["20",[["Ὅτι",19,8],["ἐμοὶ",6,49],["μὲν",281,12],["εἰρηνικὰ",934,74],["ἐλάλουν",50,129],["καὶ",2,8],["ἐπʼ",9,1],["ὀργῇ",198,2],["δόλους",920,31],["διελογίζοντο",2577,131]],"For to me they spoke peaceably, but imagined deceits in [their] anger."],["21",[["Καὶ",2,8],["ἐπλάτυναν",1779,141],["ἐπʼ",9,1],["ἐμὲ",6,82],["τὸ",1,32],["στόμα",123,33],["αὐτῶν",3,41],["εἶπαν",18,535],["εὖγε",2274,17],["εὖγε",2274,17],["εἶδον",73,147],["οἱ",1,128],["ὀφθαλμοὶ",91,51],["ἡμῶν",6,41]],"And they opened wide their mouth upon me; they said, Aha, aha, our eyes have seen [it]."],["22",[["Εἶδες",73,154],["Κύριε",7,251],["μὴ",25,8],["παρασιωπήσῃς",1907,170],["Κύριε",7,251],["μὴ",25,8],["ἀποστῇς",2055,159],["ἀπʼ",17,1],["ἐμοῦ",6,48]],"Thou hast seen [it], O Lord: keep not silence: O Lord, withdraw not [thyself] from me."],["23",[["Ἐξεγέρθητι",650,242],["Κύριε",7,251],["καὶ",2,8],["πρόσχες",1692,154],["τῇ",1,95],["κρίσει",226,2],["μου",6,48],["ὁ",1,4],["Θεός",20,5],["μου",6,48],["καὶ",2,8],["ὁ",1,4],["Κύριός",7,5],["μου",6,48],["εἰς",8,1],["τὴν",1,9],["δίκην",1224,10],["μου",6,48]],"Awake, O Lord, and attend to my judgment, [even] to my cause, my God and my Lord."],["24",[["Κρῖνόν",240,583],["με",6,82],["Κύριε",7,251],["κατὰ",32,1],["τὴν",1,9],["δικαιοσύνην",185,10],["σου",5,146],["Κύριε",7,251],["ὁ",1,4],["Θεός",20,5],["μου",6,48],["καὶ",2,8],["μὴ",25,8],["ἐπιχαρείησάν",1939,410],["μοι",6,49]],"Judge me, O Lord, according to thy righteousness, O Lord my God; and let them not rejoice against me."],["25",[["Μὴ",25,8],["εἴποισαν",18,412],["ἐν",4,1],["καρδίαις",63,71],["αὐτῶν",3,41],["εὖγε",2274,17],["εὖγε",2274,17],["τῇ",1,95],["ψυχῇ",62,2],["ἡμῶν",6,41],["μηδὲ",412,12],["εἴποιεν",18,674],["κατεπίομεν",1183,288],["αὐτόν",3,82]],"Let them not say in their hearts, Aha, aha, [it is pleasing] to our soul: neither let them say, We have devoured him."],["26",[["Αἰσχυνθείησαν",614,410],["καὶ",2,8],["ἐντραπείησαν",1153,410],["ἅμα",499,17],["οἱ",1,128],["ἐπιχαίροντες",1939,137],["τοῖς",1,138],["κακοῖς",161,215],["μου",6,48],["ἐνδυσάσθωσαν",515,541],["αἰσχύνην",683,10],["καὶ",2,8],["ἐντροπὴν",3439,10],["οἱ",1,128],["μεγαλοῤῥημονοῦντες",3593,137],["ἐπʼ",9,1],["ἐμέ",6,82]],"Let them be confounded and ashamed together that rejoice at my afflictions: let them be clothed with shame and confusion that speak great swelling words against me."],["27",[["Ἀγαλλιάσαιντο",737,556],["καὶ",2,8],["εὐφρανθείησαν",242,410],["οἱ",1,128],["θέλοντες",609,137],["τὴν",1,9],["δικαιοσύνην",185,10],["μου",6,48],["καὶ",2,8],["εἰπάτωσαν",18,261],["διαπαντὸς",506,17],["μεγαλυνθείη",606,555],["ὁ",1,4],["Κύριος",7,5],["οἱ",1,128],["θέλοντες",609,137],["τὴν",1,9],["εἰρήνην",210,10],["τοῦ",1,30],["δούλου",136,21],["αὐτοῦ",3,48]],"Let them that rejoice in my righteousness exult and be glad: and let them say continually, The Lord be magnified, who desire the peace of his servant."],["28",[["Καὶ",2,8],["ἡ",1,11],["γλῶσσά",385,13],["μου",6,48],["μελετήσει",1344,120],["τὴν",1,9],["δικαιοσύνην",185,10],["σου",5,146],["ὅλην",233,37],["τὴν",1,9],["ἡμέραν",28,10],["τὸν",1,6],["ἔπαινόν",2854,7],["σου",5,146]],"And my tongue shall meditate on thy righteousness, [and] on thy praise all the day."]]