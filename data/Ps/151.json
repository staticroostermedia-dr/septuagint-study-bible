[["1",[["Οὗτος",16,112],["ὁ",1,4],["ψαλμὸς",644,5],["ἰδιόγραφος",9737,16],["εἰς",8,1],["Δαυὶδ",52,105],["καὶ",2,8],["ἔξωθεν",1050,17],["τοῦ",1,30],["ἀριθμοῦ",355,21],["ὅτε",432,8],["ἐμονομάχησε",5841,3],["τῷ",1,110],["Γολιάδ",0,0],["Μικρὸς",367,16],["ἤμην",10,429],["ἐν",4,1],["τοῖς",1,138],["ἀδελφοίς",67,139],["μου",6,48],["καὶ",2,8],["νεώτερος",515,16],["ἐν",4,1],["τῷ",1,110],["οἴκῳ",34,113],["τοῦ",1,30],["πατρός",44,21],["μου",6,48],["ἐποίμαινον",953,129],["τὰ",1,42],["πρόβατα",194,43],["τοῦ",1,30],["πατρός",44,21],["μου",6,48]],"This Psalm is a genuine one of David, though supernumerary, [composed] when he fought in single combat with Goliad. I was small among my brethren, and youngest in my father's house: I tended my father's sheep."],["2",[["Αἱ",1,185],["χεῖρές",37,180],["μου",6,48],["ἐποίησαν",23,141],["ὄργανον",1578,20],["καὶ",2,8],["οἱ",1,128],["δάκτυλοί",1182,51],["μου",6,48],["ἥρμοσαν",2989,141],["ψαλτήριον",1693,20]],"My hands formed a musical instrument, and my fingers tuned a psaltery."],["3",[["Καὶ",2,8],["τίς",39,150],["ἀναγγελεῖ",231,120],["τῷ",1,110],["Κυρίῳ",7,113],["μου",6,48],["αὐτὸς",3,158],["Κύριος",7,5],["αὐτὸς",3,158],["εἰσακούει",241,87]],"And who shall tell my Lord? the Lord himself, he himself hears."],["4",[["Αὐτὸς",3,158],["ἐξαπέστειλεν",220,3],["τὸν",1,6],["ἄγγελον",208,7],["αὐτοῦ",3,48],["καὶ",2,8],["ᾖρέ",206,14],["με",6,82],["ἐκ",21,1],["τῶν",1,44],["προβάτων",194,45],["τοῦ",1,30],["πατρός",44,21],["μου",6,48],["καὶ",2,8],["ἔχρισέ",712,3],["με",6,82],["ἐν",4,1],["τῷ",1,52],["ἐλαίῳ",313,53],["τῆς",1,18],["χρίσεως",2130,19],["αὐτοῦ",3,48]],"He sent forth his angel, and took me from my father's sheep, and he anointed me with the oil of his anointing."],["5",[["Οἱ",1,128],["ἀδελφοί",67,51],["μου",6,48],["καλοὶ",266,130],["καὶ",2,8],["μεγάλοι",66,130],["καὶ",2,8],["οὐκ",12,17],["εὐδόκησεν",906,3],["ἐν",4,1],["αὐτοῖς",3,142],["Κύριος",7,5]],"My brothers were handsome and tall; but the Lord did not take pleasure in them."],["6",[["Ἐξῆλθον",82,141],["εἰς",8,1],["συνάντησιν",429,87],["τῷ",1,110],["ἀλλοφύλῳ",203,111],["καὶ",2,8],["ἐπικατηράσατό",2675,26],["με",6,82],["ἐν",4,1],["τοῖς",1,91],["εἰδώλοις",627,92],["αὐτοῦ",3,48]],"I went forth to meet the Philistine; and he cursed me by his idols."],["7",[["Ἐγὼ",6,158],["δὲ",14,12],["σπασάμενος",1691,244],["τὴν",1,9],["παρʼ",73,1],["αὐτοῦ",3,48],["μάχαιραν",342,10],["ἀπεκεφάλισα",9007,147],["αὐτόν",3,82],["καὶ",2,8],["ᾖρα",206,147],["ὄνειδος",973,20],["ἐξ",21,1],["υἱῶν",13,77],["Ἰσραήλ",27,105]],"But I drew his own sword, and beheaded him, and removed reproach from the children of Israel."]]