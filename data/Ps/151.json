[["1",[["Οὗτος",16,112],["ὁ",1,4],["ψαλμὸς",639,5],["ἰδιόγραφος",9814,16],["εἰς",8,1],["Δαυὶδ",52,105],["καὶ",2,8],["ἔξωθεν",1050,17],["τοῦ",1,30],["ἀριθμοῦ",353,21],["ὅτε",430,8],["ἐμονομάχησε",5869,3],["τῷ",1,110],["Γολιάδ",0,0],["Μικρὸς",365,16],["ἤμην",10,435],["ἐν",4,1],["τοῖς",1,138],["ἀδελφοίς",66,139],["μου",6,48],["καὶ",2,8],["νεώτερος",513,16],["ἐν",4,1],["τῷ",1,110],["οἴκῳ",34,113],["τοῦ",1,30],["πατρός",44,21],["μου",6,48],["ἐποίμαινον",955,129],["τὰ",1,42],["πρόβατα",194,43],["τοῦ",1,30],["πατρός",44,21],["μου",6,48]],"This Psalm is a genuine one of David, though supernumerary, [composed] when he fought in single combat with Goliad. I was small among my brethren, and youngest in my father's house: I tended my father's sheep."],["2",[["Αἱ",1,183],["χεῖρές",37,179],["μου",6,48],["ἐποίησαν",23,141],["ὄργανον",1579,20],["καὶ",2,8],["οἱ",1,128],["δάκτυλοί",1182,51],["μου",6,48],["ἥρμοσαν",3421,141],["ψαλτήριον",1698,20]],"My hands formed a musical instrument, and my fingers tuned a psaltery."],["3",[["Καὶ",2,8],["τίς",39,150],["ἀναγγελεῖ",228,120],["τῷ",1,110],["Κυρίῳ",7,113],["μου",6,48],["αὐτὸς",3,158],["Κύριος",7,5],["αὐτὸς",3,158],["εἰσακούει",237,87]],"And who shall tell my Lord? the Lord himself, he himself hears."],["4",[["Αὐτὸς",3,158],["ἐξαπέστειλεν",217,3],["τὸν",1,6],["ἄγγελον",206,7],["αὐτοῦ",3,48],["καὶ",2,8],["ᾖρέ",248,14],["με",6,82],["ἐκ",21,1],["τῶν",1,44],["προβάτων",194,45],["τοῦ",1,30],["πατρός",44,21],["μου",6,48],["καὶ",2,8],["ἔχρισέ",713,3],["με",6,82],["ἐν",4,1],["τῷ",1,52],["ἐλαίῳ",312,53],["τῆς",1,18],["χρίσεως",2137,19],["αὐτοῦ",3,48]],"He sent forth his angel, and took me from my father's sheep, and he anointed me with the oil of his anointing."],["5",[["Οἱ",1,128],["ἀδελφοί",66,51],["μου",6,48],["καλοὶ",264,130],["καὶ",2,8],["μεγάλοι",65,130],["καὶ",2,8],["οὐκ",12,17],["εὐδόκησεν",908,3],["ἐν",4,1],["αὐτοῖς",3,142],["Κύριος",7,5]],"My brothers were handsome and tall; but the Lord did not take pleasure in them."],["6",[["Ἐξῆλθον",84,141],["εἰς",8,1],["συνάντησιν",426,87],["τῷ",1,110],["ἀλλοφύλῳ",203,111],["καὶ",2,8],["ἐπικατηράσατό",2678,26],["με",6,82],["ἐν",4,1],["τοῖς",1,91],["εἰδώλοις",626,92],["αὐτοῦ",3,48]],"I went forth to meet the Philistine; and he cursed me by his idols."],["7",[["Ἐγὼ",6,158],["δὲ",14,12],["σπασάμενος",1694,245],["τὴν",1,9],["παρʼ",72,1],["αὐτοῦ",3,48],["μάχαιραν",341,10],["ἀπεκεφάλισα",9074,147],["αὐτόν",3,82],["καὶ",2,8],["ᾖρα",0,0],["ὄνειδος",973,20],["ἐξ",21,1],["υἱῶν",13,77],["Ἰσραήλ",27,105]],"But I drew his own sword, and beheaded him, and removed reproach from the children of Israel."]]