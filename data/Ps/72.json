[["1",[["Ψαλμὸς",644,5],["τῷ",1,110],["Ἀσάφ",1103,5],["Ὡς",36,8],["ἀγαθὸς",114,16],["ὁ",1,4],["Θεὸς",20,5],["τῷ",1,110],["Ἰσραὴλ",27,105],["τοῖς",1,138],["εὐθέσι",825,215],["καρδίᾳ",64,2]],"A Psalm for Asaph. How good is God to Israel, to the upright in heart!"],["2",[["Ἐμοῦ",6,48],["δὲ",14,12],["παρὰ",73,1],["μικρὸν",367,29],["ἐσαλεύθησαν",678,94],["οἱ",1,128],["πόδες",210,51],["παρʼ",73,1],["ὀλίγον",555,29],["ἐξεχύθη",436,38],["τὰ",1,42],["διαβήματά",2077,43],["μου",6,48]],"But my feet were almost overthrown; my goings very nearly slipped."],["3",[["Ὅτι",19,8],["ἐζήλωσα",1057,147],["ἐπὶ",9,1],["τοῖς",1,138],["ἀνόμοις",536,215],["εἰρήνην",213,10],["ἁμαρτωλῶν",409,163],["θεωρῶν",897,67]],"For I was jealous of the transgressors, beholding the tranquillity of sinners."],["4",[["Ὅτι",19,8],["οὐκ",12,17],["ἔστιν",10,87],["ἀνάνευσις",8956,13],["ἐν",4,1],["τῷ",1,110],["θανάτῳ",170,113],["αὐτῶν",3,41],["καὶ",2,8],["στερέωμα",1479,33],["ἐν",4,1],["τῇ",1,95],["μάστιγι",1308,2],["αὐτῶν",3,41]],"For there is no sign of reluctance in their death: and [they have] firmness under their affliction."],["5",[["Ἐν",4,1],["κόποις",1345,139],["ἀνθρώπων",43,77],["οὐκ",12,17],["εἰσὶ",10,191],["καὶ",2,8],["μετὰ",29,1],["ἀνθρώπων",43,77],["οὐ",12,17],["μαστιγωθήσονται",1413,135]],"They are not in the troubles of [other] men; and they shall not be scourged with [other] men."],["6",[["Διὰ",56,1],["τοῦτο",16,122],["ἐκράτησεν",385,3],["αὐτοὺς",3,60],["ἡ",1,11],["ὑπερηφανία",1131,13],["περιεβάλοντο",744,184],["ἀδικίαν",288,10],["καὶ",2,8],["ἀσέβειαν",722,10],["αὐτῶν",3,41]],"Therefore pride has possessed them; they have clothed themselves with their injustice and ungodliness."],["7",[["Ἐξελεύσεται",82,89],["ὡς",36,8],["ἐκ",21,1],["στέατος",576,24],["ἡ",1,11],["ἀδικία",288,13],["αὐτῶν",3,41],["διῆλθον",423,141],["εἰς",8,1],["διάθεσιν",2885,10],["καρδίας",64,19]],"Their injustice shall go forth as out of fatness: they have fulfilled their intention."],["8",[["Διενοήθησαν",2342,94],["καὶ",2,8],["ἐλάλησαν",50,141],["ἐν",4,1],["πονηρίᾳ",730,180],["ἀδικίαν",288,10],["εἰς",8,1],["τὸ",1,32],["ὕψος",481,33],["ἐλάλησαν",50,141]],"They have taken counsel and spoken in wickedness: they have uttered unrighteousness loftily."],["9",[["Ἔθεντο",110,184],["εἰς",8,1],["οὐρανὸν",94,7],["τὸ",1,32],["στόμα",123,33],["αὐτῶν",3,41],["καὶ",2,8],["ἡ",1,11],["γλῶσσα",388,13],["αὐτῶν",3,41],["διῆλθεν",423,3],["ἐπὶ",9,1],["τῆς",1,18],["γῆς",26,19]],"They have set their mouth against heaven, and their tongue has gone through upon the earth."],["10",[["Διὰ",56,1],["τοῦτο",16,122],["ἐπιστρέψει",117,120],["ὁ",1,4],["λαός",35,5],["μου",6,48],["ἐνταῦθα",1457,17],["καὶ",2,8],["ἡμέραι",28,2],["πλήρεις",490,58],["εὑρεθήσονται",101,135],["ἐν",4,1],["αὐτοῖς",3,142]],"Therefore shall my people return hither: and full days shall be found with them."],["11",[["Καὶ",2,8],["εἶπαν",18,141],["πῶς",441,12],["ἔγνω",79,3],["ὁ",1,4],["Θεὸς",20,5],["καὶ",2,8],["εἰ",77,8],["ἔστι",10,87],["γνῶσις",753,13],["ἐν",4,1],["τῷ",1,110],["ὑψίστῳ",474,111]],"And they said, How does God know? and is there knowledge in the Most High?"],["12",[["Ἰδοὺ",51,17],["οὗτοι",16,213],["οἱ",1,128],["ἁμαρτωλοὶ",409,130],["καὶ",2,8],["εὐθηνοῦντες",2451,137],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["κατέσχον",1040,141],["πλούτου",574,21]],"Behold, these [are] the sinners, and they that prosper always: they have possessed wealth."],["13",[["Καὶ",2,8],["εἶπα",18,147],["ἄρα",985,12],["ματαίως",654,17],["ἐδικαίωσα",1115,147],["τὴν",1,9],["καρδίαν",64,10],["μου",6,48],["καὶ",2,8],["ἐνιψάμην",3310,152],["ἐν",4,1],["ἀθώοις",0,0],["τὰς",1,39],["χεῖράς",37,40],["μου",6,48]],"And I said, Verily in vain have I justified my heart, and washed my hands in innocency."],["14",[["Καὶ",2,8],["ἐγενόμην",30,152],["μεμαστιγωμένος",1413,408],["ὅλην",235,37],["τὴν",1,9],["ἡμέραν",28,10],["καὶ",2,8],["ὁ",1,4],["ἔλεγχός",1659,5],["μου",6,48],["εἰς",8,1],["τὰς",1,39],["πρωΐας",3122,19]],"For I was plagued all the day, and my reproof [was] every morning."],["15",[["Εἰ",77,8],["ἔλεγον",31,129],["διηγήσομαι",800,177],["οὕτως",71,17],["ἰδοὺ",51,17],["τῇ",1,95],["γενεᾷ",286,2],["τῶν",1,76],["υἱῶν",13,77],["σου",5,146],["ἠσυνθέτηκα",3714,85]],"If I said, I will speak thus; behold, I [should] have broken covenant with the generation of thy children."],["16",[["Καὶ",2,8],["ὑπέλαβον",1009,141],["τοῦ",1,30],["γνῶναι",79,100],["τοῦτο",16,122],["κόπος",1345,5],["ἐστὶν",10,87],["ἐναντίον",138,17],["μου",6,48]],"And I undertook to understand this, [but] it is too hard for me,"],["17",[["ἕως",42,8],["εἰσέλθω",86,227],["εἰς",8,1],["τὸ",1,32],["ἁγιαστήριον",5252,33],["τοῦ",1,30],["Θεοῦ",20,21],["συνῶ",606,227],["εἰς",8,1],["τὰ",1,42],["ἔσχατα",410,65]],"until I go into the sanctuary of God; [and so] understand the latter end."],["18",[["Πλὴν",257,1],["διὰ",56,1],["τὰς",1,39],["δολιότητας",3526,40],["ἔθου",110,169],["αὐτοῖς",3,142],["κατέβαλες",1074,154],["αὐτοὺς",3,60],["ἐν",4,1],["τῷ",1,110],["ἐπαρθῆναι",661,175]],"Surely thou hast appointed [judgments] to them because of their crafty dealings: thou hast cast them down when they were lifted up."],["19",[["Πῶς",441,12],["ἐγένοντο",30,184],["εἰς",8,1],["ἐρήμωσιν",1940,10],["ἐξάπινα",2535,17],["ἐξέλιπον",321,141],["ἀπώλοντο",217,184],["διὰ",56,1],["τὴν",1,9],["ἀνομίαν",275,10],["αὐτῶν",3,41]],"How have they become desolate! suddenly they have failed: they have perished because of their iniquity."],["20",[["Ὡσεὶ",343,17],["ἐνύπνιον",653,20],["ἐξεγειρομένου",656,418],["Κύριε",7,250],["ἐν",4,1],["τῇ",1,95],["πόλει",41,2],["σου",5,146],["τὴν",1,9],["εἰκόνα",1136,10],["αὐτῶν",3,41],["ἐξουδενώσεις",1068,159]],"As the dream of one awakening, O Lord, in thy city thou wilt despise their image."],["21",[["Ὅτι",19,8],["ηὐφράνθη",244,38],["ἡ",1,11],["καρδία",64,13],["μου",6,48],["καὶ",2,8],["οἱ",1,128],["νεφροί",1414,51],["μου",6,48],["ἠλλοιώθησαν",1231,94]],"For my heart has rejoiced, and my reins have been gladdened."],["22",[["Κᾀγὼ",613,105],["ἐξουδενωμένος",1068,408],["καὶ",2,8],["οὐκ",12,17],["ἔγνων",79,147],["κτηνώδης",7518,16],["ἐγενόμην",30,152],["παρὰ",73,1],["σοὶ",5,151]],"But I [was] vile and knew not: I became brutish before thee."],["23",[["κᾀγὼ",613,105],["διαπαντὸς",510,17],["μετὰ",29,1],["σου",5,146],["ἐκράτησας",385,154],["τῆς",1,18],["χειρὸς",37,19],["τῆς",1,18],["δεξιᾶς",282,78],["μου",6,83]],"Yet I am continually with thee: thou hast holden my right hand."],["24",[["ἐν",4,1],["τῇ",1,95],["βουλῇ",350,2],["σου",5,146],["ὡδήγησάς",1108,154],["με",6,82],["καὶ",2,8],["μετὰ",29,1],["δόξης",141,19],["προσελάβου",3119,169],["με",6,82]],"Thou hast guided me by thy counsel, and thou hast taken me to thyself with glory."],["25",[["Τί",39,119],["γάρ",40,12],["μοι",6,49],["ὑπάρχει",418,87],["ἐν",4,1],["τῷ",1,110],["οὐρανῷ",94,113],["καὶ",2,8],["παρὰ",73,1],["σοῦ",5,146],["τί",39,119],["ἠθέλησα",612,147],["ἐπὶ",9,1],["τῆς",1,18],["γῆς",26,19]],"For what have I in heaven [but thee]? and what have I desired upon the earth beside thee?"],["26",[["Ἐξέλιπεν",321,3],["ἡ",1,11],["καρδία",64,13],["μου",6,48],["καὶ",2,8],["ἡ",1,11],["σάρξ",287,13],["μου",6,48],["ὁ",1,4],["Θεὸς",20,5],["τῆς",1,18],["καρδίας",64,19],["μου",6,83],["καὶ",2,8],["ἡ",1,11],["μερίς",399,13],["μου",6,48],["ὁ",1,4],["Θεὸς",20,5],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7]],"My heart and my flesh have failed: [but] God [is the strength] of my heart, and God is my portion for ever."],["27",[["Ὅτι",19,8],["ἰδοὺ",51,17],["οἱ",1,128],["μακρύνοντες",0,0],["ἑαυτοὺς",92,60],["ἀπὸ",17,1],["σοῦ",5,146],["ἀπολοῦνται",217,127],["ἐξωλόθρευσας",291,154],["πάντα",11,59],["τὸν",1,6],["πορνεύοντα",2109,178],["ἀπὸ",17,1],["σοῦ",5,146]],"For, behold, they that remove themselves far from thee shall perish: thou hast destroyed every one that goes a whoring from thee."],["28",[["Ἐμοὶ",6,49],["δὲ",14,12],["τὸ",1,32],["προσκολλᾶσθαι",2038,104],["τῷ",1,110],["Θεῷ",20,113],["ἀγαθόν",114,29],["ἐστι",10,87],["τίθεσθαι",110,104],["ἐν",4,1],["τῷ",1,110],["Κυρίῳ",7,113],["τὴν",1,9],["ἐλπίδα",530,10],["μου",6,48],["τοῦ",1,30],["ἐξαγγεῖλαι",2532,100],["πάσας",11,109],["τὰς",1,39],["αἰνέσεις",402,159],["σου",5,146],["ἐν",4,1],["ταῖς",1,70],["πύλαις",162,71],["τῆς",1,18],["θυγατρὸς",97,19],["Σιών",334,2]],"But it is good for me to cleave close to God, to put my trust in the Lord; that I may proclaim all thy praises in the gates of the daughter of Sion."]]