[["1",[["Ψαλμὸς",639,5],["τῷ",1,110],["Ἀσάφ",1105,5],["Ὡς",36,8],["ἀγαθὸς",113,16],["ὁ",1,4],["Θεὸς",20,5],["τῷ",1,110],["Ἰσραὴλ",27,105],["τοῖς",1,138],["εὐθέσι",826,215],["καρδίᾳ",63,2]],"A Psalm for Asaph. How good is God to Israel, to the upright in heart!"],["2",[["Ἐμοῦ",6,48],["δὲ",14,12],["παρὰ",72,1],["μικρὸν",365,29],["ἐσαλεύθησαν",679,94],["οἱ",1,128],["πόδες",208,51],["παρʼ",72,1],["ὀλίγον",554,29],["ἐξεχύθη",435,38],["τὰ",1,42],["διαβήματά",2082,43],["μου",6,48]],"But my feet were almost overthrown; my goings very nearly slipped."],["3",[["Ὅτι",19,8],["ἐζήλωσα",1116,147],["ἐπὶ",9,1],["τοῖς",1,138],["ἀνόμοις",532,215],["εἰρήνην",210,10],["ἁμαρτωλῶν",406,163],["θεωρῶν",898,67]],"For I was jealous of the transgressors, beholding the tranquillity of sinners."],["4",[["Ὅτι",19,8],["οὐκ",12,17],["ἔστιν",10,87],["ἀνάνευσις",9022,13],["ἐν",4,1],["τῷ",1,110],["θανάτῳ",169,113],["αὐτῶν",3,41],["καὶ",2,8],["στερέωμα",1482,33],["ἐν",4,1],["τῇ",1,95],["μάστιγι",1308,2],["αὐτῶν",3,41]],"For there is no sign of reluctance in their death: and [they have] firmness under their affliction."],["5",[["Ἐν",4,1],["κόποις",1342,139],["ἀνθρώπων",43,77],["οὐκ",12,17],["εἰσὶ",10,189],["καὶ",2,8],["μετὰ",29,1],["ἀνθρώπων",43,77],["οὐ",12,17],["μαστιγωθήσονται",1632,135]],"They are not in the troubles of [other] men; and they shall not be scourged with [other] men."],["6",[["Διὰ",54,1],["τοῦτο",16,122],["ἐκράτησεν",383,3],["αὐτοὺς",3,60],["ἡ",1,11],["ὑπερηφανία",1130,13],["περιεβάλοντο",743,182],["ἀδικίαν",288,10],["καὶ",2,8],["ἀσέβειαν",722,10],["αὐτῶν",3,41]],"Therefore pride has possessed them; they have clothed themselves with their injustice and ungodliness."],["7",[["Ἐξελεύσεται",84,89],["ὡς",36,8],["ἐκ",21,1],["στέατος",574,24],["ἡ",1,11],["ἀδικία",288,13],["αὐτῶν",3,41],["διῆλθον",427,141],["εἰς",8,1],["διάθεσιν",2899,10],["καρδίας",63,19]],"Their injustice shall go forth as out of fatness: they have fulfilled their intention."],["8",[["Διενοήθησαν",2353,94],["καὶ",2,8],["ἐλάλησαν",50,141],["ἐν",4,1],["πονηρίᾳ",729,179],["ἀδικίαν",288,10],["εἰς",8,1],["τὸ",1,32],["ὕψος",480,33],["ἐλάλησαν",50,141]],"They have taken counsel and spoken in wickedness: they have uttered unrighteousness loftily."],["9",[["Ἔθεντο",109,182],["εἰς",8,1],["οὐρανὸν",94,7],["τὸ",1,32],["στόμα",123,33],["αὐτῶν",3,41],["καὶ",2,8],["ἡ",1,11],["γλῶσσα",385,13],["αὐτῶν",3,41],["διῆλθεν",427,3],["ἐπὶ",9,1],["τῆς",1,18],["γῆς",26,19]],"They have set their mouth against heaven, and their tongue has gone through upon the earth."],["10",[["Διὰ",54,1],["τοῦτο",16,122],["ἐπιστρέψει",116,120],["ὁ",1,4],["λαός",35,5],["μου",6,48],["ἐνταῦθα",1457,17],["καὶ",2,8],["ἡμέραι",28,2],["πλήρεις",489,58],["εὑρεθήσονται",106,135],["ἐν",4,1],["αὐτοῖς",3,142]],"Therefore shall my people return hither: and full days shall be found with them."],["11",[["Καὶ",2,8],["εἶπαν",18,221],["πῶς",440,12],["ἔγνω",81,3],["ὁ",1,4],["Θεὸς",20,5],["καὶ",2,8],["εἰ",77,8],["ἔστι",10,87],["γνῶσις",753,13],["ἐν",4,1],["τῷ",1,110],["ὑψίστῳ",473,111]],"And they said, How does God know? and is there knowledge in the Most High?"],["12",[["Ἰδοὺ",51,17],["οὗτοι",16,213],["οἱ",1,128],["ἁμαρτωλοὶ",406,130],["καὶ",2,8],["εὐθηνοῦντες",2458,137],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["κατέσχον",1057,141],["πλούτου",572,21]],"Behold, these [are] the sinners, and they that prosper always: they have possessed wealth."],["13",[["Καὶ",2,8],["εἶπα",18,147],["ἄρα",986,12],["ματαίως",648,17],["ἐδικαίωσα",1134,147],["τὴν",1,9],["καρδίαν",63,10],["μου",6,48],["καὶ",2,8],["ἐνιψάμην",3316,152],["ἐν",4,1],["ἀθώοις",0,0],["τὰς",1,39],["χεῖράς",37,40],["μου",6,48]],"And I said, Verily in vain have I justified my heart, and washed my hands in innocency."],["14",[["Καὶ",2,8],["ἐγενόμην",30,152],["μεμαστιγωμένος",0,0],["ὅλην",233,37],["τὴν",1,9],["ἡμέραν",28,10],["καὶ",2,8],["ὁ",1,4],["ἔλεγχός",1660,5],["μου",6,48],["εἰς",8,1],["τὰς",1,39],["πρωΐας",3130,19]],"For I was plagued all the day, and my reproof [was] every morning."],["15",[["Εἰ",77,8],["ἔλεγον",31,129],["διηγήσομαι",797,176],["οὕτως",70,17],["ἰδοὺ",51,17],["τῇ",1,95],["γενεᾷ",286,2],["τῶν",1,76],["υἱῶν",13,77],["σου",5,146],["ἠσυνθέτηκα",0,0]],"If I said, I will speak thus; behold, I [should] have broken covenant with the generation of thy children."],["16",[["Καὶ",2,8],["ὑπέλαβον",1009,141],["τοῦ",1,30],["γνῶναι",81,100],["τοῦτο",16,122],["κόπος",1342,5],["ἐστὶν",10,87],["ἐναντίον",138,17],["μου",6,48]],"And I undertook to understand this, [but] it is too hard for me,"],["17",[["ἕως",42,8],["εἰσέλθω",88,227],["εἰς",8,1],["τὸ",1,32],["ἁγιαστήριον",5283,33],["τοῦ",1,30],["Θεοῦ",20,21],["συνῶ",602,227],["εἰς",8,1],["τὰ",1,42],["ἔσχατα",407,65]],"until I go into the sanctuary of God; [and so] understand the latter end."],["18",[["Πλὴν",257,1],["διὰ",54,1],["τὰς",1,39],["δολιότητας",3529,40],["ἔθου",109,169],["αὐτοῖς",3,142],["κατέβαλες",1075,154],["αὐτοὺς",3,60],["ἐν",4,1],["τῷ",1,110],["ἐπαρθῆναι",752,174]],"Surely thou hast appointed [judgments] to them because of their crafty dealings: thou hast cast them down when they were lifted up."],["19",[["Πῶς",440,12],["ἐγένοντο",30,182],["εἰς",8,1],["ἐρήμωσιν",1941,10],["ἐξάπινα",2539,17],["ἐξέλιπον",321,141],["ἀπώλοντο",213,182],["διὰ",54,1],["τὴν",1,9],["ἀνομίαν",274,10],["αὐτῶν",3,41]],"How have they become desolate! suddenly they have failed: they have perished because of their iniquity."],["20",[["Ὡσεὶ",342,17],["ἐνύπνιον",647,20],["ἐξεγειρομένου",650,425],["Κύριε",7,251],["ἐν",4,1],["τῇ",1,95],["πόλει",41,2],["σου",5,146],["τὴν",1,9],["εἰκόνα",1136,10],["αὐτῶν",3,41],["ἐξουδενώσεις",1069,159]],"As the dream of one awakening, O Lord, in thy city thou wilt despise their image."],["21",[["Ὅτι",19,8],["ηὐφράνθη",242,38],["ἡ",1,11],["καρδία",63,13],["μου",6,48],["καὶ",2,8],["οἱ",1,128],["νεφροί",1415,51],["μου",6,48],["ἠλλοιώθησαν",1289,94]],"For my heart has rejoiced, and my reins have been gladdened."],["22",[["Κᾀγὼ",611,105],["ἐξουδενωμένος",1069,228],["καὶ",2,8],["οὐκ",12,17],["ἔγνων",81,147],["κτηνώδης",7568,16],["ἐγενόμην",30,152],["παρὰ",72,1],["σοὶ",5,151]],"But I [was] vile and knew not: I became brutish before thee."],["23",[["κᾀγὼ",611,105],["διαπαντὸς",506,17],["μετὰ",29,1],["σου",5,146],["ἐκράτησας",383,154],["τῆς",1,18],["χειρὸς",37,19],["τῆς",1,18],["δεξιᾶς",282,78],["μου",6,83]],"Yet I am continually with thee: thou hast holden my right hand."],["24",[["ἐν",4,1],["τῇ",1,95],["βουλῇ",349,2],["σου",5,146],["ὡδήγησάς",1110,154],["με",6,82],["καὶ",2,8],["μετὰ",29,1],["δόξης",141,19],["προσελάβου",3127,169],["με",6,82]],"Thou hast guided me by thy counsel, and thou hast taken me to thyself with glory."],["25",[["Τί",39,119],["γάρ",40,12],["μοι",6,49],["ὑπάρχει",416,87],["ἐν",4,1],["τῷ",1,110],["οὐρανῷ",94,113],["καὶ",2,8],["παρὰ",72,1],["σοῦ",5,146],["τί",39,119],["ἠθέλησα",609,147],["ἐπὶ",9,1],["τῆς",1,18],["γῆς",26,19]],"For what have I in heaven [but thee]? and what have I desired upon the earth beside thee?"],["26",[["Ἐξέλιπεν",321,3],["ἡ",1,11],["καρδία",63,13],["μου",6,48],["καὶ",2,8],["ἡ",1,11],["σάρξ",287,13],["μου",6,48],["ὁ",1,4],["Θεὸς",20,5],["τῆς",1,18],["καρδίας",63,19],["μου",6,83],["καὶ",2,8],["ἡ",1,11],["μερίς",396,13],["μου",6,48],["ὁ",1,4],["Θεὸς",20,5],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7]],"My heart and my flesh have failed: [but] God [is the strength] of my heart, and God is my portion for ever."],["27",[["Ὅτι",19,8],["ἰδοὺ",51,17],["οἱ",1,128],["μακρύνοντες",0,0],["ἑαυτοὺς",92,60],["ἀπὸ",17,1],["σοῦ",5,146],["ἀπολοῦνται",213,127],["ἐξωλόθρευσας",291,154],["πάντα",11,59],["τὸν",1,6],["πορνεύοντα",2116,177],["ἀπὸ",17,1],["σοῦ",5,146]],"For, behold, they that remove themselves far from thee shall perish: thou hast destroyed every one that goes a whoring from thee."],["28",[["Ἐμοὶ",6,49],["δὲ",14,12],["τὸ",1,32],["προσκολλᾶσθαι",2043,104],["τῷ",1,110],["Θεῷ",20,113],["ἀγαθόν",113,29],["ἐστι",10,87],["τίθεσθαι",109,104],["ἐν",4,1],["τῷ",1,110],["Κυρίῳ",7,113],["τὴν",1,9],["ἐλπίδα",527,10],["μου",6,48],["τοῦ",1,30],["ἐξαγγεῖλαι",2535,100],["πάσας",11,109],["τὰς",1,39],["αἰνέσεις",399,159],["σου",5,146],["ἐν",4,1],["ταῖς",1,70],["πύλαις",162,71],["τῆς",1,18],["θυγατρὸς",97,19],["Σιών",331,2]],"But it is good for me to cleave close to God, to put my trust in the Lord; that I may proclaim all thy praises in the gates of the daughter of Sion."]]