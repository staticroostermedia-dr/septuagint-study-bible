[["1",[["Αἶνος",1763,5],["ᾠδῆς",776,19],["τῷ",1,110],["Δαυίδ",52,105],["Δεῦτε",1159,17],["ἀγαλλιασώμεθα",738,270],["τῷ",1,110],["Κυρίῳ",7,113],["ἀλαλάξωμεν",1984,75],["τῷ",1,110],["Θεῷ",20,113],["τῷ",1,110],["σωτῆρι",1388,113],["ἡμῶν",6,41]],"The praise of a Song by David. Come, let us exult in the Lord; let us make a joyful noise to God our Saviour."],["2",[["Προφθάσωμεν",1831,75],["τὸ",1,32],["πρόσωπον",47,33],["αὐτοῦ",3,48],["ἐν",4,1],["ἐξομολογήσει",479,120],["καὶ",2,8],["ἐν",4,1],["ψαλμοῖς",644,139],["ἀλαλάξωμεν",1984,75],["αὐτῷ",3,49]],"Let us come before his presence with thanksgiving, and make a joyful noise to him with psalms."],["3",[["Ὅτι",19,8],["Θεὸς",20,5],["μέγας",66,16],["Κύριος",7,5],["καὶ",2,8],["βασιλεὺς",22,5],["μέγας",66,16],["ἐπὶ",9,1],["πάντας",11,58],["τοὺς",1,56],["θεούς",20,31]],"For the Lord is a great God, and a great king over all gods:",{"s":"r"}],["4",[["ὅτι",19,8],["οὐκ",12,17],["ἀπώσεται",770,89],["Κύριος",7,5],["τὸν",1,6],["λαὸν",35,7],["αὐτοῦ",3,48],["ὅτι",19,8],["ἐν",4,1],["τῇ",1,95],["χειρὶ",37,2],["αὐτοῦ",3,48],["τὰ",1,42],["πέρατα",876,43],["τῆς",1,18],["γῆς",26,19],["καὶ",2,8],["τὰ",1,42],["ὕψη",481,43],["τῶν",1,44],["ὀρέων",87,45],["αὐτοῦ",3,48],["ἐστιν",10,87]],"for the Lord will not cast off his people. For the ends of the earth are in his hands; and the heights of the mountains are his.",{"s":"r"}],["5",[["Ὅτι",19,8],["αὐτοῦ",3,48],["ἐστιν",10,87],["ἡ",1,11],["θάλασσα",137,13],["καὶ",2,8],["αὐτὸς",3,158],["ἐποίησεν",23,3],["αὐτὴν",3,98],["καὶ",2,8],["τὴν",1,9],["ξηρὰν",1186,37],["χεῖρες",37,180],["αὐτοῦ",3,48],["ἔπλασαν",910,141]],"For the sea is his, and he made it: and his hands formed the dry land."],["6",[["Δεῦτε",1159,17],["προσκυνήσωμεν",298,75],["καὶ",2,8],["προσπέσωμεν",1737,75],["αὐτῷ",3,49],["καὶ",2,8],["κλαύσωμεν",412,75],["ἐναντίον",138,17],["Κυρίου",7,21],["τοῦ",1,30],["ποίησαντος",23,513],["ἡμᾶς",6,60]],"Come, let us worship and fall down before him; and weep before the Lord that made us."],["7",[["Ὅτι",19,8],["αὐτός",3,158],["ἐστιν",10,87],["ὁ",1,4],["Θεὸς",20,5],["ἡμῶν",6,41],["καὶ",2,8],["ἡμεῖς",6,195],["λαὸς",35,5],["νομῆς",1205,19],["αὐτοῦ",3,48],["καὶ",2,8],["πρόβατα",194,43],["χειρὸς",37,19],["αὐτοῦ",3,48]],"For he is our God; and we are the people of his pasture, and the sheep of his hand."],["8",[["σήμερον",205,17],["ἐὰν",45,8],["τῆς",1,18],["φωνῆς",95,19],["αὐτοῦ",3,48],["ἀκούσητε",54,118],["μὴ",25,8],["σκληρύνητε",1284,118],["τὰς",1,39],["καρδίας",64,19],["ὑμῶν",5,136],["ὡς",36,8],["ἐν",4,1],["τῷ",1,110],["παραπικρασμῷ",7875,113],["κατὰ",32,1],["τὴν",1,9],["ἡμέραν",28,10],["τοῦ",1,30],["πικρασμοῦ",5945,21],["ἐν",4,1],["τῇ",1,95],["ἐρήμῳ",160,96]],"To-day, if ye will hear his voice, harden not your hearts, as in the provocation, according to the day of irritation in the wilderness:"],["9",[["οὗ",120,17],["ἐπείρασάν",1094,141],["με",6,82],["οἱ",1,128],["πατέρες",44,51],["ὑμῶν",5,136],["ἐδοκίμασαν",1269,141],["καὶ",2,8],["εἶδον",53,147],["τὰ",1,42],["ἔργα",105,43],["μου",6,48]],"where your fathers tempted me, proved me, and saw my works."],["10",[["Τεσσαράκοντα",512,57],["ἔτη",81,43],["προσώχθισα",1780,147],["τῇ",1,95],["γενεᾷ",286,2],["ἐκείνῃ",80,99],["καὶ",2,8],["εἶπα",18,147],["ἀεὶ",2401,17],["πλανῶνται",464,299],["τῇ",1,95],["καρδίᾳ",64,2],["καὶ",2,8],["αὐτοὶ",3,195],["οὐκ",12,17],["ἔγνωσαν",79,141],["τὰς",1,39],["ὁδούς",68,40],["μου",6,48]],"Forty years was I grieved with this generation, and said, They do always err in their heart, and they have not known my ways."],["11",[["Ὡς",36,8],["ὤμοσα",347,147],["ἐν",4,1],["τῇ",1,95],["ὀργῇ",198,2],["μου",6,48],["εἰ",77,8],["εἰσελεύσονται",86,127],["εἰς",8,1],["τὴν",1,9],["κατάπαυσίν",2728,10],["μου",6,48]],"So I sware in my wrath, They shall not enter into my rest."]]