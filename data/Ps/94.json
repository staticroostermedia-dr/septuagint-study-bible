[["1",[["Αἶνος",1762,5],["ᾠδῆς",773,19],["τῷ",1,110],["Δαυίδ",52,105],["Δεῦτε",1162,17],["ἀγαλλιασώμεθα",737,270],["τῷ",1,110],["Κυρίῳ",7,113],["ἀλαλάξωμεν",1989,75],["τῷ",1,110],["Θεῷ",20,113],["τῷ",1,110],["σωτῆρι",1390,113],["ἡμῶν",6,41]],"The praise of a Song by David. Come, let us exult in the Lord; let us make a joyful noise to God our Saviour."],["2",[["Προφθάσωμεν",1834,75],["τὸ",1,32],["πρόσωπον",47,33],["αὐτοῦ",3,48],["ἐν",4,1],["ἐξομολογήσει",478,120],["καὶ",2,8],["ἐν",4,1],["ψαλμοῖς",639,139],["ἀλαλάξωμεν",1989,75],["αὐτῷ",3,49]],"Let us come before his presence with thanksgiving, and make a joyful noise to him with psalms."],["3",[["Ὅτι",19,8],["Θεὸς",20,5],["μέγας",65,16],["Κύριος",7,5],["καὶ",2,8],["βασιλεὺς",22,5],["μέγας",65,16],["ἐπὶ",9,1],["πάντας",11,58],["τοὺς",1,56],["θεούς",20,31]],"For the Lord is a great God, and a great king over all gods: for the Lord will not cast off his people."],["4",[["ὅτι",19,8],["οὐκ",12,17],["ἀπώσεται",767,89],["Κύριος",7,5],["τὸν",1,6],["λαὸν",35,7],["αὐτοῦ",3,48],["ὅτι",19,8],["ἐν",4,1],["τῇ",1,95],["χειρὶ",37,2],["αὐτοῦ",3,48],["τὰ",1,42],["πέρατα",877,43],["τῆς",1,18],["γῆς",26,19],["καὶ",2,8],["τὰ",1,42],["ὕψη",480,43],["τῶν",1,44],["ὀρέων",86,45],["αὐτοῦ",3,48],["ἐστιν",10,87]],"For the ends of the earth are in his hands; and the heights of the mountains are his."],["5",[["Ὅτι",19,8],["αὐτοῦ",3,48],["ἐστιν",10,87],["ἡ",1,11],["θάλασσα",137,13],["καὶ",2,8],["αὐτὸς",3,158],["ἐποίησεν",23,3],["αὐτὴν",3,98],["καὶ",2,8],["τὴν",1,9],["ξηρὰν",1187,37],["χεῖρες",37,179],["αὐτοῦ",3,48],["ἔπλασαν",912,141]],"For the sea is his, and he made it: and his hands formed the dry land."],["6",[["Δεῦτε",1162,17],["προσκυνήσωμεν",296,75],["καὶ",2,8],["προσπέσωμεν",1780,75],["αὐτῷ",3,49],["καὶ",2,8],["κλαύσωμεν",409,75],["ἐναντίον",138,17],["Κυρίου",7,21],["τοῦ",1,30],["ποίησαντος",23,521],["ἡμᾶς",6,60]],"Come, let us worship and fall down before him; and weep before the Lord that made us."],["7",[["Ὅτι",19,8],["αὐτός",3,158],["ἐ