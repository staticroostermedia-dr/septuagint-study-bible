[["1",[["Ψαλμὸς",644,5],["τῷ",1,110],["Ἀσάφ",1103,5],["Θεὸς",20,5],["θεῶν",20,77],["Κύριος",7,5],["ἐλάλησε",50,3],["καὶ",2,8],["ἐκάλεσε",128,3],["τὴν",1,9],["γῆν",26,10],["ἀπὸ",17,1],["ἀνατολῶν",345,61],["ἡλίου",323,21],["μέχρι",781,1],["δυσμῶν",882,61]],"A Psalm for Asaph. The God of gods, the Lord, has spoken, and called the earth from the rising of the sun to the going down [thereof]."],["2",[["Ἐκ",21,1],["Σιὼν",334,2],["ἡ",1,11],["εὐπρέπεια",2171,13],["τῆς",1,18],["ὡραιότητος",3480,19],["αὐτοῦ",3,48]],"Out of Sion [comes] the excellence of his beauty."],["3",[["Ὁ",1,4],["Θεὸς",20,5],["ἐμφανῶς",2827,17],["ἥξει",260,120],["ὁ",1,4],["Θεὸς",20,5],["ἡμῶν",6,41],["καὶ",2,8],["οὐ",12,17],["παρασιωπήσεται",1908,89],["πῦρ",118,33],["ἐναντίον",138,17],["αὐτοῦ",3,48],["καυθήσεται",671,125],["καὶ",2,8],["κύκλῳ",258,17],["αὐτοῦ",3,48],["καταιγὶς",1470,13],["σφοδρά",3365,15]],"God, our God, shall come manifestly, and shall not keep silence: a fire shall be kindled before him, and round about him there shall be a very great tempest."],["4",[["Προσκαλέσεται",1595,89],["τὸν",1,6],["οὐρανὸν",94,7],["ἄνω",1314,17],["καὶ",2,8],["τὴν",1,9],["γῆν",26,10],["διακρῖναι",1506,100],["τὸν",1,6],["λαὸν",35,7],["αὐτοῦ",3,48]],"He shall summon the heaven above, and the earth, that he may judge his people."],["5",[["Συναγάγετε",166,69],["αὐτῷ",3,49],["τοὺς",1,56],["ὁσίους",917,58],["αὐτοῦ",3,48],["τοὺς",1,56],["διατιθεμένους",619,230],["τὴν",1,9],["διαθήκην",169,10],["αὐτοῦ",3,48],["ἐπὶ",9,1],["θυσίαις",156,71]],"Assemble ye his saints to him, those that have engaged in a covenant with him upon sacrifices."],["6",[["Καὶ",2,8],["ἀναγγελοῦσιν",231,207],["οἱ",1,128],["οὐρανοὶ",94,51],["τὴν",1,9],["δικαιοσύνην",187,10],["αὐτοῦ",3,48],["ὅτι",19,8],["Θεὸς",20,5],["κριτής",749,5],["ἐστι",10,87],["διάψαλμα",689,20]],"And the heavens shall declare his righteousness: for God is judge. Pause."],["7",[["Ἄκουσον",54,198],["λαός",35,5],["μου",6,48],["καὶ",2,8],["λαλήσω",50,157],["σοι",5,151],["Ἰσραὴλ",27,105],["καὶ",2,8],["διαμαρτύρομαί",1585,251],["σοι",5,151],["ὁ",1,4],["Θεὸς",20,5],["ὁ",1,4],["Θεός",20,5],["σου",5,146],["εἰμὶ",10,149],["ἐγώ",6,158]],"Hear, my people, and I will speak to thee, O Israel: and I will testify to thee: I am God, thy God."],["8",[["Οὐκ",12,17],["ἐπὶ",9,1],["ταῖς",1,70],["θυσίαις",156,71],["σου",5,146],["ἐλέγξω",752,157],["σε",5,161],["τὰ",1,42],["δὲ",14,12],["ὁλοκαυτώματά",318,43],["σου",5,146],["ἐνώπιόν",115,1],["μου",6,48],["ἐστὶ",10,87],["διαπαντός",510,17]],"I will not reprove thee on account of thy sacrifices; for thy whole-burnt-offerings are before me continually."],["9",[["Οὐ",12,17],["δέξομαι",815,177],["ἐκ",21,1],["τοῦ",1,30],["οἴκου",34,21],["σου",5,146],["μόσχους",256,31],["οὐδὲ",106,12],["ἐκ",21,1],["τῶν",1,44],["ποιμνίων",707,45],["σου",5,146],["χιυάρους",0,0]],"I will take no bullocks out of thine house, nor he-goats out of thy flocks."],["10",[["Ὅτι",19,8],["ἐμά",525,63],["ἐστι",10,87],["πάντα",11,74],["τὰ",1,253],["θηρία",403,63],["τοῦ",1,30],["δρυμοῦ",802,21],["κτήνη",223,43],["ἐν",4,1],["τοῖς",1,91],["ὄρεσι",87,92],["καὶ",2,8],["βόες",814,7]],"For all the wild beasts of the thicket are mine, the cattle on the mountains, and oxen."],["11",[["Ἔγνωκα",79,85],["πάντα",11,65],["τὰ",1,42],["πετεινὰ",572,43],["τοῦ",1,30],["οὐρανοῦ",94,21],["καὶ",2,8],["ὡραιότης",3480,13],["ἀγροῦ",252,21],["μετʼ",29,1],["ἐμοῦ",6,48],["ἐστιν",10,87]],"I know all the birds of the sky; and the beauty of the field is mine."],["12",[["Ἐὰν",45,8],["πεινάσω",1045,157],["οὐ",12,17],["μή",25,8],["σοι",5,151],["εἴπω",18,227],["ἐμὴ",525,13],["γάρ",40,12],["ἐστιν",10,87],["ἡ",1,11],["οἰκουμένη",528,204],["καὶ",2,8],["τὸ",1,32],["πλήρωμα",2185,33],["αὐτῆς",3,83]],"If I should be hungry, I will not tell thee: for the world is mine, and the fulness of it."],["13",[["Μὴ",25,8],["φάγομαι",147,177],["κρέα",629,43],["ταύρων",1285,77],["ἢ",61,8],["αἷμα",148,33],["τράγων",1423,77],["πίομαι",212,177]],"Will I eat the flesh of bulls, or drink the blood of goats?"],["14",[["Θῦσον",437,198],["τῷ",1,110],["Θεῷ",20,113],["θυσίαν",156,10],["αἰνέσεως",989,19],["καὶ",2,8],["ἀπόδος",312,198],["τῷ",1,110],["ὑψίστῳ",474,111],["τὰς",1,39],["εὐχάς",633,40],["σου",5,146]],"Offer to God the sacrifice of praise; and pay thy vows to the Most High."],["15",[["Καὶ",2,8],["ἐπικάλεσαί",341,275],["με",6,82],["ἐν",4,1],["ἡμέρᾳ",28,2],["θλίψεως",438,19],["καὶ",2,8],["ἐξελοῦμαί",413,177],["σε",5,161],["καὶ",2,8],["δοξάσεις",452,159],["με",6,82],["διάψαλμα",689,20]],"And call upon me in the day of affliction; and I will deliver thee, and thou shalt glorify me. Pause."],["16",[["Τῷ",1,110],["δὲ",14,12],["ἁμαρτωλῷ",409,111],["εἶπεν",18,3],["ὁ",1,4],["Θεὸς",20,5],["ἱνατί",102,238],["σὺ",5,156],["διηγῇ",800,306],["τὰ",1,42],["δικαιώματά",428,43],["μου",6,48],["καὶ",2,8],["ἀναλαμβάνεις",575,145],["τὴν",1,9],["διαθήκην",169,10],["μου",6,48],["διὰ",56,1],["στόματός",123,24],["σου",5,146]],"But to the sinner God has said, Why dost thou declare my ordinances, and take up my covenant in thy mouth?"],["17",[["Σὺ",5,156],["δὲ",14,12],["ἐμίσησας",351,154],["παιδείαν",571,10],["καὶ",2,8],["ἐξέβαλες",585,154],["τοὺς",1,56],["λόγους",48,31],["μου",6,48],["εἰς",8,1],["τὰ",1,42],["ὀπίσω",167,17]],"Whereas thou hast hated instruction, and hast cast my words behind [thee]."],["18",[["Εἰ",77,8],["ἐθεώρεις",897,217],["κλέπτην",2358,7],["συνέτρεχες",3363,217],["αὐτῷ",3,49],["καὶ",2,8],["μετὰ",29,1],["μοιχῶν",2367,36],["τὴν",1,9],["μερίδα",399,10],["σου",5,146],["ἐτίθεις",110,217]],"If thou sawest a thief, thou rannest along with him, and hast cast in thy lot with adulterers."],["19",[["Τὸ",1,32],["στόμα",123,33],["σου",5,146],["ἐπλεόνασε",1523,3],["κακίαν",433,10],["καὶ",2,8],["ἡ",1,11],["γλῶσσά",388,13],["σου",5,146],["περιέπλεκε",2940,14],["δολιότητα",3526,10]],"Thy mouth has multiplied wickedness, and thy tongue has framed deceit."],["20",[["Καθήμενος",419,407],["κατὰ",32,1],["τοῦ",1,30],["ἀδελφοῦ",67,21],["σου",5,146],["κατελάλεις",2356,217],["καὶ",2,8],["κατὰ",32,1],["τοῦ",1,30],["υἱοῦ",13,21],["τῆς",1,18],["μητρός",189,19],["σου",5,146],["ἐτίθεις",110,217],["σκάνδαλον",1834,20]],"Thou didst sit and speak against thy brother, and didst scandalise thy mother's son."],["21",[["Ταῦτα",16,248],["ἐποίησας",23,154],["καὶ",2,8],["ἐσίγησα",1915,147],["ὑπέλαβες",1009,154],["ἀνομίαν",275,10],["ὅτι",19,8],["ἔσομαί",10,177],["σοι",5,151],["ὅμοιος",657,16],["ἐλέγξω",752,157],["σε",5,161],["καὶ",2,8],["παραστήσω",595,157],["κατὰ",32,1],["πρόσωπόν",47,33],["σου",5,146]],"These things thou didst, and I kept silence: thou thoughtest wickedly that I should be like thee; [but] I will reprove thee, and set [thine offences] before thee."],["22",[["Σύνετε",606,69],["δὴ",193,12],["ταῦτα",16,248],["οἱ",1,128],["ἐπιλανθανόμενοι",513,351],["τοῦ",1,30],["Θεοῦ",20,21],["μήποτε",964,17],["ἁρπάσῃ",1214,116],["καὶ",2,8],["μὴ",25,8],["ᾖ",10,173],["ὁ",1,4],["ῥυόμενος",337,114]],"Now consider these things, ye that forget God, lest he rend [you], and there be no deliverer."],["23",[["Θυσία",156,13],["αἰνέσεως",989,19],["δοξάσει",452,120],["με",6,82],["καὶ",2,8],["ἐκεῖ",76,17],["ὁδὸς",68,13],["ᾗ",24,102],["δείξω",870,157],["αὐτῷ",3,49],["τὸ",1,32],["σωτήριον",472,33],["Θεοῦ",20,21]],"The sacrifice of praise will glorify me: and that is the way wherein I will shew to him the salvation of God."]]