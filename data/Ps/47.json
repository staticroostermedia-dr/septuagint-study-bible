[["1",[["Ψαλμὸς",639,5],["ᾠδῆς",773,19],["τοῖς",1,138],["υἱοῖς",13,139],["Κορὲ",875,251],["δευτέρᾳ",270,96],["σαββάτου",441,24]],"A Psalm of praise for the sons of Core on the second [day] of the week."],["2",[["Μεγὰς",65,16],["Κύριος",7,5],["καὶ",2,8],["αἰνετὸς",2568,16],["σφόδρα",149,17],["ἐν",4,1],["πόλει",41,2],["τοῦ",1,30],["Θεοῦ",20,21],["ἡμῶν",6,41],["ἐν",4,1],["ὄρει",86,53],["ἁγίῳ",75,34],["αὐτοῦ",3,48]],"Great is the Lord, and greatly to be praised in the city of our God, in his holy mountain."],["3",[["Εὐρίζων",7260,163],["ἀγαλλιάματι",1794,53],["πάσης",11,78],["τῆς",1,18],["γῆς",26,19],["ὄρη",86,63],["Σιὼν",331,2],["τὰ",1,254],["πλευρὰ",1328,13],["τοῦ",1,30],["βοῤῥᾶ",384,21],["ἡ",1,11],["πόλις",41,13],["τοῦ",1,30],["βασιλέως",22,21],["τοῦ",1,30],["μεγάλου",65,153]],"The city of the great King is well planted [on] the mountains of Sion, with the joy of the whole earth, [on] the sides of the north."],["4",[["Ὁ",1,4],["Θεὸς",20,5],["ἐν",4,1],["ταῖς",1,70],["βάρεσιν",2886,92],["αὐτῆς",3,83],["γινώσκεται",81,108],["ὅταν",318,8],["ἀντιλαμβάνηται",984,301],["αὐτῆς",3,83]],"God is known in her palaces, when he undertakes to help her."],["5",[["Ὅτι",19,8],["ἰδοὺ",51,17],["οἱ",1,128],["βασιλεῖς",22,51],["τῆς",1,18],["γῆς",26,19],["συνήχθησαν",165,94],["ἤλθοσαν",0,0],["ἐπὶ",9,1],["τὸ",1,32],["αὐτό",3,121]],"For, behold, the kings of the earth were assembled, they came together."],["6",[["Αὐτοὶ",3,193],["ἰδόντες",73,188],["οὕτως",70,17],["ἐθαύμασαν",965,141],["ἐταράχθησαν",508,94],["ἐσαλεύθησαν",679,94]],"They saw, and so they wondered: they were troubled, they were moved."],["7",[["τρόμος",1600,5],["ἐπελάβετο",1087,26],["αὐτῶν",3,41],["ἐκεῖ",76,17],["ὠδῖνες",2013,179],["ὡς",36,8],["τικτούσης",251,212]],"Trembling took hold on them: there were the pangs as of a woman in travail."],["8",[["Ἐν",4,1],["πνεύματι",167,53],["βιαίῳ",2349,34],["συντρίψεις",267,159],["πλοῖα",1169,43],["Θάρσις",0,0]],"Thou wilt break the ships of Tharsis with a vehement wind."],["9",[["Καθάπερ",688,8],["ἠκούσαμεν",53,288],["οὕτως",70,17],["καὶ",2,8],["εἴδομεν",73,288],["ἐν",4,1],["πόλει",41,2],["Κυρίου",7,21],["τῶν",1,123],["δυνάμεων",98,61],["ἐν",4,1],["πόλει",41,2],["τοῦ",1,30],["Θεοῦ",20,21],["ἡμῶν",6,41],["ὁ",1,4],["Θεὸς",20,5],["ἐθεμελίωσεν",1203,3],["αὐτὴν",3,98],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["διάψαλμα",687,20]],"As we have heard, so have we also seen, in the city of the Lord of hosts, in the city of our God: God has founded it for ever. Pause."],["10",[["Ὑπελάβομεν",1009,288],["ὁ",1,4],["Θεὸς",20,5],["τὸ",1,32],["ἔλεός",182,33],["σου",5,146],["ἐν",4,1],["μέσῳ",112,34],["τοῦ",1,30],["λαοῦ",35,21],["σου",5,146]],"We have thought of thy mercy, O God, in the midst of thy people."],["11",[["Κατὰ",32,1],["τὸ",1,32],["ὄνομά",55,33],["σου",5,146],["ὁ",1,4],["Θεὸς",20,5],["οὕτως",70,17],["καὶ",2,8],["ἡ",1,11],["αἴνεσίς",990,13],["σου",5,146],["ἐπὶ",9,1],["τὰ",1,42],["πέρατα",877,43],["τῆς",1,18],["γῆς",26,19],["δικαιοσύνης",185,19],["πλήρης",489,15],["ἡ",1,11],["δεξιά",282,15],["σου",5,146]],"According to thy name, O God, so is also thy praise to the ends of the earth: thy right hand is full of righteousness."],["12",[["Εὐφρανθήτω",242,25],["τὸ",1,32],["ὄρος",86,33],["Σιὼν",331,2],["ἀγαλλιάσθωσαν",737,72],["αἱ",1,183],["θυγατέρες",97,179],["τῆς",1,18],["Ἰουδαίας",491,19],["ἕνεκα",445,1],["τῶν",1,44],["κριμάτων",266,45],["σου",5,146],["Κύριε",7,251]],"Let mount Sion rejoice, let the daughters of Judæa exult, because of thy judgments, O Lord."],["13",[["Κυκλώσατε",600,69],["Σιὼν",331,2],["καὶ",2,8],["περιλάβετε",2484,69],["αὐτὴν",3,98],["διηγήσασθε",797,376],["ἐν",4,1],["τοῖς",1,138],["πύργοις",709,139],["αὐτῆς",3,83]],"Go round about Sion, and encompass her: tell ye her towers."],["14",[["Θέσθε",109,268],["τὰς",1,39],["καρδίας",63,19],["ὑμῶν",5,136],["εἰς",8,1],["τὴν",1,9],["δύναμιν",98,10],["αὐτῆς",3,83],["καὶ",2,8],["καταδιέλεσθε",4850,268],["τὰς",1,39],["βάρεις",3512,40],["αὐτῆς",3,83],["ὅπως",236,8],["ἂν",82,12],["διηγήσησθε",797,133],["εἰς",8,1],["γενεὰν",286,10],["ἑτέραν",253,37]],"Mark ye well her strength, and observe her palaces; that ye may tell the next generation."],["15",[["Ὅτι",19,8],["οὗτός",16,112],["ἐστιν",10,87],["ὁ",1,4],["Θεὸς",20,5],["ἡμῶν",6,41],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["καὶ",2,8],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["τοῦ",1,30],["αἰῶνος",100,21],["αὐτὸς",3,158],["ποιμανεῖ",955,120],["ἡμᾶς",6,60],["εἰς",8,1],["τοὺς",1,56],["αἰῶνας",100,31]],"For this is our God for ever and ever: he will be our guide for evermore."]]