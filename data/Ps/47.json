[["1",[["Ψαλμὸς",644,5],["ᾠδῆς",776,19],["τοῖς",1,138],["υἱοῖς",13,139],["Κορὲ",874,250],["δευτέρᾳ",271,96],["σαββάτου",442,24]],"A Psalm of praise for the sons of Core on the second [day] of the week."],["2",[["Μεγὰς",66,16],["Κύριος",7,5],["καὶ",2,8],["αἰνετὸς",2564,16],["σφόδρα",150,17],["ἐν",4,1],["πόλει",41,2],["τοῦ",1,30],["Θεοῦ",20,21],["ἡμῶν",6,41],["ἐν",4,1],["ὄρει",87,53],["ἁγίῳ",75,34],["αὐτοῦ",3,48]],"Great is the Lord, and greatly to be praised in the city of our God, in his holy mountain."],["3",[["Εὐρίζων",7208,163],["ἀγαλλιάματι",1794,53],["πάσης",11,78],["τῆς",1,18],["γῆς",26,19],["ὄρη",87,63],["Σιὼν",334,2],["τὰ",1,253],["πλευρὰ",1328,13],["τοῦ",1,30],["βοῤῥᾶ",387,21],["ἡ",1,11],["πόλις",41,13],["τοῦ",1,30],["βασιλέως",22,21],["τοῦ",1,30],["μεγάλου",66,153]],"The city of the great King is well planted [on] the mountains of Sion, with the joy of the whole earth, [on] the sides of the north."],["4",[["Ὁ",1,4],["Θεὸς",20,5],["ἐν",4,1],["ταῖς",1,70],["βάρεσιν",2871,92],["αὐτῆς",3,83],["γινώσκεται",79,108],["ὅταν",319,8],["ἀντιλαμβάνηται",984,297],["αὐτῆς",3,83]],"God is known in her palaces, when he undertakes to help her."],["5",[["Ὅτι",19,8],["ἰδοὺ",51,17],["οἱ",1,128],["βασιλεῖς",22,51],["τῆς",1,18],["γῆς",26,19],["συνήχθησαν",166,94],["ἤλθοσαν",55,141],["ἐπὶ",9,1],["τὸ",1,32],["αὐτό",3,121]],"For, behold, the kings of the earth were assembled, they came together."],["6",[["Αὐτοὶ",3,195],["ἰδόντες",53,190],["οὕτως",71,17],["ἐθαύμασαν",963,141],["ἐταράχθησαν",508,94],["ἐσαλεύθησαν",678,94]],"They saw, and so they wondered: they were troubled, they were moved."],["7",[["τρόμος",1599,5],["ἐπελάβετο",1086,26],["αὐτῶν",3,41],["ἐκεῖ",76,17],["ὠδῖνες",2005,180],["ὡς",36,8],["τικτούσης",251,212]],"Trembling took hold on them: there were the pangs as of a woman in travail."],["8",[["Ἐν",4,1],["πνεύματι",168,53],["βιαίῳ",2337,34],["συντρίψεις",268,159],["πλοῖα",1169,43],["Θάρσις",13029,0]],"Thou wilt break the ships of Tharsis with a vehement wind."],["9",[["Καθάπερ",690,8],["ἠκούσαμεν",54,285],["οὕτως",71,17],["καὶ",2,8],["εἴδομεν",53,285],["ἐν",4,1],["πόλει",41,2],["Κυρίου",7,21],["τῶν",1,123],["δυνάμεων",98,61],["ἐν",4,1],["πόλει",41,2],["τοῦ",1,30],["Θεοῦ",20,21],["ἡμῶν",6,41],["ὁ",1,4],["Θεὸς",20,5],["ἐθεμελίωσεν",1116,3],["αὐτὴν",3,98],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["διάψαλμα",689,20]],"As we have heard, so have we also seen, in the city of the Lord of hosts, in the city of our God: God has founded it for ever. Pause."],["10",[["Ὑπελάβομεν",1009,285],["ὁ",1,4],["Θεὸς",20,5],["τὸ",1,32],["ἔλεός",183,33],["σου",5,146],["ἐν",4,1],["μέσῳ",113,34],["τοῦ",1,30],["λαοῦ",35,21],["σου",5,146]],"We have thought of thy mercy, O God, in the midst of thy people."],["11",[["Κατὰ",32,1],["τὸ",1,32],["ὄνομά",57,33],["σου",5,146],["ὁ",1,4],["Θεὸς",20,5],["οὕτως",71,17],["καὶ",2,8],["ἡ",1,11],["αἴνεσίς",989,13],["σου",5,146],["ἐπὶ",9,1],["τὰ",1,42],["πέρατα",876,43],["τῆς",1,18],["γῆς",26,19],["δικαιοσύνης",187,19],["πλήρης",490,15],["ἡ",1,11],["δεξιά",282,15],["σου",5,146]],"According to thy name, O God, so is also thy praise to the ends of the earth: thy right hand is full of righteousness."],["12",[["Εὐφρανθήτω",244,25],["τὸ",1,32],["ὄρος",87,33],["Σιὼν",334,2],["ἀγαλλιάσθωσαν",738,72],["αἱ",1,185],["θυγατέρες",97,180],["τῆς",1,18],["Ἰουδαίας",492,19],["ἕνεκα",447,1],["τῶν",1,44],["κριμάτων",267,45],["σου",5,146],["Κύριε",7,250]],"Let mount Sion rejoice, let the daughters of Judæa exult, because of thy judgments, O Lord."],["13",[["Κυκλώσατε",603,69],["Σιὼν",334,2],["καὶ",2,8],["περιλάβετε",2477,69],["αὐτὴν",3,98],["διηγήσασθε",800,371],["ἐν",4,1],["τοῖς",1,138],["πύργοις",708,139],["αὐτῆς",3,83]],"Go round about Sion, and encompass her: tell ye her towers."],["14",[["Θέσθε",110,268],["τὰς",1,39],["καρδίας",64,19],["ὑμῶν",5,136],["εἰς",8,1],["τὴν",1,9],["δύναμιν",98,10],["αὐτῆς",3,83],["καὶ",2,8],["καταδιέλεσθε",4822,268],["τὰς",1,39],["βάρεις",3509,40],["αὐτῆς",3,83],["ὅπως",240,8],["ἂν",83,12],["διηγήσησθε",800,133],["εἰς",8,1],["γενεὰν",286,10],["ἑτέραν",253,37]],"Mark ye well her strength, and observe her palaces; that ye may tell the next generation."],["15",[["Ὅτι",19,8],["οὗτός",16,112],["ἐστιν",10,87],["ὁ",1,4],["Θεὸς",20,5],["ἡμῶν",6,41],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["καὶ",2,8],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["τοῦ",1,30],["αἰῶνος",100,21],["αὐτὸς",3,158],["ποιμανεῖ",953,120],["ἡμᾶς",6,60],["εἰς",8,1],["τοὺς",1,56],["αἰῶνας",100,31]],"For this is our God for ever and ever: he will be our guide for evermore."]]