[["1",[["Εἰς",8,1],["τὸ",1,32],["τέλος",369,33],["ὑπὲρ",139,1],["τῶν",1,76],["ληνῶν",1769,77],["ψαλμὸς",639,5],["τῷ",1,110],["Ἀσάφ",1105,5]],"For the end, a Psalm for Asaph, concerning the wine-presses."],["2",[["Ἀγαλλιᾶσθε",737,386],["τῷ",1,110],["Θεῷ",20,113],["τῷ",1,110],["βοηθῷ",948,113],["ἡμῶν",6,41],["ἀλαλάξατε",1989,69],["τῷ",1,110],["Θεῷ",20,113],["Ἰακώβ",146,105]],"Rejoice ye in God our helper; shout aloud to the God of Jacob."],["3",[["Λάβετε",46,69],["ψαλμὸν",639,7],["καὶ",2,8],["δότε",33,69],["τύμπανον",1790,20],["ψαλτήριον",1698,20],["τερπνὸν",6179,28],["μετὰ",29,1],["κιθάρας",1513,19]],"Take a psalm, and produce the timbrel, the pleasant psaltery with the harp."],["4",[["Σαλπίσατε",846,69],["ἐν",4,1],["νεομηνίᾳ",3605,2],["σάλπιγγι",578,2],["ἐν",4,1],["εὐσήμῳ",7262,96],["ἡμέρᾳ",28,2],["ἑορτῆς",485,19],["ὑμῶν",5,136]],"Blow the trumpet at the new moon, in the glorious day of your feast."],["5",[["Ὅτι",19,8],["πρόσταγμα",391,20],["τῷ",1,110],["Ἰσραήλ",27,105],["ἐστι",10,87],["καὶ",2,8],["κρίμα",266,33],["τῷ",1,110],["Θεῷ",20,113],["Ἰακώβ",146,105]],"For [this] is an ordinance for Israel, and a statute of the God of Jacob."],["6",[["Μαρτύριον",220,33],["ἐν",4,1],["τῷ",1,110],["Ἰωσὴφ",262,105],["ἔθετο",109,26],["αὐτὸν",3,82],["ἐν",4,1],["τῷ",1,110],["ἐξελθεῖν",84,100],["αὐτὸν",3,82],["ἐκ",21,1],["γῆς",26,19],["Αἰγύπτου",93,19],["γλῶσσαν",385,10],["ἣν",24,124],["οὐκ",12,17],["ἔγνω",81,3],["ἤκουσεν",53,3]],"He made it [to be] a testimony in Joseph, when he came forth out of the land of Egypt: he heard a language which he understood not."],["7",[["Ἀπέστησεν",514,3],["ἀπὸ",17,1],["ἄρσεων",3003,61],["τὸν",1,6],["νῶτον",2194,7],["αὐτοῦ",3,48],["αἱ",1,183],["χεῖρες",37,179],["αὐτοῦ",3,48],["ἐν",4,1],["τῷ",1,110],["κοφίνῳ",5806,113],["ἐδούλευσαν",403,141]],"He removed his back from burdens: his hands slaved in making the baskets."],["8",[["Ἐν",4,1],["θλίψει",437,2],["ἐπεκαλέσω",340,169],["με",6,82],["καὶ",2,8],["ἐῤῥυσάμην",335,152],["σε",5,161],["ἐπήκουσά",595,147],["σου",5,146],["ἐν",4,1],["ἀποκρύφῳ",2664,111],["καταιγίδος",1470,19],["ἐδοκίμασά",1337,147],["σε",5,161],["ἐπὶ",9,1],["ὕδατος",85,24],["ἀντιλογίας",1850,19],["διάψαλμα",687,20]],"Thou didst call upon me in trouble, and I delivered thee; I heard thee in the secret place of the storm: I proved thee at the water of Strife. Pause."],["9",[["Ἄκουσον",53,198],["λαός",35,5],["μου",6,48],["καὶ",2,8],["λαλήσω",50,157],["σοι",5,151],["Ἰσραὴλ",27,105],["καὶ",2,8],["διαμαρτύρομαί",1586,252],["σοι",5,151],["ἐὰν",45,8],["ἀκούσῃς",53,170],["μου",6,48]],"Hear, my people, and I will speak to thee, O Israel; and I will testify to thee: if thou wilt hearken to me;"],["10",[["οὐκ",12,17],["ἔσται",10,89],["ἐν",4,1],["σοὶ",5,151],["θεὸς",20,5],["πρόσφατος",3952,16],["οὐδὲ",105,12],["προσκυνήσεις",296,159],["θεῷ",20,113],["ἀλλοτρίῳ",377,111]],"there shall be no new god in thee; neither shalt thou worship a strange god."],["11",[["Ἐγὼ",6,158],["γάρ",40,12],["εἰμι",10,149],["Κύριος",7,5],["ὁ",1,4],["Θεός",20,5],["σου",5,146],["ὁ",1,4],["ἀναγαγών",522,155],["σε",5,161],["ἐκ",21,1],["γῆς",26,19],["Αἰγύπτου",93,19],["πλάτυνον",1779,198],["τὸ",1,32],["στόμα",123,33],["σου",5,146],["καὶ",2,8],["πληρώσω",529,157],["αὐτό",3,121]],"For I am the Lord thy God, that brought thee out of the land of Egypt: open thy mouth wide, and I will fill it."],["12",[["Καὶ",2,8],["οὐκ",12,17],["ἤκουσεν",53,3],["ὁ",1,4],["λαός",35,5],["μου",6,83],["τῆς",1,18],["φωνῆς",95,19],["μου",6,83],["καὶ",2,8],["Ἰσραὴλ",27,105],["οὐ",12,17],["προσέσχε",557,3],["μοι",6,49]],"But my people hearkened not to my voice; and Israel gave no heed to me."],["13",[["Καὶ",2,8],["ἐξαπέστειλα",217,147],["αὐτοὺς",3,60],["κατὰ",32,1],["τὰ",1,42],["ἐπιτηδεύματα",905,43],["τῶν",1,123],["καρδιῶν",63,61],["αὐτῶν",3,187],["πορεύσονται",49,127],["ἐν",4,1],["τοῖς",1,91],["ἐπιτηδεύμασιν",905,92],["αὐτῶν",3,41]],"So I let them go after the ways of their own hearts: they will go on in their own ways."],["14",[["Εἰ",77,8],["ὁ",1,4],["λαός",35,5],["μου",6,48],["ἤκουσέ",53,3],["μου",6,48],["Ἰσραὴλ",27,105],["ταῖς",1,70],["ὁδοῖς",67,71],["μου",6,48],["εἰ",77,8],["ἐπορεύθη",49,38]],"If my people had hearkened to me, if Israel had walked in my ways,"],["15",[["ἐν",4,1],["τῷ",1,110],["μηδενὶ",910,314],["ἂν",82,12],["τοὺς",1,56],["ἐχθροὺς",135,31],["αὐτῶν",3,41],["ἐταπείνωσα",333,147],["καὶ",2,8],["ἐπὶ",9,1],["τοὺς",1,56],["θλίβοντας",599,229],["αὐτοὺς",3,60],["ἐπέβαλον",724,141],["ἂν",82,12],["τὴν",1,9],["χεῖρά",37,10],["μου",6,48]],"I should have put down their enemies very quickly, and should have laid my hand upon those that afflicted them."],["16",[["Οἱ",1,128],["ἐχθροὶ",135,51],["Κυρίου",7,21],["ἐψεύσαντο",1311,182],["αὐτῷ",3,49],["καὶ",2,8],["ἔσται",10,89],["ὁ",1,4],["καιρὸς",132,5],["αὐτῶν",3,41],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7]],"The Lord's enemies [should have] lied to him: but their time shall be for ever."],["17",[["καὶ",2,8],["ἐψώμισεν",1793,3],["αὐτοὺς",3,60],["ἐκ",21,1],["στέατος",574,24],["πυροῦ",939,250],["καὶ",2,8],["ἐκ",21,1],["πέτρας",546,19],["μέλι",804,20],["ἐχόρτασεν",2405,3],["αὐτούς",3,60]],"And he fed them with the fat of wheat; and satisfied them with honey out of the rock."]]