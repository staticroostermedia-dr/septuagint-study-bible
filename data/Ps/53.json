[["1",[["Εἰς",8,1],["τὸ",1,32],["τέλος",369,33],["ἐν",4,1],["ὕμνοις",1499,139],["συνέσεως",467,19],["τῷ",1,110],["Δαυὶδ",52,105]],"For the end, among the Hymns of instruction by David,"],["2",[["ἐν",4,1],["τῷ",1,110],["ἐλθεῖν",56,100],["τοὺς",1,56],["Ζειφαίους",0,0],["καὶ",2,8],["εἰπεῖν",18,100],["τῷ",1,110],["Σαοὺλ",155,251],["οὐκ",12,17],["ἰδοὺ",51,17],["Δαυὶδ",52,105],["κέκρυπται",378,371],["παρʼ",72,1],["ἡμῖν",6,142]],"when the Ziphites came and said to Saul, Lo, is not David hid with us?"],["3",[["Ὁ",1,4],["Θεὸς",20,5],["ἐν",4,1],["τῷ",1,52],["ὀνόματί",55,53],["σου",5,146],["σῶσόν",171,198],["με",6,82],["καὶ",2,8],["ἐν",4,1],["τῇ",1,95],["δυνάμει",98,2],["σου",5,146],["κρῖνόν",240,36],["με",6,82]],"Save me, O God, by thy name, and judge me by thy might."],["4",[["Ὁ",1,4],["Θεὸς",20,5],["εἰσάκουσον",237,198],["τῆς",1,18],["προσευχῆς",549,19],["μου",6,83],["ἐνώτισαι",1316,296],["τὰ",1,42],["ῥήματα",115,43],["τοῦ",1,23],["στόματός",123,24],["μου",6,48]],"O God, hear my prayer; hearken to the words of my mouth."],["5",[["Ὅτι",19,8],["ἀλλότριοι",377,130],["ἐπανέστησαν",1221,141],["ἐπʼ",9,1],["ἐμὲ",6,82],["καὶ",2,8],["κραταιοὶ",734,166],["ἐζήτησαν",190,141],["τὴν",1,9],["ψυχήν",62,10],["μου",6,48],["οὐ",12,17],["προέθεντο",2622,182],["τὸν",1,6],["Θεὸν",20,7],["ἐνώπιον",114,1],["αὐτῶν",3,41],["διάψαλμα",687,20]],"For strangers have risen up against me, and mighty men have sought my life: they have not set God before them. Pause."],["6",[["Ἰδοὺ",51,17],["γὰρ",40,12],["ὁ",1,4],["Θεὸς",20,5],["βοηθεῖ",552,87],["μοι",6,49],["καὶ",2,8],["ὁ",1,4],["Κύριος",7,5],["ἀντιλήπτωρ",2221,5],["τῆς",1,18],["ψυχῆς",62,19],["μου",6,83]],"For lo! God assists me; and the Lord is the helper of my soul."],["7",[["Ἀποστρέψει",130,120],["τὰ",1,42],["κακὰ",161,65],["τοῖς",1,138],["ἐχθροῖς",135,139],["μου",6,48],["ἐν",4,1],["τῇ",1,95],["ἀληθείᾳ",350,2],["σου",5,146],["ἐξολόθρευσον",291,243],["αὐτούς",3,60]],"He shall return evil to mine enemies; utterly destroy them in thy truth."],["8",[["Ἑκουσίως",4119,17],["θύσω",436,157],["σοι",5,151],["ἐξομολογήσομαι",478,176],["τῷ",1,52],["ὀνόματί",55,53],["σου",5,146],["Κύριε",7,251],["ὅτι",19,8],["ἀγαθόν",113,29]],"I will willingly sacrifice to thee: I will give thanks to thy name, O Lord; for [it is] good."],["9",[["Ὅτι",19,8],["ἐκ",21,1],["πάσης",11,78],["θλίψεως",437,19],["ἐῤῥύσω",335,169],["με",6,82],["καὶ",2,8],["ἐν",4,1],["τοῖς",1,138],["ἐχθροῖς",135,139],["μου",6,48],["ἐπεῖδεν",1866,3],["ὁ",1,4],["ὀφθαλμός",91,5],["μου",6,48]],"For thou hast delivered me out of all affliction, and mine eye has seen [my desire] upon mine enemies."]]