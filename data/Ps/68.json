[["1",[["Εἰς",8,1],["τὸ",1,32],["τέλος",369,33],["ὑπὲρ",139,1],["τῶν",1,76],["ἀλλοιωθησομένων",1289,695],["τῶ",1,30],["Δαυίδ",52,105]],"For the end, [a Psalm] of David, for alternate [strains]."],["2",[["Σώσον",171,171],["με",6,82],["ὁ",1,4],["Θεὸς",20,5],["ὅτι",19,8],["εἰσήλθοσαν",0,0],["ὕδατα",85,43],["ἕως",42,8],["ψυχῆς",62,19],["μου",6,83]],"Save me, O God; for the waters have come in to my soul."],["3",[["Ἐνεπάγην",3009,148],["εἰς",8,1],["ἰλὺν",6624,10],["βυθοῦ",3510,21],["καὶ",2,8],["οὐκ",12,17],["ἔστιν",10,87],["ὑπόστασις",1878,13],["ἦλθον",56,141],["εἰς",8,1],["τὰ",1,42],["βάθη",1503,43],["τῆς",1,18],["θαλάσσης",137,19],["καὶ",2,8],["καταιγὶς",1470,13],["κατεπόντισέ",2732,3],["με",6,82]],"I am stuck fast in deep mire, and there is no standing: I am come in to the depths of the sea, and a storm has overwhelmed me."],["4",[["Ἐκοπίασα",0,0],["κράζων",590,67],["ἐβραγχίασεν",0,0],["ὁ",1,4],["λάρυγξ",2097,5],["μου",6,48],["ἐξέλιπον",321,141],["οἱ",1,128],["ὀφθαλμοί",91,51],["μου",6,48],["ἀπὸ",17,1],["τοῦ",1,30],["ἐλπίζειν",511,54],["με",6,82],["ἐπὶ",9,1],["τὸν",1,6],["Θεόν",20,7],["μου",6,48]],"I am weary [of] crying, my throat has become hoarse; mine eyes have failed by my waiting on my God."],["5",[["Ἐπληθύνθησαν",315,94],["ὑπὲρ",139,1],["τὰς",1,39],["τρίχας",1035,40],["τῆς",1,18],["κεφαλῆς",144,19],["μου",6,83],["οἱ",1,128],["μισοῦντές",355,137],["με",6,98],["δωρεάν",1338,10],["ἐκραταιώθησαν",734,94],["οἱ",1,128],["ἐχθροί",135,51],["μου",6,48],["οἱ",1,128],["ἐκδιώκοντές",2234,137],["με",6,82],["ἀδίκως",402,17],["ἃ",1,11],["οὐχ",12,17],["ἥρπασα",1219,147],["τότε",250,17],["ἀπετίννυον",0,0]],"They that hate me without a cause are more than the hairs of my head: my enemies that persecute me unrighteously are strengthened: then I restored that which I took not away."],["6",[["Ὁ",1,4],["Θεὸς",20,5],["σὺ",5,156],["ἔγνως",81,154],["τὴν",1,9],["ἀφροσύνην",1402,10],["μου",6,48],["καὶ",2,8],["αἱ",1,183],["πλημμελειαί",1017,179],["μου",6,48],["ἀπὸ",17,1],["σοῦ",5,146],["οὐκ",12,17],["ἐκρύβησαν",378,94]],"O God, thou knowest my foolishness; and my transgressions are not hidden from thee."],["7",[["Μὴ",25,8],["αἰσχυνθείησαν",614,410],["ἐπʼ",9,1],["ἐμὲ",6,82],["οἱ",1,128],["ὑπομένοντές",635,137],["σε",5,161],["Κύριε",7,251],["τῶν",1,123],["δυνάμεων",98,61],["μὴ",25,8],["ἐντραπείησαν",1153,410],["ἐπʼ",9,1],["ἐμὲ",6,82],["οἱ",1,128],["ζητοῦντές",190,137],["σε",5,161],["ὁ",1,4],["Θεὸς",20,5],["τοῦ",1,30],["Ἰσραήλ",27,105]],"Let not them that wait on thee, O Lord of hosts, be ashamed on my account: let not them that seek thee, be ashamed on my account, O God of Israel."],["8",[["Ὅτι",19,8],["ἕνεκά",445,1],["σου",5,146],["ὑπήνεγκα",1877,147],["ὀνειδισμὸν",732,7],["ἐκάλυψεν",618,3],["ἐντροπὴ",3439,13],["τὸ",1,32],["πρόσωπόν",47,33],["μου",6,48]],"For I have suffered reproach for thy sake; shame has covered my face."],["9",[["Ἀπηλλοτριωμένος",0,0],["ἐγενήθην",30,148],["τοῖς",1,138],["ἀδελφοῖς",66,139],["μου",6,48],["καὶ",2,8],["ξένος",1830,16],["τοῖς",1,138],["υἱοῖς",13,139],["τῆς",1,18],["μητρός",188,19],["μου",6,83]],"I became strange to my brethren, and a stranger to my mother's children."],["10",[["ὅτι",19,8],["ὁ",1,4],["ζῆλος",1095,5],["τοῦ",1,30],["οἴκου",34,21],["σου",5,146],["κατάφαγέ",404,198],["με",6,82],["καὶ",2,8],["οἱ",1,128],["ὀνειδισμοὶ",732,51],["τῶν",1,76],["ὀνειδιζόντων",946,164],["σε",5,161],["ἐπέπεσον",995,141],["ἐπʼ",9,1],["ἐμέ",6,82]],"For the zeal of thine house has eaten me up; and the reproaches of them that reproached thee are fallen upon me."],["11",[["Καὶ",2,8],["συνέκαμψα",5085,147],["ἐν",4,1],["νηστείᾳ",1416,2],["τὴν",1,9],["ψυχήν",62,10],["μου",6,48],["καὶ",2,8],["ἐγενήθη",30,38],["εἰς",8,1],["ὀνειδισμοὺς",732,31],["ἐμοί",6,49]],"And I bowed down my soul with fasting, and that was made my reproach."],["12",[["Καὶ",2,8],["ἐθέμην",109,152],["τὸ",1,32],["ἔνδυμά",2547,33],["μου",6,48],["σάκκον",848,7],["καὶ",2,8],["ἐγενόμην",30,152],["αὐτοῖς",3,142],["εἰς",8,1],["παραβολήν",1061,10]],"And I put on sackcloth for my covering; and I became a proverb to them."],["13",[["Κατʼ",32,1],["ἐμοῦ",6,48],["ἠδολέσχουν",2515,129],["οἱ",1,128],["καθήμενοι",417,548],["ἐν",4,1],["πύλῃ",162,2],["καὶ",2,8],["εἰς",8,1],["ἐμὲ",6,82],["ἔψαλλον",901,129],["οἱ",1,128],["πίνοντες",215,137],["τὸν",1,6],["οἶνον",261,7]],"They that sit in the gate talked against me, and they that drank wine sang against me."],["14",[["Ἐγὼ",6,158],["δὲ",14,12],["τῇ",1,95],["προσευχῇ",549,2],["μου",6,48],["πρὸς",15,1],["σὲ",5,161],["Κύριε",7,251],["καιρὸς",132,5],["εὐδοκίας",1624,40],["ὁ",1,4],["Θεός",20,5],["ἐν",4,1],["τῷ",1,52],["πλήθει",199,53],["τοῦ",1,23],["ἐλέους",182,24],["σου",5,146],["ἐπάκουσόν",595,198],["μου",6,48],["ἐν",4,1],["ἀληθείᾳ",350,2],["τῆς",1,18],["σωτηρίας",422,19],["σου",5,146]],"But I [will cry] to thee, O Lord, in my prayer; O God, it is a propitious time: in the multitude of thy mercy hear me, in the truth of thy salvation."],["15",[["Σῶσόν",171,198],["με",6,82],["ἀπὸ",17,1],["πηλοῦ",1386,21],["ἵνα",101,8],["μὴ",25,8],["ἐνπαγῶ",3009,569],["ῥυσθείην",335,694],["ἐκ",21,1],["τῶν",1,76],["μισούντων",355,164],["με",6,82],["καὶ",2,8],["ἐκ",21,1],["τοῦ",1,23],["βάθους",1503,24],["τῶν",1,44],["ὑδάτων",85,45]],"Save me from the mire, that I stick not [in it]: let me be delivered from them that hate me, and from the deep waters."],["16",[["Μή",25,8],["με",6,82],["καταποντισάτω",2732,46],["καταιγὶς",1470,13],["ὕδατος",85,24],["μηδὲ",412,12],["καταπιέτω",1183,46],["με",6,82],["βυθὸς",3510,5],["μηδὲ",412,12],["συνσχέτω",0,0],["ἐπʼ",9,1],["ἐμὲ",6,82],["φρέαρ",878,33],["τὸ",1,32],["στόμα",123,33],["αὐτοῦ",3,48]],"Let not the waterflood drown me, nor let the deep swallow me up; neither let the well shut its mouth upon me."],["17",[["Εἰσάκουσόν",237,198],["μου",6,48],["Κύριε",7,251],["ὅτι",19,8],["χρηστὸν",1357,28],["τὸ",1,27],["ἔλεός",182,20],["σου",5,146],["κατὰ",32,1],["τὸ",1,32],["πλῆθος",199,33],["τῶν",1,76],["οἰκτιρμῶν",1188,77],["σου",5,146],["ἐπίβλεψον",516,198],["ἐπʼ",9,1],["ἐμε",6,82]],"Hear me, O Lord; for thy mercy is good: according to the multitude of thy compassions look upon me."],["18",[["Καὶ",2,8],["μὴ",25,8],["ἀποστρέψῃς",130,170],["τὸ",1,32],["πρόσωπόν",47,33],["σου",5,146],["ἀπὸ",17,1],["τοῦ",1,30],["παιδός",126,21],["σου",5,146],["ὅτι",19,8],["θλίβομαι",599,252],["ταχὺ",1391,17],["ἐπάκουσόν",595,198],["μου",6,48]],"And turn not away thy face from thy servant; for I am afflicted: hear me speedily."],["19",[["Πρόσχες",1692,154],["τῇ",1,95],["ψυχῇ",62,2],["μου",6,48],["καὶ",2,8],["λύτρωσαι",548,296],["αὐτὴν",3,98],["ἕνεκα",445,1],["τῶν",1,76],["ἐχθρῶν",135,77],["μου",6,48],["ῥῦσαί",335,275],["με",6,82]],"Draw nigh to my soul and redeem it: deliver me because of mine enemies."],["20",[["Σὺ",5,156],["γὰρ",40,12],["γινώσκεις",81,145],["τὸν",1,6],["ὀνειδισμόν",732,7],["μου",6,48],["καὶ",2,8],["τὴν",1,9],["αἰσχύνην",683,10],["μου",6,48],["καὶ",2,8],["τὴν",1,9],["ἐντροπήν",3439,10],["μου",6,48],["ἐναντίον",138,17],["σου",5,146],["πάντες",11,130],["οἱ",1,128],["θλίβοντές",599,137],["με",6,82]],"For thou knowest my reproach, and my shame, and my confusion; all that afflict me are before thee."],["21",[["Ὀνειδισμὸν",732,7],["προσεδόκησεν",2768,3],["ἡ",1,11],["ψυχή",62,13],["μου",6,48],["καὶ",2,8],["ταλαιπωρίαν",1449,10],["καὶ",2,8],["ὑπέμεινα",635,147],["συλλυπούμενον",6122,201],["καὶ",2,8],["οὐχ",12,17],["ὑπῆρξε",416,3],["καὶ",2,8],["παρακαλοῦντα",432,292],["καὶ",2,8],["οὐχ",12,17],["εὗρον",106,141]],"My soul has waited for reproach and misery; and I waited for one to grieve with me, but there was none; and for one to comfort me, but I found none."],["22",[["Καὶ",2,8],["ἔδωκαν",33,141],["εἰς",8,1],["τὸ",1,32],["βρῶμά",714,33],["μου",6,48],["χολὴν",2136,10],["καὶ",2,8],["εἰς",8,1],["τὴν",1,9],["δίψαν",2357,10],["μου",6,48],["ἐπότισάν",788,141],["με",6,82],["ὄξος",4143,33]],"They gave [me] also gall for my food, and made me drink vinegar for my thirst."],["23",[["Γενηθήτω",30,25],["ἡ",1,11],["τράπεζα",644,13],["αὐτῶν",3,41],["ἐνώπιον",114,1],["αὐτῶν",3,41],["εἰς",8,1],["παγίδα",815,10],["καὶ",2,8],["εἰς",8,1],["ἀνταπόδοσιν",2412,10],["καὶ",2,8],["εἰς",8,1],["σκάνδαλον",1838,20]],"Let their table before them be for a snare, and for a recompence, and for a stumbling-block."],["24",[["Σκοτισθήτωσαν",4404,50],["οἱ",1,128],["ὀφθαλμοὶ",91,51],["αὐτῶν",3,41],["τοῦ",1,30],["μὴ",25,8],["βλέπειν",469,54],["καὶ",2,8],["τὸν",1,6],["νῶτον",2194,7],["αὐτῶν",3,41],["διαπαντὸς",506,17],["σύγκαμψον",5085,243]],"Let their eyes be darkened that they should not see; and bow down their back continually."],["25",[["Ἔκχεον",435,198],["ἐπʼ",9,1],["αὐτοὺς",3,60],["τὴν",1,9],["ὀργήν",198,10],["σου",5,146],["καὶ",2,8],["ὁ",1,4],["θυμὸς",177,5],["τῆς",1,18],["ὀργῆς",198,19],["σου",5,146],["καταλάβοι",537,276],["αὐτούς",3,60]],"Pour out thy wrath upon them, and let the fury of thine anger take hold on them."],["26",[["Γενηθήτω",30,25],["ἡ",1,11],["ἔπαυλις",1174,13],["αὐτῶν",3,41],["ἠρημωμένη",0,0],["καὶ",2,8],["ἐν",4,1],["τοῖς",1,91],["σκηνώμασιν",680,92],["αὐτῶν",3,41],["μὴ",25,8],["ἔστω",10,35],["ὁ",1,4],["κατοικῶν",90,67]],"Let their habitation be made desolate; and let there be no inhabitant in their tents:"],["27",[["ὅτι",19,8],["ὃν",24,106],["σὺ",5,156],["ἐπάταξας",145,154],["αὐτοὶ",3,193],["κατεδίωξαν",619,141],["καὶ",2,8],["ἐπὶ",9,1],["τὸ",1,32],["ἄλγος",3727,33],["τῶν",1,44],["τραυμάτων",2132,45],["μου",6,48],["προσέθηκαν",200,141]],"because they persecuted him whom thou hast smitten; and they have added to the grief of my wounds."],["28",[["Πρόσθες",200,198],["ἀνομίαν",274,10],["ἐπὶ",9,1],["τὴν",1,9],["ἀνομίαν",274,10],["αὐτῶν",3,41],["καὶ",2,8],["μὴ",25,8],["εἰσελθέτωσαν",0,0],["ἐν",4,1],["δικαιοσύνῃ",185,2],["σου",5,146]],"Add iniquity to their iniquity; and let them not come into thy righteousness."],["29",[["Ἐξαλειφθήτωσαν",1086,50],["ἐκ",21,1],["βίβλου",1465,19],["ζώντων",117,164],["καὶ",2,8],["μετὰ",29,1],["δικαίων",152,163],["μὴ",25,8],["γραφήτωσαν",0,0]],"Let them be blotted out of the book of the living, and let them not be written with the righteous."],["30",[["Πτωχὸς",496,5],["καὶ",2,8],["ἀλγῶν",3400,67],["εἰμι",10,149],["ἐγὼ",6,158],["καὶ",2,8],["ἡ",1,11],["σωτηρία",422,13],["τοῦ",1,23],["προσώπου",47,24],["σου",5,146],["ἀντελάβετό",984,26],["μου",6,48]],"I am poor and sorrowful; but the salvation of thy countenance has helped me."],["31",[["Αἰνέσω",399,157],["τὸ",1,32],["ὄνομα",55,33],["τοῦ",1,30],["Θεοῦ",20,21],["μου",6,48],["μετʼ",29,1],["ᾠδῆς",773,19],["μεγαλυνῶ",606,157],["αὐτὸν",3,82],["ἐν",4,1],["αἰνέσει",399,120]],"I will praise the name of my God with a song, I will magnify him with praise;"],["32",[["καὶ",2,8],["ἀρέσει",957,120],["τῷ",1,110],["Θεῷ",20,113],["ὑπὲρ",139,1],["μόσχον",256,7],["νέον",513,59],["κέρατα",567,43],["ἐκφέροντα",622,232],["καὶ",2,8],["ὁπλάς",2009,40]],"and [this] shall please God more than a young calf having horns and hoofs."],["33",[["Ἰδέτωσαν",0,0],["πτωχοὶ",496,51],["καὶ",2,8],["εὐφρανθήτωσαν",242,50],["ἐκζητήσατε",459,69],["τὸν",1,6],["Θεὸν",20,7],["καὶ",2,8],["ζήσεσθε",117,117]],"Let the poor see and rejoice; seek the Lord diligently, and ye shall live."],["34",[["Ὅτι",19,8],["εἰσήκουσε",237,3],["τῶν",1,76],["πενήτων",668,77],["ὁ",1,4],["Κύριος",7,5],["καὶ",2,8],["τοὺς",1,56],["πεπεδημένους",0,0],["αὐτοῦ",3,48],["οὐκ",12,17],["ἐξουδένωσεν",1069,3]],"For the Lord hears the poor, and does not set at nought his fettered ones."],["35",[["Αἰνεσάτωσαν",399,261],["αὐτὸν",3,82],["οἱ",1,128],["οὐρανοὶ",94,51],["καὶ",2,8],["ἡ",1,11],["γῆ",26,13],["θάλασσα",137,13],["καὶ",2,8],["πάντα",11,65],["τὰ",1,42],["ἕρποντα",2431,232],["ἐν",4,1],["αὐτοῖς",3,142]],"Let the heavens and the earth praise him, the sea, and all things moving in them."],["36",[["Ὅτι",19,8],["ὁ",1,4],["Θεὸς",20,5],["σώσει",171,120],["τὴν",1,9],["Σιὼν",331,2],["καὶ",2,8],["οἰκοδομηθήσονται",125,135],["αἱ",1,183],["πόλεις",41,179],["τῆς",1,18],["Ἰουδαίας",491,19],["καὶ",2,8],["κατοικήσουσιν",90,207],["ἐκεῖ",76,17],["καὶ",2,8],["κληρονομήσουσιν",368,207],["αὐτήν",3,98]],"For God will save Sion, and the cities of Judea shall be built; and [men] shall dwell there, and inherit it."],["37",[["Καὶ",2,8],["τὸ",1,32],["σπέρμα",214,33],["τῶν",1,76],["δούλων",136,77],["αὐτοῦ",3,48],["καθέξουσιν",1057,207],["αὐτὴν",3,98],["καὶ",2,8],["οἱ",1,128],["ἀγαπῶντες",224,137],["τὸ",1,32],["ὄνομα",55,33],["αὐτοῦ",3,48],["κατασκηνώσουσιν",802,207],["ἐν",4,1],["αὐτῇ",3,99]],"And the seed of his servants shall possess it, and they that love his name shall dwell therein."]]