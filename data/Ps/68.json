[["1",[["Εἰς",8,1],["τὸ",1,32],["τέλος",373,33],["ὑπὲρ",139,1],["τῶν",1,76],["ἀλλοιωθησομένων",1231,673],["τῶ",1,30],["Δαυίδ",52,105]],"For the end, [a Psalm] of David, for alternate [strains]."],["2",[["Σώσον",172,171],["με",6,82],["ὁ",1,4],["Θεὸς",20,5],["ὅτι",19,8],["εἰσήλθοσαν",86,141],["ὕδατα",85,43],["ἕως",42,8],["ψυχῆς",63,19],["μου",6,83]],"Save me, O God; for the waters have come in to my soul."],["3",[["Ἐνεπάγην",2997,148],["εἰς",8,1],["ἰλὺν",6585,10],["βυθοῦ",3507,21],["καὶ",2,8],["οὐκ",12,17],["ἔστιν",10,87],["ὑπόστασις",1877,13],["ἦλθον",55,141],["εἰς",8,1],["τὰ",1,42],["βάθη",1502,43],["τῆς",1,18],["θαλάσσης",137,19],["καὶ",2,8],["καταιγὶς",1470,13],["κατεπόντισέ",2726,3],["με",6,82]],"I am stuck fast in deep mire, and there is no standing: I am come in to the depths of the sea, and a storm has overwhelmed me."],["4",[["Ἐκοπίασα",921,147],["κράζων",592,67],["ἐβραγχίασεν",6865,3],["ὁ",1,4],["λάρυγξ",2092,5],["μου",6,48],["ἐξέλιπον",321,141],["οἱ",1,128],["ὀφθαλμοί",91,51],["μου",6,48],["ἀπὸ",17,1],["τοῦ",1,30],["ἐλπίζειν",514,54],["με",6,82],["ἐπὶ",9,1],["τὸν",1,6],["Θεόν",20,7],["μου",6,48]],"I am weary [of] crying, my throat has become hoarse; mine eyes have failed by my waiting on my God."],["5",[["Ἐπληθύνθησαν",316,94],["ὑπὲρ",139,1],["τὰς",1,39],["τρίχας",1038,40],["τῆς",1,18],["κεφαλῆς",144,19],["μου",6,83],["οἱ",1,128],["μισοῦντές",351,137],["με",6,98],["δωρεάν",1341,10],["ἐκραταιώθησαν",729,94],["οἱ",1,128],["ἐχθροί",135,51],["μου",6,48],["οἱ",1,128],["ἐκδιώκοντές",2220,137],["με",6,82],["ἀδίκως",406,17],["ἃ",1,11],["οὐχ",12,17],["ἥρπασα",1214,147],["τότε",250,17],["ἀπετίννυον",0,0]],"They that hate me without a cause are more than the hairs of my head: my enemies that persecute me unrighteously are strengthened: then I restored that which I took not away."],["6",[["Ὁ",1,4],["Θεὸς",20,5],["σὺ",5,156],["ἔγνως",79,154],["τὴν",1,9],["ἀφροσύνην",1401,10],["μου",6,48],["καὶ",2,8],["αἱ",1,185],["πλημμελειαί",1018,180],["μου",6,48],["ἀπὸ",17,1],["σοῦ",5,146],["οὐκ",12,17],["ἐκρύβησαν",372,94]],"O God, thou knowest my foolishness; and my transgressions are not hidden from thee."],["7",[["Μὴ",25,8],["αἰσχυνθείησαν",611,403],["ἐπʼ",9,1],["ἐμὲ",6,82],["οἱ",1,128],["ὑπομένοντές",639,137],["σε",5,161],["Κύριε",7,250],["τῶν",1,123],["δυνάμεων",98,61],["μὴ",25,8],["ἐντραπείησαν",1105,403],["ἐπʼ",9,1],["ἐμὲ",6,82],["οἱ",1,128],["ζητοῦντές",191,137],["σε",5,161],["ὁ",1,4],["Θεὸς",20,5],["τοῦ",1,30],["Ἰσραήλ",27,105]],"Let not them that wait on thee, O Lord of hosts, be ashamed on my account: let not them that seek thee, be ashamed on my account, O God of Israel."],["8",[["Ὅτι",19,8],["ἕνεκά",447,1],["σου",5,146],["ὑπήνεγκα",1876,147],["ὀνειδισμὸν",733,7],["ἐκάλυψεν",620,3],["ἐντροπὴ",3435,13],["τὸ",1,32],["πρόσωπόν",47,33],["μου",6,48]],"For I have suffered reproach for thy sake; shame has covered my face."],["9",[["Ἀπηλλοτριωμένος",2658,408],["ἐγενήθην",30,148],["τοῖς",1,138],["ἀδελφοῖς",67,139],["μου",6,48],["καὶ",2,8],["ξένος",1828,16],["τοῖς",1,138],["υἱοῖς",13,139],["τῆς",1,18],["μητρός",189,19],["μου",6,83]],"I became strange to my brethren, and a stranger to my mother's children."],["10",[["ὅτι",19,8],["ὁ",1,4],["ζῆλος",1164,5],["τοῦ",1,30],["οἴκου",34,21],["σου",5,146],["κατάφαγέ",407,198],["με",6,82],["καὶ",2,8],["οἱ",1,128],["ὀνειδισμοὶ",733,51],["τῶν",1,76],["ὀνειδιζόντων",945,164],["σε",5,161],["ἐπέπεσον",995,141],["ἐπʼ",9,1],["ἐμέ",6,82]],"For the zeal of thine house has eaten me up; and the reproaches of them that reproached thee are fallen upon me."],["11",[["Καὶ",2,8],["συνέκαμψα",5059,147],["ἐν",4,1],["νηστείᾳ",1415,2],["τὴν",1,9],["ψυχήν",63,10],["μου",6,48],["καὶ",2,8],["ἐγενήθη",30,38],["εἰς",8,1],["ὀνειδισμοὺς",733,31],["ἐμοί",6,49]],"And I bowed down my soul with fasting, and that was made my reproach."],["12",[["Καὶ",2,8],["ἐθέμην",110,152],["τὸ",1,32],["ἔνδυμά",2543,33],["μου",6,48],["σάκκον",847,7],["καὶ",2,8],["ἐγενόμην",30,152],["αὐτοῖς",3,142],["εἰς",8,1],["παραβολήν",1061,10]],"And I put on sackcloth for my covering; and I became a proverb to them."],["13",[["Κατʼ",32,1],["ἐμοῦ",6,48],["ἠδολέσχουν",2512,129],["οἱ",1,128],["καθήμενοι",419,539],["ἐν",4,1],["πύλῃ",162,2],["καὶ",2,8],["εἰς",8,1],["ἐμὲ",6,82],["ἔψαλλον",913,129],["οἱ",1,128],["πίνοντες",212,137],["τὸν",1,6],["οἶνον",261,7]],"They that sit in the gate talked against me, and they that drank wine sang against me."],["14",[["Ἐγὼ",6,158],["δὲ",14,12],["τῇ",1,95],["προσευχῇ",550,2],["μου",6,48],["πρὸς",15,1],["σὲ",5,161],["Κύριε",7,250],["καιρὸς",132,5],["εὐδοκίας",1625,40],["ὁ",1,4],["Θεός",20,5],["ἐν",4,1],["τῷ",1,52],["πλήθει",200,53],["τοῦ",1,23],["ἐλέους",183,24],["σου",5,146],["ἐπάκουσόν",597,198],["μου",6,48],["ἐν",4,1],["ἀληθείᾳ",352,2],["τῆς",1,18],["σωτηρίας",425,19],["σου",5,146]],"But I [will cry] to thee, O Lord, in my prayer; O God, it is a propitious time: in the multitude of thy mercy hear me, in the truth of thy salvation."],["15",[["Σῶσόν",172,198],["με",6,82],["ἀπὸ",17,1],["πηλοῦ",1386,21],["ἵνα",102,8],["μὴ",25,8],["ἐνπαγῶ",2997,555],["ῥυσθείην",337,672],["ἐκ",21,1],["τῶν",1,76],["μισούντων",351,164],["με",6,82],["καὶ",2,8],["ἐκ",21,1],["τοῦ",1,23],["βάθους",1502,24],["τῶν",1,44],["ὑδάτων",85,45]],"Save me from the mire, that I stick not [in it]: let me be delivered from them that hate me, and from the deep waters."],["16",[["Μή",25,8],["με",6,82],["καταποντισάτω",2726,46],["καταιγὶς",1470,13],["ὕδατος",85,24],["μηδὲ",414,12],["καταπιέτω",1183,46],["με",6,82],["βυθὸς",3507,5],["μηδὲ",414,12],["συνσχέτω",0,0],["ἐπʼ",9,1],["ἐμὲ",6,82],["φρέαρ",877,33],["τὸ",1,32],["στόμα",123,33],["αὐτοῦ",3,48]],"Let not the waterflood drown me, nor let the deep swallow me up; neither let the well shut its mouth upon me."],["17",[["Εἰσάκουσόν",241,198],["μου",6,48],["Κύριε",7,250],["ὅτι",19,8],["χρηστὸν",1359,28],["τὸ",1,27],["ἔλεός",183,20],["σου",5,146],["κατὰ",32,1],["τὸ",1,32],["πλῆθος",200,33],["τῶν",1,76],["οἰκτιρμῶν",1187,77],["σου",5,146],["ἐπίβλεψον",517,198],["ἐπʼ",9,1],["ἐμε",6,82]],"Hear me, O Lord; for thy mercy is good: according to the multitude of thy compassions look upon me."],["18",[["Καὶ",2,8],["μὴ",25,8],["ἀποστρέψῃς",130,170],["τὸ",1,32],["πρόσωπόν",47,33],["σου",5,146],["ἀπὸ",17,1],["τοῦ",1,30],["παιδός",127,21],["σου",5,146],["ὅτι",19,8],["θλίβομαι",601,251],["ταχὺ",1389,17],["ἐπάκουσόν",597,198],["μου",6,48]],"And turn not away thy face from thy servant; for I am afflicted: hear me speedily."],["19",[["Πρόσχες",1689,154],["τῇ",1,95],["ψυχῇ",63,2],["μου",6,48],["καὶ",2,8],["λύτρωσαι",535,275],["αὐτὴν",3,98],["ἕνεκα",447,1],["τῶν",1,76],["ἐχθρῶν",135,77],["μου",6,48],["ῥῦσαί",337,275],["με",6,82]],"Draw nigh to my soul and redeem it: deliver me because of mine enemies."],["20",[["Σὺ",5,156],["γὰρ",40,12],["γινώσκεις",79,145],["τὸν",1,6],["ὀνειδισμόν",733,7],["μου",6,48],["καὶ",2,8],["τὴν",1,9],["αἰσχύνην",685,10],["μου",6,48],["καὶ",2,8],["τὴν",1,9],["ἐντροπήν",3435,10],["μου",6,48],["ἐναντίον",138,17],["σου",5,146],["πάντες",11,130],["οἱ",1,128],["θλίβοντές",601,137],["με",6,82]],"For thou knowest my reproach, and my shame, and my confusion; all that afflict me are before thee."],["21",[["Ὀνειδισμὸν",733,7],["προσεδόκησεν",2758,3],["ἡ",1,11],["ψυχή",63,13],["μου",6,48],["καὶ",2,8],["ταλαιπωρίαν",1448,10],["καὶ",2,8],["ὑπέμεινα",639,147],["συλλυπούμενον",6094,201],["καὶ",2,8],["οὐχ",12,17],["ὑπῆρξε",418,3],["καὶ",2,8],["παρακαλοῦντα",434,289],["καὶ",2,8],["οὐχ",12,17],["εὗρον",101,141]],"My soul has waited for reproach and misery; and I waited for one to grieve with me, but there was none; and for one to comfort me, but I found none."],["22",[["Καὶ",2,8],["ἔδωκαν",33,141],["εἰς",8,1],["τὸ",1,32],["βρῶμά",714,33],["μου",6,48],["χολὴν",2129,10],["καὶ",2,8],["εἰς",8,1],["τὴν",1,9],["δίψαν",2346,10],["μου",6,48],["ἐπότισάν",790,141],["με",6,82],["ὄξος",4132,33]],"They gave [me] also gall for my food, and made me drink vinegar for my thirst."],["23",[["Γενηθήτω",30,25],["ἡ",1,11],["τράπεζα",650,13],["αὐτῶν",3,41],["ἐνώπιον",115,1],["αὐτῶν",3,41],["εἰς",8,1],["παγίδα",817,10],["καὶ",2,8],["εἰς",8,1],["ἀνταπόδοσιν",2403,10],["καὶ",2,8],["εἰς",8,1],["σκάνδαλον",1834,20]],"Let their table before them be for a snare, and for a recompence, and for a stumbling-block."],["24",[["Σκοτισθήτωσαν",3951,50],["οἱ",1,128],["ὀφθαλμοὶ",91,51],["αὐτῶν",3,41],["τοῦ",1,30],["μὴ",25,8],["βλέπειν",470,54],["καὶ",2,8],["τὸν",1,6],["νῶτον",2181,7],["αὐτῶν",3,41],["διαπαντὸς",510,17],["σύγκαμψον",5059,198]],"Let their eyes be darkened that they should not see; and bow down their back continually."],["25",[["Ἔκχεον",436,198],["ἐπʼ",9,1],["αὐτοὺς",3,60],["τὴν",1,9],["ὀργήν",198,10],["σου",5,146],["καὶ",2,8],["ὁ",1,4],["θυμὸς",178,5],["τῆς",1,18],["ὀργῆς",198,19],["σου",5,146],["καταλάβοι",532,216],["αὐτούς",3,60]],"Pour out thy wrath upon them, and let the fury of thine anger take hold on them."],["26",[["Γενηθήτω",30,25],["ἡ",1,11],["ἔπαυλις",1173,13],["αὐτῶν",3,41],["ἠρημωμένη",740,197],["καὶ",2,8],["ἐν",4,1],["τοῖς",1,91],["σκηνώμασιν",682,92],["αὐτῶν",3,41],["μὴ",25,8],["ἔστω",10,35],["ὁ",1,4],["κατοικῶν",89,67]],"Let their habitation be made desolate; and let there be no inhabitant in their tents:"],["27",[["ὅτι",19,8],["ὃν",24,106],["σὺ",5,156],["ἐπάταξας",145,154],["αὐτοὶ",3,195],["κατεδίωξαν",621,141],["καὶ",2,8],["ἐπὶ",9,1],["τὸ",1,32],["ἄλγος",3720,33],["τῶν",1,44],["τραυμάτων",2124,45],["μου",6,48],["προσέθηκαν",201,141]],"because they persecuted him whom thou hast smitten; and they have added to the grief of my wounds."],["28",[["Πρόσθες",201,198],["ἀνομίαν",275,10],["ἐπὶ",9,1],["τὴν",1,9],["ἀνομίαν",275,10],["αὐτῶν",3,41],["καὶ",2,8],["μὴ",25,8],["εἰσελθέτωσαν",86,261],["ἐν",4,1],["δικαιοσύνῃ",187,2],["σου",5,146]],"Add iniquity to their iniquity; and let them not come into thy righteousness."],["29",[["Ἐξαλειφθήτωσαν",1085,50],["ἐκ",21,1],["βίβλου",1465,19],["ζώντων",107,164],["καὶ",2,8],["μετὰ",29,1],["δικαίων",153,163],["μὴ",25,8],["γραφήτωσαν",186,50]],"Let them be blotted out of the book of the living, and let them not be written with the righteous."],["30",[["Πτωχὸς",497,5],["καὶ",2,8],["ἀλγῶν",3394,67],["εἰμι",10,149],["ἐγὼ",6,158],["καὶ",2,8],["ἡ",1,11],["σωτηρία",425,13],["τοῦ",1,23],["προσώπου",47,24],["σου",5,146],["ἀντελάβετό",984,26],["μου",6,48]],"I am poor and sorrowful; but the salvation of thy countenance has helped me."],["31",[["Αἰνέσω",402,157],["τὸ",1,32],["ὄνομα",57,33],["τοῦ",1,30],["Θεοῦ",20,21],["μου",6,48],["μετʼ",29,1],["ᾠδῆς",776,19],["μεγαλυνῶ",604,157],["αὐτὸν",3,82],["ἐν",4,1],["αἰνέσει",402,120]],"I will praise the name of my God with a song, I will magnify him with praise;"],["32",[["καὶ",2,8],["ἀρέσει",955,120],["τῷ",1,110],["Θεῷ",20,113],["ὑπὲρ",139,1],["μόσχον",256,7],["νέον",515,59],["κέρατα",569,43],["ἐκφέροντα",624,232],["καὶ",2,8],["ὁπλάς",2001,40]],"and [this] shall please God more than a young calf having horns and hoofs."],["33",[["Ἰδέτωσαν",53,261],["πτωχοὶ",497,51],["καὶ",2,8],["εὐφρανθήτωσαν",244,50],["ἐκζητήσατε",460,69],["τὸν",1,6],["Θεὸν",20,7],["καὶ",2,8],["ζήσεσθε",107,117]],"Let the poor see and rejoice; seek the Lord diligently, and ye shall live."],["34",[["Ὅτι",19,8],["εἰσήκουσε",241,3],["τῶν",1,76],["πενήτων",672,77],["ὁ",1,4],["Κύριος",7,5],["καὶ",2,8],["τοὺς",1,56],["πεπεδημένους",2280,369],["αὐτοῦ",3,48],["οὐκ",12,17],["ἐξουδένωσεν",1068,3]],"For the Lord hears the poor, and does not set at nought his fettered ones."],["35",[["Αἰνεσάτωσαν",402,261],["αὐτὸν",3,82],["οἱ",1,128],["οὐρανοὶ",94,51],["καὶ",2,8],["ἡ",1,11],["γῆ",26,13],["θάλασσα",137,13],["καὶ",2,8],["πάντα",11,65],["τὰ",1,42],["ἕρποντα",2426,232],["ἐν",4,1],["αὐτοῖς",3,142]],"Let the heavens and the earth praise him, the sea, and all things moving in them."],["36",[["Ὅτι",19,8],["ὁ",1,4],["Θεὸς",20,5],["σώσει",172,120],["τὴν",1,9],["Σιὼν",334,2],["καὶ",2,8],["οἰκοδομηθήσονται",126,135],["αἱ",1,185],["πόλεις",41,180],["τῆς",1,18],["Ἰουδαίας",492,19],["καὶ",2,8],["κατοικήσουσιν",89,207],["ἐκεῖ",76,17],["καὶ",2,8],["κληρονομήσουσιν",370,207],["αὐτήν",3,98]],"For God will save Sion, and the cities of Judea shall be built; and [men] shall dwell there, and inherit it."],["37",[["Καὶ",2,8],["τὸ",1,32],["σπέρμα",218,33],["τῶν",1,76],["δούλων",136,77],["αὐτοῦ",3,48],["καθέξουσιν",1040,207],["αὐτὴν",3,98],["καὶ",2,8],["οἱ",1,128],["ἀγαπῶντες",214,137],["τὸ",1,32],["ὄνομα",57,33],["αὐτοῦ",3,48],["κατασκηνώσουσιν",805,207],["ἐν",4,1],["αὐτῇ",3,99]],"And the seed of his servants shall possess it, and they that love his name shall dwell therein."]]