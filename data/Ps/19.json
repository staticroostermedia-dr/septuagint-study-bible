[["1",[["Εἰς",8,1],["τὸ",1,32],["τέλος",369,33],["ψαλμὸς",639,5],["τῷ",1,110],["Δαυίδ",52,105]],"For the end, a Psalm of David."],["2",[["Ἐπακούσαι",595,276],["σου",5,146],["Κύριος",7,5],["ἐν",4,1],["ἡμέρᾳ",28,2],["θλίψεως",437,19],["ὑπερασπίσαι",1755,100],["σου",5,146],["τὸ",1,32],["ὄνομα",55,33],["τοῦ",1,30],["Θεοῦ",20,21],["Ἰακώβ",146,105]],"The Lord hear thee in the day of trouble; the name of the God of Jacob defend thee."],["3",[["Ἐξαποστείλαι",217,276],["σοι",5,151],["βοήθειαν",761,10],["ἐξ",21,1],["ἁγίου",75,88],["καὶ",2,8],["ἐκ",21,1],["Σιὼν",331,2],["ἀντιλάβοιτό",984,397],["σου",5,146]],"Send thee help from the sanctuary, and aid thee out of Sion."],["4",[["Μνησθείη",231,555],["πάσης",11,78],["θυσίας",156,19],["σου",5,146],["καὶ",2,8],["τὸ",1,32],["ὁλοκαύτωμά",317,33],["σου",5,146],["πιανάτω",3336,46],["διάψαλμα",687,20]],"Remember all thy sacrifice, and enrich thy whole-burnt-offering. Pause."],["5",[["Δῴη",33,276],["σοι",5,151],["κατὰ",32,1],["τὴν",1,9],["καρδίαν",63,10],["σου",5,146],["καὶ",2,8],["πᾶσαν",11,37],["τὴν",1,9],["βουλήν",349,10],["σου",5,146],["πληρώσαι",529,276]],"Grant thee according to thy heart, and fulfil all thy desire."],["6",[["Ἀγαλλιασόμεθα",737,132],["ἐν",4,1],["τῷ",1,110],["σωτηρίῳ",1787,111],["σου",5,146],["καὶ",2,8],["ἐν",4,1],["ὀνόματι",55,53],["Θεοῦ",20,21],["ἡμῶν",6,41],["μεγαλυνθησόμεθα",606,353],["πληρώσαι",529,276],["Κύριος",7,5],["πάντα",11,65],["τὰ",1,42],["αἰτήματά",2262,43],["σου",5,146]],"We will exult in thy salvation, and in the name of our God shall we be magnified: the Lord fulfil all thy petitions."],["7",[["Νῦν",89,17],["ἔγνων",81,147],["ὅτι",19,8],["ἔσωσε",171,3],["Κύριος",7,5],["τὸν",1,6],["χριστὸν",1073,7],["αὐτοῦ",3,48],["ἐπακούσεται",595,89],["αὐτοῦ",3,48],["ἐξ",21,1],["οὐρανοῦ",94,21],["ἁγίου",75,153],["αὐτοῦ",3,48],["ἐν",4,1],["δυναστείαις",919,71],["ἡ",1,11],["σωτηρία",422,13],["τῆς",1,18],["δεξιᾶς",282,78],["αὐτοῦ",3,48]],"Now I know that the Lord has saved his Christ: he shall hear him from his holy heaven: the salvation of his right hand is mighty."],["8",[["Οὗτοι",16,213],["ἐν",4,1],["ἅρμασι",359,92],["καὶ",2,8],["οὗτοι",16,213],["ἐν",4,1],["ἵπποις",308,139],["ἡμεῖς",6,193],["δὲ",14,12],["ἐν",4,1],["ὀνόματι",55,53],["Κυρίου",7,21],["Θεοῦ",20,21],["ἡμῶν",6,41],["μεγαλυνθησόμεθα",606,353]],"Some [glory] in chariots, and some in horses: but we will glory in the name of the Lord our God."],["9",[["Αὐτοὶ",3,193],["συνεποδίσθησαν",3364,94],["καὶ",2,8],["ἔπεσαν",154,141],["ἡμεῖς",6,193],["δὲ",14,12],["ἀνέστημεν",121,288],["καὶ",2,8],["ἀνωρθώθημεν",2518,498]],"They are overthrown and fallen: but we are risen, and have been set upright."],["10",[["Κύριε",7,251],["σῶσον",171,559],["τὸν",1,6],["βασιλέα",22,7],["καὶ",2,8],["ἐπάκουσον",595,198],["ἡμῶν",6,41],["ἐν",4,1],["ᾗ",24,102],["ἂν",82,12],["ἡμέρᾳ",28,2],["ἐπικαλεσώμεθά",340,270],["σε",5,161]],"O Lord, save the king: and hear us in whatever day we call upon thee."]]