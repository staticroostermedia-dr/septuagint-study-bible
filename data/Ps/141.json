[["1",[["Συνέσεως",467,19],["τῷ",1,110],["Δαυὶδ",52,105],["ἐν",4,1],["τῷ",1,110],["εἶναι",10,54],["αὐτὸν",3,82],["ἐν",4,1],["τῷ",1,52],["σπηλαίῳ",940,53],["προσευχή",549,13]],"[A Psalm] of instruction for David, when he was in the cave,—a Prayer."],["2",[["Φωνῇ",95,2],["μου",6,48],["πρὸς",15,1],["Κύριον",7,7],["ἐκέκραξα",590,147],["φωνῇ",95,2],["μου",6,48],["πρὸς",15,1],["Κύριον",7,7],["ἐδεήθην",1674,148]],"I cried to the Lord with my voice; with my voice I made supplication to the Lord."],["3",[["Ἐκχεῶ",435,157],["ἐναντίον",138,17],["αὐτοῦ",3,48],["τὴν",1,9],["δέησίν",674,10],["μου",6,48],["τὴν",1,9],["θλίψιν",437,10],["μου",6,48],["ἐνώπιον",114,1],["αὐτοῦ",3,48],["ἀπαγγελῶ",272,157]],"I will pour out before him my supplication: I will declare before him mine affliction."],["4",[["Ἐν",4,1],["τῷ",1,110],["ἐκλείπειν",321,54],["ἐξ",21,1],["ἐμοῦ",6,48],["τὸ",1,32],["πνεῦμά",167,33],["μου",6,48],["καὶ",2,8],["σὺ",5,156],["ἔγνως",81,154],["τὰς",1,39],["τρίβους",744,40],["μου",6,48],["ἐν",4,1],["ὁδῷ",67,2],["ταύτῃ",16,200],["ᾗ",24,102],["ἐπορευόμην",49,380],["ἔκρυψαν",378,141],["παγίδα",815,10],["μοι",6,49]],"When my spirit was fainting within me, then thou knewest my paths; in the very way wherein I was walking, they hid a snare for me."],["5",[["Κατενόουν",1547,297],["εἰς",8,1],["τὰ",1,42],["δεξιὰ",282,65],["καὶ",2,8],["ἐπέβλεπον",516,129],["ὅτι",19,8],["οὐκ",12,17],["ἦν",10,14],["ὁ",1,4],["ἐπιγινώσκων",433,67],["με",6,82],["ἀπώλετο",594,26],["φυγὴ",2133,13],["ἀπʼ",17,1],["ἐμοῦ",6,48],["καὶ",2,8],["οὐκ",12,17],["ἔστιν",10,87],["ὁ",1,4],["ἐκζητῶν",459,67],["τὴν",1,9],["ψυχήν",62,10],["μου",6,48]],"I looked on [my] right hand, and behold, for there was none that noticed me; refuge failed me; and there was none that cared for my soul."],["6",[["Πρὸς",15,1],["σὲ",5,161],["Κύριε",7,251],["ἐκέραξα",0,0],["καὶ",2,8],["εἶπα",18,147],["σὺ",5,156],["εἶ",10,145],["ἡ",1,11],["ἐλπίς",527,13],["μου",6,48],["μερίς",396,13],["μου",6,48],["ἐν",4,1],["γῇ",26,2],["ζώντων",117,164]],"I cried unto thee, O Lord, and said, Thou art my hope, my portion in the land of the living."],["7",[["Πρόσχες",1692,154],["πρὸς",15,1],["τὴν",1,9],["δέησίν",674,10],["μου",6,48],["ὅτι",19,8],["ἐταπεινώθην",333,148],["σφόδρα",149,17],["ῥῦσαί",335,275],["με",6,82],["ἐκ",21,1],["τῶν",1,76],["καταδιωκόντων",619,164],["με",6,82],["ὅτι",19,8],["ἐκραταιώθησαν",734,94],["ὑπὲρ",139,1],["ἐμέ",6,82]],"Attend to my supplication, for I am brought very low; deliver me from them that persecute me; for they are stronger than I."],["8",[["Ἐξάγαγε",299,198],["ἐκ",21,1],["φυλακῆς",483,19],["τὴν",1,9],["ψυχήν",62,10],["μου",6,48],["τοῦ",1,30],["ἐξομολογήσασθαι",478,103],["τῷ",1,52],["ὀνόματί",55,53],["σου",5,146],["Κύριε",7,251],["ἐμὲ",6,82],["ὑπομενοῦσι",635,207],["δίκαιοι",152,130],["ἕως",42,8],["οὗ",120,17],["ἀνταποδῷς",661,170],["μοι",6,49]],"Bring my soul out of prison, that I may give thanks to thy name, O Lord; the righteous shall wait for me, until thou recompense me."]]