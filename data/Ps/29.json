[["1",[["Εἰς",8,1],["τὸ",1,32],["τέλος",373,33],["ψαλμὸς",644,5],["ᾠδῆς",776,19],["τοῦ",1,30],["ἐνκαινισμοῦ",0,0],["τοῦ",1,30],["οἴκου",34,21],["τοῦ",1,30],["Δαυίδ",52,105]],"For the end, a Psalm and Song at the dedication of the house of David."],["2",[["Ὑψώσω",331,157],["σε",5,161],["Κύριε",7,250],["ὅτι",19,8],["ὑπέλαβές",1009,154],["με",6,82],["καὶ",2,8],["οὐκ",12,17],["εὔφρανας",244,154],["τοὺς",1,56],["ἐχθρούς",135,31],["μου",6,48],["ἐπʼ",9,1],["ἐμέ",6,82]],"I will exalt thee, O Lord; for thou hast lifted me up, and not caused mine enemies to rejoice over me."],["3",[["Κύριε",7,250],["ὁ",1,4],["Θεός",20,5],["μου",6,48],["ἐκέκραξα",592,147],["πρὸς",15,1],["σὲ",5,161],["καὶ",2,8],["ἰάσω",797,322],["με",6,82]],"O Lord my God, I cried to thee, and thou didst heal me."],["4",[["Κύριε",7,250],["ἀνήγαγες",524,154],["ἐξ",21,1],["ᾅδου",586,21],["τὴν",1,9],["ψυχήν",63,10],["μου",6,48],["ἔσωσάς",172,154],["με",6,82],["ἀπὸ",17,1],["τῶν",1,76],["καταβαινόντων",175,164],["εἰς",8,1],["λάκκον",680,7]],"O Lord, thou hast brought up my soul from Hades, thou hast delivered me from [among] them that go down to the pit."],["5",[["Ψάλατε",913,69],["τῷ",1,110],["Κυρίῳ",7,113],["οἱ",1,128],["ὅσιοι",917,130],["αὐτοῦ",3,48],["καὶ",2,8],["ἐξομολογεῖσθε",479,382],["τῇ",1,95],["μνήμῃ",2177,2],["τῆς",1,18],["ἁγιωσύνης",4057,19],["αὐτοῦ",3,48]],"Sing to the Lord, ye his saints, and give thanks for the remembrance of his holiness."],["6",[["Ὅτι",19,8],["ὀργὴ",198,13],["ἐν",4,1],["τῷ",1,110],["θυμῷ",178,113],["αὐτοῦ",3,48],["καὶ",2,8],["ζωὴ",216,13],["ἐν",4,1],["τῷ",1,52],["θελήματι",1039,53],["αὐτοῦ",3,48],["τοεσπέρας",0,0],["αὐλισθήσεται",990,125],["κλαυθμὸς",1203,5],["καὶ",2,8],["εἰς",8,1],["το",1,27],["πρωῒ",504,17],["ἀγαλλίασις",1981,13]],"For anger is in his wrath, but life in his favour: weeping shall tarry for the evening, but joy shall be in the morning."],["7",[["Ἐγὼ",6,158],["δὲ",14,12],["εἶπα",18,147],["ἐν",4,1],["τῇ",1,95],["εὐθηνίᾳ",2452,2],["μου",6,48],["οὐ",12,17],["μὴ",25,8],["σαλευθῶ",678,555],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7]],"And I said in my prosperity, I shall never be moved."],["8",[["Κύριε",7,250],["ἐν",4,1],["τῷ",1,52],["θελήματί",1039,53],["σου",5,146],["παρέσχου",2279,169],["τῷ",1,52],["κάλλει",886,53],["μου",6,48],["δύναμιν",98,10],["ἀπέστρεψας",130,154],["δὲ",14,12],["τὸ",1,32],["πρόσωπόν",47,33],["σου",5,146],["καὶ",2,8],["ἐγενήθην",30,148],["τεταραγμένος",508,408]],"O Lord, in thy good pleasure thou didst add strength to my beauty: but thou didst turn away thy face, and I was troubled."],["9",[["Πρὸς",15,1],["σὲ",5,161],["Κύριε",7,250],["κεκράξομαι",592,177],["καὶ",2,8],["πρὸς",15,1],["τὸν",1,6],["Θεόν",20,7],["μου",6,48],["δεηθήσομαι",440,176]],"To thee, O Lord, will I cry; and to my God will I make supplication."],["10",[["Τίς",39,368],["ὠφέλεια",2556,13],["ἐν",4,1],["τῷ",1,52],["αἵματί",148,53],["μου",6,48],["ἐν",4,1],["τῷ",1,110],["καταβῆναί",175,100],["με",6,98],["εἰς",8,1],["διαφθοράν",1671,10],["μὴ",25,8],["ἐξομολογήσεταί",479,89],["σοι",5,151],["χοῦς",1098,5],["ἢ",61,8],["ἀναγγελεῖ",231,120],["τὴν",1,9],["ἀλήθειάν",352,10],["σου",5,146]],"What profit is there in my blood, when I go down to destruction? Shall the dust give praise to thee? or shall it declare thy truth?"],["11",[["Ἤκουσε",54,3],["Κύριος",7,5],["καὶ",2,8],["ἠλέησέ",446,3],["με",6,82],["Κύριος",7,5],["ἐγενήθη",30,38],["βοηθός",947,5],["μου",6,48]],"The Lord heard, and had compassion upon me; the Lord is become my helper."],["12",[["Ἔστρεψας",1078,154],["τὸν",1,6],["κοπετόν",1820,7],["μου",6,48],["εἰς",8,1],["χαρὰν",1125,10],["ἐμοὶ",6,49],["διεῤῥήξας",9607,155],["τὸν",1,6],["σάκκον",847,7],["μου",6,48],["καὶ",2,8],["περιέζωσάς",1310,154],["με",6,98],["εὐφροσύνην",360,10]],"Thou hast turned my mourning into joy for me: thou hast rent off my sackcloth, and girded me with gladness;"],["13",[["ὅπως",240,8],["ἂν",83,12],["ψάλῃ",913,160],["σοι",5,151],["ἡ",1,11],["δόξα",141,188],["μου",6,48],["καὶ",2,8],["οὐ",12,17],["μὴ",25,8],["κατανυγῶ",2086,555],["Κ