[["1",[["Εἰς",8,1],["τὸ",1,32],["τέλος",369,33],["ψαλμὸς",639,5],["ᾠδῆς",773,19],["τοῦ",1,30],["ἐνκαινισμοῦ",0,0],["τοῦ",1,30],["οἴκου",34,21],["τοῦ",1,30],["Δαυίδ",52,105]],"For the end, a Psalm and Song at the dedication of the house of David."],["2",[["Ὑψώσω",327,157],["σε",5,161],["Κύριε",7,251],["ὅτι",19,8],["ὑπέλαβές",1009,154],["με",6,82],["καὶ",2,8],["οὐκ",12,17],["εὔφρανας",242,154],["τοὺς",1,56],["ἐχθρούς",135,31],["μου",6,48],["ἐπʼ",9,1],["ἐμέ",6,82]],"I will exalt thee, O Lord; for thou hast lifted me up, and not caused mine enemies to rejoice over me."],["3",[["Κύριε",7,251],["ὁ",1,4],["Θεός",20,5],["μου",6,48],["ἐκέκραξα",590,147],["πρὸς",15,1],["σὲ",5,161],["καὶ",2,8],["ἰάσω",794,327],["με",6,82]],"O Lord my God, I cried to thee, and thou didst heal me."],["4",[["Κύριε",7,251],["ἀνήγαγες",522,154],["ἐξ",21,1],["ᾅδου",583,21],["τὴν",1,9],["ψυχήν",62,10],["μου",6,48],["ἔσωσάς",171,154],["με",6,82],["ἀπὸ",17,1],["τῶν",1,76],["καταβαινόντων",174,164],["εἰς",8,1],["λάκκον",677,7]],"O Lord, thou hast brought up my soul from Hades, thou hast delivered me from [among] them that go down to the pit."],["5",[["Ψάλατε",901,69],["τῷ",1,110],["Κυρίῳ",7,113],["οἱ",1,128],["ὅσιοι",918,130],["αὐτοῦ",3,48],["καὶ",2,8],["ἐξομολογεῖσθε",478,386],["τῇ",1,95],["μνήμῃ",2189,2],["τῆς",1,18],["ἁγιωσύνης",4065,19],["αὐτοῦ",3,48]],"Sing to the Lord, ye his saints, and give thanks for the remembrance of his holiness."],["6",[["Ὅτι",19,8],["ὀργὴ",198,13],["ἐν",4,1],["τῷ",1,110],["θυμῷ",177,113],["αὐτοῦ",3,48],["καὶ",2,8],["ζωὴ",212,13],["ἐν",4,1],["τῷ",1,52],["θελήματι",1036,53],["αὐτοῦ",3,48],["τοεσπέρας",0,0],["αὐλισθήσεται",991,125],["κλαυθμὸς",1207,5],["καὶ",2,8],["εἰς",8,1],["το",1,27],["πρωῒ",501,17],["ἀγαλλίασις",1985,13]],"For anger is in his wrath, but life in his favour: weeping shall tarry for the evening, but joy shall be in the morning."],["7",[["Ἐγὼ",6,158],["δὲ",14,12],["εἶπα",18,147],["ἐν",4,1],["τῇ",1,95],["εὐθηνίᾳ",2459,2],["μου",6,48],["οὐ",12,17],["μὴ",25,8],["σαλευθῶ",679,569],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7]],"And I said in my prosperity, I shall never be moved."],["8",[["Κύριε",7,251],["ἐν",4,1],["τῷ",1,52],["θελήματί",1036,53],["σου",5,146],["παρέσχου",2292,169],["τῷ",1,52],["κάλλει",887,53],["μου",6,48],["δύναμιν",98,10],["ἀπέστρεψας",130,154],["δὲ",14,12],["τὸ",1,32],["πρόσωπόν",47,33],["σου",5,146],["καὶ",2,8],["ἐγενήθην",30,148],["τεταραγμένος",0,0]],"O Lord, in thy good pleasure thou didst add strength to my beauty: but thou didst turn away thy face, and I was troubled."],["9",[["Πρὸς",15,1],["σὲ",5,161],["Κύριε",7,251],["κεκράξομαι",590,176],["καὶ",2,8],["πρὸς",15,1],["τὸν",1,6],["Θεόν",20,7],["μου",6,48],["δεηθήσομαι",439,175]],"To thee, O Lord, will I cry; and to my God will I make supplication."],["10",[["Τίς",39,373],["ὠφέλεια",2560,13],["ἐν",4,1],["τῷ",1,52],["αἵματί",148,53],["μου",6,48],["ἐν",4,1],["τῷ",1,110],["καταβῆναί",174,100],["με",6,98],["εἰς",8,1],["διαφθοράν",1672,10],["μὴ",25,8],["ἐξομολογήσεταί",478,89],["σοι",5,151],["χοῦς",1101,5],["ἢ",60,8],["ἀναγγελεῖ",228,120],["τὴν",1,9],["ἀλήθειάν",350,10],["σου",5,146]],"What profit is there in my blood, when I go down to destruction? Shall the dust give praise to thee? or shall it declare thy truth?"],["11",[["Ἤκουσε",53,3],["Κύριος",7,5],["καὶ",2,8],["ἠλέησέ",457,3],["με",6,82],["Κύριος",7,5],["ἐγενήθη",30,38],["βοηθός",948,5],["μου",6,48]],"The Lord heard, and had compassion upon me; the Lord is become my helper."],["12",[["Ἔστρεψας",1079,154],["τὸν",1,6],["κοπετόν",1822,7],["μου",6,48],["εἰς",8,1],["χαρὰν",1124,10],["ἐμοὶ",6,49],["διεῤῥήξας",9675,155],["τὸν",1,6],["σάκκον",848,7],["μου",6,48],["καὶ",2,8],["περιέζωσάς",1418,154],["με",6,98],["εὐφροσύνην",360,10]],"Thou hast turned my mourning into joy for me: thou hast rent off my sackcloth, and girded me with gladness;"],["13",[["ὅπως",236,8],["ἂν",82,12],["ψάλῃ",901,160],["σοι",5,151],["ἡ",1,11],["δόξα",141,186],["μου",6,48],["καὶ",2,8],["οὐ",12,17],["μὴ",25,8],["κατανυγῶ",2588,569],["Κύριε",7,251],["ὁ",1,4],["Θεός",20,5],["μου",6,48],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["ἐξομολογήσομαί",478,176],["σοι",5,151]],"that my glory may sing praise to thee, and I may not be pierced [with sorrow]. O Lord my God, I will give thanks to thee for ever."]]