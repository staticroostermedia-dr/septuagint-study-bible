[["1",[["Ψαλμὸς",644,5],["τῷ",1,110],["Δαυίδ",52,105],["Κύριε",7,250],["τίς",39,150],["παροικήσει",782,120],["ἐν",4,1],["τῷ",1,52],["σκηνώματί",682,53],["σου",5,146],["καὶ",2,8],["τίς",39,150],["κατασκηνώσει",805,120],["ἐν",4,1],["τῷ",1,52],["ὄρει",87,53],["τῷ",1,52],["ἁγίῳ",75,34],["σου",5,146]],"A Psalm of David. O Lord, who shall sojourn in thy tabernacle? and who shall dwell in thy holy mountain?"],["2",[["Πορευόμενος",49,114],["ἄμωμος",637,16],["καὶ",2,8],["ἐργαζόμενος",467,114],["δικαιοσύνην",187,10],["λαλῶν",50,67],["ἀλήθειαν",352,10],["ἐν",4,1],["καρδίᾳ",64,2],["αὐτοῦ",3,48]],"He that walks blameless, and works righteousness, who speaks truth in his heart."],["3",[["Ὃς",24,246],["οὐκ",12,17],["ἐδόλωσεν",5584,3],["ἐν",4,1],["γλώσσῃ",388,2],["αὐτοῦ",3,48],["οὐδὲ",106,12],["ἐποίησε",23,3],["τῷ",1,110],["πλησίον",292,17],["αὐτοῦ",3,48],["κακὸν",161,59],["καὶ",2,8],["ὀνειδισμὸν",733,7],["οὐκ",12,17],["ἔλαβεν",46,3],["ἐπὶ",9,1],["τοὺς",1,56],["ἔγγιστα",3420,74],["αὐτοῦ",3,48]],"Who has not spoken craftily with his tongue, neither has done evil to his neighbour, nor taken up a reproach against them that dwelt nearest to him."],["4",[["Ἐξουδένωται",1068,182],["ἐνώπιον",115,1],["αὐτοῦ",3,48],["πονηρευόμενος",1331,114],["τοὺς",1,56],["δὲ",14,12],["φοβουμένους",134,230],["Κύριον",7,7],["δοξάζει",452,87],["ὁ",1,4],["ὀμνύων",347,67],["τῷ",1,110],["πλησίον",292,17],["αὐτοῦ",3,48],["καὶ",2,8],["οὐκ",12,17],["ἐθετῶν",4622,596]],"In his sight an evil-worker is set at nought, but he honours them that fear the Lord. He swears to his neighbour, and disappoints [him] not."],["5",[["Τὸ",1,32],["ἀργύριον",152,33],["αὐτοῦ",3,48],["οὐκ",12,17],["ἔδωκεν",33,3],["ἐπὶ",9,1],["τόκῳ",1839,113],["καὶ",2,8],["δῶρα",348,43],["ἐπʼ",9,1],["ἀθώοις",0,0],["οὐκ",12,17],["ἔλαβεν",46,3],["ὁ",1,4],["ποιῶν",23,67],["ταῦτα",16,248],["οὐ",12,17],["σαλευθήσεται",678,125],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7]],"He has not lent his money on usury, and has not received bribes against the innocent. He th