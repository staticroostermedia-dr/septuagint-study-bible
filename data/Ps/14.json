[["1",[["Ψαλμὸς",639,5],["τῷ",1,110],["Δαυίδ",52,105],["Κύριε",7,251],["τίς",39,150],["παροικήσει",781,120],["ἐν",4,1],["τῷ",1,52],["σκηνώματί",680,53],["σου",5,146],["καὶ",2,8],["τίς",39,150],["κατασκηνώσει",802,120],["ἐν",4,1],["τῷ",1,52],["ὄρει",86,53],["τῷ",1,52],["ἁγίῳ",75,34],["σου",5,146]],"A Psalm of David. O Lord, who shall sojourn in thy tabernacle? and who shall dwell in thy holy mountain?"],["2",[["Πορευόμενος",49,114],["ἄμωμος",633,16],["καὶ",2,8],["ἐργαζόμενος",468,114],["δικαιοσύνην",185,10],["λαλῶν",50,67],["ἀλήθειαν",350,10],["ἐν",4,1],["καρδίᾳ",63,2],["αὐτοῦ",3,48]],"He that walks blameless, and works righteousness, who speaks truth in his heart."],["3",[["Ὃς",24,247],["οὐκ",12,17],["ἐδόλωσεν",5613,3],["ἐν",4,1],["γλώσσῃ",385,2],["αὐτοῦ",3,48],["οὐδὲ",105,12],["ἐποίησε",23,3],["τῷ",1,110],["πλησίον",292,17],["αὐτοῦ",3,48],["κακὸν",161,59],["καὶ",2,8],["ὀνειδισμὸν",732,7],["οὐκ",12,17],["ἔλαβεν",46,3],["ἐπὶ",9,1],["τοὺς",1,56],["ἔγγιστα",3425,74],["αὐτοῦ",3,48]],"Who has not spoken craftily with his tongue, neither has done evil to his neighbour, nor taken up a reproach against them that dwelt nearest to him."],["4",[["Ἐξουδένωται",1069,372],["ἐνώπιον",114,1],["αὐτοῦ",3,48],["πονηρευόμενος",1387,114],["τοὺς",1,56],["δὲ",14,12],["φοβουμένους",134,230],["Κύριον",7,7],["δοξάζει",465,87],["ὁ",1,4],["ὀμνύων",346,67],["τῷ",1,110],["πλησίον",292,17],["αὐτοῦ",3,48],["καὶ",2,8],["οὐκ",12,17],["ἐθετῶν",4647,612]],"In his sight an evil-worker is set at nought, but he honours them that fear the Lord. He swears to his neighbour, and disappoints [him] not."],["5",[["Τὸ",1,32],["ἀργύριον",150,33],["αὐτοῦ",3,48],["οὐκ",12,17],["ἔδωκεν",33,3],["ἐπὶ",9,1],["τόκῳ",1841,113],["καὶ",2,8],["δῶρα",347,43],["ἐπʼ",9,1],["ἀθώοις",0,0],["οὐκ",12,17],["ἔλαβεν",46,3],["ὁ",1,4],["ποιῶν",23,67],["ταῦτα",16,249],["οὐ",12,17],["σαλευθήσεται",679,125],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7]],"He has not lent his money on usury, and has not received bribes against the innocent. He th