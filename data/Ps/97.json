[["1",[["Ψαλμὸς",644,5],["τῷ",1,110],["Δαυίδ",52,105],["Ἄσατε",2511,262],["τῷ",1,110],["Κυρίῳ",7,113],["ᾆσμα",2239,20],["καινὸν",728,28],["ὅτι",19,8],["θαυμαστὰ",1073,74],["ἐποίησεν",23,3],["ὁ",1,4],["Κύριος",7,5],["ἔσωσεν",172,3],["αὐτῷ",3,49],["ἡ",1,11],["δεξιὰ",282,15],["αὐτοῦ",3,48],["καὶ",2,8],["ὁ",1,4],["βραχίων",1032,5],["ὁ",1,4],["ἅγιος",75,16],["αὐτοῦ",3,48]],"A Psalm of David. Sing to the Lord a new song; for the Lord has wrought wonderful works, his right hand, and his holy arm, have wrought salvation for him."],["2",[["Ἐγνώρισε",748,3],["Κύριος",7,5],["τὸ",1,32],["σωτήριον",472,33],["αὐτοῦ",3,48],["ἐναντίον",138,17],["τῶν",1,44],["ἐθνῶν",60,45],["ἀπεκάλυψε",652,3],["τὴν",1,9],["δικαιοσύνην",187,10],["αὐτοῦ",3,48]],"The Lord has made known his salvation, he has revealed his righteousness in the sight of the nations."],["3",[["Ἐμνήσθη",230,38],["τοῦ",1,23],["ἐλέους",183,24],["αὐτοῦ",3,144],["τῷ",1,110],["Ἰακὼβ",146,105],["καὶ",2,8],["τῆς",1,18],["ἀληθείας",352,19],["αὐτοῦ",3,48],["τῷ",1,110],["οἴκῳ",34,113],["Ἰσραήλ",27,105],["εἴδοσαν",53,141],["πάντα",11,65],["τὰ",1,42],["πέρατα",876,43],["τῆς",1,18],["γῆς",26,19],["τὸ",1,32],["σωτήριον",472,33],["τοῦ",1,30],["θεοῦ",20,21],["ἡμῶν",6,41]],"He has remembered his mercy to Jacob, and his truth to the house of Israel; all the ends of the earth have seen the salvation of our God."],["4",[["Ἀλαλάξατε",1984,69],["τῷ",1,110],["Θεῷ",20,113],["πᾶσα",11,15],["ἡ",1,11],["γῆ",26,13],["ᾄσατε",856,69],["καὶ",2,8],["ἀγαλλιᾶσθε",738,382],["καὶ",2,8],["ψάλατε",913,69]],"Shout to God, all the earth; sing, and exult, and sing psalms."],["5",[["Ψάλατε",913,69],["τῷ",1,110],["Κυρίῳ",7,113],["ἐν",4,1],["κιθάρᾳ",1513,2],["ἐν",4,1],["κιθάρᾳ",1513,2],["καὶ",2,8],["φωνῇ",95,2],["ψαλμοῦ",644,21]],"Sing to the Lord with a harp, with a harp, and the voice of a psalm."],["6",[["Ἐν",4,1],["σάλπιγξιν",580,71],["ἐλαταῖς",3188,71],["καὶ",2,8],["φωνῇ",95,2],["σάλπιγγος",580,19],["κερατίνης",1729,78],["ἀλαλάξατε",1984,69],["ἐνώπιον",115,1],["τοῦ",1,30],["βασιλέως",22,21],["Κυρίῳ",7,113]],"With trumpets of metal, and the sound of a trumpet of horn make a joyful noise to the Lord before the king."],["7",[["Σαλευθήτω",678,25],["ἡ",1,11],["θάλασσα",137,13],["καὶ",2,8],["τὸ",1,32],["πλήρωμα",2185,33],["αὐτῆς",3,83],["ἡ",1,11],["οἰκουμένη",528,204],["καὶ",2,8],["οἱ",1,128],["κατοικοῦντες",89,137],["αὐτήν",3,98]],"Let the sea be moved, and the fulness of it; the world, and they that dwell in it."],["8",[["Ποταμοὶ",249,51],["κροτήσουσι",2593,207],["χειρὶ",37,2],["ἐπιτοαυτὸ",1404,105],["τὰ",1,42],["ὄρη",87,43],["ἀγαλλιάσονται",738,127]],"The rivers shall clap their hands together; the mountains shall exult."],["9",[["Ὅτι",19,8],["ἥκει",260,87],["κρῖναι",263,100],["τὴν",1,9],["γῆν",26,10],["κρινεῖ",263,120],["τὴν",1,9],["οἰκουμένην",1326,10],["ἐν",4,1],["δικαιοσύνῃ",187,2],["καὶ",2,8],["λαοὺς",35,31],["ἐν",4,1],["εὐθύτητι",1674,2]],"For he is come to judge the earth; he shall judge the world in righteousness, and the nations in uprightness."]]