[["1",[["Ἀλληλούϊα",1749,105],["Μακάριος",806,16],["ἀνὴρ",38,5],["ὁ",1,4],["φοβούμενος",134,114],["τὸν",1,6],["Κύριον",7,7],["ἐν",4,1],["ταῖς",1,70],["ἐντολαῖς",259,71],["αὐτοῦ",3,48],["θελήσει",836,120],["σφόδρα",150,17]],"Alleluia. Blessed is the man that fears the Lord: he will delight greatly in his commandments."],["2",[["Δυνατὸν",356,28],["ἐν",4,1],["τῇ",1,95],["γῇ",26,2],["ἔσται",10,89],["τὸ",1,32],["σπέρμα",218,33],["αὐτοῦ",3,48],["γενεὰ",286,13],["εὐθέων",1137,163],["εὐλογηθήσεται",149,125]],"His seed shall be mighty in the earth: the generation of the upright shall be blessed."],["3",[["Δόξα",141,188],["καὶ",2,8],["πλοῦτος",574,5],["ἐν",4,1],["τῷ",1,110],["οἴκῳ",34,113],["αὐτοῦ",3,48],["καὶ",2,8],["ἡ",1,11],["δικαιοσύνη",187,13],["αὐτοῦ",3,48],["μένει",681,87],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["τοῦ",1,30],["αἰῶνος",100,21]],"Glory and riches shall be in his house; and his righteousness endures for evermore."],["4",[["Ἐξανέτειλεν",4085,3],["ἐν",4,1],["σκότει",506,53],["φῶς",380,20],["τοῖς",1,138],["εὐθέσιν",825,215],["ἐλεήμων",1489,16],["καὶ",2,8],["οἰκτίρμων",2102,16],["καὶ",2,8],["δίκαιος",153,16]],"To the upright light has sprung up in darkness: he is pitiful, and merciful, and righteous."],["5",[["Χρηστὸς",1359,16],["ἀνὴρ",38,5],["ὁ",1,4],["οἰκτείρων",1309,67],["καὶ",2,8],["κιχρῶν",4854,67],["οἰκονομήσει",4937,120],["τοὺς",1,56],["λόγους",48,31],["αὐτοῦ",3,48],["ἐν",4,1],["κρίσει",229,2]],"The good man is he that pities and lends: he will direct his affairs with judgment."],["6",[["ὅτι",19,8],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["οὐ",12,17],["σαλευθήσεται",678,125],["εἰς",8,1],["μνημόσυνον",716,33],["αἰώνιον",391,29],["ἔσται",10,89],["δίκαιος",153,16]],"For he shall not be moved for ever; the righteous shall be in everlasting remembrance."],["7",[["Ἀπὸ",17,1],["ἀκοῆς",1047,19],["πονηρᾶς",164,78],["οὐ",12,17],["φοβηθήσεται",134,125],["ἑτοίμη",904,15],["ἡ",1,11],["καρδία",64,13],["αὐτοῦ",3,48],["ἐλπίζειν",514,54],["ἐπὶ",9,1],["Κύριον",7,7]],"He shall not be afraid of [any] evil report: his heart is ready to trust in the Lord."],["8",[["Ἐστήρικται",979,182],["ἡ",1,11],["καρδία",64,13],["αὐτοῦ",3,48],["οὐ",12,17],["φοβηθῇ",134,333],["ἕως",42,8],["οὗ",120,17],["ἐπίδῃ",1865,160],["ἐπὶ",9,1],["τοὺς",1,56],["ἐχθροὺς",135,31],["αὐτοῦ",3,48]],"His heart is established, he shall not fear, till he shall see [his desire] upon his enemies."],["9",[["Ἐσκόρπισεν",1785,3],["ἔδωκε",33,3],["τοῖς",1,138],["πένησιν",672,139],["ἡ",1,11],["δικαιοσύνη",187,13],["αὐτοῦ",3,48],["μένει",681,87],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["τοῦ",1,30],["αἰῶνος",100,21],["τὸ",1,32],["κέρας",569,33],["αὐτοῦ",3,48],["ὑψωθήσεται",331,125],["ἐν",4,1],["δόξῃ",141,2]],"He has dispersed abroad; he has given to the poor; his righteousness endures for evermore: his horn shall be exalted with honour."],["10",[["Ἁμαρτωλὸς",409,16],["ὄψεται",112,89],["καὶ",2,8],["ὀργισθήσεται",725,125],["τοὺς",1,56],["ὀδόντας",930,31],["αὐτοῦ",3,48],["βρύξει",3793,120],["καὶ",2,8],["τακήσεται",1021,125],["ἐπιθυμία",699,13],["ἁμαρτωλοῦ",409,153],["ἀπολεῖται",217,89]],"The sinner shall see and be angry, he shall gnash his teeth, and consume away: the desire of the sinner shall perish."]]