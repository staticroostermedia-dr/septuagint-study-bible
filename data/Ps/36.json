[["1",[["Τῷ",1,110],["Δαυίδ",52,105],["Μὴ",25,8],["παραζήλου",3101,239],["ἐν",4,1],["πονηρευομένοις",1331,342],["μηδὲ",414,12],["ζήλου",1164,21],["τοὺς",1,56],["ποιοῦντας",23,229],["τὴν",1,9],["ἀνομίαν",275,10]],"[A Psalm] of David. Fret not thyself because of evil-doers, neither be envious of them that do iniquity."],["2",[["Ὅτι",19,8],["ὡσεὶ",343,17],["χόρτος",1046,5],["ταχὺ",1389,17],["ἀποξηρανθήσονται",4038,135],["καὶ",2,8],["ὡσεὶ",343,17],["λάχανα",3883,43],["χλόης",2438,19],["ταχὺ",1389,17],["ἀποπεσοῦνται",3172,127]],"For they shall soon be withered as the grass, and shall soon fall away as the green herbs."],["3",[["Ἔλπισον",514,198],["ἐπὶ",9,1],["Κύριον",7,7],["καὶ",2,8],["ποίει",23,239],["χρηστότητα",1845,10],["καὶ",2,8],["κατασκήνου",805,239],["τὴν",1,9],["γῆν",26,10],["καὶ",2,8],["ποιμανθήσῃ",0,0],["ἐπὶ",9,1],["τῷ",1,110],["πλούτῳ",574,113],["αὐτῆς",3,83]],"Hope in the Lord, and do good; and dwell on the land, and thou shalt be fed with the wealth of it."],["4",[["Κατατρύφησον",5709,198],["τοῦ",1,30],["Κυρίου",7,21],["καὶ",2,8],["δώσει",33,120],["σοι",5,151],["τὰ",1,42],["αἰτήματα",2247,43],["τῆς",1,18],["καρδίας",64,19],["σου",5,146]],"Delight [thyself] in the Lord; and he shall grant thee the requests of thine heart."],["5",[["Ἀποκάλυψον",652,198],["πρὸς",15,1],["Κύριον",7,7],["τὴν",1,9],["ὁδόν",68,10],["σου",5,146],["καὶ",2,8],["ἔλπισον",514,198],["ἐπʼ",9,1],["αὐτὸν",3,82],["καὶ",2,8],["αὐτὸς",3,158],["ποιήσει",23,120]],"Disclose thy way to the Lord, and hope in him;",{"s":"r"}],["6",[["Καὶ",2,8],["ἐξοίσει",624,120],["ὡς",36,8],["φῶς",380,20],["τὴν",1,9],["δικαιοσύνην",187,10],["σου",5,146],["καὶ",2,8],["τὸ",1,32],["κρίμα",267,33],["σου",5,146],["ὡς",36,8],["μεσημβρίαν",1633,10]],"and he shall bring [it] to pass. And he shall bring forth thy righteousness as the light, and thy judgment as the noon-day.",{"s":"r"}],["7",[["Ὑποτάγηθι",1497,242],["τῷ",1,110],["Κυρίῳ",7,113],["καὶ",2,8],["ἱκέτευσον",3018,547],["αὐτόν",3,82],["μὴ",25,8],["παραζήλου",3101,239],["ἐν",4,1],["τῷ",1,110],["κατευοδουμένῳ",3857,240],["ἐν",4,1],["τῇ",1,95],["ὁδῷ",68,2],["αὐτοῦ",3,48],["ἐν",4,1],["ἀνθρώπῳ",43,113],["ποιοῦντι",23,390],["παρανομίας",2932,40]],"Submit thyself to the Lord, and supplicate him: fret not thyself because of him that prospers in his way, at the man that does unlawful deeds."],["8",[["Παῦσαι",706,100],["ἀπὸ",17,1],["ὀργῆς",198,19],["καὶ",2,8],["ἐνκατάλιπε",0,0],["θυμὸν",178,7],["μὴ",25,8],["παραζήλου",3101,239],["ὥστε",346,17],["πονηρεύεσθαι",1331,104]],"Cease from anger, and forsake wrath: fret not thyself so as to do evil."],["9",[["Ὅτι",19,8],["οἱ",1,128],["πονηρευόμενοι",1331,351],["ἐξολοθρευθήσονται",291,135],["οἱ",1,128],["δὲ",14,12],["ὑπομένοντες",639,137],["τὸν",1,6],["Κύριον",7,7],["αὐτοὶ",3,195],["κληρονομήσουσι",370,207],["τὴν",1,9],["γῆν",26,10]],"For evil-doers shall be destroyed: but they that wait on the Lord, they shall inherit the land."],["10",[["Καὶ",2,8],["ἔτι",111,17],["ὀλίγον",555,29],["καὶ",2,8],["οὐ",12,17],["μὴ",25,8],["ὑπάρξῃ",418,116],["ἁμαρτωλὸς",409,16],["καὶ",2,8],["ζητήσεις",3534,40],["τὸν",1,6],["τόπον",99,7],["αὐτοῦ",3,48],["καὶ",2,8],["οὐ",12,17],["μὴ",25,8],["εὕρῃς",101,170]],"And yet a little while, and the sinner shall not be, and thou shalt seek for his place, and shalt not find [it]."],["11",[["Οἱ",1,128],["δὲ",14,12],["πρᾳεῖς",2286,130],["κληρονομήσουσι",370,207],["γῆν",26,10],["καὶ",2,8],["κατατρυφήσουσιν",5709,207],["ἐπὶ",9,1],["πλήθει",200,53],["εἰρήνης",213,19]],"But the meek shall inherit the earth; and shall delight [themselves] in the abundance of peace."],["12",[["Παρατηρήσεται",3914,89],["ὁ",1,4],["ἁμαρτωλὸς",409,16],["τὸν",1,6],["δίκαιον",153,59],["καὶ",2,8],["βρύξει",3793,120],["ἐπʼ",9,1],["αὐτὸν",3,82],["τοὺς",1,56],["ὀδόντας",930,31],["αὐτοῦ",3,48]],"The sinner will watch for the righteous, and gnash his teeth upon him."],["13",[["Ὁ",1,4],["δὲ",14,12],["Κύριος",7,5],["ἐκγελάσεται",3727,89],["αὐτὸν",3,82],["ὅτι",19,8],["προβλέτει",0,0],["ὅτι",19,8],["ἥξει",260,120],["ἡ",1,11],["ἡμέρα",28,13],["αὐτοῦ",3,48]],"But the Lord shall laugh at him: for he foresees that his day will come."],["14",[["Ῥομφαίαν",248,10],["ἐσπάσαντο",1691,184],["οἱ",1,128],["ἁμαρτωλοὶ",409,130],["ἐνέτειναν",1991,141],["τόξον",711,20],["αὐτῶν",3,41],["τοῦ",1,30],["καταβαλεῖν",1074,100],["πτωχὸν",497,7],["καὶ",2,8],["πένητα",672,7],["τοῦ",1,30],["σφάξαι",635,100],["τοὺς",1,56],["εὐθεῖς",825,58],["τῇ",1,95],["καρδίᾳ",64,2]],"Sinners have drawn their swords, they have bent their bow, to cast down the poor and needy one, [and] to slay the upright in heart."],["15",[["Ἡ",1,11],["ῥομφαία",248,13],["αὐτῶν",3,41],["εἰσέλθοι",86,216],["εἰς",8,1],["τὴν",1,9],["καρδίαν",64,10],["αὐτῶν",3,41],["καὶ",2,8],["τὰ",1,42],["τόξα",711,43],["αὐτῶν",3,41],["συντριβείη",268,544]],"Let their sword enter into their [own] heart, and their bows be broken."],["16",[["Κρεῖσσον",922,29],["ὀλίγον",555,29],["τῷ",1,110],["δικαίῳ",153,111],["ὑπὲρ",139,1],["πλοῦτον",574,7],["ἁμαρτωλῶν",409,163],["πολύν",74,59]],"A little is better to the righteous than abundant wealth of sinners."],["17",[["Ὅτι",19,8],["βραχίονες",618,130],["ἁμαρτωλῶν",409,163],["συντριβήσονται",268,135],["ὑποστηρίζει",6650,87],["δὲ",14,12],["τοὺς",1,56],["δικαίους",153,58],["ὁ",1,4],["Κύριος",7,5]],"For the arms of sinners shall be broken; but the Lord supports the righteous."],["18",[["Γινώσκει",79,87],["Κύριος",7,5],["τὰς",1,39],["ὁδοὺς",68,40],["τῶν",1,76],["ἀμώμων",637,163],["καὶ",2,8],["ἡ",1,11],["κληρονομία",299,13],["αὐτῶν",3,41],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["ἔσται",10,89]],"The Lord knows the ways of the perfect; and their inheritance shall be for ever."],["19",[["Οὐ",12,17],["καταισχυνθήσονται",696,135],["ἐν",4,1],["καιρῷ",132,113],["πονηρῷ",164,111],["καὶ",2,8],["ἐν",4,1],["ἡμέραις",28,71],["λιμοῦ",503,21],["χορτασθήσονται",2397,135]],"They shall not be ashamed in an evil time; and in days of famine they shall be satisfied."],["20",[["Ὅτι",19,8],["οἱ",1,128],["ἁμαρτωλοὶ",409,130],["ἀπολοῦνται",217,127],["οἱ",1,128],["δὲ",14,12],["ἐχθροὶ",135,51],["τοῦ",1,30],["Κυρίου",7,21],["ἅμα",502,17],["τῷ",1,110],["δοξασθῆναι",452,175],["αὐτοὺς",3,60],["καὶ",2,8],["ὑψωθῆναι",331,175],["ἐκλείποντες",321,137],["ὡσεὶ",343,17],["καπνὸς",1469,5],["ἐξέλιπον",321,141]],"For the sinners shall perish; and the enemies of the Lord at the moment of their being honoured and exalted have utterly vanished like smoke."],["21",[["Δανείζεται",1669,108],["ὁ",1,4],["ἁμαρτωλὸς",409,16],["καὶ",2,8],["οὐκ",12,17],["ἀποτίσει",1365,120],["ὁ",1,4],["δὲ",14,12],["δίκαιος",153,16],["οἰκτείρει",1309,239],["καὶ",2,8],["διδοῖ",33,87]],"The sinner borrows, and will not pay again: but the righteous has compassion, and gives."],["22",[["Ὅτι",19,8],["οἱ",1,128],["εὐλογοῦντες",149,137],["αὐτὸν",3,82],["κληρονομήσουσι",370,207],["γῆν",26,10],["οἱ",1,128],["δὲ",14,12],["καταρώμενοι",779,351],["αὐτὸν",3,82],["ἐξολοθρευθήσονται",291,135]],"For they that bless him shall inherit the earth; and they that curse him shall be utterly destroyed."],["23",[["Παρὰ",73,1],["Κυρίου",7,21],["τὰ",1,42],["διαβήματα",2077,43],["ἀνθρώπου",43,21],["κατευθύνεται",827,108],["καὶ",2,8],["τὴν",1,9],["ὁδὸν",68,10],["αὐτοῦ",3,48],["θελήσει",836,120]],"The steps of a man are rightly ordered by the Lord: and he will take pleasure in his way."],["24",[["Ὅταν",319,8],["πέσῃ",154,160],["οὐ",12,17],["καταῤῥαχθήσεται",2585,125],["ὅτι",19,8],["Κύριος",7,5],["ἀντιστηρίζει",5201,87],["χεῖρα",37,10],["αὐτοῦ",3,48]],"When he falls, he shall not be ruined: for the Lord supports his hand."],["25",[["Νεώτερος",515,16],["ἐγενόμην",30,152],["καὶ",2,8],["γὰρ",40,12],["ἐγήρασα",1411,147],["καὶ",2,8],["οὐκ",12,17],["εἶδον",53,147],["δίκαιον",153,59],["ἐγκαταλελειμμένον",364,442],["οὐδὲ",106,12],["τὸ",1,32],["σπέρμα",218,33],["αὐτοῦ",3,48],["ζητοῦν",191,47],["ἄρτους",197,31]],"I was [once] young, indeed I am now old; yet I have not seen the righteous forsaken, nor his seed seeking bread."],["26",[["Ὅλην",235,37],["τὴν",1,9],["ἡμέραν",28,10],["ἐλεεῖ",446,87],["καὶ",2,8],["δανείζει",1669,87],["καὶ",2,8],["τὸ",1,32],["σπέρμα",218,33],["αὐτοῦ",3,48],["εἰς",8,1],["εὐλογίαν",578,10],["ἔσται",10,89]],"He is merciful, and lends continually; and his seed shall be blessed."],["27",[["Ἔκκλινον",394,198],["ἀπὸ",17,1],["κακοῦ",161,88],["καὶ",2,8],["ποίησον",23,198],["ἀγαθὸν",114,29],["καὶ",2,8],["κατασκήνου",805,239],["εἰς",8,1],["αἰῶνα",100,7],["αἰῶνος",100,21]],"Turn aside from evil, and do good; and dwell for ever."],["28",[["Ὅτι",19,8],["Κύριος",7,5],["ἀγαπᾷ",214,173],["κρίσιν",229,10],["καὶ",2,8],["οὐκ",12,17],["ἐγκαταλείψει",364,120],["τοὺς",1,56],["ὁσίους",917,58],["αὐτοῦ",3,48],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["φυλαχθήσονται",125,135],["ἄμωμοι",637,130],["ἐκδικηθήσονται",539,135],["καὶ",2,8],["σπέρμα",218,20],["ἀσεβῶν",247,163],["ἐξολοθρευθήσεται",291,125]],"For the Lord loves judgment, and will not forsake his saints; they shall be preserved for ever: the blameless shall be avenged, but the seed of the ungodly shall be utterly destroyed."],["29",[["Δίκαιοι",153,130],["δὲ",14,12],["κληρονομήσουσι",370,207],["γῆν",26,10],["καὶ",2,8],["κατασκηνώσουσιν",805,207],["εἰς",8,1],["αἰῶνα",100,7],["αἰῶνος",100,21],["ἐπʼ",9,1],["αὐτῆς",3,83]],"But the righteous shall inherit the earth, and dwell upon it for ever."],["30",[["Στόμα",123,33],["δικαίου",153,153],["μελετήσει",1347,120],["σοφίαν",242,10],["καὶ",2,8],["ἡ",1,11],["γλῶσσα",388,13],["αὐτοῦ",3,48],["λαλήσει",50,120],["κρίσιν",229,10]],"The mouth of the righteous will meditate wisdom, and his tongue will speak of judgment."],["31",[["Ὁ",1,4],["νόμος",140,5],["τοῦ",1,30],["Θεοῦ",20,21],["αὐτοῦ",3,48],["ἐν",4,1],["καρδίᾳ",64,2],["αὐτοῦ",3,48],["καὶ",2,8],["οὐχ",12,17],["ὑποσκελισθήσεται",3479,125],["τὰ",1,42],["διαβήματα",2077,43],["αὐτοῦ",3,48]],"The law of his God is in his heart; and his steps shall not slide."],["32",[["Κατανοεῖ",1549,87],["ὁ",1,4],["ἁμαρτωλὸς",409,16],["τὸν",1,6],["δίκαιον",153,59],["καὶ",2,8],["ζητεῖ",191,87],["τοῦ",1,30],["θανατῶσαι",382,100],["αὐτόν",3,82]],"The sinner watches the righteous, and seeks to slay him."],["33",[["Ὁ",1,4],["δὲ",14,12],["Κύριος",7,5],["οὐ",12,17],["μὴ",25,8],["ἐγκαταλίπῃ",364,160],["αὐτὸν",3,82],["εἰς",8,1],["τὰς",1,39],["χεῖρας",37,40],["αὐτοῦ",3,48],["οὐδὲ",106,12],["μὴ",25,8],["καταδικάσαι",2582,100],["αὐτὸν",3,82],["ὅταν",319,8],["κρίνηται",263,236],["αὐτῷ",3,49]],"But the Lord will not leave him in his hands, nor by any means condemn him when he is judged."],["34",[["Ὑπόμεινον",639,198],["τὸν",1,6],["Κύριον",7,7],["καὶ",2,8],["φύλαξον",125,198],["τὴν",1,9],["ὁδὸν",68,10],["αὐτοῦ",3,48],["καὶ",2,8],["ὑψώσει",331,120],["σε",5,161],["τοῦ",1,30],["κατακληρονομῆσαι",907,100],["τὴν",1,9],["γῆν",26,10],["ἐν",4,1],["τῷ",1,110],["ἐξολοθρεύεσθαι",291,104],["ἁμαρτωλοὺς",409,58],["ὄψει",112,116]],"Wait on the Lord, and keep his way, and he shall exalt thee to inherit the land: when the wicked are destroyed, thou shalt see [it]."],["35",[["Εἶδον",53,147],["τὸν",1,6],["ἀσεβῆ",247,59],["ὑπερυψούμενον",1294,361],["καὶ",2,8],["ἐπαιρόμενον",661,361],["ὡς",36,8],["τὰς",1,39],["κέδρους",873,40],["τοῦ",1,30],["Λιβάνου",537,21]],"I saw the ungodly very highly exalting himself, and lifting himself up like the cedars of Libanus."],["36",[["Καὶ",2,8],["παρῆλθον",404,141],["καὶ",2,8],["ἰδοὺ",51,17],["οὐκ",12,17],["ἦν",10,14],["καὶ",2,8],["ἐζήτησα",191,147],["αὐτόν",3,82],["καὶ",2,8],["οὐχ",12,17],["εὑρέθη",101,38],["ὁ",1,4],["τόπος",99,5],["αὐτοῦ",3,48]],"Yet I passed by, and lo! he was not: and I sought him, but his place was not found."],["37",[["Φύλασσε",125,239],["ἀκακίαν",2650,10],["καὶ",2,8],["ἴδε",713,17],["εὐθύτητα",1674,10],["ὅτι",19,8],["ἐστὶν",10,87],["ἐγκατάλειμμα",3421,20],["ἀνθρώπῳ",43,113],["εἰρηνικῷ",935,111]],"Maintain innocence, and behold uprightness: for there is a remnant to the peaceable man."],["38",[["Οἱ",1,128],["δὲ",14,12],["παράνομοι",830,130],["ἐξολοθρευθήσονται",291,135],["ἐπιτοαυτὸ",1404,105],["τὰ",1,42],["ἐγκαταλείμματα",3421,43],["τῶν",1,76],["ἀσεβῶν",247,163],["ἐξολοθρευθήσονται",291,135]],"But the transgressors shall be utterly destroyed together: the remnants of the ungodly shall be utterly destroyed."],["39",[["Σωτηρία",425,13],["δὲ",14,12],["τῶν",1,76],["δικαίων",153,163],["παρὰ",73,1],["Κυρίου",7,21],["καὶ",2,8],["ὑπερασπιστὴς",1875,5],["αὐτῶν",3,41],["ἐστιν",10,87],["ἐν",4,1],["καιρῷ",132,113],["θλίψεως",438,19]],"But the salvation of the righteous is of the Lord; and he is their defender in the time of affliction."],["40",[["Καὶ",2,8],["βοηθήσει",366,373],["αὐτοῖς",3,142],["Κύριος",7,5],["καὶ",2,8],["ῥύσεται",337,89],["αὐτοὺς",3,60],["καὶ",2,8],["ἐξελεῖται",413,89],["αὐτοὺς",3,60],["ἐξ",21,1],["ἁμαρτωλῶν",409,163],["καὶ",2,8],["σώσει",172,120],["αὐτοὺς",3,60],["ὅτι",19,8],["ἤλπισαν",514,141],["ἐπʼ",9,1],["αὐτόν",3,82]],"And the Lord shall help them, and deliver them: and he shall rescue them from sinners, and save them, because they have hoped in him."]]