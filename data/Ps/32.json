[["1",[["Τῷ",1,110],["Δαυίδ",52,105],["Ἀγαλλιᾶσθε",738,382],["δίκαιοι",153,130],["ἐν",4,1],["τῷ",1,110],["Κυρίῳ",7,113],["τοῖς",1,138],["εὐθέσι",825,215],["πρέπει",2762,87],["αἴνεσις",989,13]],"[A Psalm] of David. Rejoice in the Lord, ye righteous; praise becomes the upright."],["2",[["Ἐξομολογεῖσθε",479,382],["τῷ",1,110],["Κυρίῳ",7,113],["ἐν",4,1],["κιθάρᾳ",1513,2],["ἐν",4,1],["ψαλτηρίῳ",1693,53],["δεκαχόρδῳ",4735,34],["ψάλατε",913,69],["αὐτῷ",3,233]],"Praise the Lord on the harp; play to him on a psaltery of ten strings."],["3",[["Ἄσατε",2511,262],["αὐτῷ",3,49],["ᾆσμα",2239,20],["καινὸν",728,28],["καλῶς",1273,17],["ψάλατε",913,69],["ἐν",4,1],["ἀλαλαγμῷ",2978,113]],"Sing to him a new song; play skilfully with a loud noise."],["4",[["Ὅτι",19,8],["εὐθὴς",825,16],["ὁ",1,4],["λόγος",48,5],["τοῦ",1,30],["Κυρίου",7,21],["καὶ",2,8],["πάντα",11,65],["τὰ",1,42],["ἔργα",105,43],["αὐτοῦ",3,48],["ἐν",4,1],["πίστει",887,2]],"For the word of the Lord is right; and all his works are faithful."],["5",[["Ἀγαπᾷ",214,173],["ἐγεημοσύνην",0,0],["καὶ",2,8],["κρίσιν",229,10],["τοῦ",1,23],["ἐλέους",183,24],["Κυρίου",7,21],["πλήρης",490,15],["ἡ",1,11],["γῆ",26,13]],"He loves mercy and judgment; the earth is full of the mercy of the Lord."],["6",[["Τῷ",1,110],["λόγῳ",48,113],["τοῦ",1,30],["Κυρίου",7,21],["οἱ",1,128],["οὐρανοὶ",94,51],["ἐστερεώθησαν",1334,94],["καὶ",2,8],["τῷ",1,52],["πνεύματι",168,53],["τοῦ",1,23],["στόματος",123,24],["αὐτοῦ",3,144],["πᾶσα",11,15],["ἡ",1,11],["δύναμις",98,13],["αὐτῶν",3,41]],"By the word of the Lord the heavens were established; and all the host of them by the breath of his [mouth]."],["7",[["Συνάγων",166,67],["ὡσεὶ",343,17],["ἀσκὸν",2213,7],["ὕδατα",85,43],["θαλάσσης",137,19],["τιθεὶς",110,67],["ἐν",4,1],["θησαυροῖς",579,139],["ἀβύσσους",1083,40]],"Who gathers the waters of the sea as [in] a bottle; who lays up the deeps in treasuries."],["8",[["Φόβηθήτω",134,25],["τὸν",1,6],["Κύριον",7,7],["πᾶσα",11,15],["ἡ",1,11],["γῆ",26,13],["ἀπʼ",17,1],["αὐτοῦ",3,48],["δὲ",14,12],["σαλευθήτωσαν",678,50],["πάντες",11,130],["οἱ",1,128],["κατοικοῦντες",89,137],["τὴν",1,9],["οἰκουμένην",1326,10]],"Let all the earth fear the Lord; and let all that dwell in the world be moved because of him."],["9",[["Ὅτι",19,8],["αὐτὸς",3,158],["εἶπε",18,3],["καὶ",2,8],["ἐγενήθησαν",30,94],["αὐτὸς",3,158],["ἐνετείλατο",143,26],["καὶ",2,8],["ἐκτίσθησαν",786,94]],"For he spoke, and they were made; he commanded, and they were created."],["10",[["Κύριος",7,5],["διασκεδάζει",7006,87],["βουλὰς",350,40],["ἐθνῶν",60,45],["ἀθετεῖ",834,87],["δὲ",14,12],["λογισμοὺς",500,31],["λαῶν",35,77],["καὶ",2,8],["ἀθετεῖ",834,87],["βουλὰς",350,40],["ἀρχόντων",96,77]],"The Lord frustrates the counsels of the nations; he brings to nought also the reasonings of the peoples, and brings to nought the counsels of princes."],["11",[["Ἡ",1,11],["δὲ",14,12],["βουλὴ",350,13],["τοῦ",1,30],["Κυρίου",7,21],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["μένει",681,87],["λογισμοὶ",500,51],["τῆς",1,18],["καρδίας",64,19],["αὐτοῦ",3,48],["ἀπὸ",17,1],["γενεῶν",286,61],["εἰς",8,1],["γενεάς",286,40]],"But the counsel of the Lord endures for ever, the thoughts of his heart from generation to generation."],["12",[["Μακάριον",806,28],["τὸ",1,27],["ἔθνος",60,20],["οὗ",120,17],["ἐστι",10,87],["Κύριος",7,5],["ὁ",1,4],["Θεὸς",20,5],["αὐτοῦ",3,48],["λαὸς",35,5],["ὃν",24,106],["ἐξελέξατο",420,26],["εἰς",8,1],["κληρονομίαν",299,10],["ἑαυτῷ",92,49]],"Blessed is the nation whose God is the Lord; the people whom he has chosen for his own inheritance."],["13",[["Ἐξ",21,1],["οὐρανοῦ",94,21],["ἐπέβλεψεν",517,3],["ὁ",1,4],["Κύριος",7,5],["εἶδε",53,3],["πάντας",11,58],["τοὺς",1,56],["υἱοὺς",13,31],["τῶν",1,76],["ἀνθρώπων",43,77]],"The Lord looks out of heaven; he beholds all the sons of men."],["14",[["Ἐξ",21,1],["ἑτοίμου",904,88],["κατοικητηρίου",2020,24],["αὐτοῦ",3,144],["ἐπέβλεψεν",517,3],["ἐπὶ",9,1],["πάντας",11,58],["τοὺς",1,56],["κατοικοῦντας",89,229],["τὴν",1,9],["γῆν",26,10]],"He looks from his prepared habi