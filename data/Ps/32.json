4,285]],"For our heart shall rejoice in him, and we have hoped in his holy name."],["22",[["Γένοιτο",30,392],["τὸ",1,32],["ἔλεός",183,33],["σου",5,146],["Κύριε",7,250],["ἐφʼ",9,1],["ἡμᾶς",6,60],["καθάπερ",690,8],["ἠλπίσαμεν",514,285],["ἐπὶ",9,1],["σέ",5,161]],"Let thy mercy, O Lord, be upon us, according as we have hoped in thee."]]