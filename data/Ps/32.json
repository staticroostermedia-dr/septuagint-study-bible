[["1",[["Τῷ",1,110],["Δαυίδ",52,105],["Ἀγαλλιᾶσθε",737,386],["δίκαιοι",152,130],["ἐν",4,1],["τῷ",1,110],["Κυρίῳ",7,113],["τοῖς",1,138],["εὐθέσι",826,215],["πρέπει",2772,87],["αἴνεσις",990,13]],"[A Psalm] of David. Rejoice in the Lord, ye righteous; praise becomes the upright."],["2",[["Ἐξομολογεῖσθε",478,386],["τῷ",1,110],["Κυρίῳ",7,113],["ἐν",4,1],["κιθάρᾳ",1513,2],["ἐν",4,1],["ψαλτηρίῳ",1698,53],["δεκαχόρδῳ",4761,34],["ψάλατε",901,69],["αὐτῷ",3,233]],"Praise the Lord on the harp; play to him on a psaltery of ten strings."],["3",[["Ἄσατε",699,343],["αὐτῷ",3,49],["ᾆσμα",2254,20],["καινὸν",728,28],["καλῶς",1271,17],["ψάλατε",901,69],["ἐν",4,1],["ἀλαλαγμῷ",2991,113]],"Sing to him a new song; play skilfully with a loud noise."],["4",[["Ὅτι",19,8],["εὐθὴς",826,16],["ὁ",1,4],["λόγος",48,5],["τοῦ",1,30],["Κυρίου",7,21],["καὶ",2,8],["πάντα",11,65],["τὰ",1,42],["ἔργα",104,43],["αὐτοῦ",3,48],["ἐν",4,1],["πίστει",888,2]],"For the word of the Lord is right; and all his works are faithful."],["5",[["Ἀγαπᾷ",224,172],["ἐγεημοσύνην",0,0],["καὶ",2,8],["κρίσιν",226,10],["τοῦ",1,23],["ἐλέους",182,24],["Κυρίου",7,21],["πλήρης",489,15],["ἡ",1,11],["γῆ",26,13]],"He loves mercy and judgment; the earth is full of the mercy of the Lord."],["6",[["Τῷ",1,110],["λόγῳ",48,113],["τοῦ",1,30],["Κυρίου",7,21],["οἱ",1,128],["οὐρανοὶ",94,51],["ἐστερεώθησαν",1354,94],["καὶ",2,8],["τῷ",1,52],["πνεύματι",167,53],["τοῦ",1,23],["στόματος",123,24],["αὐτοῦ",3,144],["πᾶσα",11,15],["ἡ",1,11],["δύναμις",98,13],["αὐτῶν",3,41]],"By the word of the Lord the heavens were established; and all the host of them by the breath of his [mouth]."],["7",[["Συνάγων",165,67],["ὡσεὶ",342,17],["ἀσκὸν",2225,7],["ὕδατα",85,43],["θαλάσσης",137,19],["τιθεὶς",109,67],["ἐν",4,1],["θησαυροῖς",577,139],["ἀβύσσους",1084,40]],"Who gathers the waters of the sea as [in] a bottle; who lays up the deeps in treasuries."],["8",[["Φόβηθήτω",134,25],["τὸν",1,6],["Κύριον",7,7],["πᾶσα",11,15],["ἡ",1,11],["γῆ",26,13],["ἀπʼ",17,1],["αὐτοῦ",3,48],["δὲ",14,12],["σαλευθήτωσαν",679,50],["πάντες",11,130],["οἱ",1,128],["κατοικοῦντες",90,137],["τὴν",1,9],["οἰκουμένην",1326,10]],"Let all the earth fear the Lord; and let all that dwell in the world be moved because of him."],["9",[["Ὅτι",19,8],["αὐτὸς",3,158],["εἶπε",18,3],["καὶ",2,8],["ἐγενήθησαν",30,94],["αὐτὸς",3,158],["ἐνετείλατο",143,26],["καὶ",2,8],["ἐκτίσθησαν",951,94]],"For he spoke, and they were made; he commanded, and they were created."],["10",[["Κύριος",7,5],["διασκεδάζει",7052,87],["βουλὰς",349,40],["ἐθνῶν",59,45],["ἀθετεῖ",835,87],["δὲ",14,12],["λογισμοὺς",498,31],["λαῶν",35,77],["καὶ",2,8],["ἀθετεῖ",835,87],["βουλὰς",349,40],["ἀρχόντων",96,77]],"The Lord frustrates the counsels of the nations; he brings to nought also the reasonings of the peoples, and brings to nought the counsels of princes."],["11",[["Ἡ",1,11],["δὲ",14,12],["βουλὴ",349,13],["τοῦ",1,30],["Κυρίου",7,21],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["μένει",678,87],["λογισμοὶ",498,51],["τῆς",1,18],["καρδίας",63,19],["αὐτοῦ",3,48],["ἀπὸ",17,1],["γενεῶν",286,61],["εἰς",8,1],["γενεάς",286,40]],"But the counsel of the Lord endures for ever, the thoughts of his heart from generation to generation."],["12",[["Μακάριον",803,28],["τὸ",1,27],["ἔθνος",59,20],["οὗ",120,17],["ἐστι",10,87],["Κύριος",7,5],["ὁ",1,4],["Θεὸς",20,5],["αὐτοῦ",3,48],["λαὸς",35,5],["ὃν",24,106],["ἐξελέξατο",418,26],["εἰς",8,1],["κληρονομίαν",297,10],["ἑαυτῷ",92,49]],"Blessed is the nation whose God is the Lord; the people whom he has chosen for his own inheritance."],["13",[["Ἐξ",21,1],["οὐρανοῦ",94,21],["ἐπέβλεψεν",516,3],["ὁ",1,4],["Κύριος",7,5],["εἶδε",276,3],["πάντας",11,58],["τοὺς",1,56],["υἱοὺς",13,31],["τῶν",1,76],["ἀνθρώπων",43,77]],"The Lord looks out of heaven; he beholds all the sons of men."],["14",[["Ἐξ",21,1],["ἑτοίμου",906,88],["κατοικητηρίου",2027,24],["αὐτοῦ",3,144],["ἐπέβλεψεν",516,3],["ἐπὶ",9,1],["πάντας",11,58],["τοὺς",1,56],["κατοικοῦντας",90,229],["τὴν",1,9],["γῆν",26,10]],"He looks from his prepared habitation on all the dwellers on the earth;"],["15",[["Ὁ",1,4],["πλάσας",912,155],["κατὰ",32,1],["μόνας",300,109],["τὰς",1,39],["καρδίας",63,19],["αὐτῶν",3,41],["ὁ",1,4],["συνιεὶς",602,67],["πάντα",11,65],["τὰ",1,42],["ἔργα",104,43],["αὐτῶν",3,41]],"who fashioned their hearts alone; who understands all their works."],["16",[["Οὐ",12,17],["σώζεται",171,108],["βασιλεὺς",22,5],["διὰ",54,1],["πολλὴν",74,37],["δύναμιν",98,10],["καὶ",2,8],["γίγας",1160,5],["οὐ",12,17],["σωθήσεται",171,125],["ἐν",4,1],["πλήθει",199,53],["ἰσχύος",180,19],["αὐτοῦ",3,48]],"A king is not saved by reason of a great host; and a giant shall not be delivered by the greatness of his strength."],["17",[["Ψευδὴς",547,16],["ἵππος",308,5],["εἰς",8,1],["σωτηρίαν",422,10],["ἐν",4,1],["δὲ",14,12],["πλήθει",199,53],["δυνάμεως",98,19],["αὐτοῦ",3,48],["οὐ",12,17],["σωθήσεται",171,125]],"A horse is vain for safety; neither shall he be delivered by the greatness of his power."],["18",[["Ἰδοὺ",51,17],["οἱ",1,128],["ὀφθαλμοὶ",91,51],["Κυρίου",7,21],["ἐπὶ",9,1],["τοὺς",1,56],["φοβουμένους",134,230],["αὐτὸν",3,82],["τοὺς",1,56],["ἐλπίζοντας",511,229],["ἐπὶ",9,1],["τὸ",1,32],["ἔλεος",182,33],["αὐτοῦ",3,48]],"Behold, the eyes of the Lord are on them that fear him, those that hope in his mercy;"],["19",[["ῥύσασθαι",335,103],["ἐκ",21,1],["θανάτου",169,21],["τὰς",1,39],["ψυχὰς",62,40],["αὐτῶν",3,41],["καὶ",2,8],["διαθρέψαι",2081,100],["αὐτοὺς",3,60],["ἐν",4,1],["λιμῷ",500,113]],"to deliver their souls from death, and to keep them alive in famine."],["20",[["Ἡ",1,11],["ψυχὴ",62,13],["ἡμῶν",6,41],["ὑπομένει",635,87],["τῷ",1,110],["Κυρίῳ",7,113],["ὅτι",19,8],["βοηθὸς",948,5],["καὶ",2,8],["ὑπερασπιστὴς",1876,5],["ἡμῶν",6,41],["ἐστιν",10,87]],"Our soul waits on the Lord; for he is our helper and defender."],["21",[["Ὅτι",19,8],["ἐν",4,1],["αὐτῷ",3,49],["εὐφρανθήσεται",242,125],["ἡ",1,11],["καρδία",63,13],["ἡμῶν",6,41],["καὶ",2,8],["ἐν",4,1],["τῷ",1,52],["ὀνόματι",55,53],["τῷ",1,52],["ἁγίῳ",75,34],["αὐτοῦ",3,48],["ἠλπίσαμεν",511,288]],"For our heart shall rejoice in him, and we have hoped in his holy name."],["22",[["Γένοιτο",30,397],["τὸ",1,32],["ἔλεός",182,33],["σου",5,146],["Κύριε",7,251],["ἐφʼ",9,1],["ἡμᾶς",6,60],["καθάπερ",688,8],["ἠλπίσαμεν",511,288],["ἐπὶ",9,1],["σέ",5,161]],"Let thy mercy, O Lord, be upon us, according as we have hoped in thee."]]