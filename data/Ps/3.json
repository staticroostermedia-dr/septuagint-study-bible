[["1",[["Ψαλμὸς",644,5],["τῷ",1,110],["Δαυὶδ",52,105],["ὁπότε",3224,17],["ἀπεδίδρασκεν",1427,14],["ἀπὸ",17,1],["προσώπου",47,24],["Ἀβεσσαλὼμ",15119,0],["τοῦ",1,30],["υἱοῦ",13,21],["αὐτοῦ",3,48]],"A Psalm of David, when he fled from the presence of his son Abessalom."],["2",[["Κύριε",7,250],["τί",39,119],["ἐπληθύνθησαν",316,94],["οἱ",1,128],["θλίβοντές",601,137],["με",6,82],["πολλοὶ",74,130],["ἐπανίστανται",1216,299],["ἐπʼ",9,1],["ἐμέ",6,82]],"O Lord, why are they that afflict me multiplied? many rise up against me."],["3",[["Πολλοὶ",74,130],["λέγουσι",31,191],["τῇ",1,95],["ψυχῇ",63,2],["μου",6,48],["οὐκ",12,17],["ἔστι",10,87],["σωτηρία",425,13],["αὐτῷ",3,49],["ἐν",4,1],["τῷ",1,110],["Θεῷ",20,113],["αὐτοῦ",3,48],["διάψαλμα",689,20]],"Many say concerning my soul, There is no deliverance for him in his God. Pause."],["4",[["Σὺ",5,156],["δὲ",14,12],["Κύριε",7,250],["ἀντιλήπτωρ",2209,5],["μου",6,48],["εἶ",10,145],["δόξα",141,188],["μου",6,48],["καὶ",2,8],["ὑψῶν",331,67],["τὴν",1,9],["κεφαλήν",144,10],["μου",6,48]],"But thou, O Lord, art my helper: my glory, and the one that lifts up my head."],["5",[["Φωνῇ",95,2],["μου",6,48],["πρὸς",15,1],["Κύριον",7,7],["ἐκέκραξα",592,147],["καὶ",2,8],["ἐπήκουσέ",597,3],["μου",6,48],["ἐξ",21,1],["ὄρους",87,24],["ἁγίου",75,88],["αὐτοῦ",3,144],["διάψαλμα",689,20]],"I cried to the Lord with my voice, and he heard me out of his holy mountain. Pause."],["6",[["Ἐγὼ",6,158],["ἐκοιμήθην",301,94],["καὶ",2,8],["ὕπνωσα",1664,147],["ἐξηγέρθην",656,148],["ὅτι",19,8],["Κύριος",7,5],["ἀντιλήψεταί",984,89],["μου",6,48]],"I lay down and slept; I awaked; for the Lord will help me."],["7",[["Οὐ",12,17],["φοβηθήσομαι",134,176],["ἀπὸ",17,1],["μυριάδων",1142,61],["λαοῦ",35,21],["τῶν",1,123],["κύκλῳ",258,17],["ἐπιτιθεμένων",239,468],["μοι",6,49]],"I will not be afraid of ten thousands of people, who beset me round about."],["8",[["Ἀνάστα",121,275],["Κύριε",7,250],["σῶσόν",172,548],["με",6,82],["ὁ",1,4],["Θεός",20,5],["μου",6,48],["ὅτι",19,8],["σὺ",5,156],["ἐπάταξας",145,154],["πάντας",11,58],["τοὺς",1,56],["ἐχθραίνοντάς",2678,229],["μοι",6,49],["ματαίως",654,17],["ὀδόντας",930,31],["ἁμαρτωλῶν",409,163],["συνέτριψας",268,154]],"Arise, Lord; deliver me, my God: for thou hast smitten all who were without cause mine enemies; thou hast broken the teeth of sinners."],["9",[["Τοῦ",1,30],["Κυρίου",7,21],["ἡ",1,11],["σωτηρία",425,13],["καὶ",2,8],["ἐπὶ",9,1],["τὸν",1,6],["λαόν",35,7],["σου",5,146],["ἡ",1,11],["εὐλογία",578,13],["σου",5,146]],"Deliverance is the Lord's, and thy blessing is upon thy people."]]