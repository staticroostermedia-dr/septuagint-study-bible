[["1",[["Συνέσεως",469,19],["Αἰθὰμ",11736,0],["τῷ",1,110],["Ἰσραηλίτῃ",3468,113]],"[A Psalm] of instruction for Ætham the Israelite."],["2",[["Τὰ",1,42],["ἐλέη",183,43],["σου",5,146],["Κύριε",7,250],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["ᾄσομαι",856,177],["εἰς",8,1],["γενεὰν",286,10],["καὶ",2,8],["γενεὰν",286,10],["ἀπαγγελῶ",273,157],["τὴν",1,9],["ἀλήθειάν",352,10],["σου",5,146],["ἐν",4,1],["τῷ",1,52],["στόματί",123,53],["μου",6,48]],"I will sing of thy mercies, O Lord, for ever: I will declare thy truth with my mouth to all generations."],["3",[["Ὅτι",19,8],["εἶπας",18,154],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["ἔλεος",183,33],["οἰκοδομηθήσεται",126,125],["ἐν",4,1],["τοῖς",1,138],["οὐρανοῖς",94,139],["ἑτοιμασθήσεται",371,125],["ἡ",1,11],["ἀλήθειά",352,13],["σου",5,146]],"For thou hast said, Mercy shall be built up for ever: thy truth shall be established in the heavens."],["4",[["Διεθέμην",619,152],["διαθήκην",169,10],["τοῖς",1,138],["ἐκλεκτοῖς",552,215],["μου",6,48],["ὤμοσα",347,147],["Δαυὶδ",52,105],["τῷ",1,110],["δούλῳ",136,113],["μου",6,48]],"I made a covenant with my chosen ones, I sware unto David my servant."],["5",[["Ἕως",42,8],["τοῦ",1,30],["αἰῶνος",100,21],["ἑτοιμάσω",371,227],["τὸ",1,32],["σπέρμα",218,33],["σου",5,146],["καὶ",2,8],["οἰκοδομήσω",126,157],["εἰς",8,1],["γενεὰν",286,10],["καὶ",2,8],["γενεὰν",286,10],["τὸν",1,6],["θρόνον",383,7],["σου",5,146],["διάψαλμα",689,20]],"I will establish thy seed for ever, and build up thy throne to all generations. Pause."],["6",[["Ἐξομολογήσονται",479,127],["οἱ",1,128],["οὐρανοὶ",94,51],["τὰ",1,42],["θαυμάσιά",884,65],["σου",5,146],["Κύριε",7,250],["καὶ",2,8],["τὴν",1,9],["ἀλήθειάν",352,10],["σου",5,146],["ἐν",4,1],["ἐκκλησίᾳ",563,2],["ἁγίων",75,163]],"The heavens shall declare thy wonders, O Lord; and thy truth in the assembly of the saints."],["7",[["Ὅτι",19,8],["τίς",39,150],["ἐν",4,1],["νεφέλαις",444,71],["ἰσωθήσεται",5382,125],["τῷ",1,110],["Κυρίῳ",7,113],["καὶ",2,8],["τίς",39,150],["ὁμοιωθήσεται",1175,125],["τῷ",1,110],["Κυρίῳ",7,113],["ἐν",4,1],["υἱοῖς",13,139],["Θεοῦ",20,21]],"For who in the heavens shall be compared to the Lord? and who shall be likened to the Lord among the sons of God?"],["8",[["Ὁ",1,4],["Θεὸς",20,5],["ἐνδοξαζόμενος",2529,114],["ἐν",4,1],["βουλῇ",350,2],["ἁγίων",75,163],["μέγας",66,16],["καὶ",2,8],["φοβερὸς",1210,16],["ἐπὶ",9,1],["πάντας",11,58],["τοὺς",1,56],["περικύκλῳ",1778,218],["αὐτοῦ",3,48]],"God is glorified in the council of the saints; great and terrible toward all that are round about him."],["9",[["Κύριε",7,250],["ὁ",1,4],["Θεὸς",20,5],["τῶν",1,123],["δυνάμεων",98,61],["τίς",39,150],["ὅμοιός",657,16],["σοι",5,151],["δυνατὸς",356,16],["εἶ",10,145],["Κύριε",7,250],["καὶ",2,8],["ἡ",1,11],["ἀλήθειά",352,13],["σου",5,146],["κύκλῳ",258,17],["σου",5,146]],"O Lord God of hosts, who is like to thee? thou art mighty, O Lord, and thy truth is round about thee."],["10",[["Σὺ",5,156],["δεσπόζεις",2014,145],["τοῦ",1,23],["κράτους",1139,24],["τῆς",1,18],["θαλάσσης",137,19],["τὸν",1,6],["δὲ",14,12],["σάλον",2637,7],["τῶν",1,44],["κυμάτων",1630,45],["αὐτῆς",3,83],["σὺ",5,156],["καταπραΰνεις",5702,145]],"Thou rulest the power of the sea; and thou calmest the tumult of its waves."],["11",[["Σὺ",5,156],["ἐταπείνωσας",322,154],["ὡς",36,8],["τραυματίαν",819,7],["ὑπερήφανον",1109,59],["καὶ",2,8],["ἐν",4,1],["τῷ",1,110],["βραχίονι",1032,113],["τῆς",1,18],["δυνάμεώς",98,19],["σου",5,146],["διεσκόρπισας",1001,154],["τοὺς",1,56],["ἐχθρούς",135,31],["σου",5,146]],"Thou hast brought down the proud as one that is slain; and with the arm of thy power thou hast scattered thine enemies."],["12",[["Σοί",5,151],["εἰσιν",10,191],["οἱ",1,128],["οὐρανοὶ",94,51],["καὶ",2,8],["σή",405,13],["ἐστιν",10,87],["ἡ",1,11],["γῆ",26,13],["τὴν",1,9],["οἰκουμένην",1326,10],["καὶ",2,8],["τὸ",1,32],["πλήρωμα",2185,33],["αὐτῆς",3,83],["σὺ",5,156],["ἐθεμελίωσας",1116,154]],"The heavens are thine, and the earth is thine: thou hast founded the world, and the fulness of it."],["13",[["Τὸν",1,6],["Βοῤῥᾶν",387,7],["καὶ",2,8],["θάλασσας",137,31],["σὺ",5,156],["ἔκτισας",786,154],["Θαβὼρ",0,0],["καὶ",2,8],["Ἑρμὼν",15571,0],["ἐν",4,1],["τῷ",1,52],["ὀνόματί",57,53],["σου",5,146],["ἀγαλλιάσονται",738,127]],"Thou hast created the north and the west: Thabor and Hermon shall rejoice in thy name."],["14",[["Σὸς",405,5],["ὁ",1,4],["βραχίων",1032,5],["μετὰ",29,1],["δυναστείας",918,40],["κραταιωθήτω",729,25],["ἡ",1,11],["χείρ",37,13],["σου",5,146],["ὑψωθήτω",331,25],["ἡ",1,11],["δεξιά",282,15],["σου",5,146]],"Thine is the mighty arm: let thy hand be strengthened, let thy right hand be exalted."],["15",[["Δικαιοσύνη",187,13],["καὶ",2,8],["κρίμα",267,33],["ἑτοιμασία",2679,13],["τοῦ",1,30],["θρόνου",383,21],["σου",5,146],["ἔλεος",183,33],["καὶ",2,8],["ἀλήθεια",352,13],["προπορεύσονται",5007,127],["πρὸ",238,1],["προσώπου",47,24],["σου",5,146]],"Justice and judgment are the establishment of thy throne: mercy and truth shall go before thy face."],["16",[["Μακάριος",806,16],["ὁ",1,4],["λαὸς",35,5],["ὁ",1,4],["γινώσκων",79,67],["ἀλαλαγμόν",2978,7],["Κύριε",7,250],["ἐν",4,1],["τῷ",1,110],["φωτὶ",380,113],["τοῦ",1,23],["προσώπου",47,24],["σου",5,146],["πορεύσονται",49,127]],"Blessed is the people that knows the joyful sound: they shall walk, O Lord, in the light of thy countenance."],["17",[["καὶ",2,8],["ἐν",4,1],["τῷ",1,52],["ὀνόματί",57,53],["σου",5,146],["ἀγαλλιάσονται",738,127],["ὅλην",235,37],["τὴν",1,9],["ἡμέραν",28,10],["καὶ",2,8],["ἐν",4,1],["τῇ",1,95],["δικαιοσύνῃ",187,2],["σου",5,146],["ὑψωθήσονται",331,135]],"And in thy name shall they rejoice all the day: and in thy righteousness shall they be exalted."],["18",[["Ὅτι",19,8],["τὸ",1,32],["καύχημα",1627,33],["τῆς",1,18],["δυνάμεως",98,19],["αὐτῶν",3,41],["σὺ",5,156],["εἶ",10,145],["καὶ",2,8],["ἐν",4,1],["τῇ",1,95],["εὐδοκίᾳ",1625,2],["σου",5,146],["ὑψωθήσεται",331,125],["τὸ",1,32],["κέρας",569,33],["ἡμῶν",6,41]],"For thou art the boast of their strength; and in thy good pleasure shall our horn be exalted,"],["19",[["ὅτι",19,8],["τοῦ",1,30],["Κυρίου",7,21],["ἡ",1,11],["ἀντίληψις",2404,13],["καὶ",2,8],["τοῦ",1,30],["ἁγίου",75,153],["Ἰσραὴλ",27,105],["βασιλέως",22,21],["ἡμῶν",6,41]],"for [our] help is of the Lord; and of the Holy One of Israel, our king."],["20",[["Τότε",250,17],["ἐλάλησας",50,154],["ἐν",4,1],["ὁράσει",509,2],["τοῖς",1,138],["υἱοῖς",13,139],["σου",5,146],["καὶ",2,8],["εἶπας",18,154],["ἐθέμην",110,152],["βοήθειαν",765,10],["ἐπὶ",9,1],["δυνατὸν",356,37],["ὕψωσα",331,147],["ἐκλεκτὸν",552,59],["ἐκ",21,1],["τοῦ",1,30],["λαοῦ",35,21],["μου",6,48]],"Then thou spokest in vision to thy children, and saidst, I have laid help on a mighty one; I have exalted one chosen out of my people."],["21",[["Εὗρον",101,141],["Δαυὶδ",52,105],["τὸν",1,6],["δοῦλόν",136,7],["μου",6,48],["ἐν",4,1],["ἐλέει",183,53],["ἁγίῳ",75,34],["ἔχρισα",712,147],["αὐτόν",3,82]],"I have found David my servant; I have anointed him by [my] holy mercy."],["22",[["Ἡ",1,11],["γὰρ",40,12],["χείρ",37,13],["μου",6,48],["συναντιλήψεται",4410,89],["αὐτῷ",3,49],["καὶ",2,8],["ὁ",1,4],["βραχίων",1032,5],["μου",6,48],["κατισχύσει",628,120],["αὐτόν",3,82]],"For my hand shall support him; and mine arm shall strengthen him."],["23",[["Οὐκ",12,17],["ὠφελήσει",1499,120],["ἐχθρὸς",135,5],["ἐν",4,1],["αὐτῷ",3,49],["καὶ",2,8],["υἱὸς",13,5],["ἀνομίας",275,19],["οὐ",12,17],["προσθήσει",201,120],["τοῦ",1,30],["κακῶσαι",757,100],["αὐτόν",3,82]],"The enemy shall have no advantage against him; and the son of transgression shall not hurt him again."],["24",[["Καὶ",2,8],["συγκόψω",2382,157],["ἀπὸ",17,1],["προσώπου",47,24],["αὐτοῦ",3,144],["τοὺς",1,56],["ἐχθροὺς",135,31],["αὐτοῦ",3,48],["καὶ",2,8],["τοὺς",1,56],["μισοῦντας",351,229],["αὐτὸν",3,82],["τροπώσομαι",1642,177]],"And I will hew down his foes before him, and put to flight those that hate him."],["25",[["Καὶ",2,8],["ἡ",1,11],["ἀλήθειά",352,13],["μου",6,48],["καὶ",2,8],["τὸ",1,32],["ἔλεός",183,33],["μου",6,48],["μετʼ",29,1],["αὐτοῦ",3,48],["καὶ",2,8],["ἐν",4,1],["τῷ",1,52],["ὀνόματί",57,53],["μου",6,48],["ὑψωθήσεται",331,125],["τὸ",1,32],["κέρας",569,33],["αὐτοῦ",3,48]],"But my truth and my mercy shall be with him; and in my name shall his horn be exalted."],["26",[["Καὶ",2,8],["θήσομαι",110,177],["ἐν",4,1],["θαλάσσῃ",137,2],["χεῖρα",37,10],["αὐτοῦ",3,48],["καὶ",2,8],["ἐν",4,1],["ποταμοῖς",249,139],["δεξιὰν",282,37],["αὐτοῦ",3,48]],"And I will set his hand in the sea, and his right hand in the rivers."],["27",[["Αὐτὸς",3,158],["ἐπικαλέσεταί",341,89],["με",6,82],["πατήρ",44,5],["μου",6,48],["εἶ",10,145],["σὺ",5,156],["Θεός",20,5],["μου",6,48],["καὶ",2,8],["ἀντιλήπτωρ",2209,5],["τῆς",1,18],["σωτηρίας",425,19],["μου",6,83]],"He shall call upon me, [saying], Thou art my Father, my God, and the helper of my salvation."],["28",[["Κᾀγὼ",613,105],["πρωτότοκον",445,59],["θήσομαι",110,177],["αὐτὸν",3,82],["ὑψηλὸν",289,59],["παρὰ",73,1],["τοῖς",1,138],["βασιλεῦσι",22,139],["τῆς",1,18],["γῆς",26,19]],"And I will make him [my] first-born, higher than the kings of the earth."],["29",[["Εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["φυλάξω",125,157],["αὐτῷ",3,49],["τὸ",1,32],["ἔλεός",183,33],["μου",6,48],["καὶ",2,8],["ἡ",1,11],["διαθήκη",169,13],["μου",6,48],["πιστὴ",750,15],["αὐτῷ",3,49]],"I will keep my mercy for him for ever, and my covenant [shall be] firm with him."],["30",[["Καὶ",2,8],["θήσομαι",110,177],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["τοῦ",1,30],["αἰῶνος",100,21],["τὸ",1,32],["σπέρμα",218,33],["αὐτοῦ",3,48],["καὶ",2,8],["τὸν",1,6],["θρόνον",383,7],["αὐτοῦ",3,48],["ὡς",36,8],["τὰς",1,39],["ἡμέρας",28,19],["τοῦ",1,30],["οὐρανοῦ",94,21]],"And I will establish his seed for ever and ever, and his throne as the days of heaven."],["31",[["Ἐὰν",45,8],["ἐγκαταλίπωσιν",364,224],["οἱ",1,128],["υἱοὶ",13,51],["αὐτοῦ",3,48],["τὸν",1,6],["νόμον",140,7],["μου",6,48],["καὶ",2,8],["τοῖς",1,91],["κρίμασί",267,92],["μου",6,48],["μὴ",25,8],["πορευθῶσιν",49,266]],"If his children should forsake my law, and walk not in my judgments;"],["32",[["ἐὰν",45,8],["τὰ",1,42],["δικαιώματά",428,43],["μου",6,48],["βεβηλώσωσι",608,224],["καὶ",2,8],["τὰς",1,39],["ἐντολάς",259,40],["μου",6,48],["μὴ",25,8],["φυλάξωσιν",125,224]],"if they should profane my ordinances, and not keep my commandments;"],["33",[["Ἐπισκέψομαι",375,231],["ἐν",4,1],["ῥάβδῳ",493,2],["τὰς",1,39],["ἀνομίας",275,40],["αὐτῶν",3,41],["καὶ",2,8],["ἐν",4,1],["μάστιξι",1308,71],["τὰς",1,39],["ἁμαρτίας",119,40],["αὐτῶν",3,41]],"I will visit their transgressions with a rod, and their sins with scourges."],["34",[["Τὸ",1,32],["δὲ",14,12],["ἔλεός",183,33],["μου",6,48],["οὐ",12,17],["μὴ",25,8],["διασκεδάσω",1114,157],["ἀπʼ",17,1],["αὐτοῦ",3,48],["οὐδὲ",106,12],["μὴ",25,8],["ἀδικήσω",760,157],["ἐν",4,1],["τῇ",1,95],["ἀληθείᾳ",352,2],["μου",6,48]],"But my mercy I will not utterly remove from him, nor wrong my truth."],["35",[["οὐδὲ",106,12],["μὴ",25,8],["βεβηλώσω",608,157],["τὴν",1,9],["διαθήκην",169,10],["μου",6,48],["καὶ",2,8],["τὰ",1,42],["ἐκπορευόμενα",365,203],["διὰ",56,1],["τῶν",1,44],["χειλέων",361,45],["μου",6,48],["οὐ",12,17],["μὴ",25,8],["ἀθετήσω",834,157]],"Neither will I by any means profane my covenant; and I will not make void the things that proceed out of my lips."],["36",[["Ἅπαξ",1315,17],["ὤμοσα",347,147],["ἐν",4,1],["τῷ",1,110],["ἁγίῳ",75,111],["μου",6,48],["εἰ",77,8],["τῷ",1,110],["Δαυὶδ",52,105],["ψεύσομαι",1099,177]],"Once have I sworn by my holiness, that I will not lie to David."],["37",[["Τὸ",1,32],["σπέρμα",218,33],["αὐτοῦ",3,48],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["μενεῖ",681,120],["καὶ",2,8],["ὁ",1,4],["θρόνος",383,5],["αὐτοῦ",3,48],["ὡς",36,8],["ὁ",1,4],["ἥλιος",323,5],["ἐναντίον",138,17],["μου",6,48]],"His seed shall endure for ever, and his throne as the sun before me;"],["38",[["καὶ",2,8],["ὡς",36,8],["ἡ",1,11],["σελήνη",1207,13],["κατηρτισμένη",1888,197],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["καὶ",2,8],["ὁ",1,4],["μάρτυς",875,5],["ἐν",4,1],["οὐρανῷ",94,113],["πιστός",750,16],["διάψαλμα",689,20]],"and as the moon [that is] established for ever, and as the faithful witness in heaven. Pause."],["39",[["Σὺ",5,156],["δὲ",14,12],["ἀπώσω",770,157],["καὶ",2,8],["ἐξουδένωσας",1068,154],["ἀνεβάλου",3397,169],["τὸν",1,6],["χριστόν",1072,7],["σου",5,146]],"But thou hast cast off and set at nought, thou hast rejected thine anointed."],["40",[["Κατέστρεψας",1220,154],["τὴν",1,9],["διαθήκην",169,10],["τοῦ",1,30],["δούλου",136,21],["σου",5,146],["ἐβεβήλωσας",608,154],["εἰς",8,1],["τὴν",1,9],["γῆν",26,10],["τὸ",1,32],["ἁγίασμα",835,33],["αὐτοῦ",3,48]],"Thou hast overthrown the covenant of thy servant; thou hast profaned his sanctuary, [casting it] to the ground."],["41",[["Καθεῖλες",602,154],["πάντας",11,58],["τοὺς",1,56],["φραγμοῦς",1979,31],["αὐτοῦ",3,48],["ἔθου",110,169],["τὰ",1,42],["ὀχυρώματα",775,43],["αὐτοῦ",3,48],["δειλίαν",3513,10]],"Thou hast broken down all his hedges; thou hast made his strong holds a terror."],["42",[["Διήρπασαν",1160,141],["αὐτὸν",3,82],["πάντες",11,130],["οἱ",1,128],["διοδεύοντες",1816,137],["ὁδὸν",68,10],["ἐγενήθη",30,38],["ὄνειδος",973,20],["τοῖς",1,138],["γείτοσιν",2072,139],["αὐτοῦ",3,48]],"All that go by the way have spoiled him: he is become a reproach to his neighbours."],["43",[["Ὕψωσας",331,154],["τὴν",1,9],["δεξιὰν",282,37],["τῶν",1,76],["ἐχθρῶν",135,77],["αὐτοῦ",3,48],["εὔφρανας",244,154],["πάντας",11,58],["τοὺς",1,56],["ἐχθροὺς",135,31],["αὐτοῦ",3,48]],"Thou hast exalted the right hand of his enemies; thou hast made all his enemies to rejoice."],["44",[["Ἀπέστρεψας",130,154],["τὴν",1,9],["βοήθειαν",765,10],["τῆς",1,18],["ῥομφαίας",248,19],["αὐτοῦ",3,48],["καὶ",2,8],["οὐκ",12,17],["ἀντελάβου",984,169],["αὐτοῦ",3,48],["ἐν",4,1],["τῷ",1,110],["πολέμῳ",163,113]],"Thou hast turned back the help of his sword, and hast not helped him in the battle."],["45",[["Κατέλυσας",861,154],["ἀπὸ",17,1],["καθαρισμοῦ",2017,21],["αὐτὸν",3,82],["τὸν",1,6],["θρόνον",383,7],["αὐτοῦ",3,48],["εἰς",8,1],["τὴν",1,9],["γῆν",26,10],["κατέῤῥαξας",2585,154]],"Thou hast deprived him of glory: thou hast broken down his throne to the ground."],["46",[["ἐσμίκρυνας",3824,154],["τὰς",1,39],["ἡμέρας",28,19],["τοῦ",1,30],["θρόνου",383,21],["αὐτοῦ",3,48],["κατέχεας",3856,154],["αὐτοῦ",3,48],["αἰσχύνην",685,10],["διάψαλμα",689,20]],"Thou hast shortened the days of his throne: thou hast poured shame upon him. Pause."],["47",[["Ἕως",42,8],["πότε",458,12],["Κύριε",7,250],["ἀποστρέφῃ",130,166],["εἰς",8,1],["τέλος",373,33],["ἐκκαυθήσεται",941,125],["ὡς",36,8],["πῦρ",118,33],["ἡ",1,11],["ὀργή",198,13],["σου",5,146]],"How long, O Lord, wilt thou turn away, for ever? shall thine anger flame out as fire?"],["48",[["Μνήσθητι",230,242],["τίς",39,368],["ἡ",1,11],["ὑπόστασίς",1877,13],["μου",6,48],["μὴ",25,8],["γὰρ",40,12],["ματαίως",654,17],["ἔκτισας",786,154],["πάντας",11,58],["τοὺς",1,56],["υἱοὺς",13,31],["τῶν",1,76],["ἀνθρώπων",43,77]],"Remember what my being is: for hast thou created all the sons of men in vain?"],["49",[["Τίς",39,150],["ἐστιν",10,87],["ἄνθρωπος",43,5],["ὃς",24,246],["ζήσεται",107,89],["καὶ",2,8],["οὐκ",12,17],["ὄψεται",112,89],["θάνατον",170,7],["ῥύσεται",337,89],["τὴν",1,9],["ψυχὴν",63,10],["αὐτοῦ",3,48],["ἐκ",21,1],["χειρὸς",37,19],["ᾅδου",586,21],["διάψαλμα",689,20]],"What man is there who shall live, and not see death? shall [any one] deliver his soul from the hand of Hades? Pause."],["50",[["Ποῦ",478,17],["ἐστι",10,87],["τὰ",1,42],["ἐλέη",183,43],["σου",5,146],["τὰ",1,42],["ἀρχαῖα",1570,65],["Κύριε",7,250],["ἃ",1,11],["ὤμοσας",347,154],["τῷ",1,110],["Δαυὶδ",52,105],["ἐν",4,1],["τῇ",1,95],["ἀληθείᾳ",352,2],["σου",5,146]],"Where are thine ancient mercies, O Lord, which thou swarest to David in thy truth?"],["51",[["Μνήσθητι",230,242],["Κύριε",7,250],["τοῦ",1,30],["ὀνειδισμου",733,21],["τῶν",1,76],["δούλων",136,77],["σου",5,146],["οὗ",120,17],["ὑπέσχον",5425,141],["ἐν",4,1],["τῷ",1,110],["κόλπῳ",1140,113],["μου",6,48],["πολλῶν",74,79],["ἐθνῶν",60,45]],"Remember, O Lord, the reproach of thy servants, which I have borne in my bosom, [even the reproach] of many nations;"],["52",[["οὗ",120,17],["ὠνείδισαν",945,141],["οἱ",1,128],["ἐχθροί",135,51],["σου",5,146],["Κύριε",7,250],["οὗ",120,17],["ὠνείδισαν",945,141],["τὸ",1,32],["ἀντάλλαγμα",3165,33],["τοῦ",1,30],["χριστοῦ",1072,21],["σου",5,146]],"wherewith thine enemies have reviled, O Lord: wherewith they have reviled the recompence of thine anointed."],["53",[["Εὐλογητὸς",767,16],["Κύριος",7,5],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["γένοιτο",30,392],["γένοιτο",30,392]],"Blessed be the Lord for ever. So be it, so be it."]]