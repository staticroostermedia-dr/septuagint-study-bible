[["1",[["Ψαλμὸς",644,5],["εἰς",8,1],["ἐξομολόγησιν",1934,10],["Ἀλαλάξατε",1984,69],["τῷ",1,110],["Κυρίῳ",7,113],["πᾶσα",11,15],["ἡ",1,11],["γῆ",26,13]],"A Psalm for Thanksgiving. Make a joyful noise to the Lord, all the earth."],["2",[["δουλεύσατε",398,69],["τῷ",1,110],["Κυρίῳ",7,113],["ἐν",4,1],["εὐφροσύνῃ",360,2],["εἰσέλθατε",86,69],["ἐνώπιον",115,1],["αὐτοῦ",3,48],["ἐν",4,1],["ἀγαλλιάσει",1981,2]],"Serve the Lord with gladness; come before his presence with exultation."],["3",[["Γνῶτε",79,118],["ὅτι",19,8],["Κύριος",7,5],["αὐτός",3,158],["ἐστιν",10,87],["ὁ",1,4],["Θεός",20,5],["αὐτὸς",3,158],["ἐποίησεν",23,3],["ἡμᾶς",6,60],["καὶ",2,8],["οὐχ",12,17],["ἡμεῖς",6,195],["λαὸς",35,5],["αὐτοῦ",3,48],["καὶ",2,8],["πρόβατα",194,43],["τῆς",1,18],["νομῆς",1205,19],["αὐτοῦ",3,48]],"Know that the Lord he is God; he made us, and not we ourselves; [we are] his people, and the sheep of his pasture."],["4",[["Εἰσέλθατε",86,69],["εἰς",8,1],["τὰς",1,39],["πύλας",162,40],["αὐτοῦ",3,48],["ἐν",4,1],["ἐξομολογήσει",479,120],["τὰς",1,39],["αὐλὰς",327,40],["αὐτοῦ",3,48],["ἐν",4,1],["ὕμνοις",1498,139],["ἐξομολογεῖσθε",479,382],["αὐτῷ",3,49],["αἰνεῖτε",402,307],["τὸ",1,32],["ὄνομα",57,33],["αὐτοῦ",3,48]],"Enter into his gates with thanksgiving, and his courts with hymns; give thanks to him, praise his name."],["5",[["Ὅτι",19,8],["χρηστὸς",1359,16],["Κύριος",7,5],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["τὸ",1,32],["ἔλεος",183,33],["αὐτοῦ",3,48],["καὶ",2,8],["ἕως",42,8],["γενεᾶς",286,19],["καὶ",2,8],["γενεᾶς",286,19],["ἡ",1,11],["ἀλήθεια",352,13],["αὐτοῦ",3,48]],"For the Lord is good, his mercy is for ever; and his truth [endures] to generation and generation."]]