[["1",[["Εἰς",8,1],["τὸ",1,32],["τέλος",373,33],["τοῖς",1,138],["υἱοῖς",13,139],["Κορὲ",874,250],["ψαλμός",644,5]],"For the end, a Psalm for the sons of Core."],["2",[["Εὐδόκησας",906,154],["Κύριε",7,250],["τὴν",1,9],["γῆν",26,10],["σου",5,146],["ἀπέστρεψας",130,154],["τὴν",1,9],["αἰχμαλωσίαν",461,10],["Ἰακώβ",146,105]],"O Lord, thou hast taken pleasure in thy land: thou hast turned back the captivity of Jacob."],["3",[["Ἀφῆκας",501,154],["τὰς",1,39],["ἀνομίας",275,40],["τῷ",1,110],["λαῷ",35,113],["σου",5,146],["ἐκάλυψας",620,154],["πάσας",11,109],["τὰς",1,39],["ἁμαρτίας",119,40],["αὐτῶν",3,41],["διάψαλμα",689,20]],"Thou hast forgiven thy people their transgressions; thou hast covered all their sins. Pause."],["4",[["Κατέπαυσας",778,154],["πᾶσαν",11,37],["τὴν",1,9],["ὀργήν",198,10],["σου",5,146],["ἀπέστρεψας",130,154],["ἀπὸ",17,1],["ὀργῆς",198,19],["θυμοῦ",178,21],["σου",5,146]],"Thou hast caused all thy wrath to cease: thou hast turned from thy fierce anger."],["5",[["Ἐπίστρεψον",117,198],["ἡμᾶς",6,60],["ὁ",1,4],["Θεὸς",20,5],["τῶν",1,76],["σωτηρίων",1788,163],["ἡμῶν",6,41],["καὶ",2,8],["ἀπόστρεψον",130,198],["τὸν",1,6],["θυμόν",178,7],["σου",5,146],["ἀφʼ",17,1],["ἡμῶν",6,41]],"Turn us, O God of our salvation, and turn thine anger away from us."],["6",[["Μὴ",25,8],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["ὀργισθῇς",725,278],["ἡμῖν",6,142],["ἢ",61,8],["διατενεῖς",3812,159],["τὴν",1,9],["ὀργήν",198,10],["σου",5,146],["ἀπὸ",17,1],["γενεᾶς",286,19],["εἰς",8,1],["γενεάν",286,10]],"Wouldest thou be angry with us for ever? or wilt thou continue thy wrath from generation to generation?"],["7",[["Ὁ",1,4],["Θεὸς",20,5],["σὺ",5,156],["ἐπιστρέψας",117,155],["ζωώσεις",107,159],["ἡμᾶς",6,60],["καὶ",2,8],["ὁ",1,4],["λαός",35,5],["σου",5,146],["εὐφρανθήσεται",244,125],["ἐπὶ",9,1],["σοί",5,151]],"O God, thou wilt turn and quicken us; and thy people shall rejoice in thee."],["8",[["Δεῖξον",870,198],["ἡμῖν",6,142],["Κύριε",7,250],["τὸ",1,32],["ἔλεός",183,33],["σου",5,146],["καὶ",2,8],["τὸ",1,32],["σωτήριόν",472,33],["σου",5,146],["δῴης",0,0],["ἡμῖν",6,142]],"Shew us thy mercy, O Lord, and grant us thy salvation."],["9",[["Ἀκούσομαι",54,177],["τί",39,119],["λαλήσει",50,120],["ἐν",4,1],["ἐμοὶ",6,49],["Κύριος",7,5],["ὁ",1,4],["Θεὸς",20,5],["ὅτι",19,8],["λαλήσει",50,120],["εἰρήνην",213,10],["ἐπὶ",9,1],["τὸν",1,6],["λαὸν",35,7],["αὐτοῦ",3,48],["καὶ",2,8],["ἐπὶ",9,1],["τοὺς",1,56],["ὁσίους",917,58],["αὐτοῦ",3,48],["καὶ",2,8],["ἐπὶ",9,1],["τοὺς",1,56],["ἐπιστρέφοντας",117,229],["πρὸς",15,1],["αὐτὸν",3,82],["καρδίαν",64,10]],"I will hear what the Lord God will say concerning me: for he shall speak peace to his people, and to his saints, and to those that turn their heart toward him."],["10",[["Πλὴν",257,1],["ἐγγὺς",1026,17],["τῶν",1,76],["φοβουμένων",134,295],["αὐτὸν",3,82],["τὸ",1,32],["σωτήριον",472,33],["αὐτοῦ",3,48],["τοῦ",1,30],["κατασκηνῶσαι",805,100],["δόξαν",141,10],["ἐν",4,1],["τῇ",1,95],["γῇ",26,2],["ἡμῶν",6,41]],"Moreover his salvation is near them that fear him; that glory may dwell in our land."],["11",[["Ἔλεος",183,33],["καὶ",2,8],["ἀλήθεια",352,13],["συνήντησαν",429,129],["δικαιοσύνη",187,13],["καὶ",2,8],["εἰρήνη",213,13],["κατεφίλησαν",1890,141]],"Mercy and truth are met together: righteousness and peace have kissed [each other]."],["12",[["Ἀλήθεια",352,13],["ἐκ",21,1],["τῆς",1,18],["γῆς",26,19],["ἀνέτειλε",900,3],["καὶ",2,8],["δικαιοσύνη",187,13],["ἐκ",21,1],["τοῦ",1,30],["οὐρανοῦ",94,21],["διέκυψε",2706,3]],"Truth has sprung out of the earth; and righteousness has looked down from heaven."],["13",[["Καὶ",2,8],["γὰρ",40,12],["ὁ",1,4],["Κύριος",7,5],["δώσει",33,120],["χρηστότητα",1845,10],["καὶ",2,8],["ἡ",1,11],["γῆ",26,13],["ἡμῶν",6,41],["δώσει",33,120],["τὸν",1,6],["καρπὸν",448,7],["αὐτῆς",3,83]],"For the Lord will give goodness; and our land shall yield her fruit."],["14",[["Δικαιοσύνη",187,13],["ἐναντίον",138,17],["αὐτοῦ",3,48],["προπορεύσεται",1281,89],["καὶ",2,8],["θήσει",110,120],["εἰς",8,1],["ὁδὸν",68,10],["τὰ",1,42],["διαβήματα",2077,43],["αὐτοῦ",3,48]],"Righteousness shall go before him; and shall set his steps in the way."]]