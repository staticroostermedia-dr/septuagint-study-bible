[["1",[["Εἰς",8,1],["τὸ",1,32],["τέλος",373,33],["ψαλμὸς",644,5],["τῷ",1,110],["Δαυίδ",52,105]],"For the end, a Psalm of David."],["2",[["Μακαρίος",806,16],["ὁ",1,4],["συνιῶν",2496,357],["ἐπὶ",9,1],["πτωχὸν",497,7],["καὶ",2,8],["πένητα",672,7],["ἐν",4,1],["ἡμέρᾳ",28,2],["πονηρᾷ",164,96],["ῥύσεται",337,89],["αὐτὸν",3,82],["ὁ",1,4],["Κύριος",7,5]],"Blessed [is the man] who thinks on the poor and needy: the Lord shall deliver him in an evil day."],["3",[["Κύριος",7,5],["φυλάξαι",125,100],["αὐτὸν",3,82],["καὶ",2,8],["ζήσαι",107,216],["αὐτὸν",3,82],["καὶ",2,8],["μακαρίσαι",1681,100],["αὐτὸν",3,82],["ἐν",4,1],["τῇ",1,95],["γῇ",26,2],["καὶ",2,8],["μὴ",25,8],["παραδοῖ",254,160],["αὐτὸν",3,82],["εἰς",8,1],["χεῖρας",37,40],["ἐχθροῦ",135,21],["αὐτοῦ",3,48]],"May the Lord preserve him and keep him alive, and bless him on the earth, and not deliver him into the hands of his enemy."],["4",[["Κύριος",7,5],["βοηθήσαι",553,216],["αὐτῷ",3,49],["ἐπὶ",9,1],["κλίνης",1221,19],["ὀδύνης",774,19],["αὐτοῦ",3,48],["ὅλην",235,37],["τὴν",1,9],["κοίτην",704,10],["αὐτοῦ",3,48],["ἔστρεψας",1078,154],["ἐν",4,1],["τῇ",1,95],["ἀῤῥωστίᾳ",2311,2],["αὐτοῦ",3,48]],"May the Lord help him upon the bed of his pain; thou hast made all his bed in his sickness."],["5",[["Ἐγὼ",6,511],["εἶπα",18,147],["Κύριε",7,250],["ἐλέησόν",446,198],["με",6,98],["ἴασαι",797,379],["τὴν",1,9],["ψυχήν",63,10],["μου",6,48],["ὅτι",19,8],["ἥμαρτόν",237,141],["σοι",5,151]],"I said, O Lord, have mercy upon me; heal my soul; for I have sinned against thee."],["6",[["Οἱ",1,128],["ἐχθροί",135,51],["μου",6,48],["εἶπαν",18,141],["κακά",161,65],["μοι",6,49],["πότε",458,12],["ἀποθανεῖται",109,89],["καὶ",2,8],["ἀπολεῖται",217,89],["τὸ",1,32],["ὄνομα",57,33],["αὐτοῦ",3,48]],"Mine enemies have spoken evil against me, [saying], When shall he die, and his name perish?"],["7",[["Καὶ",2,8],["εἰ",77,8],["εἰσεπορεύετο",376,22],["τοῦ",1,30],["ἰδεῖν",53,100],["μάτην",1774,17],["ἐλάλει",50,14],["ἡ",1,11],["καρδία",64,13],["αὐτοῦ",3,48],["συνήγαγεν",166,3],["ἀνομίαν",275,10],["ἑαυτῷ",92,49],["ἐξεπορεύετο",365,22],["ἔξω",527,17],["καὶ",2,8],["ἐλάλει",50,14]],"And if he came to see [me], his heart spoke vainly; he gathered iniquity to himself; he went forth and spoke in like manner."],["8",[["ἐπὶ",9,1],["τὸ",1,32],["αὐτό",3,121],["Κατʼ",32,1],["ἐμοῦ",6,48],["ἐψιθύριζον",5153,129],["πάντες",11,130],["οἱ",1,128],["ἐχθροί",135,51],["μου",6,48],["κατʼ",32,1],["ἐμοῦ",6,48],["ἐλογίζοντο",495,131],["κακά",161,65],["μοι",6,49]],"All my enemies whispered against me; against me they devised my hurt."],["9",[["Λόγον",48,7],["παράνομον",830,59],["κατέθεντο",3283,184],["κατʼ",32,1],["ἐμοῦ",6,48],["μὴ",25,8],["ὁ",1,4],["κοιμώμενος",301,114],["οὐχὶ",330,12],["προσθήσει",201,120],["τοῦ",1,30],["ἀναστῆναι",121,100]],"They denounced a wicked word against me, [saying], Now that he lies, shall he not rise up again?"],["10",[["Καὶ",2,8],["γὰρ",40,12],["ὁ",1,4],["ἄνθρωπος",43,5],["τῆς",1,18],["εἰρήνης",213,19],["μου",6,83],["ἐφʼ",9,1],["ὃν",24,106],["ἤλπισα",514,147],["ὁ",1,4],["ἐσθίων",147,67],["ἄρτους",197,31],["μου",6,48],["ἐμεγάλυνεν",604,3],["ἐπʼ",9,1],["ἐμὲ",6,82],["πτερνισμόν",6016,7]],"For even the man of my peace, in whom I trusted, who ate my bread, lifted up [his] heel against me."],["11",[["Σὺ",5,156],["δὲ",14,12],["Κύριε",7,250],["ἐλέησόν",446,198],["με",6,82],["καὶ",2,8],["ἀνάστησόν",121,198],["με",6,82],["καὶ",2,8],["ἀνταποδώσω",666,157],["αὐτοῖς",3,142]],"But thou, O Lord, have compassion upon me, and raise me up, and I shall requite them."],["12",[["Ἐν",4,1],["τούτῳ",16,279],["ἔγνων",79,147],["ὅτι",19,8],["τεθέληκάς",0,0],["με",6,82],["ὅτι",19,8],["οὐ",12,17],["μὴ",25,8],["ἐπιχαρῇ",1938,116],["ὁ",1,4],["ἐχθρός",135,5],["μου",6,48],["ἐπʼ",9,1],["ἐμέ",6,82]],"By this I know that thou hast delighted in me, because mine enemy shall not rejoice over me."],["13",[["Ἐμοῦ",6,48],["δὲ",14,12],["διὰ",56,1],["τὴν",1,9],["ἀκακίαν",2650,10],["ἀντελάβου",984,169],["καὶ",2,8],["ἐβεβαίωσάς",4705,154],["με",6,82],["ἐνώπιόν",115,1],["σου",5,146],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7]],"But thou didst help me because of [mine] innocence, and hast established me before thee for ever."],["14",[["Εὐλογητὸς",767,16],["Κύριος",7,5],["ὁ",1,4],["Θεὸς",20,5],["Ἰσραὴλ",27,105],["ἀπὸ",17,1],["τοῦ",1,30],["αἰῶνος",100,21],["καὶ",2,8],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["γένοιτο",30,392],["γένοιτο",30,392]],"Blessed [be] the Lord God of Israel from everlasting, and to everlasting. So be it, so be it."]]