["ᾅδου",583,21],["κατωτάτου",3289,153]],"For thy mercy is great toward me; and thou hast delivered my soul from the lowest hell."],["14",[["Ὁ",1,4],["Θεὸς",20,5],["παράνομοι",832,130],["ἐπανέστησαν",1221,141],["ἐπʼ",9,1],["ἐμὲ",6,82],["καὶ",2,8],["συναγωγὴ",284,13],["κραταιῶν",734,67],["ἐζήτησαν",190,141],["τὴν",1,9],["ψυχήν",62,10],["μου",6,48],["καὶ",2,8],["οὐ",12,17],["προέθεντό",2622,182],["σε",5,161],["ἐνώπιον",114,1],["αὐτῶν",3,41]],"O God, transgressors have risen up against me, and an assembly of violent [men] have sought my life; and have not set thee before them."],["15",[["Καὶ",2,8],["σὺ",5,156],["Κύριε",7,251],["ὁ",1,4],["Θεὸς",20,5],["οἰκτίρμων",2109,16],["καὶ",2,8],["ἐλεήμων",1491,16],["μακρόθυμος",1770,16],["καὶ",2,8],["πολυέλεος",2619,16],["καὶ",2,8],["ἀληθινός",1020,16]],"But thou, O Lord God, art compassionate and merciful, long-suffering, and abundant in mercy and true."],["16",[["Ἐπίβλεψον",516,198],["ἐπʼ",9,1],["ἐμὲ",6,82],["καὶ",2,8],["ἐλέησόν",457,243],["με",6,82],["δὸς",33,198],["τὸ",1,32],["κράτος",1139,33],["σου",5,146],["τῷ",1,110],["παιδί",126,113],["σου",5,146],["καὶ",2,8],["σῶσον",171,198],["τὸν",1,6],["υἱὸν",13,7],["τῆς",1,18],["παιδίσκης",601,19],["σου",5,146]],"Look thou upon me, and have mercy upon me: give thy strength to thy servant, and save the son of thine handmaid."],["17",[["Ποίησον",23,198],["μετʼ",29,1],["ἐμοῦ",6,48],["σημεῖον",502,33],["εἰς",8,1],["ἀγαθὸν",113,29],["καὶ",2,8],["ἰδέτωσαν",0,0],["οἱ",1,128],["μισοῦντές",355,137],["με",6,82],["καὶ",2,8],["αἰσχυνθήτωσαν",614,50],["ὅτι",19,8],["σὺ",5,156],["Κύριε",7,251],["ἐβοήθησάς",552,154],["μοι",6,49],["καὶ",2,8],["παρεκάλεσάς",432,154],["με",6,82]],"Establish with me a token for good; and let them that hate me see [it] and be ashamed; because thou, O Lord, hast helped me, and comforted me."]]