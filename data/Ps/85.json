[["1",[["Προσευχὴ",549,13],["τῷ",1,110],["Δαυίδ",52,105],["Κλίνον",829,583],["Κύριε",7,251],["τὸ",1,32],["οὖς",325,33],["σου",5,146],["καὶ",2,8],["εἰσάκουσόν",237,198],["μου",6,48],["ὅτι",19,8],["πτωχὸς",496,5],["καὶ",2,8],["πένης",668,5],["εἰμὶ",10,149],["ἐγώ",6,158]],"A Prayer of David. O Lord, incline thine ear, and hearken to me; for I am poor and needy."],["2",[["Φύλαξον",127,198],["τὴν",1,9],["ψυχήν",62,10],["μου",6,48],["ὅτι",19,8],["ὅσιός",918,16],["εἰμι",10,149],["σῶσον",171,171],["τὸν",1,6],["δοῦλόν",136,7],["σου",5,146],["ὁ",1,4],["Θεὸς",20,5],["τὸν",1,6],["ἐλπίζοντα",511,177],["ἐπὶ",9,1],["σέ",5,161]],"Preserve my soul, for I am holy; save thy servant, O God, who hopes in thee."],["3",[["Ἐλέησόν",457,243],["με",6,82],["Κύριε",7,251],["ὅτι",19,8],["πρὸς",15,1],["σὲ",5,161],["κεκράξομαι",590,176],["ὅλην",233,37],["τὴν",1,9],["ἡμέραν",28,10]],"Pity me, O Lord: for to thee will I cry all the day."],["4",[["Εὔφρανον",242,198],["τὴν",1,9],["ψυχὴν",62,10],["τοῦ",1,30],["δούλου",136,21],["σου",5,146],["ὅτι",19,8],["πρὸς",15,1],["σὲ",5,161],["Κύριε",7,251],["ᾖρα",0,0],["τὴν",1,9],["ψυχήν",62,10],["μου",6,48]],"Rejoice the soul of thy servant: for to thee, O Lord, have I lifted up my soul."],["5",[["Ὅτι",19,8],["σὺ",5,156],["Κύριε",7,251],["χρηστὸς",1357,16],["καὶ",2,8],["ἐπιεικὴς",3751,16],["καὶ",2,8],["πολυέλεος",2619,16],["πᾶσι",11,215],["τοῖς",1,138],["ἐπικαλουμένοις",340,346],["σε",5,161]],"For thou, O Lord, art kind, and gentle; and plenteous in mercy to all that call upon thee."],["6",[["Ἐνώτισαι",1316,296],["Κύριε",7,251],["τὴν",1,9],["προσευχήν",549,10],["μου",6,48],["καὶ",2,8],["πρόσχες",1692,154],["τῇ",1,95],["φωνῇ",95,2],["τῆς",1,18],["δεήσεώς",674,19],["μου",6,83]],"Give ear to my prayer, O Lord; and attend to the voice of my supplication."],["7",[["Ἐν",4,1],["ἡμέρᾳ",28,2],["θλίψεώς",437,19],["μου",6,83],["ἐκέκραξα",590,147],["πρὸς",15,1],["σὲ",5,161],["ὅτι",19,8],["εἰσήκουσάς",237,154],["μου",6,48]],"In the day of my trouble I cried to thee: for thou