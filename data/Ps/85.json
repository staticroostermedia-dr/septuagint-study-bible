thou didst hear me."],["8",[["Οὐκ",12,17],["ἔστιν",10,87],["ὅμοιός",657,16],["σοι",5,151],["ἐν",4,1],["θεοῖς",20,139],["Κύριε",7,250],["καὶ",2,8],["οὐκ",12,17],["ἔστι",10,87],["κατὰ",32,1],["τὰ",1,42],["ἔργα",105,43],["σου",5,146]],"There is none like to thee, O Lord, among the gods; and there are no [works] like to thy works."],["9",[["Πάντα",11,65],["τὰ",1,42],["ἔθνη",60,43],["ὅσα",103,43],["ἐποίησας",23,154],["ἥξουσι",260,350],["καὶ",2,8],["προσκυνήσουσιν",298,350],["ἐνώπιόν",115,1],["σου",5,146],["Κύριε",7,250],["καὶ",2,8],["δοξάσουσι",452,207],["τὸ",1,32],["ὄνομά",57,33],["σου",5,146]],"All nations whom thou hast made shall come, and shall worship before thee, O Lord; and shall glorify thy name."],["10",[["ὅτι",19,8],["μέγας",66,16],["εἶ",10,145],["σὺ",5,156],["καὶ",2,8],["ποιῶν",23,67],["θαυμάσια",884,65],["σὺ",5,156],["εἶ",10,145],["ὁ",1,4],["Θεὸς",20,5],["μόνος",302,16],["ὁ",1,4],["μέγας",66,16]],"For thou art great, and doest wonders: thou art the only [and] the great God."],["11",[["Ὁδήγησόν",1108,198],["με",6,82],["Κύριε",7,250],["ἐν",4,1],["τῇ",1,95],["ὁδῷ",68,2],["σου",5,146],["καὶ",2,8],["πορεύσομαι",49,177],["ἐν",4,1],["τῇ",1,95],["ἀληθείᾳ",352,2],["σου",5,146],["εὐφρανθήτω",244,25],["ἡ",1,11],["καρδία",64,13],["μου",6,48],["τοῦ",1,30],["φοβεῖσθαι",134,104],["τὸ",1,32],["ὄνομά",57,33],["σου",5,146]],"Guide me, O Lord, in thy way, and I will walk in thy truth: let my heart rejoice, that I may fear thy name."],["12",[["Ἐξομολογήσομαί",479,177],["σοι",5,151],["Κύριε",7,250],["ὁ",1,4],["Θεός",20,5],["μου",6,48],["ἐν",4,1],["ὅλῃ",235,96],["καρδίᾳ",64,2],["μου",6,48],["καὶ",2,8],["δοξάσω",452,227],["τὸ",1,32],["ὄνομά",57,33],["σου",5,146],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7]],"I will give thee thanks, O Lord my God, with all my heart; and I will glorify thy name for ever."],["13",[["Ὅτι",19,8],["τὸ",1,32],["ἔλεός",183,33],["σου",5,146],["μέγα",66,29],["ἐπʼ",9,1],["ἐμὲ",6,82],["καὶ",2,8],["ἐῤῥύσω",337,169],["τὴν",1,9],["ψυχήν",63,10],["μου",6,48],["ἐξ",21,1],["ᾅδου",586,21],["κατωτάτου",3285,153]],"For thy mercy is great toward me; and thou hast delivered my soul from the lowest hell."],["14",[["Ὁ",1,4],["Θεὸς",20,5],["παράνομοι",830,130],["ἐπανέστησαν",1216,141],["ἐπʼ",9,1],["ἐμὲ",6,82],["καὶ",2,8],["συναγωγὴ",284,13],["κραταιῶν",729,67],["ἐζήτησαν",191,141],["τὴν",1,9],["ψυχήν",63,10],["μου",6,48],["καὶ",2,8],["οὐ",12,17],["προέθεντό",2619,184],["σε",5,161],["ἐνώπιον",115,1],["αὐτῶν",3,41]],"O God, transgressors have risen up against me, and an assembly of violent [men] have sought my life; and have not set thee before them."],["15",[["Καὶ",2,8],["σὺ",5,156],["Κύριε",7,250],["ὁ",1,4],["Θεὸς",20,5],["οἰκτίρμων",2102,16],["καὶ",2,8],["ἐλεήμων",1489,16],["μακρόθυμος",1770,16],["καὶ",2,8],["πολυέλεος",2616,16],["καὶ",2,8],["ἀληθινός",1023,16]],"But thou, O Lord God, art compassionate and merciful, long-suffering, and abundant in mercy and true."],["16",[["Ἐπίβλεψον",517,198],["ἐπʼ",9,1],["ἐμὲ",6,82],["καὶ",2,8],["ἐλέησόν",446,198],["με",6,82],["δὸς",33,198],["τὸ",1,32],["κράτος",1139,33],["σου",5,146],["τῷ",1,110],["παιδί",127,113],["σου",5,146],["καὶ",2,8],["σῶσον",172,198],["τὸν",1,6],["υἱὸν",13,7],["τῆς",1,18],["παιδίσκης",605,19],["σου",5,146]],"Look thou upon me, and have mercy upon me: give thy strength to thy servant, and save the son of thine handmaid."],["17",[["Ποίησον",23,198],["μετʼ",29,1],["ἐμοῦ",6,48],["σημεῖον",505,33],["εἰς",8,1],["ἀγαθὸν",114,29],["καὶ",2,8],["ἰδέτωσαν",53,261],["οἱ",1,128],["μισοῦντές",351,137],["με",6,82],["καὶ",2,8],["αἰσχυνθήτωσαν",611,50],["ὅτι",19,8],["σὺ",5,156],["Κύριε",7,250],["ἐβοήθησάς",553,154],["μοι",6,49],["καὶ",2,8],["παρεκάλεσάς",434,154],["με",6,82]],"Establish with me a token for good; and let them that hate me see [it] and be ashamed; because thou, O Lord, hast helped me, and comforted me."]]