[["1",[["Τοῦ",1,30],["Δαυίδ",52,105],["Πρὸς",15,1],["σὲ",5,161],["Κύριε",7,250],["ἐκέκραξα",592,147],["ὁ",1,4],["Θεός",20,5],["μου",6,48],["μὴ",25,8],["παρασιωπήσῃς",1908,170],["ἐπʼ",9,1],["ἑμοὶ",9359,105],["μήποτε",964,17],["παρασιωπήσῃς",1908,170],["ἐπʼ",9,1],["ἐμοὶ",6,49],["καὶ",2,8],["ὁμοιωθήσομαι",1175,176],["τοῖς",1,138],["καταβαίνουσιν",175,352],["εἰς",8,1],["λάκκον",680,7]],"[A Psalm] of David. To thee, O Lord, have I cried; my God, be not silent toward me: lest thou be silent toward me, and so I should be likened to them that go down to the pit."],["2",[["Εἰσάκουσον",241,198],["τῆς",1,18],["φωνῆς",95,19],["τῆς",1,18],["δεήσεώς",677,19],["μου",6,83],["ἐν",4,1],["τῷ",1,110],["δέεσθαί",440,104],["με",6,82],["πρὸς",15,1],["σὲ",5,161],["ἐν",4,1],["τῷ",1,110],["αἴρειν",206,54],["με",6,82],["χεῖράς",37,40],["μου",6,48],["εἰς",8,1],["ναὸν",483,7],["ἅγιόν",75,59],["σου",5,146]],"Hearken to the voice of my supplication, when I pray to thee, when I lift up my hands toward thy holy temple."],["3",[["Μὴ",25,8],["συνελκύσῃς",8442,170],["μετὰ",29,1],["ἁμαρτωλῶν",409,163],["τὴν",1,9],["ψυχήν",63,10],["μου",6,48],["καὶ",2,8],["μετὰ",29,1],["ἐργαζομένων",467,468],["ἀδικίαν",288,10],["μὴ",25,8],["συναπολέσῃς",2962,170],["με",6,82],["τῶν",1,76],["λαλούντων",50,164],["εἰρήνην",213,10],["μετὰ",29,1],["τῶν",1,76],["πλησίον",292,17],["αὐτῶν",3,41],["κακὰ",161,65],["δὲ",14,12],["ἐν",4,1],["ταῖς",1,70],["καρδίαις",64,71],["αὐτῶν",3,41]],"Draw not away my soul with sinners, and destroy me not with the workers of iniquity, who speak peace with their neighbours, but evils are in their hearts."],["4",[["Δὸς",33,198],["αὐτοῖς",3,142],["κατὰ",32,1],["τὰ",1,42],["ἔργα",105,43],["αὐτῶν",3,41],["καὶ",2,8],["κατὰ",32,1],["τὴν",1,9],["πονηρίαν",730,10],["τῶν",1,44],["ἐπιτηδευμάτων",903,45],["αὐτῶν",3,168],["κατὰ",32,1],["τὰ",1,42],["ἔργα",105,43],["τῶν",1,123],["χειρῶν",37,61],["αὐτῶν",3,189],["δὸς",33,198],["αὐτοῖς",3,142],["ἀπόδος",312,198],["τὸ",1,32],["ἀνταπόδομα",1850,33],["αὐτῶν",3,41],["αὐτοῖς",3,142]],"Give them according to their works, and according to the wickedness of their devices: give them according to the works of their hands; render their recompence unto them."],["5",[["Ὅτι",19,8],["οὐ",12,17],["συνῆκαν",606,141],["εἰς",8,1],["τὰ",1,42],["ἔργα",105,43],["Κυρίου",7,21],["καὶ",2,8],["εἰς",8,1],["τὰ",1,42],["ἔργα",105,43],["τῶν",1,123],["χειρῶν",37,61],["αὐτοῦ",3,48],["καθελεῖς",602,159],["αὐτοὺς",3,60],["καὶ",2,8],["οὐ",12,17],["μὴ",25,8],["οἰκοδομήσεις",126,159],["αὐτούς",3,60]],"Because they have not attended to the works of the Lord, even to the works of his hands, thou shalt pull them down, and shalt not build them up."],["6",[["Εὐλογητὸς",767,16],["Κύριος",7,5],["ὅτι",19,8],["εἰσήκουσε",241,3],["τῆς",1,18],["φωνῆς",95,19],["τῆς",1,18],["δεήσεώς",677,19],["μου",6,83]],"Blessed be the Lord, for he has hearkened to the voice of my petition."],["7",[["Κύριος",7,5],["βοηθός",947,5],["μου",6,48],["καὶ",2,8],["ὑπερασπιστής",1875,5],["μου",6,48],["ἐπʼ",9,1],["αὐτῷ",3,49],["ἤλπισεν",514,3],["ἡ",1,11],["καρδία",64,13],["μου",6,48],["καὶ",2,8],["ἐβοηθήθην",553,148],["καὶ",2,8],["ἀνέθαλεν",2980,3],["ἡ",1,11],["σάρξ",287,13],["μου",6,48],["καὶ",2,8],["ἐκ",21,1],["θελήματός",1039,24],["μου",6,48],["ἐξομολογήσομαι",479,177],["αὐτῷ",3,49]],"The Lord is my helper and my defender; my heart has hoped in him, and I am helped: my flesh has revived, and willingly will I give praise to him."],["8",[["Κύριος",7,5],["κραταίωμα",4280,20],["τοῦ",1,30],["λαοῦ",35,21],["αὐτοῦ",3,48],["καὶ",2,8],["ὑπερασπιστὴς",1875,5],["τῶν",1,76],["σωτηρίων",1788,163],["τοῦ",1,30],["χριστοῦ",1072,21],["αὐτοῦ",3,48],["ἐστι",10,87]],"The Lord is the strength of his people, and the saving defender of his anointed."],["9",[["Σῶσον",172,198],["τὸν",1,6],["λαόν",35,7],["σου",5,146],["καὶ",2,8],["εὐλόγησον",149,198],["τὴν",1,9],["κληρονομίαν",299,10],["σου",5,146],["καὶ",2,8],["ποίμανον",0,0],["αὐτοὺς",3,60],["καὶ",2,8],["ἔπαρον",661,198],["αὐτοὺς",3,60],["ἕως",42,8],["τοῦ",1,30],["αἰῶνος",100,21]],"Save thy people, and bless thine inheritance: and take care of them, and lift them up for ever."]]