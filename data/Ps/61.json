[["1",[["Εἰς",8,1],["τὸ",1,32],["τέλος",373,33],["ὑπὲρ",139,1],["Ἰδιθοὺν",0,0],["ψαλμὸς",644,5],["τῷ",1,110],["Δαυίδ",52,105]],"For the end, a Psalm of David for Idithun."],["2",[["Οὐχὶ",330,12],["τῷ",1,110],["Θεῷ",20,113],["ὑποταγήσεται",1497,125],["ἡ",1,11],["ψυχή",63,13],["μου",6,48],["παρʼ",73,1],["αὐτοῦ",3,48],["γὰρ",40,12],["τὸ",1,32],["σωτήριόν",472,33],["μου",6,48]],"Shall not my soul be subjected to God? for of him is my salvation."],["3",[["Καὶ",2,8],["γὰρ",40,12],["αὐτὸς",3,158],["Θεός",20,5],["μου",6,48],["καὶ",2,8],["σωτήρ",1388,5],["μου",6,48],["ἀντιλήπτωρ",2209,5],["μου",6,48],["οὐ",12,17],["μὴ",25,8],["σαλευθῶ",678,555],["ἐπὶ",9,1],["πλεῖον",938,29]],"For he is my God and my Saviour; my helper, I shall not be moved very much."],["4",[["Ἕως",42,8],["πότε",458,12],["ἐπιτίθεσθε",239,68],["ἐπʼ",9,1],["ἄνθρωπον",43,7],["φονεύετε",970,84],["πάντες",11,130],["ὡς",36,8],["τοίχῳ",709,113],["κεκλιμένῳ",785,459],["καὶ",2,8],["φραγμῷ",1979,113],["ὠσμένῳ",3230,459]],"How long will ye assault a man? ye are all slaughtering as with a bowed wall and a broken hedge."],["5",[["Πλὴν",257,1],["τὴν",1,9],["τιμήν",720,10],["μου",6,48],["ἐβουλεύσαντο",641,184],["ἀπώσασθαι",770,103],["ἔδραμον",820,141],["ἐν",4,1],["δίψει",2257,53],["τῷ",1,52],["στόματι",123,53],["αὐτῶν",3,41],["εὐλόγουν",149,129],["καὶ",2,8],["τῇ",1,95],["καρδίᾳ",64,2],["αὐτῶν",3,41],["κατηρῶντο",779,131],["διάψαλμα",689,20]],"They only took counsel to set at nought mine honour: I ran in thirst: with their mouth they blessed, but with their heart they cursed. Pause."],["6",[["Πλὴν",257,1],["τῷ",1,110],["Θεῷ",20,113],["ὑποτάγηθι",1497,242],["ἡ",1,11],["ψυχή",63,13],["μου",6,48],["ὅτι",19,8],["παρʼ",73,1],["αὐτοῦ",3,48],["ἡ",1,11],["ὑπομονή",1616,13],["μου",6,48]],"Nevertheless do thou, my soul, be subjected to God; for of him [is] my patient hope."],["7",[["Ὅτι",19,8],["αὐτὸς",3,158],["Θεός",20,5],["μου",6,48],["καὶ",2,8],["σωτήρ",1388,5],["μου",6,48],["ἀντιλήπτωρ",2209,5],["μου",6,48],["οὐ",12,17],["μὴ",25,8],["μεταναστεύσω",4906,157]],"For he [is] my God and my Saviour; my helper, I shall not be moved."],["8",[["Ἐπὶ",9,1],["τῷ",1,110],["Θεῷ",20,113],["τὸ",1,32],["σωτήριόν",472,33],["μου",6,48],["καὶ",2,8],["ἡ",1,11],["δόξα",141,188],["μου",6,48],["ὁ",1,4],["Θεὸς",20,5],["τῆς",1,18],["βοηθείας",765,19],["μου",6,83],["καὶ",2,8],["ἡ",1,11],["ἐλπίς",530,13],["μου",6,48],["ἐπὶ",9,1],["τῷ",1,110],["Θεῷ",20,113]],"In God [is] my salvation and my glory: [he is] the God of my help, and my hope is in God."],["9",[["Ἐλπίσατε",514,69],["ἐπʼ",9,1],["αὐτὸν",3,82],["πᾶσα",11,15],["συναγωγὴ",284,13],["λαοῦ",35,21],["ἐκχέετε",436,307],["ἐνώπιον",115,1],["αὐτοῦ",3,48],["τὰς",1,39],["καρδίας",64,19],["ὑμῶν",5,136],["ὅτι",19,8],["ὁ",1,4],["Θεὸς",20,5],["βοηθὸς",947,5],["ἡμῶν",6,41],["διάψαλμα",689,20]],"Hope in him, all ye congregation of the people; pour out your hearts before him, for God is our helper. Pause."],["10",[["Πλὴν",257,1],["μάταιοι",654,130],["οἱ",1,128],["νἱοὶ",13,51],["τῶν",1,76],["ἀνθρώπων",43,77],["ψευδεῖς",549,130],["οἱ",1,128],["υἱοὶ",13,51],["τῶν",1,76],["ἀνθρώπων",43,77],["ἐν",4,1],["ζυγοῖς",2349,145],["τοῦ",1,30],["ἀδικῆσαι",760,100],["αὐτοὶ",3,195],["ἐκ",21,1],["ματαιότητος",937,19],["ἐπιτοαυτό",1404,105]],"But the sons of men are vain; the sons of men are false, so as to be deceitful in the balances; they are all alike [formed] out of vanity."],["11",[["Μὴ",25,8],["ἐλπίζετε",514,84],["ἐπʼ",9,1],["ἀδικίαν",288,10],["καὶ",2,8],["ἐπὶ",9,1],["ἁρπάγματα",2053,63],["μὴ",25,8],["ἐπιποθεῖτε",2537,84],["πλοῦτος",574,5],["ἐὰν",45,8],["ῥέῃ",667,166],["μὴ",25,8],["προστίθεσθε",201,68],["καρδίαν",64,10]],"Trust not in unrighteousness, and lust not after robberies: if wealth should flow in, set not your heart upon it."],["12",[["Ἅπαξ",1315,17],["ἐλάλησεν",50,3],["ὁ",1,4],["Θεὸς",20,5],["δύο",104,57],["ταῦτα",16,248],["ἤκουσα",54,147],["ὅτι",19,8],["τὸ",1,32],["κράτος",1139,33],["τοῦ",1,30],["Θεοῦ",20,21]],"God has spoken once, [and] I have heard these two things, that power is of God;"],["13",[["καὶ",2,8],["σοῦ",5,146],["Κύριε",7,250],["τὸ",1,32],["ἔλεος",183,33],["ὅτι",19,8],["σὺ",5,156],["ἀποδώσεις",312,159],["ἑκάστῳ",171,111],["κατὰ",32,1],["τὰ",1,42],["ἔργα",105,43],["αὐτοῦ",3,48]],"and mercy is thine, O Lord; for thou wilt recompense every one according to his works."]]