[["1",[["Εἰς",8,1],["τὸ",1,32],["τέλος",373,33],["τῷ",1,110],["δούλῳ",136,113],["Κυρίου",7,21],["τῷ",1,110],["Δαυίδ",52,105]],"For the end, by David the servant of the Lord."],["2",[["Φησὶν",660,87],["ὁ",1,4],["παράνομος",830,16],["τοῦ",1,30],["ἁμαρτάνειν",237,54],["ἐν",4,1],["ἑαυτῷ",92,49],["οὐκ",12,17],["ἔστι",10,87],["φόβος",333,5],["Θεοῦ",20,21],["ἀπέναντι",583,17],["τῶν",1,76],["ὀφθαλμῶν",91,77],["αὐτοῦ",3,48]],"The transgressor, that he may sin, says within himself, [that] there is no fear of God before his eyes."],["3",[["Ὅτι",19,8],["ἐδόλωσεν",5584,3],["ἐνώπιον",115,1],["αὐτοῦ",3,48],["τοῦ",1,30],["εὑρεῖν",101,100],["τὴν",1,9],["ἀνομίαν",275,10],["αὐτοῦ",3,48],["καὶ",2,8],["μισῆσαι",351,100]],"For he has dealt craftily before him, to discover his iniquity and hate it."],["4",[["Τὰ",1,42],["ῥήματα",116,43],["τοῦ",1,23],["στόματος",123,24],["αὐτοῦ",3,144],["ἀνομία",275,13],["καὶ",2,8],["δόλος",919,5],["οὐκ",12,17],["ἠβουλήθη",463,38],["συνιέναι",606,54],["τοῦ",1,30],["ἀγαθῦναι",1694,100]],"The words of his mouth are transgression and deceit: he is not inclined to understand [how] to do good."],["5",[["Ἀνομίαν",275,10],["ἐλογίσατο",495,252],["ἐπὶ",9,1],["τῆς",1,18],["κοίτης",704,19],["αὐτοῦ",3,48],["παρέστη",595,3],["πάσῃ",11,96],["ὁδῷ",68,2],["οὐκ",12,17],["ἀγαθῇ",114,96],["τῇ",1,95],["δὲ",14,12],["κακίᾳ",433,2],["οὐ",12,17],["προσώχθισε",1780,3]],"He devises iniquity on his bed; he gives himself to every evil way; and does not abhor evil."],["6",[["Κύριε",7,250],["ἐν",4,1],["τῷ",1,110],["οὐρανῷ",94,113],["τὸ",1,32],["ἔλεός",183,33],["σου",5,146],["καὶ",2,8],["ἡ",1,11],["ἀλήθειά",352,13],["σου",5,146],["ἕως",42,8],["τῶν",1,123],["νεφελῶν",444,61]],"O Lord, thy mercy is in the heaven; and thy truth [reaches] to the clouds."],["7",[["Ἡ",1,11],["δικαιοσύνη",187,13],["σου",5,146],["ὡς",36,8],["ὄρη",87,63],["Θεοῦ",20,21],["τὰ",1,253],["κρίματά",267,63],["σου",5,146],["ὡσεὶ",343,17],["ἄβυσσος",1083,13],["πολλή",74,15],["ἀνθρώπους",43,31],["καὶ",2,8],["κτήνη",223,43],["σώσεις",172,159],["Κύριε",7,250]],"Thy righteousness is as the mountains of God, thy judgments are as a great deep: O Lord, thou wilt preserve men and beasts."],["8",[["Ὡς",36,8],["ἐπλήθυνας",316,154],["τὸ",1,32],["ἔλεός",183,33],["σου",5,146],["ὁ",1,4],["Θεός",20,5],["οἱ",1,128],["δὲ",14,12],["υἱοὶ",13,51],["τῶν",1,76],["ἀνθρώπων",43,77],["ἐν",4,1],["σκέπῃ",1188,2],["τῶν",1,123],["πτερύγων",719,61],["σου",5,146],["ἐλπιοῦσι",514,207]],"How hast thou multiplied thy mercy, O God! so the children of men shall trust in the shelter of thy wings."],["9",[["Μεθυσθήσονται",1276,135],["ἀπὸ",17,1],["πιότητος",2612,19],["οἴκου",34,21],["σου",5,146],["καὶ",2,8],["τὸν",1,6],["χειμάῤῥουν",1842,7],["τῆς",1,18],["τρυφῆς",1643,19],["σου",5,146],["ποτιεῖς",790,159],["αὐτούς",3,60]],"They shall be fully satisfied with the fatness of thine house; and thou shalt cause them to drink of the full stream of thy delights."],["10",[["Ὅτι",19,8],["παρὰ",73,1],["σοὶ",5,151],["πηγὴ",565,13],["ζωῆς",216,19],["ἐν",4,1],["τῷ",1,110],["φωτί",380,113],["σου",5,146],["ὀψόμεθα",112,132],["φῶς",380,20]],"For with thee is the fountain of life: in thy light we shall see light."],["11",[["Παράτεινον",3605,198],["τὸ",1,32],["ἔλεός",183,33],["σου",5,146],["τοῖς",1,138],["γινώσκουσί",79,352],["σε",5,161],["καὶ",2,8],["τὴν",1,9],["δικαιοσύνην",187,10],["σου",5,146],["τοῖς",1,138],["εὐθέσι",825,215],["τῇ",1,95],["καρδίᾳ",64,2]],"Extend thy mercy to them that know thee; and thy righteousness to the upright in heart."],["12",[["Μὴ",25,8],["ἐλθέτω",55,46],["μοι",6,49],["ποῦς",210,5],["ὑπερηφανίας",1131,40],["καὶ",2,8],["χεὶρ",37,13],["ἁμαρτωλῶν",409,163],["μὴ",25,8],["σαλεύσαι",678,216],["με",6,82]],"Let not the foot of pride come against me, and let not the hand of sinners move me."],["13",[["Ἐκεῖ",76,17],["ἔπεσον",154,141],["πάντες",11,130],["οἱ",1,128],["ἐργαζόμενοι",467,351],["τὴν",1,9],["ἀνομίαν",275,10],["ἐξώσθησαν",1575,94],["καὶ",2,8],["οὐ",12,17],["μὴ",25,8],["δύνωνται",185,391],["στῆναι",78,100]],"There have all the workers of iniquity fallen: they are cast out, and shall not be able to stand."]]