[["1",[["Εἰς",8,1],["τὸ",1,32],["τέλος",369,33],["τῷ",1,110],["δούλῳ",136,113],["Κυρίου",7,21],["τῷ",1,110],["Δαυίδ",52,105]],"For the end, by David the servant of the Lord."],["2",[["Φησὶν",655,87],["ὁ",1,4],["παράνομος",832,16],["τοῦ",1,30],["ἁμαρτάνειν",244,54],["ἐν",4,1],["ἑαυτῷ",92,49],["οὐκ",12,17],["ἔστι",10,87],["φόβος",330,5],["Θεοῦ",20,21],["ἀπέναντι",580,17],["τῶν",1,76],["ὀφθαλμῶν",91,77],["αὐτοῦ",3,48]],"The transgressor, that he may sin, says within himself, [that] there is no fear of God before his eyes."],["3",[["Ὅτι",19,8],["ἐδόλωσεν",5613,3],["ἐνώπιον",114,1],["αὐτοῦ",3,48],["τοῦ",1,30],["εὑρεῖν",106,100],["τὴν",1,9],["ἀνομίαν",274,10],["αὐτοῦ",3,48],["καὶ",2,8],["μισῆσαι",355,100]],"For he has dealt craftily before him, to discover his iniquity and hate it."],["4",[["Τὰ",1,42],["ῥήματα",115,43],["τοῦ",1,23],["στόματος",123,24],["αὐτοῦ",3,144],["ἀνομία",274,13],["καὶ",2,8],["δόλος",920,5],["οὐκ",12,17],["ἠβουλήθη",461,38],["συνιέναι",602,54],["τοῦ",1,30],["ἀγαθῦναι",1699,100]],"The words of his mouth are transgression and deceit: he is not inclined to understand [how] to do good."],["5",[["Ἀνομίαν",274,10],["ἐλογίσατο",494,253],["ἐπὶ",9,1],["τῆς",1,18],["κοίτης",705,19],["αὐτοῦ",3,48],["παρέστη",592,3],["πάσῃ",11,96],["ὁδῷ",67,2],["οὐκ",12,17],["ἀγαθῇ",113,96],["τῇ",1,95],["δὲ",14,12],["κακίᾳ",431,2],["οὐ",12,17],["προσώχθισε",1833,3]],"He devises iniquity on his bed; he gives himself to every evil way; and does not abhor evil."],["6",[["Κύριε",7,251],["ἐν",4,1],["τῷ",1,110],["οὐρανῷ",94,113],["τὸ",1,32],["ἔλεός",182,33],["σου",5,146],["καὶ",2,8],["ἡ",1,11],["ἀλήθειά",350,13],["σου",5,146],["ἕως",42,8],["τῶν",1,123],["νεφελῶν",443,61]],"O Lord, thy mercy is in the heaven; and thy truth [reaches] to the clouds."],["7",[["Ἡ",1,11],["δικαιοσύνη",185,13],["σου",5,146],["ὡς",36,8],["ὄρη",86,63],["Θεοῦ",20,21],["τὰ",1,254],["κρίματά",266,63],["σου",5,146],["ὡσεὶ",342,17],["ἄβυσσος",1084,13],["πολλή",74,15],["ἀνθρώπους",43,31],["καὶ",2,8],["κτήνη",219,43],["σώσεις",171,159],["Κύριε",7,251]],"Thy righteousness is as the mountains of God, thy judgments are as a great deep: O Lord, thou wilt preserve men and beasts."],["8",[["Ὡς",36,8],["ἐπλήθυνας",315,154],["τὸ",1,32],["ἔλεός",182,33],["σου",5,146],["ὁ",1,4],["Θεός",20,5],["οἱ",1,128],["δὲ",14,12],["υἱοὶ",13,51],["τῶν",1,76],["ἀνθρώπων",43,77],["ἐν",4,1],["σκέπῃ",1189,2],["τῶν",1,123],["πτερύγων",720,61],["σου",5,146],["ἐλπιοῦσι",511,207]],"How hast thou multiplied thy mercy, O God! so the children of men shall trust in the shelter of thy wings."],["9",[["Μεθυσθήσονται",1274,135],["ἀπὸ",17,1],["πιότητος",2615,19],["οἴκου",34,21],["σου",5,146],["καὶ",2,8],["τὸν",1,6],["χειμάῤῥουν",1844,7],["τῆς",1,18],["τρυφῆς",1642,19],["σου",5,146],["ποτιεῖς",788,159],["αὐτούς",3,60]],"They shall be fully satisfied with the fatness of thine house; and thou shalt cause them to drink of the full stream of thy delights."],["10",[["Ὅτι",19,8],["παρὰ",72,1],["σοὶ",5,151],["πηγὴ",563,13],["ζωῆς",212,19],["ἐν",4,1],["τῷ",1,110],["φωτί",376,113],["σου",5,146],["ὀψόμεθα",111,132],["φῶς",376,20]],"For with thee is the fountain of life: in thy light we shall see light."],["11",[["Παράτεινον",3613,198],["τὸ",1,32],["ἔλεός",182,33],["σου",5,146],["τοῖς",1,138],["γινώσκουσί",81,357],["σε",5,161],["καὶ",2,8],["τὴν",1,9],["δικαιοσύνην",185,10],["σου",5,146],["τοῖς",1,138],["εὐθέσι",826,215],["τῇ",1,95],["καρδίᾳ",63,2]],"Extend thy mercy to them that know thee; and thy righteousness to the upright in heart."],["12",[["Μὴ",25,8],["ἐλθέτω",56,46],["μοι",6,49],["ποῦς",208,5],["ὑπερηφανίας",1130,40],["καὶ",2,8],["χεὶρ",37,13],["ἁμαρτωλῶν",406,163],["μὴ",25,8],["σαλεύσαι",679,276],["με",6,82]],"Let not the foot of pride come against me, and let not the hand of sinners move me."],["13",[["Ἐκεῖ",76,17],["ἔπεσον",154,141],["πάντες",11,130],["οἱ",1,128],["ἐργαζόμενοι",468,356],["τὴν",1,9],["ἀνομίαν",274,10],["ἐξώσθησαν",1576,94],["καὶ",2,8],["οὐ",12,17],["μὴ",25,8],["δύνωνται",184,396],["στῆναι",78,100]],"There have all the workers of iniquity fallen: they are cast out, and shall not be able to stand."]]