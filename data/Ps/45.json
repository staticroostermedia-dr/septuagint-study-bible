[["1",[["Εἰς",8,1],["τὸ",1,32],["τέλος",373,33],["ὑπὲρ",139,1],["τῶν",1,76],["υἱῶν",13,77],["Κορὲ",874,250],["ὑπὲρ",139,1],["τῶν",1,76],["κρυφίων",2733,163],["ψαλμός",644,5]],"For the end, for the sons of Core; a Psalm concerning secret things."],["2",[["Ὁ",1,4],["Θεὸς",20,5],["ἡμῶν",6,41],["καταφυγὴ",1678,13],["καὶ",2,8],["δύναμις",98,13],["βοηθὸς",947,5],["ἐν",4,1],["θλίψεσι",438,71],["ταῖς",1,70],["εὑρούσαις",101,648],["ἡμᾶς",6,60],["σφόδρα",150,17]],"God is our refuge and strength, a help in the afflictions that have come heavily upon us."],["3",[["Διὰ",56,1],["τοῦτο",16,122],["οὐ",12,17],["φοβηθησόμεθα",134,349],["ἐν",4,1],["τῷ",1,110],["ταράσσεσθαι",508,104],["τὴν",1,9],["γῆν",26,10],["καὶ",2,8],["μετατίθεσθαι",2027,104],["ὄρη",87,63],["ἐν",4,1],["καρδίαις",64,71],["θαλασσῶν",137,61]],"Therefore will we not fear when the earth is troubled, and the mountains are removed into the depths of the seas."],["4",[["Ἤχησαν",1660,141],["καὶ",2,8],["ἐταράχθησαν",508,94],["τὰ",1,42],["ὕδατα",85,43],["αὐτῶν",3,41],["ἐταράχθησαν",508,94],["τὰ",1,42],["ὄρη",87,43],["ἐν",4,1],["τῇ",1,95],["κραταιότητι",7503,2],["αὐτοῦ",3,48],["διάψαλμα",689,20]],"Their waters have roared and been troubled, the mountains have been troubled by his might. Pause."],["5",[["Τοῦ",1,30],["ποταμοῦ",249,21],["τὰ",1,42],["ὁρμήματα",2849,43],["εὐφραίνουσι",244,191],["τὴν",1,9],["πόλιν",41,10],["τοῦ",1,30],["Θεοῦ",20,21],["ἡγίασε",329,3],["τὸ",1,32],["σκήνωμα",682,33],["αὐτοῦ",3,48],["ὁ",1,4],["ὕψιστος",474,16]],"The flowings of the river gladden the city of God: the Most High has sanctified his tabernacle."],["6",[["Ὁ",1,4],["Θεὸς",20,5],["ἐν",4,1],["μέσῳ",113,34],["αὐτῆς",3,83],["οὐ",12,17],["σαλευθήσεται",678,125],["βοηθήσει",366,373],["αὐτῇ",3,99],["ὁ",1,4],["Θεὸς",20,5],["τῷ",1,52],["προσώπῳ",47,53]],"God is in the midst of her; she shall not be moved: God shall help her with his countenance."],["7",[["Ἐταράχθησαν",508,94],["ἔθνη",60,43],["ἔκλιναν",785,141],["βασιλεῖαι",157,180],["ἔδωκε",33,3],["φωνὴν",95,10],["αὐτοῦ",3,48],["ἐσαλεύθη",678,38],["ἡ",1,11],["γῆ",26,13]],"The nations were troubled, the kingdoms tottered: he uttered his voice, the earth shook."],["8",[["Κύριος",7,5],["τῶν",1,123],["δυνάμεων",98,61],["μεθʼ",29,1],["ἡμῶν",6,189],["ἀντιλήπτωρ",2209,5],["ἡμῶν",6,189],["ὁ",1,4],["Θεὸς",20,5],["Ἰακώβ",146,105],["διάψαλμα",689,20]],"The Lord of hosts is with us; the God of Jacob is our helper. Pause."],["9",[["Δεῦτε",1159,17],["καὶ",2,8],["ἴδετε",53,69],["τὰ",1,42],["ἔργα",105,43],["τοῦ",1,30],["Κυρίου",7,21],["ἃ",1,11],["ἔθετο",110,26],["τέρατα",1005,43],["ἐπὶ",9,1],["τῆς",1,18],["γῆς",26,19]],"Come, and behold the works of the Lord, what wonders he has achieved on the earth."],["10",[["ἀνταναιρῶν",2982,67],["πολέμους",163,31],["μέχρι",781,1],["τῶν",1,44],["περάτων",876,45],["τῆς",1,18],["γῆς",26,19],["τόξον",711,20],["συντρίψει",268,120],["καὶ",2,8],["συγκλάσει",3644,120],["ὅπλον",764,20],["καὶ",2,8],["θυρεοὺς",1723,31],["κατακαύσει",554,120],["ἐν",4,1],["πυρί",118,53]],"Putting an end to wars as for the ends of the earth; he will crush the bow, and break in pieces the weapon, and burn the bucklers with fire."],["11",[["Σχολάσατε",5090,69],["καὶ",2,8],["γνῶτε",79,118],["ὅτι",19,8],["ἐγώ",6,158],["εἰμι",10,149],["ὁ",1,4],["Θεὸς",20,5],["ὑψωθήσομαι",331,176],["ἐν",4,1],["τοῖς",1,91],["ἔθνεσιν",60,92],["ὑψωθήσομαι",331,176],["ἐν",4,1],["τῇ",1,95],["γῇ",26,2]],"Be still, and know that I am God: I will be exalted among the nations, I will be exalted in the earth."],["12",[["Κύριος",7,5],["τῶν",1,123],["δυνάμεων",98,61],["μεθʼ",29,1],["ἡμῶν",6,189],["ἀντιλήπτωρ",2209,5],["ἡμῶν",6,189],["ὁ",1,4],["Θεὸς",20,5],["Ἰακώβ",146,105]],"The Lord of hosts is with us; the God of Jacob is our helper."]]