όν",543,198],["με",6,82]],"Deal with thy servant according to thy mercy, and teach me thine ordinances."],["125",[["Δοῦλός",136,5],["σου",5,146],["εἰμὶ",10,149],["ἐγὼ",6,158],["συνέτισόν",2207,198],["με",6,82],["καὶ",2,8],["γνώσομαι",81,176],["τὰ",1,42],["μαρτύριά",220,43],["σου",5,146]],"I am thy servant; instruct me, and I shall know thy testimonies."],["126",[["Καιρὸς",132,5],["τοῦ",1,30],["ποιῆσαι",23,100],["τῷ",1,110],["Κυρίῳ",7,113],["διεσκέδασαν",1115,141],["τὸν",1,6],["νόμον",140,7],["σου",5,146]],"[It is] time for the Lord to work: they have utterly broken thy law."],["127",[["Διὰ",54,1],["τοῦτο",16,122],["ἠγάπησα",224,147],["τὰς",1,39],["ἐντολάς",259,40],["σου",5,146],["ὑπὲρ",139,1],["χρυσίον",202,20],["καὶ",2,8],["τοπάζιον",3985,105]],"Therefore have I loved thy commandments more than gold, or the topaz."],["128",[["Διὰ",54,1],["τοῦτο",16,122],["πρὸς",15,1],["πάσας",11,109],["τὰς",1,39],["ἐντολάς",259,40],["σου",5,146],["κατωρθούμην",1471,380],["πᾶσαν",11,37],["ὁδὸν",67,10],["ἄδικον",402,37],["ἐμίσησα",355,147]],"Therefore I directed myself [according] to all thy commandments: I have hated every unjust way."],["129",[["Θαυμαστὰ",1074,74],["τὰ",1,254],["μαρτύριά",220,63],["σου",5,146],["διὰ",54,1],["τοῦτο",16,122],["ἐξηρεύνησεν",1864,3],["αὐτὰ",3,66],["ἡ",1,11],["ψυχή",62,13],["μου",6,48]],"Thy testimonies are wonderful: therefore my soul has sought them out."],["130",[["Ἡ",1,11],["δήλωσις",4226,13],["τῶν",1,76],["λόγων",48,77],["σου",5,146],["φωτιεῖ",1232,120],["καὶ",2,8],["συνετιεῖ",2207,120],["νηπίους",1015,58]],"The manifestation of thy words will enlighten, and instruct the simple."],["131",[["Τὸ",1,32],["στόμα",123,33],["μου",6,48],["ἤνοιξα",621,147],["καὶ",2,8],["εἵλκυσα",1222,147],["πνεῦμα",167,20],["ὅτι",19,8],["τὰς",1,39],["ἐντολάς",259,40],["σου",5,146],["ἐπεπόθουν",2541,129]],"I opened my mouth, and drew breath: for I earnestly longed after thy commandments."],["132",[["Ἐπίβλεψον",516,198],["ἐπʼ",9,1],["ἐμὲ",6,82],["καὶ",2,8],["ἐλέησόν",457,243],["με",6,82],["κατὰ",32,1],["τὸ",1,32],["κρίμα",266,33],["τῶν",1,76],["ἀγαπώντων",224,164],["τὸ",1,32],["ὄνομά",55,33],["σου",5,146]],"Look upon me and have mercy upon me, after the manner of them that love thy name."],["133",[["Τὰ",1,42],["διαβήματά",2082,43],["μου",6,48],["κατεύθυνον",828,198],["κατὰ",32,1],["τὸ",1,32],["λόγιόν",1249,33],["σου",5,146],["καὶ",2,8],["μὴ",25,8],["κατακυριευσάτω",2091,46],["μου",6,48],["πᾶσα",11,15],["ἀνομία",274,13]],"Order my steps according to thy word: and let not any iniquity have dominion over me."],["134",[["Λύτρωσαί",548,296],["με",6,82],["ἀπὸ",17,1],["συκοφαντίας",3970,40],["ἀνθρώπων",43,77],["καὶ",2,8],["φυλάξω",127,157],["τὰς",1,39],["ἐντολάς",259,40],["σου",5,146]],"Deliver me from the false accusation of men: so will I keep thy commandments."],["135",[["Τὸ",1,32],["πρόσωπόν",47,33],["σου",5,146],["ἐπίφανον",1709,198],["ἐπὶ",9,1],["τὸν",1,6],["δοῦλόν",136,7],["σου",5,146],["καὶ",2,8],["δίδαξόν",543,198],["με",6,82],["τὰ",1,42],["δικαιώματά",425,43],["σου",5,146]],"Cause thy face to shine upon thy servant: and teach me thine ordinances."],["136",[["Διεξόδους",1508,40],["ὑδάτων",85,45],["κατέβησαν",174,141],["οἱ",1,128],["ὀφθαλμοί",91,51],["μου",6,48],["ἐπεὶ",1238,8],["οὐκ",12,17],["ἐφύλαξα",127,147],["τὸν",1,6],["νόμον",140,7],["σου",5,146]],"Mine eyes have been bathed in streams of water, because I kept not thy law."],["137",[["Δίκαιος",152,16],["εἶ",10,145],["Κύριε",7,251],["καὶ",2,8],["εὐθεῖς",826,185],["αἱ",1,183],["κρίσεις",226,179],["σου",5,146]],"Righteous art thou, O Lord, and upright are thy judgments."],["138",[["Ἐνετείλω",143,169],["δικαιοσύνην",185,10],["τὰ",1,42],["μαρτύριά",220,43],["σου",5,146],["καὶ",2,8],["ἀλήθειαν",350,10],["σφόδρα",149,17]],"Thou hast commanded righteousness and perfect truth, [as] thy testimonies."],["139",[["Ἐξέτηξέ",3191,3],["με",6,82],["ὁ",1,4],["ζῆλός",1095,5],["σου",5,146],["ὅτι",19,8],["ἐπελάθοντο",3018,182],["τῶν",1,76],["λόγων",48,77],["σου",5,146],["οἱ",1,128],["ἐχθροί",135,51],["μου",6,48]],"Thy zeal has quite wasted me: because mine enemies have forgotten thy words."],["140",[["Πεπυρωμένον",939,587],["τὸ",1,32],["λόγιόν",1249,33],["σου",5,146],["σφόδρα",149,17],["καὶ",2,8],["ὁ",1,4],["δοῦλός",136,5],["σου",5,146],["ἠγάπησεν",224,3],["αὐτό",3,121]],"Thy word [has been] very fully tried; and thy servant loves it."],["141",[["Νεώτερος",513,16],["ἐγὼ",6,158],["εἰμι",10,149],["καὶ",2,8],["ἐξουδενωμένος",1069,228],["τὰ",1,42],["δικαιώματά",425,43],["σου",5,146],["οὐκ",12,17],["ἐπελαθόμην",512,152]],"I am young and despised: [yet] I have not forgotten thine ordinances."],["142",[["Ἡ",1,11],["δικαιοσύνη",185,13],["σου",5,146],["δικαιοσύνη",185,13],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["καὶ",2,8],["ὁ",1,4],["νόυος",0,0],["σου",5,146],["ἀλήθεια",350,13]],"Thy righteousness is an everlasting righteousness, and thy law is truth."],["143",[["Θλίψεις",437,179],["καὶ",2,8],["ἀνάγκαι",1125,179],["εὕροσάν",0,0],["με",6,82],["ἐντολαί",259,179],["σου",5,146],["μελέτη",2284,13],["μου",6,48]],"Afflictions and distresses found me: [but] thy commandments [were] my meditation."],["144",[["Δικαιοσύνη",185,13],["τὰ",1,42],["μαρτύριά",220,43],["σου",5,146],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["συνέτισόν",2207,198],["με",6,82],["καὶ",2,8],["ζήσομαι",117,176]],"Thy testimonies [are] an everlasting righteousness: instruct me, and I shall live."],["145",[["Ἐκέκραξα",590,147],["ἐν",4,1],["ὅλῃ",233,96],["καρδίᾳ",63,2],["μου",6,48],["ἐπάκουσόν",595,198],["μου",6,48],["Κύριε",7,251],["τὰ",1,42],["δικαιώματά",425,43],["σου",5,146],["ἐκζητήσω",459,157]],"I cried with my whole heart; hear me, O Lord: I will search out thine ordinances."],["146",[["Ἐκέκραξά",0,0],["σοι",5,151],["σῶσόν",171,198],["με",6,82],["καὶ",2,8],["φυλάξω",127,157],["τὰ",1,42],["μαρτύριά",220,43],["σου",5,146]],"I cried to thee; save me, and I will keep thy testimonies."],["147",[["Προέφθασα",1834,147],["ἐν",4,1],["ἀωρίᾳ",2671,96],["καὶ",2,8],["ἐκέκραξα",590,147],["εἰς",8,1],["τοὺς",1,56],["λόγους",48,31],["σου",5,146],["ἐπήλπισα",3201,147]],"I arose before the dawn, and cried: I hoped in thy words."],["148",[["Προέφθασαν",1834,141],["οἱ",1,128],["ὀφθαλμοί",91,51],["μου",6,48],["πρὸς",15,1],["ὄρθρον",1436,7],["τοῦ",1,30],["μελετᾷν",1344,54],["τὰ",1,42],["λόγιά",1249,43],["σου",5,146]],"Mine eyes prevented the dawn, that I might meditate on thine oracles."],["149",[["Τῆς",1,18],["φωνῆς",95,19],["μου",6,83],["ἄκουσον",53,198],["Κύριε",7,251],["κατὰ",32,1],["τὸ",1,32],["ἔλεός",182,33],["σου",5,146],["κατὰ",32,1],["τὸ",1,32],["κρίμα",266,33],["σου",5,146],["ζῆσόν",117,474],["με",6,82]],"Hear my voice, O Lord, according to thy mercy; quicken me according to thy judgment."],["150",[["Προσήγγισαν",2383,141],["οἱ",1,128],["καταδιώκοντές",619,137],["με",6,82],["ἀνομίᾳ",274,2],["ἀπὸ",17,1],["δὲ",14,12],["τοῦ",1,30],["νόμου",140,21],["σου",5,146],["ἐμακρύνθησαν",0,0]],"They have drawn nigh who persecuted me unlawfully; and they are far removed from thy law."],["151",[["Ἐγγὺς",1022,17],["εἶ",10,145],["Κύριε",7,251],["καὶ",2,8],["πᾶσαι",11,185],["αἱ",1,183],["ὁδοί",67,179],["σου",5,146],["ἀλήθεια",350,13]],"Thou art near, O Lord; and all thy ways are truth."],["152",[["Κατʼ",32,1],["ἀρχὰς",269,40],["ἔγνων",81,147],["ἐκ",21,1],["τῶν",1,44],["μαρτυρίων",220,45],["σου",5,146],["ὅτι",19,8],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["ἐθεμελίωσας",1203,154],["αὐτά",3,66]],"I have known of old concerning thy testimonies, that thou hast founded them for ever."],["153",[["Ἴδε",693,17],["τὴν",1,9],["ταπείνωσίν",1483,10],["μου",6,48],["καὶ",2,8],["ἐξελοῦ",411,275],["με",6,82],["ὅτι",19,8],["τοῦ",1,30],["νόμου",140,21],["σου",5,146],["οὐκ",12,17],["ἐπελαθόμην",512,152]],"Look upon mine affliction, and rescue me; for I have not forgotten thy law."],["154",[["Κρῖνον",240,36],["τὴν",1,9],["κρίσιν",226,10],["μου",6,48],["καὶ",2,8],["λύτρωσαί",548,296],["με",6,82],["διὰ",54,1],["τὸν",1,6],["λόγον",48,7],["σου",5,146],["ζῆσόν",117,171],["με",6,82]],"Plead my cause, and ransom me: quicken me because of thy word."],["155",[["Μακρὰν",638,37],["ἀπὸ",17,1],["ἁμαρτωλῶν",406,163],["σωτηρία",422,186],["ὅτι",19,8],["τὰ",1,350],["δικαιώματά",425,63],["σου",5,146],["οὐκ",12,17],["ἐξεζήτησαν",459,141]],"Salvation is far from sinners: for they have not searched out thine ordinances."],["156",[["Οἱ",1,128],["οἰκτιρμοί",1188,51],["σου",5,146],["πολλοὶ",74,130],["Κύριε",7,251],["κατὰ",32,1],["τὸ",1,32],["κρίμα",266,33],["σου",5,146],["ζῆσόν",117,474],["με",6,82]],"Thy mercies, O Lord, are many: quicken me according to thy judgment."],["157",[["Πολλοὶ",74,130],["οἱ",1,128],["ἐκδιώκοντές",2234,137],["με",6,82],["καὶ",2,8],["θλίβοντές",599,137],["με",6,82],["ἐκ",21,1],["τῶν",1,44],["μαρτυρίων",220,45],["σου",5,146],["οὐκ",12,17],["ἐξέκλινα",393,147]],"Many are they that persecute me and oppress me: [but] I have not declined from thy testimonies."],["158",[["Εἶδον",73,147],["ἀσυνετοῦντας",9192,229],["καὶ",2,8],["ἐξετηκόμην",3191,380],["ὅτι",19,8],["τὰ",1,42],["λόγιά",1249,43],["σου",5,146],["οὐκ",12,17],["ἐφυλάξαντο",127,182]],"I beheld men acting foolishly, and I pined away; for they kept not thine oracles."],["159",[["Ἴδε",693,17],["ὅτι",19,8],["τὰς",1,39],["ἐντολάς",259,40],["σου",5,146],["ἠγάπησα",224,147],["Κύριε",7,251],["ἐν",4,1],["τῷ",1,52],["ἐλέει",182,53],["σου",5,146],["ζῆσόν",117,171],["με",6,82]],"Behold, I have loved thy commandments, O Lord: quicken me in thy mercy."],["160",[["Ἀρχὴ",269,13],["τῶν",1,76],["λόγων",48,77],["σου",5,146],["ἀλήθεια",350,13],["καὶ",2,8],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["πάντα",11,59],["τὰ",1,42],["κρίματα",266,43],["τῆς",1,18],["δικαιοσύνης",185,19],["σου",5,146]],"The beginning of thy words is truth; and all the judgments of thy righteousness [endure] for ever."],["161",[["Ἄρχοντες",96,51],["κατεδίωξάν",619,141],["με",6,98],["δωρεὰν",1338,10],["καὶ",2,8],["ἀπὸ",17,1],["τῶν",1,76],["λόγων",48,77],["σου",5,146],["ἐδειλίασεν",0,0],["ἡ",1,11],["καρδία",63,13],["μου",6,48]],"Princes persecuted me without a cause, but my heart feared because of thy words."],["162",[["Ἀγαλλιάσομαι",737,176],["ἐγὼ",6,158],["ἐπὶ",9,1],["τὰ",1,42],["λόγιά",1249,43],["σου",5,146],["ὡς",36,8],["ὁ",1,4],["εὑρίσκων",106,67],["σκῦλα",558,43],["πολλά",74,65]],"I will exult because of thine oracles, as one that finds much spoil."],["163",[["Ἀδικίαν",288,10],["ἐμίσησα",355,147],["καὶ",2,8],["ἐβδελυξάμην",1202,329],["τὸν",1,6],["δὲ",14,12],["νόμον",140,7],["σου",5,146],["ἠγάπησα",224,147]],"I hate and abhor unrighteousness; but I love thy law."],["164",[["Ἑπτάκις",1608,17],["τῆς",1,18],["ἡμέρας",28,19],["ᾔνεσά",399,147],["σε",5,161],["ἐπὶ",9,1],["τὰ",1,42],["κρίματα",266,43],["τῆς",1,18],["δικαιοσύνης",185,19],["σου",5,146]],"Seven times in a day have I praised thee because of the judgments of thy righteousness."],["165",[["Εἰρήνη",210,13],["πολλὴ",74,15],["τοῖς",1,138],["ἀγαπῶσι",224,357],["τὸν",1,6],["νόμον",140,7],["σου",5,146],["καὶ",2,8],["οὐκ",12,17],["ἔστιν",10,87],["αὐτοῖς",3,142],["σκάνδαλον",1838,20]],"Great peace have they that love thy law: and there is no stumbling-block to them."],["166",[["Προσεδόκων",2768,129],["τὸ",1,32],["σωτήριόν",471,33],["σου",5,146],["Κύριε",7,251],["καὶ",2,8],["τὰς",1,39],["ἐντολάς",259,40],["σου",5,146],["ἠγάπησα",224,147]],"I waited for thy salvation, O Lord, and have loved thy commandments."],["167",[["Ἐφύλαξεν",127,3],["ἡ",1,11],["ψυχή",62,13],["μου",6,48],["τὰ",1,42],["μαρτύριά",220,43],["σου",5,146],["καὶ",2,8],["ἠγάπησεν",224,3],["αὐτὰ",3,66],["σφόδρα",149,17]],"My soul has kept thy testimonies, and loved them exceedingly."],["168",[["Ἐφύλαξα",127,147],["τὰς",1,39],["ἐντολάς",259,40],["σου",5,146],["καὶ",2,8],["τὰ",1,42],["μαρτύριά",220,43],["σου",5,146],["ὅτι",19,8],["πᾶσαι",11,185],["αἱ",1,183],["ὁδοί",67,179],["μου",6,48],["ἐναντίον",138,17],["σου",5,146],["Κύριε",7,251]],"I have kept thy commandments and thy testimonies; for all my ways are before thee, O Lord."],["169",[["Ἐγγυσάτω",0,0],["ἡ",1,11],["δέησίς",674,13],["μου",6,48],["ἐνώπιόν",114,1],["σου",5,146],["Κύριε",7,251],["κατὰ",32,1],["τὸ",1,32],["λόγιόν",1249,33],["σου",5,146],["συνέτισόν",2207,198],["με",6,82]],"Let my supplication come near before thee, O Lord; instruct me according to thine oracle."],["170",[["Εἰσέλθοι",88,276],["τὸ",1,32],["ἀξίωμά",3174,33],["μου",6,48],["ἐνώπιόν",114,1],["σου",5,146],["Κύριε",7,251],["κατὰ",32,1],["τὸ",1,32],["λόγιόν",1249,33],["σου",5,146],["ῥῦσαί",335,275],["με",6,82]],"Let my petition come in before thee, O Lord; deliver me according to thine oracle."],["171",[["Ἐξερεύξαιντο",0,0],["τὰ",1,42],["χείλη",361,43],["μου",6,48],["ὕμνον",1499,7],["ὅταν",318,8],["διδάξῃς",543,170],["με",6,82],["τὰ",1,42],["δικαιώματά",425,43],["σου",5,146]],"Let my lips utter a hymn, when thou shalt have taught me thine ordinances."],["172",[["Φθέγξαιτο",2309,397],["ἡ",1,11],["γλῶσσά",385,13],["μου",6,48],["τὰ",1,42],["λόγιά",1249,43],["σου",5,146],["ὅτι",19,8],["πᾶσαι",11,185],["αἱ",1,183],["ἐντολαί",259,179],["σου",5,146],["δικαιοσύνη",185,13]],"Let my tongue utter thine oracles; for all thy commandments are righteous."],["173",[["Γενέσθω",30,316],["ἡ",1,11],["χείρ",37,13],["σου",5,146],["τοῦ",1,30],["σῶσαί",171,100],["με",6,82],["ὅτι",19,8],["τὰς",1,39],["ἐντολάς",259,40],["σου",5,146],["ᾑρετισάμην",1669,152]],"Let thine hand be [prompt] to save me; for I have chosen thy commandments."],["174",[["Ἐπεπόθησα",2541,147],["τὸ",1,32],["σωτήριόν",471,33],["σου",5,146],["Κύριε",7,251],["καὶ",2,8],["ὁ",1,4],["νόμος",140,5],["σου",5,146],["μελέτη",2284,13],["μου",6,48],["ἐστί",10,87]],"I have longed after thy salvation, O Lord; and thy law is my meditation."],["175",[["Ζήσεται",117,89],["ἡ",1,11],["ψυχή",62,13],["μου",6,48],["καὶ",2,8],["αἰνέσει",399,120],["σε",5,161],["καὶ",2,8],["τὰ",1,42],["κρίματά",266,43],["σου",5,146],["βοηθήσει",364,379],["μοι",6,49]],"My soul shall live, and shall praise thee; and thy judgments shall help me."],["176",[["Ἐπλανήθην",464,94],["ὡς",36,8],["πρόβατον",194,33],["ἀπολωλὸς",213,426],["ζήτησον",190,198],["τὸν",1,6],["δοῦλόν",136,7],["σου",5,146],["ὅτι",19,8],["τὰς",1,39],["ἐντολάς",259,40],["σου",5,146],["οὐκ",12,17],["ἐπελαθόμην",512,152]],"I have gone astray like a lost sheep; seek thy servant; for I have not forgotten thy commandments."]]