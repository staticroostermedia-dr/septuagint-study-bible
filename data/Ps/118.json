[["1",[["Ἀλληλούϊα",1749,105],["Μακάριοι",806,130],["ἄμωμοι",637,130],["ἐν",4,1],["ὁδῷ",68,2],["οἱ",1,128],["πορευόμενοι",49,351],["ἐν",4,1],["νόμῳ",140,113],["Κυρίου",7,21]],"Alleluia. Blessed are the blameless in the way, who walk in the law of the Lord."],["2",[["Μακάριοι",806,130],["οἱ",1,128],["ἐξερευνῶντες",1863,137],["τὰ",1,42],["μαρτύρια",225,43],["αὐτοῦ",3,48],["ἐν",4,1],["ὅλῃ",235,96],["καρδίᾳ",64,2],["ἐκζητήσουσιν",460,207],["αὐτόν",3,82]],"Blessed are they that search out his testimonies: they will diligently seek him with the whole heart."],["3",[["Οὐ",12,17],["γὰρ",40,12],["οἱ",1,128],["ἐργαζόμενοι",467,351],["τὴν",1,9],["ἀνομίαν",275,10],["ἐν",4,1],["ταῖς",1,70],["ὁδοῖς",68,71],["αὐτοῦ",3,48],["ἐπορεύθησαν",49,94]],"For they that work iniquity have not walked in his ways."],["4",[["Σὺ",5,156],["ἐνετείλω",143,169],["τὰς",1,39],["ἐντολάς",259,40],["σου",5,146],["τοῦ",1,30],["φυλάξασθαι",125,103],["σφόδρα",150,17]],"Thou hast commanded [us] diligently to keep thy precepts."],["5",[["Ὄφελον",3475,12],["κατευθυνθείησαν",827,403],["αἱ",1,185],["ὁδοί",68,180],["μου",6,48],["τοῦ",1,30],["φυλάξασθαι",125,103],["τὰ",1,42],["δικαιώματά",428,43],["σου",5,146]],"O that my ways were directed to keep thine ordinances."],["6",[["Τότε",250,17],["οὐ",12,17],["μὴ",25,8],["αἰσχυνθῶ",611,555],["ἐν",4,1],["τῷ",1,110],["με",6,82],["ἐπιβλέπειν",517,54],["ἐπὶ",9,1],["πάσας",11,109],["τὰς",1,39],["ἐντολάς",259,40],["σου",5,146]],"Then shall I not be ashamed, when I have respect to all thy commandments."],["7",[["Ἐξομολογήσομαί",479,177],["σοι",5,151],["ἐν",4,1],["εὐθύτητι",1674,2],["καρδίας",64,19],["ἐν",4,1],["τῷ",1,110],["μεμαθηκέναι",923,107],["με",6,82],["τὰ",1,42],["κρίματα",267,43],["τῆς",1,18],["δικαιοσύνης",187,19],["σου",5,146]],"I will give thee thanks with uprightness of heart, when I have learnt the judgments of thy righteousness."],["8",[["Τὰ",1,42],["δικαιώματά",428,43],["σου",5,146],["φυλάξω",125,157],["μή",25,8],["με",6,82],["ἐγκαταλίπῃς",364,170],["ἕως",42,8],["σφόδρα",150,17]],"I will keep thine ordinances: O forsake me not greatly."],["9",[["Ἐν",4,1],["τίνι",39,436],["κατορθώσει",1471,120],["νεώτερος",515,16],["τὴν",1,9],["ὁδὸν",68,10],["αὐτοῦ",3,48],["ἐν",4,1],["τῷ",1,110],["φυλάξασθαι",125,103],["τοὺς",1,56],["λόγους",48,31],["σου",5,146]],"Wherewith shall a young man direct his way? by keeping thy words."],["10",[["Ἐν",4,1],["ὅλῃ",235,96],["καρδίᾳ",64,2],["μου",6,48],["ἐξεζήτησά",460,147],["σε",5,161],["μὴ",25,8],["ἀπώσῃ",770,116],["με",6,82],["ἀπὸ",17,1],["τῶν",1,123],["ἐντολῶν",259,61],["σου",5,146]],"With my whole heart have I diligently sought thee: cast me not away from thy commandments."],["11",[["Ἐν",4,1],["τῇ",1,95],["καρδίᾳ",64,2],["μου",6,48],["ἔκρυψα",372,147],["τὰ",1,42],["λόγιά",1248,43],["σου",5,146],["ὅπως",240,8],["ἂν",83,12],["μὴ",25,8],["ἁμάρτω",237,227],["σοι",5,151]],"I have hidden thine oracles in my heart, that I might not sin against thee."],["12",[["Εὐλογητὸς",767,16],["εἶ",10,145],["Κύριε",7,250],["δίδαξόν",545,198],["με",6,82],["τὰ",1,42],["δικαιώματά",428,43],["σου",5,146]],"Blessed art thou, O Lord: teach me thine ordinances."],["13",[["Ἐν",4,1],["τοῖς",1,91],["χείλεσί",361,92],["μου",6,48],["ἐξήγγειλα",2532,147],["πάντα",11,65],["τὰ",1,42],["κρίματα",267,43],["τοῦ",1,23],["στόματός",123,24],["σου",5,146]],"With my lips have I declared all the judgments of thy mouth."],["14",[["Ἐν",4,1],["τῇ",1,95],["ὁδῷ",68,2],["τῶν",1,44],["μαρτυρίων",225,45],["σου",5,146],["ἐτέρφθην",1601,148],["ὡς",36,8],["ἐπὶ",9,1],["παντὶ",11,111],["πλούτῳ",574,113]],"I have delighted in the way of thy testimonies, [as much] as in all riches."],["15",[["Ἐν",4,1],["ταῖς",1,70],["ἐντολαῖς",259,71],["σου",5,146],["ἀδολεσχήσω",2512,157],["καὶ",2,8],["κατανοήσω",1549,157],["τὰς",1,39],["ὁδούς",68,40],["σου",5,146]],"I will meditate on thy commandments, and consider thy ways."],["16",[["Ἐν",4,1],["τοῖς",1,91],["δικαιώμασί",428,92],["σου",5,146],["μελετήσω",1347,157],["οὐκ",12,17],["ἐπιλήσομαι",513,177],["τῶν",1,76],["λόγων",48,77],["σου",5,146]],"I will meditate on thine ordinances: I will not forget thy words."],["17",[["Ἀνταπόδος",666,198],["τῷ",1,110],["δούλῳ",136,113],["σου",5,146],["ζήσομαι",107,177],["καὶ",2,8],["φυλάξω",125,157],["τοὺς",1,56],["λόγους",48,31],["σου",5,146]],"Render a recompence to thy servant: [so] shall I live, and keep thy words."],["18",[["Ἀποκάλυψον",652,198],["τοὺς",1,56],["ὀφθαλμούς",91,31],["μου",6,48],["καὶ",2,8],["κατανοήσω",1549,157],["τὰ",1,42],["θαυμάσια",884,65],["ἐκ",21,1],["τοῦ",1,30],["νόμου",140,21],["σου",5,146]],"Unveil thou mine eyes, and I shall perceive wondrous things out of thy law."],["19",[["Πάροικος",1421,16],["ἐγώ",6,158],["εἰμι",10,149],["ἐν",4,1],["τῇ",1,95],["γῇ",26,2],["μὴ",25,8],["ἀποκρύψῃς",1926,170],["ἀπʼ",17,1],["ἐμοῦ",6,48],["τὰς",1,39],["ἐντολάς",259,40],["σου",5,146]],"I am a stranger in the earth: hide not thy commandments from me."],["20",[["Ἐπεπόθησεν",2537,3],["ἡ",1,11],["ψυχή",63,13],["μου",6,48],["τοῦ",1,30],["ἐπιθυμῆσαι",915,100],["τὰ",1,42],["κρίματά",267,43],["σου",5,146],["ἐν",4,1],["παντὶ",11,111],["καιρῷ",132,113]],"My soul has longed exceedingly for thy judgments at all times."],["21",[["Ἐπετίμησας",2318,154],["ὑπερηφάνοις",1109,215],["ἐπικατάρατοι",1069,130],["οἱ",1,128],["ἐκκλίνοντες",394,137],["ἀπὸ",17,1],["τῶν",1,123],["ἐντολῶν",259,61],["σου",5,146]],"Thou hast rebuked the proud: cursed are they that turn aside from thy commandments."],["22",[["Περίελε",863,198],["ἀπʼ",17,1],["ἐμοῦ",6,48],["ὄνειδος",973,20],["καὶ",2,8],["ἐξουδένωσιν",4087,10],["ὅτι",19,8],["τὰ",1,42],["μαρτύριά",225,43],["σου",5,146],["ἐξεζήτησα",460,147]],"Remove from me reproach and contempt; for I have sought out thy testimonies."],["23",[["Καὶ",2,8],["γὰρ",40,12],["ἐκάθισαν",274,141],["ἄρχοντες",96,51],["καὶ",2,8],["κατʼ",32,1],["ἐμοῦ",6,48],["κατελάλουν",2356,129],["ὁ",1,4],["δὲ",14,12],["δοῦλός",136,5],["σου",5,146],["ἠδολέσχει",2512,14],["ἐν",4,1],["τοῖς",1,91],["δικαιώμασί",428,92],["σου",5,146]],"For princes sat and spoke against me: but thy servant was meditating on thine ordinances."],["24",[["Καὶ",2,8],["γὰρ",40,12],["τὰ",1,42],["μαρτύριά",225,43],["σου",5,146],["μελέτη",2269,13],["μου",6,48],["ἐστὶ",10,87],["καὶ",2,8],["αἱ",1,185],["συμβουλίαι",2960,180],["μου",6,48],["τὰ",1,42],["δικαιώματά",428,43],["σου",5,146]],"For thy testimonies are my meditation, and thine ordinances are my counsellors."],["25",[["Ἐκολλήθη",1246,38],["τῷ",1,52],["ἐδάφει",1711,53],["ἡ",1,11],["ψυχή",63,13],["μου",6,48],["ζῆσόν",107,171],["με",6,82],["κατὰ",32,1],["τὸ",1,32],["λόγον",48,7],["σου",5,146]],"My soul has cleaved to the ground; quicken thou me according to thy word."],["26",[["Τὰς",1,39],["ὁδούς",68,40],["σου",5,146],["ἐξήγγειλα",2532,147],["καὶ",2,8],["ἐπήκουσάς",597,154],["μου",6,48],["δίδαξόν",545,198],["με",6,82],["τὰ",1,42],["δικαιώματά",428,43],["σου",5,146]],"I declared my ways, and thou didst hear me; teach me thine ordinances."],["27",[["Ὁδὸν",68,10],["δικαιωμάτων",428,45],["σου",5,146],["συνέτισόν",2194,198],["με",6,82],["καὶ",2,8],["ἀδολεσχήσω",2512,157],["ἐν",4,1],["τοῖς",1,138],["θαυμασίοις",884,215],["σου",5,146]],"Instruct me in the way of thine ordinances; and I will meditate on thy wondrous works."],["28",[["Ἐνύσταξεν",2471,3],["ἡ",1,11],["ψυχή",63,13],["μου",6,83],["ἀπὸ",17,1],["ἀκηδίας",5166,19],["βεβαίωσόν",4705,198],["με",6,82],["ἐν",4,1],["τοῖς",1,138],["λόγοις",48,139],["σου",5,146]],"My soul has slumbered for sorrow; strengthen thou me with thy words."],["29",[["Ὁδὸν",68,10],["ἀδικίας",288,19],["ἀπόστησον",293,198],["ἀπʼ",17,1],["ἐμοῦ",6,48],["καὶ",2,8],["τῷ",1,110],["νόμῳ",140,113],["σου",5,146],["ἐλέησόν",446,198],["με",6,82]],"Remove from me the way of iniquity; and be merciful to me by thy law."],["30",[["Ὁδὸν",68,10],["ἀληθείας",352,19],["ᾑρετισάμην",1618,152],["καὶ",2,8],["τὰ",1,42],["κρίματά",267,43],["σου",5,146],["οὐκ",12,17],["ἐπελαθόμην",513,152]],"I have chosen the way of truth; and have not forgotten thy judgments."],["31",[["Ἐκολλήθην",1246,94],["τοῖς",1,91],["μαρτυρίοις",225,92],["σου",5,146],["Κύριε",7,250],["μή",25,8],["με",6,82],["καταισχύνῃς",696,199]],"I have cleaved to thy testimonies, O Lord; put me not to shame."],["32",[["Ὁδὸν",68,10],["ἐντολῶν",259,61],["σου",5,146],["ἔδραμον",820,141],["ὅταν",319,8],["ἐπλάτυνας",1779,154],["τὴν",1,9],["καρδίαν",64,10],["μου",6,48]],"I ran the way of thy commandments, when thou didst enlarge my heart."],["33",[["Νομοθέτησόν",2746,198],["με",6,98],["Κύριε",7,250],["τὴν",1,9],["ὁδὸν",68,10],["τῶν",1,44],["δικαιωμάτων",428,45],["σου",5,146],["καὶ",2,8],["ἐκζητήσω",460,157],["αὐτὴν",3,98],["διαπαντός",510,17]],"Teach me, O Lord, the way of thine ordinances, and I will seek it out continually."],["34",[["Συνέτισόν",2194,198],["με",6,82],["καὶ",2,8],["ἐξερευνήσω",1863,157],["τὸν",1,6],["νόμον",140,7],["σου",5,146],["καὶ",2,8],["φυλάξω",125,157],["αὐτὸν",3,82],["ἐν",4,1],["ὅλῃ",235,96],["καρδίᾳ",64,2],["μου",6,48]],"Instruct me, and I will search out thy law, and will keep it with my whole heart."],["35",[["Ὁδήγησόν",1108,198],["με",6,82],["ἐν",4,1],["τῇ",1,95],["τρίβῳ",745,2],["τῶν",1,123],["ἐντολῶν",259,61],["σου",5,146],["ὅτι",19,8],["αὐτὴν",3,98],["ἠθέλησα",612,147]],"Guide me in the path of thy commandments; for I have delighted in it."],["36",[["Κλῖνον",785,36],["τὴν",1,9],["καρδίαν",64,10],["μου",6,48],["εἰς",8,1],["τὰ",1,42],["μαρτύριά",225,43],["σου",5,146],["καὶ",2,8],["μὴ",25,8],["εἰς",8,1],["πλεονεξίαν",3332,10]],"Incline mine heart to thy testimonies, and not to covetousness."],["37",[["Ἀπόστρεψον",130,198],["τοὺς",1,56],["ὀφθαλμούς",91,31],["μου",6,48],["τοῦ",1,30],["μὴ",25,8],["ἰδεῖν",53,100],["ματαιότητα",937,10],["ἐν",4,1],["τῇ",1,95],["ὁδῷ",68,2],["σου",5,146],["ζῆσόν",107,171],["με",6,82]],"Turn away mine eyes that I may not behold vanity: quicken thou me in thy way."],["38",[["Στῆσον",78,171],["τῷ",1,110],["δούλῳ",136,113],["σου",5,146],["τὸ",1,32],["λόγιόν",1248,33],["σου",5,146],["εἰς",8,1],["τὸν",1,6],["φόβον",333,7],["σου",5,146]],"Confirm thine oracle to thy servant, that he may fear thee."],["39",[["Περίελε",863,198],["τὸν",1,6],["ὄνειδισμόν",733,7],["μου",6,48],["ὃν",24,106],["ὑπώπτευσα",6648,147],["ὅτι",19,8],["τὰ",1,42],["κρίματά",267,43],["σου",5,146],["χρηστά",1359,65]],"Take away my reproach which I have feared: for thy judgments are good."],["40",[["Ἰδοὺ",51,17],["ἐπεθύμησα",915,147],["τὰς",1,39],["ἐντολάς",259,40],["σου",5,146],["ἐν",4,1],["τῇ",1,95],["δικαιοσύνῃ",187,2],["σου",5,146],["ζῆσόν",107,171],["με",6,82]],"Behold, I have desired thy commandments: quicken me in thy righteousness."],["41",[["Καὶ",2,8],["ἔλθοι",55,216],["ἐπʼ",9,1],["ἐμὲ",6,82],["τὸ",1,32],["ἔλεός",183,33],["σου",5,146],["Κύριε",7,250],["τὸ",1,32],["σωτήριόν",472,33],["σου",5,146],["κατὰ",32,1],["τὸν",1,6],["λόγον",48,7],["σου",5,146]],"And let thy mercy come upon me, O Lord; [even] thy salvation, according to thy word."],["42",[["Καὶ",2,8],["ἀποκριθήσομαι",234,176],["τοῖς",1,138],["ὀνειδίζουσί",945,352],["μοι",6,49],["λόγον",48,7],["ὅτι",19,8],["ἤλπισα",514,147],["ἐπὶ",9,1],["τοῖς",1,138],["λόγοις",48,139],["σου",5,146]],"And [so] I shall render an answer to them that reproach me: for I have trusted in thy words."],["43",[["Καὶ",2,8],["μὴ",25,8],["περιέλῃς",863,170],["ἐκ",21,1],["τοῦ",1,23],["στόματός",123,24],["μου",6,83],["λόγον",48,7],["ἀληθείας",352,19],["ἕως",42,8],["σφόδρα",150,17],["ὅτι",19,8],["ἐπὶ",9,1],["τοῖς",1,91],["κρίμασί",267,92],["σου",5,146],["ἐπήλπισα",3195,147]],"And take not the word of truth utterly out of my mouth; for I have hoped in thy judgments."],["44",[["Καὶ",2,8],["φυλάξω",125,157],["τὸν",1,6],["νόμον",140,7],["σου",5,146],["διαπαντὸς",510,17],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["καὶ",2,8],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["τοῦ",1,30],["αἰῶνος",100,21]],"So shall I keep thy law continually, for ever and ever."],["45",[["Καὶ",2,8],["ἐπορευόμην",49,374],["ἐν",4,1],["πλατυσμῷ",3620,113],["ὅτι",19,8],["τὰς",1,39],["ἐντολάς",259,40],["σου",5,146],["ἐξεζήτησα",460,147]],"I walked also at large: for I sought out thy commandments."],["46",[["Καὶ",2,8],["ἐλάλουν",50,129],["ἐν",4,1],["τοῖς",1,91],["μαρτυρίοις",225,92],["σου",5,146],["ἐναντίον",138,17],["βασιλέων",22,77],["καὶ",2,8],["οὐκ",12,17],["ᾐσχυνόμην",611,374]],"And I spoke of thy testimonies before kings, and was not ashamed."],["47",[["Καὶ",2,8],["ἐμελέτων",1347,129],["ἐν",4,1],["ταῖς",1,70],["ἐντολαῖς",259,71],["σου",5,146],["αἷς",24,281],["ἠγάπησα",214,147],["σφόδρα",150,17]],"And I meditated on thy commandments, which I loved exceedingly."],["48",[["Καὶ",2,8],["ᾖρα",206,147],["τὰς",1,39],["χεῖράς",37,40],["μου",6,48],["πρὸς",15,1],["τὰς",1,39],["ἐντολάς",259,40],["σου",5,146],["ἃς",24,186],["ἠγάπησα",214,147],["καὶ",2,8],["ἠδολέσχουν",2512,129],["ἐν",4,1],["τοῖς",1,91],["δικαιώμασί",428,92],["σου",5,146]],"And I lifted up my hands to thy commandments which I loved; and I meditated in thine ordinances."],["49",[["Μνήσθητι",230,242],["τῶν",1,76],["λόγων",48,77],["σου",5,146],["τῷ",1,110],["δούλῳ",136,113],["σου",5,146],["ὧν",24,97],["ἐπήλπισάς",3195,154],["με",6,82]],"Remember thy words to thy servant, wherein thou hast made me hope."],["50",[["Αὕτη",16,101],["με",6,82],["παρεκάλεσεν",434,3],["ἐν",4,1],["τῇ",1,95],["ταπεινώσει",322,120],["μου",6,48],["ὅτι",19,8],["τὸ",1,32],["λόγιόν",1248,33],["σου",5,146],["ἔζησέ",107,3],["με",6,82]],"This has comforted me in mine affliction: for thine oracle has quickened me."],["51",[["Ὑπερήφανοι",1109,130],["παρηνόμουν",2750,129],["ἕως",42,8],["σφόδρα",150,17],["ἀπὸ",17,1],["δὲ",14,12],["τοῦ",1,30],["νόμου",140,21],["σου",5,146],["οὐκ",12,17],["ἐξέκλινα",394,147]],"The proud have transgressed exceedingly; but I swerved not from thy law."],["52",[["Ἐμνήσθην",230,148],["τῶν",1,44],["κριμάτων",267,45],["σου",5,146],["ἀπʼ",17,1],["αἰῶνος",100,21],["Κύριε",7,250],["καὶ",2,8],["παρεκλήθην",434,148]],"I remembered thy judgments of old, O Lord; and was comforted."],["53",[["Ἀθυμία",5164,13],["κατέσχε",1040,3],["με",6,82],["ἀπὸ",17,1],["ἁμαρτωλῶν",409,163],["τῶν",1,76],["ἐγκαταλιμπανόντων",364,164],["τὸν",1,6],["νόμον",140,7],["σου",5,146]],"Despair took hold upon me, because of the sinners who forsake thy law."],["54",[["Ψαλτὰ",8713,74],["ἦσάν",10,129],["μοι",6,49],["τὰ",1,42],["δικαιώματά",428,43],["σου",5,146],["ἐν",4,1],["τόπῳ",99,113],["παροικίας",2105,19],["μου",6,83]],"Thine ordinances were my songs in the place of my sojourning."],["55",[["Ἐμνήσθην",230,148],["ἐν",4,1],["νυκτὶ",219,2],["τοῦ",1,23],["ὀνόματός",57,24],["σου",5,146],["Κύριε",7,250],["καὶ",2,8],["ἐφύλαξα",125,147],["τὸν",1,6],["νόμον",140,7],["σου",5,146]],"I remembered thy name, O Lord, in the night, and kept thy law."],["56",[["Αὕτη",16,101],["ἐγενήθη",30,38],["μοι",6,49],["ὅτι",19,8],["τὰ",1,42],["δικαιώματά",428,43],["σου",5,146],["ἐξεζήτησα",460,147]],"This I had, because I diligently sought thine ordinances."],["57",[["Μερίς",399,13],["μου",6,48],["εἶ",10,145],["Κύριε",7,250],["εἶπα",18,147],["τοῦ",1,30],["φυλάξασθαι",125,103],["τὸν",1,6],["νόμον",140,7],["σου",5,146]],"Thou art my portion, O Lord: I said that I would keep thy law."],["58",[["Ἐδεήθην",1672,148],["τοῦ",1,23],["προσώπου",47,24],["σου",5,146],["ἐν",4,1],["ὅλῃ",235,96],["καρδίᾳ",64,2],["μου",6,48],["ἐλέησόν",446,198],["με",6,82],["κατὰ",32,1],["τὸ",1,32],["λόγιόν",1248,33],["σου",5,146]],"I besought thy favour with my whole heart: have mercy upon me according to thy word."],["59",[["Διελογισάμην",2573,325],["τὰς",1,39],["ὁδούς",68,40],["σου",5,146],["καὶ",2,8],["ἐπέστρεψα",117,147],["τοὺς",1,56],["πόδας",210,31],["μου",6,48],["εἰς",8,1],["τὰ",1,42],["μαρτύριά",225,43],["σου",5,146]],"I thought on thy ways, and turned my feet to thy testimonies."],["60",[["Ἡτοιμάσθην",371,256],["καὶ",2,8],["οὐκ",12,17],["ἐταράχθην",508,148],["τοῦ",1,30],["φυλάξασθαι",125,103],["τὰς",1,39],["ἐντολάς",259,40],["σου",5,146]],"I prepared myself, (and was not terrified,) to keep thy commandments."],["61",[["Σχοινία",1527,43],["ἁμαρτωλῶν",409,163],["περιεπλάκησάν",2940,94],["μοι",6,49],["καὶ",2,8],["τοῦ",1,30],["νόμου",140,21],["σου",5,146],["οὐκ",12,17],["ἐπελαθόμην",513,152]],"The snares of sinners entangled me: but I forgot not thy law."],["62",[["Μεσονύκτιον",5822,33],["ἐξεγειρόμην",656,374],["τοῦ",1,30],["ἐξομολογεῖσθαί",479,104],["σοι",5,151],["ἐπὶ",9,1],["τὰ",1,42],["κρίματα",267,43],["τῆς",1,18],["δικαιοσύνης",187,19],["σου",5,146]],"At midnight I arose, to give thanks to thee for the judgments of thy righteousness."],["63",[["Μέτοχος",3093,5],["ἐγώ",6,158],["εἰμι",10,149],["πάντων",11,163],["τῶν",1,76],["φοβουμένων",134,295],["σε",5,161],["καὶ",2,8],["τῶν",1,76],["φυλασσόντων",125,164],["τὰς",1,39],["ἐντολάς",259,40],["σου",5,146]],"I am a companion of all them that fear thee, and of them that keep thy commandments."],["64",[["Τοῦ",1,23],["ἐλέους",183,24],["σου",5,146],["Κύριε",7,250],["πλήρης",490,15],["ἡ",1,11],["γῆ",26,13],["τὰ",1,42],["δικαιώματά",428,43],["σου",5,146],["δίδαξόν",545,198],["με",6,82]],"O Lord, the earth is full of thy mercy: teach me thine ordinances."],["65",[["Χρηστότητα",1845,10],["ἐποίησας",23,154],["μετὰ",29,1],["τοῦ",1,30],["δούλου",136,21],["σου",5,146],["Κύριε",7,250],["κατὰ",32,1],["τὸν",1,6],["λόγον",48,7],["σου",5,146]],"Thou hast wrought kindly with thy servant, O Lord, according to thy word."],["66",[["Χρηστότητα",1845,10],["καὶ",2,8],["παιδείαν",571,10],["καὶ",2,8],["γνῶσιν",753,10],["δίδαξόν",545,198],["με",6,98],["ὅτι",19,8],["ταῖς",1,70],["ἐντολαῖς",259,71],["σου",5,146],["ἐπίστευσα",649,147]],"Teach me kindness, and instruction, and knowledge: for I have believed thy commandments."],["67",[["Πρὸ",238,1],["τοῦ",1,30],["με",6,82],["ταπεινωθῆναι",322,175],["ἐγὼ",6,158],["ἐπλημμέλησα",1329,147],["διὰ",56,1],["τοῦτο",16,122],["τὸ",1,32],["λόγιόν",1248,33],["σου",5,146],["ἐφύλαξα",125,147]],"Before I was afflicted, I transgressed; therefore have I kept thy word."],["68",[["Χρηστὸς",1359,16],["εἶ",10,145],["σὺ",5,156],["Κύριε",7,250],["καὶ",2,8],["ἐν",4,1],["τῇ",1,95],["χρηστότητί",1845,2],["σου",5,146],["δίδαξόν",545,198],["με",6,82],["τὰ",1,42],["δικαιωματά",428,43],["σου",5,146]],"Good art thou, O Lord; therefore in thy goodness teach me thine ordinances."],["69",[["Ἐπληθύνθη",316,38],["ἐπʼ",9,1],["ἐμὲ",6,82],["ἀδικία",288,13],["ὑπερηφάνων",1109,163],["ἐγὼ",6,179],["δὲ",14,12],["ἐν",4,1],["ὅλῃ",235,96],["καρδίᾳ",64,2],["μου",6,48],["ἐξερευνήσω",1863,157],["τὰς",1,39],["ἐντολάς",259,40],["σου",5,146]],"The injustice of the proud has been multiplied against me: but I will search out thy commandments with all my heart."],["70",[["Ἐτυρώθη",0,0],["ὡς",36,8],["γάλα",1034,33],["ἡ",1,11],["καρδία",64,13],["αὐτῶν",3,41],["ἐγὼ",6,179],["δὲ",14,12],["τὸν",1,6],["νόμον",140,7],["σου",5,146],["ἐμελέτησα",1347,147]],"Their heart has been curdled like milk; but I have meditated on thy law."],["71",[["Ἀγαθόν",114,29],["μοι",6,49],["ὅτι",19,8],["ἐταπείνωσάς",322,154],["με",6,82],["ὅπως",240,8],["ἂν",83,12],["μάθω",923,227],["τὰ",1,42],["δικαιώματά",428,43],["σου",5,146]],"[It is] good for me that thou hast afflicted me; that I might learn thine ordinances."],["72",[["Ἀγαθόν",114,29],["μοι",6,49],["ὁ",1,4],["νόμος",140,5],["τοῦ",1,23],["στόματός",123,24],["σου",5,146],["ὑπὲρ",139,1],["χιλιάδας",179,40],["χρυσίου",202,24],["καὶ",2,8],["ἀργυρίου",152,24]],"The law of thy mouth is better to me than thousands of gold and silver."],["73",[["Αἱ",1,185],["χεῖρές",37,180],["σου",5,146],["ἔποίησάν",23,141],["με",6,82],["καὶ",2,8],["ἐπλασάν",910,141],["με",6,82],["συνέτισόν",2194,198],["με",6,82],["καὶ",2,8],["μαθήσομαι",923,177],["τὰς",1,39],["ἐντολάς",259,40],["σου",5,146]],"Thy hands have made me, and fashioned me: instruct me, that I may learn thy commandments."],["74",[["Οἱ",1,128],["φοβούμενοί",134,351],["σε",5,161],["ὄψονταί",112,127],["με",6,82],["καὶ",2,8],["εὐφρανθήσονται",244,135],["ὅτι",19,8],["εἰς",8,1],["τοὺς",1,56],["λόγους",48,31],["σου",5,146],["ἐπήλπισα",3195,147]],"They that fear thee will see me and rejoice: for I have hoped in thy words."],["75",[["Ἔγνων",79,147],["Κύριε",7,250],["ὅτι",19,8],["δικαιοσύνη",187,13],["τὰ",1,42],["κρίματά",267,43],["σου",5,146],["καὶ",2,8],["ἀληθείᾳ",352,2],["ἐταπείνωσάς",322,154],["με",6,82]],"I know, O Lord, that thy judgments are righteousness, and [that] thou in truthfulness hast afflicted me."],["76",[["Γενηθήτω",30,25],["δὴ",193,12],["τὸ",1,32],["ἔλεός",183,33],["σου",5,146],["τοῦ",1,30],["παρακαλέσαι",434,100],["με",6,82],["κατὰ",32,1],["τὸ",1,32],["λόγιόν",1248,33],["σου",5,146],["τῷ",1,110],["δούλῳ",136,113],["σου",5,146]],"Let, I pray thee, thy mercy be to comfort me, according to thy word to thy servant."],["77",[["Ἐλθέτωσάν",55,261],["μοι",6,49],["οἱ",1,128],["οἰκτιρμοί",1187,51],["σου",5,146],["καὶ",2,8],["ζήσομαι",107,177],["ὅτι",19,8],["ὁ",1,4],["νόμος",140,5],["σου",5,146],["μελέτη",2269,13],["μου",6,48],["ἐστίν",10,87]],"Let thy compassions come to me, that I may live: for thy law is my meditation."],["78",[["Αἰσχυνθήτωσαν",611,50],["ὑπερήφανοι",1109,130],["ὅτι",19,8],["ἀδίκως",406,17],["ἠνόμησαν",1426,141],["εἰς",8,1],["ἐμὲ",6,82],["ἐγὼ",6,158],["δὲ",14,12],["ἀδολεσχήσω",2512,157],["ἐν",4,1],["ταῖς",1,70],["ἐντολαῖς",259,71],["σου",5,146]],"Let the proud be ashamed; for they transgressed against me unjustly: but I will meditate in thy commandments."],["79",[["Ἐπιστρεψάτωσάν",117,261],["με",6,82],["οἱ",1,128],["φοβούμενοί",134,351],["σε",5,161],["καὶ",2,8],["οἱ",1,128],["γινώσκοντες",79,137],["τὰ",1,42],["μαρτύριά",225,43],["σου",5,146]],"Let those that fear thee, and those that know thy testimonies, turn to me."],["80",[["Γενηθήτω",30,25],["ἡ",1,11],["καρδία",64,13],["μου",6,48],["ἄμωμος",637,15],["ἐν",4,1],["τοῖς",1,91],["δικαιώμασί",428,92],["σου",5,146],["ὅπως",240,8],["ἂν",83,12],["μὴ",25,8],["αἰσχυνθῶ",611,555]],"Let mine heart be blameless in thine ordinances, that I may not be ashamed."],["81",[["Ἐκλείπει",321,87],["εἰς",8,1],["τὸ",1,32],["σωτήριόν",472,33],["σου",5,146],["ἡ",1,11],["ψυχή",63,13],["μου",6,48],["εἰς",8,1],["τοὺς",1,56],["λόγους",48,31],["σου",5,146],["ἐπήλπισα",3195,147]],"My soul faints for thy salvation: I have hoped in thy words."],["82",[["Ἐξέλιπον",321,141],["οἱ",1,128],["ὀφθαλμοί",91,51],["μου",6,48],["εἰς",8,1],["τὸ",1,32],["λόγιόν",1248,33],["σου",5,146],["λέγοντες",31,137],["πότε",458,12],["παρακαλέσεις",434,159],["με",6,82]],"Mine eyes failed [in waiting] for thy word, saying, When wilt thou comfort me?"],["83",[["Ὅτι",19,8],["ἐγενήθην",30,148],["ὡς",36,8],["ἀσκὸς",2213,5],["ἐν",4,1],["πάχνῃ",3128,2],["τὰ",1,42],["δικαιώματά",428,43],["σου",5,146],["οὐκ",12,17],["ἐπελαθόμην",513,152]],"For I am become as a bottle in the frost: [yet] I have not forgotten thine ordinances."],["84",[["Πόσαι",2486,180],["εἰσὶν",10,191],["αἱ",1,185],["ἡμέραι",28,2],["τοῦ",1,30],["δούλου",136,21],["σου",5,146],["πότε",458,12],["ποιήσεις",23,159],["μοι",6,49],["ἐκ",21,1],["τῶν",1,76],["καταδιωκόντων",621,164],["με",6,98],["κρίσιν",229,10]],"How many are the days of thy servant? when wilt thou execute judgment for me on them that persecute me?"],["85",[["Διηγήσαντό",800,184],["μοι",6,49],["παράνομοι",830,130],["ἀδολεσχίας",4010,40],["ἀλλʼ",108,17],["οὐχ",12,17],["ὡς",36,8],["ὁ",1,4],["νόμος",140,5],["σου",5,146],["Κύριε",7,250]],"Transgressors told me [idle tales]; but not according to thy law, O Lord."],["86",[["Πᾶσαι",11,187],["αἱ",1,185],["ἐντολαί",259,180],["σου",5,146],["ἀλήθεια",352,13],["ἀδίκως",406,17],["κατεδίωξάν",621,141],["με",6,82],["βοήθησόν",553,198],["μοι",6,49]],"All thy commandments are truth; they persecuted me unjustly; help thou me."],["87",[["Παρὰ",73,1],["βραχὺ",618,29],["συνετέλεσάν",317,141],["με",6,82],["ἐν",4,1],["τῇ",1,95],["γῇ",26,2],["ἐγὼ",6,158],["δὲ",14,12],["οὐκ",12,17],["ἐγκατέλιπον",364,141],["τὰς",1,39],["ἐντολάς",259,40],["σου",5,146]],"They nearly made an end of me in the earth; but I forsook not thy commandments."],["88",[["Κατὰ",32,1],["τὸ",1,32],["ἔλεός",183,33],["σου",5,146],["ζῆσόν",107,466],["με",6,82],["καὶ",2,8],["φυλάξω",125,157],["τὰ",1,42],["μαρτύρια",225,43],["τοῦ",1,23],["στόματός",123,24],["σου",5,146]],"Quicken me according to thy mercy; so shall I keep the testimonies of thy mouth."],["89",[["Εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["Κύριε",7,250],["ὁ",1,4],["λόγος",48,5],["σου",5,146],["διαμένει",1884,87],["ἐν",4,1],["τῷ",1,110],["οὐρανῷ",94,113]],"Thy word, O Lord, abides in heaven for ever."],["90",[["εἰς",8,1],["γενεὰν",286,10],["καὶ",2,8],["γενεὰν",286,10],["ἡ",1,11],["ἀλήθειά",352,13],["σου",5,146],["ἐθεμελίωσας",1116,154],["τὴν",1,9],["γῆν",26,10],["καὶ",2,8],["διαμένει",1884,87]],"Thy truth [endures] to all generations; thou hast founded the earth, and it abides."],["91",[["Τῇ",1,95],["διατάξει",1507,120],["σου",5,146],["διαμένει",1884,87],["ἡμέρα",28,13],["ὅτι",19,8],["τὰ",1,42],["σύμπαντα",1357,65],["δοῦλα",136,43],["σά",405,43]],"The day continues by thy arrangement; for all things are thy servants."],["92",[["Εἰ",77,8],["μὴ",25,8],["ὅτι",19,8],["ὁ",1,4],["νόμος",140,5],["σου",5,146],["μελέτη",2269,13],["μου",6,48],["ἐστὶ",10,87],["τότε",250,17],["ἂν",83,12],["ἀπωλόμην",217,152],["ἐν",4,1],["τῇ",1,95],["ταπεινώσει",322,120],["μου",6,48]],"Were it not that thy law is my meditation, then I should have perished in mine affliction."],["93",[["Εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["οὐ",12,17],["μὴ",25,8],["ἐπιλάθωμαι",513,255],["τῶν",1,44],["δικαιωμάτων",428,45],["σου",5,146],["ὅτι",19,8],["ἐν",4,1],["αὐτοῖς",3,142],["ἔζησάς",107,154],["με",6,82]],"I will never forget thine ordinances; for with them thou hast quickened me."],["94",[["Σός",405,5],["εἰμι",10,149],["ἐγὼ",6,158],["σῶσόν",172,198],["με",6,82],["ὅτι",19,8],["τὰ",1,42],["δικαιώματά",428,43],["σου",5,146],["ἐξεζήτησα",460,147]],"I am thine, save me; for I have sought out thine ordinances."],["95",[["Ἐμὲ",6,82],["ὑπέμειναν",639,141],["ἁμαρτωλοὶ",409,130],["τοῦ",1,30],["ἀπολέσαι",217,100],["με",6,82],["τὰ",1,42],["μαρτύριά",225,43],["σου",5,146],["συνῆκα",606,147]],"Sinners laid wait for me to destroy me; [but] I understood thy testimonies."],["96",[["Πάσης",11,78],["συντελείας",810,19],["εἶδον",53,147],["πέρας",876,20],["πλατεία",925,188],["ἡ",1,11],["ἐντολή",259,13],["σου",5,146],["σφόδρα",150,17]],"I have seen an end of all perfection; [but] thy commandment is very broad."],["97",[["Ὡς",36,8],["ἠγάπησα",214,147],["τὸν",1,6],["νόμον",140,7],["σου",5,146],["Κύριε",7,250],["ὅλην",235,37],["τὴν",1,9],["ἡμέραν",28,10],["μελέτη",2269,13],["μου",6,48],["ἐστίν",10,87]],"How I have loved thy law, O Lord! it is my meditation all the day."],["98",[["Ὑπὲρ",139,1],["τοὺς",1,56],["ἐχθρούς",135,31],["μου",6,48],["ἐσόφισάς",1786,154],["με",6,98],["τὴν",1,9],["ἐντολήν",259,10],["σου",5,146],["ὅτι",19,8],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["ἐμή",525,13],["ἐστιν",10,87]],"Thou hast made me wiser than mine enemies [in] thy commandment; for it is mine for ever."],["99",[["Ὑπὲρ",139,1],["πάντας",11,58],["τοὺς",1,56],["διδάσκοντάς",545,229],["με",6,82],["συνῆκα",606,147],["ὅτι",19,8],["τὰ",1,42],["μαρτύριά",225,43],["σου",5,146],["μελέτη",2269,13],["μου",6,48],["ἐστίν",10,87]],"I have more understanding than all my teachers; for thy testimonies are my meditation."],["100",[["Ὑπὲρ",139,1],["πρεσβυτέρους",332,31],["συνῆκα",606,147],["ὅτι",19,8],["τὰς",1,39],["ἐντολάς",259,40],["σου",5,146],["ἐξεζήτησα",460,147]],"I understand more than the aged; because I have sought out thy commandments."],["101",[["Ἐκ",21,1],["πάσης",11,78],["ὁδοῦ",68,19],["πονηρᾶς",164,78],["ἐκώλυσα",1440,147],["τοὺς",1,56],["πόδας",210,31],["μου",6,48],["ὅπως",240,8],["ἂν",83,12],["φυλάξω",125,157],["τοὺς",1,56],["λόγους",48,31],["σου",5,146]],"I have kept back my feet from every evil way, that I might keep thy words."],["102",[["Ἀπὸ",17,1],["τῶν",1,44],["κριμάτων",267,45],["σου",5,146],["οὐκ",12,17],["ἐξέκλινα",394,147],["ὅτι",19,8],["σὺ",5,156],["ἐνομοθέτησάς",2746,154],["με",6,82]],"I have not declined from thy judgments; for thou hast instructed me."],["103",[["Ὡς",36,8],["γλυκέα",2073,15],["τῷ",1,110],["λάρυγγί",2092,113],["μου",6,48],["τὰ",1,42],["λόγιά",1248,43],["σου",5,146],["ὑπὲρ",139,1],["μέλι",807,20],["τῷ",1,52],["στόματί",123,53],["μου",6,48]],"How sweet are thine oracles to my throat! more so than honey to my mouth!"],["104",[["Ἀπὸ",17,1],["τῶν",1,123],["ἐντολῶν",259,61],["σου",5,146],["συνῆκα",606,147],["διὰ",56,1],["τοῦτο",16,122],["ἐμίσησα",351,147],["πᾶσαν",11,37],["ὁδὸν",68,10],["ἀδικίας",288,19]],"I gain understanding by thy commandments: therefore I have hated every way of unrighteousness."],["105",[["Λύχνος",1059,5],["τοῖς",1,138],["ποσί",210,139],["μου",6,48],["ὁ",1,4],["νόμος",140,5],["σου",5,146],["καὶ",2,8],["φῶς",380,20],["ταῖς",1,70],["τρίβοις",745,71],["μου",6,48]],"Thy law is a lamp to my feet, and a light to my paths."],["106",[["Ὤμοσα",347,147],["καὶ",2,8],["ἔστησα",78,147],["τοῦ",1,30],["φυλάξασθαι",125,103],["τὰ",1,42],["κρίματα",267,43],["τῆς",1,18],["δικαιοσύνης",187,19],["σου",5,146]],"I have sworn and determined to keep the judgments of thy righteousness."],["107",[["Ἐταπεινώθην",322,148],["ἕως",42,8],["σφόδρα",150,17],["Κύριε",7,250],["ζῆσόν",107,548],["με",6,82],["κατὰ",32,1],["τὸν",1,6],["λόγον",48,7],["σου",5,146]],"I have been very greatly afflicted, O Lord: quicken me, according to thy word."],["108",[["Τὰ",1,42],["ἑκούσια",2424,65],["τοῦ",1,23],["στόματός",123,24],["μου",6,48],["εὐλόκησον",0,0],["δὴ",193,12],["Κύριε",7,250],["καὶ",2,8],["τὰ",1,42],["κρίματά",267,43],["σου",5,146],["δίδαξόν",545,198],["με",6,82]],"Accept, I pray thee, O Lord, the freewill-offerings of my mouth, and teach me thy judgments."],["109",[["Ἡ",1,11],["ψυχή",63,13],["μου",6,48],["ἐν",4,1],["ταῖς",1,70],["χερσὶ",37,71],["σου",5,146],["διαπαντὸς",510,17],["καὶ",2,8],["τὸν",1,6],["νόμον",140,7],["σου",5,146],["οὐκ",12,17],["ἐπελαθόμην",513,152]],"My soul is continually in thine hands; and I have not forgotten thy law."],["110",[["Ἔθεντο",110,184],["ἁμαρτωλοὶ",409,130],["παγίδα",817,10],["μοι",6,49],["καὶ",2,8],["ἐκ",21,1],["τῶν",1,123],["ἐντολῶν",259,61],["σου",5,146],["οὐκ",12,17],["ἐπλανήθην",464,94]],"Sinners spread a snare for me; but I erred not from thy commandments."],["111",[["Ἐκληρονόμησα",370,147],["τὰ",1,42],["μαρτύριά",225,43],["σου",5,146],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["ὅτι",19,8],["ἀγαλλιάμα",1794,20],["τῆς",1,18],["καρδίας",64,19],["μού",6,83],["εἰσιν",10,191]],"I have inherited thy testimonies for ever; for they are the joy of my heart."],["112",[["Ἔκλινα",785,147],["τὴν",1,9],["καρδίαν",64,10],["μου",6,48],["τοῦ",1,30],["ποιῆσαι",23,100],["τὰ",1,42],["δικαιώματά",428,43],["σου",5,146],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["διʼ",56,1],["ἀντάμειψιν",8937,10]],"I have inclined my heart to perform thine ordinances for ever, in return [for thy mercies]."],["113",[["Παρανόμους",830,58],["ἐμίσησα",351,147],["τὸν",1,6],["δὲ",14,12],["νόμον",140,7],["σου",5,146],["ἠγάπησα",214,147]],"I have hated transgressors; but I have loved thy law."],["114",[["Βοηθός",947,5],["μου",6,48],["καὶ",2,8],["ἀντιλήπτωρ",2209,5],["μου",6,48],["εἶ",10,145],["σὺ",5,156],["εἰς",8,1],["τοὺς",1,56],["λόγους",48,31],["σου",5,146],["ἐπήλπισα",3195,147]],"Thou art my helper and my supporter; I have hoped in thy words."],["115",[["Ἐκκλίνατε",394,69],["ἀπʼ",17,1],["ἐμοῦ",6,48],["οἱ",1,128],["πονηρευόμενοι",1331,351],["καὶ",2,8],["ἐξεραυνήσω",6473,157],["τὰς",1,39],["ἐντολὰς",259,40],["τοῦ",1,30],["Θεοῦ",20,21],["μου",6,48]],"Depart from me, ye evil-doers; for I will search out the commandments of my God."],["116",[["Ἀντιλαβοῦ",984,275],["μου",6,48],["κατὰ",32,1],["τὸ",1,32],["λόγιόν",1248,33],["σου",5,146],["καὶ",2,8],["ζῆσόν",107,171],["με",6,82],["καὶ",2,8],["μὴ",25,8],["καταισχύνῃς",696,199],["με",6,82],["ἀπὸ",17,1],["τῆς",1,18],["προσδοκίας",3118,19],["μου",6,83]],"Uphold me according to thy word, and quicken me; and make me not ashamed of my expectation."],["117",[["Βοήθησόν",553,198],["μοι",6,49],["καὶ",2,8],["σωθήσομαι",172,176],["καὶ",2,8],["μελετήσω",1347,157],["ἐν",4,1],["τοῖς",1,91],["δικαιώμασί",428,92],["σου",5,146],["διαπαντός",510,17]],"Help me, and I shall be saved; and I will meditate in thine ordinances continually."],["118",[["Ἐξουδένωσας",1068,154],["πάντας",11,58],["τοὺς",1,56],["ἀποστατοῦντας",3175,229],["ἀπὸ",17,1],["τῶν",1,44],["δικαιωμάτων",428,45],["σου",5,146],["ὅτι",19,8],["ἄδικον",406,28],["τὸ",1,27],["ἐνθύμημα",1491,20],["αὐτῶν",3,41]],"Thou hast brought to nought all that depart from thine ordinances; for their inward thought is unrighteous."],["119",[["Παραβαίνοντας",788,229],["ἐλογισάμην",495,325],["πάντας",11,58],["τοὺς",1,56],["ἁμαρτωλοὺς",409,58],["τῆς",1,18],["γῆς",26,19],["διὰ",56,1],["τοῦτο",16,122],["ἠγάπησα",214,147],["τὰ",1,42],["μαρτύριά",225,43],["σου",5,146]],"I have reckoned all the sinners of the earth as transgressors; therefore have I loved thy testimonies."],["120",[["Καθήλωσον",7292,547],["ἐκ",21,1],["τοῦ",1,30],["φόβου",333,21],["σου",5,146],["τὰς",1,39],["σάρκας",287,40],["μου",6,48],["ἀπὸ",17,1],["γὰρ",40,12],["τῶν",1,44],["κριμάτων",267,45],["σου",5,146],["ἐφοβήθην",134,148]],"Penetrate my flesh with thy fear; for I am afraid of thy judgments."],["121",[["Ἐποίησα",23,147],["κρίμα",267,33],["καὶ",2,8],["δικαιοσύνην",187,10],["μὴ",25,8],["παραδῷς",254,170],["με",6,82],["τοῖς",1,138],["ἀδικοῦσί",760,352],["με",6,82]],"I have done judgment and justice; deliver me not up to them that injure me."],["122",[["Ἔνδεξαι",6450,275],["τὸν",1,6],["δοῦλόν",136,7],["σου",5,146],["εἰς",8,1],["ἀγαθὸν",114,29],["μὴ",25,8],["συκοφαντησάτωσάν",2959,261],["με",6,82],["ὑπερήφανοι",1109,130]],"Receive thy servant for good: let not the proud accuse me falsely."],["123",[["Οἱ",1,128],["ὀφθαλμοί",91,51],["μου",6,48],["ἐξέλιπον",321,141],["εἰς",8,1],["τὸ",1,32],["σωτήριόν",472,33],["σου",5,146],["καὶ",2,8],["εἰς",8,1],["τὸ",1,32],["λόγιον",1248,33],["τῆς",1,18],["δικαιοσύνης",187,19],["σου",5,146]],"Mine eyes have failed for thy salvation, and for the word of thy righteousness."],["124",[["Ποίησον",23,198],["μετὰ",29,1],["τοῦ",1,30],["δούλου",136,21],["σου",5,146],["κατὰ",32,1],["τὸ",1,32],["ἔλεός",183,33],["σου",5,146],["καὶ",2,8],["τὰ",1,42],["δικαιώματά",428,43],["σου",5,146],["δίδαξόν",545,198],["με",6,82]],"Deal with thy servant according to thy mercy, and teach me thine ordinances."],["125",[["Δοῦλός",136,5],["σου",5,146],["εἰμὶ",10,149],["ἐγὼ",6,158],["συνέτισόν",2194,198],["με",6,82],["καὶ",2,8],["γνώσομαι",79,177],["τὰ",1,42],["μαρτύριά",225,43],["σου",5,146]],"I am thy servant; instruct me, and I shall know thy testimonies."],["126",[["Καιρὸς",132,5],["τοῦ",1,30],["ποιῆσαι",23,100],["τῷ",1,110],["Κυρίῳ",7,113],["διεσκέδασαν",1114,141],["τὸν",1,6],["νόμον",140,7],["σου",5,146]],"[It is] time for the Lord to work: they have utterly broken thy law."],["127",[["Διὰ",56,1],["τοῦτο",16,122],["ἠγάπησα",214,147],["τὰς",1,39],["ἐντολάς",259,40],["σου",5,146],["ὑπὲρ",139,1],["χρυσίον",202,20],["καὶ",2,8],["τοπάζιον",3976,105]],"Therefore have I loved thy commandments more than gold, or the topaz."],["128",[["Διὰ",56,1],["τοῦτο",16,122],["πρὸς",15,1],["πάσας",11,109],["τὰς",1,39],["ἐντολάς",259,40],["σου",5,146],["κατωρθούμην",1471,374],["πᾶσαν",11,37],["ὁδὸν",68,10],["ἄδικον",406,37],["ἐμίσησα",351,147]],"Therefore I directed myself [according] to all thy commandments: I have hated every unjust way."],["129",[["Θαυμαστὰ",1073,74],["τὰ",1,253],["μαρτύριά",225,63],["σου",5,146],["διὰ",56,1],["τοῦτο",16,122],["ἐξηρεύνησεν",1863,3],["αὐτὰ",3,66],["ἡ",1,11],["ψυχή",63,13],["μου",6,48]],"Thy testimonies are wonderful: therefore my soul has sought them out."],["130",[["Ἡ",1,11],["δήλωσις",4213,13],["τῶν",1,76],["λόγων",48,77],["σου",5,146],["φωτιεῖ",1230,120],["καὶ",2,8],["συνετιεῖ",2194,120],["νηπίους",1016,58]],"The manifestation of thy words will enlighten, and instruct the simple."],["131",[["Τὸ",1,32],["στόμα",123,33],["μου",6,48],["ἤνοιξα",362,147],["καὶ",2,8],["εἵλκυσα",1217,147],["πνεῦμα",168,20],["ὅτι",19,8],["τὰς",1,39],["ἐντολάς",259,40],["σου",5,146],["ἐπεπόθουν",2537,129]],"I opened my mouth, and drew breath: for I earnestly longed after thy commandments."],["132",[["Ἐπίβλεψον",517,198],["ἐπʼ",9,1],["ἐμὲ",6,82],["καὶ",2,8],["ἐλέησόν",446,198],["με",6,82],["κατὰ",32,1],["τὸ",1,32],["κρίμα",267,33],["τῶν",1,76],["ἀγαπώντων",214,164],["τὸ",1,32],["ὄνομά",57,33],["σου",5,146]],"Look upon me and have mercy upon me, after the manner of them that love thy name."],["133",[["Τὰ",1,42],["διαβήματά",2077,43],["μου",6,48],["κατεύθυνον",827,198],["κατὰ",32,1],["τὸ",1,32],["λόγιόν",1248,33],["σου",5,146],["καὶ",2,8],["μὴ",25,8],["κατακυριευσάτω",2084,46],["μου",6,48],["πᾶσα",11,15],["ἀνομία",275,13]],"Order my steps according to thy word: and let not any iniquity have dominion over me."],["134",[["Λύτρωσαί",535,275],["με",6,82],["ἀπὸ",17,1],["συκοφαντίας",3961,40],["ἀνθρώπων",43,77],["καὶ",2,8],["φυλάξω",125,157],["τὰς",1,39],["ἐντολάς",259,40],["σου",5,146]],"Deliver me from the false accusation of men: so will I keep thy commandments."],["135",[["Τὸ",1,32],["πρόσωπόν",47,33],["σου",5,146],["ἐπίφανον",1707,198],["ἐπὶ",9,1],["τὸν",1,6],["δοῦλόν",136,7],["σου",5,146],["καὶ",2,8],["δίδαξόν",545,198],["με",6,82],["τὰ",1,42],["δικαιώματά",428,43],["σου",5,146]],"Cause thy face to shine upon thy servant: and teach me thine ordinances."],["136",[["Διεξόδους",1508,40],["ὑδάτων",85,45],["κατέβησαν",175,141],["οἱ",1,128],["ὀφθαλμοί",91,51],["μου",6,48],["ἐπεὶ",1236,8],["οὐκ",12,17],["ἐφύλαξα",125,147],["τὸν",1,6],["νόμον",140,7],["σου",5,146]],"Mine eyes have been bathed in streams of water, because I kept not thy law."],["137",[["Δίκαιος",153,16],["εἶ",10,145],["Κύριε",7,250],["καὶ",2,8],["εὐθεῖς",825,187],["αἱ",1,185],["κρίσεις",229,180],["σου",5,146]],"Righteous art thou, O Lord, and upright are thy judgments."],["138",[["Ἐνετείλω",143,169],["δικαιοσύνην",187,10],["τὰ",1,42],["μαρτύριά",225,43],["σου",5,146],["καὶ",2,8],["ἀλήθειαν",352,10],["σφόδρα",150,17]],"Thou hast commanded righteousness and perfect truth, [as] thy testimonies."],["139",[["Ἐξέτηξέ",3185,3],["με",6,82],["ὁ",1,4],["ζῆλός",1164,5],["σου",5,146],["ὅτι",19,8],["ἐπελάθοντο",3006,184],["τῶν",1,76],["λόγων",48,77],["σου",5,146],["οἱ",1,128],["ἐχθροί",135,51],["μου",6,48]],"Thy zeal has quite wasted me: because mine enemies have forgotten thy words."],["140",[["Πεπυρωμένον",926,445],["τὸ",1,32],["λόγιόν",1248,33],["σου",5,146],["σφόδρα",150,17],["καὶ",2,8],["ὁ",1,4],["δοῦλός",136,5],["σου",5,146],["ἠγάπησεν",214,3],["αὐτό",3,121]],"Thy word [has been] very fully tried; and thy servant loves it."],["141",[["Νεώτερος",515,16],["ἐγὼ",6,158],["εἰμι",10,149],["καὶ",2,8],["ἐξουδενωμένος",1068,408],["τὰ",1,42],["δικαιώματά",428,43],["σου",5,146],["οὐκ",12,17],["ἐπελαθόμην",513,152]],"I am young and despised: [yet] I have not forgotten thine ordinances."],["142",[["Ἡ",1,11],["δικαιοσύνη",187,13],["σου",5,146],["δικαιοσύνη",187,13],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["καὶ",2,8],["ὁ",1,4],["νόυος",0,0],["σου",5,146],["ἀλήθεια",352,13]],"Thy righteousness is an everlasting righteousness, and thy law is truth."],["143",[["Θλίψεις",438,180],["καὶ",2,8],["ἀνάγκαι",1126,180],["εὕροσάν",101,141],["με",6,82],["ἐντολαί",259,180],["σου",5,146],["μελέτη",2269,13],["μου",6,48]],"Afflictions and distresses found me: [but] thy commandments [were] my meditation."],["144",[["Δικαιοσύνη",187,13],["τὰ",1,42],["μαρτύριά",225,43],["σου",5,146],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["συνέτισόν",2194,198],["με",6,82],["καὶ",2,8],["ζήσομαι",107,177]],"Thy testimonies [are] an everlasting righteousness: instruct me, and I shall live."],["145",[["Ἐκέκραξα",592,147],["ἐν",4,1],["ὅλῃ",235,96],["καρδίᾳ",64,2],["μου",6,48],["ἐπάκουσόν",597,198],["μου",6,48],["Κύριε",7,250],["τὰ",1,42],["δικαιώματά",428,43],["σου",5,146],["ἐκζητήσω",460,157]],"I cried with my whole heart; hear me, O Lord: I will search out thine ordinances."],["146",[["Ἐκέκραξά",0,0],["σοι",5,151],["σῶσόν",172,198],["με",6,82],["καὶ",2,8],["φυλάξω",125,157],["τὰ",1,42],["μαρτύριά",225,43],["σου",5,146]],"I cried to thee; save me, and I will keep thy testimonies."],["147",[["Προέφθασα",1831,147],["ἐν",4,1],["ἀωρίᾳ",2668,96],["καὶ",2,8],["ἐκέκραξα",592,147],["εἰς",8,1],["τοὺς",1,56],["λόγους",48,31],["σου",5,146],["ἐπήλπισα",3195,147]],"I arose before the dawn, and cried: I hoped in thy words."],["148",[["Προέφθασαν",1831,141],["οἱ",1,128],["ὀφθαλμοί",91,51],["μου",6,48],["πρὸς",15,1],["ὄρθρον",1434,7],["τοῦ",1,30],["μελετᾷν",1347,54],["τὰ",1,42],["λόγιά",1248,43],["σου",5,146]],"Mine eyes prevented the dawn, that I might meditate on thine oracles."],["149",[["Τῆς",1,18],["φωνῆς",95,19],["μου",6,83],["ἄκουσον",54,198],["Κύριε",7,250],["κατὰ",32,1],["τὸ",1,32],["ἔλεός",183,33],["σου",5,146],["κατὰ",32,1],["τὸ",1,32],["κρίμα",267,33],["σου",5,146],["ζῆσόν",107,466],["με",6,82]],"Hear my voice, O Lord, according to thy mercy; quicken me according to thy judgment."],["150",[["Προσήγγισαν",2375,141],["οἱ",1,128],["καταδιώκοντές",621,137],["με",6,82],["ἀνομίᾳ",275,2],["ἀπὸ",17,1],["δὲ",14,12],["τοῦ",1,30],["νόμου",140,21],["σου",5,146],["ἐμακρύνθησαν",0,0]],"They have drawn nigh who persecuted me unlawfully; and they are far removed from thy law."],["151",[["Ἐγγὺς",1026,17],["εἶ",10,145],["Κύριε",7,250],["καὶ",2,8],["πᾶσαι",11,187],["αἱ",1,185],["ὁδοί",68,180],["σου",5,146],["ἀλήθεια",352,13]],"Thou art near, O Lord; and all thy ways are truth."],["152",[["Κατʼ",32,1],["ἀρχὰς",270,40],["ἔγνων",79,147],["ἐκ",21,1],["τῶν",1,44],["μαρτυρίων",225,45],["σου",5,146],["ὅτι",19,8],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["ἐθεμελίωσας",1116,154],["αὐτά",3,66]],"I have known of old concerning thy testimonies, that thou hast founded them for ever."],["153",[["Ἴδε",713,17],["τὴν",1,9],["ταπείνωσίν",1481,10],["μου",6,48],["καὶ",2,8],["ἐξελοῦ",413,275],["με",6,82],["ὅτι",19,8],["τοῦ",1,30],["νόμου",140,21],["σου",5,146],["οὐκ",12,17],["ἐπελαθόμην",513,152]],"Look upon mine affliction, and rescue me; for I have not forgotten thy law."],["154",[["Κρῖνον",263,36],["τὴν",1,9],["κρίσιν",229,10],["μου",6,48],["καὶ",2,8],["λύτρωσαί",535,275],["με",6,82],["διὰ",56,1],["τὸν",1,6],["λόγον",48,7],["σου",5,146],["ζῆσόν",107,171],["με",6,82]],"Plead my cause, and ransom me: quicken me because of thy word."],["155",[["Μακρὰν",642,37],["ἀπὸ",17,1],["ἁμαρτωλῶν",409,163],["σωτηρία",425,188],["ὅτι",19,8],["τὰ",1,346],["δικαιώματά",428,63],["σου",5,146],["οὐκ",12,17],["ἐξεζήτησαν",460,141]],"Salvation is far from sinners: for they have not searched out thine ordinances."],["156",[["Οἱ",1,128],["οἰκτιρμοί",1187,51],["σου",5,146],["πολλοὶ",74,130],["Κύριε",7,250],["κατὰ",32,1],["τὸ",1,32],["κρίμα",267,33],["σου",5,146],["ζῆσόν",107,466],["με",6,82]],"Thy mercies, O Lord, are many: quicken me according to thy judgment."],["157",[["Πολλοὶ",74,130],["οἱ",1,128],["ἐκδιώκοντές",2220,137],["με",6,82],["καὶ",2,8],["θλίβοντές",601,137],["με",6,82],["ἐκ",21,1],["τῶν",1,44],["μαρτυρίων",225,45],["σου",5,146],["οὐκ",12,17],["ἐξέκλινα",394,147]],"Many are they that persecute me and oppress me: [but] I have not declined from thy testimonies."],["158",[["Εἶδον",53,147],["ἀσυνετοῦντας",9124,229],["καὶ",2,8],["ἐξετηκόμην",3185,374],["ὅτι",19,8],["τὰ",1,42],["λόγιά",1248,43],["σου",5,146],["οὐκ",12,17],["ἐφυλάξαντο",125,184]],"I beheld men acting foolishly, and I pined away; for they kept not thine oracles."],["159",[["Ἴδε",713,17],["ὅτι",19,8],["τὰς",1,39],["ἐντολάς",259,40],["σου",5,146],["ἠγάπησα",214,147],["Κύριε",7,250],["ἐν",4,1],["τῷ",1,52],["ἐλέει",183,53],["σου",5,146],["ζῆσόν",107,171],["με",6,82]],"Behold, I have loved thy commandments, O Lord: quicken me in thy mercy."],["160",[["Ἀρχὴ",270,13],["τῶν",1,76],["λόγων",48,77],["σου",5,146],["ἀλήθεια",352,13],["καὶ",2,8],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["πάντα",11,59],["τὰ",1,42],["κρίματα",267,43],["τῆς",1,18],["δικαιοσύνης",187,19],["σου",5,146]],"The beginning of thy words is truth; and all the judgments of thy righteousness [endure] for ever."],["161",[["Ἄρχοντες",96,51],["κατεδίωξάν",621,141],["με",6,98],["δωρεὰν",1341,10],["καὶ",2,8],["ἀπὸ",17,1],["τῶν",1,76],["λόγων",48,77],["σου",5,146],["ἐδειλίασεν",1955,3],["ἡ",1,11],["καρδία",64,13],["μου",6,48]],"Princes persecuted me without a cause, but my heart feared because of thy words."],["162",[["Ἀγαλλιάσομαι",738,177],["ἐγὼ",6,158],["ἐπὶ",9,1],["τὰ",1,42],["λόγιά",1248,43],["σου",5,146],["ὡς",36,8],["ὁ",1,4],["εὑρίσκων",101,67],["σκῦλα",559,43],["πολλά",74,65]],"I will exult because of thine oracles, as one that finds much spoil."],["163",[["Ἀδικίαν",288,10],["ἐμίσησα",351,147],["καὶ",2,8],["ἐβδελυξάμην",1056,325],["τὸν",1,6],["δὲ",14,12],["νόμον",140,7],["σου",5,146],["ἠγάπησα",214,147]],"I hate and abhor unrighteousness; but I love thy law."],["164",[["Ἑπτάκις",1608,17],["τῆς",1,18],["ἡμέρας",28,19],["ᾔνεσά",402,147],["σε",5,161],["ἐπὶ",9,1],["τὰ",1,42],["κρίματα",267,43],["τῆς",1,18],["δικαιοσύνης",187,19],["σου",5,146]],"Seven times in a day have I praised thee because of the judgments of thy righteousness."],["165",[["Εἰρήνη",213,13],["πολλὴ",74,15],["τοῖς",1,138],["ἀγαπῶσι",214,352],["τὸν",1,6],["νόμον",140,7],["σου",5,146],["καὶ",2,8],["οὐκ",12,17],["ἔστιν",10,87],["αὐτοῖς",3,142],["σκάνδαλον",1834,20]],"Great peace have they that love thy law: and there is no stumbling-block to them."],["166",[["Προσεδόκων",2758,129],["τὸ",1,32],["σωτήριόν",472,33],["σου",5,146],["Κύριε",7,250],["καὶ",2,8],["τὰς",1,39],["ἐντολάς",259,40],["σου",5,146],["ἠγάπησα",214,147]],"I waited for thy salvation, O Lord, and have loved thy commandments."],["167",[["Ἐφύλαξεν",125,3],["ἡ",1,11],["ψυχή",63,13],["μου",6,48],["τὰ",1,42],["μαρτύριά",225,43],["σου",5,146],["καὶ",2,8],["ἠγάπησεν",214,3],["αὐτὰ",3,66],["σφόδρα",150,17]],"My soul has kept thy testimonies, and loved them exceedingly."],["168",[["Ἐφύλαξα",125,147],["τὰς",1,39],["ἐντολάς",259,40],["σου",5,146],["καὶ",2,8],["τὰ",1,42],["μαρτύριά",225,43],["σου",5,146],["ὅτι",19,8],["πᾶσαι",11,187],["αἱ",1,185],["ὁδοί",68,180],["μου",6,48],["ἐναντίον",138,17],["σου",5,146],["Κύριε",7,250]],"I have kept thy commandments and thy testimonies; for all my ways are before thee, O Lord."],["169",[["Ἐγγυσάτω",0,0],["ἡ",1,11],["δέησίς",677,13],["μου",6,48],["ἐνώπιόν",115,1],["σου",5,146],["Κύριε",7,250],["κατὰ",32,1],["τὸ",1,32],["λόγιόν",1248,33],["σου",5,146],["συνέτισόν",2194,198],["με",6,82]],"Let my supplication come near before thee, O Lord; instruct me according to thine oracle."],["170",[["Εἰσέλθοι",86,216],["τὸ",1,32],["ἀξίωμά",3167,33],["μου",6,48],["ἐνώπιόν",115,1],["σου",5,146],["Κύριε",7,250],["κατὰ",32,1],["τὸ",1,32],["λόγιόν",1248,33],["σου",5,146],["ῥῦσαί",337,275],["με",6,82]],"Let my petition come in before thee, O Lord; deliver me according to thine oracle."],["171",[["Ἐξερεύξαιντο",0,0],["τὰ",1,42],["χείλη",361,43],["μου",6,48],["ὕμνον",1498,7],["ὅταν",319,8],["διδάξῃς",545,170],["με",6,82],["τὰ",1,42],["δικαιώματά",428,43],["σου",5,146]],"Let my lips utter a hymn, when thou shalt have taught me thine ordinances."],["172",[["Φθέγξαιτο",2296,392],["ἡ",1,11],["γλῶσσά",388,13],["μου",6,48],["τὰ",1,42],["λόγιά",1248,43],["σου",5,146],["ὅτι",19,8],["πᾶσαι",11,187],["αἱ",1,185],["ἐντολαί",259,180],["σου",5,146],["δικαιοσύνη",187,13]],"Let my tongue utter thine oracles; for all thy commandments are righteous."],["173",[["Γενέσθω",30,312],["ἡ",1,11],["χείρ",37,13],["σου",5,146],["τοῦ",1,30],["σῶσαί",172,100],["με",6,82],["ὅτι",19,8],["τὰς",1,39],["ἐντολάς",259,40],["σου",5,146],["ᾑρετισάμην",1618,152]],"Let thine hand be [prompt] to save me; for I have chosen thy commandments."],["174",[["Ἐπεπόθησα",2537,147],["τὸ",1,32],["σωτήριόν",472,33],["σου",5,146],["Κύριε",7,250],["καὶ",2,8],["ὁ",1,4],["νόμος",140,5],["σου",5,146],["μελέτη",2269,13],["μου",6,48],["ἐστί",10,87]],"I have longed after thy salvation, O Lord; and thy law is my meditation."],["175",[["Ζήσεται",107,89],["ἡ",1,11],["ψυχή",63,13],["μου",6,48],["καὶ",2,8],["αἰνέσει",402,120],["σε",5,161],["καὶ",2,8],["τὰ",1,42],["κρίματά",267,43],["σου",5,146],["βοηθήσει",366,373],["μοι",6,49]],"My soul shall live, and shall praise thee; and thy judgments shall help me."],["176",[["Ἐπλανήθην",464,94],["ὡς",36,8],["πρόβατον",194,33],["ἀπολωλὸς",217,419],["ζήτησον",191,198],["τὸν",1,6],["δοῦλόν",136,7],["σου",5,146],["ὅτι",19,8],["τὰς",1,39],["ἐντολάς",259,40],["σου",5,146],["οὐκ",12,17],["ἐπελαθόμην",513,152]],"I have gone astray like a lost sheep; seek thy servant; for I have not forgotten thy commandments."]]