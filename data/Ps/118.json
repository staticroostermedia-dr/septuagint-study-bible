[["1",[["Ἀλληλούϊα",1746,105],["Μακάριοι",803,130],["ἄμωμοι",633,130],["ἐν",4,1],["ὁδῷ",67,2],["οἱ",1,128],["πορευόμενοι",49,356],["ἐν",4,1],["νόμῳ",140,113],["Κυρίου",7,21]],"Alleluia. Blessed are the blameless in the way, who walk in the law of the Lord."],["2",[["Μακάριοι",803,130],["οἱ",1,128],["ἐξερευνῶντες",1864,137],["τὰ",1,42],["μαρτύρια",220,43],["αὐτοῦ",3,48],["ἐν",4,1],["ὅλῃ",233,96],["καρδίᾳ",63,2],["ἐκζητήσουσιν",459,207],["αὐτόν",3,82]],"Blessed are they that search out his testimonies: they will diligently seek him with the whole heart."],["3",[["Οὐ",12,17],["γὰρ",40,12],["οἱ",1,128],["ἐργαζόμενοι",468,356],["τὴν",1,9],["ἀνομίαν",274,10],["ἐν",4,1],["ταῖς",1,70],["ὁδοῖς",67,71],["αὐτοῦ",3,48],["ἐπορεύθησαν",49,94]],"For they that work iniquity have not walked in his ways."],["4",[["Σὺ",5,156],["ἐνετείλω",143,169],["τὰς",1,39],["ἐντολάς",259,40],["σου",5,146],["τοῦ",1,30],["φυλάξασθαι",127,103],["σφόδρα",149,17]],"Thou hast commanded [us] diligently to keep thy precepts."],["5",[["Ὄφελον",3478,12],["κατευθυνθείησαν",828,410],["αἱ",1,183],["ὁδοί",67,179],["μου",6,48],["τοῦ",1,30],["φυλάξασθαι",127,103],["τὰ",1,42],["δικαιώματά",425,43],["σου",5,146]],"O that my ways were directed to keep thine ordinances."],["6",[["Τότε",250,17],["οὐ",12,17],["μὴ",25,8],["αἰσχυνθῶ",614,569],["ἐν",4,1],["τῷ",1,110],["με",6,82],["ἐπιβλέπειν",516,54],["ἐπὶ",9,1],["πάσας",11,109],["τὰς",1,39],["ἐντολάς",259,40],["σου",5,146]],"Then shall I not be ashamed, when I have respect to all thy commandments."],["7",[["Ἐξομολογήσομαί",478,176],["σοι",5,151],["ἐν",4,1],["εὐθύτητι",1676,2],["καρδίας",63,19],["ἐν",4,1],["τῷ",1,110],["μεμαθηκέναι",923,107],["με",6,82],["τὰ",1,42],["κρίματα",266,43],["τῆς",1,18],["δικαιοσύνης",185,19],["σου",5,146]],"I will give thee thanks with uprightness of heart, when I have learnt the judgments of thy righteousness."],["8",[["Τὰ",1,42],["δικαιώματά",425,43],["σου",5,146],["φυλάξω",127,157],["μή",25,8],["με",6,82],["ἐγκαταλίπῃς",363,170],["ἕως",42,8],["σφόδρα",149,17]],"I will keep thine ordinances: O forsake me not greatly."],["9",[["Ἐν",4,1],["τίνι",39,442],["κατορθώσει",1471,120],["νεώτερος",513,16],["τὴν",1,9],["ὁδὸν",67,10],["αὐτοῦ",3,48],["ἐν",4,1],["τῷ",1,110],["φυλάξασθαι",127,103],["τοὺς",1,56],["λόγους",48,31],["σου",5,146]],"Wherewith shall a young man direct his way? by keeping thy words."],["10",[["Ἐν",4,1],["ὅλῃ",233,96],["καρδίᾳ",63,2],["μου",6,48],["ἐξεζήτησά",459,147],["σε",5,161],["μὴ",25,8],["ἀπώσῃ",767,116],["με",6,82],["ἀπὸ",17,1],["τῶν",1,123],["ἐντολῶν",259,61],["σου",5,146]],"With my whole heart have I diligently sought thee: cast me not away from thy commandments."],["11",[["Ἐν",4,1],["τῇ",1,95],["καρδίᾳ",63,2],["μου",6,48],["ἔκρυψα",378,147],["τὰ",1,42],["λόγιά",1249,43],["σου",5,146],["ὅπως",236,8],["ἂν",82,12],["μὴ",25,8],["ἁμάρτω",244,227],["σοι",5,151]],"I have hidden thine oracles in my heart, that I might not sin against thee."],["12",[["Εὐλογητὸς",763,16],["εἶ",10,145],["Κύριε",7,251],["δίδαξόν",543,198],["με",6,82],["τὰ",1,42],["δικαιώματά",425,43],["σου",5,146]],"Blessed art thou, O Lord: teach me thine ordinances."],["13",[["Ἐν",4,1],["τοῖς",1,91],["χείλεσί",361,92],["μου",6,48],["ἐξήγγειλα",2535,147],["πάντα",11,65],["τὰ",1,42],["κρίματα",266,43],["τοῦ",1,23],["στόματός",123,24],["σου",5,146]],"With my lips have I declared all the judgments of thy mouth."],["14",[["Ἐν",4,1],["τῇ",1,95],["ὁδῷ",67,2],["τῶν",1,44],["μαρτυρίων",220,45],["σου",5,146],["ἐτέρφθην",1602,148],["ὡς",36,8],["ἐπὶ",9,1],["παντὶ",11,111],["πλούτῳ",572,113]],"I have delighted in the way of thy testimonies, [as much] as in all riches."],["15",[["Ἐν",4,1],["ταῖς",1,70],["ἐντολαῖς",259,71],["σου",5,146],["ἀδολεσχήσω",2515,157],["καὶ",2,8],["κατανοήσω",1547,157],["τὰς",1,39],["ὁδούς",67,40],["σου",5,146]],"I will meditate on thy commandments, and consider thy ways."],["16",[["Ἐν",4,1],["τοῖς",1,91],["δικαιώμασί",425,92],["σου",5,146],["μελετήσω",1344,157],["οὐκ",12,17],["ἐπιλήσομαι",512,176],["τῶν",1,76],["λόγων",48,77],["σου",5,146]],"I will meditate on thine ordinances: I will not forget thy words."],["17",[["Ἀνταπόδος",661,198],["τῷ",1,110],["δούλῳ",136,113],["σου",5,146],["ζήσομαι",117,176],["καὶ",2,8],["φυλάξω",127,157],["τοὺς",1,56],["λόγους",48,31],["σου",5,146]],"Render a recompence to thy servant: [so] shall I live, and keep thy words."],["18",[["Ἀποκάλυψον",662,243],["τοὺς",1,56],["ὀφθαλμούς",91,31],["μου",6,48],["καὶ",2,8],["κατανοήσω",1547,157],["τὰ",1,42],["θαυμάσια",885,65],["ἐκ",21,1],["τοῦ",1,30],["νόμου",140,21],["σου",5,146]],"Unveil thou mine eyes, and I shall perceive wondrous things out of thy law."],["19",[["Πάροικος",1421,16],["ἐγώ",6,158],["εἰμι",10,149],["ἐν",4,1],["τῇ",1,95],["γῇ",26,2],["μὴ",25,8],["ἀποκρύψῃς",1396,170],["ἀπʼ",17,1],["ἐμοῦ",6,48],["τὰς",1,39],["ἐντολάς",259,40],["σου",5,146]],"I am a stranger in the earth: hide not thy commandments from me."],["20",[["Ἐπεπόθησεν",2541,3],["ἡ",1,11],["ψυχή",62,13],["μου",6,48],["τοῦ",1,30],["ἐπιθυμῆσαι",916,100],["τὰ",1,42],["κρίματά",266,43],["σου",5,146],["ἐν",4,1],["παντὶ",11,111],["καιρῷ",132,113]],"My soul has longed exceedingly for thy judgments at all times."],["21",[["Ἐπετίμησας",2331,154],["ὑπερηφάνοις",1111,215],["ἐπικατάρατοι",1070,130],["οἱ",1,128],["ἐκκλίνοντες",393,137],["ἀπὸ",17,1],["τῶν",1,123],["ἐντολῶν",259,61],["σου",5,146]],"Thou hast rebuked the proud: cursed are they that turn aside from thy commandments."],["22",[["Περίελε",863,198],["ἀπʼ",17,1],["ἐμοῦ",6,48],["ὄνειδος",973,20],["καὶ",2,8],["ἐξουδένωσιν",4097,10],["ὅτι",19,8],["τὰ",1,42],["μαρτύριά",220,43],["σου",5,146],["ἐξεζήτησα",459,147]],"Remove from me reproach and contempt; for I have sought out thy testimonies."],["23",[["Καὶ",2,8],["γὰρ",40,12],["ἐκάθισαν",273,141],["ἄρχοντες",96,51],["καὶ",2,8],["κατʼ",32,1],["ἐμοῦ",6,48],["κατελάλουν",2365,129],["ὁ",1,4],["δὲ",14,12],["δοῦλός",136,5],["σου",5,146],["ἠδολέσχει",2515,14],["ἐν",4,1],["τοῖς",1,91],["δικαιώμασί",425,92],["σου",5,146]],"For princes sat and spoke against me: but thy servant was meditating on thine ordinances."],["24",[["Καὶ",2,8],["γὰρ",40,12],["τὰ",1,42],["μαρτύριά",220,43],["σου",5,146],["μελέτη",2284,13],["μου",6,48],["ἐστὶ",10,87],["καὶ",2,8],["αἱ",1,183],["συμβουλίαι",2972,179],["μου",6,48],["τὰ",1,42],["δικαιώματά",425,43],["σου",5,146]],"For thy testimonies are my meditation, and thine ordinances are my counsellors."],["25",[["Ἐκολλήθη",1272,38],["τῷ",1,52],["ἐδάφει",1712,53],["ἡ",1,11],["ψυχή",62,13],["μου",6,48],["ζῆσόν",117,171],["με",6,82],["κατὰ",32,1],["τὸ",1,32],["λόγον",48,7],["σου",5,146]],"My soul has cleaved to the ground; quicken thou me according to thy word."],["26",[["Τὰς",1,39],["ὁδούς",67,40],["σου",5,146],["ἐξήγγειλα",2535,147],["καὶ",2,8],["ἐπήκουσάς",595,154],["μου",6,48],["δίδαξόν",543,198],["με",6,82],["τὰ",1,42],["δικαιώματά",425,43],["σου",5,146]],"I declared my ways, and thou didst hear me; teach me thine ordinances."],["27",[["Ὁδὸν",67,10],["δικαιωμάτων",425,45],["σου",5,146],["συνέτισόν",2207,198],["με",6,82],["καὶ",2,8],["ἀδολεσχήσω",2515,157],["ἐν",4,1],["τοῖς",1,138],["θαυμασίοις",885,215],["σου",5,146]],"Instruct me in the way of thine ordinances; and I will meditate on thy wondrous works."],["28",[["Ἐνύσταξεν",2478,3],["ἡ",1,11],["ψυχή",62,13],["μου",6,83],["ἀπὸ",17,1],["ἀκηδίας",5195,19],["βεβαίωσόν",4730,243],["με",6,82],["ἐν",4,1],["τοῖς",1,138],["λόγοις",48,139],["σου",5,146]],"My soul has slumbered for sorrow; strengthen thou me with thy words."],["29",[["Ὁδὸν",67,10],["ἀδικίας",288,19],["ἀπόστησον",646,198],["ἀπʼ",17,1],["ἐμοῦ",6,48],["καὶ",2,8],["τῷ",1,110],["νόμῳ",140,113],["σου",5,146],["ἐλέησόν",457,243],["με",6,82]],"Remove from me the way of iniquity; and be merciful to me by thy law."],["30",[["Ὁδὸν",67,10],["ἀληθείας",350,19],["ᾑρετισάμην",1669,152],["καὶ",2,8],["τὰ",1,42],["κρίματά",266,43],["σου",5,146],["οὐκ",12,17],["ἐπελαθόμην",512,152]],"I have chosen the way of truth; and have not forgotten thy judgments."],["31",[["Ἐκολλήθην",1272,94],["τοῖς",1,91],["μαρτυρίοις",220,92],["σου",5,146],["Κύριε",7,251],["μή",25,8],["με",6,82],["καταισχύνῃς",716,199]],"I have cleaved to thy testimonies, O Lord; put me not to shame."],["32",[["Ὁδὸν",67,10],["ἐντολῶν",259,61],["σου",5,146],["ἔδραμον",818,141],["ὅταν",318,8],["ἐπλάτυνας",1779,154],["τὴν",1,9],["καρδίαν",63,10],["μου",6,48]],"I ran the way of thy commandments, when thou didst enlarge my heart."],["33",[["Νομοθέτησόν",2755,243],["με",6,98],["Κύριε",7,251],["τὴν",1,9],["ὁδὸν",67,10],["τῶν",1,44],["δικαιωμάτων",425,45],["σου",5,146],["καὶ",2,8],["ἐκζητήσω",459,157],["αὐτὴν",3,98],["διαπαντός",506,17]],"Teach me, O Lord, the way of thine ordinances, and I will seek it out continually."],["34",[["Συνέτισόν",2207,198],["με",6,82],["καὶ",2,8],["ἐξερευνήσω",1864,157],["τὸν",1,6],["νόμον",140,7],["σου",5,146],["καὶ",2,8],["φυλάξω",127,157],["αὐτὸν",3,82],["ἐν",4,1],["ὅλῃ",233,96],["καρδίᾳ",63,2],["μου",6,48]],"Instruct me, and I will search out thy law, and will keep it with my whole heart."],["35",[["Ὁδήγησόν",1110,243],["με",6,82],["ἐν",4,1],["τῇ",1,95],["τρίβῳ",744,2],["τῶν",1,123],["ἐντολῶν",259,61],["σου",5,146],["ὅτι",19,8],["αὐτὴν",3,98],["ἠθέλησα",609,147]],"Guide me in the path of thy commandments; for I have delighted in it."],["36",[["Κλῖνον",829,36],["τὴν",1,9],["καρδίαν",63,10],["μου",6,48],["εἰς",8,1],["τὰ",1,42],["μαρτύριά",220,43],["σου",5,146],["καὶ",2,8],["μὴ",25,8],["εἰς",8,1],["πλεονεξίαν",3337,10]],"Incline mine heart to thy testimonies, and not to covetousness."],["37",[["Ἀπόστρεψον",130,198],["τοὺς",1,56],["ὀφθαλμούς",91,31],["μου",6,48],["τοῦ",1,30],["μὴ",25,8],["ἰδεῖν",73,100],["ματαιότητα",937,10],["ἐν",4,1],["τῇ",1,95],["ὁδῷ",67,2],["σου",5,146],["ζῆσόν",117,171],["με",6,82]],"Turn away mine eyes that I may not behold vanity: quicken thou me in thy way."],["38",[["Στῆσον",78,171],["τῷ",1,110],["δούλῳ",136,113],["σου",5,146],["τὸ",1,32],["λόγιόν",1249,33],["σου",5,146],["εἰς",8,1],["τὸν",1,6],["φόβον",330,7],["σου",5,146]],"Confirm thine oracle to thy servant, that he may fear thee."],["39",[["Περίελε",863,198],["τὸν",1,6],["ὄνειδισμόν",732,7],["μου",6,48],["ὃν",24,106],["ὑπώπτευσα",6690,147],["ὅτι",19,8],["τὰ",1,42],["κρίματά",266,43],["σου",5,146],["χρηστά",1357,65]],"Take away my reproach which I have feared: for thy judgments are good."],["40",[["Ἰδοὺ",51,17],["ἐπεθύμησα",916,147],["τὰς",1,39],["ἐντολάς",259,40],["σου",5,146],["ἐν",4,1],["τῇ",1,95],["δικαιοσύνῃ",185,2],["σου",5,146],["ζῆσόν",117,171],["με",6,82]],"Behold, I have desired thy commandments: quicken me in thy righteousness."],["41",[["Καὶ",2,8],["ἔλθοι",56,276],["ἐπʼ",9,1],["ἐμὲ",6,82],["τὸ",1,32],["ἔλεός",182,33],["σου",5,146],["Κύριε",7,251],["τὸ",1,32],["σωτήριόν",471,33],["σου",5,146],["κατὰ",32,1],["τὸν",1,6],["λόγον",48,7],["σου",5,146]],"And let thy mercy come upon me, O Lord; [even] thy salvation, according to thy word."],["42",[["Καὶ",2,8],["ἀποκριθήσομαι",229,175],["τοῖς",1,138],["ὀνειδίζουσί",946,357],["μοι",6,49],["λόγον",48,7],["ὅτι",19,8],["ἤλπισα",511,147],["ἐπὶ",9,1],["τοῖς",1,138],["λόγοις",48,139],["σου",5,146]],"And [so] I shall render an answer to them that reproach me: for I have trusted in thy words."],["43",[["Καὶ",2,8],["μὴ",25,8],["περιέλῃς",863,170],["ἐκ",21,1],["τοῦ",1,23],["στόματός",123,24],["μου",6,83],["λόγον",48,7],["ἀληθείας",350,19],["ἕως",42,8],["σφόδρα",149,17],["ὅτι",19,8],["ἐπὶ",9,1],["τοῖς",1,91],["κρίμασί",266,92],["σου",5,146],["ἐπήλπισα",3201,147]],"And take not the word of truth utterly out of my mouth; for I have hoped in thy judgments."],["44",[["Καὶ",2,8],["φυλάξω",127,157],["τὸν",1,6],["νόμον",140,7],["σου",5,146],["διαπαντὸς",506,17],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["καὶ",2,8],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["τοῦ",1,30],["αἰῶνος",100,21]],"So shall I keep thy law continually, for ever and ever."],["45",[["Καὶ",2,8],["ἐπορευόμην",49,380],["ἐν",4,1],["πλατυσμῷ",3627,113],["ὅτι",19,8],["τὰς",1,39],["ἐντολάς",259,40],["σου",5,146],["ἐξεζήτησα",459,147]],"I walked also at large: for I sought out thy commandments."],["46",[["Καὶ",2,8],["ἐλάλουν",50,129],["ἐν",4,1],["τοῖς",1,91],["μαρτυρίοις",220,92],["σου",5,146],["ἐναντίον",138,17],["βασιλέων",22,77],["καὶ",2,8],["οὐκ",12,17],["ᾐσχυνόμην",614,380]],"And I spoke of thy testimonies before kings, and was not ashamed."],["47",[["Καὶ",2,8],["ἐμελέτων",1344,129],["ἐν",4,1],["ταῖς",1,70],["ἐντολαῖς",259,71],["σου",5,146],["αἷς",24,282],["ἠγάπησα",224,147],["σφόδρα",149,17]],"And I meditated on thy commandments, which I loved exceedingly."],["48",[["Καὶ",2,8],["ᾖρα",0,0],["τὰς",1,39],["χεῖράς",37,40],["μου",6,48],["πρὸς",15,1],["τὰς",1,39],["ἐντολάς",259,40],["σου",5,146],["ἃς",24,184],["ἠγάπησα",224,147],["καὶ",2,8],["ἠδολέσχουν",2515,129],["ἐν",4,1],["τοῖς",1,91],["δικαιώμασί",425,92],["σου",5,146]],"And I lifted up my hands to thy commandments which I loved; and I meditated in thine ordinances."],["49",[["Μνήσθητι",231,242],["τῶν",1,76],["λόγων",48,77],["σου",5,146],["τῷ",1,110],["δούλῳ",136,113],["σου",5,146],["ὧν",24,97],["ἐπήλπισάς",3201,154],["με",6,82]],"Remember thy words to thy servant, wherein thou hast made me hope."],["50",[["Αὕτη",16,101],["με",6,82],["παρεκάλεσεν",432,3],["ἐν",4,1],["τῇ",1,95],["ταπεινώσει",333,120],["μου",6,48],["ὅτι",19,8],["τὸ",1,32],["λόγιόν",1249,33],["σου",5,146],["ἔζησέ",117,3],["με",6,82]],"This has comforted me in mine affliction: for thine oracle has quickened me."],["51",[["Ὑπερήφανοι",1111,130],["παρηνόμουν",2760,129],["ἕως",42,8],["σφόδρα",149,17],["ἀπὸ",17,1],["δὲ",14,12],["τοῦ",1,30],["νόμου",140,21],["σου",5,146],["οὐκ",12,17],["ἐξέκλινα",393,147]],"The proud have transgressed exceedingly; but I swerved not from thy law."],["52",[["Ἐμνήσθην",231,148],["τῶν",1,44],["κριμάτων",266,45],["σου",5,146],["ἀπʼ",17,1],["αἰῶνος",100,21],["Κύριε",7,251],["καὶ",2,8],["παρεκλήθην",432,148]],"I remembered thy judgments of old, O Lord; and was comforted."],["53",[["Ἀθυμία",5192,13],["κατέσχε",1057,3],["με",6,82],["ἀπὸ",17,1],["ἁμαρτωλῶν",406,163],["τῶν",1,76],["ἐγκαταλιμπανόντων",363,164],["τὸν",1,6],["νόμον",140,7],["σου",5,146]],"Despair took hold upon me, because of the sinners who forsake thy law."],["54",[["Ψαλτὰ",8772,74],["ἦσάν",10,129],["μοι",6,49],["τὰ",1,42],["δικαιώματά",425,43],["σου",5,146],["ἐν",4,1],["τόπῳ",99,113],["παροικίας",2112,19],["μου",6,83]],"Thine ordinances were my songs in the place of my sojourning."],["55",[["Ἐμνήσθην",231,148],["ἐν",4,1],["νυκτὶ",216,2],["τοῦ",1,23],["ὀνόματός",55,24],["σου",5,146],["Κύριε",7,251],["καὶ",2,8],["ἐφύλαξα",127,147],["τὸν",1,6],["νόμον",140,7],["σου",5,146]],"I remembered thy name, O Lord, in the night, and kept thy law."],["56",[["Αὕτη",16,101],["ἐγενήθη",30,38],["μοι",6,49],["ὅτι",19,8],["τὰ",1,42],["δικαιώματά",425,43],["σου",5,146],["ἐξεζήτησα",459,147]],"This I had, because I diligently sought thine ordinances."],["57",[["Μερίς",396,13],["μου",6,48],["εἶ",10,145],["Κύριε",7,251],["εἶπα",18,147],["τοῦ",1,30],["φυλάξασθαι",127,103],["τὸν",1,6],["νόμον",140,7],["σου",5,146]],"Thou art my portion, O Lord: I said that I would keep thy law."],["58",[["Ἐδεήθην",1674,148],["τοῦ",1,23],["προσώπου",47,24],["σου",5,146],["ἐν",4,1],["ὅλῃ",233,96],["καρδίᾳ",63,2],["μου",6,48],["ἐλέησόν",457,243],["με",6,82],["κατὰ",32,1],["τὸ",1,32],["λόγιόν",1249,33],["σου",5,146]],"I besought thy favour with my whole heart: have mercy upon me according to thy word."],["59",[["Διελογισάμην",2577,329],["τὰς",1,39],["ὁδούς",67,40],["σου",5,146],["καὶ",2,8],["ἐπέστρεψα",116,147],["τοὺς",1,56],["πόδας",208,31],["μου",6,48],["εἰς",8,1],["τὰ",1,42],["μαρτύριά",220,43],["σου",5,146]],"I thought on thy ways, and turned my feet to thy testimonies."],["60",[["Ἡτοιμάσθην",371,148],["καὶ",2,8],["οὐκ",12,17],["ἐταράχθην",508,256],["τοῦ",1,30],["φυλάξασθαι",127,103],["τὰς",1,39],["ἐντολάς",259,40],["σου",5,146]],"I prepared myself, (and was not terrified,) to keep thy commandments."],["61",[["Σχοινία",1525,43],["ἁμαρτωλῶν",406,163],["περιεπλάκησάν",2953,94],["μοι",6,49],["καὶ",2,8],["τοῦ",1,30],["νόμου",140,21],["σου",5,146],["οὐκ",12,17],["ἐπελαθόμην",512,152]],"The snares of sinners entangled me: but I forgot not thy law."],["62",[["Μεσονύκτιον",5854,33],["ἐξεγειρόμην",650,380],["τοῦ",1,30],["ἐξομολογεῖσθαί",478,104],["σοι",5,151],["ἐπὶ",9,1],["τὰ",1,42],["κρίματα",266,43],["τῆς",1,18],["δικαιοσύνης",185,19],["σου",5,146]],"At midnight I arose, to give thanks to thee for the judgments of thy righteousness."],["63",[["Μέτοχος",3102,5],["ἐγώ",6,158],["εἰμι",10,149],["πάντων",11,163],["τῶν",1,76],["φοβουμένων",134,299],["σε",5,161],["καὶ",2,8],["τῶν",1,76],["φυλασσόντων",127,164],["τὰς",1,39],["ἐντολάς",259,40],["σου",5,146]],"I am a companion of all them that fear thee, and of them that keep thy commandments."],["64",[["Τοῦ",1,23],["ἐλέους",182,24],["σου",5,146],["Κύριε",7,251],["πλήρης",489,15],["ἡ",1,11],["γῆ",26,13],["τὰ",1,42],["δικαιώματά",425,43],["σου",5,146],["δίδαξόν",543,198],["με",6,82]],"O Lord, the earth is full of thy mercy: teach me thine ordinances."],["65",[["Χρηστότητα",1847,10],["ἐποίησας",23,154],["μετὰ",29,1],["τοῦ",1,30],["δούλου",136,21],["σου",5,146],["Κύριε",7,251],["κατὰ",32,1],["τὸν",1,6],["λόγον",48,7],["σου",5,146]],"Thou hast wrought kindly with thy servant, O Lord, according to thy word."],["66",[["Χρηστότητα",1847,10],["καὶ",2,8],["παιδείαν",569,10],["καὶ",2,8],["γνῶσιν",753,10],["δίδαξόν",543,198],["με",6,98],["ὅτι",19,8],["ταῖς",1,70],["ἐντολαῖς",259,71],["σου",5,146],["ἐπίστευσα",658,147]],"Teach me kindness, and instruction, and knowledge: for I have believed thy commandments."],["67",[["Πρὸ",235,1],["τοῦ",1,30],["με",6,82],["ταπεινωθῆναι",333,174],["ἐγὼ",6,158],["ἐπλημμέλησα",1351,147],["διὰ",54,1],["τοῦτο",16,122],["τὸ",1,32],["λόγιόν",1249,33],["σου",5,146],["ἐφύλαξα",127,147]],"Before I was afflicted, I transgressed; therefore have I kept thy word."],["68",[["Χρηστὸς",1357,16],["εἶ",10,145],["σὺ",5,156],["Κύριε",7,251],["καὶ",2,8],["ἐν",4,1],["τῇ",1,95],["χρηστότητί",1847,2],["σου",5,146],["δίδαξόν",543,198],["με",6,82],["τὰ",1,42],["δικαιωματά",425,43],["σου",5,146]],"Good art thou, O Lord; therefore in thy goodness teach me thine ordinances."],["69",[["Ἐπληθύνθη",315,38],["ἐπʼ",9,1],["ἐμὲ",6,82],["ἀδικία",288,13],["ὑπερηφάνων",1111,163],["ἐγὼ",6,178],["δὲ",14,12],["ἐν",4,1],["ὅλῃ",233,96],["καρδίᾳ",63,2],["μου",6,48],["ἐξερευνήσω",1864,157],["τὰς",1,39],["ἐντολάς",259,40],["σου",5,146]],"The injustice of the proud has been multiplied against me: but I will search out thy commandments with all my heart."],["70",[["Ἐτυρώθη",0,0],["ὡς",36,8],["γάλα",1031,33],["ἡ",1,11],["καρδία",63,13],["αὐτῶν",3,41],["ἐγὼ",6,178],["δὲ",14,12],["τὸν",1,6],["νόμον",140,7],["σου",5,146],["ἐμελέτησα",1344,147]],"Their heart has been curdled like milk; but I have meditated on thy law."],["71",[["Ἀγαθόν",113,29],["μοι",6,49],["ὅτι",19,8],["ἐταπείνωσάς",333,154],["με",6,82],["ὅπως",236,8],["ἂν",82,12],["μάθω",923,227],["τὰ",1,42],["δικαιώματά",425,43],["σου",5,146]],"[It is] good for me that thou hast afflicted me; that I might learn thine ordinances."],["72",[["Ἀγαθόν",113,29],["μοι",6,49],["ὁ",1,4],["νόμος",140,5],["τοῦ",1,23],["στόματός",123,24],["σου",5,146],["ὑπὲρ",139,1],["χιλιάδας",178,40],["χρυσίου",202,24],["καὶ",2,8],["ἀργυρίου",150,24]],"The law of thy mouth is better to me than thousands of gold and silver."],["73",[["Αἱ",1,183],["χεῖρές",37,179],["σου",5,146],["ἔποίησάν",23,141],["με",6,82],["καὶ",2,8],["ἐπλασάν",912,141],["με",6,82],["συνέτισόν",2207,198],["με",6,82],["καὶ",2,8],["μαθήσομαι",923,176],["τὰς",1,39],["ἐντολάς",259,40],["σου",5,146]],"Thy hands have made me, and fashioned me: instruct me, that I may learn thy commandments."],["74",[["Οἱ",1,128],["φοβούμενοί",134,356],["σε",5,161],["ὄψονταί",111,127],["με",6,82],["καὶ",2,8],["εὐφρανθήσονται",242,135],["ὅτι",19,8],["εἰς",8,1],["τοὺς",1,56],["λόγους",48,31],["σου",5,146],["ἐπήλπισα",3201,147]],"They that fear thee will see me and rejoice: for I have hoped in thy words."],["75",[["Ἔγνων",81,147],["Κύριε",7,251],["ὅτι",19,8],["δικαιοσύνη",185,13],["τὰ",1,42],["κρίματά",266,43],["σου",5,146],["καὶ",2,8],["ἀληθείᾳ",350,2],["ἐταπείνωσάς",333,154],["με",6,82]],"I know, O Lord, that thy judgments are righteousness, and [that] thou in truthfulness hast afflicted me."],["76",[["Γενηθήτω",30,25],["δὴ",193,12],["τὸ",1,32],["ἔλεός",182,33],["σου",5,146],["τοῦ",1,30],["παρακαλέσαι",432,100],["με",6,82],["κατὰ",32,1],["τὸ",1,32],["λόγιόν",1249,33],["σου",5,146],["τῷ",1,110],["δούλῳ",136,113],["σου",5,146]],"Let, I pray thee, thy mercy be to comfort me, according to thy word to thy servant."],["77",[["Ἐλθέτωσάν",0,0],["μοι",6,49],["οἱ",1,128],["οἰκτιρμοί",1188,51],["σου",5,146],["καὶ",2,8],["ζήσομαι",117,176],["ὅτι",19,8],["ὁ",1,4],["νόμος",140,5],["σου",5,146],["μελέτη",2284,13],["μου",6,48],["ἐστίν",10,87]],"Let thy compassions come to me, that I may live: for thy law is my meditation."],["78",[["Αἰσχυνθήτωσαν",614,50],["ὑπερήφανοι",1111,130],["ὅτι",19,8],["ἀδίκως",402,17],["ἠνόμησαν",1427,141],["εἰς",8,1],["ἐμὲ",6,82],["ἐγὼ",6,158],["δὲ",14,12],["ἀδολεσχήσω",2515,157],["ἐν",4,1],["ταῖς",1,70],["ἐντολαῖς",259,71],["σου",5,146]],"Let the proud be ashamed; for they transgressed against me unjustly: but I will meditate in thy commandments."],["79",[["Ἐπιστρεψάτωσάν",116,261],["με",6,82],["οἱ",1,128],["φοβούμενοί",134,356],["σε",5,161],["καὶ",2,8],["οἱ",1,128],["γινώσκοντες",81,137],["τὰ",1,42],["μαρτύριά",220,43],["σου",5,146]],"Let those that fear thee, and those that know thy testimonies, turn to me."],["80",[["Γενηθήτω",30,25],["ἡ",1,11],["καρδία",63,13],["μου",6,48],["ἄμωμος",633,15],["ἐν",4,1],["τοῖς",1,91],["δικαιώμασί",425,92],["σου",5,146],["ὅπως",236,8],["ἂν",82,12],["μὴ",25,8],["αἰσχυνθῶ",614,569]],"Let mine heart be blameless in thine ordinances, that I may not be ashamed."],["81",[["Ἐκλείπει",321,87],["εἰς",8,1],["τὸ",1,32],["σωτήριόν",471,33],["σου",5,146],["ἡ",1,11],["ψυχή",62,13],["μου",6,48],["εἰς",8,1],["τοὺς",1,56],["λόγους",48,31],["σου",5,146],["ἐπήλπισα",3201,147]],"My soul faints for thy salvation: I have hoped in thy words."],["82",[["Ἐξέλιπον",321,141],["οἱ",1,128],["ὀφθαλμοί",91,51],["μου",6,48],["εἰς",8,1],["τὸ",1,32],["λόγιόν",1249,33],["σου",5,146],["λέγοντες",31,137],["πότε",455,12],["παρακαλέσεις",432,159],["με",6,82]],"Mine eyes failed [in waiting] for thy word, saying, When wilt thou comfort me?"],["83",[["Ὅτι",19,8],["ἐγενήθην",30,148],["ὡς",36,8],["ἀσκὸς",2225,5],["ἐν",4,1],["πάχνῃ",3136,2],["τὰ",1,42],["δικαιώματά",425,43],["σου",5,146],["οὐκ",12,17],["ἐπελαθόμην",512,152]],"For I am become as a bottle in the frost: [yet] I have not forgotten thine ordinances."],["84",[["Πόσαι",2494,179],["εἰσὶν",10,189],["αἱ",1,183],["ἡμέραι",28,2],["τοῦ",1,30],["δούλου",136,21],["σου",5,146],["πότε",455,12],["ποιήσεις",23,159],["μοι",6,49],["ἐκ",21,1],["τῶν",1,76],["καταδιωκόντων",619,164],["με",6,98],["κρίσιν",226,10]],"How many are the days of thy servant? when wilt thou execute judgment for me on them that persecute me?"],["85",[["Διηγήσαντό",797,182],["μοι",6,49],["παράνομοι",832,130],["ἀδολεσχίας",4020,40],["ἀλλʼ",107,17],["οὐχ",12,17],["ὡς",36,8],["ὁ",1,4],["νόμος",140,5],["σου",5,146],["Κύριε",7,251]],"Transgressors told me [idle tales]; but not according to thy law, O Lord."],["86",[["Πᾶσαι",11,185],["αἱ",1,183],["ἐντολαί",259,179],["σου",5,146],["ἀλήθεια",350,13],["ἀδίκως",402,17],["κατεδίωξάν",619,141],["με",6,82],["βοήθησόν",552,243],["μοι",6,49]],"All thy commandments are truth; they persecuted me unjustly; help thou me."],["87",[["Παρὰ",72,1],["βραχὺ",616,29],["συνετέλεσάν",316,141],["με",6,82],["ἐν",4,1],["τῇ",1,95],["γῇ",26,2],["ἐγὼ",6,158],["δὲ",14,12],["οὐκ",12,17],["ἐγκατέλιπον",363,141],["τὰς",1,39],["ἐντολάς",259,40],["σου",5,146]],"They nearly made an end of me in the earth; but I forsook not thy commandments."],["88",[["Κατὰ",32,1],["τὸ",1,32],["ἔλεός",182,33],["σου",5,146],["ζῆσόν",117,474],["με",6,82],["καὶ",2,8],["φυλάξω",127,157],["τὰ",1,42],["μαρτύρια",220,43],["τοῦ",1,23],["στόματός",123,24],["σου",5,146]],"Quicken me according to thy mercy; so shall I keep the testimonies of thy mouth."],["89",[["Εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["Κύριε",7,251],["ὁ",1,4],["λόγος",48,5],["σου",5,146],["διαμένει",1886,87],["ἐν",4,1],["τῷ",1,110],["οὐρανῷ",94,113]],"Thy word, O Lord, abides in heaven for ever."],["90",[["εἰς",8,1],["γενεὰν",286,10],["καὶ",2,8],["γενεὰν",286,10],["ἡ",1,11],["ἀλήθειά",350,13],["σου",5,146],["ἐθεμελίωσας",1203,154],["τὴν",1,9],["γῆν",26,10],["καὶ",2,8],["διαμένει",1886,87]],"Thy truth [endures] to all generations; thou hast founded the earth, and it abides."],["91",[["Τῇ",1,95],["διατάξει",1887,120],["σου",5,146],["διαμένει",1886,87],["ἡμέρα",28,13],["ὅτι",19,8],["τὰ",1,42],["σύμπαντα",1355,65],["δοῦλα",136,43],["σά",401,43]],"The day continues by thy arrangement; for all things are thy servants."],["92",[["Εἰ",77,8],["μὴ",25,8],["ὅτι",19,8],["ὁ",1,4],["νόμος",140,5],["σου",5,146],["μελέτη",2284,13],["μου",6,48],["ἐστὶ",10,87],["τότε",250,17],["ἂν",82,12],["ἀπωλόμην",213,152],["ἐν",4,1],["τῇ",1,95],["ταπεινώσει",333,120],["μου",6,48]],"Were it not that thy law is my meditation, then I should have perished in mine affliction."],["93",[["Εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["οὐ",12,17],["μὴ",25,8],["ἐπιλάθωμαι",512,255],["τῶν",1,44],["δικαιωμάτων",425,45],["σου",5,146],["ὅτι",19,8],["ἐν",4,1],["αὐτοῖς",3,142],["ἔζησάς",117,154],["με",6,82]],"I will never forget thine ordinances; for with them thou hast quickened me."],["94",[["Σός",401,5],["εἰμι",10,149],["ἐγὼ",6,158],["σῶσόν",171,198],["με",6,82],["ὅτι",19,8],["τὰ",1,42],["δικαιώματά",425,43],["σου",5,146],["ἐξεζήτησα",459,147]],"I am thine, save me; for I have sought out thine ordinances."],["95",[["Ἐμὲ",6,82],["ὑπέμειναν",635,141],["ἁμαρτωλοὶ",406,130],["τοῦ",1,30],["ἀπολέσαι",594,100],["με",6,82],["τὰ",1,42],["μαρτύριά",220,43],["σου",5,146],["συνῆκα",602,147]],"Sinners laid wait for me to destroy me; [but] I understood thy testimonies."],["96",[["Πάσης",11,78],["συντελείας",808,19],["εἶδον",73,147],["πέρας",877,20],["πλατεία",925,186],["ἡ",1,11],["ἐντολή",259,13],["σου",5,146],["σφόδρα",149,17]],"I have seen an end of all perfection; [but] thy commandment is very broad."],["97",[["Ὡς",36,8],["ἠγάπησα",224,147],["τὸν",1,6],["νόμον",140,7],["σου",5,146],["Κύριε",7,251],["ὅλην",233,37],["τὴν",1,9],["ἡμέραν",28,10],["μελέτη",2284,13],["μου",6,48],["ἐστίν",10,87]],"How I have loved thy law, O Lord! it is my meditation all the day."],["98",[["Ὑπὲρ",139,1],["τοὺς",1,56],["ἐχθρούς",135,31],["μου",6,48],["ἐσόφισάς",1785,154],["με",6,98],["τὴν",1,9],["ἐντολήν",259,10],["σου",5,146],["ὅτι",19,8],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["ἐμή",523,13],["ἐστιν",10,87]],"Thou hast made me wiser than mine enemies [in] thy commandment; for it is mine for ever."],["99",[["Ὑπὲρ",139,1],["πάντας",11,58],["τοὺς",1,56],["διδάσκοντάς",543,229],["με",6,82],["συνῆκα",602,147],["ὅτι",19,8],["τὰ",1,42],["μαρτύριά",220,43],["σου",5,146],["μελέτη",2284,13],["μου",6,48],["ἐστίν",10,87]],"I have more understanding than all my teachers; for thy testimonies are my meditation."],["100",[["Ὑπὲρ",139,1],["πρεσβυτέρους",329,31],["συνῆκα",602,147],["ὅτι",19,8],["τὰς",1,39],["ἐντολάς",259,40],["σου",5,146],["ἐξεζήτησα",459,147]],"I understand more than the aged; because I have sought out thy commandments."],["101",[["Ἐκ",21,1],["πάσης",11,78],["ὁδοῦ",67,19],["πονηρᾶς",164,78],["ἐκώλυσα",1441,147],["τοὺς",1,56],["πόδας",208,31],["μου",6,48],["ὅπως",236,8],["ἂν",82,12],["φυλάξω",127,157],["τοὺς",1,56],["λόγους",48,31],["σου",5,146]],"I have kept back my feet from every evil way, that I might keep thy words."],["102",[["Ἀπὸ",17,1],["τῶν",1,44],["κριμάτων",266,45],["σου",5,146],["οὐκ",12,17],["ἐξέκλινα",393,147],["ὅτι",19,8],["σὺ",5,156],["ἐνομοθέτησάς",2755,154],["με",6,82]],"I have not declined from thy judgments; for thou hast instructed me."],["103",[["Ὡς",36,8],["γλυκέα",2079,15],["τῷ",1,110],["λάρυγγί",2097,113],["μου",6,48],["τὰ",1,42],["λόγιά",1249,43],["σου",5,146],["ὑπὲρ",139,1],["μέλι",804,20],["τῷ",1,52],["στόματί",123,53],["μου",6,48]],"How sweet are thine oracles to my throat! more so than honey to my mouth!"],["104",[["Ἀπὸ",17,1],["τῶν",1,123],["ἐντολῶν",259,61],["σου",5,146],["συνῆκα",602,147],["διὰ",54,1],["τοῦτο",16,122],["ἐμίσησα",355,147],["πᾶσαν",11,37],["ὁδὸν",67,10],["ἀδικίας",288,19]],"I gain understanding by thy commandments: therefore I have hated every way of unrighteousness."],["105",[["Λύχνος",1059,5],["τοῖς",1,138],["ποσί",208,139],["μου",6,48],["ὁ",1,4],["νόμος",140,5],["σου",5,146],["καὶ",2,8],["φῶς",376,20],["ταῖς",1,70],["τρίβοις",744,71],["μου",6,48]],"Thy law is a lamp to my feet, and a light to my paths."],["106",[["Ὤμοσα",346,147],["καὶ",2,8],["ἔστησα",78,147],["τοῦ",1,30],["φυλάξασθαι",127,103],["τὰ",1,42],["κρίματα",266,43],["τῆς",1,18],["δικαιοσύνης",185,19],["σου",5,146]],"I have sworn and determined to keep the judgments of thy righteousness."],["107",[["Ἐταπεινώθην",333,148],["ἕως",42,8],["σφόδρα",149,17],["Κύριε",7,251],["ζῆσόν",117,559],["με",6,82],["κατὰ",32,1],["τὸν",1,6],["λόγον",48,7],["σου",5,146]],"I have been very greatly afflicted, O Lord: quicken me, according to thy word."],["108",[["Τὰ",1,42],["ἑκούσια",2429,65],["τοῦ",1,23],["στόματός",123,24],["μου",6,48],["εὐλόκησον",0,0],["δὴ",193,12],["Κύριε",7,251],["καὶ",2,8],["τὰ",1,42],["κρίματά",266,43],["σου",5,146],["δίδαξόν",543,198],["με",6,82]],"Accept, I pray thee, O Lord, the freewill-offerings of my mouth, and teach me thy judgments."],["109",[["Ἡ",1,11],["ψυχή",62,13],["μου",6,48],["ἐν",4,1],["ταῖς",1,70],["χερσὶ",37,71],["σου",5,146],["διαπαντὸς",506,17],["καὶ",2,8],["τὸν",1,6],["νόμον",140,7],["σου",5,146],["οὐκ",12,17],["ἐπελαθόμην",512,152]],"My soul is continually in thine hands; and I have not forgotten thy law."],["110",[["Ἔθεντο",109,182],["ἁμαρτωλοὶ",406,130],["παγίδα",815,10],["μοι",6,49],["καὶ",2,8],["ἐκ",21,1],["τῶν",1,123],["ἐντολῶν",259,61],["σου",5,146],["οὐκ",12,17],["ἐπλανήθην",464,94]],"Sinners spread a snare for me; but I erred not from thy commandments."],["111",[["Ἐκληρονόμησα",368,147],["τὰ",1,42],["μαρτύριά",220,43],["σου",5,146],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["ὅτι",19,8],["ἀγαλλιάμα",1794,20],["τῆς",1,18],["καρδίας",63,19],["μού",6,83],["εἰσιν",10,189]],"I have inherited thy testimonies for ever; for they are the joy of my heart."],["112",[["Ἔκλινα",829,147],["τὴν",1,9],["καρδίαν",63,10],["μου",6,48],["τοῦ",1,30],["ποιῆσαι",23,100],["τὰ",1,42],["δικαιώματά",425,43],["σου",5,146],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["διʼ",54,1],["ἀντάμειψιν",9003,10]],"I have inclined my heart to perform thine ordinances for ever, in return [for thy mercies]."],["113",[["Παρανόμους",832,58],["ἐμίσησα",355,147],["τὸν",1,6],["δὲ",14,12],["νόμον",140,7],["σου",5,146],["ἠγάπησα",224,147]],"I have hated transgressors; but I have loved thy law."],["114",[["Βοηθός",948,5],["μου",6,48],["καὶ",2,8],["ἀντιλήπτωρ",2221,5],["μου",6,48],["εἶ",10,145],["σὺ",5,156],["εἰς",8,1],["τοὺς",1,56],["λόγους",48,31],["σου",5,146],["ἐπήλπισα",3201,147]],"Thou art my helper and my supporter; I have hoped in thy words."],["115",[["Ἐκκλίνατε",393,69],["ἀπʼ",17,1],["ἐμοῦ",6,48],["οἱ",1,128],["πονηρευόμενοι",1387,356],["καὶ",2,8],["ἐξεραυνήσω",6507,157],["τὰς",1,39],["ἐντολὰς",259,40],["τοῦ",1,30],["Θεοῦ",20,21],["μου",6,48]],"Depart from me, ye evil-doers; for I will search out the commandments of my God."],["116",[["Ἀντιλαβοῦ",984,275],["μου",6,48],["κατὰ",32,1],["τὸ",1,32],["λόγιόν",1249,33],["σου",5,146],["καὶ",2,8],["ζῆσόν",117,171],["με",6,82],["καὶ",2,8],["μὴ",25,8],["καταισχύνῃς",716,199],["με",6,82],["ἀπὸ",17,1],["τῆς",1,18],["προσδοκίας",3126,19],["μου",6,83]],"Uphold me according to thy word, and quicken me; and make me not ashamed of my expectation."],["117",[["Βοήθησόν",552,243],["μοι",6,49],["καὶ",2,8],["σωθήσομαι",171,175],["καὶ",2,8],["μελετήσω",1344,157],["ἐν",4,1],["τοῖς",1,91],["δικαιώμασί",425,92],["σου",5,146],["διαπαντός",506,17]],"Help me, and I shall be saved; and I will meditate in thine ordinances continually."],["118",[["Ἐξουδέ