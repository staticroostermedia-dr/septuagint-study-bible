[["1",[["Ἀλληλούϊα",1746,105],["Ἀγγαίου",1994,153],["καὶ",2,8],["Ζαχαρίου",894,21],["Ἐπαίνει",1532,239],["Ἱερουσαλήμ",69,20],["τὸν",1,6],["Κύριον",7,7],["αἴνει",399,239],["τὸν",1,6],["Θεόν",20,7],["σου",5,146],["Σιών",331,2]],"Alleluia, [a Psalm] of Aggæus and Zacharias. Praise the Lord, O Jerusalem; praise thy God, O Sion."],["2",[["Ὅτι",19,8],["ἐνίσχυσεν",988,3],["τοὺς",1,56],["μοχλοὺς",1168,31],["τῶν",1,123],["πυλῶν",162,61],["σου",5,146],["εὐλόγησεν",147,3],["τοὺς",1,56],["υἱούς",13,31],["σου",5,146],["ἐν",4,1],["σοί",5,151]],"For he has strengthened the bars of thy gates; he has blessed thy children within thee."],["3",[["Ὁ",1,4],["τιθεὶς",109,67],["τὰ",1,42],["ὅριά",234,43],["σου",5,146],["εἰρήνην",210,10],["καὶ",2,8],["στέαρ",574,20],["πυροῦ",939,250],["ἐμπιπλῶν",424,36],["σε",5,161]],"He makes thy borders peaceful, and fills thee with the flour of wheat."],["4",[["Ὁ",1,4],["ἀποστέλλων",83,67],["τὸ",1,32],["λόγιον",1249,33],["αὐτοῦ",3,48],["τῇ",1,95],["γῇ",26,2],["ἕως",42,8],["τάχους",1566,24],["δραμεῖται",818,89],["ὁ",1,4],["λόγος",48,5],["αὐτοῦ",3,48]],"He sends his oracle to the earth: his word will run swiftly."],["5",[["Τοῦ",1,30],["διδόντος",33,143],["χιόνα",1646,10],["ὡσεὶ",342,17],["ἔριον",2686,20],["ὁμίχλην",2860,10],["ὡσεὶ",342,17],["σποδὸν",1228,10],["πάσσοντος",2045,143]],"He gives snow like wool: he scatters the mist like ashes."],["6",[["Βάλλοντος",774,143],["κρύσταλλον",2921,7],["αὐτοῦ",3,48],["ὠσεὶ",3235,120],["ψωμούς",2514,31],["κατὰ",32,1],["πρόσωπον",47,33],["ψύχους",3395,24],["αὐτοῦ",3,144],["τίς",39,150],["ὑποστήσεται",1537,89]],"Casting [forth] his ice like morsels: who shall stand before his cold?"],["7",[["Ἀποστελεῖ",83,120],["τὸν",1,6],["λόγον",48,7],["αὐτοῦ",3,48],["καὶ",2,8],["τήξει",1019,120],["αὐτά",3,66],["πνεύσει",3631,116],["τὸ",1,32],["πνεῦμα",167,33],["αὐτοῦ",3,48],["καὶ",2,8],["ῥυήσεται",663,125],["ὕδατα",85,43]],"He shall send out his word, and melt them: he shall blow [with] his wind, and the waters shall flow."],["8",[["Ἀπαγγέλλων",272,67],["τὸν",1,6],["λόγον",48,7],["αὐτοῦ",3,48],["τῷ",1,110],["Ἰακώβ",146,105],["δικαιώματα",425,43],["καὶ",2,8],["κρίματα",266,43],["αὐτοῦ",3,48],["τῷ",1,110],["Ἰσραήλ",27,105]],"He sends his word to Jacob, his ordinances and judgments to Israel."],["9",[["Οὐκ",12,17],["ἐποίησεν",23,3],["οὕτως",70,17],["παντὶ",11,34],["ἔθνει",59,53],["καὶ",2,8],["τὰ",1,42],["κρίματα",266,43],["αὐτοῦ",3,48],["οὐκ",12,17],["ἐδήλωσεν",1719,3],["αὐτοῖς",3,142]],"He has not done so to any [other] nation; and he has not shewn them his judgments."]]