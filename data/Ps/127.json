[["1",[["Ὠδὴ",773,105],["τῶν",1,76],["ἀναβαθμῶν",1486,77],["Μακάριοι",803,130],["πάντες",11,130],["οἱ",1,128],["φοβούμενοι",134,356],["τὸν",1,6],["Κύριον",7,7],["οἱ",1,128],["πορευόμενοι",49,356],["ἐν",4,1],["ταῖς",1,70],["ὁδοῖς",67,71],["αὐτοῦ",3,48]],"A Song of Degrees. Blessed are all they that fear the Lord; who walk in his ways."],["2",[["Τοὺς",1,56],["πόνους",564,31],["τῶν",1,76],["καρπῶν",446,77],["σου",5,146],["φάγεσαι",153,116],["μακάριος",803,16],["εἶ",10,145],["καὶ",2,8],["καλῶς",1271,17],["σοι",5,151],["ἔσται",10,89]],"Thou shalt eat the labours of thy hands: blessed art thou, and it shall be well with thee."],["3",[["Ἡ",1,11],["γυνή",58,13],["σου",5,146],["ὡς",36,8],["ἄμπελος",810,13],["εὐθηνοῦσα",2458,181],["ἐν",4,1],["ταῖς",1,70],["κλίτεσι",1038,92],["τῆς",1,18],["οἰκίας",232,19],["σου",5,146],["οἱ",1,128],["υἱοί",13,51],["σου",5,146],["ὡς",36,8],["νεόφυτα",4336,74],["ἐλαιῶν",2061,61],["κύκλῳ",258,17],["τῆς",1,18],["τραπέζης",644,19],["σου",5,146]],"Thy wife shall be as a fruitful vine on the sides of thy house: thy children as young olive-plants round about thy table."],["4",[["Ἰδοὺ",51,17],["οὕτως",70,17],["εὐλογηθήσεται",147,125],["ἄνθρωπος",43,5],["ὁ",1,4],["φοβούμενος",134,114],["τὸν",1,6],["Κύριον",7,7]],"Behold, thus shall the man be blessed that fears the Lord."],["5",[["Εὐλογήσαι",147,276],["σε",5,161],["Κύριος",7,5],["ἐκ",21,1],["Σιὼν",331,2],["καὶ",2,8],["ἴδοις",276,433],["τὰ",1,42],["ἀγαθὰ",113,65],["Ἱερουσαλὴμ",69,20],["πάσας",11,109],["τὰς",1,39],["ἡμέρας",28,19],["τῆς",1,18],["ζωῆς",212,19],["σου",5,146]],"May the Lord bless thee out of Sion; and mayest thou see the prosperity of Jerusalem all the days of thy life."],["6",[["Καὶ",2,8],["ἴδοις",276,433],["υἱοὺς",13,31],["τῶν",1,76],["υἱῶν",13,77],["σου",5,146],["εἰρήνη",210,13],["ἐπὶ",9,1],["τὸν",1,6],["Ἰσραήλ",27,105]],"And mayest thou see thy children's children. Peace be upon Israel."]]