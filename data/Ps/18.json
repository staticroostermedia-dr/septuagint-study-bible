[["1",[["Εἰς",8,1],["τὸ",1,32],["τέλος",369,33],["ψαλμὸς",639,5],["τῷ",1,110],["Δαυίδ",52,105]],"For the end, a Psalm of David."],["2",[["Οἱ",1,128],["οὐρανοὶ",94,51],["διηγοῦνται",797,502],["δόξαν",141,10],["Θεοῦ",20,21],["ποίησιν",2767,10],["δὲ",14,12],["χειρῶν",37,61],["αὐτοῦ",3,48],["ἀναγγέλλει",228,87],["τὸ",1,32],["στερέωμα",1482,33]],"The heavens declare the glory of God; and the firmament proclaims the work of his hands."],["3",[["Ἡμέρα",28,13],["τῇ",1,95],["ἡμέρᾳ",28,2],["ἐρεύγεται",3761,108],["ῥῆμα",115,33],["καὶ",2,8],["νὺξ",216,13],["νυκτὶ",216,2],["ἀναγγέλλει",228,87],["γνῶσιν",753,10]],"Day to day utters speech, and night to night proclaims knowledge."],["4",[["Οὐκ",12,17],["εἰσὶ",10,189],["λαλιαὶ",1826,179],["οὐδὲ",105,12],["λόγοι",48,51],["ὧν",24,97],["οὐχὶ",326,12],["ἀκούονται",53,303],["αἱ",1,183],["φωναὶ",95,179],["αὐτῶν",3,41]],"There are no speeches or words, in which their voices are not heard."],["5",[["Εἰς",8,1],["πᾶσαν",11,37],["τὴν",1,9],["γῆν",26,10],["ἐξῆλθεν",84,3],["ὁ",1,4],["φθόγγος",6204,5],["αὐτῶν",3,41],["καὶ",2,8],["εἰς",8,1],["τὰ",1,42],["πέρατα",877,43],["τῆς",1,18],["οἰκουμένης",1326,19],["τὰ",1,42],["ῥήματα",115,43],["αὐτῶν",3,41]],"Their voice is gone out into all the earth, and their words to the ends of the world."],["6",[["ἐν",4,1],["τῷ",1,110],["ἡλίῳ",320,113],["ἔθετο",109,26],["τὸ",1,32],["σκήνωμα",680,33],["αὐτοῦ",3,48],["καὶ",2,8],["αὐτὸς",3,158],["ὡς",36,8],["νυμφίος",2288,5],["ἐκπορευόμενος",373,114],["ἐκ",21,1],["παστοῦ",3928,21],["αὐτοῦ",3,48],["ἀγαλλιάσεται",737,89],["ὡς",36,8],["γίγας",1160,5],["δραμεῖν",818,100],["ὁδὸν",67,10],["αὐτοῦ",3,48]],"In the sun he has set his tabernacle; and he comes forth as a bridegroom out of his chamber: he will exult as a giant to run his course."],["7",[["Ἀπʼ",17,1],["ἄκρου",723,24],["τοῦ",1,30],["οὐρανοῦ",94,21],["ἡ",1,11],["ἔξοδος",758,13],["αὐτοῦ",3,48],["καὶ",2,8],["τὸ",1,32],["κατάντημα",7494,33],["αὐτοῦ",3,144],["ἕως",42,8],["ἄκρου",723,24],["τοῦ",1,30],["οὐρανοῦ",94,21],["καὶ",2,8],["οὐκ",12,17],["ἔστιν",10,87],["ὃς",24,247],["ἀποκρυβήσεται",1396,125],["τὴν",1,9],["θέρμην",4699,10],["αὐτοῦ",3,48]],"His going forth is from the extremity of heaven, and his circuit to the [other] end of heaven: and no one shall be hidden from his heat."],["8",[["Ὁ",1,4],["νόμος",140,5],["τοῦ",1,30],["Κυρίου",7,21],["ἄμωμος",633,16],["ἐπιστρέφων",116,67],["ψυχὰς",62,40],["ἡ",1,11],["μαρτυρία",2744,13],["Κυρίου",7,21],["πιστὴ",748,15],["σοφίζουσα",1785,181],["νήπια",1015,74]],"The law of the Lord is perfect, converting souls: the testimony of the Lord is faithful, instructing babes."],["9",[["Τὰ",1,42],["δικαιώματα",425,43],["Κυρίου",7,21],["εὐθέα",826,65],["εὐφραίνοντα",242,232],["καρδίαν",63,10],["ἡ",1,11],["ἐντολὴ",259,13],["Κυρίου",7,21],["τηλαυγὴς",3663,15],["φωτίζουσα",1232,181],["ὀφθαλμούς",91,31]],"The ordinances of the Lord are right, rejoicing the heart: the commandment of the Lord is bright, enlightening the eyes."],["10",[["Ὁ",1,4],["φόβος",330,5],["Κυρίου",7,21],["ἁγνὸς",2826,16],["διαμένων",1886,67],["εἰς",8,1],["αἰῶνα",100,7],["αἰῶνος",100,21],["τὰ",1,42],["κρίματα",266,43],["Κυρίου",7,21],["ἀληθινὰ",1020,65],["δεδικαιωμένα",0,0],["ἐπὶ",9,1],["τὸ",1,32],["αὐτό",3,121]],"The fear of the Lord is pure, enduring for ever and ever: the judgments of the Lord are true, [and] justified altogether."],["11",[["Ἐπιθυμητὰ",1938,74],["ὑπὲρ",139,1],["χρυσίον",202,20],["καὶ",2,8],["λίθον",195,7],["τίμιον",1190,59],["πολὺν",74,59],["καὶ",2,8],["γλυκύτερα",2079,74],["ὑπὲρ",139,1],["μέλι",804,20],["καὶ",2,8],["κηρίον",2917,20]],"To be desired more than gold, and much precious stone: sweeter also than honey and the honey-comb."],["12",[["Καὶ",2,8],["γὰρ",40,12],["ὁ",1,4],["δοῦλός",136,5],["σου",5,146],["φυλάσσει",127,87],["αὐτὰ",3,66],["ἐν",4,1],["τῷ",1,110],["φυλάσσειν",127,54],["αὐτὰ",3,66],["ἀνταπόδοσις",2412,13],["πολλή",74,15]],"For thy servant keeps to them: in the keeping of them [there is] great reward."],["13",[["Παραπτώματα",1909,43],["τίς",39,150],["συνήσει",602,120],["ἐκ",21,1],["τῶν",1,76],["κρυφίων",2740,163],["μου",6,48],["καθάρισόν",488,198],["με",6,82]],"Who will understand [his] transgressions? purge thou me from my secret [sins]."],["14",[["καὶ",2,8],["ἀπὸ",17,1],["ἀλλοτρίων",377,163],["φεῖσαι",607,275],["τοῦ",1,30],["δούλου",136,21],["σου",5,146],["ἐὰν",45,8],["μή",25,8],["μου",6,48],["κατακυριεύσωσι",2091,224],["τότε",250,17],["ἄμωμος",633,16],["ἔσομαι",10,176],["καὶ",2,8],["καθαρισθήσομαι",488,175],["ἀπὸ",17,1],["ἁμαρτίας",119,19],["μεγάλης",65,78]],"And spare thy servant [the attack] of strangers: if they do not gain the dominion over me, then shall I be blameless, and I shall be clear from great sin."],["15",[["Καὶ",2,8],["ἔσονται",10,127],["εἰς",8,1],["εὐδοκίαν",1624,10],["τὸ",1,32],["λόγια",1249,43],["τοῦ",1,23],["στόματός",123,24],["μου",6,48],["καὶ",2,8],["ἡ",1,11],["μελέτη",2284,13],["τῆς",1,18],["καρδίας",63,19],["μου",6,83],["ἐνώπιόν",114,1],["σου",5,146],["διαπαντός",506,17],["Κύριε",7,251],["βοηθέ",948,251],["μου",6,48],["καὶ",2,8],["λυτρωτά",4310,463],["μου",6,48]],"So shall the sayings of my mouth, and the meditation of my heart, be pleasing continually before thee, O Lord my helper, and my redeemer."]]