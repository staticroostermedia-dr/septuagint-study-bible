[["1",[["Εἰς",8,1],["τὸ",1,32],["τέλος",369,33],["ὑπὲρ",139,1],["τῆς",1,18],["κληρονομούσης",368,212],["ψαλμὸς",639,5],["τῷ",1,110],["Δαυίδ",52,105]],"For the end, a Psalm of David, concerning her that inherits."],["2",[["Τὰ",1,42],["ῥήματά",115,43],["μου",6,48],["ἐνώτισαι",1316,296],["Κύριε",7,251],["σύνες",602,198],["τῆς",1,18],["κραυγῆς",830,19],["μου",6,83]],"Hearken to my words, O Lord, attend to my cry."],["3",[["πρόσχες",1692,154],["τῇ",1,95],["φωνῇ",95,2],["τῆς",1,18],["δεήσεώς",674,19],["μου",6,83],["ὁ",1,4],["βασιλεύς",22,5],["μου",6,48],["καὶ",2,8],["ὁ",1,4],["Θεός",20,5],["μου",6,48],["ὅτι",19,8],["πρὸς",15,1],["σὲ",5,161],["προσεύξομαι",550,176],["Κύριε",7,251]],"Attend to the voice of my supplication, my King, and my God: for to thee, O Lord, will I pray."],["4",[["τοπρωῒ",0,0],["εἰσακούσῃ",237,116],["τῆς",1,18],["φωνῆς",95,19],["μου",6,83],["τοπρωῒ",0,0],["παραστήσομαί",592,176],["σοι",5,151],["καὶ",2,8],["ἐπόψομαι",3759,176]],"In the morning thou shalt hear my voice: in the morning will I wait upon thee, and will look up."],["5",[["Ὅτι",19,8],["οὐχὶ",326,12],["Θεὸς",20,5],["θέλων",609,67],["ἀνομίαν",274,10],["σὺ",5,156],["εἶ",10,145],["οὐδὲ",105,12],["παροικησει",781,120],["σοι",5,151],["πονηρευόμενος",1387,114]],"For thou art not a God that desires iniquity; neither shall the worker of wickedness dwell with thee."],["6",[["οὐδὲ",105,12],["διαμενοῦσι",1886,207],["παράνομοι",832,130],["κατέναντι",689,17],["τῶν",1,76],["ὀφθαλμῶν",91,77],["σου",5,146],["ἐμίσησας",355,154],["Κύριε",7,251],["πάντας",11,58],["τοὺς",1,56],["ἐργαζομένους",468,230],["τὴν",1,9],["ἀνομίαν",274,10]],"Neither shall the transgressors continue in thy sight: thou hatest, O Lord, all them that work iniquity."],["7",[["ἀπολεῖς",213,159],["πάντας",11,58],["τοὺς",1,56],["λαλοῦντας",50,229],["τὸ",1,32],["ψεῦδος",1193,33],["ἄνδρα",38,7],["αἱμάτων",148,45],["καὶ",2,8],["δόλιον",1543,28],["βδελύσσεται",1202,108],["Κύριος",7,5]],"Thou wilt destroy all that speak falsehood: the Lord abhors the bloody and deceitful man."],["8",[["Ἐγὼ",6,158],["δὲ",14,12],["ἐν",4,1],["τῷ",1,52],["πλήθει",199,53],["τοῦ",1,30],["ἐλέου",182,21],["σου",5,146],["εἰσελεύσομαι",88,176],["εἰς",8,1],["τὸν",1,6],["οἶκόν",34,7],["σου",5,146],["προσκυνήσω",296,227],["πρὸς",15,1],["ναὸν",481,7],["ἅγιόν",75,59],["σου",5,146],["ἐν",4,1],["φόβῳ",330,113],["σου",5,146]],"But I will enter into thine house in the multitude of thy mercy: I will worship in thy fear toward thy holy temple."],["9",[["Κύριε",7,251],["ὁδήγησόν",1110,243],["με",6,82],["ἐν",4,1],["τῇ",1,95],["δικαιοσύνῃ",185,2],["σου",5,146],["ἕνεκα",445,1],["τῶν",1,76],["ἐχθρῶν",135,77],["μου",6,48],["κατεύθυνον",828,198],["ἐνώπιόν",114,1],["σου",5,146],["τὴν",1,9],["ὁδόν",67,10],["μου",6,48]],"Lead me, O Lord, in thy righteousness because of mine enemies; make my way plain before thy face."],["10",[["Ὅτι",19,8],["οὐκ",12,17],["ἔστιν",10,87],["ἐν",4,1],["τῷ",1,52],["στόματι",123,53],["αὐτῶν",3,41],["ἀλήθεια",350,13],["ἡ",1,11],["καρδία",63,13],["αὐτῶν",3,41],["ματαία",648,15],["τάφος",865,5],["ἀνεῳγμένος",820,480],["ὁ",1,4],["λάρυγξ",2097,5],["αὐτῶν",3,41],["ταῖς",1,70],["γλώσσαις",385,71],["αὐτῶν",3,41],["ἐδολιοῦσαν",0,0]],"For there is no truth in their mouth; their heart is vain; their throat is an open sepulchre; with their tongues they have used deceit."],["11",[["Κρίνον",240,36],["αὐτοὺς",3,60],["ὁ",1,4],["Θεός",20,5],["ἀποπεσάτωσαν",0,0],["ἀπὸ",17,1],["τῶν",1,123],["διαβουλιῶν",7004,61],["αὐτῶν",3,187],["κατὰ",32,1],["τὸ",1,32],["πλῆθος",199,33],["τῶν",1,123],["ἀσεβειῶν",722,61],["αὐτῶν",3,187],["ἔξωσον",1576,198],["αὐτοὺς",3,60],["ὅτι",19,8],["παρεπίκρανάν",2037,141],["σε",5,161],["Κύριε",7,251]],"Judge them, O God; let them fail of their counsels: cast them out according to the abundance of their ungodliness; for they have provoked thee, O Lord."],["12",[["Καὶ",2,8],["εὐφρανθήτωσαν",242,50],["ἐπὶ",9,1],["σοὶ",5,151],["πάντες",11,130],["οἱ",1,128],["ἐλπίζοντες",511,137],["ἐπὶ",9,1],["σὲ",5,161],["εἰς",8,1],["αἰῶνα",100,7],