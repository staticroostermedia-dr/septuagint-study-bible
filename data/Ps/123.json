[["1",[["Ὠδὴ",776,105],["τῶν",1,76],["ἀναβαθμῶν",1484,77],["Εἰ",77,8],["μὴ",25,8],["ὅτι",19,8],["Κύριος",7,5],["ἦν",10,14],["ἐν",4,1],["ἡμῖν",6,142],["εἰπάτω",18,46],["δὴ",193,12],["Ἰσραὴλ",27,105]],"A Song of Degrees. If it had not been that the Lord was among us, let Israel now say;"],["2",[["εἰ",77,8],["μὴ",25,8],["ὅτι",19,8],["Κύριος",7,5],["ἦν",10,14],["ἐν",4,1],["ἡμῖν",6,142],["ἐν",4,1],["τῷ",1,110],["ἐπαναστῆναι",1216,100],["ἀνθρώπους",43,31],["ἐφʼ",9,1],["ἡμᾶς",6,60]],"if it had not been that the Lord was among us, when men rose up against us;"],["3",[["ἄρα",985,12],["ζῶντας",107,229],["ἂν",83,12],["κατέπιον",1183,141],["ἡμᾶς",6,60],["ἐν",4,1],["τῷ",1,110],["ὀργισθῆναι",725,175],["τὸν",1,6],["θυμὸν",178,7],["αὐτῶν",3,41],["ἐφʼ",9,1],["ἡμᾶς",6,60]],"verily they would have swallowed us up alive, when their wrath was kindled against us:"],["4",[["ἄρα",985,12],["τὸ",1,32],["ὕδωρ",85,33],["ἂν",83,12],["κατεπόντισεν",2726,3],["ἡμᾶς",6,60],["χείμαῤῥον",737,7],["διῆλθεν",423,3],["ἡ",1,11],["ψυχὴ",63,13],["ἡμῶν",6,41]],"verily the water would have drowned us, our soul would have gone under the torrent."],["5",[["Ἄρα",985,12],["διῆλθεν",423,3],["ἡ",1,11],["ψυχὴ",63,13],["ἡμῶν",6,41],["τὸ",1,32],["ὕδωρ",85,33],["τὸ",1,32],["ἀνυπόστατον",4510,29]],"Yea, our soul would have gone under the overwhelming water."],["6",[["Εὐλογητὸς",767,16],["Κύριος",7,5],["ὃς",24,246],["οὐκ",12,17],["ἔδωκεν",33,3],["ἡμᾶς",6,60],["εἰς",8,1],["θήραν",1510,10],["τοῖς",1,138],["ὀδοῦσιν",930,139],["αὐτῶν",3,41]],"Blessed be the Lord, who has not given us for a prey to their teeth."],["7",[["Ἡ",1,11],["ψυχὴ",63,13],["ἡμῶν",6,41],["ὡς",36,8],["στρουθίον",2492,20],["ἐῤῥύσθη",337,38],["ἐκ",21,1],["τῆς",1,18],["παγίδος",817,19],["τῶν",1,76],["θηρευόντων",1887,164],["ἡ",1,11],["παγὶς",817,13],["συνετρίβη",268,38],["καὶ",2,8],["ἡμεῖς",6,195],["ἐῤῥύσθημεν",337,491]],"Our soul has been delivered as a sparrow from the snare of the fowlers: the snare is broken, and we are delivered."],["8",[["Ἡ",1,11],["βοήθεια",765,13],["ἡμῶν",6,41],["ἐν",4,1],["ὀνόματι",57,53],["Κυρίου",7,21],["τοῦ",1,30],["ποιήσαντος",23,513],["τὸν",1,6],["οὐρανὸν",94,7],["καὶ",2,8],["τὴν",1,9],["γῆν",26,10]],"Our help is in the name of the Lord, who made heaven and earth."]]