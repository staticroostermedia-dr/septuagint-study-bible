[["1",[["Εἰς",8,1],["τὸ",1,32],["τέλος",369,33],["τοῖς",1,138],["υἱοῖς",13,139],["Κορὲ",875,251],["ψαλμός",639,5]],"For the end, a Psalm for the sons of Core."],["2",[["Ἀκούσατε",53,69],["ταῦτα",16,249],["πάντα",11,65],["τὰ",1,42],["ἔθνη",59,43],["ἐνωτίσασθε",1316,180],["πάντες",11,130],["οἱ",1,128],["κατοικοῦντες",90,137],["τὴν",1,9],["οἰκουμένην",1326,10]],"Hear these words, all ye nations, hearken, all ye that dwell upon the earth:"],["3",[["οἵ",1,128],["τε",207,12],["γηγενεῖς",3812,130],["καὶ",2,8],["οἱ",1,128],["υἱοὶ",13,51],["τῶν",1,76],["ἀνθρώπων",43,77],["ἐπιτοαυτὸ",1405,105],["πλούσιος",954,16],["καὶ",2,8],["πένης",668,5]],"both the sons of mean men, and sons of [great] men; the rich and poor [man] together."],["4",[["Τὸ",1,32],["στόμα",123,33],["μου",6,48],["λαλήσει",50,120],["σοφίαν",238,10],["καὶ",2,8],["ἡ",1,11],["μελέτη",2284,13],["τῆς",1,18],["καρδίας",63,19],["μου",6,83],["σύνεσιν",467,10]],"My mouth shall speak of wisdom; and the meditation of my heart shall bring [forth] understanding."],["5",[["Κλινῶ",829,157],["εἰς",8,1],["παραβολὴν",1061,10],["τὸ",1,32],["οὖς",325,33],["μου",6,48],["ἀνοίξω",820,157],["ἐν",4,1],["ψαλτηρίῳ",1698,53],["τὸ",1,32],["πρόβλημά",2625,33],["μου",6,48]],"I will incline mine ear to a parable: I will open my riddle on the harp."],["6",[["Ἱνατί",101,238],["φοβοῦμαι",134,252],["ἐν",4,1],["ἡμέρᾳ",28,2],["πονηρᾷ",164,96],["ἡ",1,11],["ἀνομία",274,13],["τῆς",1,18],["πτέρνης",2628,19],["μου",6,83],["κυκλώσει",600,120],["με",6,82]],"Wherefore should I fear in the evil day? the iniquity of my heel shall compass me."],["7",[["Οἱ",1,128],["πεποιθότες",343,264],["ἐπὶ",9,1],["τῇ",1,95],["δυνάμει",98,2],["αὐτῶν",3,41],["καὶ",2,8],["ἐπὶ",9,1],["τῷ",1,52],["πλήθει",199,53],["τοῦ",1,30],["πλούτου",572,21],["αὐτῶν",3,41],["καυχώμενοι",1379,356]],"They that trust in their strength, and boast themselves in the multitude of their wealth—"],["8",[["Ἀδελφὸς",66,5],["οὐ",12,17],["λυτροῦται",548,108],["λυτρώσεται",548,89],["ἄνθρωπος",43,5],["οὐ",12,17],["δώσει",33,120],["τῷ",1,110],["Θεῷ",20,113],["ἐξίλασμα",6520,20],["ἑαυτοῦ",92,48]],"A brother does not redeem, shall a man redeem? he shall not give to God a ransom for himself,"],["9",[["καὶ",2,8],["τὴν",1,9],["τιμὴν",721,10],["τῆς",1,18],["λυτρώσεως",2602,19],["τῆς",1,18],["ψυχῆς",62,19],["αὐτοῦ",3,48],["καὶ",2,8],["ἐκοπίασεν",935,3],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7]],"or the price of the redemption of his soul, though he labour for ever,"],["10",[["καὶ",2,8],["ζήσεται",117,89],["εἰς",8,1],["τέλος",369,33],["ὅτι",19,8],["οὐκ",12,17],["ὄψεται",111,89],["καταφθορὰν",3561,10]],"and live to the end, [so] that he should not see corruption."],["11",[["Ὅταν",318,8],["ἴδῃ",73,160],["σοφοὺς",322,58],["ἀποθνήσκοντας",108,229],["ἐπιτοαυτὸ",1405,105],["ἄφρων",438,16],["καὶ",2,8],["ἄνους",3729,5],["ἀπολοῦνται",213,127],["καὶ",2,8],["καταλείψουσιν",255,355],["ἀλλοτρίοις",377,215],["τὸν",1,6],["πλοῦτον",572,7],["αὐτῶν",3,41]],"When he shall see wise men dying, the fool and the senseless one shall perish together; and they shall leave their wealth to strangers."],["12",[["Καὶ",2,8],["οἱ",1,128],["τάφοι",865,51],["αὐτῶν",3,41],["οἰκίαι",232,179],["αὐτῶν",3,41],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["σκηνώματα",680,63],["αὐτῶν",3,41],["εἰς",8,1],["γενεὰν",286,10],["καὶ",2,8],["γενεὰν",286,10],["ἐπεκαλέσαντο",340,182],["τὰ",1,42],["ὀνόματα",55,43],["αὐτῶν",3,41],["ἐπὶ",9,1],["τῶν",1,123],["γαιῶν",859,61],["αὐτῶν",3,187]],"And their sepulchres are their houses for ever, [even] their tabernacles to all generations: they have called their lands after their own names."],["13",[["Καὶ",2,8],["ἄνθρωπος",43,5],["ἐν",4,1],["τιμῇ",721,2],["ὢν",10,67],["οὐ",12,17],["συνῆκε",602,3],["παρασυνεβλήθη",5933,38],["τοῖς",1,91],["κτήνεσι",219,92],["τοῖς",1,91],["ἀνοήτοις",2821,90],["καὶ",2,8],["ὡμοιώθη",1197,38],["αὐτοῖς",3,142]],"And man being in honour, understands not: he is compared to the senseless cattle, and is like to them."],["14",[["Αὕτη",16,101],["ἡ",1,11],["ὁδὸς",67,13],["αὐτῶν",3,41],["σκάνδαλον",1838,20],["αὐτοῖς",3,142],["καὶ",2,8],["μετὰ",29,1],["ταῦτα",16,249],["ἐν",4,1],["τῷ",1,52],["στόματι",123,53],["αὐτῶν",3,41],["εὐλογήσουσι",147,207],["διάψαλμα",687,20]],"This their way is an offence to them: yet afterwards men will commend their sayings. Pause."],["15",[["Ὡς",36,8],["πρόβατα",194,43],["ἐν",4,1],["ᾅδῃ",583,113],["ἔθεντο",109,182],["θάνατος",169,5],["ποιμανεῖ",955,120],["αὐτούς",3,60],["καὶ",2,8],["κατακυριεύσουσιν",2091,207],["αὐτῶν",3,41],["οἱ",1,128],["εὐθεῖς",826,130],["τοπρωῒ",0,0],["καὶ",2,8],["ἡ",1,11],["βοήθεια",761,13],["αὐτῶν",3,41],["παλαιωθήσεται",1520,125],["ἐν",4,1],["τῷ",1,110],["ᾅδῃ",583,113],["ἐκ",21,1],["τῆς",1,18],["δόξης",141,19],["αὐτῶν",3,41]],"They have laid [them] as sheep in Hades; death shall feed on them; and the upright shall have dominion over them in the morning, and their help shall fail in Hades from their glory."],["16",[["Πλὴν",257,1],["ὁ",1,4],["Θεὸς",20,5],["λυτρώσεται",548,89],["τὴν",1,9],["ψυχήν",62,10],["μου",6,83],["ἐκ",21,1],["χειρὸς",37,19],["ᾅδου",583,21],["ὅταν",318,8],["λαμβάνῃ",46,172],["με",6,82],["διάψαλμα",687,20]],"But God shall deliver my soul from the power of Hades, when he shall receive me. Pause."],["17",[["Μὴ",25,8],["φοβοῦ",134,250],["ὅταν",318,8],["πλουτήσῃ",2486,116],["ἄνθρωπος",43,5],["καὶ",2,8],["ὅταν",318,8],["πληθυνθῇ",315,337],["ἡ",1,11],["δόξα",141,186],["τοῦ",1,30],["οἴκου",34,21],["αὐτοῦ",3,48]],"Fear not when a man is enriched, and when the glory of his house is increased."],["18",[["Ὅτι",19,8],["οὐκ",12,17],["ἐν",4,1],["τῷ",1,110],["ἀποθνήσκειν",108,54],["αὐτὸν",3,82],["λήψεται",46,89],["τὰ",1,42],["πάντα",11,65],["οὐδὲ",105,12],["συγκαταβήσεται",5081,89],["αὐτῷ",3,49],["ἡ",1,11],["δόξα",141,186],["αὐτοῦ",3,48]],"For he shall take nothing when he dies; neither shall his glory descend with him."],["19",[["Ὅτι",19,8],["ἡ",1,11],["ψυχὴ",62,13],["αὐτοῦ",3,48],["ἐν",4,1],["τῇ",1,95],["ζωῇ",212,2],["αὐτοῦ",3,48],["εὐλογηθήσεται",147,125],["ἐξομολογήσεταί",478,89],["σοι",5,151],["ὅταν",318,8],["ἀγαθύνῃς",1699,199],["αὐτῷ",3,49]],"For his soul shall be blessed in his life: he shall give thanks to thee when thou dost well to him."],["20",[["Εἰσελεύσεται",88,89],["ἕως",42,8],["γενεᾶς",286,19],["πατέρων",44,77],["αὐτοῦ",3,48],["ἕως",42,8],["αἰῶνος",100,21],["οὐκ",12,17],["ὄψεται",111,89],["φῶς",376,20]],"[Yet] he shall go in to the generation of his fathers; he shall never see light."],["21",[["Ἄνθρωπος",43,5],["ἐν",4,1],["τιμῇ",721,2],["ὢν",10,67],["οὐ",12,17],["συνῆκε",602,3],["παρασυνεβλήθη",5933,38],["τοῖς",1,91],["κτήνεσι",219,92],["τοῖς",1,91],["ἀνοήτοις",2821,90],["καὶ",2,8],["ὡμοιώθη",1197,38],["αὐτοῖς",3,142]],"Man that is in honour, understands not: he is compared to the senseless cattle, and is like them."]]