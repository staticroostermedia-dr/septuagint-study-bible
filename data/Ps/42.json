[["1",[["Ψαλμὸς",644,5],["τῷ",1,110],["Δαυίδ",52,105],["Κρίνον",2021,20],["με",6,82],["ὁ",1,4],["Θεὸς",20,5],["καὶ",2,8],["δίκασον",1621,198],["τὴν",1,9],["δίκην",1219,10],["μου",6,48],["ἐξ",21,1],["ἔθνους",60,24],["οὐχ",12,17],["ὁσίου",917,153],["ἀπὸ",17,1],["ἀνθρώπου",43,21],["ἀδίκου",406,153],["καὶ",2,8],["δολίου",1545,153],["ῥῦσαί",337,275],["με",6,82]],"A Psalm of David. Judge me, O God, and plead my cause, against an ungodly nation: deliver me from the unjust and crafty man."],["2",[["Ὅτι",19,8],["σὺ",5,156],["εἶ",10,145],["ὁ",1,4],["Θεὸς",20,5],["κραταίωμά",4280,20],["μου",6,48],["ἱνατί",102,238],["ἀπώσω",770,157],["με",6,82],["καὶ",2,8],["ἱνατί",102,238],["σκυθρωπάζων",3352,67],["πορεύομαι",49,251],["ἐν",4,1],["τῷ",1,110],["ἐκθλίβειν",1930,54],["τὸν",1,6],["ἐχθρόν",135,7],["μου",6,48]],"For thou, O God, art my strength: wherefore hast thou cast me off? and why do I go sad of countenance, while the enemy oppresses [me]?"],["3",[["Ἐξαπόστειλον",220,198],["τὸ",1,27],["φῶς",380,20],["σου",5,146],["καὶ",2,8],["τὴν",1,9],["ἀλήθειάν",352,10],["σου",5,146],["αὐτά",3,66],["με",6,82],["ὡδήγησαν",1108,141],["καὶ",2,8],["ἤγαγόν",224,141],["με",6,82],["εἰς",8,1],["ὄρος",87,33],["ἅγιόν",75,29],["σου",5,146],["καὶ",2,8],["εἰς",8,1],["τὰ",1,42],["σκηνώματά",682,43],["σου",5,146]],"Send forth thy light and thy truth: they have led me, and brought me to thy holy mountain, and to thy tabernacles."],["4",[["Καὶ",2,8],["εἰσελεύσομαι",86,177],["πρὸς",15,1],["τὸ",1,32],["θυσιαστήριον",133,33],["τοῦ",1,30],["Θεοῦ",20,21],["πρὸς",15,1],["τὸν",1,6],["Θεὸν",20,7],["τὸν",1,6],["εὐφραίνοντα",244,178],["τὴν",1,9],["νεότητά",787,10],["μου",6,48],["ἐξομολογήσομαί",479,177],["σοι",5,151],["ἐν",4,1],["κιθάρᾳ",1513,2],["ὁ",1,4],["Θεὸς",20,5],["ὁ",1,4],["Θεός",20,5],["μου",6,48]],"And I will go in to the altar of God, to God who gladdens my youth: I will give thanks to thee on the harp, O God, my God."],["5",[["Ἱνατί",102,238],["περίλυπος",3619,15],["εἶ",10,145],["ἡ",1,11],["ψυχή",63,13],["μου",6,48],["καὶ",2,8],["ἱνατί",102,238],["συνταράσσεις",2042,145],["με",6,82],["ἔλπισον",514,198],["ἐπὶ",9,1],["τὸν",1,6],["Θεὸν",20,7],["ὅτι",19,8],["ἐξομολογήσομαι",479,177],["αὐτῷ",3,49],["σωτήριον",472,33],["τοῦ",1,23],["προσώπου",47,24],["μου",6,48],["ὁ",1,4],["Θεός",20,5],["μου",6,48]],"Wherefore art thou very sad, O my soul? and wherefore dost thou trouble me? Hope in God; for I will give thanks to him, [who is] the health of my countenance, [and] my God."]]