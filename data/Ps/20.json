[["1",[["Εἰς",8,1],["τὸ",1,32],["τέλος",369,33],["ψαλμὸς",639,5],["τῷ",1,110],["Δαυίδ",52,105]],"For the end, a Psalm of David."],["2",[["Κύριε",7,251],["ἐν",4,1],["τῇ",1,95],["δυνάμει",98,2],["σου",5,146],["εὐφρανθήσεται",242,125],["ὁ",1,4],["βασιλεὺς",22,5],["καὶ",2,8],["ἐπὶ",9,1],["τῷ",1,110],["σωτηρίῳ",1787,111],["σου",5,146],["ἀγαλλιάσεται",737,89],["σφόδρα",149,17]],"O Lord, the king shall rejoice in thy strength; and in thy salvation he shall greatly exult."],["3",[["Τὴν",1,9],["ἐπιθυμίαν",701,10],["τῆς",1,18],["ψυχῆς",62,19],["αὐτοῦ",3,48],["ἔδωκας",33,154],["αὐτῷ",3,49],["καὶ",2,8],["τὴν",1,9],["δέησιν",674,10],["τῶν",1,44],["χειλέων",361,45],["αὐτοῦ",3,48],["οὐκ",12,17],["ἐστέρησας",2121,154],["αὐτόν",3,82],["διάψαλμα",687,20]],"Thou hast granted him the desire of his soul, and hast not withheld from him the request of his lips. Pause."],["4",[["Ὅτι",19,8],["προέφθασας",1834,154],["αὐτὸν",3,82],["ἐν",4,1],["εὐλογίαις",576,71],["χρηστότητος",1847,19],["ἔθηκας",109,154],["ἐπὶ",9,1],["τὴν",1,9],["κεφαλὴν",144,10],["αὐτοῦ",3,48],["στέφανον",979,7],["ἐκ",21,1],["λίθου",195,21],["τιμίου",1190,153]],"For thou hast prevented him with blessings of goodness: thou hast set upon his head a crown of precious stone."],["5",[["Ζωὴν",212,10],["ᾐτήσατό",615,26],["σε",5,161],["καὶ",2,8],["ἔδωκας",33,154],["αὐτῷ",3,49],["μακρότητα",3091,10],["ἡμερῶν",28,61],["εἰς",8,1],["αἰῶνα",100,7],["αἰῶνος",100,21]],"He asked life of thee, and thou gavest him length of days for ever and ever."],["6",[["Μεγάλη",65,15],["ἡ",1,11],["δόξα",141,186],["αὐτοῦ",3,48],["ἐν",4,1],["τῷ",1,110],["σωτηρίῳ",1787,111],["σου",5,146],["δόξαν",141,10],["καὶ",2,8],["μεγαλοπρέπειαν",2745,10],["ἐπιθήσεις",239,159],["ἐπʼ",9,1],["αὐτόν",3,82]],"His glory is great in thy salvation: thou wilt crown him with glory and majesty."],["7",[["Ὅτι",19,8],["δώσεις",33,159],["αὐτῷ",3,49],["εὐλογίαν",576,10],["εἰς",8,1],["αἰῶνα",100,7],["αἰῶνος",100,21],["εὐφρανεῖς",242,159],["αὐτὸν",3,82],["ἐν",4,1],["χαρᾷ",1124,2],["μετὰ",29,1],["τοῦ",1,23],["προσώπου",47,24],["σου",5,146]],"For thou wilt give him a blessing for ever and ever: thou wilt gladden him with joy with thy countenance."],["8",[["Ὅτι",19,8],["ὁ",1,4],["βασιλεὺς",22,5],["ἐλπίζει",511,87],["ἐπὶ",9,1],["Κύριον",7,7],["καὶ",2,8],["ἐν",4,1],["τῷ",1,52],["ἐλέει",182,53],["τοῦ",1,30],["ὑψίστου",473,153],["οὐ",12,17],["μὴ",25,8],["σαλευθῇ",679,337]],"For the king trusts in the Lord, and through the mercy of the Highest he shall not be moved."],["9",[["Εὑρεθείη",106,555],["ἡ",1,11],["χείρ",37,13],["σου",5,146],["πᾶσι",11,215],["τοῖς",1,138],["ἐχθροῖς",135,139],["σου",5,146],["ἡ",1,11],["δεξιά",282,15],["σου",5,146],["εὕροι",106,276],["πάντας",11,58],["τοὺς",1,56],["μισοῦντάς",355,229],["σε",5,161]],"Let thy hand be found by all thine enemies: let thy right hand find all that hate thee."],["10",[["Θήσεις",109,159],["αὐτοὺς",3,60],["ὡς",36,8],["κλίβανον",7530,7],["πυρὸς",118,24],["εἰς",8,1],["καιρὸν",132,7],["τοῦ",1,23],["προσώπου",47,24],["σου",5,146],["Κύριος",7,5],["ἐν",4,1],["ὀργῇ",198,2],["αὐτοῦ",3,48],["συνταράξει",2047,120],["αὐτοὺς",3,60],["καὶ",2,8],["καταφάγεται",404,89],["αὐτοὺς",3,60],["πῦρ",118,33]],"Thou shalt make them as a fiery oven at the time of thy presence: the Lord shall trouble them in his anger, and fire shall devour them."],["11",[["Τὸν",1,6],["καρπὸν",446,7],["αὐτῶν",3,41],["ἀπὸ",17,1],["γῆς",26,19],["ἀπολεῖς",213,159],["καὶ",2,8],["τὸ",1,32],["σπέρμα",214,33],["αὐτῶν",3,41],["ἀπὸ",17,1],["υἱῶν",13,77],["ἀνθρώπων",43,77]],"Thou shalt destroy their fruit from the earth, and their seed from [among] the sons of men."],["12",[["Ὅτι",19,8],["ἔκλιναν",829,141],["εἰς",8,1],["σὲ",5,161],["κακὰ",161,65],["διελογίσαντο",2577,436],["βουλὴν",349,10],["ἣν",24,124],["οὐ",12,17],["μὴ",25,8],["δύνωνται",184,396],["στῆσαι",78,100]],"For they intended evils against thee; they imagined a device which they shall by no means be able to perform."],["13",[["Ὅτι",19,8],["θήσεις",109,159],["αὐτοὺς",3,60],["νῶτον",2194,7],["ἐν",4,1],["τοῖς",1,138],["περιλοίποις",5970,215],["σου",5,146],["ἑτοιμάσεις",371,159],["τὸ",1,32],["πρόσωπον",47,33],["αὐτῶν",3,41]],"For thou shalt make them [turn their] back in thy latter end, thou wilt prepare their face."],["14",[["Ὑψώθητι",327,242],["Κύριε",7,251],["ἐν",4,1],["τῇ",1,95],["δυνάμει",98,2],["σου",5,146],["ᾄσομεν",1080,269],["καὶ",2,8],["ψαλοῦμεν",901,269],["τὰς",1,39],["δυναστείας",919,40],["σου",5,146]],"Be thou exalted, O Lord, in thy strength: we will sing and praise thy mighty acts."]]