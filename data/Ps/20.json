[["1",[["Εἰς",8,1],["τὸ",1,32],["τέλος",373,33],["ψαλμὸς",644,5],["τῷ",1,110],["Δαυίδ",52,105]],"For the end, a Psalm of David."],["2",[["Κύριε",7,250],["ἐν",4,1],["τῇ",1,95],["δυνάμει",98,2],["σου",5,146],["εὐφρανθήσεται",244,125],["ὁ",1,4],["βασιλεὺς",22,5],["καὶ",2,8],["ἐπὶ",9,1],["τῷ",1,110],["σωτηρίῳ",1788,111],["σου",5,146],["ἀγαλλιάσεται",738,89],["σφόδρα",150,17]],"O Lord, the king shall rejoice in thy strength; and in thy salvation he shall greatly exult."],["3",[["Τὴν",1,9],["ἐπιθυμίαν",699,10],["τῆς",1,18],["ψυχῆς",63,19],["αὐτοῦ",3,48],["ἔδωκας",33,154],["αὐτῷ",3,49],["καὶ",2,8],["τὴν",1,9],["δέησιν",677,10],["τῶν",1,44],["χειλέων",361,45],["αὐτοῦ",3,48],["οὐκ",12,17],["ἐστέρησας",1976,154],["αὐτόν",3,82],["διάψαλμα",689,20]],"Thou hast granted him the desire of his soul, and hast not withheld from him the request of his lips. Pause."],["4",[["Ὅτι",19,8],["προέφθασας",1831,154],["αὐτὸν",3,82],["ἐν",4,1],["εὐλογίαις",578,71],["χρηστότητος",1845,19],["ἔθηκας",110,154],["ἐπὶ",9,1],["τὴν",1,9],["κεφαλὴν",144,10],["αὐτοῦ",3,48],["στέφανον",980,7],["ἐκ",21,1],["λίθου",195,21],["τιμίου",1189,153]],"For thou hast prevented him with blessings of goodness: thou hast set upon his head a crown of precious stone."],["5",[["Ζωὴν",216,10],["ᾐτήσατό",617,26],["σε",5,161],["καὶ",2,8],["ἔδωκας",33,154],["αὐτῷ",3,49],["μακρότητα",3081,10],["ἡμερῶν",28,61],["εἰς",8,1],["αἰῶνα",100,7],["αἰῶνος",100,21]],"He asked life of thee, and thou gavest him length of days for ever and ever."],["6",[["Μεγάλη",66,15],["ἡ",1,11],["δόξα",141,188],["αὐτοῦ",3,48],["ἐν",4,1],["τῷ",1,110],["σωτηρίῳ",1788,111],["σου",5,146],["δόξαν",141,10],["καὶ",2,8],["μεγαλοπρέπειαν",2738,10],["ἐπιθήσεις",239,159],["ἐπʼ",9,1],["αὐτόν",3,82]],"His glory is great in thy salvation: thou wilt crown him with glory and majesty."],["7",[["Ὅτι",19,8],["δώσεις",33,159],["αὐτῷ",3,49],["εὐλογίαν",578,10],["εἰς",8,1],["αἰῶνα",100,7],["αἰῶνος",100,21],["εὐφρανεῖς",244,159],["αὐτὸν",3,82],["ἐν",4,1],["χαρᾷ",1125,2],["μετὰ",29,1],["τοῦ",1,23],["προσώπου",47,24],["σου",5,146]],"For thou wilt give him a blessing for ever and ever: thou wilt gladden him with joy with thy countenance."],["8",[["Ὅτι",19,8],["ὁ",1,4],["βασιλεὺς",22,5],["ἐλπίζει",514,87],["ἐπὶ",9,1],["Κύριον",7,7],["καὶ",2,8],["ἐν",4,1],["τῷ",1,52],["ἐλέει",183,53],["τοῦ",1,30],["ὑψίστου",474,153],["οὐ",12,17],["μὴ",25,8],["σαλευθῇ",678,333]],"For the king trusts in the Lord, and through the mercy of the Highest he shall not be moved."],["9",[["Εὑρεθείη",101,544],["ἡ",1,11],["χείρ",37,13],["σου",5,146],["πᾶσι",11,215],["τοῖς",1,138],["ἐχθροῖς",135,139],["σου",5,146],["ἡ",1,11],["δεξιά",282,15],["σου",5,146],["εὕροι",101,216],["πάντας",11,58],["τοὺς",1,56],["μισοῦντάς",351,229],["σε",5,161]],"Let thy hand be found by all thine enemies: let thy right hand find all that hate thee."],["10",[["Θήσεις",110,159],["αὐτοὺς",3,60],["ὡς",36,8],["κλίβανον",7480,7],["πυρὸς",118,24],["εἰς",8,1],["καιρὸν",132,7],["τοῦ",1,23],["προσώπου",47,24],["σου",5,146],["Κύριος",7,5],["ἐν",4,1],["ὀργῇ",198,2],["αὐτοῦ",3,48],["συνταράξει",2042,120],["αὐτοὺς",3,60],["καὶ",2,8],["καταφάγεται",407,89],["αὐτοὺς",3,60],["πῦρ",118,33]],"Thou shalt make them as a fiery oven at the time of thy presence: the Lord shall trouble them in his anger, and fire shall devour them."],["11",[["Τὸν",1,6],["καρπὸν",448,7],["αὐτῶν",3,41],["ἀπὸ",17,1],["γῆς",26,19],["ἀπολεῖς",217,159],["καὶ",2,8],["τὸ",1,32],["σπέρμα",218,33],["αὐτῶν",3,41],["ἀπὸ",17,1],["υἱῶν",13,77],["ἀνθρώπων",43,77]],"Thou shalt destroy their fruit from the earth, and their seed from [among] the sons of men."],["12",[["Ὅτι",19,8],["ἔκλιναν",785,141],["εἰς",8,1],["σὲ",5,161],["κακὰ",161,65],["διελογίσαντο",2573,430],["βουλὴν",350,10],["ἣν",24,124],["οὐ",12,17],["μὴ",25,8],["δύνωνται",185,391],["στῆσαι",78,100]],"For they intended evils against thee; they imagined a device which they shall by no means be able to perform."],["13",[["Ὅτι",19,8],["θήσεις",110,159],["αὐτοὺς",3,60],["νῶτον",2181,7],["ἐν",4,1],["τοῖς",1,138],["περιλοίποις",5940,215],["σου",5,146],["ἑτοιμάσεις",371,159],["τὸ",1,32],["πρόσωπον",47,33],["αὐτῶν",3,41]],"For thou shalt make them [turn their] back in thy latter end, thou wilt prepare their face."],["14",[["Ὑψώθητι",331,242],["Κύριε",7,250],["ἐν",4,1],["τῇ",1,95],["δυνάμει",98,2],["σου",5,146],["ᾄσομεν",856,269],["καὶ",2,8],["ψαλοῦμεν",913,269],["τὰς",1,39],["δυναστείας",918,40],["σου",5,146]],"Be thou exalted, O Lord, in thy strength: we will sing and praise thy mighty acts."]]