[["1",[["Ὠδὴ",773,105],["ψαλμοῦ",639,21],["τοῖς",1,138],["υἱοῖς",13,139],["Κορὲ",875,251],["εἰς",8,1],["τὸ",1,32],["τέλος",369,33],["ὑπὲρ",139,1],["μαελὲθ",4919,105],["τοῦ",1,30],["ἀποκριθῆναι",229,174],["συνέσεως",467,19],["Αἰμὰν",0,0],["τῷ",1,110],["Ἰσραηλίτῃ",3471,113]],"A song of a Psalm for the sons of Core for the end, upon Maeleth for responsive [strains], of instruction for Æman the Israelite."],["2",[["Κύριε",7,251],["ὁ",1,4],["Θεὸς",20,5],["τῆς",1,18],["σωτηρίας",422,19],["μου",6,83],["ἡμέρας",28,19],["ἐκέκραξα",590,147],["καὶ",2,8],["ἐν",4,1],["νυκτὶ",216,2],["ἐναντίον",138,17],["σου",5,146]],"O Lord God of my salvation, I have cried by day and in the night before thee."],["3",[["Εἰσελθέτω",88,46],["ἐνώπιόν",114,1],["σου",5,146],["ἡ",1,11],["προσευχή",549,13],["μου",6,48],["κλῖνον",829,36],["τὸ",1,27],["οὖς",325,20],["σου",5,146],["εἰς",8,1],["τὴν",1,9],["δέησίν",674,10],["μου",6,48],["Κύριε",7,251]],"Let my prayer come in before thee; incline thine ear to my supplication, O Lord."],["4",[["Ὅτι",19,8],["ἐπλήσθη",911,38],["κακῶν",161,79],["ἡ",1,11],["ψυχή",62,13],["μου",6,48],["καὶ",2,8],["ἡ",1,11],["ζωή",212,13],["μου",6,48],["τῷ",1,110],["ᾅδῃ",583,113],["ἤγγισε",0,0]],"For my soul is filled with troubles, and my life has drawn nigh to Hades."],["5",[["Προσελογίσθην",3945,256],["μετὰ",29,1],["τῶν",1,76],["καταβαινόντων",174,164],["εἰς",8,1],["λάκκον",677,7],["ἐγενήθην",30,148],["ὡς",36,8],["ἄνθρωπος",43,5],["ἀβοήθητος",5184,16]],"I have been reckoned with them that go down to the pit; I became as a man without help;"],["6",[["ἐν",4,1],["νεκροῖς",653,215],["ἐλεύθερος",1456,16],["ὡσεὶ",342,17],["τραυματίαι",817,51],["ἐῤῥιμμένοι",2004,493],["καθεύδοντες",1725,137],["ἐν",4,1],["τάφῳ",865,113],["ὧν",24,97],["οὐκ",12,17],["ἐμνήσθης",231,363],["ἔτι",110,17],["καὶ",2,8],["αὐτοὶ",3,193],["ἐκ",21,1],["τῆς",1,18],["χειρός",37,19],["σου",5,146],["ἀπώσθησαν",767,94]],"free among the dead, as the slain ones cast out, who sleep in the tomb; whom thou rememberest no more; and they are rejected from thy hand."],["7",[["Ἔθεντό",109,182],["με",6,82],["ἐν",4,1],["λάκκῳ",677,113],["κατωτάτῳ",3289,111],["ἐν",4,1],["σκοτεινοῖς",2386,215],["καὶ",2,8],["ἐν",4,1],["σκιᾷ",978,2],["θανάτου",169,21]],"They laid me in the lowest pit, in dark [places], and in the shadow of death."],["8",[["Ἐπʼ",9,1],["ἐμὲ",6,82],["ἐπεστηρίχθη",2850,38],["ὁ",1,4],["θυμός",177,5],["σου",5,146],["καὶ",2,8],["πάντας",11,58],["τοὺς",1,56],["μετεωρισμούς",3303,31],["σου",5,146],["ἐπήγαγες",415,154],["ἐπʼ",9,1],["ἐμέ",6,82],["διάψαλμα",687,20]],"Thy wrath has pressed heavily upon me, and thou hast brought upon me all thy billows. Pause."],["9",[["Ἐμάκρυνας",0,0],["τοὺς",1,56],["γνωστούς",1618,58],["μου",6,48],["ἀπʼ",17,1],["ἐμοῦ",6,48],["ἔθεντό",109,182],["με",6,82],["βδέλυγμα",475,33],["ἑαυτοῖς",92,142],["παρεδόθην",254,148],["καὶ",2,8],["οὐκ",12,17],["ἐξεπορευόμην",373,380]],"Thou hast removed my acquaintance far from me; they have made me an abomination to themselves; I have been delivered up, and have not gone forth."],["10",[["Οἱ",1,128],["ὀφθαλμοί",91,51],["μου",6,48],["ἠσθένησαυ",0,0],["ἀπὸ",17,1],["πτωχείας",1912,40],["καὶ",2,8],["ἐκέκραξα",590,147],["πρὸς",15,1],["σὲ",5,161],["Κύριε",7,251],["ὅλην",233,37],["τὴν",1,9],["ἡμέραν",28,10],["διεπέτασα",1816,147],["πρὸς",15,1],["σὲ",5,161],["τὰς",1,39],["χεῖράς",37,40],["μου",6,48]],"Mine eyes are dimmed from poverty; but I cried to thee, O Lord, all the day; I spread forth my hands to thee."],["11",[["Μὴ",25,8],["τοῖς",1,138],["νεκροῖς",653,215],["ποιήσεις",23,159],["θαυμάσια",885,65],["ἢ",60,8],["ἰατροὶ",2552,51],["ἀναστήσουσι",121,207],["καὶ",2,8],["ἐξομολογήσονταί",478,127],["σοι",5,151]],"Wilt thou work wonders for the dead? or shall physicians raise [them] up, that they shall praise thee?"],["12",[["Μὴ",25,8],["διηγήσεταί",797,89],["τις",39,150],["ἐν",4,1],["τάφῳ",865,113],["τὸ",1,32],["ἔλεός",182,33],["σου",5,146],["καὶ",2,8],["τὴν",1,9],["ἀλήθειάν",350,10],["σου",5,146],["ἐν",4,1],["τῇ",1,95],["ἀπωλείᾳ",539,2]],"Shall any one declare thy mercy in the tomb? and thy truth in destruction?"],["13",[["Μὴ",25,8],["γνωσθήσεται",81,125],["ἐν",4,1],["τῷ",1,52],["σκότει",503,53],["τὰ",1,42],["θαυμάσιά",885,65],["σου",5,146],["καὶ",2,8],["ἡ",1,11],["δικαιοσύνη",185,13],["σου",5,146],["ἐν",4,1],["γῇ",26,2],["ἐπιλελησμένῃ",512,468]],"Shall thy wonders be known in darkness? and thy righteousness in a forgotten land?"],["14",[["Κᾀγὼ",611,105],["πρὸς",15,1],["σὲ",5,161],["Κύριε",7,251],["ἐκέκραξα",590,147],["καὶ",2,8],["τοπρωῒ",0,0],["ἡ",1,11],["προσευχή",549,13],["μου",6,48],["προφθάσει",1834,120],["σε",5,161]],"But I cried to thee, O Lord; and in the morning shall my prayer prevent thee."],["15",[["Ἱνατί",101,238],["Κύριε",7,251],["ἀπωθεῖς",767,145],["τὴν",1,9],["προσευχήν",549,10],["μου",6,48],["ἀποστρέφεις",130,145],["τὸ",1,32],["πρόσωπόν",47,33],["σου",5,146],["ἀπʼ",17,1],["ἐμοῦ",6,48]],"Wherefore, O Lord, dost thou reject my prayer, [and] turn thy face away from me?"],["16",[["Πτωχός",496,5],["εἰμι",10,149],["ἐγὼ",6,158],["καὶ",2,8],["ἐν",4,1],["κόποις",1342,139],["ἐκ",21,1],["νεότητός",785,19],["μου",6,83],["ὑψωθεὶς",327,206],["δὲ",14,12],["ἐταπεινώθην",333,148],["καὶ",2,8],["ἐξηπορήθην",9502,94]],"I am poor and in troubles from my youth; and having been exalted, I was brought low and into despair."],["17",[["Ἐπʼ",9,1],["ἐμὲ",6,82],["διῆλθον",427,141],["αἱ",1,183],["ὀργαί",198,179],["σου",5,146],["καὶ",2,8],["οἱ",1,128],["φοβερισμοί",8682,51],["σου",5,146],["ἐξετάραξάν",4600,141],["με",6,82]],"Thy wrath has passed over me; and thy terrors have greatly disquieted me."],["18",[["Ἐκύκλωσάν",600,141],["με",6,82],["ὡς",36,8],["ὕδωρ",85,33],["ὅλην",233,37],["τὴν",1,9],["ἡμέραν",28,10],["περιέσχον",1349,141],["με",6,98],["ἅμα",499,17]],"They compassed me like water; all the day they beset me together."],["19",[["Ἐμάκρυνας",0,0],["ἀπʼ",17,1],["ἐμοῦ",6,48],["φίλον",334,59],["καὶ",2,8],["τοὺς",1,56],["γνωστούς",1618,58],["μου",6,83],["ἀπὸ",17,1],["ταλαιπωρίας",1449,19]],"Thou hast put far from me [every] friend, and mine acquaintances because of [my] wretchedness."]]