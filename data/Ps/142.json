[["1",[["Ψαλμὸς",644,5],["τῷ",1,110],["Δαυὶδ",52,105],["ὅτε",432,8],["αὐτὸν",3,82],["ὁ",1,4],["υἱὸς",13,5],["κατεδιώκει",0,0],["Κύριε",7,250],["εἰσάκουσον",241,198],["τῆς",1,18],["προσευχῆς",550,19],["μου",6,83],["ἐνώτισαι",1316,334],["τὴν",1,9],["δέησίν",677,10],["μου",6,48],["ἐν",4,1],["τῇ",1,95],["ἀληθείᾳ",352,2],["σου",5,146],["ἐπάκουσόν",597,198],["μου",6,48],["ἐν",4,1],["τῇ",1,95],["δικαιοσύνῃ",187,2],["σου",5,146]],"A Psalm of David, when his son pursued him. O Lord, attend to my prayer: hearken to my supplication in thy truth; hear me in thy righteousness."],["2",[["Καὶ",2,8],["μὴ",25,8],["εἰσέλθῃς",86,170],["εἰς",8,1],["κρίσιν",229,10],["μετὰ",29,1],["τοῦ",1,30],["δούλου",136,21],["σου",5,146],["ὅτι",19,8],["οὐ",12,17],["δικαιωθήσεται",1115,125],["ἐνώπιόν",115,1],["σου",5,146],["πᾶς",11,16],["ζῶν",107,67]],"And enter not into judgment with thy servant, for in thy sight shall no [man] living be justified."],["3",[["Ὅτι",19,8],["κατεδίωξεν",621,3],["ὁ",1,4],["ἐχθρὸς",135,5],["τὴν",1,9],["ψυχήν",63,10],["μου",6,48],["ἐταπείνωσεν",322,3],["εἰς",8,1],["τὴν",1,9],["γῆν",26,10],["τὴν",1,9],["ζωήν",216,10],["μου",6,48],["ἐκάθισέ",274,3],["με",6,82],["ἐν",4,1],["σκοτεινοῖς",2378,215],["ὡς",36,8],["νεκροὺς",659,58],["αἰῶνος",100,21]],"For the enemy has persecuted my soul; he has brought my life down to the ground; he has made me to dwell in a dark [place], as those that have been long dead."],["4",[["καὶ",2,8],["ἠκηδίασεν",4011,3],["ἐπʼ",9,1],["ἐμὲ",6,82],["τὸ",1,32],["πνεῦμά",168,33],["μου",6,48],["ἐν",4,1],["ἐμοὶ",6,49],["ἐταράχθη",508,38],["ἡ",1,11],["καρδία",64,13],["μου",6,48]],"Therefore my spirit was grieved in me; my heart was troubled within me."],["5",[["Ἐμνήσθην",230,148],["ἡμερῶν",28,61],["ἀρχαίων",1570,115],["καὶ",2,8],["ἐμελέτησα",1347,147],["ἐν",4,1],["πᾶσι",11,90],["τοῖς",1,91],["ἔργοις",105,92],["σου",5,146],["ἐν",4,1],["ποιήμασι",1443,92],["τῶν",1,123],["χειρῶν",37,61],["σου",5,146],["ἐμελέτων",1347,129]],"I remembered the days of old; and I meditated on all thy doings: [yea], I meditated on the works of thine hands."],["6",[["Διεπέτασα",1815,147],["πρὸς",15,1],["σὲ",5,161],["τὰς",1,39],["χεῖράς",37,40],["μου",6,48],["ἡ",1,11],["ψυχή",63,13],["μου",6,48],["ὡς",36,8],["γῆ",26,13],["ἄνυδρός",1701,15],["σοι",5,151],["διάψαλμα",689,20]],"I spread forth my hands to thee; my soul [thirsts] for thee, as a dry land. Pause."],["7",[["Ταχὺ",1389,17],["εἰσάκουσόν",241,198],["μου",6,48],["Κύριε",7,250],["ἐξέλιπε",321,3],["τὸ",1,32],["πνεῦμά",168,33],["μου",6,48],["μὴ",25,8],["ἀποστρέψῃς",130,170],["τὸ",1,32],["πρόσωπόν",47,33],["σου",5,146],["ἀπʼ",17,1],["ἐμοῦ",6,48],["καὶ",2,8],["ὁμοιωθήσομαι",1175,176],["τοῖς",1,138],["καταβαίνουσιν",175,352],["εἰς",8,1],["λάκκον",680,7]],"Hear me speedily, O Lord; my spirit has failed; turn not away thy face from me, else I shall be like to them that go down to the pit."],["8",[["Ἀκουστὸν",1748,28],["ποίησόν",23,198],["μοι",6,49],["τοπρωῒ",0,0],["τὸ",1,32],["ἔλεός",183,33],["σου",5,146],["ὅτι",19,8],["ἐπὶ",9,1],["σοὶ",5,151],["ἤλπισα",514,147],["γνώρισόν",748,198],["μοι",6,49],["Κύριε",7,250],["ὁδὸν",68,10],["ἐν",4,1],["ᾗ",24,102],["πορεύσομαι",49,177],["ὅτι",19,8],["πρὸς",15,1],["σὲ",5,161],["ᾖρα",206,147],["τὴν",1,9],["ψυχήν",63,10],["μου",6,48]],"Cause me to hear thy mercy in the morning; for I have hoped in thee; make known to me, O Lord, the way wherein I should walk; for I have lifted up my soul to thee."],["9",[["Ἐξελοῦ",413,275],["με",6,82],["ἐκ",21,1],["τῶν",1,76],["ἐχθρῶν",135,77],["μου",6,48],["Κύριε",7,250],["ὅτι",19,8],["πρὸς",15,1],["σὲ",5,161],["κατέφυγον",1889,141]],"Deliver me from mine enemies, O Lord; for I have fled to thee for refuge."],["10",[["Δίδαξόν",545,198],["με",6,82],["τοῦ",1,30],["ποιεῖν",23,54],["τὸ",1,32],["θέλημά",1039,33],["σου",5,146],["ὅτι",19,8],["Θεός",20,5],["μου",6,48],["εἶ",10,145],["σὺ",5,156],["τὸ",1,32],["πνεῦμά",168,33],["σου",5,146],["τὸ",1,32],["ἁγαθὸν",114,29],["ὁδηγήσει",1108,120],["με",6,82],["ἐν",4,1],["τῇ",1,95],["εὐθείᾳ",1137,96]],"Teach me to do thy will; for thou art my God; thy good Spirit shall guide me in the straight [way]."],["11",[["Ἕνεκα",447,1],["τοῦ",1,23],["ὀνόματός",57,24],["σου",5,146],["Κύριε",7,250],["ζήσεις",107,159],["με",6,82],["ἐν",4,1],["τῇ",1,95],["δικαιοσύνῃ",187,2],["σου",5,146],["ἐξάξεις",295,159],["ἐκ",21,1],["θλίψεως",438,19],["τὴν",1,9],["ψυχήν",63,10],["μου",6,48]],"Thou shalt quicken me, O Lord, for thy name's sake; in thy righteousness thou shalt bring my soul out of affliction."],["12",[["Καὶ",2,8],["ἐν",4,1],["τῷ",1,52],["ἐλέει",183,53],["σου",5,146],["ἐξολοθρεύσεις",291,159],["τοὺς",1,56],["ἐχθρούς",135,31],["μου",6,48],["καὶ",2,8],["ἀπολεῖς",217,159],["πάντας",11,58],["τοὺς",1,56],["θλίβοντας",601,229],["τὴν",1,9],["ψυχήν",63,10],["μου",6,48],["ὅτι",19,8],["δοῦλός",136,5],["σου",5,146],["εἰμὶ",10,149],["ἐγώ",6,158]],"And in thy mercy thou wilt destroy mine enemies, and wilt destroy all those that afflict my soul; for I am thy servant."]]