[["1",[["Ψαλμὸς",639,5],["τῷ",1,110],["Δαυὶδ",52,105],["ὅτε",430,8],["αὐτὸν",3,82],["ὁ",1,4],["υἱὸς",13,5],["κατεδιώκει",0,0],["Κύριε",7,251],["εἰσάκουσον",237,198],["τῆς",1,18],["προσευχῆς",549,19],["μου",6,83],["ἐνώτισαι",1316,296],["τὴν",1,9],["δέησίν",674,10],["μου",6,48],["ἐν",4,1],["τῇ",1,95],["ἀληθείᾳ",350,2],["σου",5,146],["ἐπάκουσόν",595,198],["μου",6,48],["ἐν",4,1],["τῇ",1,95],["δικαιοσύνῃ",185,2],["σου",5,146]],"A Psalm of David, when his son pursued him. O Lord, attend to my prayer: hearken to my supplication in thy truth; hear me in thy righteousness."],["2",[["Καὶ",2,8],["μὴ",25,8],["εἰσέλθῃς",88,170],["εἰς",8,1],["κρίσιν",226,10],["μετὰ",29,1],["τοῦ",1,30],["δούλου",136,21],["σου",5,146],["ὅτι",19,8],["οὐ",12,17],["δικαιωθήσεται",1134,125],["ἐνώπιόν",114,1],["σου",5,146],["πᾶς",11,16],["ζῶν",117,67]],"And enter not into judgment with thy servant, for in thy sight shall no [man] living be justified."],["3",[["Ὅτι",19,8],["κατεδίωξεν",619,3],["ὁ",1,4],["ἐχθρὸς",135,5],["τὴν",1,9],["ψυχήν",62,10],["μου",6,48],["ἐταπείνωσεν",333,3],["εἰς",8,1],["τὴν",1,9],["γῆν",26,10],["τὴν",1,9],["ζωήν",212,10],["μου",6,48],["ἐκάθισέ",273,3],["με",6,82],["ἐν",4,1],["σκοτεινοῖς",2386,215],["ὡς",36,8],["νεκροὺς",653,58],["αἰῶνος",100,21]],"For the enemy has persecuted my soul; he has brought my life down to the ground; he has made me to dwell in a dark [place], as those that have been long dead."],["4",[["καὶ",2,8],["ἠκηδίασεν",0,0],["ἐπʼ",9,1],["ἐμὲ",6,82],["τὸ",1,32],["πνεῦμά",167,33],["μου",6,48],["ἐν",4,1],["ἐμοὶ",6,49],["ἐταράχθη",508,38],["ἡ",1,11],["καρδία",63,13],["μου",6,48]],"Therefore my spirit was grieved in me; my heart was troubled within me."],["5",[["Ἐμνήσθην",231,148],["ἡμερῶν",28,61],["ἀρχαίων",1571,115],["καὶ",2,8],["ἐμελέτησα",1344,147],["ἐν",4,1],["πᾶσι",11,90],["τοῖς",1,91],["ἔργοις",104,92],["σου",5,146],["ἐν",4,1],["ποιήμασι",1444,92],["τῶν",1,123],["χειρῶν",37,61],["σου",5,146],["ἐμελέτων",1344,129]],"I remembered the days of old; and I meditated on all thy doings: [yea], I meditated on the works of thine hands."],["6",[["Διεπέτασα",1816,147],["πρὸς",15,1],["σὲ",5,161],["τὰς",1,39],["χεῖράς",37,40],["μου",6,48],["ἡ",1,11],["ψυχή",62,13],["μου",6,48],["ὡς",36,8],["γῆ",26,13],["ἄνυδρός",1705,15],["σοι",5,151],["διάψαλμα",687,20]],"I spread forth my hands to thee; my soul [thirsts] for thee, as a dry land. Pause."],["7",[["Ταχὺ",1391,17],["εἰσάκουσόν",237,198],["μου",6,48],["Κύριε",7,251],["ἐξέλιπε",321,3],["τὸ",1,32],["πνεῦμά",167,33],["μου",6,48],["μὴ",25,8],["ἀποστρέψῃς",130,170],["τὸ",1,32],["πρόσωπόν",47,33],["σου",5,146],["ἀπʼ",17,1],["ἐμοῦ",6,48],["καὶ",2,8],["ὁμοιωθήσομαι",1197,175],["τοῖς",1,138],["καταβαίνουσιν",174,357],["εἰς",8,1],["λάκκον",677,7]],"Hear me speedily, O Lord; my spirit has failed; turn not away thy face from me, else I shall be like to them that go down to the pit."],["8",[["Ἀκουστὸν",1745,28],["ποίησόν",23,198],["μοι",6,49],["τοπρωῒ",0,0],["τὸ",1,32],["ἔλεός",182,33],["σου",5,146],["ὅτι",19,8],["ἐπὶ",9,1],["σοὶ",5,151],["ἤλπισα",511,147],["γνώρισόν",746,198],["μοι",6,49],["Κύριε",7,251],["ὁδὸν",67,10],["ἐν",4,1],["ᾗ",24,102],["πορεύσομαι",49,176],["ὅτι",19,8],["πρὸς",15,1],["σὲ",5,161],["ᾖρα",0,0],["τὴν",1,9],["ψυχήν",62,10],["μου",6,48]],"Cause me to hear thy mercy in the morning; for I have hoped in thee; make known to me, O Lord, the way wherein I should walk; for I have lifted up my soul to thee."],["9",[["Ἐξελοῦ",411,275],["με",6,82],["ἐκ",21,1],["τῶν",1,76],["ἐχθρῶν",135,77],["μου",6,48],["Κύριε",7,251],["ὅτι",19,8],["πρὸς",15,1],["σὲ",5,161],["κατέφυγον",1964,141]],"Deliver me from mine enemies, O Lord; for I have fled to thee for refuge."],["10",[["Δίδαξόν",543,198],["με",6,82],["τοῦ",1,30],["ποιεῖν",23,54],["τὸ",1,32],["θέλημά",1036,33],["σου",5,146],["ὅτι",19,8],["Θεός",20,5],["μου",6,48],["εἶ",10,145],["σὺ",5,156],["τὸ",1,32],["πνεῦμά",167,33],["σου",5,146],["τὸ",1,32],["ἁγαθὸν",113,29],["ὁδηγήσει",1110,120],["με",6,82],["ἐν",4,1],["τῇ",1,95],["εὐθείᾳ",1137,96]],"Teach me to do thy will; for thou art my God; thy good Spirit shall guide me in the straight [way]."],["11",[["Ἕνεκα",445,1],["τοῦ",1,23],["ὀνόματός",55,24],["σου",5,146],["Κύριε",7,251],["ζήσεις",117,159],["με",6,82],["ἐν",4,1],["τῇ",1,95],["δικαιοσύνῃ",185,2],["σου",5,146],["ἐξάξεις",299,159],["ἐκ",21,1],["θλίψεως",437,19],["τὴν",1,9],["ψυχήν",62,10],["μου",6,48]],"Thou shalt quicken me, O Lord, for thy name's sake; in thy righteousness thou shalt bring my soul out of affliction."],["12",[["Καὶ",2,8],["ἐν",4,1],["τῷ",1,52],["ἐλέει",182,53],["σου",5,146],["ἐξολοθρεύσεις",291,159],["τοὺς",1,56],["ἐχθρούς",135,31],["μου",6,48],["καὶ",2,8],["ἀπολεῖς",213,159],["πάντας",11,58],["τοὺς",1,56],["θλίβοντας",599,229],["τὴν",1,9],["ψυχήν",62,10],["μου",6,48],["ὅτι",19,8],["δοῦλός",136,5],["σου",5,146],["εἰμὶ",10,149],["ἐγώ",6,158]],"And in thy mercy thou wilt destroy mine enemies, and wilt destroy all those that afflict my soul; for I am thy servant."]]