[["1",[["Εἰς",8,1],["τὸ",1,32],["τέλος",369,33],["τῷ",1,110],["Δαυὶδ",52,105],["εἰς",8,1],["ἀνάμνησιν",4035,10],["εἰς",8,1],["τὸ",1,32],["σῶσαί",171,100],["με",6,82],["Κύριον",7,7]],"For the end, by David for a remembrance, that the Lord may save me."],["2",[["Ὁ",1,4],["Θεὸς",20,5],["εἰς",8,1],["τὴν",1,9],["βοήθειάν",761,10],["μου",6,48],["πρόσχες",1692,154]],"Draw nigh, O God, to my help."],["3",[["Αἰσχυνθείησαν",614,410],["καὶ",2,8],["ἐντραπείησαν",1153,410],["οἱ",1,128],["ζητοῦντες",190,137],["τὴν",1,9],["ψυχήν",62,10],["μου",6,48],["ἀποστραφείησαν",130,410],["εἰς",8,1],["τὰ",1,42],["ὀπίσω",166,17],["καὶ",2,8],["καταισχυνθείησαν",716,410],["οἱ",1,128],["βουλόμενοί",461,356],["μοι",6,49],["κατά",32,1]],"Let them be ashamed and confounded that seek my soul: let them be turned backward and put to shame, that wish me evil."],["4",[["Ἀποστραφείησαν",130,410],["παραυτίκα",7938,17],["αἰσχυνόμενοι",614,356],["οἱ",1,128],["λέγοντές",31,137],["μοι",6,49],["εὖγε",2274,17],["εὖγε",2274,17]],"Let them that say to me, Aha, aha, be turned back and put to shame immediately."],["5",[["Ἀγαλλιάσθωσαν",737,72],["καὶ",2,8],["εὐφρανθήτωσαν",242,50],["ἐπὶ",9,1],["σοὶ",5,151],["πάντες",11,130],["οἱ",1,128],["ζητοῦντές",190,137],["σε",5,161],["καὶ",2,8],["λεγέτωσαν",31,55],["διαπαντὸς",506,17],["μεγαλυνθήτω",606,25],["ὁ",1,4],["Θεὸς",20,5],["οἱ",1,128],["ἀγαπῶντες",224,137],["τὸ",1,32],["σωτήριόν",471,33],["σου",5,146]],"Let all that seek thee exult and be glad in thee: and let those that love thy salvation say continually, Let God be magnified."],["6",[["Ἐγὼ",6,158],["δὲ",14,12],["πτωχὸς",496,5],["καὶ",2,8],["πένης",668,5],["ὁ",1,4],["Θεὸς",20,5],["βοήθησόν",552,243],["μοι",6,49],["βοηθός",948,5],["μου",6,48],["καὶ",2,8],["ῥύστης",4161,5],["μου",6,48],["εἶ",10,145],["σὺ",5,156],["Κύριε",7,251],["μὴ",25,8],["χρονίσῃς",1744,170]],"But I am poor and needy; O God, help me: thou art my helper and deliverer, O Lord, delay not."]]