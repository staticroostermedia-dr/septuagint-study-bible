[["1",[["Ὠδὴ",773,105],["τῶν",1,76],["ἀναβαθμῶν",1486,77],["Ἐν",4,1],["τῷ",1,110],["ἐπιστρέψαι",116,100],["Κύριον",7,7],["τὴν",1,9],["αἰχμαλωσίαν",458,10],["Σιὼν",331,2],["ἐγενήθημεν",30,498],["ὡσεὶ",342,17],["παρακεκλημένοι",432,493]],"A Song of Degrees. When the Lord turned the captivity of Sion, we became as comforted ones."],["2",[["Τότε",250,17],["ἐπλήσθη",911,38],["χαρᾶς",1124,19],["τὸ",1,32],["στόμα",123,33],["ἡμῶν",6,41],["καὶ",2,8],["ἡ",1,11],["γλῶσσα",385,13],["ἡμῶν",6,41],["ἀγαλλιάσεως",1985,19],["τότε",250,17],["ἐροῦσιν",191,357],["ἐν",4,1],["τοῖς",1,91],["ἔθνεσιν",59,92],["ἐμεγάλυνε",606,14],["Κύριος",7,5],["τοῦ",1,30],["ποιῆσαι",23,100],["μετʼ",29,1],["αὐτῶν",3,41]],"Then was our mouth filled with joy, and our tongue with exultation: then would they say among the Gentiles,"],["3",[["Ἐμεγάλυνε",606,14],["Κύριος",7,5],["τοῦ",1,30],["ποιῆσαι",23,100],["μεθʼ",29,1],["ἡμῶν",6,41],["ἐγενήθημεν",30,498],["εὐφραινόμενοι",242,356]],"The Lord has done great things among them. The Lord has done great things for us, we became joyful."],["4",[["Ἐπίστρεψον",116,198],["Κύριε",7,251],["τὴν",1,9],["αἰχμαλωσίαν",458,10],["ἡμῶν",6,41],["ὡς",36,8],["χειμάῤῥους",736,31],["ἐν",4,1],["τῷ",1,110],["Νότῳ",586,113]],"Turn, O Lord, our captivity, as the streams in the south."],["5",[["Οἱ",1,128],["σπείροντες",790,137],["ἐν",4,1],["δάκρυσιν",1268,90],["ἐν",4,1],["ἀγαλλιάσει",1985,2],["θεριοῦσι",1546,207]],"They that sow in tears shall reap in joy."],["6",[["Πορευόμενοι",49,356],["ἐπορεύοντο",49,131],["καὶ",2,8],["ἔκλαιον",409,129],["βάλλοντες",774,137],["τὰ",1,42],["σπέρματα",214,43],["αὐτῶν",3,41],["ἐρχόμενοι",56,356],["δὲ",14,12],["ἥξουσιν",260,207],["ἐν",4,1],["ἀγαλλιάσει",1985,186],["αἴροντες",248,137],["τὰ",1,350],["δράγματα",1956,63],["αὐτῶν",3,41]],"They went on and wept as they cast their seeds; but they shall surely come with exultation, bringing their sheaves [with them]."]]