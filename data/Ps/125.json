[["1",[["Ὠδὴ",776,105],["τῶν",1,76],["ἀναβαθμῶν",1484,77],["Ἐν",4,1],["τῷ",1,110],["ἐπιστρέψαι",117,100],["Κύριον",7,7],["τὴν",1,9],["αἰχμαλωσίαν",461,10],["Σιὼν",334,2],["ἐγενήθημεν",30,491],["ὡσεὶ",343,17],["παρακεκλημένοι",434,370]],"A Song of Degrees. When the Lord turned the captivity of Sion, we became as comforted ones."],["2",[["Τότε",250,17],["ἐπλήσθη",909,38],["χαρᾶς",1125,19],["τὸ",1,32],["στόμα",123,33],["ἡμῶν",6,41],["καὶ",2,8],["ἡ",1,11],["γλῶσσα",388,13],["ἡμῶν",6,41],["ἀγαλλιάσεως",1981,19],["τότε",250,17],["ἐροῦσιν",165,350],["ἐν",4,1],["τοῖς",1,91],["ἔθνεσιν",60,92],["ἐμεγάλυνε",604,14],["Κύριος",7,5],["τοῦ",1,30],["ποιῆσαι",23,100],["μετʼ",29,1],["αὐτῶν",3,41]],"Then was our mouth filled with joy, and our tongue with exultation: then would they say among the Gentiles,"],["3",[["Ἐμεγάλυνε",604,14],["Κύριος",7,5],["τοῦ",1,30],["ποιῆσαι",23,100],["μεθʼ",29,1],["ἡμῶν",6,41],["ἐγενήθημεν",30,491],["εὐφραινόμενοι",244,351]],"The Lord has done great things among them. The Lord has done great things for us, we became joyful."],["4",[["Ἐπίστρεψον",117,198],["Κύριε",7,250],["τὴν",1,9],["αἰχμαλωσίαν",461,10],["ἡμῶν",6,41],["ὡς",36,8],["χειμάῤῥους",737,31],["ἐν",4,1],["τῷ",1,110],["Νότῳ",589,113]],"Turn, O Lord, our captivity, as the streams in the south."],["5",[["Οἱ",1,128],["σπείροντες",793,137],["ἐν",4,1],["δάκρυσιν",1268,90],["ἐν",4,1],["ἀγαλλιάσει",1981,2],["θεριοῦσι",1509,207]],"They that sow in tears shall reap in joy."],["6",[["Πορευόμενοι",49,351],["ἐπορεύοντο",49,131],["καὶ",2,8],["ἔκλαιον",412,129],["βάλλοντες",766,137],["τὰ",1,42],["σπέρματα",218,43],["αὐτῶν",3,41],["ἐρχόμενοι",55,351],["δὲ",14,12],["ἥξουσιν",260,207],["ἐν",4,1],["ἀγαλλιάσει",1981,188],["αἴροντες",206,137],["τὰ",1,346],["δράγματα",1956,63],["αὐτῶν",3,41]],"They went on and wept as they cast their seeds; but they shall surely come with exultation, bringing their sheaves [with them]."]]