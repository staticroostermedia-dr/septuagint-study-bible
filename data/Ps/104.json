[["1",[["Ἀλληλούϊα",1746,105],["Ἐξομολογεῖσθε",478,386],["τῷ",1,110],["Κυρίῳ",7,113],["καὶ",2,8],["ἐπικαλεῖσθε",340,68],["τὸ",1,32],["ὄνομα",55,33],["αὐτοῦ",3,48],["ἀπαγγείλατε",272,69],["ἐν",4,1],["τοῖς",1,91],["ἔθνεσι",59,92],["τὰ",1,42],["ἔργα",104,43],["αὐτοῦ",3,48]],"Alleluia. Give thanks to the Lord, and call upon his name; declare his works among the heathen."],["2",[["Ασατε",0,0],["αὐτῷ",3,49],["καὶ",2,8],["ψάλατε",901,69],["αὐτῷ",3,49],["διηγήσασθε",797,376],["πάντα",11,65],["τὰ",1,42],["θαυμάσια",885,65],["αὐτοῦ",3,48]],"Sing to him, yea, sing praises to him: tell forth all his wonderful works."],["3",[["Ἐπαινεῖσθε",1532,68],["ἐν",4,1],["τῷ",1,52],["ὀνόματι",55,53],["τῷ",1,52],["ἁγίῳ",75,34],["αὐτοῦ",3,48],["εὐφρανθήτω",242,25],["καρδία",63,13],["ζητούντων",190,164],["τὸν",1,6],["Κύριον",7,7]],"Glory in his holy name: let the heart of them that seek the Lord rejoice."],["4",[["Ζητήσατε",190,69],["τὸν",1,6],["Κύριον",7,7],["καὶ",2,8],["κραταιώθητε",734,358],["ζητήσατε",190,69],["τὸ",1,32],["πρόσωπον",47,33],["αὐτοῦ",3,48],["διαπαντός",506,17]],"Seek ye the Lord, and be strengthened; seek his face continually."],["5",[["Μνήσθητε",231,358],["τῶν",1,76],["θαυμασίων",885,163],["αὐτον",3,82],["ὧν",24,307],["ἐποίησε",23,3],["τὰ",1,42],["τέρατα",1005,43],["αὐτοῦ",3,48],["καὶ",2,8],["τὰ",1,42],["κρίματα",266,43],["τοῦ",1,23],["στόματος",123,24],["αὐτοῦ",3,144]],"Remember his wonderful works that he has done; his wonders, and the judgments of his mouth;"],["6",[["Σπέρμα",214,20],["Ἁβραὰμ",294,105],["δοῦλοι",136,51],["αὐτοῦ",3,48],["υἱοὶ",13,51],["Ἰακὼβ",146,105],["ἐκλεκτοὶ",551,130],["αὐτοῦ",3,48]],"[ye] seed of Abraam, his servants, [ye] children of Jacob, his chosen ones."],["7",[["Αὐτὸς",3,158],["Κύριος",7,5],["ὁ",1,4],["Θεὸς",20,5],["ἡμῶν",6,41],["ἐν",4,1],["πάσῃ",11,96],["τῇ",1,95],["γῇ",26,2],["τὰ",1,42],["κρίματα",266,43],["αὐτοῦ",3,48]],"He is the Lord our God; his judgments are in all the earth."],["8",[["Ἐμνήσθη",231,38],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["διαθήκης",168,19],["αὐτοῦ",3,48],["λόγου",48,21],["οὗ",120,17],["ἐνετείλατο",143,26],["εἰς",8,1],["χιλίας",1485,109],["γενεὰς",286,40]],"He has remembered his covenant for ever, the word which he commanded for a thousand generations:"],["9",[["ὃν",24,106],["διέθετο",617,26],["τῷ",1,110],["Ἁβραὰμ",294,105],["καὶ",2,8],["τοῦ",1,30],["ὅρκου",947,21],["αὐτοῦ",3,48],["τῷ",1,110],["Ἰσαάκ",448,105]],"which he established as a covenant to Abraam, and [he remembered] his oath to Isaac."],["10",[["Καὶ",2,8],["ἔστησεν",78,3],["αὐτὴν",3,98],["τῷ",1,110],["Ἰακὼβ",146,105],["εἰς",8,1],["πρόσταγμα",391,20],["καὶ",2,8],["τῷ",1,110],["Ἰσραὴλ",27,105],["εἰς",8,1],["διαθήκην",168,10],["αἰώνιον",388,37]],"And he established it to Jacob for an ordinance, and to Israel for an everlasting covenant;"],["11",[["λέγων",31,67],["σοὶ",5,151],["δώσω",33,157],["τὴν",1,9],["γῆν",26,10],["Χαναὰν",542,105],["σχοίνισμα",2394,20],["κληρονομίας",297,19],["ὑμῶν",5,136]],"saying, To thee will I give the land of Chanaan, the line of your inheritance:"],["12",[["Ἐν",4,1],["τῷ",1,110],["εἶναι",10,54],["αὐτοὺς",3,60],["ἀριθμῷ",353,113],["βραχεῖς",616,130],["ὀλιγοστοὺς",2007,58],["καὶ",2,8],["παροίκους",1421,58],["ἐν",4,1],["αὐτῇ",3,99]],"when they were few in number, very few, and sojourners in it."],["13",[["καὶ",2,8],["διῆλθον",427,141],["ἐξ",21,1],["ἔθνους",59,24],["εἰς",8,1],["ἔθνος",59,33],["καὶ",2,8],["ἐκ",21,1],["βασιλείας",157,19],["εἰς",8,1],["λαὸν",35,7],["ἕτερον",253,59]],"And they went from nation to nation, and from [one] kingdom to another people."],["14",[["οὐκ",12,17],["ἀφῆκεν",504,3],["ἄνθρωπον",43,7],["ἀδικῆσαι",819,100],["αὐτοὺς",3,60],["καὶ",2,8],["ἤλεγξεν",750,3],["ὑπὲρ",139,1],["αὐτῶν",3,41],["βασιλεῖς",22,51]],"He suffered no man to wrong them; and he rebuked kings for their sakes:"],["15",[["Μὴ",25,8],["ἅψησθε",462,133],["τῶν",1,76],["χριστῶν",1073,77],["μου",6,48],["καὶ",2,8],["ἐν",4,1],["τοῖς",1,138],["προφήταις",175,139],["μου",6,48],["μὴ",25,8],["πονηρεύεσθε",1387,68]],"[saying], Touch not my anointed ones; and do my prophets no harm."],["16",[["Καὶ",2,8],["ἐκάλεσε",128,3],["λιμὸν",500,7],["ἐπὶ",9,1],["τὴν",1,9],["γῆν",26,10],["πᾶν",11,29],["στήριγμα",2122,33],["ἄρτου",197,21],["συνέτριψεν",267,3]],"Moreover he called for a famine upon the land; he broke the whole support of bread."],["17",[["Ἀπέστειλεν",83,3],["ἔμπροσθεν",387,17],["αὐτῶν",3,41],["ἄνθρωπον",43,7],["εἰς",8,1],["δοῦλον",136,7],["ἐπράθη",1350,38],["Ἰωσήφ",262,105]],"He sent a man before them; Joseph was sold for a slave."],["18",[["Ἐταπείνωσαν",333,141],["ἐν",4,1],["πέδαις",2299,71],["τοὺς",1,56],["πόδας",208,31],["αὐτοῦ",3,48],["σίδηρον",791,7],["διῆλθεν",427,3],["ἡ",1,11],["ψυχὴ",62,13],["αὐτοῦ",3,48]],"They hurt his feet with fetters; his soul passed into iron,"],["19",[["Μέχρι",780,1],["τοῦ",1,30],["ἐλθεῖν",56,100],["τὸν",1,6],["λόγον",48,7],["αὐτοῦ",3,48],["τὸ",1,32],["λόγιον",1249,33],["τοῦ",1,30],["Κυρίου",7,21],["ἐπύρωσεν",939,3],["αὐτόν",3,82]],"until the time that his cause came on; the word of the Lord tried him as fire."],["20",[["Ἀπέστειλε",83,3],["βασιλεὺς",22,5],["καὶ",2,8],["ἔλυσεν",1381,3],["αὐτὸν",3,82],["ἄρχων",96,5],["λαῶν",35,77],["καὶ",2,8],["ἀφῆκεν",504,3],["αὐτόν",3,82]],"The king sent and loosed him; [even] the prince of the people, and let him go free."],["21",[["Κατέστησεν",313,3],["αὐτὸν",3,82],["κύριον",7,7],["τοῦ",1,30],["οἴκου",34,21],["αὐτοῦ",3,48],["καὶ",2,8],["ἄρχοντα",96,7],["πάσης",11,78],["τῆς",1,18],["κτήσεως",1440,19],["αὐτοῦ",3,48]],"He made him lord over his house, and ruler of all his substance;"],["22",[["τοῦ",1,30],["παιδεῦσαι",654,100],["τοὺς",1,56],["ἄρχοντας",96,31],["αὐτοῦ",3,48],["ὡς",36,8],["ἑαυτὸν",92,82],["καὶ",2,8],["τοὺς",1,56],["πρεσβυτέρους",329,31],["αὐτοῦ",3,48],["σοφίσαι",1785,100]],"to chastise his rulers at his pleasure, and to teach his elders wisdom."],["23",[["Καὶ",2,8],["εἰσῆλθεν",88,3],["Ἰσραὴλ",27,105],["εἰς",8,1],["Αἴγυπτον",93,10],["καὶ",2,8],["Ἰακὼβ",146,105],["παρῴκησεν",781,3],["ἐν",4,1],["γῇ",26,2],["Χάμ",0,0]],"Israel also came into Egypt, and Jacob sojourned in the land of Cham."],["24",[["Καὶ",2,8],["ηὔξησε",1179,3],["τὸν",1,6],["λαὸν",35,7],["αὐτοῦ",3,48],["σφόδρα",149,17],["καὶ",2,8],["ἐκραταίωσεν",734,3],["αὐτὸν",3,82],["ὑπὲρ",139,1],["τοὺς",1,56],["ἐχθροὺς",135,31],["αὐτοῦ",3,48]],"And he increased his people greatly, and made them stronger than their enemies."],["25",[["Καὶ",2,8],["μετέστρεψε",1635,3],["τὴν",1,9],["καρδίαν",63,10],["αὐτῶν",3,41],["τοῦ",1,30],["μισῆσαι",355,100],["τὸν",1,6],["λαὸν",35,7],["αὐτοῦ",3,48],["τοῦ",1,30],["δολιοῦσθαι",5612,104],["ἐν",4,1],["τοῖς",1,138],["δούλοις",136,139],["αὐτοῦ",3,48]],"And he turned their heart to hate his people, to deal craftily with his servants."],["26",[["Ἐξαπέστειλε",217,3],["Μωυσῆν",68,7],["τὸν",1,6],["δοῦλον",136,7],["αὐτοῦ",3,48],["Ἀαρὼν",159,5],["ὃν",24,106],["ἐξελέξατο",418,26],["αὐτόν",3,82]],"He sent forth Moses his servant, [and] Aaron whom he had chosen."],["27",[["Ἔθετο",109,26],["ἐν",4,1],["αὐτοῖς",3,142],["τοὺς",1,56],["λόγους",48,31],["τῶν",1,44],["σημείων",502,45],["αὐτοῦ",3,48],["καὶ",2,8],["τῶν",1,44],["τεράτων",1005,45],["ἐν",4,1],["γῇ",26,2],["Χάμ",0,0]],"He established among them his signs, and [his] wonders in the land of Cham."],["28",[["Ἐξαπέστειλε",217,3],["σκότος",503,5],["καὶ",2,8],["ἐσκότασε",3961,3],["καὶ",2,8],["παρεπίκραναν",2037,141],["τοὺς",1,56],["λόγους",48,31],["αὐτοῦ",3,48]],"He sent forth darkness, and made it dark; yet they rebelled against his words."],["29",[["Μετέστρεψε",1635,3],["τὰ",1,42],["ὕδατα",85,43],["αὐτῶν",3,41],["εἰς",8,1],["αἷμα",148,33],["καὶ",2,8],["ἀπέκτεινε",298,3],["τοὺς",1,56],["ἰχθύας",1371,31],["αὐτῶν",3,41]],"He turned their waters into blood, and slew their fish."],["30",[["Ἐξῆρψεν",0,0],["ἡ",1,11],["γῆ",26,13],["αὐτῶν",3,41],["βατράχους",2173,31],["ἐν",4,1],["τοῖς",1,91],["ταμείοις",1526,92],["τῶν",1,76],["βασιλέων",22,77],["αὐτῶν",3,41]],"Their land produced frogs abundantly, in the chambers of their kings."],["31",[["Εἶπε",18,3],["καὶ",2,8],["ἦλθε",56,3],["κυνόμυια",2922,13],["καὶ",2,8],["σκνίπες",0,0],["ἐν",4,1],["πᾶσι",11,90],["τοῖς",1,91],["ὁρίοις",234,92],["αὐτῶν",3,41]],"He spoke, and the dog-fly came, and lice in all their coasts."],["32",[["Ἔθετο",109,26],["τὰς",1,39],["βροχὰς",5531,40],["αὐτῶν",3,41],["χάλαζαν",1310,10],["πῦρ",118,33],["καταφλέγον",3287,47],["ἐν",4,1],["τῇ",1,95],["γῇ",26,2],["αὐτῶν",3,41]],"He turned their rain into hail, [and sent] flaming fire in their land."],["33",[["Καὶ",2,8],["ἐπάταξε",145,3],["τὰς",1,39],["ἀμπέλους",810,40],["αὐτῶν",3,41],["καὶ",2,8],["τὰς",1,39],["συκὰς",5087,13],["αὐτῶν",3,41],["καὶ",2,8],["συνέτριψε",267,3],["πᾶν",11,29],["ξύλον",196,33],["ὁρίου",234,24],["αὐτῶν",3,41]],"And he smote their vines and their fig-trees; and broke every tree of their coast."],["34",[["Εἶπε",18,3],["καὶ",2,8],["ἦλθεν",56,3],["ἀκρὶς",1359,13],["καὶ",2,8],["βροῦχος",3048,105],["οὗ",120,17],["οὐκ",12,17],["ἦν",10,14],["ἀριθμὸς",353,5]],"He spoke, and the locust came, and caterpillars innumerable,"],["35",[["καὶ",2,8],["κατέφαγε",404,3],["πάντα",11,59],["τὸν",1,6],["χόρτον",1044,7],["ἐν",4,1],["τῇ",1,95],["γῇ",26,2],["αὐτῶν",3,41],["καὶ",2,8],["κατέφαγε",404,3],["τὸν",1,6],["καρπὸν",446,7],["τῆς",1,18],["γῆς",26,19],["αὐτῶν",3,41]],"and devoured all the grass in their land, and devoured the fruit of their ground."],["36",[["Καὶ",2,8],["ἐπάταξε",145,3],["πᾶν",11,29],["πρωτότοκον",444,29],["ἐκ",21,1],["τῆς",1,18],["γῆς",26,19],["αὐτῶν",3,41],["ἀπαρχὴν",691,10],["παντὸς",11,153],["πόνου",564,21],["αὐτῶν",3,41]],"He smote also every first-born of their land, the first-fruits of all their labour."],["37",[["Καὶ",2,8],["ἐξήγαγεν",299,3],["αὐτοὺς",3,60],["ἐν",4,1],["ἀργυρίῳ",150,53],["καὶ",2,8],["χρυσίῳ",202,53],["καὶ",2,8],["οὐκ",12,17],["ἦν",10,14],["ἐν",4,1],["ταῖς",1,70],["φυλαῖς",142,71],["αὐτῶν",3,41],["ὁ",1,4],["ἀσθενῶν",768,67]],"And he brought them out with silver and gold; and there was not a feeble one among their tribes."],["38",[["Εὐφράνθη",242,38],["Αἴγυπτος",93,1