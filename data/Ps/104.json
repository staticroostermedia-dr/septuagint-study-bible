[["1",[["Ἀλληλούϊα",1749,105],["Ἐξομολογεῖσθε",479,382],["τῷ",1,110],["Κυρίῳ",7,113],["καὶ",2,8],["ἐπικαλεῖσθε",341,68],["τὸ",1,32],["ὄνομα",57,33],["αὐτοῦ",3,48],["ἀπαγγείλατε",273,69],["ἐν",4,1],["τοῖς",1,91],["ἔθνεσι",60,92],["τὰ",1,42],["ἔργα",105,43],["αὐτοῦ",3,48]],"Alleluia. Give thanks to the Lord, and call upon his name; declare his works among the heathen."],["2",[["Ασατε",0,0],["αὐτῷ",3,49],["καὶ",2,8],["ψάλατε",913,69],["αὐτῷ",3,49],["διηγήσασθε",800,371],["πάντα",11,65],["τὰ",1,42],["θαυμάσια",884,65],["αὐτοῦ",3,48]],"Sing to him, yea, sing praises to him: tell forth all his wonderful works."],["3",[["Ἐπαινεῖσθε",1534,68],["ἐν",4,1],["τῷ",1,52],["ὀνόματι",57,53],["τῷ",1,52],["ἁγίῳ",75,34],["αὐτοῦ",3,48],["εὐφρανθήτω",244,25],["καρδία",64,13],["ζητούντων",191,164],["τὸν",1,6],["Κύριον",7,7]],"Glory in his holy name: let the heart of them that seek the Lord rejoice."],["4",[["Ζητήσατε",191,69],["τὸν",1,6],["Κύριον",7,7],["καὶ",2,8],["κραταιώθητε",729,353],["ζητήσατε",191,69],["τὸ",1,32],["πρόσωπον",47,33],["αὐτοῦ",3,48],["διαπαντός",510,17]],"Seek ye the Lord, and be strengthened; seek his face continually."],["5",[["Μνήσθητε",230,353],["τῶν",1,76],["θαυμασίων",884,163],["αὐτον",3,82],["ὧν",24,303],["ἐποίησε",23,3],["τὰ",1,42],["τέρατα",1005,43],["αὐτοῦ",3,48],["καὶ",2,8],["τὰ",1,42],["κρίματα",267,43],["τοῦ",1,23],["στόματος",123,24],["αὐτοῦ",3,144]],"Remember his wonderful works that he has done; his wonders, and the judgments of his mouth;"],["6",[["Σπέρμα",218,20],["Ἁβραὰμ",294,105],["δοῦλοι",136,51],["αὐτοῦ",3,48],["υἱοὶ",13,51],["Ἰακὼβ",146,105],["ἐκλεκτοὶ",552,130],["αὐτοῦ",3,48]],"[ye] seed of Abraam, his servants, [ye] children of Jacob, his chosen ones."],["7",[["Αὐτὸς",3,158],["Κύριος",7,5],["ὁ",1,4],["Θεὸς",20,5],["ἡμῶν",6,41],["ἐν",4,1],["πάσῃ",11,96],["τῇ",1,95],["γῇ",26,2],["τὰ",1,42],["κρίματα",267,43],["αὐτοῦ",3,48]],"He is the Lord our God; his judgments are in all the earth."],["8",[["Ἐμνήσθη",230,38],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["διαθήκης",169,19],["αὐτοῦ",3,48],["λόγου",48,21],["οὗ",120,17],["ἐνετείλατο",143,26],["εἰς",8,1],["χιλίας",1483,109],["γενεὰς",286,40]],"He has remembered his covenant for ever, the word which he commanded for a thousand generations:"],["9",[["ὃν",24,106],["διέθετο",619,26],["τῷ",1,110],["Ἁβραὰμ",294,105],["καὶ",2,8],["τοῦ",1,30],["ὅρκου",946,21],["αὐτοῦ",3,48],["τῷ",1,110],["Ἰσαάκ",451,105]],"which he established as a covenant to Abraam, and [he remembered] his oath to Isaac."],["10",[["Καὶ",2,8],["ἔστησεν",78,3],["αὐτὴν",3,98],["τῷ",1,110],["Ἰακὼβ",146,105],["εἰς",8,1],["πρόσταγμα",393,20],["καὶ",2,8],["τῷ",1,110],["Ἰσραὴλ",27,105],["εἰς",8,1],["διαθήκην",169,10],["αἰώνιον",391,37]],"And he established it to Jacob for an ordinance, and to Israel for an everlasting covenant;"],["11",[["λέγων",31,67],["σοὶ",5,151],["δώσω",33,157],["τὴν",1,9],["γῆν",26,10],["Χαναὰν",544,105],["σχοίνισμα",2386,20],["κληρονομίας",299,19],["ὑμῶν",5,136]],"saying, To thee will I give the land of Chanaan, the line of your inheritance:"],["12",[["Ἐν",4,1],["τῷ",1,110],["εἶναι",10,54],["αὐτοὺς",3,60],["ἀριθμῷ",355,113],["βραχεῖς",618,130],["ὀλιγοστοὺς",1999,58],["καὶ",2,8],["παροίκους",1421,58],["ἐν",4,1],["αὐτῇ",3,99]],"when they were few in number, very few, and sojourners in it."],["13",[["καὶ",2,8],["διῆλθον",423,141],["ἐξ",21,1],["ἔθνους",60,24],["εἰς",8,1],["ἔθνος",60,33],["καὶ",2,8],["ἐκ",21,1],["βασιλείας",157,19],["εἰς",8,1],["λαὸν",35,7],["ἕτερον",253,59]],"And they went from nation to nation, and from [one] kingdom to another people."],["14",[["οὐκ",12,17],["ἀφῆκεν",501,3],["ἄνθρωπον",43,7],["ἀδικῆσαι",760,100],["αὐτοὺς",3,60],["καὶ",2,8],["ἤλεγξεν",752,3],["ὑπὲρ",139,1],["αὐτῶν",3,41],["βασιλεῖς",22,51]],"He suffered no man to wrong them; and he rebuked kings for their sakes:"],["15",[["Μὴ",25,8],["ἅψησθε",465,133],["τῶν",1,76],["χριστῶν",1072,77],["μου",6,48],["καὶ",2,8],["ἐν",4,1],["τοῖς",1,138],["προφήταις",176,139],["μου",6,48],["μὴ",25,8],["πονηρεύεσθε",1331,68]],"[saying], Touch not my anointed ones; and do my prophets no harm."],["16",[["Καὶ",2,8],["ἐκάλεσε",128,3],["λιμὸν",503,7],["ἐπὶ",9,1],["τὴν",1,9],["γῆν",26,10],["πᾶν",11,29],["στήριγμα",2113,33],["ἄρτου",197,21],["συνέτριψεν",268,3]],"Moreover he called for a famine upon the land; he broke the whole support of bread."],["17",[["Ἀπέστειλεν",84,3],["ἔμπροσθεν",390,17],["αὐτῶν",3,41],["ἄνθρωπον",43,7],["εἰς",8,1],["δοῦλον",136,7],["ἐπράθη",1354,38],["Ἰωσήφ",262,105]],"He sent a man before them; Joseph was sold for a slave."],["18",[["Ἐταπείνωσαν",322,141],["ἐν",4,1],["πέδαις",2287,71],["τοὺς",1,56],["πόδας",210,31],["αὐτοῦ",3,48],["σίδηρον",794,7],["διῆλθεν",423,3],["ἡ",1,11],["ψυχὴ",63,13],["αὐτοῦ",3,48]],"They hurt his feet with fetters; his soul passed into iron,"],["19",[["Μέχρι",781,1],["τοῦ",1,30],["ἐλθεῖν",55,100],["τὸν",1,6],["λόγον",48,7],["αὐτοῦ",3,48],["τὸ",1,32],["λόγιον",1248,33],["τοῦ",1,30],["Κυρίου",7,21],["ἐπύρωσεν",926,3],["αὐτόν",3,82]],"until the time that his cause came on; the word of the Lord tried him as fire."],["20",[["Ἀπέστειλε",84,3],["βασιλεὺς",22,5],["καὶ",2,8],["ἔλυσεν",1381,3],["αὐτὸν",3,82],["ἄρχων",96,5],["λαῶν",35,77],["καὶ",2,8],["ἀφῆκεν",501,3],["αὐτόν",3,82]],"The king sent and loosed him; [even] the prince of the people, and let him go free."],["21",[["Κατέστησεν",314,3],["αὐτὸν",3,82],["κύριον",7,7],["τοῦ",1,30],["οἴκου",34,21],["αὐτοῦ",3,48],["καὶ",2,8],["ἄρχοντα",96,7],["πάσης",11,78],["τῆς",1,18],["κτήσεως",1274,19],["αὐτοῦ",3,48]],"He made him lord over his house, and ruler of all his substance;"],["22",[["τοῦ",1,30],["παιδεῦσαι",643,100],["τοὺς",1,56],["ἄρχοντας",96,31],["αὐτοῦ",3,48],["ὡς",36,8],["ἑαυτὸν",92,82],["καὶ",2,8],["τοὺς",1,56],["πρεσβυτέρους",332,31],["αὐτοῦ",3,48],["σοφίσαι",1786,100]],"to chastise his rulers at his pleasure, and to teach his elders wisdom."],["23",[["Καὶ",2,8],["εἰσῆλθεν",86,3],["Ἰσραὴλ",27,105],["εἰς",8,1],["Αἴγυπτον",93,10],["καὶ",2,8],["Ἰακὼβ",146,105],["παρῴκησεν",782,3],["ἐν",4,1],["γῇ",26,2],["Χάμ",0,0]],"Israel also came into Egypt, and Jacob sojourned in the land of Cham."],["24",[["Καὶ",2,8],["ηὔξησε",1180,3],["τὸν",1,6],["λαὸν",35,7],["αὐτοῦ",3,48],["σφόδρα",150,17],["καὶ",2,8],["ἐκραταίωσεν",729,3],["αὐτὸν",3,82],["ὑπὲρ",139,1],["τοὺς",1,56],["ἐχθροὺς",135,31],["αὐτοῦ",3,48]],"And he increased his people greatly, and made them stronger than their enemies."],["25",[["Καὶ",2,8],["μετέστρεψε",1635,3],["τὴν",1,9],["καρδίαν",64,10],["αὐτῶν",3,41],["τοῦ",1,30],["μισῆσαι",351,100],["τὸν",1,6],["λαὸν",35,7],["αὐτοῦ",3,48],["τοῦ",1,30],["δολιοῦσθαι",5583,104],["ἐν",4,1],["τοῖς",1,138],["δούλοις",136,139],["αὐτοῦ",3,48]],"And he turned their heart to hate his people, to deal craftily with his servants."],["26",[["Ἐξαπέστειλε",220,3],["Μωυσῆν",69,7],["τὸν",1,6],["δοῦλον",136,7],["αὐτοῦ",3,48],["Ἀαρὼν",159,5],["ὃν",24,106],["ἐξελέξατο",420,26],["αὐτόν",3,82]],"He sent forth Moses his servant, [and] Aaron whom he had chosen."],["27",[["Ἔθετο",110,26],["ἐν",4,1],["αὐτοῖς",3,142],["τοὺς",1,56],["λόγους",48,31],["τῶν",1,44],["σημείων",505,45],["αὐτοῦ",3,48],["καὶ",2,8],["τῶν",1,44],["τεράτων",1005,45],["ἐν",4,1],["γῇ",26,2],["Χάμ",0,0]],"He established among them his signs, and [his] wonders in the land of Cham."],["28",[["Ἐξαπέστειλε",220,3],["σκότος",506,5],["καὶ",2,8],["ἐσκότασε",3950,3],["καὶ",2,8],["παρεπίκραναν",1685,141],["τοὺς",1,56],["λόγους",48,31],["αὐτοῦ",3,48]],"He sent forth darkness, and made it dark; yet they rebelled against his words."],["29",[["Μετέστρεψε",1635,3],["τὰ",1,42],["ὕδατα",85,43],["αὐτῶν",3,41],["εἰς",8,1],["αἷμα",148,33],["καὶ",2,8],["ἀπέκτεινε",300,3],["τοὺς",1,56],["ἰχθύας",1372,31],["αὐτῶν",3,41]],"He turned their waters into blood, and slew their fish."],["30",[["Ἐξῆρψεν",0,0],["ἡ",1,11],["γῆ",26,13],["αὐτῶν",3,41],["βατράχους",2164,31],["ἐν",4,1],["τοῖς",1,91],["ταμείοις",1528,92],["τῶν",1,76],["βασιλέων",22,77],["αὐτῶν",3,41]],"Their land produced frogs abundantly, in the chambers of their kings."],["31",[["Εἶπε",18,3],["καὶ",2,8],["ἦλθε",55,3],["κυνόμυια",2907,13],["καὶ",2,8],["σκνίπες",0,0],["ἐν",4,1],["πᾶσι",11,90],["τοῖς",1,91],["ὁρίοις",236,92],["αὐτῶν",3,41]],"He spoke, and the dog-fly came, and lice in all their coasts."],["32",[["Ἔθετο",110,26],["τὰς",1,39],["βροχὰς",5501,40],["αὐτῶν",3,41],["χάλαζαν",1191,10],["πῦρ",118,33],["καταφλέγον",3284,47],["ἐν",4,1],["τῇ",1,95],["γῇ",26,2],["αὐτῶν",3,41]],"He turned their rain into hail, [and sent] flaming fire in their land."],["33",[["Καὶ",2,8],["ἐπάταξε",145,3],["τὰς",1,39],["ἀμπέλους",812,40],["αὐτῶν",3,41],["καὶ",2,8],["τὰς",1,39],["συκὰς",1561,13],["αὐτῶν",3,41],["καὶ",2,8],["συνέτριψε",268,3],["πᾶν",11,29],["ξύλον",196,33],["ὁρίου",236,24],["αὐτῶν",3,41]],"And he smote their vines and their fig-trees; and broke every tree of their coast."],["34",[["Εἶπε",18,3],["καὶ",2,8],["ἦλθεν",55,3],["ἀκρὶς",1361,13],["καὶ",2,8],["βροῦχος",3037,105],["οὗ",120,17],["οὐκ",12,17],["ἦν",10,14],["ἀριθμὸς",355,5]],"He spoke, and the locust came, and caterpillars innumerable,"],["35",[["καὶ",2,8],["κατέφαγε",407,3],["πάντα",11,59],["τὸν",1,6],["χόρτον",1046,7],["ἐν",4,1],["τῇ",1,95],["γῇ",26,2],["αὐτῶν",3,41],["καὶ",2,8],["κατέφαγε",407,3],["τὸν",1,6],["καρπὸν",448,7],["τῆς",1,18],["γῆς",26,19],["αὐτῶν",3,41]],"and devoured all the grass in their land, and devoured the fruit of their ground."],["36",[["Καὶ",2,8],["ἐπάταξε",145,3],["πᾶν",11,29],["πρωτότοκον",445,29],["ἐκ",21,1],["τῆς",1,18],["γῆς",26,19],["αὐτῶν",3,41],["ἀπαρχὴν",693,10],["παντὸς",11,153],["πόνου",566,21],["αὐτῶν",3,41]],"He smote also every first-born of their land, the first-fruits of all their labour."],["37",[["Καὶ",2,8],["ἐξήγαγεν",295,3],["αὐτοὺς",3,60],["ἐν",4,1],["ἀργυρίῳ",152,53],["καὶ",2,8],["χρυσίῳ",202,53],["καὶ",2,8],["οὐκ",12,17],["ἦν",10,14],["ἐν",4,1],["ταῖς",1,70],["φυλαῖς",142,71],["αὐτῶν",3,41],["ὁ",1,4],["ἀσθενῶν",771,67]],"And he brought them out with silver and gold; and there was not a feeble one among their tribes."],["38",[["Εὐφράνθη",244,38],["Αἴγυπτος",93,13],["ἐν",4,1],["τῇ",1,95],["ἐξόδῳ",762,2],["αὐτῶν",3,41],["ὅτι",19,8],["ἐπέπεσεν",995,3],["ὁ",1,4],["φόβος",333,5],["αὐτῶν",3,41],["ἐπʼ",9,1],["αὐτούς",3,60]],"Egypt rejoiced at their departing; for the fear of them fell upon them."],["39",[["Διεπέτασε",1815,3],["νεφέλην",444,10],["εἰς",8,1],["σκέπην",1188,10],["αὐτοῖς",3,142],["καὶ",2,8],["πῦρ",118,33],["τοῦ",1,30],["φωτίσαι",1230,100],["αὐτοῖς",3,142],["τὴν",1,9],["νύκτα",219,10]],"He spread out a cloud for a covering to them, and fire to give them light by night."],["40",[["Ἤτησαν",0,0],["καὶ",2,8],["ἦλθεν",55,3],["ὀρτυγομήτρα",3763,13],["καὶ",2,8],["ἄρτον",197,7],["οὐρανοῦ",94,21],["ἐνέπλησεν",427,3],["αὐτούς",3,60]],"They asked, and the quail came, and he satisfied them with the bread of heaven."],["41",[["Διέῤῥηξε",647,3],["πέτραν",548,10],["καὶ",2,8],["ἐῤῥύησαν",667,94],["ὕδατα",85,43],["ἐπορεύθησαν",49,94],["ἐν",4,1],["ἀνύδροις",1701,215],["ποταμοί",249,51]],"He clave the rock, and the waters flowed; rivers ran in dry places."],["42",[["Ὅτι",19,8],["ἐμνήσθη",230,38],["τοῦ",1,30],["λόγου",48,21],["τοῦ",1,30],["ἁγίου",75,153],["αὐτοῦ",3,48],["τοῦ",1,30],["πρὸς",15,1],["Ἀβραὰμ",294,105],["τὸν",1,6],["δοῦλον",136,7],["αὐτοῦ",3,48]],"For he remembered his holy word, which [he promised] to Abraam his servant."],["43",[["Καὶ",2,8],["ἐξήγαγε",295,3],["τὸν",1,6],["λαὸν",35,7],["αὐτοῦ",3,48],["ἐν",4,1],["ἀγαλλιάσει",1981,2],["καὶ",2,8],["τοὺς",1,56],["ἐκλεκτοὺς",552,58],["αὐτοῦ",3,48],["ἐν",4,1],["εὐφροσύνῃ",360,2]],"And he brought out his people with exultation, and his chosen with joy;"],["44",[["Καὶ",2,8],["ἔδωκεν",33,3],["αὐτοῖς",3,142],["χώρας",278,19],["ἐθνῶν",60,45],["καὶ",2,8],["πόνους",566,31],["λαῶν",35,77],["ἐκληρονόμησαν",370,141]],"and gave them the lands of the heathen; and they inherited the labours of the people;"],["45",[["Ὅπως",240,8],["ἂν",83,12],["φυλάξωσι",125,224],["τὰ",1,42],["δικαιώματα",428,43],["αὐτοῦ",3,48],["καὶ",2,8],["τὸν",1,6],["νόμον",140,7],["αὐτοῦ",3,48],["ἐκζητήσωσιν",460,224]],"that they might keep his ordinances, and diligently seek his law."]]