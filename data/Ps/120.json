[["1",[["Ὠδὴ",773,105],["τῶν",1,76],["ἀναβαθμῶν",1486,77],["Ἦρα",248,147],["τοὺς",1,56],["ὀφθαλμούς",91,31],["μου",6,48],["εἰς",8,1],["τὰ",1,42],["ὄρη",86,43],["ὅθεν",1154,17],["ἥξει",260,120],["ἡ",1,11],["βοήθειά",761,13],["μου",6,48]],"A Song of Degrees. I lifted up mine eyes to the mountains, whence my help shall come."],["2",[["Ἡ",1,11],["βοήθειά",761,13],["μου",6,48],["παρὰ",72,1],["Κυρίου",7,21],["τοῦ",1,30],["ποιήσαντος",23,521],["τὸν",1,6],["οὐρανὸν",94,7],["καὶ",2,8],["τὴν",1,9],["γῆν",26,10]],"My help [shall come] from the Lord, who made the heaven and the earth."],["3",[["Μὴ",25,8],["δῴης",0,0],["εἰς",8,1],["σάλον",2642,7],["τὸν",1,6],["πόδα",208,7],["σου",5,146],["μηδὲ",412,12],["νυστάξῃ",2478,116],["ὁ",1,4],["φυλάσσων",127,67],["σε",5,161]],"Let not thy foot be moved; and let not thy keeper slumber."],["4",[["Ἰδοὺ",51,17],["οὐ",12,17],["νυστάξει",2478,120],["οὐδὲ",105,12],["ὑπνώσει",1665,120],["ὁ",1,4],["φυλάσσων",127,67],["τὸν",1,6],["Ἰσραήλ",27,105]],"Behold, he that keeps Israel shall not slumber nor sleep."],["5",[["Κύριος",7,5],["φυλάξει",127,120],["σε",5,161],["Κύριος",7,5],["σκέπη",1189,13],["σου",5,146],["ἐπὶ",9,1],["χεῖρα",37,10],["δεξιάν",282,37],["σου",5,146]],"The Lord shall keep thee: the Lord is thy shelter upon thy right hand."],["6",[["Ἡμέρας",28,19],["ὁ",1,4],["ἥλιος",320,5],["οὐ",12,17],["συγκαύσει",3145,120],["σε",5,161],["οὐδὲ",105,12],["ἡ",1,11],["σελήνη",1211,13],["τὴν",1,9],["νύκτα",216,10]],"The sun shall not burn thee by day, neither the moon by night."],["7",[["Κύριος",7,5],["φυλάξαι",127,100],["σε",5,161],["ἀπὸ",17,1],["παντὸς",11,153],["κακοῦ",161,153],["φυλάξει",127,120],["τὴν",1,9],["ψυχήν",62,10],["σου",5,146],["ὁ",1,4],["Κύριος",7,5]],"May the Lord preserve thee from all evil: the Lord shall keep thy soul."],["8",[["Κύριος",7,5],["φυλάξει",127,120],["τὴν",1,9],["εἴσοδόν",1002,10],["σου",5,146],["καὶ",2,8],["τὴν",1,9],["ἔξοδόν",758,10],["σου",5,146],["ἀπὸ",17,1],["τοῦ",1,30],["νῦν",89,17],["καὶ",2,8],["ἕως",42,8],["τοῦ",1,30],["αἰῶνος",100,21]],"The Lord shall keep thy coming in, and thy going out, from henceforth and even for ever."]]