[["1",[["Ὠδὴ",776,105],["τῶν",1,76],["ἀναβαθμῶν",1484,77],["Ἦρα",206,147],["τοὺς",1,56],["ὀφθαλμούς",91,31],["μου",6,48],["εἰς",8,1],["τὰ",1,42],["ὄρη",87,43],["ὅθεν",1153,17],["ἥξει",260,120],["ἡ",1,11],["βοήθειά",765,13],["μου",6,48]],"A Song of Degrees. I lifted up mine eyes to the mountains, whence my help shall come."],["2",[["Ἡ",1,11],["βοήθειά",765,13],["μου",6,48],["παρὰ",73,1],["Κυρίου",7,21],["τοῦ",1,30],["ποιήσαντος",23,513],["τὸν",1,6],["οὐρανὸν",94,7],["καὶ",2,8],["τὴν",1,9],["γῆν",26,10]],"My help [shall come] from the Lord, who made the heaven and the earth."],["3",[["Μὴ",25,8],["δῴης",0,0],["εἰς",8,1],["σάλον",2637,7],["τὸν",1,6],["πόδα",210,7],["σου",5,146],["μηδὲ",414,12],["νυστάξῃ",2471,116],["ὁ",1,4],["φυλάσσων",125,67],["σε",5,161]],"Let not thy foot be moved; and let not thy keeper slumber."],["4",[["Ἰδοὺ",51,17],["οὐ",12,17],["νυστάξει",2471,120],["οὐδὲ",106,12],["ὑπνώσει",1664,120],["ὁ",1,4],["φυλάσσων",125,67],["τὸν",1,6],["Ἰσραήλ",27,105]],"Behold, he that keeps Israel shall not slumber nor sleep."],["5",[["Κύριος",7,5],["φυλάξει",125,120],["σε",5,161],["Κύριος",7,5],["σκέπη",1188,13],["σου",5,146],["ἐπὶ",9,1],["χεῖρα",37,10],["δεξιάν",282,37],["σου",5,146]],"The Lord shall keep thee: the Lord is thy shelter upon thy right hand."],["6",[["Ἡμέρας",28,19],["ὁ",1,4],["ἥλιος",323,5],["οὐ",12,17],["συγκαύσει",3137,120],["σε",5,161],["οὐδὲ",106,12],["ἡ",1,11],["σελήνη",1207,13],["τὴν",1,9],["νύκτα",219,10]],"The sun shall not burn thee by day, neither the moon by night."],["7",[["Κύριος",7,5],["φυλάξαι",125,100],["σε",5,161],["ἀπὸ",17,1],["παντὸς",11,153],["κακοῦ",161,153],["φυλάξει",125,120],["τὴν",1,9],["ψυχήν",63,10],["σου",5,146],["ὁ",1,4],["Κύριος",7,5]],"May the Lord preserve thee from all evil: the Lord shall keep thy soul."],["8",[["Κύριος",7,5],["φυλάξει",125,120],["τὴν",1,9],["εἴσοδόν",1002,10],["σου",5,146],["καὶ",2,8],["τὴν",1,9],["ἔξοδόν",762,10],["σου",5,146],["ἀπὸ",17,1],["τοῦ",1,30],["νῦν",90,17],["καὶ",2,8],["ἕως",42,8],["τοῦ",1,30],["αἰῶνος",100,21]],"The Lord shall keep thy coming in, and thy going out, from henceforth and even for ever."]]