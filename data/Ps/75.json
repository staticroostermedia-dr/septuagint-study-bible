[["1",[["Εἰς",8,1],["τὸ",1,32],["τέλος",369,33],["ἐν",4,1],["ὕμνοις",1499,139],["ψαλμὸς",639,5],["τῷ",1,110],["Ἀσάφ",1105,5],["ᾠδὴ",773,13],["πρὸς",15,1],["τὸν",1,6],["Ἀσσύριον",414,59]],"For the end, among the Hymns, a Psalm for Asaph; a Song for the Assyrian."],["2",[["Γνωστὸς",1618,16],["ἐν",4,1],["τῇ",1,95],["Ἰουδαίᾳ",491,2],["ὁ",1,4],["Θεὸς",20,5],["ἐν",4,1],["τῷ",1,110],["Ἰσραὴλ",27,105],["μέγα",65,29],["τὸ",1,32],["ὄνομα",55,33],["αὐτοῦ",3,48]],"God is known in Judea; his name is great in Israel."],["3",[["Καὶ",2,8],["ἐγενήθη",30,38],["ἐν",4,1],["εἰρήνῃ",210,2],["ὁ",1,4],["τόπος",99,5],["αὐτοῦ",3,48],["καὶ",2,8],["τὸ",1,32],["κατοικητήριον",2027,33],["αὐτοῦ",3,48],["ἐν",4,1],["Σιών",331,2]],"And his place has been in peace, and his dwelling-place in Sion."],["4",[["Ἐκεῖ",76,17],["συνέτριψε",267,3],["τὰ",1,42],["κράτη",1139,43],["τῶν",1,44],["τόξων",712,45],["ὅπλον",760,20],["καὶ",2,8],["ῥομφαίαν",247,10],["καὶ",2,8],["πόλεμον",163,7],["διάψαλμα",687,20]],"There he broke the power of the bows, the shield, and the sword, and the battle. Pause."],["5",[["Φωτίζεις",1232,145],["σὺ",5,156],["θαυμαστῶς",1074,17],["ἀπὸ",17,1],["ὀρέων",86,45],["αἰωνίων",388,79]],"Thou dost wonderfully shine forth from the everlasting mountains."],["6",[["ἐταράχθησαν",508,94],["πάντες",11,130],["οἱ",1,128],["ἀσύνετοι",2520,130],["τῇ",1,95],["καρδίᾳ",63,2],["ὕπνωσαν",1665,141],["ὕπνον",1010,7],["αὐτῶν",3,41],["καὶ",2,8],["οὐχ",12,17],["εὗρον",106,141],["οὐδὲν",225,29],["πάντες",11,130],["οἱ",1,128],["ἄνδρες",38,51],["τοῦ",1,30],["πλούτου",572,21],["ταῖς",1,70],["χερσὶν",37,71],["αὐτῶν",3,41]],"All the simple ones in heart were troubled; all the men of wealth have slept their sleep, and have found nothing in their hands."],["7",[["Ἀπὸ",17,1],["ἐπιτιμήσεώς",3449,19],["σου",5,146],["ὁ",1,4],["Θεὸς",20,5],["Ἰακὼβ",146,105],["ἐνύσταξαν",2478,141],["οἱ",1,128],["ἐπιβεβηκότες",881,264],["τοὺς",1,56],["ἵππους",308,31]],"At thy rebuke, O God of Jacob, the riders on horses slumbered."],["8",[["Σὺ