[["1",[["Εἰς",8,1],["τὸ",1,32],["τέλος",373,33],["ὑπὲρ",139,1],["τῶν",1,76],["ληνῶν",1769,77],["ψαλμὸς",644,5],["τῷ",1,110],["Δαυίδ",52,105]],"For the end, concerning the wine-presses, a Psalm of David."],["2",[["Κύριε",7,250],["ὁ",1,4],["Κύριος",7,5],["ἡμῶν",6,41],["ὡς",36,8],["θαυμαστὸν",1073,28],["τὸ",1,27],["ὄνομά",57,20],["σου",5,146],["ἐν",4,1],["πάσῃ",11,96],["τῇ",1,95],["γῇ",26,2],["ὅτι",19,8],["ἐπῄρθη",661,38],["ἡ",1,11],["μεγαλοπρέπειά",2738,13],["σου",5,146],["ὑπεράνω",1946,17],["τῶν",1,76],["οὐρανῶν",94,77]],"O Lord, our Lord, how wonderful is thy name in all the earth! for thy magnificence is exalted above the heavens."],["3",[["Ἐκ",21,1],["στόματος",123,24],["νηπίων",1016,163],["καὶ",2,8],["θηλαζόντων",1468,164],["κατηρτίσω",1888,169],["αἶνον",1763,7],["ἕνεκα",447,1],["τῶν",1,76],["ἐχθρῶν",135,77],["σου",5,146],["τοῦ",1,30],["καταλῦσαι",861,100],["ἐχθρὸν",135,7],["καὶ",2,8],["ἐκδικητήν",9286,7]],"Out of the mouth of babes and sucklings hast thou perfected praise, because of thine enemies; that thou mightest put down the enemy and avenger."],["4",[["Ὅτι",19,8],["ὄψομαι",112,177],["τοὺς",1,56],["οὐρανοὺς",94,31],["ἔργα",105,43],["τῶν",1,76],["δακτύλων",1182,77],["σου",5,146],["σελήνην",1207,10],["καὶ",2,8],["ἀστέρας",1699,31],["ἃ",1,11],["σὺ",5,156],["ἐθεμελίωσας",1116,154]],"For I will regard the heavens, the work of thy fingers; the moon and stars, which thou hast established."],["5",[["Τί",39,119],["ἐστιν",10,87],["ἄνθρωπος",43,5],["ὅτι",19,8],["μιμνήσκῃ",230,166],["αὐτοῦ",3,48],["ἢ",61,8],["υἱὸς",13,5],["ἀνθρώπου",43,21],["ὅτι",19,8],["ἐπισκέπτῃ",375,166],["αὐτόν",3,82]],"What is man, that thou art mindful of him? or the son of man, that thou visitest him?"],["6",[["Ἠλάττωσας",1431,154],["αὐτὸν",3,82],["βραχύ",618,29],["τι",39,119],["παρʼ",73,1],["ἀγγέλους",208,31],["δόξῃ",141,2],["καὶ",2,8],["τιμῇ",720,2],["ἐστεφάνωσας",3354,154],["αὐτὸν",3,82]],"Thou madest him a little less than angels, thou hast crowned him with glory and honour;"],["7",[["καὶ",2