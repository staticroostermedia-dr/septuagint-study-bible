[["1",[["Ψαλμὸς",644,5],["τῷ",1,110],["Δαυίδ",52,105],["Ὁ",1,4],["Κύριος",7,5],["ἐβασίλευσεν",151,3],["ὀργιζέσθωσαν",725,72],["λαοί",35,51],["ὁ",1,4],["καθήμενος",419,407],["ἐπὶ",9,1],["τῶν",1,76],["χερουβὶμ",759,105],["σαλευθήτω",678,25],["ἡ",1,11],["γῆ",26,13]],"A Psalm of David. The Lord reigns;—let the people rage; [it is he] that sits upon the cherubs, let the earth be moved."],["2",[["Κύριος",7,5],["ἐν",4,1],["Σιὼν",334,2],["μέγας",66,16],["καὶ",2,8],["ὑψηλός",289,16],["ἐστιν",10,87],["ἐπὶ",9,1],["πάντας",11,58],["τοὺς",1,56],["λαούς",35,31]],"The Lord is great in Sion, and is high over all the people."],["3",[["Ἐξομολογησάσθωσαν",479,533],["τῷ",1,52],["ὀνόματί",57,53],["σου",5,146],["τῷ",1,52],["μεγάλῳ",66,34],["ὅτι",19,8],["φοβερὸν",1210,28],["καὶ",2,8],["ἅγιόν",75,28],["ἐστι",10,87]],"Let them give thanks to thy great name; for it is terrible and holy."],["4",[["καὶ",2,8],["τιμὴ",720,13],["βασιλέως",22,21],["κρίσιν",229,10],["ἀγαπᾷ",214,173],["σὺ",5,156],["ἡτοίμασας",371,154],["εὐθύτητας",1674,40],["κρίσιν",229,10],["καὶ",2,8],["δικαιοσύνην",187,10],["ἐν",4,1],["Ἰακὼβ",146,105],["σὺ",5,156],["ἐποίησας",23,154]],"And the king's honour loves judgment; thou hast prepared equity, thou hast wrought judgment and justice in Jacob."],["5",[["Ὑψοῦτε",331,339],["Κύριον",7,7],["τὸν",1,6],["Θεὸν",20,7],["ἡμῶν",6,41],["καὶ",2,8],["προσκυνεῖτε",298,84],["τῷ",1,52],["ὑποποδίῳ",4661,53],["τῶν",1,76],["ποδῶν",210,77],["αὐτοῦ",3,48],["ὅτι",19,8],["ἅγιός",75,16],["ἐστι",10,87]],"Exalt ye the Lord our God, and worship [at] his footstool; for he is holy."],["6",[["Μωυσῆς",69,5],["καὶ",2,8],["Ἀαρὼν",159,5],["ἐν",4,1],["τοῖς",1,138],["ἱερεῦσιν",65,139],["αὐτοῦ",3,48],["καὶ",2,8],["Σαμουὴλ",397,105],["ἐν",4,1],["τοῖς",1,138],["ἐπικαλουμένοις",341,342],["τὸ",1,32],["ὄνομα",57,33],["αὐτοῦ",3,48],["ἐπεκαλοῦντο",341,131],["τὸν",1,6],["Κύριον",7,7],["καὶ",2,8],["αὐτὸς",3,158],["εἰσήκουεν",241,14]],"Moses and Aaron among his priests, and Samuel among them that call upon his name; they called upon the Lord, and he heard them."],["7",[["ἐν",4,1],["στύλῳ",395,113],["νεφέλης",444,19],["ἐλάλει",50,14],["πρὸς",15,1],["αὐτούς",3,60],["ἐφύλασσον",125,129],["τὰ",1,42],["μαρτύρια",225,43],["αὐτοῦ",3,48],["καὶ",2,8],["τὰ",1,42],["προστάγματα",393,43],["ἃ",1,11],["ἔδωκεν",33,3],["αὐτοῖς",3,142]],"He spoke to them in a pillar of cloud; they kept his testimonies, and the ordinances which he gave them."],["8",[["Κύριε",7,250],["ὁ",1,4],["Θεὸς",20,5],["ἡμῶν",6,41],["σὺ",5,156],["ἐπήκουες",597,217],["αὐτῶν",3,41],["ὁ",1,4],["Θεὸς",20,5],["εὐίλατος",5631,16],["ἐγίνου",30,355],["αὐτοῖς",3,142],["καὶ",2,8],["ἐκδικῶν",539,67],["ἐπὶ",9,1],["πάντα",11,65],["τὰ",1,42],["ἐπιτηδεύματα",903,43],["αὐτῶν",3,41]],"O Lord our God, thou heardest them; O God, thou becamest propitious to them, though thou didst take vengeance on all their devices."],["9",[["Ὑψοῦτε",331,339],["Κύριον",7,7],["τὸν",1,6],["Θεὸν",20,7],["ἡμῶν",6,41],["καὶ",2,8],["προσκυνεῖτε",298,84],["εἰς",8,1],["ὄρος",87,33],["ἅγιον",75,29],["αὐτοῦ",3,48],["ὅτι",19,8],["ἅγιος",75,16],["Κύριος",7,5],["ὁ",1,4],["Θεὸς",20,5],["ἡμῶν",6,41]],"Exalt ye the Lord our God, and worship at his holy mountain; for the Lord our God is holy."]]