[["1",[["Ὠδὴ",773,105],["ψαλμοῦ",639,21],["τῷ",1,110],["Ἀσάφ",1105,5]],"A Song of a Psalm for Asaph."],["2",[["Ὁ",1,4],["Θεὸς",20,5],["τίς",39,150],["ὁμοιωθήσεταί",1197,125],["σοι",5,151],["μὴ",25,8],["σιγήσῃς",1915,170],["μηδὲ",412,12],["καταπραΰνῃς",5735,199],["ὁ",1,4],["Θεός",20,5]],"O God, who shall be compared to thee? be not silent, neither be still, O God."],["3",[["Ὅτι",19,8],["ἰδοὺ",51,17],["οἱ",1,128],["ἐχθροί",135,51],["σου",5,146],["ἤχησαν",1661,141],["καὶ",2,8],["οἱ",1,128],["μισοῦντές",355,137],["σε",5,161],["ᾖραν",0,0],["κεφαλήν",144,10]],"For behold, thine enemies have made a noise; and they that hate thee have lifted up the head."],["4",[["Ἐπὶ",9,1],["τὸν",1,6],["λαόν",35,7],["σου",5,146],["κατεπανουργεύσαντο",7420,436],["γνώμην",1375,10],["καὶ",2,8],["ἐβουλεύσαντο",637,182],["κατὰ",32,1],["τῶν",1,76],["ἁγίων",75,163],["σου",5,146]],"Against thy people they have craftily imagined a device, and have taken counsel against thy saints."],["5",[["Εἶπαν",18,221],["δεῦτε",1162,17],["καὶ",2,8],["ἐξολοθρεύσωμεν",291,75],["αὐτοὺς",3,60],["ἐξ",21,1],["ἔθνους",59,24],["καὶ",2,8],["οὐ",12,17],["μὴ",25,8],["μνησθῇ",231,337],["τὸ",1,32],["ὄνομα",55,33],["Ἰσραὴλ",27,105],["ἔτι",110,17]],"They have said, Come, and let us utterly destroy them out of the nation; and let the name of Israel be remembered no more at all."],["6",[["Ὅτι",19,8],["ἐβουλεύσαντο",637,182],["ἐν",4,1],["ὁμονοίᾳ",3228,2],["ἐπιτοαυτὸ",1405,105],["κατὰ",32,1],["σοῦ",5,146],["διαθήκην",168,10],["διέθεντο",617,182]],"For they have taken counsel together with one consent: they have made a confederacy against thee;"],["7",[["Τὰ",1,42],["σκηνώματα",680,43],["τῶν",1,76],["Ἰδουμαίων",1319,163],["καὶ",2,8],["οἱ",1,128],["Ἰσμαηλῖται",0,0],["Μωὰβ",0,0],["καὶ",2,8],["οἱ",1,128],["Ἀγαρηνοὶ",0,0]],"even the tents of the Idumeans, and the Ismaelites; Moab, and the Agarenes;"],["8",[["Γεβὰλ",0,0],["καὶ",2,8],["Ἀμμὼν",434,61],["καὶ",2,8],["Ἀμαλὴκ",1257,105],["καὶ",2,8],["ἀλλόφυλοι",203,130],["μετὰ",29,1],["τῶν",1,76],["κατοικούντων",90,164],["Τύρον",1201,10]],"Gebal, and Ammon, and Amalec; the Philistines also, with them that dwell at Tyre."],["9",[["Καὶ",2,8],["γὰρ",40,12],["καὶ",2,8],["Ἀσσοὺρ",0,0],["συμπαρεγένετο",8430,26],["μετʼ",29,1],["αὐτῶν",3,41],["ἐγενήθησαν",30,94],["εἰς",8,1],["ἀντίληψιν",2413,10],["τοῖς",1,138],["υἱοῖς",13,139],["Λώτ",1264,105],["διάψαλμα",687,20]],"Yea, Assur too is come with them: they have become a help to the children of Lot. Pause."],["10",[["Ποίησον",23,198],["αὐτοῖς",3,142],["ὡς",36,8],["τῇ",1,95],["Μαδιὰμ",895,105],["καὶ",2,8],["τῷ",1,110],["Σεισάρᾳ",0,0],["ὡς",36,8],["τῷ",1,110],["Ἰαβεὶν",0,0],["ἐν",4,1],["τῷ",1,110],["χειμάῤῥῳ",736,113],["Κεισῶν",0,0]],"Do thou to them as to Madiam, and to Sisera; as to Jabin at the brook of Kison."],["11",[["Ἐξωλοθρεύθησαν",291,94],["ἐν",4,1],["Ἀενδὼρ",0,0],["ἐγενήθησαν",30,94],["ὡσεὶ",342,17],["κόπρος",2599,13],["τῇ",1,95],["γῇ",26,2]],"They were utterly destroyed at Aendor: they became as dung for the earth."],["12",[["Θοῦ",109,275],["τοὺς",1,56],["ἄρχοντας",96,31],["αὐτῶν",3,41],["ὡς",36,8],["τὸν",1,6],["Ὠρὴβ",0,0],["καὶ",2,8],["Ζὴβ",0,0],["καὶ",2,8],["Ζεβεὲ",0,0],["καὶ",2,8],["Σαλμανὰ",0,0],["πάντας",11,58],["τοὺς",1,56],["ἄρχοντας",96,31],["αὐτῶν",3,41]],"Make their princes as Oreb and Zeb, and Zebee and Salmana; [even] all their princes:"],["13",[["Οἵτινες",454,461],["εἶπαν",18,221],["κληρονομήσωμεν",368,75],["ἑαυτοῖς",92,142],["τὸ",1,32],["θυσιαστήριον",133,33],["τοῦ",1,30],["Θεοῦ",20,21]],"who said, Let us take to ourselves the altar of God as an inheritance."],["14",[["Ὁ",1,4],["Θεός",20,5],["μου",6,48],["θοῦ",109,275],["αὐτοὺς",3,60],["ὡς",36,8],["τροχὸν",913,7],["ὡς",36,8],["καλάμην",2026,10],["κατὰ",32,1],["πρόσωπον",47,33],["ἀνέμου",852,21]],"O my God, make them as a wheel; as stubble before the face of the wind."],["15",[["Ὡσεὶ",342,17],["πῦρ",118,33],["ὃ",1,4],["διαφλέξει",7068,120],["δρυμὸν",799,7],["ὡσεὶ",342,17],["φλὸξ",982,13],["κατακαύσαι",553,276],["ὄρη",86,63]],"As fire which shall burn up a wood, as the flame may consume the mountains;"],["16",[["Οὕτως",70,17],["καταδιώξεις",619,159],["αὐτοὺς",3,60],["ἐν",4,1],["τῇ",1,95],["καταιγίδι",1470,2],["σου",5,146],["καὶ",2,8],["ἐν",4,1],["τῇ",1,95],["ὀργῇ",198,2],["σου",5,146],["ταράξεις",508,159],["αὐτούς",3,60]],"so shalt thou persecute them with thy tempest, and trouble them in thine anger."],["17",[["Πλήρωσον",529,243],["τὰ",1,42],["πρόσωπα",47,43],["αὐτῶν",3,41],["ἀτιμίας",1048,40],["καὶ",2,8],["ζητήσουσι",190,207],["τὸ",1,32],["ὄνομά",55,33],["σου",5,146],["Κύριε",7,251]],"Fill their faces with dishonour; so shall they seek thy name, O Lord."],["18",[["Αἰσχυνθήτωσαν",614,50],["καὶ",2,8],["ταραχθήτωσαν",508,50],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["τοῦ",1,30],["αἰῶνος",100,21],["καὶ",2,8],["ἐντραπήτωσαν",0,0],["καὶ",2,8],["ἀπολέσθωσαν",213,541]],"Let them be ashamed and troubled for evermore; yea, let them be confounded and destroyed."],["19",[["Καὶ",2,8],["γνώτωσαν",0,0],["ὅτι",19,8],["ὄνομά",55,33],["σοι",5,151],["Κύριος",7,5],["σὺ",5,156],["μόνος",300,16],["ὕψιστος",473,16],["ἐπὶ",9,1],["πᾶσαν",11,37],["τὴν",1,9],["γῆν",26,10]],"And let them know that thy name is Lord; that thou alone art Most High over all the earth."]]