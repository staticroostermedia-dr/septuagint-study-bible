[["1",[["Ὠδὴ",776,105],["ψαλμοῦ",644,21],["τῷ",1,110],["Ἀσάφ",1103,5]],"A Song of a Psalm for Asaph."],["2",[["Ὁ",1,4],["Θεὸς",20,5],["τίς",39,150],["ὁμοιωθήσεταί",1175,125],["σοι",5,151],["μὴ",25,8],["σιγήσῃς",1915,170],["μηδὲ",414,12],["καταπραΰνῃς",5702,199],["ὁ",1,4],["Θεός",20,5]],"O God, who shall be compared to thee? be not silent, neither be still, O God."],["3",[["Ὅτι",19,8],["ἰδοὺ",51,17],["οἱ",1,128],["ἐχθροί",135,51],["σου",5,146],["ἤχησαν",1660,141],["καὶ",2,8],["οἱ",1,128],["μισοῦντές",351,137],["σε",5,161],["ᾖραν",206,141],["κεφαλήν",144,10]],"For behold, thine enemies have made a noise; and they that hate thee have lifted up the head."],["4",[["Ἐπὶ",9,1],["τὸν",1,6],["λαόν",35,7],["σου",5,146],["κατεπανουργεύσαντο",7366,430],["γνώμην",1376,10],["καὶ",2,8],["ἐβουλεύσαντο",641,184],["κατὰ",32,1],["τῶν",1,76],["ἁγίων",75,163],["σου",5,146]],"Against thy people they have craftily imagined a device, and have taken counsel against thy saints."],["5",[["Εἶπαν",18,141],["δεῦτε",1159,17],["καὶ",2,8],["ἐξολοθρεύσωμεν",291,75],["αὐτοὺς",3,60],["ἐξ",21,1],["ἔθνους",60,24],["καὶ",2,8],["οὐ",12,17],["μὴ",25,8],["μνησθῇ",230,333],["τὸ",1,32],["ὄνομα",57,33],["Ἰσραὴλ",27,105],["ἔτι",111,17]],"They have said, Come, and let us utterly destroy them out of the nation; and let the name of Israel be remembered no more at all."],["6",[["Ὅτι",19,8],["ἐβουλεύσαντο",641,184],["ἐν",4,1],["ὁμονοίᾳ",3223,2],["ἐπιτοαυτὸ",1404,105],["κατὰ",32,1],["σοῦ",5,146],["διαθήκην",169,10],["διέθεντο",619,184]],"For they have taken counsel together with one consent: they have made a confederacy against thee;"],["7",[["Τὰ",1,42],["σκηνώματα",682,43],["τῶν",1,76],["Ἰδουμαίων",1319,163],["καὶ",2,8],["οἱ",1,128],["Ἰσμαηλῖται",0,0],["Μωὰβ",0,0],["καὶ",2,8],["οἱ",1,128],["Ἀγαρηνοὶ",0,0]],"even the tents of the Idumeans, and the Ismaelites; Moab, and the Agarenes;"],["8",[["Γεβὰλ",12847,0],["καὶ",2,8],["Ἀμμὼν",435,61],["καὶ",2,8],["Ἀμαλὴκ",1257,105],["καὶ",2,8],["ἀλλόφυλοι",203,130],["μετὰ",29,1],["τῶν",1,76],["κατοικούντων",89,164],["Τύρον",1199,10]],"Gebal, and Ammon, and Amalec; the Philistines also, with them that dwell at Tyre."],["9",[["Καὶ",2,8],["γὰρ",40,12],["καὶ",2,8],["Ἀσσοὺρ",0,0],["συμπαρεγένετο",8371,26],["μετʼ",29,1],["αὐτῶν",3,41],["ἐγενήθησαν",30,94],["εἰς",8,1],["ἀντίληψιν",2404,10],["τοῖς",1,138],["υἱοῖς",13,139],["Λώτ",1264,105],["διάψαλμα",689,20]],"Yea, Assur too is come with them: they have become a help to the children of Lot. Pause."],["10",[["Ποίησον",23,198],["αὐτοῖς",3,142],["ὡς",36,8],["τῇ",1,95],["Μαδιὰμ",894,105],["καὶ",2,8],["τῷ",1,110],["Σεισάρᾳ",0,0],["ὡς",36,8],["τῷ",1,110],["Ἰαβεὶν",14549,0],["ἐν",4,1],["τῷ",1,110],["χειμάῤῥῳ",737,113],["Κεισῶν",0,0]],"Do thou to them as to Madiam, and to Sisera; as to Jabin at the brook of Kison."],["11",[["Ἐξωλοθρεύθησαν",291,94],["ἐν",4,1],["Ἀενδὼρ",14070,0],["ἐγενήθησαν",30,94],["ὡσεὶ",343,17],["κόπρος",2595,13],["τῇ",1,95],["γῇ",26,2]],"They were utterly destroyed at Aendor: they became as dung for the earth."],["12",[["Θοῦ",110,275],["τοὺς",1,56],["ἄρχοντας",96,31],["αὐτῶν",3,41],["ὡς",36,8],["τὸν",1,6],["Ὠρὴβ",11786,0],["καὶ",2,8],["Ζὴβ",12014,0],["καὶ",2,8],["Ζεβεὲ",11633,0],["καὶ",2,8],["Σαλμανὰ",11656,0],["πάντας",11,58],["τοὺς",1,56],["ἄρχοντας",96,31],["αὐτῶν",3,41]],"Make their princes as Oreb and Zeb, and Zebee and Salmana; [even] all their princes:"],["13",[["Οἵτινες",457,455],["εἶπαν",18,141],["κληρονομήσωμεν",370,75],["ἑαυτοῖς",92,142],["τὸ",1,32],["θυσιαστήριον",133,33],["τοῦ",1,30],["Θεοῦ",20,21]],"who said, Let us take to ourselves the altar of God as an inheritance."],["14",[["Ὁ",1,4],["Θεός",20,5],["μου",6,48],["θοῦ",110,275],["αὐτοὺς",3,60],["ὡς",36,8],["τροχὸν",911,7],["ὡς",36,8],["καλάμην",2018,10],["κατὰ",32,1],["πρόσωπον",47,33],["ἀνέμου",850,21]],"O my God, make them as a wheel; as stubble before the face of the wind."],["15",[["Ὡσεὶ",343,17],["πῦρ",118,33],["ὃ",1,4],["διαφλέξει",7022,120],["δρυμὸν",802,7],["ὡσεὶ",343,17],["φλὸξ",983,13],["κατακαύσαι",554,216],["ὄρη",87,63]],"As fire which shall burn up a wood, as the flame may consume the mountains;"],["16",[["Οὕτως",71,17],["καταδιώξεις",621,159],["αὐτοὺς",3,60],["ἐν",4,1],["τῇ",1,95],["καταιγίδι",1470,2],["σου",5,146],["καὶ",2,8],["ἐν",4,1],["τῇ",1,95],["ὀργῇ",198,2],["σου",5,146],["ταράξεις",508,159],["αὐτούς",3,60]],"so shalt thou persecute them with thy tempest, and trouble them in thine anger."],["17",[["Πλήρωσον",518,198],["τὰ",1,42],["πρόσωπα",47,43],["αὐτῶν",3,41],["ἀτιμίας",1049,40],["καὶ",2,8],["ζητήσουσι",191,207],["τὸ",1,32],["ὄνομά",57,33],["σου",5,146],["Κύριε",7,250]],"Fill their faces with dishonour; so shall they seek thy name, O Lord."],["18",[["Αἰσχυνθήτωσαν",611,50],["καὶ",2,8],["ταραχθήτωσαν",508,50],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["τοῦ",1,30],["αἰῶνος",100,21],["καὶ",2,8],["ἐντραπήτωσαν",1105,50],["καὶ",2,8],["ἀπολέσθωσαν",217,533]],"Let them be ashamed and troubled for evermore; yea, let them be confounded and destroyed."],["19",[["Καὶ",2,8],["γνώτωσαν",79,261],["ὅτι",19,8],["ὄνομά",57,33],["σοι",5,151],["Κύριος",7,5],["σὺ",5,156],["μόνος",302,16],["ὕψιστος",474,16],["ἐπὶ",9,1],["πᾶσαν",11,37],["τὴν",1,9],["γῆν",26,10]],"And let them know that thy name is Lord; that thou alone art Most High over all the earth."]]