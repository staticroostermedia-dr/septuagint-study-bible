[["1",[["Ἀλληλούϊα",1749,105],["Ἐξομολογήσομαι",479,177],["σοι",5,151],["Κύριε",7,250],["ἐν",4,1],["ὅλῃ",235,96],["καρδίᾳ",64,2],["μου",6,48],["ἐν",4,1],["βουλῇ",350,2],["εὐθέων",1137,163],["καὶ",2,8],["συναγωγῇ",284,2]],"Alleluia. I will give thee thanks, O Lord, with my whole heart, in the council of the upright, and [in] the congregation."],["2",[["Μεγάλα",66,65],["τὰ",1,42],["ἔργα",105,43],["Κυρίου",7,21],["ἐξεζητημένα",460,381],["εἰς",8,1],["πάντα",11,65],["τὰ",1,42],["θελήματα",1039,43],["αὐτοῦ",3,48]],"The works of the Lord are great, sought out according to all his will."],["3",[["Ἐξομολόγησις",1934,13],["καὶ",2,8],["μεγαλοπρέπεια",2738,13],["τὸ",1,32],["ἔργον",105,33],["αὐτοῦ",3,48],["καὶ",2,8],["ἡ",1,11],["δικαιοσύνη",187,13],["αὐτοῦ",3,48],["μένει",681,87],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["τοῦ",1,30],["αἰῶνος",100,21]],"His work is [worthy of] thanksgiving and honour: and his righteousness endures for ever and ever."],["4",[["Μνείαν",2271,10],["ἐποιήσατο",23,26],["τῶν",1,76],["θαυμασίων",884,163],["αὐτοῦ",3,48],["ἐλεήμων",1489,16],["καὶ",2,8],["οἰκτίρμων",2102,16],["ὁ",1,4],["Κύριος",7,5]],"He has caused his wonderful works to be remembered: the Lord is merciful and compassionate."],["5",[["Τροφὴν",1390,10],["ἔδωκε",33,3],["τοῖς",1,138],["φοβουμένοις",134,342],["αὐτόν",3,82],["μνησθήσεται",230,125],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["διαθήκης",169,19],["αὐτοῦ",3,48]],"He has given food to them that fear him: he will remember his covenant for ever."],["6",[["Ἰσχὺν",181,10],["ἔργων",105,45],["αὐτοῦ",3,48],["ἀνήγγειλε",231,3],["τῷ",1,110],["λαῷ",35,113],["αὐτοῦ",3,48],["τοῦ",1,30],["δοῦναι",33,100],["αὐτοῖς",3,142],["κληρονομίαν",299,10],["ἐθνῶν",60,45]],"He has declared to his people the power of his works, to give them the inheritance of the heathen."],["7",[["Ἔργα",105,43],["χειρῶν",37,61],["αὐτοῦ",3,48],["ἀλήθεια",352,13],["καὶ",2,8],["κρίσις",229,13],["πισταὶ",750,187],["πᾶσαι",11,187],["αἱ",1,185],["ἐντολαὶ",259,180],["αὐτοῦ",3,48]],"The works of his hands are truth and judgment: all his commandments are sure:"],["8",[["ἐστηριγμέναι",979,424],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["τοῦ",1,30],["αἰῶνος",100,21],["πεποιημέναι",23,424],["ἐν",4,1],["ἀληθείᾳ",352,2],["καὶ",2,8],["εὐθύτητι",1674,2]],"established for ever and ever, done in truth and uprightness."],["9",[["Λύτρωσιν",2599,10],["ἀπέστειλε",84,3],["τῷ",1,110],["λαῷ",35,113],["αὐτοῦ",3,48],["ἐνετείλατο",143,26],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["διαθήκην",169,10],["αὐτοῦ",3,48],["ἅγιον",75,28],["καὶ",2,8],["φοβερὸν",1210,28],["τὸ",1,27],["ὄνομα",57,20],["αὐτοῦ",3,48]],"He sent redemption to his people: he commanded his covenant for ever: holy and fearful is his name."],["10",[["Ἀρχὴ",270,13],["σοφίας",242,19],["φόβος",333,5],["Κυρίου",7,21],["σύνεσις",469,13],["δὲ",14,12],["ἀγαθὴ",114,15],["πᾶσι",11,215],["τοῖς",1,138],["ποιοῦσιν",23,352],["αὐτήν",3,98],["ἡ",1,11],["αἴνεσις",989,13],["αὐτοῦ",3,48],["μένει",681,87],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["τοῦ",1,30],["αἰῶνος",100,21]],"The fear of the Lord is the beginning of wisdom, and all that act accordingly have a good understanding; his praise endures for ever and ever."]]