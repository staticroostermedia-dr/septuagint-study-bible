[["1",[["Ἀλληλούϊα",1746,105],["Ἐξομολογήσομαι",478,176],["σοι",5,151],["Κύριε",7,251],["ἐν",4,1],["ὅλῃ",233,96],["καρδίᾳ",63,2],["μου",6,48],["ἐν",4,1],["βουλῇ",349,2],["εὐθέων",1137,163],["καὶ",2,8],["συναγωγῇ",284,2]],"Alleluia. I will give thee thanks, O Lord, with my whole heart, in the council of the upright, and [in] the congregation."],["2",[["Μεγάλα",65,65],["τὰ",1,42],["ἔργα",104,43],["Κυρίου",7,21],["ἐξεζητημένα",0,0],["εἰς",8,1],["πάντα",11,65],["τὰ",1,42],["θελήματα",1036,43],["αὐτοῦ",3,48]],"The works of the Lord are great, sought out according to all his will."],["3",[["Ἐξομολόγησις",1935,13],["καὶ",2,8],["μεγαλοπρέπεια",2745,13],["τὸ",1,32],["ἔργον",104,33],["αὐτοῦ",3,48],["καὶ",2,8],["ἡ",1,11],["δικαιοσύνη",185,13],["αὐτοῦ",3,48],["μένει",678,87],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["τοῦ",1,30],["αἰῶνος",100,21]],"His work is [worthy of] thanksgiving and honour: and his righteousness endures for ever and ever."],["4",[["Μνείαν",2286,10],["ἐποιήσατο",23,26],["τῶν",1,76],["θαυμασίων",885,163],["αὐτοῦ",3,48],["ἐλεήμων",1491,16],["καὶ",2,8],["οἰκτίρμων",2109,16],["ὁ",1,4],["Κύριος",7,5]],"He has caused his wonderful works to be remembered: the Lord is merciful and compassionate."],["5",[["Τροφὴν",1392,10],["ἔδωκε",33,3],["τοῖς",1,138],["φοβουμένοις",134,346],["αὐτόν",3,82],["μνησθήσεται",231,125],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["διαθήκης",168,19],["αὐτοῦ",3,48]],"He has given food to them that fear him: he will remember his covenant for ever."],["6",[["Ἰσχὺν",180,10],["ἔργων",104,45],["αὐτοῦ",3,48],["ἀνήγγειλε",228,3],["τῷ",1,110],["λαῷ",35,113],["αὐτοῦ",3,48],["τοῦ",1,30],["δοῦναι",33,100],["αὐτοῖς",3,142],["κληρονομίαν",297,10],["ἐθνῶν",59,45]],"He has declared to his people the power of his works, to give them the inheritance of the heathen."],["7",[["Ἔργα",104,43],["χειρῶν",37,61],["αὐτοῦ",3,48],["ἀλήθεια",350,13],["καὶ",2,8],["κρίσις",226,13],["πισταὶ",748,185],["πᾶσαι",11,185],["αἱ",1,183],["ἐντολαὶ",259,179],["αὐτοῦ",3,48]],"The works of his hands are truth and judgment: all his commandments are sure:"],["8",[["ἐστηριγμέναι",0,0],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["τοῦ",1,30],["αἰῶνος",100,21],["πεποιημέναι",0,0],["ἐν",4,1],["ἀληθείᾳ",350,2],["καὶ",2,8],["εὐθύτητι",1676,2]],"established for ever and ever, done in truth and uprightness."],["9",[["Λύτρωσιν",2602,10],["ἀπέστειλε",83,3],["τῷ",1,110],["λαῷ",35,113],["αὐτοῦ",3,48],["ἐνετείλατο",143,26],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["διαθήκην",168,10],["αὐτοῦ",3,48],["ἅγιον",75,28],["καὶ",2,8],["φοβερὸν",1213,28],["τὸ",1,27],["ὄνομα",55,20],["αὐτοῦ",3,48]],"He sent redemption to his people: he commanded his covenant for ever: holy and fearful is his name."],["10",[["Ἀρχὴ",269,13],["σοφίας",238,19],["φόβος",330,5],["Κυρίου",7,21],["σύνεσις",467,13],["δὲ",14,12],["ἀγαθὴ",113,15],["πᾶσι",11,215],["τοῖς",1,138],["ποιοῦσιν",23,357],["αὐτήν",3,98],["ἡ",1,11],["αἴνεσις",990,13],["αὐτοῦ",3,48],["μένει",678,87],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["τοῦ",1,30],["αἰῶνος",100,21]],"The fear of the Lord is the beginning of wisdom, and all that act accordingly have a good understanding; his praise endures for ever and ever."]]