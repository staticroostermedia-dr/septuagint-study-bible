[["1",[["Ψαλμὸς",639,5],["τῷ",1,110],["Δαυίδ",52,105],["Κύριε",7,251],["ἐκέκραξα",590,147],["πρὸς",15,1],["σὲ",5,161],["εἰσάκουσόν",237,198],["μου",6,48],["πρόσχες",1692,154],["τῇ",1,95],["φωνῇ",95,2],["τῆς",1,18],["δεήσεώς",674,19],["μου",6,83],["ἐν",4,1],["τῷ",1,110],["κεκραγέναι",590,107],["με",6,82],["πρὸς",15,1],["σέ",5,161]],"A Psalm of David. O Lord, I have cried to thee; hear me: attend to the voice of my supplication, when I cry to thee."],["2",[["Κατευθυνθήτω",828,25],["ἡ",1,11],["προσευχή",549,13],["μου",6,48],["ὡς",36,8],["θυμίαμα",652,20],["ἐνώπιόν",114,1],["σου",5,146],["ἔπαρσις",3766,13],["τῶν",1,123],["χειρῶν",37,61],["μου",6,48],["θυσία",156,13],["ἑσπερινή",3457,15]],"Let my prayer be set forth before thee as incense; the lifting up of my hands [as] an evening sacrifice."],["3",[["Θοῦ",109,275],["Κύριε",7,251],["φυλακὴν",483,10],["τῷ",1,52],["στόματί",123,53],["μου",6,48],["καὶ",2,8],["θύραν",277,10],["περιοχῆς",1595,19],["περὶ",71,1],["τὰ",1,42],["χείλη",361,43],["μου",6,48]],"Set a watch, O Lord, on my mouth, and a strong door about my lips."],["4",[["Μὴ",25,8],["ἐκκλίνῃς",393,170],["τὴν",1,9],["καρδίαν",63,10],["μου",6,48],["εἰς",8,1],["λόγους",48,31],["πονηρίας",729,19],["τοῦ",1,30],["προφασίζεσθαι",5046,104],["προφάσεις",3641,179],["ἐν",4,1],["ἁμαρτίαις",119,71],["σὺν",309,1],["ἀνθρώποις",43,139],["ἐργαζομένοις",468,346],["τὴν",1,9],["ἀνομίαν",274,10],["καὶ",2,8],["οὐ",12,17],["μὴ",25,8],["συνδοιάσω",8466,157],["μετὰ",29,1],["τῶν",1,76],["ἐκλεκτῶν",551,163],["αὐτῶν",3,41]],"Incline not my heart to evil things, to employ pretexts for sins, with men who work iniquity: and let me not unite with their choice ones."],["5",[["Παιδεύσει",654,120],["με",6,82],["δίκαιος",152,16],["ἐν",4,1],["ἐλέει",182,53],["καὶ",2,8],["ἐλέγξει",750,120],["με",6,82],["ἔλαιον",312,33],["δὲ",14,12],["ἁμαρτωλοῦ",406,153],["μὴ",25,8],["λιπανάτω",0,0],["τὴν",1,9],["κεφαλήν",144,10],["μου",6,48],["ὅτι",19,8],["ἔτι",110,17],["καὶ",2,8],["ἡ",1,11],["προσευχή",549,13],["μου",6,48],["ἐν",4,1],["ταῖς",1,70],["εὐδοκίαις",1624,71],["αὐτῶν",3,41]],"The righteous shall chasten me with mercy, and reprove me: but let not the oil of the sinner anoint my head: for yet shall my prayer also be in their pleasures."],["6",[["Κατεπόθησαν",1183,94],["ἐχόμενα",124,203],["πέτρας",546,19],["οἱ",1,128],["κραταιοὶ",734,166],["αὐτῶν",3,41],["ἀκούσονται",53,127],["τὰ",1,42],["ῥήματά",115,43],["μου",6,48],["ὅτι",19,8],["ἠδύνθησαν",0,0]],"Their mighty ones have been swallowed up near the rock: they shall hear my words, for they are sweet."],["7",[["Ὡσεὶ",342,17],["πάχος",2492,20],["γῆς",26,19],["διεῤῥάγη",673,38],["ἐπὶ",9,1],["τῆς",1,18],["γῆς",26,19],["διεσκορπίσθη",1001,38],["τὰ",1,42],["ὀστᾶ",472,43],["ἡμῶν",6,41],["παρὰ",72,1],["τὸν",1,6],["ᾅδην",583,7]],"As a lump of earth is crushed upon the ground, our bones have been scattered by the [mouth of] the grave."],["8",[["Ὅτι",19,8],["πρὸς",15,1],["σὲ",5,161],["Κύριε",7,251],["Κύριε",7,251],["οἱ",1,128],["ὀφθαλμοί",91,51],["μου",6,48],["ἐπὶ",9,1],["σοὶ",5,151],["ἤλπισα",511,147],["μὴ",25,8],["ἀντανέλῃς",2995,170],["τὴν",1,9],["ψυχήν",62,10],["μου",6,48]],"For mine eyes are to thee, O Lord God: I have hoped in thee; take not away my life."],["9",[["Φύλαξόν",127,243],["με",6,82],["ἀπὸ",17,1],["παγίδος",815,19],["ἧς",24,162],["συνεστήσαντό",1099,182],["μοι",6,49],["καὶ",2,8],["ἀπὸ",17,1],["σκανδάλων",1838,45],["τῶν",1,44],["ἐργαζομένων",468,385],["τὴν",1,9],["ἀνομίαν",274,10]],"Keep me from the snare which they have set for me, and from the stumbling-blocks of them that work iniquity."],["10",[["Πεσοῦνται",154,127],["ἐν",4,1],["ἀμφιβλήστρῳ",4025,53],["αὐτοῦ",3,48],["ἁμαρτωλοὶ",406,130],["καταμόνας",4855,17],["εἰμὶ",10,149],["ἐγὼ",6,158],["ἕως",42,8],["οὗ",120,17],["ἂν",82,12],["παρέλθω",410,227]],"Sinners shall fall by their own net: I am alone until I shall escape."]]