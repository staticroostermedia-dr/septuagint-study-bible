[["1",[["Εἰς",8,1],["τὸ",1,32],["τέλος",369,33],["ψαλμὸς",639,5],["τῷ",1,110],["Δαυίδ",52,105],["Ὁ",1,4],["Θεὸς",20,5],["τὴν",1,9],["αἴνεσίν",990,10],["μου",6,48],["μὴ",25,8],["παρασιωπήσῃς",1907,170]],"For the end, a Psalm of David. O God, pass not over my praise in silence;"],["2",[["ὅτι",19,8],["στόμα",123,33],["ἁμαρτωλοῦ",406,153],["καὶ",2,8],["στόμα",123,33],["δολίου",1543,153],["ἐπʼ",9,1],["ἐμὲ",6,82],["ἠνοίχθη",820,38],["ἐλάλησαν",50,141],["κατʼ",32,1],["ἐμοῦ",6,48],["γλώσσῃ",385,2],["δολίᾳ",1543,96]],"for the mouth of the sinner and the mouth of the crafty [man] have been opened against me: they have spoken against me with a crafty tongue."],["3",[["καὶ",2,8],["λόγοις",48,139],["μίσους",2606,24],["ἐκύκλωσάν",600,141],["με",6,82],["καὶ",2,8],["ἐπολέμησάν",304,141],["με",6,82],["δωρέαν",1338,17]],"And they have compassed me with words of hatred; and fought against me without a cause."],["4",[["Ἀντὶ",158,1],["τοῦ",1,30],["ἀγαπᾷν",224,54],["με",6,82],["ἐνδιέβαλλόν",4091,129],["με",6,82],["ἐγὼ",6,158],["δὲ",14,12],["προσηυχόμην",550,380]],"Instead of loving me, they falsely accused me: but I continued to pray."],["5",[["Καὶ",2,8],["ἔθεντο",109,182],["κατʼ",32,1],["ἐμοῦ",6,48],["κακὰ",161,65],["ἀντὶ",158,1],["ἀγαθῶν",113,79],["καὶ",2,8],["μῖσος",2606,20],["ἀντὶ",158,1],["τῆς",1,18],["ἀγαπήσεώς",4500,19],["μου",6,83]],"And they rewarded me evil for good, and hatred for my love."],["6",[["Κατάστησον",313,198],["ἐπʼ",9,1],["αὐτὸν",3,82],["ἁμαρτωλὸν",406,59],["καὶ",2,8],["διάβολος",1721,16],["στήτω",78,46],["ἐκ",21,1],["δεξιῶν",282,79],["αὐτοῦ",3,48]],"Set thou a sinner against him; and let the devil stand at his right hand."],["7",[["Ἐν",4,1],["τῷ",1,110],["κρίνεσθαι",240,104],["αὐτὸν",3,82],["ἐξέλθοι",84,276],["καταδεδικασμένος",0,0],["καὶ",2,8],["ἡ",1,11],["προσευχὴ",549,13],["αὐτοῦ",3,48],["γενέσθω",30,316],["εἰς",8,1],["ἁμαρτίαν",119,10]],"When he is judged, let him go forth condemned: and let his prayer become sin."],["8",[["Γενηθήτωσαν",30,50],["αἱ",1,183],["ἡμέραι",28,2],["αὐτοῦ",3,48],["ὀλίγαι",554,185],["καὶ",2,8],["τὴν",1,9],["ἐπισκοπὴν",1108,10],["αὐτοῦ",3,48],["λάβοι",46,276],["ἕτερος",253,16]],"Let his days be few: and let another take his office of overseer."],["9",[["Γενηθήτωσαν",30,50],["οἱ",1,128],["υἱοὶ",13,51],["αὐτοῦ",3,48],["ὀρφανοὶ",959,130],["καὶ",2,8],["ἡ",1,11],["γυνὴ",58,13],["αὐτοῦ",3,48],["χήρα",749,13]],"Let his children be orphans, and his wife a widow."],["10",[["Σαλευόμενοι",679,356],["μεταναστήτωσαν",0,0],["οἱ",1,128],["υἱοὶ",13,51],["αὐτοῦ",3,48],["καὶ",2,8],["ἐπαιτησάτωσαν",6522,261],["ἐκβληθήτωσαν",582,50],["ἐκ",21,1],["τῶν",1,44],["οἰκοπέδων",4963,45],["αὐτῶν",3,168]],"Let his children wander without a dwelling-place, and beg: let them be cast out of their habitations."],["11",[["Ἐξερευνησάτω",1864,46],["δανειστὴς",4758,5],["πάντα",11,65],["ὅσα",102,43],["ὑπάρχει",416,87],["αὐτῷ",3,49],["καὶ",2,8],["διαρπασάτωσαν",1181,261],["ἀλλότριοι",377,130],["τοὺς",1,56],["πόνους",564,31],["αὐτοῦ",3,48]],"Let [his] creditor exact all that belongs to him: and let strangers spoil his labours."],["12",[["Μὴ",25,8],["ὑπαρξάτω",416,46],["αὐτῷ",3,49],["ἀντιλήμπτωρ",0,0],["μηδὲ",412,12],["γενηθήτω",30,25],["οἰκτίρμων",2109,16],["τοῖς",1,138],["ὀρφανοῖς",959,215],["αὐτοῦ",3,48]],"Let him have no helper; neither let there be any one to have compassion on his fatherless children."],["13",[["Γενηθήτω",30,25],["τὰ",1,42],["τέκνα",192,43],["αὐτοῦ",3,48],["εἰς",8,1],["ἐξολόθρευσιν",0,0],["ἐν",4,1],["γενεᾷ",286,2],["μιᾷ",57,96],["ἐξαλειφθείη",1086,555],["τὸ",1,32],["ὄνομα",55,33],["αὐτοῦ",3,48]],"Let his children be [given up] to utter destruction: in one generation let his name be blotted out."],["14",[["Ἀναμνησθείη",1650,555],["ἡ",1,11],["ἀνομία",274,13],["τῶν",1,76],["πατέρων",44,77],["αὐτοῦ",3,48],["ἔναντι",230,17],["Κυρίου",7,21],["καὶ",2,8],["ἡ",1,11],["ἁμαρτία",119,13],["τῆς",1,18],["μητρὸς",188,19],["αὐτοῦ",3,48],["μὴ",25,8],["ἐξαλειφθείη",1086,555]],"Let the iniquity of his fathers be remembered before the Lord; and let not the sin of his mother be blotted out."],["15",[["Γενηθήτωσαν",30,50],["ἐναντίον",138,17],["Κυρίου",7,21],["διαπαντὸς",506,17],["καὶ",2,8],["ἐξολοθρευθείη",291,555],["ἐκ",21,1],["γῆς",26,19],["τὸ",1,32],["μνημόσυνον",717,33],["αὐτῶν",3,41]],"Let them be before the Lord continually; and let their memorial be blotted out from the earth."],["16",[["Ἀνθʼ",158,1],["ὧν",24,97],["οὐκ",12,17],["ἐμνήσθη",231,38],["ποιῆσαι",23,100],["ἔλεος",182,33],["καὶ",2,8],["κατεδίωξεν",619,3],["ἄνθρωπον",43,7],["πένητα",668,7],["καὶ",2,8],["πτωχὸν",496,7],["καὶ",2,8],["κατανενυγμένον",4269,447],["τῇ",1,95],["καρδίᾳ",63,2],["τοῦ",1,30],["θανατῶσαι",386,100]],"Because he remembered not to shew mercy, but persecuted the needy and poor man, and [that] to slay him that was pricked in the heart."],["17",[["Καὶ",2,8],["ἠγάπησε",224,3],["κατάραν",1166,10],["καὶ",2,8],["ἥξει",260,120],["αὐτῷ",3,49],["καὶ",2,8],["οὐκ",12,17],["ἠθέλησεν",609,3],["εὐλογίαν",576,10],["καὶ",2,8],["μακρυνθήσεται",0,0],["ἀπʼ",17,1],["αὐτοῦ",3,48]],"He loved cursing also, and it shall come upon him; and he took not pleasure in blessing, so it shall be removed far from him."],["18",[["Καὶ",2,8],["ἐνεδύσατο",515,26],["κατάραν",1166,10],["ὡς",36,8],["ἱμάτιον",275,33],["καὶ",2,8],["εἰσῆλθεν",88,3],["ὡσεὶ",342,17],["ὕδωρ",85,33],["εἰς",8,1],["τὰ",1,42],["ἔγκατα",3764,43],["αὐτοῦ",3,48],["καὶ",2,8],["ὡσεὶ",342,17],["ἔλαιον",312,33],["ἐν",4,1],["τοῖς",1,91],["ὀστέοις",472,92],["αὐτοῦ",3,48]],"Yea, he put on cursing as a garment, and it is come as water into his bowels, and as oil into his bones."],["19",[["Γενηθήτω",30,25],["αὐτῷ",3,49],["ὡς",36,8],["ἱμάτιον",275,33],["ὃ",1,4],["περιβάλλεται",743,108],["καὶ",2,8],["ὡσεὶ",342,17],["ζώνη",1889,13],["ἣν",24,124],["διαπαντὸς",506,17],["περιζώννυται",1418,108]],"Let it be to him as a garment which he puts on, and as a girdle with which he girds himself continually."],["20",[["Τοῦτο",16,122],["τὸ",1,32],["ἔργον",104,33],["τῶν",1,76],["ἐνδιαβαλλόντων",4091,164],["με",6,82],["παρὰ",72,1],["Κυρίου",7,21],["καὶ",2,8],["τῶν",1,76],["λαλούντων",50,164],["πονηρὰ",164,15],["κατὰ",32,1],["τῆς",1,18],["ψυχῆς",62,19],["μου",6,83]],"This is the dealing of the Lord with those who falsely accuse me, and of them that speak evil against my soul."],["21",[["Καὶ",2,8],["σὺ",5,156],["Κύριε",7,251],["Κύριε",7,251],["ποίησον",23,198],["μετʼ",29,1],["ἐμοῦ",6,48],["ἕνεκεν",445,1],["τοῦ",1,23],["ὀνόματός",55,24],["σου",5,146],["ὅτι",19,8],["χρηστὸν",1357,28],["τὸ",1,27],["ἔλεός",182,20],["σου",5,146]],"But thou, O Lord, Lord, deal [mercifully] with me, for thy name's sake: for thy mercy is good."],["22",[["Ῥῦσαί",335,275],["με",6,82],["ὅτι",19,8],["πτωχὸς",496,5],["καὶ",2,8],["πένης",668,5],["εἰμὶ",10,149],["ἐγὼ",6,158],["καὶ",2,8],["ἡ",1,11],["καρδία",63,13],["μου",6,48],["τετάρακται",0,0],["ἐντός",3198,17],["μου",6,48]],"Deliver me, for I am poor and needy; and my heart is troubled within me."],["23",[["Ὡσεὶ",342,17],["σκιὰ",978,13],["ἐν",4,1],["τῷ",1,110],["ἐκκλῖναι",393,100],["αὐτὴν",3,98],["ἀντανῃρέθην",2995,94],["ἐξετινάχθην",1996,256],["ὡσεὶ",342,17],["ἀκρίδες",1359,179]],"I am removed as a shadow in its going down: I am tossed up and down like locusts."],["24",[["Τὰ",1,42],["γόνατά",1300,43],["μου",6,48],["ἠσθένησαν",768,141],["ἀπὸ",17,1],["νηστείας",1416,40],["καὶ",2,8],["ἡ",1,11],["σάρξ",287,13],["μου",6,48],["ἠλλοιώθη",1289,38],["διʼ",54,1],["ἔλαιον",312,33]],"My knees are weakened through fasting, and my flesh is changed by reason of [the want of] oil."],["25",[["Κᾀγὼ",611,105],["ἐγενήθην",30,148],["ὄνειδος",973,20],["αὐτοῖς",3,142],["εἴδοσάν",0,0],["με",6,82],["ἐσάλευσαν",679,141],["κεφαλὰς",144,40],["αὐτῶν",3,41]],"I became also a reproach to them: [when] they saw me they shook their heads."],["26",[["Βοήθησόν",552,243],["μοι",6,49],["Κύριε",7,251],["ὁ",1,4],["Θεός",20,5],["μου",6,48],["καὶ",2,8],["σῶσόν",171,198],["με",6,82],["κατὰ",32,1],["τὸ",1,32],["ἔλεός",182,33],["σου",5,146]],"Help me, O Lord my God; and save me according to thy mercy."],["27",[["Καὶ",2,8],["γνώτωσαν",0,0],["ὅτι",19,8],["ἡ",1,11],["χείρ",37,13],["σου",5,146],["αὕτη",16,101],["καὶ",2,8],["σὺ",5,156],["Κύριε",7,251],["ἐποίησας",23,154],["αὐτήν",3,98]],"And let them know that this is thy hand; and [that] thou, Lord, hast wrought it."],["28",[["Καταράσονται",778,492],["αὐτοὶ",3,193],["καὶ",2,8],["σὺ",5,156],["εὐλογήσεις",147,159],["οἱ",1,128],["ἐπανιστάμενοί",1221,356],["μοι",6,49],["αἰσχυνθήτωσαν",614,50],["ὁ",1,4],["δὲ",14,12],["δοῦλός",136,5],["σου",5,146],["εὐφρανθήσεται",242,125]],"Let them curse, but thou shalt bless: let them that rise up against me be ashamed, but let thy servant rejoice."],["29",[["Ἐνδυσάσθωσαν",515,541],["οἱ",1,128],["ἐνδιαβάλλοντές",4091,137],["με",6,98],["ἐντροπήν",3439,10],["καὶ",2,8],["περιβαλέσθωσαν",743,541],["ὡς",36,8],["διπλοΐδα",2897,10],["αἰσχύνην",683,10],["αὐτῶν",3,41]],"Let those that falsely accuse me be clothed with shame, and let them cover themselves with their shame as with a mantle."],["30",[["Ἐξομολογήσομαι",478,176],["τῷ",1,110],["Κυρίῳ",7,113],["σφόδρα",149,17],["ἐν",4,1],["τῷ",1,52],["στόματί",123,53],["μου",6,48],["καὶ",2,8],["ἐν",4,1],["μέσῳ",112,34],["πολλῶν",74,163],["αἰνέσω",399,157],["αὐτόν",3,82]],"I will give thanks to the Lord abundantly with my mouth; and in the midst of many I will praise him."],["31",[["Ὅτι",19,8],["παρέστη",592,3],["ἐκ",21,1],["δεξιῶν",282,79],["πένητος",668,21],["τοῦ",1,30],["σῶσαι",171,100],["ἐκ",21,1],["τῶν",1,76],["καταδιωκόντων",619,164],["τὴν",1,9],["ψυχήν",62,10],["μου",6,48]],"For he stood on the right hand of the poor, to save [me] from them that persecute my soul."]]