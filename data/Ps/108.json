[["1",[["Εἰς",8,1],["τὸ",1,32],["τέλος",373,33],["ψαλμὸς",644,5],["τῷ",1,110],["Δαυίδ",52,105],["Ὁ",1,4],["Θεὸς",20,5],["τὴν",1,9],["αἴνεσίν",989,10],["μου",6,48],["μὴ",25,8],["παρασιωπήσῃς",1908,170]],"For the end, a Psalm of David. O God, pass not over my praise in silence;"],["2",[["ὅτι",19,8],["στόμα",123,33],["ἁμαρτωλοῦ",409,153],["καὶ",2,8],["στόμα",123,33],["δολίου",1545,153],["ἐπʼ",9,1],["ἐμὲ",6,82],["ἠνοίχθη",362,38],["ἐλάλησαν",50,141],["κατʼ",32,1],["ἐμοῦ",6,48],["γλώσσῃ",388,2],["δολίᾳ",1545,96]],"for the mouth of the sinner and the mouth of the crafty [man] have been opened against me: they have spoken against me with a crafty tongue."],["3",[["καὶ",2,8],["λόγοις",48,139],["μίσους",2604,24],["ἐκύκλωσάν",603,141],["με",6,82],["καὶ",2,8],["ἐπολέμησάν",305,141],["με",6,82],["δωρέαν",1341,17]],"And they have compassed me with words of hatred; and fought against me without a cause."],["4",[["Ἀντὶ",158,1],["τοῦ",1,30],["ἀγαπᾷν",214,54],["με",6,82],["ἐνδιέβαλλόν",4082,129],["με",6,82],["ἐγὼ",6,158],["δὲ",14,12],["προσηυχόμην",551,374]],"Instead of loving me, they falsely accused me: but I continued to pray."],["5",[["Καὶ",2,8],["ἔθεντο",110,184],["κατʼ",32,1],["ἐμοῦ",6,48],["κακὰ",161,65],["ἀντὶ",158,1],["ἀγαθῶν",114,79],["καὶ",2,8],["μῖσος",2604,20],["ἀντὶ",158,1],["τῆς",1,18],["ἀγαπήσεώς",4479,19],["μου",6,83]],"And they rewarded me evil for good, and hatred for my love."],["6",[["Κατάστησον",314,198],["ἐπʼ",9,1],["αὐτὸν",3,82],["ἁμαρτωλὸν",409,59],["καὶ",2,8],["διάβολος",1720,16],["στήτω",78,46],["ἐκ",21,1],["δεξιῶν",282,79],["αὐτοῦ",3,48]],"Set thou a sinner against him; and let the devil stand at his right hand."],["7",[["Ἐν",4,1],["τῷ",1,110],["κρίνεσθαι",263,104],["αὐτὸν",3,82],["ἐξέλθοι",82,216],["καταδεδικασμένος",2582,408],["καὶ",2,8],["ἡ",1,11],["προσευχὴ",550,13],["αὐτοῦ",3,48],["γενέσθω",30,312],["εἰς",8,1],["ἁμαρτίαν",119,10]],"When he is judged, let him go forth condemned: and let his prayer become sin."],["8",[["Γενηθήτωσαν",30,50],["αἱ",1,185],["ἡμέραι",28,2],["αὐτοῦ",3,48],["ὀλίγαι",555,187],["καὶ",2,8],["τὴν",1,9],["ἐπισκοπὴν",1106,10],["αὐτοῦ",3,48],["λάβοι",46,216],["ἕτερος",253,16]],"Let his days be few: and let another take his office of overseer."],["9",[["Γενηθήτωσαν",30,50],["οἱ",1,128],["υἱοὶ",13,51],["αὐτοῦ",3,48],["ὀρφανοὶ",957,130],["καὶ",2,8],["ἡ",1,11],["γυνὴ",59,13],["αὐτοῦ",3,48],["χήρα",751,13]],"Let his children be orphans, and his wife a widow."],["10",[["Σαλευόμενοι",678,351],["μεταναστήτωσαν",5826,261],["οἱ",1,128],["υἱοὶ",13,51],["αὐτοῦ",3,48],["καὶ",2,8],["ἐπαιτησάτωσαν",6487,261],["ἐκβληθήτωσαν",585,50],["ἐκ",21,1],["τῶν",1,44],["οἰκοπέδων",4940,45],["αὐτῶν",3,168]],"Let his children wander without a dwelling-place, and beg: let them be cast out of their habitations."],["11",[["Ἐξερευνησάτω",1863,46],["δανειστὴς",4732,5],["πάντα",11,65],["ὅσα",103,43],["ὑπάρχει",418,87],["αὐτῷ",3,49],["καὶ",2,8],["διαρπασάτωσαν",1160,261],["ἀλλότριοι",381,130],["τοὺς",1,56],["πόνους",566,31],["αὐτοῦ",3,48]],"Let [his] creditor exact all that belongs to him: and let strangers spoil his labours."],["12",[["Μὴ",25,8],["ὑπαρξάτω",418,46],["αὐτῷ",3,49],["ἀντιλήμπτωρ",0,0],["μηδὲ",414,12],["γενηθήτω",30,25],["οἰκτίρμων",2102,16],["τοῖς",1,138],["ὀρφανοῖς",957,215],["αὐτοῦ",3,48]],"Let him have no helper; neither let there be any one to have compassion on his fatherless children."],["13",[["Γενηθήτω",30,25],["τὰ",1,42],["τέκνα",192,43],["αὐτοῦ",3,48],["εἰς",8,1],["ἐξολόθρευσιν",0,0],["ἐν",4,1],["γενεᾷ",286,2],["μιᾷ",58,96],["ἐξαλειφθείη",1085,544],["τὸ",1,32],["ὄνομα",57,33],["αὐτοῦ",3,48]],"Let his children be [given up] to utter destruction: in one generation let his name be blotted out."],["14",[["Ἀναμνησθείη",1651,544],["ἡ",1,11],["ἀνομία",275,13],["τῶν",1,76],["πατέρων",44,77],["αὐτοῦ",3,48],["ἔναντι",232,17],["Κυρίου",7,21],["καὶ",2,8],["ἡ",1,11],["ἁμαρτία",119,13],["τῆς",1,18],["μητρὸς",189,19],["αὐτοῦ",3,48],["μὴ",25,8],["ἐξαλειφθείη",1085,544]],"Let the iniquity of his fathers be remembered before the Lord; and let not the sin of his mother be blotted out."],["15",[["Γενηθήτωσαν",30,50],["ἐναντίον",138,17],["Κυρίου",7,21],["διαπαντὸς",510,17],["καὶ",2,8],["ἐξολοθρευθείη",291,544],["ἐκ",21,1],["γῆς",26,19],["τὸ",1,32],["μνημόσυνον",716,33],["αὐτῶν",3,41]],"Let them be before the Lord continually; and let their memorial be blotted out from the earth."],["16",[["Ἀνθʼ",158,1],["ὧν",24,97],["οὐκ",12,17],["ἐμνήσθη",230,38],["ποιῆσαι",23,100],["ἔλεος",183,33],["καὶ",2,8],["κατεδίωξεν",621,3],["ἄνθρωπον",43,7],["πένητα",672,7],["καὶ",2,8],["πτωχὸν",497,7],["καὶ",2,8],["κατανενυγμένον",2086,442],["τῇ",1,95],["καρδίᾳ",64,2],["τοῦ",1,30],["θανατῶσαι",382,100]],"Because he remembered not to shew mercy, but persecuted the needy and poor man, and [that] to slay him that was pricked in the heart."],["17",[["Καὶ",2,8],["ἠγάπησε",214,3],["κατάραν",1165,10],["καὶ",2,8],["ἥξει",260,120],["αὐτῷ",3,49],["καὶ",2,8],["οὐκ",12,17],["ἠθέλησεν",612,3],["εὐλογίαν",578,10],["καὶ",2,8],["μακρυνθήσεται",0,0],["ἀπʼ",17,1],["αὐτοῦ",3,48]],"He loved cursing also, and it shall come upon him; and he took not pleasure in blessing, so it shall be removed far from him."],["18",[["Καὶ",2,8],["ἐνεδύσατο",516,26],["κατάραν",1165,10],["ὡς",36,8],["ἱμάτιον",276,33],["καὶ",2,8],["εἰσῆλθεν",86,3],["ὡσεὶ",343,17],["ὕδωρ",85,33],["εἰς",8,1],["τὰ",1,42],["ἔγκατα",3753,43],["αὐτοῦ",3,48],["καὶ",2,8],["ὡσεὶ",343,17],["ἔλαιον",313,33],["ἐν",4,1],["τοῖς",1,91],["ὀστέοις",473,92],["αὐτοῦ",3,48]],"Yea, he put on cursing as a garment, and it is come as water into his bowels, and as oil into his bones."],["19",[["Γενηθήτω",30,25],["αὐτῷ",3,49],["ὡς",36,8],["ἱμάτιον",276,33],["ὃ",1,4],["περιβάλλεται",744,108],["καὶ",2,8],["ὡσεὶ",343,17],["ζώνη",1886,13],["ἣν",24,124],["διαπαντὸς",510,17],["περιζώννυται",1310,108]],"Let it be to him as a garment which he puts on, and as a girdle with which he girds himself continually."],["20",[["Τοῦτο",16,122],["τὸ",1,32],["ἔργον",105,33],["τῶν",1,76],["ἐνδιαβαλλόντων",4082,164],["με",6,82],["παρὰ",73,1],["Κυρίου",7,21],["καὶ",2,8],["τῶν",1,76],["λαλούντων",50,164],["πονηρὰ",164,15],["κατὰ",32,1],["τῆς",1,18],["ψυχῆς",63,19],["μου",6,83]],"This is the dealing of the Lord with those who falsely accuse me, and of them that speak evil against my soul."],["21",[["Καὶ",2,8],["σὺ",5,156],["Κύριε",7,250],["Κύριε",7,250],["ποίησον",23,198],["μετʼ",29,1],["ἐμοῦ",6,48],["ἕνεκεν",447,1],["τοῦ",1,23],["ὀνόματός",57,24],["σου",5,146],["ὅτι",19,8],["χρηστὸν",1359,28],["τὸ",1,27],["ἔλεός",183,20],["σου",5,146]],"But thou, O Lord, Lord, deal [mercifully] with me, for thy name's sake: for thy mercy is good."],["22",[["Ῥῦσαί",337,275],["με",6,82],["ὅτι",19,8],["πτωχὸς",497,5],["καὶ",2,8],["πένης",672,5],["εἰμὶ",10,149],["ἐγὼ",6,158],["καὶ",2,8],["ἡ",1,11],["καρδία",64,13],["μου",6,48],["τετάρακται",508,182],["ἐντός",3192,17],["μου",6,48]],"Deliver me, for I am poor and needy; and my heart is troubled within me."],["23",[["Ὡσεὶ",343,17],["σκιὰ",978,13],["ἐν",4,1],["τῷ",1,110],["ἐκκλῖναι",394,100],["αὐτὴν",3,98],["ἀντανῃρέθην",2982,94],["ἐξετινάχθην",1753,148],["ὡσεὶ",343,17],["ἀκρίδες",1361,180]],"I am removed as a shadow in its going down: I am tossed up and down like locusts."],["24",[["Τὰ",1,42],["γόνατά",1300,43],["μου",6,48],["ἠσθένησαν",771,141],["ἀπὸ",17,1],["νηστείας",1415,40],["καὶ",2,8],["ἡ",1,11],["σάρξ",287,13],["μου",6,48],["ἠλλοιώθη",1231,38],["διʼ",56,1],["ἔλαιον",313,33]],"My knees are weakened through fasting, and my flesh is changed by reason of [the want of] oil."],["25",[["Κᾀγὼ",613,105],["ἐγενήθην",30,148],["ὄνειδος",973,20],["αὐτοῖς",3,142],["εἴδοσάν",53,141],["με",6,82],["ἐσάλευσαν",678,141],["κεφαλὰς",144,40],["αὐτῶν",3,41]],"I became also a reproach to them: [when] they saw me they shook their heads."],["26",[["Βοήθησόν",553,198],["μοι",6,49],["Κύριε",7,250],["ὁ",1,4],["Θεός",20,5],["μου",6,48],["καὶ",2,8],["σῶσόν",172,198],["με",6,82],["κατὰ",32,1],["τὸ",1,32],["ἔλεός",183,33],["σου",5,146]],"Help me, O Lord my God; and save me according to thy mercy."],["27",[["Καὶ",2,8],["γνώτωσαν",79,261],["ὅτι",19,8],["ἡ",1,11],["χείρ",37,13],["σου",5,146],["αὕτη",16,101],["καὶ",2,8],["σὺ",5,156],["Κύριε",7,250],["ἐποίησας",23,154],["αὐτήν",3,98]],"And let them know that this is thy hand; and [that] thou, Lord, hast wrought it."],["28",[["Καταράσονται",779,484],["αὐτοὶ",3,195],["καὶ",2,8],["σὺ",5,156],["εὐλογήσεις",149,159],["οἱ",1,128],["ἐπανιστάμενοί",1216,351],["μοι",6,49],["αἰσχυνθήτωσαν",611,50],["ὁ",1,4],["δὲ",14,12],["δοῦλός",136,5],["σου",5,146],["εὐφρανθήσεται",244,125]],"Let them curse, but thou shalt bless: let them that rise up against me be ashamed, but let thy servant rejoice."],["29",[["Ἐνδυσάσθωσαν",516,533],["οἱ",1,128],["ἐνδιαβάλλοντές",4082,137],["με",6,98],["ἐντροπήν",3435,10],["καὶ",2,8],["περιβαλέσθωσαν",744,533],["ὡς",36,8],["διπλοΐδα",2883,10],["αἰσχύνην",685,10],["αὐτῶν",3,41]],"Let those that falsely accuse me be clothed with shame, and let them cover themselves with their shame as with a mantle."],["30",[["Ἐξομολογήσομαι",479,177],["τῷ",1,110],["Κυρίῳ",7,113],["σφόδρα",150,17],["ἐν",4,1],["τῷ",1,52],["στόματί",123,53],["μου",6,48],["καὶ",2,8],["ἐν",4,1],["μέσῳ",113,34],["πολλῶν",74,163],["αἰνέσω",402,157],["αὐτόν",3,82]],"I will give thanks to the Lord abundantly with my mouth; and in the midst of many I will praise him."],["31",[["Ὅτι",19,8],["παρέστη",595,3],["ἐκ",21,1],["δεξιῶν",282,79],["πένητος",672,21],["τοῦ",1,30],["σῶσαι",172,100],["ἐκ",21,1],["τῶν",1,76],["καταδιωκόντων",621,164],["τὴν",1,9],["ψυχήν",63,10],["μου",6,48]],"For he stood on the right hand of the poor, to save [me] from them that persecute my soul."]]