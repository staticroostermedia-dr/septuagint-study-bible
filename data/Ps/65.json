[["1",[["Εἰς",8,1],["τὸ",1,32],["τέλος",369,33],["ᾠδὴ",773,13],["ψαλμοῦ",639,21],["ἀναστάσεως",4036,19],["Ἀλαλάξατε",1989,69],["τῷ",1,110],["Θεῷ",20,113],["πᾶσα",11,15],["ἡ",1,11],["γῆ",26,13]],"For the end, a Song of a Psalm of resurrection. Shout unto God, all the earth."],["2",[["ψάλατε",901,69],["δὴ",193,12],["τῷ",1,52],["ὀνόματι",55,53],["αὐτοῦ",3,48],["δότε",33,69],["δόξαν",141,10],["αἰνέσει",399,120],["αὐτοῦ",3,48]],"O sing praises to his name; give glory to his praise."],["3",[["Εἴπατε",18,262],["τῷ",1,110],["Θεῷ",20,113],["ὡς",36,8],["φοβερὰ",1213,74],["τὰ",1,254],["ἔργα",104,63],["σου",5,146],["ἐν",4,1],["τῷ",1,52],["πλήθει",199,53],["τῆς",1,18],["δυνάμεώς",98,19],["σου",5,146],["ψεύσονταί",1311,127],["σε",5,161],["οἱ",1,128],["ἐχθροί",135,51],["σου",5,146]],"Say unto God, How awful are thy works! through the greatness of thy power thine enemies shall lie to thee."],["4",[["Πᾶσα",11,15],["ἡ",1,11],["γῆ",26,13],["προσκυνησάτωσάν",296,261],["σοι",5,151],["καὶ",2,8],["ψαλάτωσάν",901,261],["σοι",5,151],["ψαλάτωσαν",901,261],["τῷ",1,52],["ὀνόματί",55,53],["σου",5,146],["διάψαλμα",687,20]],"Let all the earth worship thee, and sing to thee; let them sing to thy name. Pause."],["5",[["Δεῦτε",1162,17],["καὶ",2,8],["ἴδετε",73,69],["τὰ",1,42],["ἔργα",104,43],["τοῦ",1,30],["Θεοῦ",20,21],["φοβερὸς",1213,16],["ἐν",4,1],["βουλαῖς",349,71],["ὑπὲρ",139,1],["τοὺς",1,56],["υἱοὺς",13,31],["τῶν",1,76],["ἀνθρώπων",43,77]],"Come and behold the works of God; [he is] terrible in [his] counsels beyond the children of men."],["6",[["Ὁ",1,4],["μεταστρέφων",1635,67],["τὴν",1,9],["θάλασσαν",137,10],["εἰς",8,1],["ξηρὰν",1187,37],["ἐν",4,1],["ποταμῷ",249,113],["διελεύσονται",427,127],["ποδί",208,113],["ἐκεῖ",76,17],["εὐφρανθησόμεθα",242,353],["ἐπʼ",9,1],["αὐτῷ",3,49]],"Who turns the sea into dry land; they shall go through the river on foot; there shall we rejoice in him,"],["7",[["τῷ",1,110],["δεσπόζοντι",2022,395],["ἐν",4,1],["τῇ",1,95],["δυναστείᾳ",919,2],["αὐτοῦ",3,48],["τοῦ",1,30],["αἰῶνος",100,21],["οἱ",1,128],["ὀφθαλμοὶ",91,51],["αὐτοῦ",3,48],["ἐπὶ",9,1],["τὰ",1,42],["ἔθνη",59,43],["ἐπιβλέπουσιν",516,189],["οἱ",1,128],["παραπικραίνοντες",1688,137],["μὴ",25,8],["ὑψούσθωσαν",327,72],["ἐν",4,1],["ἑαυτοῖς",92,142],["διάψαλμα",687,20]],"who by his power is Lord over the age, his eyes look upon the nations; let not them that provoke [him] be exalted in themselves. Pause."],["8",[["Εὐλογεῖτε",147,311],["ἔθνη",59,43],["τὸν",1,6],["Θεὸν",20,7],["ἡμῶν",6,41],["καὶ",2,8],["ἀκουτίσατε",3163,69],["τὴν",1,9],["φωνὴν",95,10],["τῆς",1,18],["αἰνέσεως",990,19],["αὐτοῦ",3,48]],"Bless our God, ye Gentiles, and make the voice of his praise to be heard;"],["9",[["τοῦ",1,30],["θεμένου",109,291],["τὴν",1,9],["ψυχήν",62,10],["μου",6,48],["εἰς",8,1],["ζωὴν",212,10],["καὶ",2,8],["μὴ",25,8],["δόντος",33,521],["εἰς",8,1],["σάλον",2642,7],["τοὺς",1,56],["πόδας",208,31],["μου",6,48]],"who quickens my soul in life, and does not suffer my feet to be moved."],["10",[["Ὅτι",19,8],["ἐδοκίμασας",1337,154],["ἡμᾶς",6,60],["ὁ",1,4],["Θεὸς",20,5],["ἐπύρωσας",939,154],["ἡμᾶς",6,60],["ὡς",36,8],["πυροῦται",939,108],["τὸ",1,32],["ἀργύριον",150,33]],"For thou, O God, hast proved us; thou hast tried us with fire as silver is tried."],["11",[["Εἰσήγαγες",389,154],["ἡμᾶς",6,60],["εἰς",8,1],["τὴν",1,9],["παγίδα",815,10],["ἔθου",109,169],["θλίψεις",437,179],["ἐπὶ",9,1],["τὸν",1,6],["νῶτον",2194,7],["ἡμῶν",6,41]],"Thou broughtest us into the snare; thou laidest afflictions on our back."],["12",[["ἐπεβίβασας",2677,154],["ἀνθρώπους",43,31],["ἐπὶ",9,1],["τὰς",1,39],["κεφαλὰς",144,40],["ἡμῶν",6,41],["διήλθομεν",427,288],["διὰ",54,1],["πυρὸς",118,24],["καὶ",2,8],["ὕδατος",85,24],["καὶ",2,8],["ἐξήγαγες",299,154],["ἡμᾶς",6,60],["εἰς",8,1],["ἀναψυχήν",5220,10]],"Thou didst mount men upon our heads; we went through fire and water; but thou broughtest us out into [a place of] refreshment."],["13",[["Εἰσελεύσομαι",88,176],["εἰς",8,1],["τὸν",1,6],["οἶκόν",34,7],["σου",5,146],["ἐν",4,1],["ὁλοκαυτώμασιν",317,92],["ἀποδώσω",311,157],["σοι",5,151],["τὰς",1,39],["εὐχάς",631,40],["μου",6,48]],"I will go into thine house with whole-burnt-offerings; I will pay thee my vows,"],["14",[["ἃς",24,184],["διέστειλε",907,3],["τὰ",1,42],["χείλη",361,43],["μου",6,48],["καὶ",2,8],["ἐλάλησε",50,3],["τὸ",1,32],["στόμα",123,33],["μου",6,48],["ἐν",4,1],["τῇ",1,95],["θλίψει",437,2],["μου",6,48]],"which my lips framed, and my mouth uttered in my affliction."],["15",[["Ὁλοκαυτώματα",317,43],["μεμυελωμένα",0,0],["ἀνοίσω",382,157],["σοι",5,151],["μετὰ",29,1],["θυμιάματος",652,24],["καὶ",2,8],["κριῶν",332,77],["ποιήσω",23,227],["σοι",5,151],["βόας",408,31],["μετὰ",29,1],["χιμάρων",914,77],["διάψαλμα",687,20]],"I will offer to thee whole-burnt-sacrifices full of marrow, with incense and rams; I will sacrifice to thee oxen with goats. Pause."],["16",[["Δεῦτε",1162,17],["ἀκούσατε",53,69],["καὶ",2,8],["διηγήσομαι",797,176],["πάντες",11,130],["οἱ",1,128],["φοβούμενοι",134,356],["τὸν",1,6],["Θεὸν",20,7],["ὅσα",102,63],["ἐποίησε",23,3],["τῇ",1,95],["ψυχῇ",62,2],["μου",6,48]],"Come, hear, and I will tell, all ye that fear God, how great things he has done for my soul."],["17",[["Πρὸς",15,1],["αὐτὸν",3,82],["τῷ",1,52],["στόματί",123,53],["μου",6,48],["ἐκέκραξα",590,147],["καὶ",2,8],["ὕψωσα",327,147],["ὑπὸ",122,1],["τὴν",1,9],["γλῶσσάν",385,10],["μου",6,48]],"I cried to him with my mouth, and exalted him with my tongue."],["18",[["Ἀδικίαν",288,10],["εἰ",77,8],["ἐθεώρουν",898,129],["ἐν",4,1],["καρδίᾳ",63,2],["μου",6,48],["μὴ",25,8],["εἰσακουσάτω",237,46],["Κύριος",7,5]],"If I have regarded iniquity in my heart, let not the Lord hearken [to me]."],["19",[["Διὰ",54,1],["τοῦτο",16,122],["εἰσήκουσέ",237,3],["μου",6,48],["ὁ",1,4],["Θεὸς",20,5],["προσέσχε",557,3],["τῇ",1,95],["φωνῇ",95,2],["τῆς",1,18],["προσευχῆς",549,19],["μου",6,83]],"Therefore God has hearkened to me; he has attended to the voice of my prayer."],["20",[["Εὐλογητὸς",763,16],["ὁ",1,4],["Θεὸς",20,5],["ὃς",24,247],["οὐκ",12,17],["ἀπέστησε",646,3],["τὴν",1,9],["προσευχήν",549,10],["μου",6,48],["καὶ",2,8],["τὸ",1,32],["ἔλεος",182,33],["αὐτοῦ",3,48],["ἀπʼ",17,1],["ἐμοῦ",6,48]],"Blessed be God, who has not turned away my prayer, nor his mercy from me."]]