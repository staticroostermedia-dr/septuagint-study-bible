[["1",[["Εἰς",8,1],["τὸ",1,32],["τέλος",369,33],["ὑπὲρ",139,1],["τῶν",1,76],["ἀλλοιωθησομένων",1289,695],["μαρτύριον",220,33],["τῷ",1,110],["Ἀσὰφ",1105,5],["ψαλμὸς",639,5],["ὑπὲρ",139,1],["τοῦ",1,30],["Ἀσσυρίου",414,153]],"For the end, for alternate [strains], a testimony for Asaph, a Psalm concerning the Assyrian."],["2",[["Ὁ",1,4],["Ποιμαίνων",955,67],["τὸν",1,6],["Ἰσραὴλ",27,105],["πρόσχες",1692,154],["ὁ",1,4],["ὁδηγῶν",1110,67],["ὡσεὶ",342,17],["πρόβατα",194,43],["τὸν",1,6],["Ἰωσήφ",262,105],["ὁ",1,4],["καθήμενος",417,414],["ἐπὶ",9,1],["τῶν",1,76],["χερουβὶμ",756,105],["ἐμφάνηθι",6477,242]],"Attend, O Shepherd of Israel, who guidest Joseph like a flock; thou who sittest upon the cherubs, manifest thyself;"],["3",[["ἐναντίον",138,17],["Ἐφραὶμ",307,105],["καὶ",2,8],["Βενιαμὶν",357,105],["καὶ",2,8],["Μανασσῆ",394,251],["ἐξέγειρον",650,198],["τὴν",1,9],["δυναστείαν",919,10],["σου",5,146],["καὶ",2,8],["ἐλθὲ",56,198],["εἰς",8,1],["τὸ",1,32],["σῶσαι",171,100],["ἡμᾶς",6,60]],"before Ephraim and Benjamin and Manasse, stir up thy power, and come to deliver us."],["4",[["Ὁ",1,4],["Θεὸς",20,5],["ἐπίστρεψον",116,198],["ἡμᾶς",6,60],["καὶ",2,8],["ἐπίφανον",1709,198],["τὸ",1,32],["πρόσωπόν",47,33],["σου",5,146],["καὶ",2,8],["σωθησόμεθα",171,353]],"Turn us, O God, and cause thy face to shine; and we shall be delivered."],["5",[["Κύριε",7,251],["ὁ",1,4],["Θεὸς",20,5],["τῶν",1,123],["δυνάμεων",98,61],["ἕως",42,8],["πότε",455,12],["ὀργίζῃ",725,166],["ἐπὶ",9,1],["τὴν",1,9],["προσευχὴν",549,10],["τοῦ",1,30],["δούλου",136,21],["σου",5,146]],"O Lord God of hosts, how long art thou angry with the prayer of thy servant?"],["6",[["Ψωμιεῖς",1793,159],["ἡμᾶς",6,60],["ἄρτον",197,7],["δακρύων",1268,45],["καὶ",2,8],["ποτιεῖς",788,159],["ἡμᾶς",6,60],["ἐν",4,1],["δάκρυσιν",1268,90],["ἐν",4,1],["μέτρῳ",718,53]],"Thou wilt feed us with bread of tears; and wilt cause us to drink tears by measure."],["7",[["Ἔθου",109,169],["ἡμᾶς",6,60],["εἰς",8,1],["ἀντιλογίαν",1850,10],["τοῖς",1,138],["γείτοσιν",2078,139],["ἡμῶν",6,41],["καὶ",2,8],["οἱ",1,128],["ἐχθροὶ",135,51],["ἡμῶν",6,41],["ἐμυκτήρισαν",2103,141],["ἡμᾶς",6,60]],"Thou hast made us a strife to our neighbours; and our enemies have mocked at us."],["8",[["Κύριε",7,251],["ὁ",1,4],["Θεὸς",20,5],["τῶν",1,123],["δυνάμεων",98,61],["ἐπίστρεψον",116,198],["ἡμᾶς",6,60],["καὶ",2,8],["ἐπίφανον",1709,198],["τὸ",1,32],["πρόσωπόν",47,33],["σου",5,146],["καὶ",2,8],["σωθησόμεθα",171,353],["διάψαλμα",687,20]],"Turn us, O Lord God of hosts, and cause thy face to shine; and we shall be saved. Pause."],["9",[["Ἄμπελον",810,10],["ἐξ",21,1],["Αἰγύπτου",93,19],["μετῇρας",0,0],["ἐξέβαλες",582,154],["ἔθνη",59,43],["καὶ",2,8],["κατεφύτευσας",1727,154],["αὐτήν",3,98]],"Thou hast transplanted a vine out of Egypt: thou hast cast out the heathen, and planted it."],["10",[["Ὡδοποίησας",4140,154],["ἔμπροσθεν",387,17],["αὐτῆς",3,83],["καὶ",2,8],["κατεφύτευσας",1727,154],["τὰς",1,39],["ῥίζας",893,40],["αὐτῆς",3,83],["καὶ",2,8],["ἐπλήσθη",911,38],["ἡ",1,11],["γῆ",26,13]],"Thou madest a way before it, and didst cause its roots to strike, and the land was filled [with it]."],["11",[["Ἐκάλυψεν",618,3],["ὄρη",86,63],["ἡ",1,11],["σκιὰ",978,13],["αὐτῆς",3,83],["καὶ",2,8],["αἱ",1,183],["ἀναδενδράδες",6290,179],["αὐτῆς",3,83],["τὰς",1,39],["κέδρους",874,40],["τοῦ",1,30],["Θεοῦ",20,21]],"Its shadow covered the mountains, and its shoots [equalled] the goodly cedars."],["12",[["Ἐξέτεινε",419,3],["τὰ",1,42],["κλήματα",2594,43],["αὐτῆς",3,83],["ἕως",42,8],["θαλάσσης",137,19],["καὶ",2,8],["ἕως",42,8],["ποταμοῦ",249,21],["τὰς",1,39],["παραφυάδας",3925,40],["αὐτῆς",3,83]],"It sent forth its branches to the sea, and its shoots to the river."],["13",[["Ἱνατί",101,238],["καθεῖλες",610,154],["τὸν",1,6],["φραγμὸν",1983,7],["αὐτῆς",3,83],["καὶ",2,8],["τρυγῶσιν",2307,189],["αὐτὴν",3,98],["πάντες",11,130],["οἱ",1,128],["παραπορευόμενοι",1251,356],["τὴν",1,9],["ὁδόν",67,10]],"Wherefore hast thou broken down its hedge, while all that pass by the way pluck it?"],["14",[["Ἐλυμῄνατο",0,0],["αὐτὴν",3,98],["σῦς",4690,13],["ἐκ",21,1],["δρυμοῦ",799,21],["καὶ",2,8],["μονιὸς",7756,16],["ἄγριος",1454,16],["κατενεμήσατο",7468,26],["αὐτήν",3,98]],"The boar out of the wood has laid it waste, and the wild beast has devoured it."],["15",[["Ὁ",1,4],["Θεὸς",20,5],["τῶν",1,123],["δυνάμεων",98,61],["ἐπίστρεψον",116,198],["δὴ",193,12],["ἐπίβλεψον",516,198],["ἐξ",21,1],["οὐρανοῦ",94,21],["καὶ",2,8],["ἴδε",693,17],["καὶ",2,8],["ἐπίσκεψαι",429,296],["τὴν",1,9],["ἄμπελον",810,10],["ταύτην",16,234]],"O God of hosts, turn, we pray thee: look on [us] from heaven, and behold and visit this vine;"],["16",[["Καὶ",2,8],["κατάρτισαι",1962,296],["αὐτὴν",3,98],["ἣν",24,124],["ἐφύτευσεν",1066,3],["ἡ",1,11],["δεξιά",282,15],["σου",5,146],["καὶ",2,8],["ἐπὶ",9,1],["υἱὸν",13,7],["ἀνθρώπου",43,21],["ὃν",24,106],["ἐκραταίωσας",734,154],["σεαυτῷ",293,49]],"and restore that which thy right hand has planted: and look on the son of man whom thou didst strengthen for thyself."],["17",[["Ἐμπεπυρισμένη",0,0],["πυρὶ",118,53],["καὶ",2,8],["ἀνεσκαμμένη",8952,197],["ἀπὸ",17,1],["ἐπιτιμήσεως",3449,19],["τοῦ",1,23],["προσώπου",47,24],["σου",5,146],["ἀπολοῦνται",213,127]],"[It is] burnt with fire and dug up: they shall perish at the rebuke of thy presence."],["18",[["Γενηθήτω",30,25],["ἡ",1,11],["χείρ",37,13],["σου",5,146],["ἐπʼ",9,1],["ἄνδρα",38,7],["δεξιᾶς",282,78],["σου",5,146],["καὶ",2,8],["ἐπὶ",9,1],["υἱὸν",13,7],["ἀνθρώπου",43,21],["ὃν",24,106],["ἐκραταίωσας",734,154],["σεαυτῷ",293,49]],"Let thy hand be upon the man of thy right hand, and upon the son of man whom thou didst strengthen for thyself."],["19",[["Καὶ",2,8],["οὐ",12,17],["μὴ",25,8],["ἀποστῶμεν",2055,269],["ἀπὸ",17,1],["σοῦ",5,146],["ζωώσεις",117,159],["ἡμᾶς",6,60],["καὶ",2,8],["τὸ",1,32],["ὄνομά",55,33],["σου",5,146],["ἐπικαλεσόμεθα",340,132]],"So will we not depart from thee: thou shalt quicken us, and we will call upon thy name."],["20",[["Κύριε",7,251],["ὁ",1,4],["Θεὸς",20,5],["τῶν",1,123],["δυνάμεων",98,61],["ἐπίστρεψον",116,198],["ἡμᾶς",6,60],["καὶ",2,8],["ἐπίφανον",1709,198],["τὸ",1,32],["πρόσωπόν",47,33],["σου",5,146],["καὶ",2,8],["σωθησόμεθα",171,353]],"Turn us, O Lord God of hosts, and make thy face to shine; and we shall be saved."]]