[["1",[["Εἰς",8,1],["τὸ",1,32],["τέλος",373,33],["ὑπὲρ",139,1],["τῶν",1,76],["ἀλλοιωθησομένων",1231,673],["μαρτύριον",225,33],["τῷ",1,110],["Ἀσὰφ",1103,5],["ψαλμὸς",644,5],["ὑπὲρ",139,1],["τοῦ",1,30],["Ἀσσυρίου",15579,153]],"For the end, for alternate [strains], a testimony for Asaph, a Psalm concerning the Assyrian."],["2",[["Ὁ",1,4],["Ποιμαίνων",953,67],["τὸν",1,6],["Ἰσραὴλ",27,105],["πρόσχες",1689,154],["ὁ",1,4],["ὁδηγῶν",1108,67],["ὡσεὶ",343,17],["πρόβατα",194,43],["τὸν",1,6],["Ἰωσήφ",262,105],["ὁ",1,4],["καθήμενος",419,407],["ἐπὶ",9,1],["τῶν",1,76],["χερουβὶμ",759,105],["ἐμφάνηθι",6444,242]],"Attend, O Shepherd of Israel, who guidest Joseph like a flock; thou who sittest upon the cherubs, manifest thyself;"],["3",[["ἐναντίον",138,17],["Ἐφραὶμ",308,105],["καὶ",2,8],["Βενιαμὶν",358,105],["καὶ",2,8],["Μανασσῆ",396,250],["ἐξέγειρον",656,198],["τὴν",1,9],["δυναστείαν",918,10],["σου",5,146],["καὶ",2,8],["ἐλθὲ",55,198],["εἰς",8,1],["τὸ",1,32],["σῶσαι",172,100],["ἡμᾶς",6,60]],"before Ephraim and Benjamin and Manasse, stir up thy power, and come to deliver us."],["4",[["Ὁ",1,4],["Θεὸς",20,5],["ἐπίστρεψον",117,198],["ἡμᾶς",6,60],["καὶ",2,8],["ἐπίφανον",1707,198],["τὸ",1,32],["πρόσωπόν",47,33],["σου",5,146],["καὶ",2,8],["σωθησόμεθα",172,349]],"Turn us, O God, and cause thy face to shine; and we shall be delivered."],["5",[["Κύριε",7,250],["ὁ",1,4],["Θεὸς",20,5],["τῶν",1,123],["δυνάμεων",98,61],["ἕως",42,8],["πότε",458,12],["ὀργίζῃ",725,166],["ἐπὶ",9,1],["τὴν",1,9],["προσευχὴν",550,10],["τοῦ",1,30],["δούλου",136,21],["σου",5,146]],"O Lord God of hosts, how long art thou angry with the prayer of thy servant?"],["6",[["Ψωμιεῖς",1793,159],["ἡμᾶς",6,60],["ἄρτον",197,7],["δακρύων",1268,45],["καὶ",2,8],["ποτιεῖς",790,159],["ἡμᾶς",6,60],["ἐν",4,1],["δάκρυσιν",1268,90],["ἐν",4,1],["μέτρῳ",717,53]],"Thou wilt feed us with bread of tears; and wilt cause us to drink tears by measure."],["7",[["Ἔθου",110,169],["ἡμᾶς",6,60],["εἰς",8,1],["ἀντιλογίαν",1851,10],["τοῖς",1,138],["γείτοσιν",2072,139],["ἡμῶν",6,41],["καὶ",2,8],["οἱ",1,128],["ἐχθροὶ",135,51],["ἡμῶν",6,41],["ἐμυκτήρισαν",2096,141],["ἡμᾶς",6,60]],"Thou hast made us a strife to our neighbours; and our enemies have mocked at us."],["8",[["Κύριε",7,250],["ὁ",1,4],["Θεὸς",20,5],["τῶν",1,123],["δυνάμεων",98,61],["ἐπίστρεψον",117,198],["ἡμᾶς",6,60],["καὶ",2,8],["ἐπίφανον",1707,198],["τὸ",1,32],["πρόσωπόν",47,33],["σου",5,146],["καὶ",2,8],["σωθησόμεθα",172,349],["διάψαλμα",689,20]],"Turn us, O Lord God of hosts, and cause thy face to shine; and we shall be saved. Pause."],["9",[["Ἄμπελον",812,10],["ἐξ",21,1],["Αἰγύπτου",93,19],["μετῇρας",4308,154],["ἐξέβαλες",585,154],["ἔθνη",60,43],["καὶ",2,8],["κατεφύτευσας",1727,154],["αὐτήν",3,98]],"Thou hast transplanted a vine out of Egypt: thou hast cast out the heathen, and planted it."],["10",[["Ὡδοποίησας",4129,154],["ἔμπροσθεν",390,17],["αὐτῆς",3,83],["καὶ",2,8],["κατεφύτευσας",1727,154],["τὰς",1,39],["ῥίζας",892,40],["αὐτῆς",3,83],["καὶ",2,8],["ἐπλήσθη",909,38],["ἡ",1,11],["γῆ",26,13]],"Thou madest a way before it, and didst cause its roots to strike, and the land was filled [with it]."],["11",[["Ἐκάλυψεν",620,3],["ὄρη",87,63],["ἡ",1,11],["σκιὰ",978,13],["αὐτῆς",3,83],["καὶ",2,8],["αἱ",1,185],["ἀναδενδράδες",6259,180],["αὐτῆς",3,83],["τὰς",1,39],["κέδρους",873,40],["τοῦ",1,30],["Θεοῦ",20,21]],"Its shadow covered the mountains, and its shoots [equalled] the goodly cedars."],["12",[["Ἐξέτεινε",421,3],["τὰ",1,42],["κλήματα",2589,43],["αὐτῆς",3,83],["ἕως",42,8],["θαλάσσης",137,19],["καὶ",2,8],["ἕως",42,8],["ποταμοῦ",249,21],["τὰς",1,39],["παραφυάδας",3915,40],["αὐτῆς",3,83]],"It sent forth its branches to the sea, and its shoots to the river."],["13",[["Ἱνατί",102,238],["καθεῖλες",602,154],["τὸν",1,6],["φραγμὸν",1979,7],["αὐτῆς",3,83],["καὶ",2,8],["τρυγῶσιν",2295,191],["αὐτὴν",3,98],["πάντες",11,130],["οἱ",1,128],["παραπορευόμενοι",1250,351],["τὴν",1,9],["ὁδόν",68,10]],"Wherefore hast thou broken down its hedge, while all that pass by the way pluck it?"],["14",[["Ἐλυμῄνατο",0,0],["αὐτὴν",3,98],["σῦς",4665,13],["ἐκ",21,1],["δρυμοῦ",802,21],["καὶ",2,8],["μονιὸς",7701,16],["ἄγριος",1454,16],["κατενεμήσατο",7419,26],["αὐτήν",3,98]],"The boar out of the wood has laid it waste, and the wild beast has devoured it."],["15",[["Ὁ",1,4],["Θεὸς",20,5],["τῶν",1,123],["δυνάμεων",98,61],["ἐπίστρεψον",117,198],["δὴ",193,12],["ἐπίβλεψον",517,198],["ἐξ",21,1],["οὐρανοῦ",94,21],["καὶ",2,8],["ἴδε",713,17],["καὶ",2,8],["ἐπίσκεψαι",375,379],["τὴν",1,9],["ἄμπελον",812,10],["ταύτην",16,234]],"O God of hosts, turn, we pray thee: look on [us] from heaven, and behold and visit this vine;"],["16",[["Καὶ",2,8],["κατάρτισαι",1888,275],["αὐτὴν",3,98],["ἣν",24,124],["ἐφύτευσεν",1022,3],["ἡ",1,11],["δεξιά",282,15],["σου",5,146],["καὶ",2,8],["ἐπὶ",9,1],["υἱὸν",13,7],["ἀνθρώπου",43,21],["ὃν",24,106],["ἐκραταίωσας",729,154],["σεαυτῷ",255,49]],"and restore that which thy right hand has planted: and look on the son of man whom thou didst strengthen for thyself."],["17",[["Ἐμπεπυρισμένη",0,0],["πυρὶ",118,53],["καὶ",2,8],["ἀνεσκαμμένη",6266,197],["ἀπὸ",17,1],["ἐπιτιμήσεως",3446,19],["τοῦ",1,23],["προσώπου",47,24],["σου",5,146],["ἀπολοῦνται",217,127]],"[It is] burnt with fire and dug up: they shall perish at the rebuke of thy presence."],["18",[["Γενηθήτω",30,25],["ἡ",1,11],["χείρ",37,13],["σου",5,146],["ἐπʼ",9,1],["ἄνδρα",38,7],["δεξιᾶς",282,78],["σου",5,146],["καὶ",2,8],["ἐπὶ",9,1],["υἱὸν",13,7],["ἀνθρώπου",43,21],["ὃν",24,106],["ἐκραταίωσας",729,154],["σεαυτῷ",255,49]],"Let thy hand be upon the man of thy right hand, and upon the son of man whom thou didst strengthen for thyself."],["19",[["Καὶ",2,8],["οὐ",12,17],["μὴ",25,8],["ἀποστῶμεν",293,75],["ἀπὸ",17,1],["σοῦ",5,146],["ζωώσεις",107,159],["ἡμᾶς",6,60],["καὶ",2,8],["τὸ",1,32],["ὄνομά",57,33],["σου",5,146],["ἐπικαλεσόμεθα",341,132]],"So will we not depart from thee: thou shalt quicken us, and we will call upon thy name."],["20",[["Κύριε",7,250],["ὁ",1,4],["Θεὸς",20,5],["τῶν",1,123],["δυνάμεων",98,61],["ἐπίστρεψον",117,198],["ἡμᾶς",6,60],["καὶ",2,8],["ἐπίφανον",1707,198],["τὸ",1,32],["πρόσωπόν",47,33],["σου",5,146],["καὶ",2,8],["σωθησόμεθα",172,349]],"Turn us, O Lord God of hosts, and make thy face to shine; and we shall be saved."]]