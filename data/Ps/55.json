[["1",[["Εἰς",8,1],["τὸ",1,32],["τέλος",373,33],["ὑπὲρ",139,1],["τοῦ",1,30],["λαοῦ",35,21],["τοῦ",1,30],["ἀπὸ",17,1],["τῶν",1,76],["ἁγίων",75,163],["μεμακρυμμένου",0,0],["τῷ",1,110],["Δαυὶδ",52,105],["εἰς",8,1],["στηλογραφίαν",3640,10],["ὁπότε",3224,17],["ἐκράτησαν",385,141],["αὐτὸν",3,82],["οἱ",1,128],["ἀλλόφυλοι",203,130],["ἐν",4,1],["Γέθ",11630,0]],"For the end, concerning the people that were removed from the sanctuary, by David for a memorial, when the Philistines caught him in Geth."],["2",[["Ἐλεήσον",446,171],["με",6,82],["ὁ",1,4],["Θεὸς",20,5],["ὅτι",19,8],["κατεπάτησέ",1117,3],["με",6,98],["ἄνθρωπος",43,5],["ὅλην",235,37],["τὴν",1,9],["ἡμέραν",28,10],["πολεμῶν",305,67],["ἔθλιψέ",601,3],["με",6,82]],"Have mercy upon me, O God; for man has trodden me down; all the day long he warring has afflicted me."],["3",[["Κατεπάτησάν",1117,141],["με",6,82],["οἱ",1,128],["ἐχθροί",135,51],["μου",6,48],["ὅλην",235,37],["τὴν",1,9],["ἡμέραν",28,10],["ἀπὸ",17,1],["ὕψους",481,24],["ἡμέρας",28,19],["ὅτι",19,8],["πολλοὶ",74,130],["οἱ",1,128],["πολεμοῦντές",305,137],["με",6,82]],"Mine enemies have trodden me down all the day from the dawning of the day; for there are many warring against me."],["4",[["Φοβηθήσονται",134,135],["ἐγὼ",6,158],["δὲ",14,12],["ἐλπιῶ",514,157],["ἐπὶ",9,1],["σοί",5,151]],"They shall be afraid, but I will trust in thee."],["5",[["Ἐν",4,1],["τῷ",1,110],["Θεῷ",20,113],["ἐπαινέσω",1534,227],["τοὺς",1,56],["λόγους",48,31],["μου",6,48],["ὅλην",235,37],["τὴν",1,9],["ἡμέραν",28,10],["ἐν",4,1],["τῷ",1,110],["Θεῷ",20,113],["ἤλπισα",514,147],["οὐ",12,17],["φοβηθήσομαι",134,176],["τί",39,119],["ποιήσει",23,120],["μοι",6,49],["σάρξ",287,13]],"In God I will praise my words; all the day have I hoped in God; I will not fear what flesh shall do to me."],["6",[["Ὅλην",235,37],["τὴν",1,9],["ἡμέραν",28,10],["τοὺς",1,56],["λόγους",48,31],["μου",6,48],["ἐβδελύσσοντο",1056,131],["κατʼ",32,1],["ἐμοῦ",6,48],["πάντες",11,130],["οἱ",1,128],["διαλογισμοὶ",1584,51],["αὐτῶν",3,41],["εἰς",8,1],["κακόν",161,29]],"All the day long they have abominated my words; all their devices [are] against me for evil."],["7",[["Παροικήσουσι",782,350],["καὶ",2,8],["κατακρύψουσιν",2019,350],["αὐτοὶ",3,195],["τὴν",1,9],["πτέρναν",2625,10],["μου",6,48],["φυλάξουσι",125,207],["καθάπερ",690,8],["ὑπέμεινα",639,147],["τῇ",1,95],["ψυχῇ",63,2],["μου",6,48]],"They will dwell near and hide [themselves]; they will watch my steps, accordingly as I have waited patiently in my soul."],["8",[["Ὑπὲρ",139,1],["τοῦ",1,30],["μηθενὸς",908,219],["σώσεις",172,159],["αὐτοὺς",3,60],["ἐν",4,1],["ὀργῇ",198,2],["λαοὺς",35,31],["κατάξεις",735,159],["ὁ",1,4],["Θεὸς",20,5]],"Thou wilt on no account save them; thou wilt bring down the people in wrath. O God,",{"s":"r"}],["9",[["τὴν",1,9],["ζωήν",216,10],["μου",6,48],["ἐξήγγειλά",2532,147],["σοι",5,151],["ἔθου",110,169],["τὰ",1,42],["δάκρυά",1268,43],["μου",6,48],["ἐνώπιόν",115,1],["σου",5,146],["ὡς",36,8],["καὶ",2,8],["ἐν",4,1],["τῇ",1,95],["ἐπαγγελίᾳ",3439,2],["σου",5,146]],"I have declared my life to thee; thou hast set my tears before thee, even according to thy promise.",{"s":"r"}],["10",[["Ἐπιστρέψουσιν",117,207],["οἱ",1,128],["ἐχθροί",135,51],["μου",6,48],["εἰς",8,1],["τὰ",1,42],["ὀπίσω",167,17],["ἐν",4,1],["ᾗ",24,102],["ἂν",83,12],["ἡμέρᾳ",28,2],["ἐπικαλέσωμαί",341,255],["σε",5,161],["ἰδοὺ",51,17],["ἔγνων",79,147],["ὅτι",19,8],["Θεός",20,5],["μου",6,48],["εἶ",10,145],["σύ",5,156]],"Mine enemies shall be turned back, in the day wherein I shall call upon thee; behold, I know that thou art my God."],["11",[["Ἐπὶ",9,1],["τῷ",1,110],["Θεῷ",20,113],["αἰνέσω",402,157],["ῥῆμα",116,33],["ἐπὶ",9,1],["τῷ",1,110],["Κυρίῳ",7,113],["αἰνέσω",402,157],["λόγον",48,7]],"In God will I praise [his] word; in the Lord will I praise [his] saying."],["12",[["Ἐπὶ",9,1],["τῷ",1,110],["Θεῷ",20,113],["ἤλπισα",514,147],["οὐ",12,17],["φοβηθήσομαι",134,176],["τί",39,119],["ποιήσει",23,120],["μοι",6,49],["ἄνθρωπος",43,5]],"I have hoped in God; I will not be afraid of what man shall do to me."],["13",[["Ἐν",4,1],["ἐμοὶ",6,49],["ὁ",1,4],["Θεὸς",20,5],["αἱ",1,185],["εὐχαὶ",633,180],["ἃς",24,186],["ἀποδώσω",312,157],["αἰνέσεώς",989,19],["σου",5,146]],"The vows of thy praise, O God, which I will pay, are upon me."],["14",[["Ὅτι",19,8],["ἐῤῥύσω",337,169],["τὴν",1,9],["ψυχήν",63,10],["μου",6,48],["ἐκ",21,1],["θανάτου",170,21],["καὶ",2,8],["τοὺς",1,56],["πόδας",210,31],["μου",6,48],["ἐξ",21,1],["ὀλισθήματος",3021,24],["τοῦ",1,23],["εὐαρεστῆσαι",4223,100],["ἐνώπιον",115,1],["τοῦ",1,30],["Θεοῦ",20,21],["ἐν",4,1],["φωτὶ",380,113],["ζώντων",107,164]],"For thou hast delivered my soul from death, and my feet from sliding, that I should be well-pleasing before God in the land of the living."]]