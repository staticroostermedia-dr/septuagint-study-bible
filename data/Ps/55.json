[["1",[["Εἰς",8,1],["τὸ",1,32],["τέλος",369,33],["ὑπὲρ",139,1],["τοῦ",1,30],["λαοῦ",35,21],["τοῦ",1,30],["ἀπὸ",17,1],["τῶν",1,76],["ἁγίων",75,163],["μεμακρυμμένου",0,0],["τῷ",1,110],["Δαυὶδ",52,105],["εἰς",8,1],["στηλογραφίαν",3647,10],["ὁπότε",3229,17],["ἐκράτησαν",383,141],["αὐτὸν",3,82],["οἱ",1,128],["ἀλλόφυλοι",203,130],["ἐν",4,1],["Γέθ",0,0]],"For the end, concerning the people that were removed from the sanctuary, by David for a memorial, when the Philistines caught him in Geth."],["2",[["Ἐλεήσον",457,171],["με",6,82],["ὁ",1,4],["Θεὸς",20,5],["ὅτι",19,8],["κατεπάτησέ",1205,3],["με",6,98],["ἄνθρωπος",43,5],["ὅλην",233,37],["τὴν",1,9],["ἡμέραν",28,10],["πολεμῶν",304,67],["ἔθλιψέ",599,3],["με",6,82]],"Have mercy upon me, O God; for man has trodden me down; all the day long he warring has afflicted me."],["3",[["Κατεπάτησάν",1205,141],["με",6,82],["οἱ",1,128],["ἐχθροί",135,51],["μου",6,48],["ὅλην",233,37],["τὴν",1,9],["ἡμέραν",28,10],["ἀπὸ",17,1],["ὕψους",480,24],["ἡμέρας",28,19],["ὅτι",19,8],["πολλοὶ",74,130],["οἱ",1,128],["πολεμοῦντές",304,137],["με",6,82]],"Mine enemies have trodden me down all the day from the dawning of the day; for there are many warring against me."],["4",[["Φοβηθήσονται",134,135],["ἐγὼ",6,158],["δὲ",14,12],["ἐλπιῶ",511,157],["ἐπὶ",9,1],["σοί",5,151]],"They shall be afraid, but I will trust in thee."],["5",[["Ἐν",4,1],["τῷ",1,110],["Θεῷ",20,113],["ἐπαινέσω",1532,227],["τοὺς",1,56],["λόγους",48,31],["μου",6,48],["ὅλην",233,37],["τὴν",1,9],["ἡμέραν",28,10],["ἐν",4,1],["τῷ",1,110],["Θεῷ",20,113],["ἤλπισα",511,147],["οὐ",12,17],["φοβηθήσομαι",134,175],["τί",39,119],["ποιήσει",23,120],["μοι",6,49],["σάρξ",287,13]],"In God I will praise my words; all the day have I hoped in God; I will not fear what flesh shall do to me."],["6",[["Ὅλην",233,37],["τὴν",1,9],["ἡμέραν",28,10],["τοὺς",1,56],["λόγους",48,31],["μου",6,48],["ἐβδελύσσοντο",1202,131],["κατʼ",32,1],["ἐμοῦ",6,48],["πάντες",11,130],["οἱ",1,128],["διαλογισμοὶ",1585,51],["αὐτῶν",3,41],["εἰς",8,1],["κακόν",161,29]],"All the day long they have abominated my words; all their devices [are] against me for evil."],["7",[["Παροικήσουσι",781,355],["καὶ",2,8],["κατακρύψουσιν",2090,355],["αὐτοὶ",3,193],["τὴν",1,9],["πτέρναν",2628,10],["μου",6,48],["φυλάξουσι",127,207],["καθάπερ",688,8],["ὑπέμεινα",635,147],["τῇ",1,95],["ψυχῇ",62,2],["μου",6,48]],"They will dwell near and hide [themselves]; they will watch my steps, accordingly as I have waited patiently in my soul."],["8",[["Ὑπὲρ",139,1],["τοῦ",1,30],["μηθενὸς",910,218],["σώσεις",171,159],["αὐτοὺς",3,60],["ἐν",4,1],["ὀργῇ",198,2],["λαοὺς",35,31],["κατάξεις",741,159],["ὁ",1,4],["Θεὸς",20,5]],"Thou wilt on no account save them; thou wilt bring down the people in wrath."],["9",[["τὴν",1,9],["ζωήν",212,10],["μου",6,48],["ἐξήγγειλά",2535,147],["σοι",5,151],["ἔθου",109,169],["τὰ",1,42],["δάκρυά",1268,43],["μου",6,48],["ἐνώπιόν",114,1],["σου",5,146],["ὡς",36,8],["καὶ",2,8],["ἐν",4,1],["τῇ",1,95],["ἐπαγγελίᾳ",3442,2],["σου",5,146]],"O God, I have declared my life to thee; thou hast set my tears before thee, even according to thy promise."],["10",[["Ἐπιστρέψουσιν",116,207],["οἱ",1,128],["ἐχθροί",135,51],["μου",6,48],["εἰς",8,1],["τὰ",1,42],["ὀπίσω",166,17],["ἐν",4,1],["ᾗ",24,102],["ἂν",82,12],["ἡμέρᾳ",28,2],["ἐπικαλέσωμαί",340,255],["σε",5,161],["ἰδοὺ",51,17],["ἔγνων",81,147],["ὅτι",19,8],["Θεός",20,5],["μου",6,48],["εἶ",10,145],["σύ",5,156]],"Mine enemies shall be turned back, in the day wherein I shall call upon thee; behold, I know that thou art my God."],["11",[["Ἐπὶ",9,1],["τῷ",1,110],["Θεῷ",20,113],["αἰνέσω",399,157],["ῥῆμα",115,33],["ἐπὶ",9,1],["τῷ",1,110],["Κυρίῳ",7,113],["αἰνέσω",399,157],["λόγον",48,7]],"In God will I praise [his] word; in the Lord will I praise [his] saying."],["12",[["Ἐπὶ",9,1],["τῷ",1,110],["Θεῷ",20,113],["ἤλπισα",511,147],["οὐ",12,17],["φοβηθήσομαι",134,175],["τί",39,119],["ποιήσει",23,120],["μοι",6,49],["ἄνθρωπος",43,5]],"I have hoped in God; I will not be afraid of what man shall do to me."],["13",[["Ἐν",4,1],["ἐμοὶ",6,49],["ὁ",1,4],["Θεὸς",20,5],["αἱ",1,183],["εὐχαὶ",631,179],["ἃς",24,184],["ἀποδώσω",311,157],["αἰνέσεώς",990,19],["σου",5,146]],"The vows of thy praise, O God, which I will pay, are upon me."],["14",[["Ὅτι",19,8],["ἐῤῥύσω",335,169],["τὴν",1,9],["ψυχήν",62,10],["μου",6,48],["ἐκ",21,1],["θανάτου",169,21],["καὶ",2,8],["τοὺς",1,56],["πόδας",208,31],["μου",6,48],["ἐξ",21,1],["ὀλισθήματος",3033,24],["τοῦ",1,23],["εὐαρεστῆσαι",4236,100],["ἐνώπιον",114,1],["τοῦ",1,30],["Θεοῦ",20,21],["ἐν",4,1],["φωτὶ",376,113],["ζώντων",117,164]],"For thou hast delivered my soul from death, and my feet from sliding, that I should be well-pleasing before God in the land of the living."]]