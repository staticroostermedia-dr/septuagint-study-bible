[["1",[["Εἰς",8,1],["τὸ",1,32],["τέλος",369,33],["ψαλμὸς",639,5],["τῷ",1,110],["Δαυίδ",52,105],["Ἕως",42,8],["πότε",455,12],["Κύριε",7,251],["ἐπιλήσῃ",512,116],["μου",6,48],["εἰς",8,1],["τέλος",369,33],["ἕως",42,8],["πότε",455,12],["ἀποστρέψεις",130,159],["τὸ",1,32],["πρόσωπόν",47,33],["σου",5,146],["ἀπʼ",17,1],["ἐμοῦ",6,48]],"For the end, a Psalm of David."],["2",[["Ἕως",42,8],["τίνος",39,308],["θήσομαι",109,176],["βουλὰς",349,40],["ἐν",4,1],["ψυχῇ",62,2],["μου",6,48],["ὀδύνας",771,40],["ἐν",4,1],["καρδίᾳ",63,2],["μου",6,83],["ἡμέρας",28,19],["ἕως",42,8],["πότε",455,12],["ὑψωθήσεται",327,125],["ὁ",1,4],["ἐχθρός",135,5],["μου",6,48],["ἐπʼ",9,1],["ἐμέ",6,82]],"How long, O Lord, wilt thou forget me? for ever? how long wilt thou turn away thy face from me?"],["3",[["Ἐπίβλεψον",516,198],["εἰσάκουσόν",237,198],["μου",6,48],["Κύριε",7,251],["ὁ",1,4],["Θεός",20,5],["μου",6,48],["φώτισον",1232,198],["τοὺς",1,56],["ὀφθαλμούς",91,31],["μου",6,48],["μή",25,8],["ποτε",455,12],["ὑπνώσω",1665,157],["εἰς",8,1],["θάνατον",169,7]],"How long shall I take counsel in my soul, [having] sorrows in my heart daily? how long shall my enemy be exalted over me?"],["4",[["μή",25,8],["ποτε",455,12],["εἴποι",18,276],["ὁ",1,4],["ἐχθρός",135,5],["μου",6,48],["ἴσχυσα",565,147],["πρὸς",15,1],["αὐτόν",3,82],["οἱ",1,128],["θλίβοντές",599,137],["με",6,82],["ἀγαλλιάσονται",737,127],["ἐὰν",45,8],["σαλευθῶ",679,569]],"Look on me, hearken to me, O Lord my God: lighten mine eyes, lest I sleep in death;"],["5",[["Ἐγὼ",6,158],["δὲ",14,12],["ἐπὶ",9,1],["τῷ",1,52],["ἐλέει",182,53],["σου",5,146],["ἤλπισα",511,147],["ἀγαλλιάσεται",737,89],["ἡ",1,11],["καρδία",63,13],["μου",6,48],["ἐν",4,1],["τῷ",1,110],["σωτηρίῳ",1787,111],["σου",5,146]],"lest at any time mine enemy say, I have prevailed against him: my persecutors will exult if ever I should be moved."],["6",[["Ἄσω",5306,157],["τῷ",1,110],["Κυρίῳ",7,113],["τῷ",1,110],["εὐεργετήσαντί",2904,359],["με",6,82],["καὶ",2,8],["ψαλῶ",901,157],["τῷ",1,52],["ὀνόματι",55,53],["Κυρίου",7,21],["τοῦ",1,30],["ὑψίστου",473,153]],"But I have hoped in thy mercy; my heart shall exult in thy salvation. I will sing to the Lord who has dealt bountifully with me, and I will sing psalms to the name of the Lord most high."]]