[["1",[["Εἰς",8,1],["τὸ",1,32],["τέλος",373,33],["ψαλμὸς",644,5],["τῷ",1,110],["Δαυίδ",52,105],["Ἕως",42,8],["πότε",458,12],["Κύριε",7,250],["ἐπιλήσῃ",513,116],["μου",6,48],["εἰς",8,1],["τέλος",373,33],["ἕως",42,8],["πότε",458,12],["ἀποστρέψεις",130,159],["τὸ",1,32],["πρόσωπόν",47,33],["σου",5,146],["ἀπʼ",17,1],["ἐμοῦ",6,48]],"For the end, a Psalm of David. How long, O Lord, wilt thou forget me? for ever? how long wilt thou turn away thy face from me?",{"s":"r"}],["2",[["Ἕως",42,8],["τίνος",39,304],["θήσομαι",110,177],["βουλὰς",350,40],["ἐν",4,1],["ψυχῇ",63,2],["μου",6,48],["ὀδύνας",774,40],["ἐν",4,1],["καρδίᾳ",64,2],["μου",6,83],["ἡμέρας",28,19],["ἕως",42,8],["πότε",458,12],["ὑψωθήσεται",331,125],["ὁ",1,4],["ἐχθρός",135,5],["μου",6,48],["ἐπʼ",9,1],["ἐμέ",6,82]],"How long shall I take counsel in my soul, [having] sorrows in my heart daily?",{"s":"r"}],["3",[["Ἐπίβλεψον",517,198],["εἰσάκουσόν",241,198],["μου",6,48],["Κύριε",7,250],["ὁ",1,4],["Θεός",20,5],["μου",6,48],["φώτισον",1230,198],["τοὺς",1,56],["ὀφθαλμούς",91,31],["μου",6,48],["μή",25,8],["ποτε",458,12],["ὑπνώσω",1664,157],["εἰς",8,1],["θάνατον",170,7]],"how long shall my enemy be exalted over me? Look on me, hearken to me, O Lord my God:",{"s":"r"}],["4",[["μή",25,8],["ποτε",458,12],["εἴποι",18,216],["ὁ",1,4],["ἐχθρός",135,5],["μου",6,48],["ἴσχυσα",567,147],["πρὸς",15,1],["αὐτόν",3,82],["οἱ",1,128],["θλίβοντές",601,137],["με",6,82],["ἀγαλλιάσονται",738,127],["ἐὰν",45,8],["σαλευθῶ",678,555]],"lighten mine eyes, lest I sleep in death; lest at any time mine enemy say,",{"s":"r"}],["5",[["Ἐγὼ",6,158],["δὲ",14,12],["ἐπὶ",9,1],["τῷ",1,52],["ἐλέει",183,53],["σου",5,146],["ἤλπισα",514,147],["ἀγαλλιάσεται",738,89],["ἡ",1,11],["καρδία",64,13],["μου",6,48],["ἐν",4,1],["τῷ",1,110],["σωτηρίῳ",1788,111],["σου",5,146]],"I have prevailed against him: my persecutors will exult if ever I should be moved. But I have hoped in thy mercy; my heart shall exult in thy salvation.",{"s":"r"}],["6",[["Ἄσω",5275,157],["τῷ",1,110],["Κυρ