[["1",[["Ἀλληλούϊα",1749,105],["Αἰνεῖτε",402,307],["τὸ",1,32],["ὄνομα",57,33],["Κυρίου",7,21],["αἰνεῖτε",402,307],["δοῦλοι",136,51],["Κύριον",7,7]],"Alleluia. Praise ye the name of the Lord; praise the Lord, [ye his] servants,"],["2",[["Οἱ",1,128],["ἑστῶτες",78,263],["ἐν",4,1],["οἴκω",34,451],["Κυρίου",7,21],["ἐν",4,1],["αὐλαῖς",327,71],["οἴκου",34,21],["Θεοῦ",20,21],["ἡμῶν",6,41]],"who stand in the house of the Lord, in the courts of the house of our God."],["3",[["Αἰνεῖτε",402,307],["τὸν",1,6],["Κύριον",7,7],["ὅτι",19,8],["ἀγαθὸς",114,16],["Κύριος",7,5],["ψάλατε",913,69],["τῷ",1,52],["ὀνόματι",57,53],["αὐτοῦ",3,48],["ὅτι",19,8],["καλόν",266,28]],"Praise ye the Lord; for the Lord is good: sing praises to his name; for [it is] good."],["4",[["Ὅτι",19,8],["τὸν",1,6],["Ἰακὼβ",146,105],["ἐξελέξατο",420,26],["ἑαυτῷ",92,49],["ὁ",1,4],["Κύριος",7,5],["Ἰσραὴλ",27,105],["εἰς",8,1],["περιουσιασμὸν",5931,7],["ἑαυτῷ",92,49]],"For the Lord has chosen Jacob for himself, [and] Israel for his peculiar treasure."],["5",[["Ὅτι",19,8],["ἐγὼ",6,158],["ἔγνωκα",79,85],["ὅτι",19,8],["μέγας",66,16],["ὁ",1,4],["Κύριος",7,5],["καὶ",2,8],["ὁ",1,4],["Κύριος",7,5],["ἡμῶν",6,41],["παρὰ",73,1],["πάντας",11,58],["τοὺς",1,56],["θεούς",20,31]],"For I know that the Lord is great, and our Lord is above all gods;"],["6",[["Πάντα",11,65],["ὅσα",103,43],["ἠθέλησεν",612,3],["ὁ",1,4],["Κύριος",7,5],["ἐποίησεν",23,3],["ἐν",4,1],["τῷ",1,110],["οὐρανῷ",94,113],["καὶ",2,8],["ἐν",4,1],["τῇ",1,95],["γῇ",26,2],["ἐν",4,1],["ταῖς",1,70],["θαλάσσαις",137,71],["καὶ",2,8],["ἐν",4,1],["πάσαις",11,287],["ταῖς",1,70],["ἀβύσσοις",1083,71]],"all that the Lord willed, he did in heaven, and on the earth, in the sea, and in all deeps."],["7",[["Ἀνάγων",524,67],["νεφέλας",444,40],["ἐξ",21,1],["ἐσχάτου",410,88],["τῆς",1,18],["γῆς",26,19],["ἀστραπὰς",1855,40],["εἰς",8,1],["ὑετὸν",676,7],["ἐποίησεν",23,3],["ὁ",1,4],["ἐξάγων",295,67],["ἀνέμους",850,31],["ἐκ",21,1],["θησαυρῶν",579,77],["αὐτοῦ",3,48]],"Who brings up clouds from the