2],["αὐτῶν",3,41],["αἱ",1,185],["θυγατέρες",97,180],["αὐτῶν",3,41],["κεκαλλωπισμέναι",3842,424],["περικεκοσμημέναι",7946,424],["ὡς",36,8],["ὁμοίωμα",1176,20],["ναοῦ",483,21]],"whose children are as plants, strengthened in their youth: their daughters are beautiful, sumptuously adorned after the similitude of a temple."],["13",[["Τὰ",1,42],["ταμεῖα",1528,43],["αὐτῶν",3,41],["πλήρη",490,65],["ἐξερευγόμενα",5314,203],["ἐκ",21,1],["τούτου",16,126],["εἰς",8,1],["τοῦτο",16,122],["τὰ",1,42],["πρόβατα",194,43],["αὐτῶν",3,41],["πολυτόκα",8014,65],["πληθύνοντα",316,232],["ἐν",4,1],["ταῖς",1,70],["ἐξόδοις",762,71],["αὐτῶν",3,41]],"Their garners are full, and bursting with one kind of store after another; their sheep are prolific, multiplying in their streets."],["14",[["Οἱ",1,128],["βόες",814,7],["αὐτῶν",3,41],["παχεῖς",3108,130],["οὐκ",12,17],["ἔστι",10,87],["κατάπτωμα",7449,20],["φραγμοῦ",1979,21],["οὐδὲ",106,12],["διέξοδος",1508,13],["οὐδὲ",106,12],["κραυγὴ",828,13],["ἐν",4,1],["ταῖς",1,70],["ἐπαύλεσιν",1173,71],["αὐτῶν",3,41]],"Their oxen are fat: there is no falling down of a hedge, nor going out, nor cry in their folds."],["15",[["Ἐμακάρισαν",1681,141],["τὸν",1,6],["λαὸν",35,7],["ᾧ",24,202],["ταῦτά",16,335],["ἐστι",10,87],["μακάριος",806,16],["ὁ",1,4],["λαὸς",35,5],["οὗ",120,17],["Κύριος",7,5],["ὁ",1,4],["Θεὸς",20,5],["αὐτοῦ",3,48]],"Men bless the people to whom this lot belongs, [but] blessed is the people whose God is the Lord."]]