[["1",[["Τῷ",1,110],["Δαυὶδ",52,105],["πρὸς",15,1],["τὸν",1,6],["Γολιάδ",0,0],["Εὐλογήτος",767,16],["Κύριος",7,5],["ὁ",1,4],["Θεός",20,5],["μου",6,48],["ὁ",1,4],["διδάσκων",545,67],["τὰς",1,39],["χεῖράς",37,40],["μου",6,48],["εἰς",8,1],["παράταξιν",843,10],["τοὺς",1,56],["δακτύλους",1182,31],["μου",6,48],["εἰς",8,1],["πόλεμον",163,7]],"[A Psalm] of David concerning Goliad. Blessed [be] the Lord my God, who instructs my hands for battle, [and] my fingers for war."],["2",[["Ἔλεός",183,20],["μου",6,48],["καὶ",2,8],["καταφυγή",1678,13],["μου",6,48],["ἀντιλήπτωρ",2209,5],["μου",6,48],["καὶ",2,8],["ῥύστης",4149,5],["μου",6,48],["ὑπερασπιστής",1875,5],["μου",6,48],["καὶ",2,8],["ἐπʼ",9,1],["αὐτῷ",3,49],["ἤλπισα",514,147],["ὁ",1,4],["ὑποτάσσων",1497,67],["τὸν",1,6],["λαόν",35,7],["μου",6,48],["ὑπʼ",122,1],["ἐμέ",6,82]],"My mercy, and my refuge; my helper, and my deliverer; my protector, in whom I have trusted; who subdues my people under me."],["3",[["Κύριε",7,250],["τί",39,119],["ἐστιν",10,87],["ἄνθρωπος",43,5],["ὅτι",19,8],["ἐγνώσθης",79,360],["αὐτῷ",3,49],["ἢ",61,8],["υἱὸς",13,5],["ἀνθρώπου",43,21],["ὅτι",19,8],["λογίζῃ",495,166],["αὐτόν",3,82]],"Lord, what is man, that thou art made known to him? or the son of man, that thou takest account of him?"],["4",[["Ἄνθρωπος",43,5],["ματαιότητι",937,2],["ὡμοιώθη",1175,38],["αἱ",1,185],["ἡμέραι",28,2],["αὐτοῦ",3,48],["ὡσεὶ",343,17],["σκιὰ",978,13],["παράγουσι",2277,191]],"Man is like to vanity: his days pass as a shadow."],["5",[["Κύριε",7,250],["κλῖνον",785,568],["οὐρανούς",94,31],["σου",5,146],["καὶ",2,8],["κατάβηθι",175,198],["ἅψαι",465,100],["τῶν",1,44],["ὀρέων",87,45],["καὶ",2,8],["καπνισθήσονται",2580,135]],"O Lord, bow thy heavens, and come down: touch the mountains, and they shall smoke."],["6",[["Ἄστραψον",5242,198],["ἀστραπὴν",1855,10],["καὶ",2,8],["σκορπιεῖς",1785,159],["αὐτοὺς",3,60],["ἐξαπόστειλον",220,198],["τὰ",1,42],["βέλη",1156,43],["σου",5,146],["καὶ",2,8],["συνταράξεις",2042,159],["αὐτούς",3,60]],"Send lightning