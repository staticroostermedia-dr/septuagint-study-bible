,2],["αὐτῶν",3,41],["αἱ",1,183],["θυγατέρες",97,179],["αὐτῶν",3,41],["κεκαλλωπισμέναι",0,0],["περικεκοσμημέναι",0,0],["ὡς",36,8],["ὁμοίωμα",1176,20],["ναοῦ",481,21]],"whose children are as plants, strengthened in their youth: their daughters are beautiful, sumptuously adorned after the similitude of a temple."],["13",[["Τὰ",1,42],["ταμεῖα",1526,43],["αὐτῶν",3,41],["πλήρη",489,65],["ἐξερευγόμενα",5348,203],["ἐκ",21,1],["τούτου",16,126],["εἰς",8,1],["τοῦτο",16,122],["τὰ",1,42],["πρόβατα",194,43],["αὐτῶν",3,41],["πολυτόκα",8074,65],["πληθύνοντα",315,232],["ἐν",4,1],["ταῖς",1,70],["ἐξόδοις",758,71],["αὐτῶν",3,41]],"Their garners are full, and bursting with one kind of store after another; their sheep are prolific, multiplying in their streets."],["14",[["Οἱ",1,128],["βόες",812,7],["αὐτῶν",3,41],["παχεῖς",2949,130],["οὐκ",12,17],["ἔστι",10,87],["κατάπτωμα",7497,20],["φραγμοῦ",1983,21],["οὐδὲ",105,12],["διέξοδος",1508,13],["οὐδὲ",105,12],["κραυγὴ",830,13],["ἐν",4,1],["ταῖς",1,70],["ἐπαύλεσιν",1174,71],["αὐτῶν",3,41]],"Their oxen are fat: there is no falling down of a hedge, nor going out, nor cry in their folds."],["15",[["Ἐμακάρισαν",1683,141],["τὸν",1,6],["λαὸν",35,7],["ᾧ",24,202],["ταῦτά",16,339],["ἐστι",10,87],["μακάριος",803,16],["ὁ",1,4],["λαὸς",35,5],["οὗ",120,17],["Κύριος",7,5],["ὁ",1,4],["Θεὸς",20,5],["αὐτοῦ",3,48]],"Men bless the people to whom this lot belongs, [but] blessed is the people whose God is the Lord."]]