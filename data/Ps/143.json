[["1",[["Τῷ",1,110],["Δαυὶδ",52,105],["πρὸς",15,1],["τὸν",1,6],["Γολιάδ",0,0],["Εὐλογήτος",763,16],["Κύριος",7,5],["ὁ",1,4],["Θεός",20,5],["μου",6,48],["ὁ",1,4],["διδάσκων",543,67],["τὰς",1,39],["χεῖράς",37,40],["μου",6,48],["εἰς",8,1],["παράταξιν",844,10],["τοὺς",1,56],["δακτύλους",1182,31],["μου",6,48],["εἰς",8,1],["πόλεμον",163,7]],"[A Psalm] of David concerning Goliad. Blessed [be] the Lord my God, who instructs my hands for battle, [and] my fingers for war."],["2",[["Ἔλεός",182,20],["μου",6,48],["καὶ",2,8],["καταφυγή",1681,13],["μου",6,48],["ἀντιλήπτωρ",2221,5],["μου",6,48],["καὶ",2,8],["ῥύστης",4161,5],["μου",6,48],["ὑπερασπιστής",1876,5],["μου",6,48],["καὶ",2,8],["ἐπʼ",9,1],["αὐτῷ",3,49],["ἤλπισα",511,147],["ὁ",1,4],["ὑποτάσσων",1756,67],["τὸν",1,6],["λαόν",35,7],["μου",6,48],["ὑπʼ",122,1],["ἐμέ",6,82]],"My mercy, and my refuge; my helper, and my deliverer; my protector, in whom I have trusted; who subdues my people under me."],["3",[["Κύριε",7,251],["τί",39,119],["ἐστιν",10,87],["ἄνθρωπος",43,5],["ὅτι",19,8],["ἐγνώσθης",81,363],["αὐτῷ",3,49],["ἢ",60,8],["υἱὸς",13,5],["ἀνθρώπου",43,21],["ὅτι",19,8],["λογίζῃ",494,166],["αὐτόν",3,82]],"Lord, what is man, that thou art made known to him? or the son of man, that thou takest account of him?"],["4",[["Ἄνθρωπος",43,5],["ματαιότητι",937,2],["ὡμοιώθη",1197,38],["αἱ",1,183],["ἡμέραι",28,2],["αὐτοῦ",3,48],["ὡσεὶ",342,17],["σκιὰ",978,13],["παράγουσι",2290,189]],"Man is like to vanity: his days pass as a shadow."],["5",[["Κύριε",7,251],["κλῖνον",829,583],["οὐρανούς",94,31],["σου",5,146],["καὶ",2,8],["κατάβηθι",174,198],["ἅψαι",462,100],["τῶν",1,44],["ὀρέων",86,45],["καὶ",2,8],["καπνισθήσονται",2584,135]],"O Lord, bow thy heavens, and come down: touch the mountains, and they shall smoke."],["6",[["Ἄστραψον",5273,243],["ἀστραπὴν",1854,10],["καὶ",2,8],["σκορπιεῖς",1837,159],["αὐτοὺς",3,60],["ἐξαπόστειλον",217,198],["τὰ",1,42],["βέλη",1159,43],["σου",5,146],["καὶ",2,8],["συνταράξεις",2047,159],["αὐτούς",3,60]],"Send lightning