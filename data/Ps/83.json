[["1",[["Εἰς",8,1],["τὸ",1,32],["τέλος",369,33],["ὑπὲρ",139,1],["τῶν",1,76],["ληνῶν",1769,77],["τοῖς",1,138],["υἱοῖς",13,139],["Κορὲ",875,251],["ψαλμός",639,5]],"For the end, a Psalm for the sons of Core, concerning the wine-presses."],["2",[["Ὡς",36,8],["ἀγαπητὰ",1922,65],["τὰ",1,42],["σκηνώματά",680,43],["σου",5,146],["Κύριε",7,251],["τῶν",1,123],["δυνάμεων",98,61]],"How amiable are thy tabernacles, O Lord of hosts!"],["3",[["Ἐπιποθεῖ",2541,87],["καὶ",2,8],["ἐκλείπει",321,87],["ἡ",1,11],["ψυχή",62,13],["μου",6,48],["εἰς",8,1],["τὰς",1,39],["αὐλὰς",324,40],["τοῦ",1,30],["Κυρίου",7,21],["ἡ",1,11],["καρδία",63,13],["μου",6,48],["καὶ",2,8],["ἡ",1,11],["σάρξ",287,13],["μου",6,48],["ἠγαλλιάσαντο",737,182],["ἐπὶ",9,1],["Θεὸν",20,7],["ζῶντα",117,177]],"My soul longs, and faints for the courts of the Lord: my heart and my flesh have exulted in the living God."],["4",[["Καὶ",2,8],["γὰρ",40,12],["στρουθίον",2498,20],["εὗρεν",106,3],["ἑαυτῷ",92,49],["οἰκίαν",232,10],["καὶ",2,8],["τρυγὼν",2211,13],["νοσσιὰν",2609,10],["ἑαυτῇ",92,99],["οὗ",120,17],["θήσει",109,120],["τὰ",1,42],["νοσσία",7824,43],["ἑαυτῆς",92,83],["τὰ",1,42],["θυσιαστήριά",133,43],["σου",5,146],["Κύριε",7,251],["τῶν",1,123],["δυνάμεων",98,61],["ὁ",1,4],["βασιλεύς",22,5],["μου",6,48],["καὶ",2,8],["ὁ",1,4],["Θεός",20,5],["μου",6,48]],"Yea, the sparrow has found himself a home, and the turtle-dove a nest for herself, where she may lay her young, [even] thine altars, O Lord of hosts, my King, and my God."],["5",[["Μακάριοι",803,130],["οἱ",1,128],["κατοικοῦντες",90,137],["ἐν",4,1],["τῷ",1,110],["οἴκῳ",34,113],["σου",5,146],["εἰς",8,1],["τοὺς",1,56],["αἰῶνας",100,31],["τῶν",1,76],["αἰώνων",100,77],["αἰνέσουσί",399,207],["σε",5,161],["διάψαλμα",687,20]],"Blessed are they that dwell in thy house: they will praise thee evermore. Pause."],["6",[["Μακάριος",803,16],["ἀνὴρ",38,5],["οὗ",120,17],["ἐστιν",10,87],["ἡ",1,11],["ἀντίληψις",2413,13],["αὐτοῦ",3,48],["παρὰ",72,1],["σοῦ",5,146],["Κύριε",7,251],["ἀναβάσεις",87,170],["ἐν",4,1],["τῇ",1,95],["καρδίᾳ",63,2],["αὐτοῦ",3,48],["διέθετο",617,26]],"Blessed is the man whose help is of thee, O Lord; in his heart he has purposed to go up"],["7",[["εἰς",8,1],["τὴν",1,9],["κοιλάδα",1058,10],["τοῦ",1,30],["κλαυθμῶνος",3872,21],["εἰς",8,1],["τὸν",1,6],["τόπον",99,7],["ὃν",24,106],["ἔθετο",109,26],["καὶ",2,8],["γὰρ",40,12],["εὐλογίας",576,19],["δώσει",33,120],["ὁ",1,4],["νομοθετῶν",2755,67]],"the valley of weeping, to the place which he has appointed, for [there] the law-giver will grant blessings."],["8",[["πορεύσονται",49,127],["ἐκ",21,1],["δυνάμεως",98,19],["εἰς",8,1],["δύναμιν",98,10],["ὀφθήσεται",111,125],["ὁ",1,4],["Θεὸς",20,5],["τῶν",1,76],["θεῶν",20,77],["ἐν",4,1],["Σιών",331,2]],"They shall go from strength to strength: the God of gods shall be seen in Sion."],["9",[["Κύριε",7,251],["ὁ",1,4],["Θεὸς",20,5],["τῶν",1,123],["δυνάμεων",98,61],["εἰσάκουσον",237,198],["τῆς",1,18],["προσευχῆς",549,19],["μου",6,83],["ἐνώτισαι",1316,296],["ὁ",1,4],["Θεὸς",20,5],["Ἰακώβ",146,105],["διάψαλμα",687,20]],"O Lord God of hosts, hear my prayer: hearken, O God of Jacob. Pause."],["10",[["Ὑπερασπιστὰ",1876,463],["ἡμῶν",6,41],["ἴδε",693,17],["ὁ",1,4],["Θεὸς",20,5],["καὶ",2,8],["ἐπίβλεψον",516,198],["ἐπὶ",9,1],["τὸ",1,32],["πρόσωπον",47,33],["τοῦ",1,30],["χριστοῦ",1073,21],["σοῦ",5,146]],"Behold, O God our defender, and look upon the face of thine anointed."],["11",[["Ὅτι",19,8],["κρείσσων",922,15],["ἡμέρα",28,13],["μία",57,15],["ἐν",4,1],["ταῖς",1,70],["αὐλαῖς",324,71],["σου",5,146],["ὑπὲρ",139,1],["χιλιάδας",178,40],["ἐξελεξάμην",418,152],["παραῤῥιπτεῖσθαι",4980,104],["ἐν",4,1],["τῷ",1,110],["οἴκῳ",34,113],["τοῦ",1,30],["Θεοῦ",20,21],["μᾶλλον",1040,17],["ἢ",60,8],["οἰκεῖν",526,54],["με",6,82],["ἐπὶ",9,1],["σκηνώμασιν",680,92],["ἁμαρτωλῶν",406,163]],"For one day in thy courts is better than thousands. I would rather be an abject in the house of God, than dwell in the tents of sinners."],["12",[["Ὅτι",19,8],["ἔλεον",182,7],["καὶ",2,8],["ἀλήθειαν",350,10],["ἀγαπᾷ",224,172],["Κύριος",7,5],["ὁ",1,4],["Θεὸς",20,5],["χάριν",366,10],["καὶ",2,8],["δόξαν",141,10],["δώσει",33,120],["Κύριος",7,5],["οὐχ",12,17],["ὑστερήσει",1948,120],["τὰ",1,42],["ἀγαθὰ",113,65],["τοῖς",1,138],["πορευομένοις",49,346],["ἐν",4,1],["ἀκακίᾳ",2653,179]],"For the Lord loves mercy and truth: God will give grace and glory: the Lord will not withhold good things from them that walk in innocence."],["13",[["Κύριε",7,251],["τῶν",1,123],["δυνάμεων",98,61],["μακάριος",803,16],["ἄνθρωπος",43,5],["ὁ",1,4],["ἐλπίζων",511,67],["ἐπὶ",9,1],["σέ",5,161]],"O Lord of hosts, blessed is the man that trusts in thee."]]