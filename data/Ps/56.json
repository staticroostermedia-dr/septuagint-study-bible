[["1",[["Εἰς",8,1],["τὸ",1,32],["τέλος",369,33],["μὴ",25,8],["διαφθείρῃς",686,170],["τῷ",1,110],["Δαυὶδ",52,105],["εἰς",8,1],["στηλογραφίαν",3647,10],["ἐν",4,1],["τῷ",1,110],["αὐτὸν",3,82],["ἀποδιδράσκειν",1428,54],["ἀπὸ",17,1],["προσώπου",47,24],["Σαοὺλ",155,251],["εἰς",8,1],["τὸ",1,32],["σπήλαιον",940,33]],"For the end. Destroy not: by David, for a memorial, when he fled from the presence of Saul to the cave."],["2",[["Ἐλέησον",457,243],["με",6,82],["ὁ",1,4],["Θεὸς",20,5],["ἐλέησόν",457,243],["με",6,82],["ὅτι",19,8],["ἐπὶ",9,1],["σοὶ",5,151],["πέποιθεν",343,165],["ἡ",1,11],["ψυχή",62,13],["μου",6,48],["καὶ",2,8],["ἐν",4,1],["τῇ",1,95],["σκιᾷ",978,2],["τῶν",1,123],["πτερύγων",720,61],["σου",5,146],["ἐλπιῶ",511,157],["ἕως",42,8],["οὗ",120,17],["παρέλθῃ",410,160],["ἡ",1,11],["ἀνομία",274,13]],"Have mercy, upon me, O God, have mercy upon me: for my soul has trusted in thee: and in the shadow of thy wings will I hope, until the iniquity have passed away."],["3",[["Κεκράξομαι",590,176],["πρὸς",15,1],["τὸν",1,6],["Θεὸν",20,7],["τὸν",1,6],["ὕψιστον",473,59],["τὸν",1,6],["Θεὸν",20,7],["τὸν",1,6],["εὐεργετήσαντά",2904,485],["με",6,82],["διάψαλμα",687,20]],"I will cry to God most high; the God who has benefited me. Pause."],["4",[["Ἐξαπέστειλεν",217,3],["ἐξ",21,1],["οὐρανοῦ",94,21],["καὶ",2,8],["ἔσωσέ",171,3],["με",6,82],["ἔδωκεν",33,3],["εἰς",8,1],["ὄνειδος",973,20],["τοὺς",1,56],["καταπατοῦντάς",1205,229],["με",6,82],["ἐξαπέστειλεν",217,3],["ὁ",1,4],["Θεὸς",20,5],["τὸ",1,32],["ἔλεος",182,33],["αὐτοῦ",3,48],["καὶ",2,8],["τὴν",1,9],["ἀλήθειαν",350,10],["αὐτοῦ",3,48]],"He sent from heaven and saved me; he gave to reproach them that trampled on me: God has sent forth his mercy and his truth;"],["5",[["καὶ",2,8],["ἐῤῥύσατο",335,26],["τὴν",1,9],["ψυχήν",62,10],["μου",6,48],["ἐκ",21,1],["μέσου",112,153],["σκύμνων",1481,77],["ἐκοιμήθην",302,94],["τεταραγμένος",0,0],["υἱοὶ",13,51],["ἀνθρώπων",43,77],["οἱ",1,128],["ὀδόντες",929,51],["αὐτῶν",3,41],["ὅπλον",760,20],["καὶ",2,8],["βέλη",1159,43],["καὶ",2,8],["ἡ",1,11],["γλῶσσα",385,13],["αὐτῶν",3,41],["μάχαιρα",341,13],["ὀξεῖα",1664,15]],"and he has delivered my soul from the midst of [lions'] whelps: I lay down to sleep, [though] troubled. [As for] the sons of men, their teeth are arms and [missile] weapons, and their tongue a sharp sword."],["6",[["Ὑψώθητι",327,242],["ἐπὶ",9,1],["τοὺς",1,56],["οὐρανοὺς",94,31],["ὁ",1,4],["Θεὸς",20,5],["καὶ",2,8],["ἐπὶ",9,1],["πᾶσαν",11,37],["τὴν",1,9],["γῆν",26,10],["ἡ",1,11],["δόξα",141,186],["σου",5,146]],"Be thou exalted, O God, above the heavens; and thy glory above all the earth."],["7",[["Παγίδας",815,40],["ἡτοίμασαν",371,141],["τοῖς",1,138],["ποσί",208,139],["μου",6,48],["καὶ",2,8],["κατέκαμψαν",4268,141],["τὴν",1,9],["ψυχήν",62,10],["μου",6,48],["ὤρυξαν",1372,141],["πρὸ",235,1],["προσώπου",47,24],["μου",6,48],["βόθρον",1718,7],["καὶ",2,8],["ἐνέπεσαν",6485,141],["εἰς",8,1],["αὐτόν",3,82],["διάψαλμα",687,20]],"They have prepared snares for my feet, and have bowed down my soul: they have dug a pit before my face, and fallen into it [themselves]. Pause."],["8",[["Ἑτοίμη",906,15],["ἡ",1,11],["καρδία",63,13],["μου",6,48],["ὁ",1,4],["Θεὸς",20,5],["ἑτοίμη",906,15],["ἡ",1,11],["καρδία",63,13],["μου",6,48],["ᾄσομαι",1080,176],["καὶ",2,8],["ψαλῶ",901,157]],"My heart, O God, [is] ready, my heart [is] ready: I will sing, yea will sing psalms."],["9",[["Ἐξεγέρθητι",650,242],["ἡ",1,11],["δόξα",141,186],["μου",6,48],["ἐξεγέρθητι",650,242],["ψαλτήριον",1698,20],["καὶ",2,8],["κιθάρα",1513,13],["ἐξεγερθήσομαι",650,175],["ὄρθρου",1436,21]],"Awake, my glory; awake, psaltery and harp: I will awake early."],["10",[["Ἐξομολογήσομαί",478,176],["σοι",5,151],["ἐν",4,1],["λαοῖς",35,139],["Κύριε",7,251],["ψαλῶ",901,157],["σοι",5,151],["ἐν",4,1],["ἔθνεσιν",59,92]],"O Lord, I will give thanks to thee among the nations: I will sing to thee among the Gentiles."],["11",[["Ὅτι",19,8],["ἐμεγαλύνθη",606,38],["ἕως",42,8],["τῶν",1,76],["οὐρανῶν",94,77],["τὸ",1,32],["ἔλεός",182,33],["σου",5,14