[["1",[["Εἰς",8,1],["τὸ",1,32],["τέλος",373,33],["μὴ",25,8],["διαφθείρῃς",688,170],["τῷ",1,110],["Δαυὶδ",52,105],["εἰς",8,1],["στηλογραφίαν",3640,10],["ἐν",4,1],["τῷ",1,110],["αὐτὸν",3,82],["ἀποδιδράσκειν",1427,54],["ἀπὸ",17,1],["προσώπου",47,24],["Σαοὺλ",155,250],["εἰς",8,1],["τὸ",1,32],["σπήλαιον",939,33]],"For the end. Destroy not: by David, for a memorial, when he fled from the presence of Saul to the cave."],["2",[["Ἐλέησον",446,198],["με",6,82],["ὁ",1,4],["Θεὸς",20,5],["ἐλέησόν",446,198],["με",6,82],["ὅτι",19,8],["ἐπὶ",9,1],["σοὶ",5,151],["πέποιθεν",344,165],["ἡ",1,11],["ψυχή",63,13],["μου",6,48],["καὶ",2,8],["ἐν",4,1],["τῇ",1,95],["σκιᾷ",978,2],["τῶν",1,123],["πτερύγων",719,61],["σου",5,146],["ἐλπιῶ",514,157],["ἕως",42,8],["οὗ",120,17],["παρέλθῃ",404,160],["ἡ",1,11],["ἀνομία",275,13]],"Have mercy, upon me, O God, have mercy upon me: for my soul has trusted in thee: and in the shadow of thy wings will I hope, until the iniquity have passed away."],["3",[["Κεκράξομαι",592,177],["πρὸς",15,1],["τὸν",1,6],["Θεὸν",20,7],["τὸν",1,6],["ὕψιστον",474,59],["τὸν",1,6],["Θεὸν",20,7],["τὸν",1,6],["εὐεργετήσαντά",2890,476],["με",6,82],["διάψαλμα",689,20]],"I will cry to God most high; the God who has benefited me. Pause."],["4",[["Ἐξαπέστειλεν",220,3],["ἐξ",21,1],["οὐρανοῦ",94,21],["καὶ",2,8],["ἔσωσέ",172,3],["με",6,82],["ἔδωκεν",33,3],["εἰς",8,1],["ὄνειδος",973,20],["τοὺς",1,56],["καταπατοῦντάς",1117,229],["με",6,82],["ἐξαπέστειλεν",220,3],["ὁ",1,4],["Θεὸς",20,5],["τὸ",1,32],["ἔλεος",183,33],["αὐτοῦ",3,48],["καὶ",2,8],["τὴν",1,9],["ἀλήθειαν",352,10],["αὐτοῦ",3,48]],"He sent from heaven and saved me; he gave to reproach them that trampled on me: God has sent forth his mercy and his truth;"],["5",[["καὶ",2,8],["ἐῤῥύσατο",337,26],["τὴν",1,9],["ψυχήν",63,10],["μου",6,48],["ἐκ",21,1],["μέσου",113,153],["σκύμνων",1478,77],["ἐκοιμήθην",301,94],["τεταραγμένος",508,408],["υἱοὶ",13,51],["ἀνθρώπων",43,77],["οἱ",1,128],["ὀδόντες",930,51],["αὐτῶν",3,41],["ὅπλον",764,20],["καὶ",2,8],["βέλη",1156,43],["καὶ",2,8],["ἡ",1,11],["γλῶσσα",388,13],["αὐτῶν",3,41],["μάχαιρα",342,13],["ὀξεῖα",1663,15]],"and he has delivered my soul from the midst of [lions'] whelps: I lay down to sleep, [though] troubled. [As for] the sons of men, their teeth are arms and [missile] weapons, and their tongue a sharp sword."],["6",[["Ὑψώθητι",331,242],["ἐπὶ",9,1],["τοὺς",1,56],["οὐρανοὺς",94,31],["ὁ",1,4],["Θεὸς",20,5],["καὶ",2,8],["ἐπὶ",9,1],["πᾶσαν",11,37],["τὴν",1,9],["γῆν",26,10],["ἡ",1,11],["δόξα",141,188],["σου",5,146]],"Be thou exalted, O God, above the heavens; and thy glory above all the earth."],["7",[["Παγίδας",817,40],["ἡτοίμασαν",371,141],["τοῖς",1,138],["ποσί",210,139],["μου",6,48],["καὶ",2,8],["κατέκαμψαν",4256,141],["τὴν",1,9],["ψυχήν",63,10],["μου",6,48],["ὤρυξαν",1373,141],["πρὸ",238,1],["προσώπου",47,24],["μου",6,48],["βόθρον",1718,7],["καὶ",2,8],["ἐνέπεσαν",6452,141],["εἰς",8,1],["αὐτόν",3,82],["διάψαλμα",689,20]],"They have prepared snares for my feet, and have bowed down my soul: they have dug a pit before my face, and fallen into it [themselves]. Pause."],["8",[["Ἑτοίμη",904,15],["ἡ",1,11],["καρδία",64,13],["μου",6,48],["ὁ",1,4],["Θεὸς",20,5],["ἑτοίμη",904,15],["ἡ",1,11],["καρδία",64,13],["μου",6,48],["ᾄσομαι",856,177],["καὶ",2,8],["ψαλῶ",913,157]],"My heart, O God, [is] ready, my heart [is] ready: I will sing, yea will sing psalms."],["9",[["Ἐξεγέρθητι",656,242],["ἡ",1,11],["δόξα",141,188],["μου",6,48],["ἐξεγέρθητι",656,242],["ψαλτήριον",1693,20],["καὶ",2,8],["κιθάρα",1513,13],["ἐξεγερθήσομαι",656,176],["ὄρθρου",1434,21]],"Awake, my glory; awake, psaltery and harp: I will awake early."],["10",[["Ἐξομολογήσομαί",479,177],["σοι",5,151],["ἐν",4,1],["λαοῖς",35,139],["Κύριε",7,250],["ψαλῶ",913,157],["σοι",5,151],["ἐν",4,1],["ἔθνεσιν",60,92]],"O Lord, I will give thanks to thee among the nations: I will sing to thee among the Gentiles."],["11",[["Ὅτι",19,8],["ἐμεγαλύνθη",604,38],["ἕως",42,8],["τῶν",1,76],["οὐρανῶν",94,77],["τὸ",1,32],["ἔλεός",183,33],["σου",5,146],["καὶ",2,8],["ἕως",42,8],["τῶν",1,123],["νεφελῶν",444,61],["ἡ",1,11],["ἀλήθειά",352,13],["σου",5,146]],"For thy mercy has been magnified even to the heavens, and thy truth to the clouds."],["12",[["Ὑψώθητι",331,242],["ἐπὶ",9,1],["τοὺς",1,56],["οὐρανοὺς",94,31],["ὁ",1,4],["Θεὸς",20,5],["καὶ",2,8],["ἐπὶ",9,1],["πᾶσαν",11,37],["τὴν",1,9],["γῆν",26,10],["ἡ",1,11],["δόξα",141,188],["σου",5,146]],"Be thou exalted, O God, above the heavens; and thy glory above all the earth."]]