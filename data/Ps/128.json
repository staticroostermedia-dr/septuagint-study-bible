[["1",[["Ὠδὴ",773,105],["τῶν",1,76],["ἀναβαθμῶν",1486,77],["Πλεονάκις",2957,17],["ἐπολέμησάν",304,141],["με",6,82],["ἐκ",21,1],["νεότητός",785,19],["μου",6,83],["εἰπάτω",18,46],["δὴ",193,12],["Ἰσραήλ",27,105]],"A Song of Degrees. Many a time have they warred against me from my youth, let Israel now say:"],["2",[["Πλεονάκις",2957,17],["ἐπολέμησάν",304,141],["με",6,82],["ἐκ",21,1],["νεότητός",785,19],["μου",6,83],["καὶ",2,8],["γὰρ",40,12],["οὐκ",12,17],["ἠδυνήθησάν",184,94],["μοι",6,49]],"Many a time have they warred against me from my youth: and yet they prevailed not against me."],["3",[["Ἐπὶ",9,1],["τὸν",1,6],["νῶτόν",1347,7],["μου",6,48],["ἐτέκταινον",2507,129],["οἱ",1,128],["ἁμαρτωλοὶ",406,130],["ἐμάκρυναν",0,0],["τὴν",1,9],["ἀνομίαν",274,10],["αὐτῶν",3,41]],"The sinners wrought upon my back: they prolonged their iniquity."],["4",[["Κύριος",7,5],["δίκαιος",152,16],["συνέκοψεν",2390,3],["αὐχένας",3501,31],["ἁμαρτωλῶν",406,163]],"The righteous Lord has cut asunder the necks of sinners."],["5",[["Αἰσχυνθήτωσαν",614,50],["καὶ",2,8],["ἀποστραφήτωσαν",0,0],["εἰς",8,1],["τὰ",1,42],["ὀπίσω",166,17],["πάντες",11,130],["οἱ",1,128],["μισοῦντες",355,137],["Σιών",331,2]],"Let all that hate Sion be put to shame and turned back."],["6",[["Γενηθήτωσαν",30,50],["ὡσεὶ",342,17],["χόρτος",1044,5],["δωμάτων",1467,45],["ὃς",24,247],["πρὸ",235,1],["τοῦ",1,30],["ἐκσπασθῆναι",2060,174],["ἐξηράνθη",843,38]],"Let them be as the grass of the house-tops, which withers before it is plucked up."],["7",[["Οὗ",120,17],["οὐκ",12,17],["ἐπλήρωσεν",529,3],["τὴν",1,9],["χεῖρα",37,10],["αὐτοῦ",3,48],["ὁ",1,4],["θερίζων",1546,67],["καὶ",2,8],["τὸν",1,6],["κόλπον",1140,7],["αὐτοῦ",3,48],["ὁ",1,4],["τὰ",1,42],["δράγματα",1956,43],["συλλέγων",1148,67]],"Wherewith the reaper fills not his hand, nor he that makes up the sheaves, his bosom."],["8",[["Καὶ",2,8],["οὐκ",12,17],["εἶπαν",18,221],["οἱ",1,128],["παράγοντες",2290,137],["εὐλογία",576,13],["Κυρίου",7,21],["ἐφʼ",9,1],["ὑμᾶς",5,209],["εὐλογήκαμεν",147,315],["ὑμᾶς",5,209],["ἐν",4,1],["ὀνόματι",55,53],["Κυρίου",7,21]],"Neither do they that go by say, The blessing of the Lord be upon you: we have blessed you in the name of the Lord."]]