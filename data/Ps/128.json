[["1",[["Ὠδὴ",776,105],["τῶν",1,76],["ἀναβαθμῶν",1484,77],["Πλεονάκις",2944,17],["ἐπολέμησάν",305,141],["με",6,82],["ἐκ",21,1],["νεότητός",787,19],["μου",6,83],["εἰπάτω",18,46],["δὴ",193,12],["Ἰσραήλ",27,105]],"A Song of Degrees. Many a time have they warred against me from my youth, let Israel now say:"],["2",[["Πλεονάκις",2944,17],["ἐπολέμησάν",305,141],["με",6,82],["ἐκ",21,1],["νεότητός",787,19],["μου",6,83],["καὶ",2,8],["γὰρ",40,12],["οὐκ",12,17],["ἠδυνήθησάν",185,94],["μοι",6,49]],"Many a time have they warred against me from my youth: and yet they prevailed not against me."],["3",[["Ἐπὶ",9,1],["τὸν",1,6],["νῶτόν",1351,7],["μου",6,48],["ἐτέκταινον",2503,129],["οἱ",1,128],["ἁμαρτωλοὶ",409,130],["ἐμάκρυναν",0,0],["τὴν",1,9],["ἀνομίαν",275,10],["αὐτῶν",3,41]],"The sinners wrought upon my back: they prolonged their iniquity."],["4",[["Κύριος",7,5],["δίκαιος",153,16],["συνέκοψεν",2382,3],["αὐχένας",3498,31],["ἁμαρτωλῶν",409,163]],"The righteous Lord has cut asunder the necks of sinners."],["5",[["Αἰσχυνθήτωσαν",611,50],["καὶ",2,8],["ἀποστραφήτωσαν",130,50],["εἰς",8,1],["τὰ",1,42],["ὀπίσω",167,17],["πάντες",11,130],["οἱ",1,128],["μισοῦντες",351,137],["Σιών",334,2]],"Let all that hate Sion be put to shame and turned back."],["6",[["Γενηθήτωσαν",30,50],["ὡσεὶ",343,17],["χόρτος",1046,5],["δωμάτων",1467,45],["ὃς",24,246],["πρὸ",238,1],["τοῦ",1,30],["ἐκσπασθῆναι",2054,175],["ἐξηράνθη",842,38]],"Let them be as the grass of the house-tops, which withers before it is plucked up."],["7",[["Οὗ",120,17],["οὐκ",12,17],["ἐπλήρωσεν",518,3],["τὴν",1,9],["χεῖρα",37,10],["αὐτοῦ",3,48],["ὁ",1,4],["θερίζων",1509,67],["καὶ",2,8],["τὸν",1,6],["κόλπον",1140,7],["αὐτοῦ",3,48],["ὁ",1,4],["τὰ",1,42],["δράγματα",1956,43],["συλλέγων",1148,67]],"Wherewith the reaper fills not his hand, nor he that makes up the sheaves, his bosom."],["8",[["Καὶ",2,8],["οὐκ",12,17],["εἶπαν",18,141],["οἱ",1,128],["παράγοντες",2277,137],["εὐλογία",578,13],["Κυρίου",7,21],["ἐφʼ",9,1],["ὑμᾶς",5,209],["εὐλογήκαμεν",0,