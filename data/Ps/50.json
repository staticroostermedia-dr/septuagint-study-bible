[["1",[["Εἰς",8,1],["τὸ",1,32],["τέλος",373,33],["ψαλμὸς",644,5],["τῷ",1,110],["Δαυὶδ",52,105]],"For the end, a Psalm of David,"],["2",[["ἐν",4,1],["τῷ",1,110],["ἐλθεῖν",55,100],["πρὸς",15,1],["αὐτὸν",3,82],["Νάθαν",988,105],["τὸν",1,6],["προφήτην",176,7],["ἡνίκα",543,17],["εἰσῆλθε",86,3],["πρὸς",15,1],["Βηρσαβεέ",0,0]],"when Nathan the prophet came to him, when he had gone in to Bersabee."],["3",[["Ἐλέησον",446,198],["με",6,82],["ὁ",1,4],["Θεὸς",20,5],["κατὰ",32,1],["τὸ",1,32],["μέγα",66,29],["ἔλεός",183,33],["σου",5,146],["καὶ",2,8],["κατὰ",32,1],["τὸ",1,32],["πλῆθος",200,33],["τῶν",1,76],["οἰκτιρμῶν",1187,77],["σου",5,146],["ἐξάλειψον",1085,198],["τὸ",1,32],["ἀνόμημά",2212,33],["μου",6,48]],"Have mercy upon me, O God, according to thy great mercy; and according to the multitude of thy compassions blot out my transgression."],["4",[["Ἐπιπλεῖον",4608,36],["πλῦνόν",967,36],["με",6,82],["ἀπὸ",17,1],["τῆς",1,18],["ἀνομίας",275,19],["μου",6,83],["καὶ",2,8],["ἀπὸ",17,1],["τῆς",1,18],["ἁμαρτίας",119,19],["μου",6,83],["καθάρισόν",482,198],["με",6,82]],"Wash me thoroughly from mine iniquity, and cleanse me from my sin."],["5",[["Ὅτι",19,8],["τὴν",1,9],["ἀνομίαν",275,10],["μου",6,48],["ἐγὼ",6,158],["γινώσκω",79,149],["καὶ",2,8],["ἡ",1,11],["ἁμαρτία",119,13],["μου",6,48],["ἐνώπιόν",115,1],["μου",6,48],["ἐστὶ",10,87],["διαπαντός",510,17]],"For I am conscious of mine iniquity; and my sin is continually before me."],["6",[["Σοὶ",5,151],["μόνῳ",302,111],["ἥμαρτον",237,147],["καὶ",2,8],["τὸ",1,32],["πονηρὸν",164,29],["ἐνώπιόν",115,1],["σου",5,146],["ἐποίησα",23,147],["ὅπως",240,8],["ἂν",83,12],["δικαιωθῇς",1115,278],["ἐν",4,1],["τοῖς",1,138],["λόγοις",48,139],["σου",5,146],["καὶ",2,8],["νικήσῃς",1441,170],["ἐν",4,1],["τῷ",1,110],["κρίνεσθαί",263,104],["σε",5,161]],"Against thee only have I sinned, and done evil before thee: that thou mightest be justified in thy sayings, and mightest overcome when thou art judged."],["7",[["Ἰδοὺ",51,17],["γὰρ",40,12],["ἐν",4,1],["ἀνομίαις",275,71],["συνελήφθην",507,148],["καὶ",2,8],["ἐν",4,1],["ἁμαρτίαις",119,71],["ἐκίσσησέ",5731,3],["με",6,82],["ἡ",1,11],["μήτηρ",189,13],["μου",6,48]],"For, behold, I was conceived in iniquities, and in sins did my mother conceive me."],["8",[["Ἰδοὺ",51,17],["γὰρ",40,12],["ἀλήθειαν",352,10],["ἠγάπησας",214,154],["τὰ",1,42],["ἄδηλα",4552,65],["καὶ",2,8],["τὰ",1,42],["κρύφια",2733,65],["τῆς",1,18],["σοφίας",242,19],["σου",5,146],["ἐδήλωσάς",1670,154],["μοι",6,49]],"For, behold, thou lovest truth: thou hast manifested to me the secret and hidden things of thy wisdom."],["9",[["Ῥαντιεῖς",5429,159],["με",6,82],["ὑσσώπῳ",2856,2],["καὶ",2,8],["καθαρισθήσομαι",482,176],["πλυνεῖς",967,159],["με",6,82],["καὶ",2,8],["ὑπὲρ",139,1],["χιόνα",1646,10],["λευκανθήσομαι",0,0]],"Thou shalt sprinkle me with hyssop, and I shall be purified: thou shalt wash me, and I shall be made whiter than snow."],["10",[["Ἀκουτιεῖς",3157,159],["με",6,98],["ἀγαλλίασιν",1981,10],["καὶ",2,8],["εὐφροσύνην",360,10],["ἀγαλλιάσονται",738,127],["ὀστᾶ",473,63],["τεταπεινωμένα",322,441]],"Thou shalt cause me to hear gladness and joy: the afflicted bones shall rejoice."],["11",[["Ἀπόστρεψον",130,198],["τὸ",1,32],["πρόσωπόν",47,33],["σου",5,146],["ἀπὸ",17,1],["τῶν",1,123],["ἁμαρτιῶν",119,61],["μου",6,48],["καὶ",2,8],["πάσας",11,109],["τὰς",1,39],["ἀνομίας",275,40],["μου",6,48],["ἐξάλειψον",1085,198]],"Turn away thy face from my sins, and blot out all mine iniquities."],["12",[["Καρδίαν",64,10],["καθαρὰν",379,37],["κτίσον",786,171],["ἐν",4,1],["ἐμοὶ",6,49],["ὁ",1,4],["Θεὸς",20,5],["καὶ",2,8],["πνεῦμα",168,20],["εὐθὲς",825,28],["ἐγκαίνισον",2314,198],["ἐν",4,1],["τοῖς",1,91],["ἐγκάτοις",3753,92],["μου",6,48]],"Create in me a clean heart, O God; and renew a right spirit in my inward parts."],["13",[["Μὴ",25,8],["ἀποῤῥίψῃς",1150,170],["με",6,82],["ἀπὸ",17,1],["τοῦ",1,23],["προσώπου",47,24],["σου",5,146],["καὶ",2,8],["τὸ",1,32],["πνεῦμα",168,33],["τὸ",1,32],["ἅγιόν",75,29],["σου",5,146],["μὴ",25,8],["ἀντανέλῃς",2982,170],["ἀπʼ",17,1],["ἐμοῦ",6,48]],"Cast me not away from thy presence; and remove not thy Holy Spirit from me."],["14",[["Ἀπόδος",312,198],["μοι",6,49],["τὴν",1,9],["ἀγαλλίασιν",1981,10],["τοῦ",1,23],["σωτηρίου",472,24],["σου",5,146],["πνεύματι",168,53],["ἡγεμονικῷ",6573,34],["στήριξόν",979,198],["με",6,82]],"Restore to me the joy of thy salvation: establish me with thy directing Spirit."],["15",[["Διδάξω",545,157],["ἀνόμους",536,109],["τὰς",1,39],["ὁδούς",68,40],["σου",5,146],["καὶ",2,8],["ἀσεβεῖς",247,130],["ἐπὶ",9,1],["σὲ",5,161],["ἐπιστρέψουσι",117,207]],"[Then] will I teach transgressors thy ways; and ungodly men shall turn to thee."],["16",[["Ῥῦσαί",337,275],["με",6,82],["ἐξ",21,1],["αἱμάτων",148,45],["ὁ",1,4],["Θεὸς",20,5],["ὁ",1,4],["Θεὸς",20,5],["τῆς",1,18],["σωτηρίας",425,19],["μου",6,83],["ἀγαλλιάσεται",738,89],["ἡ",1,11],["γλῶσσά",388,13],["μου",6,48],["τὴν",1,9],["δικαιοσύνην",187,10],["σου",5,146]],"Deliver me from blood-guiltiness, O God, the God of my salvation: [and] my tongue shall joyfully declare thy righteousness."],["17",[["Κύριε",7,250],["τὰ",1,42],["χείλη",361,43],["μου",6,48],["ἀνοίξεις",362,159],["καὶ",2,8],["τὸ",1,32],["στόμα",123,33],["μου",6,48],["ἀναγγελεῖ",231,120],["τὴν",1,9],["αἴνεσίν",989,10],["σου",5,146]],"O Lord, thou shalt open my lips; and my mouth shall declare thy praise."],["18",[["Ὅτι",19,8],["εἰ",77,8],["ἠθέλησας",836,154],["θυσίαν",156,10],["ἔδωκα",33,147],["ἄν",83,12],["ὁλοκαυτώματα",318,43],["οὐκ",12,17],["εὐδοκήσεις",906,159]],"For if thou desiredst sacrifice, I would have given [it]: thou wilt not take pleasure in whole-burnt-offerings."],["19",[["Θυσία",156,13],["τῷ",1,110],["Θεῷ",20,113],["πνεῦμα",168,20],["συντετριμμένον",268,326],["καρδίαν",64,10],["συντετριμμένην",268,440],["καὶ",2,8],["τεταπεινωμένην",322,440],["ὁ",1,4],["Θεὸς",20,5],["οὐκ",12,17],["ἐξουδενώσει",1068,120]],"Sacrifice to God is a broken spirit: a broken and humbled heart God will not despise."],["20",[["Ἀγάθυνον",1694,198],["Κύριε",7,250],["ἐν",4,1],["τῇ",1,95],["εὐδοκίᾳ",1625,2],["σου",5,146],["τὴν",1,9],["Σιὼν",334,2],["καὶ",2,8],["οἰκοδομηθήτω",126,25],["τὰ",1,42],["τείχη",325,43],["Ἱερουσαλήμ",70,20]],"Do good, O Lord, to Sion in thy good pleasure; and let the walls of Jerusalem be built."],["21",[["Τότε",250,17],["εὐδοκήσεις",906,159],["θυσίαν",156,10],["δικαιοσύνης",187,19],["ἀναφορὰν",4506,10],["καὶ",2,8],["ὁλοκαυτώματα",318,43],["τότε",250,17],["ἀνοίσουσιν",384,207],["ἐπὶ",9,1],["τὸ",1,32],["θυσιαστήριόν",133,33],["σου",5,146],["μόσχους",256,31]],"Then shalt thou be pleased with a sacrifice of righteousness, offering, and whole-burnt-sacrifices: then shall they offer calves upon thine altar."]]