[["1",[["Εἰς",8,1],["τὸ",1,32],["τέλος",373,33],["μὴ",25,8],["διαφθείρῃς",688,170],["τῷ",1,110],["Δαυὶδ",52,105],["εἰς",8,1],["στηλογραφίαν",3640,10]],"For the end. Destroy not: by David, for a memorial."],["2",[["Εἰ",77,8],["ἀληθῶς",1795,17],["ἄρα",985,12],["δικαιοσύνην",187,10],["λαλεῖτε",50,307],["εὐθεῖα",1137,15],["κρίνετε",263,307],["οἱ",1,128],["υἱοὶ",13,51],["τῶν",1,76],["ἀνθρώπων",43,77]],"If ye do indeed speak righteousness, [then] do ye judge rightly, ye sons of men."],["3",[["Καὶ",2,8],["γὰρ",40,12],["ἐν",4,1],["καρδίᾳ",64,2],["ἀνομίας",275,19],["ἐργάζεσθε",467,382],["ἐν",4,1],["τῇ",1,95],["γῇ",26,2],["ἀδικίαν",288,10],["αἱ",1,185],["χεῖρες",37,180],["ὑμῶν",5,136],["συμπλέκουσιν",2383,191]],"For ye work iniquities in [your] hearts in the earth: your hands plot unrighteousness."],["4",[["Ἀπηλλοτριώθησαν",2658,94],["οἱ",1,128],["ἁμαρτωλοὶ",409,130],["ἀπὸ",17,1],["μήτρας",1350,19],["ἐπλανήθησαν",464,94],["ἀπὸ",17,1],["γαστρὸς",777,19],["ἐλάλησαν",50,141],["ψευδῆ",549,74]],"Sinners have gone astray from the womb: they go astray from the belly: they speak lies."],["5",[["Θυμὸς",178,5],["αὐτοῖς",3,142],["κατὰ",32,1],["τὴν",1,9],["ὁμοίωσιν",3765,10],["τοῦ",1,30],["ὄφεως",1197,21],["ὡσεὶ",343,17],["ἀσπίδος",1430,19],["κωφῆς",2362,78],["καὶ",2,8],["βυούσης",6874,212],["τὰ",1,42],["ὦτα",328,43],["αὐτῆς",3,83]],"Their venom is like [that] of a serpent; as [that] of a deaf asp, and that stops her ears;"],["6",[["ἥτις",457,421],["οὐκ",12,17],["εἰσακούσεται",241,89],["φωνὴν",95,10],["ἐπᾳδόντων",4596,164],["φαρμάκου",2394,21],["τε",209,12],["φαρμακευομένου",5118,418],["παρὰ",73,1],["σοφοῦ",324,153]],"which will not hear the voice of charmers, nor [heed] the charm prepared skilfully by the wise."],["7",[["Ὁ",1,4],["Θεὸς",20,5],["συνέτριψε",268,3],["τοὺς",1,56],["ὀδόντας",930,31],["αὐτῶν",3,41],["ἐν",4,1],["τῷ",1,52],["στόματι",123,53],["αὐτῶν",3,41],["τὰς",1,39],["μύλας",4318,40],["τῶν",1,76],["λεόντων",424,77],["συνέθλασεν",3647,3],["ὁ",1,4],["Κύριος",7,5]],"God has crushed their teeth in their mouth: God has broken the cheek-teeth of the lions."],["8",[["Ἐξουδενωθήσονται",1068,135],["ὡς",36,8],["ὕδωρ",85,33],["διαπορευόμενον",1113,205],["ἐντενεῖ",1991,120],["τὸ",1,32],["τόξον",711,33],["αὐτοῦ",3,48],["ἕως",42,8],["οὗ",120,17],["ἀσθενήσουσιν",771,207]],"They shall utterly pass away like water running through: he shall bend his bow till they shall fail."],["9",[["Ὡσεὶ",343,17],["κηρὸς",3069,5],["ὁ",1,4],["τακεῖς",1021,278],["ἀνταναιρεθήσονται",2982,135],["ἔπεσε",154,3],["πῦρ",118,33],["καὶ",2,8],["οὐκ",12,17],["εἶδον",53,147],["τὸν",1,6],["ἥλιον",323,7]],"They shall be destroyed as melted wax: the fire has fallen and they have not seen the sun."],["10",[["Πρὸ",238,1],["τοῦ",1,30],["συνιέναι",606,54],["τὰς",1,39],["ἀκάνθας",1571,40],["ὑμῶν",5,136],["τὴν",1,9],["ῥάμνον",4148,7],["ὡσεὶ",343,17],["ζῶντας",107,229],["ὡσεὶ",343,17],["ἐν",4,1],["ὀργῇ",198,2],["καταπίεται",1183,89],["ὑμᾶς",5,209]],"Before your thorns feel the white thorn, he shall swallow you up as living, as in his wrath."],["11",[["Εὐφρανθήσεται",244,125],["δίκαιος",153,16],["ὅταν",319,8],["ἴδῃ",53,160],["ἐκδίκησιν",821,10],["ἀσεβῶν",247,163],["τὰς",1,39],["χεῖρας",37,40],["αὐτοῦ",3,48],["νίψεται",1776,89],["ἐν",4,1],["τῷ",1,52],["αἵματι",148,53],["τοῦ",1,30],["ἁμαρτωλοῦ",409,153]],"The righteous shall rejoice when he sees the vengeance of the ungodly: he shall wash his hands in the blood of the sinner."],["12",[["Καὶ",2,8],["ἐρεῖ",165,120],["ἄνθρωπος",43,5],["εἰ",77,8],["ἄρα",985,12],["ἐστὶ",10,87],["καρπὸς",448,5],["τῷ",1,110],["δικαίῳ",153,111],["ἄρα",985,12],["ἐστὶν",10,87],["ὁ",1,4],["Θεὸς",20,5],["κρίνων",263,67],["αὐτοὺς",3,60],["ἐν",4,1],["τῇ",1,95],["γῇ",26,2]],"And a man shall say, Verily then there is a reward for the righteous: verily there is a God that judges them in the earth."]]