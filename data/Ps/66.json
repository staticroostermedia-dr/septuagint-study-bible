[["1",[["Εἰς",8,1],["τὸ",1,32],["τέλος",373,33],["ἐν",4,1],["ὕμνοις",1498,139],["ψαλμὸς",644,5],["τῷ",1,110],["Δαυίδ",52,105]],"For the end, a Psalm of David among the Hymns."],["2",[["Ὁ",1,4],["Θεὸς",20,5],["οἰκτειρήσαι",1309,216],["ἡμᾶς",6,60],["καὶ",2,8],["εὐλογήσαι",149,216],["ἡμᾶς",6,60],["ἐπιφάναι",1707,216],["τὸ",1,32],["πρόσωπον",47,33],["αὐτοῦ",3,48],["ἐφʼ",9,1],["ἡμᾶς",6,60],["διάψαλμα",689,20]],"God be merciful to us, and bless us; [and] cause his face to shine upon us. Pause."],["3",[["Τοῦ",1,30],["γνῶναι",79,100],["ἐν",4,1],["τῇ",1,95],["γῇ",26,2],["τὴν",1,9],["ὁδόν",68,10],["σου",5,146],["ἐν",4,1],["πᾶσιν",11,90],["ἔθνεσι",60,92],["τὸ",1,32],["σωτήριόν",472,33],["σου",5,146]],"That [men] may know thy way on the earth, thy salvation among all nations."],["4",[["Ἐξομολογησάσθωσάν",479,533],["σοι",5,151],["λαοὶ",35,51],["ὁ",1,4],["Θεὸς",20,5],["ἐξομολογησάσθωσάν",479,533],["σοι",5,151],["λαοὶ",35,51],["πάντες",11,130]],"Let the nations, O God, give thanks to thee; let all the nations give thanks to thee."],["5",[["Εὐφρανθήτωσαν",244,50],["καὶ",2,8],["ἀγαλλιάσθωσαν",738,72],["ἔθνη",60,43],["ὅτι",19,8],["κρινεῖς",263,159],["λαοὺς",35,31],["ἐν",4,1],["εὐθύτητι",1674,2],["καὶ",2,8],["ἔθνη",60,43],["ἐν",4,1],["τῇ",1,95],["γῇ",26,2],["ὁδηγήσεις",1108,159],["διάψαλμα",689,20]],"Let the nations rejoice and exult, for thou shalt judge the peoples in equity, and shalt guide the nations on the earth. Pause."],["6",[["Ἐξομολογησάσθωσάν",479,533],["σοι",5,151],["λαοὶ",35,51],["ὁ",1,4],["Θεὸς",20,5],["ἐξομολογησάσθωσάν",479,533],["σοι",5,151],["λαοὶ",35,51],["πάντες",11,130]],"Let the peoples, O God, give thanks to thee; let all the peoples give thanks to thee."],["7",[["Γῆ",26,13],["ἔδωκε",33,3],["τὸν",1,6],["καρπὸν",448,7],["αὐτῆς",3,83],["εὐλογήσαι",149,216],["ἡμᾶς",6,60],["ὁ",1,4],["Θεὸς",20,5],["ὁ",1,4],["Θεὸς",20,5],["ἡμῶν",6,41]],"The earth has yielded her fruit; let God, our God, bless us."],["8",[["εὐλογήσαι",149,216],["ἡμᾶς",6,60],["ὁ",1,4],["Θεὸς",20,5],["καὶ",2,8],["φοβηθήτωσαν",134,50],["αὐτὸν",3,82],["πάντα",11,59],["τὰ",1,42],["πέρατα",876,43],["τῆς",1,18],["γῆς",26,19]],"Let God bless us; and let all the ends of the earth fear him."]]