[["1",[["Εἰς",8,1],["τὸ",1,32],["τέλος",369,33],["ἐν",4,1],["ὕμνοις",1499,139],["ψαλμὸς",639,5],["τῷ",1,110],["Δαυίδ",52,105]],"For the end, a Psalm of David among the Hymns."],["2",[["Ὁ",1,4],["Θεὸς",20,5],["οἰκτειρήσαι",1687,276],["ἡμᾶς",6,60],["καὶ",2,8],["εὐλογήσαι",147,276],["ἡμᾶς",6,60],["ἐπιφάναι",1709,276],["τὸ",1,32],["πρόσωπον",47,33],["αὐτοῦ",3,48],["ἐφʼ",9,1],["ἡμᾶς",6,60],["διάψαλμα",687,20]],"God be merciful to us, and bless us; [and] cause his face to shine upon us. Pause."],["3",[["Τοῦ",1,30],["γνῶναι",81,100],["ἐν",4,1],["τῇ",1,95],["γῇ",26,2],["τὴν",1,9],["ὁδόν",67,10],["σου",5,146],["ἐν",4,1],["πᾶσιν",11,90],["ἔθνεσι",59,92],["τὸ",1,32],["σωτήριόν",471,33],["σου",5,146]],"That [men] may know thy way on the earth, thy salvation among all nations."],["4",[["Ἐξομολογησάσθωσάν",478,541],["σοι",5,151],["λαοὶ",35,51],["ὁ",1,4],["Θεὸς",20,5],["ἐξομολογησάσθωσάν",478,541],["σοι",5,151],["λαοὶ",35,51],["πάντες",11,130]],"Let the nations, O God, give thanks to thee; let all the nations give thanks to thee."],["5",[["Εὐφρανθήτωσαν",242,50],["καὶ",2,8],["ἀγαλλιάσθωσαν",737,72],["ἔθνη",59,43],["ὅτι",19,8],["κρινεῖς",240,159],["λαοὺς",35,31],["ἐν",4,1],["εὐθύτητι",1676,2],["καὶ",2,8],["ἔθνη",59,43],["ἐν",4,1],["τῇ",1,95],["γῇ",26,2],["ὁδηγήσεις",1110,159],["διάψαλμα",687,20]],"Let the nations rejoice and exult, for thou shalt judge the peoples in equity, and shalt guide the nations on the earth. Pause."],["6",[["Ἐξομολογησάσθωσάν",478,541],["σοι",5,151],["λαοὶ",35,51],["ὁ",1,4],["Θεὸς",20,5],["ἐξομολογησάσθωσάν",478,541],["σοι",5,151],["λαοὶ",35,51],["πάντες",11,130]],"Let the peoples, O God, give thanks to thee; let all the peoples give thanks to thee."],["7",[["Γῆ",26,13],["ἔδωκε",33,3],["τὸν",1,6],["καρπὸν",446,7],["αὐτῆς",3,83],["εὐλογήσαι",147,276],["ἡμᾶς",6,60],["ὁ",1,4],["Θεὸς",20,5],["ὁ",1,4],["Θεὸς",20,5],["ἡμῶν",6,41]],"The earth has yielded her fruit; let God, our God, bless us."],["8",[["εὐλογήσαι",147,276],["ἡμᾶς",6,60],["ὁ",1,4],["Θεὸς",20,5],["καὶ",2,8],["φοβηθήτωσαν",134,50],["αὐτὸν",3,82],["πάντα",11,59],["τὰ",1,42],["πέρατα",877,43],["τῆς",1,18],["γῆς",26,19]],"Let God bless us; and let all the ends of the earth fear him."]]