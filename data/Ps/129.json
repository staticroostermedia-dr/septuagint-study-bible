[["1",[["Ὠδὴ",776,105],["τῶν",1,76],["ἀναβαθμῶν",1484,77],["Ἐκ",21,1],["βαθέων",1880,163],["ἐκέκραξά",592,0],["σοι",5,151],["Κύριε",7,250]],"A Song of Degrees. Out of the depths have I cried to thee, O Lord."],["2",[["Κύριε",7,250],["εἰσάκουσον",241,198],["τῆς",1,18],["φωνῆς",95,19],["μου",6,83],["γενηθήτω",30,25],["τὰ",1,42],["ὦτά",328,43],["σου",5,146],["προσέχοντα",558,232],["εἰς",8,1],["τὴν",1,9],["φωνὴν",95,10],["τῆς",1,18],["δεήσεώς",677,19],["μου",6,83]],"O Lord, hearken to my voice; let thine ears be attentive to the voice of my supplication."],["3",[["Ἐὰν",45,8],["ἀνομίας",275,19],["παρατηρήσῃς",3914,170],["Κύριε",7,250],["Κύριε",7,250],["τίς",39,150],["ὑποστήσεται",1538,89]],"If thou, O Lord, shouldest mark iniquities, O Lord, who shall stand?"],["4",[["Ὅτι",19,8],["παρὰ",73,1],["σοὶ",5,151],["ὁ",1,4],["ἱλασμός",3213,5],["ἐστιν",10,87],["ἕνεκεν",447,1],["τοῦ",1,23],["ὀνόματός",57,24],["σου",5,146]],"For with thee is forgiveness: for thy name's sake"],["5",[["ὑπέμεινά",639,147],["σε",5,161],["Κύριε",7,250],["ὑπέμεινεν",639,3],["ἡ",1,11],["ψυχή",63,13],["μου",6,48],["εἰς",8,1],["τὸν",1,6],["λόγον",48,7],["σου",5,146]],"have I waited for thee, O Lord, my soul has waited for thy word."],["6",[["ἤλπισεν",514,3],["ἡ",1,11],["ψυχή",63,13],["μου",6,48],["ἐπὶ",9,1],["τὸν",1,6],["Κύριον",7,7],["ἀπὸ",17,1],["φυλακῆς",485,19],["πρωΐας",3122,19],["μέχρι",781,1],["νυκτός",219,19]],"My soul has hoped in the Lord; from the morning watch till night."],["7",[["Ἐλπισάτω",514,46],["Ἰσραὴλ",27,105],["ἐπὶ",9,1],["τὸν",1,6],["Κύριον",7,7],["ὅτι",19,8],["παρὰ",73,1],["τῷ",1,110],["Κυρίῳ",7,113],["τὸ",1,32],["ἔλεος",183,33],["καὶ",2,8],["πολλὴ",74,15],["παρ",73,1],["αὐτῷ",3,49],["λύτρωσις",2599,13]],"Let Israel hope in the Lord: for with the Lord is mercy, and with him is plenteous redemption."],["8",[["Καὶ",2,8],["αὐτὸς",3,158],["λυτρώσεται",535,89],["τὸν",1,6],["Ἰσραὴλ",27,105],["ἐκ",21,1],["πασῶν",11,115],["τῶν",1,123],["ἀνομιῶν",275,61],["αὐτοῦ",3,48]],"And he shall redeem Isr