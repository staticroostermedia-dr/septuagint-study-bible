[["1",[["Ψαλμὸς",644,5],["τῷ",1,110],["Δαυὶδ",52,105],["τετράδι",2967,2],["σαββάτου",442,24],["Θεὸς",20,5],["ἐκδικήσεων",821,61],["Κύριος",7,5],["ὁ",1,4],["Θεὸς",20,5],["ἐκδικήσεων",821,61],["ἐπαῤῥησιάσατο",3917,252]],"A Psalm of David for the fourth [day] of the week. The Lord is a God of vengeance; the God of vengeance has declared himself."],["2",[["Ὑψώθητι",331,242],["ὁ",1,4],["κρίνων",263,67],["τὴν",1,9],["γῆν",26,10],["ἀπόδος",312,198],["ἀνταπόδοσιν",2403,10],["τοῖς",1,138],["ὑπερηφάνοις",1109,215]],"Be thou exalted, thou that judgest the earth: render a reward to the proud."],["3",[["Ἕως",42,8],["πότε",458,12],["ἁμαρτωλοὶ",409,130],["Κύριε",7,250],["ἕως",42,8],["πότε",458,12],["ἁμαρτωλοὶ",409,130],["καυχήσονται",1380,484]],"How long shall sinners, O Lord, how long shall sinners boast?"],["4",[["Φθέγξονται",2296,127],["καὶ",2,8],["λαλήσουσιν",50,350],["ἀδικίαν",288,10],["λαλήσουσι",50,350],["πάντες",11,130],["οἱ",1,128],["ἐργαζόμενοι",467,351],["τὴν",1,9],["ἀνομίαν",275,10]],"They will utter and speak unrighteousness; all the workers of iniquity will speak [so]."],["5",[["Τὸν",1,6],["λαόν",35,7],["σου",5,146],["Κύριε",7,250],["ἐταπείνωσαν",322,141],["καὶ",2,8],["τὴν",1,9],["κληρονομίαν",299,10],["σου",5,146],["ἐκάκωσαν",757,141]],"They have afflicted thy people, O Lord, and hurt thine heritage."],["6",[["Χήραν",751,10],["καὶ",2,8],["ὀρφανὸν",957,37],["ἀπέκτειναν",300,141],["καὶ",2,8],["προσήλυτον",634,7],["ἐφόνευσαν",970,141]],"They have slain the widow and fatherless, and murdered the stranger."],["7",[["Καὶ",2,8],["εἶπαν",18,141],["οὐκ",12,17],["ὄψεται",112,89],["Κύριος",7,5],["οὐδὲ",106,12],["συνήσει",606,120],["ὁ",1,4],["Θεὸς",20,5],["τοῦ",1,30],["Ἰακώβ",146,105]],"And they said, The Lord shall not see, neither shall the God of Jacob understand."],["8",[["Σύνετε",606,69],["δὴ",193,12],["ἄφρονες",439,130],["ἐν",4,1],["τῷ",1,110],["λαῷ",35,113],["καὶ",2,8],["μωροὶ",1278,537],["ποτὲ",458,12],["φρονήσατε",2297,69]],"Understand now, ye simple among the people; and ye fools, at length be wise."],["9",[["Ὁ",1,4],["φυτεύσας",1022,155],["τὸ",1,32],["οὖς",328,33],["οὐχὶ",330,12],["ἀκούει",54,87],["ἢ",61,8],["ὁ",1,4],["πλάσας",910,155],["τὸν",1,6],["ὀφθαλμὸν",91,7],["οὐχὶ",330,12],["κατανοεῖ",1549,87]],"He that planted the ear, does he not hear? or he that formed the eye, does not he perceive?"],["10",[["Ὁ",1,4],["παιδεύων",643,67],["ἔθνη",60,43],["οὐχὶ",330,12],["ἐλέγξει",752,120],["ὁ",1,4],["διδάσκων",545,67],["ἄνθρωπον",43,7],["γνῶσιν",753,10]],"He that chastises the heathen, shall not he punish, [even] he that teaches man knowledge?"],["11",[["Κύριος",7,5],["γινώσκει",79,87],["τοὺς",1,56],["διαλογισμοὺς",1584,31],["τῶν",1,76],["ἀνθρώπων",43,77],["ὅτι",19,8],["εἰσὶ",10,191],["μάταιοι",654,130]],"The Lord knows the thoughts of men, that they are vain."],["12",[["Μακάριος",806,16],["ὁ",1,4],["ἄνθρωπος",43,5],["ὃν",24,106],["ἂν",83,12],["σὺ",5,156],["παιδεύσῃς",643,170],["Κύριε",7,250],["καὶ",2,8],["ἐκ",21,1],["τοῦ",1,30],["νόμου",140,21],["σου",5,146],["διδάξῃς",545,170],["αὐτόν",3,82]],"Blessed is the man whomsoever thou shalt chasten, O Lord, and shalt teach him out of thy law;"],["13",[["τοῦ",1,30],["πραΰναι",8031,216],["αὐτῷ",3,49],["ἀφʼ",17,1],["ἡμερῶν",28,61],["πονηρῶν",164,115],["ἕως",42,8],["οὗ",120,17],["ὀρυγῇ",1373,333],["τῷ",1,110],["ἁμαρτωλῷ",409,111],["βόθρος",1718,5]],"to give him rest from evil days, until a pit be digged for the sinful one."],["14",[["Ὅτι",19,8],["οὐκ",12,17],["ἀπώσεται",770,89],["Κύριος",7,5],["τὸν",1,6],["λαὸν",35,7],["αὐτοῦ",3,48],["καὶ",2,8],["τὴν",1,9],["κληρονομίαν",299,10],["αὐτοῦ",3,48],["οὐκ",12,17],["ἐγκαταλείψει",364,120]],"For the Lord will not cast off his people, neither will he forsake his inheritance;"],["15",[["ἕως",42,8],["οὗ",120,17],["δικαιοσύνη",187,13],["ἐπιστρέψῃ",117,160],["εἰς",8,1],["κρίσιν",229,10],["καὶ",2,8],["ἐχόμενοι",124,351],["αὐτῆς",3,83],["πάντες",11,130],["οἱ",1,128],["εὐθεῖς",825,130],["τῇ",1,95],["καρδίᾳ",64,2],["διάψαλμα",689,20]],"until righteousness return to judgment, and all the upright in heart shall follow it. Pause."],["16",[["Τίς",39,150],["ἀναστήσεταί",121,89],["μοι",6,49],["ἐπὶ",9,1],["πονηρευομένους",1331,230],["ἢ",61,8],["τίς",39,150],["συμπαραστήσεταί",8373,89],["μοι",6,49],["ἐπὶ",9,1],["τοὺς",1,56],["ἐργαζομένους",467,230],["τὴν",1,9],["ἀνομίαν",275,10]],"Who will rise up for me against the transgressors? or who will stand up with me against the workers of iniquity?"],["17",[["Εἰ",77,8],["μὴ",25,8],["ὅτι",19,8],["Κύριος",7,5],["ἐβοήθησέ",553,3],["μοι",6,49],["παραβραχὺ",0,0],["παρῴκησε",782,3],["τῷ",1,110],["ᾅδῃ",586,113],["ἡ",1,11],["ψυχή",63,13],["μου",6,48]],"If the Lord had not helped me, my soul had almost sojourned in Hades."],["18",[["Εἰ",77,8],["ἔλεγον",31,129],["σεσάλευται",678,182],["ὁ",1,4],["πούς",210,5],["μου",6,48],["τὸ",1,32],["ἔλεός",183,33],["σου",5,146],["Κύριε",7,250],["ἐβοήθει",553,14],["μοι",6,49]],"If I said, My foot has been moved; thy mercy, O Lord, helped me.",{"s":"r"}],["19",[["Κύριε",7,250],["κατὰ",32,1],["τὸ",1,32],["πλῆθος",200,33],["τῶν",1,123],["ὀδυνῶν",774,61],["μου",6,48],["ἐν",4,1],["τῇ",1,95],["καρδίᾳ",64,2],["μου",6,48],["αἱ",1,185],["παρακλήσεις",2183,180],["σου",5,146],["ἠγάπησαν",214,141],["τὴν",1,9],["ψυχήν",63,10],["μου",6,48]],"O Lord, according to the multitude of my griefs within my heart, thy consolations have soothed my soul.",{"s":"r"}],["20",[["Μὴ",25,8],["συμπροσέσται",6100,89],["σοι",5,151],["θρόνος",383,5],["ἀνομίας",275,19],["ὁ",1,4],["πλάσσων",910,67],["κόπον",1345,7],["ἐπὶ",9,1],["προστάγματι",393,53]],"Shall the throne of iniquity have fellowship with thee, which frames mischief by an ordinance?"],["21",[["Θηρεύσουσιν",1887,207],["ἐπὶ",9,1],["ψυχὴν",63,10],["δικαίου",153,153],["καὶ",2,8],["αἷμα",148,33],["ἀθῶον",1079,29],["καταδικάσονται",2582,127]],"They will hunt for the soul of the righteous, and condemn innocent blood."],["22",[["Καὶ",2,8],["ἐγένετό",30,26],["μοι",6,49],["Κύριος",7,5],["εἰς",8,1],["καταφυγὴν",1678,10],["καὶ",2,8],["ὁ",1,4],["Θεός",20,5],["μου",6,48],["εἰς",8,1],["βοηθὸν",947,7],["ἐλπίδος",530,19],["μου",6,83]],"But the Lord was my refuge; and my God the helper of my hope."],["23",[["Καὶ",2,8],["ἀποδώσει",312,120],["αὐτοῖς",3,142],["τὴν",1,9],["ἀνομίαν",275,10],["αὐτῶν",3,41],["καὶ",2,8],["τὴν",1,9],["πονηρίαν",730,10],["αὐτῶν",3,41],["ἀφανιεῖ",623,120],["αὐτοὺς",3,60],["Κύριος",7,5],["ὁ",1,4],["Θεὸς",20,5],["ἡμῶν",6,41]],"And he will recompense to them their iniquity and their wickedness: the Lord our God shall utterly destroy them."]]