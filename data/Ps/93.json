[["1",[["Ψαλμὸς",639,5],["τῷ",1,110],["Δαυὶδ",52,105],["τετράδι",2979,2],["σαββάτου",441,24],["Θεὸς",20,5],["ἐκδικήσεων",608,61],["Κύριος",7,5],["ὁ",1,4],["Θεὸς",20,5],["ἐκδικήσεων",608,61],["ἐπαῤῥησιάσατο",3927,253]],"A Psalm of David for the fourth [day] of the week. The Lord is a God of vengeance; the God of vengeance has declared himself."],["2",[["Ὑψώθητι",327,242],["ὁ",1,4],["κρίνων",240,67],["τὴν",1,9],["γῆν",26,10],["ἀπόδος",311,198],["ἀνταπόδοσιν",2412,10],["τοῖς",1,138],["ὑπερηφάνοις",1111,215]],"Be thou exalted, thou that judgest the earth: render a reward to the proud."],["3",[["Ἕως",42,8],["πότε",455,12],["ἁμαρτωλοὶ",406,130],["Κύριε",7,251],["ἕως",42,8],["πότε",455,12],["ἁμαρτωλοὶ",406,130],["καυχήσονται",1379,492]],"How long shall sinners, O Lord, how long shall sinners boast?"],["4",[["Φθέγξονται",2309,127],["καὶ",2,8],["λαλήσουσιν",50,355],["ἀδικίαν",288,10],["λαλήσουσι",50,355],["πάντες",11,130],["οἱ",1,128],["ἐργαζόμενοι",468,356],["τὴν",1,9],["ἀνομίαν",274,10]],"They will utter and speak unrighteousness; all the workers of iniquity will speak [so]."],["5",[["Τὸν",1,6],["λαόν",35,7],["σου",5,146],["Κύριε",7,251],["ἐταπείνωσαν",333,141],["καὶ",2,8],["τὴν",1,9],["κληρονομίαν",297,10],["σου",5,146],["ἐκάκωσαν",764,141]],"They have afflicted thy people, O Lord, and hurt thine heritage."],["6",[["Χήραν",749,10],["καὶ",2,8],["ὀρφανὸν",959,37],["ἀπέκτειναν",298,141],["καὶ",2,8],["προσήλυτον",632,7],["ἐφόνευσαν",983,141]],"They have slain the widow and fatherless, and murdered the stranger."],["7",[["Καὶ",2,8],["εἶπαν",18,221],["οὐκ",12,17],["ὄψεται",111,89],["Κύριος",7,5],["οὐδὲ",105,12],["συνήσει",602,120],["ὁ",1,4],["Θεὸς",20,5],["τοῦ",1,30],["Ἰακώβ",146,105]],"And they said, The Lord shall not see, neither shall the God of Jacob understand."],["8",[["Σύνετε",602,69],["δὴ",193,12],["ἄφρονες",438,130],["ἐν",4,1],["τῷ",1,110],["λαῷ",35,113],["καὶ",2,8],["μωροὶ",1276,545],["ποτὲ",455,12],["φρονήσατε",2310,69]],"Understand now, ye simple among the people; and ye fools, at length be wise."],["9",[["Ὁ",1,4],["φυτεύσας",1066,155],["τὸ",1,32],["οὖς",325,33],["οὐχὶ",326,12],["ἀκούει",53,87],["ἢ",60,8],["ὁ",1,4],["πλάσας",912,155],["τὸν",1,6],["ὀφθαλμὸν",91,7],["οὐχὶ",326,12],["κατανοεῖ",1547,87]],"He that planted the ear, does he not hear? or he that formed the eye, does not he perceive?"],["10",[["Ὁ",1,4],["παιδεύων",654,67],["ἔθνη",59,43],["οὐχὶ",326,12],["ἐλέγξει",750,120],["ὁ",1,4],["διδάσκων",543,67],["ἄνθρωπον",43,7],["γνῶσιν",753,10]],"He that chastises the heathen, shall not he punish, [even] he that teaches man knowledge?"],["11",[["Κύριος",7,5],["γινώσκει",81,87],["τοὺς",1,56],["διαλογισμοὺς",1585,31],["τῶν",1,76],["ἀνθρώπων",43,77],["ὅτι",19,8],["εἰσὶ",10,189],["μάταιοι",648,130]],"The Lord knows the thoughts of men, that they are vain."],["12",[["Μακάριος",803,16],["ὁ",1,4],["ἄνθρωπος",43,5],["ὃν",24,106],["ἂν",82,12],["σὺ",5,156],["παιδεύσῃς",654,170],["Κύριε",7,251],["καὶ",2,8],["ἐκ",21,1],["τοῦ",1,30],["νόμου",140,21],["σου",5,146],["διδάξῃς",543,170],["αὐτόν",3,82]],"Blessed is the man whomsoever thou shalt chasten, O Lord, and shalt teach him out of thy law;"],["13",[["τοῦ",1,30],["πραΰναι",8091,276],["αὐτῷ",3,49],["ἀφʼ",17,1],["ἡμερῶν",28,61],["πονηρῶν",164,115],["ἕως",42,8],["οὗ",120,17],["ὀρυγῇ",1372,337],["τῷ",1,110],["ἁμαρτωλῷ",406,111],["βόθρος",1718,5]],"to give him rest from evil days, until a pit be digged for the sinful one."],["14",[["Ὅτι",19,8],["οὐκ",12,17],["ἀπώσεται",767,89],["Κύριος",7,5],["τὸν",1,6],["λαὸν",35,7],["αὐτοῦ",3,48],["καὶ",2,8],["τὴν",1,9],["κληρονομίαν",297,10],["αὐτοῦ",3,48],["οὐκ",12,17],["ἐγκαταλείψει",363,120]],"For the Lord will not cast off his people, neither will he forsake his inheritance;"],["15",[["ἕως",42,8],["οὗ",120,17],["δικαιοσύνη",185,13],["ἐπιστρέψῃ",116,160],["εἰς",8,1],["κρίσιν",226,10],["καὶ",2,8],["ἐχόμενοι",124,356],["αὐτῆς",3,83],["πάντες",11,130],["οἱ",1,128],["εὐθεῖς",826,130],["τῇ",1,95],["καρδίᾳ",63,2],["διάψαλμα",687,20]],"until righteousness return to judgment, and all the upright in heart shall follow it. Pause."],["16",[["Τίς",39,150],["ἀναστήσεταί",121,89],["μοι",6,49],["ἐπὶ",9,1],["πονηρευομένους",1387,230],["ἢ",60,8],["τίς",39,150],["συμπαραστήσεταί",8432,89],["μοι",6,49],["ἐπὶ",9,1],["τοὺς",1,56],["ἐργαζομένους",468,230],["τὴν",1,9],["ἀνομίαν",274,10]],"Who will rise up for me against the transgressors? or who will stand up with me against the workers of iniquity?"],["17",[["Εἰ",77,8],["μὴ",25,8],["ὅτι",19,8],["Κύριος",7,5],["ἐβοήθησέ",552,3],["μοι",6,49],["παραβραχὺ",0,0],["παρῴκησε",781,3],["τῷ",1,110],["ᾅδῃ",583,113],["ἡ",1,11],["ψυχή",62,13],["μου",6,48]],"If the Lord had not helped me, my soul had almost sojourned in Hades."],["18",[["Εἰ",77,8],["ἔλεγον",31,129],["σεσάλευται",0,0],["ὁ",1,4],["πούς",208,5],["μου",6,48],["τὸ",1,32],["ἔλεός",182,33],["σου",5,146],["Κύριε",7,251],["ἐβοήθει",552,14],["μοι",6,49]],"If I said, My foot has been moved;"],["19",[["Κύριε",7,251],["κατὰ",32,1],["τὸ",1,32],["πλῆθος",199,33],["τῶν",1,123],["ὀδυνῶν",771,61],["μου",6,48],["ἐν",4,1],["τῇ",1,95],["καρδίᾳ",63,2],["μου",6,48],["αἱ",1,183],["παρακλήσεις",2196,179],["σου",5,146],["ἠγάπησαν",224,141],["τὴν",1,9],["ψυχήν",62,10],["μου",6,48]],"thy mercy, O Lord, helped me. O Lord, according to the multitude of my griefs within my heart, thy consolations have soothed my soul."],["20",[["Μὴ",25,8],["συμπροσέσται",6128,89],["σοι",5,151],["θρόνος",379,5],["ἀνομίας",274,19],["ὁ",1,4],["πλάσσων",912,67],["κόπον",1342,7],["ἐπὶ",9,1],["προστάγματι",391,53]],"Shall the throne of iniquity have fellowship with thee, which frames mischief by an ordinance?"],["21",[["Θηρεύσουσιν",1890,207],["ἐπὶ",9,1],["ψυχὴν",62,10],["δικαίου",152,153],["καὶ",2,8],["αἷμα",148,33],["ἀθῶον",0,0],["καταδικάσονται",2586,127]],"They will hunt for the soul of the righteous, and condemn innocent blood."],["22",[["Καὶ",2,8],["ἐγένετό",30,26],["μοι",6,49],["Κύριος",7,5],["εἰς",8,1],["καταφυγὴν",1681,10],["καὶ",2,8],["ὁ",1,4],["Θεός",20,5],["μου",6,48],["εἰς",8,1],["βοηθὸν",948,7],["ἐλπίδος",527,19],["μου",6,83]],"But the Lord was my refuge; and my God the helper of my hope."],["23",[["Καὶ",2,8],["ἀποδώσει",311,120],["αὐτοῖς",3,142],["τὴν",1,9],["ἀνομίαν",274,10],["αὐτῶν",3,41],["καὶ",2,8],["τὴν",1,9],["πονηρίαν",729,10],["αὐτῶν",3,41],["ἀφανιεῖ",675,120],["αὐτοὺς",3,60],["Κύριος",7,5],["ὁ",1,4],["Θεὸς",20,5],["ἡμῶν",6,41]],"And he will recompense to them their iniquity and their wickedness: the Lord our God shall utterly destroy them."]]