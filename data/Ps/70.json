20,5],["μου",6,48],["εἰς",8,1],["τὴν",1,9],["βοήθειάν",765,10],["μου",6,48],["πρόσχες",1689,154],["Αἰσχυνθήτωσαν",611,50],["καὶ",2,8],["ἐκλιπέτωσαν",321,261],["οἱ",1,128],["ἐνδιαβάλλοντες",4082,137],["τὴν",1,9],["ψυχήν",63,10],["μου",6,48],["περιβαλλέσθωσαν",744,72],["αἰσχύνην",685,10],["καὶ",2,8],["ἐντροπὴν",3435,10],["οἱ",1,128],["ζητοῦντες",191,137],["τὰ",1,42],["κακά",161,65],["μοι",6,49]],"Let those that plot against my soul be ashamed and utterly fail: let those that seek my hurt be clothed with shame and dishonour."],["14",[["Ἐγὼ",6,158],["δὲ",14,12],["διαπαντὸς",510,17],["ἐλπιῶ",514,157],["καὶ",2,8],["προσθήσω",201,157],["ἐπὶ",9,1],["πᾶσαν",11,37],["τὴν",1,9],["αἴνεσίν",989,10],["σου",5,146]],"But I will hope continually, and will praise thee more and more."],["15",[["Τὸ",1,32],["στόμα",123,33],["μου",6,48],["ἐξαγγελεῖ",2532,120],["τὴν",1,9],["δικαιοσύνην",187,10],["σου",5,146],["ὅλην",235,37],["τὴν",1,9],["ἡμέραν",28,10],["τὴν",1,9],["σωτηρίαν",425,10],["σου",5,146],["ὅτι",19,8],["οὐκ",12,17],["ἔγνων",79,147],["πραγματείας",3336,40]],"My mouth shall declare thy righteousness openly, [and] thy salvation all the day; for I am not acquainted with the affairs [of men]."],["16",[["Εἰσελεύσομαι",86,177],["ἐν",4,1],["δυναστείᾳ",918,2],["Κυρίου",7,21],["Κύριε",7,250],["μνησθήσομαι",230,176],["τῆς",1,18],["δικαιοσύνης",187,19],["σου",5,146],["μόνου",302,153]],"I will go on in the might of the Lord: O Lord, I will make mention of thy righteousness only."],["17",[["Ἐδίδαξας",545,154],["με",6,82],["ὁ",1,4],["Θεὸς",20,5],["ἐκ",21,1],["νεότητός",787,19],["μου",6,83],["καὶ",2,8],["μέχρι",781,1],["νῦν",90,17],["ἀπαγγελῶ",273,157],["τὰ",1,42],["θαυμάσιά",884,65],["σου",5,146]],"O God, thou hast taught me from my youth, and until now will I declare thy wonders;"],["18",[["καὶ",2,8],["ἕως",42,8],["γήρους",3512,24],["καὶ",2,8],["πρεσβείου",4362,24],["ὁ",1,4],["Θεὸς",20,5],["μὴ",25,8],["ἐγκαταλίπῃς",364,170],["με",6,82],["ἕως",42,8],["ἂν",83,12],["ἀπαγγείλω",273,227],["τὸν",1,6],["βραχίονά",618,59],["σου",5,146],["πάσῃ",11,96],["τῇ",1,95],["γενεᾷ",286,2],["τῇ",1,95],["ἐρχομένῃ",55,499],["Τὴν",1,9],["δυναστείαν",918,10],["σου",5,146]],"even until I am old and advanced in years. O God, forsake me not; until I shall have declared thine arm to all the generation that is to come:"],["19",[["καὶ",2,8],["τὴν",1,9],["δικαιοσύνην",187,10],["σου",5,146],["ὁ",1,4],["Θεὸς",20,5],["ἕως",42,8],["ὑψίστων",474,115],["ἃ",1,11],["ἐποίησας",23,154],["μεγαλεῖα",2268,65],["ὁ",1,4],["Θεὸς",20,5],["τίς",39,150],["ὅμοιός",657,16],["σοι",5,151]],"even thy power and thy righteousness, O God, up to the highest [heavens, even] the mighty works which thou hast done: O God, who is like to thee?"],["20",[["Ὅσας",103,40],["ἔδειξάς",860,154],["μοι",6,49],["θλίψεις",438,40],["πολλὰς",74,109],["καὶ",2,8],["κακάς",161,109],["καὶ",2,8],["ἐπιστρέψας",117,155],["ἐζωοποίησάς",3533,154],["με",6,82],["καὶ",2,8],["ἐκ",21,1],["τῶν",1,123],["ἀβύσσων",1083,61],["τῆς",1,18],["γῆς",26,19],["πάλιν",655,17],["ἀνήγαγές",524,154],["με",6,82]],"What afflictions many and sore hast thou shewed me! yet thou didst turn and quicken me, and broughtest me again from the depths of the earth."],["21",[["Ἐπλεόνασας",1523,154],["τὴν",1,9],["δικαιοσύνην",187,10],["σου",5,146],["καὶ",2,8],["ἐπιστρέψας",117,155],["παρεκάλεσάς",434,154],["με",6,82],["καὶ",2,8],["ἐκ",21,1],["τῶν",1,123],["ἀβύσσων",1083,61],["τῆς",1,18],["γῆς",26,19],["πάλιν",655,17],["ἀνήγαγές",524,154],["με",6,82]],"Thou didst multiply thy righteousness, and didst turn and comfort me, and broughtest me again out of the depths of the earth."],["22",[["Καὶ",2,8],["γὰρ",40,12],["ἐγὼ",6,158],["ἐξομολογήσομαί",479,177],["σοι",5,151],["ἐν",4,1],["σκεύει",182,53],["ψαλμοῦ",644,21],["τὴν",1,9],["ἀλήθειάν",352,10],["σου",5,146],["ὁ",1,4],["Θεὸς",20,5],["ψαλῶ",913,157],["σοι",5,151],["ἐν",4,1],["κιθάρᾳ",1513,2],["ὁ",1,4],["ἅγιος",75,16],["τοῦ",1,30],["Ἰσραήλ",27,105]],"I will also therefore give thanks to thee, O God, [because of] thy truth, on an instrument of psalmody: I will sing psalms to thee on the harp, O Holy One of Israel."],["23",[["Ἀγαλλιάσονται",738,127],["τὰ",1,42],["χείλη",361,43],["μου",6,48],["ὅταν",319,8],["ψάλω",913,227],["σοι",5,151],["καὶ",2,8],["ἡ",1,11],["ψυχή",63,13],["μου",6,48],["ἣν",24,124],["ἐλυτρώσω",535,169]],"My lips shall rejoice when I sing to thee; and my soul, which thou hast redeemed."],["24",[["Ἔτι",111,17],["δὲ",14,12],["καὶ",2,8],["ἡ",1,11],["γλῶσσά",388,13],["μου",6,48],["ὅλην",235,37],["τὴν",1,9],["ἡμέραν",28,10],["μελετήσει",1347,120],["τὴν",1,9],["δικαιοσύνην",187,10],["σου",5,146],["ὅταν",319,8],["αἰσχυνθῶσι",611,266],["καὶ",2,8],["ἐντραπῶσιν",1105,266],["οἱ",1,128],["ζητοῦντες",191,137],["τὰ",1,42],["κακά",161,65],["μοι",6,49]],"Moreover also my tongue shall dwell all the day upon thy righteousness; when they shall be ashamed and confounded that seek my hurt."]]