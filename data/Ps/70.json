[["1",[["Τῷ",1,110],["Δαυὶδ",52,105],["υἱῶν",13,77],["Ἰωναδὰβ",0,0],["καὶ",2,8],["τῶν",1,76],["πρώτων",495,163],["αἰχμαλωτισθέντων",2261,246],["Ἐπὶ",9,1],["σοὶ",5,151],["Κύριε",7,251],["ἤλπισα",511,147],["μὴ",25,8],["καταισχυνθείην",716,694],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7]],"By David, [a Psalm sung by] the sons of Jonadab, and the first that were taken captive. O Lord, I have hoped in thee: let me never be put to shame."],["2",[["Ἐν",4,1],["τῇ",1,95],["δικαιοσύνῃ",185,2],["σου",5,146],["ῥῦσαί",335,275],["με",6,82],["καὶ",2,8],["ἐξελοῦ",411,275],["με",6,82],["κλῖνον",829,36],["πρὸς",15,1],["μὲ",6,82],["τὸ",1,32],["οὖς",325,33],["σου",5,146],["καὶ",2,8],["σῶσόν",171,198],["με",6,82]],"In thy righteousness deliver me and rescue me: incline thine ear to me, and save me."],["3",[["Γενοῦ",30,275],["μοι",6,49],["εἰς",8,1],["Θεὸν",20,7],["ὑπερασπιστὴν",1876,7],["καὶ",2,8],["εἰς",8,1],["τόπον",99,7],["ὀχυρὸν",855,59],["τοῦ",1,30],["σῶσαί",171,100],["με",6,82],["ὅτι",19,8],["στερέωμά",1482,20],["μου",6,48],["καὶ",2,8],["καταφυγή",1681,13],["μου",6,48],["εἶ",10,145],["σύ",5,156]],"Be to me a protecting God, and a strong hold to save me: for thou art my fortress and my refuge."],["4",[["Ὁ",1,4],["Θεός",20,5],["μου",6,48],["ῥῦσαί",335,275],["με",6,82],["ἐκ",21,1],["χειρὸς",37,19],["ἁμαρτωλοῦ",406,78],["ἐκ",21,1],["χειρὸς",37,19],["παρανομοῦντος",2760,143],["καὶ",2,8],["ἀδικοῦντος",819,143]],"Deliver me, O my God, from the hand of the sinner, from the hand of the transgressor and unjust man."],["5",[["Ὅτι",19,8],["σὺ",5,156],["εἶ",10,145],["ἡ",1,11],["ὑπομονή",1615,13],["μου",6,48],["Κύριε",7,251],["Κύριε",7,251],["ἡ",1,11],["ἐλπίς",527,13],["μου",6,83],["ἐκ",21,1],["νεότητός",785,19],["μου",6,83]],"For thou art my support, O Lord; O Lord, [thou art] my hope from my youth."],["6",[["Ἐπὶ",9,1],["σὲ",5,161],["ἐπεστηρίχθην",2850,256],["ἀπὸ",17,1],["γαστρὸς",775,19],["ἐκ",21,1],["κοιλίας",545,19],["μητρός",188,19],["μου",6,83],["σύ",5,156],["μου",6,83],["εἶ",10,145],["σκεπαστής",3646,5],["ἐν",4,1],["σοὶ",5,151],["ἡ",1,11],["ὕμνησίς",6704,13],["μου",6,48],["διαπαντός",506,17]],"On thee have I been stayed from the womb: from the belly of my mother thou art my protector: of thee is my praise continually."],["7",[["Ὡσεὶ",342,17],["τέρας",1005,20],["ἐγενήθην",30,148],["τοῖς",1,138],["πολλοῖς",74,215],["καὶ",2,8],["σὺ",5,156],["βοηθὸς",948,5],["κραταιός",862,16]],"I am become as it were a wonder to many; but thou art [my] strong helper."],["8",[["Πληρωθήτω",529,25],["τὸ",1,32],["στόμα",123,33],["μου",6,83],["αἰνέσεως",990,19],["ὅπως",236,8],["ὑμνήσω",856,157],["τὴν",1,9],["δόξαν",141,10],["σου",5,146],["ὅλην",233,37],["τὴν",1,9],["ἡμέραν",28,10],["τὴν",1,9],["μεγαλοπρέπειάν",2745,10],["σου",5,146]],"Let my mouth be filled with praise, that I may hymn thy glory, [and] thy majesty all the day."],["9",[["Μὴ",25,8],["ἀποῤῥίψῃς",1215,170],["με",6,82],["εἰς",8,1],["καιρὸν",132,7],["γήρους",3515,24],["ἐν",4,1],["τῷ",1,110],["ἐκλείπειν",321,54],["τὴν",1,9],["ἰσχύν",180,10],["μου",6,48],["μὴ",25,8],["ἐγκαταλίπῃς",363,170],["με",6,82]],"Cast me not off at the time of old age; forsake me not when my strength fails."],["10",[["Ὅτι",19,8],["εἶπαν",18,221],["οἱ",1,128],["ἐχθροί",135,51],["μου",6,48],["ἐμοὶ",6,49],["καὶ",2,8],["οἱ",1,128],["φυλάσσοντες",127,137],["τὴν",1,9],["ψυχήν",62,10],["μου",6,48],["ἐβουλεύσαντο",637,182],["ἐπιτοαυτὸ",1405,105]],"For mine enemies have spoken against me; and they that lay wait for my soul have taken counsel together,"],["11",[["λέγοντες",31,137],["ὁ",1,4],["Θεὸς",20,5],["ἐγκατέλιπεν",363,3],["αὐτὸν",3,82],["καταδιώξατε",619,69],["καὶ",2,8],["καταλάβετε",537,69],["αὐτὸν",3,82],["ὅτι",19,8],["οὐκ",12,17],["ἔστιν",10,87],["ὁ",1,4],["ῥυόμενος",335,114]],"saying, God has forsaken him: persecute ye and take him; for there is none to deliver [him]."],["12",[["Ὁ",1,4],["Θεὸς",20,5],["μὴ",25,8],["μακρύνῃς",0,0],["ἀπʼ",17,1],["ἐμοῦ",6,48]],"O God, go not far from me, O my God, draw nigh to my help."],["13",[["ὁ",1,4],["Θεός",20,5],["μου",6,48],["εἰς",8,1],["τὴν",1,9],["βοήθειάν",761,10],["μου",6,48],["πρόσχες",1692,154],["Αἰσχυνθήτωσαν",614,50],["καὶ",2,8],["ἐκλιπέτωσαν",0,0],["οἱ",1,128],["ἐνδιαβάλλοντες",4091,137],["τὴν",1,9],["ψυχήν",62,10],["μου",6,48],["περιβαλλέσθωσαν",743,72],["αἰσχύνην",683,10],["καὶ",2,8],["ἐντροπὴν",3439,10],["οἱ",1,128],["ζητοῦντες",190,137],["τὰ",1,42],["κακά",161,65],["μοι",6,49]],"Let those that plot against my soul be ashamed and utterly fail: let those that seek my hurt be clothed with shame and dishonour."],["14",[["Ἐγὼ",6,158],["δὲ",14,12],["διαπαντὸς",506,17],["ἐλπιῶ",511,157],["καὶ",2,8],["προσθήσω",200,157],["ἐπὶ",9,1],["πᾶσαν",11,37],["τὴν",1,9],["αἴνεσίν",990,10],["σου",5,146]],"But I will hope continually, and will praise thee more and more."],["15",[["Τὸ",1,32],["στόμα",123,33],["μου",6,48],["ἐξαγγελεῖ",2535,120],["τὴν",1,9],["δικαιοσύνην",185,10],["σου",5,146],["ὅλην",233,37],["τὴν",1,9],["ἡμέραν",28,10],["τὴν",1,9],["σωτηρίαν",422,10],["σου",5,146],["ὅτι",19,8],["οὐκ",12,17],["ἔγνων",81,147],["πραγματείας",3341,40]],"My mouth shall declare thy righteousness openly, [and] thy salvation all the day; for I am not acquainted with the affairs [of men]."],["16",[["Εἰσελεύσομαι",88,176],["ἐν",4,1],["δυναστείᾳ",919,2],["Κυρίου",7,21],["Κύριε",7,251],["μνησθήσομαι",231,175],["τῆς",1,18],["δικαιοσύνης",185,19],["σου",5,146],["μόνου",300,153]],"I will go on in the might of the Lord: O Lord, I will make mention of thy righteousness only."],["17",[["Ἐδίδαξας",543,154],["με",6,82],["ὁ",1,4],["Θεὸς",20,5],["ἐκ",21,1],["νεότητός",785,19],["μου",6,83],["καὶ",2,8],["μέχρι",780,1],["νῦν",89,17],["ἀπαγγελῶ",272,157],["τὰ",1,42],["θαυμάσιά",885,65],["σου",5,146]],"O God, thou hast taught me from my youth, and until now will I declare thy wonders;"],["18",[["καὶ",2,8],["ἕως",42,8],["γήρους",3515,24],["καὶ",2,8],["πρεσβείου",4375,24],["ὁ",1,4],["Θεὸς",20,5],["μὴ",25,8],["ἐγκαταλίπῃς",363,170],["με",6,82],["ἕως",42,8],["ἂν",82,12],["ἀπαγγείλω",272,227],["τὸν",1,6],["βραχ