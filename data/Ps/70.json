[["1",[["Τῷ",1,110],["Δαυὶδ",52,105],["υἱῶν",13,77],["Ἰωναδὰβ",11607,0],["καὶ",2,8],["τῶν",1,76],["πρώτων",496,163],["αἰχμαλωτισθέντων",2246,245],["Ἐπὶ",9,1],["σοὶ",5,151],["Κύριε",7,250],["ἤλπισα",514,147],["μὴ",25,8],["καταισχυνθείην",696,672],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7]],"By David, [a Psalm sung by] the sons of Jonadab, and the first that were taken captive. O Lord, I have hoped in thee: let me never be put to shame."],["2",[["Ἐν",4,1],["τῇ",1,95],["δικαιοσύνῃ",187,2],["σου",5,146],["ῥῦσαί",337,275],["με",6,82],["καὶ",2,8],["ἐξελοῦ",413,275],["με",6,82],["κλῖνον",785,36],["πρὸς",15,1],["μὲ",6,82],["τὸ",1,32],["οὖς",328,33],["σου",5,146],["καὶ",2,8],["σῶσόν",172,198],["με",6,82]],"In thy righteousness deliver me and rescue me: incline thine ear to me, and save me."],["3",[["Γενοῦ",30,275],["μοι",6,49],["εἰς",8,1],["Θεὸν",20,7],["ὑπερασπιστὴν",1875,7],["καὶ",2,8],["εἰς",8,1],["τόπον",99,7],["ὀχυρὸν",854,59],["τοῦ",1,30],["σῶσαί",172,100],["με",6,82],["ὅτι",19,8],["στερέωμά",1479,20],["μου",6,48],["καὶ",2,8],["καταφυγή",1678,13],["μου",6,48],["εἶ",10,145],["σύ",5,156]],"Be to me a protecting God, and a strong hold to save me: for thou art my fortress and my refuge."],["4",[["Ὁ",1,4],["Θεός",20,5],["μου",6,48],["ῥῦσαί",337,275],["με",6,82],["ἐκ",21,1],["χειρὸς",37,19],["ἁμαρτωλοῦ",409,78],["ἐκ",21,1],["χειρὸς",37,19],["παρανομοῦντος",2750,143],["καὶ",2,8],["ἀδικοῦντος",760,143]],"Deliver me, O my God, from the hand of the sinner, from the hand of the transgressor and unjust man."],["5",[["Ὅτι",19,8],["σὺ",5,156],["εἶ",10,145],["ἡ",1,11],["ὑπομονή",1616,13],["μου",6,48],["Κύριε",7,250],["Κύριε",7,250],["ἡ",1,11],["ἐλπίς",530,13],["μου",6,83],["ἐκ",21,1],["νεότητός",787,19],["μου",6,83]],"For thou art my support, O Lord; O Lord, [thou art] my hope from my youth."],["6",[["Ἐπὶ",9,1],["σὲ",5,161],["ἐπεστηρίχθην",2676,256],["ἀπὸ",17,1],["γαστρὸς",777,19],["ἐκ",21,1],["κοιλίας",547,19],["μητρός",189,19],["μου",6,83],["σύ",5,156],["μου",6,83],["εἶ",10,145],["σκε