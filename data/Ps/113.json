[["1",[["Ἀλληλούϊα",1746,105],["Ἐν",4,1],["ἐξόδῳ",758,2],["Ἰσραὴλ",27,105],["ἐξ",21,1],["Αἰγύπτου",93,19],["οἴκου",34,21],["Ἰακὼβ",146,105],["ἐκ",21,1],["λαοῦ",35,21],["βαρβάρου",3049,153]],"Alleluia. At the going forth of Israel from Egypt, of the house of Jacob from a barbarous people,"],["2",[["ἐγενήθη",30,38],["Ἰουδαία",491,13],["ἁγίασμα",836,20],["αὐτοῦ",3,48],["Ἰσραὴλ",27,105],["ἐξουσία",928,13],["αὐτοῦ",3,48]],"Judea became his sanctuary, [and] Israel his dominion."],["3",[["Ἡ",1,11],["θάλασσα",137,13],["εἶδε",276,3],["καὶ",2,8],["ἔφυγεν",265,3],["ὁ",1,4],["Ἰορδάνης",301,5],["ἐστράφη",1079,38],["εἰς",8,1],["τὰ",1,42],["ὀπίσω",166,17]],"The sea saw and fled: Jordan was turned back."],["4",[["Τὰ",1,42],["ὄρη",86,43],["ἐσκίρτησαν",3352,129],["ὡσεὶ",342,17],["κριοὶ",332,51],["καὶ",2,8],["οἱ",1,128],["βουνοὶ",575,51],["ὡς",36,8],["ἀρνία",4562,43],["προβάτων",194,45]],"The mountains skipped like rams, and the hills like lambs."],["5",[["Τί",39,119],["σοι",5,151],["ἐστὶ",10,87],["θάλασσα",137,13],["ὅτι",19,8],["ἔφυγες",265,154],["καὶ",2,8],["σὺ",5,156],["Ἰορδάνη",301,251],["ὅτι",19,8],["ἐστράφης",1079,363],["εἰς",8,1],["τὰ",1,42],["ὀπίσω",166,17]],"What [ailed] thee, O sea, that thou fleddest? and thou Jordan, that thou wast turned back?"],["6",[["Τὰ",1,42],["ὄρη",86,43],["ὅτι",19,8],["ἐσκίρτησατε",3352,262],["ὡσεὶ",342,17],["κριοί",332,51],["καὶ",2,8],["οἱ",1,128],["βουνοὶ",575,51],["ὡς",36,8],["ἀρνία",4562,43],["προβάτων",194,45]],"[Ye] mountains, that ye skipped like rams, and [ye] hills, like lambs?"],["7",[["Ἀπὸ",17,1],["προσώπου",47,24],["Κυρίου",7,21],["ἐσαλεύθη",679,38],["ἡ",1,11],["γῆ",26,13],["ἀπὸ",17,1],["προσώπου",47,24],["τοῦ",1,30],["Θεοῦ",20,21],["Ἰακὼβ",146,105]],"The earth trembled at the presence of the Lord, at the presence of the God of Jacob;"],["8",[["τοῦ",1,30],["στρέψαντος",1079,521],["τὴν",1,9],["πέτραν",546,10],["εἰς",8,1],["λίμνας",3894,40],["ὑδάτων",85,45],["καὶ",2,8],["τὴν",1,9],["ἀκρότομον",2816,37],["εἰς",8,1],["πηγὰς",563,40],["ὑδάτων",85,45]],"who turned the rock into pools of water, and the flint into fountains of water."],["9",[["Μὴ",25,8],["ἡμῖν",6,142],["Κύριε",7,251],["μὴ",25,8],["ἡμῖν",6,142],["ἀλλʼ",107,17],["ἢ",60,8],["τῷ",1,52],["ὀνόματί",55,53],["σου",5,146],["δὸς",33,198],["δόξαν",141,10],["ἐπὶ",9,1],["τῷ",1,52],["ἐλέει",182,53],["σου",5,146],["καὶ",2,8],["τῇ",1,95],["ἀληθείᾳ",350,2],["σου",5,146]],"Not to us, O Lord, not to us, but to thy name give glory, because of thy mercy and thy truth;"],["10",[["μή",25,8],["ποτε",455,12],["εἴπωσι",18,224],["τὰ",1,42],["ἔθνη",59,43],["ποῦ",477,17],["ἐστιν",10,87],["ὁ",1,4],["Θεὸς",20,5],["αὐτῶν",3,41]],"lest at any time the nations should say, Where is their God?"],["11",[["Ὁ",1,4],["δὲ",14,12],["Θεὸς",20,5],["ἡμῶν",6,41],["ἐν",4,1],["τῷ",1,110],["οὐρανῷ",94,113],["καὶ",2,8],["ἐν",4,1],["τῇ",1,95],["γῇ",26,2],["πάντα",11,65],["ὅσα",102,43],["ἠθέλησεν",609,3],["ἐποίησε",23,3]],"But our God has done in heaven and on earth, whatsoever he has pleased."],["12",[["Τὰ",1,42],["εἴδωλα",626,43],["τῶν",1,44],["ἐθνῶν",59,45],["ἀργύριον",150,33],["καὶ",2,8],["χρυσίον",202,33],["ἔργα",104,43],["χειρῶν",37,61],["ἀνθρώπων",43,77]],"The idols of the nations are silver and gold, the works of men's hands."],["13",[["Στόμα",123,33],["ἔχουσι",124,189],["καὶ",2,8],["οὐ",12,17],["λαλήσουσιν",50,355],["ὀφθαλμοὺς",91,31],["ἔχουσι",124,357],["καὶ",2,8],["οὐκ",12,17],["ὄψονται",111,127]],"They have a mouth, but they cannot speak; they have eyes, but they cannot see:"],["14",[["Ὦτα",325,43],["ἔχουσι",124,189],["καὶ",2,8],["οὐκ",12,17],["ἀκούσονται",53,127],["ῥῖνας",3038,40],["ἔχουσι",124,189],["καὶ",2,8],["οὐκ",12,17],["ὀσφρανθήσονται",0,0]],"they have ears, but they cannot hear; they have noses, but they cannot smell;"],["15",[["Χεῖρας",37,40],["ἔχουσι",124,189],["καὶ",2,8],["οὐ",12,17],["ψηλαφήσουσι",2219,355],["πόδας",208,31],["ἔχουσι",124,357],["καὶ",2,8],["οὐ",12,17],["περιπατήσουσιν",1327,355],["οὐ",12,17],["φωνήσουσιν",1743,355],["ἐν",4,1],["τῷ",1,110],["λάρυγγι",2097,113],["αὐτῶν",3,41]],"they have hands, but they cannot handle; they have feet, but they cannot walk: they cannot speak through their throat."],["16",[["ὅμοιοι",651,130],["αὐτοῖς",3,142],["γένοιντο",30,556],["οἱ",1,128],["ποιοῦντες",23,137],["αὐτὰ",3,66],["καὶ",2,8],["πάντες",11,130],["οἱ",1,128],["πεποιθότες",343,264],["ἐπʼ",9,1],["αὐτοῖς",3,142]],"Let those that make them become like to them, and all who trust in them."],["17",[["Οἶκος",34,5],["Ἰσραὴλ",27,105],["ἔλπισεν",511,3],["ἐπὶ",9,1],["Κύριον",7,7],["βοηθὸς",948,5],["καὶ",2,8],["ὑπερασπιστὴς",1876,5],["αὐτῶν",3,41],["ἐστιν",10,87]],"The house of Israel trusts in the Lord: he is their helper and defender."],["18",[["Οἶκος",34,5],["Ἀαρὼν",159,5],["ἤλπισεν",511,3],["ἐπὶ",9,1],["Κύριον",7,7],["βοηθὸς",948,5],["καὶ",2,8],["ὑπερασπιστὴς",1876,5],["αὐτῶν",3,41],["ἐστιν",10,87]],"The house of Aaron trusts in the Lord: he is their helper and defender."],["19",[["Οἱ",1,128],["φοβούμενοι",134,356],["τὸν",1,6],["Κύριον",7,7],["ἤλπισαν",511,141],["ἐπὶ",9,1],["Κύριον",7,7],["βοηθὸς",948,5],["καὶ",2,8],["ὑπερασπιστὴς",1876,5],["αὐτῶν",3,41],["ἐστι",10,87]],"They that fear the Lord trust in the Lord: he is their helper and defender."],["20",[["Κύριος",7,5],["μνησθεὶς",231,206],["ἡμῶν",6,41],["εὐλόγησεν",147,3],["ἡμᾶς",6,60],["εὐλόγησε",147,3],["τὸν",1,6],["οἶκον",34,7],["Ἰσραὴλ",27,105],["εὐλόγησε",147,3],["τὸν",1,6],["οἶκον",34,7],["Ἀαρών",159,5]],"The Lord has remembered us, and blessed us: he has blessed the house of Israel, he has blessed the house of Aaron."],["21",[["Εὐλόγησε",147,3],["τοὺς",1,56],["φοβουμένους",134,230],["τὸν",1,6],["Κύριον",7,7],["τοὺς",1,56],["μικροὺς",365,58],["μετὰ",29,1],["τῶν",1,76],["μεγάλων",65,163]],"He has blessed them that fear the Lord, both small and great."],["22",[["Προσθείη",200,276],["Κύριος",7,5],["ἐφʼ",9,1],["ὑμᾶς",5,209],["ἐφʼ",9,1],["ὑμᾶς",5,209],["καὶ",2,8],["ἐπὶ",9,1],["τοὺς",1,56],["υἱοὺς",13,31],["ὑμῶν",5,136]],"The Lord add [blessings] to you and to your children."],["23",[["Εὐλογημένοι",147,579],["ὑμεῖς",5,208],["τῷ",1,110],["Κυρίῳ",7,113],["τῷ",1,110],["ποιήσαντι",23,359],["τὸν",1,6],["οὐρανὸν",94,7],["καὶ",2,8],["τὴν",1,9],["γῆν",26,10]],"Blessed are ye of the Lord, who made the heaven and the earth."],["24",[["Ὁ",1,4],["οὐρανὸς",94,5],["τοῦ",1,30],["οὐρανοῦ",94,21],["τῷ",1,110],["Κυρίῳ",7,113],["τὴν",1,9],["δὲ",14,12],["γῆν",26,10],["ἔδωκε",33,3],["τοῖς",1,138],["υἱοῖς",13,139],["τῶν",1,76],["ἀνθρώπων",43,77]],"The heaven of heavens [belongs] to the Lord: but he has given the earth to the sons of men."],["25",[["Οὐχ",12,17],["οἱ",1,128],["νεκροὶ",653,130],["αἰνέσουσί",399,207],["σε",5,161],["Κύριε",7,251],["οὐδὲ",105,12],["πάντες",11,130],["οἱ",1,128],["καταβαίνοντες",174,137],["εἰς",8,1],["ᾅδου",583,21]],"The dead shall not praise thee, O Lord, nor any that go down to Hades."],["26",[["Ἀλλʼ",107,17],["ἡμεῖς",6,193],["οἱ",1,128],["ζῶντες",117,137],["εὐλογήσομεν",147,269],["τὸν",1,6],["Κύριον",7,7],["ἀπὸ",17,1],["τοῦ",1,30],["νῦν",89,17],["καὶ",2,8],["ἕως",42,8],["τοῦ",1,30],["αἰῶνος",100,21]],"But we, the living, will bless the Lord, from henceforth and for ever."]]