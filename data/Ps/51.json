[["1",[["Εἰς",8,1],["τὸ",1,32],["τέλος",369,33],["συνέσεως",467,19],["τῷ",1,110],["Δαυὶδ",52,105]],"For the end, [a Psalm] of instruction by David,"],["2",[["ἐν",4,1],["τῷ",1,110],["ἐλθεῖν",56,100],["Δωὴκ",0,0],["τὸν",1,6],["Ἰδουμαῖον",1319,59],["καὶ",2,8],["ἀναγγεῖλαι",228,100],["τῷ",1,110],["Σαοὺλ",155,251],["καὶ",2,8],["εἰπεῖν",18,100],["αὐτῷ",3,49],["ἦλθε",56,3],["Δαυὶδ",52,105],["εἰς",8,1],["τὸν",1,6],["οἶκον",34,7],["Ἀβιμέλεχ",0,0]],"when Doec the Idumean came and told Saul, and said to him, David is gone to the house of Abimelech."],["3",[["Τί",39,119],["ἐγκαυχᾷ",4589,407],["ἐν",4,1],["κακίᾳ",431,2],["ὁ",1,4],["δυνατὸς",354,16],["ἀνομίαν",274,10],["ὅλην",233,37],["τὴν",1,9],["ἡμέραν",28,10]],"Why dost thou, O mighty man, boast of iniquity in [thy] mischief? All the day"],["4",[["ἀδικίαν",288,10],["ἐλογίσατο",494,253],["ἡ",1,11],["γλῶσσά",385,13],["σου",5,146],["ὡσεὶ",342,17],["ξυρὸν",4346,20],["ἠκονημένον",0,0],["ἐποίησας",23,154],["δόλον",920,7]],"thy tongue has devised unrighteousness; like a sharpened razor thou hast wrought deceit."],["5",[["Ἠγάπησας",224,154],["κακίαν",431,10],["ὑπὲρ",139,1],["ἀγαθωσύνην",2314,10],["ἀδικίαν",288,10],["ὑπὲρ",139,1],["τὸ",1,32],["λαλῆσαι",50,100],["δικαιοσύνην",185,10],["διάψαλμα",687,20]],"Thou hast loved wickedness more than goodness; unrighteousness better than to speak righteousness. Pause."],["6",[["Ἠγάπησας",224,154],["πάντα",11,65],["τὰ",1,42],["ῥήματα",115,43],["καταποντισμοῦ",7430,21],["γλῶσσαν",385,10],["δολίαν",1543,37]],"Thou hast loved all words of destruction, [and] a deceitful tongue."],["7",[["Διὰ",54,1],["τοῦτο",16,122],["ὁ",1,4],["Θεὸς",20,5],["καθέλοι",610,276],["σε",5,161],["εἰς",8,1],["τέλος",369,33],["ἐκτίλαι",3192,100],["σε",5,161],["καὶ",2,8],["μεταναστεύσαι",4930,276],["σε",5,161],["ἀπὸ",17,1],["σκηνώματος",680,24],["καὶ",2,8],["τὸ",1,32],["ῥίζωμά",6722,33],["σου",5,146],["ἐκ",21,1],["γῆς",26,19],["ζώντων",117,164],["διάψαλμα",687,20]],"Therefore may God destroy thee for ever, may he pluck thee up and utterly remove thee from [thy] dwelling, and thy root from the land of the living. Pause."],["8",[["Καὶ",2,8],["ὄψονται",111,127],["δίκαιοι",152,130],["καὶ",2,8],["φοβηθήσονται",134,135],["καὶ",2,8],["ἐπʼ",9,1],["αὐτὸν",3,82],["γελάσονται",2077,127],["καὶ",2,8],["ἐροῦσιν",191,189]],"And the righteous shall see, and fear, and shall laugh at him, and say,"],["9",[["ἰδοὺ",51,17],["ἄνθρωπος",43,5],["ὃς",24,247],["οὐκ",12,17],["ἔθετο",109,26],["τὸν",1,6],["Θεὸν",20,7],["βοηθὸν",948,7],["αὐτοῦ",3,48],["ἀλλʼ",107,17],["ἐπήλπισεν",3201,3],["ἐπὶ",9,1],["τὸ",1,32],["πλῆθος",199,33],["τοῦ",1,30],["πλούτου",572,21],["αὐτοῦ",3,48],["καὶ",2,8],["ἐνεδυναμώθη",9468,38],["ἐπὶ",9,1],["τῇ",1,95],["ματαιότητι",937,2],["αὐτοῦ",3,48]],"Behold the man who made not God his help; but trusted in the abundance of his wealth, and strengthened himself in his vanity."],["10",[["Ἐγὼ",6,158],["δὲ",14,12],["ὡσεὶ",342,17],["ἐλαία",1655,13],["κατάκαρπος",4869,15],["ἐν",4,1],["τῷ",1,110],["οἴκῳ",34,113],["τοῦ",1,30],["Θεοῦ",20,21],["ἤλπισα",511,147],["ἐπὶ",9,1],["τὸ",1,32],["ἔλεος",182,33],["τοῦ",1,30],["Θεοῦ",20,21],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["καὶ",2,8],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["τοῦ",1,30],["αἰῶνος",100,21]],"But I am as a fruitful olive in the house of God: I have trusted in the mercy of God for ever, even for evermore."],["11",[["Ἐξομολογήσομαί",478,176],["σοι",5,151],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["ὅτι",19,8],["ἐποίησας",23,154],["καὶ",2,8],["ὑπομενῶ",635,157],["τὸ",1,32],["ὄνομά",55,33],["σου",5,146],["ὅτι",19,8],["χρηστὸν",1357,28],["ἐναντίον",138,17],["τῶν",1,76],["ὁσίων",918,163],["σου",5,146]],"I will give thanks to thee for ever, for thou hast done [it]: and I will wait on thy name; for [it is] good before thy saints."]]