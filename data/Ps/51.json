[["1",[["Εἰς",8,1],["τὸ",1,32],["τέλος",373,33],["συνέσεως",469,19],["τῷ",1,110],["Δαυὶδ",52,105]],"For the end, [a Psalm] of instruction by David,"],["2",[["ἐν",4,1],["τῷ",1,110],["ἐλθεῖν",55,100],["Δωὴκ",0,0],["τὸν",1,6],["Ἰδουμαῖον",1319,59],["καὶ",2,8],["ἀναγγεῖλαι",231,100],["τῷ",1,110],["Σαοὺλ",155,250],["καὶ",2,8],["εἰπεῖν",18,100],["αὐτῷ",3,49],["ἦλθε",55,3],["Δαυὶδ",52,105],["εἰς",8,1],["τὸν",1,6],["οἶκον",34,7],["Ἀβιμέλεχ",0,0]],"when Doec the Idumean came and told Saul, and said to him, David is gone to the house of Abimelech."],["3",[["Τί",39,119],["ἐγκαυχᾷ",4565,401],["ἐν",4,1],["κακίᾳ",433,2],["ὁ",1,4],["δυνατὸς",356,16],["ἀνομίαν",275,10],["ὅλην",235,37],["τὴν",1,9],["ἡμέραν",28,10]],"Why dost thou, O mighty man, boast of iniquity in [thy] mischief? All the day"],["4",[["ἀδικίαν",288,10],["ἐλογίσατο",495,252],["ἡ",1,11],["γλῶσσά",388,13],["σου",5,146],["ὡσεὶ",343,17],["ξυρὸν",4331,20],["ἠκονημένον",3684,326],["ἐποίησας",23,154],["δόλον",919,7]],"thy tongue has devised unrighteousness; like a sharpened razor thou hast wrought deceit."],["5",[["Ἠγάπησας",214,154],["κακίαν",433,10],["ὑπὲρ",139,1],["ἀγαθωσύνην",2300,10],["ἀδικίαν",288,10],["ὑπὲρ",139,1],["τὸ",1,32],["λαλῆσαι",50,100],["δικαιοσύνην",187,10],["διάψαλμα",689,20]],"Thou hast loved wickedness more than goodness; unrighteousness better than to speak righteousness. Pause."],["6",[["Ἠγάπησας",214,154],["πάντα",11,65],["τὰ",1,42],["ῥήματα",116,43],["καταποντισμοῦ",7377,21],["γλῶσσαν",388,10],["δολίαν",1545,37]],"Thou hast loved all words of destruction, [and] a deceitful tongue."],["7",[["Διὰ",56,1],["τοῦτο",16,122],["ὁ",1,4],["Θεὸς",20,5],["καθέλοι",602,216],["σε",5,161],["εἰς",8,1],["τέλος",373,33],["ἐκτίλαι",3186,216],["σε",5,161],["καὶ",2,8],["μεταναστεύσαι",4906,216],["σε",5,161],["ἀπὸ",17,1],["σκηνώματος",682,24],["καὶ",2,8],["τὸ",1,32],["ῥίζωμά",6679,33],["σου",5,146],["ἐκ",21,1],["γῆς",26,19],["ζώντων",107,164],["διάψαλμα",689,20]],"Therefore may God destroy thee for ever, may he pluck thee up and utterly remove thee from [thy] dwelling, and thy root from the land of the living. Pause."],["8",[["Καὶ",2,8],["ὄψονται",112,127],["δίκαιοι",153,130],["καὶ",2,8],["φοβηθήσονται",134,135],["καὶ",2,8],["ἐπʼ",9,1],["αὐτὸν",3,82],["γελάσονται",2071,127],["καὶ",2,8],["ἐροῦσιν",165,207]],"And the righteous shall see, and fear, and shall laugh at him, and say,"],["9",[["ἰδοὺ",51,17],["ἄνθρωπος",43,5],["ὃς",24,246],["οὐκ",12,17],["ἔθετο",110,26],["τὸν",1,6],["Θεὸν",20,7],["βοηθὸν",947,7],["αὐτοῦ",3,48],["ἀλλʼ",108,17],["ἐπήλπισεν",3195,3],["ἐπὶ",9,1],["τὸ",1,32],["πλῆθος",200,33],["τοῦ",1,30],["πλούτου",574,21],["αὐτοῦ",3,48],["καὶ",2,8],["ἐνεδυναμώθη",9400,38],["ἐπὶ",9,1],["τῇ",1,95],["ματαιότητι",937,2],["αὐτοῦ",3,48]],"Behold the man who made not God his help; but trusted in the abundance of his wealth, and strengthened himself in his vanity."],["10",[["Ἐγὼ",6,158],["δὲ",14,12],["ὡσεὶ",343,17],["ἐλαία",1655,13],["κατάκαρπος",4843,15],["ἐν",4,1],["τῷ",1,110],["οἴκῳ",34,113],["τοῦ",1,30],["Θεοῦ",20,21],["ἤλπισα",514,147],["ἐπὶ",9,1],["τὸ",1,32],["ἔλεος",183,33],["τοῦ",1,30],["Θεοῦ",20,21],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["καὶ",2,8],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["τοῦ",1,30],["αἰῶνος",100,21]],"But I am as a fruitful olive in the house of God: I have trusted in the mercy of God for ever, even for evermore."],["11",[["Ἐξομολογήσομαί",479,177],["σοι",5,151],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["ὅτι",19,8],["ἐποίησας",23,154],["καὶ",2,8],["ὑπομενῶ",639,157],["τὸ",1,32],["ὄνομά",57,33],["σου",5,146],["ὅτι",19,8],["χρηστὸν",1359,28],["ἐναντίον",138,17],["τῶν",1,76],["ὁσίων",917,163],["σου",5,146]],"I will give thanks to thee for ever, for thou hast done [it]: and I will wait on thy name; for [it is] good before thy saints."]]