[["1",[["Εἰς",8,1],["τὸ",1,32],["τέλος",373,33],["ἐν",4,1],["ὕμνοις",1498,139],["ὑπὲρ",139,1],["τῆς",1,18],["ὀγδόης",1027,78],["ψαλμὸς",644,5],["τῷ",1,110],["Δαυίδ",52,105]],"For the end, a Psalm of David among the Hymns for the eighth."],["2",[["Κύριε",7,250],["μὴ",25,8],["τῷ",1,110],["θυμῷ",178,113],["σου",5,146],["ἐλέγξῃς",752,170],["με",6,82],["μηδὲ",414,12],["τῇ",1,95],["ὀργῇ",198,2],["σου",5,146],["παιδεύσῃς",643,170],["με",6,82]],"O Lord, rebuke me not in thy wrath, neither chasten me in thine anger."],["3",[["Ἐλέησόν",446,198],["με",6,82],["Κύριε",7,250],["ὅτι",19,8],["ἀσθενής",1854,15],["εἰμι",10,149],["ἴασαί",797,379],["με",6,82],["Κύριε",7,250],["ὅτι",19,8],["ἐταράχθη",508,38],["τὰ",1,42],["ὀστᾶ",473,43],["μου",6,48]],"Pity me, O Lord; for I am weak: heal me, O Lord; for my bones are vexed."],["4",[["Καὶ",2,8],["ἡ",1,11],["ψυχή",63,13],["μου",6,48],["ἐταράχθη",508,38],["σφόδρα",150,17],["καὶ",2,8],["σὺ",5,156],["Κύριε",7,250],["ἕως",42,8],["πότε",458,12]],"My soul also is grievously vexed: but thou, O Lord, how long?"],["5",[["Ἐπίστρεψον",117,198],["Κύριε",7,250],["ῥῦσαι",337,275],["τὴν",1,9],["ψυχήν",63,10],["μου",6,48],["σῶσόν",172,198],["με",6,82],["ἕνεκεν",447,1],["τοῦ",1,23],["ἐλέους",183,24],["σου",5,146]],"Return, O Lord, deliver my soul: save me for thy mercy's sake."],["6",[["ὅτι",19,8],["οὐκ",12,17],["ἔστιν",10,87],["ἐν",4,1],["τῷ",1,110],["θανάτῳ",170,113],["ὁ",1,4],["μνημονεύων",1900,67],["σου",5,146],["ἐν",4,1],["δὲ",14,12],["τῷ",1,110],["ᾅδῃ",586,113],["τίς",39,150],["ἐξομολογήσεταί",479,89],["σοι",5,151]],"For in death no man remembers thee: and who will give thee thanks in Hades?"],["7",[["Ἐκοπίασα",921,147],["ἐν",4,1],["στεναγμῷ",1598,113],["μου",6,48],["λούσω",1042,157],["καθʼ",32,1],["ἑκάστην",171,37],["νύκτα",219,10],["τὴν",1,9],["κλίνην",1221,10],["μου",6,48],["ἐν",4,1],["δάκρυσί",1268,90],["μου",6,48],["τὴν",1,9],["στρωμνήν",2629,10],["μου",6,48],["βρέξω",2163,157]],"I am wearied with my groaning; I shall wash my bed every night; I shall water my couch with my tears."],["8",[["Ἐταράχθη",508,38],["ἀπὸ",17,1],["θυμοῦ",178,21],["ὁ",1,4],["ὀφθαλμός",91,5],["μου",6,48],["ἐπαλαιώθην",1384,148],["ἐν",4,1],["πᾶσι",11,215],["τοῖς",1,138],["ἐχθροῖς",135,139],["μου",6,48]],"Mine eye is troubled because of my wrath; I am worn out because of all my enemies."],["9",[["Ἀπόστητε",293,69],["ἀπʼ",17,1],["ἐμοῦ",6,48],["πάντες",11,130],["οἱ",1,128],["ἐργαζόμενοι",467,351],["τὴν",1,9],["ἀνομίαν",275,10],["ὅτι",19,8],["εἰσήκουσε",241,3],["Κύριος",7,5],["τῆς",1,18],["φωνῆς",95,19],["τοῦ",1,30],["κλαυθμοῦ",1203,21],["μου",6,48]],"Depart from me, all ye that work iniquity; for the Lord has heard the voice of my weeping."],["10",[["Εἰσήκουσε",241,3],["Κύριος",7,5],["τῆς",1,18],["δεήσεώς",677,19],["μου",6,83],["Κύριος",7,5],["τὴν",1,9],["προσευχήν",550,10],["μου",6,48],["προσεδέξατο",1019,26]],"The Lord has hearkened to my petition; the Lord has accepted my prayer."],["11",[["Αἰσχυνθείησαν",611,403],["καὶ",2,8],["ταραχθείησαν",508,403],["σφόδρα",150,17],["πάντες",11,130],["οἱ",1,128],["ἐχθροί",135,51],["μου",6,48],["ἐπιστραφείησαν",117,403],["καὶ",2,8],["αἰσχυνθείησαν",611,403],["σφόδρα",150,17],["διὰ",56,1],["τάχους",1565,24]],"Let all mine enemies be put to shame and sore troubled: let them be turned back and grievously put to shame speedily."]]