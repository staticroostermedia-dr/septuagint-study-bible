[["1",[["Εἰς",8,1],["τὸ",1,32],["τέλος",369,33],["ἐν",4,1],["ὕμνοις",1499,139],["ὑπὲρ",139,1],["τῆς",1,18],["ὀγδόης",1023,78],["ψαλμὸς",639,5],["τῷ",1,110],["Δαυίδ",52,105]],"For the end, a Psalm of David among the Hymns for the eighth."],["2",[["Κύριε",7,251],["μὴ",25,8],["τῷ",1,110],["θυμῷ",177,113],["σου",5,146],["ἐλέγξῃς",750,170],["με",6,82],["μηδὲ",412,12],["τῇ",1,95],["ὀργῇ",198,2],["σου",5,146],["παιδεύσῃς",654,170],["με",6,82]],"O Lord, rebuke me not in thy wrath, neither chasten me in thine anger."],["3",[["Ἐλέησόν",457,243],["με",6,82],["Κύριε",7,251],["ὅτι",19,8],["ἀσθενής",1853,15],["εἰμι",10,149],["ἴασαί",794,166],["με",6,82],["Κύριε",7,251],["ὅτι",19,8],["ἐταράχθη",508,38],["τὰ",1,42],["ὀστᾶ",472,43],["μου",6,48]],"Pity me, O Lord; for I am weak: heal me, O Lord; for my bones are vexed."],["4",[["Καὶ",2,8],["ἡ",1,11],["ψυχή",62,13],["μου",6,48],["ἐταράχθη",508,38],["σφόδρα",149,17],["καὶ",2,8],["σὺ",5,156],["Κύριε",7,251],["ἕως",42,8],["πότε",455,12]],"My soul also is grievously vexed: but thou, O Lord, how long?"],["5",[["Ἐπίστρεψον",116,198],["Κύριε",7,251],["ῥῦσαι",335,275],["τὴν",1,9],["ψυχήν",62,10],["μου",6,48],["σῶσόν",171,198],["με",6,82],["ἕνεκεν",445,1],["τοῦ",1,23],["ἐλέους",182,24],["σου",5,146]],"Return, O Lord, deliver my soul: save me for thy mercy's sake."],["6",[["ὅτι",19,8],["οὐκ",12,17],["ἔστιν",10,87],["ἐν",4,1],["τῷ",1,110],["θανάτῳ",169,113],["ὁ",1,4],["μνημονεύων",1901,67],["σου",5,146],["ἐν",4,1],["δὲ",14,12],["τῷ",1,110],["ᾅδῃ",583,113],["τίς",39,150],["ἐξομολογήσεταί",478,89],["σοι",5,151]],"For in death no man remembers thee: and who will give thee thanks in Hades?"],["7",[["Ἐκοπίασα",0,0],["ἐν",4,1],["στεναγμῷ",1599,113],["μου",6,48],["λούσω",1039,157],["καθʼ",32,1],["ἑκάστην",170,37],["νύκτα",216,10],["τὴν",1,9],["κλίνην",1184,10],["μου",6,48],["ἐν",4,1],["δάκρυσί",1268,90],["μου",6,48],["τὴν",1,9],["στρωμνήν",2634,10],["μου",6,48],["βρέξω",2172,157]],"I am wearied with my groaning; I shall wash my bed every night; I shall water my couch with my tears."],["8",[["Ἐταράχθη",508,38],["ἀπὸ",17,1],["θυμοῦ",177,21],["ὁ",1,4],["ὀφθαλμός",91,5],["μου",6,48],["ἐπαλαιώθην",1520,148],["ἐν",4,1],["πᾶσι",11,215],["τοῖς",1,138],["ἐχθροῖς",135,139],["μου",6,48]],"Mine eye is troubled because of my wrath; I am worn out because of all my enemies."],["9",[["Ἀπόστητε",514,69],["ἀπʼ",17,1],["ἐμοῦ",6,48],["πάντες",11,130],["οἱ",1,128],["ἐργαζόμενοι",468,356],["τὴν",1,9],["ἀνομίαν",274,10],["ὅτι",19,8],["εἰσήκουσε",237,3],["Κύριος",7,5],["τῆς",1,18],["φωνῆς",95,19],["τοῦ",1,30],["κλαυθμοῦ",1207,21],["μου",6,48]],"Depart from me, all ye that work iniquity; for the Lord has heard the voice of my weeping."],["10",[["Εἰσήκουσε",237,3],["Κύριος",7,5],["τῆς",1,18],["δεήσεώς",674,19],["μου",6,83],["Κύριος",7,5],["τὴν",1,9],["προσευχήν",549,10],["μου",6,48],["προσεδέξατο",1018,26]],"The Lord has hearkened to my petition; the Lord has accepted my prayer."],["11",[["Αἰσχυνθείησαν",614,410],["καὶ",2,8],["ταραχθείησαν",508,410],["σφόδρα",149,17],["πάντες",11,130],["οἱ",1,128],["ἐχθροί",135,51],["μου",6,48],["ἐπιστραφείησαν",116,410],["καὶ",2,8],["αἰσχυνθείησαν",614,410],["σφόδρα",149,17],["διὰ",54,1],["τάχους",1566,24]],"Let all mine enemies be put to shame and sore troubled: let them be turned back and grievously put to shame speedily."]]