[["1",[["Ἀλληλούϊα",1746,105],["Ἠγαπήσα",224,147],["ὅτι",19,8],["εἰσακούσεται",237,89],["Κύριος",7,5],["τῆς",1,18],["φωνῆς",95,19],["τῆς",1,18],["δεήσεώς",674,19],["μου",6,83]],"Alleluia. I am well pleased, because the Lord will hearken to the voice of my supplication."],["2",[["Ὅτι",19,8],["ἔκλινε",829,3],["τὸ",1,32],["οὖς",325,33],["αὐτοῦ",3,48],["ἐμοὶ",6,49],["καὶ",2,8],["ἐν",4,1],["ταῖς",1,70],["ἡμέραις",28,71],["μου",6,48],["ἐπικαλέσομαι",340,176]],"Because he has inclined his ear to me, therefore will I call upon him while I live."],["3",[["Περιέσχον",1349,141],["με",6,82],["ὠδῖνες",2013,179],["θανάτου",169,21],["κίνδυνοι",2371,51],["ᾅδου",583,21],["εὕροσάν",0,0],["με",6,98],["θλίψιν",437,10],["καὶ",2,8],["ὀδύνην",771,10],["εὗρον",106,141]],"The pangs of death compassed me; the dangers of hell found me: I found affliction and sorrow."],["4",[["καὶ",2,8],["τὸ",1,32],["ὄνομα",55,33],["Κυρίου",7,21],["ἐπεκαλεσάμην",340,152],["ὦ",641,320],["Κύριε",7,251],["ῥῦσαι",335,275],["τὴν",1,9],["ψυχήν",62,10],["μου",6,48]],"Then I called on the name of the Lord: O Lord, deliver my soul."],["5",[["Ἐλεήμων",1491,16],["ὁ",1,4],["Κύριος",7,5],["καὶ",2,8],["δίκαιος",152,16],["καὶ",2,8],["ὁ",1,4],["Θεὸς",20,5],["ἡμῶν",6,41],["ἐλεεῖ",457,87]],"The Lord is merciful and righteous; yea, our God has pity."],["6",[["Φυλάσσων",127,67],["τὰ",1,42],["νήπια",1015,65],["ὁ",1,4],["Κύριος",7,5],["ἐταπεινώθην",333,148],["καὶ",2,8],["ἔσωσέ",171,3],["με",6,82]],"The Lord preserves the simple: I was brought low, and he delivered me."],["7",[["Ἐπίστρεψον",116,198],["ψυχή",62,13],["μου",6,48],["εἰς",8,1],["τὴν",1,9],["ἀνάπαυσίν",1046,10],["σου",5,146],["ὅτι",19,8],["Κύριος",7,5],["εὐηργέτησέ",0,0],["σε",5,161]],"Return to thy rest, O my soul; for the Lord has dealt bountifully with thee."],["8",[["Ὅτι",19,8],["ἐξείλετο",411,26],["τὴν",1,9],["ψυχήν",62,10],["μου",6,48],["ἐκ",21,1],["θανάτου",169,21],["τοὺς",1,56],["ὀφθαλμούς",91,31],["μου",6,48],["ἀπὸ",17,1],["δακρύων",1268,45],["καὶ",2,8],["τοὺς",1,56],["πόδας",208,31],["μου",6,48],["ἀπὸ",17,1],["ὀλισθήματος",3033,24]],"For he has delivered my soul from death, mine eyes from tears, and my feet from falling."],["9",[["Εὐαρεστήσω",4236,157],["ἐνώπιον",114,1],["Κυρίου",7,21],["ἐν",4,1],["χώρᾳ",278,2],["ζώντων",117,164]],"I shall be well-pleasing before the Lord in the land of the living."]]