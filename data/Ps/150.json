[["1",[["Ἁλληλούϊα",1746,105],["Αἰνεῖτε",399,311],["τὸν",1,6],["Θεὸν",20,7],["ἐν",4,1],["τοῖς",1,138],["ἁγίοις",75,215],["αὐτοῦ",3,48],["αἰνεῖτε",399,311],["αὐτὸν",3,82],["ἐν",4,1],["στερεώματι",1482,53],["δυνάμεως",98,19],["αὐτοῦ",3,48]],"Alleluia. Praise God in his holy places: praise him in the firmament of his power."],["2",[["Αἰνεῖτε",399,311],["αὐτὸν",3,82],["ἐπὶ",9,1],["ταῖς",1,70],["δυναστείαις",919,71],["αὐτοῦ",3,48],["αἰνεῖτε",399,311],["αὐτὸν",3,82],["κατὰ",32,1],["τὸ",1,32],["πλῆθος",199,33],["τῆς",1,18],["μεγαλωσύνης",1474,19],["αὐτοῦ",3,48]],"Praise him on [account of] his mighty acts: praise him according to his abundant greatness."],["3",[["Αἰνεῖτε",399,311],["αὐτὸν",3,82],["ἐν",4,1],["ἤχῳ",1805,113],["σάλπιγγος",578,19],["αἰνεῖτε",399,311],["αὐτὸν",3,82],["ἐν",4,1],["ψαλτηρίῳ",1698,53],["καὶ",2,8],["κιθάρᾳ",1513,2]],"Praise him with the sound of a trumpet: praise him with psaltery and harp."],["4",[["Αἰνεῖτε",399,311],["αὐτὸν",3,82],["ἐν",4,1],["τυμπάνῳ",1790,53],["καὶ",2,8],["χορῷ",1846,113],["αἰνεῖτε",399,311],["αὐτὸν",3,82],["ἐν",4,1],["χορδαῖς",6237,71],["καὶ",2,8],["ὀργάνῳ",1579,53]],"Praise him with timbrel and dance: praise him with stringed instruments and the organ."],["5",[["Αἰνεῖτε",399,311],["αὐτὸν",3,82],["ἐν",4,1],["κυμβάλοις",1825,92],["εὐήχοις",5662,90],["αἰνεῖτε",399,311],["αὐτὸν",3,82],["ἐν",4,1],["κυμβάλοις",1825,92],["ἀλαλαγμοῦ",2991,21]],"Praise him with melodious cymbals: praise him with loud cymbals."],["6",[["Πᾶσα",11,15],["πνοὴ",1637,13],["αἰνεσάτω",399,46],["τὸν",1,6],["Κύριον",7,7]],"Let every thing that has breath praise the Lord."]]