[["1",[["Ἁλληλούϊα",1749,105],["Αἰνεῖτε",402,307],["τὸν",1,6],["Θεὸν",20,7],["ἐν",4,1],["τοῖς",1,138],["ἁγίοις",75,215],["αὐτοῦ",3,48],["αἰνεῖτε",402,307],["αὐτὸν",3,82],["ἐν",4,1],["στερεώματι",1479,53],["δυνάμεως",98,19],["αὐτοῦ",3,48]],"Alleluia. Praise God in his holy places: praise him in the firmament of his power."],["2",[["Αἰνεῖτε",402,307],["αὐτὸν",3,82],["ἐπὶ",9,1],["ταῖς",1,70],["δυναστείαις",918,71],["αὐτοῦ",3,48],["αἰνεῖτε",402,307],["αὐτὸν",3,82],["κατὰ",32,1],["τὸ",1,32],["πλῆθος",200,33],["τῆς",1,18],["μεγαλωσύνης",1473,19],["αὐτοῦ",3,48]],"Praise him on [account of] his mighty acts: praise him according to his abundant greatness."],["3",[["Αἰνεῖτε",402,307],["αὐτὸν",3,82],["ἐν",4,1],["ἤχῳ",1803,113],["σάλπιγγος",580,19],["αἰνεῖτε",402,307],["αὐτὸν",3,82],["ἐν",4,1],["ψαλτηρίῳ",1693,53],["καὶ",2,8],["κιθάρᾳ",1513,2]],"Praise him with the sound of a trumpet: praise him with psaltery and harp."],["4",[["Αἰνεῖτε",402,307],["αὐτὸν",3,82],["ἐν",4,1],["τυμπάνῳ",1790,53],["καὶ",2,8],["χορῷ",1844,113],["αἰνεῖτε",402,307],["αὐτὸν",3,82],["ἐν",4,1],["χορδαῖς",6207,71],["καὶ",2,8],["ὀργάνῳ",1578,53]],"Praise him with timbrel and dance: praise him with stringed instruments and the organ."],["5",[["Αἰνεῖτε",402,307],["αὐτὸν",3,82],["ἐν",4,1],["κυμβάλοις",1823,92],["εὐήχοις",5632,90],["αἰνεῖτε",402,307],["αὐτὸν",3,82],["ἐν",4,1],["κυμβάλοις",1823,92],["ἀλαλαγμοῦ",2978,21]],"Praise him with melodious cymbals: praise him with loud cymbals."],["6",[["Πᾶσα",11,15],["πνοὴ",1637,13],["αἰνεσάτω",402,46],["τὸν",1,6],["Κύριον",7,7]],"Let every thing that has breath praise the Lord."]]