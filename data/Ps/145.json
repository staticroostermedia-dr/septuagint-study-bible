[["1",[["Ἀλληλούϊα",1749,105],["Ἀγγαίου",1988,153],["καὶ",2,8],["Ζαχαρίου",893,21],["Αἰνεῖ",402,87],["ἡ",1,11],["ψυχή",63,13],["μου",6,48],["τὸν",1,6],["Κύριον",7,7]],"Alleluia, [a Psalm] of Aggæus and Zacharias. My soul, praise the Lord."],["2",[["Αἰνέσω",402,157],["Κύριον",7,7],["ἐν",4,1],["ζωῇ",216,2],["μοῦ",6,48],["ψαλῶ",913,157],["τῷ",1,110],["Θεῷ",20,113],["μου",6,48],["ἕως",42,8],["ὑπάρχω",418,149]],"While I live will I praise the Lord: I will sing praises to my God as long as I exist."],["3",[["Μὴ",25,8],["πεποίθατε",344,330],["ἐπʼ",9,1],["ἄρχοντας",96,31],["καὶ",2,8],["ἐφʼ",9,1],["υἱοὺς",13,31],["ἀνθρώπων",43,77],["οἷς",24,292],["οὐκ",12,17],["ἔστι",10,87],["σωτηρία",425,13]],"Trust not in princes, nor in the children of men, in whom there is no safety."],["4",[["Ἐξελεύσεται",82,89],["τὸ",1,32],["πνεῦμα",168,33],["αὐτοῦ",3,48],["καὶ",2,8],["ἐπιστρέψει",117,120],["εἰς",8,1],["τὴν",1,9],["γῆν",26,10],["αὐτοῦ",3,48],["ἐν",4,1],["ἐκείνῃ",80,99],["τῇ",1,95],["ἡμέρᾳ",28,2],["ἀπολοῦνται",217,127],["πάντες",11,130],["οἱ",1,128],["διαλογισμοὶ",1584,51],["αὐτῶν",3,41]],"His breath shall go forth, and he shall return to his earth; in that day all his thoughts shall perish."],["5",[["Μακάριος",806,16],["οὗ",120,17],["ὁ",1,4],["Θεὸς",20,5],["Ἰακὼβ",146,105],["βοηθός",947,5],["αὐτοῦ",3,48],["ἡ",1,11],["ἐλπὶς",530,13],["αὐτοῦ",3,48],["ἐπὶ",9,1],["Κύριον",7,7],["τὸν",1,6],["Θεὸν",20,7],["αὐτοῦ",3,48]],"Blessed is he whose helper is the God of Jacob, whose hope is in the Lord his God:"],["6",[["Τὸν",1,6],["ποιήσαντα",23,476],["τὸν",1,6],["οὐρανὸν",94,7],["καὶ",2,8],["τὴν",1,9],["γῆν",26,10],["τὴν",1,9],["θάλασσαν",137,10],["καὶ",2,8],["πάντα",11,65],["τὰ",1,42],["ἐν",4,1],["αὐτοῖς",3,142],["τὸν",1,6],["φυλάσσοντα",125,178],["ἀλήθειαν",352,10],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7]],"who made heaven, and earth, the sea, and all things in them: who keeps truth for ever:"],["7",[["ποιοῦντα",23,178],["κρίμα",267,33],["τοῖς",1,138],["ἀδικουμένοις",760,342],["διδόντα",33,178],["