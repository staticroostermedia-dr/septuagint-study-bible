[["1",[["Ἀλληλούϊα",1746,105],["Ἀγγαίου",1994,153],["καὶ",2,8],["Ζαχαρίου",894,21],["Αἰνεῖ",399,87],["ἡ",1,11],["ψυχή",62,13],["μου",6,48],["τὸν",1,6],["Κύριον",7,7]],"Alleluia, [a Psalm] of Aggæus and Zacharias. My soul, praise the Lord."],["2",[["Αἰνέσω",399,157],["Κύριον",7,7],["ἐν",4,1],["ζωῇ",212,2],["μοῦ",6,48],["ψαλῶ",901,157],["τῷ",1,110],["Θεῷ",20,113],["μου",6,48],["ἕως",42,8],["ὑπάρχω",416,149]],"While I live will I praise the Lord: I will sing praises to my God as long as I exist."],["3",[["Μὴ",25,8],["πεποίθατε",343,334],["ἐπʼ",9,1],["ἄρχοντας",96,31],["καὶ",2,8],["ἐφʼ",9,1],["υἱοὺς",13,31],["ἀνθρώπων",43,77],["οἷς",24,295],["οὐκ",12,17],["ἔστι",10,87],["σωτηρία",422,13]],"Trust not in princes, nor in the children of men, in whom there is no safety."],["4",[["Ἐξελεύσεται",84,89],["τὸ",1,32],["πνεῦμα",167,33],["αὐτοῦ",3,48],["καὶ",2,8],["ἐπιστρέψει",116,120],["εἰς",8,1],["τὴν",1,9],["γῆν",26,10],["αὐτοῦ",3,48],["ἐν",4,1],["ἐκείνῃ",79,99],["τῇ",1,95],["ἡμέρᾳ",28,2],["ἀπολοῦνται",213,127],["πάντες",11,130],["οἱ",1,128],["διαλογισμοὶ",1585,51],["αὐτῶν",3,41]],"His breath shall go forth, and he shall return to his earth; in that day all his thoughts shall perish."],["5",[["Μακάριος",803,16],["οὗ",120,17],["ὁ",1,4],["Θεὸς",20,5],["Ἰακὼβ",146,105],["βοηθός",948,5],["αὐτοῦ",3,48],["ἡ",1,11],["ἐλπὶς",527,13],["αὐτοῦ",3,48],["ἐπὶ",9,1],["Κύριον",7,7],["τὸν",1,6],["Θεὸν",20,7],["αὐτοῦ",3,48]],"Blessed is he whose helper is the God of Jacob, whose hope is in the Lord his God:"],["6",[["Τὸν",1,6],["ποιήσαντα",23,485],["τὸν",1,6],["οὐρανὸν",94,7],["καὶ",2,8],["τὴν",1,9],["γῆν",26,10],["τὴν",1,9],["θάλασσαν",137,10],["καὶ",2,8],["πάντα",11,65],["τὰ",1,42],["ἐν",4,1],["αὐτοῖς",3,142],["τὸν",1,6],["φυλάσσοντα",127,177],["ἀλήθειαν",350,10],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7]],"who made heaven, and earth, the sea, and all things in them: who keeps truth for ever:"],["7",[["ποιοῦντα",23,177],["κρίμα",266,33],["τοῖς",1,138],["ἀδικουμένοις",819,346],["διδόντα",33,177],["