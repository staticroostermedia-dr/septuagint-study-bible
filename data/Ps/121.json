[["1",[["Ὠδὴ",776,105],["τῶν",1,76],["ἀναβαθμῶν",1484,77],["Εὐφράνθην",244,148],["ἐπὶ",9,1],["τοῖς",1,138],["εἰρηκόσι",165,552],["μοι",6,49],["εἰς",8,1],["οἶκον",34,7],["Κυρίου",7,21],["πορευσόμεθα",49,132]],"A Song of Degrees. I was glad when they said to me, Let us go into the house of the Lord."],["2",[["Ἑστῶτες",78,263],["ἦσαν",10,129],["οἱ",1,128],["πόδες",210,51],["ἡμῶν",6,41],["ἐν",4,1],["ταῖς",1,70],["αὐλαῖς",327,71],["σου",5,146],["Ἱερουσαλήμ",70,20]],"Our feet stood in thy courts, O Jerusalem."],["3",[["Ἱερουσαλὴμ",70,20],["οἰκοδομουμένη",126,204],["ὡς",36,8],["πόλις",41,13],["ἧς",24,162],["ἡ",1,11],["μετοχὴ",7684,13],["αὐτῆς",3,83],["ἐπιτοαυτό",1404,105]],"Jerusalem is built as a city whose fellowship is complete."],["4",[["Ἐκεῖ",76,17],["γὰρ",40,12],["ἀνέβησαν",88,141],["αἱ",1,185],["φυλαὶ",142,180],["φυλαὶ",142,180],["Κυρίου",7,21],["μαρτύριον",225,33],["τῷ",1,110],["Ἰσραὴλ",27,105],["τοῦ",1,30],["ἐξομολογήσασθαι",479,103],["τῷ",1,52],["ὀνόματι",57,53],["Κυρίου",7,21]],"For thither the tribes went up, the tribes of the Lord, as a testimony for Israel, to give thanks unto the name of the Lord."],["5",[["Ὅτι",19,8],["ἐκεῖ",76,17],["ἐκάθισαν",274,141],["θρόνοι",383,51],["εἰς",8,1],["κρίσιν",229,10],["θρόνοι",383,51],["ἐπὶ",9,1],["οἶκον",34,7],["Δαυίδ",52,105]],"For there are set thrones for judgment, [even] thrones for the house of David."],["6",[["Ἐρωτήσατε",822,69],["δὴ",193,12],["τὰ",1,42],["εἰς",8,1],["εἰρήνην",213,10],["τὴν",1,9],["Ἱερουσαλὴμ",70,20],["καὶ",2,8],["εὐθηνία",2452,13],["τοῖς",1,138],["ἀγαπῶσί",214,352],["σε",5,161]],"Pray now for the peace of Jerusalem: and [let there be] prosperity to them that love thee."],["7",[["Γενέσθω",30,312],["δὴ",193,12],["εἰρήνη",213,13],["ἐν",4,1],["τῇ",1,95],["δυνάμει",98,2],["σου",5,146],["καὶ",2,8],["εὐθηνία",2452,13],["ἐν",4,1],["ταῖς",1,70],["πυργοβάρεσί",8175,71],["σου",5,146]],"Let peace, I pray, be within thine host, and prosperity in thy palaces."],["8",[["Ἕνεκα",447,1],["τῶν",1,76],["ἀδελφῶν",67,77],["μου",6,48],["καὶ",2,8],["τῶν",1,76],["πλησίον",292,17],["μου",6,48],["ἐλάλουν",50,129],["δὴ",193,12],["εἰρήνην",213,10],["περὶ",72,1],["σοῦ",5,146]],"For the sake of my brethren and my neighbours, I have indeed spoken peace concerning thee."],["9",[["Ἕνεκα",447,1],["τοῦ",1,30],["οἴκου",34,21],["Κυρίου",7,21],["τοῦ",1,30],["Θεοῦ",20,21],["ἡμῶν",6,41],["ἐξεζήτησα",460,147],["ἀγαθά",114,65],["σοι",5,151]],"Because of the house of the Lord our God, I have diligently sought thy good."]]