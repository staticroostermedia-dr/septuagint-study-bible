[["1",[["Εἰς",8,1],["τὸ",1,32],["τέλος",369,33],["τοῖς",1,138],["ἀλλοιωθησομένοις",1289,641],["ἔτι",110,17],["εἰς",8,1],["στηλογραφίαν",3647,10],["τῷ",1,110],["Δαυὶδ",52,105],["εἰς",8,1],["διδαχὴν",7076,10]],"For the end, for them that shall yet be changed; for an inscription by David for instruction,"],["2",[["ὁπότε",3229,17],["ἐνεπύρισε",0,0],["τὴν",1,9],["Μεσοποταμίαν",1759,10],["Συρίας",493,19],["καὶ",2,8],["τὴν",1,9],["Συρίαν",493,10],["Σοβὰλ",0,0],["καὶ",2,8],["ἐπέστρεψεν",116,3],["Ἰωὰβ",0,0],["καὶ",2,8],["ἐπάταξε",145,3],["τὴν",1,9],["φάραγγα",620,10],["τῶν",1,76],["ἁλῶν",2143,77],["δώδεκα",555,57],["χιλιάδας",178,40]],"when he [had] burned Mesopotamia of Syria, and Syria Sobal, and Joab [had] returned and smitten [in] the valley of salt twelve thousand."],["3",[["Ὁ",1,4],["Θεὸς",20,5],["ἀπώσω",767,157],["ἡμᾶς",6,60],["καὶ",2,8],["καθεῖλες",610,154],["ἡμᾶς",6,60],["ὠργίσθης",725,363],["καὶ",2,8],["ᾠκτείρησας",1687,154],["ἡμᾶς",6,60]],"O God, thou hast rejected and destroyed us; thou hast been angry, yet hast pitied us."],["4",[["Συνέσεισας",4439,154],["τὴν",1,9],["γῆν",26,10],["καὶ",2,8],["συνετάραξας",2047,154],["αὐτὴν",3,98],["ἴασαι",794,166],["τὰ",1,42],["συντρίμματα",1231,43],["αὐτῆς",3,83],["ὅτι",19,8],["ἐσαλεύθη",679,38]],"Thou hast shaken the earth, and troubled it; heal its breaches, for it has been shaken."],["5",[["Ἔδειξας",860,154],["τῷ",1,110],["λαῷ",35,113],["σου",5,146],["σκληρὰ",833,15],["ἐπότισας",788,154],["ἡμᾶς",6,60],["οἶνον",261,7],["κατανύξεως",5753,19]],"Thou hast shewn thy people hard things: thou hast made us drink the wine of astonishment."],["6",[["Ἔδωκας",33,154],["τοῖς",1,138],["φοβουμένοις",134,346],["σε",5,161],["σημείωσιν",8283,10],["τοῦ",1,30],["φυγεῖν",265,100],["ἀπὸ",17,1],["προσώπου",47,24],["τόξον",712,20],["διάψαλμα",687,20]],"Thou hast given a token to them that fear thee, that they might flee from the bow. Pause."],["7",[["Ὅπως",236,8],["ἂν",82,12],["ῥυσθῶσιν",335,267],["οἱ",1,128],["ἀγαπητοί",1922,130],["σου",5,146],["σῶσον",171,198],["τῇ",1,95],["δεξιᾷ",282,96],["σου",5,146],["καὶ",2,8],["ἐπάκουσόν",595,198],["μου",6,48]],"That thy beloved ones may be delivered; save with thy right hand, and hear me."],["8",[["Ὁ",1,4],["Θεὸς",20,5],["ἐλάλησεν",50,3],["ἐν",4,1],["τῷ",1,110],["ἁγίῳ",75,111],["αὐτοῦ",3,48],["ἀγαλλιάσομαι",737,176],["καὶ",2,8],["διαμεριῶ",2174,157],["Σίκιμα",2977,105],["καὶ",2,8],["τὴν",1,9],["κοιλάδα",1058,10],["τῶν",1,123],["σκηνῶν",131,61],["διαμετρήσω",1244,157]],"God has spoken in his holiness; I will rejoice, and divide Sicima, and measure out the valley of tents."],["9",[["Ἐμός",523,5],["ἐστι",10,87],["Γαλαὰδ",0,0],["καὶ",2,8],["ἐμός",523,5],["ἐστι",10,87],["Μανασσῆ",394,251],["καὶ",2,8],["Ἐφραὶμ",307,105],["κραταίωσις",4889,13],["τῆς",1,18],["κεφαλῆς",144,19],["μου",6,83],["Ἰούδας",61,5],["βασιλεύς",22,5],["μου",6,48]],"Galaad is mine, and Manasse is mine; and Ephraim is the strength of my head;"],["10",[["Μωὰβ",0,0],["λέβης",1343,5],["τῆς",1,18],["ἐλπίδος",527,19],["μου",6,83],["ἐπὶ",9,1],["τὴν",1,9],["Ἰδουμαίαν",1319,37],["ἐκτενῶ",419,157],["τὸ",1,32],["ὑπόδημά",1666,33],["μου",6,48],["ἐμοὶ",6,49],["ἀλλόφυλοι",203,130],["ὑπετάγησαν",1756,94]],"Judas is my king; Moab is the caldron of my hope; over Idumea will I stretch out my shoe; the Philistines have been subjected to me."],["11",[["Τίς",39,150],["ἀπάξει",1216,120],["με",6,98],["εἰς",8,1],["πόλιν",41,10],["περιοχῆς",1595,19],["τίς",39,150],["ὁδηγήσει",1110,120],["με",6,82],["ἕως",42,8],["τῆς",1,18],["Ἰδουμαίας",1223,19]],"Who will lead me into the fortified city? who will guide me as far as Idumea?"],["12",[["Οὐχὶ",326,12],["σὺ",5,156],["ὁ",1,4],["Θεὸς",20,5],["ὁ",1,4],["ἀπωσάμενος",767,245],["ἡμᾶς",6,60],["καὶ",2,8],["οὐκ",12,17],["ἐξελεύσῃ",84,116],["ὁ",1,4],["Θεὸς",20,5],["ἐν",4,1],["ταῖς",1,70],["δυνάμεσιν",98,71],["ἡμῶν",6,41]],"Wilt not thou, O God, who hast cast us off? and wilt not thou, O God, go forth with our forces?"],["13",[["Δὸς",33,198],["ἡμῖν",6,142],["βοήθειαν",761,10],["ἐκ",21,1],["θλίψεως",437,19],["καὶ",2,8],["ματαία",648,15],["σωτηρία",422,13],["ἀνθρώπου",43,21]],"Give us help from trouble: for vain is the deliverance of man."],["14",[["Ἐν",4,1],["τῷ",1,110],["Θεῷ",20,113],["ποιήσομεν",23,269],["δύναμιν",98,10],["καὶ",2,8],["αὐτὸς",3,158],["ἐξουδενώσει",1069,120],["τοὺς",1,56],["θλίβοντας",599,229],["ἡμᾶς",6,60]],"In God will we do valiantly; and he shall bring to nought them that harass us."]]