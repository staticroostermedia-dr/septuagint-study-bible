[["1",[["Εἰς",8,1],["τὸ",1,32],["τέλος",373,33],["τοῖς",1,138],["ἀλλοιωθησομένοις",1231,624],["ἔτι",111,17],["εἰς",8,1],["στηλογραφίαν",3640,10],["τῷ",1,110],["Δαυὶδ",52,105],["εἰς",8,1],["διδαχὴν",7030,10]],"For the end, for them that shall yet be changed; for an inscription by David for instruction,"],["2",[["ὁπότε",3224,17],["ἐνεπύρισε",3430,0],["τὴν",1,9],["Μεσοποταμίαν",1760,10],["Συρίας",494,19],["καὶ",2,8],["τὴν",1,9],["Συρίαν",494,10],["Σοβὰλ",13752,0],["καὶ",2,8],["ἐπέστρεψεν",117,3],["Ἰωὰβ",11546,0],["καὶ",2,8],["ἐπάταξε",145,3],["τὴν",1,9],["φάραγγα",622,10],["τῶν",1,76],["ἁλῶν",2136,77],["δώδεκα",556,57],["χιλιάδας",179,40]],"when he [had] burned Mesopotamia of Syria, and Syria Sobal, and Joab [had] returned and smitten [in] the valley of salt twelve thousand."],["3",[["Ὁ",1,4],["Θεὸς",20,5],["ἀπώσω",770,157],["ἡμᾶς",6,60],["καὶ",2,8],["καθεῖλες",602,154],["ἡμᾶς",6,60],["ὠργίσθης",725,360],["καὶ",2,8],["ᾠκτείρησας",1309,154],["ἡμᾶς",6,60]],"O God, thou hast rejected and destroyed us; thou hast been angry, yet hast pitied us."],["4",[["Συνέσεισας",4420,154],["τὴν",1,9],["γῆν",26,10],["καὶ",2,8],["συνετάραξας",2042,154],["αὐτὴν",3,98],["ἴασαι",797,379],["τὰ",1,42],["συντρίμματα",1229,43],["αὐτῆς",3,83],["ὅτι",19,8],["ἐσαλεύθη",678,38]],"Thou hast shaken the earth, and troubled it; heal its breaches, for it has been shaken."],["5",[["Ἔδειξας",860,154],["τῷ",1,110],["λαῷ",35,113],["σου",5,146],["σκληρὰ",831,15],["ἐπότισας",790,154],["ἡμᾶς",6,60],["οἶνον",261,7],["κατανύξεως",5717,19]],"Thou hast shewn thy people hard things: thou hast made us drink the wine of astonishment."],["6",[["Ἔδωκας",33,154],["τοῖς",1,138],["φοβουμένοις",134,342],["σε",5,161],["σημείωσιν",8223,10],["τοῦ",1,30],["φυγεῖν",264,100],["ἀπὸ",17,1],["προσώπου",47,24],["τόξον",711,20],["διάψαλμα",689,20]],"Thou hast given a token to them that fear thee, that they might flee from the bow. Pause."],["7",[["Ὅπως",240,8],["ἂν",83,12],["ῥυσθῶσιν",337,266],["οἱ",1,128],["ἀγαπητοί",1920,130],["σου",5,146],["σῶσον",172,198],["τῇ",1,95],["δεξιᾷ",282,96],["σου",5,146],["καὶ",2,8],["ἐπάκουσόν",597,198],["μου",6,48]],"That thy beloved ones may be delivered; save with thy right hand, and hear me."],["8",[["Ὁ",1,4],["Θεὸς",20,5],["ἐλάλησεν",50,3],["ἐν",4,1],["τῷ",1,110],["ἁγίῳ",75,111],["αὐτοῦ",3,48],["ἀγαλλιάσομαι",738,177],["καὶ",2,8],["διαμεριῶ",2075,157],["Σίκιμα",2965,105],["καὶ",2,8],["τὴν",1,9],["κοιλάδα",1058,10],["τῶν",1,123],["σκηνῶν",131,61],["διαμετρήσω",1242,157]],"God has spoken in his holiness; I will rejoice, and divide Sicima, and measure out the valley of tents."],["9",[["Ἐμός",525,5],["ἐστι",10,87],["Γαλαὰδ",11550,0],["καὶ",2,8],["ἐμός",525,5],["ἐστι",10,87],["Μανασσῆ",396,250],["καὶ",2,8],["Ἐφραὶμ",308,105],["κραταίωσις",4864,13],["τῆς",1,18],["κεφαλῆς",144,19],["μου",6,83],["Ἰούδας",62,5],["βασιλεύς",22,5],["μου",6,48]],"Galaad is mine, and Manasse is mine; and Ephraim is the strength of my head; Judas is my king;",{"s":"r"}],["10",[["Μωὰβ",0,0],["λέβης",1346,5],["τῆς",1,18],["ἐλπίδος",530,19],["μου",6,83],["ἐπὶ",9,1],["τὴν",1,9],["Ἰδουμαίαν",1218,37],["ἐκτενῶ",421,157],["τὸ",1,32],["ὑπόδημά",1665,33],["μου",6,48],["ἐμοὶ",6,49],["ἀλλόφυλοι",203,130],["ὑπετάγησαν",1497,94]],"Moab is the caldron of my hope; over Idumea will I stretch out my shoe; the Philistines have been subjected to me.",{"s":"r"}],["11",[["Τίς",39,150],["ἀπάξει",1212,120],["με",6,98],["εἰς",8,1],["πόλιν",41,10],["περιοχῆς",1594,19],["τίς",39,150],["ὁδηγήσει",1108,120],["με",6,82],["ἕως",42,8],["τῆς",1,18],["Ἰδουμαίας",1218,19]],"Who will lead me into the fortified city? who will guide me as far as Idumea?"],["12",[["Οὐχὶ",330,12],["σὺ",5,156],["ὁ",1,4],["Θεὸς",20,5],["ὁ",1,4],["ἀπωσάμενος",770,244],["ἡμᾶς",6,60],["καὶ",2,8],["οὐκ",12,17],["ἐξελεύσῃ",82,116],["ὁ",1,4],["Θεὸς",20,5],["ἐν",4,1],["ταῖς",1,70],["δυνάμεσιν",98,71],["ἡμῶν",6,41]],"Wilt not thou, O God, who hast cast us off? and wilt not thou, O God, go forth with our forces?"],["13",[["Δὸς",33,198],["ἡμῖν",6,142],["βοήθειαν",765,10],["ἐκ",21,1],["θλίψεως",438,19],["καὶ",2,8],["ματαία",654,15],["σωτηρία",425,13],["ἀνθρώπου",43,21]],"Give us help from trouble: for vain is the deliverance of man."],["14",[["Ἐν",4,1],["τῷ",1,110],["Θεῷ",20,113],["ποιήσομεν",23,269],["δύναμιν",98,10],["καὶ",2,8],["αὐτὸς",3,158],["ἐξουδενώσει",1068,120],["τοὺς",1,56],["θλίβοντας",601,229],["ἡμᾶς",6,60]],"In God will we do valiantly; and he shall bring to nought them that harass us."]]