[["1",[["Ψαλμὸς",644,5],["τῷ",1,110],["Δαυὶδ",52,105],["τῆς",1,18],["μιᾶς",58,78],["σαββάτου",442,24],["Τοῦ",1,30],["Κυρίου",7,21],["ἡ",1,11],["γῆ",26,13],["καὶ",2,8],["τὸ",1,32],["πλήρωμα",2185,33],["αὐτῆς",3,83],["ἡ",1,11],["οἰκουμένη",528,204],["καὶ",2,8],["πάντες",11,130],["οἱ",1,128],["κατοικοῦντες",89,137],["ἐν",4,1],["αὐτῇ",3,99]],"A Psalm for David on the first day of the week. The earth is the Lord's and the fulness thereof; the world, and all that dwell in it."],["2",[["Αὐτὸς",3,158],["ἐπὶ",9,1],["θαλασσῶν",137,61],["ἐθεμελιώσεν",1116,3],["αὐτὴν",3,98],["καὶ",2,8],["ἐπὶ",9,1],["ποταμῶν",249,77],["ἡτοίμασεν",371,3],["αὐτήν",3,98]],"He has founded it upon the seas, and prepared it upon the rivers."],["3",[["Τίς",39,150],["ἀναβήσεται",88,89],["εἰς",8,1],["τὸ",1,32],["ὄρος",87,33],["τοῦ",1,30],["Κυρίου",7,21],["καὶ",2,8],["τίς",39,150],["στήσεται",78,89],["ἐν",4,1],["τόπῳ",99,113],["ἁγίῳ",75,111],["αὐτοῦ",3,48]],"Who shall go up to the mountain of the Lord, and who shall stand in his holy place?"],["4",[["Ἀθῶος",1079,16],["χερσὶ",37,71],["καὶ",2,8],["καθαρὸς",379,16],["τῇ",1,95],["καρδίᾳ",64,2],["ὃς",24,246],["οὐκ",12,17],["ἔλαβεν",46,3],["ἐπὶ",9,1],["ματαίῳ",654,111],["τὴν",1,9],["ψυχὴν",63,10],["αὐτοῦ",3,48],["καὶ",2,8],["οὐκ",12,17],["ὤμοσεν",347,3],["ἐπὶ",9,1],["δόλῳ",919,113],["τῷ",1,110],["πλησίον",292,17],["αὐτοῦ",3,48]],"He that is innocent in his hands and pure in his heart; who has not lifted up his soul to vanity, nor sworn deceitfully to his neighbour."],["5",[["Οὗτος",16,112],["λήψεται",46,89],["εὐλογίαν",578,10],["παρὰ",73,1],["Κυρίου",7,21],["καὶ",2,8],["ἐλεημοσύνην",942,10],["παρὰ",73,1],["Θεοῦ",20,21],["σωτῆρος",1388,21],["αὐτοῦ",3,48]],"He shall receive a blessing from the Lord, and mercy from God his Saviour."],["6",[["Αὕτη",16,101],["ἡ",1,11],["γενεὰ",286,13],["ζητούντων",191,164],["αὐτὸν",3,82],["ζητούντων",191,164],["τὸ",1,32],["πρόσωπον",47,33],["τοῦ",1,30],["Θεοῦ",20,21],["Ἰακώβ",146,105],["διάψαλμα",689,20]],"This is the generation of 