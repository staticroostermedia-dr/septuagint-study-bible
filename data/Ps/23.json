[["1",[["Ψαλμὸς",639,5],["τῷ",1,110],["Δαυὶδ",52,105],["τῆς",1,18],["μιᾶς",57,78],["σαββάτου",441,24],["Τοῦ",1,30],["Κυρίου",7,21],["ἡ",1,11],["γῆ",26,13],["καὶ",2,8],["τὸ",1,32],["πλήρωμα",2198,33],["αὐτῆς",3,83],["ἡ",1,11],["οἰκουμένη",526,204],["καὶ",2,8],["πάντες",11,130],["οἱ",1,128],["κατοικοῦντες",90,137],["ἐν",4,1],["αὐτῇ",3,99]],"A Psalm for David on the first day of the week. The earth is the Lord's and the fulness thereof; the world, and all that dwell in it."],["2",[["Αὐτὸς",3,158],["ἐπὶ",9,1],["θαλασσῶν",137,61],["ἐθεμελιώσεν",1203,3],["αὐτὴν",3,98],["καὶ",2,8],["ἐπὶ",9,1],["ποταμῶν",249,77],["ἡτοίμασεν",371,3],["αὐτήν",3,98]],"He has founded it upon the seas, and prepared it upon the rivers."],["3",[["Τίς",39,150],["ἀναβήσεται",87,89],["εἰς",8,1],["τὸ",1,32],["ὄρος",86,33],["τοῦ",1,30],["Κυρίου",7,21],["καὶ",2,8],["τίς",39,150],["στήσεται",78,89],["ἐν",4,1],["τόπῳ",99,113],["ἁγίῳ",75,111],["αὐτοῦ",3,48]],"Who shall go up to the mountain of the Lord, and who shall stand in his holy place?"],["4",[["Ἀθῶος",1988,378],["χερσὶ",37,71],["καὶ",2,8],["καθαρὸς",375,16],["τῇ",1,95],["καρδίᾳ",63,2],["ὃς",24,247],["οὐκ",12,17],["ἔλαβεν",46,3],["ἐπὶ",9,1],["ματαίῳ",648,111],["τὴν",1,9],["ψυχὴν",62,10],["αὐτοῦ",3,48],["καὶ",2,8],["οὐκ",12,17],["ὤμοσεν",346,3],["ἐπὶ",9,1],["δόλῳ",920,113],["τῷ",1,110],["πλησίον",292,17],["αὐτοῦ",3,48]],"He that is innocent in his hands and pure in his heart; who has not lifted up his soul to vanity, nor sworn deceitfully to his neighbour."],["5",[["Οὗτος",16,112],["λήψεται",46,89],["εὐλογίαν",576,10],["παρὰ",72,1],["Κυρίου",7,21],["καὶ",2,8],["ἐλεημοσύνην",943,10],["παρὰ",72,1],["Θεοῦ",20,21],["σωτῆρος",1390,21],["αὐτοῦ",3,48]],"He shall receive a blessing from the Lord, and mercy from God his Saviour."],["6",[["Αὕτη",16,101],["ἡ",1,11],["γενεὰ",286,13],["ζητούντων",190,164],["αὐτὸν",3,82],["ζητούντων",190,164],["τὸ",1,32],["πρόσωπον",47,33],["τοῦ",1,30],["Θεοῦ",20,21],["Ἰακώβ",146,105],["διάψαλμα",687,20]],"This is the generation of them that seek him, that seek the face of the God of Jacob. Pause."],["7",[["Ἄρατε",248,69],["πύλας",162,40],["οἱ",1,128],["ἄρχοντες",96,51],["ὑμῶν",5,136],["καὶ",2,8],["ἐπάρθητε",752,358],["πύλαι",162,179],["αἰώνιοι",388,185],["καὶ",2,8],["εἰσελεύσεται",88,89],["ὁ",1,4],["βασιλεὺς",22,5],["τῆς",1,18],["δόξης",141,19]],"Lift up your gates, ye princes, and be ye lifted up, ye everlasting doors; and the king of glory shall come in."],["8",[["Τίς",39,150],["ἐστιν",10,87],["οὗτος",16,112],["ὁ",1,4],["βασιλεὺς",22,5],["τῆς",1,18],["δόξης",141,19],["Κύριος",7,5],["κραταιὸς",862,16],["καὶ",2,8],["δυνατὸς",354,16],["Κύριος",7,5],["δυνατὸς",354,16],["ἐν",4,1],["πολέμῳ",163,113]],"Who is this king of glory? the Lord strong and mighty, the Lord mighty in battle."],["9",[["Ἄρατε",248,69],["πύλας",162,40],["οἱ",1,128],["ἄρχοντες",96,51],["ὑμῶν",5,136],["καὶ",2,8],["ἐπάρθητε",752,358],["πύλαι",162,179],["αἰώνιοι",388,185],["καὶ",2,8],["εἰσελεύσεται",88,89],["ὁ",1,4],["βασιλεὺς",22,5],["τῆς",1,18],["δόξης",141,19]],"Lift up your gates, ye princes; and be ye lift up, ye everlasting doors; and the king of glory shall come in."],["10",[["Τίς",39,150],["ἐστιν",10,87],["οὗτος",16,112],["ὁ",1,4],["βασιλεὺς",22,5],["τῆς",1,18],["δόξης",141,19],["Κύριος",7,5],["τῶν",1,123],["δυνάμεων",98,61],["αὐτός",3,158],["ἐστιν",10,87],["οὗτος",16,112],["ὁ",1,4],["βασιλεὺς",22,5],["τῆς",1,18],["δόξης",141,19]],"Who is this king of glory? The Lord of hosts, he is this king of glory."]]