[["1",[["Εἰς",8,1],["τὸ",1,32],["τέλος",373,33],["ὑπὲρ",139,1],["τῆς",1,18],["ὀγδόης",1027,78],["ψαλμὸς",644,5],["τῷ",1,110],["Δαυίδ",52,105]],"For the end, a Psalm of David, upon the eighth."],["2",[["Σῶσον",172,548],["με",6,82],["Κύριε",7,250],["ὅτι",19,8],["ἐκλέλοιπεν",321,165],["ὅσιος",917,16],["ὅτι",19,8],["ὠλιγώθησαν",2684,94],["αἱ",1,185],["ἀλήθειαι",352,180],["ἀπὸ",17,1],["τῶν",1,76],["υἱῶν",13,77],["τῶν",1,76],["ἀνθρώπων",43,77]],"Save me, O Lord; for the godly man has failed; for truth is diminished from among the children of men."],["3",[["Μάταια",654,74],["ἐλάλησεν",50,3],["ἕκαστος",171,16],["πρὸς",15,1],["τὸν",1,6],["πλησίον",292,17],["αὐτοῦ",3,48],["χείλη",361,43],["δόλια",1545,65],["ἐν",4,1],["καρδίᾳ",64,2],["καὶ",2,8],["ἐν",4,1],["καρδίᾳ",64,2],["ἐλάλησαν",50,141]],"Every one has spoken vanity to his neighbour: their lips are deceitful, they have spoken with a double heart."],["4",[["Ἐξολοθρεύσαι",291,216],["Κύριος",7,5],["πάντα",11,65],["τὰ",1,42],["χείλη",361,43],["τὰ",1,42],["δόλια",1545,65],["καὶ",2,8],["γλῶσσαν",388,10],["μεγαλοῤῥήμονα",5814,37]],"Let the Lord destroy all the deceitful lips, and the tongue that speaks great words:"],["5",[["Τοὺς",1,56],["εἰπόντας",18,458],["τὴν",1,9],["γλῶσσαν",388,10],["ἡμῶν",6,41],["μεγαλυνοῦμεν",604,269],["τὰ",1,42],["χείλη",361,43],["ἡμῶν",6,41],["παρʼ",73,1],["ἡμῶν",6,41],["ἐστι",10,87],["τίς",39,150],["ἡμῶν",6,41],["Κύριός",7,5],["ἐστιν",10,87]],"who have said, We will magnify our tongue; our lips are our own: who is Lord of us?"],["6",[["Ἀπὸ",17,1],["τῆς",1,18],["ταλαιπωρίας",1448,19],["τῶν",1,76],["πτωχῶν",497,77],["καὶ",2,8],["ἀπὸ",17,1],["τοῦ",1,30],["στεναγμοῦ",1598,21],["τῶν",1,76],["πενήτων",672,77],["νῦν",90,17],["ἀναστήσομαι",121,177],["λέγει",31,87],["Κύριος",7,5],["θήσομαι",110,177],["ἐν",4,1],["σωτηρίῳ",1788,111],["παῤῥησιάσομαι",3917,231],["ἐν",4,1],["αὐτῷ",3,49]],"Because of the misery of the poor, and because of the sighing of the needy, now will I arise, saith the Lord, I will set [them] in safety; I will speak [to them] thereof openly."],["7",[["Τὰ",1,42],["λόγια",1248,43],["Κυρίου",7,21],["λόγια",1248,43],["ἁγνά",2814,65],["ἀργύριον",152,20],["πεπυρωμένον",926,326],["δοκίμιον",5582,20],["τῇ",1,95],["γῇ",26,2],["κεκαθαρισμένον",482,326],["ἑπταπλασίως",3202,17]],"The oracles of the Lord are pure oracles; as silver tried in the fire, proved [in] a furnace of earth, purified seven times."],["8",[["Σὺ",5,156],["Κύριε",7,250],["φυλάξεις",125,159],["ἡμᾶς",6,60],["καὶ",2,8],["διατηρήσεις",1586,159],["ἡμᾶς",6,60],["ἀπὸ",17,1],["τῆς",1,18],["γενεᾶς",286,19],["ταύτης",16,290],["καὶ",2,8],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7]],"Thou, O Lord, shalt keep us, and shalt preserve us, from this generation, and for ever."],["9",[["Κύκλῳ",258,17],["οἱ",1,128],["ἀσεβεῖς",247,130],["περιπατοῦσι",1327,191],["κατὰ",32,1],["τὸ",1,32],["ὕψος",481,33],["σου",5,146],["ἐπολυώρησας",5965,154],["τοὺς",1,56],["υἱοὺς",13,31],["τῶν",1,76],["ἀνθρώπων",43,77]],"The ungodly walk around: according to thy greatness thou hast greatly exalted the sons of men."]]