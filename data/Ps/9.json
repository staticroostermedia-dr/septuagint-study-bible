[["1",[["Εἰς",8,1],["τὸ",1,32],["τέλος",369,33],["ὑπὲρ",139,1],["τῶν",1,76],["κρυφίων",2740,163],["τοῦ",1,30],["υἱοῦ",13,21],["ψαλμὸς",639,5],["τῷ",1,110],["Δαυίδ",52,105]],"For the end, a Psalm of David, concerning the secrets of the Son."],["2",[["Ἐξομολογήσομαι",478,176],["σοι",5,151],["Κύριε",7,251],["ἐν",4,1],["ὅλῃ",233,96],["καρδίᾳ",63,2],["μου",6,48],["διηγήσομαι",797,176],["πάντα",11,65],["τὰ",1,42],["θαυμάσιά",885,65],["σου",5,146]],"I will give thanks to thee, O Lord, with my whole heart; I will recount all thy wonderful works."],["3",[["Εὐφρανθήσομαι",242,175],["καὶ",2,8],["ἀγαλλιάσομαι",737,176],["ἐν",4,1],["σοὶ",5,151],["ψαλῶ",901,157],["τῷ",1,52],["ὀνόματί",55,53],["σου",5,146],["ὕψιστε",473,313]],"I will be glad and exult in thee: I will sing to thy name, O thou Most High."],["4",[["Ἐν",4,1],["τῷ",1,110],["ἀποστραφῆναι",130,174],["τὸν",1,6],["ἐχθρόν",135,7],["μου",6,48],["εἰς",8,1],["τὰ",1,42],["ὀπίσω",166,17],["ἀσθενήσουσι",768,207],["καὶ",2,8],["ἀπολοῦνται",213,127],["ἀπὸ",17,1],["προσώπου",47,24],["σου",5,146]],"When mine enemies are turned back, they shall be feeble and perish at thy presence."],["5",[["Ὅτι",19,8],["ἐποίησας",23,154],["τὴν",1,9],["κρίσιν",226,10],["μου",6,48],["καὶ",2,8],["τὴν",1,9],["δίκην",1224,10],["μου",6,48],["ἐκάθισας",273,154],["ἐπὶ",9,1],["θρόνου",379,21],["ὁ",1,4],["κρίνων",240,67],["δικαιοσύνην",185,10]],"For thou hast maintained my cause and my right; thou satest on the throne, that judgest righteousness."],["6",[["Ἐπετίμησας",2331,154],["ἔθνεσι",59,92],["καὶ",2,8],["ἀπώλετο",594,26],["ὁ",1,4],["ἀσεβὴς",246,16],["τὸ",1,32],["ὄνομα",55,33],["αὐτῶν",3,41],["ἐξήλειψας",1086,154],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["καὶ",2,8],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["τοῦ",1,30],["αἰῶνος",100,21]],"Thou hast rebuked the nations, and the ungodly one has perished; thou hast blotted out their name for ever, even for ever and ever."],["7",[["Τοῦ",1,30],["ἐχθροῦ",135,21],["ἐξέλιπον",321,141],["αἱ",1,183],["ῥομφαῖαι",247,179],["εἰς",8,1],["τέλος",369,33],["καὶ",2,8],["πόλεις",41,40],["καθεῖλες",610,154],["ἀπώλετο",594,26],["τὸ",1,32],["μνημόσυνον",717,33],["αὐτῶν",3,41],["μετʼ",29,1],["ἤχου",1805,21]],"The swords of the enemy have failed utterly; and thou hast destroyed cities: their memorial has been destroyed with a noise,"],["8",[["καὶ",2,8],["ὁ",1,4],["Κύριος",7,5],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["μένει",678,87],["ἡτοίμασεν",371,3],["ἐν",4,1],["κρίσει",226,2],["τὸν",1,6],["θρόνον",379,7],["αὐτοῦ",3,48]],"but the Lord endures for ever: he has prepared his throne for judgment."],["9",[["καὶ",2,8],["αὐτὸς",3,158],["κρινεῖ",240,120],["τὴν",1,9],["οἰκουμένην",1326,10],["ἐν",4,1],["δικαιοσύνῃ",185,2],["κρινεῖ",240,120],["λαοὺς",35,31],["ἐν",4,1],["εὐθύτητι",1676,2]],"And he will judge the world in righteousness, he will judge the nations in uprightness."],["10",[["Καὶ",2,8],["ἐγένετο",30,26],["Κύριος",7,5],["καταφυγὴ",1681,13],["τῷ",1,110],["πένητι",668,113],["βοηθὸς",948,5],["ἐν",4,1],["εὐκαιρίαις",3841,71],["ἐν",4,1],["θλίψει",437,2]],"The Lord also is become a refuge for the poor, a seasonable help, in affliction."],["11",[["Καὶ",2,8],["ἐλπισάτωσαν",511,261],["ἐπὶ",9,1],["σὲ",5,161],["οἱ",1,128],["γινώσκοντες",81,137],["τὸ",1,32],["ὄνομά",55,33],["σου",5,146],["ὅτι",19,8],["οὐκ",12,17],["ἐγκατέλιπες",363,154],["τοὺς",1,56],["ἐκζητοῦντάς",459,229],["σε",5,161],["Κύριε",7,251]],"And let them that know thy name hope in thee: for thou, O Lord, hast not failed them that diligently seek thee."],["12",[["Ψάλατε",901,69],["τῷ",1,110],["Κυρίῳ",7,113],["τῷ",1,110],["κατοικοῦντι",90,395],["ἐν",4,1],["Σιὼν",331,2],["ἀναγγείλατε",228,69],["ἐν",4,1],["τοῖς",1,91],["ἔθνεσι",59,92],["τὰ",1,42],["ἐπιτηδεύματα",905,43],["αὐτοῦ",3,48]],"Sing praises to the Lord, who dwells in Sion: declare his dealings among the nations."],["13",[["Ὅτι",19,8],["ἐκζητῶν",459,67],["τὰ",1,42],["αἵματα",148,43],["αὐτῶν",3,41],["ἐμνήσθη",231,38],["οὐκ",12,17],["ἐπελάθετο",512,26],["τῆς",1,18],["δεήσεως",674,19],["τῶν",1,76],["πενήτων",668,77]],"For he remembered them, [in] making inquisition for blood: he has not forgotten the supplication of the poor."],["14",[["Ἐλέησόν",457,243],["με",6,82],["Κύριε",7,251],["ἴδε",693,17],["τὴν",1,9],["ταπείνωσίν",1483,10],["μου",6,48],["ἐκ",21,1],["τῶν",1,76],["ἐχθρῶν",135,77],["μου",6,48],["ὁ",1,4],["ὑψῶν",327,67],["με",6,82],["ἐκ",21,1],["τῶν",1,123],["πυλῶν",162,61],["τοῦ",1,30],["θανάτου",169,21]],"Have mercy upon me, O Lord; look upon my affliction [which I suffer] of mine enemies, thou that liftest me up from the gates of death:"],["15",[["Ὅπως",236,8],["ἂν",82,12],["ἐξαγγείλω",2535,227],["πάσας",11,109],["τὰς",1,39],["αἰνέσεις",399,159],["σου",5,146],["ἐν",4,1],["ταῖς",1,70],["πύλαις",162,71],["τῆς",1,18],["θυγατρὸς",97,19],["Σιών",331,2],["ἀγαλλιάσομαι",737,176],["ἐπὶ",9,1],["τῷ",1,110],["σωτηρίῳ",1787,111],["σου",5,146]],"that I may declare all thy praises in the gates of the daughter of Sion: I will exult in thy salvation."],["16",[["Ἐνεπάγησαν",3009,94],["ἔθνη",59,43],["ἐν",4,1],["διαφθορᾷ",1672,2],["ᾗ",24,102],["ἐποίησαν",23,141],["ἐν",4,1],["παγίδι",815,2],["ταύτῃ",16,200],["ᾗ",24,102],["ἔκρυψαν",378,141],["συνελήφθη",510,38],["ὁ",1,4],["ποὺς",208,5],["αὐτῶν",3,41]],"The heathen are caught in the destruction which they planned: in the very snare which they hid is their foot taken."],["17",[["Γινώσκεται",81,108],["Κύριος",7,5],["κρίματα",266,63],["ποιῶν",23,67],["ἐν",4,1],["τοῖς",1,91],["ἔργοις",104,92],["τῶν",1,123],["χειρῶν",37,61],["αὐτοῦ",3,48],["συνελήφθη",510,38],["ὁ",1,4],["ἁμαρτωλός",406,16],["ᾠδὴ",773,13],["διαψάλματος",687,24]],"The Lord is known as executing judgments: the sinner is taken in the works of his hands. A song of Pause."],["18",[["Ἀποστραφήτωσαν",0,0],["οἱ",1,128],["ἁμαρτωλοὶ",406,130],["εἰς",8,1],["τὸν",1,6],["ᾅδην",583,7],["πάντα",11,59],["τὰ",1,42],["ἔθνη",59,43],["τὰ",1,42],["ἐπιλανθανόμενα",512,203],["τοῦ",1,30],["Θεοῦ",20,21]],"Let sinners be driven away into Hades, [even] all the nations that forget God."],["19",[["Ὅτι",19,8],["οὐκ",12,17],["εἰς",8,1],["τέλος",369,33],["ἐπιλησθήσεται",512,125],["ὁ",1,4],["πτωχὸς",496,5],["ἡ",1,11],["ὑπομονὴ",1615,13],["τῶν",1,76],["πενήτων",668,77],["οὐκ",12,17],["ἀπολεῖται",213,89],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7]],"For the poor shall not be forgotten for ever: the patience of the needy ones shall not perish for ever."],["20",[["Ἀνάστηθι",121,198],["Κύριε",7,251],["μὴ",25,8],["κραταιούσθω",734,344],["ἄνθρωπος",43,5],["κριθήτωσαν",240,50],["ἔθνη",59,43],["ἐνώπιόν",114,1],["σου",5,146]],"Arise, O Lord, let not man prevail: let the heathen be judged before thee."],["21",[["Κατάστησον",313,198],["Κύριε",7,251],["νομοθέτην",7821,7],["ἐπʼ",9,1],["αὐτοὺς",3,60],["γνώτωσαν",0,0],["ἔθνη",59,43],["ὅτι",19,8],["ἀνθρωποί",8964,166],["εἰσι",10,189],["διάψαλμα",687,20]],"Appoint, O Lord, a lawgiver over them: let the heathen know that they are men. Pause."],["22",[["Ἱνατί",101,238],["Κύριε",7,251],["ἀφέστηκας",646,263],["μακρόθεν",1250,17],["ὑπερορᾷς",2558,199],["ἐν",4,1],["εὐκαιρίαις",3841,71],["ἐν",4,1],["θλίψει",437,2]],"Why standest thou afar off, O Lord? [why] dost thou overlook [us] in times of need, in affliction?"],["23",[["Ἐν",4,1],["τῷ",1,110],["ὑπερηφανεύεσθαι",3783,104],["τὸν",1,6],["ἀσεβῆ",246,59],["ἐμπυρίζεται",3435,108],["ὁ",1,4],["πτωχὸς",496,5],["συλλαμβάνονται",510,303],["ἐν",4,1],["διαβουλίοις",2710,92],["οἷς",24,341],["διαλογίζονται",2577,303]],"While the ungodly one acts proudly, the poor is hotly pursued: [the wicked] are taken in the crafty counsels which they imagine."],["24",[["Ὅτι",19,8],["ἐπαινεῖται",1532,108],["ὁ",1,4],["ἁμαρτωλὸς",406,16],["ἐν",4,1],["ταῖς",1,70],["ἐπιθυμίαις",701,71],["τῆς",1,18],["ψυχῆς",62,19],["αὐτοῦ",3,48],["καὶ",2,8],["ὁ",1,4],["ἀδικῶν",819,67],["ἐνευλογεῖται",3437,108]],"Because the sinner praises himself for the desires of his heart; and the unjust one blesses himself."],["25",[["Παρώξυνε",1041,14],["τὸν",1,6],["Κύριον",7,7],["ὁ",1,4],["ἁμαρτωλὸς",406,16],["κατὰ",32,1],["τὸ",1,32],["πλῆθος",199,33],["τῆς",1,18],["ὀργῆς",198,19],["αὐτοῦ",3,48],["οὐκ",12,17],["ἐκζητήσει",459,120],["οὐκ",12,17],["ἔστιν",10,87],["ὁ",1,4],["Θεὸς",20,5],["ἐνώπιον",114,1],["αὐτοῦ",3,48]],"The sinner has provoked the Lord: according to the abundance of his pride he will not seek after [him]: God is not before him."],["26",[["Βεβηλοῦνται",589,303],["αἱ",1,183],["ὁδοὶ",67,179],["αὐτοῦ",3,48],["ἐν",4,1],["παντὶ",11,111],["καιρῷ",132,113],["ἀνταναιρεῖται",2995,108],["τὰ",1,42],["κρίματά",266,43],["σου",5,146],["ἀπὸ",17,1],["προσώπου",47,24],["αὐτοῦ",3,144],["πάντων",11,163],["τῶν",1,76],["ἐχθρῶν",135,77],["αὐτοῦ",3,48],["κατακυριεύσει",2091,120]],"His ways are profane at all times; thy judgments are removed from before him: he will gain the mastery over all his enemies."],["27",[["Εἶπε",18,3],["γὰρ",40,12],["ἐν",4,1],["καρδίᾳ",63,2],["αὐτοῦ",3,48],["οὐ",12,17],["μὴ",25,8],["σαλευθῶ",679,569],["ἀπὸ",17,1],["γενεᾶς",286,19],["εἰς",8,1],["γενεὰν",286,10],["ἄνευ",1103,1],["κακοῦ",161,88]],"For he has said in his heart, I shall not be moved, [continuing] without evil from generation to generation."],["28",[["Οὗ",120,17],["ἀρᾶς",1217,19],["τὸ",1,32],["στόμα",123,33],["αὐτοῦ",3,48],["γέμει",3261,87],["καὶ",2,8],["πικρίας",1556,19],["καὶ",2,8],["δόλου",920,21],["ὑπὸ",122,1],["τὴν",1,9],["γλῶσσαν",385,10],["αὐτοῦ",3,48],["κόπος",1342,5],["καὶ",2,8],["πόνος",564,5]],"Whose mouth is full of cursing, and bitterness, and fraud: under his tongue are trouble and pain."],["29",[["Ἐγκάθηται",1859,511],["ἔνεδρα",1370,63],["μετὰ",29,1],["πλουσίων",954,115],["ἐν",4,1],["ἀποκρύφοις",1396,450],["τοῦ",1,30],["ἀποκτεῖναι",298,100],["ἀθῶον",0,0],["οἱ",1,128],["ὀφθαλμοὶ",91,51],["αὐτοῦ",3,48],["εἰς",8,1],["τὸν",1,6],["πένητα",668,7],["ἀποβλέπουσιν",4042,189]],"He lies in wait with rich [men] in secret places, in order to slay the innocent: his eyes are set against the poor."],["30",[["Ἐνεδρεύει",1492,87],["ἐν",4,1],["ἀποκρύφῳ",2664,111],["ὡς",36,8],["λέων",421,5],["ἐν",4,1],["τῇ",1,95],["μάνδρᾳ",2376,2],["αὐτοῦ",3,48],["ἐνεδρεύει",1492,87],["τοῦ",1,30],["ἁρπάσαι",1219,100],["πτωχὸν",496,7],["ἁρπάσαι",1219,100],["πτωχὸν",496,7],["ἐν",4,1],["τῷ",1,110],["ἑλκύσαι",1222,100],["αὐτόν",3,82],["ἐν",4,1],["τῇ",1,95],["παγίδι",815,2],["αὐτοῦ",3,48]],"He lies in wait in secret as a lion in his den: he lies in wait to ravish the poor, to ravish the poor when he draws him [after him]: he will bring him down in his snare."],["31",[["ταπεινώσει",333,120],["αὐτὸν",3,82],["κύψει",1966,120],["καὶ",2,8],["πεσεῖται",154,89],["ἐν",4,1],["τῷ",1,110],["αὐτὸν",3,82],["κατακυριεῦσαι",2091,100],["τῶν",1,76],["πενήτων",668,77]],"He will bow down and fall when he has mastered the poor."],["32",[["Εἶπε",18,3],["γὰρ",40,12],["ἐν",4,1],["τῇ",1,95],["καρδίᾳ",63,2],["αὐτοῦ",3,48],["ἐπιλέλησται",512,372],["ὁ",1,4],["Θεὸς",20,5],["ἀπέστρεψε",130,3],["τὸ",1,32],["πρόσωπον",47,33],["αὐτοῦ",3,48],["τοῦ",1,30],["μὴ",25,8],["βλέπειν",469,54],["εἰς",8,1],["τέλος",369,33]],"For he has said in his heart, God has forgotten: he has turned away his face so as never to look."],["33",[["Ἀνάστηθι",121,198],["Κύριε",7,251],["ὁ",1,4],["Θεὸς",20,5],["ὑψωθήτω",327,25],["ἡ",1,11],["χείρ",37,13],["σου",5,146],["μὴ",25,8],["ἐπιλάθῃ",512,160],["τῶν",1,76],["πενήτων",668,77]],"Arise, O Lord God; let thy hand be lifted up: forget not the poor."],["34",[["Ἕνεκεν",445,1],["τίνος",39,308],["παρώξυνεν",1041,14],["ὁ",1,4],["ἀσεβὴς",246,16],["τὸν",1,6],["Θεόν",20,7],["εἶπε",18,3],["γὰρ",40,12],["ἐν",4,1],["καρδίᾳ",63,2],["αὐτοῦ",3,48],["οὐ",12,17],["ζητήσει",190,120]],"Wherefore has the wicked provoked God? for he has said in his heart, He will not require [it]."],["35",[["Βλέπεις",469,145],["ὅτι",19,8],["σὺ",5,156],["πόνον",564,7],["καὶ",2,8],["θυμὸν",177,7],["κατανοεῖς",1547,145],["τοῦ",1,30],["παραδοῦναι",254,100],["αὐτοὺς",3,60],["εἰς",8,1],["χεῖράς",37,40],["σου",5,146],["σοὶ",5,151],["ἐγκαταλέλειπται",363,372],["ὁ",1,4],["πτωχὸς",496,5],["ὀρφανῷ",959,111],["σὺ",5,156],["ἦσθα",10,216],["βοηθός",948,5]],"Thou seest [it]; for thou dost observe trouble and wrath, to deliver them into thy hands: the poor has been left to thee; thou wast a helper to the orphan."],["36",[["Σύντριψον",267,198],["τὸν",1,6],["βραχίονα",616,59],["τοῦ",1,30],["ἁμαρτωλοῦ",406,153],["καὶ",2,8],["πονηροῦ",164,153],["ζητηθήσεται",190,125],["ἡ",1,11],["ἁμαρτία",119,13],["αὐτοῦ",3,48],["καὶ",2,8],["οὐ",12,17],["μὴ",25,8],["εὑρεθῇ",106,337]],"Break thou the arm of the sinner and wicked man: his sin shall be sought for, and shall not be found."],["37",[["Βασιλεύσει",151,120],["Κύριος",7,5],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["καὶ",2,8],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["τοῦ",1,30],["αἰῶνος",100,21],["ἀπολεῖσθε",213,117],["ἔθνη",59,43],["ἐκ",21,1],["τῆς",1,18],["γῆς",26,19],["αὐτοῦ",3,48]],"The Lord shall reign for ever, even for ever and ever: ye Gentiles shall perish out of his land."],["38",[["Τὴν",1,9],["ἐπιθυμίαν",701,10],["τῶν",1,76],["πενήτων",668,77],["εἰσήκουσε",237,3],["Κύριος",7,5],["τὴν",1,9],["ἑτοιμασίαν",2683,10],["τῆς",1,18],["καρδίας",63,19],["αὐτῶν",3,41],["προσέσχε",557,3],["τὸ",1,32],["οὖς",325,33],["σου",5,146]],"The Lord has heard the desire of the poor: thine ear has inclined to the preparation of their heart;"],["39",[["Κρῖναι",240,100],["ὀρφανῷ",959,111],["καὶ",2,8],["ταπεινῷ",1100,111],["ἵνα",101,8],["μὴ",25,8],["προσθῇ",200,160],["ἔτι",110,17],["μεγαλαυχεῖν",3901,54],["ἄνθρωπος",43,5],["ἐπὶ",9,1],["τῆς",1,18],["γῆς",26,19]],"to plead for the orphan and afflicted, that man may no more boast upon the earth."]]