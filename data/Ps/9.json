[["1",[["Εἰς",8,1],["τὸ",1,32],["τέλος",373,33],["ὑπὲρ",139,1],["τῶν",1,76],["κρυφίων",2733,163],["τοῦ",1,30],["υἱοῦ",13,21],["ψαλμὸς",644,5],["τῷ",1,110],["Δαυίδ",52,105]],"For the end, a Psalm of David, concerning the secrets of the Son."],["2",[["Ἐξομολογήσομαι",479,177],["σοι",5,151],["Κύριε",7,250],["ἐν",4,1],["ὅλῃ",235,96],["καρδίᾳ",64,2],["μου",6,48],["διηγήσομαι",800,177],["πάντα",11,65],["τὰ",1,42],["θαυμάσιά",884,65],["σου",5,146]],"I will give thanks to thee, O Lord, with my whole heart; I will recount all thy wonderful works."],["3",[["Εὐφρανθήσομαι",244,176],["καὶ",2,8],["ἀγαλλιάσομαι",738,177],["ἐν",4,1],["σοὶ",5,151],["ψαλῶ",913,157],["τῷ",1,52],["ὀνόματί",57,53],["σου",5,146],["ὕψιστε",474,309]],"I will be glad and exult in thee: I will sing to thy name, O thou Most High."],["4",[["Ἐν",4,1],["τῷ",1,110],["ἀποστραφῆναι",130,175],["τὸν",1,6],["ἐχθρόν",135,7],["μου",6,48],["εἰς",8,1],["τὰ",1,42],["ὀπίσω",167,17],["ἀσθενήσουσι",771,207],["καὶ",2,8],["ἀπολοῦνται",217,127],["ἀπὸ",17,1],["προσώπου",47,24],["σου",5,146]],"When mine enemies are turned back, they shall be feeble and perish at thy presence."],["5",[["Ὅτι",19,8],["ἐποίησας",23,154],["τὴν",1,9],["κρίσιν",229,10],["μου",6,48],["καὶ",2,8],["τὴν",1,9],["δίκην",1219,10],["μου",6,48],["ἐκάθισας",274,154],["ἐπὶ",9,1],["θρόνου",383,21],["ὁ",1,4],["κρίνων",263,67],["δικαιοσύνην",187,10]],"For thou hast maintained my cause and my right; thou satest on the throne, that judgest righteousness."],["6",[["Ἐπετίμησας",2318,154],["ἔθνεσι",60,92],["καὶ",2,8],["ἀπώλετο",217,26],["ὁ",1,4],["ἀσεβὴς",247,16],["τὸ",1,32],["ὄνομα",57,33],["αὐτῶν",3,41],["ἐξήλειψας",1085,154],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["καὶ",2,8],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["τοῦ",1,30],["αἰῶνος",100,21]],"Thou hast rebuked the nations, and the ungodly one has perished; thou hast blotted out their name for ever, even for ever and ever."],["7",[["Τοῦ",1,30],["ἐχθροῦ",135,21],["ἐξέλιπον",321,141],["αἱ",1,185],["ῥομφαῖαι",248,180],["εἰς",8,1],["τέλος",373,33],["καὶ",2,8],["πόλεις",41,40],["καθεῖλες",602,154],["ἀπώλετο",217,26],["τὸ",1,32],["μνημόσυνον",716,33],["αὐτῶν",3,41],["μετʼ",29,1],["ἤχου",1803,21]],"The swords of the enemy have failed utterly; and thou hast destroyed cities: their memorial has been destroyed with a noise,"],["8",[["καὶ",2,8],["ὁ",1,4],["Κύριος",7,5],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["μένει",681,87],["ἡτοίμασεν",371,3],["ἐν",4,1],["κρίσει",229,2],["τὸν",1,6],["θρόνον",383,7],["αὐτοῦ",3,48]],"but the Lord endures for ever: he has prepared his throne for judgment."],["9",[["καὶ",2,8],["αὐτὸς",3,158],["κρινεῖ",263,120],["τὴν",1,9],["οἰκουμένην",1326,10],["ἐν",4,1],["δικαιοσύνῃ",187,2],["κρινεῖ",263,120],["λαοὺς",35,31],["ἐν",4,1],["εὐθύτητι",1674,2]],"And he will judge the world in righteousness, he will judge the nations in uprightness."],["10",[["Καὶ",2,8],["ἐγένετο",30,26],["Κύριος",7,5],["καταφυγὴ",1678,13],["τῷ",1,110],["πένητι",672,113],["βοηθὸς",947,5],["ἐν",4,1],["εὐκαιρίαις",3828,71],["ἐν",4,1],["θλίψει",438,2]],"The Lord also is become a refuge for the poor, a seasonable help, in affliction."],["11",[["Καὶ",2,8],["ἐλπισάτωσαν",514,261],["ἐπὶ",9,1],["σὲ",5,161],["οἱ",1,128],["γινώσκοντες",79,137],["τὸ",1,32],["ὄνομά",57,33],["σου",5,146],["ὅτι",19,8],["οὐκ",12,17],["ἐγκατέλιπες",364,154],["τοὺς",1,56],["ἐκζητοῦντάς",460,229],["σε",5,161],["Κύριε",7,250]],"And let them that know thy name hope in thee: for thou, O Lord, hast not failed them that diligently seek thee."],["12",[["Ψάλατε",913,69],["τῷ",1,110],["Κυρίῳ",7,113],["τῷ",1,110],["κατοικοῦντι",89,390],["ἐν",4,1],["Σιὼν",334,2],["ἀναγγείλατε",231,69],["ἐν",4,1],["τοῖς",1,91],["ἔθνεσι",60,92],["τὰ",1,42],["ἐπιτηδεύματα",903,43],["αὐτοῦ",3,48]],"Sing praises to the Lord, who dwells in Sion: declare his dealings among the nations."],["13",[["Ὅτι",19,8],["ἐκζητῶν",460,67],["τὰ",1,42],["αἵματα",148,43],["αὐτῶν",3,41],["ἐμνήσθη",230,38],["οὐκ",12,17],["ἐπελάθετο",513,26],["τῆς",1,18],["δεήσεως",677,19],["τῶν",1,76],["πενήτων",672,77]],"For he remembered them, [in] making inquisition for blood: he has not forgotten the supplication of the poor."],["14",[["Ἐλέησόν",446,198],["με",6,82],["Κύριε",7,250],["ἴδε",713,17],["τὴν",1,9],["ταπείνωσίν",1481,10],["μου",6,48],["ἐκ",21,1],["τῶν",1,76],["ἐχθρῶν",135,77],["μου",6,48],["ὁ",1,4],["ὑψῶν",331,67],["με",6,82],["ἐκ",21,1],["τῶν",1,123],["πυλῶν",162,61],["τοῦ",1,30],["θανάτου",170,21]],"Have mercy upon me, O Lord; look upon my affliction [which I suffer] of mine enemies, thou that liftest me up from the gates of death:"],["15",[["Ὅπως",240,8],["ἂν",83,12],["ἐξαγγείλω",2532,227],["πάσας",11,109],["τὰς",1,39],["αἰνέσεις",402,159],["σου",5,146],["ἐν",4,1],["ταῖς",1,70],["πύλαις",162,71],["τῆς",1,18],["θυγατρὸς",97,19],["Σιών",334,2],["ἀγαλλιάσομαι",738,177],["ἐπὶ",9,1],["τῷ",1,110],["σωτηρίῳ",1788,111],["σου",5,146]],"that I may declare all thy praises in the gates of the daughter of Sion: I will exult in thy salvation."],["16",[["Ἐνεπάγησαν",2997,94],["ἔθνη",60,43],["ἐν",4,1],["διαφθορᾷ",1671,2],["ᾗ",24,102],["ἐποίησαν",23,141],["ἐν",4,1],["παγίδι",817,2],["ταύτῃ",16,200],["ᾗ",24,102],["ἔκρυψαν",372,141],["συνελήφθη",507,38],["ὁ",1,4],["ποὺς",210,5],["αὐτῶν",3,41]],"The heathen are caught in the destruction which they planned: in the very snare which they hid is their foot taken."],["17",[["Γινώσκεται",79,108],["Κύριος",7,5],["κρίματα",267,63],["ποιῶν",23,67],["ἐν",4,1],["τοῖς",1,91],["ἔργοις",105,92],["τῶν",1,123],["χειρῶν",37,61],["αὐτοῦ",3,48],["συνελήφθη",507,38],["ὁ",1,4],["ἁμαρτωλός",409,16],["ᾠδὴ",776,13],["διαψάλματος",689,24]],"The Lord is known as executing judgments: the sinner is taken in the works of his hands. A song of Pause."],["18",[["Ἀποστραφήτωσαν",130,50],["οἱ",1,128],["ἁμαρτωλοὶ",409,130],["εἰς",8,1],["τὸν",1,6],["ᾅδην",586,7],["πάντα",11,59],["τὰ",1,42],["ἔθνη",60,43],["τὰ",1,42],["ἐπιλανθανόμενα",513,203],["τοῦ",1,30],["Θεοῦ",20,21]],"Let sinners be driven away into Hades, [even] all the nations that forget God."],["19",[["Ὅτι",19,8],["οὐκ",12,17],["εἰς",8,1],["τέλος",373,33],["ἐπιλησθήσεται",513,125],["ὁ",1,4],["πτωχὸς",497,5],["ἡ",1,11],["ὑπομονὴ",1616,13],["τῶν",1,76],["πενήτων",672,77],["οὐκ",12,17],["ἀπολεῖται",217,89],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7]],"For the poor shall not be forgotten for ever: the patience of the needy ones shall not perish for ever."],["20",[["Ἀνάστηθι",121,198],["Κύριε",7,250],["μὴ",25,8],["κραταιούσθω",729,340],["ἄνθρωπος",43,5],["κριθήτωσαν",263,50],["ἔθνη",60,43],["ἐνώπιόν",115,1],["σου",5,146]],"Arise, O Lord, let not man prevail: let the heathen be judged before thee."],["21",[["Κατάστησον",314,198],["Κύριε",7,250],["νομοθέτην",7766,7],["ἐπʼ",9,1],["αὐτοὺς",3,60],["γνώτωσαν",79,261],["ἔθνη",60,43],["ὅτι",19,8],["ἀνθρωποί",43,166],["εἰσι",10,191],["διάψαλμα",689,20]],"Appoint, O Lord, a lawgiver over them: let the heathen know that they are men. Pause."],["22",[["Ἱνατί",102,238],["Κύριε",7,250],["ἀφέστηκας",293,172],["μακρόθεν",1249,17],["ὑπερορᾷς",2554,199],["ἐν",4,1],["εὐκαιρίαις",3828,71],["ἐν",4,1],["θλίψει",438,2]],"Why standest thou afar off, O Lord? [why] dost thou overlook [us] in times of need, in affliction?"],["23",[["Ἐν",4,1],["τῷ",1,110],["ὑπερηφανεύεσθαι",3771,104],["τὸν",1,6],["ἀσεβῆ",247,59],["ἐμπυρίζεται",3430,108],["ὁ",1,4],["πτωχὸς",497,5],["συλλαμβάνονται",507,299],["ἐν",4,1],["διαβουλίοις",2704,92],["οἷς",24,337],["διαλογίζονται",2573,299]],"While the ungodly one acts proudly, the poor is hotly pursued: [the wicked] are taken in the crafty counsels which they imagine."],["24",[["Ὅτι",19,8],["ἐπαινεῖται",1534,108],["ὁ",1,4],["ἁμαρτωλὸς",409,16],["ἐν",4,1],["ταῖς",1,70],["ἐπιθυμίαις",699,71],["τῆς",1,18],["ψυχῆς",63,19],["αὐτοῦ",3,48],["καὶ",2,8],["ὁ",1,4],["ἀδικῶν",760,67],["ἐνευλογεῖται",3433,108]],"Because the sinner praises himself for the desires of his heart; and the unjust one blesses himself."],["25",[["Παρώξυνε",1044,14],["τὸν",1,6],["Κύριον",7,7],["ὁ",1,4],["ἁμαρτωλὸς",409,16],["κατὰ",32,1],["τὸ",1,32],["πλῆθος",200,33],["τῆς",1,18],["ὀργῆς",198,19],["αὐτοῦ",3,48],["οὐκ",12,17],["ἐκζητήσει",460,120],["οὐκ",12,17],["ἔστιν",10,87],["ὁ",1,4],["Θεὸς",20,5],["ἐνώπιον",115,1],["αὐτοῦ",3,48]],"The sinner has provoked the Lord: according to the abundance of his pride he will not seek after [him]: God is not before him."],["26",[["Βεβηλοῦνται",608,299],["αἱ",1,185],["ὁδοὶ",68,180],["αὐτοῦ",3,48],["ἐν",4,1],["παντὶ",11,111],["καιρῷ",132,113],["ἀνταναιρεῖται",2982,108],["τὰ",1,42],["κρίματά",267,43],["σου",5,146],["ἀπὸ",17,1],["προσώπου",47,24],["αὐτοῦ",3,144],["πάντων",11,163],["τῶν",1,76],["ἐχθρῶν",135,77],["αὐτοῦ",3,48],["κατακυριεύσει",2084,120]],"His ways are profane at all times; thy judgments are removed from before him: he will gain the mastery over all his enemies."],["27",[["Εἶπε",18,3],["γὰρ",40,12],["ἐν",4,1],["καρδίᾳ",64,2],["αὐτοῦ",3,48],["οὐ",12,17],["μὴ",25,8],["σαλευθῶ",678,555],["ἀπὸ",17,1],["γενεᾶς",286,19],["εἰς",8,1],["γενεὰν",286,10],["ἄνευ",1101,1],["κακοῦ",161,88]],"For he has said in his heart, I shall not be moved, [continuing] without evil from generation to generation."],["28",[["Οὗ",120,17],["ἀρᾶς",1213,19],["τὸ",1,32],["στόμα",123,33],["αὐτοῦ",3,48],["γέμει",3256,87],["καὶ",2,8],["πικρίας",1557,19],["καὶ",2,8],["δόλου",919,21],["ὑπὸ",122,1],["τὴν",1,9],["γλῶσσαν",388,10],["αὐτοῦ",3,48],["κόπος",1345,5],["καὶ",2,8],["πόνος",566,5]],"Whose mouth is full of cursing, and bitterness, and fraud: under his tongue are trouble and pain."],["29",[["Ἐγκάθηται",1860,506],["ἔνεδρα",1371,63],["μετὰ",29,1],["πλουσίων",952,115],["ἐν",4,1],["ἀποκρύφοις",1697,215],["τοῦ",1,30],["ἀποκτεῖναι",300,100],["ἀθῶον",1079,28],["οἱ",1,128],["ὀφθαλμοὶ",91,51],["αὐτοῦ",3,48],["εἰς",8,1],["τὸν",1,6],["πένητα",672,7],["ἀποβλέπουσιν",4033,191]],"He lies in wait with rich [men] in secret places, in order to slay the innocent: his eyes are set against the poor."],["30",[["Ἐνεδρεύει",1490,87],["ἐν",4,1],["ἀποκρύφῳ",1697,111],["ὡς",36,8],["λέων",424,5],["ἐν",4,1],["τῇ",1,95],["μάνδρᾳ",2368,2],["αὐτοῦ",3,48],["ἐνεδρεύει",1490,87],["τοῦ",1,30],["ἁρπάσαι",1214,100],["πτωχὸν",497,7],["ἁρπάσαι",1214,100],["πτωχὸν",497,7],["ἐν",4,1],["τῷ",1,110],["ἑλκύσαι",1217,100],["αὐτόν",3,82],["ἐν",4,1],["τῇ",1,95],["παγίδι",817,2],["αὐτοῦ",3,48]],"He lies in wait in secret as a lion in his den: he lies in wait to ravish the poor, to ravish the poor when he draws him [after him]: he will bring him down in his snare."],["31",[["ταπεινώσει",322,120],["αὐτὸν",3,82],["κύψει",1964,120],["καὶ",2,8],["πεσεῖται",154,89],["ἐν",4,1],["τῷ",1,110],["αὐτὸν",3,82],["κατακυριεῦσαι",2084,100],["τῶν",1,76],["πενήτων",672,77]],"He will bow down and fall when he has mastered the poor."],["32",[["Εἶπε",18,3],["γὰρ",40,12],["ἐν",4,1],["τῇ",1,95],["καρδίᾳ",64,2],["αὐτοῦ",3,48],["ἐπιλέλησται",513,182],["ὁ",1,4],["Θεὸς",20,5],["ἀπέστρεψε",130,3],["τὸ",1,32],["πρόσωπον",47,33],["αὐτοῦ",3,48],["τοῦ",1,30],["μὴ",25,8],["βλέπειν",470,54],["εἰς",8,1],["τέλος",373,33]],"For he has said in his heart, God has forgotten: he has turned away his face so as never to look."],["33",[["Ἀνάστηθι",121,198],["Κύριε",7,250],["ὁ",1,4],["Θεὸς",20,5],["ὑψωθήτω",331,25],["ἡ",1,11],["χείρ",37,13],["σου",5,146],["μὴ",25,8],["ἐπιλάθῃ",513,160],["τῶν",1,76],["πενήτων",672,77]],"Arise, O Lord God; let thy hand be lifted up: forget not the poor."],["34",[["Ἕνεκεν",447,1],["τίνος",39,304],["παρώξυνεν",1044,14],["ὁ",1,4],["ἀσεβὴς",247,16],["τὸν",1,6],["Θεόν",20,7],["εἶπε",18,3],["γὰρ",40,12],["ἐν",4,1],["καρδίᾳ",64,2],["αὐτοῦ",3,48],["οὐ",12,17],["ζητήσει",191,120]],"Wherefore has the wicked provoked God? for he has said in his heart, He will not require [it]."],["35",[["Βλέπεις",470,145],["ὅτι",19,8],["σὺ",5,156],["πόνον",566,7],["καὶ",2,8],["θυμὸν",178,7],["κατανοεῖς",1549,145],["τοῦ",1,30],["παραδοῦναι",254,100],["αὐτοὺς",3,60],["εἰς",8,1],["χεῖράς",37,40],["σου",5,146],["σοὶ",5,151],["ἐγκαταλέλειπται",364,182],["ὁ",1,4],["πτωχὸς",497,5],["ὀρφανῷ",957,111],["σὺ",5,156],["ἦσθα",10,217],["βοηθός",947,5]],"Thou seest [it]; for thou dost observe trouble and wrath, to deliver them into thy hands: the poor has been left to thee; thou wast a helper to the orphan."],["36",[["Σύντριψον",268,198],["τὸν",1,6],["βραχίονα",618,59],["τοῦ",1,30],["ἁμαρτωλοῦ",409,153],["καὶ",2,8],["πονηροῦ",164,153],["ζητηθήσεται",191,125],["ἡ",1,11],["ἁμαρτία",119,13],["αὐτοῦ",3,48],["καὶ",2,8],["οὐ",12,17],["μὴ",25,8],["εὑρεθῇ",101,333]],"Break thou the arm of the sinner and wicked man: his sin shall be sought for, and shall not be found."],["37",[["Βασιλεύσει",151,120],["Κύριος",7,5],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["καὶ",2,8],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["τοῦ",1,30],["αἰῶνος",100,21],["ἀπολεῖσθε",217,117],["ἔθνη",60,43],["ἐκ",21,1],["τῆς",1,18],["γῆς",26,19],["αὐτοῦ",3,48]],"The Lord shall reign for ever, even for ever and ever: ye Gentiles shall perish out of his land."],["38",[["Τὴν",1,9],["ἐπιθυμίαν",699,10],["τῶν",1,76],["πενήτων",672,77],["εἰσήκουσε",241,3],["Κύριος",7,5],["τὴν",1,9],["ἑτοιμασίαν",2679,10],["τῆς",1,18],["καρδίας",64,19],["αὐτῶν",3,41],["προσέσχε",558,3],["τὸ",1,32],["οὖς",328,33],["σου",5,146]],"The Lord has heard the desire of the poor: thine ear has inclined to the preparation of their heart;"],["39",[["Κρῖναι",263,100],["ὀρφανῷ",957,111],["καὶ",2,8],["ταπεινῷ",1097,111],["ἵνα",102,8],["μὴ",25,8],["προσθῇ",201,160],["ἔτι",111,17],["μεγαλαυχεῖν",3889,54],["ἄνθρωπος",43,5],["ἐπὶ",9,1],["τῆς",1,18],["γῆς",26,19]],"to plead for the orphan and afflicted, that man may no more boast upon the earth."]]