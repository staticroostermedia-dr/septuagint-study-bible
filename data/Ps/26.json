[["1",[["Τοῦ",1,30],["Δαυὶδ",52,105],["πρὸ",235,1],["τοῦ",1,30],["χρισθῆναι",713,174],["Κύριος",7,5],["φωτισμός",3676,5],["μου",6,48],["καὶ",2,8],["σώτηρ",1390,5],["μου",6,48],["τίνα",39,368],["φοβηθήσομαι",134,175],["Κύριος",7,5],["ὑπερασπιστὴς",1876,5],["τῆς",1,18],["ζωῆς",212,19],["μου",6,83],["ἀπὸ",17,1],["τίνος",39,308],["δειλιάσω",2448,157]],"[A Psalm] of David, before he was anointed. The Lord is my light and my Saviour; whom shall I fear? the Lord is the defender of my life; of whom shall I be afraid?"],["2",[["Ἐν",4,1],["τῷ",1,110],["ἐγγίζειν",452,54],["ἐπʼ",9,1],["ἐμὲ",6,82],["κακοῦντας",764,229],["τοῦ",1,30],["φαγεῖν",268,100],["τὰς",1,39],["σάρκας",287,40],["μου",6,48],["οἱ",1,128],["θλίβοντες",599,137],["με",6,82],["καὶ",2,8],["οἱ",1,128],["ἐχθροί",135,51],["μου",6,48],["αὐτοὶ",3,193],["ἠσθένησαν",768,141],["καὶ",2,8],["ἔπεσαν",154,141]],"When evil-doers drew nigh against me to eat up my flesh, my persecutors and mine enemies, they fainted and fell."],["3",[["Ἐὰν",45,8],["παρατάξηται",719,236],["ἐπʼ",9,1],["ἐμὲ",6,82],["παρεμβολὴ",189,13],["οὐ",12,17],["φοβηθήσεται",134,125],["ἡ",1,11],["καρδία",63,13],["μου",6,48],["ἐὰν",45,8],["ἐπαναστῇ",1221,160],["ἐπʼ",9,1],["ἐμὲ",6,82],["πόλεμος",163,5],["ἐν",4,1],["ταύτῃ",16,200],["ἐγὼ",6,158],["ἐλπιζω",511,149]],"Though an army should set itself in array against me, my heart shall not be afraid: though war should rise up against me, in this am I confident."],["4",[["Μίαν",57,37],["ᾐτησάμην",615,152],["παρὰ",72,1],["Κυρίου",7,21],["ταύτην",16,234],["ἐκζητήσω",459,157],["τοῦ",1,30],["κατοικεῖν",90,54],["με",6,82],["ἐν",4,1],["οἴκῳ",34,113],["Κυρίου",7,21],["πάσας",11,109],["τὰς",1,39],["ἡμέρας",28,19],["τῆς",1,18],["ζωῆς",212,19],["μου",6,83],["τοῦ",1,30],["θεωρεῖν",898,54],["με",6,98],["τὴν",1,9],["τερπνότητα",6180,10],["Κυρίου",7,21],["καὶ",2,8],["ἐπισκέπτεσθαι",429,104],["τὸν",1,6],["ναὸν",481,7],["αὐτοῦ",3,48]],"One thing have I asked of the Lord, this will I earnestly seek: that I should dwell in the house of the Lord all the days of my life, that I should behold the fair beauty of the Lord, and survey his temple."],["5",[["Ὅτι",19,8],["ἔκρυψέ",378,3],["με",6,82],["ἐν",4,1],["σκηνῇ",131,2],["αὐτοῦ",3,48],["ἐν",4,1],["ἡμέρᾳ",28,2],["κακῶν",161,79],["μου",6,48],["ἐσκέπασέ",1212,3],["με",6,82],["ἐν",4,1],["ἀποκρύφῳ",2664,111],["τῆς",1,18],["σκῆνης",131,19],["αὐτοῦ",3,48],["ἐν",4,1],["πέτρᾳ",546,2],["ὕψωσέ",327,3],["με",6,82]],"For in the day of mine afflictions he hid me in his tabernacle: he sheltered me in the secret of his tabernacle; he set me up on a rock."],["6",[["καὶ",2,8],["νῦν",89,17],["ἰδοὺ",51,17],["ὕψωσε",327,3],["τὴν",1,9],["κεφαλήν",144,10],["μου",6,48],["ἐπʼ",9,1],["ἐχθρούς",135,31],["μου",6,48],["ἐκύκλωσα",600,147],["καὶ",2,8],["ἔθυσα",436,147],["ἐν",4,1],["τῇ",1,95],["σκηνῇ",131,2],["αὐτοῦ",3,48],["θυσίαν",156,10],["ἀλαλαγμοῦ",2991,21],["ᾄσομαι",1080,176],["καὶ",2,8],["ψαλῶ",901,157],["τῷ",1,110],["Κυρίῳ",7,113]],"And now, behold, he has lifted up mine head over mine enemies: I went round and offered in his tabernacle the sacrifice of joy; I will sing, even sing psalms to the Lord."],["7",[["Εἰσάκουσον",237,198],["Κύριε",7,251],["τῆς",1,18],["φωνῆς",95,19],["μου",6,83],["ἧς",24,162],["ἐκέκραξα",590,147],["ἐλέησόν",457,243],["με",6,82],["καὶ",2,8],["εἰσάκουσόν",237,198],["μου",6,48]],"Hear, O Lord, my voice which I have uttered aloud: pity me, and hearken to me."],["8",[["Σοὶ",5,151],["εἶπεν",18,3],["ἡ",1,11],["καρδία",63,13],["μου",6,48],["ἐξεζήτησα",459,147],["τὸ",1,32],["πρόσωπόν",47,33],["σου",5,146],["τὸ",1,32],["πρόσωπόν",47,33],["σου",5,146],["Κύριε",7,251],["ζητήσω",190,157]],"My heart said to thee, I have diligently sought thy face: thy face, O Lord, I will seek."],["9",[["Μὴ",25,8],["ἀποστρέψῃς",130,170],["τὸ",1,32],["πρόσωπόν",47,33],["σου",5,146],["ἀπʼ",17,1],["ἐμοῦ",6,48],["μὴ",25,8],["ἐκκλίνῃς",393,170],["ἐν",4,1],["ὀργῇ",198,2],["ἀπὸ",17,1],["τοῦ",1,30],["δούλου",136,21],["σου",5,146],["βοηθός",948,5],["μου",6,48],["γενοῦ",30,275],["μὴ",25,8],["ἐγκαταλίπῃς",363,170],["με",6,82],["καὶ",2,8],["μὴ",25,8],["ὑπερίδῃς",1498,170],["με",6,82],["ὁ",1,4],["Θεὸς",20,5],["ὁ",1,4],["σωτήρ",1390,5],["μου",6,48]],"Turn not thy face away from me, turn not thou away from thy servant in anger: be thou my helper, forsake me not; and, O God my Saviour, overlook me not."],["10",[["Ὅτι",19,8],["ὁ",1,4],["πατήρ",44,5],["μου",6,48],["καὶ",2,8],["ἡ",1,11],["μήτηρ",188,13],["μου",6,48],["ἐγκατέλιπόν",363,141],["με",6,82],["ὁ",1,4],["δὲ",14,12],["Κύριος",7,5],["προσελάβετό",3127,26],["με",6,82]],"For my father and my mother have forsaken me, but the Lord has taken me to himself."],["11",[["Νομοθέτησόν",2755,243],["με",6,82],["Κύριε",7,251],["ἐν",4,1],["τῇ",1,95],["ὁδῷ",67,2],["σου",5,146],["καὶ",2,8],["ὁδήγησόν",1110,243],["με",6,82],["ἐν",4,1],["τρίβῳ",744,2],["εὐθείᾳ",1137,96],["ἕνεκα",445,1],["τῶν",1,76],["ἐχθρῶν",135,77],["μου",6,48]],"Teach me, O Lord, in thy way, and guide me in a right path, because of mine enemies."],["12",[["Μὴ",25,8],["παραδῷς",254,170],["με",6,82],["εἰς",8,1],["ψυχὰς",62,40],["θλιβόντων",599,164],["με",6,82],["ὅτι",19,8],["ἐπανέστησάν",1221,141],["μοι",6,49],["μάρτυρες",876,51],["ἄδικοι",402,130],["καὶ",2,8],["ἐψεύσατο",1311,26],["ἡ",1,11],["ἀδικία",288,13],["ἑαυτῇ",92,99]],"Deliver me not over to the desire of them that afflict me; for unjust witnesses have risen up against me, and injustice has lied within herself."],["13",[["Πιστεύω",658,149],["τοῦ",1,30],["ἰδεῖν",73,100],["τὰ",1,42],["ἀγαθὰ",113,65],["Κυρίου",7,21],["ἐν",4,1],["γῇ",26,2],["ζώντων",117,164]],"I believe that I shall see the goodness of the Lord in the land of the living."],["14",[["Ὑπόμεινον",635,198],["τὸν",1,6],["Κυριον",7,7],["ἀνδρίζου",1747,360],["καὶ",2,8],["κραταιούσθω",734,344],["ἡ",1,11],["καρδία",63,13],["σου",5,146],["καὶ",2,8],["ὑπόμεινον",635,198],["τὸν",1,6],["Κύριον",7,7]],"Wait on the Lord: be of good courage, and let thy heart be strengthened: yea, wait on the Lord."]]