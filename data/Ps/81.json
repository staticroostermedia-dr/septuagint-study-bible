[["1",[["Ψαλμὸς",644,5],["τῷ",1,110],["Ἀσάφ",1103,5],["Ὁ",1,4],["Θεὸς",20,5],["ἔστη",78,3],["ἐν",4,1],["συναγωγῇ",284,2],["θεῶν",20,77],["ἐν",4,1],["μέσῳ",113,34],["δὲ",14,12],["θεοὺς",20,31],["διακρινεῖ",1506,120]],"A Psalm for Asaph. God stands in the assembly of gods; and in the midst [of them] will judge gods."],["2",[["Ἕως",42,8],["πότε",458,12],["κρίνετε",263,307],["ἀδικίαν",288,10],["καὶ",2,8],["πρόσωπα",47,43],["ἁμαρτωλῶν",409,163],["λαμβάνετε",46,84],["διάψαλμα",689,20]],"How long will ye judge unrighteously, and accept the persons of sinners? Pause."],["3",[["Κρίνατε",263,69],["ὀρφανὸν",957,28],["καὶ",2,8],["πτωχὸν",497,20],["ταπεινὸν",1097,28],["καὶ",2,8],["πένητα",672,7],["δικαιώσατε",1115,69]],"Judge the orphan and poor: do justice to the low and needy."],["4",[["Εξέλεσθε",0,0],["πένητα",672,7],["καὶ",2,8],["πτωχὸν",497,7],["ἐκ",21,1],["χειρὸς",37,19],["ἁμαρτωλοῦ",409,78],["ῥύσασθε",337,268]],"Rescue the needy, and deliver the poor out of the hand of the sinner."],["5",[["Οὐκ",12,17],["ἔγνωσαν",79,141],["οὐδὲ",106,12],["συνῆκαν",606,141],["ἐν",4,1],["σκότει",506,53],["διαπορεύονται",1113,299],["σαλευθήσονται",678,135],["πάντα",11,65],["τὰ",1,42],["θεμελια",950,43],["τῆς",1,18],["γῆς",26,19]],"They know not, nor understand; they walk on in darkness: all the foundations of the earth shall be shaken."],["6",[["Ἐγὼ",6,158],["εἶπα",18,147],["θεοί",20,51],["ἐστε",10,84],["καὶ",2,8],["υἱοὶ",13,51],["ὑψίστου",474,153],["πάντες",11,130]],"I have said, Ye are gods; and all [of you] children of the Most High."],["7",[["Ὑμεῖς",5,208],["δὲ",14,12],["ὡς",36,8],["ἄνθρωποι",43,51],["ἀποθνήσκετε",109,84],["καὶ",2,8],["ὡς",36,8],["εἷς",58,16],["τῶν",1,76],["ἀρχόντων",96,77],["πίπτετε",154,84]],"But ye die as men, and fall as one of the princes."],["8",[["Ἀνάστα",121,275],["ὁ",1,4],["Θεὸς",20,5],["κρῖνον",263,36],["τὴν",1,9],["γῆν",26,10],["ὅτι",19,8],["σὺ",5,156],["κατακληρονομήσεις",907,159],["ἐν",4,1],["πᾶσι",11,90],["τοῖς",1,91],["ἔθνεσιν",60,92]],"Arise, O God, judge the earth: for thou shalt inherit all nations."]]