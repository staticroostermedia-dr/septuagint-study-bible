[["1",[["Ψαλμὸς",639,5],["τῷ",1,110],["Ἀσάφ",1105,5],["Ὁ",1,4],["Θεὸς",20,5],["ἔστη",78,3],["ἐν",4,1],["συναγωγῇ",284,2],["θεῶν",20,77],["ἐν",4,1],["μέσῳ",112,34],["δὲ",14,12],["θεοὺς",20,31],["διακρινεῖ",1507,120]],"A Psalm for Asaph. God stands in the assembly of gods; and in the midst [of them] will judge gods."],["2",[["Ἕως",42,8],["πότε",455,12],["κρίνετε",240,311],["ἀδικίαν",288,10],["καὶ",2,8],["πρόσωπα",47,43],["ἁμαρτωλῶν",406,163],["λαμβάνετε",46,84],["διάψαλμα",687,20]],"How long will ye judge unrighteously, and accept the persons of sinners? Pause."],["3",[["Κρίνατε",240,69],["ὀρφανὸν",959,28],["καὶ",2,8],["πτωχὸν",496,20],["ταπεινὸν",1100,28],["καὶ",2,8],["πένητα",668,7],["δικαιώσατε",1134,69]],"Judge the orphan and poor: do justice to the low and needy."],["4",[["Εξέλεσθε",0,0],["πένητα",668,7],["καὶ",2,8],["πτωχὸν",496,7],["ἐκ",21,1],["χειρὸς",37,19],["ἁμαρτωλοῦ",406,78],["ῥύσασθε",335,268]],"Rescue the needy, and deliver the poor out of the hand of the sinner."],["5",[["Οὐκ",12,17],["ἔγνωσαν",81,141],["οὐδὲ",105,12],["συνῆκαν",602,141],["ἐν",4,1],["σκότει",503,53],["διαπορεύονται",1114,303],["σαλευθήσονται",679,135],["πάντα",11,65],["τὰ",1,42],["θεμελια",950,43],["τῆς",1,18],["γῆς",26,19]],"They know not, nor understand; they walk on in darkness: all the foundations of the earth shall be shaken."],["6",[["Ἐγὼ",6,158],["εἶπα",18,147],["θεοί",20,51],["ἐστε",10,84],["καὶ",2,8],["υἱοὶ",13,51],["ὑψίστου",473,153],["πάντες",11,130]],"I have said, Ye are gods; and all [of you] children of the Most High."],["7",[["Ὑμεῖς",5,208],["δὲ",14,12],["ὡς",36,8],["ἄνθρωποι",43,51],["ἀποθνήσκετε",108,84],["καὶ",2,8],["ὡς",36,8],["εἷς",57,16],["τῶν",1,76],["ἀρχόντων",96,77],["πίπτετε",154,84]],"But ye die as men, and fall as one of the princes."],["8",[["Ἀνάστα",121,275],["ὁ",1,4],["Θεὸς",20,5],["κρῖνον",240,36],["τὴν",1,9],["γῆν",26,10],["ὅτι",19,8],["σὺ",5,156],["κατακληρονομήσεις",909,159],["ἐν",4,1],["πᾶσι",11,90],["τοῖς",1,91],["ἔθνεσιν",59,92]],"Arise, O God, judge the earth: for thou shalt inherit all nations."]]