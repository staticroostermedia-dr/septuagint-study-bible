[["1",[["Εἰς",8,1],["τὸ",1,32],["τέλος",373,33],["ψαλμὸς",644,5],["τῷ",1,110],["Δαυίδ",52,105],["Κύριε",7,250],["ἐδοκίμασάς",1269,154],["με",6,82],["καὶ",2,8],["ἔγνως",79,154],["με",6,82]],"For the end, a Psalm of David. O Lord, thou hast proved me, and known me."],["2",[["Σὺ",5,156],["ἔγνως",79,154],["τὴν",1,9],["καθέδραν",2083,10],["μου",6,48],["καὶ",2,8],["τὴν",1,9],["ἔγερσίν",6546,10],["μου",6,48],["σὺ",5,156],["συνῆκας",606,154],["τοὺς",1,56],["διαλογισμούς",1584,31],["μου",6,48],["ἀπὸ",17,1],["μακρόθεν",1249,17]],"Thou knowest my down-sitting and mine up-rising: thou understandest my thoughts long before."],["3",[["Τὴν",1,9],["τρίβον",745,10],["μου",6,48],["καὶ",2,8],["τὴν",1,9],["σχοῖνόν",3967,7],["μου",6,48],["ἑξιχνίασας",2223,0],["καὶ",2,8],["πάσας",11,109],["τὰς",1,39],["ὁδούς",68,40],["μου",6,48],["προεῖδες",5985,154]],"Thou hast traced my path and my bed, and hast foreseen all my ways."],["4",[["ὅτι",19,8],["οὐκ",12,17],["ἔστι",10,87],["λόγος",48,5],["ἄδικος",406,16],["ἐν",4,1],["γλώσσῃ",388,2],["μου",6,48],["ἰδοὺ",51,17],["Κύριε",7,250],["σὺ",5,156],["ἔγνως",79,154],["πάντα",11,65]],"For there is no unrighteous word in my tongue: behold, O Lord, thou hast known all things,"],["5",[["τὰ",1,42],["ἔσχατα",410,65],["καὶ",2,8],["τὰ",1,42],["ἀρχαῖα",1570,65],["σὺ",5,156],["ἔπλασάς",910,154],["με",6,82],["καὶ",2,8],["ἔθηκας",110,154],["ἐπʼ",9,1],["ἐμὲ",6,98],["τὴν",1,9],["χεῖρά",37,10],["σου",5,146]],"the last and the first: thou hast fashioned me, and laid thine hand upon me."],["6",[["Ἐθαυμαστώθη",3060,38],["ἡ",1,11],["γνῶσίς",753,13],["σου",5,146],["ἐξ",21,1],["ἐμοῦ",6,48],["ἐκραταιώθη",729,38],["οὐ",12,17],["μὴ",25,8],["δύνωμαι",185,397],["πρὸς",15,1],["αὐτήν",3,98]],"The knowledge of thee is too wonderful for me; it is very difficult, I cannot [attain] to it."],["7",[["Ποῦ",478,17],["πορευθῶ",49,555],["ἀπὸ",17,1],["τοῦ",1,23],["πνεύματός",168,24],["σου",5,146],["καὶ",2,8],["ἀπὸ",17,1],["τοῦ",1,23],["προσώπου",47,24],["σου",5,146],["ποῦ",478,17],["φύγω",264,227]],"Whither shall I go from thy Spirit? and whither shall I flee from thy presence?"],["8",[["Ἐὰν",45,8],["ἀναβῶ",88,227],["εἰς",8,1],["τὸν",1,6],["οὐρανὸν",94,7],["σὺ",5,156],["ἐκεῖ",76,17],["εἶ",10,145],["ἐὰν",45,8],["καταβῶ",175,227],["εἰς",8,1],["τὸν",1,6],["ᾅδην",586,7],["πάρει",899,145]],"If I should go up to heaven, thou art there: if I should go down to hell, thou art present."],["9",[["Ἐὰν",45,8],["ἀναλάβω",575,227],["τὰς",1,39],["πτέρυγάς",719,40],["μου",6,48],["κατʼ",32,1],["ὀρθὸν",1537,28],["καὶ",2,8],["κατασκηνώσω",805,157],["εἰς",8,1],["τὰ",1,42],["ἔσχατα",410,65],["τῆς",1,18],["θαλάσσης",137,19]],"If I should spread my wings [to fly] straight forward, and sojourn at the extremity of the sea, [it would be vain],"],["10",[["καὶ",2,8],["γὰρ",40,12],["ἐκεῖ",76,17],["ἡ",1,11],["χείρ",37,13],["σου",5,146],["ὁδηγήσει",1108,120],["με",6,82],["καὶ",2,8],["καθέξει",1040,120],["με",6,82],["ἡ",1,11],["δεξιά",282,15],["σου",5,146]],"for even there thy hand would guide me, and thy right hand would hold me."],["11",[["Καὶ",2,8],["εἶπα",18,147],["ἄρα",985,12],["σκότος",506,5],["καταπατήσει",1117,120],["με",6,82],["καὶ",2,8],["νὺξ",219,13],["φωτισμὸς",3670,5],["ἐν",4,1],["τῇ",1,95],["τρυφῇ",1643,2],["μου",6,48]],"When I said, Surely the darkness will cover me; even the night [was] light in my luxury."],["12",[["Ὅτι",19,8],["σκότος",506,5],["οὐ",12,17],["σκοτισθήσεται",3951,125],["ἀπὸ",17,1],["σοῦ",5,146],["καὶ",2,8],["νὺξ",219,13],["ὡς",36,8],["ἡμέρα",28,13],["φωτισθήσεται",1230,125],["ὡς",36,8],["τὸ",1,32],["σκότος",506,5],["αὐτῆς",3,83],["οὕτως",71,17],["καὶ",2,8],["τὸ",1,27],["φῶς",380,20],["αὐτῆς",3,83]],"For darkness will not be darkness with thee; but night will be light as day: as its darkness, so shall its light [be to thee]."],["13",[["Ὅτι",19,8],["σὺ",5,156],["ἐκτήσω",564,169],["τοὺς",1,56],["νεφρούς",1414,31],["μου",6,48],["Κύριε",7,250],["ἀντελάβου",984,169],["μου",6,83],["ἐκ",21,1],["γαστρὸς",777,19],["μητρός",189,19],["μου",6,83]],"For thou, O Lord, hast possessed my reins; thou hast helped me from my mother's womb."],["14",[["Ἐξομολογήσομαί",479,177],["σοι",5,151],["ὅτι",19,8],["φοβερῶς",1210,17],["ἐθαυμαστώθης",3060,360],["θαυμάσια",884,65],["τὰ",1,42],["ἔργα",105,43],["σου",5,146],["καὶ",2,8],["ἡ",1,11],["ψυχή",63,13],["μου",6,48],["γινώσκει",79,87],["σφόδρα",150,17]],"I will give thee thanks; for thou art fearfully wondrous; wondrous are thy works; and my soul knows [it] well."],["15",[["Οὐκ",12,17],["ἐκρύβη",372,38],["τὸ",1,32],["ὀστοῦν",473,33],["μου",6,48],["ἀπὸ",17,1],["σοῦ",5,146],["ὃ",1,4],["ἐποίησας",23,154],["ἐν",4,1],["κρυφῇ",372,333],["καὶ",2,8],["ἡ",1,11],["ὑπόστασίς",1877,13],["μου",6,48],["ἐν",4,1],["τοῖς",1,138],["κατωτάτω",3285,453],["τῆς",1,18],["γῆς",26,19]],"My bones which thou madest in secret were not hidden from thee, nor my substance, in the lowest parts of the earth."],["16",[["Ἀκατέργαστόν",8774,28],["μου",6,48],["εἶδου",53,169],["οἱ",1,128],["ἀφθαλμοί",0,0],["σου",5,146],["καὶ",2,8],["ἐπὶ",9,1],["τὸ",1,32],["βιβλίον",339,33],["σου",5,146],["πάντες",11,130],["γραφήσονται",186,135],["ἡμέρας",28,19],["πλασθήσονται",910,135],["καὶ",2,8],["οὐθεὶς",228,16],["ἐν",4,1],["αὐτοῖς",3,142]],"Thine eyes saw my unwrought [substance], and all [men] shall be written in thy book; they shall be formed by day, though [there should for a time] be no one among them."],["17",[["Ἐμοὶ",6,49],["δὲ",14,12],["λίαν",1898,17],["ἐτιμήθησαν",1020,94],["οἱ",1,128],["φίλοι",336,130],["σου",5,146],["ὁ",1,4],["Θεὸς",20,5],["λίαν",1898,17],["ἐκραταιώθησαν",729,94],["αἱ",1,185],["ἀρχαὶ",270,180],["αὐτῶν",3,41]],"But thy friends, O God, have been greatly honoured by me; their rule has been greatly strengthened."],["18",[["Ἐξαριθμήσομαι",1932,177],["αὐτοὺς",3,60],["καὶ",2,8],["ὑπὲρ",139,1],["ἄμμον",435,10],["πληθυνθήσονται",316,135],["ἐξηγέρθην",656,148],["καὶ",2,8],["ἔτι",111,17],["εἰμὶ",10,149],["μετὰ",29,1],["σοῦ",5,146]],"I will number them, and they shall be multiplied beyond the sand; I awake, and am still with thee."],["19",[["Ἐὰν",45,8],["ἀποκτείνῃς",300,170],["ἁμαρτωλοὺς",409,58],["ὁ",1,4],["Θεός",20,5],["ἄνδρες",38,51],["αἱμάτων",148,45],["ἐκκλίνατε",394,69],["ἀπʼ",17,1],["ἐμοῦ",6,48]],"Oh that thou wouldest slay the wicked, O God; depart from me, ye men of blood."],["20",[["ὅτι",19,8],["ἐρεῖς",165,159],["εἰς",8,1],["διαλογισμόν",1584,7],["λήψονται",46,127],["εἰς",8,1],["ματαιότητα",937,10],["τὰς",1,39],["πόλεις",41,40],["σου",5,146]],"For thou wilt say concerning [their] thought, [that] they shall take thy cities in vain."],["21",[["Οὐχὶ",330,12],["τοὺς",1,56],["μισοῦντάς",351,229],["σε",5,161],["Κύριε",7,250],["ἐμίσησα",351,147],["καὶ",2,8],["ἐπὶ",9,1],["τοὺς",1,56],["ἐχθρούς",135,31],["σου",5,146],["ἐξετηκόμην",3185,374]],"Have I not hated them, O Lord, that hate thee? and wasted away because of thine enemies?"],["22",[["Τέλειον",1919,28],["μῖσος",2604,20],["ἐμίσουν",351,129],["αὐτοὺς",3,60],["εἰς",8,1],["ἐχθροὺς",135,31],["ἐγένοντό",30,184],["μοι",6,49]],"I have hated them with perfect hatred; they were counted my enemies."],["23",[["Δοκίμασόν",1269,198],["με",6,82],["ὁ",1,4],["Θεὸς",20,5],["καὶ",2,8],["γνῶθι",79,198],["τὴν",1,9],["καρδίαν",64,10],["μου",6,48],["ἔτασόν",2227,198],["με",6,82],["καὶ",2,8],["γνῶθι",79,198],["τὰς",1,39],["τρίβους",745,40],["μου",6,48]],"Prove me, O God, and know my heart; examine me, and know my paths;"],["24",[["Καὶ",2,8],["ἴδε",713,17],["εἰ",77,8],["ὁδὸς",68,13],["ἀνομίας",275,19],["ἐν",4,1],["ἐμοὶ",6,49],["καὶ",2,8],["ὁδήγησόν",1108,198],["με",6,82],["ἐν",4,1],["ὁδῷ",68,2],["αἰωνίᾳ",391,96]],"and see if [there is any] way of iniquity in me, and lead me in an everlasting way."]]