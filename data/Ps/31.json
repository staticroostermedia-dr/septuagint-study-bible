[["1",[["Συνέσεως",469,19],["τῷ",1,110],["Δαυίδ",52,105],["Μακάριοι",806,130],["ὧν",24,97],["ἀφέθησαν",501,94],["αἱ",1,185],["ἀνομίαι",275,180],["καὶ",2,8],["ὧν",24,97],["ἐπεκαλύφθησαν",1997,94],["αἱ",1,185],["ἁμαρτίαι",119,180]],"[A Psalm] of instruction by David. Blessed [are they] whose transgressions are forgiven, and whose sins are covered."],["2",[["Μακάριος",806,16],["ἀνὴρ",38,5],["ᾧ",24,202],["οὐ",12,17],["μὴ",25,8],["λογίσηται",495,411],["Κύριος",7,5],["ἁμαρτίαν",119,10],["οὐδέ",106,12],["ἐστιν",10,87],["ἐν",4,1],["τῷ",1,52],["στόματι",123,53],["αὐτοῦ",3,48],["δόλος",919,5]],"Blessed is the man to whom the Lord will not impute sin, and in whose mouth there is no guile."],["3",[["Ὅτι",19,8],["ἐσίγησα",1915,147],["ἐπαλαιώθη",1384,38],["τὰ",1,42],["ὀστᾶ",473,43],["μου",6,48],["ἀπὸ",17,1],["τοῦ",1,30],["κράζειν",592,54],["με",6,98],["ὅλην",235,37],["τὴν",1,9],["ἡμέραν",28,10]],"Because I kept silence, my bones waxed old, from my crying all the day."],["4",[["Ὅτι",19,8],["ἡμέρας",28,19],["καὶ",2,8],["νυκτὸς",219,19],["ἐβαρύνθη",1013,38],["ἐπʼ",9,1],["ἐμὲ",6,82],["ἡ",1,11],["χείρ",37,13],["σου",5,146],["ἐστράφην",1078,148],["εἰς",8,1],["ταλαιπωρίαν",1448,10],["ἐν",4,1],["τῷ",1,110],["ἐμπαγῆναι",2997,175],["ἄκανθαν",1571,10],["διάψαλμα",689,20]],"For day and night thy hand was heavy upon me: I became thoroughly miserable while a thorn was fastened in [me]. Pause."],["5",[["Τὴν",1,9],["ἁμαρτίαν",119,10],["μου",6,48],["ἐγνώρισα",748,147],["καὶ",2,8],["τὴν",1,9],["ἀνομίαν",275,10],["μου",6,48],["οὐκ",12,17],["ἐκάλυψα",620,147],["εἶπα",18,147],["ἐξαγορεύσω",2420,157],["κατʼ",32,1],["ἐμοῦ",6,48],["τὴν",1,9],["ἀνομίαν",275,10],["μου",6,48],["τῷ",1,110],["Κυρίῳ",7,113],["καὶ",2,8],["σὺ",5,156],["ἀφῆκας",501,154],["τὴν",1,9],["ἀσέβειαν",722,10],["τῆς",1,18],["καρδίας",64,19],["μου",6,83],["διάψαλμα",689,20]],"I acknowledged my sin, and hid not mine iniquity: I said, I will confess mine iniquity to the Lord against myself; and thou forgavest the ungodliness of my heart. Pause."],["6",[["Ὑπὲρ",139,1],["ταύτης",16,290],["προσεύξεται",551,89],["πρὸς",15,1],["σὲ",5,161],["πᾶς",11,16],["ὅσιος",917,16],["ἐν",4,1],["καιρῷ",132,113],["εὐθέτῳ",5633,111],["πλὴν",257,1],["ἐν",4,1],["κατακλυσμῷ",1676,113],["ὑδάτων",85,45],["πολλῶν",74,79],["πρὸς",15,1],["αὐτὸν",3,82],["οὐκ",12,17],["ἐγγιοῦσι",0,0]],"Therefore shall every holy one pray to thee in a fit time: only in the deluge of many waters they shall not come nigh to him."],["7",[["Σύ",5,156],["μου",6,48],["εἶ",10,145],["καταφυγὴ",1678,13],["ἀπὸ",17,1],["θλίψεως",438,19],["τῆς",1,18],["περιεχούσης",1353,212],["με",6,82],["τὸ",1,32],["ἀγαλλίαμά",1794,33],["μου",6,48],["λύτρωσαί",535,275],["με",6,82],["ἀπὸ",17,1],["τῶν",1,76],["κυκλωσάντων",603,211],["με",6,82],["διάψαλμα",689,20]],"Thou art my refuge from the affliction that encompasses me; my joy, to deliver me from them that have compassed me. Pause."],["8",[["Συνετιῶ",2194,157],["σε",5,161],["καὶ",2,8],["συμβιβῶ",2775,157],["σε",5,161],["ἐν",4,1],["ὁδῷ",68,2],["ταύτῃ",16,200],["ᾗ",24,102],["πορεύσῃ",49,116],["ἐπιστηριῶ",2676,157],["ἐπὶ",9,1],["σὲ",5,161],["τοὺς",1,56],["ὀφθαλμούς",91,31],["μου",6,48]],"I will instruct thee and guide thee in this way wherein thou shalt go: I will fix mine eyes upon thee."],["9",[["Μὴ",25,8],["γίνεσθε",30,382],["ὡς",36,8],["ἵππος",309,5],["καὶ",2,8],["ἡμίονος",1713,5],["οἷς",24,292],["οὐκ",12,17],["ἔστι",10,87],["σύνεσις",469,13],["ἐν",4,1],["χαλινῷ",3671,113],["καὶ",2,8],["κημῷ",4852,113],["τὰς",1,39],["σιαγόνας",1784,40],["αὐτῶν",3,41],["ἄγξαι",5258,100],["τῶν",1,76],["μὴ",25,8],["ἐγγιζόντων",0,0],["πρὸς",15,1],["σέ",5,161]],"Be ye not as horse and mule, which have no understanding: [but thou must] constrain their jaws with bit and curb, lest they should come nigh to thee."],["10",[["Πολλαὶ",74,187],["αἱ",1,185],["μάστιγες",1308,180],["τοῦ",1,30],["ἁμαρτωλοῦ",409,153],["τὸν",1,6],["δὲ",14,12],["ἐλπίζοντα",514,178],["ἐπὶ",9,1],["Κύριον",7,7],["ἔλεος",183,33],["κυκλώσει",603,120]],"Many are the scourges of the sinner: but him that hopes in the Lord mercy shall compass about."],["11",[["Εὐφράνθητε",244,353],["ἐπὶ",9,1],["Κύριον",7,7],["καὶ",2,8],["ἀγαλλιᾶσθε",738,382],["δίκαιοι",153,130],["καὶ",2,8],["καυχᾶσθε",1380,382],["πάντες",11,130],["οἱ",1,128],["εὐθεῖς",825,130],["τῇ",1,95],["καρδίᾳ",64,2]],"Be glad in the Lord, and exult, ye righteous: and glory, all ye that are upright in heart."]]