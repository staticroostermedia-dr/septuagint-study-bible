[["1",[["Προσευχὴ",549,13],["τῷ",1,110],["πτωχῷ",496,113],["ὅταν",318,8],["ἀκηδιάσῃ",5194,116],["καὶ",2,8],["ἐναντίον",138,17],["Κυρίου",7,21],["ἐκχέῃ",435,166],["τὴν",1,9],["δέησιν",674,10],["αὐτοῦ",3,48]],"A Prayer for the Poor; when he is deeply afflicted, and pours out his supplication before the Lord."],["2",[["Κύριε",7,251],["εἰσάκουσον",237,198],["τῆς",1,18],["προσευχῆς",549,19],["μου",6,83],["καὶ",2,8],["ἡ",1,11],["κραυγή",830,13],["μου",6,48],["πρὸς",15,1],["σὲ",5,161],["ἐλθέτω",56,46]],"Hear my prayer, O Lord, and let my cry come to thee."],["3",[["Μὴ",25,8],["ἀποστρέψῃς",130,170],["τὸ",1,32],["πρόσωπόν",47,33],["σου",5,146],["ἀπʼ",17,1],["ἐμοῦ",6,48],["ἐν",4,1],["ᾗ",24,102],["ἂν",82,12],["ἡμέρᾳ",28,2],["θλίβομαι",599,252],["κλῖνον",829,36],["πρὸς",15,1],["μὲ",6,82],["τὸ",1,32],["οὖς",325,33],["σου",5,146],["ἐν",4,1],["ᾗ",24,102],["ἂν",82,12],["ἡμέρᾳ",28,2],["ἐπικαλέσωμαί",340,255],["σε",5,161],["ταχὺ",1391,17],["εἰσάκουσόν",237,198],["μου",6,48]],"Turn not away thy face from me: in the day [when] I am afflicted, incline thine ear to me: in the day [when] I shall call upon thee, speedily hear me."],["4",[["Ὅτι",19,8],["ἐξέλιπον",321,141],["ὡσεὶ",342,17],["καπνὸς",1469,5],["αἱ",1,183],["ἡμέραι",28,2],["μου",6,48],["καὶ",2,8],["τὰ",1,42],["ὀστᾶ",472,43],["μου",6,48],["ὡσεὶ",342,17],["φρύγιον",8694,20],["συνεφρύγησαν",6130,94]],"For my days have vanished like smoke, and my bones have been parched like a stick."],["5",[["Ἐπλήγην",1478,148],["ὡσεὶ",342,17],["χόρτος",1044,5],["καὶ",2,8],["ἐξηράνθη",843,38],["ἡ",1,11],["καρδία",63,13],["μου",6,48],["ὅτι",19,8],["ἐπελαθόμην",512,152],["τοῦ",1,30],["φαγεῖν",268,100],["τὸν",1,6],["ἄρτον",197,7],["μου",6,48]],"I am blighted like grass, and my heart is dried up; for I have forgotten to eat my bread."],["6",[["Ἀπὸ",17,1],["φωνῆς",95,19],["τοῦ",1,30],["στεναγμοῦ",1599,21],["μου",6,48],["ἐκολλήθη",1272,38],["τὸ",1,32],["ὀστοῦν",472,33],["μου",6,48],["τῇ",1,95],["σαρκί",287,2],["μου",6,48]],"By reason of the voice of my groaning, my bone has cleaved to my flesh."],["7",[["Ὡμοιώθην",1197,148],["πελεκᾶνι",0,0],["ἐρημικῷ",6567,111],["ἐγενήθην",30,148],["ὡσεὶ",342,17],["νυκτικόραξ",4342,5],["ἐν",4,1],["οἰκοπέδῳ",4963,53]],"I have become like a pelican of the wilderness;"],["8",[["Ἠγρύπνησα",2812,147],["καὶ",2,8],["ἐγενήθην",30,148],["ὡσεὶ",342,17],["στρουθίον",2498,20],["μονάζον",7759,36],["ἐπὶ",9,1],["δώματι",1467,53]],"I have become like an owl in a ruined house. I have watched, and am become as a sparrow dwelling alone on a roof."],["9",[["Ὅλην",233,37],["τὴν",1,9],["ἡμέραν",28,10],["ὠνείδιζόν",946,129],["με",6,98],["οἱ",1,128],["ἐχθροί",135,51],["μου",6,48],["καὶ",2,8],["οἱ",1,128],["ἐπαινοῦντές",1532,137],["με",6,82],["κατʼ",32,1],["ἐμοῦ",6,48],["ὤμνυον",346,129]],"All the day long mine enemies have reproached me; and they that praised me have sworn against me."],["10",[["Ὅτι",19,8],["σποδὸν",1228,10],["ὡσεὶ",342,17],["ἄρτον",197,7],["ἔφαγον",268,141],["καὶ",2,8],["τὸ",1,32],["πόμα",3958,538],["μου",6,48],["μετὰ",29,1],["κλαυθμοῦ",1207,21],["ἐκίρνων",7521,129]],"For I have eaten ashes as it were bread, and mingled my drink with weeping;"],["11",[["ἀπὸ",17,1],["προσώπου",47,24],["τῆς",1,18],["ὀργῆς",198,19],["σου",5,146],["καὶ",2,8],["τοῦ",1,30],["θυμοῦ",177,21],["σου",5,146],["ὅτι",19,8],["ἐπάρας",752,155],["κατέῤῥαξάς",2913,154],["με",6,82]],"because of thine anger and thy wrath: for thou hast lifted me up, and dashed me down."],["12",[["Αἱ",1,183],["ἡμέραι",28,2],["μου",6,48],["ὡσεὶ",342,17],["σκιὰ",978,13],["ἐκλίθησαν",829,94],["κᾀγὼ",611,105],["ὡσεὶ",342,17],["χόρτος",1044,5],["ἐξηράνθην",843,148]],"My days have declined like a shadow; and I am withered like grass."],["13",[["Σὺ",5,156],["δέ",14,12],["Κύριε",7,251],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["μένεις",678,145],["καὶ",2,8],["τὸ",1,32],["μνημόσυνόν",717,33],["σου",5,146],["εἰς",8,1],["γενεὰν",286,10],["καὶ",2,8],["γενεάν",286,10]],"But thou, Lord, endurest for ever, and thy memorial to generation and generation."],["14",[["Σὺ",5,156],["ἀναστὰς",121,155],["οἰκτειρήσεις",1687,159],["τὴν",1,9],["Σιὼν",331,2],["ὅτι",19,8],["καιρὸς",132,5],["τοῦ",1,30],["οἰκτειρῆσαι",1687,100],["αὐτὴν",3,98],["ὅτι",19,8],["ἥκει",260,87],["καιρός",132,5]],"Thou shalt arise, and have mercy upon Sion: for [it is] time to have mercy upon her, for the set time is come."],["15",[["Ὅτι",19,8],["εὐδόκησαν",908,141],["οἱ",1,128],["δοῦλοί",136,51],["σου",5,146],["τοὺς",1,56],["λίθους",195,31],["αὐτῆς",3,83],["καὶ",2,8],["τὸν",1,6],["χοῦν",1288,7],["αὐτῆς",3,83],["οἰκτειρήσουσι",1687,207]],"For thy servants have taken pleasure in her stones, and they shall pity her dust."],["16",[["Καὶ",2,8],["φοβηθήσονται",134,135],["τὰ",1,42],["ἔθνη",59,43],["τὸ",1,32],["ὄνομά",55,33],["σου",5,146],["Κύριε",7,251],["καὶ",2,8],["πάντες",11,130],["οἱ",1,128],["βασιλεῖς",22,51],["τὴν",1,9],["δόξαν",141,10],["σου",5,146]],"So the nations shall fear thy name, O Lord, and all kings thy glory."],["17",[["Ὅτι",19,8],["οἰκοδομήσει",125,120],["Κύριος",7,5],["τὴν",1,9],["Σιὼν",331,2],["καὶ",2,8],["ὀφθήσεται",111,125],["ἐν",4,1],["τῇ",1,95],["δόξῃ",141,2],["αὐτοῦ",3,48]],"For the Lord shall build up Sion, and shall appear in his glory."],["18",[["Ἐπέβλεψεν",516,3],["ἐπὶ",9,1],["τὴν",1,9],["προσευχὴν",549,10],["τῶν",1,76],["ταπεινῶν",333,67],["καὶ",2,8],["οὐκ",12,17],["ἐξουδένωσε",1069,3],["τὴν",1,9],["δέησιν",674,10],["αὐτῶν",3,41]],"He has had regard to the prayer of the lowly, and has not despised their petition."],["19",[["Γραφήτω",186,25],["αὕτη",16,101],["εἰς",8,1],["γενεὰν",286,10],["ἑτέραν",253,37],["καὶ",2,8],["λαὸς",35,5],["ὁ",1,4],["κτιζόμενος",951,114],["αἰνέσει",399,120],["τὸν",1,6],["Κύριον",7,7]],"Let this be written for another generation; and the people that shall be created shall praise the Lord."],["20",[["Ὅτι",19,8],["ἐξέκυψεν",3737,3],["ἐξ",21,1],["ὕψους",480,24],["ἁγίου",75,88],["αὐτοῦ",3,144],["Κύριος",7,5],["ἐξ",21,1],["οὐρανοῦ",94,21],["ἐπὶ",9,1],["τὴν",1,9],["γῆν",26,10],["ἐπέβλεψε",516,3]],"For he has looked out from the height of his sanctuary; the Lord looked upon the earth from heaven;"],["21",[["τοῦ",1,30],["ἀκοῦσαι",53,100],["τοῦ",1,30],["στεναγμοῦ",1599,21],["τῶν",1,76],["πεπεδημένων",0,0],["τοῦ",1,30],["λῦσαι",1381,100],["τοὺς",1,56],["υἱοὺς",13,31],["τῶν",1,76],["τεθανατωμένων",0,0]],"to hear the groaning of the fettered ones, to loosen the sons of the slain;"],["22",[["τοῦ",1,30],["ἀναγγεῖλαι",228,100],["ἐν",4,1],["Σιὼν",331,2],["τὸ",1,32],["ὄνομα",55,33],["Κυρίου",7,21],["καὶ",2,8],["τὴν",1,9],["αἴνεσιν",990,10],["αὐτοῦ",3,48],["ἐν",4,1],["Ἱερουσαλήμ",69,20]],"to proclaim the name of the Lord in Sion, and his praise in Jerusalem;"],["23",[["ἐν",4,1],["τῷ",1,110],["συναχθῆναι",165,174],["λαοὺς",35,31],["ἐπιτοαυτὸ",1405,105],["καὶ",2,8],["βασιλεῖς",22,51],["τοῦ",1,30],["δουλεύειν",403,54],["τῷ",1,110],["Κυρίῳ",7,113]],"when the people are gathered together, and the kings, to serve the Lord."],["24",[["Ἀπεκρίθη",229,38],["αὐτῷ",3,49],["ἐν",4,1],["ὁδῷ",67,2],["ἰσχύος",180,19],["αὐτοῦ",3,48],["τὴν",1,9],["ὀλιγότητα",9869,10],["τῶν",1,123],["ἡμερῶν",28,61],["μου",6,48],["ἀνάγγειλόν",228,198],["μοι",6,49]],"He answered him in the way of his strength: tell me the fewness of my days."],["25",[["μὴ",25,8],["ἀναγάγῃς",522,170],["με",6,82],["ἐν",4,1],["ἡμίσει",442,111],["ἡμερῶν",28,61],["μου",6,48],["ἐν",4,1],["γενεᾷ",286,2],["γενεῶν",286,61],["τὰ",1,42],["ἔτη",80,43],["σου",5,146]],"Take me not away in the midst of my days: thy years [are] through all generations."],["26",[["Κατʼ",32,1],["ἀρχὰς",269,40],["τὴν",1,9],["γῆν",26,10],["σὺ",5,156],["Κύριε",7,251],["ἐθεμελίωσας",1203,154],["καὶ",2,8],["ἔργα",104,43],["τῶν",1,123],["χειρῶν",37,61],["σου",5,146],["εἰσὶν",10,189],["οἱ",1,128],["οὐρανοί",94,51]],"In the beginning thou, O Lord, didst lay the foundation of the earth; and the heavens are the works of thine hands."],["27",[["Αὐτοὶ",3,193],["ἀπολοῦνται",213,127],["σὺ",5,156],["δὲ",14,12],["διαμένεις",1886,145],["καὶ",2,8],["πάντες",11,130],["ὡς",36,8],["ἱμάτιον",275,33],["παλαιωθήσονται",1520,135],["καὶ",2,8],["ὡσεὶ",342,17],["περιβόλαιον",2763,33],["ἑλίξεις",5378,159],["αὐτοὺς",3,60],["καὶ",2,8],["ἀλλαγήσονται",1149,135]],"They shall perish, but thou remainest: and [they all] shall wax old as a garment; and as a vesture shalt thou fold them, and they shall be changed."],["28",[["Σὺ",5,156],["δὲ",14,12],["ὁ",1,4],["αὐτὸς",3,158],["εἶ",10,145],["καὶ",2,8],["τὰ",1,42],["ἔτη",80,43],["σου",5,146],["οὐκ",12,17],["ἐκλείψουσιν",321,207]],"But thou art the same, and thy years shall not fail."],["29",[["Οἱ",1,128],["υἱοῖ",3991,87],["τῶν",1,76],["δούλων",136,77],["σου",5,146],["κατασκηνώσουσι",802,207],["καὶ",2,8],["τὸ",1,32],["σπέρμα",214,33],["αὐτῶν",3,41],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["κατευθυνθήσεται",828,125]],"The children of thy servants shall dwell [securely], and their seed shall prosper for ever."]]