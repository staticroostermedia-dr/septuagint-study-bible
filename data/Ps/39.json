[["1",[["Εἰς",8,1],["τὸ",1,32],["τέλος",369,33],["τῷ",1,110],["Δαυὶδ",52,105],["ψαλμός",639,5]],"For the end, a Psalm of David."],["2",[["Ὑπομένων",635,67],["ὑπέμεινα",635,147],["τὸν",1,6],["Κύριον",7,7],["καὶ",2,8],["προσέσχε",557,3],["μοι",6,49],["καὶ",2,8],["εἰσήκουσε",237,3],["τῆς",1,18],["δεήσεώς",674,19],["μου",6,83]],"I waited patiently for the Lord; and he attended to me, and hearkened to my supplication."],["3",[["Καὶ",2,8],["ἀνήγαγέ",522,3],["με",6,82],["ἐκ",21,1],["λάκκου",677,21],["ταλαιπωρίας",1449,40],["καὶ",2,8],["ἀπὸ",17,1],["πηλοῦ",1386,21],["ἰλύος",6624,19],["καὶ",2,8],["ἔστησεν",78,3],["ἐπὶ",9,1],["πέτραν",546,10],["τοὺς",1,56],["πόδας",208,31],["μου",6,48],["καὶ",2,8],["κατεύθυνε",828,239],["τὰ",1,42],["διαβήματά",2082,43],["μου",6,48]],"And he brought me up out of a pit of misery, and from miry clay: and he set my feet on a rock, and ordered my goings aright."],["4",[["Καὶ",2,8],["ἐνέβαλεν",751,3],["εἰς",8,1],["τὸ",1,32],["στόμα",123,33],["μου",6,48],["ᾆσμα",2254,33],["καινὸν",728,29],["ὕμνον",1499,7],["τῷ",1,110],["Θεῷ",20,113],["ἡμῶν",6,41],["ὄψονται",111,127],["πολλοὶ",74,130],["καὶ",2,8],["φοβηθήσονται",134,135],["καὶ",2,8],["ἐλπιοῦσιν",511,207],["ἐπὶ",9,1],["Κύριον",7,7]],"And he put a new song into my mouth, [even] a hymn to our God: many shall see [it], and fear, and shall hope in the Lord."],["5",[["Μακάριος",803,16],["ἀνὴρ",38,5],["οὗ",120,17],["ἐστι",10,87],["τὸ",1,32],["ὄνομα",55,33],["Κυρίου",7,21],["ἐλπὶς",527,13],["αὐτοῦ",3,48],["καὶ",2,8],["οὐκ",12,17],["ἐπέβλεψεν",516,3],["εἰς",8,1],["ματαιότητας",937,40],["καὶ",2,8],["μανίας",3591,40],["ψευδεῖς",547,109]],"Blessed [is] the man whose hope is the name of the Lord, and [who] has not regarded vanities and false frenzies."],["6",[["Πολλὰ",74,65],["ἐποίησας",23,154],["σὺ",5,156],["Κύριε",7,251],["ὁ",1,4],["Θεός",20,5],["μου",6,48],["τὰ",1,42],["θαυμάσιά",885,65],["σου",5,146],["καὶ",2,8],["τοῖς",1,138],["διαλογισμοῖς",1585,139],["σου",5,146],["οὐκ",12,17],["ἔστι",10,87],["τίς",39,150],["ὁμοιωθήσεταί",1197,125],["σοι",5,151],["ἀπήγγειλα",272,147],["καὶ",2,8],["ἐλάλησα",50,147],["ἐπληθύνθησαν",315,94],["ὑπὲρ",139,1],["ἀριθμόν",353,7]],"O Lord my God, thou hast multiplied thy wonderful works, and in thy thoughts there is none who shall be likened to thee: I declared and spoke [of them]: they exceeded number."],["7",[["Θυσίαν",156,10],["καὶ",2,8],["προσφορὰν",2384,10],["οὐκ",12,17],["ἠθέλησας",837,154],["σῶμα",451,20],["δὲ",14,12],["κατηρτίσω",1962,169],["μοι",6,49],["ὁλοκαύτωμα",317,20],["καὶ",2,8],["περὶ",71,1],["ἁμαρτίας",119,19],["οὐκ",12,17],["ᾔτησας",615,154]],"Sacrifice and offering thou wouldest not; but a body hast thou prepared me: whole-burnt-offering and [sacrifice] for sin thou didst not require."],["8",[["Τότε",250,17],["εἶπον",18,141],["ἰδοὺ",51,17],["ἥκω",260,149],["ἐν",4,1],["κεφαλίδι",1682,2],["βιβλίου",337,24],["γέγραπται",186,372],["περὶ",71,1],["ἐμοῦ",6,48]],"Then I said, Behold, I come: in the volume of the book it is written concerning me,"],["9",[["τοῦ",1,30],["ποιῆσαι",23,100],["τὸ",1,32],["θέλημά",1036,33],["σου",5,146],["ὁ",1,4],["Θεός",20,5],["μου",6,48],["ἠβουλήθην",461,94],["καὶ",2,8],["τὸν",1,6],["νόμον",140,7],["σου",5,146],["ἐν",4,1],["μέσῳ",112,34],["τῆς",1,18],["καρδίας",63,19],["μου",6,83]],"I desired to do thy will, O my God, and thy law in the midst of mine heart."],["10",[["Εὐηγγελισάμην",1818,152],["δικαιοσύνην",185,10],["ἐν",4,1],["ἐκκλησίᾳ",562,2],["μεγάλῃ",65,96],["ἰδοὺ",51,17],["τὰ",1,42],["χείλη",361,43],["μου",6,48],["οὐ",12,17],["μὴ",25,8],["κωλύσω",1441,157],["Κύριε",7,251],["σὺ",5,156],["ἔγνως",81,154]],"I have preached righteousness in the great congregation; lo! I will not refrain my lips; O Lord, thou knowest my righteousness."],["11",[["τὴν",1,9],["δικαιοσύνην",185,10],["μου",6,48],["οὐκ",12,17],["ἔκρυψα",378,147],["ἐν",4,1],["τῇ",1,95],["καρδίᾳ",63,2],["μου",6,48],["τὴν",1,9],["ἀλήθειάν",350,10],["σου",5,146],["καὶ",2,8],["τὸ",1,32],["σωτήριόν",471,33],["σου",5,146],["εἶπα",18,147],["οὐκ",12,17],["ἔκρυψα",378,147],["τὸ",1,32],["ἔλεός",182,33],["σου",5,146],["καὶ",2,8],["τὴν",1,9],["ἀλήθειάν",350,10],["σου",5,146],["ἀπὸ",17,1],["συναγωγῆς",284,19],["πολλῆς",74,78]],"I have not hid thy truth within my heart, and I have declared thy salvation; I have not hid thy mercy and thy truth from the great congregation."],["12",[["Σὺ",5,156],["δέ",14,12],["Κύριε",7,251],["μὴ",25,8],["μακρύνῃς",0,0],["τοὺς",1,56],["οἰκτιρμούς",1188,31],["σου",5,146],["ἀπʼ",17,1],["ἐμοῦ",6,48],["τὸ",1,32],["ἔλεός",182,33],["σου",5,146],["καὶ",2,8],["ἡ",1,11],["ἀλήθειά",350,13],["σου",5,146],["διαπαντὸς",506,17],["ἀντελάβοντό",984,182],["μου",6,48]],"But thou, Lord, remove not thy compassion far from me; thy mercy and thy truth have helped me continually."],["13",[["Ὅτι",19,8],["περιέσχον",1349,141],["με",6,82],["κακὰ",161,65],["ὧν",24,97],["οὐκ",12,17],["ἔστιν",10,87],["ἀριθμὸς",353,5],["κατέλαβόν",537,141],["με",6,82],["αἱ",1,183],["ἀνομίαι",274,179],["μου",6,48],["καὶ",2,8],["οὐκ",12,17],["ἠδυνάσθην",184,328],["τοῦ",1,30],["βλέπειν",469,54],["ἐπληθύνθησαν",315,94],["ὑπὲρ",139,1],["τὰς",1,39],["τρίχας",1035,40],["τῆς",1,18],["κεφαλῆς",144,19],["μου",6,83],["καὶ",2,8],["ἡ",1,11],["καρδία",63,13],["μου",6,48],["ἐγκατέλιπέ",363,3],["με",6,82]],"For innumerable evils have encompassed me; my transgressions have taken hold of me, and I could not see; they are multiplied more than the hairs of my head; and my heart has failed me."],["14",[["Εὐδόκησον",908,243],["Κύριε",7,251],["τοῦ",1,30],["ῥύσασθαί",335,103],["με",6,82],["Κύριε",7,251],["εἰς",8,1],["τὸ",1,32],["βοηθῆσαί",552,100],["μοι",6,49],["πρόσχες",1692,154]],"Be pleased, O Lord, to deliver me; O Lord, draw nigh to help me."],["15",[["Καταισχυνθείησαν",716,410],["καὶ",2,8],["ἐντραπείησαν",1153,410],["ἅμα",499,17],["οἱ",1,128],["ζητοῦντες",190,137],["τὴν",1,9],["ψυχήν",62,10],["μου",6,48],["τοῦ",1,30],["ἐξάραι",339,276],["αὐτήν",3,98],["ἀποστραφείησαν",130,410],["εἰς",8,1],["τὰ",1,42],["ὀπίσω",166,17],["καὶ",2,8],["ἐντραπείησαν",1153,410],["οἱ",1,128],["θέλοντές",837,137],["μοι",6,49],["κακά",161,65]],"Let those that seek my soul, to destroy it, be ashamed and confounded together; let those that wish me evil be turned backward and put to shame."],["16",[["Κομισάσθωσαν",1593,541],["παραχρῆμα",1908,17],["αἰσχύνην",683,10],["αὐτῶν",3,41],["οἱ",1,128],["λέγοντές",31,137],["μοι",6,49],["εὖγε",2274,17],["εὖγε",2274,17]],"Let those that say to me, Aha, aha, quickly receive shame for their reward."],["17",[["Ἀγαλλιάσαιντο",737,556],["καὶ",2,8],["εὐφρανθείησαν",242,410],["ἐπὶ",9,1],["σοὶ",5,151],["πάντες",11,130],["οἱ",1,128],["ζητοῦντές",190,137],["σε",5,161],["Κύριε",7,251],["καὶ",2,8],["εἰπάτωσαν",18,261],["διαπαντὸς",506,17],["μεγαλυνθήτω",606,25],["ὁ",1,4],["Κύριος",7,5],["οἱ",1,128],["ἀγαπῶντες",224,137],["τὸ",1,32],["σωτήριόν",471,33],["σου",5,146]],"Let all those that seek thee, O Lord, exult and rejoice in thee; and let them that love thy salvation say continually, The Lord be magnified."],["18",[["Ἐγὼ",6,158],["δὲ",14,12],["πτωχὸς",496,5],["καὶ",2,8],["πένης",668,5],["εἰμὶ",10,149],["Κύριος",7,5],["φροντιεῖ",2214,120],["μου",6,48],["βοηθός",948,5],["μου",6,48],["καὶ",2,8],["ὑπερασπιστής",1876,5],["μου",6,48],["εἶ",10,145],["σὺ",5,156],["ὁ",1,4],["Θεός",20,5],["μου",6,48],["μὴ",25,8],["χρονίσῃς",1744,170]],"But I am poor and needy; the Lord will take care of me; thou art my helper, and my defender, O my God, delay not."]]