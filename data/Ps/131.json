[["1",[["Ὠδὴ",776,105],["τῶν",1,76],["ἀναβαθμῶν",1484,77],["Μνήσθητι",230,242],["Κύριε",7,250],["τοῦ",1,30],["Δαυὶδ",52,105],["καὶ",2,8],["πάσης",11,78],["τῆς",1,18],["πρᾳότητος",5977,19],["αὐτοῦ",3,48]],"A Song of Degrees. Lord, remember David, and all his meekness:"],["2",[["Ὡς",36,8],["ὤμοσε",347,3],["τῷ",1,110],["Κυρίῳ",7,113],["ηὔξατο",670,26],["τῷ",1,110],["Θεῷ",20,113],["Ἰακώβ",146,105]],"how he sware to the Lord, [and] vowed to the God of Jacob, [saying],"],["3",[["Εἰ",77,8],["εἰσελεύσομαι",86,177],["εἰς",8,1],["σκήνωμα",682,33],["οἴκου",34,21],["μου",6,48],["εἰ",77,8],["ἀναβήσομαι",88,177],["ἐπὶ",9,1],["κλίνης",1221,19],["στρωμνῆς",2629,19],["μου",6,83]],"I will not go into the tabernacle of my house; I will not go up to the couch of my bed;"],["4",[["Εἰ",77,8],["δώσω",33,157],["ὕπνον",1010,7],["τοῖς",1,138],["ὀφθαλμοῖς",91,139],["μοῦ",6,48],["καὶ",2,8],["τοῖς",1,91],["βλεφάροις",2867,92],["μου",6,48],["νυσταγμὸν",4925,7],["καὶ",2,8],["ἀνάπαυσιν",1048,10],["τοῖς",1,138],["κροτάφοις",4282,139],["μου",6,48]],"I will not give sleep to mine eyes, nor slumber to mine eyelids, nor rest to my temples,"],["5",[["Ἕως",42,8],["οὗ",120,17],["εὕρω",101,227],["τόπον",99,7],["τῷ",1,110],["Κυρίῳ",7,113],["σκήνωμα",682,33],["τῷ",1,110],["Θεῷ",20,113],["Ἰακώβ",146,105]],"until I find a place for the Lord, a tabernacle for the God of Jacob."],["6",[["Ἰδοὺ",51,17],["ἠκούσαμεν",54,285],["αὐτὴν",3,98],["ἐν",4,1],["Ἐφραθὰ",11683,0],["εὕρομεν",101,285],["αὐτὴν",3,98],["ἐν",4,1],["τοῖς",1,91],["πεδίοις",349,92],["τοῦ",1,30],["δρυμοῦ",802,21]],"Behold, we heard of it in Ephratha; we found it in the fields of the wood."],["7",[["Εἰσελευσώμεθα",0,0],["εἰς",8,1],["τὰ",1,42],["σκηνώματα",682,43],["αὐτοῦ",3,48],["προσκυνήσωμεν",298,75],["εἰς",8,1],["τὸν",1,6],["τόπον",99,7],["οὗ",120,17],["ἔστησαν",78,141],["οἱ",1,128],["πόδες",210,51],["αὐτοῦ",3,48]],"Let us enter into his tabernacles: let us worship at the place where his feet stood."],["8",[["Ἀνάστηθι",121,198],["Κύριε",7,250],["εἰς",8,1],["τὴν",1,9],["ἀνάπαυσίν",1048,10],["σου",5,146],["σὺ",5,156],["καὶ",2,8],["ἡ",1,11],["κιβωτὸς",272,13],["τοῦ",1,23],["ἁγιάσματός",835,24],["σου",5,146]],"Arise, O Lord, into thy rest; thou, and the ark of thine holiness."],["9",[["Οἱ",1,128],["ἱερεῖς",65,31],["σου",5,146],["ἐνδύσονται",516,127],["δικαιοσύνην",187,10],["καὶ",2,8],["οἱ",1,128],["ὅσιοί",917,130],["σου",5,146],["ἀγαλλιάσονται",738,127]],"Thy priests shall clothe themselves with righteousness; and thy saints shall exult."],["10",[["Ἕνεκεν",447,1],["Δαυὶδ",52,105],["τοῦ",1,30],["δούλου",136,21],["σου",5,146],["μὴ",25,8],["ἀποστρέψῃς",130,170],["τὸ",1,32],["πρόσωπον",47,33],["τοῦ",1,30],["χριστοῦ",1072,21],["σου",5,146]],"For the sake of thy servant David turn not away the face of thine anointed."],["11",[["Ὤμοσε",347,3],["Κύριος",7,5],["τῷ",1,110],["Δαυὶδ",52,105],["ἀλήθειαν",352,10],["καὶ",2,8],["οὐ",12,17],["μὴ",25,8],["ἀθετήσει",834,120],["αὐτὴν",3,98],["ἐκ",21,1],["καρποῦ",448,21],["τῆς",1,18],["κοιλίας",547,19],["σου",5,146],["θήσομαι",110,177],["ἐπὶ",9,1],["τοῦ",1,30],["θρόνον",383,7],["σου",5,146]],"The Lord sware [in] truth to David, and he will not annul it, [saying], Of the fruit of thy body will I set [a king] upon thy throne."],["12",[["Ἐὰν",45,8],["φυλάξωνται",125,222],["οἱ",1,128],["υἱοί",13,51],["σου",5,146],["τὴν",1,9],["διαθήκην",169,10],["μου",6,48],["καὶ",2,8],["τὰ",1,42],["μαρτύριά",225,43],["μου",6,48],["ταῦτα",16,248],["ἃ",1,11],["διδάξω",545,157],["αὐτοὺς",3,60],["καὶ",2,8],["οἱ",1,128],["υἱοὶ",13,51],["αὐτῶν",3,41],["ἕως",42,8],["τοῦ",1,30],["αἰῶνος",100,21],["καθιοῦνται",274,127],["ἐπὶ",9,1],["τοῦ",1,30],["θρόνου",383,21],["σου",5,146]],"If thy children will keep my covenant, and these my testimonies which I shall teach them, their children also shall sit upon thy throne for ever."],["13",[["Ὅτι",19,8],["ἐξελέξατο",420,26],["Κύριος",7,5],["τὴν",1,9],["Σιὼν",334,2],["ᾑρετίσατο",1618,26],["αὐτὴν",3,98],["εἰς",8,1],["κατοικίαν",1306,10],["ἑαυτῷ",92,49]],"For the Lord has elected Sion, he has chosen her for a habitation for himself, [saying],"],["14",[["Αὕτη",16,101],["ἡ",1,11],["κατάπαυσίς",2728,13],["μου",6,48],["εἰς",8,1],["αἰῶνα",100,7],["αἰῶνος",100,21],["ὧδε",640,17],["κατοικήσω",89,157],["ὅτι",19,8],["ᾑρετισάμην",1618,152],["αὐτήν",3,98]],"This is my rest for ever: here will I dwell; for I have chosen it."],["15",[["Τὴν",1,9],["θήραν",1510,10],["αὐτῆς",3,83],["εὐλογῶν",149,67],["εὐλογήσω",149,157],["τοὺς",1,56],["πτωχοὺς",497,31],["αὐτῆς",3,83],["χορτάσω",2397,157],["ἄρτων",197,77]],"I will surely bless her provision: I will satisfy her poor with bread."],["16",[["Τοὺς",1,56],["ἱερεῖς",65,31],["αὐτῆς",3,83],["ἐνδύσω",516,169],["σωτηρίαν",425,10],["καὶ",2,8],["οἱ",1,128],["ὅσιοι",917,130],["αὐτῆς",3,83],["ἀγαλλιάσει",1981,2],["ἀγαλλιάσονται",738,127]],"I will clothe her priests with salvation; and her saints shall greatly exult."],["17",[["Ἐκεῖ",76,17],["ἐξανατελῶ",4085,157],["κέρας",569,33],["τῷ",1,110],["Δαυὶδ",52,105],["ἡτοίμασα",371,147],["λύχνον",1059,7],["τῷ",1,110],["χριστῷ",1072,113],["σου",5,146]],"There will I cause to spring up a horn to David: I have prepared a lamp for mine anointed."],["18",[["Τοὺς",1,56],["ἐχθροὺς",135,31],["αὐτοῦ",3,48],["ἐνδύσω",516,169],["αἰσχύνην",685,10],["ἐπὶ",9,1],["δὲ",14,12],["αὐτὸν",3,82],["ἐξανθήσει",1800,120],["τὸ",1,32],["ἁγίασμά",835,33],["μου",6,48]],"His enemies will I clothe with shame; but upon himself shall my holiness flourish."]]