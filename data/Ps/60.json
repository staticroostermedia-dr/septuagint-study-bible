[["1",[["Εἰς",8,1],["τὸ",1,32],["τέλος",373,33],["ἐν",4,1],["ὕμνοις",1498,139],["τῷ",1,110],["Δαυίδ",52,105]],"For the end, among the Hymns of David."],["2",[["Εἰσάκουσον",241,198],["ὁ",1,4],["Θεὸς",20,5],["τῆς",1,18],["δεήσεώς",677,19],["μου",6,83],["πρόσχες",1689,154],["τῇ",1,95],["προσευχῇ",550,2],["μου",6,48]],"O God, hearken to my petition; attend to my prayer."],["3",[["Ἀπὸ",17,1],["τῶν",1,44],["περάτων",876,45],["τῆς",1,18],["γῆς",26,19],["πρὸς",15,1],["σὲ",5,161],["ἐκέκραξα",592,147],["ἐν",4,1],["τῷ",1,110],["ἀκηδιάσαι",4011,216],["τὴν",1,9],["καρδίαν",64,10],["μου",6,48],["ἐν",4,1],["πέτρᾳ",548,2],["ὕψωσάς",331,154],["με",6,82],["ὁδήγησάς",1108,154],["με",6,82]],"From the ends of the earth have I cried to thee, when my heart was in trouble: thou liftedst me up on a rock, thou didst guide me:"],["4",[["ὅτι",19,8],["ἐγενήθης",30,360],["ἐλπίς",530,13],["μου",6,83],["πύργος",708,5],["ἰσχύος",181,19],["ἀπὸ",17,1],["προσώπου",47,24],["ἐχθροῦ",135,24]],"because thou wert my hope, a tower of strength from the face of the enemy."],["5",[["Παροικήσω",782,157],["ἐν",4,1],["τῷ",1,52],["σκηνώματί",682,53],["σου",5,146],["εἰς",8,1],["τοὺς",1,56],["αἰῶνας",100,31],["σκεπασθήσομαι",1208,176],["ἐν",4,1],["σκέπῃ",1188,2],["τῶν",1,123],["πτερύγων",719,61],["σου",5,146],["διάψαλμα",689,20]],"I will dwell in thy tabernacle for ever; I will shelter myself under the shadow of thy wings. Pause."],["6",[["Ὅτι",19,8],["σὺ",5,156],["ὁ",1,4],["Θεὸς",20,5],["εἰσήκουσας",241,154],["τῶν",1,123],["προσευχῶν",550,61],["μου",6,48],["ἔδωκας",33,154],["κληρονομίαν",299,10],["τοῖς",1,138],["φοβουμένοις",134,342],["τὸ",1,32],["ὄνομά",57,33],["σου",5,146]],"For thou, O God, hast heard my prayers; thou hast given an inheritance to them that fear thy name."],["7",[["Ἡμέρας",28,19],["ἐφʼ",9,1],["ἡμέρας",28,19],["βασιλέως",22,21],["προσθήσεις",201,159],["τὰ",1,42],["ἔτη",81,43],["αὐτοῦ",3,48],["ἕως",42,8],["ἡμέρας",28,19],["γενεᾶς",286,19],["καὶ",2,8],["γενεᾶς",286,19]],"Thou shalt add days to the days of the king; [thou shalt lengthen] his years to all generations."],["8",[["Διαμενεῖ",1884,120],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["ἐνώπιον",115,1],["τοῦ",1,30],["Θεοῦ",20,21],["ἔλεος",183,33],["καὶ",2,8],["ἀλήθειαν",352,10],["αὐτοῦ",3,48],["τίς",39,150],["ἐκζητήσει",460,120],["αὐτῶν",3,41]],"He shall endure for ever before God: which of them will seek out his mercy and truth?"],["9",[["Οὕτως",71,17],["ψαγῶ",0,0],["τῷ",1,52],["ὀνόματί",57,53],["σου",5,146],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["τοῦ",1,30],["αἰῶνος",100,21],["τοῦ",1,30],["ἀποδοῦναί",312,100],["με",6,82],["τὰς",1,39],["εὐχάς",633,40],["μου",6,48],["ἡμέραν",28,10],["ἐξ",21,1],["ἡμέρας",28,19]],"So will I sing to thy name for ever and ever, that I may daily perform my vows."]]