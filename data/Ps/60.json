[["1",[["Εἰς",8,1],["τὸ",1,32],["τέλος",369,33],["ἐν",4,1],["ὕμνοις",1499,139],["τῷ",1,110],["Δαυίδ",52,105]],"For the end, among the Hymns of David."],["2",[["Εἰσάκουσον",237,198],["ὁ",1,4],["Θεὸς",20,5],["τῆς",1,18],["δεήσεώς",674,19],["μου",6,83],["πρόσχες",1692,154],["τῇ",1,95],["προσευχῇ",549,2],["μου",6,48]],"O God, hearken to my petition; attend to my prayer."],["3",[["Ἀπὸ",17,1],["τῶν",1,44],["περάτων",877,45],["τῆς",1,18],["γῆς",26,19],["πρὸς",15,1],["σὲ",5,161],["ἐκέκραξα",590,147],["ἐν",4,1],["τῷ",1,110],["ἀκηδιάσαι",5194,210],["τὴν",1,9],["καρδίαν",63,10],["μου",6,48],["ἐν",4,1],["πέτρᾳ",546,2],["ὕψωσάς",327,154],["με",6,82],["ὁδήγησάς",1110,154],["με",6,82]],"From the ends of the earth have I cried to thee, when my heart was in trouble: thou liftedst me up on a rock, thou didst guide me:"],["4",[["ὅτι",19,8],["ἐγενήθης",30,363],["ἐλπίς",527,13],["μου",6,83],["πύργος",709,5],["ἰσχύος",180,19],["ἀπὸ",17,1],["προσώπου",47,24],["ἐχθροῦ",135,24]],"because thou wert my hope, a tower of strength from the face of the enemy."],["5",[["Παροικήσω",781,157],["ἐν",4,1],["τῷ",1,52],["σκηνώματί",680,53],["σου",5,146],["εἰς",8,1],["τοὺς",1,56],["αἰῶνας",100,31],["σκεπασθήσομαι",1212,175],["ἐν",4,1],["σκέπῃ",1189,2],["τῶν",1,123],["πτερύγων",720,61],["σου",5,146],["διάψαλμα",687,20]],"I will dwell in thy tabernacle for ever; I will shelter myself under the shadow of thy wings. Pause."],["6",[["Ὅτι",19,8],["σὺ",5,156],["ὁ",1,4],["Θεὸς",20,5],["εἰσήκουσας",237,154],["τῶν",1,123],["προσευχῶν",549,61],["μου",6,48],["ἔδωκας",33,154],["κληρονομίαν",297,10],["τοῖς",1,138],["φοβουμένοις",134,346],["τὸ",1,32],["ὄνομά",55,33],["σου",5,146]],"For thou, O God, hast heard my prayers; thou hast given an inheritance to them that fear thy name."],["7",[["Ἡμέρας",28,19],["ἐφʼ",9,1],["ἡμέρας",28,19],["βασιλέως",22,21],["προσθήσεις",200,159],["τὰ",1,42],["ἔτη",80,43],["αὐτοῦ",3,48],["ἕως",42,8],["ἡμέρας",28,19],["γενεᾶς",286,19],["καὶ",2,8],["γενεᾶς",286,19]],"Thou shalt add days to the days of the king; [thou shalt lengthen] his years to all generations."],["8",[["Διαμενεῖ",1886,120],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["ἐνώπιον",114,1],["τοῦ",1,30],["Θεοῦ",20,21],["ἔλεος",182,33],["καὶ",2,8],["ἀλήθειαν",350,10],["αὐτοῦ",3,48],["τίς",39,150],["ἐκζητήσει",459,120],["αὐτῶν",3,41]],"He shall endure for ever before God: which of them will seek out his mercy and truth?"],["9",[["Οὕτως",70,17],["ψαγῶ",0,0],["τῷ",1,52],["ὀνόματί",55,53],["σου",5,146],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["τοῦ",1,30],["αἰῶνος",100,21],["τοῦ",1,30],["ἀποδοῦναί",311,100],["με",6,82],["τὰς",1,39],["εὐχάς",631,40],["μου",6,48],["ἡμέραν",28,10],["ἐξ",21,1],["ἡμέρας",28,19]],"So will I sing to thy name for ever and ever, that I may daily perform my vows."]]