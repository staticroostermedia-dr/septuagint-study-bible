[["1",[["Εἰς",8,1],["τὸ",1,32],["τέλος",369,33],["ὑπὲρ",139,1],["Ἰδιθοὺν",0,0],["ψαλμὸς",639,5],["τῷ",1,110],["Ἀσάφ",1105,5]],"For the end, for Idithun, a Psalm of Asaph."],["2",[["Φωνῇ",95,2],["μου",6,48],["πρὸς",15,1],["Κύριον",7,7],["ἐκέκραξα",590,147],["καὶ",2,8],["ἡ",1,11],["φωνή",95,13],["μου",6,48],["πρὸς",15,1],["τὸν",1,6],["Θεὸν",20,7],["καὶ",2,8],["προσέσχε",557,3],["μοι",6,49]],"I cried to the Lord with my voice, yea, my voice [was addressed] to God; and he gave heed to me."],["3",[["Ἐν",4,1],["ἡμέρᾳ",28,2],["θλίψεώς",437,19],["μου",6,83],["τὸν",1,6],["Θεὸν",20,7],["ἐξεζήτησα",459,147],["ταῖς",1,70],["χερσί",37,71],["μου",6,83],["νυκτὸς",216,19],["ἐναντίον",138,17],["αὐτοῦ",3,48],["καὶ",2,8],["οὐκ",12,17],["ἠπατήθην",1291,94],["ἀπηνῄνατο",9036,108],["παρακληθῆναι",432,174],["ἡ",1,11],["ψυχή",62,13],["μου",6,48]],"In the day of mine affliction I earnestly sought the Lord; [even] with my hands by night before him, and I was not deceived; my soul refused to be comforted."],["4",[["Ἐμνήσθην",231,148],["τοῦ",1,30],["Θεοῦ",20,21],["καὶ",2,8],["εὐφράνθην",242,148],["ἠδολέσχησα",2515,147],["καὶ",2,8],["ὠλιγοψύχησε",3032,3],["τὸ",1,32],["πνεῦμά",167,33],["μου",6,48],["διάψαλμα",687,33]],"I remembered God, and rejoiced; I poured out my complaint, and my soul fainted. Pause."],["5",[["Προκατελάβοντο",1279,182],["φυλακὰς",483,40],["πάντες",11,130],["οἱ",1,128],["ἐχθροί",135,51],["μου",6,48],["ἐταράχθην",508,256],["καὶ",2,8],["οὐκ",12,17],["ἐλάλησα",50,147]],"All mine enemies set a watch [against me]: I was troubled, and spoke not."],["6",[["Διελογισάμην",2577,329],["ἡμέρας",28,19],["ἀρχαίας",1571,78],["καὶ",2,8],["ἔτη",80,43],["αἰώνια",388,65]],"I considered the days of old, and remembered ancient years."],["7",[["ἐμνήσθην",231,148],["καὶ",2,8],["ἐμελέτησα",1344,147],["νυκτὸς",216,19],["μετὰ",29,1],["τῆς",1,18],["καρδίας",63,19],["μου",6,83],["ἠδολέσχουν",2515,129],["καὶ",2,8],["ἔσκαλλον",8312,129],["τὸ",1,32],["πνεῦμά",167,33],["μου",6,48]],"And I meditated; I communed with my heart by night, and diligently searched my spirit, [saying],"],["8",[["Μὴ",25,8],["εἰς",8,1],["τοὺς",1,56],["αἰῶνας",100,31],["ἀπώσεται",767,89],["Κύριος",7,5],["καὶ",2,8],["οὐ",12,17],["προσθήσει",200,120],["τοῦ",1,30],["εὐδοκῆσαι",908,100],["ἔτι",110,17]],"Will the Lord cast off for ever? and will he be well pleased no more?"],["9",[["Ἢ",60,8],["εἰς",8,1],["τέλος",369,33],["ἀποκόψει",3709,120],["τὸ",1,32],["ἔλεος",182,33],["ἀπὸ",17,1],["γενεᾶς",286,19],["καὶ",2,8],["γενεᾶς",286,19]],"Will he cut off his mercy for ever, even for ever and ever?"],["10",[["Ἢ",60,8],["ἐπιλήσεται",512,89],["τοῦ",1,30],["οἰκτειρῆσαι",1687,100],["ὁ",1,4],["Θεὸς",20,5],["ἢ",60,8],["συνέξει",1423,120],["ἐν",4,1],["τῇ",1,95],["ὀργῇ",198,2],["αὐτοῦ",3,48],["τοὺς",1,56],["οἰκτιρμοὺς",1188,31],["αὐτοῦ",3,48],["διάψαλμα",687,20]],"Will God forget to pity? or will he shut up his compassions in his wrath? Pause."],["11",[["Καὶ",2,8],["εἶπα",18,147],["νῦν",89,17],["ἠρξάμην",319,152],["αὕτη",16,101],["ἡ",1,11],["ἀλλοίωσις",6278,13],["τῆς",1,18],["δεξιᾶς",282,78],["τοῦ",1,30],["ὑψίστου",473,153]],"And I said, Now I have begun; this is the change of the right hand of the Most High."],["12",[["Ἐμνήσθην",231,148],["τῶν",1,44],["ἔργων",104,45],["Κυρίου",7,21],["ὅτι",19,8],["μνησθήσομαι",231,175],["ἀπὸ",17,1],["τῆς",1,18],["ἀρχῆς",269,19],["τῶν",1,76],["θαυμασίων",885,163],["σου",5,146]],"I remembered the works of the Lord; for I will remember thy wonders from the beginning."],["13",[["καὶ",2,8],["μελετήσω",1344,157],["ἐν",4,1],["πᾶσι",11,90],["τοῖς",1,91],["ἔργοις",104,92],["σου",5,146],["καὶ",2,8],["ἐν",4,1],["τοῖς",1,91],["ἐπιτηδεύμασί",905,92],["σου",5,146],["ἀδολεσχήσω",2515,157]],"And I will meditate on all thy works, and will consider thy doings."],["14",[["Ὁ",1,4],["Θεὸς",20,5],["ἐν",4,1],["τῷ",1,110],["ἁγίῳ",75,111],["ἡ",1,11],["ὁδός",67,13],["σου",5,146],["τίς",39,150],["θεὸς",20,5],["μέγας",65,16],["ὡς",36,8],["ὁ",1,4],["Θεὸς",20,5],["ἡμῶν",6,41]],"O God, thy way is in the sanctuary; who is a great God as our God?"],["15",[["Σὺ",5,156],["εἶ",10,145],["ὁ",1,4],["Θεὸς",20,5],["ὁ",1,4],["ποιῶν",23,67],["θαυμάσια",885,65],["ἐγνώρισας",746,154],["ἐν",4,1],["τοῖς",1,138],["λαοῖς",35,139],["τὴν",1,9],["δύναμίν",98,10],["σου",5,146]],"Thou art the God that doest wonders; thou hast made known thy power among the nations."],["16",[["ἐλυτρώσω",548,169],["ἐν",4,1],["τῷ",1,110],["βραχίονί",616,314],["σου",5,146],["τὸν",1,6],["λαόν",35,7],["σου",5,146],["τοὺς",1,56],["υἱοὺς",13,31],["Ἰακὼβ",146,105],["καὶ",2,8],["Ἰωσήφ",262,105],["διάψαλμα",687,20]],"Thou hast with thine arm redeemed thy people, the sons of Jacob and Joseph. Pause."],["17",[["Εἴδοσάν",0,0],["σε",5,161],["ὕδατα",85,43],["ὁ",1,4],["Θεὸς",20,5],["εἴδοσάν",0,0],["σε",5,161],["ὕδατα",85,43],["καὶ",2,8],["ἐφοβήθησαν",134,94],["καὶ",2,8],["ἐταράχθησαν",508,94],["ἄβυσσοι",1084,179]],"The waters saw thee, O God, the waters saw thee, and feared; and the depths were troubled."],["18",[["Πλῆθος",199,20],["ἤχους",1805,31],["ὑδάτων",85,45],["φωνὴν",95,10],["ἔδωκαν",33,141],["αἱ",1,183],["νεφέλαι",443,179],["καὶ",2,8],["γὰρ",40,12],["τὰ",1,42],["βέλη",1159,43],["σου",5,146],["διαπορεύονται",1114,303]],"[There was] an abundant sound of waters: the clouds uttered a voice; for thine arrows went abroad."],["19",[["Φωνὴ",95,13],["τῆς",1,18],["βροντῆς",2885,19],["σου",5,146],["ἐν",4,1],["τῷ",1,110],["τροχῷ",913,113],["ἔφαναν",849,141],["αἱ",1,183],["ἀστραπαί",1854,179],["σου",5,146],["τῇ",1,95],["οἰκουμένῃ",526,581],["ἐσαλεύθη",679,38],["καὶ",2,8],["ἔντρομος",4126,15],["ἐγενήθη",30,38],["ἡ",1,11],["γῆ",26,13]],"The voice of thy thunder was abroad, and around thy lightnings appeared to the world; the earth trembled and quaked."],["20",[["Ἐν",4,1],["τῇ",1,95],["θαλάσσῃ",137,2],["ἡ",1,11],["ὁδός",67,13],["σου",5,146],["καὶ",2,8],["αἱ",1,183],["τρίβοι",744,179],["σου",5,146],["ἐν",4,1],["ὕδασι",85,92],["πολλοῖς",74,90],["καὶ",2,8],["τὰ",1,42],["ἴχνη",1409,43],["σου",5,146],["οὐ",12,17],["γνωσθήσονται",81,135]],"Thy way is in the sea, and thy paths in many waters, and thy footsteps cannot be known."],["21",[["Ὡδήγησας",1110,154],["ὡς",36,8],["πρόβατα",194,43],["τὸν",1,6],["λαόν",35,7],["σου",5,146],["ἐν",4,1],["χειρὶ",37,2],["Μωυσῆ",68,251],["καὶ",2,8],["Ἀαρών",159,251]],"Thou didst guide thy people as sheep by the hand of Moses and Aaron."]]