[["1",[["Εἰς",8,1],["τὸ",1,32],["τέλος",373,33],["ἐν",4,1],["ψαλμοῖς",644,139],["ᾠδὴ",776,13],["τᾠ",0,0],["Δαυίδ",52,105]],"For the end, a Song of David among [the ]Psalms."],["2",[["Ἐν",4,1],["τῷ",1,110],["ἐπικαλεῖσθαί",341,363],["με",6,82],["εἰσήκουσέ",241,3],["μου",6,48],["ὁ",1,4],["Θεὸς",20,5],["τῆς",1,18],["δικαιοσύνης",187,19],["μου",6,83],["ἐν",4,1],["θλίψει",438,2],["ἐπλάτυνάς",1779,154],["μοι",6,99],["οἰκτείρησόν",1309,198],["με",6,82],["καὶ",2,8],["εἰσάκουσον",241,198],["τῆς",1,18],["προσευχῆς",550,19],["μου",6,83]],"When I called upon [him], the God of my righteousness heard me: thou hast made room for me in tribulation; pity me, and hearken to my prayer."],["3",[["Υἱοὶ",13,51],["ἀνθρώπων",43,77],["ἕως",42,8],["πότε",458,12],["βαρυκάρδιοι",6844,130],["ἱνατί",102,238],["ἀγαπᾶτε",214,307],["ματαιότητα",937,10],["καὶ",2,8],["ζητεῖτε",191,84],["ψεῦδος",1392,33],["διάψαλμα",689,33]],"O ye sons of men, how long [will ye be] slow of heart? wherefore do ye love vanity, and seek falsehood? Pause."],["4",[["Καὶ",2,8],["γνῶτε",79,118],["ὅτι",19,8],["ἐθαυμάστωσε",3060,3],["Κύριος",7,5],["τὸν",1,6],["ὅσιον",917,59],["αὐτοῦ",3,48],["Κύριος",7,5],["εἰσακούσεταί",241,89],["μου",6,48],["ἐν",4,1],["τῷ",1,110],["κεκραγέναι",592,107],["με",6,82],["πρὸς",15,1],["αὐτόν",3,82]],"But know ye that the Lord has done wondrous things for his holy one: the Lord will hear me when I cry to him."],["5",[["Ὀργίζεσθε",725,382],["καὶ",2,8],["μὴ",25,8],["ἁμαρτάνετε",237,84],["ἃ",1,11],["λέγετε",31,84],["ἐν",4,1],["ταῖς",1,70],["καρδίαις",64,71],["ὑμῶν",5,136],["ἐπὶ",9,1],["ταῖς",1,70],["κοίταις",704,71],["ὑμῶν",5,136],["κατανύγητε",2086,353],["διάψαλμα",689,20]],"Be ye angry, and sin not; feel compunction upon your beds for what ye say in your hearts. Pause."],["6",[["Θύσατε",437,69],["θυσίαν",156,10],["δικαιοσύνης",187,19],["καὶ",2,8],["ἐλπίσατε",514,69],["ἐπὶ",9,1],["Κύριον",7,7]],"Offer the sacrifice of righteousness, and trust in the Lord."],["7",[["Πολλοὶ",74,130],["λέγουσι",31,191],["τίς",39,150],["δείξει",870,120],["ἡμῖν",6,142],["τὰ",1,42],["ἀγαθά",114,65],["ἐσημειώθη",8222,38],["ἐφʼ",9,1],["ἡμᾶς",6,60],["τὸ",1,27],["φῶς",380,20],["τοῦ",1,23],["προσώπου",47,24],["σου",5,146],["Κύριε",7,250]],"Many say, Who will shew us good things? the light of thy countenance, O Lord, has been manifested towards us."],["8",[["Ἔδωκας",33,154],["εὐφροσύνην",360,10],["εἰς",8,1],["τὴν",1,9],["καρδίαν",64,10],["μου",6,48],["ἀπὸ",17,1],["καρποῦ",448,21],["σίτου",665,21],["καὶ",2,8],["οἴνου",261,21],["καὶ",2,8],["ἐλαίου",313,24],["αὐτῶν",3,41],["ἐπληθύνθησαν",316,94]],"Thou hast put gladness into my heart: they have been satisfied with the fruit of their corn and wine and oil."],["9",[["Ἐν",4,1],["εἰρήνῃ",213,2],["ἐπὶ",9,1],["τὸ",1,32],["αὐτὸ",3,121],["κοιμηθήσομαι",301,176],["καὶ",2,8],["ὑπνώσω",1664,157],["ὅτι",19,8],["σὺ",5,156],["Κύριε",7,250],["κατὰ",32,1],["μόνας",302,109],["ἐπʼ",9,1],["ἐλπίδι",530,2],["κατῴκισάς",976,154],["με",6,82]],"I will both lie down in peace and sleep: for thou, Lord, only hast caused me to dwell securely."]]