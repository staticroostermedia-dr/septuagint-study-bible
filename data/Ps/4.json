[["1",[["Εἰς",8,1],["τὸ",1,32],["τέλος",369,33],["ἐν",4,1],["ψαλμοῖς",639,139],["ᾠδὴ",773,13],["τᾠ",0,0],["Δαυίδ",52,105]],"For the end, a Song of David among [the ]Psalms."],["2",[["Ἐν",4,1],["τῷ",1,110],["ἐπικαλεῖσθαί",340,366],["με",6,82],["εἰσήκουσέ",237,3],["μου",6,48],["ὁ",1,4],["Θεὸς",20,5],["τῆς",1,18],["δικαιοσύνης",185,19],["μου",6,83],["ἐν",4,1],["θλίψει",437,2],["ἐπλάτυνάς",1779,154],["μοι",6,99],["οἰκτείρησόν",1687,243],["με",6,82],["καὶ",2,8],["εἰσάκουσον",237,198],["τῆς",1,18],["προσευχῆς",549,19],["μου",6,83]],"When I called upon [him], the God of my righteousness heard me: thou hast made room for me in tribulation; pity me, and hearken to my prayer."],["3",[["Υἱοὶ",13,51],["ἀνθρώπων",43,77],["ἕως",42,8],["πότε",455,12],["βαρυκάρδιοι",6891,130],["ἱνατί",101,238],["ἀγαπᾶτε",224,311],["ματαιότητα",937,10],["καὶ",2,8],["ζητεῖτε",190,84],["ψεῦδος",1193,33],["διάψαλμα",687,33]],"O ye sons of men, how long [will ye be] slow of heart? wherefore do ye love vanity, and seek falsehood? Pause."],["4",[["Καὶ",2,8],["γνῶτε",81,118],["ὅτι",19,8],["ἐθαυμάστωσε",3072,3],["Κύριος",7,5],["τὸν",1,6],["ὅσιον",918,59],["αὐτοῦ",3,48],["Κύριος",7,5],["εἰσακούσεταί",237,89],["μου",6,48],["ἐν",4,1],["τῷ",1,110],["κεκραγέναι",590,107],["με",6,82],["πρὸς",15,1],["αὐτόν",3,82]],"But know ye that the Lord has done wondrous things for his holy one: the Lord will hear me when I cry to him."],["5",[["Ὀργίζεσθε",725,386],["καὶ",2,8],["μὴ",25,8],["ἁμαρτάνετε",244,84],["ἃ",1,11],["λέγετε",31,84],["ἐν",4,1],["ταῖς",1,70],["καρδίαις",63,71],["ὑμῶν",5,136],["ἐπὶ",9,1],["ταῖς",1,70],["κοίταις",705,71],["ὑμῶν",5,136],["κατανύγητε",2588,358],["διάψαλμα",687,20]],"Be ye angry, and sin not; feel compunction upon your beds for what ye say in your hearts. Pause."],["6",[["Θύσατε",436,69],["θυσίαν",156,10],["δικαιοσύνης",185,19],["καὶ",2,8],["ἐλπίσατε",511,69],["ἐπὶ",9,1],["Κύριον",7,7]],"Offer the sacrifice of righteousness, and trust in the Lord."],["7",[["Πολλοὶ",74,130],["λέγουσι",31,189],["τίς",39,150],["δείξει",871,120],["ἡμῖν",6,142],["τὰ",1,42],["ἀγαθά",113,65],["ἐσημειώθη",8282,38],["ἐφʼ",9,1],["ἡμᾶς",6,60],["τὸ",1,27],["φῶς",376,20],["τοῦ",1,23],["προσώπου",47,24],["σου",5,146],["Κύριε",7,251]],"Many say, Who will shew us good things? the light of thy countenance, O Lord, has been manifested towards us."],["8",[["Ἔδωκας",33,154],["εὐφροσύνην",360,10],["εἰς",8,1],["τὴν",1,9],["καρδίαν",63,10],["μου",6,48],["ἀπὸ",17,1],["καρποῦ",446,21],["σίτου",660,21],["καὶ",2,8],["οἴνου",261,21],["καὶ",2,8],["ἐλαίου",312,24],["αὐτῶν",3,41],["ἐπληθύνθησαν",315,94]],"Thou hast put gladness into my heart: they have been satisfied with the fruit of their corn and wine and oil."],["9",[["Ἐν",4,1],["εἰρήνῃ",210,2],["ἐπὶ",9,1],["τὸ",1,32],["αὐτὸ",3,121],["κοιμηθήσομαι",302,175],["καὶ",2,8],["ὑπνώσω",1665,157],["ὅτι",19,8],["σὺ",5,156],["Κύριε",7,251],["κατὰ",32,1],["μόνας",300,109],["ἐπʼ",9,1],["ἐλπίδι",527,2],["κατῴκισάς",976,154],["με",6,82]],"I will both lie down in peace and sleep: for thou, Lord, only hast caused me to dwell securely."]]