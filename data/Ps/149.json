[["1",[["Ἀλληλούϊα",1749,105],["Ἄσατε",2511,262],["τῷ",1,110],["Κυρίῳ",7,113],["ᾆσμα",2239,20],["καινόν",728,28],["ἡ",1,11],["αἴνεσις",989,13],["αὐτοῦ",3,48],["ἐν",4,1],["ἐκκλησίᾳ",563,2],["ὁσίων",917,115]],"Alleluia. Sing to the Lord a new song: his praise is in the assembly of the saints."],["2",[["Εὐφρανθήτω",244,25],["Ἰσραὴλ",27,105],["ἐπὶ",9,1],["τῷ",1,110],["ποιήσαντι",23,354],["αὐτὸν",3,82],["καὶ",2,8],["υἱοὶ",13,51],["Σιὼν",334,2],["ἀγαλλιάσθωσαν",738,72],["ἐπὶ",9,1],["τῷ",1,110],["βασιλεῖ",22,113],["αὐτῶν",3,41]],"Let Israel rejoice in him that made him; and let the children of Sion exult in their king."],["3",[["Αἰνεσάτωσαν",402,261],["τὸ",1,32],["ὄνομα",57,33],["αὐτοῦ",3,48],["ἐν",4,1],["χορῷ",1844,113],["ἐν",4,1],["τυμπάνῳ",1790,53],["καὶ",2,8],["ψαλτηρίῳ",1693,53],["ψαλάτωσαν",913,261],["αὐτῷ",3,233]],"Let them praise his name in the dance: let them sing praises to him with timbrel and psaltery."],["4",[["Ὅτι",19,8],["εὐδοκεῖ",906,87],["Κύριος",7,5],["ἐν",4,1],["λαῷ",35,113],["αὐτοῦ",3,48],["καὶ",2,8],["ὑψώσει",331,120],["πρᾳεῖς",2286,130],["ἐν",4,1],["σωτηρίᾳ",425,180]],"For the Lord takes pleasure in his people; and will exalt the meek with salvation."],["5",[["Καυχήσονται",1380,484],["ὅσιοι",917,130],["ἐν",4,1],["δόξῃ",141,2],["καὶ",2,8],["ἀγαλλιάσονται",738,127],["ἐπὶ",9,1],["τῶν",1,123],["κοιτῶν",704,61],["αὐτῶν",3,189]],"The saints shall rejoice in glory; and shall exult on their beds."],["6",[["Αἱ",1,185],["ὑψώσεις",331,159],["τοῦ",1,30],["Θεοῦ",20,21],["ἐν",4,1],["λάρυγγι",2092,113],["αὐτῶν",3,41],["καὶ",2,8],["ῥομφαῖαι",248,180],["δίστομοι",4214,187],["ἐν",4,1],["ταῖς",1,70],["χερσὶν",37,71],["αὐτῶν",3,41]],"The high praises of God shall be in their throat, and two-edged swords in their hands;"],["7",[["Τοῦ",1,30],["ποιῆσαι",23,100],["ἐκδίκησιν",821,10],["ἐν",4,1],["τοῖς",1,91],["ἔθνεσιν",60,92],["ἐλεγμοὺς",1798,31],["ἐν",4,1],["τοῖς",1,138],["λαοῖς",35,139]],"to execute vengeance on the nations, [and] punishments among the peoples;"],["8",[["Τ