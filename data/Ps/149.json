[["1",[["Ἀλληλούϊα",1746,105],["Ἄσατε",699,343],["τῷ",1,110],["Κυρίῳ",7,113],["ᾆσμα",2254,20],["καινόν",728,28],["ἡ",1,11],["αἴνεσις",990,13],["αὐτοῦ",3,48],["ἐν",4,1],["ἐκκλησίᾳ",562,2],["ὁσίων",918,115]],"Alleluia. Sing to the Lord a new song: his praise is in the assembly of the saints."],["2",[["Εὐφρανθήτω",242,25],["Ἰσραὴλ",27,105],["ἐπὶ",9,1],["τῷ",1,110],["ποιήσαντι",23,359],["αὐτὸν",3,82],["καὶ",2,8],["υἱοὶ",13,51],["Σιὼν",331,2],["ἀγαλλιάσθωσαν",737,72],["ἐπὶ",9,1],["τῷ",1,110],["βασιλεῖ",22,113],["αὐτῶν",3,41]],"Let Israel rejoice in him that made him; and let the children of Sion exult in their king."],["3",[["Αἰνεσάτωσαν",399,261],["τὸ",1,32],["ὄνομα",55,33],["αὐτοῦ",3,48],["ἐν",4,1],["χορῷ",1846,113],["ἐν",4,1],["τυμπάνῳ",1790,53],["καὶ",2,8],["ψαλτηρίῳ",1698,53],["ψαλάτωσαν",901,261],["αὐτῷ",3,233]],"Let them praise his name in the dance: let them sing praises to him with timbrel and psaltery."],["4",[["Ὅτι",19,8],["εὐδοκεῖ",908,87],["Κύριος",7,5],["ἐν",4,1],["λαῷ",35,113],["αὐτοῦ",3,48],["καὶ",2,8],["ὑψώσει",327,120],["πρᾳεῖς",2298,130],["ἐν",4,1],["σωτηρίᾳ",422,179]],"For the Lord takes pleasure in his people; and will exalt the meek with salvation."],["5",[["Καυχήσονται",1379,492],["ὅσιοι",918,130],["ἐν",4,1],["δόξῃ",141,2],["καὶ",2,8],["ἀγαλλιάσονται",737,127],["ἐπὶ",9,1],["τῶν",1,123],["κοιτῶν",705,61],["αὐτῶν",3,187]],"The saints shall rejoice in glory; and shall exult on their beds."],["6",[["Αἱ",1,183],["ὑψώσεις",327,159],["τοῦ",1,30],["Θεοῦ",20,21],["ἐν",4,1],["λάρυγγι",2097,113],["αὐτῶν",3,41],["καὶ",2,8],["ῥομφαῖαι",247,179],["δίστομοι",4227,185],["ἐν",4,1],["ταῖς",1,70],["χερσὶν",37,71],["αὐτῶν",3,41]],"The high praises of God shall be in their throat, and two-edged swords in their hands;"],["7",[["Τοῦ",1,30],["ποιῆσαι",23,100],["ἐκδίκησιν",608,10],["ἐν",4,1],["τοῖς",1,91],["ἔθνεσιν",59,92],["ἐλεγμοὺς",1800,31],["ἐν",4,1],["τοῖς",1,138],["λαοῖς",35,139]],"to execute vengeance on the nations, [and] punishments among the peoples;"],["8",[["Τοῦ",1,30],["δῆσαι",439,100],["τοὺς",1,56],["βασιλεῖς",22,31],["αὐτῶν",3,41],["ἐν",4,1],["πέδαις",2299,71],["καὶ",2,8],["τοὺς",1,56],["ἐνδόξους",731,58],["αὐτῶν",3,41],["ἐν",4,1],["χειροπέδαις",3679,71],["σιδηραῖς",1063,290]],"to bind their kings with fetters, and their nobles with manacles of iron;"],["9",[["Τοῦ",1,30],["ποιῆσαι",23,100],["ἐν",4,1],["αὐτοῖς",3,142],["κρίμα",266,33],["ἔγγραπτον",9717,29],["δόξα",141,186],["αὕτη",16,101],["ἐστὶ",10,87],["πᾶσι",11,215],["τοῖς",1,138],["ὁσίοις",918,215],["αὐτοῦ",3,48]],"to execute on them the judgment written: this honour have all his saints."]]