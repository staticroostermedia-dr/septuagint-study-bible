,756,105],["καὶ",2,8],["ἐπετάσθη",2956,38],["ἐπετάσθη",2956,38],["ἐπὶ",9,1],["πτερύγων",720,61],["ἀνέμων",852,77]],"And he mounted on cherubs and flew: he flew on the wings of winds."],["12",[["Καὶ",2,8],["ἔθετο",109,26],["σκότος",503,5],["ἀποκρυφὴν",5249,10],["αὐτοῦ",3,48],["κύκλῳ",258,17],["αὐτοῦ",3,48],["ἡ",1,11],["σκηνὴ",131,13],["αὐτοῦ",3,48],["σκοτεινὸν",2386,28],["ὕδωρ",85,20],["ἐν",4,1],["νεφέλαις",443,71],["ἀέρων",2667,77]],"And he made darkness his secret place: round about him was his tabernacle, [even] dark water in the clouds of the air."],["13",[["Ἀπὸ",17,1],["τῆς",1,18],["τηλαυγήσεως",8583,19],["ἐνώπιον",114,1],["αὐτοῦ",3,48],["αἱ",1,183],["νεφέλαι",443,179],["διῆλθον",427,141],["χάλαζα",1310,13],["καὶ",2,8],["ἄνθρακες",1403,51],["πυρός",118,24]],"At the brightness before him the clouds passed, hail and coals of fire."],["14",[["Καὶ",2,8],["ἐβρόντησεν",2884,3],["ἐξ",21,1],["οὐρανοῦ",94,21],["Κύριος",7,5],["καὶ",2,8],["ὁ",1,4],["ὕψιστος",473,16],["ἔδωκε",33,3],["φωνὴν",95,10],["αὐτοῦ",3,48]],"The Lord also thundered from heaven, and the Highest uttered his voice."],["15",[["Καὶ",2,8],["ἐξαπέστειλε",217,3],["βέλη",1159,43],["καὶ",2,8],["ἐσκόρπισεν",1837,3],["αὐτοὺς",3,60],["καὶ",2,8],["ἀστραπὰς",1854,40],["ἐπλήθυνε",315,14],["καὶ",2,8],["συνετάραξεν",2047,3],["αὐτούς",3,60]],"And he sent forth [his] weapons, and scattered them; and multiplied lightnings, and routed them."],["16",[["Καὶ",2,8],["ὤφθησαν",111,94],["αἱ",1,183],["πηγαὶ",563,179],["τῶν",1,44],["ὑδάτων",85,45],["καὶ",2,8],["ἀνεκαλύφθη",1991,38],["τὰ",1,42],["θεμέλια",950,43],["τῆς",1,18],["οἰκουμένης",1326,19],["ἀπὸ",17,1],["ἐπιτιμήσεώς",3449,19],["σου",5,146],["Κύριε",7,251],["ἀπὸ",17,1],["ἐνπνεύσεως",0,0],["πνεύματος",167,24],["ὀργῆς",198,19],["σου",5,146]],"And the springs of waters appeared, and the foundations of the world were exposed, at thy rebuke, O Lord, at the blasting of the breath of thy wrath."],["17",[["Ἐξαπέστειλεν",217,3],["ἐξ",21,1],["ὕψους",480,24],["καὶ",2,8],["ἔλαβέ",46,3],["με",6,82],["προσελάβετό",3127,26],["με",6,82],["ἐξ",21,1],["ὑδάτων",85,45],["πολλῶν",74,79]],"He sent from on high and took me, he drew me to himself out of many waters."],["18",[["Ῥύσεταί",335,89],["με",6,82],["ἐξ",21,1],["ἐχθρῶν",135,77],["μου",6,48],["δυνατῶν",354,163],["καὶ",2,8],["ἐκ",21,1],["τῶν",1,76],["μισούντων",355,164],["με",6,82],["ὅτι",19,8],["ἐστερεώθησαν",1354,94],["ὑπὲρ",139,1],["ἐμέ",6,82]],"He will deliver me from my mighty enemies, and from them that hate me; for they are stronger than I."],["19",[["Προέφθασάν",1834,141],["με",6,82],["ἐν",4,1],["ἡμέρᾳ",28,2],["κακώσεώς",2096,19],["μου",6,83],["καὶ",2,8],["ἐγένετο",30,26],["Κύριος",7,5],["ἀντιστήριγμά",5231,20],["μου",6,48]],"They prevented me in the day of mine affliction: but the Lord was my stay against [them]."],["20",[["Καὶ",2,8],["ἐξήγαγέ",299,3],["με",6,82],["εἰς",8,1],["πλατυσμὸν",3627,7],["ῥύσεταί",335,89],["με",6,82],["ὅτι",19,8],["ἠθέλησέ",837,3],["με",6,82]],"And he brought me out into a wide place: he will deliver me, because he has pleasure in me."],["21",[["Καὶ",2,8],["ἀνταποδώσει",661,120],["μοι",6,49],["Κύριος",7,5],["κατὰ",32,1],["τὴν",1,9],["δικαιοσύνην",185,10],["μου",6,48],["καὶ",2,8],["κατὰ",32,1],["τὴν",1,9],["καθαριότητα",3544,10],["τῶν",1,123],["χειρῶν",37,61],["μου",6,48],["ἀνταποδώσει",661,120],["μοι",6,49]],"And the Lord will recompense me according to my righteousness; even according to the purity of my hands will he recompense me."],["22",[["Ὅτι",19,8],["ἐφύλαξα",127,147],["τὰς",1,39],["ὁδοὺς",67,40],["Κυρίου",7,21],["καὶ",2,8],["οὐκ",12,17],["ἠσέβησα",1313,147],["ἀπὸ",17,1],["τοῦ",1,30],["Θεοῦ",20,21],["μου",6,48]],"For I have kept the ways of the Lord and have not wickedly departed from my God."],["23",[["Ὅτι",19,8],["πάντα",11,65],["τὰ",1,42],["κρίματα",266,43],["αὐτοῦ",3,48],["ἐνώπιόν",114,1],["μου",6,48],["καὶ",2,8],["τὰ",1,42],["δικαιώματα",425,43],["αὐτοῦ",3,48],["οὐκ",12,17],["ἀπέστησαν",514,141],["ἀπʼ",17,1],["ἐμοῦ",6,48]],"For all his judgments were before