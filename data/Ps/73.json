[["1",[["Συνέσεως",467,19],["τῷ",1,110],["Ἀσάφ",1105,5],["Ἱνατί",101,238],["ἀπόσω",9266,459],["ὁ",1,4],["Θεὸς",20,5],["εἰς",8,1],["τέλος",369,33],["ὠργίσθη",725,38],["ὁ",1,4],["θυμός",177,5],["σου",5,146],["ἐπὶ",9,1],["πρόβατα",194,43],["νομῆς",1209,19],["σου",5,146]],"[A Psalm] of instruction for Asaph. Wherefore hast thou rejected [us], O God, for ever? [wherefore] is thy wrath kindled against the sheep of thy pasture?"],["2",[["Μνήσθητι",231,242],["τῆς",1,18],["συναγωγῆς",284,19],["σου",5,146],["ἧς",24,162],["ἐκτήσω",533,169],["ἀπʼ",17,1],["ἀρχῆς",269,19],["ἐλυτρώσω",548,169],["ῥάβδον",492,10],["κληρονομίας",297,19],["σου",5,146],["ὄρος",86,33],["Σιὼν",331,2],["τοῦτο",16,122],["ὃ",1,4],["κατεσκήνωσας",802,154],["ἐν",4,1],["αὐτῷ",3,49]],"Remember thy congregation which thou hast purchased from the beginning; thou didst ransom the rod of thine inheritance; this mount Sion wherein thou hast dwelt."],["3",[["Ἔπαρον",752,198],["τὰς",1,39],["χεῖράς",37,40],["σου",5,146],["ἐπὶ",9,1],["τὰς",1,39],["ὑπερηφανίας",1130,40],["αὐτῶν",3,41],["εἰς",8,1],["τέλος",369,33],["ὅσα",102,63],["ἐπονηρεύσατο",1387,253],["ὁ",1,4],["ἐχθρὸς",135,5],["ἐν",4,1],["τοῖς",1,138],["ἁγίοις",75,215],["σου",5,146]],"Lift up thine hands against their pride continually; [because of] all that the enemy has done wickedly in thy holy places."],["4",[["Καὶ",2,8],["ἐνεκαυχήσαντο",4589,436],["οἱ",1,128],["μισοῦντές",355,137],["σε",5,161],["ἐν",4,1],["μέσῳ",112,34],["τῆς",1,18],["ἑορτῆς",485,19],["σου",5,146]],"And they that hate thee have boasted in the midst of thy feast; they have set up their standards for signs,"],["5",[["ἔθεντο",109,182],["τὰ",1,42],["σημεῖα",502,43],["αὐτῶν",3,41],["σημεῖα",502,43],["καὶ",2,8],["οὐκ",12,17],["ἔγνωσαν",81,141],["ὡς",36,8],["εἰς",8,1],["τὴν",1,9],["εἴσοδον",1002,10],["ὑπεράνω",1947,17],["ὡς",36,8],["ἐν",4,1],["δρυμῷ",799,113],["ξύλων",196,45],["ἀξίναις",3407,71],["ἐξέκοψαν",1237,141]],"ignorantly as it were in the entrance above;"],["6",[["τὰς",1,39],["θύρας",277,19],["αὐτῆς",3,83],["ἐπιτοαυτὸ",1405,105],["ἐν",4,1],["πελέκει",4393,186],["καὶ",2,8],["λαξευτηρίῳ",7621,53],["κατέῤῥαξαν",2913,141],["αὐτήν",3,98]],"they cut down its doors at once with axes as in a wood of trees; they have broken it down with hatchet and stone cutter."],["7",[["Ἐνεπύρισαν",0,0],["ἐν",4,1],["πυρὶ",118,53],["τὸ",1,32],["ἁγιαστήριόν",5283,33],["σου",5,146],["εἰς",8,1],["τὴν",1,9],["γῆν",26,10],["ἐβεβήλωσαν",589,141],["τὸ",1,32],["σκήνωμα",680,33],["τοῦ",1,23],["ὀνόματός",55,24],["σου",5,146]],"They have burnt thy sanctuary with fire to the ground; they have profaned the habitation of thy name."],["8",[["Εἶπαν",18,221],["ἐν",4,1],["τῇ",1,95],["καρδίᾳ",63,2],["αὐτῶν",3,41],["ἡ",1,11],["συγγένεια",1309,13],["αὐτῶν",3,41],["ἐπιτοαυτὸ",1405,105],["δεῦτε",1162,17],["καταπαύσωμεν",777,75],["τὰς",1,39],["ἑορτὰς",485,40],["Κυρίου",7,21],["ἀπὸ",17,1],["τῆς",1,18],["γῆς",26,19]],"They have said in their heart, [even] all their kindred together, Come, let us abolish the feasts of the Lord from the earth."],["9",[["Τὰ",1,42],["σημεῖα",502,43],["ἡμῶν",6,41],["οὐκ",12,17],["εἴδομεν",73,288],["οὐκ",12,17],["ἔστιν",10,87],["ἔτι",110,17],["προφήτης",175,5],["καὶ",2,8],["ἡμᾶς",6,60],["οὐ",12,17],["γνώσεται",81,89],["ἔτι",110,17]],"We have not seen our signs; there is no longer a prophet; and [God] will not know us any more."],["10",[["Ἕως",42,8],["πότε",455,12],["ὁ",1,4],["Θεὸς",20,5],["ὀνειδιεῖ",946,120],["ὁ",1,4],["ἐχθρὸς",135,5],["παροξυνεῖ",1041,120],["ὁ",1,4],["ὑπεναντίος",1177,16],["τὸ",1,32],["ὄνομά",55,33],["σου",5,146],["εἰς",8,1],["τέλος",369,33]],"How long, O God, shall the enemy reproach? shall the enemy provoke thy name for ever?"],["11",[["Ἱνατί",101,238],["ἀποστρέφεις",130,145],["τὴν",1,9],["χεῖρά",37,10],["σου",5,146],["καὶ",2,8],["τὴν",1,9],["δεξιάν",282,37],["σου",5,146],["ἐκ",21,1],["μέσου",112,153],["τοῦ",1,30],["κόλπου",1140,21],["σου",5,146],["εἰς",8,1],["τέλος",369,33]],"Wherefore turnest thou away thine hand, and thy right hand from the midst of thy bosom for ever?"],["12",[["Ὁ",1,4],["δὲ",14,12],["Θεὸς",20,5],["βασιλεὺς",22,5],["ἡμῶν",6,41],["πρὸ",235,1],["αἰῶνος",100,21],["εἰργάσατο",468,253],["σωτηρίαν",422,10],["ἐν",4,1],["μέσῳ",112,34],["τῆς",1,18],["γῆς",26,19]],"But God is our King of old; he has wrought salvation in the midst of the earth."],["13",[["Σὺ",5,156],["ἐκραταίωσας",734,154],["ἐν",4,1],["τῇ",1,95],["δυνάμει",98,2],["σου",5,146],["τὴν",1,9],["θάλασσαν",137,10],["σὺ",5,156],["συνέτριψας",267,154],["τὰς",1,39],["κεφαλὰς",144,40],["τῶν",1,76],["δρακόντων",1269,77],["ἐπὶ",9,1],["τοῦ",1,23],["ὕδατος",85,24],["Σὺ",5,156],["συνέτριψας",267,154],["τὰς",1,39],["κεφαλὰς",144,40],["τοῦ",1,30],["δράκοντος",1269,21]],"Thou didst establish the sea, in thy might, thou didst break to pieces the heads of the dragons in the water."],["14",[["ἔδωκας",33,154],["αὐτὸν",3,82],["βρῶμα",714,33],["λαοῖς",35,139],["τοῖς",1,138],["Αἰθίοψι",1538,139]],"Thou didst break to pieces the heads of the dragon; thou didst give him [for] meat to the Ethiopian nations."],["15",[["Σὺ",5,156],["διέῤῥηξας",673,154],["πηγὰς",563,40],["καὶ",2,8],["χειμάῤῥους",736,31],["σὺ",5,156],["ἐξήρανας",843,154],["ποταμοὺς",249,31],["ἠθάμ",9806,105]],"Thou didst cleave fountains and torrents; thou driedst up mighty rivers."],["16",[["Σή",401,13],["ἐστιν",10,87],["ἡ",1,11],["ἡμέρα",28,13],["καὶ",2,8],["σή",401,13],["ἐστιν",10,87],["ἡ",1,11],["νὺξ",216,13],["σὺ",5,156],["κατηρτίσω",1962,169],["ἥλιον",320,7],["καὶ",2,8],["σελήνην",1211,10]],"The day is thine, and the night is thine; thou hast prepared the sun and the moon."],["17",[["Σὺ",5,156],["ἐποίησας",23,154],["πάντα",11,65],["τὰ",1,42],["ὅρια",234,43],["τῆς",1,18],["γῆς",26,19],["θέρος",3076,20],["καὶ",2,8],["ἔαρ",4122,20],["σὺ",5,156],["ἐποίησας",23,154]],"Thou hast made all the borders of the earth; thou hast made summer and spring."],["18",[["Μνήσθητι",231,242],["ταύτης",16,293],["τῆς",1,18],["κτίσεώς",2278,19],["σου",5,146],["ἐχθρὸς",135,5],["ὠνείδισε",946,3],["τὸν",1,6],["Κύριον",7,7],["καὶ",2,8],["λαὸς",35,5],["ἄφρων",438,16],["παρώξυνε",1041,14],["τὸ",1,32],["ὄνομά",55,33],["σου",5,146]],"Remember this thy creation: an enemy has reproached the Lord, and a foolish people has provoked thy name."],["19",[["Μὴ",25,8],["παραδῷς",254,170],["τοῖς",1,91],["θηρίοις",400,92],["ψυχὴν",62,10],["ἐξομολογουμένην",478,167],["σοι",5,151],["τῶν",1,123],["ψυχῶν",62,61],["τῶν",1,123],["πενήτων",668,77],["σου",5,146],["μὴ",25,8],["ἐπιλάθῃ",512,160],["εἰς",8,1],["τέλος",369,33]],"Deliver not to the wild beasts a soul that gives praise to thee: forget not for ever the souls of thy poor."],["20",[["Ἐπίβλεψον",516,198],["εἰς",8,1],["τὴν",1,9],["διαθήκην",168,10],["σου",5,146],["ὅτι",19,8],["ἐπληρωθήσαν",529,94],["οἱ",1,128],["ἐσκοτωμένοι",3354,375],["τῆς",1,18],["γῆς",26,19],["οἴκων",34,77],["ἀνομιῶν",274,61]],"Look upon thy covenant: for the dark [places] of the earth are filled with the habitations of iniquity."],["21",[["Μὴ",25,8],["ἀποστραφήτω",130,25],["τεταπεινωμένος",0,0],["καὶ",2,8],["κατῃσχυμμένος",0,0],["πτωχὸς",496,5],["καὶ",2,8],["πένης",668,5],["αἰνέσουσι",399,207],["τὸ",1,32],["ὄνομά",55,33],["σου",5,146]],"Let not the afflicted and shamed one be rejected: the poor and needy shall praise thy name."],["22",[["Ἀνάστα",121,275],["ὁ",1,4],["Θεὸς",20,5],["δίκασον",1620,198],["τὴν",1,9],["δίκην",1224,10],["σου",5,146],["μνήσθητι",231,242],["τῶν",1,76],["ὀνειδισμῶν",732,77],["σου",5,146],["τῶν",1,76],["ὑπὸ",122,1],["ἄφρονος",438,218],["ὅλην",233,37],["τὴν",1,9],["ἡμέραν",28,10]],"Arise, O God, plead thy cause: remember thy reproaches that come from the foolish one all the day."],["23",[["Μὴ",25,8],["ἐπιλάθῃ",512,160],["τῆς",1,18],["φωνῆς",95,19],["τῶν",1,76],["ἱκετῶν",4657,77],["σου",5,146],["ἡ",1,11],["ὑπερηφανία",1130,13],["τῶν",1,76],["μισούντων",355,164],["σε",5,161],["ἀναβαίη",87,276],["διαπαντὸς",506,17],["πρὸς",15,1],["σέ",5,161]],"Forget not the voice of thy suppliants: let the pride of them that hate thee continually ascend before thee."]]