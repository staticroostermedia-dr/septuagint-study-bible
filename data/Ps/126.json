[["1",[["Ὠδὴ",776,105],["τῶν",1,76],["ἀναβαθμῶν",1484,77],["Ἐὰν",45,8],["μὴ",25,8],["Κύριος",7,5],["οἰκοδομήσῃ",126,116],["οἶκον",34,7],["εἰς",8,1],["μάτην",1774,17],["ἐκοπίασαν",921,141],["οἱ",1,128],["οἰκοδομοῦντες",126,137],["ἐὰν",45,8],["μὴ",25,8],["Κύριος",7,5],["φυλάξῃ",125,116],["πόλιν",41,10],["εἰς",8,1],["μάτην",1774,17],["ἠγρύπνησεν",2802,3],["ὁ",1,4],["φυλάσσων",125,67]],"A Song of Degrees. Except the Lord build the house, they that build labour in vain: except the Lord keep the city, the watchman watches in vain."],["2",[["Εἰς",8,1],["μάτην",1774,17],["ὑμῖν",5,86],["ἐστι",10,87],["τὸ",1,32],["ὀρθρίζειν",931,54],["ἐγείρεσθε",746,382],["μετὰ",29,1],["τὸ",1,32],["καθῆσθαι",419,570],["οἱ",1,128],["ἐσθίοντες",147,137],["ἄρτον",197,7],["ὀδύνης",774,19],["ὅταν",319,8],["δῷ",33,160],["τοῖς",1,138],["ἀγαπητοῖς",1920,215],["αὐτοῦ",3,48],["ὕπνον",1010,7]],"It is vain for you to rise early: ye rise up after resting, ye that eat the bread of grief; while he gives sleep to his beloved."],["3",[["Ἰδοὺ",51,17],["ἡ",1,11],["κληρονομία",299,13],["Κυρίου",7,21],["υἱοί",13,51],["ὁ",1,4],["μισθὸς",816,5],["τοῦ",1,30],["καρποῦ",448,21],["τῆς",1,18],["γαστρός",777,19]],"Behold, the inheritance of the Lord, children, the reward of the fruit of the womb."],["4",[["Ὡσεὶ",343,17],["βέλη",1156,43],["ἐν",4,1],["χειρὶ",37,2],["δυνατοῦ",356,153],["οὕτως",71,17],["οἱ",1,128],["υἱοὶ",13,51],["τῶν",1,76],["ἐκτετιναγμένων",1753,412]],"As arrows in the hand of a mighty man; so are the children of those who were outcasts."],["5",[["Μακάριος",806,16],["ὃς",24,246],["πληρώσει",518,120],["τὴν",1,9],["ἐπιθυμίαν",699,10],["αὐτοῦ",3,48],["ἐξ",21,1],["αὐτῶν",3,41],["οὐ",12,17],["καταισχυνθήσονται",696,135],["ὅταν",319,8],["λαλῶσι",50,265],["τοῖς",1,138],["ἐχθροῖς",135,139],["αὐτῶν",3,41],["ἐν",4,1],["πύλαις",162,71]],"Blessed is the man who shall satisfy his desire with them: they shall not be ashamed when they shall speak to their enemies in the gates."]]