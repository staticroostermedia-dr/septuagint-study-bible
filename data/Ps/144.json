[["1",[["Αἴνεσις",989,13],["τοῦ",1,30],["Δαυίδ",52,105],["Ὑψώσω",331,157],["σε",5,161],["ὁ",1,4],["Θεός",20,5],["μου",6,48],["ὁ",1,4],["βασιλεύς",22,5],["μου",6,48],["καὶ",2,8],["εὐλογήσω",149,157],["τὸ",1,32],["ὄνομά",57,33],["σου",5,146],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["καὶ",2,8],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["τοῦ",1,30],["αἰῶνος",100,21]],"David's [Psalm of] praise. I will exalt thee, my God, my king; and I will bless thy name for ever and ever."],["2",[["Καθʼ",32,1],["ἑκάστην",171,37],["ἡμέραν",28,10],["εὐλογήσω",149,157],["σε",5,161],["καὶ",2,8],["αἰνέσω",402,157],["τὸ",1,32],["ὄνομά",57,33],["σου",5,146],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["καὶ",2,8],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["τοῦ",1,30],["αἰῶνος",100,21]],"Every day will I bless thee, and I will praise thy name for ever and ever."],["3",[["Μέγας",66,16],["ὁ",1,4],["Κύριος",7,5],["καὶ",2,8],["αἰνετὸς",2564,16],["σφόδρα",150,17],["καὶ",2,8],["τῆς",1,18],["μεγαλωσύνης",1473,19],["αὐτοῦ",3,48],["οὐκ",12,17],["ἔστι",10,87],["πέρας",876,20]],"The Lord is great, and greatly to be praised; and there is no end of his greatness."],["4",[["Γενεὰ",286,13],["καὶ",2,8],["γενεὰ",286,13],["ἐπαινέσει",1534,120],["τὰ",1,42],["ἔργα",105,43],["σου",5,146],["καὶ",2,8],["τὴν",1,9],["δύναμίν",98,10],["σου",5,146],["ἀπαγγελοῦσι",273,207]],"Generation after generation shall praise thy works, and tell of thy power."],["5",[["Καὶ",2,8],["τὴν",1,9],["μεγαλοπρέπειαν",2738,10],["τῆς",1,18],["δόξης",141,19],["τῆς",1,18],["ἁγιωσύνης",4057,19],["σου",5,146],["λαλήσουσι",50,207],["καὶ",2,8],["τὰ",1,42],["θαυμάσιά",884,65],["σου",5,146],["διηγήσονται",800,127]],"And they shall speak of the glorious majesty of thy holiness, and recount thy wonders."],["6",[["Καὶ",2,8],["τὴν",1,9],["δύναμιν",98,10],["τῶν",1,76],["φοβερῶν",1210,163],["σου",5,146],["ἐροῦσι",165,207],["καὶ",2,8],["τὴν",1,9],["μεγαλωσύνην",1473,10],["σου",5,146],["διηγήσονται",800,127]],"And they shall speak of the power of thy terrible [acts]; and recount thy greatness."],["7",[["Μνήμην",2177,10],["τοῦ",1,23],["πλήθους",200,24],["τῆς",1,18],["χρηστότητός",1845,19],["σου",5,146],["ἐξερεύξονται",5314,127],["καὶ",2,8],["τῇ",1,95],["δικαιοσύνῃ",187,2],["σου",5,146],["ἀγαλλιάσονται",738,127]],"They shall utter the memory of the abundance of thy goodness, and shall exult in thy righteousness."],["8",[["Οἰκτίρμων",2102,16],["καὶ",2,8],["ἐλεήμων",1489,16],["ὁ",1,4],["Κύριος",7,5],["μακρόθυμος",1770,16],["καὶ",2,8],["πολυέλεος",2616,16]],"The Lord is compassionate, and merciful; long-suffering, and abundant in mercy."],["9",[["Χρηστὸς",1359,16],["Κύριος",7,5],["τοῖς",1,138],["ὑπομένουσι",639,352],["καὶ",2,8],["οἱ",1,128],["οἰκτιρμοὶ",1187,51],["αὐτοῦ",3,48],["ἐπὶ",9,1],["πάντα",11,65],["τὰ",1,42],["ἔργα",105,43],["αὐτοῦ",3,48]],"The Lord is good to those that wait [on him]; and his compassions are over all his works."],["10",[["Ἐξομολογησάσθωσάν",479,533],["σοι",5,151],["Κύριε",7,250],["πάντα",11,65],["τὰ",1,42],["ἔργα",105,43],["σου",5,146],["καὶ",2,8],["οἱ",1,128],["ὅσιοί",917,130],["σου",5,146],["εὐλογησάτωσάν",149,261],["σε",5,161]],"Let all thy works, O Lord, give thanks to thee; and let thy saints bless thee."],["11",[["Δόξαν",141,10],["τῆς",1,18],["βασιλείας",157,19],["σου",5,146],["ἐροῦσι",165,207],["καὶ",2,8],["τὴν",1,9],["δυναστείαν",918,10],["σου",5,146],["λαλήσουσιν",50,207]],"They shall speak of the glory of thy kingdom, and talk of thy dominion;"],["12",[["Τοῦ",1,30],["γνωρίσαι",748,100],["τοῖς",1,138],["υἱοῖς",13,139],["τῶν",1,76],["ἀνθρώπων",43,77],["τὴν",1,9],["δυναστείαν",918,10],["σου",5,146],["καὶ",2,8],["τὴν",1,9],["δόξαν",141,10],["τῆς",1,18],["μεγαλοπρεπείας",2738,19],["τῆς",1,18],["βασιλείας",157,19],["σου",5,146]],"to make known to the sons of men thy power, and the glorious majesty of thy kingdom."],["13",[["Ἡ",1,11],["βασιλεία",157,13],["σου",5,146],["βασιλεία",157,13],["πάντων",11,163],["τῶν",1,76],["αἰώνων",100,77],["καὶ",2,8],["ἡ",1,11],["δεσποτία",6942,13],["σου",5,146],["ἐν",4,1],["πάσῃ",11,96],["γενεᾷ",286,2],["καὶ",2,8],["γενεᾷ",286,2]],"Thy kingdom is an everlasting kingdom, and thy dominion [endures] through all generations."],["13a",[["πιστὸς",750,16],["Κύριος",7,5],["ἐν",4,1],["τοῖς",1,138],["λόγοις",48,139],["αὐτοῦ",3,48],["καὶ",2,8],["ὅσιος",917,16],["ἐν",4,1],["πᾶσι",11,90],["τοῖς",1,91],["ἔργοις",105,92],["αὐτοῦ",3,48]],"The Lord is faithful in his words, and holy in all his works."],["14",[["Ὑποστηρίζει",6650,87],["Κύριος",7,5],["πάντας",11,58],["τοὺς",1,56],["καταπίπτοντας",3280,229],["καὶ",2,8],["ἀνορθοῖ",2208,87],["πάντας",11,58],["τοὺς",1,56],["κατεῤῥαγμένους",2585,369]],"The Lord supports all that are falling, and sets up all that are broken down."],["15",[["Οἱ",1,128],["ὀφθαλμοὶ",91,51],["πάντων",11,163],["εἰς",8,1],["σὲ",5,161],["ἐλπίζουσι",514,191],["καὶ",2,8],["σὺ",5,156],["δίδως",33,145],["τὴν",1,9],["τροφὴν",1390,10],["αὐτῶν",3,41],["ἐν",4,1],["εὐκαιρίᾳ",3828,180]],"The eyes of all wait upon thee; and thou givest [them] their food in due season."],["16",[["Ἀνοίγεις",362,145],["σὺ",5,156],["τὰς",1,39],["χεῖράς",37,40],["σου",5,146],["καὶ",2,8],["ἐμπιπλᾷς",427,199],["πᾶν",11,29],["ζῶον",107,47],["εὐδοκίας",1625,40]],"Thou openest thine hands, and fillest every living thing with pleasure."],["17",[["Δίκαιος",153,16],["Κύριος",7,5],["ἐν",4,1],["πάσαις",11,287],["ταῖς",1,70],["ὁδοῖς",68,71],["αὐτοῦ",3,48],["καὶ",2,8],["ὅσιος",917,16],["ἐν",4,1],["πᾶσι",11,90],["τοῖς",1,91],["ἔργοις",105,92],["αὐτοῦ",3,48]],"The Lord is righteous in all his ways, and holy in all his works."],["18",[["Ἐγγὺς",1026,17],["Κύριος",7,5],["πᾶσιν",11,215],["τοῖς",1,138],["ἐπικαλουμένοις",341,342],["αὐτόν",3,82],["πᾶσι",11,215],["τοῖς",1,138],["ἐπικαλουμένοις",341,342],["αὐτὸν",3,82],["ἐν",4,1],["ἀληθείᾳ",352,2]],"The Lord is near to all that call upon him, to all that call upon him in truth."],["19",[["Θέλημα",1039,33],["τῶν",1,76],["φοβουμένων",134,295],["αὐτὸν",3,82],["ποιήσει",23,120],["καὶ",2,8],["τῆς",1,18],["δεήσεως",677,19],["αὐτῶν",3,41],["ἐπ