[["1",[["Ψαλμὸς",639,5],["τῷ",1,110],["Δαυὶδ",52,105],["ἐν",4,1],["τῷ",1,110],["εἶναι",10,54],["αὐτὸν",3,82],["ἐν",4,1],["τῇ",1,95],["ἐρήμῳ",160,96],["τῆς",1,18],["Ἰδουμαίας",1223,19]],"A Psalm of David, when he was in the wilderness of Idumea."],["2",[["Ὁ",1,4],["Θεὸς",20,5],["ὁ",1,4],["Θεός",20,5],["μου",6,48],["πρὸς",15,1],["σὲ",5,161],["ὀρθρίζω",930,149],["ἐδίψησέ",1163,3],["σοι",5,151],["ἡ",1,11],["ψυχή",62,13],["μου",6,48],["ποσαπλῶς",8086,378],["σοι",5,151],["ἡ",1,11],["σάρξ",287,13],["μου",6,48],["ἐν",4,1],["γῇ",26,2],["ἐρήμῳ",160,96],["καὶ",2,8],["ἀβάτῳ",1488,96],["καὶ",2,8],["ἀνύδρῳ",1705,96]],"O God, my God, I cry to thee early; my soul has thirsted for thee: how often has my flesh [longed] after thee, in a barren and trackless and dry land!"],["3",[["οὕτως",70,17],["ἐν",4,1],["τῷ",1,110],["ἁγίῳ",75,111],["ὤφθην",111,148],["σοι",5,151],["τοῦ",1,30],["ἰδεῖν",73,100],["τὴν",1,9],["δύναμίν",98,10],["σου",5,146],["καὶ",2,8],["τὴν",1,9],["δόξαν",141,10],["σου",5,146]],"Thus have I appeared before thee in the sanctuary, that I might see thy power and thy glory."],["4",[["Ὅτι",19,8],["κρεῖσσον",922,29],["τὸ",1,32],["ἔλεός",182,33],["σου",5,146],["ὑπὲρ",139,1],["ζωὰς",212,40],["τὰ",1,42],["χείλη",361,43],["μου",6,48],["ἐπαινέσουσί",1532,207],["σε",5,161]],"For thy mercy is better than life: my lips shall praise thee."],["5",[["Οὕτως",70,17],["εὐλογήσω",147,157],["σε",5,161],["ἐν",4,1],["τῇ",1,95],["ζωῇ",212,2],["μου",6,48],["ἐν",4,1],["τῷ",1,52],["ὀνόματί",55,53],["σου",5,146],["ἀρῶ",248,157],["τὰς",1,39],["χεῖράς",37,40],["μου",6,48]],"Thus will I bless thee during my life: I will lift up my hands in thy name."],["6",[["Ὡσεὶ",342,17],["στέατος",574,24],["καὶ",2,8],["πιότητος",2615,19],["ἐμπλησθείη",424,555],["ἡ",1,11],["ψυχή",62,13],["μου",6,48],["καὶ",2,8],["χείλη",361,43],["ἀγαλλιάσεως",1985,19],["αἰνέσει",399,120],["τὸ",1,32],["ὄνομά",55,33],["σου",5,146]],"Let my soul be filled as with marrow and fatness; and [my] joyful lips shall praise thy name."],["7",[["Εἰ",77,8],["ἐμνημόνευόν",1901,129],["σου",5,146],["ἐπὶ",9,1],["τῆς",1,18],["στρωμνῆς",2634,19],["μου",6,83],["ἐν",4,1],["τοῖς",1,138],["ὄρθροις",1436,139],["ἐμελέτων",1344,129],["εἰς",8,1],["σέ",5,161]],"Forasmuch as I have remembered thee on my bed: in the early seasons I have meditated on thee."],["8",[["Ὅτι",19,8],["ἐγενήθης",30,363],["βοηθός",948,5],["μου",6,48],["καὶ",2,8],["ἐν",4,1],["τῇ",1,95],["σκέπῃ",1189,2],["τῶν",1,123],["πτερύγων",720,61],["σου",5,146],["ἀγαλλιάσομαι",737,176]],"For thou hast been my helper, and in the shelter of thy wings will I rejoice."],["9",[["Ἐκολλήθη",1272,38],["ἡ",1,11],["ψυχή",62,13],["μου",6,48],["ὀπίσω",166,17],["σου",5,146],["ἐμοῦ",6,48],["ἀντελάβετο",984,26],["ἡ",1,11],["δεξιά",282,15],["σου",5,146]],"My soul has kept very close behind thee: thy right hand has upheld me."],["10",[["Αὐτοὶ",3,193],["δὲ",14,12],["εἰς",8,1],["μάτην",1774,17],["ἐζήτησαν",190,141],["τὴν",1,9],["ψυχήν",62,10],["μου",6,48],["εἰσελεύσονται",88,127],["εἰς",8,1],["τὰ",1,42],["κατώτατα",3289,65],["τῆς",1,18],["γῆς",26,19]],"But they vainly sought after my soul; they shall go into the lowest parts of the earth."],["11",[["παραδοθήσονται",254,135],["εἰς",8,1],["χεῖρας",37,40],["ῥομφαίας",247,40],["μερίδες",396,179],["ἀλωπέκων",3165,61],["ἔσονται",10,127]],"They shall be delivered up to the power of the sword; they shall be portions for foxes."],["12",[["Ὁ",1,4],["δὲ",14,12],["βασιλεὺς",22,5],["εὐφρανθήσεται",242,125],["ἐπὶ",9,1],["τῷ",1,110],["Θεῷ",20,113],["ἐπαινεθήσεται",1532,125],["πᾶς",11,16],["ὁ",1,4],["ὀμνύων",346,67],["ἐν",4,1],["αὐτῷ",3,49],["ὅτι",19,8],["ἐνεφράγη",1751,38],["στόμα",123,33],["λαλούντων",50,164],["ἄδικα",402,74]],"But the king shall rejoice in God; every one that swears by him shall be praised; for the mouth of them that speak unjust things has been stopped."]]