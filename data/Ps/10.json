[["1",[["Εἰς",8,1],["τὸ",1,32],["τέλος",373,33],["ψαλμὸς",644,5],["τῷ",1,110],["Δαυὶδ",52,105],["Ἐπὶ",9,1],["τῷ",1,110],["Κυρίῳ",7,113],["πέποιθα",344,85],["πῶς",441,12],["ἐρεῖτε",667,339],["τῇ",1,95],["ψυχῇ",63,2],["μου",6,48],["μεταναστεύου",4906,249],["ἐπὶ",9,1],["τὰ",1,42],["ὄρη",87,43],["ὡς",36,8],["στρουθίον",2492,20]],"For the end, a Psalm of David. In the Lord I have put my trust: how will ye say to my soul, Flee to the mountains as a sparrow?"],["2",[["Ὅτι",19,8],["ἰδοὺ",51,17],["οἱ",1,128],["ἁμαρτωλοὶ",409,130],["ἐνέτειναν",1991,141],["τόξον",711,20],["ἡτοίμασαν",371,141],["βέλη",1156,43],["εἰς",8,1],["φαρέτραν",2796,10],["τοῦ",1,30],["κατατοξεῦσαι",3556,100],["ἐν",4,1],["σκοτομήνῃ",8248,2],["τοὺς",1,56],["εὐθεῖς",825,58],["τῇ",1,95],["καρδίᾳ",64,2]],"For behold the sinners have bent [their] bow, they have prepared their arrows for the quiver, to shoot privily at the upright in heart."],["3",[["Ὅτι",19,8],["ἃ",1,11],["κατηρτίσω",1888,169],["καθεῖλον",602,141],["ὁ",1,4],["δὲ",14,12],["δίκαιος",153,16],["τί",39,119],["ἐποίησε",23,3]],"For they have pulled down what thou didst frame, but what has the righteous done?"],["4",[["Κύριος",7,5],["ἐν",4,1],["ναῷ",483,113],["ἁγίῳ",75,111],["αὐτοῦ",3,48],["Κύριος",7,5],["ἐν",4,1],["οὐρανῷ",94,113],["ὁ",1,4],["θρόνος",383,5],["αὐτοῦ",3,48],["οἱ",1,128],["ὀφθαλμοὶ",91,51],["αὐτοῦ",3,48],["εἰς",8,1],["τὸν",1,6],["πένητα",672,7],["ἀποβλέπουσι",4033,191],["τὰ",1,42],["βλέφαρα",2867,43],["αὐτοῦ",3,48],["ἐξετάζει",2533,87],["τοὺς",1,56],["υἱοὺς",13,31],["τῶν",1,76],["ἀνθρώπων",43,77]],"The Lord is in his holy temple, as for the Lord, his throne is in heaven: his eyes look upon the poor, his eyelids try the sons of men."],["5",[["Κύριος",7,5],["ἐξετάζει",2533,87],["τὸν",1,6],["δίκαιον",153,59],["καὶ",2,8],["τὸν",1,6],["ἀσεβῆ",247,59],["ὁ",1,4],["δὲ",14,12],["ἀγαπῶν",214,67],["ἀδικίαν",288,10],["μισεῖ",351,87],["τὴν",1,9],["ἑαυτοῦ",92,48],["ψυχήν",63,10]],"The Lord tries the righteous and the ungodly: and he that loves unrighteousness hates his own soul."],["6",[["Ἐπιβρέξει",9496,120],["ἐπὶ",9,1],["ἁμαρτωλοὺς",409,109],["παγίδας",817,40],["πῦρ",118,33],["καὶ",2,8],["θεῖον",1343,29],["καὶ",2,8],["πνεῦμα",168,33],["καταιγίδος",1470,19],["ἡ",1,11],["μερὶς",399,13],["τοῦ",1,23],["ποτηρίου",1355,24],["αὐτῶν",3,41]],"He shall rain upon sinners snares, fire, and brimstone, and a stormy blast [shall be] the portion of their cup."],["7",[["Ὅτι",19,8],["δίκαιος",153,16],["Κύριος",7,5],["καὶ",2,8],["δικαιοσύνας",187,40],["ἠγάπησεν",214,3],["εὐθύτητα",1674,10],["εἶδε",53,3],["τὸ",1,32],["πρόσωπον",47,33],["αὐτοῦ",3,48]],"For the Lord [is] righteous, and loves righteousness; his face beholds uprightness."]]