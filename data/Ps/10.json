[["1",[["Εἰς",8,1],["τὸ",1,32],["τέλος",369,33],["ψαλμὸς",639,5],["τῷ",1,110],["Δαυὶδ",52,105],["Ἐπὶ",9,1],["τῷ",1,110],["Κυρίῳ",7,113],["πέποιθα",343,85],["πῶς",440,12],["ἐρεῖτε",663,343],["τῇ",1,95],["ψυχῇ",62,2],["μου",6,48],["μεταναστεύου",4930,250],["ἐπὶ",9,1],["τὰ",1,42],["ὄρη",86,43],["ὡς",36,8],["στρουθίον",2498,20]],"For the end, a Psalm of David. In the Lord I have put my trust: how will ye say to my soul, Flee to the mountains as a sparrow?"],["2",[["Ὅτι",19,8],["ἰδοὺ",51,17],["οἱ",1,128],["ἁμαρτωλοὶ",406,130],["ἐνέτειναν",1998,141],["τόξον",712,20],["ἡτοίμασαν",371,141],["βέλη",1159,43],["εἰς",8,1],["φαρέτραν",2806,10],["τοῦ",1,30],["κατατοξεῦσαι",3560,100],["ἐν",4,1],["σκοτομήνῃ",8308,2],["τοὺς",1,56],["εὐθεῖς",826,58],["τῇ",1,95],["καρδίᾳ",63,2]],"For behold the sinners have bent [their] bow, they have prepared their arrows for the quiver, to shoot privily at the upright in heart."],["3",[["Ὅτι",19,8],["ἃ",1,11],["κατηρτίσω",1962,169],["καθεῖλον",610,141],["ὁ",1,4],["δὲ",14,12],["δίκαιος",152,16],["τί",39,119],["ἐποίησε",23,3]],"For they have pulled down what thou didst frame, but what has the righteous done?"],["4",[["Κύριος",7,5],["ἐν",4,1],["ναῷ",481,113],["ἁγίῳ",75,111],["αὐτοῦ",3,48],["Κύριος",7,5],["ἐν",4,1],["οὐρανῷ",94,113],["ὁ",1,4],["θρόνος",379,5],["αὐτοῦ",3,48],["οἱ",1,128],["ὀφθαλμοὶ",91,51],["αὐτοῦ",3,48],["εἰς",8,1],["τὸν",1,6],["πένητα",668,7],["ἀποβλέπουσι",4042,189],["τὰ",1,42],["βλέφαρα",2882,43],["αὐτοῦ",3,48],["ἐξετάζει",2537,87],["τοὺς",1,56],["υἱοὺς",13,31],["τῶν",1,76],["ἀνθρώπων",43,77]],"The Lord is in his holy temple, as for the Lord, his throne is in heaven: his eyes look upon the poor, his eyelids try the sons of men."],["5",[["Κύριος",7,5],["ἐξετάζει",2537,87],["τὸν",1,6],["δίκαιον",152,59],["καὶ",2,8],["τὸν",1,6],["ἀσεβῆ",246,59],["ὁ",1,4],["δὲ",14,12],["ἀγαπῶν",224,67],["ἀδικίαν",288,10],["μισεῖ",355,87],["τὴν",1,9],["ἑαυτοῦ",92,48],["ψυχήν",62,10]],"The Lord tries the righteous and the ungodly: and he that loves unrighteousness hates his own soul."],["6",[["Ἐπιβρέξει",9564,120],["ἐπὶ",9,1],["ἁμαρτωλοὺς",406,109],["παγίδας",815,40],["πῦρ",118,33],["καὶ",2,8],["θεῖον",1340,29],["καὶ",2,8],["πνεῦμα",167,33],["καταιγίδος",1470,19],["ἡ",1,11],["μερὶς",396,13],["τοῦ",1,23],["ποτηρίου",1352,24],["αὐτῶν",3,41]],"He shall rain upon sinners snares, fire, and brimstone, and a stormy blast [shall be] the portion of their cup."],["7",[["Ὅτι",19,8],["δίκαιος",152,16],["Κύριος",7,5],["καὶ",2,8],["δικαιοσύνας",185,40],["ἠγάπησεν",224,3],["εὐθύτητα",1676,10],["εἶδε",276,3],["τὸ",1,32],["πρόσωπον",47,33],["αὐτοῦ",3,48]],"For the Lord [is] righteous, and loves righteousness; his face beholds uprightness."]]