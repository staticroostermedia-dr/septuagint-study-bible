[["1",[["Τοῦ",1,30],["Δαυίδ",52,105],["Κρίνον",240,583],["με",6,82],["Κύριε",7,251],["ὅτι",19,8],["ἐγὼ",6,518],["ἐν",4,1],["ἀκακίᾳ",2653,179],["μου",6,48],["ἐπορεύθην",49,148],["καὶ",2,8],["ἐπὶ",9,1],["τῷ",1,110],["Κυρίῳ",7,113],["ἐλπίζων",511,67],["οὐ",12,17],["μὴ",25,8],["σαλευθῶ",679,569]],"[A Psalm] of David. Judge me, O Lord; for I have walked in my innocence: and hoping in the Lord I shall not be moved."],["2",[["Δοκίμασόν",1337,198],["με",6,82],["Κύριε",7,251],["καὶ",2,8],["πείρασόν",1096,198],["με",6,82],["πύρωσον",939,243],["τοὺς",1,56],["νεφρούς",1415,31],["μου",6,48],["καὶ",2,8],["τὴν",1,9],["καρδίαν",63,10],["μου",6,48]],"Prove me, O Lord, and try me; purify as with fire my reins and my heart."],["3",[["Ὅτι",19,8],["τὸ",1,32],["ἔλεός",182,33],["σου",5,146],["κατέναντι",689,17],["τῶν",1,76],["ὀφθαλμῶν",91,77],["μου",6,48],["ἐστὶ",10,87],["καὶ",2,8],["εὐηρέστησα",0,0],["ἐν",4,1],["τῇ",1,95],["ἀληθείᾳ",350,2],["σου",5,146]],"For thy mercy is before mine eyes: and I am well pleased with thy truth."],["4",[["Οὐκ",12,17],["ἐκάθισα",273,147],["μετὰ",29,1],["συνεδρίου",2503,24],["ματαιότητος",937,19],["καὶ",2,8],["μετὰ",29,1],["παρανομούντων",2760,164],["οὐ",12,17],["μὴ",25,8],["εἰσέλθω",88,227]],"I have not sat with the council of vanity, and will in nowise enter in with transgressors."],["5",[["Ἐμίσησα",355,147],["ἐκκλησίαν",562,10],["πονηρευομένων",1387,476],["καὶ",2,8],["μετὰ",29,1],["ἀσεβῶν",246,163],["οὐ",12,17],["μὴ",25,8],["καθίσω",273,157]],"I have hated the assembly of wicked doers; and will not sit with ungodly [men]."],["6",[["Νίψομαι",1776,176],["ἐν",4,1],["ἀθώοις",0,0],["τὰς",1,39],["χεῖράς",37,40],["μου",6,48],["καὶ",2,8],["κυκλώσω",600,157],["τὸ",1,32],["θυσιαστήριόν",133,33],["σου",5,146],["Κύριε",7,251]],"I will wash my hands in innocency, and compass thine altar, O Lord:"],["7",[["Τοῦ",1,30],["ἀκοῦσαι",53,100],["φωνῆς",95,19],["αἰνέσεως",990,19],["καὶ",2,8],["διηγήσασθαι",797,103],["πάντα",11,65],["τὰ",1,42],["θαυμάσιά",885,65],["σου",5,146]],"to hear the voice of praise, and to declare all thy wonderful works."],["8",[["Κύριε",7,251],["ἠγάπησα",224,147],["εὐπρέπειαν",2182,10],["οἴκου",34,21],["σου",5,146],["καὶ",2,8],["τόπον",99,7],["σκηνώματος",680,24],["δόξης",141,19],["σου",5,146]],"O Lord, I have loved the beauty of thy house, and the place of the tabernacle of thy glory."],["9",[["Μὴ",25,8],["συναπολέσῃς",2974,170],["μετὰ",29,1],["ἀσεβῶν",246,163],["τὴν",1,9],["ψυχήν",62,10],["μου",6,48],["καὶ",2,8],["μετὰ",29,1],["ἀνδρῶν",38,77],["αἱμάτων",148,45],["τὴν",1,9],["ζωήν",212,10],["μου",6,48]],"Destroy not my soul together with the ungodly, nor my life with bloody men:"],["10",[["ὧν",24,97],["ἐν",4,1],["χερσὶν",37,71],["ἀνομίαι",274,179],["ἡ",1,11],["δεξιὰ",282,15],["αὐτῶν",3,168],["ἐπλήσθη",911,38],["δώρων",347,45]],"in whose hands [are] iniquities, [and] their right hand is filled with bribes."],["11",[["Ἐγὼ",6,158],["δὲ",14,12],["ἐν",4,1],["ἀκακίᾳ",2653,179],["μου",6,48],["ἐπορεύθην",49,148],["λύτρωσαί",548,296],["με",6,82],["καὶ",2,8],["ἐλέησόν",457,243],["με",6,82]],"But I have walked in my innocence: redeem me, and have mercy upon me."],["12",[["Ὁ",1,4],["ποῦς",208,5],["μου",6,48],["ἔστη",78,3],["ἐν",4,1],["εὐθύτητι",1676,2],["ἐν",4,1],["ἐκκλησίαις",562,71],["εὐλογήσω",147,157],["σε",5,161],["Κύριε",7,251]],"My foot stands in an even place: in the congregations will I bless thee, O Lord."]]