[["1",[["Τοῦ",1,30],["Δαυίδ",52,105],["Κρίνον",2021,20],["με",6,82],["Κύριε",7,250],["ὅτι",19,8],["ἐγὼ",6,511],["ἐν",4,1],["ἀκακίᾳ",2650,180],["μου",6,48],["ἐπορεύθην",49,148],["καὶ",2,8],["ἐπὶ",9,1],["τῷ",1,110],["Κυρίῳ",7,113],["ἐλπίζων",514,67],["οὐ",12,17],["μὴ",25,8],["σαλευθῶ",678,555]],"[A Psalm] of David. Judge me, O Lord; for I have walked in my innocence: and hoping in the Lord I shall not be moved."],["2",[["Δοκίμασόν",1269,198],["με",6,82],["Κύριε",7,250],["καὶ",2,8],["πείρασόν",1094,198],["με",6,82],["πύρωσον",926,198],["τοὺς",1,56],["νεφρούς",1414,31],["μου",6,48],["καὶ",2,8],["τὴν",1,9],["καρδίαν",64,10],["μου",6,48]],"Prove me, O Lord, and try me; purify as with fire my reins and my heart."],["3",[["Ὅτι",19,8],["τὸ",1,32],["ἔλεός",183,33],["σου",5,146],["κατέναντι",691,17],["τῶν",1,76],["ὀφθαλμῶν",91,77],["μου",6,48],["ἐστὶ",10,87],["καὶ",2,8],["εὐηρέστησα",0,0],["ἐν",4,1],["τῇ",1,95],["ἀληθείᾳ",352,2],["σου",5,146]],"For thy mercy is before mine eyes: and I am well pleased with thy truth."],["4",[["Οὐκ",12,17],["ἐκάθισα",274,147],["μετὰ",29,1],["συνεδρίου",2498,24],["ματαιότητος",937,19],["καὶ",2,8],["μετὰ",29,1],["παρανομούντων",2750,164],["οὐ",12,17],["μὴ",25,8],["εἰσέλθω",86,227]],"I have not sat with the council of vanity, and will in nowise enter in with transgressors."],["5",[["Ἐμίσησα",351,147],["ἐκκλησίαν",563,10],["πονηρευομένων",1331,468],["καὶ",2,8],["μετὰ",29,1],["ἀσεβῶν",247,163],["οὐ",12,17],["μὴ",25,8],["καθίσω",274,157]],"I have hated the assembly of wicked doers; and will not sit with ungodly [men]."],["6",[["Νίψομαι",1776,177],["ἐν",4,1],["ἀθώοις",0,0],["τὰς",1,39],["χεῖράς",37,40],["μου",6,48],["καὶ",2,8],["κυκλώσω",603,157],["τὸ",1,32],["θυσιαστήριόν",133,33],["σου",5,146],["Κύριε",7,250]],"I will wash my hands in innocency, and compass thine altar, O Lord:"],["7",[["Τοῦ",1,30],["ἀκοῦσαι",54,100],["φωνῆς",95,19],["αἰνέσεως",989,19],["καὶ",2,8],["διηγήσασθαι",800,103],["πάντα",11,65],["τὰ",1,42],["θαυμάσιά",884,65],["σου",5,146]],"to hear the voice of praise, and to declare all thy wonderful works."],["8",[["Κύριε",7,250],["ἠγάπησα",214,147],["εὐπρέπειαν",2171,10],["οἴκου",34,21],["σου",5,146],["καὶ",2,8],["τόπον",99,7],["σκηνώματος",682,24],["δόξης",141,19],["σου",5,146]],"O Lord, I have loved the beauty of thy house, and the place of the tabernacle of thy glory."],["9",[["Μὴ",25,8],["συναπολέσῃς",2962,170],["μετὰ",29,1],["ἀσεβῶν",247,163],["τὴν",1,9],["ψυχήν",63,10],["μου",6,48],["καὶ",2,8],["μετὰ",29,1],["ἀνδρῶν",38,77],["αἱμάτων",148,45],["τὴν",1,9],["ζωήν",216,10],["μου",6,48]],"Destroy not my soul together with the ungodly, nor my life with bloody men:"],["10",[["ὧν",24,97],["ἐν",4,1],["χερσὶν",37,71],["ἀνομίαι",275,180],["ἡ",1,11],["δεξιὰ",282,15],["αὐτῶν",3,168],["ἐπλήσθη",909,38],["δώρων",348,45]],"in whose hands [are] iniquities, [and] their right hand is filled with bribes."],["11",[["Ἐγὼ",6,158],["δὲ",14,12],["ἐν",4,1],["ἀκακίᾳ",2650,180],["μου",6,48],["ἐπορεύθην",49,148],["λύτρωσαί",535,275],["με",6,82],["καὶ",2,8],["ἐλέησόν",446,198],["με",6,82]],"But I have walked in my innocence: redeem me, and have mercy upon me."],["12",[["Ὁ",1,4],["ποῦς",210,5],["μου",6,48],["ἔστη",78,3],["ἐν",4,1],["εὐθύτητι",1674,2],["ἐν",4,1],["ἐκκλησίαις",563,71],["εὐλογήσω",149,157],["σε",5,161],["Κύριε",7,250]],"My foot stands in an even place: in the congregations will I bless thee, O Lord."]]