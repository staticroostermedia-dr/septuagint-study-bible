[["1",[["Τῷ",1,110],["Δαυὶδ",52,105],["ὁπότε",3224,17],["ἠλλοίωσε",1231,3],["τὸ",1,32],["πρόσωπον",47,33],["αὐτοῦ",3,48],["ἐναντίον",138,17],["Ἀβιμέλεχ",0,0],["καὶ",2,8],["ἀπέλυσεν",1395,3],["αὐτὸν",3,82],["καὶ",2,8],["ἀπῆλθεν",297,3]],"[A Psalm] of David, when he changed his countenance before Abimelech; and he let him go, and he departed."],["2",[["Εὐλογήσω",149,157],["τὸν",1,6],["Κύριον",7,7],["ἐν",4,1],["παντὶ",11,111],["καιρῷ",132,113],["διαπαντὸς",510,17],["ἡ",1,11],["αἴνεσις",989,13],["αὐτοῦ",3,48],["ἐν",4,1],["τῷ",1,52],["στόματί",123,53],["μου",6,48]],"I will bless the Lord at all times: his praise shall be continually in my mouth."],["3",[["Ἐν",4,1],["τῷ",1,110],["Κυρίῳ",7,113],["ἐπαινεθήσεται",1534,125],["ἡ",1,11],["ψυχή",63,13],["μου",6,48],["ἀκουσάτωσαν",54,261],["πρᾳεῖς",2286,130],["καὶ",2,8],["εὐφρανθήτωσαν",244,50]],"My soul shall boast herself in the Lord: let the meek hear, and rejoice."],["4",[["Μεγαλύνατε",604,69],["τὸν",1,6],["Κύριον",7,7],["σὺν",310,1],["ἐμοὶ",6,49],["καὶ",2,8],["ὑψώσωμεν",331,75],["τὸ",1,32],["ὄνομα",57,33],["αὐτοῦ",3,48],["ἐπιτοαυτό",1404,105]],"Magnify ye the Lord with me, and let us exalt his name together."],["5",[["Ἐξεζήτησα",460,147],["τὸν",1,6],["Κύριον",7,7],["καὶ",2,8],["ἐπήκουσέ",597,3],["μου",6,48],["καὶ",2,8],["ἐκ",21,1],["πασῶν",11,115],["τῶν",1,123],["παροικιῶν",2105,61],["μου",6,48],["ἐῤῥύσατό",337,26],["με",6,82]],"I sought the Lord diligently, and he hearkened to me, and delivered me from all my sojournings."],["6",[["Προσέλθατε",529,69],["πρὸς",15,1],["αὐτὸν",3,82],["καὶ",2,8],["φωτίσθητε",1230,353],["καὶ",2,8],["τὰ",1,42],["πρόσωπα",47,43],["ὑμῶν",5,136],["οὐ",12,17],["μὴ",25,8],["καταισχυνθῇ",696,333]],"Draw near to him, and be enlightened: and your faces shall not [by any means] be ashamed."],["7",[["Οὗτος",16,112],["ὁ",1,4],["πτωχὸς",497,5],["ἐκέκραξε",0,0],["καὶ",2,8],["ὁ",1,4],["Κύριος",7,5],["εἰσήκουσεν",241,3],["αὐτοῦ",3,48],["καὶ",2,8],["ἐκ",21,1],["πασῶν",11,115],["τῶν",1,123],["θλίψεων",438,61],["αὐτοῦ",3,48],["ἔσωσεν",172,3],["αὐτόν",3,82]],"This poor man cried, and the Lord hearkened to him, and delivered him out of all his afflictions."],["8",[["Παρεμβαλεῖ",326,120],["ἄγγελος",208,5],["Κυρίου",7,21],["κύκλῳ",258,17],["τῶν",1,76],["φοβουμένων",134,295],["αὐτὸν",3,82],["καὶ",2,8],["ῥύσεται",337,89],["αὐτούς",3,60]],"The angel of the Lord will encamp round about them that fear him, and will deliver them."],["9",[["Γεύσασθε",1881,268],["καὶ",2,8],["ἴδετε",53,69],["ὅτι",19,8],["χρηστὸς",1359,16],["ὁ",1,4],["Κύριος",7,5],["μακάριος",806,16],["ἀνὴρ",38,5],["ὃς",24,246],["ἐλπίζει",514,87],["ἐπʼ",9,1],["αὐτόν",3,82]],"Taste and see that the Lord is good: blessed is the man who hopes in him."],["10",[["φοβήθητε",134,353],["τὸν",1,6],["Κύριον",7,7],["πάντες",11,130],["οἱ",1,128],["ἅγιοι",75,130],["αὐτοῦ",3,48],["ὅτι",19,8],["οὐκ",12,17],["ἔστιν",10,87],["ὑστέρημα",3774,33],["τοῖς",1,138],["φοβουμένοις",134,342],["αὐτόν",3,82]],"Fear the Lord, all ye his saints: for there is no want to them that fear him."],["11",[["Πλούσιοι",952,130],["ἐπτώχευσαν",3941,141],["καὶ",2,8],["ἐπείνασαν",1045,141],["οἱ",1,128],["δὲ",14,12],["ἐκζητοῦντες",460,137],["τὸν",1,6],["Κύριον",7,7],["οὐκ",12,17],["ἐλαττωθήσονται",1431,135],["παντὸς",11,153],["ἀγαθοῦ",114,153],["διάψαλμα",689,20]],"The rich have become poor and hungry: but they that seek the Lord diligently shall not want any good thing. Pause."],["12",[["Δεῦτε",1159,17],["τέκνα",192,43],["ἀκούσατέ",54,69],["μου",6,48],["φόβον",333,7],["Κυρίου",7,21],["διδάξω",545,157],["ὑμᾶς",5,209]],"Come, ye children, hear me: I will teach you the fear of the Lord."],["13",[["Τίς",39,150],["ἐστιν",10,87],["ἄνθρωπος",43,5],["ὁ",1,4],["θέλων",612,67],["ζωὴν",216,10],["ἀγαπῶν",214,67],["ἡμέρας",28,19],["ἰδεῖν",53,100],["ἀγαθάς",114,109]],"What man is there that desires life, loving to see good days?"],["14",[["Παῦσον",706,171],["τὴν",1,9],["γνῶσσάν",0,0],["σου",5,146],["ἀπὸ",17,1],["κακοῦ",161,88],["καὶ",2,8],["χείλη",361,43],["σου",5,146],["τοῦ",1,30],["μὴ",25,8],["λαλῆσαι",50,100],["δόλον",919,7]],"Keep thy tongue from evil, and thy lips from speaking guile."],["15",[["Ἔκκλινον",394,198],["ἀπὸ",17,1],["κακοῦ",161,88],["καὶ",2,8],["ποίησον",23,198],["ἀγαθὸν",114,29],["ζήτησον",191,198],["εἰρήνην",213,10],["καὶ",2,8],["δίωξον",533,198],["αὐτήν",3,98]],"Turn away from evil, and do good; seek peace, and pursue it."],["16",[["Οφθαλμοὶ",0,0],["Κυρίου",7,21],["ἐπὶ",9,1],["δικαίους",153,58],["καὶ",2,8],["ὦτα",328,43],["αὐτοῦ",3,48],["εἰς",8,1],["δέησιν",677,10],["αὐτῶν",3,41]],"The eyes of the Lord are over the righteous, and his ears [are open] to their prayer:"],["17",[["Πρόσωπον",47,33],["δὲ",14,12],["Κυρίου",7,21],["ἐπὶ",9,1],["ποιοῦντας",23,229],["κακὰ",161,65],["τοῦ",1,30],["ἐξολοθρεῦσαι",291,100],["ἐκ",21,1],["γῆς",26,19],["τὸ",1,32],["μνημόσυνον",716,33],["αὐτῶν",3,41]],"but the face of the Lord is against them that do evil, to destroy their memorial from the earth. The righteous cried,",{"s":"r"}],["18",[["Ἐκέκραξαν",0,0],["οἱ",1,128],["δίκαιοι",153,130],["καὶ",2,8],["ὁ",1,4],["Κύριος",7,5],["εἰσήκουσεν",241,3],["αὐτῶν",3,41],["καὶ",2,8],["ἐκ",21,1],["πασῶν",11,115],["τῶν",1,123],["θλίψεων",438,61],["αὐτῶν",3,189],["ἐῤῥύσατο",337,26],["αὐτούς",3,60]],"and the Lord hearkened to them, and delivered them out of all their afflictions.",{"s":"r"}],["19",[["Ἐγγὺς",1026,17],["Κύριος",7,5],["τοῖς",1,138],["συντετριμμένοις",268,437],["τὴν",1,9],["καρδίαν",64,10],["καὶ",2,8],["τοὺς",1,56],["ταπεινοὺς",1097,58],["τῷ",1,52],["πνεύματι",168,53],["σώσει",172,120]],"The Lord is near to them that are of a contrite heart; and will save the lowly in spirit."],["20",[["Πολλαὶ",74,187],["αἱ",1,185],["θλίψεις",438,180],["τῶν",1,76],["δικαίων",153,163],["καὶ",2,8],["ἐκ",21,1],["πασῶν",11,115],["αὐτῶν",3,189],["ῥύσεται",337,89],["αὐτοὺς",3,60]],"Many are the afflictions of the righteous: but out of them all the Lord will deliver them."],["21",[["ὁ",1,4],["Κύριος",7,5],["Φυλάσσει",125,87],["πάντα",11,65],["τὰ",1,42],["ὀστᾶ",473,43],["αὐτῶν",3,41],["ἓν",58,28],["ἐξ",21,1],["αὐτῶν",3,41],["οὐ",12,17],["συντριβήσεται",268,125]],"He keeps all their bones: not one of them shall be broken."],["22",[["Θάνατος",170,5],["ἁμαρτωλῶν",409,163],["πονηρὸς",164,16],["καὶ",2,8],["οἱ",1,128],["μισοῦντες",351,137],["τὸ",1,32],["δίκαιον",153,29],["πλημμελήσουσι",1329,207]],"The death of sinners is evil: and they that hate righteousness will go wrong."],["23",[["Λυτρώσεται",535,89],["Κύριος",7,5],["ψυχὰς",63,40],["δούλων",136,77],["αὐτοῦ",3,48],["καὶ",2,8],["οὐ",12,17],["μὴ",25,8],["πλημμελήσουσι",1329,207],["πάντες",11,130],["οἱ",1,128],["ἐλπίζοντες",514,137],["ἐπʼ",9,1],["αὐτόν",3,82]],"The Lord will redeem the souls of his servants: and none of those that hope in him shall go wrong."]]