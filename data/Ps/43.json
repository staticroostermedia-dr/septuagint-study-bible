[["1",[["Εἰς",8,1],["τὸ",1,32],["τέλος",373,33],["τοῖς",1,138],["υἱοῖς",13,139],["Κορὲ",874,250],["εἰς",8,1],["σύνεσιν",469,10],["ψαλμός",644,5]],"For the end, a Psalm for instruction, for the sons of Core."],["2",[["Ὁ",1,4],["Θεὸς",20,5],["ἐν",4,1],["τοῖς",1,91],["ὠσὶν",328,92],["ἡμῶν",6,41],["ἠκούσαμεν",54,285],["οἱ",1,128],["πατέρες",44,51],["ἡμῶν",6,41],["ἀνήγγειλαν",231,141],["ἡμῖν",6,142],["ἔργον",105,33],["ὃ",1,4],["εἰργάσω",467,322],["ἐν",4,1],["ταῖς",1,70],["ἡμέραις",28,71],["αὐτῶν",3,41],["ἐν",4,1],["ἡμεραίς",28,71],["ἀρχαίαις",1570,287]],"O God, we have heard with our ears, our fathers have told us, the work which thou wroughtest in their days, in the days of old."],["3",[["Ἡ",1,11],["χείρ",37,13],["σου",5,146],["ἔθνη",60,43],["ἐξωλόθρευσε",291,3],["καὶ",2,8],["κατεφύτευσας",1727,154],["αὐτοὺς",3,60],["ἐκάκωσας",757,154],["λαοὺς",35,31],["καὶ",2,8],["ἐξέβαλες",585,154],["αὐτούς",3,60]],"Thine hand utterly destroyed the heathen, and thou didst plant them: thou didst afflict the nations, and cast them out."],["4",[["Οὐ",12,17],["γὰρ",40,12],["ἐν",4,1],["τῇ",1,95],["ῥομφαίᾳ",248,2],["αὐτῶν",3,41],["ἐκληρονόμησαν",370,141],["γῆν",26,10],["καὶ",2,8],["ὁ",1,4],["βραχίων",1032,5],["αὐτῶν",3,41],["οὐκ",12,17],["ἔσωσεν",172,3],["αὐτοὺς",3,60],["ἀλλὰ",108,17],["ἡ",1,11],["δεξιά",282,15],["σου",5,146],["καὶ",2,8],["ὁ",1,4],["βραχίων",1032,5],["σου",5,146],["καὶ",2,8],["ὁ",1,4],["φωτισμὸς",3670,5],["τοῦ",1,23],["προσώπου",47,24],["σου",5,146],["ὅτι",19,8],["εὐδόκησας",906,154],["ἐν",4,1],["αὐτοῖς",3,142]],"For they inherited not the land by their [own] sword, and their [own] arm did not deliver them; but thy right hand, and thine arm, and the light of thy countenance, because thou wert well pleased in them."],["5",[["Σὺ",5,156],["εἶ",10,145],["αὐτὸς",3,158],["ὁ",1,4],["βασιλεύς",22,5],["μου",6,48],["καὶ",2,8],["ὁ",1,4],["Θεός",20,5],["μου",6,48],["ὁ",1,4],["ἐντελλόμενος",143,244],["τὰς",1,39],["σωτηρίας",425,40],["Ἰακώβ",146,105]],"Thou art indeed my King and my God, who commandest deliverances for Jacob."],["6",[["Ἐν",4,1],["σοὶ",5,151],["τοὺς",1,56],["ἐχθροὺς",135,31],["ἡμῶν",6,41],["κερατιοῦμεν",2458,269],["καὶ",2,8],["ἐν",4,1],["τῷ",1,52],["ὀνόματί",57,53],["σου",5,146],["ἐξουθενώσομεν",9454,269],["τοὺς",1,56],["ἐπανισταμένους",1216,230],["ἡμῖν",6,142]],"In thee will we push down our enemies, and in thy name will we bring to nought them that rise up against us."],["7",[["Οὐ",12,17],["γὰρ",40,12],["ἐπὶ",9,1],["τῷ",1,52],["τόξῳ",711,53],["μου",6,48],["ἐλπιῶ",514,157],["καὶ",2,8],["ἡ",1,11],["ῥομφαία",248,13],["μου",6,48],["οὐ",12,17],["σώσει",172,120],["με",6,82]],"For I will not trust in my bow, and my sword shall not save me."],["8",[["Ἔσωσας",172,154],["γὰρ",40,12],["ἡμᾶς",6,60],["ἐκ",21,1],["τῶν",1,76],["θλιβόντων",601,164],["ἡμᾶς",6,60],["καὶ",2,8],["τοὺς",1,56],["μισοῦντας",351,229],["ἡμᾶς",6,60],["κατῄσχυνας",696,154]],"For thou hast saved us from them that afflicted us, and hast put to shame them that hated us."],["9",[["Ἐν",4,1],["τῷ",1,110],["Θεῷ",20,113],["ἐπαινεθησόμεθα",1534,349],["ὅλην",235,37],["τὴν",1,9],["ἡμέραν",28,10],["καὶ",2,8],["ἐν",4,1],["τῷ",1,52],["ὀνόματί",57,53],["σου",5,146],["ἐξομολογησόμεθα",479,132],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["διάψαλμα",689,20]],"In God will we make our boast all the day, and to thy name will we give thanks for ever. Pause."],["10",[["Νυνὶ",2099,17],["δὲ",14,12],["ἀπώσω",770,157],["καὶ",2,8],["κατῄσχυνας",696,154],["ἡμᾶς",6,60],["καὶ",2,8],["οὐκ",12,17],["ἐξελεύσῃ",82,116],["ἐν",4,1],["ταῖς",1,70],["δυνάμεσιν",98,71],["ἡμῶν",6,41]],"But now thou hast cast off, and put us to shame; and thou wilt not go forth with our hosts."],["11",[["Ἀπέστρεψας",130,154],["ἡμᾶς",6,60],["εἰς",8,1],["τὰ",1,42],["ὀπίσω",167,17],["παρὰ",73,1],["τοὺς",1,56],["ἐχθροὺς",135,31],["ἡμῶν",6,41],["καὶ",2,8],["οἱ",1,128],["μισοῦντες",351,137],["ἡμᾶς",6,60],["διήρπαζον",1160,129],["ἑαυτοῖς",92,142]],"Thou hast turned us back before our enemies; and they that hated us spoiled for themselves."],["12",[["Ἔδωκας",33,154],["ἡμᾶς",6,60],["ὡς",36,8],["πρόβατα",194,43],["βρώσεως",1241,19],["καὶ",2,8],["ἐν",4,1],["τοῖς",1,91],["ἔθνεσι",60,92],["διέσπειρας",754,154],["ἡμᾶς",6,60]],"Thou madest us as sheep for meat; and thou scatteredst us among the nations."],["13",[["Ἀπέδου",9188,153],["τὸν",1,6],["λαόν",35,7],["σου",5,146],["ἄνευ",1101,1],["τιμῆς",720,19],["καὶ",2,8],["οὐκ",12,17],["ἦν",10,14],["πλῆθος",200,20],["ἐν",4,1],["τοῖς",1,91],["ἀλαλάγμασιν",8810,92],["αὐτῶν",3,41]],"Thou hast sold thy people without price, and there was no profit by their exchange."],["14",[["Ἔθου",110,169],["ἡμᾶς",6,60],["ὄνειδος",973,20],["τοῖς",1,138],["γείτοσιν",2072,139],["ἡμῶν",6,41],["μυκτηρισμὸν",3302,7],["καὶ",2,8],["καταγέλωτα",4842,7],["τοῖς",1,138],["κύκλῳ",258,17],["ἡμῶν",6,41]],"Thou hast made us a reproach to our neighbours, a scorn and derision to them that are round about us."],["15",[["Ἔθου",110,169],["ἡμᾶς",6,60],["εἰς",8,1],["παραβολὴν",1061,10],["ἐν",4,1],["τοῖς",1,91],["ἔθνεσι",60,92],["κίνησιν",4877,10],["κεφαλῆς",144,19],["ἐν",4,1],["τοῖς",1,138],["λαοῖς",35,139]],"Thou hast made us a proverb among the Gentiles, a shaking of the head among the nations."],["16",[["Ὅλην",235,37],["τὴν",1,9],["ἡμέραν",28,10],["ἡ",1,11],["ἐντροπή",3435,13],["μου",6,48],["κατεναντίον",4265,17],["μου",6,48],["ἐστὶ",10,87],["καὶ",2,8],["ἡ",1,11],["αἰσχύνη",685,13],["τοῦ",1,23],["προσώπου",47,24],["μου",6,48],["ἐκάλυψέ",620,3],["με",6,82]],"All the day my shame is before me, and the confusion of my face has covered me,"],["17",[["ἀπὸ",17,1],["φωνῆς",95,19],["ὀνειδίζοντος",945,143],["καὶ",2,8],["παραλαλοῦντος",7868,143],["ἀπὸ",17,1],["προσώπου",47,24],["ἐχθροῦ",135,24],["καὶ",2,8],["ἐκδιώκοντος",2220,291]],"because of the voice of the slanderer and reviler; because of the enemy and avenger."],["18",[["Ταῦτα",16,248],["πάντα",11,65],["ἦλθεν",55,3],["ἐφʼ",9,1],["ἡμᾶς",6,60],["καὶ",2,8],["οὐκ",12,17],["ἐπελαθόμεθά",513,314],["σου",5,146],["καὶ",2,8],["οὐκ",12,17],["ἠδικήσαμεν",760,285],["ἐν",4,1],["διαθήκῃ",169,2],["σου",5,146]],"All these things are come upon us: but we have not forgotten thee, neither have we dealt unrighteously in thy covenant."],["19",[["Καὶ",2,8],["οὐκ",12,17],["ἀπέστη",293,3],["εἰς",8,1],["τὰ",1,42],["ὀπίσω",167,17],["ἡ",1,11],["καρδία",64,13],["ἡμῶν",6,41],["καὶ",2,8],["ἐξέκλινας",394,154],["τὰς",1,39],["τρίβους",745,40],["ἡμῶν",6,41],["ἀπὸ",17,1],["τῆς",1,18],["ὁδοῦ",68,19],["σου",5,146]],"And our heart has not gone back; but thou hast turned aside our paths from thy way."],["20",[["Ὅτι",19,8],["ἐταπείνωσας",322,154],["ἡμᾶς",6,60],["ἐν",4,1],["τόπῳ",99,113],["κακώσεως",2091,19],["καὶ",2,8],["ἐπεκάλυψεν",1997,3],["ἡμᾶς",6,60],["σκιὰ",978,13],["θανάτου",170,21]],"For thou hast laid us low in a place of affliction, and the shadow of death has covered us."],["21",[["Εἰ",77,8],["ἐπελαθόμεθα",513,314],["τοῦ",1,23],["ὀνόματος",57,24],["τοῦ",1,23],["Θεοῦ",20,21],["ἡμῶν",6,41],["καὶ",2,8],["εἰ",77,8],["διεπετάσαμεν",1815,285],["χεῖρας",37,40],["ἡμῶν",6,41],["πρὸς",15,1],["θεὸν",20,7],["ἀλλότριον",381,59]],"If we have forgotten the name of our God, and if we have spread out our hands to a strange god;",{"s":"r"}],["22",[["οὐχὶ",330,12],["ὁ",1,4],["Θεὸς",20,5],["ἐκζητήσει",460,120],["ταῦτα",16,248],["αὐτὸς",3,158],["γὰρ",40,12],["γινώσκει",79,87],["τὰ",1,42],["κρύφια",2733,65],["τῆς",1,18],["καρδίας",64,19]],"shall not God search these things out? for he knows the secrets of the heart.",{"s":"r"}],["23",[["Ὅτι",19,8],["ἕνεκά",447,1],["σου",5,146],["θανατούμεθα",382,388],["ὅλην",235,37],["τὴν",1,9],["ἡμέραν",28,10],["ἐλογίσθημεν",495,313],["ὡς",36,8],["πρόβατα",194,43],["σφαγῆς",1742,19]],"For, for thy sake we are killed all the day long; we are counted as sheep for slaughter."],["24",[["Ἐξεγέρθητι",656,242],["ἱνατί",102,238],["ὑπνοῖς",1664,145],["Κύριε",7,250],["ἀνάστηθι",121,198],["καὶ",2,8],["μὴ",25,8],["ἀπώσῃ",770,116],["εἰς",8,1],["τέλος",373,33]],"Awake, wherefore sleepest thou, O Lord? arise, and do not cast [us] off for ever."],["25",[["Ἱνατί",102,238],["τὸ",1,27],["πρόσωπόν",47,20],["σου",5,146],["ἀποστρέφεις",130,145],["ἐπιλανθάνῃ",513,166],["τῆς",1,18],["πτωχείας",1913,19],["ἡμῶν",6,41],["καὶ",2,8],["τῆς",1,18],["θλίψεως",438,19],["ἡμῶν",6,41]],"Wherefore turnest thou thy face away, [and] forgettest our poverty and our affliction?"],["26",[["Ὅτι",19,8],["ἐταπεινώθη",322,38],["εἰς",8,1],["χοῦν",1289,7],["ἡ",1,11],["ψυχὴ",63,13],["ἡμῶν",6,41],["ἐκολλήθη",1246,38],["εἰς",8,1],["γῆν",26,10],["ἡ",1,11],["γαστὴρ",777,13],["ἡμῶν",6,41]],"For our soul has been brought down to the dust; our belly has cleaved to the earth."],["27",[["Ἀνάστα",121,275],["Κύριε",7,250],["βοήθησον",553,198],["ἡμῖν",6,142],["καὶ",2,8],["λύτρωσαι",535,275],["ἡμᾶς",6,60],["ἕνεκεν",447,1],["τοῦ",1,23],["ὀνόματός",57,24],["σου",5,146]],"Arise, O Lord, help us, and redeem us for thy name's sake."]]