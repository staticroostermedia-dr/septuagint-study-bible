[["1",[["Εἰς",8,1],["τὸ",1,32],["τέλος",369,33],["τοῖς",1,138],["υἱοῖς",13,139],["Κορὲ",875,251],["εἰς",8,1],["σύνεσιν",467,10],["ψαλμός",639,5]],"For the end, a Psalm for instruction, for the sons of Core."],["2",[["Ὁ",1,4],["Θεὸς",20,5],["ἐν",4,1],["τοῖς",1,91],["ὠσὶν",325,92],["ἡμῶν",6,41],["ἠκούσαμεν",53,288],["οἱ",1,128],["πατέρες",44,51],["ἡμῶν",6,41],["ἀνήγγειλαν",228,141],["ἡμῖν",6,142],["ἔργον",104,33],["ὃ",1,4],["εἰργάσω",468,327],["ἐν",4,1],["ταῖς",1,70],["ἡμέραις",28,71],["αὐτῶν",3,41],["ἐν",4,1],["ἡμεραίς",28,71],["ἀρχαίαις",1571,290]],"O God, we have heard with our ears, our fathers have told us, the work which thou wroughtest in their days, in the days of old."],["3",[["Ἡ",1,11],["χείρ",37,13],["σου",5,146],["ἔθνη",59,43],["ἐξωλόθρευσε",291,3],["καὶ",2,8],["κατεφύτευσας",1727,154],["αὐτοὺς",3,60],["ἐκάκωσας",764,154],["λαοὺς",35,31],["καὶ",2,8],["ἐξέβαλες",582,154],["αὐτούς",3,60]],"Thine hand utterly destroyed the heathen, and thou didst plant them: thou didst afflict the nations, and cast them out."],["4",[["Οὐ",12,17],["γὰρ",40,12],["ἐν",4,1],["τῇ",1,95],["ῥομφαίᾳ",247,2],["αὐτῶν",3,41],["ἐκληρονόμησαν",368,141],["γῆν",26,10],["καὶ",2,8],["ὁ",1,4],["βραχίων",1029,5],["αὐτῶν",3,41],["οὐκ",12,17],["ἔσωσεν",171,3],["αὐτοὺς",3,60],["ἀλλὰ",107,17],["ἡ",1,11],["δεξιά",282,15],["σου",5,146],["καὶ",2,8],["ὁ",1,4],["βραχίων",1029,5],["σου",5,146],["καὶ",2,8],["ὁ",1,4],["φωτισμὸς",3676,5],["τοῦ",1,23],["προσώπου",47,24],["σου",5,146],["ὅτι",19,8],["εὐδόκησας",908,154],["ἐν",4,1],["αὐτοῖς",3,142]],"For they inherited not the land by their [own] sword, and their [own] arm did not deliver them; but thy right hand, and thine arm, and the light of thy countenance, because thou wert well pleased in them."],["5",[["Σὺ",5,156],["εἶ",10,145],["αὐτὸς",3,158],["ὁ",1,4],["βασιλεύς",22,5],["μου",6,48],["καὶ",2,8],["ὁ",1,4],["Θεός",20,5],["μου",6,48],["ὁ",1,4],["ἐντελλόμενος",143,245],["τὰς",1,39],["σωτηρίας",422,40],["Ἰακώβ",146,105]],"Thou art indeed my King and my God, who commandest deliverances for Jacob."],["6",[["Ἐν",4,1],["σοὶ",5,151],["τοὺς",1,56],["ἐχθροὺς",135,31],["ἡμῶν",6,41],["κερατιοῦμεν",2465,269],["καὶ",2,8],["ἐν",4,1],["τῷ",1,52],["ὀνόματί",55,53],["σου",5,146],["ἐξουθενώσομεν",9523,269],["τοὺς",1,56],["ἐπανισταμένους",1221,230],["ἡμῖν",6,142]],"In thee will we push down our enemies, and in thy name will we bring to nought them that rise up against us."],["7",[["Οὐ",12,17],["γὰρ",40,12],["ἐπὶ",9,1],["τῷ",1,52],["τόξῳ",712,53],["μου",6,48],["ἐλπιῶ",511,157],["καὶ",2,8],["ἡ",1,11],["ῥομφαία",247,13],["μου",6,48],["οὐ",12,17],["σώσει",171,120],["με",6,82]],"For I will not trust in my bow, and my sword shall not save me."],["8",[["Ἔσωσας",171,154],["γὰρ",40,12],["ἡμᾶς",6,60],["ἐκ",21,1],["τῶν",1,76],["θλιβόντων",599,164],["ἡμᾶς",6,60],["καὶ",2,8],["τοὺς",1,56],["μισοῦντας",355,229],["ἡμᾶς",6,60],["κατῄσχυνας",716,154]],"For thou hast saved us from them that afflicted us, and hast put to shame them that hated us."],["9",[["Ἐν",4,1],["τῷ",1,110],["Θεῷ",20,113],["ἐπαινεθησόμεθα",1532,353],["ὅλην",233,37],["τὴν",1,9],["ἡμέραν",28,10],["καὶ",2,8],["ἐν",4,1],["τῷ",1,52],["ὀνόματί",55,53],["σου",5,146],["ἐξομολογησόμεθα",478,132],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["διάψαλμα",687,20]],"In God will we make our boast all the day, and to thy name will we give thanks for ever. Pause."],["10",[["Νυνὶ",2106,17],["δὲ",14,12],["ἀπώσω",767,157],["καὶ",2,8],["κατῄσχυνας",716,154],["ἡμᾶς",6,60],["καὶ",2,8],["οὐκ",12,17],["ἐξελεύσῃ",84,116],["ἐν",4,1],["ταῖς",1,70],["δυνάμεσιν",98,71],["ἡμῶν",6,41]],"But now thou hast cast off, and put us to shame; and thou wilt not go forth with our hosts."],["11",[["Ἀπέστρεψας",130,154],["ἡμᾶς",6,60],["εἰς",8,1],["τὰ",1,42],["ὀπίσω",166,17],["παρὰ",72,1],["τοὺς",1,56],["ἐχθροὺς",135,31],["ἡμῶν",6,41],["καὶ",2,8],["οἱ",1,128],["μισοῦντες",355,137],["ἡμᾶς",6,60],["διήρπαζον",1181,129],["ἑαυτοῖς",92,142]],"Thou hast turned us back before our enemies; and they that hated us spoiled for themselves."],["12",[["Ἔδωκας",33,154],["ἡμᾶς",6,60],["ὡς",36,8],["πρόβατα",194,43],["βρώσεως",1243,19],["καὶ",2,8],["ἐν",4,1],["τοῖς",1,91],["ἔθνεσι",59,92],["διέσπειρας",762,154],["ἡμᾶς",6,60]],"Thou madest us as sheep for meat; and thou scatteredst us among the nations."],["13",[["Ἀπέδου",9261,153],["τὸν",1,6],["λαόν",35,7],["σου",5,146],["ἄνευ",1103,1],["τιμῆς",721,19],["καὶ",2,8],["οὐκ",12,17],["ἦν",10,14],["πλῆθος",199,20],["ἐν",4,1],["τοῖς",1,91],["ἀλαλάγμασιν",8870,92],["αὐτῶν",3,41]],"Thou hast sold thy people without price, and there was no profit by their exchange."],["14",[["Ἔθου",109,169],["ἡμᾶς",6,60],["ὄνειδος",973,20],["τοῖς",1,138],["γείτοσιν",2078,139],["ἡμῶν",6,41],["μυκτηρισμὸν",3307,7],["καὶ",2,8],["καταγέλωτα",4868,7],["τοῖς",1,138],["κύκλῳ",258,17],["ἡμῶν",6,41]],"Thou hast made us a reproach to our neighbours, a scorn and derision to them that are round about us."],["15",[["Ἔθου",109,169],["ἡμᾶς",6,60],["εἰς",8,1],["παραβολὴν",1061,10],["ἐν",4,1],["τοῖς",1,91],["ἔθνεσι",59,92],["κίνησιν",4901,10],["κεφαλῆς",144,19],["ἐν",4,1],["τοῖς",1,138],["λαοῖς",35,139]],"Thou hast made us a proverb among the Gentiles, a shaking of the head among the nations."],["16",[["Ὅλην",233,37],["τὴν",1,9],["ἡμέραν",28,10],["ἡ",1,11],["ἐντροπή",3439,13],["μου",6,48],["κατεναντίον",4278,17],["μου",6,48],["ἐστὶ",10,87],["καὶ",2,8],["ἡ",1,11],["αἰσχύνη",683,13],["τοῦ",1,23],["προσώπου",47,24],["μου",6,48],["ἐκάλυψέ",618,3],["με",6,82]],"All the day my shame is before me, and the confusion of my face has covered me,"],["17",[["ἀπὸ",17,1],["φωνῆς",95,19],["ὀνειδίζοντος",946,143],["καὶ",2,8],["παραλαλοῦντος",7926,143],["ἀπὸ",17,1],["προσώπου",47,24],["ἐχθροῦ",135,24],["καὶ",2,8],["ἐκδιώκοντος",2234,294]],"because of the voice of the slanderer and reviler; because of the enemy and avenger."],["18",[["Ταῦτα",16,249],["πάντα",11,65],["ἦλθεν",56,3],["ἐφʼ",9,1],["ἡμᾶς",6,60],["καὶ",2,8],["οὐκ",12,17],["ἐπελαθόμεθά",512,318],["σου",5,146],["καὶ",2,8],["οὐκ",12,17],["ἠδικήσαμεν",819,288],["ἐν",4,1],["διαθήκῃ",168,2],["σου",5,146]],"All these things are come upon us: but we have not forgotten thee, neither have we dealt unrighteously in thy covenant."],["19",[["Καὶ",2,8],["οὐκ",12,17],["ἀπέστη",514,3],["εἰς",8,1],["τὰ",1,42],["ὀπίσω",166,17],["ἡ",1,11],["καρδία",63,13],["ἡμῶν",6,41],["καὶ",2,8],["ἐξέκλινας",393,154],["τὰς",1,39],["τρίβους",744,40],["ἡμῶν",6,41],["ἀπὸ",17,1],["τῆς",1,18],["ὁδοῦ",67,19],["σου",5,146]],"And our heart has not gone back; but thou hast turned aside our paths from thy way."],["20",[["Ὅτι",19,8],["ἐταπείνωσας",333,154],["ἡμᾶς",6,60],["ἐν",4,1],["τόπῳ",99,113],["κακώσεως",2096,19],["καὶ",2,8],["ἐπεκάλυψεν",2064,3],["ἡμᾶς",6,60],["σκιὰ",978,13],["θανάτου",169,21]],"For thou hast laid us low in a place of affliction, and the shadow of death has covered us."],["21",[["Εἰ",77,8],["ἐπελαθόμεθα",512,318],["τοῦ",1,23],["ὀνόματος",55,24],["τοῦ",1,23],["Θεοῦ",20,21],["ἡμῶν",6,41],["καὶ",2,8],["εἰ",77,8],["διεπετάσαμεν",1816,288],["χεῖρας",37,40],["ἡμῶν",6,41],["πρὸς",15,1],["θεὸν",20,7],["ἀλλότριον",377,59]],"If we have forgotten the name of our God, and if we have spread out our hands to a strange god; shall not God search these things out?"],["22",[["οὐχὶ",326,12],["ὁ",1,4],["Θεὸς",20,5],["ἐκζητήσει",459,120],["ταῦτα",16,249],["αὐτὸς",3,158],["γὰρ",40,12],["γινώσκει",81,87],["τὰ",1,42],["κρύφια",2740,65],["τῆς",1,18],["καρδίας",63,19]],"for he knows the secrets of the heart."],["23",[["Ὅτι",19,8],["ἕνεκά",445,1],["σου",5,146],["θανατούμεθα",386,393],["ὅλην",233,37],["τὴν",1,9],["ἡμέραν",28,10],["ἐλογίσθημεν",494,317],["ὡς",36,8],["πρόβατα",194,43],["σφαγῆς",1741,19]],"For, for thy sake we are killed all the day long; we are counted as sheep for slaughter."],["24",[["Ἐξεγέρθητι",650,242],["ἱνατί",101,238],["ὑπνοῖς",1665,145],["Κύριε",7,251],["ἀνάστηθι",121,198],["καὶ",2,8],["μὴ",25,8],["ἀπώσῃ",767,116],["εἰς",8,1],["τέλος",369,33]],"Awake, wherefore sleepest thou, O Lord? arise, and do not cast [us] off for ever."],["25",[["Ἱνατί",101,238],["τὸ",1,27],["πρόσωπόν",47,20],["σου",5,146],["ἀποστρέφεις",130,145],["ἐπιλανθάνῃ",512,166],["τῆς",1,18],["πτωχείας",1912,19],["ἡμῶν",6,41],["καὶ",2,8],["τῆς",1,18],["θλίψεως",437,19],["ἡμῶν",6,41]],"Wherefore turnest thou thy face away, [and] forgettest our poverty and our affliction?"],["26",[["Ὅτι",19,8],["ἐταπεινώθη",333,38],["εἰς",8,1],["χοῦν",1288,7],["ἡ",1,11],["ψυχὴ",62,13],["ἡμῶν",6,41],["ἐκολλήθη",1272,38],["εἰς",8,1],["γῆν",26,10],["ἡ",1,11],["γαστὴρ",775,13],["ἡμῶν",6,41]],"For our soul has been brought down to the dust; our belly has cleaved to the earth."],["27",[["Ἀνάστα",121,275],["Κύριε",7,251],["βοήθησον",552,198],["ἡμῖν",6,142],["καὶ",2,8],["λύτρωσαι",548,296],["ἡμᾶς",6,60],["ἕνεκεν",445,1],["τοῦ",1,23],["ὀνόματός",55,24],["σου",5,146]],"Arise, O Lord, help us, and redeem us for thy name's sake."]]