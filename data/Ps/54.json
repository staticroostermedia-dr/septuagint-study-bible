[["1",[["Εἰς",8,1],["τὸ",1,32],["τέλος",373,33],["ἐν",4,1],["ὕμνοις",1498,139],["συνέσεως",469,19],["τῷ",1,110],["Δαυίδ",52,105]],"For the end, among Hymns of instruction by David."],["2",[["Ἐνωτίσαι",1316,334],["ὁ",1,4],["Θεὸς",20,5],["τὴν",1,9],["προσευχήν",550,10],["μου",6,48],["καὶ",2,8],["μὴ",25,8],["ὑπερίδῃς",1496,170],["τὴν",1,9],["δέησίν",677,10],["μου",6,48]],"Hearken, O God, to my prayer; and disregard not my supplication."],["3",[["Πρόσχες",1689,154],["μοι",6,49],["καὶ",2,8],["εἰσάκουσόν",241,198],["μου",6,48],["ἐλυπήθην",936,148],["ἐν",4,1],["τῇ",1,95],["ἀδολεσχίᾳ",4010,2],["μου",6,48],["καὶ",2,8],["ἐταράχθην",508,148]],"Attend to me, and hearken to me: I was grieved in my meditation, and troubled;"],["4",[["ἀπὸ",17,1],["φωνῆς",95,19],["ἐχθροῦ",135,21],["καὶ",2,8],["ἀπὸ",17,1],["θλίψεως",438,19],["ἁμαρτωλοῦ",409,78],["ὅτι",19,8],["ἐξέκλιναν",394,141],["ἐπʼ",9,1],["ἐμὲ",6,98],["ἀνομίαν",275,10],["καὶ",2,8],["ἐν",4,1],["ὀργῇ",198,2],["ἐνεκότουν",6408,129],["μοι",6,99]],"because of the voice of the enemy, and because of the oppression of the sinner: for they brought iniquity against me, and were wrathfully angry with me."],["5",[["Ἡ",1,11],["καρδία",64,13],["μου",6,48],["ἐταράχθη",508,38],["ἐν",4,1],["ἐμοὶ",6,49],["καὶ",2,8],["δειλία",1955,239],["θανάτου",170,21],["ἐπέπεσεν",995,3],["ἐπʼ",9,1],["ἐμέ",6,82]],"My heart was troubled within me; and the fear of death fell upon me."],["6",[["Φόβος",333,5],["καὶ",2,8],["τρόμος",1599,5],["ἦλθεν",55,3],["ἐπʼ",9,1],["ἐμὲ",6,82],["καὶ",2,8],["ἐκάλυψέ",620,3],["με",6,82],["σκότος",506,5]],"Fear and trembling came upon me, and darkness covered me."],["7",[["Καὶ",2,8],["εἶπα",18,147],["τίς",39,150],["δώσει",33,120],["μοι",6,49],["πτέρυγας",719,40],["ὡσεὶ",343,17],["περιστερᾶς",1280,19],["καὶ",2,8],["πετασθήσομαι",2943,176],["καὶ",2,8],["καταπαύσω",778,157]],"And I said, O that I had wings as [those] of a dove! then would I flee away, and be at rest."],["8",[["Ἰδοὺ",51,17],["ἐμάκρυνα",0,0],["φυγαδεύων",3669,67],["καὶ",2,8],["ηὐλίσθην",990,256],["ἐν",4,1],["τῇ",1,95],["ἐρήμῳ",160,96],["διάψαλμα",689,20]],"Lo! I have fled afar off, and lodged in the wilderness. Pause."],["9",[["Προσεδεχόμην",1019,374],["τὸν",1,6],["σώζοντά",172,178],["με",6,82],["ἀπὸ",17,1],["ὀλιγοψυχίας",6608,19],["καὶ",2,8],["καταιγίδος",1470,19]],"I waited for him that should deliver me from distress of spirit and tempest."],["10",[["Καταπόντισον",2726,198],["Κύριε",7,250],["καὶ",2,8],["καταδίελε",4822,198],["τὰς",1,39],["γλώσσας",388,40],["αὐτῶν",3,41],["ὅτι",19,8],["εἶδον",53,147],["ἀνομίαν",275,10],["καὶ",2,8],["ἀντιλογίαν",1851,10],["ἐν",4,1],["τῇ",1,95],["πόλει",41,2]],"Destroy, O Lord, and divide their tongues: for I have seen iniquity and gainsaying in the city."],["11",[["Ἡμέρας",28,19],["καὶ",2,8],["νυκτὸς",219,19],["κυκλώσει",603,120],["αὐτὴν",3,98],["ἐπὶ",9,1],["τὰ",1,42],["τείχη",325,43],["αὐτῆς",3,83],["ἀνομία",275,13],["καὶ",2,8],["πόνος",566,5],["ἐν",4,1],["μέσῳ",113,34],["αὐτῆς",3,83]],"Day and night he shall go round about it upon its walls: iniquity and sorrow and unrighteousness [are] in the midst of it;"],["12",[["καὶ",2,8],["ἀδικία",288,13],["καὶ",2,8],["οὐκ",12,17],["ἐξέλιπεν",321,3],["ἐκ",21,1],["τῶν",1,123],["πλατειῶν",925,61],["αὐτῆς",3,83],["τόκος",1839,5],["καὶ",2,8],["δόλος",919,5]],"and usury and craft have not failed from its streets."],["13",[["Ὅτι",19,8],["εἰ",77,8],["ἐχθρὸς",135,5],["ὠνείδισέ",945,3],["με",6,82],["ὑπήνεγκα",1876,147],["ἂν",83,12],["καὶ",2,8],["εἰ",77,8],["ὁ",1,4],["μισῶν",351,67],["ἐπʼ",9,1],["ἐμὲ",6,82],["ἐμεγαλοῤῥημόνησεν",3586,3],["ἐκρύβην",372,148],["ἂν",83,12],["ἀπʼ",17,1],["αὐτοῦ",3,48]],"For if an enemy had reproached me, I would have endured it; and if one who hated [me] had spoken vauntingly against me, I would have hid myself from him."],["14",[["Σὺ",5,156],["δὲ",14,12],["ἄνθρωπε",43,250],["ἰσόψυχε",9747,309],["ἡγεμών",638,250],["μου",6,48],["καὶ",2,8],["γνωστέ",1620,309],["μου",6,48]],"But thou, O man likeminded, my guide, and my acquaintance,"],["15",[["ὃς",24,246],["ἐπιτοαυτὸ",1404,105],["ἐγλύκανας",0,0],["ἐδέσματα",2145,63],["ἐν",4,1],["τῷ",1,110],["οἴκῳ",34,113],["τοῦ",1,30],["Θεοῦ",20,21],["ἐπορεύθημεν",49,491],["ἐν",4,1],["ὁμονοίᾳ",3223,2]],"who in companionship with me sweetened [our] food: we walked in the house of God in concord."],["16",[["Ἐλθέτω",55,46],["θάνατος",170,5],["ἐπʼ",9,1],["αὐτοὺς",3,60],["καὶ",2,8],["καταβήτωσαν",175,261],["εἰς",8,1],["ᾅδου",586,21],["ζῶντες",107,137],["ὅτι",19,8],["πονηρία",730,13],["ἐν",4,1],["ταῖς",1,70],["παροικίαις",2105,71],["αὐτῶν",3,41],["ἐν",4,1],["μέσῳ",113,34],["αὐτῶν",3,41]],"Let death come upon them, and let them go down alive into Hades, for iniquity is in their dwellings, in the midst of them."],["17",[["Ἐγὼ",6,158],["πρὸς",15,1],["τὸν",1,6],["Θεὸν",20,7],["ἐκέκραξα",592,147],["καὶ",2,8],["ὁ",1,4],["Κύριος",7,5],["εἰσήκουσέ",241,3],["μου",6,48]],"I cried to God, and the Lord hearkened to me."],["18",[["Ἑσπέρας",488,19],["καὶ",2,8],["πρωῒ",504,17],["καὶ",2,8],["μεσημβρίας",1633,40],["διηγήσομαι",800,177],["καὶ",2,8],["ἀπαγγελῶ",273,157],["καὶ",2,8],["εἰσακούσεται",241,89],["τῆς",1,18],["φωνῆς",95,19],["μου",6,83]],"Evening, and morning, and at noon I will declare and make known [my wants]: and he shall hear my voice."],["19",[["Λυτρώσεται",535,89],["ἐν",4,1],["εἰρήνῃ",213,2],["τὴν",1,9],["ψυχήν",63,10],["μου",6,48],["ἀπὸ",17,1],["τῶν",1,76],["ἐγγιζόντων",0,0],["μοι",6,49],["ὅτι",19,8],["ἐν",4,1],["πολλοῖς",74,215],["ἦσαν",10,129],["σὺν",310,1],["ἐμοί",6,49]],"He shall deliver my soul in peace from them that draw nigh to me: for they were with me in many [cases]."],["20",[["Εἰσακούσεται",241,89],["ὁ",1,4],["Θεὸς",20,5],["καὶ",2,8],["ταπεινώσει",322,120],["αὐτοὺς",3,60],["ὁ",1,4],["ὑπάρχων",418,67],["πρὸ",238,1],["τῶν",1,76],["αἰώνων",100,77],["διάψαλμα",689,20]],"God shall hear, and bring them low, [even] he that has existed from eternity. Pause. For they suffer no reverse, and [therefore] they have not feared God."],["21",[["Οὐ",12,17],["γάρ",40,12],["ἐστιν",10,87],["αὐτοῖς",3,142],["ἀντάλλαγμα",3165,33],["καὶ",2,8],["οὐκ",12,17],["ἐφοβήθησαν",134,94],["τὸν",1,6],["Θεόν",20,7],["Ἐξέτεινε",421,3],["τὴν",1,9],["χεῖρα",37,10],["αὐτοῦ",3,48],["ἐν",4,1],["τῷ",1,110],["ἀποδιδόναι",312,54],["ἐβεβήλωσαν",608,141],["τὴν",1,9],["διαθήκην",169,10],["αὐτοῦ",3,48]],"He has reached forth his hand for retribution; they have profaned his covenant."],["22",[["Διεμερίσθησαν",2075,94],["ἀπὸ",17,1],["ὀργῆς",198,19],["τοῦ",1,23],["προσώπου",47,24],["αὐτοῦ",3,144],["καὶ",2,8],["ἤγγισεν",455,3],["ἡ",1,11],["καρδία",64,13],["αὐτοῦ",3,48],["ἡπαλύνθησαν",5254,94],["οἱ",1,128],["λόγοι",48,51],["αὐτοῦ",3,48],["ὑπὲρ",139,1],["ἔλαιον",313,33],["καὶ",2,8],["αὐτοί",3,195],["εἰσι",10,191],["βολίδες",2250,180]],"They were scattered at the anger of his countenance, and his heart drew nigh them. His words were smoother than oil, yet are they darts."],["23",[["Ἐπίῤῥιψον",2422,198],["ἐπὶ",9,1],["Κύριον",7,7],["τὴν",1,9],["μέριμνάν",3092,10],["σου",5,146],["καὶ",2,8],["αὐτός",3,158],["σε",5,161],["διαθρέψει",2076,120],["οὐ",12,17],["δώσει",33,120],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["σάλον",2637,7],["τῷ",1,110],["δικαίῳ",153,111]],"Cast thy care upon the Lord, and he shall sustain thee; he shall never suffer the righteous to be moved."],["24",[["Σὺ",5,156],["δὲ",14,12],["ὁ",1,4],["Θεὸς",20,5],["κατάξεις",735,159],["αὐτοὺς",3,60],["εἰς",8,1],["φρέαρ",877,33],["διαφθορᾶς",1671,19],["ἄνδρες",38,51],["αἱμάτων",148,45],["καὶ",2,8],["δολιότητος",3526,19],["οὐ",12,17],["μὴ",25,8],["ἡμισεύσωσι",9721,224],["τὰς",1,39],["ἡμέρας",28,19],["αὐτῶν",3,41],["ἐγὼ",6,158],["δὲ",14,12],["ἐλπιῶ",514,157],["ἐπὶ",9,1],["σε",5,161],["Κύριε",7,250]],"But thou, O God, shalt bring them down to the pit of destruction; bloody and crafty men shall not live out half their days; but I will hope in thee, O Lord."]]