[["1",[["Εἰς",8,1],["τὸ",1,32],["τέλος",369,33],["ἐν",4,1],["ὕμνοις",1499,139],["συνέσεως",467,19],["τῷ",1,110],["Δαυίδ",52,105]],"For the end, among Hymns of instruction by David."],["2",[["Ἐνωτίσαι",1316,296],["ὁ",1,4],["Θεὸς",20,5],["τὴν",1,9],["προσευχήν",549,10],["μου",6,48],["καὶ",2,8],["μὴ",25,8],["ὑπερίδῃς",1498,170],["τὴν",1,9],["δέησίν",674,10],["μου",6,48]],"Hearken, O God, to my prayer; and disregard not my supplication."],["3",[["Πρόσχες",1692,154],["μοι",6,49],["καὶ",2,8],["εἰσάκουσόν",237,198],["μου",6,48],["ἐλυπήθην",936,148],["ἐν",4,1],["τῇ",1,95],["ἀδολεσχίᾳ",4020,2],["μου",6,48],["καὶ",2,8],["ἐταράχθην",508,256]],"Attend to me, and hearken to me: I was grieved in my meditation, and troubled;"],["4",[["ἀπὸ",17,1],["φωνῆς",95,19],["ἐχθροῦ",135,21],["καὶ",2,8],["ἀπὸ",17,1],["θλίψεως",437,19],["ἁμαρτωλοῦ",406,78],["ὅτι",19,8],["ἐξέκλιναν",393,141],["ἐπʼ",9,1],["ἐμὲ",6,98],["ἀνομίαν",274,10],["καὶ",2,8],["ἐν",4,1],["ὀργῇ",198,2],["ἐνεκότουν",6440,129],["μοι",6,99]],"because of the voice of the enemy, and because of the oppression of the sinner: for they brought iniquity against me, and were wrathfully angry with me."],["5",[["Ἡ",1,11],["καρδία",63,13],["μου",6,48],["ἐταράχθη",508,38],["ἐν",4,1],["ἐμοὶ",6,49],["καὶ",2,8],["δειλία",2448,239],["θανάτου",169,21],["ἐπέπεσεν",995,3],["ἐπʼ",9,1],["ἐμέ",6,82]],"My heart was troubled within me; and the fear of death fell upon me."],["6",[["Φόβος",330,5],["καὶ",2,8],["τρόμος",1600,5],["ἦλθεν",56,3],["ἐπʼ",9,1],["ἐμὲ",6,82],["καὶ",2,8],["ἐκάλυψέ",618,3],["με",6,82],["σκότος",503,5]],"Fear and trembling came upon me, and darkness covered me."],["7",[["Καὶ",2,8],["εἶπα",18,147],["τίς",39,150],["δώσει",33,120],["μοι",6,49],["πτέρυγας",720,40],["ὡσεὶ",342,17],["περιστερᾶς",1278,19],["καὶ",2,8],["πετασθήσομαι",2956,175],["καὶ",2,8],["καταπαύσω",777,157]],"And I said, O that I had wings as [those] of a dove! then would I flee away, and be at rest."],["8",[["Ἰδοὺ",51,17],["ἐμάκρυνα",0,0],["φυγαδεύων",4479,67],["καὶ",2,8],["ηὐλίσθην",991,256],["ἐν",4,1],["τῇ",1,95],["ἐρήμῳ",160,96],["διάψαλμα",687,20]],"Lo! I have fled afar off, and lodged in the wilderness. Pause."],["9",[["Προσεδεχόμην",1018,380],["τὸν",1,6],["σώζοντά",171,177],["με",6,82],["ἀπὸ",17,1],["ὀλιγοψυχίας",6649,19],["καὶ",2,8],["καταιγίδος",1470,19]],"I waited for him that should deliver me from distress of spirit and tempest."],["10",[["Καταπόντισον",2732,198],["Κύριε",7,251],["καὶ",2,8],["καταδίελε",4850,198],["τὰς",1,39],["γλώσσας",385,40],["αὐτῶν",3,41],["ὅτι",19,8],["εἶδον",73,147],["ἀνομίαν",274,10],["καὶ",2,8],["ἀντιλογίαν",1850,10],["ἐν",4,1],["τῇ",1,95],["πόλει",41,2]],"Destroy, O Lord, and divide their tongues: for I have seen iniquity and gainsaying in the city."],["11",[["Ἡμέρας",28,19],["καὶ",2,8],["νυκτὸς",216,19],["κυκλώσει",600,120],["αὐτὴν",3,98],["ἐπὶ",9,1],["τὰ",1,42],["τείχη",323,43],["αὐτῆς",3,83],["ἀνομία",274,13],["καὶ",2,8],["πόνος",564,5],["ἐν",4,1],["μέσῳ",112,34],["αὐτῆς",3,83]],"Day and night he shall go round about it upon its walls: iniquity and sorrow and unrighteousness [are] in the midst of it;"],["12",[["καὶ",2,8],["ἀδικία",288,13],["καὶ",2,8],["οὐκ",12,17],["ἐξέλιπεν",321,3],["ἐκ",21,1],["τῶν",1,123],["πλατειῶν",925,61],["αὐτῆς",3,83],["τόκος",1841,5],["καὶ",2,8],["δόλος",920,5]],"and usury and craft have not failed from its streets."],["13",[["Ὅτι",19,8],["εἰ",77,8],["ἐχθρὸς",135,5],["ὠνείδισέ",946,3],["με",6,82],["ὑπήνεγκα",1877,147],["ἂν",82,12],["καὶ",2,8],["εἰ",77,8],["ὁ",1,4],["μισῶν",355,67],["ἐπʼ",9,1],["ἐμὲ",6,82],["ἐμεγαλοῤῥημόνησεν",3593,3],["ἐκρύβην",378,148],["ἂν",82,12],["ἀπʼ",17,1],["αὐτοῦ",3,48]],"For if an enemy had reproached me, I would have endured it; and if one who hated [me] had spoken vauntingly against me, I would have hid myself from him."],["14",[["Σὺ",5,156],["δὲ",14,12],["ἄνθρωπε",43,251],["ἰσόψυχε",9823,313],["ἡγεμών",634,251],["μου",6,48],["καὶ",2,8],["γνωστέ",1618,313],["μου",6,48]],"But thou, O man likeminded, my guide, and my acquaintance,"],["15",[["ὃς",24,247],["ἐπιτοαυτὸ",1405,105],["ἐγλύκανας",0,0],["ἐδέσματα",2151,63],["ἐν",4,1],["τῷ",1,110],["οἴκῳ",34,113],["τοῦ",1,30],["Θεοῦ",20,21],["ἐπορεύθημεν",49,498],["ἐν",4,1],["ὁμονοίᾳ",3228,2]],"who in companionship with me sweetened [our] food: we walked in the house of God in concord."],["16",[["Ἐλθέτω",56,46],["θάνατος",169,5],["ἐπʼ",9,1],["αὐτοὺς",3,60],["καὶ",2,8],["καταβήτωσαν",0,0],["εἰς",8,1],["ᾅδου",583,21],["ζῶντες",117,137],["ὅτι",19,8],["πονηρία",729,13],["ἐν",4,1],["ταῖς",1,70],["παροικίαις",2112,71],["αὐτῶν",3,41],["ἐν",4,1],["μέσῳ",112,34],["αὐτῶν",3,41]],"Let death come upon them, and let them go down alive into Hades, for iniquity is in their dwellings, in the midst of them."],["17",[["Ἐγὼ",6,158],["πρὸς",15,1],["τὸν",1,6],["Θεὸν",20,7],["ἐκέκραξα",590,147],["καὶ",2,8],["ὁ",1,4],["Κύριος",7,5],["εἰσήκουσέ",237,3],["μου",6,48]],"I cried to God, and the Lord hearkened to me."],["18",[["Ἑσπέρας",486,19],["καὶ",2,8],["πρωῒ",501,17],["καὶ",2,8],["μεσημβρίας",1633,40],["διηγήσομαι",797,176],["καὶ",2,8],["ἀπαγγελῶ",272,157],["καὶ",2,8],["εἰσακούσεται",237,89],["τῆς",1,18],["φωνῆς",95,19],["μου",6,83]],"Evening, and morning, and at noon I will declare and make known [my wants]: and he shall hear my voice."],["19",[["Λυτρώσεται",548,89],["ἐν",4,1],["εἰρήνῃ",210,2],["τὴν",1,9],["ψυχήν",62,10],["μου",6,48],["ἀπὸ",17,1],["τῶν",1,76],["ἐγγιζόντων",0,0],["μοι",6,49],["ὅτι",19,8],["ἐν",4,1],["πολλοῖς",74,215],["ἦσαν",10,129],["σὺν",309,1],["ἐμοί",6,49]],"He shall deliver my soul in peace from them that draw nigh to me: for they were with me in many [cases]."],["20",[["Εἰσακούσεται",237,89],["ὁ",1,4],["Θεὸς",20,5],["καὶ",2,8],["ταπεινώσει",333,120],["αὐτοὺς",3,60],["ὁ",1,4],["ὑπάρχων",416,67],["πρὸ",235,1],["τῶν",1,76],["αἰώνων",100,77],["διάψαλμα",687,20]],"God shall hear, and bring them low, [even] he that has existed from eternity. Pause. For they suffer no reverse, and [therefore] they have not feared God."],["21",[["Οὐ",12,17],["γάρ",40,12],["ἐστιν",10,87],["αὐτοῖς",3,142],["ἀντάλλαγμα",3172,33],["καὶ",2,8],["οὐκ",12,17],["ἐφοβήθησαν",134,94],["τὸν",1,6],["Θεόν",20,7],["Ἐξέτεινε",419,3],["τὴν",1,9],["χεῖρα",37,10],["αὐτοῦ",3,48],["ἐν",4,1],["τῷ",1,110],["ἀποδιδόναι",311,54],["ἐβεβήλωσαν",589,141],["τὴν",1,9],["διαθήκην",168,10],["αὐτοῦ",3,48]],"He has reached forth his hand for retribution; they have profaned his covenant."],["22",[["Διεμερίσθησαν",2174,94],["ἀπὸ",17,1],["ὀργῆς",198,19],["τοῦ",1,23],["προσώπου",47,24],["αὐτοῦ",3,144],["καὶ",2,8],["ἤγγισεν",452,3],["ἡ",1,11],["καρδία",63,13],["αὐτοῦ",3,48],["ἡπαλύνθησαν",5285,94],["οἱ",1,128],["λόγοι",48,51],["αὐτοῦ",3,48],["ὑπὲρ",139,1],["ἔλαιον",312,33],["καὶ",2,8],["αὐτοί",3,193],["εἰσι",10,189],["βολίδες",2265,179]],"They were scattered at the anger of his countenance, and his heart drew nigh them. His words were smoother than oil, yet are they darts."],["23",[["Ἐπίῤῥιψον",2542,243],["ἐπὶ",9,1],["Κύριον",7,7],["τὴν",1,9],["μέριμνάν",2472,129],["σου",5,146],["καὶ",2,8],["αὐτός",3,158],["σε",5,161],["διαθρέψει",2081,120],["οὐ",12,17],["δώσει",33,120],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["σάλον",2642,7],["τῷ",1,110],["δικαίῳ",152,111]],"Cast thy care upon the Lord, and he shall sustain thee; he shall never suffer the righteous to be moved."],["24",[["Σὺ",5,156],["δὲ",14,12],["ὁ",1,4],["Θεὸς",20,5],["κατάξεις",741,159],["αὐτοὺς",3,60],["εἰς",8,1],["φρέαρ",878,33],["διαφθορᾶς",1672,19],["ἄνδρες",38,51],["αἱμάτων",148,45],["καὶ",2,8],["δολιότητος",3529,19],["οὐ",12,17],["μὴ",25,8],["ἡμισεύσωσι",9795,224],["τὰς",1,39],["ἡμέρας",28,19],["αὐτῶν",3,41],["ἐγὼ",6,158],["δὲ",14,12],["ἐλπιῶ",511,157],["ἐπὶ",9,1],["σε",5,161],["Κύριε",7,251]],"But thou, O God, shalt bring them down to the pit of destruction; bloody and crafty men shall not live out half their days; but I will hope in thee, O Lord."]]