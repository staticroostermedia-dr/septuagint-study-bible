[["1",[["Προσευχὴ",550,13],["τοῦ",1,30],["Μωυσῆ",69,250],["ἀνθρώπου",43,21],["τοῦ",1,30],["Θεοῦ",20,21],["Κύριε",7,250],["καταφυγὴ",1678,13],["ἐγενήθης",30,360],["ἡμῖν",6,142],["ἐν",4,1],["γενεᾷ",286,2],["καὶ",2,8],["γενεᾷ",286,2]],"A Prayer of Moses the man of God. Lord, thou hast been our refuge in all generations."],["2",[["Πρὸ",238,1],["τοῦ",1,30],["ὄρη",87,43],["γενηθῆναι",30,175],["καὶ",2,8],["πλασθῆναι",910,175],["τὴν",1,9],["γῆν",26,10],["καὶ",2,8],["τὴν",1,9],["οἰκουμένην",1326,10],["καὶ",2,8],["ἀπὸ",17,1],["τοῦ",1,30],["αἰῶνος",100,21],["ἕως",42,8],["τοῦ",1,30],["αἰῶνος",100,21],["σὺ",5,156],["εἶ",10,145]],"Before the mountains existed, and [before] the earth and the world were formed, even from age to age, Thou art."],["3",[["Μὴ",25,8],["ἀποστρέψῃς",130,170],["ἄνθρωπον",43,7],["εἰς",8,1],["ταπείνωσιν",1481,10],["καὶ",2,8],["εἶπας",18,154],["ἐπιστρέψατε",117,69],["υἱοὶ",13,51],["ἀνθρώπων",43,77]],"Turn not man back to [his] low place, whereas thou saidst, Return, ye sons of men?"],["4",[["Ὅτι",19,8],["χίλια",1483,74],["ἔτη",81,63],["ἐν",4,1],["ὀφθαλμοῖς",91,139],["σου",5,146],["ὡς",36,8],["ἡ",1,11],["ἡμέρα",28,13],["ἡ",1,11],["ἐχθὲς",1288,17],["ἥτις",457,421],["διῆλθε",423,3],["καὶ",2,8],["φυλακὴ",485,13],["ἐν",4,1],["νυκτί",219,2]],"For a thousand years in thy sight are as the yesterday which is past, and as a watch in the night."],["5",[["Τὰ",1,42],["ἐξουδενώματα",6481,43],["αὐτῶν",3,41],["ἔτη",81,43],["ἔσονται",10,127],["τοπρωῒ",0,0],["ὡσεὶ",343,17],["χλόη",2438,13],["παρέλθοι",404,216]],"Years shall be vanity to them: let the morning pass away as grass."],["6",[["Τοπρωῒ",0,0],["ἀνθήσαι",2207,216],["καὶ",2,8],["παρέλθοι",404,216],["τὸ",1,32],["ἑσπέρας",488,19],["ἀποπέσοι",3172,216],["σκληρυνθείη",1284,544],["καὶ",2,8],["ξηρανθείη",842,544]],"In the morning let it flower, and pass away: in the evening let it droop, let it be withered and dried up."],["7",[["Ὅτι",19,8],["ἐξελίπομεν",321,285],["ἐν",4,1],["τῇ",1,95],["ὀργῇ",198,2],["σου",5,146],["καὶ",2,8],["ἐν",4,1],["τῷ",1,110],["θυμῷ",178,113],["σου",5,146],["ἐταράχθημεν",508,491]],"For we have perished in thine anger, and in thy wrath we have been troubled."],["8",[["Ἔθου",110,169],["τὰς",1,39],["ἀνομίας",275,40],["ἡμῶν",6,41],["ἐνώπιόν",115,1],["σου",5,146],["ὁ",1,4],["αἰὼν",100,5],["ἡμῶν",6,41],["εἰς",8,1],["φωτισμὸν",3670,7],["τοῦ",1,23],["προσώπου",47,24],["σου",5,146]],"Thou hast set our transgressions before thee: our age is in the light of thy countenance."],["9",[["Ὅτι",19,8],["πᾶσαι",11,187],["αἱ",1,185],["ἡμέραι",28,2],["ἡμῶν",6,41],["ἐξέλιπον",321,141],["καὶ",2,8],["ἐν",4,1],["τῇ",1,95],["ὀργῇ",198,2],["σου",5,146],["ἐξελίπομεν",321,285],["τὰ",1,42],["ἔτη",81,43],["ἡμῶν",6,41],["ὡς",36,8],["ἀράχνη",4048,13],["ἐμελέτων",1347,129]],"For all our days are gone, and we have passed away in thy wrath: our years have spun out their tale as a spider."],["10",[["Αἱ",1,185],["ἡμέραι",28,2],["τῶν",1,44],["ἐτῶν",81,45],["ἡμῶν",6,41],["ἐν",4,1],["αὐτοῖς",3,142],["ἑβδομήκοντα",625,57],["ἔτη",81,43],["ἐὰν",45,8],["δὲ",14,12],["ἐν",4,1],["δυναστείαις",918,71],["ὀγδοήκοντα",1433,57],["ἔτη",81,43],["καὶ",2,8],["τὸ",1,32],["πλεῖον",938,29],["αὐτῶν",3,41],["κόπος",1345,5],["καὶ",2,8],["πόνος",566,5],["ὅτι",19,8],["ἐπῆλθε",542,3],["πραΰτης",4361,105],["ἐφʼ",9,1],["ἡμᾶς",6,60],["καὶ",2,8],["παιδευθησόμεθα",643,349]],"[As for] the days of our years, in them are seventy years; and if [men should be] in strength, eighty years: and the greater part of them would be labour and trouble; for weakness overtakes us, and we shall be chastened."],["11",[["Τίς",39,150],["γινώσκει",79,87],["τὸ",1,32],["κράτος",1139,33],["τῆς",1,18],["ὀργῆς",198,19],["σου",5,146],["καὶ",2,8],["ἀπὸ",17,1],["τοῦ",1,30],["φόβου",333,21],["τοῦ",1,30],["θυμοῦ",178,21],["σου",5,146],["ἐξαριθμήσασθαι",1932,103]],"Who knows the power of thy wrath? and [who knows how] to number [his days] because of the fear of thy wrath?",{"s":"r"}],["12",[["τὴν",1,9],["δεξιάν",282,37],["σου",5,146],["οὕτως",71,17],["γνώρισον",748,198],["καὶ",2,8],["τοὺς",1,56],["πεπαιδευμένους",643,369],["τῇ",1,95],["καρδίᾳ",64,2],["ἐν",4,1],["σοφίᾳ",242,2]],"So manifest thy right hand, and those that are instructed in wisdom in the heart.",{"s":"r"}],["13",[["Ἐπίστρεψον",117,198],["Κύριε",7,250],["ἕως",42,8],["πότε",458,12],["καὶ",2,8],["παρακλήθητι",434,242],["ἐπὶ",9,1],["τοῖς",1,138],["δούλοις",136,139],["σου",5,146]],"Return, O Lord, how long? and be intreated concerning thy servants."],["14",[["Ἐνεπλήσθημεν",427,491],["τοπρωῒ",0,0],["τοῦ",1,23],["ἐλέους",183,24],["σου",5,146],["καὶ",2,8],["ἠγαλλιασάμεθα",738,314],["καὶ",2,8],["εὐφράνθημεν",244,491],["ἐν",4,1],["πάσαις",11,287],["ταῖς",1,70],["ἡμέραις",28,71],["ἡμῶν",6,41]],"We have been satisfied in the morning with thy mercy; and we did exult and rejoice:"],["15",[["εὐφρανθείημεν",244,663],["ἀνθʼ",158,1],["ᾧν",9954,482],["ἡμερῶν",28,61],["ἐταπείνωσας",322,154],["ἡμᾶς",6,60],["ἐτῶν",81,45],["ὧν",24,97],["εἴδομεν",53,285],["κακά",161,65]],"let us rejoice in all our days, in return for the days wherein thou didst afflict us, the years wherein we saw evil."],["16",[["Καὶ",2,8],["ἴδε",713,17],["ἐπὶ",9,1],["τοὺς",1,56],["δούλους",136,31],["σου",5,146],["καὶ",2,8],["ἐπὶ",9,1],["τὰ",1,42],["ἔργα",105,43],["σου",5,146],["καὶ",2,8],["ὁδήγησον",1108,198],["τοὺς",1,56],["υἱοὺς",13,31],["αὐτῶν",3,41]],"And look upon thy servants, and upon thy works; and guide their children."],["17",[["Καὶ",2,8],["ἔστω",10,35],["ἡ",1,11],["λαμπρότης",3577,13],["Κυρίου",7,21],["τοῦ",1,30],["Θεοῦ",20,21],["ἡμῶν",6,41],["ἐφʼ",9,1],["ἡμᾶς",6,60],["καὶ",2,8],["τὰ",1,42],["ἔργα",105,43],["τῶν",1,123],["χειρῶν",37,61],["ἡμῶν",6,189],["κατεύθυνον",827,198],["ἐφʼ",9,1],["ἡμᾶς",6,60]],"And let the brightness of the Lord our God be upon us: and do thou direct for us the works of our hands."]]