[["1",[["Προσευχὴ",549,13],["τοῦ",1,30],["Μωυσῆ",68,251],["ἀνθρώπου",43,21],["τοῦ",1,30],["Θεοῦ",20,21],["Κύριε",7,251],["καταφυγὴ",1681,13],["ἐγενήθης",30,363],["ἡμῖν",6,142],["ἐν",4,1],["γενεᾷ",286,2],["καὶ",2,8],["γενεᾷ",286,2]],"A Prayer of Moses the man of God. Lord, thou hast been our refuge in all generations."],["2",[["Πρὸ",235,1],["τοῦ",1,30],["ὄρη",86,43],["γενηθῆναι",30,174],["καὶ",2,8],["πλασθῆναι",912,174],["τὴν",1,9],["γῆν",26,10],["καὶ",2,8],["τὴν",1,9],["οἰκουμένην",1326,10],["καὶ",2,8],["ἀπὸ",17,1],["τοῦ",1,30],["αἰῶνος",100,21],["ἕως",42,8],["τοῦ",1,30],["αἰῶνος",100,21],["σὺ",5,156],["εἶ",10,145]],"Before the mountains existed, and [before] the earth and the world were formed, even from age to age, Thou art."],["3",[["Μὴ",25,8],["ἀποστρέψῃς",130,170],["ἄνθρωπον",43,7],["εἰς",8,1],["ταπείνωσιν",1483,10],["καὶ",2,8],["εἶπας",18,154],["ἐπιστρέψατε",116,69],["υἱοὶ",13,51],["ἀνθρώπων",43,77]],"Turn not man back to [his] low place, whereas thou saidst, Return, ye sons of men?"],["4",[["Ὅτι",19,8],["χίλια",1485,74],["ἔτη",80,63],["ἐν",4,1],["ὀφθαλμοῖς",91,139],["σου",5,146],["ὡς",36,8],["ἡ",1,11],["ἡμέρα",28,13],["ἡ",1,11],["ἐχθὲς",1287,17],["ἥτις",454,428],["διῆλθε",427,3],["καὶ",2,8],["φυλακὴ",483,13],["ἐν",4,1],["νυκτί",216,2]],"For a thousand years in thy sight are as the yesterday which is past, and as a watch in the night."],["5",[["Τὰ",1,42],["ἐξουδενώματα",6515,43],["αὐτῶν",3,41],["ἔτη",80,43],["ἔσονται",10,127],["τοπρωῒ",0,0],["ὡσεὶ",342,17],["χλόη",2443,13],["παρέλθοι",410,276]],"Years shall be vanity to them: let the morning pass away as grass."],["6",[["Τοπρωῒ",0,0],["ἀνθήσαι",2220,276],["καὶ",2,8],["παρέλθοι",410,276],["τὸ",1,32],["ἑσπέρας",486,19],["ἀποπέσοι",3179,276],["σκληρυνθείη",1283,555],["καὶ",2,8],["ξηρανθείη",843,555]],"In the morning let it flower, and pass away: in the evening let it droop, let it be withered and dried up."],["7",[["Ὅτι",19,8],["ἐξελίπομεν",321,288],["ἐν",4,1],["τῇ",1,95],["ὀργῇ",198,2],["σου",5,146],["καὶ",2,8],["ἐν",4,1],["τῷ",1,110],["θυμῷ",177,113],["σου",5,146],["ἐταράχθημεν",508,498]],"For we have perished in thine anger, and in thy wrath we have been troubled."],["8",[["Ἔθου",109,169],["τὰς",1,39],["ἀνομίας",274,40],["ἡμῶν",6,41],["ἐνώπιόν",114,1],["σου",5,146],["ὁ",1,4],["αἰὼν",100,5],["ἡμῶν",6,41],["εἰς",8,1],["φωτισμὸν",3676,7],["τοῦ",1,23],["προσώπου",47,24],["σου",5,146]],"Thou hast set our transgressions before thee: our age is in the light of thy countenance."],["9",[["Ὅτι",19,8],["πᾶσαι",11,185],["αἱ",1,183],["ἡμέραι",28,2],["ἡμῶν",6,41],["ἐξέλιπον",321,141],["καὶ",2,8],["ἐν",4,1],["τῇ",1,95],["ὀργῇ",198,2],["σου",5,146],["ἐξελίπομεν",321,288],["τὰ",1,42],["ἔτη",80,43],["ἡμῶν",6,41],["ὡς",36,8],["ἀράχνη",4056,13],["ἐμελέτων",1344,129]],"For all our days are gone, and we have passed away in thy wrath: our years have spun out their tale as a spider."],["10",[["Αἱ",1,183],["ἡμέραι",28,2],["τῶν",1,44],["ἐτῶν",80,45],["ἡμῶν",6,41],["ἐν",4,1],["αὐτοῖς",3,142],["ἑβδομήκοντα",624,57],["ἔτη",80,43],["ἐὰν",45,8],["δὲ",14,12],["ἐν",4,1],["δυναστείαις",919,71],["ὀγδοήκοντα",1435,57],["ἔτη",80,43],["καὶ",2,8],["τὸ",1,32],["πλεῖον",938,29],["αὐτῶν",3,41],["κόπος",1342,5],["καὶ",2,8],["πόνος",564,5],["ὅτι",19,8],["ἐπῆλθε",540,3],["πραΰτης",4374,105],["ἐφʼ",9,1],["ἡμᾶς",6,60],["καὶ",2,8],["παιδευθησόμεθα",654,353]],"[As for] the days of our years, in them are seventy years; and if [men should be] in strength, eighty years: and the greater part of them would be labour and trouble; for weakness overtakes us, and we shall be chastened."],["11",[["Τίς",39,150],["γινώσκει",81,87],["τὸ",1,32],["κράτος",1139,33],["τῆς",1,18],["ὀργῆς",198,19],["σου",5,146],["καὶ",2,8],["ἀπὸ",17,1],["τοῦ",1,30],["φόβου",330,21],["τοῦ",1,30],["θυμοῦ",177,21],["σου",5,146],["ἐξαριθμήσασθαι",1933,103]],"Who knows the power of thy wrath?"],["12",[["τὴν",1,9],["δεξιάν",282,37],["σου",5,146],["οὕτως",70,17],["γνώρισον",746,198],["καὶ",2,8],["τοὺς",1,56],["πεπαιδευμένους",0,0],["τῇ",1,95],["καρδίᾳ",63,2],["ἐν",4,1],["σοφίᾳ",238,2]],"and [who knows how] to number [his days] because of the fear of thy wrath? So manifest thy right hand, and those that are instructed in wisdom in the heart."],["13",[["Ἐπίστρεψον",116,198],["Κύριε",7,251],["ἕως",42,8],["πότε",455,12],["καὶ",2,8],["παρακλήθητι",432,242],["ἐπὶ",9,1],["τοῖς",1,138],["δούλοις",136,139],["σου",5,146]],"Return, O Lord, how long? and be intreated concerning thy servants."],["14",[["Ἐνεπλήσθημεν",424,498],["τοπρωῒ",0,0],["τοῦ",1,23],["ἐλέους",182,24],["σου",5,146],["καὶ",2,8],["ἠγαλλιασάμεθα",737,318],["καὶ",2,8],["εὐφράνθημεν",242,498],["ἐν",4,1],["πάσαις",11,290],["ταῖς",1,70],["ἡμέραις",28,71],["ἡμῶν",6,41]],"We have been satisfied in the morning with thy mercy; and we did exult and rejoice:"],["15",[["εὐφρανθείημεν",242,685],["ἀνθʼ",158,1],["ᾧν",10033,287],["ἡμερῶν",28,61],["ἐταπείνωσας",333,154],["ἡμᾶς",6,60],["ἐτῶν",80,45],["ὧν",24,97],["εἴδομεν",73,288],["κακά",161,65]],"let us rejoice in all our days, in return for the days wherein thou didst afflict us, the years wherein we saw evil."],["16",[["Καὶ",2,8],["ἴδε",693,17],["ἐπὶ",9,1],["τοὺς",1,56],["δούλους",136,31],["σου",5,146],["καὶ",2,8],["ἐπὶ",9,1],["τὰ",1,42],["ἔργα",104,43],["σου",5,146],["καὶ",2,8],["ὁδήγησον",1110,243],["τοὺς",1,56],["υἱοὺς",13,31],["αὐτῶν",3,41]],"And look upon thy servants, and upon thy works; and guide their children."],["17",[["Καὶ",2,8],["ἔστω",10,35],["ἡ",1,11],["λαμπρότης",3581,13],["Κυρίου",7,21],["τοῦ",1,30],["Θεοῦ",20,21],["ἡμῶν",6,41],["ἐφʼ",9,1],["ἡμᾶς",6,60],["καὶ",2,8],["τὰ",1,42],["ἔργα",104,43],["τῶν",1,123],["χειρῶν",37,61],["ἡμῶν",6,187],["κατεύθυνον",828,198],["ἐφʼ",9,1],["ἡμᾶς",6,60]],"And let the brightness of the Lord our God be upon us: and do thou direct for us the works of our hands."]]