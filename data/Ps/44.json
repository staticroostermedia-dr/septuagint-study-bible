[["1",[["Εἰς",8,1],["τὸ",1,32],["τέλος",369,33],["ὑπὲρ",139,1],["τῶν",1,76],["ἀλλοιωθησομένων",1289,695],["τοῖς",1,138],["υἱοῖς",13,139],["Κορὲ",875,251],["εἰς",8,1],["σύνεσιν",467,10],["ᾠδὴ",773,13],["ὑπὲρ",139,1],["τοῦ",1,30],["ἀγαπητοῦ",1922,153]],"For the end, for alternate [strains] by the sons of Core; for instruction, a Song concerning the beloved."],["2",[["Ἐξηρεύξατο",0,0],["ἡ",1,11],["καρδία",63,13],["μου",6,48],["λόγον",48,7],["ἀγαθὸν",113,59],["λέγω",31,149],["ἐγὼ",6,158],["τὰ",1,42],["ἔργα",104,43],["μου",6,48],["τῷ",1,110],["βασιλεῖ",22,113],["ἡ",1,11],["γλῶσσά",385,13],["μου",6,48],["κάλαμος",1473,5],["γραμματέως",630,21],["ὀξυγράφου",9874,153]],"My heart has uttered a good matter: I declare my works to the king: my tongue is the pen of a quick writer."],["3",[["Ὡραῖος",1296,16],["κάλλει",887,134],["παρὰ",72,1],["τοὺς",1,56],["υἱοὺς",13,31],["τῶν",1,76],["ἀνθρώπων",43,77],["ἐξεχύθη",435,38],["χάρις",366,13],["ἐν",4,1],["χείλεσί",361,92],["σου",5,146],["διὰ",54,1],["τοῦτο",16,122],["εὐλόγησέ",147,3],["σε",5,161],["ὁ",1,4],["Θεὸς",20,5],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7]],"Thou art more beautiful than the sons of men: grace has been shed forth on thy lips: therefore God has blessed thee for ever."],["4",[["Περίζωσαι",1418,275],["τὴν",1,9],["ῥομφαίαν",247,10],["σου",5,146],["ἐπὶ",9,1],["τὸν",1,6],["μηρόν",1275,7],["σου",5,146],["δυνατέ",354,313],["τῇ",1,95],["ὡραιότητί",3483,2],["σου",5,146],["καὶ",2,8],["τῷ",1,52],["κάλλει",887,53],["σου",5,146]],"Gird thy sword upon thy thigh, O Mighty One, in thy comeliness, and in thy beauty;"],["5",[["καὶ",2,8],["ἔντεινον",1998,198],["καὶ",2,8],["κατευοδοῦ",3867,250],["καὶ",2,8],["βασίλευε",151,239],["ἕνεκεν",445,1],["ἀληθείας",350,19],["καὶ",2,8],["πρᾳΰτητος",0,0],["καὶ",2,8],["δικαιοσύνης",185,19],["καὶ",2,8],["ὁδηγήσει",1110,120],["σε",5,161],["θαυμαστῶς",1074,17],["ἡ",1,11],["δεξιά",282,15],["σου",5,146]],"and bend [thy bow], and prosper, and reign, because of truth and meekness and righteousness; and thy right hand shall guide thee wonderfully."],["6",[["Τὰ",1,42],["βέλη",1159,43],["σου",5,146],["ἠκονημένα",0,0],["δυνατὲ",354,313],["λαοὶ",35,51],["ὑποκάτω",597,17],["σου",5,146],["πεσοῦνται",154,127],["ἐν",4,1],["καρδίᾳ",63,2],["τῶν",1,76],["ἐχθρῶν",135,77],["τοῦ",1,30],["βασιλέως",22,21]],"Thy weapons are sharpened, Mighty One, (the nations shall fall under thee) [they are] in the heart of the king's enemies."],["7",[["Ὁ",1,4],["θρόνος",379,5],["σου",5,146],["ὁ",1,4],["Θεὸς",20,5],["εἰς",8,1],["αἰῶνα",100,7],["αἰῶνος",100,21],["ῥάβδος",492,13],["εὐθύτητος",1676,19],["ἡ",1,11],["ῥάβδος",492,13],["τῆς",1,18],["βασιλείας",157,19],["σου",5,146]],"Thy throne, O God, is for ever and ever: the sceptre of thy kingdom is a sceptre of righteousness."],["8",[["Ἠγάπησας",224,154],["δικαιοσύνην",185,10],["καὶ",2,8],["ἐμίσησας",355,154],["ἀνομίαν",274,10],["διὰ",54,1],["τοῦτο",16,122],["ἔχρισέ",713,3],["σε",5,161],["ὁ",1,4],["Θεὸς",20,5],["ὁ",1,4],["Θεός",20,5],["σου",5,146],["ἔλαιον",312,33],["ἀγαλλιάσεως",1985,19],["παρὰ",72,1],["τοὺς",1,56],["μετόχους",3102,31],["σου",5,146]],"Thou hast loved righteousness, and hated iniquity: therefore God, thy God, has anointed thee with the oil of gladness beyond thy fellows."],["9",[["Σμύρνα",2778,13],["καὶ",2,8],["στακτὴ",2781,13],["καὶ",2,8],["κασία",4846,13],["ἀπὸ",17,1],["τῶν",1,44],["ἱματίων",275,45],["σου",5,146],["ἀπὸ",17,1],["βάρεων",3512,61],["ἐλεφαντίνων",2840,115],["ἐξ",21,1],["ὧν",24,190],["ηὔφρανάν",242,141],["σε",5,161]],"Myrrh, and stacte, and cassia [are exhaled] from thy garments, [and] out of the ivory palaces,"],["10",[["θυγατέρες",97,179],["βασιλέων",22,77],["ἐν",4,1],["τῇ",1,95],["τιμῇ",721,2],["σου",5,146],["παρέστη",592,3],["ἡ",1,11],["βασίλισσα",1265,13],["ἐκ",21,1],["δεξιῶν",282,79],["σου",5,146],["ἐν",4,1],["ἱματισμῷ",1462,113],["διαχρύσῳ",5609,111],["περιβεβλημένη",743,197],["πεποικιλμένη",0,0]],"with which kings' daughters have gladdened thee for thine honour: the queen stood by on thy right hand, clothed in vesture wrought with gold, [and] arrayed in divers colours."],["11",[["Ἄκουσον",53,198],["θύγατερ",97,361],["καὶ",2,8],["ἴδε",693,17],["καὶ",2,8],["κλῖνον",829,36],["τὸ",1,27],["οὖς",325,20],["σου",5,146],["καὶ",2,8],["ἐπιλάθου",512,250],["τοῦ",1,30],["λαοῦ",35,21],["σου",5,146],["καὶ",2,8],["τοῦ",1,30],["οἴκου",34,21],["τοῦ",1,30],["πατρός",44,21],["σου",5,146]],"Hear, O daughter, and see, and incline thine ear; forget also thy people, and thy father's house."],["12",[["Ὅτι",19,8],["ἐπεθύμησεν",0,0],["ὁ",1,4],["βασιλεὺς",22,5],["τοῦ",1,23],["κάλλους",887,24],["σου",5,146],["ὅτι",19,8],["αὐτός",3,158],["ἐστιν",10,87],["ὁ",1,4],["Κύριός",7,5],["σου",5,146]],"Because the king has desired thy beauty; for he is thy Lord."],["13",[["Καὶ",2,8],["προσκυνήσουσιν",296,207],["αὐτῷ",3,49],["θυγατέρες",97,179],["Τύρου",1201,19],["ἐν",4,1],["δώροις",347,92],["τὸ",1,32],["πρόσωπόν",47,33],["σου",5,146],["λιτανεῦσουσιν",5827,207],["οἱ",1,128],["πλούσιοι",954,130],["τοῦ",1,30],["λαοῦ",35,21],["τῆς",1,18],["γῆς",26,19]],"And the daughter of Tyre shall adore him with gifts; the rich of the people of the land shall supplicate thy favour."],["14",[["Πᾶσα",11,15],["ἡ",1,11],["δόξα",141,186],["αὐτῆς",3,83],["θυγατρὸς",97,19],["τοῦ",1,30],["βασιλέως",22,21],["Ἐσεβὼν",0,0],["ἐν",4,1],["κροσσωτοῖς",5786,215],["χρυσοῖς",290,215],["περιβεβλημένη",743,197],["πεποικιλμένη",0,0]],"All her glory [is that] of the daughter of the king of Esebon, robed [as she is] in golden fringed garments,"],["15",[["ἀπενεχθήσονται",1398,135],["τῷ",1,110],["βασιλεῖ",22,113],["παρθένοι",787,179],["ὀπίσω",166,17],["αὐτῆς",3,83],["αἱ",1,183],["πλησίον",292,17],["αὐτῆς",3,83],["ἀπενεχθήσονταί",1398,135],["σοι",5,151]],"in embroidered [clothing]: virgins shall be brought to the king after her: her fellows shall be brought to thee."],["16",[["Ἀπενεχθήσονται",1398,135],["ἐν",4,1],["εὐφροσύνῃ",360,2],["καὶ",2,8],["ἀγαλλιάσει",1985,2],["ἀχθήσονται",227,135],["εἰς",8,1],["ναὸν",481,7],["βασιλέως",22,21]],"They shall be brought with gladness and exultation: they shall be led into the king's temple."],["17",[["Ἀντὶ",158,1],["τῶν",1,76],["πατέρων",44,77],["σου",5,146],["ἐγενήθησάν",30,94],["σοι",5,151],["υἱοὶ",13,51],["καταστήσεις",313,159],["αὐτοὺς",3,60],["ἄρχοντας",96,31],["ἐπὶ",9,1],["πᾶσαν",11,37],["τὴν",1,9],["γῆν",26,10]],"Instead of thy fathers children are born to thee: thou shalt make them princes over all the earth."],["18",[["Μνησθήσονται",231,135],["τοῦ",1,23],["ὀνόματός",55,24],["σου",5,146],["ἐν",4,1],["πάσῃ",11,96],["γενεᾷ",286,2],["καὶ",2,8],["γενεᾷ",286,2],["διὰ",54,1],["τοῦτο",16,122],["λαοὶ",35,51],["ἐξομολογήσονταί",478,127],["σοι",5,151],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["καὶ",2,8],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7],["τοῦ",1,30],["αἰῶνος",100,21]],"They shall make mention of thy name from generation to generation: therefore shall the nations give thanks to thee for ever, even for ever and ever."]]