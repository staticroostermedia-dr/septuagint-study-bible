[["1",[["Καὶ",2,8],["ἐγένετο",30,26],["καθὼς",221,17],["ἠκούσθη",54,38],["τῷ",1,110],["Σαναβαλλὰτ",11676,0],["καὶ",2,8],["Τωβίᾳ",0,0],["καὶ",2,8],["τῷ",1,110],["Γησὰμ",12004,0],["τῷ",1,110],["Ἀραβὶ",6335,356],["καὶ",2,8],["τοῖς",1,138],["καταλοίποις",557,215],["ἐχθρῶν",135,77],["ἡμῶν",6,41],["ὅτι",19,8],["ᾠκοδόμησα",126,147],["τὸ",1,32],["τεῖχος",325,33],["καὶ",2,8],["οὐ",12,17],["κατελείφθη",207,38],["ἐν",4,1],["αὐτοῖς",3,142],["πνοή",1637,13],["ἕως",42,8],["τοῦ",1,30],["καιροῦ",132,21],["ἐκείνου",80,48],["θύρας",277,19],["οὐκ",12,17],["ἐπέστησα",631,147],["ἐν",4,1],["ταῖς",1,70],["πύλαις",162,71]],"Now it came to pass, when Sanaballat, and Tobias, and Gesam the Arabian, and the rest of our enemies, heard that I had built the wall, and [that] there was no opening left therein; ([but] hitherto I had not set up the doors on the gates;)"],["2",[["Καὶ",2,8],["ἀπέστειλε",84,3],["Σαναβαλλὰτ",11676,0],["καὶ",2,8],["Γησὰμ",12004,0],["πρὸς",15,1],["μὲ",6,82],["λέγων",31,67],["δεῦρο",715,17],["καὶ",2,8],["συναχθῶμεν",166,282],["ἐπιτοαυτὸ",1404,105],["ἐν",4,1],["ταῖς",1,70],["κώμαις",679,71],["ἐν",4,1],["πεδίῳ",349,53],["Ὠνώ",4640,169],["καὶ",2,8],["αὐτοὶ",3,195],["λογιζόμενοι",495,351],["ποιῆσαί",23,100],["μοι",6,49],["πονηρίαν",730,10]],"that Sanaballat and Gesam sent to me, saying, Come and let us meet together in the villages in the plain of Ono. But they [were] plotting to do me mischief."],["3",[["Καὶ",2,8],["ἀπέστειλα",84,147],["ἐπʼ",9,1],["αὐτοὺς",3,60],["ἀγγέλους",208,31],["λέγων",31,67],["ἔργον",105,33],["μέγα",66,29],["ἐγὼ",6,158],["ποιῶ",23,149],["καὶ",2,8],["οὐ",12,17],["δυνήσομαι",185,177],["καταβῆναι",175,100],["μή",25,8],["ποτε",458,12],["καταπαύσῃ",778,116],["τὸ",1,32],["ἔργον",105,33],["ὡς",36,8],["ἂν",83,12],["τελειώσω",1838,227],["αὐτὸ",3,121],["καταβήσομαι",175,177],["πρὸς",15,1],["ὑμᾶς",5,209]],"So I sent messengers to them, saying, I am doing a great work, and I shall not be able to come down, lest the work should cease: as soon as I shall have finished it, I will come down to you."],["4",[["Καὶ",2,8],["ἀπέστειλαν",84,141],["πρὸς",15,1],["μὲ",6,82],["ὡς",36,8],["τὸ",1,32],["ῥῆμα",116,33],["τοῦτο",16,122],["καὶ",2,8],["ἀπέστειλα",84,147],["αὐτοῖς",3,142],["κατὰ",32,1],["ταῦτα",16,248]],"And they sent to me [again] to this effect; and I sent them [word] accordingly."],["5",[["Καὶ",2,8],["ἀπέστειλε",84,3],["πρὸς",15,1],["μὲ",6,82],["Σαναβαλλὰτ",11676,0],["τὸν",1,6],["παῖδα",127,7],["αὐτοῦ",3,48],["καὶ",2,8],["ἐπιστολὴν",866,10],["ἀνεῳγμένην",362,440],["ἐν",4,1],["χειρὶ",37,2],["αὐτοῦ",3,48]],"Then Sanaballat sent his servant to me with an open letter in his hand."],["6",[["Καὶ",2,8],["ἦν",10,14],["γεγραμμένον",186,326],["ἐν",4,1],["αὐτῇ",3,99],["ἐν",4,1],["ἔθνεσιν",60,92],["ἠκούσθη",54,38],["ὅτι",19,8],["σὺ",5,156],["καὶ",2,8],["οἱ",1,128],["Ἰουδαῖοι",285,51],["λογίζεσθε",495,68],["ἀποστατῆσαι",3175,100],["διὰ",56,1],["τοῦτο",16,122],["σὺ",5,156],["οἰκοδομεῖς",126,145],["τὸ",1,32],["τεῖχος",325,33],["καὶ",2,8],["σὺ",5,156],["ἔσῃ",10,116],["αὐτοῖς",3,142],["εἰς",8,1],["βασιλέα",22,7]],"And in it was written, It has been reported among the Gentiles that thou and the Jews are planning to revolt: therefore thou art building the wall, and thou wilt be a king to them."],["7",[["Καὶ",2,8],["πρὸς",15,1],["τούτοις",16,416],["προφήτας",176,31],["ἔστησας",78,154],["σεαυτῷ",255,49],["ἵνα",102,8],["καθίσῃς",274,170],["ἐν",4,1],["Ἰερουσαλὴμ",823,10],["εἰς",8,1],["βασιλέα",22,7],["ἐπὶ",9,1],["Ἰούδα",62,21],["καὶ",2,8],["νῦν",90,17],["ἀπαγγελήσονται",0,0],["τῷ",1,110],["βασιλεῖ",22,113],["οἱ",1,128],["λόγοι",48,51],["οὗτοι",16,213],["καὶ",2,8],["νῦν",90,17],["δεῦρο",715,17],["βουλευσώμεθα",641,270],["ἐπιτοαυτό",1404,105]],"And moreover thou hast appointed prophets to thyself, that thou mightest dwell in Jerusalem as a king over Juda: and now these words will be reported to the king. Now then, come, let us take counsel together."],["8",[["Καὶ",2,8],["ἀπέστειλα",84,147],["πρὸς",15,1],["αὐτὸν",3,82],["λέγων",31,67],["οὐκ",12,17],["ἐγενήθη",30,38],["ὡς",36,8],["οἱ",1,128],["λόγοι",48,51],["οὗτοι",16,213],["ὧς",36,8],["σὺ",5,156],["λέγεις",31,145],["ὅτι",19,8],["ἀπὸ",17,1],["καρδίας",64,19],["σου",5,146],["σὺ",5,156],["ψεύδῃ",1099,166],["αὐτούς",3,60]],"And I sent to him, saying, It has not happened according to these words, [even] as thou sayest, for thou framest them falsely out of thy heart."],["9",[["Ὅτι",19,8],["πάντες",11,130],["φοβερίζουσιν",3989,191],["ἡμᾶς",6,60],["λέγοντες",31,137],["ἐκλυθήσονται",1194,135],["χεῖρες",37,180],["αὐτῶν",3,41],["ἀπὸ",17,1],["τοῦ",1,23],["ἔργου",105,24],["τούτου",16,298],["καὶ",2,8],["οὐ",12,17],["ποιηθήσεται",23,125],["καὶ",2,8],["νῦν",90,17],["ἐκραταίωσα",729,147],["τὰς",1,39],["χεῖράς",37,40],["μου",6,48]],"For all were trying to alarm us, saying, Their hands shall be weakened from this work, and it shall not be done. Now therefore I have strengthened my hands."],["10",[["Κᾀγὼ",613,105],["εἰσῆλθον",86,141],["εἰς",8,1],["οἶκον",34,7],["Σεμεῒ",998,105],["υἱοῦ",13,21],["Δαλαΐα",0,0],["υἱοῦ",13,21],["Μεταβεὴλ",13388,0],["καὶ",2,8],["αὐτὸς",3,158],["συνεχόμενος",1227,114],["καὶ",2,8],["εἶπε",18,3],["συναχθῶμεν",166,282],["εἰς",8,1],["οἶκον",34,7],["τοῦ",1,30],["Θεοῦ",20,21],["ἐν",4,1],["μέσῳ",113,34],["αὐτοῦ",3,48],["καὶ",2,8],["κλείσωμεν",1514,75],["τὰς",1,39],["θύρας",277,40],["αὐτοῦ",3,48],["ὅτι",19,8],["ἔρχονται",55,299],["νυκτὸς",219,19],["φονεῦσαί",970,100],["σε",5,161]],"And I came into the house of Semei the son of Dalaia the son of Metabeel, and he was shut up; and he said, Let us assemble together in the house of God, in the midst of it, and let us shut the doors of it; for they are coming by night to slay thee."],["11",[["Καὶ",2,8],["εἶπα",18,147],["τίς",39,150],["ἐστιν",10,87],["ὁ",1,4],["ἀνὴρ",38,5],["ὃς",24,246],["εἰσελεύσεται",86,89],["εἰς",8,1],["τὸν",1,6],["οἶκον",34,7],["καὶ",2,8],["ζήσεται",107,89]],"And I said, Who is the man that shall enter into the house, that he may live?"],["12",[["Καὶ",2,8],["ἐπέγνων",431,147],["καὶ",2,8],["ἰδοὺ",51,17],["ὁ",1,4],["Θεὸς",20,5],["οὐκ",12,17],["ἀπέστειλεν",84,3],["αὐτὸν",3,82],["ὅτι",19,8],["ἡ",1,11],["προφητεία",2285,13],["λόγος",48,5],["κατʼ",32,1],["ἐμοῦ",6,48]],"And I observed, and, behold, God had not sent him, for the prophecy was a fable [devised] against me:"],["13",[["καὶ",2,8],["Τωβίας",0,0],["καὶ",2,8],["Σαναβαλλὰτ",11676,0],["ἐμισθώσαντο",2029,184],["ἐπʼ",9,1],["ἐμὲ",6,82],["ὄχλον",1008,7],["ὅπως",240,8],["φοβηθῶ",134,555],["καὶ",2,8],["ποιήσω",23,227],["οὕτως",71,17],["καὶ",2,8],["ἁμάρτω",237,227],["καὶ",2,8],["γένωμαι",30,255],["αὐτοῖς",3,142],["εἰς",8,1],["ὄνομα",57,33],["πονηρὸν",164,29],["ὅπως",240,8],["ὀνειδίσωσί",945,224],["με",6,82]],"and Tobias and Sanaballat had hired against me a multitude, that I might be frightened, and do this, and sin, and become to them an ill name, that they might reproach me."],["14",[["Μνήσθητι",230,242],["ὁ",1,4],["Θεὸς",20,5],["Τωβίᾳ",0,0],["καὶ",2,8],["Σαναβαλλάτ",13623,0],["ὡς",36,8],["τὰ",1,42],["ποιήματα",1443,43],["αὐτοῦ",3,48],["ταῦτα",16,248],["καὶ",2,8],["τῷ",1,110],["Νωαδίᾳ",13514,0],["τῷ",1,110],["προφήτῃ",176,113],["καὶ",2,8],["καταλοίποις",557,215],["τῶν",1,76],["προφητῶν",176,77],["οἳ",1,128],["ἦσαν",10,129],["φοβερίζοντές",3989,137],["με",6,82]],"Remember, O God, Tobias and Sanaballat, according to these their deeds, and the prophetess Noadia, and the rest of the prophets who tried to alarm me."],["15",[["Καὶ",2,8],["ἐτελέσθη",1482,38],["τὸ",1,32],["τεῖχος",325,33],["πέμπτῃ",844,96],["καὶ",2,8],["εἰκάδι",1547,2],["τοῦ",1,30],["Ἐλοὺλ",14432,0],["μηνὸς",386,21],["εἰς",8,1],["πεντήκοντα",453,57],["καὶ",2,8],["δύο",104,57],["ἡμέρας",28,19]],"So the wall was finished on the twenty-fifth day of the [month] Elul, in fifty-two days."],["16",[["Καὶ",2,8],["ἐγένετο",30,26],["ἡνίκα",543,17],["ἤκουσαν",54,141],["πάντες",11,130],["οἱ",1,128],["ἐχθροὶ",135,51],["ἡμῶν",6,41],["καὶ",2,8],["ἐφοβήθησαν",134,94],["πάντα",11,65],["τὰ",1,42],["ἔθνη",60,43],["τὰ",1,42],["κύκλῳ",258,17],["ἡμῶν",6,41],["καὶ",2,8],["ἐπέπεσε",995,3],["φόβος",333,5],["σφόδρα",150,17],["ἐν",4,1],["ὀφθαλμοῖς",91,139],["αὐτῶν",3,41],["καὶ",2,8],["ἔγνωσαν",79,141],["ὅτι",19,8],["παρὰ",73,1],["τοῦ",1,30],["Θεοῦ",20,21],["ἡμῶν",6,41],["ἐγενήθη",30,38],["τελειωθῆναι",1838,175],["τὸ",1,32],["ἔργον",105,33],["τοῦτο",16,122]],"And it came to pass, when all our enemies heard [of it], that all the nations round about us feared, and great alarm fell upon them, and they knew that it was of our God that this work should be finished."],["17",[["καὶ",2,8],["ἐν",4,1],["ταῖς",1,70],["ἡμέραις",28,71],["ἐκείναις",80,194],["ἀπὸ",17,1],["πολλῶν",74,163],["ἐντίμων",1339,163],["Ἰούδα",62,21],["ἐπιστολαὶ",866,180],["ἐπορεύοντο",49,131],["πρὸς",15,1],["Τωβίαν",0,0],["καὶ",2,8],["αἱ",1,185],["Τωβία",0,0],["ἤρχοντο",55,131],["πρὸς",15,1],["αὐτούς",3,60]],"And in those days letters came to Tobias from many nobles of Juda, and those of Tobias came to them."],["18",[["Ὅτι",19,8],["πολλοὶ",74,130],["ἐν",4,1],["Ἰούδα",62,21],["ἔνορκοι",6557,130],["ἦσαν",10,129],["αὐτῷ",3,49],["ὅτι",19,8],["γαμβρὸς",1543,5],["ἦν",10,14],["τοῦ",1,30],["Σεχενία",0,0],["υἱοῦ",13,21],["Ἡραέ",0,0],["καὶ",2,8],["Ἰωνὰν",2552,105],["υἱὸς",13,5],["αὐτοῦ",3,48],["ἔλαβε",46,3],["τὴν",1,9],["θυγατέρα",97,10],["Μεσουλὰμ",11756,0],["υἱοῦ",13,21],["Βαραχία",2437,451],["εἰς",8,1],["γυναῖκα",59,10]],"For many in Juda were bound to him by oath, because he was son-in-law of Sechenias the son of Herae; and Jonan his son had taken the daughter of Mesulam the son of Barachia to wife."],["19",[["Καὶ",2,8],["τοὺς",1,56],["λόγους",48,31],["αὐτοῦ",3,48],["ἦσαν",10,129],["λέγοντες",31,137],["πρὸς",15,1],["μὲ",6,82],["καὶ",2,8],["λόγους",48,31],["μου",6,48],["ἦσαν",10,129],["ἐκφέροντες",624,137],["αὐτῷ",3,49],["καὶ",2,8],["ἐπιστολὰς",866,40],["ἀπέστειλε",84,3],["Τωβίας",0,0],["φοβερίσαι",3989,100],["με",6,82]],"And they reported his words to me, and carried out my words to him: and Tobias sent letters to terrify me."]]