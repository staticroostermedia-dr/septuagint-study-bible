[["1",[["Καὶ",2,8],["ἡ",1,11],["κραυγὴ",828,13],["τοῦ",1,30],["λαοῦ",35,21],["καὶ",2,8],["γυναικῶν",59,61],["αὐτῶν",3,189],["μεγάλη",66,15],["πρὸς",15,1],["τοὺς",1,56],["ἀδελφοὺς",67,31],["αὐτῶν",3,41],["τοὺς",1,56],["Ἰουδαίους",285,31]],"And the cry of the people and their wives [was] great against their brethren the Jews."],["2",[["Καὶ",2,8],["ἦσάν",10,129],["τινες",39,402],["λέγοντες",31,137],["ἐν",4,1],["υἱοῖς",13,139],["ἡμῶν",6,41],["καὶ",2,8],["ἐν",4,1],["θυγατράσιν",97,71],["ἡμῶν",6,41],["ἡμεῖς",6,195],["πολλοὶ",74,130],["καὶ",2,8],["λημψόμεθα",0,0],["σῖτον",665,7],["καὶ",2,8],["φαγόμεθα",147,132],["καὶ",2,8],["ζησόμεθα",107,132]],"And some said, We [are] numerous with our sons and our daughters; so we will take corn, and eat, and live."],["3",[["Καὶ",2,8],["εἰσί",10,191],["τινες",39,402],["λέγοντες",31,137],["ἀγροὶ",252,51],["ἡμῶν",6,41],["καὶ",2,8],["ἀμπελῶνες",607,51],["ἡμῶν",6,41],["καὶ",2,8],["οἰκίαι",233,180],["ἡμῶν",6,41],["ἡμεῖς",6,329],["διεγγυῶμεν",7033,241],["καὶ",2,8],["ληψόμεθα",46,132],["σῖτον",665,7],["καὶ",2,8],["φαγόμεθα",147,132]],"And some said, [As to] our fields and vineyards and houses, let us pledge [them], and we will take corn, and eat."],["4",[["Καὶ",2,8],["εἰσί",10,191],["τινες",39,402],["λέγοντες",31,137],["ἐδανεισάμεθα",1669,314],["ἀργύριον",152,33],["εἰς",8,1],["φόρους",1124,31],["τοῦ",1,30],["βασιλέως",22,21],["ἀγροὶ",252,51],["ἡμῶν",6,41],["καὶ",2,8],["ἀμπελῶνες",607,51],["ἡμῶν",6,41],["καὶ",2,8],["οἰκίαι",233,180],["ἡμῶν",6,41]],"And some said, We have borrowed money for the king's tributes:—our fields, and our vineyards, and houses [are pledged]."],["5",[["Καὶ",2,8],["νῦν",90,17],["ὡς",36,8],["σὰρξ",287,13],["ἀδελφῶν",67,77],["ἡμῶν",6,41],["σὰρξ",287,13],["ἡμῶν",6,41],["ὡς",36,8],["υἱοὶ",13,51],["αὐτῶν",3,41],["υἱοὶ",13,51],["ἡμῶν",6,41],["καὶ",2,8],["ἰδοὺ",51,17],["ἡμεῖς",6,195],["καταδυναστεύομεν",1305,241],["τοὺς",1,56],["υἱοὺς",13,31],["ἡμῶν",6,41],["καὶ",2,8],["τὰς",1,39],["θυγατέρας",97,40],["ἡμῶν",6,41],["εἰς",8,1],["δ