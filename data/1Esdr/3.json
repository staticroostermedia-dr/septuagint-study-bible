16],["ἡμῶν",6,41],["ἕνα",58,59],["λόγον",48,7],["ὃς",24,246],["ὑπερισχύσει",2237,120],["καὶ",2,8],["οὗ",120,17],["ἐὰν",45,8],["φανῇ",832,333],["τὸ",1,32],["ῥῆμα",116,33],["αὐτοῦ",3,48],["σοφώτερον",324,29],["τοῦ",1,30],["ἑτέρου",253,153],["δώσει",33,120],["αὐτῷ",3,49],["Δαρεῖος",1053,5],["ὁ",1,4],["βασιλεὺς",22,5],["δωρεὰς",1341,40],["μεγάλας",66,109],["καὶ",2,8],["ἐπινίκια",6509,74],["μεγάλα",66,74]],"Let every one of us speak a sentence: he that shall overcome, and whose sentence shall seem wiser than the others, unto him shall the king Darius give great gifts, and great things in token of victory:"],["6",[["καὶ",2,8],["πορφύραν",1062,10],["περιβαλέσθαι",744,103],["καὶ",2,8],["ἐν",4,1],["χρυσώμασι",3386,92],["πίνειν",212,54],["καὶ",2,8],["ἐπὶ",9,1],["χρυσῷ",1602,113],["καθεύδειν",1724,54],["καὶ",2,8],["ἅρμα",359,20],["χρυσοχάλινον",6210,28],["καὶ",2,8],["κίδαριν",2264,10],["βυσσίνην",2441,37],["καὶ",2,8],["μανιάκην",4302,7],["περὶ",72,1],["τὸν",1,6],["τράχηλον",692,7]],"as to be clothed in purple, to drink in gold, and to sleep upon gold, and a chariot with bridles of gold, and an headtire of fine linen, and a chain about his neck:"],["7",[["καὶ",2,8],["δεύτερος",271,16],["καθιεῖται",274,89],["Δαρείου",1053,21],["διὰ",56,1],["τὴν",1,9],["σοφίαν",242,10],["αὐτοῦ",3,48],["καὶ",2,8],["συγγενὴς",1741,16],["Δαρείου",1053,21],["κληθήσεται",128,125]],"and he shall sit next to Darius because of his wisdom, and shall be called Darius's cousin."],["8",[["Καὶ",2,8],["τότε",250,17],["γράψαντες",186,190],["ἕκαστος",171,16],["τὸν",1,6],["ἑαυτοῦ",92,48],["λόγον",48,7],["ἐσφαγίσαντο",0,0],["καὶ",2,8],["ἔθηκαν",110,141],["ὑπὸ",122,1],["τὸ",1,32],["προσκεφάλαιον",5011,33],["Δαρείου",1053,21],["τοῦ",1,30],["βασιλέως",22,21]],"And then every one wrote his sentence, sealed it, and laid it under the pillow of king Darius;"],["9",[["καὶ",2,8],["εἶπαν",18,141],["ὅταν",319,8],["ἐγερθῇ",746,333],["ὁ",1,4],["βασιλεὺς",22,5],["δώσουσιν",33,207],["αὐτῷ",3,49],["τὸ",1,32],["γράμμα",1668,33],["καὶ",2,8],["ὃν",24,467],["ἂν",83,12],["κρίνῃ",263,173],["ὁ",1,4],["βασιλεὺς",22,5],["καὶ",2,8],["οἱ",1,128],["τρεῖς",174,130],["μεγιστᾶνες",1825,51],["τῆς",1,18],["Περσίδος",2159,19],["ὅτι",19,8],["οὗ",120,17],["ὁ",1,4],["λόγος",48,5],["αὐτοῦ",3,48],["σοφώτερος",324,16],["αὐτῷ",3,49],["δοθήσεται",33,125],["τὸ",1,32],["νῖκος",2100,33],["καθὼς",221,17],["γέγραπται",186,182]],"and said that, when the king is risen, [some] will give him the writing; and of whose side the king and the three princes of Persia shall judge that his sentence is the wisest, to him shall the victory be given, as was appointed."],["10",[["Ὁ",1,4],["εἷς",58,16],["ἔγραψεν",186,3],["ὑπερισχύει",2237,87],["ὁ",1,4],["οἶνος",261,5]],"The first wrote, Wine is the strongest."],["11",[["Ὁ",1,4],["ἕτερος",253,16],["ἔγραψεν",186,3],["ὑπερισχύει",2237,87],["ὁ",1,4],["βασιλεύς",22,5]],"The second wrote, The king is strongest."],["12",[["Ὁ",1,4],["τρίτος",357,16],["ἔγραψεν",186,3],["ὑπερισχύουσιν",2237,191],["αἱ",1,185],["γυναῖκες",59,180],["ὑπὲρ",139,1],["δὲ",14,12],["πάντα",11,65],["νικᾷ",1441,173],["ἡ",1,11],["ἀλήθεια",352,13]],"The third wrote, Women are strongest: but above all things Truth beareth away the victory."],["13",[["Καὶ",2,8],["ὅτε",432,8],["ἐξηγέρθη",656,38],["ὁ",1,4],["βασιλεὺς",22,5],["λαβόντες",46,190],["τὸ",1,32],["γράμμα",1668,33],["ἔδωκαν",33,141],["αὐτῷ",3,49],["καὶ",2,8],["ἀνέγνω",795,3]],"Now when the king was risen up, they took their writings, and delivered [them] unto him, and [so] he read [them]:"],["14",[["Καὶ",2,8],["ἐξαποστείλας",220,155],["ἐκάλεσε",128,3],["πάντας",11,58],["τοὺς",1,56],["μεγιστᾶνας",1682,31],["τῆς",1,18],["Περσίδος",2159,19],["καὶ",2,8],["τῆς",1,18],["Μηδείας",4156,19],["καὶ",2,8],["τοὺς",1,56],["σατράπας",1333,31],["καὶ",2,8],["στρατηγοὺς",927,31],["καὶ",2,8],["τοπάρχας",2391,31],["καὶ",2,8],["ὑπάτους",4143,31]],"and sending forth he called all the princes of Persia and Media, and the governors, and the captains, and the lieutenants, and the chief officers;"],["15",[["καὶ",2,8],["ἐκάθισεν",274,3],["ἐν",4,1],["τῷ",1,52],["χρηματιστηρίῳ",8695,53],["καὶ",2,8],["ἀνεγνώσθη",795,38],["τὸ",1,32],["γράμμα",1668,33],["ἐνώπιον",115,1],["αὐτῶν",3,41]],"and sat him down in the royal seat of judgment; and the writing was read before them."],["16",[["Καὶ",2,8],["εἶπε",18,3],["καλέσατε",128,69],["τοὺς",1,56],["νεανίσκους",570,31],["καὶ",2,8],["αὐτοὶ",3,195],["δηλώσουσι",1670,207],["τοὺς",1,56],["λόγους",48,31],["ἑαυτῶν",92,41],["καὶ",2,8],["ἐκλήθησαν",128,94],["καὶ",2,8],["εἰσήλθοσαν",86,141]],"And he said, Call the young men, and they shall declare their own sentences. So they were called, and came in."],["17",[["Καὶ",2,8],["εἶπαν",18,141],["αὐτοῖς",3,142],["ἀπαγγείλατε",273,69],["ἡμῖν",6,142],["περὶ",72,1],["τῶν",1,76],["γεγραμμένων",186,412]],"And he said unto them, Declare unto us your mind concerning the writings.",{"s":"r"}],["18",[["Καὶ",2,8],["ἤρξατο",320,26],["ὁ",1,4],["πρῶτος",315,16],["ὁ",1,4],["εἴπας",18,155],["περὶ",72,1],["τῆς",1,18],["ἰσχύος",181,19],["τοῦ",1,30],["οἴνου",261,21],["καὶ",2,8],["ἔφη",660,14],["οὕτως",71,17],["ἄνδρες",38,51]],"Then began the first, who had spoken of the strength of wine; and he said thus, O ye men, how exceeding strong is wine! it causeth all men to err that drink it:",{"s":"r"}],["19",[["πῶς",441,12],["ὑπερισχύει",2237,87],["ὁ",1,4],["οἶνος",261,5],["πάντας",11,58],["τοὺς",1,56],["ἀνθρώπους",43,31],["τοὺς",1,56],["πιόντας",212,458],["αὐτὸν",3,82],["πλανᾷ",464,173],["τὴν",1,9],["διάνοιαν",755,10],["τοῦ",1,30],["τε",209,12],["βασιλέως",22,21],["καὶ",2,8],["τοῦ",1,30],["ὀρφανοῦ",957,153],["ποιεῖ",23,87],["τὴν",1,9],["διάνοιαν",755,10],["μίαν",58,37],["τήν",1,9],["τε",209,12],["τοῦ",1,30],["οἰκέτου",951,21],["καὶ",2,8],["τὴν",1,9],["τοῦ",1,30],["ἐλευθέρου",1456,153],["τήν",1,9],["τε",209,12],["τοῦ",1,30],["πένητος",672,21],["καὶ",2,8],["τὴν",1,9],["τοῦ",1,30],["πλουσίου",952,153]],"it maketh the mind of the king and of the fatherless child to be all one; of the bondman and of the freeman, of the poor man and of the rich:"],["20",[["καὶ",2,8],["πᾶσαν",11,37],["διάνοιαν",755,10],["μεταστρέφει",1635,87],["εἰς",8,1],["εὐωχίαν",2892,10],["καὶ",2,8],["εὐφροσύνην",360,10],["καὶ",2,8],["οὐ",12,17],["μέμνηται",230,182],["πᾶσαν",11,37],["λύπην",1075,10],["καὶ",2,8],["πᾶν",11,29],["ὀφείλημα",4642,33]],"it turneth also every thought into jollity and mirth, so that a man remembereth neither sorrow nor debt:"],["21",[["καὶ",2,8],["πάσας",11,109],["καρδίας",64,19],["ποιεῖ",23,87],["πλουσιας",0,0],["καὶ",2,8],["οὐ",12,17],["μέμνηται",230,182],["βασιλέα",22,7],["οὐδὲ",106,12],["σατράπην",1333,7],["καὶ",2,8],["πάντα",11,59],["διὰ",56,1],["ταλάντων",710,45],["ποιεῖ",23,87],["λαλεῖν",50,54]],"and it maketh every heart rich, so that a man remembereth neither king nor governor; and it maketh to speak all things by talents:"],["22",[["Καὶ",2,8],["οὐ",12,17],["μέμνηνται",230,254],["ὅταν",319,8],["πίνωσι",212,265],["φιλιάζειν",3986,54],["φίλοις",336,215],["καὶ",2,8],["ἀδελφοῖς",67,139],["καὶ",2,8],["μετʼ",29,1],["οὐ",12,17],["πολὺ",74,29],["σπῶνται",1691,299],["τὰς",1,39],["μαχαίρας",342,40]],"and when they are in their cups, they forget their love both to friends and brethren, and a little after draw out swords:"],["23",[["Καὶ",2,8],["ὅταν",319,8],["ἀπὸ",17,1],["τοῦ",1,30],["οἴνου",261,21],["ἐγερθῶσιν",746,266],["οὐ",12,17],["μέμνηνται",230,254],["ἃ",1,11],["ἔπραξαν",1251,141]],"but when they are from the wine, they remember not what they have done."],["24",[["Ὦ",646,316],["ἄνδρες",38,51],["οὐχ",12,17],["ὑπερισχύει",2237,87],["ὁ",1,4],["οἶνος",261,5],["ὅτι",19,8],["οὕτως",71,17],["ἀναγκάζει",1847,87],["ποιεῖν",23,54],["καὶ",2,8],["ἐσίγησεν",1915,3],["οὕτως",71,17],["εἴπας",18,155]],"O ye men, is not wine the strongest, that enforceth to do thus? And when he had so spoken, he held his peace."]]