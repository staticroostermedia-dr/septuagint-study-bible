],["ὃν",24,475],["ἂν",82,12],["κρίνῃ",240,172],["ὁ",1,4],["βασιλεὺς",22,5],["καὶ",2,8],["οἱ",1,128],["τρεῖς",173,130],["μεγιστᾶνες",1827,51],["τῆς",1,18],["Περσίδος",2168,19],["ὅτι",19,8],["οὗ",120,17],["ὁ",1,4],["λόγος",48,5],["αὐτοῦ",3,48],["σοφώτερος",322,16],["αὐτῷ",3,49],["δοθήσεται",33,125],["τὸ",1,32],["νῖκος",2107,33],["καθὼς",218,17],["γέγραπται",186,372]],"and said that, when the king is risen, [some] will give him the writing; and of whose side the king and the three princes of Persia shall judge that his sentence is the wisest, to him shall the victory be given, as was appointed."],["10",[["Ὁ",1,4],["εἷς",57,16],["ἔγραψεν",186,3],["ὑπερισχύει",2251,87],["ὁ",1,4],["οἶνος",261,5]],"The first wrote, Wine is the strongest."],["11",[["Ὁ",1,4],["ἕτερος",253,16],["ἔγραψεν",186,3],["ὑπερισχύει",2251,87],["ὁ",1,4],["βασιλεύς",22,5]],"The second wrote, The king is strongest."],["12",[["Ὁ",1,4],["τρίτος",356,16],["ἔγραψεν",186,3],["ὑπερισχύουσιν",2251,189],["αἱ",1,183],["γυναῖκες",58,179],["ὑπὲρ",139,1],["δὲ",14,12],["πάντα",11,65],["νικᾷ",1442,172],["ἡ",1,11],["ἀλήθεια",350,13]],"The third wrote, Women are strongest: but above all things Truth beareth away the victory."],["13",[["Καὶ",2,8],["ὅτε",430,8],["ἐξηγέρθη",650,38],["ὁ",1,4],["βασιλεὺς",22,5],["λαβόντες",46,188],["τὸ",1,32],["γράμμα",1670,33],["ἔδωκαν",33,141],["αὐτῷ",3,49],["καὶ",2,8],["ἀνέγνω",792,3]],"Now when the king was risen up, they took their writings, and delivered [them] unto him, and [so] he read [them]:"],["14",[["Καὶ",2,8],["ἐξαποστείλας",217,155],["ἐκάλεσε",128,3],["πάντας",11,58],["τοὺς",1,56],["μεγιστᾶνας",1684,31],["τῆς",1,18],["Περσίδος",2168,19],["καὶ",2,8],["τῆς",1,18],["Μηδείας",4168,19],["καὶ",2,8],["τοὺς",1,56],["σατράπας",1332,31],["καὶ",2,8],["στρατηγοὺς",926,31],["καὶ",2,8],["τοπάρχας",2400,31],["καὶ",2,8],["ὑπάτους",4154,31]],"and sending forth he called all the princes of Persia and Media, and the governors, and the captains, and the lieutenants, and the chief officers;"],["15",[["καὶ",2,8],["ἐκάθισεν",273,3],["ἐν",4,1],["τῷ",1,52],["χρηματιστηρίῳ",8755,53],["καὶ",2,8],["ἀνεγνώσθη",792,38],["τὸ",1,32],["γράμμα",1670,33],["ἐνώπιον",114,1],["αὐτῶν",3,41]],"and sat him down in the royal seat of judgment; and the writing was read before them."],["16",[["Καὶ",2,8],["εἶπε",18,3],["καλέσατε",128,69],["τοὺς",1,56],["νεανίσκους",568,31],["καὶ",2,8],["αὐτοὶ",3,193],["δηλώσουσι",1719,207],["τοὺς",1,56],["λόγους",48,31],["ἑαυτῶν",92,41],["καὶ",2,8],["ἐκλήθησαν",128,94],["καὶ",2,8],["εἰσήλθοσαν",0,0]],"And he said, Call the young men, and they shall declare their own sentences. So they were called, and came in."],["17",[["Καὶ",2,8],["εἶπαν",18,221],["αὐτοῖς",3,142],["ἀπαγγείλατε",272,69],["ἡμῖν",6,142],["περὶ",71,1],["τῶν",1,76],["γεγραμμένων",186,457]],"And he said unto them, Declare unto us your mind concerning the writings. Then began the first, who had spoken of the strength of wine;"],["18",[["Καὶ",2,8],["ἤρξατο",319,26],["ὁ",1,4],["πρῶτος",314,16],["ὁ",1,4],["εἴπας",18,155],["περὶ",71,1],["τῆς",1,18],["ἰσχύος",180,19],["τοῦ",1,30],["οἴνου",261,21],["καὶ",2,8],["ἔφη",655,14],["οὕτως",70,17],["ἄνδρες",38,51]],"and he said thus, O ye men, how exceeding strong is wine! it causeth all men to err that drink it:"],["19",[["πῶς",440,12],["ὑπερισχύει",2251,87],["ὁ",1,4],["οἶνος",261,5],["πάντας",11,58],["τοὺς",1,56],["ἀνθρώπους",43,31],["τοὺς",1,56],["πιόντας",215,466],["αὐτὸν",3,82],["πλανᾷ",464,172],["τὴν",1,9],["διάνοιαν",754,10],["τοῦ",1,30],["τε",207,12],["βασιλέως",22,21],["καὶ",2,8],["τοῦ",1,30],["ὀρφανοῦ",959,153],["ποιεῖ",23,87],["τὴν",1,9],["διάνοιαν",754,10],["μίαν",57,37],["τήν",1,9],["τε",207,12],["τοῦ",1,30],["οἰκέτου",952,21],["καὶ",2,8],["τὴν",1,9],["τοῦ",1,30],["ἐλευθέρου",1456,153],["τήν",1,9],["τε",207,12],["τοῦ",1,30],["πένητος",668,21],["καὶ",2,8],["τὴν",1,9],["τοῦ",1,30],["πλουσίου",954,153]],"it maketh the mind of the king and of the fatherless child to be all one; of the bondman and of the freeman, of the poor man and of the rich:"],["20",[["καὶ",2,8],["πᾶσαν",11,37],["διάνοιαν",754,10],["μεταστρέφει",1635,87],["εἰς",8,1],["εὐωχίαν",2906,10],["καὶ",2,8],["εὐφροσύνην",360,10],["καὶ",2,8],["οὐ",12,17],["μέμνηται",231,372],["πᾶσαν",11,37],["λύπην",1076,10],["καὶ",2,8],["πᾶν",11,29],["ὀφείλημα",4667,33]],"it turneth also every thought into jollity and mirth, so that a man remembereth neither sorrow nor debt:"],["21",[["καὶ",2,8],["πάσας",11,109],["καρδίας",63,19],["ποιεῖ",23,87],["πλουσιας",0,0],["καὶ",2,8],["οὐ",12,17],["μέμνηται",231,372],["βασιλέα",22,7],["οὐδὲ",105,12],["σατράπην",1332,7],["καὶ",2,8],["πάντα",11,59],["διὰ",54,1],["ταλάντων",711,45],["ποιεῖ",23,87],["λαλεῖν",50,54]],"and it maketh every heart rich, so that a man remembereth neither king nor governor; and it maketh to speak all things by talents:"],["22",[["Καὶ",2,8],["οὐ",12,17],["μέμνηνται",231,354],["ὅταν",318,8],["πίνωσι",215,266],["φιλιάζειν",3995,54],["φίλοις",334,215],["καὶ",2,8],["ἀδελφοῖς",66,139],["καὶ",2,8],["μετʼ",29,1],["οὐ",12,17],["πολὺ",74,29],["σπῶνται",1694,303],["τὰς",1,39],["μαχαίρας",341,40]],"and when they are in their cups, they forget their love both to friends and brethren, and a little after draw out swords:"],["23",[["Καὶ",2,8],["ὅταν",318,8],["ἀπὸ",17,1],["τοῦ",1,30],["οἴνου",261,21],["ἐγερθῶσιν",745,267],["οὐ",12,17],["μέμνηνται",231,354],["ἃ",1,11],["ἔπραξαν",1252,141]],"but when they are from the wine, they remember not what they have done."],["24",[["Ὦ",641,320],["ἄνδρες",38,51],["οὐχ",12,17],["ὑπερισχύει",2251,87],["ὁ",1,4],["οἶνος",261,5],["ὅτι",19,8],["οὕτως",70,17],["ἀναγκάζει",1927,87],["ποιεῖν",23,54],["καὶ",2,8],["ἐσίγησεν",1915,3],["οὕτως",70,17],["εἴπας",18,155]],"O ye men, is not wine the strongest, that enforceth to do thus? And when he had so spoken, he held his peace."]]