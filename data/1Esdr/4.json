"ἐγέννησαν",222,141],["τὸν",1,6],["βασιλέα",22,7],["καὶ",2,8],["πάντα",11,59],["τὸν",1,6],["λαὸν",35,7],["ὃς",24,246],["κυριεύει",885,87],["τῆς",1,18],["θαλάσσης",137,19],["καὶ",2,8],["τῆς",1,18],["γῆς",26,19]],"Women have borne the king and all the people that bear rule by sea and land."],["16",[["καὶ",2,8],["ἐξ",21,1],["αὐτῶν",3,41],["ἐγένοντο",30,184],["καὶ",2,8],["αὗται",16,196],["ἐξέθρεψαν",1573,141],["αὐτοὺς",3,60],["τοὺς",1,56],["φυτεύσαντας",1022,458],["τοὺς",1,56],["ἀμπελῶνας",607,31],["ἐξ",21,1],["ὧν",24,97],["ὁ",1,4],["οἶνος",261,5],["γίνεται",30,108]],"Even of them came they: and they nourished them up that planted the vineyards, from whence the wine cometh."],["17",[["Καὶ",2,8],["αὗται",16,196],["ποιοῦσι",23,191],["τὰς",1,39],["στολὰς",560,40],["τῶν",1,76],["ἀνθρώπων",43,77],["καὶ",2,8],["αὗται",16,196],["ποιοῦσι",23,352],["δόξαν",141,10],["τοῖς",1,138],["ἀνθρώποις",43,139],["καὶ",2,8],["οὐ",12,17],["δύνανται",185,299],["οἱ",1,128],["ἄνθρωποι",43,51],["χωρὶς",2046,17],["τῶν",1,123],["γυναικῶν",59,61],["εἶναι",10,54]],"These also make garments for men; these bring glory unto men; and without women cannot men be."],["18",[["Ἐὰν",45,8],["δὲ",14,12],["συναγάγωσι",166,224],["χρυσίον",202,20],["καὶ",2,8],["ἀργύριον",152,20],["καὶ",2,8],["πᾶν",11,28],["πρᾶγμα",511,20],["ὡραῖον",1296,28],["καὶ",2,8],["ἴδωσι",53,224],["γυναῖκα",59,10],["μίαν",58,37],["καλὴν",266,37],["τῷ",1,52],["εἴδει",949,53],["καὶ",2,8],["τῷ",1,52],["κάλλει",886,53]],"Yea, and if men have gathered together gold and silver, or any other goodly thing, do they not love a woman which is comely in favour and beauty?"],["19",[["ταῦτα",16,248],["πάντα",11,65],["ἀφέντες",501,190],["εἰς",8,1],["αὐτὴν",3,98],["ἐκκέχῃναν",0,0],["καὶ",2,8],["χάσκοντες",4463,137],["τὸ",1,32],["στόμα",123,33],["θεωροῦσιν",897,191],["αὐτὴν",3,98],["καὶ",2,8],["πάντες",11,130],["αὐτὴν",3,98],["αἱρετίζουσι",1618,191],["μᾶλλον",1043,17],["ἢ",61,8],["τὸ",1,32],["χρυσίον",202,33],["καὶ",2,8],["τὸ",1,32],["ἀργύριον",152,33],["καὶ",2,8],["πᾶν",11,29],["πρᾶγμα",511,33],["ὡραῖον",1296,29]],"And letting all those things go, do they not gape, and even with open mouth fix their eyes fast on her; and have not all men more desire unto her than unto silver or gold, or any goodly thing whatsoever?"],["20",[["Ἄνθρωπος",43,5],["τὸν",1,6],["ἑαυτοῦ",92,48],["πατέρα",44,7],["ἐγκαταλείπει",364,87],["ὃς",24,246],["ἐξέθρεψεν",1573,3],["αὐτὸν",3,82],["καὶ",2,8],["τὴν",1,9],["ἰδίαν",683,37],["χώραν",278,10],["καὶ",2,8],["πρὸς",15,1],["τὴν",1,9],["ἰδίαν",683,37],["γυναῖκα",59,10],["κολλᾶται",1246,108]],"A man leaveth his own father that brought him up, and his own country, and cleaveth unto his wife."],["21",[["καὶ",2,8],["μετὰ",29,1],["τῆς",1,18],["γυναικὸς",59,19],["ἀφίησι",501,87],["τὴν",1,9],["ψυχήν",63,10],["καὶ",2,8],["οὔτε",477,17],["τὸν",1,6],["πατέρα",44,7],["μέμνηται",230,182],["οὔτε",477,17],["τὴν",1,9],["μητέρα",189,10],["οὔτε",477,17],["τὴν",1,9],["χώραν",278,10]],"He sticketh not to spend his life with his wife, and remembereth neither father, nor mother, nor country."],["22",[["Καὶ",2,8],["ἐντεῦθεν",1458,17],["δεῖ",1158,14],["ὑμᾶς",5,209],["γνῶναι",79,100],["ὅτι",19,8],["αἱ",1,185],["γυναῖκες",59,180],["κυριεύουσιν",885,191],["ὑμῶν",5,136],["οὐχὶ",330,12],["πονεῖτε",1911,84],["καὶ",2,8],["μοχθεῖτε",2178,84],["καὶ",2,8],["πάντα",11,65],["ταῖς",1,70],["γυναιξὶ",59,71],["δίδοτε",33,307],["καὶ",2,8],["φέρετε",199,307]],"By this also ye must know that women have dominion over you: do ye not labour and toil, and give and bring all to the woman?"],["23",[["Και",2,8],["λαμβάνει",46,87],["ὁ",1,4],["ἄνθρωπος",43,5],["τὴν",1,9],["ῥομφαίαν",248,10],["αὐτοῦ",3,48],["καὶ",2,8],["ἐκπορεύεται",365,108],["ἐξοδεύειν",4591,54],["καὶ",2,8],["λῃστεύειν",7611,54],["καὶ",2,8],["κλέπτειν",1245,54],["καὶ",2,8],["εἰς",8,1],["τὴν",1,9],["θάλασσαν",137,10],["πλεῖν",2945,54],["καὶ",2,8],["ποταμοὺς",249,31]],"Yea, a man taketh his sword, and goeth his way to rob and to steal, to sail upon the sea and upon rivers;"],["24",[["κ