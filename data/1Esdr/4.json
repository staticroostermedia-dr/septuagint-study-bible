[["1",[["Καὶ",2,8],["ἤρξατο",320,26],["ὁ",1,4],["δεύτερος",271,16],["λαλεῖν",50,54],["ὁ",1,4],["εἴπας",18,155],["περὶ",72,1],["τῆς",1,18],["ἰσχύος",181,19],["τοῦ",1,30],["βασιλέως",22,21]],"Then the second, that had spoken of the strength of the king, began to say,"],["2",[["Ὦ",646,316],["ἄνδρες",38,51],["οὐχ",12,17],["ὑπερισχύουσιν",2237,191],["οἱ",1,128],["ἄνθρωποι",43,51],["τὴν",1,9],["γῆν",26,10],["καὶ",2,8],["τὴν",1,9],["θάλασσαν",137,10],["κατακρατοῦντες",1412,137],["καὶ",2,8],["πάντα",11,65],["τὰ",1,42],["ἐν",4,1],["αὐτοῖς",3,142]],"O ye men, do not men excel in strength, that bear rule over sea and land, and all things in them?"],["3",[["Ὁ",1,4],["δὲ",14,12],["βασιλεὺς",22,5],["ὑπερισχύει",2237,87],["καὶ",2,8],["κυριεύει",885,87],["αὐτῶν",3,41],["καὶ",2,8],["δεσπόζει",2014,87],["αὐτῶν",3,41],["καὶ",2,8],["πᾶν",11,29],["ὃ",1,4],["ἐὰν",45,8],["εἴπῃ",18,160],["αὐτοῖς",3,142],["ἐνακούουσιν",5302,352]],"But yet the king is more mighty: for he is lord of all these things, and hath dominion over them; and whatsoever he commandeth them they do."],["4",[["Ἐὰν",45,8],["εἴπῃ",18,160],["αὐτοῖς",3,142],["ποιῆσαι",23,100],["πόλεμον",163,7],["ἕτερος",253,16],["πρὸς",15,1],["τὸν",1,6],["ἕτερον",253,59],["ποιοῦσιν",23,191],["ἐὰν",45,8],["δὲ",14,12],["ἐξαποστείλῃ",220,160],["αὐτοὺς",3,60],["πρὸς",15,1],["τοὺς",1,56],["πολεμίους",1122,58],["βαδίζουσι",858,191],["καὶ",2,8],["κατεργάζονται",3067,299],["τὰ",1,42],["ὄρη",87,43],["καὶ",2,8],["τὰ",1,42],["τείχη",325,43],["καὶ",2,8],["τοὺς",1,56],["πύργους",708,31]],"If he bid them make war the one against the other, they do it: if he send them out against the enemies, they go, and break down mountains, walls, and towers."],["5",[["φονεύουσι",970,191],["καὶ",2,8],["φονεύονται",970,299],["καὶ",2,8],["τὸν",1,6],["λόγον",48,7],["τοῦ",1,30],["βασιλέως",22,21],["οὐ",12,17],["παραβαίνουσιν",788,191],["ἐὰν",45,8],["δὲ",14,12],["νικήσωσι",1441,224],["τῷ",1,110],["βασιλεῖ",22,113],["κομίζουσι",1592,191],["πάντα",11,65],["καὶ",2,8],["ἐὰν",45,8],["προνομεύσωσι",1145,224],["καὶ",2,8],["τὰ",1,42],["ἄλλα",584,66],["πάντα",11,65]],"They slay and are slain, and transgress not the king's commandment: if they get the victory, they bring all to the king, as well the spoil, as all things else."],["6",[["Καὶ",2,8],["ὅσοι",103,51],["οὐ",12,17],["στρατεύονται",3641,299],["οὐδὲ",106,12],["πολεμοῦσιν",305,352],["ἀλλὰ",108,17],["γεωργοῦσι",4721,352],["τὴν",1,9],["γῆν",26,10],["πάλιν",655,17],["ὅταν",319,8],["σπείρωσι",793,224],["θερίσαντε",1509,597],["ἀναφέρουσι",384,191],["τῷ",1,110],["βασιλεῖ",22,113],["καὶ",2,8],["ἕτερος",253,16],["τὸν",1,6],["ἕτερον",253,59],["ἀναγκάζοντες",1847,137],["ἀναφέρουσι",384,191],["τοὺς",1,56],["φόρους",1124,31],["τῷ",1,110],["βασιλεῖ",22,113]],"Likewise for those that are no soldiers, and have not to do with wars, but use husbandry, when they have reaped again that which they had sown, they bring it to the king, and compel one another to pay tribute unto the king."],["7",[["Καὶ",2,8],["αὐτὸς",3,158],["εἷς",58,16],["μόνος",302,16],["ἐστίν",10,87],["ἐὰν",45,8],["εἴπῃ",18,160],["ἀποκτεῖναι",300,100],["ἀποκτέννουσιν",0,0],["ἐὰν",45,8],["εἴπῃ",18,160],["ἀφεῖναι",501,100],["ἀφίουσιν",501,191]],"And yet he is but one man: if he command to kill, they kill; if he command to spare, they spare;"],["8",[["Εἶπε",18,3],["πατάξαι",145,100],["τύπτουσιν",1209,191],["εἶπεν",18,3],["ἐρημῶσαι",740,100],["ἐρημοῦσιν",740,191],["εἶπεν",18,3],["οἰκοδομῆσαι",126,100],["οἰκοδομοῦσιν",126,191]],"if he command to smite, they smite; if he command to make desolate, they make desolate; if he command to build, they build;"],["9",[["εἶπεν",18,3],["ἐκκόψαι",1193,100],["ἐκκόπτουσιν",1193,191],["εἶπε",18,3],["φυτεῦσαι",1022,100],["φυτεύουσι",1022,191]],"if he command to cut down, they cut down; if he command to plant, they plant."],["10",[["Καὶ",2,8],["πᾶς",11,16],["ὁ",1,4],["λαὸς",35,5],["αὐτοῦ",3,48],["καὶ",2,8],["αἱ",1,185],["δυνάμεις",98,180],["αὐτοῦ",3,48],["ἐνακούουσι",5302,191],["πρὸς",15,1],["δὲ",14,12],["τούτοις",1