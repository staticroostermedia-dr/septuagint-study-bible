[["1",[["Ἔλεγεν",31,14],["δὲ",14,8],["καὶ",2,8],["πρὸς",15,1],["τοὺς",1,56],["μαθητάς",10025,31],["ἄνθρωπός",43,5],["τις",39,150],["ἦν",10,14],["πλούσιος",952,16],["ὃς",24,246],["εἶχεν",124,14],["οἰκονόμον",2182,7],["καὶ",2,8],["οὗτος",16,112],["διεβλήθη",3808,38],["αὐτῷ",3,49],["ὡς",36,12],["διασκορπίζων",1001,67],["τὰ",1,42],["ὑπάρχοντα",418,232],["αὐτοῦ",3,48]],"He also said to his disciples, “There was a certain rich man who had a manager. An accusation was made to him that this man was wasting his possessions."],["2",[["καὶ",2,8],["φωνήσας",1745,155],["αὐτὸν",3,82],["εἶπεν",31,3],["αὐτῷ",3,49],["τί",10010,119],["τοῦτο",16,122],["ἀκούω",54,149],["περὶ",72,1],["σοῦ",5,146],["ἀπόδος",312,198],["τὸν",1,6],["λόγον",48,7],["τῆς",1,18],["οἰκονομίας",5872,19],["σου",5,146],["οὐ",12,12],["γὰρ",40,8],["δύνῃ",185,730],["ἔτι",111,17],["οἰκονομεῖν",4937,54]],"He called him, and said to him, ‘What is this that I hear about you? Give an accounting of your management, for you can no longer be manager.’"],["3",[["εἶπεν",31,3],["δὲ",14,8],["ἐν",4,1],["ἑαυτῷ",92,49],["ὁ",1,4],["οἰκονόμος",2182,5],["τί",10010,119],["ποιήσω",23,227],["ὅτι",19,8],["ὁ",1,4],["κύριός",7,5],["μου",9994,146],["ἀφαιρεῖται",369,506],["τὴν",1,9],["οἰκονομίαν",5872,10],["ἀπ᾽",17,1],["ἐμοῦ",6,88],["σκάπτειν",8253,54],["οὐκ",12,12],["ἰσχύω",567,149],["ἐπαιτεῖν",6487,54],["αἰσχύνομαι",611,700]],"“The manager said within himself, ‘What will I do, seeing that my lord is taking away the management position from me? I don’t have strength to dig. I am ashamed to beg."],["4",[["ἔγνων",79,147],["τί",10010,119],["ποιήσω",23,227],["ἵνα",102,8],["ὅταν",319,8],["μετασταθῶ",1519,555],["ἐκ",21,1],["τῆς",1,18],["οἰκονομίας",5872,19],["δέξωνταί",815,733],["με",9994,161],["εἰς",8,1],["τοὺς",1,56],["οἴκους",34,31],["αὐτῶν",3,41]],"I know what I will do, so that when I am removed from management, they may receive me into their houses.’"],["5",[["καὶ",2,8],["προσκαλεσάμενος",1595,770],["ἕνα",58,59],["ἕκαστον",171,59],["τῶν",1,76],["χρεοφειλετῶν",6208,77],["τοῦ",1,30],["κυρίου",7,21],["ἑαυτοῦ",92,48],["ἔλεγεν",31,14],["τῷ",1,110],["πρώτῳ",315,111],["πόσον",2486,119],["ὀφείλεις",2150,145],["τῷ",1,110],["κυρίῳ",7,113],["μου",9994,146]],"Calling each one of his lord’s debtors to him, he said to the first, ‘How much do you owe to my lord?’"],["6",[["ὁ",1,4],["δὲ",14,8],["εἶπεν",31,3],["ἑκατὸν",243,372],["βάτους",10394,31],["ἐλαίου",313,24],["ὁ",1,4],["δὲ",14,8],["εἶπεν",31,3],["αὐτῷ",3,49],["δέξαι",815,751],["σου",5,146],["τὰ",1,42],["γράμματα",1668,43],["καὶ",2,8],["καθίσας",274,155],["ταχέως",1563,17],["γράψον",186,198],["πεντήκοντα",453,372]],"He said, ‘A hundred batos of oil.’ He said to him, ‘Take your bill, and sit down quickly and write fifty.’"],["7",[["ἔπειτα",6560,17],["ἑτέρῳ",253,111],["εἶπεν",31,3],["σὺ",5,156],["δὲ",14,8],["πόσον",2486,119],["ὀφείλεις",2150,145],["ὁ",1,4],["δὲ",14,8],["εἶπεν",31,3],["ἑκατὸν",243,372],["κόρους",874,31],["σίτου",665,21],["λέγει",31,87],["αὐτῷ",3,49],["δέξαι",815,751],["σου",5,146],["τὰ",1,42],["γράμματα",1668,43],["καὶ",2,8],["γράψον",186,198],["ὀγδοήκοντα",1433,372]],"Then he said to another, ‘How much do you owe?’ He said, ‘A hundred cors of wheat.’ He said to him, ‘Take your bill, and write eighty.’"],["8",[["καὶ",2,8],["ἐπῄνεσεν",1534,3],["ὁ",1,4],["κύριος",7,5],["τὸν",1,6],["οἰκονόμον",2182,7],["τῆς",1,18],["ἀδικίας",288,19],["ὅτι",19,8],["φρονίμως",10395,17],["ἐποίησεν",23,3],["ὅτι",19,8],["οἱ",1,128],["υἱοὶ",13,51],["τοῦ",1,30],["αἰῶνος",100,21],["τούτου",16,126],["φρονιμώτεροι",1211,130],["ὑπὲρ",139,1],["τοὺς",1,56],["υἱοὺς",13,31],["τοῦ",1,23],["φωτὸς",380,24],["εἰς",8,1],["τὴν",1,9],["γενεὰν",286,10],["τὴν",1,9],["ἑαυτῶν",92,41],["εἰσιν",10,191]],"“His lord commended the dishonest manager because he had done wisely, for the children of this world are, in their own generation, wiser than the children of the light."],["9",[["καὶ",2,8],["ἐγὼ",6,156],["ὑμῖν",5,86],["λέγω",31,149],["ἑαυτοῖς",92,142],["ποιήσατε",23,69],["φίλους",336,58],["ἐκ",21,1],["τοῦ",1,30],["μαμωνᾶ",10048,21],["τῆς",1,18],["ἀδικίας",288,19],["ἵνα",102,8],["ὅταν",319,8],["ἐκλίπῃ",321,160],["δέξωνται",815,733],["ὑμᾶς",5,209],["εἰς",8,1],["τὰς",1,39],["αἰωνίους",391,109],["σκηνάς",131,40]],"I tell you, make for yourselves friends by means of unrighteous mammon, so that when you fail, they may receive you into the eternal tents."],["10",[["Ὁ",1,4],["πιστὸς",750,16],["ἐν",4,1],["ἐλαχίστῳ",2418,34],["καὶ",2,8],["ἐν",4,1],["πολλῷ",74,34],["πιστός",750,16],["ἐστιν",10,87],["καὶ",2,8],["ὁ",1,4],["ἐν",4,1],["ἐλαχίστῳ",2418,34],["ἄδικος",406,16],["καὶ",2,8],["ἐν",4,1],["πολλῷ",74,34],["ἄδικός",406,16],["ἐστιν",10,87]],"He who is faithful in a very little is faithful also in much. He who is dishonest in a very little is also dishonest in much."],["11",[["εἰ",77,8],["οὖν",227,8],["ἐν",4,1],["τῷ",1,110],["ἀδίκῳ",406,111],["μαμωνᾷ",10048,113],["πιστοὶ",750,130],["οὐκ",12,12],["ἐγένεσθε",30,779],["τὸ",1,32],["ἀληθινὸν",1023,29],["τίς",10010,150],["ὑμῖν",5,86],["πιστεύσει",649,120]],"If therefore you have not been faithful in the unrighteous mammon, who will commit to your trust the true riches?"],["12",[["καὶ",2,8],["εἰ",77,8],["ἐν",4,1],["τῷ",1,52],["ἀλλοτρίῳ",381,34],["πιστοὶ",750,130],["οὐκ",12,12],["ἐγένεσθε",30,779],["τὸ",1,32],["ὑμέτερον",10347,29],["τίς",10010,150],["ὑμῖν",5,86],["δώσει",33,120]],"If you have not been faithful in that which is another’s, who will give you that which is your own?"],["13",[["Οὐδεὶς",228,16],["οἰκέτης",951,5],["δύναται",185,728],["δυσὶν",104,215],["κυρίοις",7,139],["δουλεύειν",398,54],["ἢ",61,8],["γὰρ",40,8],["τὸν",1,6],["ἕνα",58,59],["μισήσει",351,120],["καὶ",2,8],["τὸν",1,6],["ἕτερον",253,59],["ἀγαπήσει",214,120],["ἢ",61,8],["ἑνὸς",58,153],["ἀνθέξεται",1852,718],["καὶ",2,8],["τοῦ",1,30],["ἑτέρου",253,153],["καταφρονήσει",1677,120],["οὐ",12,12],["δύνασθε",185,754],["θεῷ",20,113],["δουλεύειν",398,54],["καὶ",2,8],["μαμωνᾷ",10048,113]],"No servant can serve two masters, for either he will hate the one and love the other; or else he will hold to one and despise the other. You aren’t able to serve God and Mammon.”"],["14",[["Ἤκουον",54,129],["δὲ",14,8],["ταῦτα",16,248],["πάντα",11,65],["οἱ",1,128],["Φαρισαῖοι",10006,51],["φιλάργυροι",8612,130],["ὑπάρχοντες",418,137],["καὶ",2,8],["ἐξεμυκτήριζον",5291,129],["αὐτόν",3,82]],"The Pharisees, who were lovers of money, also heard all these things, and they scoffed at him."],["15",[["καὶ",2,8],["εἶπεν",31,3],["αὐτοῖς",3,142],["ὑμεῖς",5,208],["ἐστε",10,84],["οἱ",1,128],["δικαιοῦντες",1115,137],["ἑαυτοὺς",92,60],["ἐνώπιον",115,1],["τῶν",1,76],["ἀνθρώπων",43,77],["ὁ",1,4],["δὲ",14,8],["θεὸς",20,5],["γινώσκει",79,87],["τὰς",1,39],["καρδίας",64,40],["ὑμῶν",5,136],["ὅτι",19,8],["τὸ",1,27],["ἐν",4,1],["ἀνθρώποις",43,139],["ὑψηλὸν",289,28],["βδέλυγμα",476,20],["ἐνώπιον",115,1],["τοῦ",1,30],["θεοῦ",20,21]],"He said to them, “You are those who justify yourselves in the sight of men, but God knows your hearts. For that which is exalted among men is an abomination in the sight of God."],["16",[["Ὁ",1,4],["νόμος",140,5],["καὶ",2,8],["οἱ",1,128],["προφῆται",176,51],["μέχρι",781,1],["Ἰωάννου",2148,21],["ἀπὸ",17,1],["τότε",250,17],["ἡ",1,11],["βασιλεία",157,13],["τοῦ",1,30],["θεοῦ",20,21],["εὐαγγελίζεται",1817,108],["καὶ",2,8],["πᾶς",11,16],["εἰς",8,1],["αὐτὴν",3,98],["βιάζεται",2249,108]],"“The law and the prophets were until John. From that time the Good News of God’s Kingdom is preached, and everyone is forcing his way into it."],["17",[["εὐκοπώτερον",10071,28],["δέ",14,8],["ἐστιν",10,87],["τὸν",1,6],["οὐρανὸν",94,7],["καὶ",2,8],["τὴν",1,9],["γῆν",26,10],["παρελθεῖν",404,100],["ἢ",61,8],["τοῦ",1,30],["νόμου",140,21],["μίαν",58,37],["κεραίαν",10032,10],["πεσεῖν",154,100]],"But it is easier for heaven and earth to pass away than for one tiny stroke of a pen in the law to fall."],["18",[["Πᾶς",11,16],["ὁ",1,4],["ἀπολύων",1395,67],["τὴν",1,9],["γυναῖκα",59,10],["αὐτοῦ",3,48],["καὶ",2,8],["γαμῶν",4178,67],["ἑτέραν",253,37],["μοιχεύει",2466,87],["καὶ",2,8],["ὁ",1,4],["ἀπολελυμένην",1604,540],["ἀπὸ",17,1],["ἀνδρὸς",38,21],["γαμῶν",4178,67],["μοιχεύει",2466,87]],"“Everyone who divorces his wife and marries another commits adultery. He who marries one who is divorced from a husband commits adultery."],["19",[["Ἄνθρωπος",43,5],["δέ",14,8],["τις",39,150],["ἦν",10,14],["πλούσιος",952,16],["καὶ",2,8],["ἐνεδιδύσκετο",4586,425],["πορφύραν",1062,10],["καὶ",2,8],["βύσσον",1181,10],["εὐφραινόμενος",244,714],["καθ᾽",32,1],["ἡμέραν",28,10],["λαμπρῶς",10396,17]],"“Now there was a certain rich man, and he was clothed in purple and fine linen, living in luxury every day."],["20",[["πτωχὸς",497,5],["δέ",14,8],["τις",39,150],["ὀνόματι",57,53],["Λάζαρος",10397,5],["ἐβέβλητο",766,758],["πρὸς",15,1],["τὸν",1,6],["πυλῶνα",1596,7],["αὐτοῦ",3,48],["εἱλκωμένος",10398,228]],"A certain beggar, named Lazarus, was taken to his gate, full of sores,"],["21",[["καὶ",2,8],["ἐπιθυμῶν",915,67],["χορτασθῆναι",2397,175],["ἀπὸ",17,1],["τῶν",1,44],["πιπτόντων",154,80],["ἀπὸ",17,1],["τῆς",1,18],["τραπέζης",650,19],["τοῦ",1,30],["πλουσίου",952,153],["ἀλλὰ",108,8],["καὶ",2,8],["οἱ",1,128],["κύνες",1204,51],["ἐρχόμενοι",55,741],["ἐπέλειχον",10399,129],["τὰ",1,42],["ἕλκη",3205,43],["αὐτοῦ",3,48]],"and desiring to be fed with the crumbs that fell from the rich man’s table. Yes, even the dogs came and licked his sores."],["22",[["Ἐγένετο",30,737],["δὲ",14,8],["ἀποθανεῖν",109,100],["τὸν",1,6],["πτωχὸν",497,7],["καὶ",2,8],["ἀπενεχθῆναι",1396,175],["αὐτὸν",3,82],["ὑπὸ",122,1],["τῶν",1,76],["ἀγγέλων",208,77],["εἰς",8,1],["τὸν",1,6],["κόλπον",1140,7],["Ἀβραάμ",294,21],["ἀπέθανεν",109,3],["δὲ",14,8],["καὶ",2,8],["ὁ",1,4],["πλούσιος",952,16],["καὶ",2,8],["ἐτάφη",392,38]],"The beggar died, and he was carried away by the angels to Abraham’s bosom. The rich man also died and was buried."],["23",[["καὶ",2,8],["ἐν",4,1],["τῷ",1,110],["ᾅδῃ",586,113],["ἐπάρας",661,155],["τοὺς",1,56],["ὀφθαλμοὺς",91,31],["αὐτοῦ",3,48],["ὑπάρχων",418,67],["ἐν",4,1],["βασάνοις",841,71],["ὁρᾷ",112,87],["Ἀβραὰμ",294,7],["ἀπὸ",17,1],["μακρόθεν",1249,17],["καὶ",2,8],["Λάζαρον",10397,7],["ἐν",4,1],["τοῖς",1,138],["κόλποις",1140,139],["αὐτοῦ",3,48]],"In Hades, he lifted up his eyes, being in torment, and saw Abraham far off, and Lazarus at his bosom."],["24",[["καὶ",2,8],["αὐτὸς",3,158],["φωνήσας",1745,155],["εἶπεν",31,3],["πάτερ",44,250],["Ἀβραάμ",294,250],["ἐλέησόν",10027,198],["με",9994,161],["καὶ",2,8],["πέμψον",1597,198],["Λάζαρον",10397,7],["ἵνα",102,8],["βάψῃ",1813,160],["τὸ",1,32],["ἄκρον",723,33],["τοῦ",1,30],["δακτύλου",1182,21],["αὐτοῦ",3,48],["ὕδατος",85,24],["καὶ",2,8],["καταψύξῃ",7413,160],["τὴν",1,9],["γλῶσσάν",388,10],["μου",9994,146],["ὅτι",19,8],["ὀδυνῶμαι",2844,700],["ἐν",4,1],["τῇ",1,95],["φλογὶ",983,2],["ταύτῃ",16,200]],"He cried and said, ‘Father Abraham, have mercy on me, and send Lazarus, that he may dip the tip of his finger in water and cool my tongue! For I am in anguish in this flame.’"],["25",[["Εἶπεν",31,3],["δὲ",14,8],["Ἀβραάμ",294,5],["τέκνον",192,764],["μνήσθητι",230,242],["ὅτι",19,8],["ἀπέλαβες",3704,154],["τὰ",1,42],["ἀγαθά",114,65],["σου",5,146],["ἐν",4,1],["τῇ",1,95],["ζωῇ",216,2],["σου",5,146],["καὶ",2,8],["Λάζαρος",10397,5],["ὁμοίως",1757,17],["τὰ",1,42],["κακά",161,65],["νῦν",90,17],["δὲ",14,8],["ὧδε",640,17],["παρακαλεῖται",434,449],["σὺ",5,156],["δὲ",14,8],["ὀδυνᾶσαι",2844,306]],"“But Abraham said, ‘Son, remember that you, in your lifetime, received your good things, and Lazarus, in the same way, bad things. But here he is now comforted and you are in anguish."],["26",[["καὶ",2,8],["ἐν",4,1],["πᾶσιν",11,90],["τούτοις",16,416],["μεταξὺ",3893,1],["ἡμῶν",9994,136],["καὶ",2,8],["ὑμῶν",5,136],["χάσμα",8710,20],["μέγα",66,28],["ἐστήρικται",979,722],["ὅπως",240,8],["οἱ",1,128],["θέλοντες",612,137],["διαβῆναι",466,100],["ἔνθεν",741,17],["πρὸς",15,1],["ὑμᾶς",5,209],["μὴ",25,12],["δύνωνται",185,849],["μηδὲ",414,8],["ἐκεῖθεν",430,17],["πρὸς",15,1],["ἡμᾶς",9994,209],["διαπερῶσιν",2880,265]],"Besides all this, between us and you there is a great gulf fixed, that those who want to pass from here to you are not able, and that no one may cross over from there to us.’"],["27",[["Εἶπεν",31,3],["δέ",14,8],["ἐρωτῶ",822,149],["σε",5,161],["οὖν",227,8],["πάτερ",44,250],["ἵνα",102,8],["πέμψῃς",1597,170],["αὐτὸν",3,82],["εἰς",8,1],["τὸν",1,6],["οἶκον",34,7],["τοῦ",1,30],["πατρός",44,21],["μου",9994,146]],"“He said, ‘I ask you therefore, father, that you would send him to my father’s house—"],["28",[["ἔχω",124,149],["γὰρ",40,8],["πέντε",280,372],["ἀδελφούς",67,31],["ὅπως",240,8],["διαμαρτύρηται",1585,782],["αὐτοῖς",3,142],["ἵνα",102,8],["μὴ",25,12],["καὶ",2,8],["αὐτοὶ",3,195],["ἔλθωσιν",55,224],["εἰς",8,1],["τὸν",1,6],["τόπον",99,7],["τοῦτον",16,259],["τῆς",1,18],["βασάνου",841,19]],"for I have five brothers—that he may testify to them, so they won’t also come into this place of torment.’"],["29",[["Λέγει",31,87],["δὲ",14,8],["Ἀβραάμ",294,5],["ἔχουσιν",124,191],["Μωϋσέα",5453,7],["καὶ",2,8],["τοὺς",1,56],["προφήτας",176,31],["ἀκουσάτωσαν",54,261],["αὐτῶν",3,41]],"“But Abraham said to him, ‘They have Moses and the prophets. Let them listen to them.’"],["30",[["ὁ",1,4],["δὲ",14,8],["εἶπεν",31,3],["οὐχί",330,12],["πάτερ",44,250],["Ἀβραάμ",294,250],["ἀλλ᾽",108,8],["ἐάν",45,8],["τις",39,150],["ἀπὸ",17,1],["νεκρῶν",659,163],["πορευθῇ",49,831],["πρὸς",15,1],["αὐτούς",3,60],["μετανοήσουσιν",1634,207]],"“He said, ‘No, father Abraham, but if one goes to them from the dead, they will repent.’"],["31",[["εἶπεν",31,3],["δὲ",14,8],["αὐτῷ",3,49],["εἰ",77,8],["Μωϋσέως",5453,21],["καὶ",2,8],["τῶν",1,76],["προφητῶν",176,77],["οὐκ",12,12],["ἀκούουσιν",54,191],["οὐδ᾽",106,8],["ἐάν",45,8],["τις",39,150],["ἐκ",21,1],["νεκρῶν",659,163],["ἀναστῇ",121,160],["πεισθήσονται",344,135]],"“He said to him, ‘If they don’t listen to Moses and the prophets, neither will they be persuaded if one rises from the dead.’”"]]