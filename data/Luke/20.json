[["1",[["Καὶ",2,8],["ἐγένετο",30,737],["ἐν",4,1],["μιᾷ",58,96],["τῶν",1,123],["ἡμερῶν",28,61],["διδάσκοντος",545,143],["αὐτοῦ",3,48],["τὸν",1,6],["λαὸν",35,7],["ἐν",4,1],["τῷ",1,52],["ἱερῷ",675,53],["καὶ",2,8],["εὐαγγελιζομένου",1817,585],["ἐπέστησαν",631,141],["οἱ",1,128],["ἀρχιερεῖς",1100,51],["καὶ",2,8],["οἱ",1,128],["γραμματεῖς",632,51],["σὺν",310,1],["τοῖς",1,138],["πρεσβυτέροις",332,139]],"On one of those days, as he was teaching the people in the temple and preaching the Good News, the priests and scribes came to him with the elders."],["2",[["καὶ",2,8],["εἶπαν",31,141],["λέγοντες",31,137],["πρὸς",15,1],["αὐτόν",3,82],["εἰπὸν",31,198],["ἡμῖν",9994,86],["ἐν",4,1],["ποίᾳ",1332,801],["ἐξουσίᾳ",929,2],["ταῦτα",16,248],["ποιεῖς",23,145],["ἢ",61,8],["τίς",10010,150],["ἐστιν",10,87],["ὁ",1,4],["δούς",33,155],["σοι",5,151],["τὴν",1,9],["ἐξουσίαν",929,10],["ταύτην",16,234]],"They asked him, “Tell us: by what authority do you do these things? Or who is giving you this authority?”"],["3",[["Ἀποκριθεὶς",234,731],["δὲ",14,8],["εἶπεν",31,3],["πρὸς",15,1],["αὐτούς",3,60],["ἐρωτήσω",822,157],["ὑμᾶς",5,209],["κἀγὼ",10000,8],["λόγον",48,7],["καὶ",2,8],["εἴπατέ",31,69],["μοι",9994,151]],"He answered them, “I also will ask you one question. Tell me:"],["4",[["τὸ",1,27],["βάπτισμα",10008,20],["Ἰωάννου",2148,21],["ἐξ",21,1],["οὐρανοῦ",94,21],["ἦν",10,14],["ἢ",61,8],["ἐξ",21,1],["ἀνθρώπων",43,77]],"the baptism of John, was it from heaven, or from men?”"],["5",[["οἱ",1,128],["δὲ",14,8],["συνελογίσαντο",3962,720],["πρὸς",15,1],["ἑαυτοὺς",92,60],["λέγοντες",31,137],["ὅτι",19,8],["ἐὰν",45,8],["εἴπωμεν",31,75],["ἐξ",21,1],["οὐρανοῦ",94,21],["ἐρεῖ",10054,120],["διὰ",56,1],["τί",10010,119],["οὐκ",12,12],["ἐπιστεύσατε",649,262],["αὐτῷ",3,49]],"They reasoned with themselves, saying, “If we say, ‘From heaven,’ he will say, ‘Why didn’t you believe him?’"],["6",[["ἐὰν",45,8],["δὲ",14,8],["εἴπωμεν",31,75],["ἐξ",21,1],["ἀνθρώπων",43,77],["ὁ",1,4],["λαὸς",35,5],["ἅπας",772,16],["καταλιθάσει",1041