07,164],["πάντες",11,130],["γὰρ",40,8],["αὐτῷ",3,49],["ζῶσιν",107,191]],"Now he is not the God of the dead, but of the living, for all are alive to him.”"],["39",[["Ἀποκριθέντες",234,724],["δέ",14,8],["τινες",39,402],["τῶν",1,76],["γραμματέων",632,77],["εἶπαν",31,141],["διδάσκαλε",7031,250],["καλῶς",1273,17],["εἶπας",31,154]],"Some of the scribes answered, “Teacher, you speak well.”"],["40",[["οὐκέτι",12,17],["γὰρ",40,8],["ἐτόλμων",3371,129],["ἐπερωτᾶν",739,54],["αὐτὸν",3,82],["οὐδέν",228,29]],"They didn’t dare to ask him any more questions."],["41",[["Εἶπεν",31,3],["δὲ",14,8],["πρὸς",15,1],["αὐτούς",3,60],["πῶς",10049,12],["λέγουσιν",31,191],["τὸν",1,6],["χριστὸν",1072,7],["εἶναι",10135,54],["Δαυὶδ",52,21],["υἱόν",13,7]],"He said to them, “Why do they say that the Christ is David’s son?"],["42",[["αὐτὸς",3,158],["γὰρ",40,8],["Δαυὶδ",52,5],["λέγει",31,87],["ἐν",4,1],["βίβλῳ",1465,2],["ψαλμῶν",644,77],["εἶπεν",31,3],["κύριος",7,5],["τῷ",1,110],["κυρίῳ",7,113],["μου",9994,146],["κάθου",419,726],["ἐκ",21,1],["δεξιῶν",282,79],["μου",9994,146]],"David himself says in the book of Psalms, ‘The Lord said to my Lord, “Sit at my right hand,"],["43",[["ἕως",42,1],["ἂν",83,12],["θῶ",110,227],["τοὺς",1,56],["ἐχθρούς",135,31],["σου",5,146],["ὑποπόδιον",4661,33],["τῶν",1,76],["ποδῶν",210,77],["σου",5,146]],"until I make your enemies the footstool of your feet.”’"],["44",[["Δαυὶδ",52,5],["οὖν",227,8],["κύριον",7,7],["αὐτὸν",3,82],["καλεῖ",128,87],["καὶ",2,8],["πῶς",10049,12],["αὐτοῦ",3,48],["υἱός",13,5],["ἐστιν",10,87]],"“David therefore calls him Lord, so how is he his son?”"],["45",[["Ἀκούοντος",54,143],["δὲ",14,8],["παντὸς",11,153],["τοῦ",1,30],["λαοῦ",35,21],["εἶπεν",31,3],["τοῖς",1,138],["μαθηταῖς",10025,139],["αὐτοῦ",3,48]],"In the hearing of all the people, he said to his disciples,"],["46",[["προσέχετε",558,307],["ἀπὸ",17,1],["τῶν",1,76],["γραμματέων",632,77],["τῶν",1,76],["θελόντων",612,164],["περιπατεῖν",1327,54],["ἐν",4,1],["στολαῖς",560,71],["καὶ",2,8],["φιλούντων",1391