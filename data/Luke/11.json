[["1",[["Καὶ",2,8],["ἐγένετο",30,737],["ἐν",4,1],["τῷ",1,52],["εἶναι",10135,54],["αὐτὸν",3,82],["ἐν",4,1],["τόπῳ",99,113],["τινὶ",39,784],["προσευχόμενον",551,765],["ὡς",36,12],["ἐπαύσατο",706,26],["εἶπέν",31,3],["τις",39,150],["τῶν",1,76],["μαθητῶν",10025,77],["αὐτοῦ",3,48],["πρὸς",15,1],["αὐτόν",3,82],["κύριε",7,250],["δίδαξον",545,198],["ἡμᾶς",9994,209],["προσεύχεσθαι",551,749],["καθὼς",221,8],["καὶ",2,8],["Ἰωάννης",2148,5],["ἐδίδαξεν",545,3],["τοὺς",1,56],["μαθητὰς",10025,31],["αὐτοῦ",3,48]],"When he finished praying in a certain place, one of his disciples said to him, “Lord, teach us to pray, just as John also taught his disciples.”"],["2",[["εἶπεν",31,3],["δὲ",14,8],["αὐτοῖς",3,142],["ὅταν",319,8],["προσεύχησθε",551,748],["λέγετε",31,307],["πάτερ",44,250],["ἁγιασθήτω",329,25],["τὸ",1,27],["ὄνομά",57,20],["σου",5,146],["ἐλθέτω",55,46],["ἡ",1,11],["βασιλεία",157,13],["σου",5,146]],"He said to them, “When you pray, say, ‘Our Father in heaven, may your name be kept holy. May your Kingdom come. May your will be done on earth, as it is in heaven."],["3",[["τὸν",1,6],["ἄρτον",197,7],["ἡμῶν",9994,136],["τὸν",1,6],["ἐπιούσιον",10045,59],["δίδου",33,239],["ἡμῖν",9994,86],["τὸ",1,32],["καθ᾽",32,1],["ἡμέραν",28,10]],"Give us day by day our daily bread."],["4",[["καὶ",2,8],["ἄφες",501,198],["ἡμῖν",9994,86],["τὰς",1,39],["ἁμαρτίας",119,40],["ἡμῶν",9994,136],["καὶ",2,8],["γὰρ",40,8],["αὐτοὶ",3,195],["ἀφίομεν",501,241],["παντὶ",11,111],["ὀφείλοντι",2150,390],["ἡμῖν",9994,86],["καὶ",2,8],["μὴ",25,12],["εἰσενέγκῃς",587,170],["ἡμᾶς",9994,209],["εἰς",8,1],["πειρασμόν",2281,7]],"Forgive us our sins, for we ourselves also forgive everyone who is indebted to us. Bring us not into temptation, but deliver us from the evil one.’”"],["5",[["Καὶ",2,8],["εἶπεν",31,3],["πρὸς",15,1],["αὐτούς",3,60],["τίς",10010,150],["ἐξ",21,1],["ὑμῶν",5,136],["ἕξει",124,120],["φίλον",336,59],["καὶ",2,8],["πορεύσεται",49,718],["πρὸς",15,1],["αὐτὸν",3,82],["μεσονυκτίου",5822,24],["καὶ",2,8],["εἴπῃ",31,160],