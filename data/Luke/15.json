[["1",[["Ἦσαν",10,129],["δὲ",14,8],["αὐτῷ",3,49],["ἐγγίζοντες",455,137],["πάντες",11,130],["οἱ",1,128],["τελῶναι",10041,51],["καὶ",2,8],["οἱ",1,128],["ἁμαρτωλοὶ",409,130],["ἀκούειν",54,54],["αὐτοῦ",3,48]],"Now all the tax collectors and sinners were coming close to him to hear him."],["2",[["καὶ",2,8],["διεγόγγυζον",2572,129],["οἵ",1,128],["τε",209,8],["Φαρισαῖοι",10006,51],["καὶ",2,8],["οἱ",1,128],["γραμματεῖς",632,51],["λέγοντες",31,137],["ὅτι",19,8],["οὗτος",16,112],["ἁμαρτωλοὺς",409,58],["προσδέχεται",1019,728],["καὶ",2,8],["συνεσθίει",4415,87],["αὐτοῖς",3,142]],"The Pharisees and the scribes murmured, saying, “This man welcomes sinners, and eats with them.”"],["3",[["Εἶπεν",31,3],["δὲ",14,8],["πρὸς",15,1],["αὐτοὺς",3,60],["τὴν",1,9],["παραβολὴν",1061,10],["ταύτην",16,234],["λέγων",31,67]],"He told them this parable:"],["4",[["τίς",10010,150],["ἄνθρωπος",43,5],["ἐξ",21,1],["ὑμῶν",5,136],["ἔχων",124,67],["ἑκατὸν",243,372],["πρόβατα",194,43],["καὶ",2,8],["ἀπολέσας",596,155],["ἐξ",21,1],["αὐτῶν",3,168],["ἓν",58,29],["οὐ",12,12],["καταλείπει",207,87],["τὰ",1,42],["ἐνενήκοντα",2998,372],["ἐννέα",1574,372],["ἐν",4,1],["τῇ",1,95],["ἐρήμῳ",160,96],["καὶ",2,8],["πορεύεται",49,728],["ἐπὶ",9,1],["τὸ",1,32],["ἀπολωλὸς",596,419],["ἕως",42,1],["εὕρῃ",101,160],["αὐτό",3,121]],"“Which of you men, if you had one hundred sheep and lost one of them, wouldn’t leave the ninety-nine in the wilderness and go after the one that was lost, until he found it?"],["5",[["καὶ",2,8],["εὑρὼν",101,155],["ἐπιτίθησιν",239,87],["ἐπὶ",9,1],["τοὺς",1,56],["ὤμους",1011,31],["αὐτοῦ",3,48],["χαίρων",698,67]],"When he has found it, he carries it on his shoulders, rejoicing."],["6",[["καὶ",2,8],["ἐλθὼν",55,155],["εἰς",8,1],["τὸν",1,6],["οἶκον",34,7],["συγκαλεῖ",2381,87],["τοὺς",1,56],["φίλους",336,58],["καὶ",2,8],["τοὺς",1,56],["γείτονας",2072,31],["λέγων",31,67],["αὐτοῖς",3,142],["συγχάρητέ",6089,769],["μοι",9994,151],["ὅτι",19,8],["εὗρον",101,147],["τὸ",1,32],["πρόβατόν",194,33],["μου",9994,146],["τὸ",1,32],["ἀπολωλός",596,419]],"When he comes home, he calls together his friends and his neighbors, saying to them, ‘Rejoice with me, for I have found my sheep which was lost!’"],["7",[["Λέγω",31,149],["ὑμῖν",5,86],["ὅτι",19,8],["οὕτως",71,17],["χαρὰ",1125,13],["ἐν",4,1],["τῷ",1,110],["οὐρανῷ",94,113],["ἔσται",10,718],["ἐπὶ",9,1],["ἑνὶ",58,111],["ἁμαρτωλῷ",409,111],["μετανοοῦντι",1634,390],["ἢ",61,8],["ἐπὶ",9,1],["ἐνενήκοντα",2998,372],["ἐννέα",1574,372],["δικαίοις",153,215],["οἵτινες",457,455],["οὐ",12,12],["χρείαν",1006,10],["ἔχουσιν",124,191],["μετανοίας",3084,19]],"I tell you that even so there will be more joy in heaven over one sinner who repents, than over ninety-nine righteous people who need no repentance."],["8",[["Ἢ",61,8],["τίς",10010,368],["γυνὴ",59,13],["δραχμὰς",3264,40],["ἔχουσα",124,183],["δέκα",311,372],["ἐὰν",45,8],["ἀπολέσῃ",596,160],["δραχμὴν",3264,10],["μίαν",58,37],["οὐχὶ",330,12],["ἅπτει",10060,87],["λύχνον",1059,7],["καὶ",2,8],["σαροῖ",6042,87],["τὴν",1,9],["οἰκίαν",233,10],["καὶ",2,8],["ζητεῖ",191,87],["ἐπιμελῶς",2421,17],["ἕως",42,1],["οὗ",24,367],["εὕρῃ",101,160]],"“Or what woman, if she had ten drachma coins, if she lost one drachma coin, wouldn’t light a lamp, sweep the house, and seek diligently until she found it?"],["9",[["καὶ",2,8],["εὑροῦσα",101,140],["συγκαλεῖ",2381,87],["τὰς",1,39],["φίλας",336,109],["καὶ",2,8],["γείτονας",2072,40],["λέγουσα",31,183],["συγχάρητέ",6089,769],["μοι",9994,151],["ὅτι",19,8],["εὗρον",101,147],["τὴν",1,9],["δραχμὴν",3264,10],["ἣν",24,124],["ἀπώλεσα",596,147]],"When she has found it, she calls together her friends and neighbors, saying, ‘Rejoice with me, for I have found the drachma which I had lost!’"],["10",[["Οὕτως",71,17],["λέγω",31,149],["ὑμῖν",5,86],["γίνεται",30,728],["χαρὰ",1125,13],["ἐνώπιον",115,1],["τῶν",1,76],["ἀγγέλων",208,77],["τοῦ",1,30],["θεοῦ",20,21],["ἐπὶ",9,1],["ἑνὶ",58,111],["ἁμαρτωλῷ",409,111],["μετανοοῦντι",1634,390]],"Even so, I tell you, there is joy in the presence of the angels of God over one sinner repenting.”"],["11",[["Εἶπεν",31,3],["δέ",14,8],["ἄνθρωπός",43,5],["τις",39,150],["εἶχεν",124,14],["δύο",104,372],["υἱούς",13,31]],"He said, “A certain man had two sons."],["12",[["καὶ",2,8],["εἶπεν",31,3],["ὁ",1,4],["νεώτερος",515,16],["αὐτῶν",3,41],["τῷ",1,110],["πατρί",44,113],["πάτερ",44,250],["δός",33,198],["μοι",9994,151],["τὸ",1,32],["ἐπιβάλλον",724,47],["μέρος",471,33],["τῆς",1,18],["οὐσίας",5881,19],["ὁ",1,4],["δὲ",14,8],["διεῖλεν",1112,3],["αὐτοῖς",3,142],["τὸν",1,6],["βίον",726,7]],"The younger of them said to his father, ‘Father, give me my share of your property.’ So he divided his livelihood between them."],["13",[["καὶ",2,8],["μετ᾽",29,1],["οὐ",12,12],["πολλὰς",74,109],["ἡμέρας",28,40],["συναγαγὼν",166,155],["πάντα",11,65],["ὁ",1,4],["νεώτερος",515,16],["υἱὸς",13,5],["ἀπεδήμησεν",10161,3],["εἰς",8,1],["χώραν",278,10],["μακρὰν",642,37],["καὶ",2,8],["ἐκεῖ",76,17],["διεσκόρπισεν",1001,3],["τὴν",1,9],["οὐσίαν",5881,10],["αὐτοῦ",3,48],["ζῶν",107,67],["ἀσώτως",10392,17]],"Not many days after, the younger son gathered all of this together and traveled into a far country. There he wasted his property with riotous living."],["14",[["δαπανήσαντος",3043,513],["δὲ",14,8],["αὐτοῦ",3,48],["πάντα",11,65],["ἐγένετο",30,737],["λιμὸς",503,13],["ἰσχυρὰ",401,15],["κατὰ",32,1],["τὴν",1,9],["χώραν",278,10],["ἐκείνην",80,234],["καὶ",2,8],["αὐτὸς",3,158],["ἤρξατο",320,737],["ὑστερεῖσθαι",1947,634]],"When he had spent all of it, there arose a severe famine in that country, and he began to be in need."],["15",[["καὶ",2,8],["πορευθεὶς",49,731],["ἐκολλήθη",1246,38],["ἑνὶ",58,111],["τῶν",1,76],["πολιτῶν",2036,77],["τῆς",1,18],["χώρας",278,19],["ἐκείνης",80,290],["καὶ",2,8],["ἔπεμψεν",1597,3],["αὐτὸν",3,82],["εἰς",8,1],["τοὺς",1,56],["ἀγροὺς",252,31],["αὐτοῦ",3,48],["βόσκειν",1542,54],["χοίρους",10057,31]],"He went and joined himself to one of the citizens of that country, and he sent him into his fields to feed pigs."],["16",[["καὶ",2,8],["ἐπεθύμει",915,14],[