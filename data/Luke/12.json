],"but he who denies me in the presence of men will be denied in the presence of God’s angels."],["10",[["καὶ",2,8],["πᾶς",11,16],["ὃς",24,246],["ἐρεῖ",10054,120],["λόγον",48,7],["εἰς",8,1],["τὸν",1,6],["υἱὸν",13,7],["τοῦ",1,30],["ἀνθρώπου",43,21],["ἀφεθήσεται",501,125],["αὐτῷ",3,49],["τῷ",1,110],["δὲ",14,8],["εἰς",8,1],["τὸ",1,32],["ἅγιον",75,29],["πνεῦμα",168,33],["βλασφημήσαντι",3250,354],["οὐκ",12,12],["ἀφεθήσεται",501,125]],"Everyone who speaks a word against the Son of Man will be forgiven, but those who blaspheme against the Holy Spirit will not be forgiven."],["11",[["Ὅταν",319,8],["δὲ",14,8],["εἰσφέρωσιν",587,265],["ὑμᾶς",5,209],["ἐπὶ",9,1],["τὰς",1,39],["συναγωγὰς",284,40],["καὶ",2,8],["τὰς",1,39],["ἀρχὰς",270,40],["καὶ",2,8],["τὰς",1,39],["ἐξουσίας",929,40],["μὴ",25,12],["μεριμνήσητε",2600,118],["πῶς",10049,12],["ἢ",61,8],["τί",10010,119],["ἀπολογήσησθε",5223,746],["ἢ",61,8],["τί",10010,119],["εἴπητε",9997,118]],"When they bring you before the synagogues, the rulers, and the authorities, don’t be anxious how or what you will answer or what you will say;"],["12",[["τὸ",1,27],["γὰρ",40,8],["ἅγιον",75,28],["πνεῦμα",168,20],["διδάξει",545,120],["ὑμᾶς",5,209],["ἐν",4,1],["αὐτῇ",3,99],["τῇ",1,95],["ὥρᾳ",838,2],["ἃ",24,755],["δεῖ",1158,87],["εἰπεῖν",9997,100]],"for the Holy Spirit will teach you in that same hour what you must say.”"],["13",[["Εἶπεν",9997,3],["δέ",14,8],["τις",39,150],["ἐκ",21,1],["τοῦ",1,30],["ὄχλου",1008,21],["αὐτῷ",3,49],["διδάσκαλε",7031,250],["εἰπὲ",9997,198],["τῷ",1,110],["ἀδελφῷ",67,113],["μου",9994,146],["μερίσασθαι",1348,103],["μετ᾽",29,1],["ἐμοῦ",6,88],["τὴν",1,9],["κληρονομίαν",299,10]],"One of the multitude said to him, “Teacher, tell my brother to divide the inheritance with me.”"],["14",[["ὁ",1,4],["δὲ",14,8],["εἶπεν",9997,3],["αὐτῷ",3,49],["ἄνθρωπε",43,250],["τίς",10010,150],["με",9994,161],["κατέστησεν",314,3],["κριτὴν",749,7],["ἢ",61,8],["μεριστὴν",10383,7],["ἐφ᾽",9,1],["ὑμᾶς",5,209]],"But he said to him, “Man, who made me a j