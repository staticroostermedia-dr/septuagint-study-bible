sked."],["49",[["Πῦρ",118,33],["ἦλθον",55,147],["βαλεῖν",766,100],["ἐπὶ",9,1],["τὴν",1,9],["γῆν",26,10],["καὶ",2,8],["τί",10010,119],["θέλω",612,149],["εἰ",77,8],["ἤδη",916,17],["ἀνήφθη",1796,38]],"“I came to throw fire on the earth. I wish it were already kindled."],["50",[["βάπτισμα",10008,33],["δὲ",14,8],["ἔχω",124,149],["βαπτισθῆναι",4169,175],["καὶ",2,8],["πῶς",10049,12],["συνέχομαι",1227,572],["ἕως",42,1],["ὅτου",457,563],["τελεσθῇ",1482,333]],"But I have a baptism to be baptized with, and how distressed I am until it is accomplished!"],["51",[["δοκεῖτε",801,84],["ὅτι",19,8],["εἰρήνην",213,10],["παρεγενόμην",377,820],["δοῦναι",33,100],["ἐν",4,1],["τῇ",1,95],["γῇ",26,2],["οὐχί",330,12],["λέγω",31,149],["ὑμῖν",5,86],["ἀλλ᾽",108,8],["ἢ",61,8],["διαμερισμόν",5554,7]],"Do you think that I have come to give peace on the earth? I tell you, no, but rather division."],["52",[["ἔσονται",10,740],["γὰρ",40,8],["ἀπὸ",17,1],["τοῦ",1,30],["νῦν",90,17],["πέντε",280,372],["ἐν",4,1],["ἑνὶ",58,111],["οἴκῳ",34,113],["διαμεμερισμένοι",2075,574],["τρεῖς",174,130],["ἐπὶ",9,1],["δυσὶν",104,215],["καὶ",2,8],["δύο",104,372],["ἐπὶ",9,1],["τρισὶν",174,215]],"For from now on, there will be five in one house divided, three against two, and two against three."],["53",[["διαμερισθήσονται",2075,135],["πατὴρ",44,5],["ἐπὶ",9,1],["υἱῷ",13,113],["καὶ",2,8],["υἱὸς",13,5],["ἐπὶ",9,1],["πατρί",44,113],["μήτηρ",189,13],["ἐπὶ",9,1],["τὴν",1,9],["θυγατέρα",97,10],["καὶ",2,8],["θυγάτηρ",97,13],["ἐπὶ",9,1],["τὴν",1,9],["μητέρα",189,10],["πενθερὰ",2475,13],["ἐπὶ",9,1],["τὴν",1,9],["νύμφην",1060,10],["αὐτῆς",3,83],["καὶ",2,8],["νύμφη",1060,13],["ἐπὶ",9,1],["τὴν",1,9],["πενθεράν",2475,10]],"They will be divided, father against son, and son against father; mother against daughter, and daughter against her mother; mother-in-law against her daughter-in-law, and daughter-in-law against her mother-in-law.”"],["54",[["Ἔλεγεν",31,14],["δὲ",14,8],["καὶ",2,8],["τοῖς",1,138],["ὄχλοις",1008,139],["ὅταν",319,8],["ἴδ