[["1",[["Ἀναβλέψας",1425,155],["δὲ",14,8],["εἶδεν",112,3],["τοὺς",1,56],["βάλλοντας",766,229],["εἰς",8,1],["τὸ",1,32],["γαζοφυλάκιον",1582,33],["τὰ",1,42],["δῶρα",348,43],["αὐτῶν",3,41],["πλουσίους",952,58]],"He looked up and saw the rich people who were putting their gifts into the treasury."],["2",[["εἶδεν",112,3],["δέ",14,8],["τινα",39,583],["χήραν",751,10],["πενιχρὰν",4970,37],["βάλλουσαν",766,73],["ἐκεῖ",76,17],["λεπτὰ",1554,43],["δύο",104,372]],"He saw a certain poor widow casting in two small brass coins."],["3",[["Καὶ",2,8],["εἶπεν",31,3],["ἀληθῶς",1795,17],["λέγω",31,149],["ὑμῖν",5,86],["ὅτι",19,8],["ἡ",1,11],["χήρα",751,13],["αὕτη",16,101],["ἡ",1,11],["πτωχὴ",497,13],["πλεῖον",938,29],["πάντων",11,163],["ἔβαλεν",766,3]],"He said, “Truly I tell you, this poor widow put in more than all of them,"],["4",[["πάντες",11,130],["γὰρ",40,8],["οὗτοι",16,213],["ἐκ",21,1],["τοῦ",1,23],["περισσεύοντος",3112,291],["αὐτοῖς",3,142],["ἔβαλον",766,141],["εἰς",8,1],["τὰ",1,42],["δῶρα",348,43],["αὕτη",16,101],["δὲ",14,8],["ἐκ",21,1],["τοῦ",1,23],["ὑστερήματος",3774,24],["αὐτῆς",3,83],["πάντα",11,59],["τὸν",1,6],["βίον",726,7],["ὃν",24,106],["εἶχεν",124,14],["ἔβαλεν",766,3]],"for all these put in gifts for God from their abundance, but she, out of her poverty, put in all that she had to live on.”"],["5",[["Καί",2,8],["τινων",39,796],["λεγόντων",31,164],["περὶ",72,1],["τοῦ",1,23],["ἱεροῦ",675,24],["ὅτι",19,8],["λίθοις",195,139],["καλοῖς",266,215],["καὶ",2,8],["ἀναθήμασιν",10420,92],["κεκόσμηται",1680,722],["εἶπεν",31,3]],"As some were talking about the temple and how it was decorated with beautiful stones and gifts, he said,"],["6",[["ταῦτα",16,248],["ἃ",24,755],["θεωρεῖτε",897,84],["ἐλεύσονται",55,740],["ἡμέραι",28,180],["ἐν",4,1],["αἷς",24,281],["οὐκ",12,12],["ἀφεθήσεται",501,125],["λίθος",195,5],["ἐπὶ",9,1],["λίθῳ",195,113],["ὃς",24,246],["οὐ",12,12],["καταλυθήσεται",861,125]],"“As for these things which you see, the days will come in which there will not be left here one st