351,772],["ὑπὸ",122,1],["πάντων",11,163],["διὰ",56,1],["τὸ",1,32],["ὄνομά",57,33],["μου",9994,146]],"You will be hated by all men for my name’s sake."],["18",[["καὶ",2,8],["θρὶξ",1038,13],["ἐκ",21,1],["τῆς",1,18],["κεφαλῆς",144,19],["ὑμῶν",5,136],["οὐ",12,12],["μὴ",25,12],["ἀπόληται",217,236]],"And not a hair of your head will perish."],["19",[["ἐν",4,1],["τῇ",1,95],["ὑπομονῇ",1616,2],["ὑμῶν",5,136],["κτήσασθε",564,771],["τὰς",1,39],["ψυχὰς",63,40],["ὑμῶν",5,136]],"“By your endurance you will win your lives."],["20",[["Ὅταν",319,8],["δὲ",14,8],["ἴδητε",112,118],["κυκλουμένην",603,727],["ὑπὸ",122,1],["στρατοπέδων",3356,45],["Ἰερουσαλήμ",823,10],["τότε",250,17],["γνῶτε",79,69],["ὅτι",19,8],["ἤγγικεν",455,165],["ἡ",1,11],["ἐρήμωσις",1940,13],["αὐτῆς",3,83]],"“But when you see Jerusalem surrounded by armies, then know that its desolation is at hand."],["21",[["τότε",250,17],["οἱ",1,128],["ἐν",4,1],["τῇ",1,95],["Ἰουδαίᾳ",492,2],["φευγέτωσαν",264,55],["εἰς",8,1],["τὰ",1,42],["ὄρη",87,43],["καὶ",2,8],["οἱ",1,128],["ἐν",4,1],["μέσῳ",113,34],["αὐτῆς",3,83],["ἐκχωρείτωσαν",4581,55],["καὶ",2,8],["οἱ",1,128],["ἐν",4,1],["ταῖς",1,70],["χώραις",278,71],["μὴ",25,12],["εἰσερχέσθωσαν",86,857],["εἰς",8,1],["αὐτήν",3,98]],"Then let those who are in Judea flee to the mountains. Let those who are in the middle of her depart. Let those who are in the country not enter therein."],["22",[["ὅτι",19,8],["ἡμέραι",28,180],["ἐκδικήσεως",821,19],["αὗταί",16,196],["εἰσιν",10,191],["τοῦ",1,23],["πλησθῆναι",909,175],["πάντα",11,65],["τὰ",1,42],["γεγραμμένα",186,786]],"For these are days of vengeance, that all things which are written may be fulfilled."],["23",[["Οὐαὶ",769,316],["ταῖς",1,70],["ἐν",4,1],["γαστρὶ",777,2],["ἐχούσαις",124,505],["καὶ",2,8],["ταῖς",1,70],["θηλαζούσαις",1468,505],["ἐν",4,1],["ἐκείναις",80,336],["ταῖς",1,70],["ἡμέραις",28,71],["ἔσται",10,718],["γὰρ",40,8],["ἀνάγκη",1126,13],["μεγάλη",66,15],["ἐπὶ",9,1],["τῆς",1,18],["γῆς",26,19],["καὶ",2,8],["ὀργὴ",198,13],["τῷ",1,110],["λαῷ",35,113],["τούτῳ",16,286]],"Woe to those who are pregnant and to those who nurse infants in those days! For there will be great distress in the land and wrath to this people."],["24",[["καὶ",2,8],["πεσοῦνται",154,790],["στόματι",123,53],["μαχαίρης",342,19],["καὶ",2,8],["αἰχμαλωτισθήσονται",2246,135],["εἰς",8,1],["τὰ",1,42],["ἔθνη",60,43],["πάντα",11,65],["καὶ",2,8],["Ἰερουσαλὴμ",823,13],["ἔσται",10,718],["πατουμένη",2033,761],["ὑπὸ",122,1],["ἐθνῶν",60,45],["ἄχρι",4062,1],["οὗ",24,367],["πληρωθῶσιν",518,266],["καιροὶ",132,51],["ἐθνῶν",60,45]],"They will fall by the edge of the sword, and will be led captive into all the nations. Jerusalem will be trampled down by the Gentiles until the times of the Gentiles are fulfilled."],["25",[["καὶ",2,8],["ἔσονται",10,740],["σημεῖα",505,63],["ἐν",4,1],["ἡλίῳ",323,113],["καὶ",2,8],["σελήνῃ",1207,2],["καὶ",2,8],["ἄστροις",1338,92],["καὶ",2,8],["ἐπὶ",9,1],["τῆς",1,18],["γῆς",26,19],["συνοχὴ",4416,13],["ἐθνῶν",60,45],["ἐν",4,1],["ἀπορίᾳ",3173,2],["ἤχους",1803,24],["θαλάσσης",137,19],["καὶ",2,8],["σάλου",2637,21]],"“There will be signs in the sun, moon, and stars; and on the earth anxiety of nations, in perplexity for the roaring of the sea and the waves;"],["26",[["ἀποψυχόντων",9069,164],["ἀνθρώπων",43,77],["ἀπὸ",17,1],["φόβου",333,21],["καὶ",2,8],["προσδοκίας",3118,19],["τῶν",1,76],["ἐπερχομένων",542,762],["τῇ",1,95],["οἰκουμένῃ",1326,2],["αἱ",1,185],["γὰρ",40,8],["δυνάμεις",98,180],["τῶν",1,76],["οὐρανῶν",94,77],["σαλευθήσονται",678,135]],"men fainting for fear and for expectation of the things which are coming on the world, for the powers of the heavens will be shaken."],["27",[["καὶ",2,8],["τότε",250,17],["ὄψονται",112,740],["τὸν",1,6],["υἱὸν",13,7],["τοῦ",1,30],["ἀνθρώπου",43,21],["ἐρχόμενον",55,765],["ἐν",4,1],["νεφέλῃ",444,2],["μετὰ",29,1],["δυνάμεως",98,19],["καὶ",2,8],["δόξης",141,19],["πολλῆς",74,78]],"Then they will see the Son of Man coming in a cloud with power and great glory."],["28",[["Ἀρχομένων",320,858],["δὲ",14,8],["τούτων",16,214],["γίνεσθαι",30,749],["ἀνακύψατε",8853,69],["καὶ",2,8],["ἐπάρατε",661,69],["τὰς",1,39],["κεφαλὰς",144,40],["ὑμῶν",5,136],["διότι",177,8],["ἐγγίζει",455,87],["ἡ",1,11],["ἀπολύτρωσις",10422,13],["ὑμῶν",5,136]],"But when these things begin to happen, look up and lift up your heads, because your redemption is near.”"],["29",[["Καὶ",2,8],["εἶπεν",31,3],["παραβολὴν",1061,10],["αὐτοῖς",3,142],["ἴδετε",112,69],["τὴν",1,9],["συκῆν",1561,10],["καὶ",2,8],["πάντα",11,65],["τὰ",1,42],["δένδρα",1342,43]],"He told them a parable. “See the fig tree and all the trees."],["30",[["ὅταν",319,8],["προβάλωσιν",3337,224],["ἤδη",916,17],["βλέποντες",470,137],["ἀφ᾽",17,1],["ἑαυτῶν",92,41],["γινώσκετε",79,84],["ὅτι",19,8],["ἤδη",916,17],["ἐγγὺς",1026,1],["τὸ",1,27],["θέρος",3064,20],["ἐστίν",10,87]],"When they are already budding, you see it and know by your own selves that the summer is already near."],["31",[["οὕτως",71,17],["καὶ",2,8],["ὑμεῖς",5,208],["ὅταν",319,8],["ἴδητε",112,118],["ταῦτα",16,248],["γινόμενα",30,835],["γινώσκετε",79,307],["ὅτι",19,8],["ἐγγύς",1026,1],["ἐστιν",10,87],["ἡ",1,11],["βασιλεία",157,13],["τοῦ",1,30],["θεοῦ",20,21]],"Even so you also, when you see these things happening, know that God’s Kingdom is near."],["32",[["Ἀμὴν",3161,316],["λέγω",31,149],["ὑμῖν",5,86],["ὅτι",19,8],["οὐ",12,12],["μὴ",25,12],["παρέλθῃ",404,160],["ἡ",1,11],["γενεὰ",286,13],["αὕτη",16,101],["ἕως",42,1],["ἂν",83,12],["πάντα",11,74],["γένηται",30,745]],"Most certainly I tell you, this generation will not pass away until all things are accomplished."],["33",[["ὁ",1,4],["οὐρανὸς",94,5],["καὶ",2,8],["ἡ",1,11],["γῆ",26,13],["παρελεύσονται",404,740],["οἱ",1,128],["δὲ",14,8],["λόγοι",48,51],["μου",9994,146],["οὐ",12,12],["μὴ",25,12],["παρελεύσονται",404,740]],"Heaven and earth will pass away, but my words will by no means pass away."],["34",[["Προσέχετε",558,307],["δὲ",14,8],["ἑαυτοῖς",92,142],["μήποτε",10015,12],["βαρηθῶσιν",6847,266],["ὑμῶν",5,136],["αἱ",1,185],["καρδίαι",64,180],["ἐν",4,1],["κραιπάλῃ",10423,2],["καὶ",2,8],["μέθῃ",2469,2],["καὶ",2,8],["μερίμναις",3092,71],["βιωτικαῖς",10424,287],["καὶ",2,8],["ἐπιστῇ",631,160],["ἐφ᾽",9,1],["ὑμᾶς",5,209],["αἰφνίδιος",3787,15],["ἡ",1,11],["ἡμέρα",28,13],["ἐκείνη",80,101]],"“So be careful, or your hearts will be loaded down with carousing, drunkenness, and cares of this life, and that day will come on you suddenly."],["35",[["ὡς",36,12],["παγίς",817,13],["ἐπεισελεύσεται",9485,89],["γὰρ",40,8],["ἐπὶ",9,1],["πάντας",11,58],["τοὺς",1,56],["καθημένους",419,729],["ἐπὶ",9,1],["πρόσωπον",47,33],["πάσης",11,78],["τῆς",1,18],["γῆς",26,19]],"For it will come like a snare on all those who dwell on the surface of all the earth."],["36",[["ἀγρυπνεῖτε",2802,307],["δὲ",14,8],["ἐν",4,1],["παντὶ",11,111],["καιρῷ",132,113],["δεόμενοι",1672,741],["ἵνα",102,8],["κατισχύσητε",628,118],["ἐκφυγεῖν",1861,100],["ταῦτα",16,248],["πάντα",11,65],["τὰ",1,42],["μέλλοντα",1143,232],["γίνεσθαι",30,749],["καὶ",2,8],["σταθῆναι",78,175],["ἔμπροσθεν",390,1],["τοῦ",1,30],["υἱοῦ",13,21],["τοῦ",1,30],["ἀνθρώπου",43,21]],"Therefore be watchful all the time, praying that you may be counted worthy to escape all these things that will happen, and to stand before the Son of Man.”"],["37",[["Ἦν",10,14],["δὲ",14,8],["τὰς",1,39],["ἡμέρας",28,40],["ἐν",4,1],["τῷ",1,52],["ἱερῷ",675,53],["διδάσκων",545,67],["τὰς",1,39],["δὲ",14,8],["νύκτας",219,40],["ἐξερχόμενος",82,723],["ηὐλίζετο",990,721],["εἰς",8,1],["τὸ",1,32],["ὄρος",87,33],["τὸ",1,32],["καλούμενον",128,783],["Ἐλαιῶν",2055,61]],"Every day Jesus was teaching in the temple, and every night he would go out and spend the night on the mountain that is called Olivet."],["38",[["καὶ",2,8],["πᾶς",11,16],["ὁ",1,4],["λαὸς",35,5],["ὤρθριζεν",931,14],["πρὸς",15,1],["αὐτὸν",3,82],["ἐν",4,1],["τῷ",1,52],["ἱερῷ",675,53],["ἀκούειν",54,54],["αὐτοῦ",3,48]],"All the people came early in the morning to him in the temple to hear him."]]