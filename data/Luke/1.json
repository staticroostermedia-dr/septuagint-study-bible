"γενεαὶ",286,180]],"for he has looked at the humble state of his servant. For behold, from now on, all generations will call me blessed."],["49",[["ὅτι",19,8],["ἐποίησέν",23,3],["μοι",9994,151],["μεγάλα",66,65],["ὁ",1,4],["δυνατός",356,16],["καὶ",2,8],["ἅγιον",75,28],["τὸ",1,27],["ὄνομα",57,20],["αὐτοῦ",3,48]],"For he who is mighty has done great things for me. Holy is his name."],["50",[["καὶ",2,8],["τὸ",1,27],["ἔλεος",183,20],["αὐτοῦ",3,48],["εἰς",8,1],["γενεὰς",286,40],["καὶ",2,8],["γενεὰς",286,40],["τοῖς",1,138],["φοβουμένοις",134,736],["αὐτόν",3,82]],"His mercy is for generations and generations on those who fear him."],["51",[["ἐποίησεν",23,3],["κράτος",1139,33],["ἐν",4,1],["βραχίονι",1032,113],["αὐτοῦ",3,48],["διεσκόρπισεν",1001,3],["ὑπερηφάνους",1109,58],["διανοίᾳ",755,2],["καρδίας",64,19],["αὐτῶν",3,41]],"He has shown strength with his arm. He has scattered the proud in the imagination of their hearts."],["52",[["καθεῖλεν",602,3],["δυνάστας",803,31],["ἀπὸ",17,1],["θρόνων",383,77],["καὶ",2,8],["ὕψωσεν",331,3],["ταπεινούς",1097,58]],"He has put down princes from their thrones, and has exalted the lowly."],["53",[["πεινῶντας",1045,229],["ἐνέπλησεν",10299,3],["ἀγαθῶν",114,79],["καὶ",2,8],["πλουτοῦντας",2373,229],["ἐξαπέστειλεν",220,3],["κενούς",780,58]],"He has filled the hungry with good things. He has sent the rich away empty."],["54",[["ἀντελάβετο",984,737],["Ἰσραὴλ",27,21],["παιδὸς",127,21],["αὐτοῦ",3,48],["μνησθῆναι",230,175],["ἐλέους",183,24]],"He has given help to Israel, his servant, that he might remember mercy,"],["55",[["καθὼς",221,8],["ἐλάλησεν",50,3],["πρὸς",15,1],["τοὺς",1,56],["πατέρας",44,31],["ἡμῶν",9994,136],["τῷ",1,110],["Ἀβραὰμ",294,113],["καὶ",2,8],["τῷ",1,52],["σπέρματι",218,53],["αὐτοῦ",3,48],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7]],"as he spoke to our fathers, to Abraham and his offspring forever.”"],["56",[["Ἔμεινεν",681,3],["δὲ",14,8],["Μαριὰμ",2158,13],["σὺν",310,1],["αὐτῇ",3,99],["ὡς",36,12],["μῆνας",10294,31],["τρεῖς",174,58],["καὶ