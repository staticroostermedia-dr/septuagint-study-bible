[["1",[["Ἐπειδήπερ",10286,8],["πολλοὶ",74,130],["ἐπεχείρησαν",2541,141],["ἀνατάξασθαι",10287,776],["διήγησιν",2576,10],["περὶ",72,1],["τῶν",1,44],["πεπληροφορημένων",7986,839],["ἐν",4,1],["ἡμῖν",9994,86],["πραγμάτων",511,45]],"Since many have undertaken to set in order a narrative concerning those matters which have been fulfilled among us,"],["2",[["καθὼς",221,8],["παρέδοσαν",254,141],["ἡμῖν",9994,86],["οἱ",1,128],["ἀπ᾽",17,1],["ἀρχῆς",270,19],["αὐτόπται",10288,51],["καὶ",2,8],["ὑπηρέται",4138,51],["γενόμενοι",30,840],["τοῦ",1,30],["λόγου",48,21]],"even as those who from the beginning were eyewitnesses and servants of the word delivered them to us,"],["3",[["ἔδοξεν",801,3],["κἀμοὶ",10000,8],["παρηκολουθηκότι",5898,531],["ἄνωθεν",1605,17],["πᾶσιν",11,90],["ἀκριβῶς",5167,17],["καθεξῆς",10289,17],["σοι",5,151],["γράψαι",186,100],["κράτιστε",3074,309],["Θεόφιλε",10290,250]],"it seemed good to me also, having traced the course of all things accurately from the first, to write to you in order, most excellent Theophilus;"],["4",[["ἵνα",102,8],["ἐπιγνῷς",431,170],["περὶ",72,1],["ὧν",24,303],["κατηχήθης",10291,360],["λόγων",48,77],["τὴν",1,9],["ἀσφάλειαν",2051,10]],"that you might know the certainty concerning the things in which you were instructed."],["5",[["Ἐγένετο",30,737],["ἐν",4,1],["ταῖς",1,70],["ἡμέραις",28,71],["Ἡρῴδου",9995,21],["βασιλέως",22,21],["τῆς",1,18],["Ἰουδαίας",492,19],["ἱερεύς",65,5],["τις",39,150],["ὀνόματι",57,53],["Ζαχαρίας",893,5],["ἐξ",21,1],["ἐφημερίας",1709,19],["Ἀβιά",1606,21],["καὶ",2,8],["γυνὴ",59,13],["αὐτῷ",3,49],["ἐκ",21,1],["τῶν",1,123],["θυγατέρων",97,61],["Ἀαρὼν",159,21],["καὶ",2,8],["τὸ",1,27],["ὄνομα",57,20],["αὐτῆς",3,83],["Ἐλισάβετ",10292,13]],"There was in the days of Herod, the king of Judea, a certain priest named Zacharias, of the priestly division of Abijah. He had a wife of the daughters of Aaron, and her name was Elizabeth."],["6",[["ἦσαν",10,129],["δὲ",14,8],["δίκαιοι",153,130],["ἀμφότεροι",459,130],["ἐναντίον",138,1],["τοῦ",1,30],["θεοῦ",20,21],["πορευόμενοι",49,741],["ἐν",4,1],["πάσαις",11,287],["ταῖς",1,70],["ἐντολαῖς",259,71],["καὶ",2,8],["δικαιώμασιν",428,92],["τοῦ",1,30],["κυρίου",7,21],["ἄμεμπτοι",2134,130]],"They were both righteous before God, walking blamelessly in all the commandments and ordinances of the Lord."],["7",[["καὶ",2,8],["οὐκ",12,12],["ἦν",10,14],["αὐτοῖς",3,142],["τέκνον",192,20],["καθότι",826,8],["ἦν",10,14],["ἡ",1,11],["Ἐλισάβετ",10292,13],["στεῖρα",2380,13],["καὶ",2,8],["ἀμφότεροι",459,130],["προβεβηκότες",1969,263],["ἐν",4,1],["ταῖς",1,70],["ἡμέραις",28,71],["αὐτῶν",3,41],["ἦσαν",10,129]],"But they had no child, because Elizabeth was barren, and they both were well advanced in years."],["8",[["Ἐγένετο",30,737],["δὲ",14,8],["ἐν",4,1],["τῷ",1,52],["ἱερατεύειν",1536,54],["αὐτὸν",3,82],["ἐν",4,1],["τῇ",1,95],["τάξει",1744,2],["τῆς",1,18],["ἐφημερίας",1709,19],["αὐτοῦ",3,48],["ἔναντι",232,1],["τοῦ",1,30],["θεοῦ",20,21]],"Now while he executed the priest’s office before God in the order of his division"],["9",[["κατὰ",32,1],["τὸ",1,32],["ἔθος",3754,33],["τῆς",1,18],["ἱερατείας",2232,19],["ἔλαχεν",4880,3],["τοῦ",1,23],["θυμιᾶσαι",756,100],["εἰσελθὼν",86,155],["εἰς",8,1],["τὸν",1,6],["ναὸν",483,7],["τοῦ",1,30],["κυρίου",7,21]],"according to the custom of the priest’s office, his lot was to enter into the temple of the Lord and burn incense."],["10",[["καὶ",2,8],["πᾶν",11,28],["τὸ",1,27],["πλῆθος",200,20],["ἦν",10,14],["τοῦ",1,30],["λαοῦ",35,21],["προσευχόμενον",551,789],["ἔξω",527,1],["τῇ",1,95],["ὥρᾳ",838,2],["τοῦ",1,23],["θυμιάματος",658,24]],"The whole multitude of the people were praying outside at the hour of incense."],["11",[["Ὤφθη",10028,38],["δὲ",14,8],["αὐτῷ",3,49],["ἄγγελος",208,5],["κυρίου",7,21],["ἑστὼς",78,264],["ἐκ",21,1],["δεξιῶν",282,79],["τοῦ",1,23],["θυσιαστηρίου",133,24],["τοῦ",1,23],["θυμιάματος",658,24]],"An angel of the Lord appeared to him, standing on the right side of the altar of incense."],["12",[["καὶ",2,8],["ἐταράχθη",508,38],["Ζαχαρία