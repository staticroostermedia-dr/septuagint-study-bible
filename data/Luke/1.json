1],["ἐπιστρέψαι",117,100],["καρδίας",64,40],["πατέρων",44,77],["ἐπὶ",9,1],["τέκνα",192,43],["καὶ",2,8],["ἀπειθεῖς",3404,58],["ἐν",4,1],["φρονήσει",833,2],["δικαίων",153,163],["ἑτοιμάσαι",371,100],["κυρίῳ",7,113],["λαὸν",35,7],["κατεσκευασμένον",1437,763]],"He will go before him in the spirit and power of Elijah, ‘to turn the hearts of the fathers to the children,’ and the disobedient to the wisdom of the just; to prepare a people prepared for the Lord.”"],["18",[["Καὶ",2,8],["εἶπεν",9997,3],["Ζαχαρίας",893,5],["πρὸς",15,1],["τὸν",1,6],["ἄγγελον",208,7],["κατὰ",32,1],["τί",10010,119],["γνώσομαι",79,775],["τοῦτο",16,122],["ἐγὼ",6,156],["γάρ",40,8],["εἰμι",10,149],["πρεσβύτης",1095,5],["καὶ",2,8],["ἡ",1,11],["γυνή",59,13],["μου",9994,146],["προβεβηκυῖα",1969,284],["ἐν",4,1],["ταῖς",1,70],["ἡμέραις",28,71],["αὐτῆς",3,83]],"Zacharias said to the angel, “How can I be sure of this? For I am an old man, and my wife is well advanced in years.”"],["19",[["Καὶ",2,8],["ἀποκριθεὶς",234,731],["ὁ",1,4],["ἄγγελος",208,5],["εἶπεν",9997,3],["αὐτῷ",3,49],["ἐγώ",6,156],["εἰμι",10,149],["Γαβριὴλ",5441,5],["ὁ",1,4],["παρεστηκὼς",595,264],["ἐνώπιον",115,1],["τοῦ",1,30],["θεοῦ",20,21],["καὶ",2,8],["ἀπεστάλην",84,148],["λαλῆσαι",50,100],["πρὸς",15,1],["σὲ",5,161],["καὶ",2,8],["εὐαγγελίσασθαί",1817,103],["σοι",5,151],["ταῦτα",16,248]],"The angel answered him, “I am Gabriel, who stands in the presence of God. I was sent to speak to you and to bring you this good news."],["20",[["καὶ",2,8],["ἰδοὺ",51,316],["ἔσῃ",10,781],["σιωπῶν",1283,67],["καὶ",2,8],["μὴ",25,12],["δυνάμενος",185,723],["λαλῆσαι",50,100],["ἄχρι",4062,1],["ἧς",24,162],["ἡμέρας",28,19],["γένηται",30,745],["ταῦτα",16,335],["ἀνθ᾽",158,1],["ὧν",24,97],["οὐκ",12,12],["ἐπίστευσας",649,154],["τοῖς",1,138],["λόγοις",48,139],["μου",9994,146],["οἵτινες",457,455],["πληρωθήσονται",518,135],["εἰς",8,1],["τὸν",1,6],["καιρὸν",132,7],["αὐτῶν",3,41]],"Behold, you will be silent and not able to speak until the day that these things will happen, because you didn’t believe my words, which will be fulfilled in their proper time.”"],["21",[["Καὶ",2,8],["ἦν",10,14],["ὁ",1,4],["λαὸς",35,5],["προσδοκῶν",2758,67],["τὸν",1,6],["Ζαχαρίαν",893,7],["καὶ",2,8],["ἐθαύμαζον",963,129],["ἐν",4,1],["τῷ",1,52],["χρονίζειν",1746,54],["ἐν",4,1],["τῷ",1,110],["ναῷ",483,113],["αὐτόν",3,82]],"The people were waiting for Zacharias, and they marveled that he delayed in the temple."],["22",[["ἐξελθὼν",82,155],["δὲ",14,8],["οὐκ",12,12],["ἐδύνατο",185,721],["λαλῆσαι",50,100],["αὐτοῖς",3,142],["καὶ",2,8],["ἐπέγνωσαν",431,141],["ὅτι",19,8],["ὀπτασίαν",3022,10],["ἑώρακεν",112,165],["ἐν",4,1],["τῷ",1,110],["ναῷ",483,113],["καὶ",2,8],["αὐτὸς",3,158],["ἦν",10,14],["διανεύων",5555,67],["αὐτοῖς",3,142],["καὶ",2,8],["διέμενεν",1884,14],["κωφός",2362,16]],"When he came out, he could not speak to them. They perceived that he had seen a vision in the temple. He continued making signs to them, and remained mute."],["23",[["Καὶ",2,8],["ἐγένετο",30,737],["ὡς",36,12],["ἐπλήσθησαν",909,94],["αἱ",1,185],["ἡμέραι",28,180],["τῆς",1,18],["λειτουργίας",1141,19],["αὐτοῦ",3,48],["ἀπῆλθεν",297,3],["εἰς",8,1],["τὸν",1,6],["οἶκον",34,7],["αὐτοῦ",3,48]],"When the days of his service were fulfilled, he departed to his house."],["24",[["Μετὰ",29,1],["δὲ",14,8],["ταύτας",16,280],["τὰς",1,39],["ἡμέρας",28,40],["συνέλαβεν",507,3],["Ἐλισάβετ",10292,13],["ἡ",1,11],["γυνὴ",59,13],["αὐτοῦ",3,48],["καὶ",2,8],["περιέκρυβεν",10293,14],["ἑαυτὴν",92,98],["μῆνας",10294,31],["πέντε",280,372],["λέγουσα",31,183]],"After these days Elizabeth his wife conceived, and she hid herself five months, saying,"],["25",[["ὅτι",19,8],["οὕτως",9989,17],["μοι",9994,151],["πεποίηκεν",23,165],["κύριος",7,5],["ἐν",4,1],["ἡμέραις",28,71],["αἷς",24,281],["ἐπεῖδεν",1865,3],["ἀφελεῖν",369,100],["ὄνειδός",973,33],["μου",9994,146],["ἐν",4,1],["ἀνθρώποις",43,139]],"“Thus has the Lord done to me in the days in which he looked at me, to take away my reproach among men.”"],["26",[["Ἐν",4,1],["δὲ",14,8],["τῷ