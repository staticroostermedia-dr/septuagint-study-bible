οὐδὲ",106,8],["πάλιν",655,17],["δένδρον",1342,20],["σαπρὸν",10059,28],["ποιοῦν",23,36],["καρπὸν",448,7],["καλόν",266,59]],"“For there is no good tree that produces rotten fruit, nor again a rotten tree that produces good fruit."],["44",[["ἕκαστον",171,28],["γὰρ",40,8],["δένδρον",1342,20],["ἐκ",21,1],["τοῦ",1,30],["ἰδίου",683,153],["καρποῦ",448,21],["γινώσκεται",79,449],["οὐ",12,12],["γὰρ",40,8],["ἐξ",21,1],["ἀκανθῶν",1571,61],["συλλέγουσιν",1148,191],["σῦκα",3145,43],["οὐδὲ",106,8],["ἐκ",21,1],["βάτου",2872,19],["σταφυλὴν",1560,10],["τρυγῶσιν",2295,191]],"For each tree is known by its own fruit. For people don’t gather figs from thorns, nor do they gather grapes from a bramble bush."],["45",[["Ὁ",1,4],["ἀγαθὸς",114,16],["ἄνθρωπος",43,5],["ἐκ",21,1],["τοῦ",1,30],["ἀγαθοῦ",114,153],["θησαυροῦ",579,21],["τῆς",1,18],["καρδίας",64,19],["προφέρει",3936,87],["τὸ",1,32],["ἀγαθόν",114,29],["καὶ",2,8],["ὁ",1,4],["πονηρὸς",164,16],["ἐκ",21,1],["τοῦ",1,30],["πονηροῦ",164,153],["προφέρει",3936,87],["τὸ",1,32],["πονηρόν",164,29],["ἐκ",21,1],["γὰρ",40,8],["περισσεύματος",7970,24],["καρδίας",64,19],["λαλεῖ",50,87],["τὸ",1,27],["στόμα",123,20],["αὐτοῦ",3,48]],"The good man out of the good treasure of his heart brings out that which is good, and the evil man out of the evil treasure of his heart brings out that which is evil, for out of the abundance of the heart, his mouth speaks."],["46",[["τί",10010,119],["δέ",14,8],["με",9994,161],["καλεῖτε",128,84],["κύριε",7,250],["κύριε",7,250],["καὶ",2,8],["οὐ",12,12],["ποιεῖτε",23,84],["ἃ",24,755],["λέγω",31,149]],"“Why do you call me, ‘Lord, Lord,’ and don’t do the things which I say?"],["47",[["Πᾶς",11,16],["ὁ",1,4],["ἐρχόμενος",55,723],["πρός",15,1],["με",9994,161],["καὶ",2,8],["ἀκούων",54,67],["μου",9994,146],["τῶν",1,76],["λόγων",48,77],["καὶ",2,8],["ποιῶν",23,67],["αὐτούς",3,60],["ὑποδείξω",1239,157],["ὑμῖν",5,86],["τίνι",10010,784],["ἐστὶν",10,87],["ὅμοιος",657,16]],"Everyone who comes to me, and hears my words and does them, I will show you who he is like."],["48",[["ὅμοιός",657,16],["ἐστιν",10,87],["ἀνθρώπῳ",43,113],["οἰκοδομοῦντι",126,390],["οἰκίαν",233,10],["ὃς",24,246],["ἔσκαψεν",8253,3],["καὶ",2,8],["ἐβάθυνεν",5484,3],["καὶ",2,8],["ἔθηκεν",110,3],["θεμέλιον",950,7],["ἐπὶ",9,1],["τὴν",1,9],["πέτραν",548,10],["πλημμύρης",7992,19],["δὲ",14,8],["γενομένης",30,760],["προσέρηξεν",10351,3],["ὁ",1,4],["ποταμὸς",249,5],["τῇ",1,95],["οἰκίᾳ",233,2],["ἐκείνῃ",80,200],["καὶ",2,8],["οὐκ",12,12],["ἴσχυσεν",567,3],["σαλεῦσαι",678,100],["αὐτὴν",3,98],["διὰ",56,1],["τὸ",1,32],["καλῶς",1273,17],["οἰκοδομῆσθαι",126,825],["αὐτήν",3,98]],"He is like a man building a house, who dug and went deep and laid a foundation on the rock. When a flood arose, the stream broke against that house, and could not shake it, because it was founded on the rock."],["49",[["Ὁ",1,4],["δὲ",14,8],["ἀκούσας",54,155],["καὶ",2,8],["μὴ",25,12],["ποιήσας",23,155],["ὅμοιός",657,16],["ἐστιν",10,87],["ἀνθρώπῳ",43,113],["οἰκοδομήσαντι",126,354],["οἰκίαν",233,10],["ἐπὶ",9,1],["τὴν",1,9],["γῆν",26,10],["χωρὶς",2046,1],["θεμελίου",950,21],["ᾗ",24,102],["προσέρηξεν",10351,3],["ὁ",1,4],["ποταμός",249,5],["καὶ",2,8],["εὐθὺς",1673,17],["συνέπεσεν",2384,3],["καὶ",2,8],["ἐγένετο",30,737],["τὸ",1,27],["ῥῆγμα",4150,20],["τῆς",1,18],["οἰκίας",233,19],["ἐκείνης",80,290],["μέγα",66,28]],"But he who hears and doesn’t do, is like a man who built a house on the earth without a foundation, against which the stream broke, and immediately it fell; and the ruin of that house was great.”"]]