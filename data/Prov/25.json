[["1",[["Αὗται",16,196],["αἱ",1,185],["παιδεῖαι",571,180],["Σαλωμῶντος",0,0],["αἱ",1,185],["ἀδιάκριτοι",8753,187],["ἃς",24,186],["ἐξεγράψαντο",9280,184],["οἱ",1,128],["φίλοι",336,130],["Ἐζεκίου",456,21],["τοῦ",1,30],["βασιλέως",22,21],["τῆς",1,18],["Ἰουδαίας",492,19]],"These are the miscellaneous instructions of Solomon, which the friends of Ezekias king of Judea copied out."],["2",[["Δόξα",141,188],["Θεοῦ",20,21],["κρύπτει",372,87],["λόγον",48,7],["δόξα",141,188],["δὲ",14,12],["βασιλέως",22,21],["τιμᾷ",1020,173],["πράγματα",511,63]],"The glory of God conceals a matter: but the glory of a king honours business."],["3",[["Οὐρανὸς",94,5],["ὑψηλὸς",289,16],["γῆ",26,13],["δὲ",14,12],["βαθεῖα",1880,15],["καρδία",64,13],["δὲ",14,12],["βασιλέως",22,5],["ἀνεξέλεγκτος",6275,16]],"Heaven is high, and earth is deep, and a king's heart is unsearchable."],["4",[["Τύπτε",1209,239],["ἀδόκιμον",6231,28],["ἀργύριον",152,20],["καὶ",2,8],["καθαρισθήσεται",482,125],["καθαρὸν",379,29],["ἅπαν",772,29]],"Beat the drossy silver, and it shall be made entirely pure."],["5",[["Κτεῖνε",4869,239],["ἀσεβεῖς",247,130],["ἐκ",21,1],["προσώπου",47,24],["βασιλέως",22,21],["καὶ",2,8],["κατορθώσει",1471,120],["ἐν",4,1],["δικαιοσύνῃ",187,2],["ὁ",1,4],["θρόνος",383,5],["αὐτοῦ",3,48]],"Slay the ungodly from before the king, and his throne shall prosper in righteousness."],["6",[["Μὴ",25,8],["ἀλαζονεύου",6243,665],["ἐνώπιον",115,1],["βασιλέως",22,21],["μηδὲ",414,12],["ἐν",4,1],["τόποις",99,139],["δυναστῶν",803,77],["ὑφίστασο",1538,355]],"Be not boastful in the presence of the king, and remain not in the places of princes;"],["7",[["Κρεῖσσον",922,29],["γάρ",40,12],["σοι",5,151],["τὸ",1,32],["ῥηθῆναι",18,175],["ἀνάβαινε",88,239],["πρὸς",15,1],["μὲ",6,82],["ἢ",61,8],["ταπεινῶσαί",322,100],["σε",5,161],["ἐν",4,1],["προσώπῳ",47,53],["δυνάστου",803,21],["ἃ",1,11],["εἶδον",53,147],["οἱ",1,128],["ὀφθαλμοί",91,51],["σου",5,146],["λέγε",31,239]],"for [it is] better for thee that it should be said, Come up to me, than that [one] should humble thee in the presence of the prince; speak of that which thine eyes have seen."],["8",[["Μὴ",25,8],["πρόσπιπτε",1737,239],["εἰς",8,1],["μάχην",1382,10],["ταχέως",1563,17],["ἵνα",102,8],["μὴ",25,8],["μεταμεληθῇς",3587,528],["ἐπʼ",9,1],["ἐσχάτων",410,115],["ἡνίκα",543,17],["ἄν",83,12],["σε",5,161],["ὀνειδίσῃ",945,116],["ὁ",1,4],["σὸς",405,5],["φίλος",336,16]],"Get not suddenly into a quarrel, lest thou repent at last. Whenever thy friend shall reproach thee,",{"s":"r"}],["9",[["ἀναχώρει",2516,14],["εἰς",8,1],["τὰ",1,42],["ὀπίσω",167,17],["μὴ",25,8],["καταφρόνει",1677,239]],"retreat backward, despise [him] not;",{"s":"r"}],["10",[["μή",25,8],["σε",5,161],["ὀνειδίσῃ",945,116],["μὲν",281,12],["ὁ",1,4],["φίλος",336,16],["ἡ",1,11],["δὲ",14,12],["μάχη",1382,13],["σου",5,146],["καὶ",2,8],["ἡ",1,11],["ἔχθρα",1802,13],["οὐκ",12,17],["ἀπέσται",2818,89],["ἀλλὰ",108,17],["ἔσται",10,89],["σοι",5,151],["ἴση",944,15],["θανάτῳ",170,113]],"lest thy friend continue to reproach thee, so thy quarrel and enmity shall not depart, but shall be to thee like death."],["10a",[["χάρις",368,13],["καὶ",2,8],["φιλία",1253,13],["ἐλευθεροῖ",5298,87],["ἃς",24,186],["τήρησον",1358,198],["σεαυτῷ",255,49],["ἵνα",102,8],["μὴ",25,8],["ἐπονείδιστος",4097,16],["γένῃ",30,277],["ἀλλὰ",108,17],["φύλαξον",125,198],["τὰς",1,39],["ὁδούς",68,40],["σου",5,146],["εὐσυναλλάκτως",7187,17]],"Favour and friendship set [a man] free, which do thou keep for thyself, lest thou be made liable to reproach; but take heed to thy ways peaceably."],["11",[["Μῆλον",2923,20],["χρυσοῦν",290,28],["ἐν",4,1],["ὁρμίσκῳ",4130,113],["σαρδίου",3367,24],["οὕτως",71,17],["εἰπεῖν",18,100],["λόγον",48,7]],"[As] a golden apple in a necklace of sardius, so [is it] to speak a [wise] word."],["12",[["Εἰς",8,1],["ἐνώτιον",1993,20],["χρυσοῦν",290,28],["καὶ",2,8],["σάρδιον",3367,20],["πολυτελὲς",2282,28],["δέδεται",440,182],["λόγος",48,5],["σοφὸς",324,16],["εἰς",8,1],["εὐήκοον",5630,28],["οὖς",328,20]],"In an ear-ring of gold a precious sardius is also set; [so is] a wise word to an obedient ear."],["13",[["Ὥσπερ",226,17],["ἔξοδος",762,13],["χιόνος",1646,19],["ἐν",4,1],["ἀμητῷ",1700,113],["κατὰ",32,1],["καῦμα",1892,33],["ὠφελεῖ",1499,87],["οὕτως",71,17],["ἄγγελος",208,5],["πιστὸς",750,16],["τοὺς",1,56],["ἀποστείλαντας",84,458],["αὐτόν",3,82],["ψυχὰς",63,40],["γὰρ",40,12],["τῶν",1,76],["αὐτῷ",3,49],["χρωμένων",928,295],["ὠφελεῖ",1499,87]],"As a fall of snow in the time of harvest is good against heat, so a faithful messenger [refreshes] those that send him; for he helps the souls of his employers."],["14",[["Ὥσπερ",226,17],["ἄνεμοι",850,51],["καὶ",2,8],["νέφη",1555,63],["καὶ",2,8],["ὑετοὶ",676,51],["ἐπιφανέστατα",1866,17],["οὕτως",71,17],["ὁ",1,4],["καυχώμενος",1380,114],["ἐπὶ",9,1],["δόσει",1766,188],["ψευδεῖ",549,345]],"As winds and clouds and rains are most evident [objects], so is he that boasts of a false gift."],["15",[["Ἐν",4,1],["μακροθυμίᾳ",3887,2],["εὐοδία",3233,13],["βασιλεῦσι",22,139],["γλῶσσα",388,13],["δὲ",14,12],["μαλακὴ",4895,15],["συντρίβει",268,87],["ὀστᾶ",473,63]],"In long-suffering is prosperity to kings, and a soft tongue breaks the bones."],["16",[["Μέλι",807,20],["εὑρὼν",101,155],["φάγε",147,198],["τὸ",1,32],["ἱκανὸν",1007,29],["μή",25,8],["ποτε",458,12],["πλησθεὶς",909,206],["ἐξεμέσῃς",4590,170]],"Having found honey, eat [only] what is enough, lest haply thou be filled, and vomit it up."],["17",[["Σπάνιον",8274,28],["εἴσαγε",389,239],["σὸν",405,7],["πόδα",210,7],["πρὸς",15,1],["σεαυτοῦ",255,48],["φίλον",336,59],["μή",25,8],["ποτε",458,12],["πλησθείς",909,206],["σου",5,146],["μισήσῃ",351,116],["σε",5,161]],"Enter sparingly into thy friend's house, lest he be satiated with thy company, and hate thee."],["18",[["Ῥόπαλον",9979,20],["καὶ",2,8],["μάχαιρα",342,13],["καὶ",2,8],["τόξευμα",2392,20],["ἀκιδωτὸν",8775,20],["οὕτως",71,17],["καὶ",2,8],["ἀνὴρ",38,5],["ὁ",1,4],["καταμαρτυρῶν",3278,67],["τοῦ",1,30],["φίλου",336,153],["αὐτοῦ",3,48],["μαρτυρίαν",2737,10],["ψευδῆ",549,37]],"[As] a club, and a dagger, and a pointed arrow, so also is a man who bears false witness against his friend."],["19",[["Οδὸς",68,105],["κακοῦ",161,88],["καὶ",2,8],["ποὺς",210,5],["παρανόμου",830,153],["ὀλεῖται",1806,89],["ἐν",4,1],["ἡμέρᾳ",28,2],["κακῇ",161,96]],"The way of the wicked and the foot of the transgressor shall perish in an evil day."],["20",[["Ὥσπερ",226,17],["ὄξος",4132,33],["ἕλκει",1217,87],["ἀσύμφορον",9131,29],["οὕτως",71,17],["προσπεσὸν",1737,526],["πάθος",808,33],["ἐν",4,1],["σώματι",454,53],["καρδίαν",64,10],["λυπεῖ",936,87]],"As vinegar is bad for a sore, so trouble befalling the body afflicts the heart."],["20a",[["ὥσπερ",226,17],["σὴς",2118,5],["ἐν",4,1],["ἱματίῳ",276,53],["καὶ",2,8],["σκώληξ",1974,5],["ξύλῳ",196,53],["οὕτως",71,17],["λύπη",1075,13],["ἀνδρὸς",38,21],["βλάπτει",3251,87],["καρδίαν",64,10]],"As a moth in a garment, and a worm in wood, so the grief of a man hurts the heart."],["21",[["Ἐὰν",45,8],["πεινᾷ",1045,173],["ὁ",1,4],["ἐχθρός",135,5],["σου",5,146],["ψώμιζε",1793,239],["αὐτὸν",3,82],["ἐὰν",45,8],["διψᾷ",2346,105],["πότιζε",790,239],["αὐτόν",3,82]],"If thine enemy hunger, feed him; if he thirst, give him drink;"],["22",[["Τοῦτο",16,122],["γὰρ",40,12],["ποιῶν",23,67],["ἄνθρακας",1402,31],["πυρὸς",118,24],["σωρεύσεις",6132,159],["ἐπὶ",9,1],["τὴν",1,9],["κεφαλὴν",144,10],["αὐτοῦ",3,48],["ὁ",1,4],["δὲ",14,12],["Κύριος",7,5],["ἀνταποδώσει",666,120],["σοι",5,151],["ἀγαθά",114,65]],"for so doing thou shalt heap coals of fire upon his head, and the Lord shall reward thee [with] good."],["23",[["Ἄνεμος",850,5],["Βορέας",387,5],["ἐξεγείρει",656,87],["νέφη",1555,63],["πρόσωπον",47,33],["δὲ",14,12],["ἀναιδὲς",2305,29],["γλῶσσαν",388,10],["ἐρεθίζει",4101,87]],"The north wind raises clouds; so an impudent face provokes the tongue."],["24",[["Κρεῖσσον",922,29],["οἰκεῖν",528,54],["ἐπὶ",9,1],["γωνίας",1377,19],["δώματος",1467,24],["ἢ",61,8],["μετὰ",29,1],["γυναικὸς",59,19],["λοιδόρου",4296,21],["ἐν",4,1],["οἰκίᾳ",233,2],["κοινῇ",1515,96]],"[It is] better to dwell on a corner of the roof, than with a railing woman in an open house."],["25",[["Ὥσπερ",226,17],["ὕδωρ",85,33],["ψυχρὸν",5155,29],["ψυχῇ",63,2],["διψώσῃ",1161,210],["προσηνὲς",8098,675],["οὕτως",71,17],["ἀγγελία",2301,356],["ἀγαθὴ",114,675],["ἐκ",21,1],["γῆς",26,19],["μακρόθεν",1249,17]],"As cold water is agreeable to a thirsting soul, so is a good message from a land far off."],["26",[["Ὥσπερ",226,17],["εἴ",77,8],["τις",39,150],["πηγὴν",565,10],["φράσσοι",6184,273],["καὶ",2,8],["ὕδατος",85,24],["ἔξοδον",762,10],["λυμαίνοιτο",2462,664],["οὕτως",71,17],["ἄκοσμον",6377,28],["δίκαιον",153,28],["πεπτωκέναι",154,107],["ἐνώπιον",115,1],["ἀσεβοῦς",247,153]],"As if one should stop a well, and corrupt a spring of water, so [is it] unseemly for a righteous man to fall before an ungodly man."],["27",[["Ἐσθίειν",147,54],["μέλι",807,20],["πολὺ",74,28],["οὐ",12,17],["καλὸν",266,28],["τιμᾷν",1020,54],["δὲ",14,12],["χρὴ",6211,87],["λόγους",48,31],["ἐνδόξους",732,58]],"[It is] not good to eat much honey; but it is right to honour venerable sayings."],["28",[["Ὥσπερ",226,17],["πόλις",41,13],["τὰ",1,42],["τείχη",325,43],["καταβεβλημένη",1074,197],["καὶ",2,8],["ἀτείχιστος",6352,16],["οὕτως",71,17],["ἀνὴρ",38,5],["ὃς",24,246],["οὐ",12,17],["μετὰ",29,1],["βουλῆς",350,19],["τι",39,119],["πράσσει",1251,87]],"As a city whose walls are broken down, and which is unfortified, so is a man who does anything without counsel."]]