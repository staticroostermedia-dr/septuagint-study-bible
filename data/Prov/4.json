[["1",[["Ἀκούσατε",54,69],["παῖδες",127,51],["παιδείαν",571,10],["πατρὸς",44,21],["καὶ",2,8],["προσέχετε",558,307],["γνῶναι",79,100],["ἔννοιαν",2323,10]],"Hear, ye children, the instruction of a father, and attend to know understanding."],["2",[["Δῶρον",348,20],["γὰρ",40,12],["ἀγαθὸν",114,28],["δωροῦμαι",3821,251],["ὑμῖν",5,86],["τὸν",1,6],["ἐμὸν",525,7],["νόμον",140,7],["μὴ",25,8],["ἐγκαταλίπητε",364,118]],"For I give you a good gift; forsake ye not my law."],["3",[["Υἱὸς",13,5],["γὰρ",40,12],["ἐγενόμην",30,152],["κᾀγὼ",613,105],["πατρὶ",44,113],["ὑπήκοος",4141,16],["καὶ",2,8],["ἀγαπώμενος",214,114],["ἐν",4,1],["προσώπῳ",47,53],["μητρός",189,19]],"For I also was a son obedient to [my] father, and loved in the sight of [my] mother:"],["4",[["Οἳ",1,128],["ἔλεγον",31,129],["καὶ",2,8],["ἐδίδασκόν",545,129],["με",6,82],["ἐρειδέτω",2838,35],["ὁ",1,4],["ἡμέτερος",1712,5],["λόγος",48,5],["εἰς",8,1],["σὴν",405,10],["καρδίαν",64,10],["φύλασσε",125,239],["ἐντολὰς",259,40]],"who spoke and instructed me, [saying], Let our speech be fixed in thine heart, keep [our] commandments, forget them not:"],["5",[["μὴ",25,8],["ἐπιλάθῃ",513,160],["Μηδὲ",414,12],["παρίδῃς",2276,170],["ῥῆσιν",3028,10],["ἐμοῦ",6,48],["στόματος",123,24]],"and do not neglect the speech of my mouth."],["6",[["μηδὲ",414,12],["ἐγκαταλίπῃς",364,170],["αὐτὴν",3,98],["καὶ",2,8],["ἀνθέξεταί",1852,89],["σου",5,146],["ἐράσθητι",6561,242],["αὐτῆς",3,83],["καὶ",2,8],["τηρήσει",3147,2],["σε",5,161]],"And forsake it not, and it shall cleave to thee: love it, and it shall keep thee."],["8",[["Περιχαράκωσον",5938,198],["αὐτὴν",3,98],["καὶ",2,8],["ὑψώσει",331,120],["σε",5,161],["τίμησον",1020,198],["αὐτὴν",3,98],["ἵνα",102,8],["σε",5,161],["περιλάβῃ",2477,160]],"Secure it, and it shall exalt thee: honour it, that it may embrace thee;"],["9",[["Ἵνα",102,8],["δῷ",33,160],["τῇ",1,95],["σῇ",405,2],["κεφαλῇ",144,2],["στέφανον",980,7],["χαρίτων",368,61],["στεφάνῳ",980,113],["δὲ",14,12],["τρυφῆς",1643,19],["ὑπερασπίσῃ",1716,116],["σου",5,146]],"that it may give unto thy head a crown of graces, and may cover thee with a crown of delight."],["10",[["Ἄκουε",54,239],["υἱὲ",13,250],["καὶ",2,8],["δέξαι",815,275],["ἐμοὺς",525,31],["λόγους",48,31],["καὶ",2,8],["πληθυνθήσεται",316,125],["ἔτη",81,43],["ζωῆς",216,19],["σου",5,146],["ἵνα",102,8],["σοι",5,151],["γένωνται",30,222],["πολλαὶ",74,187],["ὁδοὶ",68,180],["βίου",726,21]],"Hear, [my] son, and receive my words; and the years of thy life shall be increased, that the resources of thy life may be many."],["11",[["Ὁδοὺς",68,40],["γὰρ",40,12],["σοφίας",242,40],["διδάσκω",545,149],["σε",5,161],["ἐμβιβάζω",9353,149],["δέ",14,12],["σε",5,161],["τροχιαῖς",3374,71],["ὀρθαῖς",1537,287]],"For I teach thee the ways of wisdom; and I cause thee to go in right paths."],["12",[["Ἐὰν",45,8],["γὰρ",40,12],["πορεύῃ",49,166],["οὐ",12,17],["συγκλεισθήσεταί",1147,125],["σου",5,146],["τὰ",1,42],["διαβήματα",2077,43],["ἐὰν",45,8],["δὲ",14,12],["τρέχῃς",820,199],["οὐ",12,17],["κοπιάσεις",921,159]],"For when thou goest, thy steps shall not be straitened; and when thou runnest, thou shalt not be distressed."],["13",[["Ἐπιλαβοῦ",1086,275],["ἐμῆς",525,19],["παιδείας",571,19],["μὴ",25,8],["ἀφῇς",501,170],["ἀλλὰ",108,17],["φύλαξον",125,198],["αὐτὴν",3,98],["σεαυτῷ",255,49],["εἰς",8,1],["ζωήν",216,10],["σου",5,146]],"Take hold of my instruction; let it not go,—but keep it for thyself for thy life."],["14",[["Ὁδοὺς",68,40],["ἀσεβῶν",247,163],["μὴ",25,8],["ἐπέλθῃς",542,170],["μηδὲ",414,12],["ζηλώσῃς",1057,170],["ὁδοὺς",68,40],["παρανόμων",830,163]],"Go not in the ways of the ungodly, neither covet the ways of transgressors."],["15",[["Ἐν",4,1],["ᾧ",24,202],["ἂν",83,12],["τόπῳ",99,113],["στρατοπεδεύσωσι",2491,224],["μὴ",25,8],["ἐπέλθῃς",542,170],["ἐκεὶ",76,17],["ἔκκλινον",394,198],["δὲ",14,12],["ἀπʼ",17,1],["αὐτῶν",3,41],["καὶ",2,8],["παράλλαξον",3320,198]],"In whatever place they shall pitch their camp, go not thither; but turn from them, and pass away."],["16",[["Οὐ",12,17],["γὰρ",40,12],["μὴ",25,8],["ὑπνώσωσιν",1664,224],["ἐὰν",45,8],["μὴ",25,8],["κακοποιήσωσιν",1511,224],["ἀφῄρηται",369,182],["ὁ",1,4],["ὕπνος",1010,5],["αὐτῶν",3,41],["καὶ",2,8],["οὐ",12,17],["κοιμῶνται",301,299]],"For they cannot sleep, unless they have done evil: their sleep is taken away, and they rest not."],["17",[["Οἵδε",129,213],["γὰρ",40,12],["σιτοῦνται",6053,299],["σῖτα",665,63],["ἀσεβείας",722,40],["οἴνῳ",261,113],["δὲ",14,12],["παρανόμῳ",830,111],["μεθύσκονται",1276,299]],"For these live upon the bread of ungodliness, and are drunken with wine of transgression."],["18",[["Αἱ",1,185],["δὲ",14,12],["ὁδοὶ",68,180],["τῶν",1,76],["δικαίων",153,163],["ὁμοίως",1757,17],["φωτὶ",380,113],["λάμπουσι",3291,191],["προπορεύονται",1281,299],["καὶ",2,8],["φωτίζουσιν",1230,191],["ἕως",42,8],["κατορθώσῃ",1471,116],["ἡ",1,11],["ἡμέρα",28,13]],"But the ways of the righteous shine like light; they go on and shine, until the day be fully come."],["19",[["Αἱ",1,185],["δὲ",14,12],["ὁδοὶ",68,180],["τῶν",1,76],["ἀσεβῶν",247,163],["σκοτειναὶ",2378,187],["οὐκ",12,17],["οἴδασι",1168,400],["πῶς",441,12],["προσκόπτουσιν",2759,191]],"But the ways of the ungodly are dark; they know not how they stumble."],["20",[["Υἱὲ",13,250],["ἐμῇ",525,2],["ῥήσει",3028,2],["πρόσεχε",558,239],["τοῖς",1,138],["δὲ",14,12],["ἐμοῖς",525,139],["λόγοις",48,139],["παράβαλλε",2930,239],["σὸν",405,20],["οὖς",328,20]],"[My] son, attend to my speech; and apply thine ear to my words:"],["21",[["Ὅπως",240,8],["μὴ",25,8],["ἐκλίπωσί",321,224],["σε",5,161],["αἱ",1,185],["πηγαί",565,180],["σου",5,146],["φύλασσε",125,239],["αὐτὰς",3,221],["ἐν",4,1],["καρδίᾳ",64,2]],"that thy fountains may not fail thee; keep them in [thine] heart."],["22",[["Ζωὴ",216,13],["γάρ",40,12],["ἐστι",10,87],["τοῖς",1,138],["εὑρίσκουσιν",101,352],["αὐτὰς",3,221],["καὶ",2,8],["πάσῃ",11,96],["σαρκὶ",287,2],["ἴασις",1463,13]],"For they are life to those that find them, and health to all [their] flesh."],["23",[["Πάσῃ",11,96],["φυλακῇ",485,2],["τήρει",1358,239],["σὴν",405,10],["καρδίαν",64,10],["ἐκ",21,1],["γὰρ",40,12],["τούτων",16,214],["ἔξοδοι",762,180],["ζωῆς",216,19]],"Keep thine heart with the utmost care; for out of these are the issues of life."],["24",[["Περίελε",863,198],["σεαυτοῦ",255,48],["σκολιὸν",1690,28],["στόμα",123,20],["καὶ",2,8],["ἄδικα",406,74],["χείλη",361,63],["μακρὰν",642,37],["ἀπὸ",17,1],["σοῦ",5,146],["ἄπωσαι",770,275]],"Remove from thee a froward mouth, and put far away from thee unjust lips."],["25",[["Οἱ",1,128],["ὀφθαλμοί",91,51],["σου",5,146],["ὀρθὰ",1537,74],["βλεπέτωσαν",470,55],["τὰ",1,253],["δὲ",14,12],["βλέφαρά",2867,63],["σου",5,146],["νευέτω",5858,35],["δίκαια",153,74]],"Let thine eyes look right on, and let thine eyelids assent [to] just [things]."],["26",[["Ὀρθὰς",1537,109],["τροχιὰς",3374,40],["ποίει",23,239],["σοῖς",405,139],["ποσί",210,139],["καὶ",2,8],["τὰς",1,39],["ὁδούς",68,40],["σου",5,146],["κατεύθυνε",827,239]],"Make straight paths for thy feet, and order thy ways aright."],["27",[["Μὴ",25,8],["ἐκκλίνῃς",394,170],["εἰς",8,1],["τὰ",1,42],["δεξιὰ",282,65],["μηδὲ",414,12],["εἰς",8,1],["τὰ",1,42],["ἀριστερά",878,65],["ἀπόστρεψον",130,198],["δὲ",14,12],["σὸν",405,7],["πόδα",210,7],["ἀπὸ",17,1],["ὁδοῦ",68,19],["κακῆς",161,78]],"Turn not aside to the right hand nor to the left, but turn away thy foot from an evil way:"],["27a",[["ὁδοὺς",68,40],["γὰρ",40,12],["τὰς",1,39],["ἐκ",21,1],["δεξιῶν",282,79],["οἶδεν",53,165],["ὁ",1,4],["Θεὸς",20,5],["διεστραμμέναι",1322,424],["δέ",14,12],["εἰσιν",10,191],["αἱ",1,185],["ἐξ",21,1],["ἀριστερῶν",878,79]],"[for God knows the ways on the right hand, but those on the left are crooked:]"],["27b",[["αὐτὸς",3,158],["δὲ",14,12],["ὀρθὰς",1537,109],["ποιήσει",23,120],["τὰς",1,39],["τροχιάς",3374,40],["σου",5,146],["τὰς",1,39],["δὲ",14,12],["πορείας",1476,40],["σου",5,146],["ἐν",4,1],["εἰρήνῃ",213,2],["προάξει",2482,120]],"and he will make thy ways straight, and will guide thy steps in peace."]]