[["1",[["Ἀκούσατε",53,69],["παῖδες",126,51],["παιδείαν",569,10],["πατρὸς",44,21],["καὶ",2,8],["προσέχετε",557,311],["γνῶναι",81,100],["ἔννοιαν",2335,10]],"Hear, ye children, the instruction of a father, and attend to know understanding."],["2",[["Δῶρον",347,20],["γὰρ",40,12],["ἀγαθὸν",113,28],["δωροῦμαι",4787,252],["ὑμῖν",5,86],["τὸν",1,6],["ἐμὸν",523,7],["νόμον",140,7],["μὴ",25,8],["ἐγκαταλίπητε",363,118]],"For I give you a good gift; forsake ye not my law."],["3",[["Υἱὸς",13,5],["γὰρ",40,12],["ἐγενόμην",30,152],["κᾀγὼ",611,105],["πατρὶ",44,113],["ὑπήκοος",4152,16],["καὶ",2,8],["ἀγαπώμενος",224,114],["ἐν",4,1],["προσώπῳ",47,53],["μητρός",188,19]],"For I also was a son obedient to [my] father, and loved in the sight of [my] mother:"],["4",[["Οἳ",1,128],["ἔλεγον",31,129],["καὶ",2,8],["ἐδίδασκόν",543,129],["με",6,82],["ἐρειδέτω",2852,35],["ὁ",1,4],["ἡμέτερος",1713,5],["λόγος",48,5],["εἰς",8,1],["σὴν",401,10],["καρδίαν",63,10],["φύλασσε",127,239],["ἐντολὰς",259,40]],"who spoke and instructed me, [saying], Let our speech be fixed in thine heart, keep [our] commandments, forget them not:"],["5",[["μὴ",25,8],["ἐπιλάθῃ",512,160],["Μηδὲ",412,12],["παρίδῃς",2289,170],["ῥῆσιν",3040,10],["ἐμοῦ",6,48],["στόματος",123,24]],"and do not neglect the speech of my mouth."],["6",[["μηδὲ",412,12],["ἐγκαταλίπῃς",363,170],["αὐτὴν",3,98],["καὶ",2,8],["ἀνθέξεταί",1851,89],["σου",5,146],["ἐράσθητι",6600,242],["αὐτῆς",3,83],["καὶ",2,8],["τηρήσει",3155,2],["σε",5,161]],"And forsake it not, and it shall cleave to thee: love it, and it shall keep thee."],["8",[["Περιχαράκωσον",5968,243],["αὐτὴν",3,98],["καὶ",2,8],["ὑψώσει",327,120],["σε",5,161],["τίμησον",1043,243],["αὐτὴν",3,98],["ἵνα",101,8],["σε",5,161],["περιλάβῃ",2484,160]],"Secure it, and it shall exalt thee: honour it, that it may embrace thee;"],["9",[["Ἵνα",101,8],["δῷ",33,160],["τῇ",1,95],["σῇ",401,2],["κεφαλῇ",144,2],["στέφανον",979,7],["χαρίτων",366,61],["στεφάνῳ",979,113],["δὲ",14,12],["τρυφῆς",1642,19],["ὑπερασπίσῃ",1755,116],["σου",5,146]],"that it may give unto thy head a crown of graces, and may cover thee with a crown of delight."],["10",[["Ἄκουε",53,239],["υἱὲ",13,251],["καὶ",2,8],["δέξαι",813,275],["ἐμοὺς",523,31],["λόγους",48,31],["καὶ",2,8],["πληθυνθήσεται",315,125],["ἔτη",80,43],["ζωῆς",212,19],["σου",5,146],["ἵνα",101,8],["σοι",5,151],["γένωνται",30,222],["πολλαὶ",74,185],["ὁδοὶ",67,179],["βίου",726,21]],"Hear, [my] son, and receive my words; and the years of thy life shall be increased, that the resources of thy life may be many."],["11",[["Ὁδοὺς",67,40],["γὰρ",40,12],["σοφίας",238,40],["διδάσκω",543,149],["σε",5,161],["ἐμβιβάζω",9421,149],["δέ",14,12],["σε",5,161],["τροχιαῖς",3379,71],["ὀρθαῖς",1536,290]],"For I teach thee the ways of wisdom; and I cause thee to go in right paths."],["12",[["Ἐὰν",45,8],["γὰρ",40,12],["πορεύῃ",49,166],["οὐ",12,17],["συγκλεισθήσεταί",1147,125],["σου",5,146],["τὰ",1,42],["διαβήματα",2082,43],["ἐὰν",45,8],["δὲ",14,12],["τρέχῃς",818,199],["οὐ",12,17],["κοπιάσεις",935,159]],"For when thou goest, thy steps shall not be straitened; and when thou runnest, thou shalt not be distressed."],["13",[["Ἐπιλαβοῦ",1087,275],["ἐμῆς",523,19],["παιδείας",569,19],["μὴ",25,8],["ἀφῇς",504,170],["ἀλλὰ",107,17],["φύλαξον",127,198],["αὐτὴν",3,98],["σεαυτῷ",293,49],["εἰς",8,1],["ζωήν",212,10],["σου",5,146]],"Take hold of my instruction; let it not go,—but keep it for thyself for thy life."],["14",[["Ὁδοὺς",67,40],["ἀσεβῶν",246,163],["μὴ",25,8],["ἐπέλθῃς",540,170],["μηδὲ",412,12],["ζηλώσῃς",1116,170],["ὁδοὺς",67,40],["παρανόμων",832,163]],"Go not in the ways of the ungodly, neither covet the ways of transgressors."],["15",[["Ἐν",4,1],["ᾧ",24,202],["ἂν",82,12],["τόπῳ",99,113],["στρατοπεδεύσωσι",2633,224],["μὴ",25,8],["ἐπέλθῃς",540,170],["ἐκεὶ",76,17],["ἔκκλινον",393,198],["δὲ",14,12],["ἀπʼ",17,1],["αὐτῶν",3,41],["καὶ",2,8],["παράλλαξον",3612,243]],"In whatever place they shall pitch their camp, go not thither; but turn from them, and pass away."],["16",[["Οὐ",12,17],["γὰρ",40,12],["μὴ",25,8],["ὑπνώσωσιν",1665,224],["ἐὰν",45,8],["μὴ",25,8],["κακοποιήσωσιν",1510,224],["ἀφῄρηται",367,372],["ὁ",1,4],["ὕπνος",1010,5],["αὐτῶν",3,41],["καὶ",2,8],["οὐ",12,17],["κοιμῶνται",302,303]],"For they cannot sleep, unless they have done evil: their sleep is taken away, and they rest not."],["17",[["Οἵδε",129,213],["γὰρ",40,12],["σιτοῦνται",6081,303],["σῖτα",660,63],["ἀσεβείας",722,40],["οἴνῳ",261,113],["δὲ",14,12],["παρανόμῳ",832,111],["μεθύσκονται",1274,303]],"For these live upon the bread of ungodliness, and are drunken with wine of transgression."],["18",[["Αἱ",1,183],["δὲ",14,12],["ὁδοὶ",67,179],["τῶν",1,76],["δικαίων",152,163],["ὁμοίως",1754,17],["φωτὶ",376,113],["λάμπουσι",3296,189],["προπορεύονται",1280,303],["καὶ",2,8],["φωτίζουσιν",1232,189],["ἕως",42,8],["κατορθώσῃ",1471,116],["ἡ",1,11],["ἡμέρα",28,13]],"But the ways of the righteous shine like light; they go on and shine, until the day be fully come."],["19",[["Αἱ",1,183],["δὲ",14,12],["ὁδοὶ",67,179],["τῶν",1,76],["ἀσεβῶν",246,163],["σκοτειναὶ",2386,185],["οὐκ",12,17],["οἴδασι",1145,406],["πῶς",440,12],["προσκόπτουσιν",2769,189]],"But the ways of the ungodly are dark; they know not how they stumble."],["20",[["Υἱὲ",13,251],["ἐμῇ",523,2],["ῥήσει",3040,2],["πρόσεχε",557,239],["τοῖς",1,138],["δὲ",14,12],["ἐμοῖς",523,139],["λόγοις",48,139],["παράβαλλε",2943,239],["σὸν",401,20],["οὖς",325,20]],"[My] son, attend to my speech; and apply thine ear to my words:"],["21",[["Ὅπως",236,8],["μὴ",25,8],["ἐκλίπωσί",321,224],["σε",5,161],["αἱ",1,183],["πηγαί",563,179],["σου",5,146],["φύλασσε",127,239],["αὐτὰς",3,220],["ἐν",4,1],["καρδίᾳ",63,2]],"that thy fountains may not fail thee; keep them in [thine] heart."],["22",[["Ζωὴ",212,13],["γάρ",40,12],["ἐστι",10,87],["τοῖς",1,138],["εὑρίσκουσιν",106,357],["αὐτὰς",3,220],["καὶ",2,8],["πάσῃ",11,96],["σαρκὶ",287,2],["ἴασις",1463,13]],"For they are life to those that find them, and health to all [their] flesh."],["23",[["Πάσῃ",11,96],["φυλακῇ",483,2],["τήρει",1356,239],["σὴν",401,10],["καρδίαν",63,10],["ἐκ",21,1],["γὰρ",40,12],["τούτων",16,214],["ἔξοδοι",758,179],["ζωῆς",212,19]],"Keep thine heart with the utmost care; for out of these are the issues of life."],["24",[["Περίελε",863,198],["σεαυτοῦ",293,48],["σκολιὸν",1693,28],["στόμα",123,20],["καὶ",2,8],["ἄδικα",402,74],["χείλη",361,63],["μακρὰν",638,37],["ἀπὸ",17,1],["σοῦ",5,146],["ἄπωσαι",767,275]],"Remove from thee a froward mouth, and put far away from thee unjust lips."],["25",[["Οἱ",1,128],["ὀφθαλμοί",91,51],["σου",5,146],["ὀρθὰ",1536,74],["βλεπέτωσαν",469,55],["τὰ",1,254],["δὲ",14,12],["βλέφαρά",2882,63],["σου",5,146],["νευέτω",5888,35],["δίκαια",152,74]],"Let thine eyes look right on, and let thine eyelids assent [to] just [things]."],["26",[["Ὀρθὰς",1536,109],["τροχιὰς",3379,40],["ποίει",23,239],["σοῖς",401,139],["ποσί",208,139],["καὶ",2,8],["τὰς",1,39],["ὁδούς",67,40],["σου",5,146],["κατεύθυνε",828,239]],"Make straight paths for thy feet, and order thy ways aright."],["27",[["Μὴ",25,8],["ἐκκλίνῃς",393,170],["εἰς",8,1],["τὰ",1,42],["δεξιὰ",282,65],["μηδὲ",412,12],["εἰς",8,1],["τὰ",1,42],["ἀριστερά",879,65],["ἀπόστρεψον",130,198],["δὲ",14,12],["σὸν",401,7],["πόδα",208,7],["ἀπὸ",17,1],["ὁδοῦ",67,19],["κακῆς",161,78]],"Turn not aside to the right hand nor to the left, but turn away thy foot from an evil way:"],["27a",[["ὁδοὺς",67,40],["γὰρ",40,12],["τὰς",1,39],["ἐκ",21,1],["δεξιῶν",282,79],["οἶδεν",73,165],["ὁ",1,4],["Θεὸς",20,5],["διεστραμμέναι",1322,462],["δέ",14,12],["εἰσιν",10,189],["αἱ",1,183],["ἐξ",21,1],["ἀριστερῶν",879,79]],"[for God knows the ways on the right hand, but those on the left are crooked:]"],["27b",[["αὐτὸς",3,158],["δὲ",14,12],["ὀρθὰς",1536,109],["ποιήσει",23,120],["τὰς",1,39],["τροχιάς",3379,40],["σου",5,146],["τὰς",1,39],["δὲ",14,12],["πορείας",1479,40],["σου",5,146],["ἐν",4,1],["εἰρήνῃ",210,2],["προάξει",2489,120]],"and he will make thy ways straight, and will guide thy steps in peace."]]