[["1",[["Υἱὲ",13,251],["ἐμῇ",523,2],["σοφίᾳ",238,2],["πρόσεχε",557,239],["ἐμοῖς",523,139],["δὲ",14,12],["λόγοις",48,139],["παράβαλλε",2943,239],["σὸν",401,20],["οὖς",325,20]],"[My] son, attend to my wisdom, and apply thine ear to my words;"],["2",[["ἵνα",101,8],["φυλάξῃς",127,170],["ἔννοιαν",2335,10],["ἀγαθήν",113,37],["αἴσθησις",1617,13],["δὲ",14,12],["ἐμῶν",523,45],["χειλέων",361,45],["ἐντέλλεταί",143,108],["σοι",5,151]],"that thou mayest keep good understanding, and the discretion of my lips gives thee a charge. Give no heed to a worthless woman;"],["3",[["Μὴ",25,8],["πρόσεχε",557,239],["φαύλῃ",2984,96],["γυναικί",58,2],["Μέλι",804,20],["γὰρ",40,12],["ἀποστάζει",2055,87],["ἀπὸ",17,1],["χειλέων",361,45],["γυναικὸς",58,19],["πόρνης",1146,19],["ἣ",1,11],["πρὸς",15,1],["καιρὸν",132,7],["λιπαίνει",5826,87],["σὸν",401,7],["φάρυγγα",2985,7]],"for honey drops from the lips of a harlot, who for a season pleases thy palate:"],["4",[["ὕστερον",2012,29],["μέντοι",3916,12],["πικρότερον",1077,29],["χολῆς",2136,19],["εὑρήσεις",106,159],["καὶ",2,8],["ἠκονημένον",0,0],["μᾶλλον",1040,17],["μαχαίρας",341,19],["διστόμου",4227,78]],"but afterwards thou wilt find her more bitter than gall, and sharper than a two-edged sword."],["5",[["Τῆς",1,18],["γὰρ",40,12],["ἀφροσύνης",1402,19],["οἱ",1,128],["πόδες",208,51],["κατάγουσι",741,189],["τοὺς",1,56],["χρωμένους",927,230],["αὐτῇ",3,99],["μετὰ",29,1],["θανάτου",169,21],["εἰς",8,1],["τὸν",1,6],["ᾅδην",583,7],["τὰ",1,42],["δὲ",14,12],["ἴχνη",1409,43],["αὐτῆς",3,83],["οὐκ",12,17],["ἐρείδεται",2852,108]],"For the feet of folly lead those who deal with her down to the grave with death; and her steps are not established."],["6",[["Ὁδοὺς",67,40],["γὰρ",40,12],["ζωῆς",212,19],["οὐκ",12,17],["ἐπέρχεται",540,108],["σφαλεραὶ",8512,185],["δὲ",14,12],["αἱ",1,183],["τροχιαὶ",3379,179],["αὐτῆς",3,83],["καὶ",2,8],["οὐκ",12,17],["εὔγνωστοι",4809,130]],"For she goes not upon the paths of life; but her ways are slippery, and not easily known."],["7",[["Νῦν",89,17],["οὖν",223,12],["υἱὲ",13,251],["ἄκουέ",53,239],["μου",6,48],["καὶ",2,8],["μὴ",25,8],["ἀκύρους",6409,58],["ποιήσεις",23,159],["ἐμοὺς",523,31],["λόγους",48,31]],"Now then, [my] son, hear me, and make not my words of none effect."],["8",[["Μακρὰν",638,37],["ποίησον",23,198],["ἀπʼ",17,1],["αὐτῆς",3,83],["σὴν",401,10],["ὁδόν",67,10],["μὴ",25,8],["ἐγγίσῃς",0,0],["πρὸς",15,1],["θύραις",277,71],["οἴκων",34,77],["αὐτῆς",3,83]],"Remove thy way far from her; draw not near to the doors of her house:"],["9",[["ἵνα",101,8],["μὴ",25,8],["πρόῃ",2623,278],["ἄλλοις",581,300],["ζωήν",212,10],["σου",5,146],["καὶ",2,8],["σὸν",401,7],["βίον",726,7],["ἀνελεήμοσιν",2411,520]],"lest thou give away thy life to others, and thy substance to the merciless:"],["10",[["Ἵνα",101,8],["μὴ",25,8],["πλησθῶσιν",924,267],["ἀλλότριοι",377,130],["σῆς",401,19],["ἰσχύος",180,19],["οἱ",1,128],["δὲ",14,12],["σοὶ",5,151],["πόνοι",564,51],["εἰς",8,1],["οἴκους",34,31],["ἀλλοτρίων",377,163],["ἔλθεσι",0,0]],"lest strangers be filled with thy strength, and thy labours come into the houses of strangers;"],["11",[["Καὶ",2,8],["μεταμεληθήσῃ",3594,173],["ἐπʼ",9,1],["ἐσχάτων",407,115],["ἡνίκα",541,17],["ἂν",82,12],["κατατριβῶσι",4862,267],["σάρκες",287,179],["σώματός",451,24],["σου",5,146]],"and thou repent at last, when the flesh of thy body is consumed,"],["12",[["καὶ",2,8],["ἐρεῖς",191,145],["πῶς",440,12],["ἐμίσησα",355,147],["παιδείαν",569,10],["καὶ",2,8],["ἐλέγχους",1660,31],["ἐξέκλινεν",393,3],["ἡ",1,11],["καρδία",63,13],["μου",6,48]],"and thou shalt say, How have I hated instruction, and my heart avoided reproofs!"],["13",[["Οὐκ",12,17],["ἤκουον",53,129],["φωνὴν",95,10],["παιδεύοντός",654,143],["με",6,98],["καὶ",2,8],["διδάσκοντός",543,143],["με",6,82],["οὐδὲ",105,12],["παρέβαλλον",2943,129],["τὸ",1,32],["οὖς",325,33],["μου",6,48]],"I heard not the voice of him that instructed me, and taught me, neither did I apply mine ear."],["14",[["Παρʼ",72,1],["ὀλίγον",554,29],["ἐγενόμην",30,152],["ἐν",4,1],["παντὶ",11,111],["κακῷ",161,111],["ἐν",4,1],["μέσῳ",112,111],["ἐκκλησίας",562,19],["καὶ",2,8],["συναγωγῆς",284,19]],"I was almost in all evil in the midst of the congregation and assembly."],["15",[["Πίνε",7875,251],["ὕδατα",85,43],["ἀπὸ",17,1],["σῶν",401,45],["ἀγγείων",1647,45],["καὶ",2,8],["ἀπὸ",17,1],["σῶν",401,45],["φρεάτων",878,45],["πηγῆς",563,19]],"Drink waters out of thine own vessels, and out of thine own springing wells."],["16",[["Μὴ",25,8],["ὑπερεκχείσθω",6679,344],["σοι",5,151],["ὕδατα",85,43],["ἐκ",21,1],["τῆς",1,18],["σῆς",401,19],["πηγῆς",563,19],["εἰς",8,1],["δὲ",14,12],["σὰς",401,40],["πλατείας",925,40],["διαπορευέσθω",1114,344],["τὰ",1,42],["σὰ",401,43],["ὕδατα",85,43]],"Let not waters out of thy fountain be spilt by thee, but let thy waters go into thy streets."],["17",[["Ἔστω",10,35],["σοι",5,151],["μόνῳ",300,111],["ὑπάρχοντα",416,232],["καὶ",2,8],["μηδεὶς",910,16],["ἀλλότριος",377,16],["μετασχέτω",2749,46],["σοι",5,151]],"Let them be only thine own, and let no stranger partake with thee."],["18",[["Ἡ",1,11],["πηγή",563,13],["σου",5,146],["τοῦ",1,23],["ὕδατος",85,24],["ἔστω",10,35],["σοι",5,151],["ἰδία",681,15],["καὶ",2,8],["συνευφραίνου",8480,360],["μετὰ",29,1],["γυναικὸς",58,19],["τῆς",1,18],["ἐκ",21,1],["νεότητός",785,19],["σου",5,146]],"Let thy fountain of water be [truly] thine own; and rejoice with the wife of thy youth."],["19",[["Ἔλαφος",1869,5],["φιλίας",1254,40],["καὶ",2,8],["πῶλος",3350,5],["σῶν",401,61],["χαρίτων",366,61],["ὁμιλείτω",3035,35],["σοι",5,151],["ἡ",1,11],["δὲ",14,12],["ἰδία",681,15],["ἡγείσθω",374,700],["σου",5,146],["καὶ",2,8],["συνέστω",1099,169],["σοι",5,151],["ἐν",4,1],["παντὶ",11,111],["καιρῷ",132,113],["ἐν",4,1],["γὰρ",40,12],["τῇ",1,95],["ταύτης",16,293],["φιλίᾳ",1254,2],["συμπεριφερόμενος",4423,114],["πολλοστὸς",5992,16],["ἔσῃ",10,116]],"Let [thy] loving hart and thy graceful colt company with thee, and let her be considered thine own, and be with thee at all times; for ravished with her love thou shalt be greatly increased."],["20",[["Μὴ",25,8],["πολὺς",74,16],["ἴσθι",10,239],["πρὸς",15,1],["ἀλλοτρίαν",377,37],["μηδὲ",412,12],["συνέχου",1423,250],["ἀγκάλαις",4498,71],["τῆς",1,18],["μὴ",25,8],["ἰδίας",681,78]],"Be not intimate with a strange woman, neither fold thyself in the arms of a woman not thine own."],["21",[["Ἐνώπιον",114,1],["γάρ",40,12],["εἰσι",10,189],["τῶν",1,76],["τοῦ",1,30],["Θεοῦ",20,21],["ὀφθαλμῶν",91,77],["ὁδοὶ",67,179],["ἀνδρὸς",38,21],["εἰς",8,1],["δὲ",14,12],["πάσας",11,109],["τὰς",1,39],["τροχιὰς",3379,40],["αὐτοῦ",3,48],["σκοπεύει",3353,87]],"For the ways of a man are before the eyes of God, and he looks on all his paths."],["22",[["Παρανομίαι",2945,179],["ἄνδρα",38,7],["ἀγρεύουσι",4018,189],["σειραῖς",3960,71],["δὲ",14,12],["τῶν",1,123],["ἑαυτοῦ",92,48],["ἁμαρτιῶν",119,61],["ἕκαστος",170,16],["σφίγγεται",8518,108]],"Iniquities ensnare a man, and every one is bound in the chains of his own sins."],["23",[["Οὗτος",16,112],["τελευτᾷ",593,172],["μετὰ",29,1],["ἀπαιδεύτων",2054,163],["ἐκ",21,1],["δὲ",14,12],["πλήθους",199,24],["τῆς",1,18],["ἑαυτοῦ",92,144],["βιότητος",6900,19],["ἐξεῤῥίφη",2838,38],["καὶ",2,8],["ἀπώλετο",594,26],["διʼ",54,1],["ἀφροσύνην",1402,10]],"Such a man dies with the uninstructed; and he is cast forth from the abundance of his own substance, and has perished through folly."]]