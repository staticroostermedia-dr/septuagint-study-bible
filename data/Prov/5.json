[["1",[["Υἱὲ",13,250],["ἐμῇ",525,2],["σοφίᾳ",242,2],["πρόσεχε",558,239],["ἐμοῖς",525,139],["δὲ",14,12],["λόγοις",48,139],["παράβαλλε",2930,239],["σὸν",405,20],["οὖς",328,20]],"[My] son, attend to my wisdom, and apply thine ear to my words;"],["2",[["ἵνα",102,8],["φυλάξῃς",125,170],["ἔννοιαν",2323,10],["ἀγαθήν",114,37],["αἴσθησις",1619,13],["δὲ",14,12],["ἐμῶν",525,45],["χειλέων",361,45],["ἐντέλλεταί",143,108],["σοι",5,151]],"that thou mayest keep good understanding, and the discretion of my lips gives thee a charge. Give no heed to a worthless woman;"],["3",[["Μὴ",25,8],["πρόσεχε",558,239],["φαύλῃ",2972,96],["γυναικί",59,2],["Μέλι",807,20],["γὰρ",40,12],["ἀποστάζει",4039,87],["ἀπὸ",17,1],["χειλέων",361,45],["γυναικὸς",59,19],["πόρνης",1146,19],["ἣ",1,11],["πρὸς",15,1],["καιρὸν",132,7],["λιπαίνει",5793,87],["σὸν",405,7],["φάρυγγα",2973,7]],"for honey drops from the lips of a harlot, who for a season pleases thy palate:"],["4",[["ὕστερον",2004,29],["μέντοι",3905,12],["πικρότερον",1076,29],["χολῆς",2129,19],["εὑρήσεις",101,159],["καὶ",2,8],["ἠκονημένον",3684,326],["μᾶλλον",1043,17],["μαχαίρας",342,19],["διστόμου",4214,78]],"but afterwards thou wilt find her more bitter than gall, and sharper than a two-edged sword."],["5",[["Τῆς",1,18],["γὰρ",40,12],["ἀφροσύνης",1401,19],["οἱ",1,128],["πόδες",210,51],["κατάγουσι",735,191],["τοὺς",1,56],["χρωμένους",928,230],["αὐτῇ",3,99],["μετὰ",29,1],["θανάτου",170,21],["εἰς",8,1],["τὸν",1,6],["ᾅδην",586,7],["τὰ",1,42],["δὲ",14,12],["ἴχνη",1408,43],["αὐτῆς",3,83],["οὐκ",12,17],["ἐρείδεται",2838,108]],"For the feet of folly lead those who deal with her down to the grave with death; and her steps are not established."],["6",[["Ὁδοὺς",68,40],["γὰρ",40,12],["ζωῆς",216,19],["οὐκ",12,17],["ἐπέρχεται",542,108],["σφαλεραὶ",8453,187],["δὲ",14,12],["αἱ",1,185],["τροχιαὶ",3374,180],["αὐτῆς",3,83],["καὶ",2,8],["οὐκ",12,17],["εὔγνωστοι",4784,130]],"For she goes not upon the paths of life; but her ways are slippery, and not easily known."],["7",[["Νῦν",90,17],["οὖν",227,12],["υἱὲ",13,250],["ἄκουέ",54,239],["μου",6,48],["καὶ",2,8],["μὴ",25,8],["ἀκύρους",6379,58],["ποιήσεις",23,159],["ἐμοὺς",525,31],["λόγους",48,31]],"Now then, [my] son, hear me, and make not my words of none effect."],["8",[["Μακρὰν",642,37],["ποίησον",23,198],["ἀπʼ",17,1],["αὐτῆς",3,83],["σὴν",405,10],["ὁδόν",68,10],["μὴ",25,8],["ἐγγίσῃς",0,0],["πρὸς",15,1],["θύραις",277,71],["οἴκων",34,77],["αὐτῆς",3,83]],"Remove thy way far from her; draw not near to the doors of her house:"],["9",[["ἵνα",102,8],["μὴ",25,8],["πρόῃ",2620,277],["ἄλλοις",584,296],["ζωήν",216,10],["σου",5,146],["καὶ",2,8],["σὸν",405,7],["βίον",726,7],["ἀνελεήμοσιν",2402,512]],"lest thou give away thy life to others, and thy substance to the merciless:"],["10",[["Ἵνα",102,8],["μὴ",25,8],["πλησθῶσιν",924,266],["ἀλλότριοι",381,130],["σῆς",405,19],["ἰσχύος",181,19],["οἱ",1,128],["δὲ",14,12],["σοὶ",5,151],["πόνοι",566,51],["εἰς",8,1],["οἴκους",34,31],["ἀλλοτρίων",381,163],["ἔλθεσι",0,0]],"lest strangers be filled with thy strength, and thy labours come into the houses of strangers;"],["11",[["Καὶ",2,8],["μεταμεληθήσῃ",3587,174],["ἐπʼ",9,1],["ἐσχάτων",410,115],["ἡνίκα",543,17],["ἂν",83,12],["κατατριβῶσι",4836,266],["σάρκες",287,180],["σώματός",454,24],["σου",5,146]],"and thou repent at last, when the flesh of thy body is consumed,"],["12",[["καὶ",2,8],["ἐρεῖς",165,159],["πῶς",441,12],["ἐμίσησα",351,147],["παιδείαν",571,10],["καὶ",2,8],["ἐλέγχους",1659,31],["ἐξέκλινεν",394,3],["ἡ",1,11],["καρδία",64,13],["μου",6,48]],"and thou shalt say, How have I hated instruction, and my heart avoided reproofs!"],["13",[["Οὐκ",12,17],["ἤκουον",54,129],["φωνὴν",95,10],["παιδεύοντός",643,143],["με",6,98],["καὶ",2,8],["διδάσκοντός",545,143],["με",6,82],["οὐδὲ",106,12],["παρέβαλλον",2930,129],["τὸ",1,32],["οὖς",328,33],["μου",6,48]],"I heard not the voice of him that instructed me, and taught me, neither did I apply mine ear."],["14",[["Παρʼ",73,1],["ὀλίγον",555,29],["ἐγενόμην",30,152],["ἐν",4,1],["παντὶ",11,111],["κακῷ",161,111],["ἐν",4,1],["μέσῳ",113,111],["ἐκκλησίας",563,19],["καὶ",2,8],["συναγωγῆς",284,19]],"I was almost in all evil in the midst of the congregation and assembly."],["15",[["Πίνε",7817,250],["ὕδατα",85,43],["ἀπὸ",17,1],["σῶν",405,45],["ἀγγείων",1648,45],["καὶ",2,8],["ἀπὸ",17,1],["σῶν",405,45],["φρεάτων",877,45],["πηγῆς",565,19]],"Drink waters out of thine own vessels, and out of thine own springing wells."],["16",[["Μὴ",25,8],["ὑπερεκχείσθω",6637,340],["σοι",5,151],["ὕδατα",85,43],["ἐκ",21,1],["τῆς",1,18],["σῆς",405,19],["πηγῆς",565,19],["εἰς",8,1],["δὲ",14,12],["σὰς",405,40],["πλατείας",925,40],["διαπορευέσθω",1113,340],["τὰ",1,42],["σὰ",405,43],["ὕδατα",85,43]],"Let not waters out of thy fountain be spilt by thee, but let thy waters go into thy streets."],["17",[["Ἔστω",10,35],["σοι",5,151],["μόνῳ",302,111],["ὑπάρχοντα",418,232],["καὶ",2,8],["μηδεὶς",908,16],["ἀλλότριος",381,16],["μετασχέτω",2741,46],["σοι",5,151]],"Let them be only thine own, and let no stranger partake with thee."],["18",[["Ἡ",1,11],["πηγή",565,13],["σου",5,146],["τοῦ",1,23],["ὕδατος",85,24],["ἔστω",10,35],["σοι",5,151],["ἰδία",683,15],["καὶ",2,8],["συνευφραίνου",8423,355],["μετὰ",29,1],["γυναικὸς",59,19],["τῆς",1,18],["ἐκ",21,1],["νεότητός",787,19],["σου",5,146]],"Let thy fountain of water be [truly] thine own; and rejoice with the wife of thy youth."],["19",[["Ἔλαφος",1868,5],["φιλίας",1253,40],["καὶ",2,8],["πῶλος",3347,5],["σῶν",405,61],["χαρίτων",368,61],["ὁμιλείτω",3023,35],["σοι",5,151],["ἡ",1,11],["δὲ",14,12],["ἰδία",683,15],["ἡγείσθω",378,678],["σου",5,146],["καὶ",2,8],["συνέστω",1065,169],["σοι",5,151],["ἐν",4,1],["παντὶ",11,111],["καιρῷ",132,113],["ἐν",4,1],["γὰρ",40,12],["τῇ",1,95],["ταύτης",16,290],["φιλίᾳ",1253,2],["συμπεριφερόμενος",4404,114],["πολλοστὸς",5963,16],["ἔσῃ",10,116]],"Let [thy] loving hart and thy graceful colt company with thee, and let her be considered thine own, and be with thee at all times; for ravished with her love thou shalt be greatly increased."],["20",[["Μὴ",25,8],["πολὺς",74,16],["ἴσθι",10,239],["πρὸς",15,1],["ἀλλοτρίαν",381,37],["μηδὲ",414,12],["συνέχου",1227,249],["ἀγκάλαις",4477,71],["τῆς",1,18],["μὴ",25,8],["ἰδίας",683,78]],"Be not intimate with a strange woman, neither fold thyself in the arms of a woman not thine own."],["21",[["Ἐνώπιον",115,1],["γάρ",40,12],["εἰσι",10,191],["τῶν",1,76],["τοῦ",1,30],["Θεοῦ",20,21],["ὀφθαλμῶν",91,77],["ὁδοὶ",68,180],["ἀνδρὸς",38,21],["εἰς",8,1],["δὲ",14,12],["πάσας",11,109],["τὰς",1,39],["τροχιὰς",3374,40],["αὐτοῦ",3,48],["σκοπεύει",3350,87]],"For the ways of a man are before the eyes of God, and he looks on all his paths."],["22",[["Παρανομίαι",2932,180],["ἄνδρα",38,7],["ἀγρεύουσι",4009,191],["σειραῖς",3949,71],["δὲ",14,12],["τῶν",1,123],["ἑαυτοῦ",92,48],["ἁμαρτιῶν",119,61],["ἕκαστος",171,16],["σφίγγεται",8459,108]],"Iniquities ensnare a man, and every one is bound in the chains of his own sins."],["23",[["Οὗτος",16,112],["τελευτᾷ",581,173],["μετὰ",29,1],["ἀπαιδεύτων",2049,163],["ἐκ",21,1],["δὲ",14,12],["πλήθους",200,24],["τῆς",1,18],["ἑαυτοῦ",92,144],["βιότητος",6854,19],["ἐξεῤῥίφη",2524,38],["καὶ",2,8],["ἀπώλετο",217,26],["διʼ",56,1],["ἀφροσύνην",1401,10]],"Such a man dies with the uninstructed; and he is cast forth from the abundance of his own substance, and has perished through folly."]]