[["10",[["Γυναῖκα",58,10],["ἀνδρείαν",1487,37],["τίς",39,373],["εὑρήσει",106,120],["τιμιωτέρα",1190,15],["δέ",14,12],["ἐστι",10,87],["λίθων",195,77],["πολυτελῶν",2294,163],["ἡ",1,11],["τοιαύτη",629,178]],"Who shall find a virtuous woman? for such a one is more valuable than precious stones."],["11",[["Θαρσεῖ",1302,87],["ἐπʼ",9,1],["αὐτῇ",3,99],["ἡ",1,11],["καρδία",63,13],["τοῦ",1,30],["ἀνδρὸς",38,21],["αὐτῆς",3,83],["ἡ",1,11],["τοιαύτη",629,178],["καλῶν",264,79],["σκύλων",558,45],["οὐκ",12,17],["ἀπορήσει",2323,120]],"The heart of her husband trusts in her: such a one shall stand in no need of fine spoils."],["12",[["Ἐνεργεῖ",3744,87],["γὰρ",40,12],["τῷ",1,110],["ἀνδρὶ",38,113],["εἰς",8,1],["ἀγαθὰ",113,65],["πάντα",11,59],["τὸν",1,6],["βίον",726,7]],"For she employs all her living for her husband's good."],["13",[["Μηρυομένη",7744,204],["ἔρια",2686,63],["καὶ",2,8],["λινὸν",5482,7],["ἐποίησεν",23,3],["εὔχρηστον",5668,59],["ταῖς",1,70],["χερσὶν",37,71],["αὐτῆς",3,83]],"Gathering wool and flax, she makes it serviceable with her hands."],["14",[["Ἐγένετο",30,26],["ὡσεὶ",342,17],["ναῦς",1775,573],["ἐμπορευομένη",2673,204],["μακρόθεν",1250,17],["συνάγει",165,87],["δὲ",14,12],["αὕτη",16,101],["τὸν",1,6],["βίον",726,7]],"She is like a ship trading from a distance: so she procures her livelihood."],["15",[["Καὶ",2,8],["ἀνίσταται",121,108],["ἐκ",21,1],["νυκτῶν",216,61],["καὶ",2,8],["ἔδωκε",33,3],["βρώματα",714,43],["τῷ",1,110],["οἴκῳ",34,113],["καὶ",2,8],["ἔργα",104,43],["ταῖς",1,70],["θεραπαίναις",3073,71]],"And she rises by night, and gives food to her household, and [appointed] tasks to her maidens."],["16",[["Θεωρήσασα",898,140],["γεώργιον",3051,20],["ἐπρίατο",3640,432],["ἀπὸ",17,1],["δὲ",14,12],["καρπῶν",446,77],["χειρῶν",37,61],["αὐτῆς",3,83],["κατεφύτευσεν",1727,3],["κτῆμα",2466,33]],"She views a farm, and buys it: and with the fruit of her hands she plants a possession."],["17",[["Ἀναζωσαμένη",6292,369],["ἰσχυρῶς",398,17],["τὴν",1,9],["ὀσφῦν",795,10],["αὐτῆς",3,83],["ἤρεισε",2852,3],["τοὺς",1,56],["βραχίονας",616,58],["αὐτῆς",3,83],["εἰς",8,1],["ἔργον",104,33]],"She strongly girds her loins, and strengthens her arms for work."],["18",[["Καὶ",2,8],["ἐγεύσατο",1883,26],["ὅτι",19,8],["καλόν",264,28],["ἐστι",10,87],["τὸ",1,27],["ἐργάζεσθαι",468,104],["καὶ",2,8],["οὐκ",12,17],["ἀποσβέννυται",4550,108],["ὁ",1,4],["λύχνος",1059,5],["αὐτῆς",3,83],["ὅλην",233,37],["τὴν",1,9],["νύκτα",216,10]],"And she finds by experience that working is good; and her candle goes not out all night."],["19",[["τοὺς",1,56],["πήχεις",245,51],["αὐτῆς",3,83],["ἐκτείνει",419,87],["ἐπὶ",9,1],["τὰ",1,42],["συμφέροντα",2500,232],["τὰς",1,39],["δὲ",14,12],["χεῖρας",37,40],["αὐτῆς",3,83],["ἐρείδει",2852,87],["εἰς",8,1],["ἄτρακτον",9289,7]],"She reaches forth her arms to needful [works], and applies her hands to the spindle."],["20",[["Χεῖρας",37,40],["δὲ",14,12],["αὐτῆς",3,83],["διήνοιξε",1321,3],["πένητι",668,113],["καρπὸν",446,7],["δὲ",14,12],["ἐξέτεινεν",419,3],["πτωχῷ",496,113]],"And she opens her hands to the needy, and reaches out fruit to the poor."],["21",[["Οὐ",12,17],["φροντίζει",2214,87],["τῶν",1,76],["ἐν",4,1],["οἴκῳ",34,113],["ὁ",1,4],["ἀνὴρ",38,5],["αὐτῆς",3,83],["ὅταν",318,8],["που",477,17],["χρονίζῃ",1744,166],["πάντες",11,130],["γὰρ",40,12],["οἱ",1,128],["παρʼ",72,1],["αὐτῆς",3,83],["ἐνδεδυμένοι",515,493],["εἰαί",0,0]],"Her husband is not anxious about those at home when he tarries anywhere abroad: for all her household are clothed."],["22",[["Δισσὰς",2898,109],["χλαίνας",8744,40],["ἐποίησε",23,3],["τῷ",1,110],["ἀνδρὶ",38,113],["αὐτῆς",3,83],["ἐκ",21,1],["δὲ",14,12],["βύσσου",1180,19],["καὶ",2,8],["πορφύρας",1062,19],["ἑαυτῇ",92,99],["ἐνδύματα",2547,63]],"She makes for her husband clothes of double texture, and garments for herself of fine linen and scarlet."],["23",[["Περίβλεπτος",8025,16],["δὲ",14,12],["γίνεται",30,108],["ὁ",1,4],["ἀνὴρ",38,5],["αὐτῆς",3,83],["ἐν",4,1],["πύλαις",162,71],["ἡνίκα",541,17],["ἂν",82,12],["καθίσῃ",273,160],["ἐν",4,1],["συνεδρίῳ",2503,53],["μετὰ",29,1],["τῶν",1,76],["γερόντων",1815,77],["κατοίκων",4299,77],["τῆς",1,18],["γῆς",26,19]],"And her husband becomes a distinguished [person] in the gates, when he sits in council with the old inhabitants of the land."],["24",[["Σινδόνας",6076,40],["ἐποίησε",23,3],["καὶ",2,8],["ἀπέδοτο",311,26],["περιζώματα",2765,63],["τοῖς",1,138],["Χαναναίοις",696,215],["στόμα",123,33],["αὐτῆς",3,83],["διήνοιξε",1321,3],["προσεχόντως",8154,17],["καὶ",2,8],["ἐννόμως",6594,17],["καὶ",2,8],["τάξιν",1643,10],["ἐστείλατο",3362,26],["τῇ",1,95],["γλώσσῃ",385,2],["αὐτῆς",3,83]],"She makes fine linens, and sells girdles to the Chananites: she opens her mouth heedfully and with propriety, and controls her tongue."],["25",[["Ἰσχὺν",180,10],["καὶ",2,8],["εὐπρέπειαν",2182,10],["ἐνεδύσατο",515,26],["καὶ",2,8],["εὐφράνθη",242,38],["ἐν",4,1],["ἡμέραις",28,71],["ἐσχάταις",407,290]],"She puts on strength and honour; and rejoices in the last days."],["26",[["Στεγναὶ",8343,185],["διατριβαὶ",3826,179],["οἴκων",34,77],["αὐτῆς",3,83],["σῖτα",660,63],["δὲ",14,12],["ὀκνηρὰ",2248,74],["οὐκ",12,17],["ἔφαγεν",268,3]],"The ways of her household are careful, and she eats not the bread of idleness."],["27",[["Τὸ",1,32],["στόμα",123,33],["δὲ",14,12],["ἀνοίγει",820,87],["σοφῶς",322,17],["καὶ",2,8],["νομοθέσμως",7820,17],["Ἡ",1,11],["δὲ",14,12],["ἐλεημοσύνη",943,13],["αὐτῆς",3,83]],"But she opens her mouth wisely, and according to law."],["28",[["ἀνέστησε",121,3],["τὰ",1,42],["τέκνα",192,43],["αὐτῆς",3,83],["καὶ",2,8],["ἐπλούτησαν",2486,141],["καὶ",2,8],["ὁ",1,4],["ἀνὴρ",38,5],["αὐτῆς",3,83],["ᾔνεσεν",399,3],["αὐτήν",3,98]],"And [her] kindness to them sets up her children for them, and they grow rich, and her husband praises her."],["29",[["Πολλαὶ",74,185],["θυγατέρες",97,179],["ἐκτήσαντο",533,182],["πλοῦτον",572,7],["πολλαὶ",74,185],["ἐποίησαν",23,141],["δύναμιν",98,10],["σὺ",5,156],["δὲ",14,12],["ὑπέρκεισαι",6697,166],["ὑπερῇρας",0,0],["πάσας",11,109]],"Many daughters have obtained wealth, many have wrought valiantly; but thou hast exceeded, thou hast surpassed all."],["30",[["Ψευδεῖς",547,185],["ἀρέσκειαι",9161,179],["καὶ",2,8],["μάταιον",648,28],["κάλλος",887,20],["γυναικος",58,19],["γυνὴ",58,13],["γὰρ",40,12],["συνετὴ",956,15],["εὐλογεῖται",147,108],["φόβον",330,7],["δὲ",14,12],["Κυρίου",7,21],["αὕτη",16,101],["αἰνείτω",399,35]],"Charms are false, and woman's beauty is vain: for it is a wise woman that is blessed, and let her praise the fear of the Lord."],["31",[["Δότε",33,69],["αὐτῇ",3,99],["ἀπὸ",17,1],["καρπῶν",446,77],["χειλέων",361,45],["αὐτῆς",3,83],["καὶ",2,8],["αἰνείσθω",399,344],["ἐν",4,1],["πύλαις",162,71],["ὁ",1,4],["ἀνὴρ",38,5],["αὐτῆς",3,83]],"Give her of the fruit of her lips; and let her husband be praised in the gates."]]