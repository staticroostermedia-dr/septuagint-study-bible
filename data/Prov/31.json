[["10",[["Γυναῖκα",59,10],["ἀνδρείαν",1485,37],["τίς",39,368],["εὑρήσει",101,120],["τιμιωτέρα",1189,15],["δέ",14,12],["ἐστι",10,87],["λίθων",195,77],["πολυτελῶν",2282,163],["ἡ",1,11],["τοιαύτη",630,179]],"Who shall find a virtuous woman? for such a one is more valuable than precious stones."],["11",[["Θαρσεῖ",1302,87],["ἐπʼ",9,1],["αὐτῇ",3,99],["ἡ",1,11],["καρδία",64,13],["τοῦ",1,30],["ἀνδρὸς",38,21],["αὐτῆς",3,83],["ἡ",1,11],["τοιαύτη",630,179],["καλῶν",266,79],["σκύλων",559,45],["οὐκ",12,17],["ἀπορήσει",2310,120]],"The heart of her husband trusts in her: such a one shall stand in no need of fine spoils."],["12",[["Ἐνεργεῖ",3432,87],["γὰρ",40,12],["τῷ",1,110],["ἀνδρὶ",38,113],["εἰς",8,1],["ἀγαθὰ",114,65],["πάντα",11,59],["τὸν",1,6],["βίον",726,7]],"For she employs all her living for her husband's good."],["13",[["Μηρυομένη",7689,204],["ἔρια",2682,63],["καὶ",2,8],["λινὸν",5451,7],["ἐποίησεν",23,3],["εὔχρηστον",5639,59],["ταῖς",1,70],["χερσὶν",37,71],["αὐτῆς",3,83]],"Gathering wool and flax, she makes it serviceable with her hands."],["14",[["Ἐγένετο",30,26],["ὡσεὶ",343,17],["ναῦς",1775,560],["ἐμπορευομένη",2670,204],["μακρόθεν",1249,17],["συνάγει",166,87],["δὲ",14,12],["αὕτη",16,101],["τὸν",1,6],["βίον",726,7]],"She is like a ship trading from a distance: so she procures her livelihood."],["15",[["Καὶ",2,8],["ἀνίσταται",121,108],["ἐκ",21,1],["νυκτῶν",219,61],["καὶ",2,8],["ἔδωκε",33,3],["βρώματα",714,43],["τῷ",1,110],["οἴκῳ",34,113],["καὶ",2,8],["ἔργα",105,43],["ταῖς",1,70],["θεραπαίναις",3061,71]],"And she rises by night, and gives food to her household, and [appointed] tasks to her maidens."],["16",[["Θεωρήσασα",897,140],["γεώργιον",3040,20],["ἐπρίατο",3633,425],["ἀπὸ",17,1],["δὲ",14,12],["καρπῶν",448,77],["χειρῶν",37,61],["αὐτῆς",3,83],["κατεφύτευσεν",1727,3],["κτῆμα",2459,33]],"She views a farm, and buys it: and with the fruit of her hands she plants a possession."],["17",[["Ἀναζωσαμένη",6261,366],["ἰσχυρῶς",401,17],["τὴν",1,9],["ὀσφῦν",798,10],["αὐτῆς",3,83],["ἤρεισε",2838,3],["τοὺς",1,56],["βραχίονας",618,58],["αὐτῆς",3,83],["εἰς",8,1],["ἔργον",105,33]],"She strongly girds her loins, and strengthens her arms for work."],["18",[["Καὶ",2,8],["ἐγεύσατο",1881,26],["ὅτι",19,8],["καλόν",266,28],["ἐστι",10,87],["τὸ",1,27],["ἐργάζεσθαι",467,104],["καὶ",2,8],["οὐκ",12,17],["ἀποσβέννυται",4526,108],["ὁ",1,4],["λύχνος",1059,5],["αὐτῆς",3,83],["ὅλην",235,37],["τὴν",1,9],["νύκτα",219,10]],"And she finds by experience that working is good; and her candle goes not out all night."],["19",[["τοὺς",1,56],["πήχεις",246,51],["αὐτῆς",3,83],["ἐκτείνει",421,87],["ἐπὶ",9,1],["τὰ",1,42],["συμφέροντα",2495,232],["τὰς",1,39],["δὲ",14,12],["χεῖρας",37,40],["αὐτῆς",3,83],["ἐρείδει",2838,87],["εἰς",8,1],["ἄτρακτον",9213,7]],"She reaches forth her arms to needful [works], and applies her hands to the spindle."],["20",[["Χεῖρας",37,40],["δὲ",14,12],["αὐτῆς",3,83],["διήνοιξε",1321,3],["πένητι",672,113],["καρπὸν",448,7],["δὲ",14,12],["ἐξέτεινεν",421,3],["πτωχῷ",497,113]],"And she opens her hands to the needy, and reaches out fruit to the poor."],["21",[["Οὐ",12,17],["φροντίζει",2200,87],["τῶν",1,76],["ἐν",4,1],["οἴκῳ",34,113],["ὁ",1,4],["ἀνὴρ",38,5],["αὐτῆς",3,83],["ὅταν",319,8],["που",478,17],["χρονίζῃ",1746,166],["πάντες",11,130],["γὰρ",40,12],["οἱ",1,128],["παρʼ",73,1],["αὐτῆς",3,83],["ἐνδεδυμένοι",516,370],["εἰαί",0,0]],"Her husband is not anxious about those at home when he tarries anywhere abroad: for all her household are clothed."],["22",[["Δισσὰς",2884,109],["χλαίνας",8684,40],["ἐποίησε",23,3],["τῷ",1,110],["ἀνδρὶ",38,113],["αὐτῆς",3,83],["ἐκ",21,1],["δὲ",14,12],["βύσσου",1181,19],["καὶ",2,8],["πορφύρας",1062,19],["ἑαυτῇ",92,99],["ἐνδύματα",2543,63]],"She makes for her husband clothes of double texture, and garments for herself of fine linen and scarlet."],["23",[["Περίβλεπτος",7966,16],["δὲ",14,12],["γίνεται",30,108],["ὁ",1,4],["ἀνὴρ",38,5],["αὐτῆς",3,83],["ἐν",4,1],["πύλαις",162,71],["ἡνίκα",543,17],["ἂν",83,12],["καθίσῃ",274,160],["ἐν",4,1],["συνεδρίῳ",2498,53],["μετὰ",29,1],["τῶν",1,76],["γερόντων",1814,77],["κατοίκων",4286,77],["τῆς",1,18],["γῆς",26,19]],"And her husband becomes a distinguished [person] in the gates, when he sits in council with the old inhabitants of the land."],["24",[["Σινδόνας",6048,40],["ἐποίησε",23,3],["καὶ",2,8],["ἀπέδοτο",312,26],["περιζώματα",2755,63],["τοῖς",1,138],["Χαναναίοις",695,215],["στόμα",123,33],["αὐτῆς",3,83],["διήνοιξε",1321,3],["προσεχόντως",8093,17],["καὶ",2,8],["ἐννόμως",6555,17],["καὶ",2,8],["τάξιν",1744,10],["ἐστείλατο",3359,26],["τῇ",1,95],["γλώσσῃ",388,2],["αὐτῆς",3,83]],"She makes fine linens, and sells girdles to the Chananites: she opens her mouth heedfully and with propriety, and controls her tongue."],["25",[["Ἰσχὺν",181,10],["καὶ",2,8],["εὐπρέπειαν",2171,10],["ἐνεδύσατο",516,26],["καὶ",2,8],["εὐφράνθη",244,38],["ἐν",4,1],["ἡμέραις",28,71],["ἐσχάταις",410,287]],"She puts on strength and honour; and rejoices in the last days."],["26",[["Στεγναὶ",8284,187],["διατριβαὶ",3813,180],["οἴκων",34,77],["αὐτῆς",3,83],["σῖτα",665,63],["δὲ",14,12],["ὀκνηρὰ",2234,74],["οὐκ",12,17],["ἔφαγεν",269,3]],"The ways of her household are careful, and she eats not the bread of idleness."],["27",[["Τὸ",1,32],["στόμα",123,33],["δὲ",14,12],["ἀνοίγει",362,87],["σοφῶς",324,17],["καὶ",2,8],["νομοθέσμως",7765,17],["Ἡ",1,11],["δὲ",14,12],["ἐλεημοσύνη",942,13],["αὐτῆς",3,83]],"But she opens her mouth wisely, and according to law."],["28",[["ἀνέστησε",121,3],["τὰ",1,42],["τέκνα",192,43],["αὐτῆς",3,83],["καὶ",2,8],["ἐπλούτησαν",2373,141],["καὶ",2,8],["ὁ",1,4],["ἀνὴρ",38,5],["αὐτῆς",3,83],["ᾔνεσεν",402,3],["αὐτήν",3,98]],"And [her] kindness to them sets up her children for them, and they grow rich, and her husband praises her."],["29",[["Πολλαὶ",74,187],["θυγατέρες",97,180],["ἐκτήσαντο",564,184],["πλοῦτον",574,7],["πολλαὶ",74,187],["ἐποίησαν",23,141],["δύναμιν",98,10],["σὺ",5,156],["δὲ",14,12],["ὑπέρκεισαι",6655,166],["ὑπερῇρας",3769,154],["πάσας",11,109]],"Many daughters have obtained wealth, many have wrought valiantly; but thou hast exceeded, thou hast surpassed all."],["30",[["Ψευδεῖς",549,187],["ἀρέσκειαι",9095,180],["καὶ",2,8],["μάταιον",654,28],["κάλλος",886,20],["γυναικος",59,19],["γυνὴ",59,13],["γὰρ",40,12],["συνετὴ",954,15],["εὐλογεῖται",149,108],["φόβον",333,7],["δὲ",14,12],["Κυρίου",7,21],["αὕτη",16,101],["αἰνείτω",402,35]],"Charms are false, and woman's beauty is vain: for it is a wise woman that is blessed, and let her praise the fear of the Lord."],["31",[["Δότε",33,69],["αὐτῇ",3,99],["ἀπὸ",17,1],["καρπῶν",448,77],["χειλέων",361,45],["αὐτῆς",3,83],["καὶ",2,8],["αἰνείσθω",402,340],["ἐν",4,1],["πύλαις",162,71],["ὁ",1,4],["ἀνὴρ",38,5],["αὐτῆς",3,83]],"Give her of the fruit of her lips; and let her husband be praised in the gates."]]