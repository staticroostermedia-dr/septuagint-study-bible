[["1",[["Κρείσσων",922,16],["ἀνὴρ",38,5],["ἐλέγχων",752,67],["ἀνδρὸς",38,21],["σκληροτραχήλου",3129,153],["ἐξαπίνης",5311,17],["γὰρ",40,12],["φλεγομένου",2644,418],["αὐτοῦ",3,48],["οὐκ",12,17],["ἔστιν",10,87],["ἴασις",1463,13]],"A reprover is better than a stiff-necked man: for when the latter is suddenly set on fire, there shall be no remedy."],["2",[["Ἐγκωμιαζομένων",4070,468],["δικαίων",153,115],["εὐφρανθήσονται",244,135],["λαοὶ",35,51],["ἀρχόντων",96,77],["δὲ",14,12],["ἀσεβῶν",247,163],["στένουσιν",3643,191],["ἄνδρες",38,51]],"When the righteous are praised, the people will rejoice: but when the ungodly rule, men mourn."],["3",[["Ἀνδρὸς",38,21],["φιλοῦντος",1391,143],["σοφίαν",242,10],["εὐφραίνεται",244,108],["πατὴρ",44,5],["αὐτοῦ",3,48],["ὃς",24,246],["δὲ",14,12],["ποιμαίνει",953,87],["πόρνας",1146,40],["ἀπολεῖ",217,120],["πλοῦτον",574,7]],"When a man loves wisdom, his father rejoices: but he that keeps harlots will waste wealth."],["4",[["Βασιλεὺς",22,5],["δίκαιος",153,16],["ἀνίστησι",121,87],["χώραν",278,10],["ἀνὴρ",38,5],["δὲ",14,12],["παράνομος",830,16],["κατασκάπτει",1550,87]],"A righteous king establishes a country: but a transgressor destroys [it]."],["5",[["Ὃς",24,246],["παρασκευάζεται",2275,108],["ἐπὶ",9,1],["πρόσωπον",47,33],["τοῦ",1,30],["ἑαυτοῦ",92,48],["φιλου",336,153],["δίκτυον",1721,33],["περιβάλλει",744,87],["αὐτὸ",3,121],["τοῖς",1,138],["ἑαυτοῦ",92,48],["ποσίν",210,139]],"He that prepares a net in the way of his own friend, entangles his own feet in it."],["6",[["Ἁμαρτάνοντι",237,390],["ἀνδρὶ",38,113],["μεγάλη",66,15],["παγὶς",817,13],["δίκαιος",153,15],["δὲ",14,12],["ἐν",4,1],["χαρᾷ",1125,2],["καὶ",2,8],["ἐν",4,1],["εὐφροσύνῃ",360,2],["ἔσται",10,89]],"A great snare [is spread] for a sinner: but the righteous shall be in joy and gladness."],["7",[["Ἐπίσταται",1087,108],["δίκαιος",153,16],["κρίνειν",263,54],["πενιχροῖς",4970,215],["ὁ",1,4],["δὲ",14,12],["ἀσεβὴς",247,16],["οὐ",12,17],["νοεῖ",1383,87],["γνῶσιν",753,10],["καὶ",2,8],["πτωχῷ",497,113],["οὐχ",12,17],["ὑπάρχει",418,87],["νοῦς",1442,5],["ἐπιγνώμων",4599,5]],"A righteous man knows how to judge for the poor: but the ungodly understands not knowledge; and the poor man has not an understanding mind."],["8",[["Ἄνδρες",38,51],["ἄνομοι",536,130],["ἐξέκαυσαν",941,141],["πόλιν",41,10],["σοφοὶ",324,130],["δὲ",14,12],["ἀπέστρεψαν",130,141],["ὀργήν",198,10]],"Lawless men burn down a city: but wise men turn away wrath."],["9",[["Ἀνὴρ",38,5],["σοφὸς",324,16],["κρινεῖ",263,120],["ἔθνη",60,43],["ἀνὴρ",38,5],["δὲ",14,12],["φαῦλος",2972,16],["ὀργιζόμενος",725,114],["καταγελᾶται",1767,89],["καὶ",2,8],["οὐ",12,17],["καταπτήσσει",3851,87]],"A wise man shall judge nations: but a worthless man being angry laughs and fears not."],["10",[["Ἄνδρες",38,51],["αἱμάτων",148,45],["μέτοχοι",3093,51],["μισοῦσιν",351,352],["ὅσιον",917,28],["οἱ",1,128],["δὲ",14,12],["εὐθεῖς",825,130],["ἐκζητήσουσι",460,207],["ψυχὴν",63,10],["αὐτοῦ",3,48]],"Bloody men hate a holy [person], but the upright will seek his soul."],["11",[["Ὅλον",235,59],["τὸν",1,6],["θυμὸν",178,7],["αὐτοῦ",3,48],["ἐκφέρει",624,87],["ἄφρων",439,16],["σοφὸς",324,16],["δὲ",14,12],["ταμιεύεται",6141,108],["κατὰ",32,1],["μέρος",471,33]],"A fool utters all his mind: but the wise reserves his in part."],["12",[["Βασιλέως",22,21],["ὑπακούοντος",867,143],["λόγον",48,7],["ἄδικον",406,59],["πάντες",11,130],["οἱ",1,128],["ὑπʼ",122,1],["αὐτὸν",3,82],["παράνομοι",830,130]],"When a king hearkens to unjust language, all his subjects are transgressors."],["13",[["Δανιστοῦ",0,0],["καὶ",2,8],["χρεωφειλέτου",6208,21],["ἀλλήλοις",1192,142],["συνελθόντων",1837,211],["ἐπισκοπὴν",1106,10],["ἀμφοτέρων",459,163],["ποιεῖται",23,108],["ὁ",1,4],["Κύριος",7,5]],"When the creditor and debtor meet together, the Lord oversees them both."],["14",[["Βασιλέως",22,21],["ἐν",4,1],["ἀληθείᾳ",352,2],["κρίνοντος",263,143],["πτωχοὺς",497,31],["ὁ",1,4],["θρόνος",383,5],["αὐτοῦ",3,48],["εἰς",8,1],["μαρτύριον",225,33],["κατασταθήσεται",314,125]],"When a king judges the poor in truth, his throne shall be established for a testimony."],["15",[["Πληγαὶ",573,180],["καὶ",2,8],["ἔλεγχοι",1659,51],["διδόασι",33,191],["σοφίαν",242,10],["παῖς",127,5],["δὲ",14,12],["πλανώμενος",464,114],["αἰσχύνει",611,87],["γονεῖς",2012,31],["αὐτοῦ",3,48]],"Stripes and reproofs give wisdom: but an erring child disgraces his parents."],["16",[["Πολλῶν",74,163],["ὄντων",10,164],["ἀσεβῶν",247,163],["πολλαὶγίνονται",0,0],["ἁμαρτίαι",119,180],["οἱ",1,128],["δὲ",14,12],["δίκαιοι",153,130],["ἐκείνων",80,41],["πιπτόντων",154,164],["κατάφοβοι",7451,130],["γίνονται",30,299]],"When the ungodly abound, sins abound: but when they fall, the righteous are warned."],["17",[["Παίδευε",643,239],["υἱόν",13,7],["σου",5,146],["καὶ",2,8],["ἀναπαύσει",674,120],["σε",5,161],["καὶ",2,8],["δώσει",33,120],["κόσμον",743,7],["τῇ",1,95],["ψυχῇ",63,2],["σου",5,146]],"Chasten thy son, and he shall give thee rest; and he shall give honour to thy soul."],["18",[["Οὐ",12,17],["μὴ",25,8],["ὑπάρξῃ",418,116],["ἐξηγητὴς",5317,5],["ἔθνει",60,53],["παρανόμῳ",830,34],["ὁ",1,4],["δὲ",14,12],["φυλάσσων",125,67],["τὸν",1,6],["νόμον",140,7],["μακαριστός",4300,16]],"There shall be no interpreter to a sinful nation: but he that observes the law is blessed."],["19",[["Λόγοις",48,139],["οὐ",12,17],["παιδευθήσεται",643,125],["οἰκέτης",951,5],["σκληρός",831,16],["ἐὰν",45,8],["γὰρ",40,12],["καὶ",2,8],["νοήσῃ",1383,116],["ἀλλʼ",108,17],["οὐχ",12,17],["ὑπακούσεται",867,89]],"A stubborn servant will not be reproved by words: for even if he understand, still he will not obey."],["20",[["Ἐὰν",45,8],["ἴδῃς",53,170],["ἄνδρα",38,7],["ταχὺν",2121,59],["ἐν",4,1],["λόγοις",48,139],["γίνωσκε",79,239],["ὅτι",19,8],["ἐλπίδα",530,10],["ἔχει",124,87],["μᾶλλον",1043,17],["ὁ",1,4],["ἄφρων",439,16],["αὐτοῦ",3,48]],"If thou see a man hasty in [his] words, know that the fool has hope rather than he."],["21",[["Ὃς",24,246],["κατασπαταλᾷ",5706,173],["ἐκ",21,1],["παιδὸς",127,21],["οἰκέτης",951,5],["ἔσται",10,89],["ἔσχατον",410,59],["δὲ",14,12],["ὀδυνηθήσεται",2844,125],["ἐφʼ",9,1],["ἑαυτῷ",92,49]],"He that lives wantonly from a child, shall be a servant, and in the end shall grieve over himself."],["22",[["Ἀνὴρ",38,5],["θυμώδης",3063,16],["ἐγείρει",746,87],["νεῖκος",4322,20],["ἀνὴρ",38,5],["δὲ",14,12],["ὀργίλος",4127,16],["ἐξώρυξεν",6479,3],["ἁμαρτίαν",119,10]],"A furious man stirs up strife, and a passionate man digs up sin."],["23",[["Ὕβρις",837,13],["ἄνδρα",38,7],["ταπεινοῖ",322,87],["τοὺς",1,56],["δὲ",14,12],["ταπεινόφρονας",8498,58],["ἐρείδει",2838,87],["δόξῃ",141,2],["Κύριος",7,5]],"Pride brings a man low, but the Lord upholds the humble-minded with honour."],["24",[["Ὃς",24,246],["μερίζεται",1348,108],["κλέπτῃ",1245,166],["μισεῖ",351,87],["τὴν",1,9],["ἑαυτοῦ",92,48],["ψυχήν",63,10],["ἐὰν",45,8],["δὲ",14,12],["ὅρκου",946,21],["προτεθέντος",2619,317],["ἀκούσαντες",54,190],["μὴ",25,8],["ἀναγγείλωσι",231,224]],"He that shares with a thief, hates his own soul: and if any having heard an oath uttered tell not of it,"],["25",[["φοβηθέντες",134,243],["καὶ",2,8],["αἰσχυνθέντες",611,243],["ἀνθρώπους",43,31],["ὑπεσκελίσθησαν",3479,94],["ὁ",1,4],["δὲ",14,12],["πεποιθὼς",344,264],["ἐπὶ",9,1],["Κυρίῳ",7,113],["εὐφρανθήσεται",244,125],["ἀσέβεια",722,13],["ἀνδρὶ",38,113],["δίδωσι",33,87],["σφάλμα",8458,20],["ὃς",24,246],["δὲ",14,12],["πέποιθεν",344,165],["ἐπὶ",9,1],["τῷ",1,110],["δεσπότῃ",1014,113],["σωθήσεται",172,125]],"[they] fearing and reverencing men [unreasonably] have been overthrown, but he that trusts in the Lord shall rejoice. Ungodliness causes a man to stumble: but he that trusts in his master shall be safe."],["26",[["Πολλοὶ",74,130],["θεραπεύουσι",1675,191],["πρόσωπα",47,43],["ἡγουμένων",378,599],["παρὰ",73,1],["δὲ",14,12],["Κυρίου",7,21],["γίνεται",30,108],["τὸ",1,32],["δίκαιον",153,29],["ἀνδρί",38,113]],"Many wait on the favour of rulers; but justice comes to a man from the Lord."],["27",[["Βδέλυγμα",476,33],["δίκαιος",153,16],["ἀνὴρ",38,5],["ἀνδρὶ",38,113],["ἀδίκῳ",406,111],["βδέλυγμα",476,33],["δὲ",14,12],["ἀνόμῳ",536,111],["κατευθύνουσα",827,183],["ὁδός",68,13]],"A righteous man is an abomination to an unrighteous man, and the direct way is an abomination to the sinner."]]