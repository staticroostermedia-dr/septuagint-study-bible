[["1",[["Κρείσσων",922,16],["ἀνὴρ",38,5],["ἐλέγχων",750,67],["ἀνδρὸς",38,21],["σκληροτραχήλου",3137,153],["ἐξαπίνης",5345,17],["γὰρ",40,12],["φλεγομένου",2647,425],["αὐτοῦ",3,48],["οὐκ",12,17],["ἔστιν",10,87],["ἴασις",1463,13]],"A reprover is better than a stiff-necked man: for when the latter is suddenly set on fire, there shall be no remedy."],["2",[["Ἐγκωμιαζομένων",4078,476],["δικαίων",152,115],["εὐφρανθήσονται",242,135],["λαοὶ",35,51],["ἀρχόντων",96,77],["δὲ",14,12],["ἀσεβῶν",246,163],["στένουσιν",3650,189],["ἄνδρες",38,51]],"When the righteous are praised, the people will rejoice: but when the ungodly rule, men mourn."],["3",[["Ἀνδρὸς",38,21],["φιλοῦντος",1393,143],["σοφίαν",238,10],["εὐφραίνεται",242,108],["πατὴρ",44,5],["αὐτοῦ",3,48],["ὃς",24,247],["δὲ",14,12],["ποιμαίνει",955,87],["πόρνας",1146,40],["ἀπολεῖ",213,120],["πλοῦτον",572,7]],"When a man loves wisdom, his father rejoices: but he that keeps harlots will waste wealth."],["4",[["Βασιλεὺς",22,5],["δίκαιος",152,16],["ἀνίστησι",121,87],["χώραν",278,10],["ἀνὴρ",38,5],["δὲ",14,12],["παράνομος",832,16],["κατασκάπτει",1679,87]],"A righteous king establishes a country: but a transgressor destroys [it]."],["5",[["Ὃς",24,247],["παρασκευάζεται",2380,108],["ἐπὶ",9,1],["πρόσωπον",47,33],["τοῦ",1,30],["ἑαυτοῦ",92,48],["φιλου",334,153],["δίκτυον",1722,33],["περιβάλλει",743,87],["αὐτὸ",3,121],["τοῖς",1,138],["ἑαυτοῦ",92,48],["ποσίν",208,139]],"He that prepares a net in the way of his own friend, entangles his own feet in it."],["6",[["Ἁμαρτάνοντι",244,395],["ἀνδρὶ",38,113],["μεγάλη",65,15],["παγὶς",815,13],["δίκαιος",152,15],["δὲ",14,12],["ἐν",4,1],["χαρᾷ",1124,2],["καὶ",2,8],["ἐν",4,1],["εὐφροσύνῃ",360,2],["ἔσται",10,89]],"A great snare [is spread] for a sinner: but the righteous shall be in joy and gladness."],["7",[["Ἐπίσταται",1088,108],["δίκαιος",152,16],["κρίνειν",240,54],["πενιχροῖς",4994,215],["ὁ",1,4],["δὲ",14,12],["ἀσεβὴς",246,16],["οὐ",12,17],["νοεῖ",1384,87],["γνῶσιν",753,10],["καὶ",2,8],["πτωχῷ",496,113],["οὐχ",12,17],["ὑπάρχει",416,87],["νοῦς",1443,5],["ἐπιγνώμων",4623,5]],"A righteous man knows how to judge for the poor: but the ungodly understands not knowledge; and the poor man has not an understanding mind."],["8",[["Ἄνδρες",38,51],["ἄνομοι",532,130],["ἐξέκαυσαν",942,141],["πόλιν",41,10],["σοφοὶ",322,130],["δὲ",14,12],["ἀπέστρεψαν",130,141],["ὀργήν",198,10]],"Lawless men burn down a city: but wise men turn away wrath."],["9",[["Ἀνὴρ",38,5],["σοφὸς",322,16],["κρινεῖ",240,120],["ἔθνη",59,43],["ἀνὴρ",38,5],["δὲ",14,12],["φαῦλος",2984,16],["ὀργιζόμενος",725,114],["καταγελᾶται",1766,89],["καὶ",2,8],["οὐ",12,17],["καταπτήσσει",3861,87]],"A wise man shall judge nations: but a worthless man being angry laughs and fears not."],["10",[["Ἄνδρες",38,51],["αἱμάτων",148,45],["μέτοχοι",3102,51],["μισοῦσιν",355,357],["ὅσιον",918,28],["οἱ",1,128],["δὲ",14,12],["εὐθεῖς",826,130],["ἐκζητήσουσι",459,207],["ψυχὴν",62,10],["αὐτοῦ",3,48]],"Bloody men hate a holy [person], but the upright will seek his soul."],["11",[["Ὅλον",233,59],["τὸν",1,6],["θυμὸν",177,7],["αὐτοῦ",3,48],["ἐκφέρει",622,87],["ἄφρων",438,16],["σοφὸς",322,16],["δὲ",14,12],["ταμιεύεται",6170,108],["κατὰ",32,1],["μέρος",470,33]],"A fool utters all his mind: but the wise reserves his in part."],["12",[["Βασιλέως",22,21],["ὑπακούοντος",868,143],["λόγον",48,7],["ἄδικον",402,59],["πάντες",11,130],["οἱ",1,128],["ὑπʼ",122,1],["αὐτὸν",3,82],["παράνομοι",832,130]],"When a king hearkens to unjust language, all his subjects are transgressors."],["13",[["Δανιστοῦ",0,0],["καὶ",2,8],["χρεωφειλέτου",6238,21],["ἀλλήλοις",1194,142],["συνελθόντων",1917,211],["ἐπισκοπὴν",1108,10],["ἀμφοτέρων",456,163],["ποιεῖται",23,108],["ὁ",1,4],["Κύριος",7,5]],"When the creditor and debtor meet together, the Lord oversees them both."],["14",[["Βασιλέως",22,21],["ἐν",4,1],["ἀληθείᾳ",350,2],["κρίνοντος",240,143],["πτωχοὺς",496,31],["ὁ",1,4],["θρόνος",379,5],["αὐτοῦ",3,48],["εἰς",8,1],["μαρτύριον",220,33],["κατασταθήσεται",313,125]],"When a king judges the poor in truth, his throne shall be established for a testimony."],["15",[["Πληγαὶ",571,179],["καὶ",2,8],["ἔλεγχοι",1660,51],["διδόασι",33,189],["σοφίαν",238,10],["παῖς",126,5],["δὲ",14,12],["πλανώμενος",464,114],["αἰσχύνει",614,87],["γονεῖς",2020,31],["αὐτοῦ",3,48]],"Stripes and reproofs give wisdom: but an erring child disgraces his parents."],["16",[["Πολλῶν",74,163],["ὄντων",10,164],["ἀσεβῶν",246,163],["πολλαὶγίνονται",0,0],["ἁμαρτίαι",119,179],["οἱ",1,128],["δὲ",14,12],["δίκαιοι",152,130],["ἐκείνων",79,41],["πιπτόντων",154,164],["κατάφοβοι",7499,130],["γίνονται",30,303]],"When the ungodly abound, sins abound: but when they fall, the righteous are warned."],["17",[["Παίδευε",654,239],["υἱόν",13,7],["σου",5,146],["καὶ",2,8],["ἀναπαύσει",670,120],["σε",5,161],["καὶ",2,8],["δώσει",33,120],["κόσμον",742,7],["τῇ",1,95],["ψυχῇ",62,2],["σου",5,146]],"Chasten thy son, and he shall give thee rest; and he shall give honour to thy soul."],["18",[["Οὐ",12,17],["μὴ",25,8],["ὑπάρξῃ",416,116],["ἐξηγητὴς",5351,5],["ἔθνει",59,53],["παρανόμῳ",832,34],["ὁ",1,4],["δὲ",14,12],["φυλάσσων",127,67],["τὸν",1,6],["νόμον",140,7],["μακαριστός",4313,16]],"There shall be no interpreter to a sinful nation: but he that observes the law is blessed."],["19",[["Λόγοις",48,139],["οὐ",12,17],["παιδευθήσεται",654,125],["οἰκέτης",952,5],["σκληρός",833,16],["ἐὰν",45,8],["γὰρ",40,12],["καὶ",2,8],["νοήσῃ",1384,116],["ἀλλʼ",107,17],["οὐχ",12,17],["ὑπακούσεται",868,89]],"A stubborn servant will not be reproved by words: for even if he understand, still he will not obey."],["20",[["Ἐὰν",45,8],["ἴδῃς",73,170],["ἄνδρα",38,7],["ταχὺν",2130,59],["ἐν",4,1],["λόγοις",48,139],["γίνωσκε",81,239],["ὅτι",19,8],["ἐλπίδα",527,10],["ἔχει",124,87],["μᾶλλον",1040,17],["ὁ",1,4],["ἄφρων",438,16],["αὐτοῦ",3,48]],"If thou see a man hasty in [his] words, know that the fool has hope rather than he."],["21",[["Ὃς",24,247],["κατασπαταλᾷ",5740,172],["ἐκ",21,1],["παιδὸς",126,21],["οἰκέτης",952,5],["ἔσται",10,89],["ἔσχατον",407,59],["δὲ",14,12],["ὀδυνηθήσεται",2858,125],["ἐφʼ",9,1],["ἑαυτῷ",92,49]],"He that lives wantonly from a child, shall be a servant, and in the end shall grieve over himself."],["22",[["Ἀνὴρ",38,5],["θυμώδης",3075,16],["ἐγείρει",745,87],["νεῖκος",4337,20],["ἀνὴρ",38,5],["δὲ",14,12],["ὀργίλος",4138,16],["ἐξώρυξεν",6514,3],["ἁμαρτίαν",119,10]],"A furious man stirs up strife, and a passionate man digs up sin."],["23",[["Ὕβρις",838,13],["ἄνδρα",38,7],["ταπεινοῖ",333,87],["τοὺς",1,56],["δὲ",14,12],["ταπεινόφρονας",8559,58],["ἐρείδει",2852,87],["δόξῃ",141,2],["Κύριος",7,5]],"Pride brings a man low, but the Lord upholds the humble-minded with honour."],["24",[["Ὃς",24,247],["μερίζεται",1382,108],["κλέπτῃ",1247,166],["μισεῖ",355,87],["τὴν",1,9],["ἑαυτοῦ",92,48],["ψυχήν",62,10],["ἐὰν",45,8],["δὲ",14,12],["ὅρκου",947,21],["προτεθέντος",2622,321],["ἀκούσαντες",53,188],["μὴ",25,8],["ἀναγγείλωσι",228,224]],"He that shares with a thief, hates his own soul: and if any having heard an oath uttered tell not of it,"],["25",[["φοβηθέντες",134,244],["καὶ",2,8],["αἰσχυνθέντες",614,244],["ἀνθρώπους",43,31],["ὑπεσκελίσθησαν",3482,94],["ὁ",1,4],["δὲ",14,12],["πεποιθὼς",343,265],["ἐπὶ",9,1],["Κυρίῳ",7,113],["εὐφρανθήσεται",242,125],["ἀσέβεια",722,13],["ἀνδρὶ",38,113],["δίδωσι",33,87],["σφάλμα",8517,20],["ὃς",24,247],["δὲ",14,12],["πέποιθεν",343,165],["ἐπὶ",9,1],["τῷ",1,110],["δεσπότῃ",1013,113],["σωθήσεται",171,125]],"[they] fearing and reverencing men [unreasonably] have been overthrown, but he that trusts in the Lord shall rejoice. Ungodliness causes a man to stumble: but he that trusts in his master shall be safe."],["26",[["Πολλοὶ",74,130],["θεραπεύουσι",1677,189],["πρόσωπα",47,43],["ἡγουμένων",374,615],["παρὰ",72,1],["δὲ",14,12],["Κυρίου",7,21],["γίνεται",30,108],["τὸ",1,32],["δίκαιον",152,29],["ἀνδρί",38,113]],"Many wait on the favour of rulers; but justice comes to a man from the Lord."],["27",[["Βδέλυγμα",475,33],["δίκαιος",152,16],["ἀνὴρ",38,5],["ἀνδρὶ",38,113],["ἀδίκῳ",402,111],["βδέλυγμα",475,33],["δὲ",14,12],["ἀνόμῳ",532,111],["κατευθύνουσα",828,181],["ὁδός",67,13]],"A righteous man is an abomination to an unrighteous man, and the direct way is an abomination to the sinner."]]