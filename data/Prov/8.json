[["1",[["Σὺ",5,156],["τὴν",1,9],["σοφίαν",242,10],["κηρύξεις",1438,159],["ἵνα",102,8],["φρόνησίς",833,13],["σοι",5,151],["ὑπακούσῃ",867,116]],"Thou shalt proclaim wisdom, that understanding may be obedient to thee."],["2",[["Ἐπὶ",9,1],["γὰρ",40,12],["τῶν",1,44],["ὑψηλῶν",289,79],["ἄκρων",723,45],["ἐστὶν",10,87],["ἀναμέσον",215,28],["δὲ",14,12],["τῶν",1,123],["τρίβων",745,61],["ἕστηκε",78,165]],"For she is on lofty eminences, and stands in the midst of the ways."],["3",[["Παρὰ",73,1],["γὰρ",40,12],["πύλαις",162,71],["δυναστῶν",803,77],["παρεδρεύει",5907,87],["ἐν",4,1],["δὲ",14,12],["εἰσόδοις",1002,71],["ὑμνεῖται",855,108]],"For she sits by the gates of princes, and sings in the entrances, [saying],"],["4",[["Ὑμᾶς",5,209],["ὦ",646,316],["ἄνθρωποι",43,51],["παρακαλῶ",434,149],["καὶ",2,8],["προΐεμαι",2620,251],["ἐμὴν",525,10],["φωνὴν",95,10],["υἱοῖς",13,139],["ἀνθρώπων",43,77]],"You, O men, I exhort; and utter my voice to the sons of men."],["5",[["Νοήσατε",1383,69],["ἄκακοι",2520,130],["πανουργίαν",3315,10],["οἱ",1,128],["δὲ",14,12],["ἀπαίδευτοι",2049,130],["ἔνθεσθε",55,268],["καρδίαν",64,10]],"O ye simple, understand subtlety, and ye that are untaught, imbibe knowledge."],["6",[["Εἰσακούσατέ",241,69],["μου",6,48],["σεμνὰ",2764,74],["γὰρ",40,12],["ἐρῶ",165,157],["καὶ",2,8],["ἀνοίσω",384,157],["ἀπὸ",17,1],["χειλέων",361,45],["ὀρθά",1537,74]],"Hearken to me; for I will speak solemn [truths]; and will produce right [sayings] from my lips."],["7",[["Ὅτι",19,8],["ἀλήθειαν",352,10],["μελετήσει",1347,120],["ὁ",1,4],["φάρυγξ",2973,5],["μου",6,48],["ἐβδελυγμένα",1056,441],["δὲ",14,12],["ἐναντίον",138,17],["ἐμοῦ",6,48],["χείλη",361,43],["ψευδῆ",549,65]],"For my throat shall meditate truth; and false lips are an abomination before me."],["8",[["Μετὰ",29,1],["δικαιοσύνης",187,19],["πάντα",11,65],["τὰ",1,42],["ῥήματα",116,43],["τοῦ",1,23],["στόματός",123,24],["μου",6,48],["οὐδὲν",228,29],["ἐαυτοῖς",0,0],["σκολιὸν",1690,29],["οὐδὲ",106,12],["στραγγαλιῶδες",8299,29]],"All the words of my mouth are in righteousness; there is nothing in them wrong or perverse."],["9",[["Πάντα",11,65],["ἐνώπια",3000,65],["τοῖς",1,138],["συνιοῦσι",2291,352],["καὶ",2,8],["ὀρθὰ",1537,74],["τοῖς",1,138],["εὑρίσκουσι",101,352],["γνῶσιν",753,10]],"They are all evident to those that understand, and right to those that find knowledge."],["10",[["Λάβετε",46,69],["παιδείαν",571,10],["καὶ",2,8],["μὴ",25,8],["ἀργύριον",152,33],["καὶ",2,8],["γνῶσιν",753,10],["ὑπὲρ",139,1],["χρυσίον",202,20],["δεδοκιμασμένον",1269,326]],"Receive instruction, and not silver; and knowledge rather than tried gold."],["11",[["Κρείσσων",922,15],["γὰρ",40,12],["σοφία",242,13],["λίθων",195,77],["πολυτελῶν",2282,163],["πᾶν",11,29],["δὲ",14,12],["τίμιον",1189,29],["οὐκ",12,17],["ἄξιον",1102,29],["αὐτῆς",3,83],["ἐστιν",10,87]],"For wisdom is better than precious stones; and no valuable substance is of equal worth with it."],["12",[["Ἐγὼ",6,179],["ἡ",1,11],["σοφία",242,13],["κατεσκήνωσα",805,147],["βουλὴν",350,10],["καὶ",2,8],["γνῶσιν",753,10],["καὶ",2,8],["ἔννοιαν",2323,10],["ἐγὼ",6,158],["ἐπεκαλεσάμην",341,152]],"I wisdom have dwelt [with] counsel and knowledge, and I have called upon understanding."],["13",[["Φόβος",333,5],["Κυρίου",7,21],["μισεῖ",351,87],["ἀδικίαν",288,10],["ὕβριν",837,10],["τε",209,12],["καὶ",2,8],["ὑπερηφανίαν",1131,10],["καὶ",2,8],["ὁδοὺς",68,40],["πονηρῶν",164,79],["μεμίσηκα",351,85],["δὲ",14,12],["ἐγὼ",6,158],["διεστραμμένας",1322,454],["ὁδοὺς",68,40],["κακῶν",161,79]],"The fear of the Lord hates unrighteousness, and insolence, and pride, and the ways of wicked men; and I hate the perverse ways of bad men."],["14",[["Ἐμὴ",525,13],["βουλὴ",350,13],["καὶ",2,8],["ἀσφάλεια",2051,13],["ἐμὴ",525,13],["φρόνησις",833,13],["ἐμὴ",525,13],["δὲ",14,12],["ἰσχύς",181,13]],"Counsel and safety are mine: prudence is mine, and strength is mine."],["15",[["Διʼ",56,1],["ἐμοῦ",6,48],["βασιλεῖς",22,51],["βασιλεύουσι",151,191],["καὶ",2,8],["οἱ",1,128],["δυνάσται",803,51],["γράφουσιν",186,191],["δικαιοσύνην",187,10]],"By me kings reign, and princes decree justice."],["16",[["Διʼ",56,1],["ἐμοῦ",6,48],["μεγιστᾶνες",1825,51],["μεγαλύνονται",604,299],["καὶ",2,8],["τύραννοι",784,51],["διʼ",56,1],["ἐμοῦ",6,83],["κρατοῦσι",385,191],["γῆς",26,19]],"By me nobles become great, and monarchs by me rule over the earth."],["17",[["Ἐγὼ",6,158],["τοὺς",1,56],["ἐμὲ",6,82],["φιλοῦντας",1391,229],["ἀγαπῶ",214,149],["οἱ",1,128],["δὲ",14,12],["ἐμὲ",6,82],["ζητοῦντες",191,137],["εὑρήσουσιν",101,207]],"I love those that love me; and they that seek me shall find [me]."],["18",[["Πλοῦτος",574,5],["καὶ",2,8],["δόξα",141,188],["ἐμοὶ",6,49],["ὑπάρχει",418,87],["καὶ",2,8],["κτῆσις",1274,13],["πολλῶν",74,163],["καὶ",2,8],["δικαιοσύνη",187,13]],"Wealth and glory belong to me; yea, abundant possessions and righteousness."],["19",[["Βέλτιον",2010,29],["ἐμὲ",6,82],["καρπίζεσθαι",5677,104],["ὑπὲρ",139,1],["χρυσίον",202,20],["καὶ",2,8],["λίθον",195,7],["τίμιον",1189,59],["τὰ",1,42],["δὲ",14,12],["ἐμὰ",525,43],["γεννήματα",742,43],["κρείσσω",922,65],["ἀργυρίου",152,24],["ἐκλεκτοῦ",552,88]],"[It is] better to have my fruit than [to have] gold and precious stones; and my produce is better than choice silver."],["20",[["Ἐν",4,1],["ὁδοῖς",68,71],["δικαιοσύνης",187,19],["περιπατῶ",1327,149],["καὶ",2,8],["ἀναμέσον",215,28],["τρίβων",745,61],["δικαιώματος",428,24],["ἀναστρέφομαι",522,251]],"I walk in ways of righteousness, and [am] conversant with the paths of judgment;"],["21",[["ἵνα",102,8],["μερίσω",1348,157],["τοῖς",1,138],["ἐμὲ",6,98],["ἀγαπῶσιν",214,352],["ὕπαρξιν",2434,10],["καὶ",2,8],["τοὺς",1,56],["θησαυροὺς",579,31],["αὐτῶν",3,41],["ἐμπλήσω",427,157],["ἀγαθῶν",114,163]],"that I may divide substance to them that love me, and may fill their treasures with good things."],["21a",[["ἐὰν",45,8],["ἀναγγείλω",231,227],["ὑμῖν",5,86],["τὰ",1,42],["καθʼ",32,1],["ἡμέραν",28,10],["γινόμενα",30,203],["μνημονεύσω",1900,157],["τὰ",1,42],["ἐξ",21,1],["αἰῶνος",100,21],["ἀριθμῆσαι",1429,100]],"If I declare to you the things that daily happen, I will remember [also] to recount the things of old."],["22",[["Κύριος",7,5],["ἔκτισέ",786,3],["με",6,98],["ἀρχὴν",270,10],["ὁδῶν",68,61],["αὐτοῦ",3,48],["εἰς",8,1],["ἔργα",105,43],["αὐτοῦ",3,48]],"The Lord made me the beginning of his ways for his works."],["23",[["πρὸ",238,1],["τοῦ",1,30],["αἰῶνος",100,21],["ἐθεμελίωσέ",1116,3],["με",6,82],["ἐν",4,1],["ἀρχῇ",270,2],["πρὸ",238,1],["τοῦ",1,30],["τὴν",1,9],["γῆν",26,10],["ποιῆσαι",23,100]],"He established me before time [was] in the beginning, before he made the earth:"],["24",[["καὶ",2,8],["πρὸ",238,1],["τοῦ",1,30],["τὰς",1,39],["ἀβύσσους",1083,40],["ποιῆσαι",23,100],["πρὸ",238,1],["τοῦ",1,30],["προελθεῖν",2761,100],["τὰς",1,39],["πηγὰς",565,40],["τῶν",1,44],["ὑδάτων",85,45]],"even before he made the depths; before the fountains of water came forth:"],["25",[["Πρὸ",238,1],["τοῦ",1,30],["ὄρη",87,43],["ἑδρασθῆναι",5345,175],["πρὸ",238,1],["δὲ",14,12],["πάντων",11,163],["βουνῶν",577,77],["γεννᾷ",222,173],["με",6,82]],"before the mountains were settled, and before all hills, he begets me."],["26",[["Κύριος",7,5],["ἐποίησε",23,3],["χώρας",278,40],["καὶ",2,8],["ἀοικήτους",2657,109],["καὶ",2,8],["ἄκρα",889,13],["οἰκούμενα",528,64],["τῆς",1,18],["ὑπʼ",122,1],["οὐρανῶν",94,77]],"The Lord made countries and uninhabited [tracts], and the highest inhabited parts of the world."],["27",[["Ἡνίκα",543,17],["ἡτοίμαζε",371,14],["τὸν",1,6],["οὐρανὸν",94,7],["συμπαρήμην",6101,429],["αὐτῷ",3,49],["καὶ",2,8],["ὅτε",432,8],["ἀφώριζε",636,14],["τὸν",1,6],["ἑαυτοῦ",92,48],["θρόνον",383,7],["ἐπʼ",9,1],["ἀνέμων",850,77]],"When he prepared the heaven, I was present with him; and when he prepared his throne upon the winds:"],["28",[["καὶ",2,8],["ὡς",36,8],["ἰσχυρὰ",401,74],["ἐποίει",23,14],["τὰ",1,253],["ἄνω",1314,17],["νέφη",1555,63],["καὶ",2,8],["ὡς",36,8],["ἀσφαλεῖς",3715,109],["ἐτίθει",110,14],["πηγὰς",565,40],["τῆς",1,18],["ὑπʼ",122,1],["οὐρανὸν",94,7]],"and when he strengthened the clouds above; and when he secured the fountains of the earth:"],["29",[["καὶ",2,8],["ὡς",36,8],["ἰσχυρὰ",401,74],["ἐποίει",23,14],["τὰ",1,253],["θεμέλια",950,63],["τῆς",1,18],["γῆς",26,19]],"and when he strengthened the foundations of the earth:"],["30",[["ἤμην",10,429],["παρʼ",73,1],["αὐτῷ",3,49],["ἁρμόζουσα",2989,183],["ἐγὼ",6,179],["ἤμην",10,429],["ᾗ",24,102],["προσέχαιρε",8128,14],["καθʼ",32,1],["ἡμέραν",28,10],["δὲ",14,12],["εὐφραινόμην",244,374],["ἐν",4,1],["προσώπῳ",47,53],["αὐτοῦ",3,48],["ἐν",4,1],["παντὶ",11,111],["καιρῷ",132,113]],"I was by him, suiting [myself to him], I was that wherein he took delight; and daily I rejoiced in his presence continually."],["31",[["ὅτε",432,8],["ἐνευφραίνετο",6453,22],["τὴν",1,9],["οἰκουμένην",1326,10],["συντελέσας",317,155],["καὶ",2,8],["ἐνευφραίνετο",6453,22],["ἐν",4,1],["υἱοῖς",13,139],["ἀνθρώπων",43,77]],"For he rejoiced when he had completed the world, and rejoiced among the children of men."],["32",[["Νῦν",90,17],["οὖν",227,12],["υἱὲ",13,250],["ἄκουέ",54,239],["μου",6,48]],"Now then, [my] son, hear me:",{"s":"r"}],["34",[["μακάριος",806,16],["ἀνὴρ",38,5],["ὃς",24,246],["εἰσακούσεταί",241,89],["μου",6,48],["καὶ",2,8],["ἄνθρωπος",43,5],["ὃς",24,246],["τὰς",1,39],["ἐμὰς",525,40],["ὁδοὺς",68,40],["φυλάξει",125,120],["ἀγρυπνῶν",2802,67],["ἐπʼ",9,1],["ἐμαῖς",525,71],["θύραις",277,71],["καθʼ",32,1],["ἡμέραν",28,10],["τηρῶν",1358,67],["σταθμοὺς",969,31],["ἐμῶν",525,61],["εἰσόδων",1002,61]],"blessed is the man who shall hearken to me, and the mortal who shall keep my ways; watching daily at my doors, waiting at the posts of my entrances.",{"s":"r"}],["35",[["Αἱ",1,185],["γὰρ",40,12],["ἔξοδοί",762,180],["μου",6,83],["ἔξοδοι",762,180],["ζωῆς",216,19],["καὶ",2,8],["ἑτοιμάζεται",371,108],["θέλησις",7274,13],["παρὰ",73,1],["Κυρίου",7,21]],"For my outgoings are the outgoings of life, and [in them] is prepared favour from the Lord."],["36",[["Οἱ",1,128],["δὲ",14,12],["ἁμαρτάνοντες",237,137],["εἰς",8,1],["ἐμὲ",6,82],["ἀσεβοῦσιν",1256,191],["εἰς",8,1],["τὰς",1,39],["ἑαυτῶν",92,41],["ψυχὰς",63,40],["καὶ",2,8],["οἱ",1,128],["μισοῦντές",351,137],["με",6,82],["ἀγαπῶσι",214,191],["θάνατον",170,7]],"But they that sin against me act wickedly against their own souls: and they that hate me love death."]]