[["1",[["Σὺ",5,156],["τὴν",1,9],["σοφίαν",238,10],["κηρύξεις",1438,159],["ἵνα",101,8],["φρόνησίς",834,13],["σοι",5,151],["ὑπακούσῃ",868,116]],"Thou shalt proclaim wisdom, that understanding may be obedient to thee."],["2",[["Ἐπὶ",9,1],["γὰρ",40,12],["τῶν",1,44],["ὑψηλῶν",289,79],["ἄκρων",723,45],["ἐστὶν",10,87],["ἀναμέσον",211,28],["δὲ",14,12],["τῶν",1,123],["τρίβων",744,61],["ἕστηκε",78,165]],"For she is on lofty eminences, and stands in the midst of the ways."],["3",[["Παρὰ",72,1],["γὰρ",40,12],["πύλαις",162,71],["δυναστῶν",800,77],["παρεδρεύει",5937,87],["ἐν",4,1],["δὲ",14,12],["εἰσόδοις",1002,71],["ὑμνεῖται",856,108]],"For she sits by the gates of princes, and sings in the entrances, [saying],"],["4",[["Ὑμᾶς",5,209],["ὦ",641,320],["ἄνθρωποι",43,51],["παρακαλῶ",432,149],["καὶ",2,8],["προΐεμαι",2623,252],["ἐμὴν",523,10],["φωνὴν",95,10],["υἱοῖς",13,139],["ἀνθρώπων",43,77]],"You, O men, I exhort; and utter my voice to the sons of men."],["5",[["Νοήσατε",1384,69],["ἄκακοι",2523,130],["πανουργίαν",3321,10],["οἱ",1,128],["δὲ",14,12],["ἀπαίδευτοι",2054,130],["ἔνθεσθε",56,268],["καρδίαν",63,10]],"O ye simple, understand subtlety, and ye that are untaught, imbibe knowledge."],["6",[["Εἰσακούσατέ",237,69],["μου",6,48],["σεμνὰ",2774,74],["γὰρ",40,12],["ἐρῶ",1659,149],["καὶ",2,8],["ἀνοίσω",382,157],["ἀπὸ",17,1],["χειλέων",361,45],["ὀρθά",1536,74]],"Hearken to me; for I will speak solemn [truths]; and will produce right [sayings] from my lips."],["7",[["Ὅτι",19,8],["ἀλήθειαν",350,10],["μελετήσει",1344,120],["ὁ",1,4],["φάρυγξ",2985,5],["μου",6,48],["ἐβδελυγμένα",0,0],["δὲ",14,12],["ἐναντίον",138,17],["ἐμοῦ",6,48],["χείλη",361,43],["ψευδῆ",547,65]],"For my throat shall meditate truth; and false lips are an abomination before me."],["8",[["Μετὰ",29,1],["δικαιοσύνης",185,19],["πάντα",11,65],["τὰ",1,42],["ῥήματα",115,43],["τοῦ",1,23],["στόματός",123,24],["μου",6,48],["οὐδὲν",225,29],["ἐαυτοῖς",0,0],["σκολιὸν",1693,29],["οὐδὲ",105,12],["στραγγαλιῶδες",8357,29]],"All the words of my mouth are in righteousness; there is nothing in them wrong or perverse."],["9",[["Πάντα",11,65],["ἐνώπια",3011,65],["τοῖς",1,138],["συνιοῦσι",2303,357],["καὶ",2,8],["ὀρθὰ",1536,74],["τοῖς",1,138],["εὑρίσκουσι",106,357],["γνῶσιν",753,10]],"They are all evident to those that understand, and right to those that find knowledge."],["10",[["Λάβετε",46,69],["παιδείαν",569,10],["καὶ",2,8],["μὴ",25,8],["ἀργύριον",150,33],["καὶ",2,8],["γνῶσιν",753,10],["ὑπὲρ",139,1],["χρυσίον",202,20],["δεδοκιμασμένον",0,0]],"Receive instruction, and not silver; and knowledge rather than tried gold."],["11",[["Κρείσσων",922,15],["γὰρ",40,12],["σοφία",238,13],["λίθων",195,77],["πολυτελῶν",2294,163],["πᾶν",11,29],["δὲ",14,12],["τίμιον",1190,29],["οὐκ",12,17],["ἄξιον",1104,29],["αὐτῆς",3,83],["ἐστιν",10,87]],"For wisdom is better than precious stones; and no valuable substance is of equal worth with it."],["12",[["Ἐγὼ",6,178],["ἡ",1,11],["σοφία",238,13],["κατεσκήνωσα",802,147],["βουλὴν",349,10],["καὶ",2,8],["γνῶσιν",753,10],["καὶ",2,8],["ἔννοιαν",2335,10],["ἐγὼ",6,158],["ἐπεκαλεσάμην",340,152]],"I wisdom have dwelt [with] counsel and knowledge, and I have called upon understanding."],["13",[["Φόβος",330,5],["Κυρίου",7,21],["μισεῖ",355,87],["ἀδικίαν",288,10],["ὕβριν",838,10],["τε",207,12],["καὶ",2,8],["ὑπερηφανίαν",1130,10],["καὶ",2,8],["ὁδοὺς",67,40],["πονηρῶν",164,79],["μεμίσηκα",0,0],["δὲ",14,12],["ἐγὼ",6,158],["διεστραμμένας",1322,460],["ὁδοὺς",67,40],["κακῶν",161,79]],"The fear of the Lord hates unrighteousness, and insolence, and pride, and the ways of wicked men; and I hate the perverse ways of bad men."],["14",[["Ἐμὴ",523,13],["βουλὴ",349,13],["καὶ",2,8],["ἀσφάλεια",2057,13],["ἐμὴ",523,13],["φρόνησις",834,13],["ἐμὴ",523,13],["δὲ",14,12],["ἰσχύς",180,13]],"Counsel and safety are mine: prudence is mine, and strength is mine."],["15",[["Διʼ",54,1],["ἐμοῦ",6,48],["βασιλεῖς",22,51],["βασιλεύουσι",151,189],["καὶ",2,8],["οἱ",1,128],["δυνάσται",800,51],["γράφουσιν",186,189],["δικαιοσύνην",185,10]],"By me kings reign, and princes decree justice."],["16",[["Διʼ",54,1],["ἐμοῦ",6,48],["μεγιστᾶνες",1827,51],["μεγαλύνονται",606,303],["καὶ",2,8],["τύραννοι",784,51],["διʼ",54,1],["ἐμοῦ",6,83],["κρατοῦσι",383,189],["γῆς",26,19]],"By me nobles become great, and monarchs by me rule over the earth."],["17",[["Ἐγὼ",6,158],["τοὺς",1,56],["ἐμὲ",6,82],["φιλοῦντας",1393,229],["ἀγαπῶ",224,149],["οἱ",1,128],["δὲ",14,12],["ἐμὲ",6,82],["ζητοῦντες",190,137],["εὑρήσουσιν",106,207]],"I love those that love me; and they that seek me shall find [me]."],["18",[["Πλοῦτος",572,5],["καὶ",2,8],["δόξα",141,186],["ἐμοὶ",6,49],["ὑπάρχει",416,87],["καὶ",2,8],["κτῆσις",1440,13],["πολλῶν",74,163],["καὶ",2,8],["δικαιοσύνη",185,13]],"Wealth and glory belong to me; yea, abundant possessions and righteousness."],["19",[["Βέλτιον",2018,29],["ἐμὲ",6,82],["καρπίζεσθαι",5710,104],["ὑπὲρ",139,1],["χρυσίον",202,20],["καὶ",2,8],["λίθον",195,7],["τίμιον",1190,59],["τὰ",1,42],["δὲ",14,12],["ἐμὰ",523,43],["γεννήματα",740,43],["κρείσσω",922,65],["ἀργυρίου",150,24],["ἐκλεκτοῦ",551,88]],"[It is] better to have my fruit than [to have] gold and precious stones; and my produce is better than choice silver."],["20",[["Ἐν",4,1],["ὁδοῖς",67,71],["δικαιοσύνης",185,19],["περιπατῶ",1327,149],["καὶ",2,8],["ἀναμέσον",211,28],["τρίβων",744,61],["δικαιώματος",425,24],["ἀναστρέφομαι",520,252]],"I walk in ways of righteousness, and [am] conversant with the paths of judgment;"],["21",[["ἵνα",101,8],["μερίσω",1382,157],["τοῖς",1,138],["ἐμὲ",6,98],["ἀγαπῶσιν",224,357],["ὕπαρξιν",2439,10],["καὶ",2,8],["τοὺς",1,56],["θησαυροὺς",577,31],["αὐτῶν",3,41],["ἐμπλήσω",424,157],["ἀγαθῶν",113,163]],"that I may divide substance to them that love me, and may fill their treasures with good things."],["21a",[["ἐὰν",45,8],["ἀναγγείλω",228,227],["ὑμῖν",5,86],["τὰ",1,42],["καθʼ",32,1],["ἡμέραν",28,10],["γινόμενα",30,203],["μνημονεύσω",1901,157],["τὰ",1,42],["ἐξ",21,1],["αἰῶνος",100,21],["ἀριθμῆσαι",1430,100]],"If I declare to you the things that daily happen, I will remember [also] to recount the things of old."],["22",[["Κύριος",7,5],["ἔκτισέ",951,3],["με",6,98],["ἀρχὴν",269,10],["ὁδῶν",67,61],["αὐτοῦ",3,48],["εἰς",8,1],["ἔργα",104,43],["αὐτοῦ",3,48]],"The Lord made me the beginning of his ways for his works."],["23",[["πρὸ",235,1],["τοῦ",1,30],["αἰῶνος",100,21],["ἐθεμελίωσέ",1203,3],["με",6,82],["ἐν",4,1],["ἀρχῇ",269,2],["πρὸ",235,1],["τοῦ",1,30],["τὴν",1,9],["γῆν",26,10],["ποιῆσαι",23,100]],"He established me before time [was] in the beginning, before he made the earth:"],["24",[["καὶ",2,8],["πρὸ",235,1],["τοῦ",1,30],["τὰς",1,39],["ἀβύσσους",1084,40],["ποιῆσαι",23,100],["πρὸ",235,1],["τοῦ",1,30],["προελθεῖν",2771,100],["τὰς",1,39],["πηγὰς",563,40],["τῶν",1,44],["ὑδάτων",85,45]],"even before he made the depths; before the fountains of water came forth:"],["25",[["Πρὸ",235,1],["τοῦ",1,30],["ὄρη",86,43],["ἑδρασθῆναι",6574,174],["πρὸ",235,1],["δὲ",14,12],["πάντων",11,163],["βουνῶν",575,77],["γεννᾷ",222,172],["με",6,82]],"before the mountains were settled, and before all hills, he begets me."],["26",[["Κύριος",7,5],["ἐποίησε",23,3],["χώρας",278,40],["καὶ",2,8],["ἀοικήτους",2660,109],["καὶ",2,8],["ἄκρα",890,13],["οἰκούμενα",526,64],["τῆς",1,18],["ὑπʼ",122,1],["οὐρανῶν",94,77]],"The Lord made countries and uninhabited [tracts], and the highest inhabited parts of the world."],["27",[["Ἡνίκα",541,17],["ἡτοίμαζε",371,14],["τὸν",1,6],["οὐρανὸν",94,7],["συμπαρήμην",6129,435],["αὐτῷ",3,49],["καὶ",2,8],["ὅτε",430,8],["ἀφώριζε",1218,14],["τὸν",1,6],["ἑαυτοῦ",92,48],["θρόνον",379,7],["ἐπʼ",9,1],["ἀνέμων",852,77]],"When he prepared the heaven, I was present with him; and when he prepared his throne upon the winds:"],["28",[["καὶ",2,8],["ὡς",36,8],["ἰσχυρὰ",398,74],["ἐποίει",23,14],["τὰ",1,254],["ἄνω",1314,17],["νέφη",1554,63],["καὶ",2,8],["ὡς",36,8],["ἀσφαλεῖς",3721,109],["ἐτίθει",109,14],["πηγὰς",563,40],["τῆς",1,18],["ὑπʼ",122,1],["οὐρανὸν",94,7]],"and when he strengthened the clouds above; and when he secured the fountains of the earth:"],["29",[["καὶ",2,8],["ὡς",36,8],["ἰσχυρὰ",398,74],["ἐποίει",23,14],["τὰ",1,254],["θεμέλια",950,63],["τῆς",1,18],["γῆς",26,19]],"and when he strengthened the foundations of the earth:"],["30",[["ἤμην",10,435],["παρʼ",72,1],["αὐτῷ",3,49],["ἁρμόζουσα",3421,181],["ἐγὼ",6,178],["ἤμην",10,435],["ᾗ",24,102],["προσέχαιρε",8188,14],["καθʼ",32,1],["ἡμέραν",28,10],["δὲ",14,12],["εὐφραινόμην",242,380],["ἐν",4,1],["προσώπῳ",47,53],["αὐτοῦ",3,48],["ἐν",4,1],["παντὶ",11,111],["καιρῷ",132,113]],"I was by him, suiting [myself to him], I was that wherein he took delight; and daily I rejoiced in his presence continually."],["31",[["ὅτε",430,8],["ἐνευφραίνετο",6486,22],["τὴν",1,9],["οἰκουμένην",1326,10],["συντελέσας",316,155],["καὶ",2,8],["ἐνευφραίνετο",6486,22],["ἐν",4,1],["υἱοῖς",13,139],["ἀνθρώπων",43,77]],"For he rejoiced when he had completed the world, and rejoiced among the children of men."],["32",[["Νῦν",89,17],["οὖν",223,12],["υἱὲ",13,251],["ἄκουέ",53,239],["μου",6,48]],"Now then, [my] son, hear me: blessed is the man who shall hearken to me, and the mortal who shall keep my ways;"],["34",[["μακάριος",803,16],["ἀνὴρ",38,5],["ὃς",24,247],["εἰσακούσεταί",237,89],["μου",6,48],["καὶ",2,8],["ἄνθρωπος",43,5],["ὃς",24,247],["τὰς",1,39],["ἐμὰς",523,40],["ὁδοὺς",67,40],["φυλάξει",127,120],["ἀγρυπνῶν",2812,67],["ἐπʼ",9,1],["ἐμαῖς",523,71],["θύραις",277,71],["καθʼ",32,1],["ἡμέραν",28,10],["τηρῶν",1356,67],["σταθμοὺς",970,31],["ἐμῶν",523,61],["εἰσόδων",1002,61]],"watching daily at my doors, waiting at the posts of my entrances."],["35",[["Αἱ",1,183],["γὰρ",40,12],["ἔξοδοί",758,179],["μου",6,83],["ἔξοδοι",758,179],["ζωῆς",212,19],["καὶ",2,8],["ἑτοιμάζεται",371,108],["θέλησις",7326,13],["παρὰ",72,1],["Κυρίου",7,21]],"For my outgoings are the outgoings of life, and [in them] is prepared favour from the Lord."],["36",[["Οἱ",1,128],["δὲ",14,12],["ἁμαρτάνοντες",244,137],["εἰς",8,1],["ἐμὲ",6,82],["ἀσεβοῦσιν",1313,189],["εἰς",8,1],["τὰς",1,39],["ἑαυτῶν",92,41],["ψυχὰς",62,40],["καὶ",2,8],["οἱ",1,128],["μισοῦντές",355,137],["με",6,82],["ἀγαπῶσι",224,189],["θάνατον",169,7]],"But they that sin against me act wickedly against their own souls: and they that hate me love death."]]