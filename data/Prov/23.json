[["1",[["Ἐὰν",45,8],["καθίσῃς",274,170],["δειπνεῖν",5534,54],["ἐπὶ",9,1],["τραπέζης",650,19],["δυνάστου",803,21],["νοητῶς",7762,17],["νόει",1383,239],["τὰ",1,42],["παρατιθέμενά",1279,203],["σοι",5,151]],"If thou sit to sup at the table of a prince, consider attentively the things set before thee:"],["2",[["Καὶ",2,8],["ἐπίβαλλε",724,239],["τὴν",1,9],["χεῖρά",37,10],["σου",5,146],["εἰδὼς",53,264],["ὅτι",19,8],["τοιαῦτά",630,376],["σε",5,161],["δεῖ",1158,14],["παρασκευάσαι",2275,100],["εἰ",77,8],["δὲ",14,12],["ἀπληστότερος",4558,16],["εἶ",10,145]],"and apply thine hand, knowing that it behoves thee to prepare such [meats]: but if thou art very insatiable,"],["3",[["μὴ",25,8],["ἐπιθύμει",915,239],["τῶν",1,44],["ἐδεσμάτων",2145,45],["αὐτοῦ",3,48],["ταῦτα",16,248],["γὰρ",40,12],["ἔχεται",124,108],["ζωῆς",216,19],["ψευδοῦς",549,78]],"desire not his provisions; for these belong to a false life."],["4",[["Μὴ",25,8],["παρεκτείνου",5908,249],["πένης",672,5],["ὢν",10,67],["πλουσίῳ",952,111],["τῇ",1,95],["δὲ",14,12],["σῇ",405,2],["ἐννοίᾳ",2323,2],["ἀπόσχου",1255,169]],"If thou art poor, measure not thyself with a rich man; but refrain thyself in thy wisdom."],["5",[["Ἐὰν",45,8],["ἐπιστήσῃς",631,170],["τὸ",1,32],["σὸν",405,33],["ὄμμα",3024,33],["πρὸς",15,1],["αὐτὸν",3,82],["οὐδαμοῦ",4334,17],["φανεῖται",832,89],["κατεσκεύασται",1437,182],["γὰρ",40,12],["αὐτῷ",3,49],["πτέρυγες",719,180],["ὥσπερ",226,17],["ἀετοῦ",1567,21],["καὶ",2,8],["ὑποστρέφει",2238,87],["εἰς",8,1],["τὸν",1,6],["οἶκον",34,7],["τοῦ",1,30],["προεστηκότος",3340,305],["αὐτοῦ",3,48]],"If thou shouldest fix thine eye upon him, he will disappear; for wings like an eagle's are prepared for him, and he returns to the house of his master."],["6",[["Μὴ",25,8],["συνδείπνει",6106,239],["ἀνδρὶ",38,113],["βασκάνῳ",3795,111],["μηδὲ",414,12],["ἐπιθύμει",915,239],["τῶν",1,44],["βρωμάτων",714,45],["αὐτοῦ",3,48]],"Sup not with an envious man, neither desire thou his meats:"],["7",[["ὃν",24,106],["τρόπον",245,7],["γὰρ",40,12],["εἴ",77,8],["τις",39,150],["καταπίοι",1183,216],["τρίχα",1038,10],["οὕτως",71,17],["ἐσθίει",147,87],["καὶ",2,8],["πίνει",212,87],["μηδὲ",414,12],["πρὸς",15,1],["σὲ",5,161],["εἰσαγάγῃς",389,170],["αὐτὸν",3,82],["καὶ",2,8],["φάγῃς",147,170],["τὸν",1,6],["ψωμόν",2510,7],["σου",5,146],["μετʼ",29,1],["αὐτοῦ",3,48]],"so he eats and drinks as if any one should swallow a hair, and do not bring him in to thyself, nor eat thy morsel with him:"],["8",[["ἐξεμέσει",4590,120],["γὰρ",40,12],["αὐτὸν",3,82],["καὶ",2,8],["λυμανεῖται",2462,89],["τοὺς",1,56],["λόγους",48,31],["σου",5,146],["τοὺς",1,56],["καλούς",266,58]],"for he will vomit it up, and spoil thy fair words."],["9",[["Εἰς",8,1],["ὦτα",328,43],["ἄφρονος",439,219],["μηδὲν",908,29],["λέγε",31,239],["μήποτε",964,17],["μυκτηρίσῃ",2096,116],["τοὺς",1,56],["συνετοὺς",954,58],["λόγους",48,31],["σου",5,146]],"Say nothing in the ears of a fool, lest at any time he sneer at thy wise words."],["10",[["Μὴ",25,8],["μεταθῇς",2027,170],["ὅρια",236,43],["αἰώνια",391,65],["εἰς",8,1],["δὲ",14,12],["κτῆμα",2459,33],["ὀρφανῶν",957,115],["μὴ",25,8],["εἰσέλθῃς",86,170]],"Remove not the ancient landmarks; and enter not upon the possession of the fatherless:"],["11",[["Ὁ",1,4],["γὰρ",40,12],["λυτρούμενος",535,114],["αὐτοὺς",3,60],["Κύριος",7,5],["κραταιός",862,16],["ἐστι",10,87],["καὶ",2,8],["κρινεῖ",263,120],["τὴν",1,9],["κρίσιν",229,10],["αὐτῶν",3,41],["μετὰ",29,1],["σοῦ",5,146]],"for the Lord is their redeemer; he is mighty, and will plead their cause with thee."],["12",[["Δὸς",33,198],["εἰς",8,1],["παιδείαν",571,10],["τὴν",1,9],["καρδίαν",64,10],["σου",5,146],["τὰ",1,42],["δὲ",14,12],["ὦτά",328,43],["σου",5,146],["ἑτοίμασον",371,198],["λόγοις",48,139],["αἰσθήσεως",1619,19]],"Apply thine heart to instruction, and prepare thine ears for words of discretion."],["13",[["Μὴ",25,8],["ἀπόσχῃ",1255,160],["νήπιον",1016,28],["παιδεύειν",643,54],["ὅτι",19,8],["ἐὰν",45,8],["πατάξῃς",145,170],["αὐτὸν",3,82],["ῥάβδῳ",493,2],["οὐ",12,17],["μὴ",25,8],["ἀποθάνῃ",109,160]],"Refrain not from chastening a child; for if thou beat him with the rod, he shall not die."],["14",[["Συ",5,156],["μὲν",281,12],["γὰρ",40,12],["πατάξεις",145,159],["αὐτὸν",3,82],["ῥάβδῳ",493,2],["τὴν",1,9],["δὲ",14,12],["ψυχὴν",63,10],["αὐτοῦ",3,48],["ἐκ",21,1],["θανάτου",170,21],["ῥύσῃ",337,116]],"For thou shalt beat him with the rod, and shalt deliver his soul from death."],["15",[["Υἱὲ",13,250],["ἐὰν",45,8],["σοφὴ",324,15],["γένηταί",30,236],["σου",5,146],["ἡ",1,11],["καρδία",64,13],["εὐφρανεῖς",244,159],["καὶ",2,8],["τὴν",1,9],["ἐμὴν",525,10],["καρδίαν",64,10]],"Son, if thy heart be wise, thou shalt also gladden my heart;"],["16",[["καὶ",2,8],["ἐνδιατρίψει",9398,120],["λόγοις",48,139],["τὰ",1,42],["σὰ",405,43],["χείλη",361,43],["πρὸς",15,1],["τὰ",1,42],["ἐμὰ",525,43],["χείλη",361,43],["ἐὰν",45,8],["ὀρθὰ",1537,65],["ὦσι",10,265]],"and thy lips shall converse with my lips, if they be right."],["17",[["Μὴ",25,8],["ζηλούτω",1057,35],["ἡ",1,11],["καρδία",64,13],["σου",5,146],["ἁμαρτωλοὺς",409,58],["ἀλλὰ",108,17],["ἐν",4,1],["φόβῳ",333,113],["Κυρίου",7,21],["ἴσθι",10,239],["ὅλην",235,37],["τὴν",1,9],["ἡμέραν",28,10]],"Let not thine heart envy sinners: but be thou in the fear of the Lord all the day."],["18",[["Ἐὰν",45,8],["γὰρ",40,12],["τηρήσῃς",1358,170],["αὐτὰ",3,66],["ἔσται",10,89],["σοι",5,151],["ἔκγονα",1407,65],["ἡ",1,11],["δὲ",14,12],["ἐλπίς",530,13],["σου",5,146],["οὐκ",12,17],["ἀποστήσεται",293,89]],"For if thou shouldest keep these things, thou shalt have posterity; and thine hope shall not be removed."],["19",[["Ἄκουε",54,239],["υἱὲ",13,250],["καὶ",2,8],["σοφὸς",324,16],["γίνου",30,249],["καὶ",2,8],["κατεύθυνε",827,239],["ἐννοίας",2323,19],["σῆς",405,19],["καρδίας",64,19]],"Hear, [my] son, and be wise, and rightly direct the thoughts of thine heart."],["20",[["Μὴ",25,8],["ἴσθι",10,239],["οἰνοπότης",7802,5],["μηδὲ",414,12],["ἐκτείνου",421,249],["συμβολαῖς",2776,71],["κρεῶν",629,45],["τε",209,12],["ἀγορασμοῖς",3390,139]],"Be not a wine-bibber, neither continue long at feasts, and purchases of flesh:"],["21",[["Πᾶς",11,16],["γὰρ",40,12],["μέθυσος",3903,5],["καὶ",2,8],["πορνοκόπος",8024,16],["πτωχεύσει",3941,120],["καὶ",2,8],["ἐνδύσεται",516,89],["διεῤῥηγμένα",647,441],["καὶ",2,8],["ῥακώδη",9963,63],["πᾶς",11,16],["ὑπνώδης",9894,16]],"for every drunkard and whoremonger shall be poor; and every sluggard shall clothe himself with tatters and ragged garments."],["22",[["Ἄκουε",54,239],["υἱὲ",13,250],["πατρὸς",44,21],["τοῦ",1,30],["γεννήσαντός",222,513],["σε",5,161],["καὶ",2,8],["μὴ",25,8],["καταφρόνει",1677,239],["ὅτι",19,8],["γεγήρακέ",1411,165],["σου",5,146],["ἡ",1,11],["μήτηρ",189,13]],"Hearken, [my] son, to thy father which begot thee, and despise not [thy mother] because she is grown old."],["24",[["Καλῶς",1273,17],["ἐκτρέφει",1573,87],["πατὴρ",44,5],["δίκαιος",153,16],["ἐπὶ",9,1],["δὲ",14,12],["υἱῷ",13,113],["σοφῷ",324,111],["εὐφραίνεται",244,108],["ἡ",1,11],["ψυχὴ",63,13],["αὐτοῦ",3,48]],"A righteous father brings up [his children] well; and his soul rejoices over a wise son."],["25",[["Εὐφραινέσθω",244,340],["ὁ",1,4],["πατὴρ",44,5],["καὶ",2,8],["ἡ",1,11],["μήτηρ",189,13],["ἐπὶ",9,1],["σοὶ",5,151],["καὶ",2,8],["χαιρέτω",698,35],["ἡ",1,11],["τεκοῦσά",251,140],["σε",5,161]],"Let thy father and thy mother rejoice over thee, and let her that bore thee be glad."],["26",[["Δός",33,198],["μοι",6,49],["υἱὲ",13,250],["σὴν",405,10],["καρδίαν",64,10],["οἱ",1,128],["δὲ",14,12],["σοὶ",5,151],["ὀφθαλμοὶ",91,51],["ἐμὰς",525,40],["ὁδοὺς",68,40],["τηρείτωσαν",1358,55]],"[My] son, give me thine heart, and let thine eyes observe my ways."],["27",[["Πίθος",8196,5],["γὰρ",40,12],["τετρημένος",3975,408],["ἐστὶν",10,87],["ἀλλότριος",381,16],["οἶκος",34,5],["καὶ",2,8],["φρέαρ",877,33],["στενὸν",1975,29],["ἀλλότριον",381,29]],"For a strange house is a vessel full of holes; and a strange well is narrow."],["28",[["Οὗτος",16,112],["γὰρ",40,12],["συντόμως",5079,17],["ἀπολεῖται",217,89],["καὶ",2,8],["πᾶς",11,16],["παράνομος",830,16],["ἀναλωθήσεται",1849,125]],"For such a one shall perish suddenly; and every transgressor shall be cut off."],["29",[["Τίνι",39,436],["οὐαί",769,316],["τίνι",39,436],["θόρυβος",2722,5],["τίνι",39,436],["κρίσεις",229,180],["τίνι",39,436],["δὲ",14,12],["ἀηδίαι",8761,180],["καὶ",2,8],["λέσχαι",7609,180],["τίνι",39,436],["συντρίμματα",1229,63],["διακενῆς",2705,17],["τίνος",39,304],["πελιδνοὶ",7914,130],["οἱ",1,128],["ὀφθαλμοί",91,51]],"Who [has] woe? who trouble? who [has] quarrels? and who vexations and disputes? who [has] bruises without a cause? whose eyes are livid?"],["30",[["Οὐ",12,17],["τῶν",1,76],["ἐγχρονιζόντων",6418,164],["ἐν",4,1],["οἴνοις",261,139],["οὐ",12,17],["τῶν",1,76],["ἰχνευόντων",6592,164],["ποῦ",478,17],["πότοι",1356,51],["γίνονται",30,299],["μὴ",25,8],["μεθύσκεσθε",1276,382],["ἐν",4,1],["οἴνοις",261,139],["ἀλλὰ",108,17],["ὁμιλεῖτε",3023,84],["ἀνθρώποις",43,139],["δικαίοις",153,215],["καὶ",2,8],["ὁμιλεῖτε",3023,84],["ἐν",4,1],["περιπάτοις",3329,139]],"Are not those of them that stay long at wine? [are] not [those] of them that haunt [the places] where banquets are? Be not drunk with wine; but converse with just men, and converse [with them] openly."],["31",[["Ἐὰν",45,8],["γὰρ",40,12],["εἰς",8,1],["τὰς",1,39],["φιάλας",1287,40],["καὶ",2,8],["τὰ",1,42],["ποτήρια",1355,43],["δῷς",33,170],["τοὺς",1,56],["ὀφθαλμούς",91,31],["σου",5,146],["ὕστερον",2004,29],["περιπατήσεις",1327,159],["γυμνότερος",1299,16],["ὑπέρου",9942,24]],"For if thou shouldest set thine eyes on bowls and cups, thou shalt afterwards go more naked than a pestle."],["32",[["Τὸ",1,32],["δὲ",14,12],["ἔσχατον",410,29],["ὥσπερ",226,17],["ὑπὸ",122,1],["ὄφεως",1197,21],["πεπληγὼς",1475,264],["ἐκτείνεται",421,108],["καὶ",2,8],["ὥσπερ",226,17],["ὑπὸ",122,1],["κεράστου",7462,21],["διαχεῖται",1588,108],["αὐτῷ",3,49],["ὁ",1,4],["ἰός",3017,5]],"But at last [such a one] stretches himself out as one smitten by a serpent, and venom is diffused through him as by a horned serpent."],["33",[["Οἱ",1,128],["ὀφθαλμοί",91,51],["σου",5,146],["ὅταν",319,8],["ἴδωσιν",53,224],["ἀλλοτρίαν",381,37],["τὸ",1,32],["στόμα",123,33],["σου",5,146],["τότε",250,17],["λαλήσει",50,120],["σκολιά",1690,74]],"Whenever thine eyes shall behold a strange woman, then thy mouth shall speak perverse things."],["34",[["Καὶ",2,8],["κατακείσῃ",4267,116],["ὥσπερ",226,17],["ἐν",4,1],["καρδίᾳ",64,2],["θαλάσσης",137,19],["καὶ",2,8],["ὥσπερ",226,17],["κυβερνήτης",3870,5],["ἐν",4,1],["πολλῷ",74,111],["κλύδωνι",2904,113]],"And thou shalt lie as in the midst of the sea, and as a pilot in a great storm."],["35",[["Ἐρεῖς",165,159],["δὲ",14,12],["τύπτουσί",1209,191],["με",6,82],["καὶ",2,8],["οὐκ",12,17],["ἐπόνεσα",1911,147],["καὶ",2,8],["ἐνέπαιξάν",1703,141],["μοι",6,49],["ἐγὼ",6,158],["δὲ",14,12],["οὐκ",12,17],["ᾔδειν",53,320],["πότε",458,12],["ὄρθρος",1434,5],["ἔσται",10,89],["ἵνα",102,8],["ἐλθὼν",55,155],["ζητήσω",191,157],["μεθʼ",29,1],["ὧν",24,97],["συνελεύσομαι",1837,177]],"And thou shalt say, They smote me, and I was not pained; and they mocked me, and I knew it not: when will it be morning, that I may go and seek those with whom I may go in company?"]]