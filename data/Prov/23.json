[["1",[["Ἐὰν",45,8],["καθίσῃς",273,170],["δειπνεῖν",5566,54],["ἐπὶ",9,1],["τραπέζης",644,19],["δυνάστου",800,21],["νοητῶς",7817,17],["νόει",1384,239],["τὰ",1,42],["παρατιθέμενά",1277,203],["σοι",5,151]],"If thou sit to sup at the table of a prince, consider attentively the things set before thee:"],["2",[["Καὶ",2,8],["ἐπίβαλλε",724,239],["τὴν",1,9],["χεῖρά",37,10],["σου",5,146],["εἰδὼς",73,265],["ὅτι",19,8],["τοιαῦτά",629,382],["σε",5,161],["δεῖ",1161,14],["παρασκευάσαι",2380,100],["εἰ",77,8],["δὲ",14,12],["ἀπληστότερος",4581,16],["εἶ",10,145]],"and apply thine hand, knowing that it behoves thee to prepare such [meats]: but if thou art very insatiable,"],["3",[["μὴ",25,8],["ἐπιθύμει",916,239],["τῶν",1,44],["ἐδεσμάτων",2151,45],["αὐτοῦ",3,48],["ταῦτα",16,249],["γὰρ",40,12],["ἔχεται",124,108],["ζωῆς",212,19],["ψευδοῦς",547,78]],"desire not his provisions; for these belong to a false life."],["4",[["Μὴ",25,8],["παρεκτείνου",5938,250],["πένης",668,5],["ὢν",10,67],["πλουσίῳ",954,111],["τῇ",1,95],["δὲ",14,12],["σῇ",401,2],["ἐννοίᾳ",2335,2],["ἀπόσχου",1256,169]],"If thou art poor, measure not thyself with a rich man; but refrain thyself in thy wisdom."],["5",[["Ἐὰν",45,8],["ἐπιστήσῃς",623,170],["τὸ",1,32],["σὸν",401,33],["ὄμμα",3036,33],["πρὸς",15,1],["αὐτὸν",3,82],["οὐδαμοῦ",4349,17],["φανεῖται",849,89],["κατεσκεύασται",0,0],["γὰρ",40,12],["αὐτῷ",3,49],["πτέρυγες",720,179],["ὥσπερ",221,17],["ἀετοῦ",1568,21],["καὶ",2,8],["ὑποστρέφει",2252,87],["εἰς",8,1],["τὸν",1,6],["οἶκον",34,7],["τοῦ",1,30],["προεστηκότος",3344,309],["αὐτοῦ",3,48]],"If thou shouldest fix thine eye upon him, he will disappear; for wings like an eagle's are prepared for him, and he returns to the house of his master."],["6",[["Μὴ",25,8],["συνδείπνει",6134,239],["ἀνδρὶ",38,113],["βασκάνῳ",3808,111],["μηδὲ",412,12],["ἐπιθύμει",916,239],["τῶν",1,44],["βρωμάτων",714,45],["αὐτοῦ",3,48]],"Sup not with an envious man, neither desire thou his meats:"],["7",[["ὃν",24,106],["τρόπον",243,7],["γὰρ",40,12],["εἴ",77,8],["τις",39,150],["καταπίοι",1183,276],["τρίχα",1035,10],["οὕτως",70,17],["ἐσθίει",153,87],["καὶ",2,8],["πίνει",215,87],["μηδὲ",412,12],["πρὸς",15,1],["σὲ",5,161],["εἰσαγάγῃς",389,170],["αὐτὸν",3,82],["καὶ",2,8],["φάγῃς",153,170],["τὸν",1,6],["ψωμόν",2514,7],["σου",5,146],["μετʼ",29,1],["αὐτοῦ",3,48]],"so he eats and drinks as if any one should swallow a hair, and do not bring him in to thyself, nor eat thy morsel with him:"],["8",[["ἐξεμέσει",4613,120],["γὰρ",40,12],["αὐτὸν",3,82],["καὶ",2,8],["λυμανεῖται",2469,89],["τοὺς",1,56],["λόγους",48,31],["σου",5,146],["τοὺς",1,56],["καλούς",264,58]],"for he will vomit it up, and spoil thy fair words."],["9",[["Εἰς",8,1],["ὦτα",325,43],["ἄφρονος",438,218],["μηδὲν",910,29],["λέγε",31,239],["μήποτε",966,17],["μυκτηρίσῃ",2103,116],["τοὺς",1,56],["συνετοὺς",956,58],["λόγους",48,31],["σου",5,146]],"Say nothing in the ears of a fool, lest at any time he sneer at thy wise words."],["10",[["Μὴ",25,8],["μεταθῇς",2033,170],["ὅρια",234,43],["αἰώνια",388,65],["εἰς",8,1],["δὲ",14,12],["κτῆμα",2466,33],["ὀρφανῶν",959,115],["μὴ",25,8],["εἰσέλθῃς",88,170]],"Remove not the ancient landmarks; and enter not upon the possession of the fatherless:"],["11",[["Ὁ",1,4],["γὰρ",40,12],["λυτρούμενος",548,114],["αὐτοὺς",3,60],["Κύριος",7,5],["κραταιός",862,16],["ἐστι",10,87],["καὶ",2,8],["κρινεῖ",240,120],["τὴν",1,9],["κρίσιν",226,10],["αὐτῶν",3,41],["μετὰ",29,1],["σοῦ",5,146]],"for the Lord is their redeemer; he is mighty, and will plead their cause with thee."],["12",[["Δὸς",33,198],["εἰς",8,1],["παιδείαν",569,10],["τὴν",1,9],["καρδίαν",63,10],["σου",5,146],["τὰ",1,42],["δὲ",14,12],["ὦτά",325,43],["σου",5,146],["ἑτοίμασον",371,198],["λόγοις",48,139],["αἰσθήσεως",1617,19]],"Apply thine heart to instruction, and prepare thine ears for words of discretion."],["13",[["Μὴ",25,8],["ἀπόσχῃ",1256,160],["νήπιον",1015,28],["παιδεύειν",654,54],["ὅτι",19,8],["ἐὰν",45,8],["πατάξῃς",145,170],["αὐτὸν",3,82],["ῥάβδῳ",492,2],["οὐ",12,17],["μὴ",25,8],["ἀποθάνῃ",108,160]],"Refrain not from chastening a child; for if thou beat him with the rod, he shall not die."],["14",[["Συ",5,156],["μὲν",281,12],["γὰρ",40,12],["πατάξεις",145,159],["αὐτὸν",3,82],["ῥάβδῳ",492,2],["τὴν",1,9],["δὲ",14,12],["ψυχὴν",62,10],["αὐτοῦ",3,48],["ἐκ",21,1],["θανάτου",169,21],["ῥύσῃ",335,116]],"For thou shalt beat him with the rod, and shalt deliver his soul from death."],["15",[["Υἱὲ",13,251],["ἐὰν",45,8],["σοφὴ",322,15],["γένηταί",30,236],["σου",5,146],["ἡ",1,11],["καρδία",63,13],["εὐφρανεῖς",242,159],["καὶ",2,8],["τὴν",1,9],["ἐμὴν",523,10],["καρδίαν",63,10]],"Son, if thy heart be wise, thou shalt also gladden my heart;"],["16",[["καὶ",2,8],["ἐνδιατρίψει",9466,120],["λόγοις",48,139],["τὰ",1,42],["σὰ",401,43],["χείλη",361,43],["πρὸς",15,1],["τὰ",1,42],["ἐμὰ",523,43],["χείλη",361,43],["ἐὰν",45,8],["ὀρθὰ",1536,65],["ὦσι",10,266]],"and thy lips shall converse with my lips, if they be right."],["17",[["Μὴ",25,8],["ζηλούτω",1116,35],["ἡ",1,11],["καρδία",63,13],["σου",5,146],["ἁμαρτωλοὺς",406,58],["ἀλλὰ",107,17],["ἐν",4,1],["φόβῳ",330,113],["Κυρίου",7,21],["ἴσθι",10,239],["ὅλην",233,37],["τὴν",1,9],["ἡμέραν",28,10]],"Let not thine heart envy sinners: but be thou in the fear of the Lord all the day."],["18",[["Ἐὰν",45,8],["γὰρ",40,12],["τηρήσῃς",1356,170],["αὐτὰ",3,66],["ἔσται",10,89],["σοι",5,151],["ἔκγονα",1408,65],["ἡ",1,11],["δὲ",14,12],["ἐλπίς",527,13],["σου",5,146],["οὐκ",12,17],["ἀποστήσεται",646,89]],"For if thou shouldest keep these things, thou shalt have posterity; and thine hope shall not be removed."],["19",[["Ἄκουε",53,239],["υἱὲ",13,251],["καὶ",2,8],["σοφὸς",322,16],["γίνου",30,250],["καὶ",2,8],["κατεύθυνε",828,239],["ἐννοίας",2335,19],["σῆς",401,19],["καρδίας",63,19]],"Hear, [my] son, and be wise, and rightly direct the thoughts of thine heart."],["20",[["Μὴ",25,8],["ἴσθι",10,239],["οἰνοπότης",7860,5],["μηδὲ",412,12],["ἐκτείνου",419,250],["συμβολαῖς",2785,71],["κρεῶν",628,45],["τε",207,12],["ἀγορασμοῖς",3396,139]],"Be not a wine-bibber, neither continue long at feasts, and purchases of flesh:"],["21",[["Πᾶς",11,16],["γὰρ",40,12],["μέθυσος",3914,5],["καὶ",2,8],["πορνοκόπος",8084,16],["πτωχεύσει",3953,120],["καὶ",2,8],["ἐνδύσεται",515,89],["διεῤῥηγμένα",673,453],["καὶ",2,8],["ῥακώδη",10042,63],["πᾶς",11,16],["ὑπνώδης",9973,16]],"for every drunkard and whoremonger shall be poor; and every sluggard shall clothe himself with tatters and ragged garments."],["22",[["Ἄκουε",53,239],["υἱὲ",13,251],["πατρὸς",44,21],["τοῦ",1,30],["γεννήσαντός",222,521],["σε",5,161],["καὶ",2,8],["μὴ",25,8],["καταφρόνει",1680,239],["ὅτι",19,8],["γεγήρακέ",1412,165],["σου",5,146],["ἡ",1,11],["μήτηρ",188,13]],"Hearken, [my] son, to thy father which begot thee, and despise not [thy mother] because she is grown old."],["24",[["Καλῶς",1271,17],["ἐκτρέφει",1574,87],["πατὴρ",44,5],["δίκαιος",152,16],["ἐπὶ",9,1],["δὲ",14,12],["υἱῷ",13,113],["σοφῷ",322,111],["εὐφραίνεται",242,108],["ἡ",1,11],["ψυχὴ",62,13],["αὐτοῦ",3,48]],"A righteous father brings up [his children] well; and his soul rejoices over a wise son."],["25",[["Εὐφραινέσθω",242,344],["ὁ",1,4],["πατὴρ",44,5],["καὶ",2,8],["ἡ",1,11],["μήτηρ",188,13],["ἐπὶ",9,1],["σοὶ",5,151],["καὶ",2,8],["χαιρέτω",698,35],["ἡ",1,11],["τεκοῦσά",251,140],["σε",5,161]],"Let thy father and thy mother rejoice over thee, and let her that bore thee be glad."],["26",[["Δός",33,198],["μοι",6,49],["υἱὲ",13,251],["σὴν",401,10],["καρδίαν",63,10],["οἱ",1,128],["δὲ",14,12],["σοὶ",5,151],["ὀφθαλμοὶ",91,51],["ἐμὰς",523,40],["ὁδοὺς",67,40],["τηρείτωσαν",1356,55]],"[My] son, give me thine heart, and let thine eyes observe my ways."],["27",[["Πίθος",8252,5],["γὰρ",40,12],["τετρημένος",3984,228],["ἐστὶν",10,87],["ἀλλότριος",377,16],["οἶκος",34,5],["καὶ",2,8],["φρέαρ",878,33],["στενὸν",1980,29],["ἀλλότριον",377,29]],"For a strange house is a vessel full of holes; and a strange well is narrow."],["28",[["Οὗτος",16,112],["γὰρ",40,12],["συντόμως",5105,17],["ἀπολεῖται",213,89],["καὶ",2,8],["πᾶς",11,16],["παράνομος",832,16],["ἀναλωθήσεται",1848,125]],"For such a one shall perish suddenly; and every transgressor shall be cut off."],["29",[["Τίνι",39,442],["οὐαί",766,320],["τίνι",39,442],["θόρυβος",2728,5],["τίνι",39,442],["κρίσεις",226,179],["τίνι",39,442],["δὲ",14,12],["ἀηδίαι",8820,179],["καὶ",2,8],["λέσχαι",7661,179],["τίνι",39,442],["συντρίμματα",1231,63],["διακενῆς",2711,17],["τίνος",39,308],["πελιδνοὶ",7975,130],["οἱ",1,128],["ὀφθαλμοί",91,51]],"Who [has] woe? who trouble? who [has] quarrels? and who vexations and disputes? who [has] bruises without a cause? whose eyes are livid?"],["30",[["Οὐ",12,17],["τῶν",1,76],["ἐγχρονιζόντων",6449,164],["ἐν",4,1],["οἴνοις",261,139],["οὐ",12,17],["τῶν",1,76],["ἰχνευόντων",6632,164],["ποῦ",477,17],["πότοι",1353,51],["γίνονται",30,303],["μὴ",25,8],["μεθύσκεσθε",1274,386],["ἐν",4,1],["οἴνοις",261,139],["ἀλλὰ",107,17],["ὁμιλεῖτε",3035,84],["ἀνθρώποις",43,139],["δικαίοις",152,215],["καὶ",2,8],["ὁμιλεῖτε",3035,84],["ἐν",4,1],["περιπάτοις",3334,139]],"Are not those of them that stay long at wine? [are] not [those] of them that haunt [the places] where banquets are? Be not drunk with wine; but converse with just men, and converse [with them] openly."],["31",[["Ἐὰν",45,8],["γὰρ",40,12],["εἰς",8,1],["τὰς",1,39],["φιάλας",1286,40],["καὶ",2,8],["τὰ",1,42],["ποτήρια",1352,43],["δῷς",33,170],["τοὺς",1,56],["ὀφθαλμούς",91,31],["σου",5,146],["ὕστερον",2012,29],["περιπατήσεις",1327,159],["γυμνότερος",1299,16],["ὑπέρου",10021,24]],"For if thou shouldest set thine eyes on bowls and cups, thou shalt afterwards go more naked than a pestle."],["32",[["Τὸ",1,32],["δὲ",14,12],["ἔσχατον",407,29],["ὥσπερ",221,17],["ὑπὸ",122,1],["ὄφεως",1199,21],["πεπληγὼς",1478,265],["ἐκτείνεται",419,108],["καὶ",2,8],["ὥσπερ",221,17],["ὑπὸ",122,1],["κεράστου",7511,21],["διαχεῖται",1588,108],["αὐτῷ",3,49],["ὁ",1,4],["ἰός",3029,5]],"But at last [such a one] stretches himself out as one smitten by a serpent, and venom is diffused through him as by a horned serpent."],["33",[["Οἱ",1,128],["ὀφθαλμοί",91,51],["σου",5,146],["ὅταν",318,8],["ἴδωσιν",73,224],["ἀλλοτρίαν",377,37],["τὸ",1,32],["στόμα",123,33],["σου",5,146],["τότε",250,17],["λαλήσει",50,120],["σκολιά",1693,74]],"Whenever thine eyes shall behold a strange woman, then thy mouth shall speak perverse things."],["34",[["Καὶ",2,8],["κατακείσῃ",4280,116],["ὥσπερ",221,17],["ἐν",4,1],["καρδίᾳ",63,2],["θαλάσσης",137,19],["καὶ",2,8],["ὥσπερ",221,17],["κυβερνήτης",3880,5],["ἐν",4,1],["πολλῷ",74,111],["κλύδωνι",2918,113]],"And thou shalt lie as in the midst of the sea, and as a pilot in a great storm."],["35",[["Ἐρεῖς",191,145],["δὲ",14,12],["τύπτουσί",1191,189],["με",6,82],["καὶ",2,8],["οὐκ",12,17],["ἐπόνεσα",1910,147],["καὶ",2,8],["ἐνέπαιξάν",1862,141],["μοι",6,49],["ἐγὼ",6,158],["δὲ",14,12],["οὐκ",12,17],["ᾔδειν",73,324],["πότε",455,12],["ὄρθρος",1436,5],["ἔσται",10,89],["ἵνα",101,8],["ἐλθὼν",56,155],["ζητήσω",190,157],["μεθʼ",29,1],["ὧν",24,97],["συνελεύσομαι",1917,176]],"And thou shalt say, They smote me, and I was not pained; and they mocked me, and I knew it not: when will it be morning, that I may go and seek those with whom I may go in company?"]]