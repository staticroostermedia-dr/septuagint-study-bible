[["1",[["Υἱὲ",13,250],["φύλασσε",125,239],["ἐμοὺς",525,31],["λόγους",48,31],["τὰς",1,39],["δὲ",14,12],["ἐμὰς",525,40],["ἐντολὰς",259,40],["κρύψον",372,171],["παρὰ",73,1],["σεαυτῷ",255,49]],"[My] son, keep my words, and hide with thee my commandments."],["1a",[["Υἱὲ",13,250],["τίμα",1020,239],["τὸν",1,6],["Κύριον",7,7],["καὶ",2,8],["ἰσχύσεις",567,159],["πλὴν",257,1],["δὲ",14,12],["αὐτοῦ",3,48],["μὴ",25,8],["φοβοῦ",134,249],["ἄλλον",584,82]],"[My] son, honour the Lord, and thou shalt be strong; and fear none but him:"],["2",[["φύλαξον",125,198],["ἐμὰς",525,40],["ἐντολὰς",259,40],["καὶ",2,8],["βιώσεις",3504,159],["τοὺς",1,56],["δὲ",14,12],["ἐμοὺς",525,31],["λόγους",48,31],["ὥσπερ",226,17],["κόρας",2910,40],["ὀμμάτων",3024,45]],"keep my commandments, and thou shalt live; and [keep] my words as the pupils of [thine] eyes."],["3",[["Περίθου",1017,275],["δὲ",14,12],["αὐτοὺς",3,60],["σοῖς",405,139],["δακτύλοις",1182,139],["ἐπίγραψον",4600,198],["δὲ",14,12],["ἐπὶ",9,1],["τὸ",1,32],["πλάτος",966,33],["τῆς",1,18],["καρδίας",64,19],["σου",5,146]],"And bind them on thy fingers, and write [them] on the table of thine heart."],["4",[["Εἰπὸν",18,267],["τὴν",1,9],["σοφίαν",242,10],["σὴν",405,10],["ἀδελφὴν",521,10],["εἶναι",10,54],["τὴν",1,9],["δὲ",14,12],["φρόνησιν",833,10],["γνώριμον",3255,37],["περιποίησαι",1352,275],["σεαυτῷ",255,49]],"Say that wisdom is thy sister, and gain prudence as an acquaintance for thyself;"],["5",[["Ἵνα",102,8],["σε",5,161],["τηρήσῃ",1358,160],["ἀπὸ",17,1],["γυναικὸς",59,19],["ἀλλοτρίας",381,78],["καὶ",2,8],["πονηρᾶς",164,78],["ἐάν",45,8],["σε",5,161],["λόγοις",48,139],["τοῖς",1,138],["πρὸς",15,1],["χάριν",368,10],["ἐμβάληται",747,411]],"that she may keep thee from the strange and wicked woman, if she should assail thee with flattering words."],["6",[["Ἀπὸ",17,1],["γὰρ",40,12],["θυρίδος",1304,19],["ἐκ",21,1],["τοῦ",1,30],["οἴκου",34,21],["αὐτῆς",3,83],["εἰς",8,1],["τὰς",1,39],["πλατείας",925,40],["παρακύπτουσα",3103,183]],"For she looks from a window out of her house into the streets, at one whom she may see of the senseless ones,",{"s":"r"}],["7",[["ὃν",24,106],["ἂν",83,12],["ἴδῃ",53,160],["τῶν",1,44],["ἀφρόνων",439,409],["τέκνων",192,45],["νεανίαν",2030,7],["ἐνδεῆ",1656,59],["φρενῶν",2508,61]],"a young man void of understanding, passing by the corner in the passages near her house,",{"s":"r"}],["8",[["παραπορευόμενον",1250,201],["παρὰ",73,1],["γωνίαν",1377,10],["ἐν",4,1],["διόδοις",2710,71],["οἴκων",34,77],["αὐτῆς",3,83],["καὶ",2,8],["λαλοῦντα",50,289]],"and speaking, in the dark of the evening,"],["9",[["ἐν",4,1],["σκότει",506,53],["ἑσπερινῷ",3454,34],["ἡνίκα",543,17],["ἂν",83,12],["ἡσυχία",2546,13],["νυκτερινὴ",3599,15],["καὶ",2,8],["γνοφώδης",5518,372]],"when there happens [to be] the stillness of night and of darkness:"],["10",[["ἡ",1,11],["δὲ",14,12],["γυνὴ",59,13],["συναντᾷ",429,173],["αὐτῷ",3,49],["εἶδος",949,20],["ἔχουσα",124,183],["πορνικὸν",5972,28],["ἣ",1,11],["ποιεῖ",23,87],["νέων",515,115],["ἐξίπτασθαι",5293,104],["καρδίας",64,19]],"and the woman meets him having the appearance of a harlot, that causes the hearts of young men to flutter."],["11",[["Ἀνεπτερωμένη",5186,197],["δέ",14,12],["ἐστι",10,87],["καὶ",2,8],["ἄσωτος",9208,16],["ἐν",4,1],["οἴκῳ",34,113],["δὲ",14,12],["οὐχ",12,17],["ἡσυχάζουσιν",1090,191],["οἱ",1,128],["πόδες",210,51],["αὐτῆς",3,83]],"And she is fickle, and debauched, and her feet abide not at home."],["12",[["Χρόνον",486,7],["γάρ",40,12],["τινα",39,365],["ἔξω",527,17],["ῥέμβεται",9957,108],["χρόνον",486,7],["δὲ",14,12],["ἐν",4,1],["πλατείαις",925,71],["παρὰ",73,1],["πᾶσαν",11,37],["γωνίαν",1377,10],["ἐνεδρεύει",1490,87]],"For at one time she wanders without, and at [another] time she lies in wait in the streets, at every corner."],["13",[["Εἶτα",2450,17],["ἐπιλαβομένη",1086,366],["ἐφίλησεν",1391,3],["αὐτὸν",3,82],["ἀναιδεῖ",2305,34],["δὲ",14,12],["προσώπῳ",47,53],["προσεῖπεν",5991,3],["αὐτῷ",3,233]],"Then she caught him, and kissed him, and with an impudent face said to him,"],["14",[["θυσία",156,13],["εἰρηνική",935,15],["μοι",6,49],["ἐστὶ",10,87],["σήμερον",205,17],["ἀποδίδωμι",312,149],["τὰς",1,39],["εὐχάς",633,40],["μου",6,48]],"I have a peace-offering; to-day I pay my vows:"],["15",[["Ἕνεκα",447,1],["τούτου",16,126],["ἐξῆλθον",82,141],["εἰς",8,1],["συνάντησίν",429,87],["σοι",5,151],["ποθοῦσα",3333,183],["τὸ",1,32],["σὸν",405,33],["πρόσωπον",47,33],["εὕρηκά",101,85],["σε",5,161]],"therefore I came forth to meet thee, desiring thy face; [and] I have found thee."],["16",[["κειρίαις",7457,71],["τέτακα",2789,85],["τὴν",1,9],["κλίνην",1221,10],["μου",6,48],["ἀμφιτάποις",0,0],["δὲ",14,12],["ἔστρωκα",2958,85],["τοῖς",1,138],["ἀπʼ",17,1],["Αἰγύπτου",93,19]],"I have spread my bed with sheets, and I have covered it with double tapestry from Egypt."],["17",[["Διέῤῥαγκα",0,0],["τὴν",1,9],["κοίτην",704,10],["μου",6,48],["κροκίνῳ",7512,111],["τὸν",1,6],["δὲ",14,12],["οἶκόν",34,7],["μου",6,48],["κινναμώμῳ",4853,53]],"I have sprinkled my couch with saffron, and my house with cinnamon."],["18",[["Ἐλθὲ",55,198],["καὶ",2,8],["ἀπολαύσωμεν",4037,75],["φιλίας",1253,40],["ἕως",42,8],["ὄρθρου",1434,21],["δεῦρο",715,17],["καὶ",2,8],["ἐλκυλισθῶμεν",0,0],["ἔρωτι",6563,364]],"Come, and let us enjoy love until the morning; come, and let us embrace in love."],["19",[["Οὐ",12,17],["γὰρ",40,12],["πάρεστιν",899,87],["ὁ",1,4],["ἀνήρ",38,5],["μου",6,48],["ἐν",4,1],["οἴκω",34,451],["πεπόρευται",49,182],["δὲ",14,12],["ὁδὸν",68,10],["μακράν",642,37]],"For my husband is not at home, but is gone on a long journey,"],["20",[["ἔνδεσμον",5363,7],["ἀργυρίου",152,24],["λαβὼν",46,155],["ἐν",4,1],["χειρὶ",37,2],["αὐτοῦ",3,48],["διʼ",56,1],["ἡμερῶν",28,61],["πολλῶν",74,115],["ἐπανήξει",4091,160],["εἰς",8,1],["τὸν",1,6],["οἶκον",34,7],["αὐτοῦ",3,48]],"having taken in his hand a bundle of money: after many days he will return to his house."],["21",[["Ἀπεπλάνησε",2986,3],["δὲ",14,12],["αὐτὸν",3,82],["πολλῇ",74,96],["ὁμιλίᾳ",4645,2],["βρόχοις",4175,139],["τε",209,12],["τοῖς",1,138],["ἀπὸ",17,1],["χειλέων",361,45],["ἐξώκειλεν",9451,3],["αὐτόν",3,82]],"So with much converse she prevailed on him to go astray, and with the snares of her lips she forced him from [the right path]."],["22",[["Ὁ",1,4],["δὲ",14,12],["ἐπηκολούθησεν",2141,3],["αὐτῇ",3,99],["κεπφωθείς",7460,206],["ὥσπερ",226,17],["δὲ",14,12],["βοῦς",411,5],["ἐπὶ",9,1],["σφαγὴν",1742,10],["ἄγεται",224,108],["καὶ",2,8],["ὥσπερ",226,17],["κύων",1204,5],["ἐπὶ",9,1],["δεσμοὺς",1035,31]],"And he followed her, being gently led on, and [that] as an ox is led to the slaughter, and as a dog to bonds, or as a hart shot in the liver with an arrow:"],["23",[["ἢ",61,8],["ὡς",36,8],["ἔλαφος",1868,5],["τοξεύματι",2392,53],["πεπληγὼς",1475,264],["εἰς",8,1],["τὸ",1,32],["ἧπαρ",1871,33],["σπεύδει",846,87],["δὲ",14,12],["ὥσπερ",226,17],["ὄρνεον",1238,20],["εἰς",8,1],["παγίδα",817,10],["οὐκ",12,17],["εἰδὼς",53,264],["ὅτι",19,8],["περὶ",72,1],["ψυχῆς",63,19],["τρέχει",820,87]],"and he hastens as a bird into a snare, not knowing that he is running for [his] life."],["24",[["Νῦν",90,17],["οὖν",227,12],["υἱὲ",13,250],["ἄκουέ",54,239],["μου",6,48],["καὶ",2,8],["πρόσεχε",558,239],["ῥήμασι",116,92],["στόματός",123,24],["μου",6,48]],"Now then, [my] son, hearken to me, and attend to the words of my mouth."],["25",[["Μὴ",25,8],["ἐκκλινάτω",394,46],["εἰς",8,1],["τὰς",1,39],["ὁδοὺς",68,40],["αὐτῆς",3,83],["ἡ",1,11],["καρδία",64,13],["σου",5,146]],"Let not thine heart turn aside to her ways:"],["26",[["πολλοὺς",74,58],["γὰρ",40,12],["τρώσασα",1917,140],["καταβέβληκε",1074,165],["καὶ",2,8],["ἀναρίθμητοί",2515,130],["εἰσιν",10,191],["οὓς",24,294],["πεφόνευκεν",970,165]],"for she has wounded and cast down many, and those whom she has slain are innumerable."],["27",[["Ὁδοὶ",68,180],["ᾅδου",586,21],["ὁ",1,4],["οἶκος",34,5],["αὐτῆς",3,83],["κατάγουσαι",735,301],["εἰς",8,1],["τὰ",1,42],["ταμιεῖα",2501,43],["τοῦ",1,30],["θανάτου",170,21]],"Her house is the way of hell, leading down to the chambers of death."]]