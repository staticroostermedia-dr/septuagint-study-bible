[["1",[["Υἱὲ",13,251],["φύλασσε",127,239],["ἐμοὺς",523,31],["λόγους",48,31],["τὰς",1,39],["δὲ",14,12],["ἐμὰς",523,40],["ἐντολὰς",259,40],["κρύψον",378,171],["παρὰ",72,1],["σεαυτῷ",293,49]],"[My] son, keep my words, and hide with thee my commandments."],["1a",[["Υἱὲ",13,251],["τίμα",1043,239],["τὸν",1,6],["Κύριον",7,7],["καὶ",2,8],["ἰσχύσεις",565,159],["πλὴν",257,1],["δὲ",14,12],["αὐτοῦ",3,48],["μὴ",25,8],["φοβοῦ",134,250],["ἄλλον",581,82]],"[My] son, honour the Lord, and thou shalt be strong; and fear none but him:"],["2",[["φύλαξον",127,198],["ἐμὰς",523,40],["ἐντολὰς",259,40],["καὶ",2,8],["βιώσεις",3507,159],["τοὺς",1,56],["δὲ",14,12],["ἐμοὺς",523,31],["λόγους",48,31],["ὥσπερ",221,17],["κόρας",2925,40],["ὀμμάτων",3036,45]],"keep my commandments, and thou shalt live; and [keep] my words as the pupils of [thine] eyes."],["3",[["Περίθου",1016,275],["δὲ",14,12],["αὐτοὺς",3,60],["σοῖς",401,139],["δακτύλοις",1182,139],["ἐπίγραψον",4624,198],["δὲ",14,12],["ἐπὶ",9,1],["τὸ",1,32],["πλάτος",967,33],["τῆς",1,18],["καρδίας",63,19],["σου",5,146]],"And bind them on thy fingers, and write [them] on the table of thine heart."],["4",[["Εἰπὸν",18,221],["τὴν",1,9],["σοφίαν",238,10],["σὴν",401,10],["ἀδελφὴν",519,10],["εἶναι",10,54],["τὴν",1,9],["δὲ",14,12],["φρόνησιν",834,10],["γνώριμον",3260,37],["περιποίησαι",1348,296],["σεαυτῷ",293,49]],"Say that wisdom is thy sister, and gain prudence as an acquaintance for thyself;"],["5",[["Ἵνα",101,8],["σε",5,161],["τηρήσῃ",1356,160],["ἀπὸ",17,1],["γυναικὸς",58,19],["ἀλλοτρίας",377,78],["καὶ",2,8],["πονηρᾶς",164,78],["ἐάν",45,8],["σε",5,161],["λόγοις",48,139],["τοῖς",1,138],["πρὸς",15,1],["χάριν",366,10],["ἐμβάληται",751,236]],"that she may keep thee from the strange and wicked woman, if she should assail thee with flattering words."],["6",[["Ἀπὸ",17,1],["γὰρ",40,12],["θυρίδος",1304,19],["ἐκ",21,1],["τοῦ",1,30],["οἴκου",34,21],["αὐτῆς",3,83],["εἰς",8,1],["τὰς",1,39],["πλατείας",925,40],["παρακύπτουσα",3112,181]],"For she looks from a window out of her house into the streets, at one whom she may see of the senseless ones, a young man void of understanding,"],["7",[["ὃν",24,106],["ἂν",82,12],["ἴδῃ",73,160],["τῶν",1,44],["ἀφρόνων",438,416],["τέκνων",192,45],["νεανίαν",2035,7],["ἐνδεῆ",1656,59],["φρενῶν",2512,61]],"passing by the corner in the passages near her house,"],["8",[["παραπορευόμενον",1251,201],["παρὰ",72,1],["γωνίαν",1376,10],["ἐν",4,1],["διόδοις",2716,71],["οἴκων",34,77],["αὐτῆς",3,83],["καὶ",2,8],["λαλοῦντα",50,292]],"and speaking, in the dark of the evening,"],["9",[["ἐν",4,1],["σκότει",503,53],["ἑσπερινῷ",3457,34],["ἡνίκα",541,17],["ἂν",82,12],["ἡσυχία",2550,13],["νυκτερινὴ",3606,15],["καὶ",2,8],["γνοφώδης",5549,378]],"when there happens [to be] the stillness of night and of darkness:"],["10",[["ἡ",1,11],["δὲ",14,12],["γυνὴ",58,13],["συναντᾷ",426,172],["αὐτῷ",3,49],["εἶδος",825,20],["ἔχουσα",124,181],["πορνικὸν",6001,28],["ἣ",1,11],["ποιεῖ",23,87],["νέων",513,115],["ἐξίπτασθαι",5325,104],["καρδίας",63,19]],"and the woman meets him having the appearance of a harlot, that causes the hearts of young men to flutter."],["11",[["Ἀνεπτερωμένη",0,0],["δέ",14,12],["ἐστι",10,87],["καὶ",2,8],["ἄσωτος",9284,16],["ἐν",4,1],["οἴκῳ",34,113],["δὲ",14,12],["οὐχ",12,17],["ἡσυχάζουσιν",1091,189],["οἱ",1,128],["πόδες",208,51],["αὐτῆς",3,83]],"And she is fickle, and debauched, and her feet abide not at home."],["12",[["Χρόνον",484,7],["γάρ",40,12],["τινα",39,368],["ἔξω",525,17],["ῥέμβεται",10037,108],["χρόνον",484,7],["δὲ",14,12],["ἐν",4,1],["πλατείαις",925,71],["παρὰ",72,1],["πᾶσαν",11,37],["γωνίαν",1376,10],["ἐνεδρεύει",1492,87]],"For at one time she wanders without, and at [another] time she lies in wait in the streets, at every corner."],["13",[["Εἶτα",2457,17],["ἐπιλαβομένη",1087,369],["ἐφίλησεν",1393,3],["αὐτὸν",3,82],["ἀναιδεῖ",2319,34],["δὲ",14,12],["προσώπῳ",47,53],["προσεῖπεν",6019,3],["αὐτῷ",3,233]],"Then she caught him, and kissed him, and with an impudent face said to him,"],["14",[["θυσία",156,13],["εἰρηνική",934,15],["μοι",6,49],["ἐστὶ",10,87],["σήμερον",205,17],["ἀποδίδωμι",311,149],["τὰς",1,39],["εὐχάς",631,40],["μου",6,48]],"I have a peace-offering; to-day I pay my vows:"],["15",[["Ἕνεκα",445,1],["τούτου",16,126],["ἐξῆλθον",84,141],["εἰς",8,1],["συνάντησίν",426,87],["σοι",5,151],["ποθοῦσα",3338,181],["τὸ",1,32],["σὸν",401,33],["πρόσωπον",47,33],["εὕρηκά",106,85],["σε",5,161]],"therefore I came forth to meet thee, desiring thy face; [and] I have found thee."],["16",[["κειρίαις",7505,71],["τέτακα",2799,85],["τὴν",1,9],["κλίνην",1184,10],["μου",6,48],["ἀμφιτάποις",0,0],["δὲ",14,12],["ἔστρωκα",2970,85],["τοῖς",1,138],["ἀπʼ",17,1],["Αἰγύπτου",93,19]],"I have spread my bed with sheets, and I have covered it with double tapestry from Egypt."],["17",[["Διέῤῥαγκα",0,0],["τὴν",1,9],["κοίτην",705,10],["μου",6,48],["κροκίνῳ",7562,111],["τὸν",1,6],["δὲ",14,12],["οἶκόν",34,7],["μου",6,48],["κινναμώμῳ",4879,53]],"I have sprinkled my couch with saffron, and my house with cinnamon."],["18",[["Ἐλθὲ",56,198],["καὶ",2,8],["ἀπολαύσωμεν",4047,75],["φιλίας",1254,40],["ἕως",42,8],["ὄρθρου",1436,21],["δεῦρο",715,17],["καὶ",2,8],["ἐλκυλισθῶμεν",0,0],["ἔρωτι",6602,367]],"Come, and let us enjoy love until the morning; come, and let us embrace in love."],["19",[["Οὐ",12,17],["γὰρ",40,12],["πάρεστιν",900,87],["ὁ",1,4],["ἀνήρ",38,5],["μου",6,48],["ἐν",4,1],["οἴκω",34,463],["πεπόρευται",0,0],["δὲ",14,12],["ὁδὸν",67,10],["μακράν",638,37]],"For my husband is not at home, but is gone on a long journey,"],["20",[["ἔνδεσμον",5392,7],["ἀργυρίου",150,24],["λαβὼν",46,155],["ἐν",4,1],["χειρὶ",37,2],["αὐτοῦ",3,48],["διʼ",54,1],["ἡμερῶν",28,61],["πολλῶν",74,115],["ἐπανήξει",4101,160],["εἰς",8,1],["τὸν",1,6],["οἶκον",34,7],["αὐτοῦ",3,48]],"having taken in his hand a bundle of money: after many days he will return to his house."],["21",[["Ἀπεπλάνησε",2999,3],["δὲ",14,12],["αὐτὸν",3,82],["πολλῇ",74,96],["ὁμιλίᾳ",4670,2],["βρόχοις",4187,139],["τε",207,12],["τοῖς",1,138],["ἀπὸ",17,1],["χειλέων",361,45],["ἐξώκειλεν",9520,3],["αὐτόν",3,82]],"So with much converse she prevailed on him to go astray, and with the snares of her lips she forced him from [the right path]."],["22",[["Ὁ",1,4],["δὲ",14,12],["ἐπηκολούθησεν",2147,3],["αὐτῇ",3,99],["κεπφωθείς",7509,206],["ὥσπερ",221,17],["δὲ",14,12],["βοῦς",408,5],["ἐπὶ",9,1],["σφαγὴν",1741,10],["ἄγεται",227,108],["καὶ",2,8],["ὥσπερ",221,17],["κύων",1208,5],["ἐπὶ",9,1],["δεσμοὺς",1032,31]],"And he followed her, being gently led on, and [that] as an ox is led to the slaughter, and as a dog to bonds, or as a hart shot in the liver with an arrow:"],["23",[["ἢ",60,8],["ὡς",36,8],["ἔλαφος",1869,5],["τοξεύματι",2401,53],["πεπληγὼς",1478,265],["εἰς",8,1],["τὸ",1,32],["ἧπαρ",1872,33],["σπεύδει",847,87],["δὲ",14,12],["ὥσπερ",221,17],["ὄρνεον",1240,20],["εἰς",8,1],["παγίδα",815,10],["οὐκ",12,17],["εἰδὼς",73,265],["ὅτι",19,8],["περὶ",71,1],["ψυχῆς",62,19],["τρέχει",818,87]],"and he hastens as a bird into a snare, not knowing that he is running for [his] life."],["24",[["Νῦν",89,17],["οὖν",223,12],["υἱὲ",13,251],["ἄκουέ",53,239],["μου",6,48],["καὶ",2,8],["πρόσεχε",557,239],["ῥήμασι",115,92],["στόματός",123,24],["μου",6,48]],"Now then, [my] son, hearken to me, and attend to the words of my mouth."],["25",[["Μὴ",25,8],["ἐκκλινάτω",393,46],["εἰς",8,1],["τὰς",1,39],["ὁδοὺς",67,40],["αὐτῆς",3,83],["ἡ",1,11],["καρδία",63,13],["σου",5,146]],"Let not thine heart turn aside to her ways:"],["26",[["πολλοὺς",74,58],["γὰρ",40,12],["τρώσασα",1919,140],["καταβέβληκε",1075,165],["καὶ",2,8],["ἀναρίθμητοί",2516,130],["εἰσιν",10,189],["οὓς",24,298],["πεφόνευκεν",0,0]],"for she has wounded and cast down many, and those whom she has slain are innumerable."],["27",[["Ὁδοὶ",67,179],["ᾅδου",583,21],["ὁ",1,4],["οἶκος",34,5],["αὐτῆς",3,83],["κατάγουσαι",741,305],["εἰς",8,1],["τὰ",1,42],["ταμιεῖα",2505,43],["τοῦ",1,30],["θανάτου",169,21]],"Her house is the way of hell, leading down to the chambers of death."]]