[["1",[["Ὥσπερ",226,17],["δρόσος",1135,13],["ἐν",4,1],["ἀμητῷ",1700,113],["καὶ",2,8],["ὥσπερ",226,17],["ὑετὸς",676,5],["ἐν",4,1],["θέρει",3064,134],["οὕτως",71,17],["οὐκ",12,17],["ἔστιν",10,87],["ἄφρουι",0,0],["τιμή",720,13]],"As dew in harvest, and as rain in summer, so honour is not [seemly] for a fool."],["2",[["Ὥσπερ",226,17],["ὄρνεα",1238,63],["πέταται",1559,108],["καὶ",2,8],["στρουθοί",3135,51],["οὕτως",71,17],["ἀρὰ",1213,13],["ματαία",654,15],["οὐκ",12,17],["ἐπελεύσεται",542,89],["οὐδενί",228,310]],"As birds and sparrows fly, so a curse shall not come upon any one without a cause."],["3",[["Ὥσπερ",226,17],["μάστιξ",1308,13],["ἵππῳ",309,113],["καὶ",2,8],["κέντρον",3875,20],["ὄνῳ",499,113],["οὕτως",71,17],["ῥάβδος",493,13],["ἔθνει",60,53],["παρανόμῳ",830,34]],"As a whip for a horse, and a goad for an ass, so [is] a rod for a simple nation."],["4",[["Μὴ",25,8],["ἀποκρίνου",234,249],["ἄφρονι",439,310],["πρὸς",15,1],["τὴν",1,9],["ἐκείνου",80,48],["ἀφροσύνην",1401,10],["ἵνα",102,8],["μὴ",25,8],["ὅμοιος",657,16],["γένῃ",30,277],["αὐτῷ",3,49]],"Answer not a fool according to his folly, lest thou become like him."],["5",[["Ἀλλὰ",108,17],["ἀποκρίνου",234,249],["ἄφρονι",439,310],["κατὰ",32,1],["τὴν",1,9],["ἀφροσύνην",1401,10],["αὐτοῦ",3,48],["ἵνα",102,8],["μὴ",25,8],["φαίνηται",832,297],["σοφὸς",324,16],["παρʼ",73,1],["ἑαυτῷ",92,49]],"Yet answer a fool according to his folly, lest he seem wise in his own conceit."],["6",[["Ἐκ",21,1],["τῶν",1,123],["ὁδῶν",68,61],["ἑαυτοῦ",92,48],["ὄνειδος",973,20],["ποιεῖται",23,108],["ὁ",1,4],["ἀποστείλας",84,155],["διʼ",56,1],["ἀγγέλου",208,21],["ἄφρονος",439,219],["λόγον",48,7]],"He that sends a message by a foolish messenger procures for himself a reproach from his own ways."],["7",[["Ἄφελοῦ",369,275],["πορείαν",1476,10],["σκελῶν",2766,45],["καὶ",2,8],["παρανομίαν",2932,10],["ἐκ",21,1],["στόματος",123,24],["ἀφρόνων",439,409]],"[As well] take away the motion of the legs, as transgression from the mouth of fools."],["8",[["Ὃς",24,246],["ἀποδεσμεύει",8997,87],["λίθον",195,7],["ἐν",4,1],["σφενδόνῃ",3140,2],["ὅμοιός",657,16],["ἐστι",10,87],["τῷ",1,110],["διδόντι",33,390],["ἄφρονι",439,310],["δόξαν",141,10]],"He that binds up a stone in a sling, is like one that gives glory to a fool."],["9",[["Ἄκανθαι",1571,180],["φύονται",2127,299],["ἐν",4,1],["χειρὶ",37,2],["μεθύσου",3903,21],["δουλεία",1036,13],["δὲ",14,12],["ἐν",4,1],["χειρὶ",37,2],["τῶν",1,76],["ἀφρόνων",439,409]],"Thorns grow in the hand of a drunkard, and servitude in the hand of fools."],["10",[["Πολλὰ",74,65],["χειμάζεται",8671,108],["πᾶσα",11,15],["σὰρξ",287,13],["ἀφρόνων",439,409],["συντρίβεται",268,108],["γὰρ",40,12],["ἡ",1,11],["ἔκστασις",1535,13],["αὐτῶν",3,41]],"All the flesh of fools endures much hardship; for their fury is brought to nought."],["11",[["Ὥσπερ",226,17],["κύων",1204,5],["ὅταν",319,8],["ἐπέλθῃ",542,160],["ἐπὶ",9,1],["τὸν",1,6],["ἑαυτοῦ",92,48],["ἔμετον",9660,7],["καὶ",2,8],["μισητὸς",2920,16],["γένηται",30,236],["οὕτως",71,17],["ἄφρων",439,16],["τῇ",1,95],["ἑαυτοῦ",92,48],["κακίᾳ",433,2],["ἀναστρέψας",522,155],["ἐπὶ",9,1],["τὴν",1,9],["ἑαυτοῦ",92,48],["ἁμαρτίαν",119,10]],"As when a dog goes to his own vomit, and becomes abominable, so is a fool who returns in his wickedness to his own sin."],["11a",[["ἔστιν",10,87],["αἰσχύνη",685,13],["ἐπάγουσα",417,183],["ἁμαρτίαν",119,10],["καὶ",2,8],["ἐστιν",10,87],["αἰσχύνη",685,13],["δόξα",141,188],["καὶ",2,8],["χάρις",368,13]],"[There is a shame that brings sin: and there is a shame [that is] glory and grace.]"],["12",[["Εἶδον",53,147],["ἄνδρα",38,7],["δόξαντα",801,476],["παρʼ",73,1],["αὐτῷ",3,49],["σοφὸν",324,28],["εἶναι",10,54],["ἐλπίδα",530,10],["μέντοι",3905,12],["ἔσχε",124,3],["μᾶλλον",1043,17],["ἄφρων",439,16],["αὐτοῦ",3,48]],"I have seen a man who seemed to himself to be wise; but a fool had more hope than he."],["13",[["Λέγει",31,87],["ὀκνηρὸς",2234,16],["ἀποστελλόμενος",84,244],["εἰς",8,1],["ὁδὸν",68,10],["λέων",424,5],["ἐν",4,1],["ταῖς",1,70],["ἐν",4,1],["δὲ",14,12],["ταῖς",1,70],["πλατείαις",925,71],["φονευταί",1978,51]],"A sluggard when sent on a journey says, [There is] a lion in the ways, and [there are] murderers in the streets."],["14",[["Ὥσπερ",226,17],["θύρα",277,13],["στρέφεται",1078,108],["ἐπὶ",9,1],["τοῦ",1,30],["στρόφιγγος",8312,21],["οὕτως",71,17],["ὀκνηρὸς",2234,16],["ἐπὶ",9,1],["τῆς",1,18],["κλίνης",1221,19],["αὐτοῦ",3,48]],"As a door turns on the hinge, so does a sluggard on his bed."],["15",[["Κρύψας",372,155],["ὀκνηρὸς",2234,16],["τὴν",1,9],["χεῖρα",37,10],["ἐν",4,1],["τῷ",1,110],["κόλπῳ",1140,113],["αὐτοῦ",3,48],["οὐ",12,17],["δυνήσεται",185,89],["ἐπενεγκεῖν",2144,100],["ἐπὶ",9,1],["στόμα",123,33]],"A sluggard having hid his hand in his bosom, will not be able to bring it up to his mouth."],["16",[["Σοφώτερος",324,16],["ἑαυτῷ",92,49],["ὀκνηρὸς",2234,16],["φαίνεται",832,108],["τοῦ",1,30],["ἐν",4,1],["πλησμονῇ",1524,2],["ἀποκομίζοντος",6308,143],["ἀγγελίαν",2301,10]],"A sluggard seems to himself wiser than one who most satisfactorily brings back a message."],["17",[["Ὥσπερ",226,17],["ὁ",1,4],["κρατῶν",385,67],["κέρκου",3573,19],["κυνὸς",1204,21],["οὕτως",71,17],["ὁ",1,4],["προεστὼς",3340,264],["ἀλλοτρίας",381,78],["κρίσεως",229,19]],"As he that lays hold of a dog's tail, so is he that makes himself the champion of another's cause."],["18",[["Ὥσπερ",226,17],["οἱ",1,128],["ἰώμενοι",797,351],["προβάλλουσι",3337,191],["λόγους",48,31],["εἰς",8,1],["ἀνθρώπους",43,31],["ὁ",1,4],["δὲ",14,12],["ἀπαντήσας",1024,155],["τῷ",1,110],["λόγῳ",48,113],["πρῶτος",315,16],["ὑποσκελισθήσεται",3479,125]],"As those who need correction put forth [fair] words to men, and he that first falls in with the proposal will be overthrown;"],["19",[["Οὕτως",71,17],["πάντες",11,130],["οἱ",1,128],["ἐνεδρεύοντες",1490,137],["τοὺς",1,56],["ἑαυτῶν",92,41],["φίλους",336,58],["ὅταν",319,8],["δὲ",14,12],["ὁραθῶσι",0,0],["λέγουσιν",31,191],["ὅτι",19,8],["παίζων",1418,67],["ἔπραξα",1251,147]],"so are all that lay wait for their own friends, and when they are discovered, say, I did it in jest."],["20",[["Ἐν",4,1],["πολλοῖς",74,90],["ξύλοις",196,92],["θάλλει",3839,87],["πῦρ",118,33],["ὅπου",1579,17],["δὲ",14,12],["οὐκ",12,17],["ἔστι",10,87],["δίθυμος",7115,15],["ἡσυχάζει",1090,87],["μάχη",1382,13]],"With much wood fire increases; but where there is not a double-minded man, strife ceases."],["21",[["Ἐσχάρα",2322,13],["ἄνθραξι",1402,139],["καὶ",2,8],["ξύλα",196,63],["πυρὶ",118,53],["ἀνὴρ",38,5],["δὲ",14,12],["λοίδορος",4296,5],["εἰς",8,1],["ταραχὴν",1562,10],["μάχης",1382,19]],"A hearth for coals, and wood for fire; and a railing man for the tumult of strife."],["22",[["Λόγοι",48,51],["κερκώπων",7551,77],["μαλακοὶ",4895,130],["οὗτοι",16,213],["δὲ",14,12],["τύπτουσιν",1209,191],["εἰς",8,1],["ταμιεῖα",2501,63],["σπλάγχνων",2190,45]],"The words of cunning knaves are soft; but they smite [even] to the inmost parts of the bowels."],["23",[["Ἀργύριον",152,33],["διδόμενον",33,205],["μετὰ",29,1],["δόλου",919,21],["ὥσπερ",226,17],["ὄστρακον",2848,20],["ἡγητέον",9713,28],["χείλη",361,43],["λεῖα",1185,65],["καρδίαν",64,10],["καλύπτει",620,87],["λυπηράν",3582,37]],"Silver dishonestly given is to be considered as a potsherd: smooth lips cover a grievous heart."],["24",[["Χείλεσι",361,92],["πάντα",11,65],["ἐπινεύει",4606,87],["ἀποκλαιόμενος",5218,114],["ἐχθρὸς",135,5],["ἐν",4,1],["δὲ",14,12],["τῇ",1,95],["καρδίᾳ",64,2],["τεκταίνεται",2503,108],["δόλους",919,31]],"A weeping enemy promises all things with his lips, but in his heart he contrives deceit."],["25",[["Ἐάν",45,8],["σου",5,146],["δέηται",440,297],["ὁ",1,4],["ἐχθρὸς",135,5],["μεγάλῃ",66,96],["τῇ",1,95],["φωνῇ",95,2],["μὴ",25,8],["πεισθῇς",344,278],["ἑπτὰ",180,57],["γάρ",40,12],["πονηρίαι",730,2],["ἐν",4,1],["τῇ",1,95],["ψυχῇ",63,2],["αὐτοῦ",3,48]],"Though [thine] enemy intreat thee with a loud voice, consent not: for there are seven abominations in his heart."],["26",[["Ὁ",1,4],["κρύπτων",372,67],["ἔχθραν",1802,10],["συνίστησι",1065,87],["δόλον",919,7],["ἐκκαλύπτει",9294,87],["δὲ",14,12],["τὰς",1,39],["ἑαυτοῦ",92,48],["ἁμαρτίας",119,40],["εὔγνωστος",4784,16],["ἐν",4,1],["συνεδρίοις",2498,92]],"He that hides enmity frames deceit: but being easily discerned, exposes his own sins in the public assemblies."],["27",[["Ὁ",1,4],["ὀρύσσων",1373,67],["βόθρον",1718,7],["τῷ",1,110],["πλησίον",292,17],["ἐμπεσεῖται",994,89],["εἰς",8,1],["αὐτόν",3,82],["ὁ",1,4],["δὲ",14,12],["κυλίων",3871,67],["λίθον",195,7],["ἐφʼ",9,1],["ἑαυτὸν",92,82],["κυλίει",3871,87]],"He that digs a pit for his neighbour shall fall into it: and he that rolls a stone, rolls it upon himself."],["28",[["Γλῶσσα",388,13],["ψευδὴς",549,15],["μισεῖ",351,87],["ἀλήθειαν",352,10],["στόμα",123,33],["δὲ",14,12],["ἄστεγον",5268,29],["ποιεῖ",23,87],["ἀκαταστασίας",6235,19]],"A lying tongue hates the truth; and an unguarded mouth causes tumults."]]