[["1",[["Ὥσπερ",221,17],["δρόσος",1135,13],["ἐν",4,1],["ἀμητῷ",1704,113],["καὶ",2,8],["ὥσπερ",221,17],["ὑετὸς",672,5],["ἐν",4,1],["θέρει",3076,134],["οὕτως",70,17],["οὐκ",12,17],["ἔστιν",10,87],["ἄφρουι",0,0],["τιμή",721,13]],"As dew in harvest, and as rain in summer, so honour is not [seemly] for a fool."],["2",[["Ὥσπερ",221,17],["ὄρνεα",1240,63],["πέταται",1558,108],["καὶ",2,8],["στρουθοί",3143,51],["οὕτως",70,17],["ἀρὰ",1217,13],["ματαία",648,15],["οὐκ",12,17],["ἐπελεύσεται",540,89],["οὐδενί",225,314]],"As birds and sparrows fly, so a curse shall not come upon any one without a cause."],["3",[["Ὥσπερ",221,17],["μάστιξ",1308,13],["ἵππῳ",308,113],["καὶ",2,8],["κέντρον",3885,20],["ὄνῳ",497,113],["οὕτως",70,17],["ῥάβδος",492,13],["ἔθνει",59,53],["παρανόμῳ",832,34]],"As a whip for a horse, and a goad for an ass, so [is] a rod for a simple nation."],["4",[["Μὴ",25,8],["ἀποκρίνου",229,250],["ἄφρονι",438,314],["πρὸς",15,1],["τὴν",1,9],["ἐκείνου",79,48],["ἀφροσύνην",1402,10],["ἵνα",101,8],["μὴ",25,8],["ὅμοιος",651,16],["γένῃ",30,278],["αὐτῷ",3,49]],"Answer not a fool according to his folly, lest thou become like him."],["5",[["Ἀλλὰ",107,17],["ἀποκρίνου",229,250],["ἄφρονι",438,314],["κατὰ",32,1],["τὴν",1,9],["ἀφροσύνην",1402,10],["αὐτοῦ",3,48],["ἵνα",101,8],["μὴ",25,8],["φαίνηται",849,301],["σοφὸς",322,16],["παρʼ",72,1],["ἑαυτῷ",92,49]],"Yet answer a fool according to his folly, lest he seem wise in his own conceit."],["6",[["Ἐκ",21,1],["τῶν",1,123],["ὁδῶν",67,61],["ἑαυτοῦ",92,48],["ὄνειδος",973,20],["ποιεῖται",23,108],["ὁ",1,4],["ἀποστείλας",83,155],["διʼ",54,1],["ἀγγέλου",206,21],["ἄφρονος",438,218],["λόγον",48,7]],"He that sends a message by a foolish messenger procures for himself a reproach from his own ways."],["7",[["Ἄφελοῦ",367,275],["πορείαν",1479,10],["σκελῶν",2776,45],["καὶ",2,8],["παρανομίαν",2945,10],["ἐκ",21,1],["στόματος",123,24],["ἀφρόνων",438,416]],"[As well] take away the motion of the legs, as transgression from the mouth of fools."],["8",[["Ὃς",24,247],["ἀποδεσμεύει",9064,87],["λίθον",195,7],["ἐν",4,1],["σφενδόνῃ",3148,2],["ὅμοιός",651,16],["ἐστι",10,87],["τῷ",1,110],["διδόντι",33,395],["ἄφρονι",438,314],["δόξαν",141,10]],"He that binds up a stone in a sling, is like one that gives glory to a fool."],["9",[["Ἄκανθαι",1572,179],["φύονται",2134,303],["ἐν",4,1],["χειρὶ",37,2],["μεθύσου",3914,21],["δουλεία",1033,13],["δὲ",14,12],["ἐν",4,1],["χειρὶ",37,2],["τῶν",1,76],["ἀφρόνων",438,416]],"Thorns grow in the hand of a drunkard, and servitude in the hand of fools."],["10",[["Πολλὰ",74,65],["χειμάζεται",8731,108],["πᾶσα",11,15],["σὰρξ",287,13],["ἀφρόνων",438,416],["συντρίβεται",267,108],["γὰρ",40,12],["ἡ",1,11],["ἔκστασις",1533,13],["αὐτῶν",3,41]],"All the flesh of fools endures much hardship; for their fury is brought to nought."],["11",[["Ὥσπερ",221,17],["κύων",1208,5],["ὅταν",318,8],["ἐπέλθῃ",540,160],["ἐπὶ",9,1],["τὸν",1,6],["ἑαυτοῦ",92,48],["ἔμετον",9734,7],["καὶ",2,8],["μισητὸς",2934,16],["γένηται",30,236],["οὕτως",70,17],["ἄφρων",438,16],["τῇ",1,95],["ἑαυτοῦ",92,48],["κακίᾳ",431,2],["ἀναστρέψας",520,155],["ἐπὶ",9,1],["τὴν",1,9],["ἑαυτοῦ",92,48],["ἁμαρτίαν",119,10]],"As when a dog goes to his own vomit, and becomes abominable, so is a fool who returns in his wickedness to his own sin."],["11a",[["ἔστιν",10,87],["αἰσχύνη",683,13],["ἐπάγουσα",415,181],["ἁμαρτίαν",119,10],["καὶ",2,8],["ἐστιν",10,87],["αἰσχύνη",683,13],["δόξα",141,186],["καὶ",2,8],["χάρις",366,13]],"[There is a shame that brings sin: and there is a shame [that is] glory and grace.]"],["12",[["Εἶδον",73,147],["ἄνδρα",38,7],["δόξαντα",798,485],["παρʼ",72,1],["αὐτῷ",3,49],["σοφὸν",322,28],["εἶναι",10,54],["ἐλπίδα",527,10],["μέντοι",3916,12],["ἔσχε",124,3],["μᾶλλον",1040,17],["ἄφρων",438,16],["αὐτοῦ",3,48]],"I have seen a man who seemed to himself to be wise; but a fool had more hope than he."],["13",[["Λέγει",31,87],["ὀκνηρὸς",2248,16],["ἀποστελλόμενος",83,245],["εἰς",8,1],["ὁδὸν",67,10],["λέων",421,5],["ἐν",4,1],["ταῖς",1,70],["ἐν",4,1],["δὲ",14,12],["ταῖς",1,70],["πλατείαις",925,71],["φονευταί",1982,51]],"A sluggard when sent on a journey says, [There is] a lion in the ways, and [there are] murderers in the streets."],["14",[["Ὥσπερ",221,17],["θύρα",277,13],["στρέφεται",1079,108],["ἐπὶ",9,1],["τοῦ",1,30],["στρόφιγγος",8370,21],["οὕτως",70,17],["ὀκνηρὸς",2248,16],["ἐπὶ",9,1],["τῆς",1,18],["κλίνης",1184,19],["αὐτοῦ",3,48]],"As a door turns on the hinge, so does a sluggard on his bed."],["15",[["Κρύψας",378,155],["ὀκνηρὸς",2248,16],["τὴν",1,9],["χεῖρα",37,10],["ἐν",4,1],["τῷ",1,110],["κόλπῳ",1140,113],["αὐτοῦ",3,48],["οὐ",12,17],["δυνήσεται",184,89],["ἐπενεγκεῖν",2150,100],["ἐπὶ",9,1],["στόμα",123,33]],"A sluggard having hid his hand in his bosom, will not be able to bring it up to his mouth."],["16",[["Σοφώτερος",322,16],["ἑαυτῷ",92,49],["ὀκνηρὸς",2248,16],["φαίνεται",849,108],["τοῦ",1,30],["ἐν",4,1],["πλησμονῇ",1522,2],["ἀποκομίζοντος",6339,143],["ἀγγελίαν",2315,10]],"A sluggard seems to himself wiser than one who most satisfactorily brings back a message."],["17",[["Ὥσπερ",221,17],["ὁ",1,4],["κρατῶν",383,67],["κέρκου",3577,19],["κυνὸς",1208,21],["οὕτως",70,17],["ὁ",1,4],["προεστὼς",3344,265],["ἀλλοτρίας",377,78],["κρίσεως",226,19]],"As he that lays hold of a dog's tail, so is he that makes himself the champion of another's cause."],["18",[["Ὥσπερ",221,17],["οἱ",1,128],["ἰώμενοι",794,356],["προβάλλουσι",3342,189],["λόγους",48,31],["εἰς",8,1],["ἀνθρώπους",43,31],["ὁ",1,4],["δὲ",14,12],["ἀπαντήσας",1047,155],["τῷ",1,110],["λόγῳ",48,113],["πρῶτος",314,16],["ὑποσκελισθήσεται",3482,125]],"As those who need correction put forth [fair] words to men, and he that first falls in with the proposal will be overthrown;"],["19",[["Οὕτως",70,17],["πάντες",11,130],["οἱ",1,128],["ἐνεδρεύοντες",1492,137],["τοὺς",1,56],["ἑαυτῶν",92,41],["φίλους",334,58],["ὅταν",318,8],["δὲ",14,12],["ὁραθῶσι",0,0],["λέγουσιν",31,189],["ὅτι",19,8],["παίζων",1476,67],["ἔπραξα",1252,147]],"so are all that lay wait for their own friends, and when they are discovered, say, I did it in jest."],["20",[["Ἐν",4,1],["πολλοῖς",74,90],["ξύλοις",196,92],["θάλλει",3542,87],["πῦρ",118,33],["ὅπου",1580,17],["δὲ",14,12],["οὐκ",12,17],["ἔστι",10,87],["δίθυμος",7162,15],["ἡσυχάζει",1091,87],["μάχη",1383,13]],"With much wood fire increases; but where there is not a double-minded man, strife ceases."],["21",[["Ἐσχάρα",2334,13],["ἄνθραξι",1403,139],["καὶ",2,8],["ξύλα",196,63],["πυρὶ",118,53],["ἀνὴρ",38,5],["δὲ",14,12],["λοίδορος",4309,5],["εἰς",8,1],["ταραχὴν",1562,10],["μάχης",1383,19]],"A hearth for coals, and wood for fire; and a railing man for the tumult of strife."],["22",[["Λόγοι",48,51],["κερκώπων",7602,77],["μαλακοὶ",4920,130],["οὗτοι",16,213],["δὲ",14,12],["τύπτουσιν",1191,189],["εἰς",8,1],["ταμιεῖα",2505,63],["σπλάγχνων",2203,45]],"The words of cunning knaves are soft; but they smite [even] to the inmost parts of the bowels."],["23",[["Ἀργύριον",150,33],["διδόμενον",33,205],["μετὰ",29,1],["δόλου",920,21],["ὥσπερ",221,17],["ὄστρακον",2862,20],["ἡγητέον",9787,28],["χείλη",361,43],["λεῖα",1186,65],["καρδίαν",63,10],["καλύπτει",618,87],["λυπηράν",3588,37]],"Silver dishonestly given is to be considered as a potsherd: smooth lips cover a grievous heart."],["24",[["Χείλεσι",361,92],["πάντα",11,65],["ἐπινεύει",4630,87],["ἀποκλαιόμενος",5248,114],["ἐχθρὸς",135,5],["ἐν",4,1],["δὲ",14,12],["τῇ",1,95],["καρδίᾳ",63,2],["τεκταίνεται",2507,108],["δόλους",920,31]],"A weeping enemy promises all things with his lips, but in his heart he contrives deceit."],["25",[["Ἐάν",45,8],["σου",5,146],["δέηται",439,301],["ὁ",1,4],["ἐχθρὸς",135,5],["μεγάλῃ",65,96],["τῇ",1,95],["φωνῇ",95,2],["μὴ",25,8],["πεισθῇς",343,279],["ἑπτὰ",179,57],["γάρ",40,12],["πονηρίαι",729,2],["ἐν",4,1],["τῇ",1,95],["ψυχῇ",62,2],["αὐτοῦ",3,48]],"Though [thine] enemy intreat thee with a loud voice, consent not: for there are seven abominations in his heart."],["26",[["Ὁ",1,4],["κρύπτων",378,67],["ἔχθραν",1804,10],["συνίστησι",1099,87],["δόλον",920,7],["ἐκκαλύπτει",9368,87],["δὲ",14,12],["τὰς",1,39],["ἑαυτοῦ",92,48],["ἁμαρτίας",119,40],["εὔγνωστος",4809,16],["ἐν",4,1],["συνεδρίοις",2503,92]],"He that hides enmity frames deceit: but being easily discerned, exposes his own sins in the public assemblies."],["27",[["Ὁ",1,4],["ὀρύσσων",1372,67],["βόθρον",1718,7],["τῷ",1,110],["πλησίον",292,17],["ἐμπεσεῖται",1085,89],["εἰς",8,1],["αὐτόν",3,82],["ὁ",1,4],["δὲ",14,12],["κυλίων",3881,67],["λίθον",195,7],["ἐφʼ",9,1],["ἑαυτὸν",92,82],["κυλίει",3881,87]],"He that digs a pit for his neighbour shall fall into it: and he that rolls a stone, rolls it upon himself."],["28",[["Γλῶσσα",385,13],["ψευδὴς",547,15],["μισεῖ",355,87],["ἀλήθειαν",350,10],["στόμα",123,33],["δὲ",14,12],["ἄστεγον",5299,29],["ποιεῖ",23,87],["ἀκαταστασίας",6266,19]],"A lying tongue hates the truth; and an unguarded mouth causes tumults."]]