[["1",[["Καὶ",2,8],["ὁ",1,4],["πέμπτος",844,16],["ἄγγελος",208,5],["ἐσάλπισεν",845,3],["καὶ",2,8],["εἶδον",112,147],["ἀστέρα",1699,7],["ἐκ",21,1],["τοῦ",1,30],["οὐρανοῦ",94,21],["πεπτωκότα",154,434],["εἰς",8,1],["τὴν",1,9],["γῆν",26,10],["καὶ",2,8],["ἐδόθη",33,38],["αὐτῷ",3,49],["ἡ",1,11],["κλεὶς",4271,13],["τοῦ",1,23],["φρέατος",877,24],["τῆς",1,18],["ἀβύσσου",1083,19]],"The fifth angel sounded, and I saw a star from the sky which had fallen to the earth. The key to the pit of the abyss was given to him."],["2",[["καὶ",2,8],["ἤνοιξεν",362,3],["τὸ",1,32],["φρέαρ",877,33],["τῆς",1,18],["ἀβύσσου",1083,19],["καὶ",2,8],["ἀνέβη",88,3],["καπνὸς",1469,5],["ἐκ",21,1],["τοῦ",1,23],["φρέατος",877,24],["ὡς",36,12],["καπνὸς",1469,5],["καμίνου",1166,19],["μεγάλης",66,78],["καὶ",2,8],["ἐσκοτώθη",3351,38],["ὁ",1,4],["ἥλιος",323,5],["καὶ",2,8],["ὁ",1,4],["ἀὴρ",2664,5],["ἐκ",21,1],["τοῦ",1,30],["καπνοῦ",1469,21],["τοῦ",1,23],["φρέατος",877,24]],"He opened the pit of the abyss, and smoke went up out of the pit, like the smoke from a burning furnace. The sun and the air were darkened because of the smoke from the pit."],["3",[["καὶ",2,8],["ἐκ",21,1],["τοῦ",1,30],["καπνοῦ",1469,21],["ἐξῆλθον",82,141],["ἀκρίδες",1361,180],["εἰς",8,1],["τὴν",1,9],["γῆν",26,10],["καὶ",2,8],["ἐδόθη",33,38],["αὐταῖς",3,194],["ἐξουσία",929,13],["ὡς",36,12],["ἔχουσιν",124,191],["ἐξουσίαν",929,10],["οἱ",1,128],["σκορπίοι",2765,51],["τῆς",1,18],["γῆς",26,19]],"Then out of the smoke came locusts on the earth, and power was given to them, as the scorpions of the earth have power."],["4",[["καὶ",2,8],["ἐρρέθη",31,38],["αὐταῖς",3,194],["ἵνα",102,8],["μὴ",25,12],["ἀδικήσουσιν",760,207],["τὸν",1,6],["χόρτον",1046,7],["τῆς",1,18],["γῆς",26,19],["οὐδὲ",106,8],["πᾶν",11,29],["χλωρὸν",2203,29],["οὐδὲ",106,8],["πᾶν",11,29],["δένδρον",1342,33],["εἰ",77,8],["μὴ",25,12],["τοὺς",1,56],["ἀνθρώπους",43,31],["οἵτινες",457,455],["οὐκ",12,12],["ἔχουσιν",124,191],["τὴν",1,9],["σφραγῖδα",3141,10],["τοῦ",1,30],["θεοῦ",20,21],["ἐπὶ",9,1],["τῶν",1,44],["μετώπων",3094,45]],"They were told that they should not hurt the grass of the earth, neither any green thing, neither any tree, but only those people who don’t have God’s seal on their foreheads."],["5",[["καὶ",2,8],["ἐδόθη",33,38],["αὐτοῖς",3,142],["ἵνα",102,8],["μὴ",25,12],["ἀποκτείνωσιν",300,224],["αὐτούς",3,60],["ἀλλ᾽",108,8],["ἵνα",102,8],["βασανισθήσονται",1435,135],["μῆνας",10294,31],["πέντε",280,372],["καὶ",2,8],["ὁ",1,4],["βασανισμὸς",5489,5],["αὐτῶν",3,189],["ὡς",36,12],["βασανισμὸς",5489,5],["σκορπίου",2765,21],["ὅταν",319,8],["παίσῃ",2372,160],["ἄνθρωπον",43,7]],"They were given power, not to kill them, but to torment them for five months. Their torment was like the torment of a scorpion when it strikes a person."],["6",[["Καὶ",2,8],["ἐν",4,1],["ταῖς",1,70],["ἡμέραις",28,71],["ἐκείναις",80,336],["ζητήσουσιν",191,207],["οἱ",1,128],["ἄνθρωποι",43,51],["τὸν",1,6],["θάνατον",170,7],["καὶ",2,8],["οὐ",12,12],["μὴ",25,12],["εὑρήσουσιν",101,207],["αὐτόν",3,82],["καὶ",2,8],["ἐπιθυμήσουσιν",915,207],["ἀποθανεῖν",109,100],["καὶ",2,8],["φεύγει",264,87],["ὁ",1,4],["θάνατος",170,5],["ἀπ᾽",17,1],["αὐτῶν",3,41]],"In those days people will seek death, and will in no way find it. They will desire to die, and death will flee from them."],["7",[["καὶ",2,8],["τὰ",1,253],["ὁμοιώματα",1176,63],["τῶν",1,123],["ἀκρίδων",1361,61],["ὅμοια",657,74],["ἵπποις",309,139],["ἡτοιμασμένοις",371,804],["εἰς",8,1],["πόλεμον",163,7],["καὶ",2,8],["ἐπὶ",9,1],["τὰς",1,39],["κεφαλὰς",144,40],["αὐτῶν",3,189],["ὡς",36,12],["στέφανοι",980,51],["ὅμοιοι",657,130],["χρυσῷ",1602,113],["καὶ",2,8],["τὰ",1,253],["πρόσωπα",47,63],["αὐτῶν",3,189],["ὡς",36,12],["πρόσωπα",47,63],["ἀνθρώπων",43,77]],"The shapes of the locusts were like horses prepared for war. On their heads were something like golden crowns, and their faces were like people’s faces."],["8",[["καὶ",2,8],["εἶχον",124,129],["τρίχας",1038,40],["ὡς",36,12],["τρίχας",1038,40],["γυναικῶν",59,61],["καὶ",2,8],["οἱ",1,128],["ὀδόντες",930,51],["αὐτῶν",3,189],["ὡς",36,12],["λεόντων",424,77],["ἦσαν",10,129]],"They had hair like women’s hair, and their teeth were like those of lions."],["9",[["καὶ",2,8],["εἶχον",124,129],["θώρακας",2082,31],["ὡς",36,12],["θώρακας",2082,31],["σιδηροῦς",1063,58],["καὶ",2,8],["ἡ",1,11],["φωνὴ",95,13],["τῶν",1,123],["πτερύγων",719,61],["αὐτῶν",3,189],["ὡς",36,12],["φωνὴ",95,13],["ἁρμάτων",359,45],["ἵππων",309,77],["πολλῶν",74,163],["τρεχόντων",820,164],["εἰς",8,1],["πόλεμον",163,7]],"They had breastplates like breastplates of iron. The sound of their wings was like the sound of many chariots and horses rushing to war."],["10",[["καὶ",2,8],["ἔχουσιν",124,191],["οὐρὰς",3313,40],["ὁμοίας",657,109],["σκορπίοις",2765,139],["καὶ",2,8],["κέντρα",3875,43],["καὶ",2,8],["ἐν",4,1],["ταῖς",1,70],["οὐραῖς",3313,71],["αὐτῶν",3,189],["ἡ",1,11],["ἐξουσία",929,13],["αὐτῶν",3,189],["ἀδικῆσαι",760,100],["τοὺς",1,56],["ἀνθρώπους",43,31],["μῆνας",10294,31],["πέντε",280,372]],"They have tails like those of scorpions, with stingers. In their tails they have power to harm men for five months."],["11",[["ἔχουσιν",124,191],["ἐπ᾽",9,1],["αὐτῶν",3,189],["βασιλέα",22,7],["τὸν",1,6],["ἄγγελον",208,7],["τῆς",1,18],["ἀβύσσου",1083,19],["ὄνομα",57,20],["αὐτῷ",3,49],["Ἑβραϊστὶ",9701,17],["Ἀβαδδών",11478,5],["καὶ",2,8],["ἐν",4,1],["τῇ",1,95],["Ἑλληνικῇ",3208,96],["ὄνομα",57,33],["ἔχει",124,87],["Ἀπολλύων",11479,5]],"They have over them as king the angel of the abyss. His name in Hebrew is “Abaddon”, but in Greek, he has the name “Apollyon”."],["12",[["ἡ",1,11],["οὐαὶ",769,316],["ἡ",1,11],["μία",58,15],["ἀπῆλθεν",297,3],["ἰδοὺ",51,316],["ἔρχεται",55,728],["ἔτι",111,17],["δύο",104,372],["οὐαὶ",769,316],["μετὰ",29,1],["ταῦτα",16,248]],"The first woe is past. Behold, there are still two woes coming after this."],["13",[["Καὶ",2,8],["ὁ",1,4],["ἕκτος",1259,16],["ἄγγελος",208,5],["ἐσάλπισεν",845,3],["καὶ",2,8],["ἤκουσα",54,147],["φωνὴν",95,10],["μίαν",58,37],["ἐκ",21,1],["τῶν",1,44],["τεσσάρων",306,79],["κεράτων",569,45],["τοῦ",1,23],["θυσιαστηρίου",133,24],["τοῦ",1,23],["χρυσοῦ",290,88],["τοῦ",1,23],["ἐνώπιον",115,1],["τοῦ",1,30],["θεοῦ",20,21]],"The sixth angel sounded. I heard a voice from the horns of the golden altar which is before God,"],["14",[["λέγοντα",31,178],["τῷ",1,110],["ἕκτῳ",1259,111],["ἀγγέλῳ",208,113],["ὁ",1,4],["ἔχων",124,67],["τὴν",1,9],["σάλπιγγα",580,10],["λῦσον",1381,198],["τοὺς",1,56],["τέσσαρας",306,58],["ἀγγέλους",208,31],["τοὺς",1,56],["δεδεμένους",440,803],["ἐπὶ",9,1],["τῷ",1,110],["ποταμῷ",249,113],["τῷ",1,110],["μεγάλῳ",66,111],["Εὐφράτῃ",1501,113]],"saying to the sixth angel who had the trumpet, “Free the four angels who are bound at the great river Euphrates!”"],["15",[["καὶ",2,8],["ἐλύθησαν",1381,94],["οἱ",1,128],["τέσσαρες",306,130],["ἄγγελοι",208,51],["οἱ",1,128],["ἡτοιμασμένοι",371,574],["εἰς",8,1],["τὴν",1,9],["ὥραν",838,10],["καὶ",2,8],["ἡμέραν",28,10],["καὶ",2,8],["μῆνα",10294,7],["καὶ",2,8],["ἐνιαυτὸν",400,7],["ἵνα",102,8],["ἀποκτείνωσιν",300,224],["τὸ",1,32],["τρίτον",357,29],["τῶν",1,76],["ἀνθρώπων",43,77]],"The four angels were freed who had been prepared for that hour and day and month and year, so that they might kill one third of mankind."],["16",[["καὶ",2,8],["ὁ",1,4],["ἀριθμὸς",355,5],["τῶν",1,44],["στρατευμάτων",3357,45],["τοῦ",1,23],["ἱππικοῦ",6598,88],["δισμυριάδες",1957,180],["μυριάδων",1142,61],["ἤκουσα",54,147],["τὸν",1,6],["ἀριθμὸν",355,7],["αὐτῶν",3,168]],"The number of the armies of the horsemen was two hundred million. I heard the number of them."],["17",[["Καὶ",2,8],["οὕτως",71,17],["εἶδον",112,147],["τοὺς",1,56],["ἵππους",309,31],["ἐν",4,1],["τῇ",1,95],["ὁράσει",509,2],["καὶ",2,8],["τοὺς",1,56],["καθημένους",419,729],["ἐπ᾽",9,1],["αὐτῶν",3,41],["ἔχοντας",124,229],["θώρακας",2082,31],["πυρίνους",5032,58],["καὶ",2,8],["ὑακινθίνους",1614,58],["καὶ",2,8],["θειώδεις",11480,58],["καὶ",2,8],["αἱ",1,185],["κεφαλαὶ",144,180],["τῶν",1,76],["ἵππων",309,77],["ὡς",36,12],["κεφαλαὶ",144,180],["λεόντων",424,77],["καὶ",2,8],["ἐκ",21,1],["τῶν",1,44],["στομάτων",123,45],["αὐτῶν",3,41],["ἐκπορεύεται",365,728],["πῦρ",118,20],["καὶ",2,8],["καπνὸς",1469,5],["καὶ",2,8],["θεῖον",2893,20]],"Thus I saw the horses in the vision and those who sat on them, having breastplates of fiery red, hyacinth blue, and sulfur yellow; and the horses’ heads resembled lions’ heads. Out of their mouths proceed fire, smoke, and sulfur."],["18",[["ἀπὸ",17,1],["τῶν",1,123],["τριῶν",174,115],["πληγῶν",573,61],["τούτων",16,519],["ἀπεκτάνθησαν",300,94],["τὸ",1,27],["τρίτον",357,28],["τῶν",1,76],["ἀνθρώπων",43,77],["ἐκ",21,1],["τοῦ",1,23],["πυρὸς",118,24],["καὶ",2,8],["τοῦ",1,30],["καπνοῦ",1469,21],["καὶ",2,8],["τοῦ",1,23],["θείου",2893,24],["τοῦ",1,23],["ἐκπορευομένου",365,871],["ἐκ",21,1],["τῶν",1,44],["στομάτων",123,45],["αὐτῶν",3,41]],"By these three plagues, one third of mankind was killed: by the fire, the smoke, and the sulfur, which proceeded out of their mouths."],["19",[["ἡ",1,11],["γὰρ",40,8],["ἐξουσία",929,13],["τῶν",1,76],["ἵππων",309,77],["ἐν",4,1],["τῷ",1,52],["στόματι",123,53],["αὐτῶν",3,41],["ἐστιν",10,87],["καὶ",2,8],["ἐν",4,1],["ταῖς",1,70],["οὐραῖς",3313,71],["αὐτῶν",3,41],["αἱ",1,185],["γὰρ",40,8],["οὐραὶ",3313,180],["αὐτῶν",3,41],["ὅμοιαι",657,187],["ὄφεσιν",1197,139],["ἔχουσαι",124,301],["κεφαλὰς",144,40],["καὶ",2,8],["ἐν",4,1],["αὐταῖς",3,194],["ἀδικοῦσιν",760,191]],"For the power of the horses is in their mouths and in their tails. For their tails are like serpents, and have heads; and with them they harm."],["20",[["καὶ",2,8],["οἱ",1,128],["λοιποὶ",523,130],["τῶν",1,76],["ἀνθρώπων",43,77],["οἳ",24,455],["οὐκ",12,12],["ἀπεκτάνθησαν",300,94],["ἐν",4,1],["ταῖς",1,70],["πληγαῖς",573,71],["ταύταις",16,336],["οὐδὲ",106,8],["μετενόησαν",1634,141],["ἐκ",21,1],["τῶν",1,44],["ἔργων",105,45],["τῶν",1,123],["χειρῶν",37,61],["αὐτῶν",3,41],["ἵνα",102,8],["μὴ",25,12],["προσκυνήσουσιν",298,207],["τὰ",1,42],["δαιμόνια",2013,43],["καὶ",2,8],["τὰ",1,42],["εἴδωλα",627,43],["τὰ",1,42],["χρυσᾶ",290,65],["καὶ",2,8],["τὰ",1,42],["ἀργυρᾶ",590,65],["καὶ",2,8],["τὰ",1,42],["χαλκᾶ",614,65],["καὶ",2,8],["τὰ",1,42],["λίθινα",1632,65],["καὶ",2,8],["τὰ",1,42],["ξύλινα",1417,65],["ἃ",24,778],["οὔτε",477,8],["βλέπειν",470,54],["δύνανται",185,756],["οὔτε",477,8],["ἀκούειν",54,54],["οὔτε",477,8],["περιπατεῖν",1327,54]],"The rest of mankind, who were not killed with these plagues, didn’t repent of the works of their hands, that they wouldn’t worship demons, and the idols of gold, and of silver, and of brass, and of stone, and of wood, which can’t see, hear, or walk."],["21",[["καὶ",2,8],["οὐ",12,12],["μετενόησαν",1634,141],["ἐκ",21,1],["τῶν",1,76],["φόνων",1645,77],["αὐτῶν",3,41],["οὔτε",477,8],["ἐκ",21,1],["τῶν",1,44],["φαρμάκων",2394,45],["αὐτῶν",3,41],["οὔτε",477,8],["ἐκ",21,1],["τῆς",1,18],["πορνείας",1003,19],["αὐτῶν",3,41],["οὔτε",477,8],["ἐκ",21,1],["τῶν",1,44],["κλεμμάτων",4275,45],["αὐτῶν",3,41]],"They didn’t repent of their murders, their sorceries, their sexual immorality, or their thefts."]]