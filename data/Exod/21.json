[["1",[["Καὶ",2,8],["ταῦτα",16,249],["τὰ",1,42],["δικαιώματα",425,43],["ἃ",1,11],["παραθήσῃ",1277,116],["ἐνώπιον",114,1],["αὐτῶν",3,41]],"And these [are] the ordinances which thou shalt set before them."],["2",[["Ἐὰν",45,8],["κτήσῃ",533,116],["παῖδα",126,7],["Ἐβραῖον",1090,7],["ἓξ",528,57],["ἔτη",80,43],["δουλεύσει",403,120],["σοι",5,151],["τῷ",1,110],["δὲ",14,12],["ἑβδόμῳ",460,111],["ἔτει",80,53],["ἀπελεύσεται",305,89],["ἐλεύθερος",1456,16],["δωρεάν",1338,10]],"If thou buy a Hebrew servant, six years shall he serve thee, and in the seventh year he shall go forth free for nothing."],["3",[["Ἐὰν",45,8],["αὐτὸς",3,158],["μόνος",300,16],["εἰσέλθῃ",88,160],["καὶ",2,8],["μόνος",300,16],["ἐξελεύσεται",84,89],["ἐὰν",45,8],["δὲ",14,12],["γυνὴ",58,13],["συνεισέλθῃ",4432,160],["μετʼ",29,1],["αὐτοῦ",3,48],["ἐξελεύσεται",84,89],["καὶ",2,8],["ἡ",1,11],["γυνὴ",58,13],["αὐτοῦ",3,48]],"If he should have come in alone, he shall also go forth alone; and if his wife should have gone in together with him, his wife also shall go out."],["4",[["Καὶ",2,8],["ἐὰν",45,8],["δὲ",14,12],["ὁ",1,4],["κύριος",7,5],["δῷ",33,160],["αὐτῷ",3,49],["γυναῖκα",58,10],["καὶ",2,8],["τέκῃ",251,160],["αὐτῷ",3,49],["υἱοὺς",13,31],["ἢ",60,8],["θυγατέρας",97,40],["ἡ",1,11],["γυνὴ",58,13],["καὶ",2,8],["τὰ",1,42],["παιδία",447,43],["ἔσται",10,89],["τῷ",1,110],["κυρίῳ",7,113],["αὐτοῦ",3,48],["αὐτὸς",3,158],["δὲ",14,12],["μόνος",300,16],["ἐξελεύσεται",84,89]],"Moreover, if his master give him a wife, and she have [born] him sons or daughters, the wife and the children shall be his master's; and he shall go forth alone."],["5",[["Ἐὰν",45,8],["δὲ",14,12],["ἀποκριθεὶς",229,206],["εἴπῃ",18,160],["ὁ",1,4],["παῖς",126,5],["ἠγάπηκα",0,0],["τὸν",1,6],["κύριόν",7,7],["μου",6,48],["καὶ",2,8],["τὴν",1,9],["γυναῖκα",58,10],["καὶ",2,8],["τὰ",1,42],["παιδία",447,43],["οὐκ",12,17],["ἀποτρέχω",1653,149],["ἐλεύθερος",1456,16]],"And if the servant should answer and say, I love my master and wife and children, I will not go away free;"],["6",[["προσάξει",352,120],["αὐτὸν",3,82],["ὁ",1,4],["κύριος",7,5],["αὐτοῦ",3,48],["πρὸς",15,1],["τὸ",1,32],["κριτήριον",3569,33],["τοῦ",1,30],["Θεοῦ",20,21],["καὶ",2,8],["τότε",250,17],["προσάξει",352,120],["αὐτὸν",3,82],["ἐπὶ",9,1],["τὴν",1,9],["θύραν",277,10],["ἐπὶ",9,1],["τὸν",1,6],["σταθμὸν",970,7],["καὶ",2,8],["τρυπήσει",4463,120],["ὁ",1,4],["κύριος",7,5],["αὐτοῦ",3,48],["τὸ",1,32],["οὖς",325,33],["τῷ",1,52],["ὀπητίῳ",6655,53],["καὶ",2,8],["δουλεύσει",403,120],["αὐτῷ",3,49],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7]],"his master shall bring him to the judgment-seat of God, and then shall he bring him to the door,—to the door-post, and his master shall bore his ear through with an awl, and he shall serve him for ever."],["7",[["Ἐὰν",45,8],["δέ",14,12],["τις",39,150],["ἀποδῶται",311,236],["τὴν",1,9],["ἑαυτοῦ",92,48],["θυγατέρα",97,10],["οἰκέτιν",4961,10],["οὐκ",12,17],["ἀπελεύσεται",305,89],["ὥσπερ",221,17],["ἀποτρέχουσιν",1653,189],["αἱ",1,183],["δοῦλαι",136,179]],"And if any one sell his daughter as a domestic, she shall not depart as the maid-servants depart."],["8",[["Ἐὰν",45,8],["μὴ",25,8],["εὐαρεστήσῃ",4236,116],["τῷ",1,110],["κυρίῳ",7,113],["αὐτῆς",3,83],["ἣ",1,11],["αὐτῷ",3,49],["καθωμολογήσατο",5695,26],["ἀπολυτρώσει",6340,120],["αὐτήν",3,98],["ἔθνει",59,53],["δὲ",14,12],["ἀλλοτρίῳ",377,34],["οὐ",12,17],["κύριός",7,5],["ἐστι",10,87],["πωλεῖν",2119,54],["αὐτὴν",3,98],["ὅτι",19,8],["ἠθέτησεν",835,3],["ἐν",4,1],["αὐτῇ",3,99]],"If she be not pleasing to her master, after she has betrothed herself to him, he shall let her go free; but he is not at liberty to sell her to a foreign nation, because he has trifled with her."],["9",[["Ἐὰν",45,8],["δὲ",14,12],["τῷ",1,110],["υἱῷ",13,113],["καθομολογήσηται",5695,236],["αὐτὴν",3,98],["κατὰ",32,1],["τὸ",1,32],["δικαίωμα",425,33],["τῶν",1,123],["θυγατέρων",97,61],["ποιήσει",23,120],["αὐτῇ",3,99]],"And if he should have betrothed her to his son, he shall do to her according to the right of daughters."],["10",[["Ἐὰν",45,8],["δὲ",14,12],["ἄλλην",581,98],["λάβῃ",46,160],["ἑαυτῷ",92,49],["τὰ",1,42],["δέοντα",439,232],["καὶ",2,8],["τὸν",1,6],["ἱματισμὸν",1462,7],["καὶ",2,8],["τὴν",1,9],["ὁμιλίαν",4670,10],["αὐτῆς",3,83],["οὐκ",12,17],["ἀποστερήσει",3412,120]],"And if he take another to himself, he shall not deprive her of necessaries and her apparel, and her companionship [with him]."],["11",[["Ἐὰν",45,8],["δὲ",14,12],["τὰ",1,42],["τρία",173,65],["ταῦτα",16,249],["μὴ",25,8],["ποιήσῃ",23,160],["αὐτῇ",3,99],["ἐξελεύσεται",84,89],["δωρεὰν",1338,10],["ἄνευ",1103,1],["ἀργυρίου",150,24]],"And if he will not do these three things to her, she shall go out free without money."],["12",[["Ἐὰν",45,8],["δὲ",14,12],["πατάξῃ",145,160],["τις",39,150],["τινὰ",39,368],["καὶ",2,8],["ἀποθάνῃ",108,160],["θανάτῳ",169,113],["θανατούσθω",386,344]],"And if any man smite another and he die, let him be certainly put to death."],["13",[["Ὁ",1,4],["δὲ",14,12],["οὐχ",12,17],["ἑκὼν",6577,16],["ἀλλὰ",107,17],["ὁ",1,4],["Θεὸς",20,5],["παρέδωκεν",254,3],["εἰς",8,1],["τὰς",1,39],["χεῖρας",37,40],["αὐτοῦ",3,48],["δώσω",33,157],["σοι",5,151],["τόπον",99,7],["οὗ",120,17],["φεύξεται",265,89],["ἐκεῖ",76,17],["ὁ",1,4],["φονεύσας",983,155]],"But as for him that did it not willingly, but God delivered him into his hands, I will give thee a place whither the slayer may flee."],["14",[["Ἐὰν",45,8],["δέ",14,12],["τις",39,150],["ἐπιθῆται",239,236],["τῷ",1,110],["πλησίον",292,17],["ἀποκτεῖναι",298,100],["αὐτὸν",3,82],["δόλῳ",920,113],["καὶ",2,8],["καταφύγῃ",1964,160],["ἀπὸ",17,1],["τοῦ",1,23],["θυσιαστηρίου",133,24],["μου",6,48],["λήψῃ",46,116],["αὐτὸν",3,82],["θανατῶσαι",386,100]],"And if any one lie in wait for his neighbour to slay him by craft, and he go for refuge, thou shalt take him from my altar to put him to death."],["15",[["Ὃς",24,247],["τύπτει",1191,87],["πατέρα",44,7],["αὐτοῦ",3,48],["ἢ",60,8],["μητέρα",188,10],["αὐτοῦ",3,48],["θανάτῳ",169,113],["θανατούσθω",386,344]],"Whoever smites his father or his mother, let him be