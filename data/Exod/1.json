,["ἐβδελύσσοντο",1202,131],["οἱ",1,128],["Αἰγύπτιοι",420,130],["ἀπὸ",17,1],["τῶν",1,76],["υἱῶν",13,77],["Ἰσραήλ",27,105]],"But as they humbled them, by so much they multiplied, and grew exceedingly strong; and the Egyptians greatly abhorred the children of Israel."],["13",[["Καὶ",2,8],["κατεδυνάστευον",1323,129],["οἱ",1,128],["Αἰγύπτιοι",420,130],["τοὺς",1,56],["υἱοὺς",13,31],["Ἰσραὴλ",27,105],["βίᾳ",1504,179]],"And the Egyptians tyrannised over the children of Israel by force."],["14",[["Καὶ",2,8],["κατωδύνων",3869,163],["αὐτῶν",3,41],["τὴν",1,9],["ζωὴν",212,10],["ἐν",4,1],["τοῖς",1,91],["ἔργοις",104,92],["τοῖς",1,91],["σκληροῖς",833,90],["τῷ",1,110],["πηλῷ",1386,113],["καὶ",2,8],["τῇ",1,95],["πλινθείᾳ",3939,2],["καὶ",2,8],["πᾶσι",11,90],["τοῖς",1,91],["ἔργοις",104,92],["τοῖς",1,91],["ἐν",4,1],["τοῖς",1,91],["πεδίοις",348,92],["κατὰ",32,1],["πάντα",11,65],["τὰ",1,42],["ἔργα",104,43],["ὧν",24,97],["κατεδουλοῦντο",2730,131],["αὐτοὺς",3,60],["μετὰ",29,1],["βίας",1504,19]],"And they embittered their life by hard labours, in the clay and in brick-making, and all the works in the plains, according to all the works, wherein they caused them to serve with violence."],["15",[["Καὶ",2,8],["εἶπεν",18,3],["ὁ",1,4],["βασιλεὺς",22,5],["τῶν",1,76],["Αἰγυπτίων",420,163],["ταῖς",1,70],["μαίαις",2933,71],["τῶν",1,76],["Ἐβραίων",1090,77],["τῇ",1,95],["μιᾷ",57,96],["αὐτῶν",3,41],["ὄνομα",55,33],["Σεπφώρα",0,0],["καὶ",2,8],["τὸ",1,32],["ὄνομα",55,33],["τῆς",1,18],["δευτέρας",270,78],["Φουά",0,0]],"And the king of the Egyptians spoke to the midwives of the Hebrews; the name of the one was, Sepphora; and the name of the second, Phua."],["16",[["Καὶ",2,8],["εἶπεν",18,3],["ὅταν",318,8],["μαιοῦσθε",5839,68],["τὰς",1,39],["Ἐβραίας",1090,40],["καὶ",2,8],["ὦσι",10,266],["πρὸς",15,1],["τῷ",1,110],["τίκτειν",251,54],["ἐὰν",45,8],["μὲν",281,12],["ἄρσεν",915,33],["ᾖ",10,172],["ἀποκτείνατε",298,69],["αὐτό",3,121],["ἐὰν",45,8],["δὲ",14,12],["θῆλυ",1204,29],["περιποιεῖσθε",1348,68],["αὐτό",3,121]],"And he said, When ye do the office of midwives to the Hebrew women, and they are about to be delivered, if it be a male, kill it; but if a female, save it."],["17",[["Ἐφοβήθησαν",134,94],["δὲ",14,12],["αἱ",1,183],["μαῖαι",2933,179],["τὸν",1,6],["Θεὸν",20,7],["καὶ",2,8],["οὐκ",12,17],["ἐποίησαν",23,141],["καθότι",827,17],["συνέταξεν",450,3],["αὐταῖς",3,192],["ὁ",1,4],["βασιλεὺς",22,5],["Αἰγύπτου",93,19],["καὶ",2,8],["ἐζωογόνουν",2722,129],["τὰ",1,42],["ἄρσενα",915,43]],"But the midwives feared God, and did not as the king of Egypt appointed them; and they saved the male children alive."],["18",[["Ἐκάλεσε",128,3],["δὲ",14,12],["ὁ",1,4],["βασιλεὺς",22,5],["Αἰγύπτου",93,19],["τὰς",1,39],["μαίας",2933,40],["καὶ",2,8],["εἶπεν",18,3],["αὐταῖς",3,192],["τί",39,119],["ὅτι",19,8],["ἐποιήσατε",23,262],["τὸ",1,32],["πρᾶγμα",507,33],["τοῦτο",16,122],["καὶ",2,8],["ἐζωογονεῖτε",2722,343],["τὰ",1,42],["ἄρσενα",915,43]],"And the king of Egypt called the midwives, and said to them, Why is it that ye have done this thing, and saved the male children alive?"],["19",[["Εἶπαν",18,221],["δὲ",14,12],["αἱ",1,183],["μαῖαι",2933,179],["τῷ",1,110],["Φαραῷ",183,105],["οὐχ",12,17],["ὡς",36,8],["γυναῖκες",58,179],["Αἰγύπτου",93,19],["αἱ",1,183],["Ἐβραῖαι",1090,179],["τίκτουσι",251,189],["γὰρ",40,12],["πρὶν",1227,17],["ἢ",60,8],["εἰσελθεῖν",88,100],["πρὸς",15,1],["αὐτὰς",3,220],["τὰς",1,39],["μαίας",2933,40],["καὶ",2,8],["ἔτικτον",251,129]],"And the midwives said to Pharao, The Hebrew women are not as the women of Egypt, for they are delivered before the midwives go in to them. So they bore children."],["20",[["Εὖ",975,17],["δὲ",14,12],["ἐποίει",23,14],["ὁ",1,4],["Θεὸς",20,5],["ταῖς",1,70],["μαίαις",2933,71],["καὶ",2,8],["ἐπλήθυνεν",315,14],["ὁ",1,4],["λαὸς",35,5],["καὶ",2,8],["ἴσχυε",565,14],["σφόδπα",0,0]],"And God did well to the midwives, and the people multiplied, and grew very strong."],["21",[["Ἐπεὶ",1238,8],["δὲ",14,12],["ἐφοβοῦντο",134,131],["αἱ",1,183],["μαῖαι",2933,179],["τὸν",1,6],["Θεὸν",20,7],["ἐποίησαν",23,141],["ἑαυταῖς",92,192],["οἰκίας",232,19]],"And as the midwives feared God, they established for themselves families."],["22",[["Συνέταξε",450,3],["δὲ",14,12],["Φαραὼ",183,149],["παντὶ",11,111],["τῷ",1,110],["λαῷ",35,113],["αὐτοῦ",3,48],["λέγων",31,67],["πᾶν",11,29],["ἄρσεν",915,33],["ὃ",1,4],["ἐὰν",45,8],["τεχθῇ",251,337],["τοῖς",1,138],["Ἑβραίοις",1090,139],["εἰς",8,1],["τὸν",1,6],["ποταμὸν",249,7],["ῥίψατε",694,69],["καὶ",2,8],["πᾶν",11,29],["θῆλυ",1204,29],["ζωογονεῖτε",2722,84],["αὐτό",3,121]],"And Pharao charged all his people, saying, Whatever male [child] shall be born to the Hebrews, cast into the river; and every female, save it alive."]]