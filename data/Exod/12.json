],["προφυλακὴ",2481,13],["Κυρίῳ",7,113],["ὥστε",346,17],["πᾶσι",11,215],["τοῖς",1,138],["υἱοῖς",13,139],["Ἰσραὴλ",27,105],["εἶναι",10,54],["εἰς",8,1],["γενεὰς",286,40],["αὐτῶν",3,41]],"It is a watch kept to the Lord, so that he should bring them out of the land of Egypt; that very night is a watch kept to the Lord, so that it should be to all the children of Israel to their generations."],["43",[["Εἶπε",18,3],["δὲ",14,12],["Κύριος",7,5],["πρὸς",15,1],["Μωυσῆν",69,7],["καὶ",2,8],["Ἀαρὼν",159,5],["οὗτος",16,112],["ὁ",1,4],["νόμος",140,5],["τοῦ",1,30],["πάσχα",1096,238],["πᾶς",11,16],["ἀλλογενὴς",1066,16],["οὐκ",12,17],["ἔδεται",147,89],["ἀπʼ",17,1],["αὐτοῦ",3,48]],"And the Lord said to Moses and Aaron, This is the law of the passover: no stranger shall eat of it."],["44",[["Καὶ",2,8],["πάντα",11,59],["οἰκέτην",951,7],["ἢ",61,8],["ἀργυρώνητον",3709,59],["περιτεμεῖς",1222,159],["αὐτόν",3,82],["καὶ",2,8],["τότε",250,17],["φάγεται",269,89],["ἀπʼ",17,1],["αὐτοῦ",3,48]],"And every slave or servant bought with money—him thou shalt circumcise, and then shall he eat of it."],["45",[["Πάροικος",1421,16],["ἢ",61,8],["μισθωτὸς",1826,5],["οὐκ",12,17],["ἔδεται",147,89],["ἀπʼ",17,1],["αὐτοῦ",3,48]],"A sojourner or hireling shall not eat of it."],["46",[["Ἐν",4,1],["οἰκίᾳ",233,2],["μιᾷ",58,96],["βρωθήσεται",1111,125],["καὶ",2,8],["οὐκ",12,17],["ἐξοίσετε",624,348],["ἐκ",21,1],["τῆς",1,18],["οἰκίας",233,19],["τῶν",1,44],["κρεῶν",629,45],["ἔξω",527,17],["καὶ",2,8],["ὀστοῦν",473,20],["οὐ",12,17],["συντρίψετε",268,348],["ἀπʼ",17,1],["αὐτοῦ",3,48]],"In one house shall it be eaten, and ye shall not carry of the flesh out from the house; and a bone of it ye shall not break."],["47",[["Πᾶσα",11,15],["συναγωγὴ",284,13],["υἱῶν",13,77],["Ἰσραὴλ",27,105],["ποιήσει",23,120],["αὐτό",3,121]],"All the congregation of the children of Israel shall keep it."],["48",[["Ἐὰν",45,8],["δέ",14,12],["τις",39,150],["προσέλθῃ",529,160],["πρὸς",15,1],["ὑμᾶς",5,209],["προσήλυτος",634,5],["ποιῆσαι",23,100],["τὸ",1,32],["πάσχα",1096,119],["Κυρίῳ",7,113],["περιτεμεῖς",1222,159],["αὐτοῦ",3,48],["πᾶν",11,29],["ἀρσενικόν",848,29],["καὶ",2,8],["τότε",250,17],["προσελεύσεται",529,89],["ποιῆσαι",23,100],["αὐτό",3,121],["καὶ",2,8],["ἔσται",10,89],["ὥσπερ",226,17],["καὶ",2,8],["ὁ",1,4],["αὐτόχθων",2248,5],["τῆς",1,18],["γῆς",26,19],["πᾶς",11,16],["ἀπερίτμητος",1313,16],["οὐκ",12,17],["ἔδεται",147,89],["ἀπʼ",17,1],["αὐτοῦ",3,48]],"And if any proselyte shall come to you to keep the passover to the Lord, thou shalt circumcise every male of him, and then shall he approach to sacrifice it, and he shall be even as the original inhabitant of the land; no uncircumcised person shall eat of it."],["49",[["Νόμος",140,5],["εἷς",58,16],["ἔσται",10,89],["τῷ",1,110],["ἐγχωρίῳ",3182,111],["καὶ",2,8],["τῷ",1,110],["προσελθόντι",529,354],["προσηλύτῳ",634,113],["ἐν",4,1],["ὑμῖν",5,86]],"There shall be one law to the native, and to the proselyte coming among you."],["50",[["Καὶ",2,8],["ἐποίησαν",23,141],["οἱ",1,128],["υἱοὶ",13,51],["Ἰσραὴλ",27,105],["καθὰ",520,17],["ἐνετείλατο",143,26],["Κύριος",7,5],["τῷ",1,110],["Μωυσῇ",69,113],["καὶ",2,8],["Ἀαρὼν",159,5],["πρὸς",15,1],["αὐτούς",3,60],["οὕτως",71,17],["ἐποίησαν",23,141]],"And the children of Israel did as the Lord commanded Moses and Aaron for them, so they did."],["51",[["Καὶ",2,8],["ἐγένετο",30,26],["ἐν",4,1],["τῇ",1,95],["ἡμέρᾳ",28,2],["ἐκείνῃ",80,99],["ἐξήγαγε",295,3],["Κύριος",7,5],["τοὺς",1,56],["υἱοὺς",13,31],["Ἰσραὴλ",27,105],["ἐκ",21,1],["γῆς",26,19],["Αἰγύπτου",93,19],["σὺν",310,1],["δυνάμει",98,2],["αὐτῶν",3,41]],"And it came to pass in that day that the Lord brought out the children of Israel from the land of Egypt with their forces."]]