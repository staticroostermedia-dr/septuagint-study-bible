[["1",[["Εἶπε",18,3],["δὲ",14,12],["Κύριος",7,5],["πρὸς",15,1],["Μευσῆν",0,0],["καὶ",2,8],["Ἀαρὼν",159,5],["ἐν",4,1],["γῇ",26,2],["Αἰγύπτου",93,19],["λέγων",31,67]],"And the Lord spoke to Moses and Aaron in the land of Egypt, saying,"],["2",[["ὁ",1,4],["μὴν",296,12],["οὗτος",16,112],["ὑμῖν",5,86],["ἀρχὴ",270,13],["μηνῶν",386,77],["πρῶτός",315,16],["ἐστιν",10,87],["ὑμῖν",5,86],["ἐν",4,1],["τοῖς",1,138],["μησὶ",386,139],["τοῦ",1,30],["ἐνιαυτοῦ",400,21]],"This month [shall be] to you the beginning of months: it is the first to you among the months of the year."],["3",[["Λάλησον",50,198],["πρὸς",15,1],["πᾶσαν",11,37],["συναγωγὴν",284,10],["υἱῶν",13,77],["Ἰσραὴλ",27,105],["λέγων",31,67],["τῇ",1,95],["δεκάτῃ",546,96],["τοῦ",1,30],["μηνὸς",386,21],["τούτου",16,126],["λαβέτωσαν",46,261],["ἕκαστος",171,16],["πρόβατον",194,33],["κατʼ",32,1],["οἴκους",34,31],["πατριῶν",338,61],["ἕκαστος",171,16],["πρόβατον",194,33],["κατʼ",32,1],["οἰκίαν",233,10]],"Speak to all the congregation of the children of Israel, saying, On the tenth of this month let them take each man a lamb according to the houses of their families, every man a lamb for his household."],["4",[["Ἐὰν",45,8],["δὲ",14,12],["ὀλιγοστοὶ",1999,130],["ὦσιν",10,265],["ἐν",4,1],["τῇ",1,95],["οἰκίᾳ",233,2],["ὥστε",346,17],["μὴ",25,8],["εἶναι",10,54],["ἱκανοὺς",1007,58],["εἰς",8,1],["πρόβατον",194,33],["συλλήψεται",507,89],["μεθʼ",29,1],["ἑαυτοῦ",92,48],["τὸν",1,6],["γείτονα",2072,7],["τὸν",1,6],["πλησίον",292,17],["αὐτοῦ",3,48],["κατὰ",32,1],["ἀριθμὸν",355,7],["ψυχῶν",63,61],["ἕκαστος",171,16],["τὸ",1,32],["ἀρκοῦν",2662,47],["αὐτῷ",3,49],["συναριθμήσεται",8401,89],["εἰς",8,1],["πρόβατον",194,33]],"And if they be few in a household, so that there are not enough for the lamb, he shall take with himself his neighbour that lives near to him,—as to the number of souls, every one according to that which suffices him shall make a reckoning for the lamb."],["5",[["Πρόβατον",194,33],["τέλειον",1919,29],["ἄρσεν",914,33],["ἐνιαύσιον",902,