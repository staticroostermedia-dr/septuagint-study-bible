[["1",[["Οὐ",12,17],["παραδέξῃ",4360,116],["ἀκοὴν",1045,10],["ματαίαν",648,37],["οὐ",12,17],["συγκαταθήσῃ",5082,116],["μετὰ",29,1],["τοῦ",1,30],["ἀδίκου",402,153],["γενέσθαι",30,103],["μάρτυς",876,5],["ἄδικος",402,16]],"Thou shalt not receive a vain report: thou shalt not agree with the unjust [man] to become an unjust witness."],["2",[["Οὐκ",12,17],["ἔσῃ",10,116],["μετὰ",29,1],["πλειόνων",938,79],["ἐπὶ",9,1],["κακίᾳ",431,2],["οὐ",12,17],["προστεθήσῃ",200,379],["μετὰ",29,1],["πλήθους",199,24],["ἐκκλῖναι",393,100],["μετὰ",29,1],["τῶν",1,44],["πλειόνων",938,79],["ὥστε",345,17],["ἑκκλεῖσαι",0,0],["κρίσιν",226,10]],"Thou shalt not associate with the multitude for evil; thou shalt not join thyself with a multitude to turn aside with the majority so as to shut out judgment."],["3",[["Καὶ",2,8],["πένητα",668,7],["οὐκ",12,17],["ἐλεήσεις",457,159],["ἐν",4,1],["κρίσει",226,2]],"And thou shalt not spare a poor man in judgment."],["4",[["Ἐὰν",45,8],["δὲ",14,12],["συναντήσῃς",426,170],["τῷ",1,110],["βοῒ",408,113],["τοῦ",1,30],["ἐχθροῦ",135,21],["σου",5,146],["ἢ",60,8],["τῷ",1,52],["ὑποζυγίῳ",1809,53],["αὐτοῦ",3,48],["πλανωμένοις",464,346],["ἀποστρέψας",130,155],["ἀποδώσεις",311,159],["αὐτῷ",3,49]],"And if thou meet thine enemy's ox or his ass going astray, thou shalt turn them back and restore them to him."],["5",[["Ἐὰν",45,8],["δὲ",14,12],["ἴδῃς",73,170],["τὸ",1,32],["ὑποζύγιον",1809,33],["τοῦ",1,30],["ἐχθροῦ",135,21],["σου",5,146],["πεπτωκὸς",154,421],["ὑπὸ",122,1],["τὸν",1,6],["γόμον",5558,7],["αὐτοῦ",3,48],["οὐ",12,17],["παρελεύσῃ",410,116],["αὐτὸ",3,121],["ἀλλὰ",107,17],["συναρεῖς",8464,159],["αὐτὸ",3,121],["μετʼ",29,1],["αὐτοῦ",3,48]],"And if thou see thine enemy's ass fallen under its burden, thou shalt not pass by it, but shalt help to raise it with him."],["6",[["Οὐ",12,17],["διαστρέψεις",1322,159],["κρίμα",266,33],["πένητος",668,21],["ἐν",4,1],["κρίσει",226,2],["αὐτοῦ",3,48]],"Thou shalt not wrest the sentence of the poor in his judgment."],["7",[["Ἀπὸ",17,1],["παντὸς"