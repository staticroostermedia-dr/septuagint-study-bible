ῷ",255,49],["σκέψαι",5044,379],["ἀπὸ",17,1],["παντὸς",11,153],["τοῦ",1,30],["λαοῦ",35,21],["ἄνδρας",38,31],["δυνατοὺς",356,58],["θεοσεβεῖς",3272,58],["ἄνδρας",38,31],["δικαίους",153,58],["μισοῦντας",351,229],["ὑπερηφανίαν",1131,10],["καὶ",2,8],["καταστήσεις",314,159],["ἐπʼ",9,1],["αὐτῶν",3,41],["χιλιάρχους",1452,31],["καὶ",2,8],["ἑκατοντάρχους",1710,31],["καὶ",2,8],["πεντηκοντάρχους",2476,31],["καὶ",2,8],["δεκαδάρχους",5537,31]],"And do thou look out for thyself out of all the people able men, fearing God, righteous men, hating pride, and thou shalt set over the people captains of thousands and captains of hundreds, and captains of fifties, and captains of tens."],["22",[["Καὶ",2,8],["κρινοῦσι",263,207],["τὸν",1,6],["λαὸν",35,7],["πᾶσαν",11,37],["ὥραν",838,10],["τὸ",1,32],["δὲ",14,12],["ῥῆμα",116,33],["τὸ",1,32],["ὑπέρογκον",3773,29],["ἀνοίσουσιν",384,207],["ἐπὶ",9,1],["σὲ",5,161],["τὰ",1,42],["δὲ",14,12],["βραχέα",618,65],["τῶν",1,44],["κριμάτων",267,45],["κρινοῦσιν",263,207],["αὐτοί",3,195],["καὶ",2,8],["κουφιοῦσιν",2591,207],["ἀπὸ",17,1],["σοῦ",5,146],["καὶ",2,8],["συναντιλήψονταί",4410,127],["σοι",5,151]],"And they shall judge the people at all times, and the too burdensome matter they shall bring to thee, but they shall judge the smaller cases; so they shall relieve thee and help thee."],["23",[["Ἐὰν",45,8],["τὸ",1,32],["ῥῆμα",116,33],["τοῦτο",16,122],["ποιήσῃς",23,170],["κατισχύσει",628,120],["σε",5,161],["ὁ",1,4],["Θεὸς",20,5],["καὶ",2,8],["δυνήσῃ",185,116],["παραστῆναι",595,100],["καὶ",2,8],["πᾶς",11,16],["ὁ",1,4],["λαὸς",35,5],["οὗτος",16,112],["εἰς",8,1],["τὸν",1,6],["ἑαυτοῦ",92,48],["τόπον",99,7],["μετʼ",29,1],["εἰρήνης",213,19],["ἥξει",260,120]],"If thou wilt do this thing, God shall strengthen thee, and thou shalt be able to attend, and all this people shall come with peace into their own place."],["24",[["Ἤκουσε",54,3],["δὲ",14,12],["Μωυσῆς",69,5],["τῆς",1,18],["φωνῆς",95,19],["τοῦ",1,30],["γαμβροῦ",1543,21],["καὶ",2,8],["ἐποίησεν",23,3],["ὅσα",103,63],["εἶπεν",18,3],["αὐτῷ",3,49]],"And Moses hearkened to the voice of his father-in-law, and did whatsoever he said to him."],["25",[["Καὶ",2,8],["ἐπέλεξε",1657,3],["Μωυσῆς",69,5],["ἄνδρας",38,31],["δυνατοὺς",356,58],["ἀπὸ",17,1],["παντὸς",11,153],["Ἰσραὴλ",27,105],["καὶ",2,8],["ἐποίησεν",23,3],["αὐτοὺς",3,60],["ἐπʼ",9,1],["αὐτῶν",3,41],["χιλιάρχους",1452,31],["καὶ",2,8],["ἑκατοντάρχους",1710,31],["καὶ",2,8],["πεντηκοντάρχους",2476,31],["καὶ",2,8],["δεκαδάρχους",5537,31]],"And Moses chose out able men out of all Israel, and he made them captains of thousands and captains of hundreds, and captains of fifties and captains of tens over the people."],["26",[["Καὶ",2,8],["ἐκρίνοσαν",0,0],["τὸν",1,6],["λαὸν",35,7],["πᾶσαν",11,37],["ὥραν",838,10],["πᾶν",11,29],["δὲ",14,12],["ῥῆμα",116,33],["ὑπέρογκον",3773,29],["ἀνεφέροσαν",384,129],["ἐπὶ",9,1],["Μωυσῆν",69,7],["πᾶν",11,59],["δὲ",14,12],["ῥῆμα",116,33],["ἐλαφρὸν",4081,29],["ἐκρίνοσαν",0,0],["αὐτοί",3,195]],"And they judged the people at all times; and every too burdensome matter they brought to Moses, but every light matter they judged themselves."],["27",[["Ἐξαπέστειλε",220,3],["δὲ",14,12],["Μωυσῆς",69,5],["τὸν",1,6],["ἑαυτοῦ",92,48],["γαμβρὸν",1543,7],["καὶ",2,8],["ἀπῆλθεν",297,3],["εἰς",8,1],["τὴν",1,9],["γῆν",26,10],["αὐτοῦ",3,48]],"And Moses dismissed his father-in-law, and he returned to his own land."]]