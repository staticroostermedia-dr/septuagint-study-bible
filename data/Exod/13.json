",8,1],["σημεῖον",502,33],["ἐπὶ",9,1],["τῆς",1,18],["χειρός",37,19],["σου",5,146],["καὶ",2,8],["ἀσαλευτον",5274,28],["πρὸ",235,1],["ὀφθαλμων",91,77],["σου",5,146],["ἐν",4,1],["γὰρ",40,12],["χειρὶ",37,2],["κραταιᾷ",862,96],["ἐξήγαγέ",299,3],["σε",5,161],["Κύριος",7,5],["ἐξ",21,1],["Αἰγύπτου",93,19]],"And it shall be for a sign upon thy hand, and immovable before thine eyes, for with a strong hand the Lord brought thee out of Egypt."],["17",[["Ὡς",36,8],["δὲ",14,12],["ἐξαπέστειλε",217,3],["Φαραὼ",183,149],["τὸν",1,6],["λαὸν",35,7],["οὐχ",12,17],["ὡδήγησεν",1110,3],["αὐτοὺς",3,60],["ὁ",1,4],["Θεὸς",20,5],["ὁδὸν",67,10],["γῆς",26,19],["Φυλιστιεὶμ",0,0],["ὅτι",19,8],["ἐγγὺς",1022,17],["ἦν",10,14],["εἶπε",18,3],["γὰρ",40,12],["ὁ",1,4],["Θεὸς",20,5],["μήποτε",966,17],["μεταμελήσῃ",4929,116],["τῷ",1,110],["λαῷ",35,113],["ἰδόντι",276,359],["πόλεμον",163,7],["καὶ",2,8],["ἀποστρέψῃ",130,116],["εἰς",8,1],["Αἴγυπτον",93,10]],"And when Pharao sent forth the people, God led them not by the way of the land of the Phylistines, because it was near; for God said, Lest at any time the people repent when they see war, and return to Egypt."],["18",[["Καὶ",2,8],["ἐκύκλωσεν",600,3],["ὁ",1,4],["Θεὸς",20,5],["τὸν",1,6],["λαὸν",35,7],["ὁδὸν",67,10],["τὴν",1,9],["εἰς",8,1],["τὴν",1,9],["ἔρημον",160,37],["εἰς",8,1],["τὴν",1,9],["ἐρυθρὰν",1495,37],["θάλασσαν",137,10],["πέμπτῃ",845,96],["δὲ",14,12],["γενεᾷ",286,2],["ἀνέβησαν",87,141],["οἱ",1,128],["υἱοὶ",13,51],["Ἰσραὴλ",27,105],["ἐκ",21,1],["γῆς",26,19],["Αἰγύπτου",93,19]],"And God led the people round by the way to the wilderness, to the Red Sea: and in the fifth generation the children of Israel went up out of the land of Egypt."],["19",[["Καὶ",2,8],["ἔλαβε",46,3],["Μωυσῆς",68,5],["τὰ",1,42],["ὀστᾶ",472,43],["Ἰωσὴφ",262,105],["μεθʼ",29,1],["ἑαυτοῦ",92,48],["ὅρκῳ",947,113],["γὰρ",40,12],["ὥρκισεν",1578,3],["τοὺς",1,56],["υἱοὺς",13,31],["Ἰσραὴλ",27,105],["λέγων",31,67],["ἐπισκοπῇ",1108,2],["ἐπισκέψεται",429,399],["ὑμᾶς",5,209],["Κύριος",7,5],["κ