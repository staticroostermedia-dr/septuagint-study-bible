υ",1599,21],["τὴν",1,9],["ἑαυτῶν",92,41],["σωτηρίαν",425,10],["κατεργάζεσθε",3067,742]],"So then, my beloved, even as you have always obeyed, not only in my presence, but now much more in my absence, work out your own salvation with fear and trembling."],["13",[["θεὸς",20,5],["γάρ",40,8],["ἐστιν",10,87],["ὁ",1,4],["ἐνεργῶν",3432,67],["ἐν",4,1],["ὑμῖν",5,86],["καὶ",2,8],["τὸ",1,32],["θέλειν",612,54],["καὶ",2,8],["τὸ",1,32],["ἐνεργεῖν",3432,54],["ὑπὲρ",139,1],["τῆς",1,18],["εὐδοκίας",1625,19]],"For it is God who works in you both to will and to work for his good pleasure."],["14",[["πάντα",11,65],["ποιεῖτε",23,307],["χωρὶς",2046,1],["γογγυσμῶν",2568,77],["καὶ",2,8],["διαλογισμῶν",1584,77]],"Do all things without complaining and arguing,"],["15",[["ἵνα",102,8],["γένησθε",30,746],["ἄμεμπτοι",2134,130],["καὶ",2,8],["ἀκέραιοι",8797,130],["τέκνα",192,63],["θεοῦ",20,21],["ἄμωμα",637,74],["μέσον",113,29],["γενεᾶς",286,19],["σκολιᾶς",1690,78],["καὶ",2,8],["διεστραμμένης",1322,931],["ἐν",4,1],["οἷς",24,292],["φαίνεσθε",832,68],["ὡς",36,12],["φωστῆρες",3380,51],["ἐν",4,1],["κόσμῳ",743,113]],"that you may become blameless and harmless, children of God without defect in the middle of a crooked and perverse generation, among whom you are seen as lights in the world,"],["16",[["λόγον",48,7],["ζωῆς",216,19],["ἐπέχοντες",3009,137],["εἰς",8,1],["καύχημα",1627,33],["ἐμοὶ",6,151],["εἰς",8,1],["ἡμέραν",28,10],["Χριστοῦ",1072,21],["ὅτι",19,8],["οὐκ",12,12],["εἰς",8,1],["κενὸν",780,29],["ἔδραμον",820,147],["οὐδὲ",106,8],["εἰς",8,1],["κενὸν",780,29],["ἐκοπίασα",921,147]],"holding up the word of life, that I may have something to boast in the day of Christ that I didn’t run in vain nor labor in vain."],["17",[["ἀλλ᾽",108,8],["εἰ",77,8],["καὶ",2,8],["σπένδομαι",1787,572],["ἐπὶ",9,1],["τῇ",1,95],["θυσίᾳ",156,2],["καὶ",2,8],["λειτουργίᾳ",1141,2],["τῆς",1,18],["πίστεως",887,19],["ὑμῶν",5,136],["χαίρω",698,149],["καὶ",2,8],["συγχαίρω",6089,149],["πᾶσιν",11,215],["ὑμῖν",5,86]],"Yes, and if I am poured out on the sacrifice and service of your faith, I am glad and rejoice with you all."],["18",[["τὸ",1,32],["δὲ",14,8],["αὐτὸ",3,121],["καὶ",2,8],["ὑμεῖς",5,208],["χαίρετε",698,307],["καὶ",2,8],["συγχαίρετέ",6089,307],["μοι",9994,151]],"In the same way, you also should be glad and rejoice with me."],["19",[["Ἐλπίζω",514,149],["δὲ",14,8],["ἐν",4,1],["κυρίῳ",7,113],["Ἰησοῦ",211,113],["Τιμόθεον",1953,7],["ταχέως",1563,17],["πέμψαι",1597,100],["ὑμῖν",5,86],["ἵνα",102,8],["κἀγὼ",10000,8],["εὐψυχῶ",11114,592],["γνοὺς",79,155],["τὰ",1,42],["περὶ",72,1],["ὑμῶν",5,136]],"But I hope in the Lord Jesus to send Timothy to you soon, that I also may be cheered up when I know how you are doing."],["20",[["οὐδένα",228,59],["γὰρ",40,8],["ἔχω",124,149],["ἰσόψυχον",9747,59],["ὅστις",457,246],["γνησίως",5517,17],["τὰ",1,42],["περὶ",72,1],["ὑμῶν",5,136],["μεριμνήσει",2600,120]],"For I have no one else like-minded, who will truly care about you."],["21",[["οἱ",1,128],["πάντες",11,130],["γὰρ",40,8],["τὰ",1,42],["ἑαυτῶν",92,41],["ζητοῦσιν",191,191],["οὐ",12,12],["τὰ",1,42],["Ἰησοῦ",211,21],["Χριστοῦ",1072,21]],"For they all seek their own, not the things of Jesus Christ."],["22",[["τὴν",1,9],["δὲ",14,8],["δοκιμὴν",10846,10],["αὐτοῦ",3,48],["γινώσκετε",79,84],["ὅτι",19,8],["ὡς",36,12],["πατρὶ",44,113],["τέκνον",192,20],["σὺν",310,1],["ἐμοὶ",6,151],["ἐδούλευσεν",398,3],["εἰς",8,1],["τὸ",1,32],["εὐαγγέλιον",4222,33]],"But you know that he has proved himself. As a child serves a father, so he served with me in furtherance of the Good News."],["23",[["τοῦτον",16,259],["μὲν",281,12],["οὖν",227,8],["ἐλπίζω",514,149],["πέμψαι",1597,100],["ὡς",36,12],["ἂν",83,12],["ἀφίδω",6359,227],["τὰ",1,42],["περὶ",72,1],["ἐμὲ",6,161],["ἐξαυτῆς",10238,17]],"Therefore I hope to send him at once, as soon as I see how it will go with me."],["24",[["πέποιθα",344,85],["δὲ",14,8],["ἐν",4,1],["κυρίῳ",7,113],["ὅτι",19,8],["καὶ",2,8],["αὐτὸς",3,158],["ταχέως",1563,17],["ἐλεύσομαι",55,775]],"But I trust in the Lord that I myself also will come shortly."],["25",[["Ἀναγκαῖον",4500,28],["δὲ",14,8],["ἡγησάμην",378,820],["Ἐπαφρόδιτον",11115,7],["τὸν",1,6],["ἀδελφὸν",67,7],["καὶ",2,8],["συνεργὸν",6116,59],["καὶ",2,8],["συστρατιώτην",11116,7],["μου",9994,146],["ὑμῶν",5,136],["δὲ",14,8],["ἀπόστολον",10080,7],["καὶ",2,8],["λειτουργὸν",2736,7],["τῆς",1,18],["χρείας",1006,19],["μου",9994,146],["πέμψαι",1597,100],["πρὸς",15,1],["ὑμᾶς",5,209]],"But I thought it necessary to send to you Epaphroditus, my brother, fellow worker, fellow soldier, and your apostle and servant of my need,"],["26",[["ἐπειδὴ",1995,8],["ἐπιποθῶν",2537,67],["ἦν",10,14],["πάντας",11,58],["ὑμᾶς",5,209],["καὶ",2,8],["ἀδημονῶν",10190,67],["διότι",177,8],["ἠκούσατε",54,262],["ὅτι",19,8],["ἠσθένησεν",771,3]],"since he longed for you all, and was very troubled because you had heard that he was sick."],["27",[["καὶ",2,8],["γὰρ",40,8],["ἠσθένησεν",771,3],["παραπλήσιον",11117,29],["θανάτῳ",170,113],["ἀλλ᾽",108,8],["ὁ",1,4],["θεὸς",20,5],["ἠλέησεν",10027,3],["αὐτόν",3,82],["οὐκ",12,12],["αὐτὸν",3,82],["δὲ",14,8],["μόνον",302,59],["ἀλλὰ",108,8],["καὶ",2,8],["ἐμέ",6,161],["ἵνα",102,8],["μὴ",25,12],["λύπην",1075,10],["ἐπὶ",9,1],["λύπην",1075,10],["σχῶ",124,227]],"For indeed he was sick nearly to death, but God had mercy on him, and not on him only, but on me also, that I might not have sorrow on sorrow."],["28",[["σπουδαιοτέρως",11118,17],["οὖν",227,8],["ἔπεμψα",1597,147],["αὐτόν",3,82],["ἵνα",102,8],["ἰδόντες",53,190],["αὐτὸν",3,82],["πάλιν",655,17],["χαρῆτε",698,851],["κἀγὼ",10000,8],["ἀλυπότερος",11119,16],["ὦ",10,592]],"I have sent him therefore the more diligently, that when you see him again, you may rejoice, and that I may be the less sorrowful."],["29",[["προσδέχεσθε",1019,742],["οὖν",227,8],["αὐτὸν",3,82],["ἐν",4,1],["κυρίῳ",7,113],["μετὰ",29,1],["πάσης",11,78],["χαρᾶς",1125,19],["καὶ",2,8],["τοὺς",1,56],["τοιούτους",630,274],["ἐντίμους",1339,58],["ἔχετε",124,307]],"Receive him therefore in the Lord with all joy, and hold such people in honor,"],["30",[["ὅτι",19,8],["διὰ",56,1],["τὸ",1,32],["ἔργον",105,33],["Χριστοῦ",1072,21],["μέχρι",781,1],["θανάτου",170,21],["ἤγγισεν",455,3],["παραβολευσάμενος",11120,770],["τῇ",1,95],["ψυχῇ",63,2],["ἵνα",102,8],["ἀναπληρώσῃ",2308,160],["τὸ",1,32],["ὑμῶν",5,136],["ὑστέρημα",3774,33],["τῆς",1,18],["πρός",15,1],["με",9994,161],["λειτουργίας",1141,19]],"because for the work of Christ he came near to death, risking his life to supply that which was lacking in your service toward me."]]