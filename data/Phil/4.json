[["1",[["Ὥστε",346,8],["ἀδελφοί",67,396],["μου",9994,146],["ἀγαπητοὶ",1920,537],["καὶ",2,8],["ἐπιπόθητοι",11128,537],["χαρὰ",1125,356],["καὶ",2,8],["στέφανός",980,250],["μου",9994,146],["οὕτως",9989,17],["στήκετε",6083,307],["ἐν",4,1],["κυρίῳ",7,113],["ἀγαπητοί",1920,537]],"Therefore, my brothers, beloved and longed for, my joy and crown, stand firm in the Lord in this way, my beloved."],["2",[["Εὐοδίαν",3233,10],["παρακαλῶ",434,149],["καὶ",2,8],["Συντύχην",11129,10],["παρακαλῶ",434,149],["τὸ",1,32],["αὐτὸ",3,121],["φρονεῖν",2297,54],["ἐν",4,1],["κυρίῳ",7,113]],"I exhort Euodia, and I exhort Syntyche, to think the same way in the Lord."],["3",[["ναὶ",3597,12],["ἐρωτῶ",822,149],["καὶ",2,8],["σέ",5,161],["γνήσιε",5519,309],["σύζυγε",11130,309],["συλλαμβάνου",507,493],["αὐταῖς",3,194],["αἵτινες",457,553],["ἐν",4,1],["τῷ",1,52],["εὐαγγελίῳ",4222,53],["συνήθλησάν",11108,141],["μοι",9994,151],["μετὰ",29,1],["καὶ",2,8],["Κλήμεντος",11131,21],["καὶ",2,8],["τῶν",1,76],["λοιπῶν",523,163],["συνεργῶν",6116,163],["μου",9994,146],["ὧν",24,303],["τὰ",1,253],["ὀνόματα",57,63],["ἐν",4,1],["βίβλῳ",1465,2],["ζωῆς",216,19]],"Yes, I beg you also, true partner, help these women, for they labored with me in the Good News with Clement also, and the rest of my fellow workers, whose names are in the book of life."],["4",[["Χαίρετε",698,307],["ἐν",4,1],["κυρίῳ",7,113],["πάντοτε",6027,17],["πάλιν",655,17],["ἐρῶ",10054,157],["χαίρετε",698,307]],"Rejoice in the Lord always! Again I will say, “Rejoice!”"],["5",[["τὸ",1,27],["ἐπιεικὲς",3741,28],["ὑμῶν",5,136],["γνωσθήτω",79,25],["πᾶσιν",11,215],["ἀνθρώποις",43,139],["ὁ",1,4],["κύριος",7,5],["ἐγγύς",1026,1]],"Let your gentleness be known to all men. The Lord is at hand."],["6",[["μηδὲν",908,29],["μεριμνᾶτε",2600,307],["ἀλλ᾽",108,8],["ἐν",4,1],["παντὶ",11,34],["τῇ",1,95],["προσευχῇ",550,2],["καὶ",2,8],["τῇ",1,95],["δεήσει",677,2],["μετὰ",29,1],["εὐχαριστίας",4230,19],["τὰ",1,253],["αἰτήματα",2247,63],["ὑμῶν",5,136],["γνωριζέσθω",748,878],["πρὸς",15,1],["τὸν",1,6],["θεόν",20,7]],"In nothing be anxious, but in everything, by prayer and petition with thanksgiving, let your requests be made known to God."],["7",[["καὶ",2,8],["ἡ",1,11],["εἰρήνη",213,13],["τοῦ",1,30],["θεοῦ",20,21],["ἡ",1,11],["ὑπερέχουσα",2555,183],["πάντα",11,59],["νοῦν",1442,7],["φρουρήσει",3665,120],["τὰς",1,39],["καρδίας",64,40],["ὑμῶν",5,136],["καὶ",2,8],["τὰ",1,42],["νοήματα",5867,43],["ὑμῶν",5,136],["ἐν",4,1],["Χριστῷ",1072,113],["Ἰησοῦ",211,113]],"And the peace of God, which surpasses all understanding, will guard your hearts and your thoughts in Christ Jesus."],["8",[["Τὸ",1,32],["λοιπόν",2461,29],["ἀδελφοί",67,396],["ὅσα",103,778],["ἐστὶν",10,87],["ἀληθῆ",1923,74],["ὅσα",103,778],["σεμνά",2764,74],["ὅσα",103,778],["δίκαια",153,74],["ὅσα",103,778],["ἁγνά",2814,74],["ὅσα",103,778],["προσφιλῆ",5014,74],["ὅσα",103,778],["εὔφημα",11132,74],["εἴ",77,8],["τις",39,368],["ἀρετὴ",1398,13],["καὶ",2,8],["εἴ",77,8],["τις",39,150],["ἔπαινος",2840,5],["ταῦτα",16,248],["λογίζεσθε",495,742]],"Finally, brothers, whatever things are true, whatever things are honorable, whatever things are just, whatever things are pure, whatever things are lovely, whatever things are of good report: if there is any virtue and if there is anything worthy of praise, think about these things."],["9",[["ἃ",24,755],["καὶ",2,8],["ἐμάθετε",923,262],["καὶ",2,8],["παρελάβετε",1385,262],["καὶ",2,8],["ἠκούσατε",54,262],["καὶ",2,8],["εἴδετε",53,262],["ἐν",4,1],["ἐμοί",6,151],["ταῦτα",16,248],["πράσσετε",1251,307],["καὶ",2,8],["ὁ",1,4],["θεὸς",20,5],["τῆς",1,18],["εἰρήνης",213,19],["ἔσται",10,718],["μεθ᾽",29,1],["ὑμῶν",5,136]],"Do the things which you learned, received, heard, and saw in me, and the God of peace will be with you."],["10",[["Ἐχάρην",698,921],["δὲ",14,8],["ἐν",4,1],["κυρίῳ",7,113],["μεγάλως",11133,17],["ὅτι",19,8],["ἤδη",916,17],["ποτὲ",458,12],["ἀνεθάλετε",2980,262],["τὸ",1,32],["ὑπὲρ",139,1],["ἐμοῦ",6,88],["φρονεῖν",2297,54],["ἐφ᾽",9,1],["ᾧ",24,410],["καὶ",2,8],["ἐφρονεῖτε",2297,339],["ἠκαιρεῖσθε",11134,832],["δέ",14,8]],"But I rejoice in the Lord greatly that now at length you have revived your thought for me; in which you did indeed take thought, but you lacked opportunity."],["11",[["οὐχ",12,12],["ὅτι",19,8],["καθ᾽",32,1],["ὑστέρησιν",10265,10],["λέγω",31,149],["ἐγὼ",6,156],["γὰρ",40,8],["ἔμαθον",923,147],["ἐν",4,1],["οἷς",24,337],["εἰμι",10,149],["αὐτάρκης",3788,16],["εἶναι",10135,54]],"Not that I speak because of lack, for I have learned in whatever state I am, to be content in it."],["12",[["οἶδα",10044,149],["καὶ",2,8],["ταπεινοῦσθαι",322,634],["οἶδα",10044,149],["καὶ",2,8],["περισσεύειν",3112,54],["ἐν",4,1],["παντὶ",11,34],["καὶ",2,8],["ἐν",4,1],["πᾶσιν",11,90],["μεμύημαι",7723,880],["καὶ",2,8],["χορτάζεσθαι",2397,634],["καὶ",2,8],["πεινᾶν",1045,54],["καὶ",2,8],["περισσεύειν",3112,54],["καὶ",2,8],["ὑστερεῖσθαι",1947,634]],"I know how to be humbled, and I also know how to abound. In any and all circumstances I have learned the secret both to be filled and to be hungry, both to abound and to be in need."],["13",[["πάντα",11,65],["ἰσχύω",567,149],["ἐν",4,1],["τῷ",1,110],["ἐνδυναμοῦντί",9400,390],["με",9994,161]],"I can do all things through Christ who strengthens me."],["14",[["πλὴν",257,8],["καλῶς",1273,17],["ἐποιήσατε",23,262],["συγκοινωνήσαντές",11097,190],["μου",9994,146],["τῇ",1,95],["θλίψει",438,2]],"However you did well that you shared in my affliction."],["15",[["οἴδατε",10044,330],["δὲ",14,8],["καὶ",2,8],["ὑμεῖς",5,208],["Φιλιππήσιοι",11135,396],["ὅτι",19,8],["ἐν",4,1],["ἀρχῇ",270,2],["τοῦ",1,23],["εὐαγγελίου",4222,24],["ὅτε",432,1],["ἐξῆλθον",82,147],["ἀπὸ",17,1],["Μακεδονίας",10620,19],["οὐδεμία",228,15],["μοι",9994,151],["ἐκκλησία",563,13],["ἐκοινώνησεν",2089,3],["εἰς",8,1],["λόγον",48,7],["δόσεως",1766,19],["καὶ",2,8],["λήμψεως",4299,19],["εἰ",77,8],["μὴ",25,12],["ὑμεῖς",5,208],["μόνοι",302,130]],"You yourselves also know, you Philippians, that in the beginning of the Good News, when I departed from Macedonia, no assembly shared with me in the matter of giving and receiving but you only."],["16",[["ὅτι",19,8],["καὶ",2,8],["ἐν",4,1],["Θεσσαλονίκῃ",10636,2],["καὶ",2,8],["ἅπαξ",1315,17],["καὶ",2,8],["δὶς",1957,17],["εἰς",8,1],["τὴν",1,9],["χρείαν",1006,10],["μοι",9994,151],["ἐπέμψατε",1597,262]],"For even in Thessalonica you sent once and again to my need."],["17",[["οὐχ",12,12],["ὅτι",19,8],["ἐπιζητῶ",1936,149],["τὸ",1,32],["δόμα",961,33],["ἀλλ᾽",108,8],["ἐπιζητῶ",1936,149],["τὸν",1,6],["καρπὸν",448,7],["τὸν",1,6],["πλεονάζοντα",1523,178],["εἰς",8,1],["λόγον",48,7],["ὑμῶν",5,136]],"Not that I seek for the gift, but I seek for the fruit that increases to your account."],["18",[["ἀπέχω",1255,149],["δὲ",14,8],["πάντα",11,65],["καὶ",2,8],["περισσεύω",3112,149],["πεπλήρωμαι",518,880],["δεξάμενος",815,770],["παρὰ",73,1],["Ἐπαφροδίτου",11115,21],["τὰ",1,42],["παρ᾽",73,1],["ὑμῶν",5,136],["ὀσμὴν",684,10],["εὐωδίας",896,19],["θυσίαν",156,10],["δεκτὴν",1340,37],["εὐάρεστον",5629,37],["τῷ",1,110],["θεῷ",20,113]],"But I have all things and abound. I am filled, having received from Epaphroditus the things that came from you, a sweet-smelling fragrance, an acceptable and well-pleasing sacrifice to God."],["19",[["ὁ",1,4],["δὲ",14,8],["θεός",20,5],["μου",9994,146],["πληρώσει",518,120],["πᾶσαν",11,37],["χρείαν",1006,10],["ὑμῶν",5,136],["κατὰ",32,1],["τὸ",1,32],["πλοῦτος",574,33],["αὐτοῦ",3,48],["ἐν",4,1],["δόξῃ",141,2],["ἐν",4,1],["Χριστῷ",1072,113],["Ἰησοῦ",211,113]],"My God will supply every need of yours according to his riches in glory in Christ Jesus."],["20",[["τῷ",1,110],["δὲ",14,8],["θεῷ",20,113],["καὶ",2,8],["πατρὶ",44,113],["ἡμῶν",9994,136],["ἡ",1,11],["δόξα",141,13],["εἰς",8,1],["τοὺς",1,56],["αἰῶνας",100,31],["τῶν",1,76],["αἰώνων",100,77],["ἀμήν",3161,316]],"Now to our God and Father be the glory forever and ever! Amen."],["21",[["Ἀσπάσασθε",2987,771],["πάντα",11,59],["ἅγιον",75,59],["ἐν",4,1],["Χριστῷ",1072,113],["Ἰησοῦ",211,113],["ἀσπάζονται",2987,756],["ὑμᾶς",5,209],["οἱ",1,128],["σὺν",310,1],["ἐμοὶ",6,151],["ἀδελφοί",67,51]],"Greet every saint in Christ Jesus. The brothers who are with me greet you."],["22",[["ἀσπάζονται",2987,756],["ὑμᾶς",5,209],["πάντες",11,130],["οἱ",1,128],["ἅγιοι",75,130],["μάλιστα",3593,17],["δὲ",14,8],["οἱ",1,128],["ἐκ",21,1],["τῆς",1,18],["Καίσαρος",10166,21],["οἰκίας",233,19]],"All the saints greet you, especially those who are of Caesar’s household."],["23",[["Ἡ",1,11],["χάρις",368,13],["τοῦ",1,30],["κυρίου",7,21],["Ἰησοῦ",211,21],["Χριστοῦ",1072,21],["μετὰ",29,1],["τοῦ",1,23],["πνεύματος",168,24],["ὑμῶν",5,136]],"The grace of the Lord Jesus Christ be with you all. Amen."]]