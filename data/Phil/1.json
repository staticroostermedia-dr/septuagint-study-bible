[["1",[["Παῦλος",10586,5],["καὶ",2,8],["Τιμόθεος",1953,5],["δοῦλοι",136,51],["Χριστοῦ",1072,21],["Ἰησοῦ",211,21],["πᾶσιν",11,215],["τοῖς",1,138],["ἁγίοις",75,215],["ἐν",4,1],["Χριστῷ",1072,113],["Ἰησοῦ",211,113],["τοῖς",1,138],["οὖσιν",10,352],["ἐν",4,1],["Φιλίπποις",10623,139],["σὺν",310,1],["ἐπισκόποις",2320,139],["καὶ",2,8],["διακόνοις",3263,139]],"Paul and Timothy, servants of Jesus Christ, to all the saints in Christ Jesus who are at Philippi, with the overseers and servants:"],["2",[["χάρις",368,13],["ὑμῖν",5,86],["καὶ",2,8],["εἰρήνη",213,13],["ἀπὸ",17,1],["θεοῦ",20,21],["πατρὸς",44,21],["ἡμῶν",9994,136],["καὶ",2,8],["κυρίου",7,21],["Ἰησοῦ",211,21],["Χριστοῦ",1072,21]],"Grace to you and peace from God our Father and the Lord Jesus Christ."],["3",[["Εὐχαριστῶ",3831,149],["τῷ",1,110],["θεῷ",20,113],["μου",9994,146],["ἐπὶ",9,1],["πάσῃ",11,96],["τῇ",1,95],["μνείᾳ",2271,2],["ὑμῶν",5,136]],"I thank my God whenever I remember you,"],["4",[["πάντοτε",6027,17],["ἐν",4,1],["πάσῃ",11,96],["δεήσει",677,2],["μου",9994,146],["ὑπὲρ",139,1],["πάντων",11,163],["ὑμῶν",5,136],["μετὰ",29,1],["χαρᾶς",1125,19],["τὴν",1,9],["δέησιν",677,10],["ποιούμενος",23,406]],"always in every request of mine on behalf of you all, making my requests with joy,"],["5",[["ἐπὶ",9,1],["τῇ",1,95],["κοινωνίᾳ",4860,2],["ὑμῶν",5,136],["εἰς",8,1],["τὸ",1,32],["εὐαγγέλιον",4222,33],["ἀπὸ",17,1],["τῆς",1,18],["πρώτης",315,78],["ἡμέρας",28,19],["ἄχρι",4062,1],["τοῦ",1,30],["νῦν",90,17]],"for your partnership in furtherance of the Good News from the first day until now;"],["6",[["πεποιθὼς",344,264],["αὐτὸ",3,121],["τοῦτο",16,122],["ὅτι",19,8],["ὁ",1,4],["ἐναρξάμενος",2671,770],["ἐν",4,1],["ὑμῖν",5,86],["ἔργον",105,33],["ἀγαθὸν",114,29],["ἐπιτελέσει",1706,120],["ἄχρι",4062,1],["ἡμέρας",28,19],["Χριστοῦ",1072,21],["Ἰησοῦ",211,21]],"being confident of this very thing, that he who began a good work in you will complete it until the day of Jesus Christ."],["7",[["καθώς",221,8],["ἐστιν",10,87],["δίκαιον",153,28],["ἐμοὶ",6,151],["τοῦτο",16,122],["φρονεῖν",2297,54],["ὑπὲρ",139,1],["πάντων",11,163],["ὑμῶν",5,136],["διὰ",56,1],["τὸ",1,32],["ἔχειν",124,54],["με",9994,161],["ἐν",4,1],["τῇ",1,95],["καρδίᾳ",64,2],["ὑμᾶς",5,209],["ἔν",4,1],["τε",209,8],["τοῖς",1,138],["δεσμοῖς",1035,139],["μου",9994,146],["καὶ",2,8],["ἐν",4,1],["τῇ",1,95],["ἀπολογίᾳ",9017,2],["καὶ",2,8],["βεβαιώσει",5492,2],["τοῦ",1,23],["εὐαγγελίου",4222,24],["συγκοινωνούς",10879,31],["μου",9994,146],["τῆς",1,18],["χάριτος",368,19],["πάντας",11,58],["ὑμᾶς",5,209],["ὄντας",10,229]],"It is even right for me to think this way on behalf of all of you, because I have you in my heart, because both in my bonds and in the defense and confirmation of the Good News, you all are partakers with me of grace."],["8",[["Μάρτυς",875,5],["γάρ",40,8],["μου",9994,146],["ὁ",1,4],["θεός",20,5],["ὡς",36,12],["ἐπιποθῶ",2537,149],["πάντας",11,58],["ὑμᾶς",5,209],["ἐν",4,1],["σπλάγχνοις",2190,92],["Χριστοῦ",1072,21],["Ἰησοῦ",211,21]],"For God is my witness, how I long after all of you in the tender mercies of Christ Jesus."],["9",[["καὶ",2,8],["τοῦτο",16,122],["προσεύχομαι",551,768],["ἵνα",102,1],["ἡ",1,11],["ἀγάπη",1982,13],["ὑμῶν",5,136],["ἔτι",111,17],["μᾶλλον",1043,17],["καὶ",2,8],["μᾶλλον",1043,17],["περισσεύῃ",3112,173],["ἐν",4,1],["ἐπιγνώσει",3449,2],["καὶ",2,8],["πάσῃ",11,96],["αἰσθήσει",1619,2]],"This I pray, that your love may abound yet more and more in knowledge and all discernment,"],["10",[["εἰς",8,1],["τὸ",1,32],["δοκιμάζειν",1269,54],["ὑμᾶς",5,209],["τὰ",1,42],["διαφέροντα",2447,232],["ἵνα",102,8],["ἦτε",10,362],["εἰλικρινεῖς",7135,130],["καὶ",2,8],["ἀπρόσκοποι",6325,130],["εἰς",8,1],["ἡμέραν",28,10],["Χριστοῦ",1072,21]],"so that you may approve the things that are excellent, that you may be sincere and without offense to the day of Christ,"],["11",[["πεπληρωμένοι",518,574],["καρπὸν",448,7],["δικαιοσύνης",187,19],["τὸν",1,6],["διὰ",56,1],["Ἰησοῦ",211,21],["Χριστοῦ",1072,21],["εἰς",8,1],["δόξαν",141,10],["καὶ",2,8],["ἔπαινον",2840,7],["θεοῦ",20,21]],"being filled with the fruits of righteousness which are through Jesus Christ, to the glory and praise of God."],["12",[["Γινώσκειν",79,54],["δὲ",14,8],["ὑμᾶς",5,209],["βούλομαι",463,768],["ἀδελφοί",67,396],["ὅτι",19,8],["τὰ",1,253],["κατ᾽",32,1],["ἐμὲ",6,161],["μᾶλλον",1043,17],["εἰς",8,1],["προκοπὴν",5986,10],["τοῦ",1,23],["εὐαγγελίου",4222,24],["ἐλήλυθεν",55,165]],"Now I desire to have you know, brothers, that the things which happened to me have turned out rather to the progress of the Good News,"],["13",[["ὥστε",346,8],["τοὺς",1,56],["δεσμούς",1035,31],["μου",9994,146],["φανεροὺς",1977,58],["ἐν",4,1],["Χριστῷ",1072,113],["γενέσθαι",30,776],["ἐν",4,1],["ὅλῳ",235,34],["τῷ",1,52],["πραιτωρίῳ",10202,53],["καὶ",2,8],["τοῖς",1,138],["λοιποῖς",523,215],["πάσιν",11,215]],"so that it became evident to the whole palace guard, and to all the rest, that my bonds are in Christ,"],["14",[["καὶ",2,8],["τοὺς",1,56],["πλείονας",938,58],["τῶν",1,76],["ἀδελφῶν",67,77],["ἐν",4,1],["κυρίῳ",7,113],["πεποιθότας",344,276],["τοῖς",1,138],["δεσμοῖς",1035,139],["μου",9994,146],["περισσοτέρως",10995,17],["τολμᾶν",3371,54],["ἀφόβως",6363,17],["τὸν",1,6],["λόγον",48,7],["λαλεῖν",50,54]],"and that most of the brothers in the Lord, being confident through my bonds, are more abundantly bold to speak the word of God without fear."],["15",[["τινὲς",39,402],["μὲν",281,12],["καὶ",2,8],["διὰ",56,1],["φθόνον",4452,7],["καὶ",2,8],["ἔριν",5372,10],["τινὲς",39,402],["δὲ",14,8],["καὶ",2,8],["δι᾽",56,1],["εὐδοκίαν",1625,10],["τὸν",1,6],["Χριστὸν",1072,7],["κηρύσσουσιν",1438,191]],"Some indeed preach Christ even out of envy and strife, and some also out of good will."],["16",[["οἱ",1,128],["μὲν",281,12],["ἐξ",21,1],["ἀγάπης",1982,19],["εἰδότες",10044,263],["ὅτι",19,8],["εἰς",8,1],["ἀπολογίαν",9017,10],["τοῦ",1,23],["εὐαγγελίου",4222,24],["κεῖμαι",1731,768]],"The former insincerely preach Christ from selfish ambition, thinking that they add affliction to my chains;"],["17",[["οἱ",1,128],["δὲ",14,8],["ἐξ",21,1],["ἐριθείας",10828,19],["τὸν",1,6],["Χριστὸν",1072,7],["καταγγέλλουσιν",5681,191],["οὐχ",12,12],["ἁγνῶς",11107,17],["οἰόμενοι",1904,741],["θλῖψιν",438,10],["ἐγείρειν",746,54],["τοῖς",1,138],["δεσμοῖς",1035,139],["μου",9994,146]],"but the latter out of love, knowing that I am appointed for the defense of the Good News."],["18",[["τί",10010,238],["γάρ",40,8],["πλὴν",257,8],["ὅτι",19,8],["παντὶ",11,111],["τρόπῳ",245,113],["εἴτε",2713,8],["προφάσει",3634,2],["εἴτε",2713,8],["ἀληθείᾳ",352,2],["Χριστὸς",1072,5],["καταγγέλλεται",5681,449],["καὶ",2,8],["ἐν",4,1],["τούτῳ",16,279],["χαίρω",698,149],["ἀλλὰ",108,8],["καὶ",2,8],["χαρήσομαι",698,937]],"What does it matter? Only that in every way, whether in pretense or in truth, Christ is proclaimed. I rejoice in this, yes, and will rejoice."],["19",[["οἶδα",10044,85],["γὰρ",40,8],["ὅτι",19,8],["τοῦτό",16,344],["μοι",9994,151],["ἀποβήσεται",1797,718],["εἰς",8,1],["σωτηρίαν",425,10],["διὰ",56,1],["τῆς",1,18],["ὑμῶν",5,136],["δεήσεως",677,19],["καὶ",2,8],["ἐπιχορηγίας",11092,19],["τοῦ",1,23],["πνεύματος",168,24],["Ἰησοῦ",211,21],["Χριστοῦ",1072,21]],"For I know that this will turn out to my salvation through your prayers and the supply of the Spirit of Jesus Christ,"],["20",[["κατὰ",32,1],["τὴν",1,9],["ἀποκαραδοκίαν",10866,10],["καὶ",2,8],["ἐλπίδα",530,10],["μου",9994,146],["ὅτι",19,8],["ἐν",4,1],["οὐδενὶ",228,34],["αἰσχυνθήσομαι",611,176],["ἀλλ᾽",108,8],["ἐν",4,1],["πάσῃ",11,96],["παρρησίᾳ",2610,2],["ὡς",36,12],["πάντοτε",6027,17],["καὶ",2,8],["νῦν",90,17],["μεγαλυνθήσεται",604,125],["Χριστὸς",1072,5],["ἐν",4,1],["τῷ",1,52],["σώματί",454,53],["μου",9994,146],["εἴτε",2713,8],["διὰ",56,1],["ζωῆς",216,19],["εἴτε",2713,8],["διὰ",56,1],["θανάτου",170,21]],"according to my earnest expectation and hope, that I will in no way be disappointed, but with all boldness, as always, now also Christ will be magnified in my body, whether by life or by death."],["21",[["Ἐμοὶ",6,151],["γὰρ",40,8],["τὸ",1,27],["ζῆν",107,54],["Χριστὸς",1072,5],["καὶ",2,8],["τὸ",1,27],["ἀποθανεῖν",109,100],["κέρδος",7550,20]],"For to me to live is Christ, and to die is gain."],["22",[["εἰ",77,8],["δὲ",14,8],["τὸ",1,27],["ζῆν",107,54],["ἐν",4,1],["σαρκί",287,2],["τοῦτό",16,344],["μοι",9994,151],["καρπὸς",448,5],["ἔργου",105,24],["καὶ",2,8],["τί",10010,119],["αἱρήσομαι",3034,177],["οὐ",12,12],["γνωρίζω",748,149]],"But if I live on in the flesh, this will bring fruit from my work; yet I don’t know what I will choose."],["23",[["συνέχομαι",1227,572],["δὲ",14,8],["ἐκ",21,1],["τῶν",1,44],["δύο",104,372],["τὴν",1,9],["ἐπιθυμίαν",699,10],["ἔχων",124,67],["εἰς",8,1],["τὸ",1,32],["ἀναλῦσαι",1986,100],["καὶ",2,8],["σὺν",310,1],["Χριστῷ",1072,113],["εἶναι",10135,54],["πολλῷ",74,34],["γὰρ",40,8],["μᾶλλον",1043,17],["κρεῖσσον",922,28]],"But I am hard pressed between the two, having the desire to depart and be with Christ, which is far better."],["24",[["τὸ",1,27],["δὲ",14,8],["ἐπιμένειν",9529,54],["ἐν",4,1],["τῇ",1,95],["σαρκὶ",287,2],["ἀναγκαιότερον",4500,28],["δι᾽",56,1],["ὑμᾶς",5,209]],"Yet to remain in the flesh is more needful for your sake."],["25",[["καὶ",2,8],["τοῦτο",16,122],["πεποιθὼς",344,264],["οἶδα",10044,85],["ὅτι",19,8],["μενῶ",681,157],["καὶ",2,8],["παραμενῶ",3104,157],["πᾶσιν",11,215],["ὑμῖν",5,86],["εἰς",8,1],["τὴν",1,9],["ὑμῶν",5,136],["προκοπὴν",5986,10],["καὶ",2,8],["χαρὰν",1125,10],["τῆς",1,18],["πίστεως",887,19]],"Having this confidence, I know that I will remain, yes, and remain with you all for your progress and joy in the faith,"],["26",[["ἵνα",102,8],["τὸ",1,27],["καύχημα",1627,20],["ὑμῶν",5,136],["περισσεύῃ",3112,173],["ἐν",4,1],["Χριστῷ",1072,113],["Ἰησοῦ",211,113],["ἐν",4,1],["ἐμοὶ",6,151],["διὰ",56,1],["τῆς",1,18],["ἐμῆς",10146,78],["παρουσίας",4349,19],["πάλιν",655,17],["πρὸς",15,1],["ὑμᾶς",5,209]],"that your boasting may abound in Christ Jesus in me through my presence with you again."],["27",[["μόνον",302,29],["ἀξίως",5208,17],["τοῦ",1,23],["εὐαγγελίου",4222,24],["τοῦ",1,30],["Χρ