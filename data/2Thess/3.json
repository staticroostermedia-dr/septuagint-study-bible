[["1",[["Τὸ",1,32],["λοιπόν",2461,29],["προσεύχεσθε",551,742],["ἀδελφοί",67,396],["περὶ",72,1],["ἡμῶν",9994,136],["ἵνα",102,8],["ὁ",1,4],["λόγος",48,5],["τοῦ",1,30],["κυρίου",7,21],["τρέχῃ",820,173],["καὶ",2,8],["δοξάζηται",452,594],["καθὼς",221,8],["καὶ",2,8],["πρὸς",15,1],["ὑμᾶς",5,209]],"Finally, brothers, pray for us, that the word of the Lord may spread rapidly and be glorified, even as also with you,"],["2",[["καὶ",2,8],["ἵνα",102,8],["ῥυσθῶμεν",337,282],["ἀπὸ",17,1],["τῶν",1,76],["ἀτόπων",3417,163],["καὶ",2,8],["πονηρῶν",164,163],["ἀνθρώπων",43,77],["οὐ",12,12],["γὰρ",40,8],["πάντων",11,163],["ἡ",1,11],["πίστις",887,13]],"and that we may be delivered from unreasonable and evil men; for not all have faith."],["3",[["πιστὸς",750,16],["δέ",14,8],["ἐστιν",10,87],["ὁ",1,4],["κύριος",7,5],["ὃς",24,246],["στηρίξει",979,120],["ὑμᾶς",5,209],["καὶ",2,8],["φυλάξει",125,120],["ἀπὸ",17,1],["τοῦ",1,30],["πονηροῦ",164,153]],"But the Lord is faithful, who will establish you and guard you from the evil one."],["4",[["πεποίθαμεν",344,311],["δὲ",14,8],["ἐν",4,1],["κυρίῳ",7,113],["ἐφ᾽",9,1],["ὑμᾶς",5,209],["ὅτι",19,8],["ἃ",24,755],["παραγγέλλομεν",1907,241],["καὶ",2,8],["ποιεῖτε",23,84],["καὶ",2,8],["ποιήσετε",23,348]],"We have confidence in the Lord concerning you, that you both do and will do the things we command."],["5",[["ὁ",1,4],["δὲ",14,8],["κύριος",7,5],["κατευθύναι",827,216],["ὑμῶν",5,136],["τὰς",1,39],["καρδίας",64,40],["εἰς",8,1],["τὴν",1,9],["ἀγάπην",1982,10],["τοῦ",1,30],["θεοῦ",20,21],["καὶ",2,8],["εἰς",8,1],["τὴν",1,9],["ὑπομονὴν",1616,10],["τοῦ",1,30],["Χριστοῦ",1072,21]],"May the Lord direct your hearts into God’s love and into the perseverance of Christ."],["6",[["Παραγγέλλομεν",1907,241],["δὲ",14,8],["ὑμῖν",5,86],["ἀδελφοί",67,396],["ἐν",4,1],["ὀνόματι",57,53],["τοῦ",1,30],["κυρίου",7,21],["ἡμῶν",9994,136],["Ἰησοῦ",211,21],["Χριστοῦ",1072,21],["στέλλεσθαι",3359,384],["ὑμᾶς",5,209],["ἀπὸ",17,1],["παντὸς",11,153],["ἀδελφοῦ",67,21],["ἀτάκτως",11178,17],["περιπατοῦντος",1327,143],["καὶ",2,8],["μὴ",25,12],["κατὰ",32,1],["τὴν",1,9],["παράδοσιν",4960,10],["ἣν",24,124],["παρελάβοσαν",1385,141],["παρ᾽",73,1],["ἡμῶν",9994,136]],"Now we command you, brothers, in the name of our Lord Jesus Christ, that you withdraw yourselves from every brother who walks in rebellion and not after the tradition which they received from us."],["7",[["αὐτοὶ",3,195],["γὰρ",40,8],["οἴδατε",1168,330],["πῶς",10049,12],["δεῖ",1158,87],["μιμεῖσθαι",4311,749],["ἡμᾶς",9994,209],["ὅτι",19,8],["οὐκ",12,12],["ἠτακτήσαμεν",11179,285],["ἐν",4,1],["ὑμῖν",5,86]],"For you know how you ought to imitate us. For we didn’t behave ourselves rebelliously among you,"],["8",[["οὐδὲ",106,8],["δωρεὰν",10087,17],["ἄρτον",197,7],["ἐφάγομεν",147,285],["παρά",73,1],["τινος",39,805],["ἀλλ᾽",108,8],["ἐν",4,1],["κόπῳ",1345,113],["καὶ",2,8],["μόχθῳ",1144,113],["νυκτὸς",219,19],["καὶ",2,8],["ἡμέρας",28,19],["ἐργαζόμενοι",467,741],["πρὸς",15,1],["τὸ",1,32],["μὴ",25,12],["ἐπιβαρῆσαί",10998,100],["τινα",39,365],["ὑμῶν",5,136]],"neither did we eat bread from anyone’s hand without paying for it, but in labor and travail worked night and day, that we might not burden any of you."],["9",[["οὐχ",12,12],["ὅτι",19,8],["οὐκ",12,12],["ἔχομεν",124,241],["ἐξουσίαν",929,10],["ἀλλ᾽",108,8],["ἵνα",102,8],["ἑαυτοὺς",92,60],["τύπον",4449,7],["δῶμεν",33,75],["ὑμῖν",5,86],["εἰς",8,1],["τὸ",1,32],["μιμεῖσθαι",4311,749],["ἡμᾶς",9994,209]],"This was not because we don’t have the right, but to make ourselves an example to you, that you should imitate us."],["10",[["καὶ",2,8],["γὰρ",40,8],["ὅτε",432,8],["ἦμεν",10,395],["πρὸς",15,1],["ὑμᾶς",5,209],["τοῦτο",16,122],["παρηγγέλλομεν",1907,395],["ὑμῖν",5,86],["ὅτι",19,8],["εἴ",77,8],["τις",39,150],["οὐ",12,12],["θέλει",612,87],["ἐργάζεσθαι",467,749],["μηδὲ",414,17],["ἐσθιέτω",147,35]],"For even when we were with you, we commanded you this: “If anyone is not willing to work, don’t let him eat.”"],["11",[["Ἀκούομεν",54,241],["γάρ",40,8],["τινας",39,318],["περιπατοῦντας",1327,229],["ἐν",4,1],["ὑμῖν",5,86],["ἀτάκτως",11178,17],["μηδὲν",908,29],["ἐργαζομένους",467,729],["ἀλλὰ",108,8],["περιεργαζομένους",7940,729]],"For we hear of some who walk among you in rebellion, who don’t work at all, but are busybodies."],["12",[["Τοῖς",1,138],["δὲ",14,8],["τοιούτοις",630,193],["παραγγέλλομεν",1907,241],["καὶ",2,8],["παρακαλοῦμεν",434,241],["ἐν",4,1],["κυρίῳ",7,113],["Ἰησοῦ",211,113],["Χριστῷ",1072,113],["ἵνα",102,8],["μετὰ",29,1],["ἡσυχίας",2546,19],["ἐργαζόμενοι",467,741],["τὸν",1,6],["ἑαυτῶν",92,41],["ἄρτον",197,7],["ἐσθίωσιν",147,265]],"Now those who are that way, we command and exhort in the Lord Jesus Christ, that they work with quietness and eat their own bread."],["13",[["ὑμεῖς",5,208],["δέ",14,8],["ἀδελφοί",67,396],["μὴ",25,12],["ἐγκακήσητε",10404,118],["καλοποιοῦντες",11180,137]],"But you, brothers, don’t be weary in doing what is right."],["14",[["Εἰ",77,8],["δέ",14,8],["τις",39,150],["οὐχ",12,12],["ὑπακούει",867,87],["τῷ",1,110],["λόγῳ",48,113],["ἡμῶν",9994,136],["διὰ",56,1],["τῆς",1,18],["ἐπιστολῆς",866,19],["τοῦτον",16,259],["σημειοῦσθε",8222,852],["μὴ",25,12],["συναναμίγνυσθαι",8394,384],["αὐτῷ",3,49],["ἵνα",102,8],["ἐντραπῇ",1105,333]],"If any man doesn’t obey our word in this letter, note that man and have no company with him, to the end that he may be ashamed."],["15",[["καὶ",2,8],["μὴ",25,12],["ὡς",36,12],["ἐχθρὸν",135,7],["ἡγεῖσθε",378,742],["ἀλλὰ",108,8],["νουθετεῖτε",2608,307],["ὡς",36,12],["ἀδελφόν",67,7]],"Don’t count him as an enemy, but admonish him as a brother."],["16",[["Αὐτὸς",3,158],["δὲ",14,8],["ὁ",1,4],["κύριος",7,5],["τῆς",1,18],["εἰρήνης",213,19],["δῴη",33,216],["ὑμῖν",5,86],["τὴν",1,9],["εἰρήνην",213,10],["διὰ",56,1],["παντὸς",11,153],["ἐν",4,1],["παντὶ",11,111],["τρόπῳ",245,113],["ὁ",1,4],["κύριος",7,5],["μετὰ",29,1],["πάντων",11,163],["ὑμῶν",5,136]],"Now may the Lord of peace himself give you peace at all times in all ways. The Lord be with you all."],["17",[["Ὁ",1,4],["ἀσπασμὸς",10171,5],["τῇ",1,95],["ἐμῇ",10146,96],["χειρὶ",37,2],["Παύλου",10586,21],["ὅ",24,677],["ἐστιν",10,87],["σημεῖον",505,20],["ἐν",4,1],["πάσῃ",11,96],["ἐπιστολῇ",866,2],["οὕτως",71,17],["γράφω",186,149]],"I, Paul, write this greeting with my own hand, which is the sign in every letter. This is how I write."],["18",[["Ἡ",1,11],["χάρις",368,13],["τοῦ",1,30],["κυρίου",7,21],["ἡμῶν",9994,136],["Ἰησοῦ",211,21],["Χριστοῦ",1072,21],["μετὰ",29,1],["πάντων",11,163],["ὑμῶν",5,136]],"The grace of our Lord Jesus Christ be with you all. Amen."]]