[["1",[["Ἀδελφοί",67,396],["μου",9994,146],["μὴ",25,12],["ἐν",4,1],["προσωπολημψίαις",10829,71],["ἔχετε",124,307],["τὴν",1,9],["πίστιν",887,10],["τοῦ",1,30],["κυρίου",7,21],["ἡμῶν",9994,136],["Ἰησοῦ",211,21],["Χριστοῦ",1072,21],["τῆς",1,18],["δόξης",141,19]],"My brothers, don’t hold the faith of our glorious Lord Jesus Christ with partiality."],["2",[["ἐὰν",45,8],["γὰρ",40,8],["εἰσέλθῃ",86,160],["εἰς",8,1],["συναγωγὴν",284,10],["ὑμῶν",5,136],["ἀνὴρ",38,5],["χρυσοδακτύλιος",11364,16],["ἐν",4,1],["ἐσθῆτι",4104,2],["λαμπρᾷ",3576,96],["εἰσέλθῃ",86,160],["δὲ",14,8],["καὶ",2,8],["πτωχὸς",497,5],["ἐν",4,1],["ῥυπαρᾷ",6676,96],["ἐσθῆτι",4104,2]],"For if a man with a gold ring, in fine clothing, comes into your synagogue, and a poor man in filthy clothing also comes in,"],["3",[["ἐπιβλέψητε",517,118],["δὲ",14,8],["ἐπὶ",9,1],["τὸν",1,6],["φοροῦντα",3990,178],["τὴν",1,9],["ἐσθῆτα",4104,10],["τὴν",1,9],["λαμπρὰν",3576,37],["καὶ",2,8],["εἴπητε",9997,118],["σὺ",5,156],["κάθου",419,726],["ὧδε",640,17],["καλῶς",1273,17],["καὶ",2,8],["τῷ",1,110],["πτωχῷ",497,113],["εἴπητε",9997,118],["σὺ",5,156],["στῆθι",78,198],["ἐκεῖ",76,17],["ἢ",61,8],["κάθου",419,726],["ὑπὸ",122,1],["τὸ",1,32],["ὑποπόδιόν",4661,33],["μου",9994,146]],"and you pay special attention to him who wears the fine clothing and say, “Sit here in a good place;” and you tell the poor man, “Stand there,” or “Sit by my footstool”"],["4",[["καὶ",2,8],["οὐ",12,12],["διεκρίθητε",1506,353],["ἐν",4,1],["ἑαυτοῖς",92,142],["καὶ",2,8],["ἐγένεσθε",30,779],["κριταὶ",749,51],["διαλογισμῶν",1584,77],["πονηρῶν",164,163]],"haven’t you shown partiality among yourselves, and become judges with evil thoughts?"],["5",[["ἀκούσατε",54,69],["ἀδελφοί",67,396],["μου",9994,146],["ἀγαπητοί",1920,537],["οὐχ",12,12],["ὁ",1,4],["θεὸς",20,5],["ἐξελέξατο",420,26],["τοὺς",1,56],["πτωχοὺς",497,31],["τῷ",1,110],["κόσμῳ",743,113],["πλουσίους",952,58],["ἐν",4,1],["πίστει",887,2],["καὶ",2,8],["κληρονόμους",3863,31],["τῆς",1,18],["βασιλείας",157,19],["ἧς",24,162],["ἐπηγγείλατο",2536,737],["τοῖς",1,138],["ἀγαπῶσιν",214,352],["αὐτόν",3,82]],"Listen, my beloved brothers. Didn’t God choose those who are poor in this world to be rich in faith and heirs of the Kingdom which he promised to those who love him?"],["6",[["ὑμεῖς",5,208],["δὲ",14,8],["ἠτιμάσατε",1400,262],["τὸν",1,6],["πτωχόν",497,7],["οὐχ",12,12],["οἱ",1,128],["πλούσιοι",952,130],["καταδυναστεύουσιν",1305,191],["ὑμῶν",5,136],["καὶ",2,8],["αὐτοὶ",3,195],["ἕλκουσιν",10463,191],["ὑμᾶς",5,209],["εἰς",8,1],["κριτήρια",3565,43]],"But you have dishonored the poor man. Don’t the rich oppress you and personally drag you before the courts?"],["7",[["οὐκ",12,12],["αὐτοὶ",3,195],["βλασφημοῦσιν",3250,191],["τὸ",1,32],["καλὸν",266,29],["ὄνομα",57,33],["τὸ",1,32],["ἐπικληθὲν",341,387],["ἐφ᾽",9,1],["ὑμᾶς",5,209]],"Don’t they blaspheme the honorable name by which you are called?"],["8",[["εἰ",77,8],["μέντοι",3905,8],["νόμον",140,7],["τελεῖτε",1482,84],["βασιλικὸν",1298,59],["κατὰ",32,1],["τὴν",1,9],["γραφήν",1505,10],["ἀγαπήσεις",214,159],["τὸν",1,6],["πλησίον",292,17],["σου",5,146],["ὡς",36,12],["σεαυτόν",10014,82],["καλῶς",1273,17],["ποιεῖτε",23,84]],"However, if you fulfill the royal law according to the Scripture, “You shall love your neighbor as yourself,” you do well."],["9",[["εἰ",77,8],["δὲ",14,8],["προσωπολημπτεῖτε",11365,84],["ἁμαρτίαν",119,10],["ἐργάζεσθε",467,754],["ἐλεγχόμενοι",752,772],["ὑπὸ",122,1],["τοῦ",1,30],["νόμου",140,21],["ὡς",36,12],["παραβάται",10832,51]],"But if you show partiality, you commit sin, being convicted by the law as transgressors."],["10",[["ὅστις",457,246],["γὰρ",40,8],["ὅλον",235,59],["τὸν",1,6],["νόμον",140,7],["τηρήσῃ",1358,160],["πταίσῃ",2187,160],["δὲ",14,8],["ἐν",4,1],["ἑνί",58,111],["γέγονεν",30,165],["πάντων",11,79],["ἔνοχος",1870,16]],"For whoever keeps the whole law, and yet stumbles in one point, he has become guilty of all."],["11",[["ὁ",1,4],["γὰρ",40,8],["εἰπὼν",9997,155],["μὴ",25,12],["μοιχεύσῃς",2466,170],["εἶπεν",9997,3],["καὶ",2,8],["μὴ",25,12],["φονεύσῃς",970,170],["εἰ",77,8],["δὲ",14,8],["οὐ",12,12],["μοιχεύεις",2466,145],["φονεύεις",970,145],["δέ",14,8],["γέγονας",30,172],["παραβάτης",10832,5],["νόμου",140,21]],"For he who said, “Do not commit adultery,” also said, “Do not commit murder.” Now if you do not commit adultery but do murder, you have become a transgressor of the law."],["12",[["οὕτως",9989,17],["λαλεῖτε",50,307],["καὶ",2,8],["οὕτως",9989,17],["ποιεῖτε",23,307],["ὡς",36,12],["διὰ",56,1],["νόμου",140,21],["ἐλευθερίας",3427,19],["μέλλοντες",1143,137],["κρίνεσθαι",263,634]],"So speak and so do as men who are to be judged by the law of freedom."],["13",[["ἡ",1,11],["γὰρ",40,8],["κρίσις",229,13],["ἀνέλεος",11366,15],["τῷ",1,110],["μὴ",25,12],["ποιήσαντι",23,354],["ἔλεος",183,33],["κατακαυχᾶται",4823,728],["ἔλεος",183,20],["κρίσεως",229,19]],"For judgment is without mercy to him who has shown no mercy. Mercy triumphs over judgment."],["14",[["Τί",10010,238],["τὸ",1,27],["ὄφελος",9852,20],["ἀδελφοί",67,396],["μου",9994,146],["ἐὰν",45,8],["πίστιν",887,10],["λέγῃ",31,173],["τις",39,150],["ἔχειν",124,54],["ἔργα",105,43],["δὲ",14,8],["μὴ",25,12],["ἔχῃ",124,173],["μὴ",25,12],["δύναται",185,728],["ἡ",1,11],["πίστις",887,13],["σῶσαι",172,100],["αὐτόν",3,82]],"What good is it, my brothers, if a man says he has faith, but has no works? Can faith save him?"],["15",[["ἐὰν",45,8],["ἀδελφὸς",67,5],["ἢ",61,8],["ἀδελφὴ",521,13],["γυμνοὶ",1299,130],["ὑπάρχωσιν",418,265],["καὶ",2,8],["λειπόμενοι",3581,520],["ὦσιν",10,265],["τῆς",1,18],["ἐφημέρου",11367,78],["τροφῆς",1390,19]],"And if a brother or sister is naked and in lack of daily food,"],["16",[["εἴπῃ",9997,160],["δέ",14,8],["τις",39,150],["αὐτοῖς",3,142],["ἐξ",21,1],["ὑμῶν",5,136],["ὑπάγετε",6654,307],["ἐν",4,1],["εἰρήνῃ",213,2],["θερμαίνεσθε",2350,382],["καὶ",2,8],["χορτάζεσθε",2397,852],["μὴ",25,12],["δῶτε",33,118],["δὲ",14,8],["αὐτοῖς",3,142],["τὰ",1,42],["ἐπιτήδεια",3008,65],["τοῦ",1,23],["σώματος",454,24],["τί",10010,238],["τὸ",1,27],["ὄφελος",9852,20]],"and one of you tells them, “Go in peace. Be warmed and filled;” yet you didn’t give them the things the body needs, what good is it?"],["17",[["οὕτως",9989,17],["καὶ",2,8],["ἡ",1,11],["πίστις",887,13],["ἐὰν",45,8],["μὴ",25,12],["ἔχῃ",124,173],["ἔργα",105,43],["νεκρά",659,15],["ἐστιν",10,87],["καθ᾽",32,1],["ἑαυτήν",92,98]],"Even so faith, if it has no works, is dead in itself."],["18",[["Ἀλλ᾽",108,8],["ἐρεῖ",10054,120],["τις",39,150],["σὺ",5,156],["πίστιν",887,10],["ἔχεις",124,145],["κἀγὼ",10000,8],["ἔργα",105,43],["ἔχω",124,149],["δεῖξόν",870,198],["μοι",9994,151],["τὴν",1,9],["πίστιν",887,10],["σου",5,146],["χωρὶς",2046,1],["τῶν",1,44],["ἔργων",105,45],["κἀγώ",10000,8],["σοι",5,151],["δείξω",870,157],["ἐκ",21,1],["τῶν",1,44],["ἔργων",105,45],["μου",9994,146],["τὴν",1,9],["πίστιν",887,10]],"Yes, a man will say, “You have faith, and I have works.” Show me your faith without works, and I will show you my faith by my works."],["19",[["σὺ",5,156],["πιστεύεις",649,145],["ὅτι",19,8],["εἷς",58,16],["ἐστιν",10,87],["ὁ",1,4],["θεός",20,5],["καλῶς",1273,17],["ποιεῖς",23,145],["καὶ",2,8],["τὰ",1,253],["δαιμόνια",2013,63],["πιστεύουσιν",649,191],["καὶ",2,8],["φρίσσουσιν",3379,191]],"You believe that God is one. You do well. The demons also believe—and shudder."],["20",[["θέλεις",612,145],["δὲ",14,8],["γνῶναι",79,100],["ὦ",646,316],["ἄνθρωπε",43,250],["κενέ",780,309],["ὅτι",19,8],["ἡ",1,11],["πίστις",887,13],["χωρὶς",2046,1],["τῶν",1,44],["ἔργων",105,45],["ἀργή",3410,15],["ἐστιν",10,87]],"But do you want to know, vain man, that faith apart from works is dead?"],["21",[["Ἀβραὰμ",294,5],["ὁ",1,4],["πατὴρ",44,5],["ἡμῶν",9994,136],["οὐκ",12,12],["ἐξ",21,1],["ἔργων",105,45],["ἐδικαιώθη",1115,38],["ἀνενέγκας",384,155],["Ἰσαὰκ",451,7],["τὸν",1,6],["υἱὸν",13,7],["αὐτοῦ",3,48],["ἐπὶ",9,1],["τὸ",1,32],["θυσιαστήριον",133,33]],"Wasn’t Abraham our father justified by works, in that he offered up Isaac his son on the altar?"],["22",[["βλέπεις",470,145],["ὅτι",19,8],["ἡ",1,11],["πίστις",887,13],["συνήργει",6115,14],["τοῖς",1,91],["ἔργοις",105,92],["αὐτοῦ",3,48],["καὶ",2,8],["ἐκ",21,1],["τῶν",1,44],["ἔργων",105,45],["ἡ",1,11],["πίστις",887,13],["ἐτελειώθη",1838,38]],"You see that faith worked with his works, and by works faith was perfected."],["23",[["καὶ",2,8],["ἐπληρώθη",518,38],["ἡ",1,11],["γραφὴ",1505,13],["ἡ",1,11],["λέγουσα",31,183],["ἐπίστευσεν",649,3],["δὲ",14,8],["Ἀβραὰμ",294,5],["τῷ",1,110],["θεῷ",20,113],["καὶ",2,8],["ἐλογίσθη",495,38],["αὐτῷ",3,49],["εἰς",8,1],["δικαιοσύνην",187,10],["καὶ",2,8],["φίλος",336,16],["θεοῦ",20,21],["ἐκλήθη",128,38]],"So the Scripture was fulfilled which says, “Abraham believed God, and it was accounted to him as righteousness,” and he was called the friend of God."],["24",[["ὁρᾶτε",112,84],["ὅτι",19,8],["ἐξ",21,1],["ἔργων",105,45],["δικαιοῦται",1115,449],["ἄνθρωπος",43,5],["καὶ",2,8],["οὐκ",12,12],["ἐκ",21,1],["πίστεως",887,19],["μόνον",302,29]],"You see then that by works a man is justified, and not only by faith."],["25",[["Ὁμοίως",1757,17],["δὲ",14,8],["καὶ",2,8],["Ῥαὰβ",2690,13],["ἡ",1,11],["πόρνη",1146,13],["οὐκ",12,12],["ἐξ",21,1],["ἔργων",105,45],["ἐδικαιώθη",1115,38],["ὑποδεξαμένη",9898,953],["τοὺς",1,56],["ἀγγέλους",208,31],["καὶ",2,8],["ἑτέρᾳ",253,96],["ὁδῷ",68,2],["ἐκβαλοῦσα",585,140]],"In the same way, wasn’t Rahab the prostitute also justified by works when she received the messengers and sent them out another way?"],["26",[["ὥσπερ",226,8],["γὰρ",40,8],["τὸ",1,27],["σῶμα",454,20],["χωρὶς",2046,1],["πνεύματος",168,24],["νεκρόν",659,28],["ἐστιν",10,87],["οὕτως",9989,17],["καὶ",2,8],["ἡ",1,11],["πίστις",887,13],["χωρὶς",2046,1],["ἔργων",105,45],["νεκρά",659,15],["ἐστιν",10,87]],"For as the body apart from the spirit is dead, even so faith apart from works is dead."]]