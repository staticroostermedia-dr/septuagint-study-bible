[["1",[["Πόθεν",1170,17],["πόλεμοι",163,51],["καὶ",2,8],["πόθεν",1170,17],["μάχαι",1382,180],["ἐν",4,1],["ὑμῖν",5,86],["οὐκ",12,12],["ἐντεῦθεν",1458,17],["ἐκ",21,1],["τῶν",1,123],["ἡδονῶν",2231,61],["ὑμῶν",5,136],["τῶν",1,123],["στρατευομένων",3641,696],["ἐν",4,1],["τοῖς",1,91],["μέλεσιν",1593,92],["ὑμῶν",5,136]],"Where do wars and fightings among you come from? Don’t they come from your pleasures that war in your members?"],["2",[["ἐπιθυμεῖτε",915,84],["καὶ",2,8],["οὐκ",12,12],["ἔχετε",124,84],["φονεύετε",970,84],["καὶ",2,8],["ζηλοῦτε",1057,84],["καὶ",2,8],["οὐ",12,12],["δύνασθε",185,754],["ἐπιτυχεῖν",6520,100],["μάχεσθε",1683,754],["καὶ",2,8],["πολεμεῖτε",305,84],["οὐκ",12,12],["ἔχετε",124,84],["διὰ",56,1],["τὸ",1,32],["μὴ",25,12],["αἰτεῖσθαι",617,384],["ὑμᾶς",5,209]],"You lust, and don’t have. You murder and covet, and can’t obtain. You fight and make war. You don’t have, because you don’t ask."],["3",[["αἰτεῖτε",617,84],["καὶ",2,8],["οὐ",12,12],["λαμβάνετε",46,84],["διότι",177,8],["κακῶς",2172,17],["αἰτεῖσθε",617,383],["ἵνα",102,8],["ἐν",4,1],["ταῖς",1,70],["ἡδοναῖς",2231,71],["ὑμῶν",5,136],["δαπανήσητε",3043,118]],"You ask, and don’t receive, because you ask with wrong motives, so that you may spend it on your pleasures."],["4",[["μοιχαλίδες",3300,954],["οὐκ",12,12],["οἴδατε",10044,330],["ὅτι",19,8],["ἡ",1,11],["φιλία",1253,13],["τοῦ",1,30],["κόσμου",743,21],["ἔχθρα",1802,13],["τοῦ",1,30],["θεοῦ",20,21],["ἐστιν",10,87],["ὃς",24,246],["ἐὰν",45,8],["οὖν",227,8],["βουληθῇ",463,831],["φίλος",336,16],["εἶναι",10135,54],["τοῦ",1,30],["κόσμου",743,21],["ἐχθρὸς",135,5],["τοῦ",1,30],["θεοῦ",20,21],["καθίσταται",314,449]],"You adulterers and adulteresses, don’t you know that friendship with the world is hostility toward God? Whoever therefore wants to be a friend of the world makes himself an enemy of God."],["5",[["ἢ",61,8],["δοκεῖτε",801,84],["ὅτι",19,8],["κενῶς",11372,17],["ἡ",1,11],["γραφὴ",1505,13],["λέγει",31,87],["πρὸς",15,1],["φθόνον",4452,7],["ἐπιποθεῖ",2537,87],["τὸ",1,32],["πνεῦμα",168,33],["ὃ",24,467],["κατῴκισεν",976,3],["ἐν",4,1],["ἡμῖν",9994,86]],"Or do you think that the Scripture says in vain, “The Spirit who lives in us yearns jealously”?"],["6",[["μείζονα",66,37],["δὲ",14,8],["δίδωσιν",33,87],["χάριν",368,10],["διὸ",1466,8],["λέγει",31,87],["ὁ",1,4],["θεὸς",20,5],["ὑπερηφάνοις",1109,215],["ἀντιτάσσεται",3163,506],["ταπεινοῖς",1097,215],["δὲ",14,8],["δίδωσιν",33,87],["χάριν",368,10]],"But he gives more grace. Therefore it says, “God resists the proud, but gives grace to the humble.”"],["7",[["ὑποτάγητε",1497,498],["οὖν",227,8],["τῷ",1,110],["θεῷ",20,113],["ἀντίστητε",796,69],["δὲ",14,8],["τῷ",1,110],["διαβόλῳ",1720,111],["καὶ",2,8],["φεύξεται",264,718],["ἀφ᾽",17,1],["ὑμῶν",5,136]],"Be subject therefore to God. Resist the devil, and he will flee from you."],["8",[["ἐγγίσατε",455,69],["τῷ",1,110],["θεῷ",20,113],["καὶ",2,8],["ἐγγιεῖ",455,120],["ὑμῖν",5,86],["καθαρίσατε",482,69],["χεῖρας",37,40],["ἁμαρτωλοί",409,537],["καὶ",2,8],["ἁγνίσατε",1337,69],["καρδίας",64,40],["δίψυχοι",11356,537]],"Draw near to God, and he will draw near to you. Cleanse your hands, you sinners. Purify your hearts, you double-minded."],["9",[["ταλαιπωρήσατε",2119,69],["καὶ",2,8],["πενθήσατε",736,69],["καὶ",2,8],["κλαύσατε",412,69],["ὁ",1,4],["γέλως",1883,5],["ὑμῶν",5,136],["εἰς",8,1],["πένθος",1004,33],["μετατραπήτω",11373,25],["καὶ",2,8],["ἡ",1,11],["χαρὰ",1125,13],["εἰς",8,1],["κατήφειαν",11374,10]],"Lament, mourn, and weep. Let your laughter be turned to mourning and your joy to gloom."],["10",[["ταπεινώθητε",322,498],["ἐνώπιον",115,1],["τοῦ",1,30],["κυρίου",7,21],["καὶ",2,8],["ὑψώσει",331,120],["ὑμᾶς",5,209]],"Humble yourselves in the sight of the Lord, and he will exalt you."],["11",[["Μὴ",25,12],["καταλαλεῖτε",2356,307],["ἀλλήλων",1192,41],["ἀδελφοί",67,396],["ὁ",1,4],["καταλαλῶν",2356,67],["ἀδελφοῦ",67,21],["ἢ",61,8],["κρίνων",263,67],["τὸν",1,6],["ἀδελφὸν",67,7],["αὐτοῦ",3,48],["καταλαλεῖ",2356,87],["νόμου",140,21],["καὶ",2,8],["κρίνει",263,87],["νόμον",140,7],["εἰ",77,8],["δὲ",14,8],["νόμον",140,7],["κρίνεις",263,145],["οὐκ",12,12],["εἶ",10,145],["ποιητὴς",8000,5],["νόμου",140,21],["ἀλλὰ",108,8],["κριτής",749,5]],"Don’t speak against one another, brothers. He who speaks against a brother and judges his brother, speaks against the law and judges the law. But if you judge the law, you are not a doer of the law but a judge."],["12",[["εἷς",58,16],["ἐστιν",10,87],["ὁ",1,4],["νομοθέτης",7766,5],["καὶ",2,8],["κριτὴς",749,5],["ὁ",1,4],["δυνάμενος",185,723],["σῶσαι",172,100],["καὶ",2,8],["ἀπολέσαι",596,100],["σὺ",5,156],["δὲ",14,8],["τίς",10010,150],["εἶ",10,145],["ὁ",1,752],["κρίνων",263,568],["τὸν",1,6],["πλησίον",292,17]],"Only one is the lawgiver, who is able to save and to destroy. But who are you to judge another?"],["13",[["Ἄγε",224,239],["νῦν",90,17],["οἱ",1,538],["λέγοντες",31,619],["σήμερον",205,17],["ἢ",61,8],["αὔριον",857,17],["πορευσόμεθα",49,874],["εἰς",8,1],["τήνδε",129,234],["τὴν",1,9],["πόλιν",41,10],["καὶ",2,8],["ποιήσομεν",23,269],["ἐκεῖ",76,17],["ἐνιαυτὸν",400,7],["καὶ",2,8],["ἐμπορευσόμεθα",2670,874],["καὶ",2,8],["κερδήσομεν",10137,269]],"Come now, you who say, “Today or tomorrow let’s go into this city and spend a year there, trade, and make a profit.”"],["14",[["οἵτινες",457,455],["οὐκ",12,12],["ἐπίστασθε",1087,754],["τὸ",1,32],["τῆς",1,18],["αὔριον",857,17],["ποία",1332,368],["ἡ",1,11],["ζωὴ",216,13],["ὑμῶν",5,136],["ἀτμὶς",2663,13],["γάρ",40,8],["ἐστε",10,84],["ἡ",1,11],["πρὸς",15,1],["ὀλίγον",555,29],["φαινομένη",832,204],["ἔπειτα",6560,17],["καὶ",2,8],["ἀφανιζομένη",623,761]],"Yet you don’t know what your life will be like tomorrow. For what is your life? For you are a vapor that appears for a little time and then vanishes away."],["15",[["ἀντὶ",158,1],["τοῦ",1,23],["λέγειν",31,54],["ὑμᾶς",5,209],["ἐὰν",45,8],["ὁ",1,4],["κύριος",7,5],["θελήσῃ",612,160],["καὶ",2,8],["ζήσομεν",107,269],["καὶ",2,8],["ποιήσομεν",23,269],["τοῦτο",16,122],["ἢ",61,8],["ἐκεῖνο",80,122]],"For you ought to say, “If the Lord wills, we will both live, and do this or that.”"],["16",[["νῦν",90,17],["δὲ",14,8],["καυχᾶσθε",1380,754],["ἐν",4,1],["ταῖς",1,70],["ἀλαζονείαις",3393,71],["ὑμῶν",5,136],["πᾶσα",11,15],["καύχησις",2730,13],["τοιαύτη",630,101],["πονηρά",164,15],["ἐστιν",10,87]],"But now you glory in your boasting. All such boasting is evil."],["17",[["εἰδότι",10044,531],["οὖν",227,8],["καλὸν",266,29],["ποιεῖν",23,54],["καὶ",2,8],["μὴ",25,12],["ποιοῦντι",23,390],["ἁμαρτία",119,13],["αὐτῷ",3,49],["ἐστιν",10,87]],"To him therefore who knows to do good and doesn’t do it, to him it is sin."]]