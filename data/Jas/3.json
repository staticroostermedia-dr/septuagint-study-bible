[["1",[["Μὴ",25,12],["πολλοὶ",74,130],["διδάσκαλοι",7031,51],["γίνεσθε",30,742],["ἀδελφοί",67,396],["μου",9994,146],["εἰδότες",1168,263],["ὅτι",19,8],["μεῖζον",66,29],["κρίμα",267,33],["λημψόμεθα",46,874]],"Let not many of you be teachers, my brothers, knowing that we will receive heavier judgment."],["2",[["πολλὰ",74,65],["γὰρ",40,8],["πταίομεν",2187,241],["ἅπαντες",772,130],["εἴ",77,8],["τις",39,150],["ἐν",4,1],["λόγῳ",48,113],["οὐ",12,12],["πταίει",2187,87],["οὗτος",16,112],["τέλειος",1919,16],["ἀνήρ",38,5],["δυνατὸς",356,16],["χαλιναγωγῆσαι",11363,100],["καὶ",2,8],["ὅλον",235,29],["τὸ",1,32],["σῶμα",454,33]],"For we all stumble in many things. Anyone who doesn’t stumble in word is a perfect person, able to bridle the whole body also."],["3",[["Εἰ",77,8],["δὲ",14,8],["τῶν",1,76],["ἵππων",309,77],["τοὺς",1,56],["χαλινοὺς",3671,31],["εἰς",8,1],["τὰ",1,42],["στόματα",123,43],["βάλλομεν",766,241],["εἰς",8,1],["τὸ",1,32],["πείθεσθαι",344,634],["αὐτοὺς",3,60],["ἡμῖν",9994,86],["καὶ",2,8],["ὅλον",235,29],["τὸ",1,32],["σῶμα",454,33],["αὐτῶν",3,41],["μετάγομεν",2601,241]],"Indeed, we put bits into the horses’ mouths so that they may obey us, and we guide their whole body."],["4",[["ἰδοὺ",51,316],["καὶ",2,8],["τὰ",1,253],["πλοῖα",1169,63],["τηλικαῦτα",5103,335],["ὄντα",10,289],["καὶ",2,8],["ὑπὸ",122,1],["ἀνέμων",850,77],["σκληρῶν",831,163],["ἐλαυνόμενα",2417,822],["μετάγεται",2601,449],["ὑπὸ",122,1],["ἐλαχίστου",2418,88],["πηδαλίου",10795,24],["ὅπου",1579,8],["ἡ",1,11],["ὁρμὴ",2847,13],["τοῦ",1,30],["εὐθύνοντος",2348,143],["βούλεται",463,728]],"Behold, the ships also, though they are so big and are driven by fierce winds, are yet guided by a very small rudder, wherever the pilot desires."],["5",[["Οὕτως",71,17],["καὶ",2,8],["ἡ",1,11],["γλῶσσα",388,13],["μικρὸν",367,28],["μέλος",1593,20],["ἐστὶν",10,87],["καὶ",2,8],["μεγάλα",66,65],["αὐχεῖ",11368,87],["ἰδοὺ",51,316],["ἡλίκον",11140,238],["πῦρ",118,20],["ἡλίκην",11140,583],["ὕλην",3229,10],["ἀνάπτει",1796,87]],"So the tongue is also a little member, and boasts great things. See how a small fire can spread to a large forest!"],["6",[["καὶ",2,8],["ἡ",1,11],["γλῶσσα",388,13],["πῦρ",118,20],["ὁ",1,4],["κόσμος",743,5],["τῆς",1,18],["ἀδικίας",288,19],["ἡ",1,11],["γλῶσσα",388,13],["καθίσταται",314,449],["ἐν",4,1],["τοῖς",1,91],["μέλεσιν",1593,92],["ἡμῶν",9994,136],["ἡ",1,11],["σπιλοῦσα",8267,183],["ὅλον",235,29],["τὸ",1,32],["σῶμα",454,33],["καὶ",2,8],["φλογίζουσα",3663,183],["τὸν",1,6],["τροχὸν",911,7],["τῆς",1,18],["γενέσεως",959,19],["καὶ",2,8],["φλογιζομένη",3663,761],["ὑπὸ",122,1],["τῆς",1,18],["γεέννης",10034,19]],"And the tongue is a fire. The world of iniquity among our members is the tongue, which defiles the whole body, and sets on fire the course of nature, and is set on fire by Gehenna."],["7",[["Πᾶσα",11,15],["γὰρ",40,8],["φύσις",2974,13],["θηρίων",403,45],["τε",209,8],["καὶ",2,8],["πετεινῶν",572,45],["ἑρπετῶν",1107,45],["τε",209,8],["καὶ",2,8],["ἐναλίων",11369,79],["δαμάζεται",5530,449],["καὶ",2,8],["δεδάμασται",5530,722],["τῇ",1,95],["φύσει",2974,2],["τῇ",1,95],["ἀνθρωπίνῃ",2656,96]],"For every kind of animal, bird, creeping thing, and sea creature is tamed, and has been tamed by mankind;"],["8",[["τὴν",1,9],["δὲ",14,8],["γλῶσσαν",388,10],["οὐδεὶς",228,16],["δαμάσαι",5530,100],["δύναται",185,728],["ἀνθρώπων",43,77],["ἀκατάστατον",8773,28],["κακόν",161,28],["μεστὴ",4306,15],["ἰοῦ",10836,21],["θανατηφόρου",4237,153]],"but nobody can tame the tongue. It is a restless evil, full of deadly poison."],["9",[["ἐν",4,1],["αὐτῇ",3,99],["εὐλογοῦμεν",149,241],["τὸν",1,6],["κύριον",7,7],["καὶ",2,8],["πατέρα",44,7],["καὶ",2,8],["ἐν",4,1],["αὐτῇ",3,99],["καταρώμεθα",779,800],["τοὺς",1,56],["ἀνθρώπους",43,31],["τοὺς",1,56],["καθ᾽",32,1],["ὁμοίωσιν",3765,10],["θεοῦ",20,21],["γεγονότας",30,276]],"With it we bless our God and Father, and with it we curse men who are made in the image of God."],["10",[["ἐκ",21,1],["τοῦ",1,23],["αὐτοῦ",3,144],["στόματος",123,24],["ἐξέρχεται",82,728],["εὐλογία",578,13],["καὶ",2,8],["κατάρα",1165,13],["οὐ",12,12],["χρή",6211,87],["ἀδελφοί",67,396],["μου",9994,146],["ταῦτα",16,335],["οὕτως",71,17],["γίνεσθαι",30,749]],"Out of the same mouth comes blessing and cursing. My brothers, these things ought not to be so."],["11",[["μήτι",10058,12],["ἡ",1,11],["πηγὴ",565,13],["ἐκ",21,1],["τῆς",1,18],["αὐτῆς",3,83],["ὀπῆς",3762,19],["βρύει",11370,87],["τὸ",1,32],["γλυκὺ",2073,29],["καὶ",2,8],["τὸ",1,32],["πικρόν",1076,29]],"Does a spring send out from the same opening fresh and bitter water?"],["12",[["μὴ",25,12],["δύναται",185,728],["ἀδελφοί",67,396],["μου",9994,146],["συκῆ",1561,13],["ἐλαίας",1655,40],["ποιῆσαι",23,100],["ἢ",61,8],["ἄμπελος",812,13],["σῦκα",3145,43],["οὔτε",477,8],["ἁλυκὸν",3177,28],["γλυκὺ",2073,29],["ποιῆσαι",23,100],["ὕδωρ",85,33]],"Can a fig tree, my brothers, yield olives, or a vine figs? Thus no spring yields both salt water and fresh water."],["13",[["Τίς",10010,150],["σοφὸς",324,16],["καὶ",2,8],["ἐπιστήμων",2837,16],["ἐν",4,1],["ὑμῖν",5,86],["δειξάτω",870,46],["ἐκ",21,1],["τῆς",1,18],["καλῆς",266,78],["ἀναστροφῆς",6267,19],["τὰ",1,42],["ἔργα",105,43],["αὐτοῦ",3,48],["ἐν",4,1],["πραΰτητι",5977,2],["σοφίας",242,19]],"Who is wise and understanding among you? Let him show by his good conduct that his deeds are done in gentleness of wisdom."],["14",[["εἰ",77,8],["δὲ",14,8],["ζῆλον",1164,7],["πικρὸν",1076,59],["ἔχετε",124,84],["καὶ",2,8],["ἐριθείαν",10828,10],["ἐν",4,1],["τῇ",1,95],["καρδίᾳ",64,2],["ὑμῶν",5,136],["μὴ",25,12],["κατακαυχᾶσθε",4823,742],["καὶ",2,8],["ψεύδεσθε",1099,742],["κατὰ",32,1],["τῆς",1,18],["ἀληθείας",352,19]],"But if you have bitter jealousy and selfish ambition in your heart, don’t boast and don’t lie against the truth."],["15",[["οὐκ",12,12],["ἔστιν",10,87],["αὕτη",16,101],["ἡ",1,11],["σοφία",242,13],["ἄνωθεν",1605,17],["κατερχομένη",4269,744],["ἀλλ᾽",108,8],["ἐπίγειος",10447,15],["ψυχικὴ",5154,15],["δαιμονιώδης",11371,15]],"This wisdom is not that which comes down from above, but is earthly, sensual, and demonic."],["16",[["ὅπου",1579,8],["γὰρ",40,8],["ζῆλος",1164,5],["καὶ",2,8],["ἐριθεία",10828,13],["ἐκεῖ",76,17],["ἀκαταστασία",6235,13],["καὶ",2,8],["πᾶν",11,28],["φαῦλον",2972,28],["πρᾶγμα",511,20]],"For where jealousy and selfish ambition are, there is confusion and every evil deed."],["17",[["Ἡ",1,11],["δὲ",14,8],["ἄνωθεν",1605,17],["σοφία",242,13],["πρῶτον",315,29],["μὲν",281,12],["ἁγνή",2814,15],["ἐστιν",10,87],["ἔπειτα",6560,17],["εἰρηνική",935,15],["ἐπιεικής",3741,15],["εὐπειθής",7179,15],["μεστὴ",4306,15],["ἐλέους",183,24],["καὶ",2,8],["καρπῶν",448,77],["ἀγαθῶν",114,163],["ἀδιάκριτος",8753,15],["ἀνυπόκριτος",6289,15]],"But the wisdom that is from above is first pure, then peaceful, gentle, reasonable, full of mercy and good fruits, without partiality, and without hypocrisy."],["18",[["καρπὸς",448,5],["δὲ",14,8],["δικαιοσύνης",187,19],["ἐν",4,1],["εἰρήνῃ",213,2],["σπείρεται",793,449],["τοῖς",1,138],["ποιοῦσιν",23,352],["εἰρήνην",213,10]],"Now the fruit of righteousness is sown in peace by those who make peace."]]