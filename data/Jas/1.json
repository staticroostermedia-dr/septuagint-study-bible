[["1",[["Ἰάκωβος",10019,5],["θεοῦ",20,21],["καὶ",2,8],["κυρίου",7,21],["Ἰησοῦ",211,21],["Χριστοῦ",1072,21],["δοῦλος",136,5],["ταῖς",1,70],["δώδεκα",556,372],["φυλαῖς",142,71],["ταῖς",1,70],["ἐν",4,1],["τῇ",1,95],["διασπορᾷ",3048,2],["χαίρειν",698,54]],"James, a servant of God and of the Lord Jesus Christ, to the twelve tribes which are in the Dispersion: Greetings."],["2",[["Πᾶσαν",11,37],["χαρὰν",1125,10],["ἡγήσασθε",378,771],["ἀδελφοί",67,396],["μου",9994,146],["ὅταν",319,8],["πειρασμοῖς",2281,139],["περιπέσητε",3110,118],["ποικίλοις",1558,215]],"Count it all joy, my brothers, when you fall into various temptations,"],["3",[["γινώσκοντες",79,137],["ὅτι",19,8],["τὸ",1,27],["δοκίμιον",5582,20],["ὑμῶν",5,136],["τῆς",1,18],["πίστεως",887,19],["κατεργάζεται",3067,728],["ὑπομονήν",1616,10]],"knowing that the testing of your faith produces endurance."],["4",[["ἡ",1,11],["δὲ",14,8],["ὑπομονὴ",1616,13],["ἔργον",105,33],["τέλειον",1919,29],["ἐχέτω",124,35],["ἵνα",102,8],["ἦτε",10,362],["τέλειοι",1919,130],["καὶ",2,8],["ὁλόκληροι",3221,130],["ἐν",4,1],["μηδενὶ",908,34],["λειπόμενοι",3581,520]],"Let endurance have its perfect work, that you may be perfect and complete, lacking in nothing."],["5",[["εἰ",77,8],["δέ",14,8],["τις",39,150],["ὑμῶν",5,136],["λείπεται",3581,506],["σοφίας",242,19],["αἰτείτω",617,35],["παρὰ",73,1],["τοῦ",1,30],["διδόντος",33,143],["θεοῦ",20,21],["πᾶσιν",11,215],["ἁπλῶς",5255,17],["καὶ",2,8],["μὴ",25,12],["ὀνειδίζοντος",945,143],["καὶ",2,8],["δοθήσεται",33,125],["αὐτῷ",3,49]],"But if any of you lacks wisdom, let him ask of God, who gives to all liberally and without reproach, and it will be given to him."],["6",[["αἰτείτω",617,35],["δὲ",14,8],["ἐν",4,1],["πίστει",887,2],["μηδὲν",908,29],["διακρινόμενος",1506,406],["ὁ",1,4],["γὰρ",40,8],["διακρινόμενος",1506,406],["ἔοικεν",11353,165],["κλύδωνι",2904,113],["θαλάσσης",137,19],["ἀνεμιζομένῳ",11354,888],["καὶ",2,8],["ῥιπιζομένῳ",11355,888]],"But let him ask in faith, without any doubting, for he who doubts is like a wave of the sea, driven by the wind and tossed."],["7",[["μὴ",25,12],["γὰρ",40,8],["οἰέσθω",1904,859],["ὁ",1,4],["ἄνθρωπος",43,5],["ἐκεῖνος",80,112],["ὅτι",19,8],["λήμψεταί",46,718],["τι",39,119],["παρὰ",73,1],["τοῦ",1,30],["κυρίου",7,21]],"For that man shouldn’t think that he will receive anything from the Lord."],["8",[["ἀνὴρ",38,5],["δίψυχος",11356,16],["ἀκατάστατος",8773,16],["ἐν",4,1],["πάσαις",11,287],["ταῖς",1,70],["ὁδοῖς",68,71],["αὐτοῦ",3,48]],"He is a double-minded man, unstable in all his ways."],["9",[["καυχάσθω",1380,859],["δὲ",14,8],["ὁ",1,4],["ἀδελφὸς",67,5],["ὁ",1,4],["ταπεινὸς",1097,16],["ἐν",4,1],["τῷ",1,52],["ὕψει",481,53],["αὐτοῦ",3,48]],"Let the brother in humble circumstances glory in his high position;"],["10",[["ὁ",1,4],["δὲ",14,8],["πλούσιος",952,16],["ἐν",4,1],["τῇ",1,95],["ταπεινώσει",1481,2],["αὐτοῦ",3,48],["ὅτι",19,8],["ὡς",36,12],["ἄνθος",1529,20],["χόρτου",1046,21],["παρελεύσεται",404,718]],"and the rich, in that he is made humble, because like the flower in the grass, he will pass away."],["11",[["ἀνέτειλεν",900,3],["γὰρ",40,8],["ὁ",1,4],["ἥλιος",323,5],["σὺν",310,1],["τῷ",1,110],["καύσωνι",2357,113],["καὶ",2,8],["ἐξήρανεν",842,3],["τὸν",1,6],["χόρτον",1046,7],["καὶ",2,8],["τὸ",1,27],["ἄνθος",1529,20],["αὐτοῦ",3,48],["ἐξέπεσεν",2315,3],["καὶ",2,8],["ἡ",1,11],["εὐπρέπεια",2171,13],["τοῦ",1,23],["προσώπου",47,24],["αὐτοῦ",3,144],["ἀπώλετο",596,26],["οὕτως",71,17],["καὶ",2,8],["ὁ",1,4],["πλούσιος",952,16],["ἐν",4,1],["ταῖς",1,70],["πορείαις",1476,71],["αὐτοῦ",3,48],["μαρανθήσεται",4303,125]],"For the sun arises with the scorching wind and withers the grass; and the flower in it falls, and the beauty of its appearance perishes. So the rich man will also fade away in his pursuits."],["12",[["μακάριος",806,16],["ἀνὴρ",38,5],["ὃς",24,246],["ὑπομένει",639,87],["πειρασμόν",2281,7],["ὅτι",19,8],["δόκιμος",3529,16],["γενόμενος",30,770],["λήμψεται",46,718],["τὸν",1,6],["στέφανον",980,7],["τῆς",1,18],["ζωῆς",216,19],["ὃν",24,106],["ἐπηγγείλατο",2536,737],["τοῖς",1,138],["ἀγαπῶσιν",214,352],["αὐτόν",3,82]],"Blessed is a person who endures temptation, for when he has been approved, he will receive the crown of life which the Lord promised to those who love him."],["13",[["Μηδεὶς",908,16],["πειραζόμενος",1094,714],["λεγέτω",31,35],["ὅτι",19,8],["ἀπὸ",17,1],["θεοῦ",20,21],["πειράζομαι",1094,572],["ὁ",1,4],["γὰρ",40,8],["θεὸς",20,5],["ἀπείραστός",11357,16],["ἐστιν",10,87],["κακῶν",161,79],["πειράζει",1094,87],["δὲ",14,8],["αὐτὸς",3,158],["οὐδένα",228,59]],"Let no man say when he is tempted, “I am tempted by God,” for God can’t be tempted by evil, and he himself tempts no one."],["14",[["ἕκαστος",171,16],["δὲ",14,8],["πειράζεται",1094,449],["ὑπὸ",122,1],["τῆς",1,18],["ἰδίας",683,78],["ἐπιθυμίας",699,19],["ἐξελκόμενος",4088,714],["καὶ",2,8],["δελεαζόμενος",11358,714]],"But each one is tempted when he is drawn away by his own lust and enticed."],["15",[["εἶτα",2450,17],["ἡ",1,11],["ἐπιθυμία",699,13],["συλλαβοῦσα",507,140],["τίκτει",251,87],["ἁμαρτίαν",119,10],["ἡ",1,11],["δὲ",14,8],["ἁμαρτία",119,13],["ἀποτελεσθεῖσα",6319,302],["ἀποκύει",9012,87],["θάνατον",170,7]],"Then the lust, when it has conceived, bears sin. The sin, when it is full grown, produces death."],["16",[["Μὴ",25,12],["πλανᾶσθε",464,809],["ἀδελφοί",67,396],["μου",9994,146],["ἀγαπητοί",1920,537]],"Don’t be deceived, my beloved brothers."],["17",[["πᾶσα",11,15],["δόσις",1766,13],["ἀγαθὴ",114,15],["καὶ",2,8],["πᾶν",11,28],["δώρημα",10848,20],["τέλειον",1919,28],["ἄνωθέν",1605,17],["ἐστιν",10,87],["καταβαῖνον",175,36],["ἀπὸ",17,1],["τοῦ",1,30],["πατρὸς",44,21],["τῶν",1,44],["φώτων",380,45],["παρ᾽",73,1],["ᾧ",24,202],["οὐκ",12,12],["ἔνι",6554,87],["παραλλαγὴ",11359,13],["ἢ",61,8],["τροπῆς",2969,19],["ἀποσκίασμα",11360,20]],"Every good gift and every perfect gift is from above, coming down from the Father of lights, with whom can be no variation nor turning shadow."],["18",[["βουληθεὶς",463,731],["ἀπεκύησεν",9012,3],["ἡμᾶς",9994,209],["λόγῳ",48,113],["ἀληθείας",352,19],["εἰς",8,1],["τὸ",1,32],["εἶναι",10135,54],["ἡμᾶς",9994,209],["ἀπαρχήν",693,10],["τινα",39,583],["τῶν",1,44],["αὐτοῦ",3,48],["κτισμάτων",3567,45]],"Of his own will he gave birth to us by the word of truth, that we should be a kind of first fruits of his creatures."],["19",[["Ἴστε",1168,651],["ἀδελφοί",67,396],["μου",9994,146],["ἀγαπητοί",1920,537],["ἔστω",10,35],["δὲ",14,8],["πᾶς",11,16],["ἄνθρωπος",43,5],["ταχὺς",2121,16],["εἰς",8,1],["τὸ",1,32],["ἀκοῦσαι",54,100],["βραδὺς",10436,16],["εἰς",8,1],["τὸ",1,32],["λαλῆσαι",50,100],["βραδὺς",10436,16],["εἰς",8,1],["ὀργήν",198,10]],"So, then, my beloved brothers, let every man be swift to hear, slow to speak, and slow to anger;"],["20",[["ὀργὴ",198,13],["γὰρ",40,8],["ἀνδρὸς",38,21],["δικαιοσύνην",187,10],["θεοῦ",20,21],["οὐκ",12,12]],"for the anger of man doesn’t produce the righteousness of God."],["21",[["διὸ",1466,8],["ἀποθέμενοι",2050,315],["πᾶσαν",11,37],["ῥυπαρίαν",11361,10],["καὶ",2,8],["περισσείαν",10850,10],["κακίας",433,19],["ἐν",4,1],["πραΰτητι",5977,2],["δέξασθε",815,771],["τὸν",1,6],["ἔμφυτον",9666,59],["λόγον",48,7],["τὸν",1,6],["δυνάμενον",185,765],["σῶσαι",172,100],["τὰς",1,39],["ψυχὰς",63,40],["ὑμῶν",5,136]],"Therefore, putting away all filthiness and overflowing of wickedness, receive with humility the implanted word, which is able to save your souls."],["22",[["Γίνεσθε",30,742],["δὲ",14,8],["ποιηταὶ",8000,51],["λόγου",48,21],["καὶ",2,8],["μὴ",25,12],["μόνον",302,29],["ἀκροαταὶ",6240,51],["παραλογιζόμενοι",2931,741],["ἑαυτούς",92,60]],"But be doers of the word, and not only hearers, deluding your own selves."],["23",[["ὅτι",19,8],["εἴ",77,8],["τις",39,150],["ἀκροατὴς",6240,5],["λόγου",48,21],["ἐστὶν",10,87],["καὶ",2,8],["οὐ",12,12],["ποιητής",8000,5],["οὗτος",16,112],["ἔοικεν",11353,165],["ἀνδρὶ",38,113],["κατανοοῦντι",1549,390],["τὸ",1,32],["πρόσωπον",47,33],["τῆς",1,18],["γενέσεως",959,19],["αὐτοῦ",3,48],["ἐν",4,1],["ἐσόπτρῳ",6564,53]],"For if anyone is a hearer of the word and not a doer, he is like a man looking at his natural face in a mirror;"],["24",[["κατενόησεν",1549,3],["γὰρ",40,8],["ἑαυτὸν",92,82],["καὶ",2,8],["ἀπελήλυθεν",297,165],["καὶ",2,8],["εὐθέως",1673,17],["ἐπελάθετο",3006,737],["ὁποῖος",9837,150],["ἦν",10,14]],"for he sees himself, and goes away, and immediately forgets what kind of man he was."],["25",[["ὁ",1,4],["δὲ",14,8],["παρακύψας",3103,155],["εἰς",8,1],["νόμον",140,7],["τέλειον",1919,59],["τὸν",1,6],["τῆς",1,18],["ἐλευθερίας",3427,19],["καὶ",2,8],["παραμείνας",3104,155],["οὐκ",12,12],["ἀκροατὴς",6240,5],["ἐπιλησμονῆς",9524,19],["γενόμενος",30,770],["ἀλλὰ",108,8],["ποιητὴς",8000,5],["ἔργου",105,24],["οὗτος",16,112],["μακάριος",806,16],["ἐν",4,1],["τῇ",1,95],["ποιήσει",23,120],["αὐτοῦ",3,48],["ἔσται",10,718]],"But he who looks into the perfect law of freedom and continues, not being a hearer who forgets but a doer of the work, this man will be blessed in what he does."],["26",[["Εἴ",77,8],["τις",39,150],["δοκεῖ",801,87],["θρησκὸς",11362,16],["εἶναι",10135,54],["μὴ",25,12],["χαλιναγωγῶν",11363,67],["γλῶσσαν",388,10],["αὐτοῦ",3,48],["ἀλλ᾽",108,8],["ἀπατῶν",1291,67],["καρδίαν",64,10],["αὐτοῦ",3,48],["τούτου",16,126],["μάταιος",654,15],["ἡ",1,11],["θρησκεία",4242,13]],"If anyone among you thinks himself to be religious while he doesn’t bridle his tongue, but deceives his heart, this man’s religion is worthless."],["27",[["θρησκεία",4242,13],["καθαρὰ",379,15],["καὶ",2,8],["ἀμίαντος",4017,15],["παρὰ",73,1],["τῷ",1,110],["θεῷ",20,113],["καὶ",2,8],["πατρὶ",44,113],["αὕτη",16,101],["ἐστίν",10,87],["ἐπισκέπτεσθαι",375,749],["ὀρφανοὺς",957,58],["καὶ",2,8],["χήρας",751,40],["ἐν",4,1],["τῇ",1,95],["θλίψει",438,2],["αὐτῶν",3,41],["ἄσπιλον",11240,59],["ἑαυτὸν",92,82],["τηρεῖν",1358,54],["ἀπὸ",17,1],["τοῦ",1,30],["κόσμου",743,21]],"Pure religion and undefiled before our God and Father is this: to visit the fatherless and widows in their affliction, and to keep oneself unstained by the world."]]