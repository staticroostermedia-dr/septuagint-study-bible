[["1",[["Ἄγε",224,239],["νῦν",90,17],["οἱ",1,538],["πλούσιοι",952,537],["κλαύσατε",412,69],["ὀλολύζοντες",1872,137],["ἐπὶ",9,1],["ταῖς",1,70],["ταλαιπωρίαις",1448,71],["ὑμῶν",5,136],["ταῖς",1,70],["ἐπερχομέναις",542,941]],"Come now, you rich, weep and howl for your miseries that are coming on you."],["2",[["ὁ",1,4],["πλοῦτος",574,5],["ὑμῶν",5,136],["σέσηπεν",3142,165],["καὶ",2,8],["τὰ",1,253],["ἱμάτια",276,63],["ὑμῶν",5,136],["σητόβρωτα",8224,74],["γέγονεν",30,165]],"Your riches are corrupted and your garments are moth-eaten."],["3",[["ὁ",1,4],["χρυσὸς",1602,5],["ὑμῶν",5,136],["καὶ",2,8],["ὁ",1,4],["ἄργυρος",2819,5],["κατίωται",7430,722],["καὶ",2,8],["ὁ",1,4],["ἰὸς",10836,5],["αὐτῶν",3,41],["εἰς",8,1],["μαρτύριον",225,33],["ὑμῖν",5,86],["ἔσται",10,718],["καὶ",2,8],["φάγεται",147,89],["τὰς",1,39],["σάρκας",287,40],["ὑμῶν",5,136],["ὡς",36,12],["πῦρ",118,20],["ἐθησαυρίσατε",2351,262],["ἐν",4,1],["ἐσχάταις",410,287],["ἡμέραις",28,71]],"Your gold and your silver are corroded, and their corrosion will be for a testimony against you and will eat your flesh like fire. You have laid up your treasure in the last days."],["4",[["ἰδοὺ",51,316],["ὁ",1,4],["μισθὸς",816,5],["τῶν",1,76],["ἐργατῶν",4617,77],["τῶν",1,76],["ἀμησάντων",2652,211],["τὰς",1,39],["χώρας",278,40],["ὑμῶν",5,136],["ὁ",1,4],["ἀπεστερημένος",3408,228],["ἀφ᾽",17,1],["ὑμῶν",5,136],["κράζει",592,87],["καὶ",2,8],["αἱ",1,185],["βοαὶ",3252,180],["τῶν",1,76],["θερισάντων",1509,211],["εἰς",8,1],["τὰ",1,42],["ὦτα",328,43],["κυρίου",7,21],["σαβαὼθ",809,77],["εἰσεληλύθασιν",86,400]],"Behold, the wages of the laborers who mowed your fields, which you have kept back by fraud, cry out; and the cries of those who reaped have entered into the ears of the Lord of Armies."],["5",[["ἐτρυφήσατε",2044,262],["ἐπὶ",9,1],["τῆς",1,18],["γῆς",26,19],["καὶ",2,8],["ἐσπαταλήσατε",6061,262],["ἐθρέψατε",1743,262],["τὰς",1,39],["καρδίας",64,40],["ὑμῶν",5,136],["ἐν",4,1],["ἡμέρᾳ",28,2],["σφαγῆς",1742,19]],"You have lived in luxury on the earth, and taken your pleasure. You have nourished your hearts as in a day of slaughter."],["6",[["κατεδικάσατε",2582,262],["ἐφονεύσατε",970,262],["τὸν",1,6],["δίκαιον",153,59],["οὐκ",12,12],["ἀντιτάσσεται",3163,506],["ὑμῖν",5,86]],"You have condemned and you have murdered the righteous one. He doesn’t resist you."],["7",[["Μακροθυμήσατε",2917,69],["οὖν",227,8],["ἀδελφοί",67,396],["ἕως",42,1],["τῆς",1,18],["παρουσίας",4349,19],["τοῦ",1,30],["κυρίου",7,21],["ἰδοὺ",51,316],["ὁ",1,4],["γεωργὸς",2701,5],["ἐκδέχεται",2415,728],["τὸν",1,6],["τίμιον",1189,59],["καρπὸν",448,7],["τῆς",1,18],["γῆς",26,19],["μακροθυμῶν",2917,67],["ἐπ᾽",9,1],["αὐτῷ",3,49],["ἕως",42,1],["λάβῃ",46,160],["πρόϊμον",3124,59],["καὶ",2,8],["ὄψιμον",3476,59]],"Be patient therefore, brothers, until the coming of the Lord. Behold, the farmer waits for the precious fruit of the earth, being patient over it, until it receives the early and late rain."],["8",[["μακροθυμήσατε",2917,69],["καὶ",2,8],["ὑμεῖς",5,208],["στηρίξατε",979,69],["τὰς",1,39],["καρδίας",64,40],["ὑμῶν",5,136],["ὅτι",19,8],["ἡ",1,11],["παρουσία",4349,13],["τοῦ",1,30],["κυρίου",7,21],["ἤγγικεν",455,165]],"You also be patient. Establish your hearts, for the coming of the Lord is at hand."],["9",[["μὴ",25,12],["στενάζετε",1445,307],["ἀδελφοί",67,396],["κατ᾽",32,1],["ἀλλήλων",1192,41],["ἵνα",102,8],["μὴ",25,12],["κριθῆτε",263,485],["ἰδοὺ",51,316],["ὁ",1,4],["κριτὴς",749,5],["πρὸ",238,1],["τῶν",1,123],["θυρῶν",277,61],["ἕστηκεν",78,165]],"Don’t grumble, brothers, against one another, so that you won’t be judged. Behold, the judge stands at the door."],["10",[["ὑπόδειγμα",4142,33],["λάβετε",46,69],["ἀδελφοί",67,396],["τῆς",1,18],["κακοπαθείας",4248,19],["καὶ",2,8],["τῆς",1,18],["μακροθυμίας",3887,19],["τοὺς",1,56],["προφήτας",176,31],["οἳ",24,455],["ἐλάλησαν",50,141],["ἐν",4,1],["τῷ",1,52],["ὀνόματι",57,53],["κυρίου",7,21]],"Take, brothers, for an example of suffering and of perseverance, the prophets who spoke in the name of the Lord."],["11",[["ἰδοὺ",51,316],["μακαρίζομεν",1681,241],["τοὺς",1,56],["ὑπομείναντας",639,458],["τὴν",1,9],["ὑπομονὴν",1616,10],["Ἰὼβ",813,21],["ἠκούσατε",54,262],["καὶ",2,8],["τὸ",1,32],["τέλος",373,33],["κυρίου",7,21],["εἴδετε",112,262],["ὅτι",19,8],["πολύσπλαγχνός",11375,16],["ἐστιν",10,87],["ὁ",1,4],["κύριος",7,5],["καὶ",2,8],["οἰκτίρμων",2102,16]],"Behold, we call them blessed who endured. You have heard of the perseverance of Job and have seen the Lord in the outcome, and how the Lord is full of compassion and mercy."],["12",[["Πρὸ",238,1],["πάντων",11,79],["δέ",14,8],["ἀδελφοί",67,396],["μου",9994,146],["μὴ",25,12],["ὀμνύετε",347,307],["μήτε",2098,8],["τὸν",1,6],["οὐρανὸν",94,7],["μήτε",2098,8],["τὴν",1,9],["γῆν",26,10],["μήτε",2098,8],["ἄλλον",584,59],["τινὰ",39,365],["ὅρκον",946,7],["ἤτω",10,35],["δὲ",14,8],["ὑμῶν",5,136],["τὸ",1,27],["ναὶ",3597,12],["ναὶ",3597,12],["καὶ",2,8],["τὸ",1,27],["οὒ",12,12],["οὔ",12,12],["ἵνα",102,8],["μὴ",25,12],["ὑπὸ",122,1],["κρίσιν",229,10],["πέσητε",154,118]],"But above all things, my brothers, don’t swear—not by heaven, or by the earth, or by any other oath; but let your “yes” be “yes”, and your “no”, “no”, so that you don’t fall into hypocrisy."],["13",[["Κακοπαθεῖ",7302,87],["τις",39,150],["ἐν",4,1],["ὑμῖν",5,86],["προσευχέσθω",551,859],["εὐθυμεῖ",10784,87],["τις",39,150],["ψαλλέτω",913,35]],"Is any among you suffering? Let him pray. Is any cheerful? Let him sing praises."],["14",[["ἀσθενεῖ",771,87],["τις",39,150],["ἐν",4,1],["ὑμῖν",5,86],["προσκαλεσάσθω",1595,792],["τοὺς",1,56],["πρεσβυτέρους",332,31],["τῆς",1,18],["ἐκκλησίας",563,19],["καὶ",2,8],["προσευξάσθωσαν",551,955],["ἐπ᾽",9,1],["αὐτὸν",3,82],["ἀλείψαντες",1922,190],["αὐτὸν",3,82],["ἐλαίῳ",313,53],["ἐν",4,1],["τῷ",1,52],["ὀνόματι",57,53],["τοῦ",1,30],["κυρίου",7,21]],"Is any among you sick? Let him call for the elders of the assembly, and let them pray over him, anointing him with oil in the name of the Lord;"],["15",[["καὶ",2,8],["ἡ",1,11],["εὐχὴ",633,13],["τῆς",1,18],["πίστεως",887,19],["σώσει",172,120],["τὸν",1,6],["κάμνοντα",3571,178],["καὶ",2,8],["ἐγερεῖ",746,120],["αὐτὸν",3,82],["ὁ",1,4],["κύριος",7,5],["κἂν",10160,8],["ἁμαρτίας",119,40],["ᾖ",10,173],["πεποιηκώς",23,264],["ἀφεθήσεται",501,125],["αὐτῷ",3,49]],"and the prayer of faith will heal him who is sick, and the Lord will raise him up. If he has committed sins, he will be forgiven."],["16",[["ἐξομολογεῖσθε",479,852],["οὖν",227,8],["ἀλλήλοις",1192,142],["τὰς",1,39],["ἁμαρτίας",119,40],["καὶ",2,8],["εὔχεσθε",670,742],["ὑπὲρ",139,1],["ἀλλήλων",1192,41],["ὅπως",240,8],["ἰαθῆτε",797,485],["πολὺ",74,29],["ἰσχύει",567,87],["δέησις",677,13],["δικαίου",153,153],["ἐνεργουμένη",3432,616]],"Confess your sins to one another and pray for one another, that you may be healed. The insistent prayer of a righteous person is powerfully effective."],["17",[["Ἠλίας",4120,5],["ἄνθρωπος",43,5],["ἦν",10,14],["ὁμοιοπαθὴς",6622,16],["ἡμῖν",9994,86],["καὶ",2,8],["προσευχῇ",550,2],["προσηύξατο",551,737],["τοῦ",1,23],["μὴ",25,12],["βρέξαι",2163,100],["καὶ",2,8],["οὐκ",12,12],["ἔβρεξεν",2163,3],["ἐπὶ",9,1],["τῆς",1,18],["γῆς",26,19],["ἐνιαυτοὺς",400,31],["τρεῖς",174,58],["καὶ",2,8],["μῆνας",10294,31],["ἕξ",531,372]],"Elijah was a man with a nature like ours, and he prayed earnestly that it might not rain, and it didn’t rain on the earth for three years and six months."],["18",[["καὶ",2,8],["πάλιν",655,17],["προσηύξατο",551,737],["καὶ",2,8],["ὁ",1,4],["οὐρανὸς",94,5],["ὑετὸν",676,7],["ἔδωκεν",33,3],["καὶ",2,8],["ἡ",1,11],["γῆ",26,13],["ἐβλάστησεν",2700,3],["τὸν",1,6],["καρπὸν",448,7],["αὐτῆς",3,83]],"He prayed again, and the sky gave rain, and the earth produced its fruit."],["19",[["Ἀδελφοί",67,396],["μου",9994,146],["ἐάν",45,8],["τις",39,150],["ἐν",4,1],["ὑμῖν",5,86],["πλανηθῇ",464,333],["ἀπὸ",17,1],["τῆς",1,18],["ἀληθείας",352,19],["καὶ",2,8],["ἐπιστρέψῃ",117,160],["τις",39,150],["αὐτόν",3,82]],"Brothers, if any among you wanders from the truth and someone turns him back,"],["20",[["γινωσκέτω",79,35],["ὅτι",19,8],["ὁ",1,4],["ἐπιστρέψας",117,155],["ἁμαρτωλὸν",409,59],["ἐκ",21,1],["πλάνης",3622,19],["ὁδοῦ",68,19],["αὐτοῦ",3,48],["σώσει",172,120],["ψυχὴν",63,10],["αὐτοῦ",3,48],["ἐκ",21,1],["θανάτου",170,21],["καὶ",2,8],["καλύψει",620,120],["πλῆθος",200,33],["ἁμαρτιῶν",119,61]],"let him know that he who turns a sinner from the error of his way will save a soul from death and will cover a multitude of sins."]]