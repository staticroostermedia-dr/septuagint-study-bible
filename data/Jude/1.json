[["1",[["Ἰούδας",62,5],["Ἰησοῦ",211,21],["Χριστοῦ",1072,21],["δοῦλος",136,5],["ἀδελφὸς",67,5],["δὲ",14,8],["Ἰακώβου",10019,21],["τοῖς",1,138],["ἐν",4,1],["θεῷ",20,113],["πατρὶ",44,113],["ἠγαπημένοις",214,804],["καὶ",2,8],["Ἰησοῦ",211,113],["Χριστῷ",1072,113],["τετηρημένοις",1358,804],["κλητοῖς",1893,215]],"Jude, a servant of Jesus Christ, and brother of James, to those who are called, sanctified by God the Father, and kept for Jesus Christ:"],["2",[["ἔλεος",183,20],["ὑμῖν",5,86],["καὶ",2,8],["εἰρήνη",213,13],["καὶ",2,8],["ἀγάπη",1982,13],["πληθυνθείη",316,544]],"May mercy, peace, and love be multiplied to you."],["3",[["Ἀγαπητοί",1920,537],["πᾶσαν",11,37],["σπουδὴν",1387,10],["ποιούμενος",23,406],["γράφειν",186,54],["ὑμῖν",5,86],["περὶ",72,1],["τῆς",1,18],["κοινῆς",1515,78],["ἡμῶν",9994,136],["σωτηρίας",425,19],["ἀνάγκην",1126,10],["ἔσχον",124,147],["γράψαι",186,100],["ὑμῖν",5,86],["παρακαλῶν",434,67],["ἐπαγωνίζεσθαι",11443,749],["τῇ",1,95],["ἅπαξ",1315,17],["παραδοθείσῃ",254,571],["τοῖς",1,138],["ἁγίοις",75,215],["πίστει",887,2]],"Beloved, while I was very eager to write to you about our common salvation, I was constrained to write to you exhorting you to contend earnestly for the faith which was once for all delivered to the saints."],["4",[["παρεισέδυσαν",11444,141],["γάρ",40,8],["τινες",39,402],["ἄνθρωποι",43,51],["οἱ",1,128],["πάλαι",3345,17],["προγεγραμμένοι",8048,574],["εἰς",8,1],["τοῦτο",16,122],["τὸ",1,32],["κρίμα",267,33],["ἀσεβεῖς",247,130],["τὴν",1,9],["τοῦ",1,30],["θεοῦ",20,21],["ἡμῶν",9994,136],["χάριτα",368,10],["μετατιθέντες",2027,137],["εἰς",8,1],["ἀσέλγειαν",6347,10],["καὶ",2,8],["τὸν",1,6],["μόνον",302,59],["δεσπότην",1014,7],["καὶ",2,8],["κύριον",7,7],["ἡμῶν",9994,136],["Ἰησοῦν",211,7],["Χριστὸν",1072,7],["ἀρνούμενοι",3710,741]],"For there are certain men who crept in secretly, even those who were long ago written about for this condemnation: ungodly men, turning the grace of our God into indecency, and denying our only Master, God, and Lord, Jesus Christ."],["5",[["Ὑπομνῆσαι",5423,100],["δὲ",14,8],["ὑμᾶς",5,209],["βούλομαι",463,768],["εἰδότας",1168,276],["ὑμᾶς",5,209],["πάντα",11,65],["ὅτι",19,8],["ἅπαξ",1315,17],["λαὸν",35,7],["ἐκ",21,1],["γῆς",26,19],["Αἰγύπτου",93,19],["σώσας",172,155],["τὸ",1,32],["δεύτερον",271,29],["τοὺς",1,56],["μὴ",25,12],["πιστεύσαντας",649,458],["ἀπώλεσεν",596,3]],"Now I desire to remind you, though you already know this, that the Lord, having saved a people out of the land of Egypt, afterward destroyed those who didn’t believe."],["6",[["ἀγγέλους",208,31],["τε",209,8],["τοὺς",1,56],["μὴ",25,12],["τηρήσαντας",1358,458],["τὴν",1,9],["ἑαυτῶν",92,41],["ἀρχὴν",270,10],["ἀλλ᾽",108,8],["ἀπολιπόντας",1604,458],["τὸ",1,32],["ἴδιον",683,29],["οἰκητήριον",5871,33],["εἰς",8,1],["κρίσιν",229,10],["μεγάλης",66,78],["ἡμέρας",28,19],["δεσμοῖς",1035,139],["ἀϊδίοις",6366,215],["ὑπὸ",122,1],["ζόφον",11349,7],["τετήρηκεν",1358,165]],"Angels who didn’t keep their first domain, but deserted their own dwelling place, he has kept in everlasting bonds under darkness for the judgment of the great day."],["7",[["ὡς",36,12],["Σόδομα",1179,63],["καὶ",2,8],["Γόμορρα",2692,13],["καὶ",2,8],["αἱ",1,185],["περὶ",72,1],["αὐτὰς",3,221],["πόλεις",41,180],["τὸν",1,6],["ὅμοιον",657,59],["τρόπον",245,7],["τούτοις",16,193],["ἐκπορνεύσασαι",1084,399],["καὶ",2,8],["ἀπελθοῦσαι",297,399],["ὀπίσω",167,1],["σαρκὸς",287,19],["ἑτέρας",253,78],["πρόκεινται",2763,756],["δεῖγμα",11445,33],["πυρὸς",118,24],["αἰωνίου",391,88],["δίκην",1219,10],["ὑπέχουσαι",5425,301]],"Even as Sodom and Gomorrah and the cities around them, having in the same way as these given themselves over to sexual immorality and gone after strange flesh, are shown as an example, suffering the punishment of eternal fire."],["8",[["ὁμοίως",1757,17],["μέντοι",3905,8],["καὶ",2,8],["οὗτοι",16,213],["ἐνυπνιαζόμενοι",1992,741],["σάρκα",287,10],["μὲν",281,12],["μιαίνουσιν",468,191],["κυριότητα",11078,10],["δὲ",14,8],["ἀθετοῦσιν",834,191],["δόξας",141,40],["δὲ",14,8],["βλασφημοῦσιν",3250,191]],"Yet in the same way, these also in their dreaming defile the flesh, despise authority, and slander celestial beings."],["9",[["ὁ",1,4],["δὲ",14,8],["Μιχαὴλ",2333,5],["ὁ",1,4],["ἀρχάγγελος",11172,5],["ὅτε",432,8],["τῷ",1,110],["διαβόλῳ",1720,111],["διακρινόμενος",1506,406],["διελέγετο",3259,721],["περὶ",72,1],["τοῦ",1,23],["Μωϋσέως",5453,21],["σώματος",454,24],["οὐκ",12,12],["ἐτόλμησεν",3371,3],["κρίσιν",229,10],["ἐπενεγκεῖν",2144,100],["βλασφημίας",3505,19],["ἀλλ᾽",108,8],["εἶπεν",31,3],["ἐπιτιμήσαι",2318,216],["σοι",5,151],["κύριος",7,5]],"But Michael, the archangel, when contending with the devil and arguing about the body of Moses, dared not bring against him an abusive condemnation, but said, “May the Lord rebuke you!”"],["10",[["οὗτοι",16,213],["δὲ",14,8],["ὅσα",103,755],["μὲν",281,12],["οὐκ",12,12],["οἴδασιν",1168,400],["βλασφημοῦσιν",3250,191],["ὅσα",103,755],["δὲ",14,8],["φυσικῶς",11446,17],["ὡς",36,12],["τὰ",1,253],["ἄλογα",3178,74],["ζῷα",7225,63],["ἐπίστανται",1087,756],["ἐν",4,1],["τούτοις",16,416],["φθείρονται",2199,507]],"But these speak evil of whatever things they don’t know. They are destroyed in these things that they understand naturally, like the creatures without reason."],["11",[["οὐαὶ",769,316],["αὐτοῖς",3,142],["ὅτι",19,8],["τῇ",1,95],["ὁδῷ",68,2],["τοῦ",1,30],["Κάϊν",2006,21],["ἐπορεύθησαν",49,725],["καὶ",2,8],["τῇ",1,95],["πλάνῃ",3622,2],["τοῦ",1,30],["Βαλαὰμ",799,21],["μισθοῦ",816,21],["ἐξεχύθησαν",436,94],["καὶ",2,8],["τῇ",1,95],["ἀντιλογίᾳ",1851,2],["τοῦ",1,30],["Κόρε",11447,21],["ἀπώλοντο",596,184]],"Woe to them! For they went in the way of Cain, and ran riotously in the error of Balaam for hire, and perished in Korah’s rebellion."],["12",[["Οὗτοί",16,213],["εἰσιν",10,191],["οἱ",1,128],["ἐν",4,1],["ταῖς",1,70],["ἀγάπαις",1982,71],["ὑμῶν",5,136],["σπιλάδες",11448,180],["συνευωχούμενοι",11424,741],["ἀφόβως",6363,17],["ἑαυτοὺς",92,60],["ποιμαίνοντες",953,137],["νεφέλαι",444,180],["ἄνυδροι",1701,187],["ὑπὸ",122,1],