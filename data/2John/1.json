[["1",[["Ὁ",1,4],["πρεσβύτερος",332,5],["ἐκλεκτῇ",552,96],["κυρίᾳ",11439,2],["καὶ",2,8],["τοῖς",1,91],["τέκνοις",192,92],["αὐτῆς",3,83],["οὓς",24,294],["ἐγὼ",6,156],["ἀγαπῶ",214,149],["ἐν",4,1],["ἀληθείᾳ",352,2],["καὶ",2,8],["οὐκ",12,12],["ἐγὼ",6,156],["μόνος",302,16],["ἀλλὰ",108,8],["καὶ",2,8],["πάντες",11,130],["οἱ",1,128],["ἐγνωκότες",79,263],["τὴν",1,9],["ἀλήθειαν",352,10]],"The elder, to the chosen lady and her children, whom I love in truth, and not I only, but also all those who know the truth,"],["2",[["διὰ",56,1],["τὴν",1,9],["ἀλήθειαν",352,10],["τὴν",1,9],["μένουσαν",681,73],["ἐν",4,1],["ἡμῖν",9994,86],["καὶ",2,8],["μεθ᾽",29,1],["ἡμῶν",9994,136],["ἔσται",10,718],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7]],"for the truth’s sake, which remains in us, and it will be with us forever:"],["3",[["ἔσται",10,718],["μεθ᾽",29,1],["ἡμῶν",9994,136],["χάρις",368,13],["ἔλεος",183,20],["εἰρήνη",213,13],["παρὰ",73,1],["θεοῦ",20,21],["πατρὸς",44,21],["καὶ",2,8],["παρὰ",73,1],["Ἰησοῦ",211,21],["Χριστοῦ",1072,21],["τοῦ",1,30],["υἱοῦ",13,21],["τοῦ",1,30],["πατρὸς",44,21],["ἐν",4,1],["ἀληθείᾳ",352,2],["καὶ",2,8],["ἀγάπῃ",1982,2]],"Grace, mercy, and peace will be with us, from God the Father and from the Lord Jesus Christ, the Son of the Father, in truth and love."],["4",[["Ἐχάρην",698,921],["λίαν",1898,17],["ὅτι",19,8],["εὕρηκα",101,85],["ἐκ",21,1],["τῶν",1,44],["τέκνων",192,45],["σου",5,146],["περιπατοῦντας",1327,229],["ἐν",4,1],["ἀληθείᾳ",352,2],["καθὼς",221,8],["ἐντολὴν",259,10],["ἐλάβομεν",46,285],["παρὰ",73,1],["τοῦ",1,30],["πατρός",44,21]],"I rejoice greatly that I have found some of your children walking in truth, even as we have been commanded by the Father."],["5",[["καὶ",2,8],["νῦν",90,17],["ἐρωτῶ",822,149],["σε",5,161],["κυρία",11439,356],["οὐχ",12,12],["ὡς",36,12],["ἐντολὴν",259,10],["καινὴν",728,37],["γράφων",186,67],["σοι",5,151],["ἀλλ᾽",108,8],["ἣν",24,124],["εἴχομεν",124,395],["ἀπ᾽",17,1],["ἀρχῆς",270,19],["ἵνα",102,8],["ἀγαπῶμεν",214,223],["ἀλλήλους",1192,60]],"Now I beg you, dear lady, not as though I wrote to you a new commandment, but that which we had from the beginning, that we love one another."],["6",[["καὶ",2,8],["αὕτη",16,101],["ἐστὶν",10,87],["ἡ",1,11],["ἀγάπη",1982,13],["ἵνα",102,1],["περιπατῶμεν",1327,223],["κατὰ",32,1],["τὰς",1,39],["ἐντολὰς",259,40],["αὐτοῦ",3,48],["αὕτη",16,101],["ἡ",1,11],["ἐντολή",259,13],["ἐστιν",10,87],["καθὼς",221,8],["ἠκούσατε",54,262],["ἀπ᾽",17,1],["ἀρχῆς",270,19],["ἵνα",102,1],["ἐν",4,1],["αὐτῇ",3,99],["περιπατῆτε",1327,362]],"This is love, that we should walk according to his commandments. This is the commandment, even as you heard from the beginning, that you should walk in it."],["7",[["ὅτι",19,8],["πολλοὶ",74,130],["πλάνοι",5953,130],["ἐξῆλθον",82,141],["εἰς",8,1],["τὸν",1,6],["κόσμον",743,7],["οἱ",1,128],["μὴ",25,12],["ὁμολογοῦντες",2686,137],["Ἰησοῦν",211,7],["Χριστὸν",1072,7],["ἐρχόμενον",55,765],["ἐν",4,1],["σαρκί",287,2],["οὗτός",16,112],["ἐστιν",10,87],["ὁ",1,4],["πλάνος",5953,16],["καὶ",2,8],["ὁ",1,4],["ἀντίχριστος",11438,5]],"For many deceivers have gone out into the world, those who don’t confess that Jesus Christ came in the flesh. This is the deceiver and the Antichrist."],["8",[["βλέπετε",470,307],["ἑαυτοὺς",92,60],["ἵνα",102,8],["μὴ",25,12],["ἀπολέσητε",596,118],["ἃ",24,755],["εἰργασάμεθα",467,868],["ἀλλὰ",108,8],["μισθὸν",816,7],["πλήρη",490,59],["ἀπολάβητε",3704,118]],"Watch yourselves, that we don’t lose the things which we have accomplished, but that we receive a full reward."],["9",[["πᾶς",11,16],["ὁ",1,4],["προάγων",2482,67],["καὶ",2,8],["μὴ",25,12],["μένων",681,67],["ἐν",4,1],["τῇ",1,95],["διδαχῇ",7030,2],["τοῦ",1,30],["Χριστοῦ",1072,21],["θεὸν",20,7],["οὐκ",12,12],["ἔχει",124,87],["ὁ",1,4],["μένων",681,67],["ἐν",4,1],["τῇ",1,95],["διδαχῇ",7030,2],["οὗτος",16,112],["καὶ",2,8],["τὸν",1,6],["πατέρα",44,7],["καὶ",2,8],["τὸν",1,6],["υἱὸν",13,7],["ἔχει",124,87]],"Whoever transgresses and doesn’t remain in the teaching of Christ doesn’t have God. He who remains in the teaching has both the Father and the Son."],["10",[["εἴ",77,8],["τις",39,150],["ἔρχεται",55,728],["πρὸς",15,1],["ὑμᾶς",5,209],["καὶ",2,8],["ταύτην",16,234],["τὴν",1,9],["διδαχὴν",7030,10],["οὐ",12,12],["φέρει",199,87],["μὴ",25,12],["λαμβάνετε",46,307],["αὐτὸν",3,82],["εἰς",8,1],["οἰκίαν",233,10],["καὶ",2,8],["χαίρειν",698,54],["αὐτῷ",3,49],["μὴ",25,12],["λέγετε",31,307]],"If anyone comes to you and doesn’t bring this teaching, don’t receive him into your house, and don’t welcome him,"],["11",[["ὁ",1,4],["λέγων",31,67],["γὰρ",40,8],["αὐτῷ",3,49],["χαίρειν",698,54],["κοινωνεῖ",2089,87],["τοῖς",1,91],["ἔργοις",105,92],["αὐτοῦ",3,48],["τοῖς",1,91],["πονηροῖς",164,90]],"for he who welcomes him participates in his evil deeds."],["12",[["Πολλὰ",74,65],["ἔχων",124,67],["ὑμῖν",5,86],["γράφειν",186,54],["οὐκ",12,12],["ἐβουλήθην",463,921],["διὰ",56,1],["χάρτου",8709,21],["καὶ",2,8],["μέλανος",11002,24],["ἀλλ᾽",108,8],["ἐλπίζω",514,149],["γενέσθαι",30,776],["πρὸς",15,1],["ὑμᾶς",5,209],["καὶ",2,8],["στόμα",123,33],["πρὸς",15,1],["στόμα",123,33],["λαλῆσαι",50,100],["ἵνα",102,8],["ἡ",1,11],["χαρὰ",1125,13],["ἡμῶν",9994,136],["πεπληρωμένη",518,557],["ᾖ",10,173]],"Having many things to write to you, I don’t want to do so with paper and ink, but I hope to come to you and to speak face to face, that our joy may be made full."],["13",[["ἀσπάζεταί",2987,728],["σε",5,161],["τὰ",1,253],["τέκνα",192,63],["τῆς",1,18],["ἀδελφῆς",521,19],["σου",5,146],["τῆς",1,18],["ἐκλεκτῆς",552,78]],"The children of your chosen sister greet you. Amen."]]