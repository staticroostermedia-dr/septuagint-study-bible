[["1",[["Ὁ",1,4],["πρεσβύτερος",332,5],["Γαΐῳ",10689,113],["τῷ",1,110],["ἀγαπητῷ",1920,111],["ὃν",24,106],["ἐγὼ",6,156],["ἀγαπῶ",214,149],["ἐν",4,1],["ἀληθείᾳ",352,2]],"The elder to Gaius the beloved, whom I love in truth."],["2",[["ἀγαπητέ",1920,309],["περὶ",72,1],["πάντων",11,79],["εὔχομαί",670,768],["σε",5,161],["εὐοδοῦσθαι",1037,634],["καὶ",2,8],["ὑγιαίνειν",1715,54],["καθὼς",221,8],["εὐοδοῦταί",1037,449],["σου",5,146],["ἡ",1,11],["ψυχή",63,13]],"Beloved, I pray that you may prosper in all things and be healthy, even as your soul prospers."],["3",[["ἐχάρην",698,921],["γὰρ",40,8],["λίαν",1898,17],["ἐρχομένων",55,762],["ἀδελφῶν",67,77],["καὶ",2,8],["μαρτυρούντων",2094,164],["σου",5,146],["τῇ",1,95],["ἀληθείᾳ",352,2],["καθὼς",221,8],["σὺ",5,156],["ἐν",4,1],["ἀληθείᾳ",352,2],["περιπατεῖς",1327,145]],"For I rejoiced greatly when brothers came and testified about your truth, even as you walk in truth."],["4",[["μειζοτέραν",66,37],["τούτων",16,214],["οὐκ",12,12],["ἔχω",124,149],["χαρὰν",1125,10],["ἵνα",102,1],["ἀκούω",54,592],["τὰ",1,42],["ἐμὰ",10146,65],["τέκνα",192,43],["ἐν",4,1],["ἀληθείᾳ",352,2],["περιπατοῦντα",1327,232]],"I have no greater joy than this: to hear about my children walking in truth."],["5",[["ἀγαπητέ",1920,309],["πιστὸν",750,29],["ποιεῖς",23,145],["ὃ",24,467],["ἐὰν",45,8],["ἐργάσῃ",467,938],["εἰς",8,1],["τοὺς",1,56],["ἀδελφοὺς",67,31],["καὶ",2,8],["τοῦτο",16,122],["ξένους",1828,58]],"Beloved, you do a faithful work in whatever you accomplish for those who are brothers and strangers."],["6",[["οἳ",24,455],["ἐμαρτύρησάν",2094,141],["σου",5,146],["τῇ",1,95],["ἀγάπῃ",1982,2],["ἐνώπιον",115,1],["ἐκκλησίας",563,19],["οὓς",24,294],["καλῶς",1273,17],["ποιήσεις",23,159],["προπέμψας",3931,155],["ἀξίως",5208,17],["τοῦ",1,30],["θεοῦ",20,21]],"They have testified about your love before the assembly. You will do well to send them forward on their journey in a way worthy of God,"],["7",[["ὑπὲρ",139,1],["γὰρ",40,8],["τοῦ",1,23],["ὀνόματος",57,24],["ἐξῆλθον",82,141],["μηδὲν",908,29],["λαμβάνοντες",46,137],["ἀπὸ",17,1],["τῶν",1,76],["ἐθνικῶν",10042,163]],"because for the sake of the Name they went out, taking nothing from the Gentiles."],["8",[["ἡμεῖς",9994,208],["οὖν",227,8],["ὀφείλομεν",2150,241],["ὑπολαμβάνειν",1009,54],["τοὺς",1,56],["τοιούτους",630,274],["ἵνα",102,8],["συνεργοὶ",6116,130],["γινώμεθα",30,873],["τῇ",1,95],["ἀληθείᾳ",352,2]],"We therefore ought to receive such, that we may be fellow workers for the truth."],["9",[["Ἔγραψά",186,147],["τι",39,119],["τῇ",1,95],["ἐκκλησίᾳ",563,2],["ἀλλ᾽",108,8],["ὁ",1,4],["φιλοπρωτεύων",11440,67],["αὐτῶν",3,41],["Διοτρέφης",11441,5],["οὐκ",12,12],["ἐπιδέχεται",1996,728],["ἡμᾶς",9994,209]],"I wrote to the assembly, but Diotrephes, who loves to be first among them, doesn’t accept what we say."],["10",[["διὰ",56,1],["τοῦτο",16,122],["ἐὰν",45,8],["ἔλθω",55,227],["ὑπομνήσω",5423,157],["αὐτοῦ",3,48],["τὰ",1,42],["ἔργα",105,43],["ἃ",24,755],["ποιεῖ",23,87],["λόγοις",48,139],["πονηροῖς",164,215],["φλυαρῶν",11442,67],["ἡμᾶς",9994,209],["καὶ",2,8],["μὴ",25,12],["ἀρκούμενος",2662,714],["ἐπὶ",9,1],["τούτοις",16,416],["οὔτε",477,8],["αὐτὸς",3,158],["ἐπιδέχεται",1996,728],["τοὺς",1,56],["ἀδελφούς",67,31],["καὶ",2,8],["τοὺς",1,56],["βουλομένους",463,729],["κωλύει",1440,87],["καὶ",2,8],["ἐκ",21,1],["τῆς",1,18],["ἐκκλησίας",563,19],["ἐκβάλλει",585,87]],"Therefore, if I come, I will call attention to his deeds which he does, unjustly accusing us with wicked words. Not content with this, he doesn’t receive the brothers himself, and those who would, he forbids and throws out of the assembly."],["11",[["Ἀγαπητέ",1920,309],["μὴ",25,12],["μιμοῦ",4311,726],["τὸ",1,32],["κακὸν",161,29],["ἀλλὰ",108,8],["τὸ",1,32],["ἀγαθόν",114,29],["ὁ",1,4],["ἀγαθοποιῶν",4007,67],["ἐκ",21,1],["τοῦ",1,30],["θεοῦ",20,21],["ἐστιν",10,87],["ὁ",1,4],["κακοποιῶν",1511,67],["οὐχ",12,12],["ἑώρακεν",112,165],["τὸν",1,6],["θεόν",20,7]],"Beloved, don’t imitate that which is evil, but that which is good. He who does good is of God. He who does evil hasn’t seen God."],["12",[["Δημητρίῳ",1029,113],["μεμαρτύρηται",2094,722],["ὑπὸ",122,1],["πάντων",11,163],["καὶ",2,8],["ὑπὸ",122,1],["αὐτῆς",3,83],["τῆς",1,18],["ἀληθείας",352,19],["καὶ",2,8],["ἡμεῖς",9994,208],["δὲ",14,8],["μαρτυροῦμεν",2094,241],["καὶ",2,8],["οἶδας",1168,172],["ὅτι",19,8],["ἡ",1,11],["μαρτυρία",2737,13],["ἡμῶν",9994,136],["ἀληθής",1923,15],["ἐστιν",10,87]],"Demetrius has the testimony of all, and of the truth itself; yes, we also testify, and you know that our testimony is true."],["13",[["Πολλὰ",74,65],["εἶχον",124,293],["γράψαι",186,100],["σοι",5,151],["ἀλλ᾽",108,8],["οὐ",12,12],["θέλω",612,149],["διὰ",56,1],["μέλανος",11002,24],["καὶ",2,8],["καλάμου",1472,21],["σοι",5,151],["γράφειν",186,54]],"I had many things to write to you, but I am unwilling to write to you with ink and pen;"],["14",[["ἐλπίζω",514,149],["δὲ",14,8],["εὐθέως",1673,17],["σε",5,161],["ἰδεῖν",112,100],["καὶ",2,8],["στόμα",123,33],["πρὸς",15,1],["στόμα",123,33],["λαλήσομεν",50,269]],"but I hope to see you soon. Then we will speak face to face. Peace be to you. The friends greet you. Greet the friends by name."],["15",[["εἰρήνη",213,13],["σοι",5,151],["ἀσπάζονταί",2987,756],["σε",5,161],["οἱ",1,128],["φίλοι",336,130],["ἀσπάζου",2987,726],["τοὺς",1,56],["φίλους",336,58],["κατ᾽",32,1],["ὄνομα",57,33]],""]]