,5,86],["καὶ",2,8],["εἰρήνη",213,13],["ἀπὸ",17,1],["θεοῦ",20,21],["πατρὸς",44,21],["ἡμῶν",9994,136],["καὶ",2,8],["κυρίου",7,21],["Ἰησοῦ",211,21],["Χριστοῦ",1072,21]],"to all who are in Rome, beloved of God, called to be saints: Grace to you and peace from God our Father and the Lord Jesus Christ."],["8",[["Πρῶτον",315,29],["μὲν",281,12],["εὐχαριστῶ",3831,149],["τῷ",1,110],["θεῷ",20,113],["μου",9994,146],["διὰ",56,1],["Ἰησοῦ",211,21],["Χριστοῦ",1072,21],["περὶ",72,1],["πάντων",11,163],["ὑμῶν",5,136],["ὅτι",19,8],["ἡ",1,11],["πίστις",887,13],["ὑμῶν",5,136],["καταγγέλλεται",5681,449],["ἐν",4,1],["ὅλῳ",235,111],["τῷ",1,110],["κόσμῳ",743,113]],"First, I thank my God through Jesus Christ for all of you, that your faith is proclaimed throughout the whole world."],["9",[["μάρτυς",875,5],["γάρ",40,8],["μού",9994,146],["ἐστιν",10,87],["ὁ",1,4],["θεός",20,5],["ᾧ",24,202],["λατρεύω",594,149],["ἐν",4,1],["τῷ",1,52],["πνεύματί",168,53],["μου",9994,146],["ἐν",4,1],["τῷ",1,52],["εὐαγγελίῳ",4222,53],["τοῦ",1,30],["υἱοῦ",13,21],["αὐτοῦ",3,48],["ὡς",36,12],["ἀδιαλείπτως",3682,17],["μνείαν",2271,10],["ὑμῶν",5,136],["ποιοῦμαι",23,700]],"For God is my witness, whom I serve in my spirit in the Good News of his Son, how unceasingly I make mention of you always in my prayers,"],["10",[["πάντοτε",6027,17],["ἐπὶ",9,1],["τῶν",1,123],["προσευχῶν",550,61],["μου",9994,146],["δεόμενος",1672,723],["εἴ",77,8],["πως",441,12],["ἤδη",916,17],["ποτὲ",458,12],["εὐοδωθήσομαι",1037,176],["ἐν",4,1],["τῷ",1,52],["θελήματι",1039,53],["τοῦ",1,30],["θεοῦ",20,21],["ἐλθεῖν",55,100],["πρὸς",15,1],["ὑμᾶς",5,209]],"requesting, if by any means now at last I may be prospered by the will of God to come to you."],["11",[["ἐπιποθῶ",2537,149],["γὰρ",40,8],["ἰδεῖν",112,100],["ὑμᾶς",5,209],["ἵνα",102,8],["τι",39,119],["μεταδῶ",3296,227],["χάρισμα",10814,33],["ὑμῖν",5,86],["πνευματικὸν",10815,29],["εἰς",8,1],["τὸ",1,32],["στηριχθῆναι",979,175],["ὑμᾶς",5,209]],"For I long to see you, that I may impart to you some spiritual gift, to the end that you may be established;"],["12",[["τοῦτο",16,344],["δέ",14,8],["ἐστιν",10,87],["συμπαρακληθῆναι",10816,175],["ἐν",4,1],["ὑμῖν",5,86],["διὰ",56,1],["τῆς",1,18],["ἐν",4,1],["ἀλλήλοις",1192,142],["πίστεως",887,19],["ὑμῶν",5,136],["τε",209,8],["καὶ",2,8],["ἐμοῦ",6,88]],"that is, that I with you may be encouraged in you, each of us by the other’s faith, both yours and mine."],["13",[["Οὐ",12,12],["θέλω",612,149],["δὲ",14,8],["ὑμᾶς",5,209],["ἀγνοεῖν",1846,54],["ἀδελφοί",67,396],["ὅτι",19,8],["πολλάκις",2947,17],["προεθέμην",2619,152],["ἐλθεῖν",55,100],["πρὸς",15,1],["ὑμᾶς",5,209],["καὶ",2,8],["ἐκωλύθην",1440,148],["ἄχρι",4062,1],["τοῦ",1,30],["δεῦρο",715,316],["ἵνα",102,8],["τινὰ",39,365],["καρπὸν",448,7],["σχῶ",124,227],["καὶ",2,8],["ἐν",4,1],["ὑμῖν",5,86],["καθὼς",221,8],["καὶ",2,8],["ἐν",4,1],["τοῖς",1,91],["λοιποῖς",523,90],["ἔθνεσιν",60,92]],"Now I don’t desire to have you unaware, brothers, that I often planned to come to you (and was hindered so far), that I might have some fruit among you also, even as among the rest of the Gentiles."],["14",[["Ἕλλησίν",2545,139],["τε",209,8],["καὶ",2,8],["βαρβάροις",3038,215],["σοφοῖς",324,215],["τε",209,8],["καὶ",2,8],["ἀνοήτοις",2810,215],["ὀφειλέτης",10046,5],["εἰμί",10,149]],"I am debtor both to Greeks and to foreigners, both to the wise and to the foolish."],["15",[["οὕτως",71,17],["τὸ",1,27],["κατ᾽",32,1],["ἐμὲ",6,161],["πρόθυμον",2483,28],["καὶ",2,8],["ὑμῖν",5,86],["τοῖς",1,138],["ἐν",4,1],["Ῥώμῃ",2240,2],["εὐαγγελίσασθαι",1817,103]],"So as much as is in me, I am eager to preach the Good News to you also who are in Rome."],["16",[["οὐ",12,12],["γὰρ",40,8],["ἐπαισχύνομαι",9469,768],["τὸ",1,32],["εὐαγγέλιον",4222,33],["δύναμις",98,13],["γὰρ",40,8],["θεοῦ",20,21],["ἐστιν",10,87],["εἰς",8,1],["σωτηρίαν",425,10],["παντὶ",11,111],["τῷ",1,110],["πιστεύοντι",649,390],["Ἰουδαίῳ",285,113],["τε",209,8],["πρῶτον",315,29],["καὶ",2,8],["Ἕλληνι",2545,113]],"For I am not ashamed of the Good News of Christ, because it is the power of God for salvation for everyone who believes, for the Jew first, and also for the Greek."],["17",[["δικαιοσύνη",187,13],["γὰρ",40,8],["θεοῦ",20,21],["ἐν",4,1],["αὐτῷ",3,233],["ἀποκαλύπτεται",652,449],["ἐκ",21,1],["πίστεως",887,19],["εἰς",8,1],["πίστιν",887,10],["καθὼς",221,8],["γέγραπται",186,722],["ὁ",1,4],["δὲ",14,8],["δίκαιος",153,16],["ἐκ",21,1],["πίστεως",887,19],["ζήσεται",107,718]],"For in it is revealed God’s righteousness from faith to faith. As it is written, “But the righteous shall live by faith.”"],["18",[["Ἀποκαλύπτεται",652,449],["γὰρ",40,8],["ὀργὴ",198,13],["θεοῦ",20,21],["ἀπ᾽",17,1],["οὐρανοῦ",94,21],["ἐπὶ",9,1],["πᾶσαν",11,37],["ἀσέβειαν",722,10],["καὶ",2,8],["ἀδικίαν",288,10],["ἀνθρώπων",43,77],["τῶν",1,76],["τὴν",1,9],["ἀλήθειαν",352,10],["ἐν",4,1],["ἀδικίᾳ",288,2],["κατεχόντων",1040,164]],"For the wrath of God is revealed from heaven against all ungodliness and unrighteousness of men who suppress the truth in unrighteousness,"],["19",[["διότι",177,8],["τὸ",1,27],["γνωστὸν",1620,28],["τοῦ",1,30],["θεοῦ",20,21],["φανερόν",1977,28],["ἐστιν",10,87],["ἐν",4,1],["αὐτοῖς",3,142],["ὁ",1,4],["θεὸς",20,5],["γὰρ",40,8],["αὐτοῖς",3,142],["ἐφανέρωσεν",8582,3]],"because that which is known of God is revealed in them, for God revealed it to them."],["20",[["τὰ",1,253],["γὰρ",40,8],["ἀόρατα",5251,74],["αὐτοῦ",3,48],["ἀπὸ",17,1],["κτίσεως",2263,19],["κόσμου",743,21],["τοῖς",1,91],["ποιήμασιν",1443,92],["νοούμενα",1383,822],["καθορᾶται",4245,449],["ἥ",1,11],["τε",209,8],["ἀΐδιος",6366,15],["αὐτοῦ",3,48],["δύναμις",98,13],["καὶ",2,8],["θειότης",7238,13],["εἰς",8,1],["τὸ",1,32],["εἶναι",10135,54],["αὐτοὺς",3,60],["ἀναπολογήτους",10817,58]],"For the invisible things of him since the creation of the world are clearly seen, being perceived through the things that are made, even his everlasting power and divinity, that they may be without excuse."],["21",[["διότι",177,8],["γνόντες",79,190],["τὸν",1,6],["θεὸν",20,7],["οὐχ",12,12],["ὡς",36,12],["θεὸν",20,7],["ἐδόξασαν",452,141],["ἢ",61,8],["ηὐχαρίστησαν",3831,141],["ἀλλ᾽",108,8],["ἐματαιώθησαν",3082,94],["ἐν",4,1],["τοῖς",1,138],["διαλογισμοῖς",1584,139],["αὐτῶν",3,41],["καὶ",2,8],["ἐσκοτίσθη",3951,38],["ἡ",1,11],["ἀσύνετος",2517,15],["αὐτῶν",3,41],["καρδία",64,13]],"Because knowing God, they didn’t glorify him as God, and didn’t give thanks, but became vain in their reasoning, and their senseless heart was darkened."],["22",[["φάσκοντες",4460,137],["εἶναι",10135,54],["σοφοὶ",324,130],["ἐμωράνθησαν",3901,94]],"Professing themselves to be wise, they became fools,"],["23",[["καὶ",2,8],["ἤλλαξαν",1172,141],["τὴν",1,9],["δόξαν",141,10],["τοῦ",1,30],["ἀφθάρτου",6389,153],["θεοῦ",20,21],["ἐν",4,1],["ὁμοιώματι",1176,53],["εἰκόνος",1136,19],["φθαρτοῦ",5120,153],["ἀνθρώπου",43,21],["καὶ",2,8],["πετεινῶν",572,45],["καὶ",2,8],["τετραπόδων",1641,79],["καὶ",2,8],["ἑρπετῶν",1107,45]],"and traded the glory of the incorruptible God for the likeness of an image of corruptible man, and of birds, four-footed animals, and creeping things."],["24",[["Διὸ",1466,8],["παρέδωκεν",254,3],["αὐτοὺς",3,60],["ὁ",1,4],["θεὸς",20,5],["ἐν",4,1],["ταῖς",1,70],["ἐπιθυμίαις",699,71],["τῶν",1,123],["καρδιῶν",64,61],["αὐτῶν",3,41],["εἰς",8,1],["ἀκαθαρσίαν",888,10],["τοῦ",1,23],["ἀτιμάζεσθαι",1400,104],["τὰ",1,42],["σώματα",454,43],["αὐτῶν",3,41],["ἐν",4,1],["αὐτοῖς",3,142]],"Therefore God also gave them up in the lusts of their hearts to uncleanness, that their bodies should be dishonored among themselves;"],["25",[["οἵτινες",457,455],["μετήλλαξαν",2465,141],["τὴν",1,9],["ἀλήθειαν",352,10],["τοῦ",1,30],["θεοῦ",20,21],["ἐν",4,1],["τῷ",1,52],["ψεύδει",1392,53],["καὶ",2,8],["ἐσεβάσθησαν",10818,720],["καὶ",2,8],["ἐλάτρευσαν",594,141],["τῇ",1,95],["κτίσει",2263,2],["παρὰ",73,1],["τὸν",1,6],["κτίσαντα",786,476],["ὅς",24,246],["ἐστιν",10,87],["εὐλογητὸς",767,16],["εἰς",8,1],["τοὺς",1,56],["αἰῶνας",100,31],["ἀμήν",3161,316]],"who exchanged the truth of God for a lie, and worshiped and served the creature rather than the Creator, who is blessed forever. Amen."],["26",[["Διὰ",56,1],["τοῦτο",16,122],["παρέδωκεν",254,3],["αὐτοὺς",3,60],["ὁ",1,4],["θεὸς",20,5],["εἰς",8,1],["πάθη",808,43],["ἀτιμίας",1049,19],["αἵ",1,185],["τε",209,8],["γὰρ",40,8],["θήλειαι",1201,187],["αὐτῶν",3,41],["μετήλλαξαν",2465,141],["τὴν",1,9],["φυσικὴν",10819,37],["χρῆσιν",4001,10],["εἰς",8,1],["τὴν",1,9],["παρὰ",73,1],["φύσιν",2974,10]],"For this reason, God gave them up to vile passions. For their women changed the natural function into that which is against nature."],["27",[["ὁμοίως",1757,17],["τε",209,8],["καὶ",2,8],["οἱ",1,128],["ἄρσενες",10150,130],["ἀφέντες",501,190],["τὴν",1,9],["φυσικὴν",10819,37],["χρῆσιν",4001,10],["τῆς",1,18],["θηλείας",1201,78],["ἐξεκαύθησαν",941,94],["ἐν",4,1],["τῇ",1,95],["ὀρέξει",3474,2],["αὐτῶν",3,41],["εἰς",8,1],["ἀλλήλους",1192,60],["ἄρσενες",10150,130],["ἐν",4,1],["ἄρσεσιν",10150,215],["τὴν",1,9],["ἀσχημοσύνην",1082,10],["κατεργαζόμενοι",3067,741],["καὶ",2,8],["τὴν",1,9],["ἀντιμισθίαν",10820,10],["ἣν",24,124],["ἔδει",1158,14],["τῆς",1,18],["πλάνης",3622,19],["αὐτῶν",3,41],["ἐν",4,1],["ἑαυτοῖς",92,142],["ἀπολαμβάνοντες",3704,137]],"Likewise also the men, leaving the natural function of the woman, burned in their lust toward one another, men doing what is inappropriate with men, and receiving in themselves the due penalty of their error."],["28",[["Καὶ",2,8],["καθὼς",221,8],["οὐκ",12,12],["ἐδοκίμασαν",1269,141],["τὸν",1,6],["θεὸν",20,7],["ἔχειν",124,54],["ἐν",4,1],["ἐπιγνώσει",3449,2],["παρέδωκεν",254,3],["αὐτοὺς",3,60],["ὁ",1,4],["θεὸς",20,5],["εἰς",8,1],["ἀδόκιμον",6231,59],["νοῦν",1442,7],["ποιεῖν",23,54],["τὰ",1,42],["μὴ",25,12],["καθήκοντα",1436,232]],"Even as they refused to have God in their knowledge, God gave them up to a reprobate mind, to do those things which are not fitting;"],["29",[["πεπληρωμένους",518,803],["πάσῃ",11,96],["ἀδικίᾳ",288,2],["πονηρίᾳ",730,2],["πλεονεξίᾳ",3332,2],["κακίᾳ",433,2],["μεστοὺς",4306,58],["φθόνου",4452,21],["φόνου",1645,21],["ἔριδος",5372,19],["δόλου",919,21],["κακοηθείας",3544,19],["ψιθυριστάς",10821,31]],"being filled with all unrighteousness, sexual immorality, wickedness, covetousness, malice; full of envy, murder, strife, deceit, evil habits, secret slanderers,"],["30",[["καταλάλους",10822,58],["θεοστυγεῖς",10823,58],["ὑβριστάς",2850,31],["ὑπερηφάνους",1109,58],["ἀλαζόνας",5172,31],["ἐφευρετὰς",10824,31],["κακῶν",161,79],["γονεῦσιν",2012,139],["ἀπειθεῖς",3404,58]],"backbiters, hateful to God, insolent, arrogant, boastful, inventors of evil things, disobedient to parents,"],["31",[["ἀσυνέτους",2517,58],["ἀσυνθέτους",4544,58],["ἀστόργους",10825,58],["ἀνελεήμονας",2402,58]],"without understanding, covenant breakers, without natural affection, unforgiving, unmerciful;"],["32",[["οἵτινες",457,455],["τὸ",1,32],["δικαίωμα",428,33],["τοῦ",1,30],["θεοῦ",20,21],["ἐπιγνόντες",431,190],["ὅτι",19,8],["οἱ",1,128],["τὰ",1,42],["τοιαῦτα",630,248],["πράσσοντες",1251,137],["ἄξιοι",1102,130],["θανάτου",170,21],["εἰσίν",10,191],["οὐ",12,12],["μόνον",302,29],["αὐτὰ",3,66],["ποιοῦσιν",23,191],["ἀλλὰ",108,8],["καὶ",2,8],["συνευδοκοῦσιν",5076,191],["τοῖς",1,138],["πράσσουσιν",1251,352]],"who, knowing the ordinance of God, that those who practice such things are worthy of death, not only do the same, but also approve of those who practice them."]]