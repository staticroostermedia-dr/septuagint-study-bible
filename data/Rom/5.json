[["1",[["Δικαιωθέντες",1115,243],["οὖν",227,8],["ἐκ",21,1],["πίστεως",887,19],["εἰρήνην",213,10],["ἔχομεν",124,241],["πρὸς",15,1],["τὸν",1,6],["θεὸν",20,7],["διὰ",56,1],["τοῦ",1,30],["κυρίου",7,21],["ἡμῶν",9994,136],["Ἰησοῦ",211,21],["Χριστοῦ",1072,21]],"Being therefore justified by faith, we have peace with God through our Lord Jesus Christ;"],["2",[["δι᾽",56,1],["οὗ",24,367],["καὶ",2,8],["τὴν",1,9],["προσαγωγὴν",10845,10],["ἐσχήκαμεν",124,311],["τῇ",1,95],["πίστει",887,2],["εἰς",8,1],["τὴν",1,9],["χάριν",368,10],["ταύτην",16,234],["ἐν",4,1],["ᾗ",24,102],["ἑστήκαμεν",78,311],["καὶ",2,8],["καυχώμεθα",1380,800],["ἐπ᾽",9,1],["ἐλπίδι",530,2],["τῆς",1,18],["δόξης",141,19],["τοῦ",1,30],["θεοῦ",20,21]],"through whom we also have our access by faith into this grace in which we stand. We rejoice in hope of the glory of God."],["3",[["οὐ",12,12],["μόνον",302,29],["δέ",14,8],["ἀλλὰ",108,8],["καὶ",2,8],["καυχώμεθα",1380,800],["ἐν",4,1],["ταῖς",1,70],["θλίψεσιν",438,71],["εἰδότες",1168,263],["ὅτι",19,8],["ἡ",1,11],["θλῖψις",438,13],["ὑπομονὴν",1616,10],["κατεργάζεται",3067,728]],"Not only this, but we also rejoice in our sufferings, knowing that suffering produces perseverance;"],["4",[["ἡ",1,11],["δὲ",14,8],["ὑπομονὴ",1616,13],["δοκιμήν",10846,10],["ἡ",1,11],["δὲ",14,8],["δοκιμὴ",10846,13],["ἐλπίδα",530,10]],"and perseverance, proven character; and proven character, hope;"],["5",[["ἡ",1,11],["δὲ",14,8],["ἐλπὶς",530,13],["οὐ",12,12],["καταισχύνει",696,87],["ὅτι",19,8],["ἡ",1,11],["ἀγάπη",1982,13],["τοῦ",1,30],["θεοῦ",20,21],["ἐκκέχυται",436,722],["ἐν",4,1],["ταῖς",1,70],["καρδίαις",64,71],["ἡμῶν",9994,136],["διὰ",56,1],["πνεύματος",168,24],["ἁγίου",75,88],["τοῦ",1,23],["δοθέντος",33,473],["ἡμῖν",9994,86]],"and hope doesn’t disappoint us, because God’s love has been poured into our hearts through the Holy Spirit who was given to us."],["6",[["ἔτι",111,17],["γὰρ",40,8],["Χριστὸς",1072,5],["ὄντων",10,164],["ἡμῶν",9994,136],["ἀσθενῶν",1854,163],["ἔτι",111,17],["κατὰ",32,1],["καιρὸν