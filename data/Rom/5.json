],["ἡ",1,11],["χάρις",368,13],["τοῦ",1,30],["θεοῦ",20,21],["καὶ",2,8],["ἡ",1,11],["δωρεὰ",1341,13],["ἐν",4,1],["χάριτι",368,2],["τῇ",1,95],["τοῦ",1,30],["ἑνὸς",58,153],["ἀνθρώπου",43,21],["Ἰησοῦ",211,21],["Χριστοῦ",1072,21],["εἰς",8,1],["τοὺς",1,56],["πολλοὺς",74,58],["ἐπερίσσευσεν",3112,3]],"But the free gift isn’t like the trespass. For if by the trespass of the one the many died, much more did the grace of God and the gift by the grace of the one man, Jesus Christ, abound to the many."],["16",[["καὶ",2,8],["οὐχ",12,12],["ὡς",36,12],["δι᾽",56,1],["ἑνὸς",58,153],["ἁμαρτήσαντος",237,513],["τὸ",1,27],["δώρημα",10848,20],["τὸ",1,27],["μὲν",281,12],["γὰρ",40,8],["κρίμα",267,20],["ἐξ",21,1],["ἑνὸς",58,88],["εἰς",8,1],["κατάκριμα",10849,33],["τὸ",1,27],["δὲ",14,8],["χάρισμα",10814,20],["ἐκ",21,1],["πολλῶν",74,79],["παραπτωμάτων",1910,45],["εἰς",8,1],["δικαίωμα",428,33]],"The gift is not as through one who sinned; for the judgment came by one to condemnation, but the free gift followed many trespasses to justification."],["17",[["Εἰ",77,8],["γὰρ",40,8],["τῷ",1,52],["τοῦ",1,30],["ἑνὸς",58,153],["παραπτώματι",1910,53],["ὁ",1,4],["θάνατος",170,5],["ἐβασίλευσεν",151,3],["διὰ",56,1],["τοῦ",1,30],["ἑνός",58,153],["πολλῷ",74,34],["μᾶλλον",1043,17],["οἱ",1,128],["τὴν",1,9],["περισσείαν",10850,10],["τῆς",1,18],["χάριτος",368,19],["καὶ",2,8],["τῆς",1,18],["δωρεᾶς",1341,19],["τῆς",1,18],["δικαιοσύνης",187,19],["λαμβάνοντες",46,137],["ἐν",4,1],["ζωῇ",216,2],["βασιλεύσουσιν",151,207],["διὰ",56,1],["τοῦ",1,30],["ἑνὸς",58,153],["Ἰησοῦ",211,21],["Χριστοῦ",1072,21]],"For if by the trespass of the one, death reigned through the one; so much more will those who receive the abundance of grace and of the gift of righteousness reign in life through the one, Jesus Christ."],["18",[["Ἄρα",985,8],["οὖν",227,8],["ὡς",36,12],["δι᾽",56,1],["ἑνὸς",58,88],["παραπτώματος",1910,24],["εἰς",8,1],["πάντας",11,58],["ἀνθρώπους",43,31],["εἰς",8,1],["κατάκριμα",10849,33],["οὕτως",71,17],["καὶ",2,8],["δι᾽",56,1],["ἑνὸς",58,88],["δικαιώματος",428,24],["εἰς",8,1],["πάντας",11,58],["ἀνθρώπους",43,31],["εἰς",8,1],["δικαίωσιν",7045,10],["ζωῆς",216,19]],"So then as through one trespass, all men were condemned; even so through one act of righteousness, all men were justified to life."],["19",[["ὥσπερ",226,8],["γὰρ",40,8],["διὰ",56,1],["τῆς",1,18],["παρακοῆς",10851,19],["τοῦ",1,30],["ἑνὸς",58,153],["ἀνθρώπου",43,21],["ἁμαρτωλοὶ",409,130],["κατεστάθησαν",314,94],["οἱ",1,128],["πολλοί",74,130],["οὕτως",71,17],["καὶ",2,8],["διὰ",56,1],["τῆς",1,18],["ὑπακοῆς",9870,19],["τοῦ",1,30],["ἑνὸς",58,153],["δίκαιοι",153,130],["κατασταθήσονται",314,135],["οἱ",1,128],["πολλοί",74,130]],"For as through the one man’s disobedience many were made sinners, even so through the obedience of the one, many will be made righteous."],["20",[["Νόμος",140,5],["δὲ",14,8],["παρεισῆλθεν",10852,3],["ἵνα",102,8],["πλεονάσῃ",1523,160],["τὸ",1,27],["παράπτωμα",1910,20],["οὗ",120,17],["δὲ",14,8],["ἐπλεόνασεν",1523,3],["ἡ",1,11],["ἁμαρτία",119,13],["ὑπερεπερίσσευσεν",10853,3],["ἡ",1,11],["χάρις",368,13]],"The law came in that the trespass might abound; but where sin abounded, grace abounded more exceedingly,"],["21",[["ἵνα",102,8],["ὥσπερ",226,8],["ἐβασίλευσεν",151,3],["ἡ",1,11],["ἁμαρτία",119,13],["ἐν",4,1],["τῷ",1,110],["θανάτῳ",170,113],["οὕτως",71,17],["καὶ",2,8],["ἡ",1,11],["χάρις",368,13],["βασιλεύσῃ",151,160],["διὰ",56,1],["δικαιοσύνης",187,19],["εἰς",8,1],["ζωὴν",216,10],["αἰώνιον",391,37],["διὰ",56,1],["Ἰησοῦ",211,21],["Χριστοῦ",1072,21],["τοῦ",1,30],["κυρίου",7,21],["ἡμῶν",9994,136]],"that as sin reigned in death, even so grace might reign through righteousness to eternal life through Jesus Christ our Lord."]]