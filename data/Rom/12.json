[["1",[["Παρακαλῶ",434,149],["οὖν",227,8],["ὑμᾶς",5,209],["ἀδελφοί",67,396],["διὰ",56,1],["τῶν",1,76],["οἰκτιρμῶν",1187,77],["τοῦ",1,30],["θεοῦ",20,21],["παραστῆσαι",595,100],["τὰ",1,42],["σώματα",454,43],["ὑμῶν",5,136],["θυσίαν",156,10],["ζῶσαν",107,73],["ἁγίαν",75,37],["εὐάρεστον",5629,37],["τῷ",1,110],["θεῷ",20,113],["τὴν",1,9],["λογικὴν",10884,37],["λατρείαν",2911,10],["ὑμῶν",5,136]],"Therefore I urge you, brothers, by the mercies of God, to present your bodies a living sacrifice, holy, acceptable to God, which is your spiritual service."],["2",[["καὶ",2,8],["μὴ",25,12],["συσχηματίζεσθε",10885,382],["τῷ",1,110],["αἰῶνι",100,113],["τούτῳ",16,286],["ἀλλὰ",108,8],["μεταμορφοῦσθε",10138,809],["τῇ",1,95],["ἀνακαινώσει",10886,2],["τοῦ",1,30],["νοὸς",1442,21],["εἰς",8,1],["τὸ",1,32],["δοκιμάζειν",1269,54],["ὑμᾶς",5,209],["τί",10010,238],["τὸ",1,27],["θέλημα",1039,20],["τοῦ",1,30],["θεοῦ",20,21],["τὸ",1,27],["ἀγαθὸν",114,28],["καὶ",2,8],["εὐάρεστον",5629,28],["καὶ",2,8],["τέλειον",1919,28]],"Don’t be conformed to this world, but be transformed by the renewing of your mind, so that you may prove what is the good, well-pleasing, and perfect will of God."],["3",[["λέγω",31,149],["γὰρ",40,8],["διὰ",56,1],["τῆς",1,18],["χάριτος",368,19],["τῆς",1,18],["δοθείσης",33,550],["μοι",9994,151],["παντὶ",11,111],["τῷ",1,110],["ὄντι",10,390],["ἐν",4,1],["ὑμῖν",5,86],["μὴ",25,12],["ὑπερφρονεῖν",5420,54],["παρ᾽",73,1],["ὃ",24,467],["δεῖ",1158,87],["φρονεῖν",2297,54],["ἀλλὰ",108,8],["φρονεῖν",2297,54],["εἰς",8,1],["τὸ",1,32],["σωφρονεῖν",10230,54],["ἑκάστῳ",171,111],["ὡς",36,12],["ὁ",1,4],["θεὸς",20,5],["ἐμέρισεν",1348,3],["μέτρον",717,33],["πίστεως",887,19]],"For I say through the grace that was given me, to everyone who is among you, not to think of yourself more highly than you ought to think; but to think reasonably, as God has apportioned to each person a measure of faith."],["4",[["καθάπερ",690,8],["γὰρ",40,8],["ἐν",4,1],["ἑνὶ",58,34],["σώματι",454,53],["πολλὰ",74,65],["μέλη",1593,43],["ἔχομεν",124,241],["τὰ",1,253],["δὲ",14,8],["μέλη",1593,63],["πάντα",11,74],["οὐ",12,12],["τὴν",1,9],["αὐτὴν",3,98],["ἔχει",124,87],["πρᾶξιν",1912,10]],"For even as we have many members in one body, and all the members don’t have the same function,"],["5",[["οὕτως",9989,17],["οἱ",1,128],["πολλοὶ",74,130],["ἓν",58,28],["σῶμά",454,20],["ἐσμεν",10,241],["ἐν",4,1],["Χριστῷ",1072,113],["τὸ",1,32],["δὲ",14,8],["καθ᾽",32,1],["εἷς",58,16],["ἀλλήλων",1192,41],["μέλη",1593,63]],"so we, who are many, are one body in Christ, and individually members of one another,"],["6",[["Ἔχοντες",124,137],["δὲ",14,8],["χαρίσματα",10814,43],["κατὰ",32,1],["τὴν",1,9],["χάριν",368,10],["τὴν",1,9],["δοθεῖσαν",33,417],["ἡμῖν",9994,86],["διάφορα",3051,65],["εἴτε",2713,8],["προφητείαν",2285,10],["κατὰ",32,1],["τὴν",1,9],["ἀναλογίαν",10887,10],["τῆς",1,18],["πίστεως",887,19]],"having gifts differing according to the grace that was given to us: if prophecy, let’s prophesy according to the proportion of our faith;"],["7",[["εἴτε",2713,8],["διακονίαν",6977,10],["ἐν",4,1],["τῇ",1,95],["διακονίᾳ",6977,2],["εἴτε",2713,8],["ὁ",1,4],["διδάσκων",545,67],["ἐν",4,1],["τῇ",1,95],["διδασκαλίᾳ",4202,2]],"or service, let’s give ourselves to service; or he who teaches, to his teaching;"],["8",[["εἴτε",2713,8],["ὁ",1,4],["παρακαλῶν",434,67],["ἐν",4,1],["τῇ",1,95],["παρακλήσει",2183,2],["ὁ",1,4],["μεταδιδοὺς",3296,67],["ἐν",4,1],["ἁπλότητι",3717,2],["ὁ",1,4],["προϊστάμενος",3340,406],["ἐν",4,1],["σπουδῇ",1387,2],["ὁ",1,4],["ἐλεῶν",10027,67],["ἐν",4,1],["ἱλαρότητι",9764,2]],"or he who exhorts, to his exhorting; he who gives, let him do it with generosity; he who rules, with diligence; he who shows mercy, with cheerfulness."],["9",[["Ἡ",1,11],["ἀγάπη",1982,13],["ἀνυπόκριτος",6289,15],["ἀποστυγοῦντες",10888,137],["τὸ",1,32],["πονηρόν",164,29],["κολλώμενοι",1246,772],["τῷ",1,52],["ἀγαθῷ",114,34]],"Let love be without hypocrisy. Abhor that which is evil. Cling to that which is good."],["10",[["τῇ",1,95],["φιλαδελφίᾳ",5121,2],["εἰς",8,1],["ἀλλήλους",1192,60],["φιλόστοργοι",6179,130],["τῇ",1,95],["τιμῇ",720,2],["ἀλλήλους",1192,60],["προηγούμενοι",2374,741]],"In love of the brothers be tenderly affectionate to one another; in honor prefer one another,"],["11",[["τῇ",1,95],["σπουδῇ",1387,2],["μὴ",25,12],["ὀκνηροί",2234,130],["τῷ",1,52],["πνεύματι",168,53],["ζέοντες",4794,137],["τῷ",1,110],["κυρίῳ",7,113],["δουλεύοντες",398,137]],"not lagging in diligence, fervent in spirit, serving the Lord,"],["12",[["τῇ",1,95],["ἐλπίδι",530,2],["χαίροντες",698,137],["τῇ",1,95],["θλίψει",438,2],["ὑπομένοντες",639,137],["τῇ",1,95],["προσευχῇ",550,2],["προσκαρτεροῦντες",5993,137]],"rejoicing in hope, enduring in troubles, continuing steadfastly in prayer,"],["13",[["ταῖς",1,70],["χρείαις",1006,71],["τῶν",1,76],["ἁγίων",75,163],["κοινωνοῦντες",2089,137],["τὴν",1,9],["φιλοξενίαν",10889,10],["διώκοντες",533,137]],"contributing to the needs of the saints, and given to hospitality."],["14",[["εὐλογεῖτε",149,307],["τοὺς",1,56],["διώκοντας",533,229],["ὑμᾶς",5,209],["εὐλογεῖτε",149,307],["καὶ",2,8],["μὴ",25,12],["καταρᾶσθε",779,742]],"Bless those who persecute you; bless, and don’t curse."],["15",[["χαίρειν",698,54],["μετὰ",29,1],["χαιρόντων",698,164],["κλαίειν",412,54],["μετὰ",29,1],["κλαιόντων",412,164]],"Rejoice with those who rejoice. Weep with those who weep."],["16",[["τὸ",1,32],["αὐτὸ",3,121],["εἰς",8,1],["ἀλλήλους",1192,60],["φρονοῦντες",2297,137],["μὴ",25,12],["τὰ",1,42],["ὑψηλὰ",289,65],["φρονοῦντες",2297,137],["ἀλλὰ",108,8],["τοῖς",1,138],["ταπεινοῖς",1097,215],["συναπαγόμενοι",8400,520],["μὴ",25,12],["γίνεσθε",30,742],["φρόνιμοι",1211,130],["παρ᾽",73,1],["ἑαυτοῖς",92,142]],"Be of the same mind one toward another. Don’t set your mind on high things, but associate with the humble. Don’t be wise in your own conceits."],["17",[["μηδενὶ",908,111],["κακὸν",161,29],["ἀντὶ",158,1],["κακοῦ",161,88],["ἀποδιδόντες",312,137],["προνοούμενοι",3338,520],["καλὰ",266,65],["ἐνώπιον",115,1],["πάντων",11,163],["ἀνθρώπων",43,77]],"Repay no one evil for evil. Respect what is honorable in the sight of all men."],["18",[["εἰ",77,8],["δυνατόν",356,28],["τὸ",1,32],["ἐξ",21,1],["ὑμῶν",5,136],["μετὰ",29,1],["πάντων",11,163],["ἀνθρώπων",43,77],["εἰρηνεύοντες",1959,137]],"If it is possible, as much as it is up to you, be at peace with all men."],["19",[["μὴ",25,12],["ἑαυτοὺς",92,60],["ἐκδικοῦντες",539,137],["ἀγαπητοί",1920,537],["ἀλλὰ",108,8],["δότε",33,69],["τόπον",99,7],["τῇ",1,95],["ὀργῇ",198,2],["γέγραπται",186,722],["γάρ",40,8],["ἐμοὶ",6,151],["ἐκδίκησις",821,13],["ἐγὼ",6,156],["ἀνταποδώσω",666,157],["λέγει",31,87],["κύριος",7,5]],"Don’t seek revenge yourselves, beloved, but give place to God’s wrath. For it is written, “Vengeance belongs to me; I will repay, says the Lord.”"],["20",[["ἀλλ᾽",108,8],["ἐὰν",45,8],["πεινᾷ",1045,173],["ὁ",1,4],["ἐχθρός",135,5],["σου",5,146],["ψώμιζε",1793,239],["αὐτόν",3,82],["ἐὰν",45,8],["διψᾷ",1161,173],["πότιζε",790,239],["αὐτόν",3,82],["τοῦτο",16,122],["γὰρ",40,8],["ποιῶν",23,67],["ἄνθρακας",1402,31],["πυρὸς",118,24],["σωρεύσεις",6132,159],["ἐπὶ",9,1],["τὴν",1,9],["κεφαλὴν",144,10],["αὐτοῦ",3,48]],"Therefore “If your enemy is hungry, feed him. If he is thirsty, give him a drink; for in doing so, you will heap coals of fire on his head.”"],["21",[["μὴ",25,12],["νικῶ",1441,848],["ὑπὸ",122,1],["τοῦ",1,23],["κακοῦ",161,88],["ἀλλὰ",108,8],["νίκα",1441,239],["ἐν",4,1],["τῷ",1,52],["ἀγαθῷ",114,34],["τὸ",1,32],["κακόν",161,29]],"Don’t be overcome by evil, but overcome evil with good."]]