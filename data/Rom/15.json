,[["εὐδόκησαν",906,141],["γὰρ",40,8],["Μακεδονία",10620,13],["καὶ",2,8],["Ἀχαΐα",9249,13],["κοινωνίαν",4860,10],["τινὰ",39,583],["ποιήσασθαι",23,103],["εἰς",8,1],["τοὺς",1,56],["πτωχοὺς",497,31],["τῶν",1,76],["ἁγίων",75,163],["τῶν",1,76],["ἐν",4,1],["Ἰερουσαλήμ",823,2]],"For it has been the good pleasure of Macedonia and Achaia to make a certain contribution for the poor among the saints who are at Jerusalem."],["27",[["εὐδόκησαν",906,141],["γάρ",40,8],["καὶ",2,8],["ὀφειλέται",10046,51],["εἰσὶν",10,191],["αὐτῶν",3,41],["εἰ",77,8],["γὰρ",40,8],["τοῖς",1,91],["πνευματικοῖς",10815,90],["αὐτῶν",3,41],["ἐκοινώνησαν",2089,141],["τὰ",1,253],["ἔθνη",60,63],["ὀφείλουσιν",2150,191],["καὶ",2,8],["ἐν",4,1],["τοῖς",1,91],["σαρκικοῖς",10902,90],["λειτουργῆσαι",534,100],["αὐτοῖς",3,142]],"Yes, it has been their good pleasure, and they are their debtors. For if the Gentiles have been made partakers of their spiritual things, they owe it to them also to serve them in material things."],["28",[["τοῦτο",16,122],["οὖν",227,8],["ἐπιτελέσας",1706,155],["καὶ",2,8],["σφραγισάμενος",1480,244],["αὐτοῖς",3,142],["τὸν",1,6],["καρπὸν",448,7],["τοῦτον",16,259],["ἀπελεύσομαι",297,775],["δι᾽",56,1],["ὑμῶν",5,136],["εἰς",8,1],["Σπανίαν",10901,10]],"When therefore I have accomplished this, and have sealed to them this fruit, I will go on by way of you to Spain."],["29",[["οἶδα",1168,85],["δὲ",14,8],["ὅτι",19,8],["ἐρχόμενος",55,723],["πρὸς",15,1],["ὑμᾶς",5,209],["ἐν",4,1],["πληρώματι",2185,53],["εὐλογίας",578,19],["Χριστοῦ",1072,21],["ἐλεύσομαι",55,775]],"I know that when I come to you, I will come in the fullness of the blessing of the Good News of Christ."],["30",[["Παρακαλῶ",434,149],["δὲ",14,8],["ὑμᾶς",5,209],["ἀδελφοί",67,396],["διὰ",56,1],["τοῦ",1,30],["κυρίου",7,21],["ἡμῶν",9994,136],["Ἰησοῦ",211,21],["Χριστοῦ",1072,21],["καὶ",2,8],["διὰ",56,1],["τῆς",1,18],["ἀγάπης",1982,19],["τοῦ",1,23],["πνεύματος",168,24],["συναγωνίσασθαί",10903,103],["μοι",9994,151],["ἐν",4,1],["ταῖς",1,70],["προσευχαῖς",