[["1",[["Οὐδὲν",228,28],["ἄρα",985,8],["νῦν",90,17],["κατάκριμα",10849,20],["τοῖς",1,138],["ἐν",4,1],["Χριστῷ",1072,113],["Ἰησοῦ",211,113]],"There is therefore now no condemnation to those who are in Christ Jesus, who don’t walk according to the flesh, but according to the Spirit."],["2",[["ὁ",1,4],["γὰρ",40,8],["νόμος",140,5],["τοῦ",1,23],["πνεύματος",168,24],["τῆς",1,18],["ζωῆς",216,19],["ἐν",4,1],["Χριστῷ",1072,113],["Ἰησοῦ",211,113],["ἠλευθέρωσέν",5298,3],["σε",5,161],["ἀπὸ",17,1],["τοῦ",1,30],["νόμου",140,21],["τῆς",1,18],["ἁμαρτίας",119,19],["καὶ",2,8],["τοῦ",1,30],["θανάτου",170,21]],"For the law of the Spirit of life in Christ Jesus made me free from the law of sin and of death."],["3",[["τὸ",1,32],["γὰρ",40,8],["ἀδύνατον",1649,29],["τοῦ",1,30],["νόμου",140,21],["ἐν",4,1],["ᾧ",24,410],["ἠσθένει",771,14],["διὰ",56,1],["τῆς",1,18],["σαρκός",287,19],["ὁ",1,4],["θεὸς",20,5],["τὸν",1,6],["ἑαυτοῦ",92,48],["υἱὸν",13,7],["πέμψας",1597,155],["ἐν",4,1],["ὁμοιώματι",1176,53],["σαρκὸς",287,19],["ἁμαρτίας",119,19],["καὶ",2,8],["περὶ",72,1],["ἁμαρτίας",119,19],["κατέκρινεν",3848,3],["τὴν",1,9],["ἁμαρτίαν",119,10],["ἐν",4,1],["τῇ",1,95],["σαρκί",287,2]],"For what the law couldn’t do, in that it was weak through the flesh, God did, sending his own Son in the likeness of sinful flesh and for sin, he condemned sin in the flesh,"],["4",[["ἵνα",102,8],["τὸ",1,27],["δικαίωμα",428,20],["τοῦ",1,30],["νόμου",140,21],["πληρωθῇ",518,333],["ἐν",4,1],["ἡμῖν",9994,86],["τοῖς",1,138],["μὴ",25,12],["κατὰ",32,1],["σάρκα",287,10],["περιπατοῦσιν",1327,352],["ἀλλὰ",108,8],["κατὰ",32,1],["πνεῦμα",168,33]],"that the ordinance of the law might be fulfilled in us who don’t walk according to the flesh, but according to the Spirit."],["5",[["οἱ",1,128],["γὰρ",40,8],["κατὰ",32,1],["σάρκα",287,10],["ὄντες",10,137],["τὰ",1,42],["τῆς",1,18],["σαρκὸς",287,19],["φρονοῦσιν",2297,191],["οἱ",1,128],["δὲ",14,8],["κατὰ",32,1],["πνεῦμα",168,33],["τὰ",1,42],["τοῦ",1,23],["πνεύματος",168,24]],"For those who live according to the flesh set their minds on the things of the flesh, but those who live according to the Spirit, the things of the Spirit."],["6",[["τὸ",1,27],["γὰρ",40,8],["φρόνημα",6186,20],["τῆς",1,18],["σαρκὸς",287,19],["θάνατος",170,5],["τὸ",1,27],["δὲ",14,8],["φρόνημα",6186,20],["τοῦ",1,23],["πνεύματος",168,24],["ζωὴ",216,13],["καὶ",2,8],["εἰρήνη",213,13]],"For the mind of the flesh is death, but the mind of the Spirit is life and peace;"],["7",[["διότι",177,8],["τὸ",1,27],["φρόνημα",6186,20],["τῆς",1,18],["σαρκὸς",287,19],["ἔχθρα",1802,13],["εἰς",8,1],["θεόν",20,7],["τῷ",1,110],["γὰρ",40,8],["νόμῳ",140,113],["τοῦ",1,30],["θεοῦ",20,21],["οὐχ",12,12],["ὑποτάσσεται",1497,449],["οὐδὲ",106,8],["γὰρ",40,8],["δύναται",185,728]],"because the mind of the flesh is hostile toward God, for it is not subject to God’s law, neither indeed can it be."],["8",[["οἱ",1,128],["δὲ",14,8],["ἐν",4,1],["σαρκὶ",287,2],["ὄντες",10,137],["θεῷ",20,113],["ἀρέσαι",955,100],["οὐ",12,12],["δύνανται",185,756]],"Those who are in the flesh can’t please God."],["9",[["ὑμεῖς",5,208],["δὲ",14,8],["οὐκ",12,12],["ἐστὲ",10,84],["ἐν",4,1],["σαρκὶ",287,2],["ἀλλ᾽",108,8],["ἐν",4,1],["πνεύματι",168,53],["εἴπερ",77,8],["πνεῦμα",168,20],["θεοῦ",20,21],["οἰκεῖ",528,87],["ἐν",4,1],["ὑμῖν",5,86],["εἰ",77,8],["δέ",14,8],["τις",39,150],["πνεῦμα",168,33],["Χριστοῦ",1072,21],["οὐκ",12,12],["ἔχει",124,87],["οὗτος",16,112],["οὐκ",12,12],["ἔστιν",10,87],["αὐτοῦ",3,48]],"But you are not in the flesh but in the Spirit, if it is so that the Spirit of God dwells in you. But if any man doesn’t have the Spirit of Christ, he is not his."],["10",[["εἰ",77,8],["δὲ",14,8],["Χριστὸς",1072,5],["ἐν",4,1],["ὑμῖν",5,86],["τὸ",1,27],["μὲν",281,12],["σῶμα",454,20],["νεκρὸν",659,28],["διὰ",56,1],["ἁμαρτίαν",119,10],["τὸ",1,27],["δὲ",14,8],["πνεῦμα",168,20],["ζωὴ",216,13],["διὰ",56,1],["δικαιοσύνην",187,10]],"If Christ is in you, the body is dead because of sin, but the spirit is alive because of righteousness."],["11",[["εἰ",77,8],["δὲ",14,8],["τὸ",1,27],["πνεῦμα",168,20],["τοῦ",1,30],["ἐγείραντος",746,513],["τὸν",1,6],["Ἰησοῦν",211,7],["ἐκ",21,1],["νεκρῶν",659,163],["οἰκεῖ",528,87],["ἐν",4,1],["ὑμῖν",5,86],["ὁ",1,4],["ἐγείρας",746,155],["Χριστὸν",1072,7],["ἐκ",21,1],["νεκρῶν",659,163],["ζῳοποιήσει",3533,120],["καὶ",2,8],["τὰ",1,42],["θνητὰ",2895,65],["σώματα",454,43],["ὑμῶν",5,136],["διὰ",56,1],["τοῦ",1,23],["ἐνοικοῦντος",1403,291],["αὐτοῦ",3,48],["πνεύματος",168,24],["ἐν",4,1],["ὑμῖν",5,86]],"But if the Spirit of him who raised up Jesus from the dead dwells in you, he who raised up Christ Jesus from the dead will also give life to your mortal bodies through his Spirit who dwells in you."],["12",[["Ἄρα",985,8],["οὖν",227,8],["ἀδελφοί",67,396],["ὀφειλέται",10046,51],["ἐσμὲν",10,241],["οὐ",12,12],["τῇ",1,95],["σαρκὶ",287,2],["τοῦ",1,23],["κατὰ",32,1],["σάρκα",287,10],["ζῆν",107,54]],"So then, brothers, we are debtors, not to the flesh, to live after the flesh."],["13",[["εἰ",77,8],["γὰρ",40,8],["κατὰ",32,1],["σάρκα",287,10],["ζῆτε",107,84],["μέλλετε",1143,84],["ἀποθνῄσκειν",109,54],["εἰ",77,8],["δὲ",14,8],["πνεύματι",168,53],["τὰς",1,39],["πράξεις",1912,40],["τοῦ",1,23],["σώματος",454,24],["θανατοῦτε",382,84],["ζήσεσθε",107,747]],"For if you live after the flesh, you must die; but if by the Spirit you put to death the deeds of the body, you will live."],["14",[["ὅσοι",103,455],["γὰρ",40,8],["πνεύματι",168,53],["θεοῦ",20,21],["ἄγονται",224,507],["οὗτοι",16,213],["υἱοὶ",13,51],["θεοῦ",20,21],["εἰσιν",10,191]],"For as many as are led by the Spirit of God, these are children of God."],["15",[["οὐ",12,12],["γὰρ",40,8],["ἐλάβετε",46,262],["πνεῦμα",168,33],["δουλείας",1036,19],["πάλιν",655,17],["εἰς",8,1],["φόβον",333,7],["ἀλλ᾽",108,8],["ἐλάβετε",46,262],["πνεῦμα",168,33],["υἱοθεσίας",10862,19],["ἐν",4,1],["ᾧ",24,410],["κράζομεν",592,241],["αββα",10273,250],["ὁ",1,752],["πατήρ",44,250]],"For you didn’t receive the spirit of bondage again to fear, but you received the Spirit of adoption, by whom we cry, “Abba! Father!”"],["16",[["αὐτὸ",3,359],["τὸ",1,27],["πνεῦμα",168,20],["συμμαρτυρεῖ",10830,87],["τῷ",1,52],["πνεύματι",168,53],["ἡμῶν",9994,136],["ὅτι",19,8],["ἐσμὲν",10,241],["τέκνα",192,63],["θεοῦ",20,21]],"The Spirit himself testifies with our spirit that we are children of God;"],["17",[["εἰ",77,8],["δὲ",14,8],["τέκνα",192,63],["καὶ",2,8],["κληρονόμοι",3863,51],["κληρονόμοι",3863,51],["μὲν",281,12],["θεοῦ",20,21],["συγκληρονόμοι",10863,130],["δὲ",14,8],["Χριστοῦ",1072,21],["εἴπερ",77,8],["συμπάσχομεν",10864,241],["ἵνα",102,8],["καὶ",2,8],["συνδοξασθῶμεν",10865,282]],"and if children, then heirs—heirs of God and joint heirs with Christ, if indeed we suffer with him, that we may also be glorified with him."],["18",[["Λογίζομαι",495,768],["γὰρ",40,8],["ὅτι",19,8],["οὐκ",12,12],["ἄξια",1102,74],["τὰ",1,253],["παθήματα",10857,63],["τοῦ",1,30],["νῦν",90,17],["καιροῦ",132,21],["πρὸς",15,1],["τὴν",1,9],["μέλλουσαν",1143,73],["δόξαν",141,10],["ἀποκαλυφθῆναι",652,175],["εἰς",8,1],["ἡμᾶς",9994,209]],"For I consider that the sufferings of this present time are not worthy to be compared with the glory which will be revealed toward us."],["19",[["ἡ",1,11],["γὰρ",40,8],["ἀποκαραδοκία",10866,13],["τῆς",1,18],["κτίσεως",2263,19],["τὴν",1,9],["ἀποκάλυψιν",1453,10],["τῶν",1,76],["υἱῶν",13,77],["τοῦ",1,30],["θεοῦ",20,21],["ἀπεκδέχεται",10867,728]],"For the creation waits with eager expectation for the children of God to be revealed."],["20",[["τῇ",1,95],["γὰρ",40,8],["ματαιότητι",937,2],["ἡ",1,11],["κτίσις",2263,13],["ὑπετάγη",1497,38],["οὐχ",12,12],["ἑκοῦσα",6538,15],["ἀλλὰ",108,8],["διὰ",56,1],["τὸν",1,6],["ὑποτάξαντα",1497,476],["ἐφ᾽",9,1],["ἑλπίδι",530,2]],"For the creation was subjected to vanity, not of its own will, but because of him who subjected it, in hope"],["21",[["ὅτι",19,8],["καὶ",2,8],["αὐτὴ",3,179],["ἡ",1,11],["κτίσις",2263,13],["ἐλευθερωθήσεται",5298,125],["ἀπὸ",17,1],["τῆς",1,18],["δουλείας",1036,19],["τῆς",1,18],["φθορᾶς",3377,19],["εἰς",8,1],["τὴν",1,9],["ἐλευθερίαν",3427,10],["τῆς",1,18],["δόξης",141,19],["τῶν",1,44],["τέκνων",192,45],["τοῦ",1,30],["θεοῦ",20,21]],"that the creation itself also will be delivered from the bondage of decay into the liberty of the glory of the children of God."],["22",[["οἴδαμεν",10044,311],["γὰρ",40,8],["ὅτι",19,8],["πᾶσα",11,15],["ἡ",1,11],["κτίσις",2263,13],["συστενάζει",10868,87],["καὶ",2,8],["συνωδίνει",10869,87],["ἄχρι",4062,1],["τοῦ",1,30],["νῦν",90,17]],"For we know that the whole creation groans and travails in pain together until now."],["23",[["οὐ",12,12],["μόνον",302,29],["δέ",14,8],["ἀλλὰ",108,8],["καὶ",2,8],["αὐτοὶ",3,195],["τὴν",1,9],["ἀπαρχὴν",693,10],["τοῦ",1,23],["πνεύματος",168,24],["ἔχοντες",124,137],["ἡμεῖς",9994,208],["καὶ",2,8],["αὐτοὶ",3,195],["ἐν",4,1],["ἑαυτοῖς",92,142],["στενάζομεν",1445,241],["υἱοθεσίαν",10862,10],["ἀπεκδεχόμενοι",10867,741],["τὴν",1,9],["ἀπολύτρωσιν",10422,10],["τοῦ",1,23],["σώματος",454,24],["ἡμῶν",9994,136]],"Not only so, but ourselves also, who have the first fruits of the Spirit, even we ourselves groan within ourselves, waiting for adoption, the redemption of our body."],["24",[["τῇ",1,95],["γὰρ",40,8],["ἐλπίδι",530,2],["ἐσώθημεν",172,491],["ἐλπὶς",530,13],["δὲ",14,8],["βλεπομένη",470,761],["οὐκ",12,12],["ἔστιν",10,87],["ἐλπίς",530,13],["ὃ",24,467],["γὰρ",40,8],["βλέπει",470,87],["τίς",10010,150],["ἐλπίζει",514,87]],"For we were saved in hope, but hope that is seen is not hope. For who hopes for that which he sees?"],["25",[["εἰ",77,8],["δὲ",14,8],["ὃ",24,467],["οὐ",12,12],["βλέπομεν",470,241],["ἐλπίζομεν",514,241],["δι᾽",56,1],["ὑπομονῆς",1616,19],["ἀπεκδεχόμεθα",10867,800]],"But if we hope for that which we don’t see, we wait for it with patience."],["26",[["ὡσαύτως",1240,17],["δὲ",14,8],["καὶ",2,8],["τὸ",1,27],["πνεῦμα",168,20],["συναντιλαμβάνεται",10375,728],["τῇ",1,95],["ἀσθενείᾳ",3413,2],["ἡμῶν",9994,136],["τὸ",1,32],["γὰρ",40,8],["τί",10010,119],["προσευξώμεθα",551,898],["καθὸ",5665,8],["δεῖ",1158,87],["οὐκ",12,12],["οἴδαμεν",10044,311],["ἀλλ᾽",108,8],["αὐτὸ",3,359],["τὸ",1,27],["πνεῦμα",168,20],["ὑπερεντυγχάνει",10870,87],["στεναγμοῖς",1598,139],["ἀλαλήτοις",10871,215]],"In the same way, the Spirit also helps our weaknesses, for we don’t know how to pray as we ought. But the Spirit himself makes intercession for us with groanings which can’t be uttered."],["27",[["ὁ",1,4],["δὲ",14,8],["ἐραυνῶν",2321,67],["τὰς",1,39],["καρδίας",64,40],["οἶδεν",10044,165],["τί",10010,119],["τὸ",1,27],["φρόνημα",6186,20],["τοῦ",1,23],["πνεύματος",168,24],["ὅτι",19,8],["κατὰ",32,1],["θεὸν",20,7],["ἐντυγχάνει",2530,87],["ὑπὲρ",139,1],["ἁγίων",75,163]],"He who searches the hearts knows what is on the Spirit’s mind, because he makes intercession for the saints according to God."],["28",[["Οἴδαμεν",10044,311],["δὲ",14,8],["ὅτι",19,8],["τοῖς",1,138],["ἀγαπῶσιν",214,352],["τὸν",1,6],["θεὸν",20,7],["πάντα",11,65],["συνεργεῖ",6115,87],["εἰς",8,1],["ἀγαθόν",114,29],["τοῖς",1,138],["κατὰ",32,1],["πρόθεσιν",1970,10],["κλητοῖς",1893,215],["οὖσιν",10,352]],"We know that all things work together for good for those who love God, for those who are called according to his purpose."],["29",[["ὅτι",19,8],["οὓς",24,294],["προέγνω",5003,3],["καὶ",2,8],["προώρισεν",10514,3],["συμμόρφους",10872,58],["τῆς",1,18],["εἰκόνος",1136,19],["τοῦ",1,30],["υἱοῦ",13,21],["αὐτοῦ",3,48],["εἰς",8,1],["τὸ",1,32],["εἶναι",10135,54],["αὐτὸν",3,82],["πρωτότοκον",445,59],["ἐν",4,1],["πολλοῖς",74,215],["ἀδελφοῖς",67,139]],"For whom he foreknew, he also predestined to be conformed to the image of his Son, that he might be the firstborn among many brothers."],["30",[["οὓς",24,294],["δὲ",14,8],["προώρισεν",10514,3],["τούτους",16,274],["καὶ",2,8],["ἐκάλεσεν",128,3],["καὶ",2,8],["οὓς",24,294],["ἐκάλεσεν",128,3],["τούτους",16,274],["καὶ",2,8],["ἐδικαίωσεν",1115,3],["οὓς",24,294],["δὲ",14,8],["ἐδικαίωσεν",1115,3],["τούτους",16,274],["καὶ",2,8],["ἐδόξασεν",452,3]],"Whom he predestined, those he also called. Whom he called, those he also justified. Whom he justified, those he also glorified."],["31",[["Τί",10010,119],["οὖν",227,8],["ἐροῦμεν",10054,269],["πρὸς",15,1],["ταῦτα",16,248],["εἰ",77,8],["ὁ",1,4],["θεὸς",20,5],["ὑπὲρ",139,1],["ἡμῶν",9994,136],["τίς",10010,150],["καθ᾽",32,1],["ἡμῶν",9994,136]],"What then shall we say about these things? If God is for us, who can be against us?"],["32",[["ὅς",24,246],["γε",353,12],["τοῦ",1,30],["ἰδίου",683,153],["υἱοῦ",13,21],["οὐκ",12,12],["ἐφείσατο",610,737],["ἀλλ᾽",108,8],["ὑπὲρ",139,1],["ἡμῶν",9994,136],["πάντων",11,163],["παρέδωκεν",254,3],["αὐτόν",3,82],["πῶς",10049,12],["οὐχὶ",330,12],["καὶ",2,8],["σὺν",310,1],["αὐτῷ",3,49],["τὰ",1,42],["πάντα",11,65],["ἡμῖν",9994,86],["χαρίσεται",6200,718]],"He who didn’t spare his own Son, but delivered him up for us all, how would he not also with him freely give us all things?"],["33",[["Τίς",10010,150],["ἐγκαλέσει",4066,120],["κατὰ",32,1],["ἐκλεκτῶν",552,163],["θεοῦ",20,21],["θεὸς",20,5],["ὁ",1,4],["δικαιῶν",1115,67]],"Who could bring a charge against God’s chosen ones? It is God who justifies."],["34",[["τίς",10010,150],["ὁ",1,4],["κατακρινῶν",3848,67],["Χριστὸς",1072,5],["Ἰησοῦς",211,5],["ὁ",1,4],["ἀποθανὼν",109,155],["μᾶλλον",1043,17],["δὲ",14,8],["ἐγερθείς",746,206],["ὃς",24,246],["καί",2,8],["ἐστιν",10,87],["ἐν",4,1],["δεξιᾷ",282,96],["τοῦ",1,30],["θεοῦ",20,21],["ὃς",24,246],["καὶ",2,8],["ἐντυγχάνει",2530,87],["ὑπὲρ",139,1],["ἡμῶν",9994,136]],"Who is he who condemns? It is Christ who died, yes rather, who was raised from the dead, who is at the right hand of God, who also makes intercession for us."],["35",[["Τίς",10010,150],["ἡμᾶς",9994,209],["χωρίσει",1647,120],["ἀπὸ",17,1],["τῆς",1,18],["ἀγάπης",1982,19],["τοῦ",1,30],["Χριστοῦ",1072,21],["θλῖψις",438,13],["ἢ",61,8],["στενοχωρία",2379,13],["ἢ",61,8],["διωγμὸς",4755,5],["ἢ",61,8],["λιμὸς",503,5],["ἢ",61,8],["γυμνότης",6919,13],["ἢ",61,8],["κίνδυνος",2363,5],["ἢ",61,8],["μάχαιρα",342,13]],"Who shall separate us from the love of Christ? Could oppression, or anguish, or persecution, 