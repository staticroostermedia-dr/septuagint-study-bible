0],["τὰς",1,39],["κοπιώσας",921,341],["ἐν",4,1],["κυρίῳ",7,113],["ἀσπάσασθε",2987,771],["Περσίδα",2159,10],["τὴν",1,9],["ἀγαπητήν",1920,37],["ἥτις",457,421],["πολλὰ",74,65],["ἐκοπίασεν",921,3],["ἐν",4,1],["κυρίῳ",7,113]],"Greet Tryphaena and Tryphosa, who labor in the Lord. Greet Persis, the beloved, who labored much in the Lord."],["13",[["ἀσπάσασθε",2987,771],["Ῥοῦφον",10279,7],["τὸν",1,6],["ἐκλεκτὸν",552,59],["ἐν",4,1],["κυρίῳ",7,113],["καὶ",2,8],["τὴν",1,9],["μητέρα",189,10],["αὐτοῦ",3,48],["καὶ",2,8],["ἐμοῦ",6,88]],"Greet Rufus, the chosen in the Lord, and his mother and mine."],["14",[["ἀσπάσασθε",2987,771],["Ἀσύγκριτον",10917,7],["Φλέγοντα",10918,7],["Ἑρμῆν",9705,7],["Πατροβᾶν",10919,7],["Ἑρμᾶν",10920,7],["καὶ",2,8],["τοὺς",1,56],["σὺν",310,1],["αὐτοῖς",3,142],["ἀδελφούς",67,31]],"Greet Asyncritus, Phlegon, Hermes, Patrobas, Hermas, and the brothers who are with them."],["15",[["ἀσπάσασθε",2987,771],["Φιλόλογον",10921,7],["καὶ",2,8],["Ἰουλίαν",10922,10],["Νηρέα",10923,7],["καὶ",2,8],["τὴν",1,9],["ἀδελφὴν",521,10],["αὐτοῦ",3,48],["καὶ",2,8],["Ὀλυμπᾶν",10924,7],["καὶ",2,8],["τοὺς",1,56],["σὺν",310,1],["αὐτοῖς",3,142],["πάντας",11,58],["ἁγίους",75,58]],"Greet Philologus and Julia, Nereus and his sister, and Olympas, and all the saints who are with them."],["16",[["ἀσπάσασθε",2987,771],["ἀλλήλους",1192,60],["ἐν",4,1],["φιλήματι",6192,53],["ἁγίῳ",75,34],["ἀσπάζονται",2987,756],["ὑμᾶς",5,209],["αἱ",1,185],["ἐκκλησίαι",563,180],["πᾶσαι",11,187],["τοῦ",1,30],["Χριστοῦ",1072,21]],"Greet one another with a holy kiss. The assemblies of Christ greet you."],["17",[["Παρακαλῶ",434,149],["δὲ",14,8],["ὑμᾶς",5,209],["ἀδελφοί",67,396],["σκοπεῖν",5040,54],["τοὺς",1,56],["τὰς",1,39],["διχοστασίας",7059,40],["καὶ",2,8],["τὰ",1,42],["σκάνδαλα",1834,43],["παρὰ",73,1],["τὴν",1,9],["διδαχὴν",7030,10],["ἣν",24,124],["ὑμεῖς",5,208],["ἐμάθετε",923,262],["ποιοῦντας",23,229],["καὶ",2,8],["ἐκκλίνετε",394,307],["ἀπ᾽",17,1],["αὐτῶν",3,41]],"Now I beg you, brothers, look out for those who are causing the divisions and occasions of stumbling, contrary to the doctrine which you learned, and turn away from them."],["18",[["οἱ",1,128],["γὰρ",40,8],["τοιοῦτοι",630,213],["τῷ",1,110],["κυρίῳ",7,113],["ἡμῶν",9994,136],["Χριστῷ",1072,113],["οὐ",12,12],["δουλεύουσιν",398,191],["ἀλλὰ",108,8],["τῇ",1,95],["ἑαυτῶν",92,41],["κοιλίᾳ",547,2],["καὶ",2,8],["διὰ",56,1],["τῆς",1,18],["χρηστολογίας",10925,19],["καὶ",2,8],["εὐλογίας",578,19],["ἐξαπατῶσιν",6468,191],["τὰς",1,39],["καρδίας",64,40],["τῶν",1,76],["ἀκάκων",2520,163]],"For those who are such don’t serve our Lord Jesus Christ, but their own belly; and by their smooth and flattering speech they deceive the hearts of the innocent."],["19",[["ἡ",1,11],["γὰρ",40,8],["ὑμῶν",5,136],["ὑπακοὴ",9870,13],["εἰς",8,1],["πάντας",11,58],["ἀφίκετο",2518,737],["ἐφ᾽",9,1],["ὑμῖν",5,86],["οὖν",227,8],["χαίρω",698,149],["θέλω",612,149],["δὲ",14,8],["ὑμᾶς",5,209],["σοφοὺς",324,58],["εἶναι",10135,54],["εἰς",8,1],["τὸ",1,32],["ἀγαθὸν",114,29],["ἀκεραίους",8797,58],["δὲ",14,8],["εἰς",8,1],["τὸ",1,32],["κακόν",161,29]],"For your obedience has become known to all. I rejoice therefore over you. But I desire to have you wise in that which is good, but innocent in that which is evil."],["20",[["ὁ",1,4],["δὲ",14,8],["θεὸς",20,5],["τῆς",1,18],["εἰρήνης",213,19],["συντρίψει",268,120],["τὸν",1,6],["σατανᾶν",6785,7],["ὑπὸ",122,1],["τοὺς",1,56],["πόδας",210,31],["ὑμῶν",5,136],["ἐν",4,1],["τάχει",1565,53],["ἡ",1,11],["χάρις",368,13],["τοῦ",1,30],["κυρίου",7,21],["ἡμῶν",9994,136],["Ἰησοῦ",211,21],["μεθ᾽",29,1],["ὑμῶν",5,136]],"And the God of peace will quickly crush Satan under your feet. The grace of our Lord Jesus Christ be with you."],["21",[["Ἀσπάζεται",2987,728],["ὑμᾶς",5,209],["Τιμόθεος",1953,5],["ὁ",1,4],["συνεργός",6116,16],["μου",9994,146],["καὶ",2,8],["Λούκιος",10578,5],["καὶ",2,8],["Ἰάσων",3019,5],["καὶ",2,8],["Σωσίπατρος",5464,5],["οἱ",1,128],["συγγενεῖς",1741,130],["μου",9994,146]],"Timothy, my fellow worker, greets you, as do Lucius, J