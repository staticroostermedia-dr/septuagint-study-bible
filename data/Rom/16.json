[["1",[["Συνίστημι",1065,149],["δὲ",14,8],["ὑμῖν",5,86],["Φοίβην",10904,10],["τὴν",1,9],["ἀδελφὴν",521,10],["ἡμῶν",9994,136],["οὖσαν",10,73],["καὶ",2,8],["διάκονον",3263,10],["τῆς",1,18],["ἐκκλησίας",563,19],["τῆς",1,18],["ἐν",4,1],["Κεγχρεαῖς",10671,71]],"I commend to you Phoebe, our sister, who is a servant of the assembly that is at Cenchreae,"],["2",[["ἵνα",102,8],["αὐτὴν",3,98],["προσδέξησθε",1019,746],["ἐν",4,1],["κυρίῳ",7,113],["ἀξίως",5208,17],["τῶν",1,76],["ἁγίων",75,163],["καὶ",2,8],["παραστῆτε",595,118],["αὐτῇ",3,99],["ἐν",4,1],["ᾧ",24,410],["ἂν",83,12],["ὑμῶν",5,136],["χρῄζῃ",8703,173],["πράγματι",511,53],["καὶ",2,8],["γὰρ",40,8],["αὐτὴ",3,179],["προστάτις",10905,13],["πολλῶν",74,163],["ἐγενήθη",30,715],["καὶ",2,8],["ἐμοῦ",6,88],["αὐτοῦ",3,48]],"that you receive her in the Lord in a way worthy of the saints, and that you assist her in whatever matter she may need from you, for she herself also has been a helper of many, and of my own self."],["3",[["Ἀσπάσασθε",2987,771],["Πρίσκαν",10906,10],["καὶ",2,8],["Ἀκύλαν",10658,7],["τοὺς",1,56],["συνεργούς",6116,58],["μου",9994,146],["ἐν",4,1],["Χριστῷ",1072,113],["Ἰησοῦ",211,113]],"Greet Prisca and Aquila, my fellow workers in Christ Jesus,"],["4",[["οἵτινες",457,455],["ὑπὲρ",139,1],["τῆς",1,18],["ψυχῆς",63,19],["μου",9994,146],["τὸν",1,95],["ἑαυτῶν",92,41],["τράχηλον",692,7],["ὑπέθηκαν",2432,141],["οἷς",24,292],["οὐκ",12,12],["ἐγὼ",6,156],["μόνος",302,16],["εὐχαριστῶ",3831,149],["ἀλλὰ",108,8],["καὶ",2,8],["πᾶσαι",11,187],["αἱ",1,185],["ἐκκλησίαι",563,180],["τῶν",1,44],["ἐθνῶν",60,45]],"who risked their own necks for my life, to whom not only I give thanks, but also all the assemblies of the Gentiles."],["5",[["καὶ",2,8],["τὴν",1,9],["κατ᾽",32,1],["οἶκον",34,7],["αὐτῶν",3,41],["ἐκκλησίαν",563,10],["ἀσπάσασθε",2987,771],["Ἐπαίνετον",9699,7],["τὸν",1,6],["ἀγαπητόν",1920,59],["μου",9994,146],["ὅς",24,246],["ἐστιν",10,87],["ἀπαρχὴ",693,13],["τῆς",1,18],["Ἀσίας",3180,19],["εἰς",8,1],["Χριστόν",1072,7]],"Greet the ass