[["1",[["Τί",10010,119],["οὖν",227,8],["ἐροῦμεν",10054,269],["ἐπιμένωμεν",9529,223],["τῇ",1,95],["ἁμαρτίᾳ",119,2],["ἵνα",102,8],["ἡ",1,11],["χάρις",368,13],["πλεονάσῃ",1523,160]],"What shall we say then? Shall we continue in sin, that grace may abound?"],["2",[["μὴ",25,12],["γένοιτο",30,842],["οἵτινες",457,455],["ἀπεθάνομεν",109,285],["τῇ",1,95],["ἁμαρτίᾳ",119,2],["πῶς",10049,12],["ἔτι",111,17],["ζήσομεν",107,269],["ἐν",4,1],["αὐτῇ",3,99]],"May it never be! We who died to sin, how could we live in it any longer?"],["3",[["ἢ",61,8],["ἀγνοεῖτε",1846,84],["ὅτι",19,8],["ὅσοι",103,455],["ἐβαπτίσθημεν",4169,491],["εἰς",8,1],["Χριστὸν",1072,7],["Ἰησοῦν",211,7],["εἰς",8,1],["τὸν",1,6],["θάνατον",170,7],["αὐτοῦ",3,48],["ἐβαπτίσθημεν",4169,491]],"Or don’t you know that all of us who were baptized into Christ Jesus were baptized into his death?"],["4",[["συνετάφημεν",10854,491],["οὖν",227,8],["αὐτῷ",3,49],["διὰ",56,1],["τοῦ",1,23],["βαπτίσματος",10008,24],["εἰς",8,1],["τὸν",1,6],["θάνατον",170,7],["ἵνα",102,8],["ὥσπερ",226,8],["ἠγέρθη",746,38],["Χριστὸς",1072,5],["ἐκ",21,1],["νεκρῶν",659,163],["διὰ",56,1],["τῆς",1,18],["δόξης",141,19],["τοῦ",1,30],["πατρός",44,21],["οὕτως",9989,17],["καὶ",2,8],["ἡμεῖς",9994,208],["ἐν",4,1],["καινότητι",5666,2],["ζωῆς",216,19],["περιπατήσωμεν",1327,75]],"We were buried therefore with him through baptism into death, that just as Christ was raised from the dead through the glory of the Father, so we also might walk in newness of life."],["5",[["εἰ",77,8],["γὰρ",40,8],["σύμφυτοι",5097,130],["γεγόναμεν",30,311],["τῷ",1,52],["ὁμοιώματι",1176,53],["τοῦ",1,30],["θανάτου",170,21],["αὐτοῦ",3,48],["ἀλλὰ",108,8],["καὶ",2,8],["τῆς",1,18],["ἀναστάσεως",4027,19],["ἐσόμεθα",10,874]],"For if we have become united with him in the likeness of his death, we will also be part of his resurrection;"],["6",[["τοῦτο",16,122],["γινώσκοντες",79,137],["ὅτι",19,8],["ὁ",1,4],["παλαιὸς",1905,16],["ἡμῶν",9994,136],["ἄνθρωπος",43,5],["συνεσταυρώθη",10205,38],["ἵνα",102,8],["καταργηθῇ",4259,333],["τὸ",1,27],["σῶμα",454,20],["τῆς",1,18],["ἁμαρτίας",119,19],["τοῦ",1,23],["μηκέτι",2366,17],["δουλεύειν",398,54],["ἡμᾶς",9994,209],["τῇ",1,95],["ἁμαρτίᾳ",119,2]],"knowing this, that our old man was crucified with him, that the body of sin might be done away with, so that we would no longer be in bondage to sin."],["7",[["ὁ",1,4],["γὰρ",40,8],["ἀποθανὼν",109,155],["δεδικαίωται",1115,722],["ἀπὸ",17,1],["τῆς",1,18],["ἁμαρτίας",119,19]],"For he who has died has been freed from sin."],["8",[["εἰ",77,8],["δὲ",14,8],["ἀπεθάνομεν",109,285],["σὺν",310,1],["Χριστῷ",1072,113],["πιστεύομεν",649,241],["ὅτι",19,8],["καὶ",2,8],["συζήσομεν",10855,269],["αὐτῷ",3,49]],"But if we died with Christ, we believe that we will also live with him,"],["9",[["εἰδότες",10044,263],["ὅτι",19,8],["Χριστὸς",1072,5],["ἐγερθεὶς",746,206],["ἐκ",21,1],["νεκρῶν",659,163],["οὐκέτι",12,17],["ἀποθνῄσκει",109,87],["θάνατος",170,5],["αὐτοῦ",3,48],["οὐκέτι",12,17],["κυριεύει",885,87]],"knowing that Christ, being raised from the dead, dies no more. Death no longer has dominion over him!"],["10",[["ὃ",24,467],["γὰρ",40,8],["ἀπέθανεν",109,3],["τῇ",1,95],["ἁμαρτίᾳ",119,2],["ἀπέθανεν",109,3],["ἐφάπαξ",10856,17],["ὃ",24,467],["δὲ",14,8],["ζῇ",107,87],["ζῇ",107,87],["τῷ",1,110],["θεῷ",20,113]],"For the death that he died, he died to sin one time; but the life that he lives, he lives to God."],["11",[["οὕτως",9989,17],["καὶ",2,8],["ὑμεῖς",5,208],["λογίζεσθε",495,742],["ἑαυτοὺς",92,60],["εἶναι",10135,54],["νεκροὺς",659,58],["μὲν",281,12],["τῇ",1,95],["ἁμαρτίᾳ",119,2],["ζῶντας",107,229],["δὲ",14,8],["τῷ",1,110],["θεῷ",20,113],["ἐν",4,1],["Χριστῷ",1072,113],["Ἰησοῦ",211,113]],"Thus consider yourselves also to be dead to sin, but alive to God in Christ Jesus our Lord."],["12",[["Μὴ",25,12],["οὖν",227,8],["βασιλευέτω",151,35],["ἡ",1,11],["ἁμαρτία",119,13],["ἐν",4,1],["τῷ",1,52],["θνητῷ",2895,34],["ὑμῶν",5,136],["σώματι",454,53],["εἰς",8,1],["τὸ",1,32],["ὑπακούειν",867,54],["ταῖς",1,70],["ἐπιθυμίαις",699,71],["αὐτοῦ",3,144]],"Therefore don’t let sin reign in your mortal body, that you should obey it in its lusts."],["13",[["μηδὲ",414,8],["παριστάνετε",595,307],["τὰ",1,42],["μέλη",1593,43],["ὑμῶν",5,136],["ὅπλα",764,43],["ἀδικίας",288,19],["τῇ",1,95],["ἁμαρτίᾳ",119,2],["ἀλλὰ",108,8],["παραστήσατε",595,69],["ἑαυτοὺς",92,60],["τῷ",1,110],["θεῷ",20,113],["ὡσεὶ",343,1],["ἐκ",21,1],["νεκρῶν",659,163],["ζῶντας",107,229],["καὶ",2,8],["τὰ",1,42],["μέλη",1593,43],["ὑμῶν",5,136],["ὅπλα",764,43],["δικαιοσύνης",187,19],["τῷ",1,110],["θεῷ",20,113]],"Also, do not present your members to sin as instruments of unrighteousness, but present yourselves to God as alive from the dead, and your members as instruments of righteousness to God."],["14",[["ἁμαρτία",119,13],["γὰρ",40,8],["ὑμῶν",5,136],["οὐ",12,12],["κυριεύσει",885,120],["οὐ",12,12],["γάρ",40,8],["ἐστε",10,84],["ὑπὸ",122,1],["νόμον",140,7],["ἀλλ᾽",108,8],["ὑπὸ",122,1],["χάριν",368,10]],"For sin will not have dominion over you, for you are not under law, but under grace."],["15",[["Τί",10010,119],["οὖν",227,8],["ἁμαρτήσωμεν",237,75],["ὅτι",19,8],["οὐκ",12,12],["ἐσμὲν",10,241],["ὑπὸ",122,1],["νόμον",140,7],["ἀλλ᾽",108,8],["ὑπὸ",122,1],["χάριν",368,10],["μὴ",25,12],["γένοιτο",30,842]],"What then? Shall we sin because we are not under law but under grace? May it never be!"],["16",[["οὐκ",12,12],["οἴδατε",10044,330],["ὅτι",19,8],["ᾧ",24,202],["παριστάνετε",595,84],["ἑαυτοὺς",92,60],["δούλους",136,31],["εἰς",8,1],["ὑπακοήν",9870,10],["δοῦλοί",136,51],["ἐστε",10,84],["ᾧ",24,202],["ὑπακούετε",867,84],["ἤτοι",9727,8],["ἁμαρτίας",119,19],["εἰς",8,1],["θάνατον",170,7],["ἢ",61,8],["ὑπακοῆς",9870,19],["εἰς",8,1],["δικαιοσύνην",187,10]],"Don’t you know that when you present yourselves as servants and obey someone, you are the servants of whomever you obey, whether of sin to death, or of obedience to righteousness?"],["17",[["χάρις",368,13],["δὲ",14,8],["τῷ",1,110],["θεῷ",20,113],["ὅτι",19,8],["ἦτε",10,339],["δοῦλοι",136,51],["τῆς",1,18],["ἁμαρτίας",119,19],["ὑπηκούσατε",867,262],["δὲ",14,8],["ἐκ",21,1],["καρδίας",64,19],["εἰς",8,1],["ὃν",24,106],["παρεδόθητε",254,353],["τύπον",4449,7],["διδαχῆς",7030,19]],"But thanks be to God that, whereas you were bondservants of sin, you became obedient from the heart to that form of teaching to which you were delivered."],["18",[["Ἐλευθερωθέντες",5298,243],["δὲ",14,8],["ἀπὸ",17,1],["τῆς",1,18],["ἁμαρτίας",119,19],["ἐδουλώθητε",3527,353],["τῇ",1,95],["δικαιοσύνῃ",187,2]],"Being made free from sin, you became bondservants of righteousness."],["19",[["Ἀνθρώπινον",2656,29],["λέγω",31,149],["διὰ",56,1],["τὴν",1,9],["ἀσθένειαν",3413,10],["τῆς",1,18],["σαρκὸς",287,19],["ὑμῶν",5,136],["ὥσπερ",226,8],["γὰρ",40,8],["παρεστήσατε",595,262],["τὰ",1,42],["μέλη",1593,43],["ὑμῶν",5,136],["δοῦλα",136,43],["τῇ",1,95],["ἀκαθαρσίᾳ",888,2],["καὶ",2,8],["τῇ",1,95],["ἀνομίᾳ",275,2],["εἰς",8,1],["τὴν",1,9],["ἀνομίαν",275,10],["οὕτως",9989,17],["νῦν",90,17],["παραστήσατε",595,69],["τὰ",1,42],["μέλη",1593,43],["ὑμῶν",5,136],["δοῦλα",136,43],["τῇ",1,95],["δικαιοσύνῃ",187,2],["εἰς",8,1],["ἁγιασμόν",3415,7]],"I speak in human terms because of the weakness of your flesh; for as you presented your members as servants to uncleanness and to wickedness upon wickedness, even so now present your members as servants to righteousness for sanctification."],["20",[["ὅτε",432,8],["γὰρ",40,8],["δοῦλοι",136,51],["ἦτε",10,339],["τῆς",1,18],["ἁμαρτίας",119,19],["ἐλεύθεροι",1456,130],["ἦτε",10,339],["τῇ",1,95],["δικαιοσύνῃ",187,2]],"For when you were servants of sin, you were free from righteousness."],["21",[["τίνα",10010,365],["οὖν",227,8],["καρπὸν",448,7],["εἴχετε",124,339],["τότε",250,17],["ἐφ᾽",9,1],["οἷς",24,337],["νῦν",90,17],["ἐπαισχύνεσθε",9469,754],["τὸ",1,27],["γὰρ",40,8],["τέλος",373,20],["ἐκείνων",80,220],["θάνατος",170,5]],"What fruit then did you have at that time in the things of which you are now ashamed? For the end of those things is death."],["22",[["νυνὶ",2099,17],["δὲ",14,8],["ἐλευθερωθέντες",5298,243],["ἀπὸ",17,1],["τῆς",1,18],["ἁμαρτίας",119,19],["δουλωθέντες",3527,243],["δὲ",14,8],["τῷ",1,110],["θεῷ",20,113],["ἔχετε",124,84],["τὸν",1,6],["καρπὸν",448,7],["ὑμῶν",5,136],["εἰς",8,1],["ἁγιασμόν",3415,7],["τὸ",1,32],["δὲ",14,8],["τέλος",373,33],["ζωὴν",216,10],["αἰώνιον",391,37]],"But now, being made free from sin and having become servants of God, you have your fruit of sanctification and the result of eternal life."],["23",[["τὰ",1,253],["γὰρ",40,8],["ὀψώνια",5406,63],["τῆς",1,18],["ἁμαρτίας",119,19],["θάνατος",170,5],["τὸ",1,27],["δὲ",14,8],["χάρισμα",10814,20],["τοῦ",1,30],["θεοῦ",20,21],["ζωὴ",216,13],["αἰώνιος",391,15],["ἐν",4,1],["Χριστῷ",1072,113],["Ἰησοῦ",211,113],["τῷ",1,110],["κυρίῳ",7,113],["ἡμῶν",9994,136]],"For the wages of sin is death, but the free gift of God is eternal life in Christ Jesus our Lord."]]