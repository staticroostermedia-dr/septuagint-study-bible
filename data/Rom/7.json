[["1",[["Ἢ",61,8],["ἀγνοεῖτε",1846,84],["ἀδελφοί",67,396],["γινώσκουσιν",79,352],["γὰρ",40,8],["νόμον",140,7],["λαλῶ",50,149],["ὅτι",19,8],["ὁ",1,4],["νόμος",140,5],["κυριεύει",885,87],["τοῦ",1,30],["ἀνθρώπου",43,21],["ἐφ᾽",9,1],["ὅσον",103,106],["χρόνον",486,7],["ζῇ",107,87]],"Or don’t you know, brothers (for I speak to men who know the law), that the law has dominion over a man for as long as he lives?"],["2",[["ἡ",1,11],["γὰρ",40,8],["ὕπανδρος",3775,15],["γυνὴ",59,13],["τῷ",1,110],["ζῶντι",107,390],["ἀνδρὶ",38,113],["δέδεται",440,722],["νόμῳ",140,113],["ἐὰν",45,8],["δὲ",14,8],["ἀποθάνῃ",109,160],["ὁ",1,4],["ἀνήρ",38,5],["κατήργηται",4259,722],["ἀπὸ",17,1],["τοῦ",1,30],["νόμου",140,21],["τοῦ",1,30],["ἀνδρός",38,21]],"For the woman that has a husband is bound by law to the husband while he lives, but if the husband dies, she is discharged from the law of the husband."],["3",[["ἄρα",985,8],["οὖν",227,8],["ζῶντος",107,143],["τοῦ",1,30],["ἀνδρὸς",38,21],["μοιχαλὶς",3300,15],["χρηματίσει",3152,120],["ἐὰν",45,8],["γένηται",30,745],["ἀνδρὶ",38,113],["ἑτέρῳ",253,111],["ἐὰν",45,8],["δὲ",14,8],["ἀποθάνῃ",109,160],["ὁ",1,4],["ἀνήρ",38,5],["ἐλευθέρα",1456,15],["ἐστὶν",10,87],["ἀπὸ",17,1],["τοῦ",1,30],["νόμου",140,21],["τοῦ",1,23],["μὴ",25,12],["εἶναι",10135,54],["αὐτὴν",3,98],["μοιχαλίδα",3300,37],["γενομένην",30,863],["ἀνδρὶ",38,113],["ἑτέρῳ",253,111]],"So then if, while the husband lives, she is joined to another man, she would be called an adulteress. But if the husband dies, she is free from the law, so that she is no adulteress, though she is joined to another man."],["4",[["Ὥστε",346,8],["ἀδελφοί",67,396],["μου",9994,146],["καὶ",2,8],["ὑμεῖς",5,208],["ἐθανατώθητε",382,353],["τῷ",1,110],["νόμῳ",140,113],["διὰ",56,1],["τοῦ",1,23],["σώματος",454,24],["τοῦ",1,30],["Χριστοῦ",1072,21],["εἰς",8,1],["τὸ",1,32],["γενέσθαι",30,776],["ὑμᾶς",5,209],["ἑτέρῳ",253,111],["τῷ",1,110],["ἐκ",21,1],["νεκρῶν",659,163],["ἐγερθέντι",746,235],["ἵνα",102,8],["καρποφορήσωμεν",5675,75],["τῷ",1,110],["θεῷ",20,113]],"Therefore, my brothers, you also were made dead to the law through the body of Christ, that you would be joined to another, to him who was raised from the dead, that we might produce fruit to God."],["5",[["ὅτε",432,8],["γὰρ",40,8],["ἦμεν",10,395],["ἐν",4,1],["τῇ",1,95],["σαρκί",287,2],["τὰ",1,253],["παθήματα",10857,63],["τῶν",1,123],["ἁμαρτιῶν",119,61],["τὰ",1,253],["διὰ",56,1],["τοῦ",1,30],["νόμου",140,21],["ἐνηργεῖτο",3432,425],["ἐν",4,1],["τοῖς",1,91],["μέλεσιν",1593,92],["ἡμῶν",9994,136],["εἰς",8,1],["τὸ",1,32],["καρποφορῆσαι",5675,100],["τῷ",1,110],["θανάτῳ",170,113]],"For when we were in the flesh, the sinful passions which were through the law worked in our members to bring out fruit to death."],["6",[["νυνὶ",2099,17],["δὲ",14,8],["κατηργήθημεν",4259,491],["ἀπὸ",17,1],["τοῦ",1,30],["νόμου",140,21],["ἀποθανόντες",109,190],["ἐν",4,1],["ᾧ",24,202],["κατειχόμεθα",1040,912],["ὥστε",346,8],["δουλεύειν",398,54],["ἡμᾶς",9994,209],["ἐν",4,1],["καινότητι",5666,2],["πνεύματος",168,24],["καὶ",2,8],["οὐ",12,12],["παλαιότητι",10858,2],["γράμματος",1668,24]],"But now we have been discharged from the law, having died to that in which we were held; so that we serve in newness of the spirit, and not in oldness of the letter."],["7",[["Τί",10010,119],["οὖν",227,8],["ἐροῦμεν",10054,269],["ὁ",1,4],["νόμος",140,5],["ἁμαρτία",119,13],["μὴ",25,12],["γένοιτο",30,842],["ἀλλὰ",108,8],["τὴν",1,9],["ἁμαρτίαν",119,10],["οὐκ",12,12],["ἔγνων",79,147],["εἰ",77,8],["μὴ",25,12],["διὰ",56,1],["νόμου",140,21],["τήν",1,9],["τε",209,8],["γὰρ",40,8],["ἐπιθυμίαν",699,10],["οὐκ",12,12],["ᾔδειν",53,320],["εἰ",77,8],["μὴ",25,12],["ὁ",1,4],["νόμος",140,5],["ἔλεγεν",31,14],["οὐκ",12,12],["ἐπιθυμήσεις",915,159]],"What shall we say then? Is the law sin? May it never be! However, I wouldn’t have known sin except through the law. For I wouldn’t have known coveting unless the law had said, “You shall not covet.”"],["8",[["ἀφορμὴν",5249,10],["δὲ",14,8],["λαβοῦσα",46,140],["ἡ",1,11],["ἁμαρτία",119,13],["διὰ",56,1],["τῆς",1,18],["ἐντολῆς",259,19],["κατειργάσατο",3067,737],["ἐν",4,1],["ἐμοὶ",6,151],["πᾶσαν",11,37],["ἐπιθυμίαν",699,10],["χωρὶς",2046,1],["γὰρ",40,8],["νόμου",140,21],["ἁμαρτία",119,13],["νεκρά",659,15]],"But sin, finding occasion through the commandment, produced in me all kinds of coveting. For apart from the law, sin is dead."],["9",[["ἐγὼ",6,156],["δὲ",14,8],["ἔζων",107,293],["χωρὶς",2046,1],["νόμου",140,21],["ποτέ",458,12],["ἐλθούσης",55,501],["δὲ",14,8],["τῆς",1,18],["ἐντολῆς",259,19],["ἡ",1,11],["ἁμαρτία",119,13],["ἀνέζησεν",4501,3]],"I was alive apart from the law once, but when the commandment came, sin revived and I died."],["10",[["ἐγὼ",6,156],["δὲ",14,8],["ἀπέθανον",109,147],["καὶ",2,8],["εὑρέθη",101,38],["μοι",9994,151],["ἡ",1,11],["ἐντολὴ",259,13],["ἡ",1,11],["εἰς",8,1],["ζωὴν",216,10],["αὕτη",16,101],["εἰς",8,1],["θάνατον",170,7]],"The commandment which was for life, this I found to be for death;"],["11",[["ἡ",1,11],["γὰρ",40,8],["ἁμαρτία",119,13],["ἀφορμὴν",5249,10],["λαβοῦσα",46,140],["διὰ",56,1],["τῆς",1,18],["ἐντολῆς",259,19],["ἐξηπάτησέν",6468,3],["με",9994,161],["καὶ",2,8],["δι᾽",56,1],["αὐτῆς",3,83],["ἀπέκτεινεν",300,3]],"for sin, finding occasion through the commandment, deceived me, and through it killed me."],["12",[["ὥστε",346,8],["ὁ",1,4],["μὲν",281,12],["νόμος",140,5],["ἅγιος",75,16],["καὶ",2,8],["ἡ",1,11],["ἐντολὴ",259,13],["ἁγία",75,15],["καὶ",2,8],["δικαία",153,15],["καὶ",2,8],["ἀγαθή",114,15]],"Therefore the law indeed is holy, and the commandment holy, righteous, and good."],["13",[["τὸ",1,27],["οὖν",227,8],["ἀγαθὸν",114,28],["ἐμοὶ",6,151],["ἐγένετο",30,737],["θάνατος",170,5],["μὴ",25,12],["γένοιτο",30,842],["ἀλλ᾽",108,8],["ἡ",1,11],["ἁμαρτία",119,13],["ἵνα",102,8],["φανῇ",832,333],["ἁμαρτία",119,13],["διὰ",56,1],["τοῦ",1,23],["ἀγαθοῦ",114,88],["μοι",9994,151],["κατεργαζομένη",3067,744],["θάνατον",170,7],["ἵνα",102,8],["γένηται",30,745],["καθ᾽",32,1],["ὑπερβολὴν",9878,10],["ἁμαρτωλὸς",409,15],["ἡ",1,11],["ἁμαρτία",119,13],["διὰ",56,1],["τῆς",1,18],["ἐντολῆς",259,19]],"Did then that which is good become death to me? May it never be! But sin, that it might be shown to be sin, was producing death in me through that which is good; that through the commandment sin might become exceedingly sinful."],["14",[["Οἴδαμεν",10044,311],["γὰρ",40,8],["ὅτι",19,8],["ὁ",1,4],["νόμος",140,5],["πνευματικός",10815,16],["ἐστιν",10,87],["ἐγὼ",6,156],["δὲ",14,8],["σάρκινός",3968,16],["εἰμι",10,149],["πεπραμένος",1354,228],["ὑπὸ",122,1],["τὴν",1,9],["ἁμαρτίαν",119,10]],"For we know that the law is spiritual, but I am fleshly, sold under sin."],["15",[["ὃ",24,467],["γὰρ",40,8],["κατεργάζομαι",3067,768],["οὐ",12,12],["γινώσκω",79,149],["οὐ",12,12],["γὰρ",40,8],["ὃ",24,467],["θέλω",612,149],["τοῦτο",16,122],["πράσσω",1251,149],["ἀλλ᾽",108,8],["ὃ",24,467],["μισῶ",351,149],["τοῦτο",16,122],["ποιῶ",23,149]],"For I don’t understand what I am doing. For I don’t practice what I desire to do; but what I hate, that I do."],["16",[["εἰ",77,8],["δὲ",14,8],["ὃ",24,467],["οὐ",12,12],["θέλω",612,149],["τοῦτο",16,122],["ποιῶ",23,149],["σύμφημι",10859,149],["τῷ",1,110],["νόμῳ",140,113],["ὅτι",19,8],["καλός",266,16]],"But if what I don’t desire, that I do, I consent to the law that it is good."],["17",[["νυνὶ",2099,17],["δὲ",14,8],["οὐκέτι",12,17],["ἐγὼ",6,156],["κατεργάζομαι",3067,768],["αὐτὸ",3,121],["ἀλλ᾽",108,8],["ἡ",1,11],["οἰκοῦσα",528,183],["ἐν",4,1],["ἐμοὶ",6,151],["ἁμαρτία",119,13]],"So now it is no more I that do it, but sin which dwells in me."],["18",[["οἶδα",10044,85],["γὰρ",40,8],["ὅτι",19,8],["οὐκ",12,12],["οἰκεῖ",528,87],["ἐν",4,1],["ἐμοί",6,151],["τοῦτ᾽",16,344],["ἔστιν",10,87],["ἐν",4,1],["τῇ",1,95],["σαρκί",287,2],["μου",9994,146],["ἀγαθόν",114,28],["τὸ",1,27],["γὰρ",40,8],["θέλειν",612,54],["παράκειταί",2934,728],["μοι",9994,151],["τὸ",1,27],["δὲ",14,8],["κατεργάζεσθαι",3067,749],["τὸ",1,32],["καλὸν",266,29],["οὐχ",12,12]],"For I know that in me, that is, in my flesh, dwells no good thing. For desire is present with me, but I don’t find it doing that which is good."],["19",[["οὐ",12,12],["γὰρ",40,8],["ὃ",24,467],["θέλω",612,149],["ποιῶ",23,149],["ἀγαθόν",114,29],["ἀλλ᾽",108,8],["ὃ",24,467],["οὐ",12,12],["θέλω",612,149],["κακὸν",161,29],["τοῦτο",16,122],["πράσσω",1251,149]],"For the good which I desire, I don’t do; but the evil which I don’t desire, that I practice."],["20",[["εἰ",77,8],["δὲ",14,8],["ὃ",24,467],["οὐ",12,12],["θέλω",612,149],["ἐγὼ",6,156],["τοῦτο",16,122],["ποιῶ",23,149],["οὐκέτι",12,17],["ἐγὼ",6,156],["κατεργάζομαι",3067,768],["αὐτὸ",3,121],["ἀλλ᾽",108,8],["ἡ",1,11],["οἰκοῦσα",528,183],["ἐν",4,1],["ἐμοὶ",6,151],["ἁμαρτία",119,13]],"But if what I don’t desire, that I do, it is no more I that do it, but sin which dwells in me."],["21",[["εὑρίσκω",101,149],["ἄρα",985,8],["τὸν",1,6],["νόμον",140,7],["τῷ",1,110],["θέλοντι",612,390],["ἐμοὶ",6,151],["ποιεῖν",23,54],["τὸ",1,32],["καλὸν",266,29],["ὅτι",19,8],["ἐμοὶ",6,151],["τὸ",1,27],["κακὸν",161,28],["παράκειται",2934,728]],"I find then the law that, while I desire to do good, evil is present."],["22",[["συνήδομαι",10860,768],["γὰρ",40,8],["τῷ",1,110],["νόμῳ",140,113],["τοῦ",1,30],["θεοῦ",20,21],["κατὰ",32,1],["τὸν",1,6],["ἔσω",2544,17],["ἄνθρωπον",43,7]],"For I delight in God’s law after the inward person,"],["23",[["βλέπω",470,149],["δὲ",14,8],["ἕτερον",253,59],["νόμον",140,7],["ἐν",4,1],["τοῖς",1,91],["μέλεσίν",1593,92],["μου",9994,146],["ἀντιστρατευόμενον",10861,765],["τῷ",1,110],["νόμῳ",140,113],["τοῦ",1,30],["νοός",1442,21],["μου",9994,146],["καὶ",2,8],["αἰχμαλωτίζοντά",2246,178],["με",9994,161],["ἐν",4,1],["τῷ",1,110],["νόμῳ",140,113],["τῆς",1,18],["ἁμαρτίας",119,19],["τῷ",1,110],["ὄντι",10,390],["ἐν",4,1],["τοῖς",1,91],["μέλεσίν",1593,92],["μου",9994,146]],"but I see a different law in my members, warring against the law of my mind, and bringing me into captivity under the law of sin which is in my members."],["24",[["ταλαίπωρος",2786,16],["ἐγὼ",6,156],["ἄνθρωπος",43,5],["τίς",10010,150],["με",9994,161],["ῥύσεται",337,718],["ἐκ",21,1],["τοῦ",1,23],["σώματος",454,24],["τοῦ",1,30],["θανάτου",170,21],["τούτου",16,126]],"What a wretched man I am! Who will deliver me out of the body of this death?"],["25",[["χάρις",368,13],["δὲ",14,8],["τῷ",1,110],["θεῷ",20,113],["διὰ",56,1],["Ἰησοῦ",211,21],["Χριστοῦ",1072,21],["τοῦ",1,30],["κυρίου",7,21],["ἡμῶν",9994,136],["ἄρα",985,8],["οὖν",227,8],["αὐτὸς",3,158],["ἐγὼ",6,156],["τῷ",1,110],["μὲν",281,12],["νοῒ",1442,113],["δουλεύω",398,149],["νόμῳ",140,113],["θεοῦ",20,21],["τῇ",1,95],["δὲ",14,8],["σαρκὶ",287,2],["νόμῳ",140,113],["ἁμαρτίας",119,19]],"I thank God through Jesus Christ, our Lord! So then with the mind, I myself serve God’s law, but with the flesh, sin’s law."]]