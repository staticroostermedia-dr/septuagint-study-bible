[["1",[["Καὶ",2,8],["ἐρεῖς",191,145],["ἐν",4,1],["τῇ",1,95],["ἡμέρᾳ",28,2],["ἐκείνῃ",79,99],["Εὐλογῶ",147,149],["σε",5,161],["Κύριε",7,251],["διότι",176,8],["ὠργίσθης",725,363],["μοι",6,49],["καὶ",2,8],["ἀπέστρεψας",130,154],["τὸν",1,6],["θυμόν",177,7],["σου",5,146],["καὶ",2,8],["ἠλέησάς",457,154],["με",6,82]],"And in that day thou shalt say, I [will] bless thee, O Lord; for thou wast angry with me, but thou hast turned aside thy wrath, and hast pitied me."],["2",[["Ἰδοὺ",51,17],["ὁ",1,4],["Θεός",20,5],["μου",6,48],["σωτήρ",1390,5],["μου",6,48],["πεποιθὼς",343,265],["ἔσομαι",10,176],["ἐπʼ",9,1],["αὐτῷ",3,49],["καὶ",2,8],["οὐ",12,17],["φοβηθήσομαι",134,175],["διότι",176,8],["ἡ",1,11],["δόξα",141,186],["μου",6,48],["καὶ",2,8],["ἡ",1,11],["αἴνεσίς",990,13],["μου",6,48],["Κύριος",7,5],["καὶ",2,8],["ἐγένετό",30,26],["μοι",6,49],["εἰς",8,1],["σωτηρίαν",422,10]],"Behold, my God is my Saviour; I will trust in him, and not be afraid: for the Lord is my glory and my praise, and is become my salvation."],["3",[["Καὶ",2,8],["ἀντλήσατε",3171,69],["ὕδωρ",85,33],["μετʼ",29,1],["εὐφροσύνης",360,19],["ἐκ",21,1],["τῶν",1,123],["πηγῶν",563,61],["τοῦ",1,23],["σωτηρίου",471,24]],"Draw ye therefore water with joy out of the wells of salvation."],["4",[["Καὶ",2,8],["ἐρεῖς",191,145],["ἐν",4,1],["τῇ",1,95],["ἡμέρᾳ",28,2],["ἐκείνῃ",79,99],["ὑμνεῖτε",856,343],["Κύριον",7,7],["βοᾶτε",364,84],["τὸ",1,32],["ὄνομα",55,33],["αὐτοῦ",3,48],["ἀναγγείλατε",228,69],["ἐν",4,1],["τοῖς",1,91],["ἔθνεσι",59,92],["τὰ",1,42],["ἔνδοξα",731,65],["αὐτοῦ",3,48],["μιμνήσκεσθε",231,68],["ὅτι",19,8],["ὑψώθη",327,38],["τὸ",1,32],["ὄνομα",55,33],["αὐτοῦ",3,48]],"And in that day thou shalt say, Sing to the Lord, call aloud upon his name, proclaim his glorious [deeds] among the Gentiles; make mention that his name is exalted."],["5",[["Ὑμνήσατε",856,262],["τὸ",1,32],["ὄνομα",55,33],["Κυρίου",7,21],["ὅτι",19,8],["ὑψηλὰ",289,65],["ἐποίησεν",23,3],["ἀναγγείλατε",228,69],["ταῦτα",16,249],["ἐν",4,1],["πάσῃ",11,96],["τῇ",1,95],["γῇ",26,2]],"Sing praise to the name of the Lord; for he has done great [things]: declare this in all the earth."],["6",[["Ἀγαλλιᾶσθε",737,386],["καὶ",2,8],["εὐφραίνεσθε",242,386],["οἱ",1,128],["κατοικοῦντες",90,137],["Σιὼν",331,2],["ὅτι",19,8],["ὑψώθη",327,38],["ὁ",1,4],["ἅγιος",75,16],["τοῦ",1,30],["Ἰσραὴλ",27,105],["ἐν",4,1],["μέσῳ",112,34],["αὐτῆς",3,83]],"Exalt and rejoice, ye that dwell in Sion: for the Holy One of Israel is exalted in the midst of her."]]