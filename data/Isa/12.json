[["1",[["Καὶ",2,8],["ἐρεῖς",165,159],["ἐν",4,1],["τῇ",1,95],["ἡμέρᾳ",28,2],["ἐκείνῃ",80,99],["Εὐλογῶ",149,149],["σε",5,161],["Κύριε",7,250],["διότι",177,8],["ὠργίσθης",725,360],["μοι",6,49],["καὶ",2,8],["ἀπέστρεψας",130,154],["τὸν",1,6],["θυμόν",178,7],["σου",5,146],["καὶ",2,8],["ἠλέησάς",446,154],["με",6,82]],"And in that day thou shalt say, I [will] bless thee, O Lord; for thou wast angry with me, but thou hast turned aside thy wrath, and hast pitied me."],["2",[["Ἰδοὺ",51,17],["ὁ",1,4],["Θεός",20,5],["μου",6,48],["σωτήρ",1388,5],["μου",6,48],["πεποιθὼς",344,264],["ἔσομαι",10,177],["ἐπʼ",9,1],["αὐτῷ",3,49],["καὶ",2,8],["οὐ",12,17],["φοβηθήσομαι",134,176],["διότι",177,8],["ἡ",1,11],["δόξα",141,188],["μου",6,48],["καὶ",2,8],["ἡ",1,11],["αἴνεσίς",989,13],["μου",6,48],["Κύριος",7,5],["καὶ",2,8],["ἐγένετό",30,26],["μοι",6,49],["εἰς",8,1],["σωτηρίαν",425,10]],"Behold, my God is my Saviour; I will trust in him, and not be afraid: for the Lord is my glory and my praise, and is become my salvation."],["3",[["Καὶ",2,8],["ἀντλήσατε",3164,69],["ὕδωρ",85,33],["μετʼ",29,1],["εὐφροσύνης",360,19],["ἐκ",21,1],["τῶν",1,123],["πηγῶν",565,61],["τοῦ",1,23],["σωτηρίου",472,24]],"Draw ye therefore water with joy out of the wells of salvation."],["4",[["Καὶ",2,8],["ἐρεῖς",165,159],["ἐν",4,1],["τῇ",1,95],["ἡμέρᾳ",28,2],["ἐκείνῃ",80,99],["ὑμνεῖτε",855,339],["Κύριον",7,7],["βοᾶτε",366,84],["τὸ",1,32],["ὄνομα",57,33],["αὐτοῦ",3,48],["ἀναγγείλατε",231,69],["ἐν",4,1],["τοῖς",1,91],["ἔθνεσι",60,92],["τὰ",1,42],["ἔνδοξα",732,65],["αὐτοῦ",3,48],["μιμνήσκεσθε",230,68],["ὅτι",19,8],["ὑψώθη",331,38],["τὸ",1,32],["ὄνομα",57,33],["αὐτοῦ",3,48]],"And in that day thou shalt say, Sing to the Lord, call aloud upon his name, proclaim his glorious [deeds] among the Gentiles; make mention that his name is exalted."],["5",[["Ὑμνήσατε",855,262],["τὸ",1,32],["ὄνομα",57,33],["Κυρίου",7,21],["ὅτι",19,8],["ὑψηλὰ",289,65],["ἐποίησεν",23,3],["ἀναγγείλατε",231,69],["ταῦτα",16,248],["ἐν",4,1],["πάσῃ",11,96],["τῇ",1,95],["γῇ",26,2]],"Sing praise to the name of the Lord; for he has done great [things]: declare this in all the earth."],["6",[["Ἀγαλλιᾶσθε",738,382],["καὶ",2,8],["εὐφραίνεσθε",244,382],["οἱ",1,128],["κατοικοῦντες",89,137],["Σιὼν",334,2],["ὅτι",19,8],["ὑψώθη",331,38],["ὁ",1,4],["ἅγιος",75,16],["τοῦ",1,30],["Ἰσραὴλ",27,105],["ἐν",4,1],["μέσῳ",113,34],["αὐτῆς",3,83]],"Exalt and rejoice, ye that dwell in Sion: for the Holy One of Israel is exalted in the midst of her."]]