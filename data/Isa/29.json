],["ὁμίχλῃ",2860,2],["ὀφθαλμοὶ",91,51],["τυφλῶν",1601,163],["ὄψονται",111,127]],"And in that day the deaf shall hear the words of the book, and they that are in darkness, and they that are in mist: the eyes of the blind shall see,"],["19",[["καὶ",2,8],["ἀγαλλιάσονται",737,127],["πτωχοὶ",496,51],["διὰ",54,1],["Κύριον",7,7],["ἐν",4,1],["εὐφροσύνῃ",360,2],["καὶ",2,8],["οἱ",1,128],["ἀπηλπισμένοι",0,0],["τῶν",1,76],["ἀνθρώπων",43,77],["ἐμπλησθήσονται",424,135],["εὐφροσύνης",360,19]],"and the poor shall rejoice with joy because of the Lord, and they that had no hope among men shall be filled with joy."],["20",[["Ἐξέλιπεν",321,3],["ἄνομος",532,16],["καὶ",2,8],["ἀπώλετο",594,26],["ὑπερήφανος",1111,16],["καὶ",2,8],["ἐξωλοθρεύθησαν",291,94],["οἱ",1,128],["ἀνομοῦντες",1427,137],["ἐπὶ",9,1],["κακίᾳ",431,2]],"The lawless man has come to nought, and the proud man has perished, and they that transgress mischievously have been utterly destroyed:"],["21",[["καὶ",2,8],["οἱ",1,128],["ποιοῦντες",23,137],["ἁμαρτεῖν",244,100],["ἀνθρώπους",43,31],["ἐν",4,1],["λόγῳ",48,113],["πάντας",11,58],["δὲ",14,12],["τοὺς",1,56],["ἐλέγχοντας",750,229],["ἐν",4,1],["πύλαις",162,71],["πρόσκομμα",2627,33],["θήσουσιν",109,207],["ὅτι",19,8],["ἐπλαγίασαν",5980,141],["ἐπʼ",9,1],["ἀδίκοις",402,215],["δίκαιον",152,59]],"and they that cause men to sin by a word: and men shall make all that reprove in the gates an offence, because they have unjustly turned aside the righteous."],["22",[["Διατοῦτο",0,0],["τάδε",129,249],["λέγει",31,87],["Κύριος",7,5],["ἐπὶ",9,1],["τὸν",1,6],["οἶκον",34,7],["Ἰακώβ",146,105],["ὃν",24,106],["ἀφώρισεν",1218,3],["ἐξ",21,1],["Ἀβραὰμ",294,105],["οὐ",12,17],["νῦν",89,17],["αἰσχυνθήσεται",614,125],["Ἰακώβ",146,105],["οὐδὲ",105,12],["νῦν",89,17],["τὸ",1,32],["πρόσωπον",47,33],["μεταβαλεῖ",1345,120]],"Therefore thus saith the Lord concerning the house of Jacob, whom he set apart from Abraam, Jacob shall not now be ashamed, neither shall he now change countenance."],["23",[["Ἀλλʼ",107,17],["ὅ