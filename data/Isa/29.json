[["1",[["Οὐαὶ",766,320],["Ἀριὴλ",2567,105],["πόλις",41,13],["ἣν",24,124],["ἐπολέμησε",304,3],["Δαυείδ",1501,105],["συναγάγετε",165,69],["γενήματα",4753,43],["ἐνιαυτὸν",397,7],["ἐπὶ",9,1],["ἐνιαυτὸν",397,7],["φάγεσθε",153,117],["φάγεσθε",153,117],["γὰρ",40,12],["σὺν",309,1],["Μωάβ",0,0]],"Alas for the city Ariel, which David besieged. Gather ye fruits year by year; eat ye, for ye shall eat with Moab."],["2",[["ἐκθλίψω",1931,157],["γὰρ",40,12],["Ἀριήλ",2567,105],["καὶ",2,8],["ἔσται",10,89],["αὐτῆς",3,83],["ἡ",1,11],["ἰσχὺς",180,13],["καὶ",2,8],["ὁ",1,4],["πλοῦτος",572,5],["ἐμοί",6,49]],"For I will grievously afflict Ariel: and her strength and her wealth shall be mine."],["3",[["Καὶ",2,8],["κυκλώσω",600,157],["ὡς",36,8],["Δαυὶδ",52,105],["ἐπὶ",9,1],["σὲ",5,161],["καὶ",2,8],["βαλῶ",774,157],["περὶ",71,1],["σὲ",5,161],["χάρακα",2138,7],["καὶ",2,8],["θήσω",109,157],["περὶ",71,1],["σὲ",5,161],["πύργους",709,31]],"And I will compass thee about like David, and will raise a mound about thee, and set up towers round thee."],["4",[["καὶ",2,8],["ταπεινωθήσονται",333,135],["εἰς",8,1],["τὴν",1,9],["γῆν",26,10],["οἱ",1,128],["λόγοι",48,51],["σου",5,146],["καὶ",2,8],["εἰς",8,1],["τὴν",1,9],["γῆν",26,10],["οἱ",1,128],["λόγοι",48,51],["σου",5,146],["δύσονται",2179,127],["καὶ",2,8],["ἔσονται",10,127],["ὡς",36,8],["οἱ",1,128],["φωνοῦντες",1743,137],["ἐκ",21,1],["τῆς",1,18],["γῆς",26,19],["ἡ",1,11],["φωνή",95,13],["σου",5,146],["καὶ",2,8],["πρὸς",15,1],["τὸ",1,32],["ἔδαφος",1712,33],["ἡ",1,11],["φωνή",95,13],["σου",5,146],["ἀσθενήσει",768,120]],"And thy words shall be brought down to the earth, and thy words shall sink down to the earth, and thy voice shall be as they that speak out of the earth, and thy voice shall be lowered to the ground."],["5",[["Καὶ",2,8],["ἔσται",10,89],["ὡς",36,8],["κονιορτὸς",1895,5],["ἀπὸ",17,1],["τροχοῦ",913,21],["ὁ",1,4],["πλοῦτος",572,5],["τῶν",1,76],["ἀσεβῶν",246,163],["καὶ",2,8],["ὡς",36,8],["χνοῦς",3680,5],["φερόμενος",201,114],["τὸ",1,32],["πλῆθος",199,