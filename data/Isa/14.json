"ὑψηλὰ",289,65],["τὰ",1,42],["πρὸς",15,1],["Βοῤῥᾶν",387,7]],"But thou saidst in thine heart, I will go up to heaven, I will set my throne above the stars of heaven: I will sit on a lofty mount, on the lofty mountains toward the north:"],["14",[["ἀναβήσομαι",88,177],["ἐπάνω",491,17],["τῶν",1,44],["νεφῶν",1555,45],["ἔσομαι",10,177],["ὅμοιος",657,16],["τῷ",1,110],["ὑψίστῳ",474,111]],"I will go up above the clouds; I will be like the Most High."],["15",[["Νῦν",90,17],["δὲ",14,12],["εἰς",8,1],["ᾅδην",586,7],["καταβήσῃ",175,116],["καὶ",2,8],["εἰς",8,1],["τὰ",1,42],["θεμέλια",950,43],["τῆς",1,18],["γῆς",26,19]],"But now thou shalt go down to hell, even to the foundations of the earth."],["16",[["Οἱ",1,128],["ἰδόντες",53,190],["σε",5,161],["θαυμάσονται",963,127],["ἐπὶ",9,1],["σοὶ",5,151],["καὶ",2,8],["ἐροῦσιν",165,207],["οὗτος",16,112],["ὁ",1,4],["ἄνθρωπος",43,5],["ὁ",1,4],["παροξύνων",1044,67],["τὴν",1,9],["γῆν",26,10],["ὁ",1,4],["σείων",1282,67],["βασιλεῖς",22,51]],"They that see thee shall wonder at thee, and say, This is the man that troubled the earth, that made kings to shake;"],["17",[["ὁ",1,4],["θεὶς",110,155],["τὴν",1,9],["οἰκουμένην",1326,10],["ὅλην",235,37],["ἔρημον",160,37],["καὶ",2,8],["τὰς",1,39],["πόλεις",41,40],["αὐτοῦ",3,48],["καθεῖλε",602,3],["τοὺς",1,56],["ἐν",4,1],["ἐπαγωγῇ",2672,2],["οὐκ",12,17],["ἔλυσε",1381,3]],"that made the whole world desolate, and destroyed its cities; he loosed not those who were in captivity."],["18",[["Πάντες",11,130],["οἱ",1,128],["βασιλεῖς",22,51],["τῶν",1,44],["ἐθνῶν",60,45],["ἐκοιμήθησαν",301,94],["ἐν",4,1],["τιμῇ",720,2],["ἄνθρωπος",43,5],["ἐν",4,1],["τῷ",1,110],["οἴκῳ",34,113],["αὐτοῦ",3,48]],"All the kings of the nations lie in honour, [every] man in his house."],["19",[["Σὺ",5,156],["δὲ",14,12],["ῥιφήσῃ",615,373],["ἐν",4,1],["τοῖς",1,91],["ὄρεσιν",87,92],["ὡς",36,8],["νεκρὸς",659,16],["ἐβδελυγμένος",1056,408],["μετὰ",29,1],["πολλῶν",74,163],["τεθνηκότων",588,398],["ἐκκεκεντημένων",3183,412],["μαχαίραις",342,71],["καταβα