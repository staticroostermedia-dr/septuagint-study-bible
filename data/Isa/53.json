[["1",[["Κύριε",7,250],["τίς",39,150],["ἐπίστευσε",649,3],["τῇ",1,95],["ἀκοῇ",1047,2],["ἡμῶν",6,41],["καὶ",2,8],["ὁ",1,4],["βραχίων",1032,5],["Κυρίου",7,21],["τίνι",39,436],["ἀπεκαλύφθη",652,38]],"O Lord, who has believed our report? and to whom has the arm of the Lord been revealed?"],["2",[["Ἀνηγγείλαμεν",231,285],["ὡς",36,8],["παιδίον",449,33],["ἐναντίον",138,17],["αὐτοῦ",3,48],["ὡς",36,8],["ῥίζα",892,188],["ἐν",4,1],["γῇ",26,2],["διψώσῃ",1161,210],["οὐκ",12,17],["ἔστιν",10,87],["εἶδος",949,20],["αὐτῷ",3,49],["οὐδὲ",106,12],["δόξα",141,188],["καὶ",2,8],["εἴδομεν",53,285],["αὐτὸν",3,82],["καὶ",2,8],["οὐκ",12,17],["εἶχεν",124,14],["εἶδος",949,20],["οὐδὲ",106,12],["κάλλος",886,20]],"We brought a report as [of] a child before him; [he is] as a root in a thirsty land: he has no form nor comeliness; and we saw him, but he had no form nor beauty."],["3",[["Ἀλλὰ",108,17],["τὸ",1,32],["εἶδος",949,33],["αὐτοῦ",3,48],["ἄτιμον",2666,29],["καὶ",2,8],["ἐκλεῖπον",321,47],["παρὰ",73,1],["τοὺς",1,56],["υἱοὺς",13,31],["τῶν",1,76],["ἀνθρώπων",43,77],["ἄνθρωπος",43,5],["ἐν",4,1],["πληγῇ",573,2],["ὢν",10,67],["καὶ",2,8],["εἰδὼς",53,264],["φέρειν",199,54],["μαλακίαν",2266,10],["ὅτι",19,8],["ἀπέστραπται",130,182],["τὸ",1,32],["πρόσωπον",47,33],["αὐτοῦ",3,48],["ἠτιμάσθη",1400,38],["καὶ",2,8],["οὐκ",12,17],["ἐλογίσθη",495,252]],"But his form was ignoble, and inferior to that of the children of men; [he was] a man in suffering, and acquainted with the bearing of sickness, for his face is turned from [us]: he was dishonoured, and not esteemed."],["4",[["Οὗτος",16,112],["τὰς",1,39],["ἁμαρτίας",119,40],["ἡμῶν",6,41],["φέρει",199,87],["καὶ",2,8],["περὶ",72,1],["ἡμῶν",6,41],["ὀδυνᾶται",2844,108],["καὶ",2,8],["ἡμεῖς",6,195],["ἐλογισάμεθα",495,313],["αὐτὸν",3,82],["εἶναι",10,54],["ἐν",4,1],["πόνῳ",566,113],["καὶ",2,8],["ἐν",4,1],["πληγῇ",573,2],["καὶ",2,8],["ἐν",4,1],["κακώσει",757,120]],"He bears our sins, and is pained for us: yet we accounted him to be in trouble, and in suffering, and in affliction."],["5",[["Αὐτὸς",3,158],["δὲ",14,12],["ἐτραυματίσθη",1450,38],["διὰ",56,1],["τὰς",1,39],["ἁμαρτίας",119,40],["ἡμῶν",6,41],["καὶ",2,8],["μεμαλάκισται",2918,182],["διὰ",56,1],["τὰς",1,39],["ἀνομίας",275,40],["ἡμῶν",6,41],["παιδεία",571,13],["εἰρήνης",213,19],["ἡμῶν",6,41],["ἐπʼ",9,1],["αὐτὸν",3,82],["τῷ",1,110],["μώλωπι",2922,113],["αὐτοῦ",3,48],["ἡμεῖς",6,195],["ἰάθημεν",797,313]],"But he was wounded on account of our sins, and was bruised because of our iniquities: the chastisement of our peace was upon him; [and] by his bruises we were healed."],["6",[["Πάντες",11,130],["ὡς",36,8],["πρόβατα",194,43],["ἐπλανήθημεν",464,491],["ἄνθρωπος",43,5],["τῇ",1,95],["ὁδῷ",68,2],["αὐτοῦ",3,48],["ἐπλανήθη",464,38],["καὶ",2,8],["Κύριος",7,5],["παρέδωκεν",254,3],["αὐτὸν",3,82],["ταῖς",1,70],["ἁμαρτίαις",119,71],["ἡμῶν",6,41]],"All we as sheep have gone astray; every one has gone astray in his way; and the Lord gave him up for our sins."],["7",[["Καὶ",2,8],["αὐτὸς",3,158],["διὰ",56,1],["τὸ",1,32],["κεκακῶσθαι",757,435],["οὐκ",12,17],["ἀνοίγει",362,87],["τὸ",1,32],["στόμα",123,33],["αὐτοῦ",3,48],["ὡς",36,8],["πρόβατον",194,33],["ἐπὶ",9,1],["σφαγὴν",1742,10],["ἤχθη",224,38],["καὶ",2,8],["ὡς",36,8],["ἀμνὸς",562,5],["ἐναντίον",138,17],["τοῦ",1,30],["κείροντος",1730,143],["ἄφωνος",5274,16],["οὕτως",71,17],["οὐκ",12,17],["ἀνοίγει",362,87],["τὸ",1,32],["στόμα",123,33]],"And he, because of his affliction, opens not his mouth: he was led as a sheep to the slaughter, and as a lamb before the shearer is dumb, so he opens not his mouth."],["8",[["Ἐν",4,1],["τῇ",1,95],["ταπεινώσει",322,120],["ἡ",1,11],["κρίσις",229,13],["αὐτοῦ",3,48],["ᾔρθη",206,0],["τὴν",1,9],["γενεὰν",286,10],["αὐτοῦ",3,48],["τίς",39,150],["διηγήσεται",800,89],["ὅτι",19,8],["αἴρεται",206,108],["ἀπὸ",17,1],["τῆς",1,18],["γῆς",26,19],["ἡ",1,11],["ζωὴ",216,13],["αὐτοῦ",3,48],["ἀπὸ",17,1],["τῶν",1,123],["ἀνομιῶν",275,61],["τοῦ",1,30],["λαοῦ",35,21],["μου",6,48],["ἤχθη",224,38],["εἰς",8,1],["θάνατον",170,7]],"In [his] humiliation his judgment was taken away: who shall declare his generation? for his life is taken away from the earth: because of the iniquities of my people he was led to death."],["9",[["Καὶ",2,8],["δώσω",33,157],["τοὺς",1,56],["πονηροὺς",164,58],["ἀντὶ",158,1],["τῆς",1,18],["ταφῆς",2502,19],["αὐτοῦ",3,48],["καὶ",2,8],["τοὺς",1,56],["πλουσίους",952,58],["ἀντὶ",158,1],["τοῦ",1,30],["θανάτου",170,21],["αὐτοῦ",3,48],["ὅτι",19,8],["ἀνομίαν",275,10],["οὐκ",12,17],["ἐποίησεν",23,3],["οὐδὲ",106,12],["δόλον",919,7],["ἐν",4,1],["τῷ",1,52],["στόματι",123,53],["αὐτοῦ",3,48]],"And I will give the wicked for his burial, and the rich for his death; for he practised no iniquity, nor craft with his mouth."],["10",[["Καὶ",2,8],["Κύριος",7,5],["βούλεται",463,108],["καθαρίσαι",482,100],["αὐτὸν",3,82],["τῆς",1,18],["πληγῆς",573,19],["ἐὰν",45,8],["δῶτε",33,118],["περὶ",72,1],["ἁμαρτίας",119,19],["ἡ",1,11],["ψυχὴ",63,13],["ὑμῶν",5,136],["ὄψεται",112,89],["σπέρμα",218,20],["μακρόβιον",5810,28]],"The Lord also is pleased to purge him from his stroke. If ye can give an offering for sin, your soul shall see a long-lived seed:"],["11",[["καὶ",2,8],["βούλεται",463,108],["Κύριος",7,5],["ἀφελεῖν",369,100],["ἀπὸ",17,1],["τοῦ",1,30],["πόνου",566,21],["τῆς",1,18],["ψυχῆς",63,19],["αὐτοῦ",3,48],["δεῖξαι",870,100],["αὐτῷ",3,49],["φῶς",380,20],["καὶ",2,8],["πλάσαι",910,100],["τῇ",1,95],["συνέσει",469,2],["δικαιῶσαι",1115,100],["δίκαιον",153,59],["εὖ",975,17],["δουλεύοντα",398,178],["πολλοῖς",74,215],["καὶ",2,8],["τὰς",1,39],["ἁμαρτίας",119,40],["αὐτῶν",3,41],["αὐτὸς",3,158],["ἀνοίσει",384,120]],"the Lord also is pleased to take away from the travail of his soul, to shew him light, and to form [him] with understanding; to justify the just one who serves many well; and he shall bear their sins."],["12",[["Διατοῦτο",0,0],["αὐτὸς",3,158],["κληρονομήσει",370,120],["πολλοὺς",74,58],["καὶ",2,8],["τῶν",1,76],["ἰσχυρῶν",401,163],["μεριεῖ",1348,120],["σκῦλα",559,43],["ἀνθʼ",158,1],["ὧν",24,97],["παρεδόθη",254,38],["εἰς",8,1],["θάνατον",170,7],["ἡ",1,11],["ψυχὴ",63,13],["αὐτοῦ",3,48],["καὶ",2,8],["ἐν",4,1],["τοῖς",1,138],["ἀνόμοις",536,215],["ἐλογίσθη",495,252],["καὶ",2,8],["αὐτὸς",3,158],["ἁμαρτίας",119,19],["πολλῶν",74,163],["ἀνήνεγκε",384,3],["καὶ",2,8],["διὰ",56,1],["τὰς",1,39],["ἀνομίας",275,40],["αὐτῶν",3,41],["παρεδόθη",254,38]],"Therefore he shall inherit many, and he shall divide the spoils of the mighty; because his soul was delivered to death: and he was numbered among the transgressors; and he bore the sins of many, and was delivered because of their iniquities."]]