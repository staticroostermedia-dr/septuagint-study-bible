[["1",[["Κύριε",7,251],["τίς",39,150],["ἐπίστευσε",658,3],["τῇ",1,95],["ἀκοῇ",1045,2],["ἡμῶν",6,41],["καὶ",2,8],["ὁ",1,4],["βραχίων",1029,5],["Κυρίου",7,21],["τίνι",39,442],["ἀπεκαλύφθη",662,38]],"O Lord, who has believed our report? and to whom has the arm of the Lord been revealed?"],["2",[["Ἀνηγγείλαμεν",228,288],["ὡς",36,8],["παιδίον",447,33],["ἐναντίον",138,17],["αὐτοῦ",3,48],["ὡς",36,8],["ῥίζα",893,186],["ἐν",4,1],["γῇ",26,2],["διψώσῃ",1163,210],["οὐκ",12,17],["ἔστιν",10,87],["εἶδος",825,20],["αὐτῷ",3,49],["οὐδὲ",105,12],["δόξα",141,186],["καὶ",2,8],["εἴδομεν",73,288],["αὐτὸν",3,82],["καὶ",2,8],["οὐκ",12,17],["εἶχεν",124,14],["εἶδος",825,20],["οὐδὲ",105,12],["κάλλος",887,20]],"We brought a report as [of] a child before him; [he is] as a root in a thirsty land: he has no form nor comeliness; and we saw him, but he had no form nor beauty."],["3",[["Ἀλλὰ",107,17],["τὸ",1,32],["εἶδος",825,33],["αὐτοῦ",3,48],["ἄτιμον",2669,29],["καὶ",2,8],["ἐκλεῖπον",321,47],["παρὰ",72,1],["τοὺς",1,56],["υἱοὺς",13,31],["τῶν",1,76],["ἀνθρώπων",43,77],["ἄνθρωπος",43,5],["ἐν",4,1],["πληγῇ",571,2],["ὢν",10,67],["καὶ",2,8],["εἰδὼς",73,265],["φέρειν",201,54],["μαλακίαν",2281,10],["ὅτι",19,8],["ἀπέστραπται",130,372],["τὸ",1,32],["πρόσωπον",47,33],["αὐτοῦ",3,48],["ἠτιμάσθη",1432,38],["καὶ",2,8],["οὐκ",12,17],["ἐλογίσθη",494,253]],"But his form was ignoble, and inferior to that of the children of men; [he was] a man in suffering, and acquainted with the bearing of sickness, for his face is turned from [us]: he was dishonoured, and not esteemed."],["4",[["Οὗτος",16,112],["τὰς",1,39],["ἁμαρτίας",119,40],["ἡμῶν",6,41],["φέρει",201,87],["καὶ",2,8],["περὶ",71,1],["ἡμῶν",6,41],["ὀδυνᾶται",2858,108],["καὶ",2,8],["ἡμεῖς",6,193],["ἐλογισάμεθα",494,317],["αὐτὸν",3,82],["εἶναι",10,54],["ἐν",4,1],["πόνῳ",564,113],["καὶ",2,8],["ἐν",4,1],["πληγῇ",571,2],["καὶ",2,8],["ἐν",4,1],["κακώσει",764,120]],"He bears our sins, and is pained for us: yet we accounted him to be in trouble, and in suffering, and in affliction."],["5",[["Αὐτὸς",3,158],["δὲ",14,12],["ἐτραυματίσθη",1565,38],["διὰ",54,1],["τὰς",1,39],["ἁμαρτίας",119,40],["ἡμῶν",6,41],["καὶ",2,8],["μεμαλάκισται",0,0],["διὰ",54,1],["τὰς",1,39],["ἀνομίας",274,40],["ἡμῶν",6,41],["παιδεία",569,13],["εἰρήνης",210,19],["ἡμῶν",6,41],["ἐπʼ",9,1],["αὐτὸν",3,82],["τῷ",1,110],["μώλωπι",2936,113],["αὐτοῦ",3,48],["ἡμεῖς",6,193],["ἰάθημεν",794,317]],"But he was wounded on account of our sins, and was bruised because of our iniquities: the chastisement of our peace was upon him; [and] by his bruises we were healed."],["6",[["Πάντες",11,130],["ὡς",36,8],["πρόβατα",194,43],["ἐπλανήθημεν",464,498],["ἄνθρωπος",43,5],["τῇ",1,95],["ὁδῷ",67,2],["αὐτοῦ",3,48],["ἐπλανήθη",464,38],["καὶ",2,8],["Κύριος",7,5],["παρέδωκεν",254,3],["αὐτὸν",3,82],["ταῖς",1,70],["ἁμαρτίαις",119,71],["ἡμῶν",6,41]],"All we as sheep have gone astray; every one has gone astray in his way; and the Lord gave him up for our sins."],["7",[["Καὶ",2,8],["αὐτὸς",3,158],["διὰ",54,1],["τὸ",1,32],["κεκακῶσθαι",0,0],["οὐκ",12,17],["ἀνοίγει",820,87],["τὸ",1,32],["στόμα",123,33],["αὐτοῦ",3,48],["ὡς",36,8],["πρόβατον",194,33],["ἐπὶ",9,1],["σφαγὴν",1741,10],["ἤχθη",227,38],["καὶ",2,8],["ὡς",36,8],["ἀμνὸς",561,5],["ἐναντίον",138,17],["τοῦ",1,30],["κείροντος",1730,143],["ἄφωνος",5305,16],["οὕτως",70,17],["οὐκ",12,17],["ἀνοίγει",820,87],["τὸ",1,32],["στόμα",123,33]],"And he, because of his affliction, opens not his mouth: he was led as a sheep to the slaughter, and as a lamb before the shearer is dumb, so he opens not his mouth."],["8",[["Ἐν",4,1],["τῇ",1,95],["ταπεινώσει",333,120],["ἡ",1,11],["κρίσις",226,13],["αὐτοῦ",3,48],["ᾔρθη",0,0],["τὴν",1,9],["γενεὰν",286,10],["αὐτοῦ",3,48],["τίς",39,150],["διηγήσεται",797,89],["ὅτι",19,8],["αἴρεται",248,108],["ἀπὸ",17,1],["τῆς",1,18],["γῆς",26,19],["ἡ",1,11],["ζωὴ",212,13],["αὐτοῦ",3,48],["ἀπὸ",17,1],["τῶν",1,123],["ἀνομιῶν",274,61],["τοῦ",1,30],["λαοῦ",35,21],["μου",6,48],["ἤχθη",227,38],["εἰς",8,1],["θάνατον",169,7]],"In [his] humiliation his judgment was taken away: who shall declare his generation? for his life is taken away from the earth: because of the iniquities of my people he was led to death."],["9",[["Καὶ",2,8],["δώσω",33,157],["τοὺς",1,56],["πονηροὺς",164,58],["ἀντὶ",158,1],["τῆς",1,18],["ταφῆς",2506,19],["αὐτοῦ",3,48],["καὶ",2,8],["τοὺς",1,56],["πλουσίους",954,58],["ἀντὶ",158,1],["τοῦ",1,30],["θανάτου",169,21],["αὐτοῦ",3,48],["ὅτι",19,8],["ἀνομίαν",274,10],["οὐκ",12,17],["ἐποίησεν",23,3],["οὐδὲ",105,12],["δόλον",920,7],["ἐν",4,1],["τῷ",1,52],["στόματι",123,53],["αὐτοῦ",3,48]],"And I will give the wicked for his burial, and the rich for his death; for he practised no iniquity, nor craft with his mouth."],["10",[["Καὶ",2,8],["Κύριος",7,5],["βούλεται",461,108],["καθαρίσαι",488,100],["αὐτὸν",3,82],["τῆς",1,18],["πληγῆς",571,19],["ἐὰν",45,8],["δῶτε",33,118],["περὶ",71,1],["ἁμαρτίας",119,19],["ἡ",1,11],["ψυχὴ",62,13],["ὑμῶν",5,136],["ὄψεται",111,89],["σπέρμα",214,20],["μακρόβιον",5843,28]],"The Lord also is pleased to purge him from his stroke. If ye can give an offering for sin, your soul shall see a long-lived seed:"],["11",[["καὶ",2,8],["βούλεται",461,108],["Κύριος",7,5],["ἀφελεῖν",367,100],["ἀπὸ",17,1],["τοῦ",1,30],["πόνου",564,21],["τῆς",1,18],["ψυχῆς",62,19],["αὐτοῦ",3,48],["δεῖξαι",871,100],["αὐτῷ",3,49],["φῶς",376,20],["καὶ",2,8],["πλάσαι",912,100],["τῇ",1,95],["συνέσει",467,2],["δικαιῶσαι",1134,100],["δίκαιον",152,59],["εὖ",975,17],["δουλεύοντα",403,177],["πολλοῖς",74,215],["καὶ",2,8],["τὰς",1,39],["ἁμαρτίας",119,40],["αὐτῶν",3,41],["αὐτὸς",3,158],["ἀνοίσει",382,120]],"the Lord also is pleased to take away from the travail of his soul, to shew him light, and to form [him] with understanding; to justify the just one who serves many well; and he shall bear their sins."],["12",[["Διατοῦτο",0,0],["αὐτὸς",3,158],["κληρονομήσει",368,120],["πολλοὺς",74,58],["καὶ",2,8],["τῶν",1,76],["ἰσχυρῶν",398,163],["μεριεῖ",1382,120],["σκῦλα",558,43],["ἀνθʼ",158,1],["ὧν",24,97],["παρεδόθη",254,38],["εἰς",8,1],["θάνατον",169,7],["ἡ",1,11],["ψυχὴ",62,13],["αὐτοῦ",3,48],["καὶ",2,8],["ἐν",4,1],["τοῖς",1,138],["ἀνόμοις",532,215],["ἐλογίσθη",494,253],["καὶ",2,8],["αὐτὸς",3,158],["ἁμαρτίας",119,19],["πολλῶν",74,163],["ἀνήνεγκε",382,3],["καὶ",2,8],["διὰ",54,1],["τὰς",1,39],["ἀνομίας",274,40],["αὐτῶν",3,41],["παρεδόθη",254,38]],"Therefore he shall inherit many, and he shall divide the spoils of the mighty; because his soul was delivered to death: and he was numbered among the transgressors; and he bore the sins of many, and was delivered because of their iniquities."]]