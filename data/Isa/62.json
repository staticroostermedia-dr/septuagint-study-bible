[["1",[["Διὰ",56,1],["Σιὼν",334,2],["οὐ",12,17],["σιωπήσομαι",1283,177],["καὶ",2,8],["διὰ",56,1],["Ἱερουσαλὴμ",70,20],["οὐκ",12,17],["ἀνήσω",1081,157],["ἕως",42,8],["ἂν",83,12],["ἐξέλθῃ",82,160],["ὡς",36,8],["φῶς",380,20],["ἡ",1,11],["δικαιοσύνη",187,13],["αὐτῆς",3,83],["τὸ",1,32],["δὲ",14,12],["σωτήριόν",472,33],["μου",6,48],["ὡς",36,8],["λαμπὰς",2023,13],["καυθήσεται",671,125]],"For Sion's sake I will not hold my peace, and for Jerusalem's sake I will not rest, until her righteousness go forth as light, and my salvation burn as a torch."],["2",[["Καὶ",2,8],["ὄψονται",112,127],["ἔθνη",60,43],["τὴν",1,9],["δικαιοσύνην",187,10],["σου",5,146],["καὶ",2,8],["βασιλεῖς",22,51],["τὴν",1,9],["δόξαν",141,10],["σου",5,146],["καὶ",2,8],["καλέσει",128,120],["σε",5,161],["τὸ",1,32],["ὄνομα",57,33],["τὸ",1,32],["καινὸν",728,29],["ὃ",1,4],["ὁ",1,4],["Κύριος",7,5],["ὀνομάσει",1662,120],["αὐτό",3,121]],"And the Gentiles shall see thy righteousness, and kings thy glory: and one shall call thee [by] a new name, which the Lord shall name."],["3",[["Καὶ",2,8],["ἔσῃ",10,116],["στέφανος",980,5],["κάλλους",886,24],["ἐν",4,1],["χειρὶ",37,2],["Κυρίου",7,21],["καὶ",2,8],["διάδημα",2078,20],["βασιλείας",157,19],["ἐν",4,1],["χειρὶ",37,2],["Θεοῦ",20,21],["σου",5,146]],"And thou shalt be a crown of beauty in the hand of the Lord, and a royal diadem in the hand of thy God."],["4",[["Καὶ",2,8],["οὐκέτι",12,17],["κληθήσῃ",128,373],["Καταλελειμμένη",207,197],["καὶ",2,8],["ἡ",1,11],["γῆ",26,13],["σου",5,146],["οὐ",12,17],["κληθήσεται",128,125],["ἔτι",111,17],["Ἔρημος",160,15],["σοὶ",5,151],["γὰρ",40,12],["κληθήσεται",128,125],["Θέλημα",1039,33],["ἐμὸν",525,33],["καὶ",2,8],["τῇ",1,95],["γῇ",26,2],["σου",5,146],["Οἰκουμένη",528,204],["ὅτι",19,8],["εὐδόκησε",906,3],["Κύριος",7,5],["ἐν",4,1],["σοὶ",5,151],["καὶ",2,8],["ἡ",1,11],["γῆ",26,13],["σου",5,146],["συνοικισθήσεται",3648,125]],"And thou shalt no more be called Forsaken; and thy land shall no more be called Desert: for thou shalt be called My Pleasure, and thy land Inhabited: for the Lord has taken pleasure in thee, and thy land shall be inhabited."],["5",[["Καὶ",2,8],["ὡς",36,8],["συνοικῶν",2385,67],["νεανίσκος",570,5],["παρθένῳ",789,2],["οὕτω",71,17],["κατοικήσουσιν",89,207],["οἱ",1,128],["υἱοί",13,51],["σου",5,146],["καὶ",2,8],["ἔσται",10,89],["ὃν",24,106],["τρόπον",245,7],["εὐφρανθήσεται",244,125],["νυμφίος",2274,5],["ἐπὶ",9,1],["νύμφῃ",1060,2],["οὕτως",71,17],["εὐφρανθήσεται",244,125],["Κύριος",7,5],["ἐπὶ",9,1],["σοί",5,151]],"And as a young man lives with a virgin, so shall thy sons dwell in [thee]: and it shall come to pass [that] as a bridegroom will rejoice over a bride, so will the Lord rejoice over thee."],["6",[["Καὶ",2,8],["ἐπὶ",9,1],["τῶν",1,44],["τειχῶν",325,45],["σου",5,146],["Ἱερουσαλὴμ",70,20],["κατέστησα",314,147],["φύλακας",8637,31],["ὅλην",235,37],["τὴν",1,9],["ἡμέραν",28,10],["καὶ",2,8],["ὅλην",235,37],["τὴν",1,9],["νύκτα",219,10],["οἳ",1,128],["διὰ",56,1],["τέλους",373,24],["οὐ",12,17],["σιωπήσονται",1283,127],["μιμνησκόμενοι",230,351],["Κυρίου",7,21]],"And on thy walls, O Jerusalem, have I set watchmen all day and all night, who shall never cease making mention of the Lord."],["7",[["Οὐκ",12,17],["ἔστι",10,87],["γὰρ",40,12],["ὑμῖν",5,86],["ὅμοιος",657,16],["ἐὰν",45,8],["διορθώσῃ",3261,116],["καὶ",2,8],["ποιήσῃ",23,160],["Ἱερουσαλὴμ",70,20],["γαυρίαμα",2873,20],["ἐπὶ",9,1],["τῆς",1,18],["γῆς",26,19]],"For there is none like you, when he shall have established, and made Jerusalem a praise on the earth."],["8",[["Ὤμοσε",347,3],["Κύριος",7,5],["κατὰ",32,1],["τῆς",1,18],["δόξης",141,19],["αὐτοῦ",3,48],["καὶ",2,8],["κατὰ",32,1],["τῆς",1,18],["ἰσχύος",181,19],["τοῦ",1,30],["βραχίονος",1032,21],["αὐτοῦ",3,48],["εἰ",77,8],["ἔτι",111,17],["δώσω",33,157],["τὸν",1,6],["σῖτόν",665,7],["σου",5,146],["καὶ",2,8],["τὰ",1,42],["βρώματα",714,43],["σου",5,146],["τοῖς",1,138],["ἐχθροῖς",135,139],["σου",5,146],["καὶ",2,8],["εἰ",77,8],["ἔτι",111,17],["πίονται",212,127],["υἱοὶ",13,51],["ἀλλότριοι",381,130],["τ