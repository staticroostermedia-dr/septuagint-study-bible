[["1",[["Οὕτως",71,17],["λέγει",31,87],["Κύριος",7,5],["ποῖον",1332,20],["τὸ",1,27],["βιβλίον",339,20],["τοῦ",1,23],["ἀποστασίου",4529,24],["τῆς",1,18],["μητρὸς",189,19],["ὑμῶν",5,136],["ᾧ",24,202],["ἐξαπέστειλα",220,147],["αὐτήν",3,98],["ἢ",61,8],["τίνι",39,436],["ὑπόχρεῳ",6658,111],["πέπρακα",1354,85],["ὑμᾶς",5,209],["ἰδοὺ",51,17],["ταῖς",1,70],["ἁμαρτίαις",119,71],["ὑμῶν",5,136],["ἐπράθητε",1354,353],["καὶ",2,8],["ταῖς",1,70],["ἀνομίαις",275,71],["ὑμῶν",5,136],["ἐξαπέστειλα",220,147],["τὴν",1,9],["μητέρα",189,10],["ὑμῶν",5,136]],"Thus saith the Lord, Of what kind is your mother's bill of divorcement, by which I put her away? or to which debtor have I sold you? Behold, ye are sold for your sins, and for your iniquities have I put your mother away."],["2",[["Τί",39,119],["ὅτι",19,8],["ἦλθον",55,141],["καὶ",2,8],["οὐκ",12,17],["ἦν",10,14],["ἄνθρωπος",43,5],["ἐκάλεσα",128,147],["καὶ",2,8],["οὐκ",12,17],["ἦν",10,14],["ὁ",1,4],["ὑπακούων",867,67],["μὴ",25,8],["οὐκ",12,17],["ἰσχύει",567,87],["ἡ",1,11],["χείρ",37,13],["μου",6,48],["τοῦ",1,30],["ῥύσασθαι",337,103],["ἢ",61,8],["οὐκ",12,17],["ἰσχύω",567,149],["τοῦ",1,30],["ἐξελέσθαι",413,103],["ἰδοὺ",51,17],["τῷ",1,110],["ἐλεγμῷ",1798,113],["μου",6,48],["ἐξερημώσω",2140,157],["τὴν",1,9],["θάλασσαν",137,10],["καὶ",2,8],["θήσω",110,157],["ποταμοὺς",249,31],["ἐρήμους",160,58],["καὶ",2,8],["ξηρανθήσονται",842,135],["οἱ",1,128],["ἰχθύες",1372,51],["αὐτῶν",3,41],["ἀπὸ",17,1],["τοῦ",1,30],["μὴ",25,8],["εἶναι",10,54],["ὕδωρ",85,33],["καὶ",2,8],["ἀποθανοῦνται",109,127],["ἐν",4,1],["δίψει",2257,134]],"Why did I come, and there was no man? [why] did I call, and there was none to hearken? Is not my hand strong to redeem? or can I not deliver? behold, by my rebuke I will dry up the sea, and make rivers a wilderness; and their fish shall be dried up because there is no water, and shall die for thirst."],["3",[["Ἐνδύσω",516,169],["τὸν",1,6],["οὐρανὸν",94,7],["σκότος",506,5],["καὶ",2,8],["ὡς",36,8],["σάκκον",847,7],["θήσω",110,157],["τὸ",1,32],["περιβόλαιον",2753,33],["αὐτοῦ",3,48]],"I will clothe the sky with darkness, and will make its covering as sackcloth."],["4",[["Κύριος",7,5],["Κύριος",7,5],["δίδωσί",33,87],["μοι",6,49],["γλῶσσαν",388,10],["παιδείας",571,19],["τοῦ",1,30],["γνῶναι",79,100],["ἡνίκα",543,17],["δεῖ",1158,14],["εἰπεῖν",18,100],["λόγον",48,7],["ἔθηκέ",110,3],["μοι",6,49],["πρωῒ",504,17],["προσέθηκέ",201,3],["μοι",6,49],["ὠτίον",2330,20],["ἀκούειν",54,54]],"The Lord [even] God gives me the tongue of instruction, to know when it is fit to speak a word: he has appointed for me early, he has given me an ear to hear:"],["5",[["καὶ",2,8],["ἡ",1,11],["παιδεία",571,13],["Κυρίου",7,21],["Κυρίου",7,21],["ἀνοίγει",362,87],["μου",6,48],["τὰ",1,42],["ὦτα",328,43],["ἐγὼ",6,158],["δὲ",14,12],["οὐκ",12,17],["ἀπειθῶ",993,149],["οὐδὲ",106,12],["ἀντιλέγω",3162,149]],"and the instruction of the Lord, even the Lord, opens mine ears, and I do not disobey, nor dispute."],["6",[["Τὸν",1,6],["νῶτόν",1351,7],["μου",6,48],["ἔδωκα",33,147],["εἰς",8,1],["μάστιγας",1308,40],["τὰς",1,39],["δὲ",14,12],["σιαγόνας",1784,40],["μου",6,48],["εἰς",8,1],["ῥαπίσματα",9978,63],["τὸ",1,32],["δὲ",14,12],["πρόσωπόν",47,33],["μου",6,48],["οὐκ",12,17],["ἀπέστρεψα",130,147],["ἀπὸ",17,1],["αἰσχύνης",685,19],["ἐμπτυσμάτων",9664,45]],"I gave my back to scourges, and my cheeks to blows; and I turned not away my face from the shame of spitting:"],["7",[["καὶ",2,8],["Κύριος",7,5],["Κύριος",7,5],["βοηθός",947,5],["μοι",6,49],["ἐγενήθη",30,38],["διατοῦτο",0,0],["οὐκ",12,17],["ἐνετράπην",1105,148],["ἀλλὰ",108,17],["ἔθηκα",110,147],["τὸ",1,32],["πρόσωπόν",47,33],["μου",6,48],["ὡς",36,8],["στερεὰν",2289,37],["πέτραν",548,10],["καὶ",2,8],["ἔγνων",79,147],["ὅτι",19,8],["οὐ",12,17],["μὴ",25,8],["αἰσχυνθῶ",611,555]],"but the Lord God became my helper; therefore I was not ashamed, but I set my face as a solid rock; and I know that I shall never be ashamed,"],["8",[["ὅτι",19,8],["ἐγγίζει",455,87],["ὁ",1,4],["δικαιώσας",1115,155],["με",6,82],["τί