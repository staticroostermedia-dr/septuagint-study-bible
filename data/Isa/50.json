[["1",[["Οὕτως",70,17],["λέγει",31,87],["Κύριος",7,5],["ποῖον",1330,20],["τὸ",1,27],["βιβλίον",337,20],["τοῦ",1,23],["ἀποστασίου",4553,24],["τῆς",1,18],["μητρὸς",188,19],["ὑμῶν",5,136],["ᾧ",24,202],["ἐξαπέστειλα",217,147],["αὐτήν",3,98],["ἢ",60,8],["τίνι",39,442],["ὑπόχρεῳ",6700,111],["πέπρακα",1350,85],["ὑμᾶς",5,209],["ἰδοὺ",51,17],["ταῖς",1,70],["ἁμαρτίαις",119,71],["ὑμῶν",5,136],["ἐπράθητε",1350,358],["καὶ",2,8],["ταῖς",1,70],["ἀνομίαις",274,71],["ὑμῶν",5,136],["ἐξαπέστειλα",217,147],["τὴν",1,9],["μητέρα",188,10],["ὑμῶν",5,136]],"Thus saith the Lord, Of what kind is your mother's bill of divorcement, by which I put her away? or to which debtor have I sold you? Behold, ye are sold for your sins, and for your iniquities have I put your mother away."],["2",[["Τί",39,119],["ὅτι",19,8],["ἦλθον",56,141],["καὶ",2,8],["οὐκ",12,17],["ἦν",10,14],["ἄνθρωπος",43,5],["ἐκάλεσα",128,147],["καὶ",2,8],["οὐκ",12,17],["ἦν",10,14],["ὁ",1,4],["ὑπακούων",868,67],["μὴ",25,8],["οὐκ",12,17],["ἰσχύει",565,87],["ἡ",1,11],["χείρ",37,13],["μου",6,48],["τοῦ",1,30],["ῥύσασθαι",335,103],["ἢ",60,8],["οὐκ",12,17],["ἰσχύω",565,149],["τοῦ",1,30],["ἐξελέσθαι",411,103],["ἰδοὺ",51,17],["τῷ",1,110],["ἐλεγμῷ",1800,113],["μου",6,48],["ἐξερημώσω",2536,157],["τὴν",1,9],["θάλασσαν",137,10],["καὶ",2,8],["θήσω",109,157],["ποταμοὺς",249,31],["ἐρήμους",160,58],["καὶ",2,8],["ξηρανθήσονται",843,135],["οἱ",1,128],["ἰχθύες",1371,51],["αὐτῶν",3,41],["ἀπὸ",17,1],["τοῦ",1,30],["μὴ",25,8],["εἶναι",10,54],["ὕδωρ",85,33],["καὶ",2,8],["ἀποθανοῦνται",108,127],["ἐν",4,1],["δίψει",2272,134]],"Why did I come, and there was no man? [why] did I call, and there was none to hearken? Is not my hand strong to redeem? or can I not deliver? behold, by my rebuke I will dry up the sea, and make rivers a wilderness; and their fish shall be dried up because there is no water, and shall die for thirst."],["3",[["Ἐνδύσω",515,169],["τὸν",1,6],["οὐρανὸν",94,7],["σκότος",503,5],["καὶ",2,8],["ὡς",36,8],["σάκκον",848,7],["θήσω",109,157],["τὸ",1,32],["περιβόλαιον",2763,33],["αὐτοῦ",3,48]],"I will clothe the sky with darkness, and will make its covering as sackcloth."],["4",[["Κύριος",7,5],["Κύριος",7,5],["δίδωσί",33,87],["μοι",6,49],["γλῶσσαν",385,10],["παιδείας",569,19],["τοῦ",1,30],["γνῶναι",81,100],["ἡνίκα",541,17],["δεῖ",1161,14],["εἰπεῖν",18,100],["λόγον",48,7],["ἔθηκέ",109,3],["μοι",6,49],["πρωῒ",501,17],["προσέθηκέ",200,3],["μοι",6,49],["ὠτίον",2342,20],["ἀκούειν",53,54]],"The Lord [even] God gives me the tongue of instruction, to know when it is fit to speak a word: he has appointed for me early, he has given me an ear to hear:"],["5",[["καὶ",2,8],["ἡ",1,11],["παιδεία",569,13],["Κυρίου",7,21],["Κυρίου",7,21],["ἀνοίγει",820,87],["μου",6,48],["τὰ",1,42],["ὦτα",325,43],["ἐγὼ",6,158],["δὲ",14,12],["οὐκ",12,17],["ἀπειθῶ",994,149],["οὐδὲ",105,12],["ἀντιλέγω",3169,149]],"and the instruction of the Lord, even the Lord, opens mine ears, and I do not disobey, nor dispute."],["6",[["Τὸν",1,6],["νῶτόν",1347,7],["μου",6,48],["ἔδωκα",33,147],["εἰς",8,1],["μάστιγας",1308,40],["τὰς",1,39],["δὲ",14,12],["σιαγόνας",1784,40],["μου",6,48],["εἰς",8,1],["ῥαπίσματα",10057,63],["τὸ",1,32],["δὲ",14,12],["πρόσωπόν",47,33],["μου",6,48],["οὐκ",12,17],["ἀπέστρεψα",130,147],["ἀπὸ",17,1],["αἰσχύνης",683,19],["ἐμπτυσμάτων",9738,45]],"I gave my back to scourges, and my cheeks to blows; and I turned not away my face from the shame of spitting:"],["7",[["καὶ",2,8],["Κύριος",7,5],["Κύριος",7,5],["βοηθός",948,5],["μοι",6,49],["ἐγενήθη",30,38],["διατοῦτο",0,0],["οὐκ",12,17],["ἐνετράπην",1153,148],["ἀλλὰ",107,17],["ἔθηκα",109,147],["τὸ",1,32],["πρόσωπόν",47,33],["μου",6,48],["ὡς",36,8],["στερεὰν",2301,37],["πέτραν",546,10],["καὶ",2,8],["ἔγνων",81,147],["ὅτι",19,8],["οὐ",12,17],["μὴ",25,8],["αἰσχυνθῶ",614,569]],"but the Lord God became my helper; therefore I was not ashamed, but I set my face as a solid rock; and I know that I shall never be ashamed,"],["8",[["ὅτι",19,8],["ἐγγίζει",452,87],["ὁ",1,4],["δικαιώσας",1134,155],["με",6,82],["τ