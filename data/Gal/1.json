[["1",[["Παῦλος",10586,5],["ἀπόστολος",10080,5],["οὐκ",12,12],["ἀπ᾽",17,1],["ἀνθρώπων",43,77],["οὐδὲ",106,8],["δι᾽",56,1],["ἀνθρώπου",43,21],["ἀλλὰ",108,8],["διὰ",56,1],["Ἰησοῦ",211,21],["Χριστοῦ",1072,21],["καὶ",2,8],["θεοῦ",20,21],["πατρὸς",44,21],["τοῦ",1,30],["ἐγείραντος",746,513],["αὐτὸν",3,82],["ἐκ",21,1],["νεκρῶν",659,163]],"Paul, an apostle—not from men, nor through man, but through Jesus Christ, and God the Father, who raised him from the dead—"],["2",[["καὶ",2,8],["οἱ",1,128],["σὺν",310,1],["ἐμοὶ",6,151],["πάντες",11,130],["ἀδελφοὶ",67,51],["ταῖς",1,70],["ἐκκλησίαις",563,71],["τῆς",1,18],["Γαλατίας",10988,19]],"and all the brothers who are with me, to the assemblies of Galatia:"],["3",[["χάρις",368,13],["ὑμῖν",5,86],["καὶ",2,8],["εἰρήνη",213,13],["ἀπὸ",17,1],["θεοῦ",20,21],["πατρὸς",44,21],["ἡμῶν",9994,136],["καὶ",2,8],["κυρίου",7,21],["Ἰησοῦ",211,21],["Χριστοῦ",1072,21]],"Grace to you and peace from God the Father and our Lord Jesus Christ,"],["4",[["τοῦ",1,30],["δόντος",33,513],["ἑαυτὸν",92,82],["ὑπὲρ",139,1],["τῶν",1,123],["ἁμαρτιῶν",119,61],["ἡμῶν",9994,136],["ὅπως",240,8],["ἐξέληται",413,236],["ἡμᾶς",9994,209],["ἐκ",21,1],["τοῦ",1,30],["αἰῶνος",100,21],["τοῦ",1,30],["ἐνεστῶτος",2531,305],["πονηροῦ",164,153],["κατὰ",32,1],["τὸ",1,32],["θέλημα",1039,33],["τοῦ",1,30],["θεοῦ",20,21],["καὶ",2,8],["πατρὸς",44,21],["ἡμῶν",9994,136]],"who gave himself for our sins, that he might deliver us out of this present evil age, according to the will of our God and Father—"],["5",[["ᾧ",24,202],["ἡ",1,11],["δόξα",141,13],["εἰς",8,1],["τοὺς",1,56],["αἰῶνας",100,31],["τῶν",1,76],["αἰώνων",100,77],["ἀμήν",3161,316]],"to whom be the glory forever and ever. Amen."],["6",[["Θαυμάζω",963,149],["ὅτι",19,8],["οὕτως",9989,17],["ταχέως",1563,17],["μετατίθεσθε",2027,68],["ἀπὸ",17,1],["τοῦ",1,30],["καλέσαντος",128,513],["ὑμᾶς",5,209],["ἐν",4,1],["χάριτι",368,2],["Χριστοῦ",1072,21],["εἰς",8,1],["ἕτερον",253,29],["εὐαγγέλιον",4222,33]],"I marvel that you are so quickly deserting him who called you in the grace of Christ to a different “good news”,"],["7",[["ὃ",24,677],["οὐκ",12,12],["ἔστιν",10,87],["ἄλλο",584,28],["εἰ",77,8],["μή",25,12],["τινές",39,402],["εἰσιν",10,191],["οἱ",1,128],["ταράσσοντες",508,137],["ὑμᾶς",5,209],["καὶ",2,8],["θέλοντες",612,137],["μεταστρέψαι",1635,100],["τὸ",1,32],["εὐαγγέλιον",4222,33],["τοῦ",1,30],["Χριστοῦ",1072,21]],"but there isn’t another “good news.” Only there are some who trouble you and want to pervert the Good News of Christ."],["8",[["ἀλλὰ",108,8],["καὶ",2,8],["ἐὰν",45,8],["ἡμεῖς",9994,208],["ἢ",61,8],["ἄγγελος",208,5],["ἐξ",21,1],["οὐρανοῦ",94,21],["εὐαγγελίζηται",1817,823],["ὑμῖν",5,86],["παρ᾽",73,1],["ὃ",24,467],["εὐηγγελισάμεθα",1817,314],["ὑμῖν",5,86],["ἀνάθεμα",1695,20],["ἔστω",10,35]],"But even though we, or an angel from heaven, should preach to you any “good news” other than that which we preached to you, let him be cursed."],["9",[["ὡς",36,12],["προειρήκαμεν",2617,311],["καὶ",2,8],["ἄρτι",2665,17],["πάλιν",655,17],["λέγω",31,149],["εἴ",77,8],["τις",39,150],["ὑμᾶς",5,209],["εὐαγγελίζεται",1817,108],["παρ᾽",73,1],["ὃ",24,467],["παρελάβετε",1385,262],["ἀνάθεμα",1695,20],["ἔστω",10,35]],"As we have said before, so I now say again: if any man preaches to you any “good news” other than that which you received, let him be cursed."],["10",[["ἄρτι",2665,17],["γὰρ",40,8],["ἀνθρώπους",43,31],["πείθω",344,149],["ἢ",61,8],["τὸν",1,6],["θεόν",20,7],["ἢ",61,8],["ζητῶ",191,149],["ἀνθρώποις",43,139],["ἀρέσκειν",955,54],["εἰ",77,8],["ἔτι",111,17],["ἀνθρώποις",43,139],["ἤρεσκον",955,293],["Χριστοῦ",1072,21],["δοῦλος",136,5],["οὐκ",12,12],["ἂν",83,12],["ἤμην",10,429]],"For am I now seeking the favor of men, or of God? Or am I striving to please men? For if I were still pleasing men, I wouldn’t be a servant of Christ."],["11",[["Γνωρίζω",748,149],["γὰρ",40,8],["ὑμῖν",5,86],["ἀδελφοί",67,396],["τὸ",1,32],["εὐαγγέλιον",4222,33],["τὸ",1,32],["εὐαγγελισθὲν",1817,387],["ὑπ᾽",122,1],["ἐμοῦ",6,88],["ὅτι",19,8],["οὐκ",12,12],["ἔστιν",10,87],["κατὰ",32,1],["ἄνθρωπον",43,7]],"But I make known to you, brothers, concerning the Good News which was preached by me, that it is not according to man."],["12",[["οὐδὲ",106,8],["γὰρ",40,8],["ἐγὼ",6,156],["παρὰ",73,1],["ἀνθρώπου",43,21],["παρέλαβον",1385,147],["αὐτὸ",3,121],["οὔτε",477,8],["ἐδιδάχθην",545,148],["ἀλλὰ",108,8],["δι᾽",56,1],["ἀποκαλύψεως",1453,19],["Ἰησοῦ",211,21],["Χριστοῦ",1072,21]],"For I didn’t receive it from man, nor was I taught it, but it came to me through revelation of Jesus Christ."],["13",[["ἠκούσατε",54,262],["γὰρ",40,8],["τὴν",1,9],["ἐμὴν",10146,37],["ἀναστροφήν",6267,10],["ποτε",458,12],["ἐν",4,1],["τῷ",1,110],["Ἰουδαϊσμῷ",4123,113],["ὅτι",19,8],["καθ᾽",32,1],["ὑπερβολὴν",9878,10],["ἐδίωκον",533,293],["τὴν",1,9],["ἐκκλησίαν",563,10],["τοῦ",1,30],["θεοῦ",20,21],["καὶ",2,8],["ἐπόρθουν",8023,293],["αὐτήν",3,98]],"For you have heard of my way of living in time past in the Jews’ religion, how that beyond measure I persecuted the assembly of God and ravaged it."],["14",[["καὶ",2,8],["προέκοπτον",10309,293],["ἐν",4,1],["τῷ",1,110],["Ἰουδαϊσμῷ",4123,113],["ὑπὲρ",139,1],["πολλοὺς",74,58],["συνηλικιώτας",11054,31],["ἐν",4,1],["τῷ",1,52],["γένει",519,53],["μου",9994,146],["περισσοτέρως",10995,17],["ζηλωτὴς",3057,5],["ὑπάρχων",418,67],["τῶν",1,123],["πατρικῶν",2473,115],["μου",9994,146],["παραδόσεων",4960,61]],"I advanced in the Jews’ religion beyond many of my own age among my countrymen, being more exceedingly zealous for the traditions of my fathers."],["15",[["ὅτε",432,8],["δὲ",14,8],["εὐδόκησεν",906,3],["ὁ",1,4],["θεὸς",20,5],["ὁ",1,4],["ἀφορίσας",636,155],["με",9994,161],["ἐκ",21,1],["κοιλίας",547,19],["μητρός",189,19],["μου",9994,146],["καὶ",2,8],["καλέσας",128,155],["διὰ",56,1],["τῆς",1,18],["χάριτος",368,19],["αὐτοῦ",3,48]],"But when it was the good pleasure of God, who separated me from my mother’s womb and called me through his grace,"],["16",[["ἀποκαλύψαι",652,100],["τὸν",1,6],["υἱὸν",13,7],["αὐτοῦ",3,48],["ἐν",4,1],["ἐμοί",6,151],["ἵνα",102,8],["εὐαγγελίζωμαι",1817,922],["αὐτὸν",3,82],["ἐν",4,1],["τοῖς",1,91],["ἔθνεσιν",60,92],["εὐθέως",1673,17],["οὐ",12,12],["προσανεθέμην",11055,152],["σαρκὶ",287,2],["καὶ",2,8],["αἵματι",148,53]],"to reveal his Son in me, that I might preach him among the Gentiles, I didn’t immediately confer with flesh and blood,"],["17",[["οὐδὲ",106,8],["ἀνῆλθον",8960,147],["εἰς",8,1],["Ἱεροσόλυμα",70,43],["πρὸς",15,1],["τοὺς",1,56],["πρὸ",238,1],["ἐμοῦ",6,88],["ἀποστόλους",10080,31],["ἀλλ᾽",108,8],["ἀπῆλθον",297,147],["εἰς",8,1],["Ἀραβίαν",5280,10],["καὶ",2,8],["πάλιν",655,17],["ὑπέστρεψα",2238,147],["εἰς",8,1],["Δαμασκόν",1012,10]],"nor did I go up to Jerusalem to those who were apostles before me, but I went away into Arabia. Then I returned to Damascus."],["18",[["ἔπειτα",6560,17],["μετὰ",29,1],["ἔτη",81,43],["τρία",174,65],["ἀνῆλθον",8960,147],["εἰς",8,1],["Ἱεροσόλυμα",70,43],["ἱστορῆσαι",5391,100],["Κηφᾶν",10440,7],["καὶ",2,8],["ἐπέμεινα",9529,147],["πρὸς",15,1],["αὐτὸν",3,82],["ἡμέρας",28,40],["δεκαπέντε",3806,372]],"Then after three years I went up to Jerusalem to visit Peter, and stayed with him fifteen days."],["19",[["ἕτερον",253,59],["δὲ",14,8],["τῶν",1,76],["ἀποστόλων",10080,77],["οὐκ",12,12],["εἶδον",53,147],["εἰ",77,8],["μὴ",25,12],["Ἰάκωβον",10019,7],["τὸν",1,6],["ἀδελφὸν",67,7],["τοῦ",1,30],["κυρίου",7,21]],"But of the other apostles I saw no one except James, the Lord’s brother."],["20",[["ἃ",24,755],["δὲ",14,8],["γράφω",186,149],["ὑμῖν",5,86],["ἰδοὺ",51,316],["ἐνώπιον",115,1],["τοῦ",1,30],["θεοῦ",20,21],["ὅτι",19,8],["οὐ",12,12],["ψεύδομαι",1099,768]],"Now about the things which I write to you, behold, before God, I’m not lying."],["21",[["ἔπειτα",6560,17],["ἦλθον",55,147],["εἰς",8,1],["τὰ",1,42],["κλίματα",10899,43],["τῆς",1,18],["Συρίας",494,19],["καὶ",2,8],["τῆς",1,18],["Κιλικίας",3782,19]],"Then I came to the regions of Syria and Cilicia."],["22",[["ἤμην",10,429],["δὲ",14,8],["ἀγνοούμενος",1846,714],["τῷ",1,52],["προσώπῳ",47,53],["ταῖς",1,70],["ἐκκλησίαις",563,71],["τῆς",1,18],["Ἰουδαίας",492,19],["ταῖς",1,70],["ἐν",4,1],["Χριστῷ",1072,113]],"I was still unknown by face to the assemblies of Judea which were in Christ,"],["23",[["μόνον",302,29],["δὲ",14,8],["ἀκούοντες",54,137],["ἦσαν",10,129],["ὅτι",19,8],["ὁ",1,4],["διώκων",533,67],["ἡμᾶς",9994,209],["ποτε",458,12],["νῦν",90,17],["εὐαγγελίζεται",1817,108],["τὴν",1,9],["πίστιν",887,10],["ἥν",24,124],["ποτε",458,12],["ἐπόρθει",8023,14]],"but they only heard, “He who once persecuted us now preaches the faith that he once tried to destroy.”"],["24",[["καὶ",2,8],["ἐδόξαζον",452,129],["ἐν",4,1],["ἐμοὶ",6,151],["τὸν",1,6],["θεόν",20,7]],"So they glorified God in me."]]