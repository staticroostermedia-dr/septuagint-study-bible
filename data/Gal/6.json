[["1",[["Ἀδελφοί",67,396],["ἐὰν",45,8],["καὶ",2,8],["προλημφθῇ",8061,333],["ἄνθρωπος",43,5],["ἔν",4,1],["τινι",39,743],["παραπτώματι",1910,53],["ὑμεῖς",5,208],["οἱ",1,128],["πνευματικοὶ",10815,130],["καταρτίζετε",1888,307],["τὸν",1,6],["τοιοῦτον",630,259],["ἐν",4,1],["πνεύματι",168,53],["πραΰτητος",4361,19],["σκοπῶν",5040,67],["σεαυτὸν",10014,82],["μὴ",25,12],["καὶ",2,8],["σὺ",5,156],["πειρασθῇς",1094,278]],"Brothers, even if a man is caught in some fault, you who are spiritual must restore such a one in a spirit of gentleness, looking to yourself so that you also aren’t tempted."],["2",[["ἀλλήλων",1192,41],["τὰ",1,42],["βάρη",2871,43],["βαστάζετε",3502,307],["καὶ",2,8],["οὕτως",9989,17],["ἀναπληρώσετε",2308,348],["τὸν",1,6],["νόμον",140,7],["τοῦ",1,30],["Χριστοῦ",1072,21]],"Bear one another’s burdens, and so fulfill the law of Christ."],["3",[["εἰ",77,8],["γὰρ",40,8],["δοκεῖ",801,87],["τις",39,150],["εἶναί",10135,54],["τι",39,238],["μηδὲν",908,28],["ὤν",10,67],["φρεναπατᾷ",11074,87],["ἑαυτόν",92,82]],"For if a man thinks himself to be something when he is nothing, he deceives himself."],["4",[["τὸ",1,32],["δὲ",14,8],["ἔργον",105,33],["ἑαυτοῦ",92,48],["δοκιμαζέτω",1269,35],["ἕκαστος",171,16],["καὶ",2,8],["τότε",250,17],["εἰς",8,1],["ἑαυτὸν",92,82],["μόνον",302,59],["τὸ",1,32],["καύχημα",1627,33],["ἕξει",124,120],["καὶ",2,8],["οὐκ",12,12],["εἰς",8,1],["τὸν",1,6],["ἕτερον",253,59]],"But let each man examine his own work, and then he will have reason to boast in himself, and not in someone else."],["5",[["ἕκαστος",171,16],["γὰρ",40,8],["τὸ",1,32],["ἴδιον",683,29],["φορτίον",3664,33],["βαστάσει",3502,120]],"For each man will bear his own burden."],["6",[["κοινωνείτω",2089,35],["δὲ",14,8],["ὁ",1,4],["κατηχούμενος",10291,714],["τὸν",1,6],["λόγον",48,7],["τῷ",1,110],["κατηχοῦντι",10291,390],["ἐν",4,1],["πᾶσιν",11,90],["ἀγαθοῖς",114,90]],"But let him who is taught in the word share all good things with him who teaches."],["7",[["μὴ",25,12],["πλανᾶσθε",464,809],["θεὸς",20,5],["οὐ",12,12],["μυκτηρίζεται",2096,449],["ὃ",24,467],["γὰρ",40,8],["ἐὰν",45,8],["σπείρῃ",793,173],["ἄνθρωπος",43,5],["τοῦτο",16,122],["καὶ",2,8],["θερίσει",1509,120]],"Don’t be deceived. God is not mocked, for whatever a man sows, that he will also reap."],["8",[["ὅτι",19,8],["ὁ",1,4],["σπείρων",793,67],["εἰς",8,1],["τὴν",1,9],["σάρκα",287,10],["ἑαυτοῦ",92,48],["ἐκ",21,1],["τῆς",1,18],["σαρκὸς",287,19],["θερίσει",1509,120],["φθοράν",3377,10],["ὁ",1,4],["δὲ",14,8],["σπείρων",793,67],["εἰς",8,1],["τὸ",1,32],["πνεῦμα",168,33],["ἐκ",21,1],["τοῦ",1,23],["πνεύματος",168,24],["θερίσει",1509,120],["ζωὴν",216,10],["αἰώνιον",391,37]],"For he who sows to his own flesh will from the flesh reap corruption. But he who sows to the Spirit will from the Spirit reap eternal life."],["9",[["τὸ",1,32],["δὲ",14,8],["καλὸν",266,29],["ποιοῦντες",23,137],["μὴ",25,12],["ἐγκακῶμεν",10404,223],["καιρῷ",132,113],["γὰρ",40,8],["ἰδίῳ",683,111],["θερίσομεν",1509,269],["μὴ",25,12],["ἐκλυόμενοι",1194,772]],"Let’s not be weary in doing good, for we will reap in due season if we don’t give up."],["10",[["ἄρα",985,8],["οὖν",227,8],["ὡς",36,12],["καιρὸν",132,7],["ἔχομεν",124,241],["ἐργαζώμεθα",467,873],["τὸ",1,32],["ἀγαθὸν",114,29],["πρὸς",15,1],["πάντας",11,58],["μάλιστα",3593,17],["δὲ",14,8],["πρὸς",15,1],["τοὺς",1,56],["οἰκείους",1967,58],["τῆς",1,18],["πίστεως",887,19]],"So then, as we have opportunity, let’s do what is good toward all men, and especially toward those who are of the household of the faith."],["11",[["Ἴδετε",53,69],["πηλίκοις",4986,90],["ὑμῖν",5,86],["γράμμασιν",1668,92],["ἔγραψα",186,147],["τῇ",1,95],["ἐμῇ",10146,96],["χειρί",37,2]],"See with what large letters I write to you with my own hand."],["12",[["ὅσοι",103,455],["θέλουσιν",612,191],["εὐπροσωπῆσαι",11075,100],["ἐν",4,1],["σαρκί",287,2],["οὗτοι",16,213],["ἀναγκάζουσιν",1847,191],["ὑμᾶς",5,209],["περιτέμνεσθαι",1222,634],["μόνον",302,29],["ἵνα",102,8],["τῷ",1,110],["σταυρῷ",10094,113],["τοῦ",1,30],["Χριστοῦ",1072,21],["μὴ",25,12],["διώκωνται",533,926]],"As many as desire to make a good impression in the flesh compel you to be circumcised, just so they may not be persecuted for the cross of Christ."],["13",[["οὐδὲ",106,8],["γὰρ",40,8],["οἱ",1,128],["περιτεμνόμενοι",1222,772],["αὐτοὶ",3,195],["νόμον",140,7],["φυλάσσουσιν",125,191],["ἀλλὰ",108,8],["θέλουσιν",612,191],["ὑμᾶς",5,209],["περιτέμνεσθαι",1222,634],["ἵνα",102,8],["ἐν",4,1],["τῇ",1,95],["ὑμετέρᾳ",10347,96],["σαρκὶ",287,2],["καυχήσωνται",1380,733]],"For even they who receive circumcision don’t keep the law themselves, but they desire to have you circumcised, so that they may boast in your flesh."],["14",[["ἐμοὶ",6,151],["δὲ",14,8],["μὴ",25,12],["γένοιτο",30,842],["καυχᾶσθαι",1380,749],["εἰ",77,8],["μὴ",25,12],["ἐν",4,1],["τῷ",1,110],["σταυρῷ",10094,113],["τοῦ",1,30],["κυρίου",7,21],["ἡμῶν",9994,136],["Ἰησοῦ",211,21],["Χριστοῦ",1072,21],["δι᾽",56,1],["οὗ",24,367],["ἐμοὶ",6,151],["κόσμος",743,5],["ἐσταύρωται",6067,722],["κἀγὼ",10000,8],["κόσμῳ",743,113]],"But far be it from me to boast except in the cross of our Lord Jesus Christ, through which the world has been crucified to me, and I to the world."],["15",[["οὔτε",477,8],["γὰρ",40,8],["περιτομή",4357,13],["τί",10010,238],["ἐστιν",10,87],["οὔτε",477,8],["ἀκροβυστία",2132,13],["ἀλλὰ",108,8],["καινὴ",728,15],["κτίσις",2263,13]],"For in Christ Jesus neither is circumcision anything, nor uncircumcision, but a new creation."],["16",[["καὶ",2,8],["ὅσοι",103,455],["τῷ",1,110],["κανόνι",4815,113],["τούτῳ",16,286],["στοιχήσουσιν",8295,207],["εἰρήνη",213,13],["ἐπ᾽",9,1],["αὐτοὺς",3,60],["καὶ",2,8],["ἔλεος",183,20],["καὶ",2,8],["ἐπὶ",9,1],["τὸν",1,6],["Ἰσραὴλ",27,7],["τοῦ",1,30],["θεοῦ",20,21]],"As many as walk by this rule, peace and mercy be on them, and on God’s Israel."],["17",[["Τοῦ",1,23],["λοιποῦ",11076,88],["κόπους",1345,31],["μοι",9994,151],["μηδεὶς",908,16],["παρεχέτω",2279,35],["ἐγὼ",6,156],["γὰρ",40,8],["τὰ",1,42],["στίγματα",8324,43],["τοῦ",1,30],["Ἰησοῦ",211,21],["ἐν",4,1],["τῷ",1,52],["σώματί",454,53],["μου",9994,146],["βαστάζω",3502,149]],"From now on, let no one cause me any trouble, for I bear the marks of the Lord Jesus branded on my body."],["18",[["Ἡ",1,11],["χάρις",368,13],["τοῦ",1,30],["κυρίου",7,21],["ἡμῶν",9994,136],["Ἰησοῦ",211,21],["Χριστοῦ",1072,21],["μετὰ",29,1],["τοῦ",1,23],["πνεύματος",168,24],["ὑμῶν",5,136],["ἀδελφοί",67,396],["ἀμήν",3161,316]],"The grace of our Lord Jesus Christ be with your spirit, brothers. Amen."]]