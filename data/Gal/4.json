[["1",[["Λέγω",31,149],["δέ",14,8],["ἐφ᾽",9,1],["ὅσον",103,106],["χρόνον",486,7],["ὁ",1,4],["κληρονόμος",3863,5],["νήπιός",1016,16],["ἐστιν",10,87],["οὐδὲν",228,29],["διαφέρει",2447,87],["δούλου",136,21],["κύριος",7,5],["πάντων",11,79],["ὤν",10,67]],"But I say that so long as the heir is a child, he is no different from a bondservant, though he is lord of all,"],["2",[["ἀλλ᾽",108,8],["ὑπὸ",122,1],["ἐπιτρόπους",5339,31],["ἐστὶν",10,87],["καὶ",2,8],["οἰκονόμους",2182,31],["ἄχρι",4062,1],["τῆς",1,18],["προθεσμίας",11064,19],["τοῦ",1,30],["πατρός",44,21]],"but is under guardians and stewards until the day appointed by the father."],["3",[["οὕτως",9989,17],["καὶ",2,8],["ἡμεῖς",9994,208],["ὅτε",432,8],["ἦμεν",10,395],["νήπιοι",1016,130],["ὑπὸ",122,1],["τὰ",1,42],["στοιχεῖα",6072,43],["τοῦ",1,30],["κόσμου",743,21],["ἤμεθα",10,517],["δεδουλωμένοι",3527,574]],"So we also, when we were children, were held in bondage under the elemental principles of the world."],["4",[["ὅτε",432,8],["δὲ",14,8],["ἦλθεν",55,3],["τὸ",1,27],["πλήρωμα",2185,20],["τοῦ",1,30],["χρόνου",486,21],["ἐξαπέστειλεν",220,3],["ὁ",1,4],["θεὸς",20,5],["τὸν",1,6],["υἱὸν",13,7],["αὐτοῦ",3,48],["γενόμενον",30,855],["ἐκ",21,1],["γυναικός",59,19],["γενόμενον",30,855],["ὑπὸ",122,1],["νόμον",140,7]],"But when the fullness of the time came, God sent out his Son, born to a woman, born under the law,"],["5",[["ἵνα",102,8],["τοὺς",1,56],["ὑπὸ",122,1],["νόμον",140,7],["ἐξαγοράσῃ",9426,160],["ἵνα",102,8],["τὴν",1,9],["υἱοθεσίαν",10862,10],["ἀπολάβωμεν",3704,75]],"that he might redeem those who were under the law, that we might receive the adoption as children."],["6",[["ὅτι",19,8],["δέ",14,8],["ἐστε",10,84],["υἱοί",13,51],["ἐξαπέστειλεν",220,3],["ὁ",1,4],["θεὸς",20,5],["τὸ",1,32],["πνεῦμα",168,33],["τοῦ",1,30],["υἱοῦ",13,21],["αὐτοῦ",3,48],["εἰς",8,1],["τὰς",1,39],["καρδίας",64,40],["ἡμῶν",9994,136],["κρᾶζον",592,47],["αββα",10273,250],["ὁ",1,752],["πατήρ",44,250]],"And because you are children, God sent out the Spirit of his Son into your hearts, crying, “Abba, Father!”"],["7",[["ὥστε",346,8],["οὐκέτι",12,17],["εἶ",10,145],["δοῦλος",136,5],["ἀλλ᾽",108,8],["υἱός",13,5],["εἰ",77,8],["δὲ",14,8],["υἱός",13,5],["καὶ",2,8],["κληρονόμος",3863,5],["διὰ",56,1],["θεοῦ",20,21]],"So you are no longer a bondservant, but a son; and if a son, then an heir of God through Christ."],["8",[["Ἀλλὰ",108,8],["τότε",250,17],["μὲν",281,12],["οὐκ",12,12],["εἰδότες",10044,263],["θεὸν",20,7],["ἐδουλεύσατε",398,262],["τοῖς",1,138],["φύσει",2974,2],["μὴ",25,12],["οὖσιν",10,352],["θεοῖς",20,139]],"However at that time, not knowing God, you were in bondage to those who by nature are not gods."],["9",[["νῦν",90,17],["δὲ",14,8],["γνόντες",79,190],["θεόν",20,7],["μᾶλλον",1043,17],["δὲ",14,8],["γνωσθέντες",79,243],["ὑπὸ",122,1],["θεοῦ",20,21],["πῶς",10049,12],["ἐπιστρέφετε",117,84],["πάλιν",655,17],["ἐπὶ",9,1],["τὰ",1,42],["ἀσθενῆ",1854,65],["καὶ",2,8],["πτωχὰ",497,43],["στοιχεῖα",6072,43],["οἷς",24,337],["πάλιν",655,17],["ἄνωθεν",1605,17],["δουλεύειν",398,54],["θέλετε",612,84]],"But now that you have come to know God, or rather to be known by God, why do you turn back again to the weak and miserable elemental principles, to which you desire to be in bondage all over again?"],["10",[["ἡμέρας",28,40],["παρατηρεῖσθε",3914,383],["καὶ",2,8],["μῆνας",10294,31],["καὶ",2,8],["καιροὺς",132,31],["καὶ",2,8],["ἐνιαυτούς",400,31]],"You observe days, months, seasons, and years."],["11",[["φοβοῦμαι",134,768],["ὑμᾶς",5,209],["μή",25,12],["πως",441,12],["εἰκῇ",7134,17],["κεκοπίακα",921,85],["εἰς",8,1],["ὑμᾶς",5,209]],"I am afraid for you, that I might have wasted my labor for you."],["12",[["Γίνεσθε",30,742],["ὡς",36,12],["ἐγώ",6,156],["ὅτι",19,8],["κἀγὼ",10000,8],["ὡς",36,12],["ὑμεῖς",5,208],["Ἀδελφοί",67,396],["δέομαι",1672,768],["ὑμῶν",5,136],["οὐδέν",228,29],["με",9994,161],["ἠδικήσατε",760,262]],"I beg you, brothers, become as I am, for I also have become as you are. You did me no wrong,"],["13",[["οἴδατε",10044,330],["δὲ",14,8],["ὅτι",19,8],["δι᾽",56,1],["ἀσθένειαν",3413,10],["τῆς",1,18],["σαρκὸς",287,19],["εὐηγγελισάμην",1817,152],["ὑμῖν",5,86],["τὸ",1,32],["πρότερον",496,29]],"but you know that because of weakness in the flesh I preached the Good News to you the first time."],["14",[["καὶ",2,8],["τὸν",1,6],["πειρασμὸν",2281,7],["ὑμῶν",5,136],["ἐν",4,1],["τῇ",1,95],["σαρκί",287,2],["μου",9994,146],["οὐκ",12,12],["ἐξουθενήσατε",2534,262],["οὐδὲ",106,8],["ἐξεπτύσατε",11065,262],["ἀλλ᾽",108,8],["ὡς",36,12],["ἄγγελον",208,7],["θεοῦ",20,21],["ἐδέξασθέ",815,371],["με",9994,161],["ὡς",36,12],["Χριστὸν",1072,7],["Ἰησοῦν",211,7]],"That which was a temptation to you in my flesh, you didn’t despise nor reject; but you received me as an angel of God, even as Christ Jesus."],["15",[["Ποῦ",9996,17],["οὖν",227,8],["ὁ",1,4],["μακαρισμὸς",10842,5],["ὑμῶν",5,136],["μαρτυρῶ",2094,149],["γὰρ",40,8],["ὑμῖν",5,86],["ὅτι",19,8],["εἰ",77,8],["δυνατόν",356,28],["τοὺς",1,56],["ὀφθαλμοὺς",91,31],["ὑμῶν",5,136],["ἐξορύξαντες",6479,190],["ἐδώκατέ",33,262],["μοι",9994,151]],"What was the blessing you enjoyed? For I testify to you that, if possible, you would have plucked out your eyes and given them to me."],["16",[["ὥστε",346,8],["ἐχθρὸς",135,5],["ὑμῶν",5,136],["γέγονα",30,85],["ἀληθεύων",4014,67],["ὑμῖν",5,86]],"So then, have I become your enemy by telling you the truth?"],["17",[["ζηλοῦσιν",1057,191],["ὑμᾶς",5,209],["οὐ",12,12],["καλῶς",1273,17],["ἀλλ᾽",108,8],["ἐκκλεῖσαι",10840,100],["ὑμᾶς",5,209],["θέλουσιν",612,191],["ἵνα",102,8],["αὐτοὺς",3,60],["ζηλοῦτε",1057,362]],"They zealously seek you in no good way. No, they desire to alienate you, that you may seek them."],["18",[["καλὸν",266,28],["δὲ",14,8],["ζηλοῦσθαι",1057,384],["ἐν",4,1],["καλῷ",266,34],["πάντοτε",6027,17],["καὶ",2,8],["μὴ",25,12],["μόνον",302,29],["ἐν",4,1],["τῷ",1,52],["παρεῖναί",899,54],["με",9994,161],["πρὸς",15,1],["ὑμᾶς",5,209]],"But it is always good to be zealous in a good cause, and not only when I am present with you."],["19",[["τέκνα",192,532],["μου",9994,146],["οὓς",24,294],["πάλιν",655,17],["ὠδίνω",2436,149],["μέχρις",781,1],["οὗ",24,367],["μορφωθῇ",11066,333],["Χριστὸς",1072,5],["ἐν",4,1],["ὑμῖν",5,86]],"My little children, of whom I am again in travail until Christ is formed in you—"],["20",[["ἤθελον",612,293],["δὲ",14,8],["παρεῖναι",899,54],["πρὸς",15,1],["ὑμᾶς",5,209],["ἄρτι",2665,17],["καὶ",2,8],["ἀλλάξαι",1172,100],["τὴν",1,9],["φωνήν",95,10],["μου",9994,146],["ὅτι",19,8],["ἀποροῦμαι",2310,700],["ἐν",4,1],["ὑμῖν",5,86]],"but I could wish to be present with you now, and to change my tone, for I am perplexed about you."],["21",[["Λέγετέ",31,307],["μοι",9994,151],["οἱ",1,538],["ὑπὸ",122,1],["νόμον",140,7],["θέλοντες",612,619],["εἶναι",10135,54],["τὸν",1,6],["νόμον",140,7],["οὐκ",12,12],["ἀκούετε",54,84]],"Tell me, you that desire to be under the law, don’t you listen to the law?"],["22",[["γέγραπται",186,722],["γὰρ",40,8],["ὅτι",19,8],["Ἀβραὰμ",294,5],["δύο",104,372],["υἱοὺς",13,31],["ἔσχεν",124,3],["ἕνα",58,59],["ἐκ",21,1],["τῆς",1,18],["παιδίσκης",605,19],["καὶ",2,8],["ἕνα",58,59],["ἐκ",21,1],["τῆς",1,18],["ἐλευθέρας",1456,78]],"For it is written that Abraham had two sons, one by the servant, and one by the free woman."],["23",[["ἀλλ᾽",108,8],["ὁ",1,4],["μὲν",281,12],["ἐκ",21,1],["τῆς",1,18],["παιδίσκης",605,19],["κατὰ",32,1],["σάρκα",287,10],["γεγέννηται",222,722],["ὁ",1,4],["δὲ",14,8],["ἐκ",21,1],["τῆς",1,18],["ἐλευθέρας",1456,78],["δι᾽",56,1],["ἐπαγγελίας",3439,19]],"However, the son by the servant was born according to the flesh, but the son by the free woman was born through promise."],["24",[["ἅτινά",457,778],["ἐστιν",10,87],["ἀλληγορούμενα",11067,822],["αὗται",16,196],["γάρ",40,8],["εἰσιν",10,191],["δύο",104,372],["διαθῆκαι",169,180],["μία",58,15],["μὲν",281,12],["ἀπὸ",17,1],["ὄρους",87,24],["Σινᾶ",1952,24],["εἰς",8,1],["δουλείαν",1036,10],["γεννῶσα",222,183],["ἥτις",457,421],["ἐστὶν",10,87],["Ἁγάρ",2413,13]],"These things contain an allegory, for these are two covenants. One is from Mount Sinai, bearing children to bondage, which is Hagar."],["25",[["τὸ",1,27],["δὲ",14,8],["Ἁγὰρ",2413,13],["Σινᾶ",1952,20],["ὄρος",87,20],["ἐστὶν",10,87],["ἐν",4,1],["τῇ",1,95],["Ἀραβίᾳ",5280,2],["συστοιχεῖ",11068,87],["δὲ",14,8],["τῇ",1,95],["νῦν",90,17],["Ἰερουσαλήμ",823,2],["δουλεύει",398,87],["γὰρ",40,8],["μετὰ",29,1],["τῶν",1,44],["τέκνων",192,45],["αὐτῆς",3,83]],"For this Hagar is Mount Sinai in Arabia, and answers to the Jerusalem that exists now, for she is in bondage with her children."],["26",[["ἡ",1,11],["δὲ",14,8],["ἄνω",1314,17],["Ἰερουσαλὴμ",823,13],["ἐλευθέρα",1456,15],["ἐστὶν",10,87],["ἥτις",457,421],["ἐστὶν",10,87],["μήτηρ",189,13],["ἡμῶν",9994,136]],"But the Jerusalem that is above is free, which is the mother of us all."],["27",[["γέγραπται",186,722],["γάρ",40,8],["εὐφράνθητι",244,242],["στεῖρα",2380,356],["ἡ",1,676],["οὐ",12,12],["τίκτουσα",251,617],["ῥῆξον",1178,198],["καὶ",2,8],["βόησον",366,198],["ἡ",1,676],["οὐκ",12,12],["ὠδίνουσα",2436,617],["ὅτι",19,8],["πολλὰ",74,74],["τὰ",1,253],["τέκνα",192,63],["τῆς",1,18],["ἐρήμου",160,78],["μᾶλλον",1043,17],["ἢ",61,8],["τῆς",1,18],["ἐχούσης",124,212],["τὸν",1,6],["ἄνδρα",38,7]],"For it is written, “Rejoice, you barren who don’t bear. Break out and shout, you who don’t travail. For the desolate women have more children than her who has a husband.”"],["28",[["ὑμεῖς",5,208],["δέ",14,8],["ἀδελφοί",67,396],["κατὰ",32,1],["Ἰσαὰκ",451,7],["ἐπαγγελίας",3439,19],["τέκνα",192,63],["ἐστέ",10,84]],"Now we, brothers, as Isaac was, are children of promise."],["29",[["ἀλλ᾽",108,8],["ὥσπερ",226,8],["τότε",250,17],["ὁ",1,4],["κατὰ",32,1],["σάρκα",287,10],["γεννηθεὶς",222,206],["ἐδίωκεν",533,14],["τὸν",1,6],["κατὰ",32,1],["πνεῦμα",168,33],["οὕτως",9989,17],["καὶ",2,8],["νῦν",90,17]],"But as then, he who was born according to the flesh persecuted him who was born according to the Spirit, so also it is now."],["30",[["ἀλλὰ",108,8],["τί",10010,119],["λέγει",31,87],["ἡ",1,11],["γραφή",1505,13],["ἔκβαλε",585,198],["τὴν",1,9],["παιδίσκην",605,10],["καὶ",2,8],["τὸν",1,6],["υἱὸν",13,7],["αὐτῆς",3,83],["οὐ",12,12],["γὰρ",40,8],["μὴ",25,12],["κληρονομήσει",370,120],["ὁ",1,4],["υἱὸς",13,5],["τῆς",1,18],["παιδίσκης",605,19],["μετὰ",29,1],["τοῦ",1,30],["υἱοῦ",13,21],["τῆς",1,18],["ἐλευθέρας",1456,78]],"However, what does the Scripture say? “Throw out the servant and her son, for the son of the servant will not inherit with the son of the free woman.”"],["31",[["διό",1466,8],["ἀδελφοί",67,396],["οὐκ",12,12],["ἐσμὲν",10,241],["παιδίσκης",605,19],["τέκνα",192,63],["ἀλλὰ",108,8],["τῆς",1,18],["ἐλευθέρας",1456,78]],"So then, brothers, we are not children of a servant, but of the free woman."]]