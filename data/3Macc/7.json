[["1",[["Βασιλεὺς",22,5],["Πτολεμαῖος",1375,5],["ὁ",1,4],["Φιλοπάτωρ",4688,5],["τοῖς",1,138],["κατʼ",32,1],["Αἴγυπτον",93,10],["στρατηγοῖς",927,139],["καὶ",2,8],["πᾶσι",11,215],["τοῖς",1,138],["τεταγμένοις",721,437],["ἐπὶ",9,1],["πραγμάτων",511,45],["χαίρειν",698,54],["καὶ",2,8],["ἐῤῥῶσθαι",2858,435]],"King Ptolemy Philopator to the commanders throughout Egypt, and to all who are set over affairs, joy and strength."],["2",[["Ἐῤῥώμεθα",2858,388],["δὲ",14,12],["καὶ",2,8],["αὐτοὶ",3,195],["καὶ",2,8],["τὰ",1,42],["τέκνα",192,43],["ἡμῶν",6,41],["κατευθύναντος",827,513],["ἡμῖν",6,142],["τοῦ",1,30],["μεγάλου",66,153],["Θεοῦ",20,21],["τὰ",1,42],["πράγματα",511,43],["καθὼς",221,17],["προαιρούμεθα",2283,388]],"We, too, and our children are well; and God has directed our affairs as we wish."],["3",[["Τῶν",1,76],["φίλων",336,163],["τινὲς",39,402],["κακοηθείᾳ",3544,2],["πυκνότερον",3344,29],["ἡμῖν",6,142],["παρακείμενοι",2934,370],["συνέπεισαν",6097,141],["ἡμᾶς",6,60],["εἰς",8,1],["τὸ",1,32],["τοὺς",1,56],["ὑπὸ",122,1],["τὴν",1,9],["βασιλείαν",157,10],["Ἰουδαίους",285,31],["συναθροίσαντας",1336,458],["σύστημα",3368,20],["κολάσασθαι",1819,103],["ξενιζούσαις",4330,505],["ἀποστατῶν",3175,67],["τιμωρίαις",2293,71]],"Certain of our friends did of malice vehemently urge us to punish the Jews of our realm in a body, with the infliction of a monstrous punishment."],["4",[["προσφερόμενοι",363,351],["μήποτε",964,17],["εὐσταθήσειν",4229,81],["τὰ",1,42],["πράγματα",511,43],["ἡμῶν",6,41],["διʼ",56,1],["ἣν",24,124],["ἔχουσιν",124,191],["οὗτοι",16,213],["πρὸς",15,1],["πάντα",11,65],["τὰ",1,42],["ἔθνη",60,43],["δυσμένειαν",3820,10],["μέχρις",781,1],["ἂν",83,12],["συντελεσθῇ",317,333],["τοῦτο",16,122]],"They pretended that our affairs would never be in a good state till this took place. Such, they said, was the hatred borne by the Jews to all other people."],["5",[["Οἳ",1,128],["καὶ",2,8],["δεσμίους",2889,31],["καταγαγόντες",735,190],["αὐτοὺς",3,60],["μετὰ",29,1],["σκυλμῶν",5042,77],["ὡς",36,8],["ἀνδράποδα",8880,63],["μᾶλλον",1043,17],["δὲ",14,12],["ὡς",36,8],["ἐπιβούλους",2542,31],["ἄνευ",1101,1],["πάσης",11,78],["ἀνακρίσεως",8953,19],["καὶ",2,8],["ἐξετάσεως",6464,19],["ἐπεχείρησαν",2541,141],["ἀνελεῖν",651,100],["νόμου",140,21],["Σκυθῶν",3784,77],["ἀγριωτέραν",1454,37],["ἐμπεπορπημένοι",9371,370],["ὠμότητα",4666,10]],"They brought them fettered in grievous chains as slaves, nay, as traitors. Without enquiry or examination they endeavoured to annihilate them. They buckled themselves with a savage cruelty, worse than Scythian custom."],["6",[["Ἡμεῖς",6,195],["δὲ",14,12],["ἐπὶ",9,1],["τούτοις",16,416],["σκληρότερον",831,17],["διαπειλησάμενοι",4746,315],["καθʼ",32,1],["ἣν",24,124],["ἔχομεν",124,241],["πρὸς",15,1],["ἅπαντας",772,58],["ἀνθρώπους",43,31],["ἐπιείκειαν",3196,10],["μόγις",7737,17],["τὸ",1,32],["ζῇν",107,54],["αὐτοῖς",3,142],["χαρισάμενοι",3151,489],["καὶ",2,8],["τὸν",1,6],["ἐπουράνιον",4098,59],["Θεὸν",20,7],["ἐγνωκότες",79,263],["ἀσφαλῶς",4050,17],["ὑπερησπικότα",1716,508],["τῶν",1,76],["Ἰουδαίων",285,77],["ὡς",36,8],["πατέρα",44,7],["ὑπὲρ",139,1],["υἱῶν",13,77],["διαπαντὸς",510,17],["ὑπερμαχοῦντα",6638,289]],"For this cause we severely threatened them; yet, with the clemency which we are wont to extend to all men, we at length permitted them to live. Finding that the God of heaven cast a shield of protection over the Jews so as to preserve them, and that he fought for them as a father always fights for his sons;"],["7",[["τήν",1,9],["τε",209,12],["τοῦ",1,30],["φίλου",336,153],["ἣν",24,124],["ἔχουσι",124,191],["πρὸς",15,1],["ἡμᾶς",6,60],["βεβαίαν",3796,37],["καὶ",2,8],["τοὺς",1,56],["προγόνους",2623,31],["ἡμῶν",6,41],["εὔνοιαν",1960,10],["ἀναλογισάμενοι",8855,489],["δικαίως",2344,17],["ἀπολελύκαμεν",1395,311],["πάσης",11,78],["καθʼ",32,1],["ὁντινοῦν",457,106],["αἰτίας",1954,19],["τρόπον",245,7]],"and taking into consideration their constancy and fidelity towards us and towards our ancestors, we have, as we ought, acquitted them of every sort of charge."],["8",[["καὶ",2,8],["προστετάχαμεν",791,311],["ἑκάστῳ",171,111],["πάντας",11,58],["εἰς",8,1],["τὰ",1,42],["ἴδια",683,65],["ἐπιστρέφειν",117,54],["ἐν",4,1],["παντὶ",11,111],["τόπῳ",99,113],["μηθενὸς",908,219],["αὐτοὺς",3,60],["τὸ",1,32],["σύνολον",3366,29],["καταβλάπτοντος",7329,143],["μήτε",2098,12],["ὀνειδίζειν",945,54],["περὶ",72,1],["τῶν",1,76],["γεγενημένων",30,412],["παρὰ",73,1],["λόγον",48,7]],"And we have dismissed them to their several homes; bidding all men everywhere to do them no wrong, or unrighteously revile them about the past."],["9",[["Γινώσκετε",79,84],["γὰρ",40,12],["ὅτι",19,8],["κατὰ",32,1],["τούτων",16,214],["ἐάν",45,8],["τι",39,119],["κακοτεχνήσωμεν",7305,75],["πονηρόν",164,29],["ἢ",61,8],["ἐπιλυπήσωμεν",5330,75],["αὐτοὺς",3,60],["τὸ",1,32],["σύνολον",3366,29],["οὐκ",12,17],["ἄνθρωπον",43,7],["ἀλλὰ",108,17],["τὸν",1,6],["πάσης",11,78],["δεσπόζοντα",2014,178],["δυνάμεως",98,19],["Θεὸν",20,7],["ὕψιστον",474,59],["ἀντικείμενον",2210,442],["ἡμῖν",6,142],["ἐπʼ",9,1],["ἐκδικήσει",539,120],["τῶν",1,44],["πραγμάτων",511,45],["κατὰ",32,1],["πᾶν",11,29],["ἀφεύκτως",9215,17],["δια",56,1],["παντὸς",11,153],["ἕξομεν",124,269],["ἔῤῥωσθε",2858,68]],"For know ye, that should we conceive any evil design against, or in any manner aggrieve them, we shall ever have as our opposite, not man, but the highest God, the ruler of all might. From Him there will be no escape, as the avenger of such deeds. Fare ye well."],["10",[["Λαβόντες",46,190],["δὲ",14,12],["τὴν",1,9],["ἐπιστολὴν",866,10],["ταύτην",16,234],["οὐκ",12,17],["ἐσπούδασαν",2490,141],["εὐθέως",1673,17],["γενέσθαι",30,103],["περὶ",72,1],["τὴν",1,9],["ἄφοδον",9218,10],["ἀλλὰ",108,17],["τὸν",1,6],["βασιλέα",22,7],["προσηξίωσαν",8077,141],["τοὺς",1,56],["ἐκ",21,1],["τοῦ",1,23],["γένους",519,24],["τῶν",1,76],["Ἰουδαίων",285,77],["τὸν",1,6],["ἅγιον",75,59],["Θεὸν",20,7],["αὐθαιρέτως",4695,17],["παραβεβηκότας",788,276],["καὶ",2,8],["τοῦ",1,30],["Θεοῦ",20,21],["τὸν",1,6],["νόμον",140,7],["τυχεῖν",1451,100],["διʼ",56,1],["αὐτῶν",3,41],["τῆς",1,18],["ὀφειλομένης",2150,428],["κολάσεως",2174,19]],"When they had received this letter, they were not forward to depart immediately. They petitioned the king to be allowed to inflict fitting punishment upon those of their race who had willingly transgressed the holy God, and the law of God."],["11",[["προφερόμενοι",3936,351],["τοὺς",1,56],["γαστρὸς",777,19],["ἕνεκεν",447,1],["τὰ",1,42],["θεῖα",1343,65],["παραβεβηκότας",788,276],["προστάγματα",393,43],["μηδέποτε",4911,17],["εὐνοήσειν",5621,81],["μηδὲ",414,12],["τοῖς",1,138],["τοῦ",1,30],["βασιλέως",22,21],["πράγμασιν",511,92]],"They alleged that men who had for their bellies' sake transgressed the ordinances of God, would never be faithful to the interests of the king."],["12",[["Ὁ",1,4],["δὲ",14,12],["τἀληθὲς",1923,28],["αὐτοὺς",3,60],["λέγειν",31,54],["παραδεξάμενος",4345,244],["καὶ",2,8],["συναινέσας",5067,155],["ἔδωκεν",33,3],["αὐτοῖς",3,142],["ἄδειαν",5259,10],["πάντων",11,163],["ὅπως",240,8],["τοὺς",1,56],["παραβεβηκότας",788,276],["τοῦ",1,30],["Θεοῦ",20,21],["τὸν",1,6],["νόμον",140,7],["ἐξολοθρεύσωσι",291,224],["κατὰ",32,1],["πάντα",11,59],["τὸν",1,6],["ὑπὸ",122,1],["τὴν",1,9],["βασιλείαν",157,10],["αὐτοῦ",3,48],["τόπον",99,7],["μετὰ",29,1],["παῤῥησίας",2610,19],["ἄνευ",1101,1],["πάσης",11,78],["βασιλικῆς",1298,78],["ἐξουσίας",929,19],["ἢ",61,8],["ἐπισκέψεως",852,19]],"The king admitted the truth of this reasoning, and commended them. Full power was given them, without warrant or special commission, to destroy those who had transgressed the law of God boldly in every part of the king's dominions."],["13",[["Τότε",250,17],["κατευφημήσαντες",7426,190],["αὐτόν",3,82],["ὡς",36,8],["πρέπον",2762,36],["ἦν",10,14],["οἱ",1,128],["τούτων",16,214],["ἱερεῖς",65,31],["καὶ",2,8],["πᾶν",11,29],["τὸ",1,32],["πλῆθος",200,33],["ἐπιφωνήσαντες",5336,190],["τὸ",1,32],["ἁλληλούϊα",1749,105],["μετὰ",29,1],["χαρᾶς",1125,19],["ἀνέλυσαν",1986,141]],"Their priests, then, as it was meet, saluted him with good wishes, and all the people echoed with the Hallelujah. They then joyfully departed."],["14",[["Τότε",250,17],["τὸν",1,6],["ἐμπεσόντα",994,476],["τῶν",1,76],["μεμιασμένων",468,412],["ὁμοεθνῆ",3473,37],["κατὰ",32,1],["τὴν",1,9],["ὁδὸν",68,10],["ἐκολάζοντο",1819,131],["καὶ",2,8],["μετὰ",29,1],["παραδειγματισμῶν",5893,77],["ἀνῄρουν",651,129]],"Then they punished and destroyed with ignominy every polluted Jew that fell in their way;"],["15",[["Ἐκείνῃ",80,99],["δὲ",14,12],["τῇ",1,95],["ἡμέρᾳ",28,2],["ἀνεῖλον",651,141],["ὑπὲρ",139,1],["τοὺς",1,56],["τριακοσίους",673,58],["ἄνδρας",38,31],["καὶ",2,8],["ἤγαγον",224,141],["εὐφροσύνην",360,10],["μετὰ",29,1],["χαρᾶς",1125,19],["τοὺς",1,56],["βεβήλους",3039,58],["χειρωσάμενοι",3384,315]],"slaying thus, in that day, above three hundred men, and esteeming this destruction of the wicked a season of joy."],["16",[["Αὐτοὶ",3,195],["δὲ",14,12],["οἱ",1,128],["μέχρι",781,1],["θανάτου",170,21],["τὸν",1,6],["Θεὸν",20,7],["ἐσχηκότες",124,263],["παντελῆ",3603,59],["σωτηρίας",425,19],["ἀπόλαυσιν",9081,10],["εἰληφότες",46,263],["ἀνέζευξαν",2048,141],["ἐκ",21,1],["τῆς",1,18],["πόλεως",41,19],["παντοίοις",4341,90],["εὐωδεστάτοις",4231,90],["ἄνθεσι",1529,92],["κατεστεμμένοι",7387,370],["μετʼ",29,1],["εὐφροσύνης",360,19],["καὶ",2,8],["βοῆς",366,145],["ἐν",4,1],["αἴνοις",1763,139],["καὶ",2,8],["παμμέλεσιν",7830,215],["ὕμνοις",1498,139],["εὐχαριστοῦντες",3831,137],["τῷ",1,110],["Θεῷ",20,113],["τῶν",1,76],["πατέρων",44,77],["αὐτῶν",3,41],["αἰωνίῳ",391,111],["σωτῆρι",1388,113],["τοῦ",1,30],["Ἰσραήλ",27,105]],"They themselves having held fast their God unto death, and having enjoyed a full deliverance, departed from the city garlanded with sweet-flowered wreaths of every kind. Uttering exclamations of joy, with songs of praise, and melodious hymns they thanked the God of their fathers, the eternal Saviour of Israel."],["17",[["Παραγενηθέντες",377,243],["δὲ",14,12],["εἰς",8,1],["Πτολεμαΐδα",1951,10],["τὴν",1,9],["ὀνομαζομένην",1662,167],["διὰ",56,1],["τὴν",1,9],["τοῦ",1,30],["τόπου",99,21],["ἰδιότητα",6583,10],["ῥοδοφόρον",9970,37],["ἐν",4,1],["ᾗ",24,102],["προσέμεινεν",5995,3],["αὐτοὺς",3,60],["ὁ",1,4],["στόλος",4399,5],["κατὰ",32,1],["κοινὴν",1515,37],["αὐτῶν",3,41],["βουλὴν",350,10],["ἡμέρας",28,19],["ἑπτὰ",180,57]],"Having arrived at Ptolemais, called from the specialty of that district Rose-bearing, where the fleet, in accordance with the general wish, waited for them seven days,"],["18",[["ἐκεῖ",76,17],["ἐποίησαν",23,141],["πότον",1356,7],["σωτήριον",472,33],["τοῦ",1,30],["βασιλέως",22,21],["χορηγήσαντος",2204,513],["αὐτοῖς",3,142],["εὐψύχως",4232,17],["τὰ",1,42],["πρὸς",15,1],["τὴν",1,9],["ἄφιξιν",9217,10],["πάντα",11,65],["ἑκάστῳ",171,111],["ἕως",42,8],["εἰς",8,1],["τὴν",1,9],["ἰδίαν",683,37],["οἰκίαν",233,10]],"they partook of a banquet of deliverance, for the king generously granted them severally the means of securing a return home."],["19",[["Καταχθέντες",735,243],["δὲ",14,12],["μετʼ",29,1],["εἰρήνης",213,19],["ἐν",4,1],["ταῖς",1,70],["πρεπούσαις",2762,505],["ἐξομολογήσεσιν",1934,71],["ὡσαύτως",1240,17],["κᾀκεῖ",10035,453],["ἔστησαν",78,141],["καὶ",2,8],["ταύτας",16,280],["ἄγειν",224,54],["τὰς",1,39],["ἡμέρας",28,19],["ἐπὶ",9,1],["τὸν",1,6],["τῆς",1,18],["παροικίας",2105,19],["αὐτῶν",3,41],["χρόνον",486,7],["εὐφροσύνους",4780,58]],"They were accordingly brought back in peace, while they gave utterance to becoming thanks; and they determined to keep these days during their sojourn as days of joyfulness."],["20",[["Ἃς",24,186],["καὶ",2,8],["ἀνιερώσαντες",6277,190],["ἐν",4,1],["στήλῃ",1064,2],["κατὰ",32,1],["τὸν",1,6],["τῆς",1,18],["συμποσίας",4405,19],["τόπον",99,7],["προσευχῆς",550,19],["καθιδρύσαντες",4806,190],["ἀνέλυσαν",1986,141],["ἀσινεῖς",6343,130],["ἐλεύθεροι",1456,130],["ὑπερχαρεῖς",6640,130],["διά",56,1],["τε",209,12],["γῆς",26,19],["καὶ",2,8],["θαλάσσης",137,19],["καὶ",2,8],["ποταμοῦ",249,21],["ἀνασωζόμενοι",1568,351],["τῇ",1,95],["τοῦ",1,30],["βασιλέως",22,21],["ἐπιταγῇ",1405,333],["ἕκαστος",171,16],["εἰς",8,1],["τὴν",1,9],["ἰδίαν",683,37]],"These they registered as sacred upon a pillar, when they had dedicated the place of their festivity to be one of prayer. They departed unharmed, free, abundant in joy, preserved by the king's command, by land, by sea, and by river, each to his own home."],["21",[["Καὶ",2,8],["πλείστην",2035,37],["ἢ",61,8],["ἔμπροσθεν",390,17],["ἐν",4,1],["τοῖς",1,138],["ἐχθροῖς",135,139],["ἐξουσίαν",929,10],["ἐσχηκότες",124,263],["μετὰ",29,1],["δόκης",801,217],["καὶ",2,8],["φόβου",333,21],["τὸ",1,32],["σύνολον",3366,29],["ὑπὸ",122,1],["μηδενὸς",908,219],["διασεισθέντες",5563,243],["τῶν",1,76],["ὑπαρχόντων",418,164]],"They had more weight than before among their enemies; and were honoured and feared, and no one in any way robbed them of their goods."],["22",[["Καὶ",2,8],["πάντα",11,65],["τὰ",1,42],["ἑαυτῶν",92,41],["πάντες",11,130],["ἐκομίσαντο",1592,184],["ἐξ",21,1],["ἀπογραφῆς",4035,19],["ὥστε",346,17],["τοὺς",1,56],["ἔχοντάς",124,229],["τι",39,119],["μετὰ",29,1],["φόβου",333,21],["μεγίστου",66,153],["ἀποδοῦναι",312,100],["αὐτοῖς",3,142],["τὰ",1,42],["μεγαλεῖα",2268,65],["τοῦ",1,30],["μεγίστου",66,153],["Θεοῦ",20,21],["ποιήσαντος",23,513],["τελείως",4433,17],["ἐπὶ",9,1],["σωτηρίᾳ",425,180],["αὐτῶν",3,41]],"Every man received back his own, according to inventory; those who had obtained their goods, giving them up with the greatest terror. For the greatest God wrought with perfectness wonders for their salvation."],["23",[["Εὐλογητὸς",767,16],["ὁ",1,4],["ῥύστης",4149,5],["Ἰσραὴλ",27,105],["εἰς",8,1],["τοὺς",1,56],["ἀεὶ",2401,17],["χρόνους",486,31],["Ἀμήν",3161,316]],"Blessed be the Redeemer of Israel unto everlasting. Amen."]]