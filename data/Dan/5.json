],["δόξῃ",141,2],["δώσει",33,120],["αὐτήν",3,98]],"And he was driven forth from men; and his heart was given him after the nature of wild beasts, and his dwelling was with the wild asses; and they fed him with grass as an ox, and his body was bathed with the dew of heaven; until he knew that the most high God is Lord of the kingdom of men, and will give it to whomsoever he shall please."],["22",[["Καὶ",2,8],["σὺ",5,156],["οὖν",227,12],["ὁ",1,4],["υἱὸς",13,5],["αὐτοῦ",3,48],["Βαλτάσαρ",0,0],["οὐκ",12,17],["ἐταπείνωσας",322,154],["τὴν",1,9],["καρδίαν",64,10],["σου",5,146],["κατενώπιον",3558,129],["τοῦ",1,30],["Θεοῦ",20,21],["οὐ",12,17],["πάντα",11,65],["ταῦτα",16,248],["ἔγνως",79,154]],"And thou accordingly, his son, O Baltasar, hast not humbled thine heart before God: knowest thou not all this?"],["23",[["Καὶ",2,8],["ἐπὶ",9,1],["τὸν",1,6],["Κύριον",7,7],["Θεὸν",20,7],["τοῦ",1,30],["οὐρανοῦ",94,21],["ὑψώθης",331,360],["καὶ",2,8],["τὰ",1,42],["σκεύη",182,43],["τοῦ",1,30],["οἴκου",34,21],["αὐτοῦ",3,48],["ἤνεγκαν",199,141],["ἐνώπιόν",115,1],["σου",5,146],["καὶ",2,8],["σὺ",5,156],["καὶ",2,8],["οἱ",1,128],["μεγιστᾶνές",1682,51],["σου",5,146],["καὶ",2,8],["αἱ",1,185],["παλλακαί",1120,180],["σου",5,146],["καὶ",2,8],["αἱ",1,185],["παράκοιτοί",4962,51],["σου",5,146],["οἶνον",261,7],["ἐπίνετε",212,339],["ἐν",4,1],["αὐτοῖς",3,142],["καὶ",2,8],["τοὺς",1,56],["θεοὺς",20,31],["τοὺς",1,56],["χρυσοῦς",290,58],["καὶ",2,8],["ἀργυροῦς",590,58],["καὶ",2,8],["χαλκοῦς",614,58],["καὶ",2,8],["σιδηροῦς",1063,58],["καὶ",2,8],["ξυλίνους",1417,58],["καὶ",2,8],["λιθίνους",1632,58],["οἳ",1,128],["οὐ",12,17],["βλέπουσι",470,191],["καὶ",2,8],["οἳ",1,128],["οὐκ",12,17],["ἀκούουσι",54,191],["καὶ",2,8],["οὐ",12,17],["γινώσκουσιν",79,352],["ᾔνεσας",402,154],["καὶ",2,8],["τὸν",1,6],["Θεὸν",20,7],["οὗ",120,17],["ἡ",1,11],["πνοή",1637,13],["σου",5,146],["ἐν",4,1],["χειρὶ",37,2],["αὐτοῦ",3,48],["καὶ",2,8],["πᾶσαι",11,187],["αἱ",1,185],["ὁδοί",68,180],["σου",5,146],["αὐτὸν",3,82],["οὐκ",12,17],["ἐδόξασας",452,154]],"And thou hast been exalted against the Lord God of heaven; and they have brought before thee the vessels of his house, and thou, and thy nobles, and thy mistresses, and thy concubines, have drunk wine out of them; and thou hast praised the gods of gold, and silver, and brass, and iron, and wood, and stone, which see not, and which hear not, and know not: and the God in whose hand are thy breath and all thy ways hast thou not glorified."],["24",[["Διατοῦτο",0,0],["ἐκ",21,1],["προσώπου",47,24],["αὐτοῦ",3,144],["ἀπεστάλη",84,38],["ἀστράγαλος",5241,5],["χειρὸς",37,19],["καὶ",2,8],["τὴν",1,9],["γραφὴν",1505,10],["ταύτην",16,234],["ἐνέταξε",3436,3]],"Therefore from his presence has been sent forth the knuckle of a hand; and he has ordered this writing."],["25",[["Καὶ",2,8],["αὕτη",16,101],["ἡ",1,11],["γραφὴ",1505,13],["ἐντεταγμένη",3436,197],["Μανὴ",12264,15],["Θεκὲλ",5647,105],["Φάρες",5470,7]],"And this is the ordered writing, Mane, Thekel, Phares."],["26",[["Τοῦτο",16,122],["τὸ",1,32],["σύγκριμα",3143,33],["τοῦ",1,23],["ῥήματος",116,24],["Μανὴ",12264,15],["ἐμέτρησεν",3299,3],["ὁ",1,4],["Θεὸς",20,5],["τὴν",1,9],["βασιλείαν",157,10],["σου",5,146],["καὶ",2,8],["ἐπλήρωσεν",518,3],["αὐτήν",3,98]],"This is the interpretation of the sentence: Mane; God has measured thy kingdom, and finished it."],["27",[["Θεκὲλ",5647,105],["ἐστάθη",78,38],["ἐν",4,1],["ζυγῷ",920,113],["καὶ",2,8],["εὑρέθη",101,38],["ὑστεροῦσα",1947,183]],"Thekel; it has been weighed in the balance, and found wanting."],["28",[["Φάρες",5470,7],["διήρηται",7000,182],["ἡ",1,11],["βασιλεία",157,13],["σου",5,146],["καὶ",2,8],["ἐδόθη",33,38],["Μήδοις",1761,139],["καὶ",2,8],["Πέρσαις",868,139]],"Phares; thy kingdom is divided, and given to the Medes and Persians."],["29",[["Καὶ",2,8],["εἶπε",18,3],["Βαλτάσαρ",0,0],["καὶ",2,8],["ἐνέδυσαν",516,141],["τον",1,6],["Δανιὴλ",489,105],["πορφύραν",1062,10],["καὶ",2,8],["τὸν",1,6],["μανιάκην",4302,7],["τὸν",1,6],["χρυσοῦν",290,59],["περιέθηκαν",1017,141],["περὶ",72,1],