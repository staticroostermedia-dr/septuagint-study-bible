[["1",[["Ἐν",4,1],["τῷ",1,110],["ἰάσασθαί",797,389],["με",6,82],["τὸν",1,6],["Ἰσραὴλ",27,105],["καὶ",2,8],["ἀποκαλυφθήσεται",652,125],["ἡ",1,11],["ἀδικία",288,13],["Ἐφραὶμ",308,105],["καὶ",2,8],["ἡ",1,11],["κακία",433,13],["Σαμαρείας",475,19],["ὅτι",19,8],["εἰργάσαντο",467,430],["ψευδῆ",549,74],["καὶ",2,8],["κλέπτης",2358,5],["πρὸς",15,1],["αὐτὸν",3,82],["εἰσελεύσεται",86,89],["ἐκδιδύσκων",4566,67],["λῃστὴς",2916,5],["ἐν",4,1],["τῇ",1,95],["ὁδῷ",68,2],["αὐτοῦ",3,48]],"When I have healed Israel, then shall the iniquity of Ephraim be revealed, and the wickedness of Samaria; for they have wrought falsehood: and a thief shall come in to him, [even] a robber spoiling in his way;"],["2",[["ὅπως",240,8],["συνᾴδωσιν",8444,265],["ὡς",36,8],["ᾄοντες",0,0],["τῇ",1,95],["καρδίᾳ",64,2],["αὐτῶν",3,41],["πάσας",11,109],["τὰς",1,39],["κακίας",433,40],["αὐτῶν",3,41],["ἐμνήσθην",230,148],["νῦν",90,17],["ἐκύκλωσαν",603,141],["αὐτοὺς",3,60],["τὰ",1,42],["διαβούλια",2704,43],["αὐτῶν",3,41],["ἀπέναντι",583,17],["τοῦ",1,23],["προσώπου",47,24],["μου",6,48],["ἐγένοντο",30,184]],"that they may concert together as [men] singing in their heart: I remember all their wickedness: now have their own counsels compassed them about; they came before my face."],["3",[["Ἐν",4,1],["ταῖς",1,70],["κακίαις",433,71],["αὐτῶν",3,41],["εὔφραναν",244,141],["βασιλεῖς",22,51],["καὶ",2,8],["ἐν",4,1],["τοῖς",1,91],["ψεύδεσιν",1392,92],["αὐτῶν",3,41],["ἄρχοντας",96,31]],"They gladdened kings with their wickedness, and princes with their lies."],["4",[["Πάντες",11,130],["μοιχεύοντες",2466,137],["ὡς",36,8],["κλίβανος",2592,5],["καιόμενος",671,114],["εἰς",8,1],["πέψιν",8194,10],["κατακαύματος",2727,24],["ἀπὸ",17,1],["τῆς",1,18],["φλογὸς",983,19],["ἀπὸ",17,1],["φυράσεως",8649,19],["στέατος",576,24],["ἕως",42,8],["τοῦ",1,23],["ζυμωθῆναι",3836,175],["αὐτό",3,121]],"They are all adulterers, as an oven glowing with flame for hot-baking, on account of the kneading of the dough, until it is leavened."],["5",[["Ἡμέραι",28,2],["τῶν",1,76],["βασιλέων",22,77],["ὑμῶν",5,136],["ἤρξαντο",320,184],["οἱ",1,128],["ἄρχοντες",96,51],["θυμοῦσθαι",871,104],["ἐξ",21,1],["οἴνου",261,21],["ἐξέτεινε",421,3],["τὴν",1,9],["χεῖρα",37,10],["αὐτοῦ",3,48],["μετὰ",29,1],["λοιμῶν",1518,77]],"[In] the days of our kings, the princes began to be inflamed with wine: he stretched out his hand with pestilent fellows."],["6",[["Διότι",177,8],["ἀνεκαύθησαν",3399,94],["ὡς",36,8],["κλίβανος",2592,5],["αἱ",1,185],["καρδίαι",64,2],["αὐτῶν",3,41],["ἐν",4,1],["τῷ",1,110],["καταράσσειν",2585,54],["αὐτοὺς",3,60],["ὅλην",235,37],["τὴν",1,9],["νύκτα",219,10],["ὕπνου",1010,21],["Ἐφραὶμ",308,105],["ἐνεπλήσθη",427,38],["πρωῒ",504,17],["ἐνεγενήθη",9253,38],["ἀνεκαύθη",3399,38],["ὡς",36,8],["πυρὸς",118,24],["φέγγος",1644,33]],"Wherefore their hearts are inflamed as an oven, while they rage all the night: Ephraim is satisfied with sleep; the morning is come; he is burnt up as a flame of fire."],["7",[["Πάντες",11,130],["ἐθερμάνθησαν",2350,94],["ὡς",36,8],["κλίβανος",2592,5],["καὶ",2,8],["κατέφαγον",407,147],["τοὺς",1,56],["κριτὰς",749,31],["αὐτῶν",3,41],["πάντες",11,130],["οἱ",1,128],["βασιλεῖς",22,51],["αὐτῶν",3,41],["ἔπεσαν",154,141],["οὐκ",12,17],["ἦν",10,14],["ἐν",4,1],["αὐτοῖς",3,142],["ὁ",1,4],["ἐπικαλούμενος",341,114],["πρὸς",15,1],["μέ",6,82]],"They are all heated like an oven, and have devoured their judges: all their kings are fallen; there was not among them one that called on me."],["8",[["Ἐφραὶμ",308,105],["ἐν",4,1],["τοῖς",1,138],["λαοῖς",35,139],["αὐτοῦ",3,48],["συνεμίγνυτο",2632,22],["Ἐφραὶμ",308,105],["ἐγένετο",30,26],["ἐγκρυφίας",3422,5],["οὐ",12,17],["μεταστρεφόμενος",1635,114]],"Ephraim is mixed among his people; Ephraim became a cake not turned."],["9",[["Κατέφαγον",407,147],["ἀλλότριοι",381,130],["τὴν",1,9],["ἰσχὺν",181,10],["αὐτοῦ",3,48],["αὐτὸς",3,158],["δὲ",14,12],["οὐκ",12,17],["ἔγνω",79,3],["καὶ",2,8],["πολιαὶ",2108,180],["ἐξήνθησαν",1800,141],["αὐτῷ",3,49],["καὶ",2,8],["αὐτὸς",3,158],["οὐκ",12,17],["ἔγνω",79,3]],"Strangers devoured his strength, and he knew [it] not; and grey hairs came upon him, and he knew [it] not."],["10",[["Καὶ",2,8],["ταπεινωθήσεται",322,125],["ἡ",1,11],["ὕβρις",837,13],["Ἰσραὴλ",27,105],["εἰς",8,1],["πρόσωπον",47,33],["αὐτοῦ",3,48],["καὶ",2,8],["οὐκ",12,17],["ἐπέστρεψαν",117,141],["πρὸς",15,1],["Κύριον",7,7],["τὸν",1,6],["Θεὸν",20,7],["αὐτῶν",3,41],["καὶ",2,8],["οὐκ",12,17],["ἐξεζήτησαν",460,141],["αὐτὸν",3,82],["ἐν",4,1],["πᾶσι",11,215],["τούτοις",16,193]],"And the pride of Israel shall be brought down before his face: yet they have not returned to the Lord their God, neither have they diligently sought him for all this."],["11",[["Καὶ",2,8],["ἦν",10,14],["Ἐφραὶμ",308,105],["ὡς",36,8],["περιστερὰ",1280,13],["ἄνους",4060,13],["οὐκ",12,17],["ἔχουσα",124,183],["καρδίαν",64,10],["Αἴγυπτον",93,10],["ἐπεκαλεῖτο",341,22],["καὶ",2,8],["εἰς",8,1],["Ἀσσυρίους",11614,58],["ἐπορεύθησαν",49,94]],"And Ephraim was as a silly dove, not having a heart: he called to Egypt, and they went to the Assyrians."],["12",[["Καθὼς",221,17],["ἂν",83,12],["πορεύωνται",49,391],["ἐπιβαλῶ",724,157],["ἐπʼ",9,1],["αὐτοὺς",3,60],["τὸ",1,32],["δίκτυόν",1721,33],["μου",6,48],["καθὼς",221,17],["τὰ",1,42],["πετεινὰ",572,43],["τοῦ",1,30],["οὐρανοῦ",94,21],["κατάξω",735,157],["αὐτοὺς",3,60],["παιδεύσω",643,157],["αὐτοὺς",3,60],["ἐν",4,1],["τῇ",1,95],["ἀκοῇ",1047,2],["τῆς",1,18],["θλίψεως",438,19],["αὐτῶν",3,41]],"Whenever they shall go, I will cast my net upon them; I will bring them down as the birds of the sky, I will chasten them with the rumour of their [coming] affliction."],["13",[["Οὐαὶ",769,316],["αὐτοῖς",3,142],["ὅτι",19,8],["ἀπεπήδησαν",5226,129],["ἀπʼ",17,1],["ἐμοῦ",6,48],["δείλαιοί",3807,130],["εἰσιν",10,191],["ὅτι",19,8],["ἠσέβησαν",1256,141],["εἰς",8,1],["ἐμέ",6,82],["ἐγὼ",6,158],["δὲ",14,12],["ἐλυτρωσάμην",535,152],["αὐτοὺς",3,60],["αὐτοὶ",3,195],["δὲ",14,12],["κατελάλησαν",2356,141],["κατʼ",32,1],["ἐμοῦ",6,48],["ψευδῆ",549,74]],"Woe to them! for they have started aside from me: they are cowards; for they have sinned against me: yet I redeemed them, but they spoke falsehoods against me."],["14",[["Καὶ",2,8],["οὐκ",12,17],["ἐβόησαν",366,129],["πρὸς",15,1],["μὲ",6,82],["αἱ",1,185],["καρδίαι",64,2],["αὐτῶν",3,41],["ἀλλʼ",108,17],["ἢ",61,8],["ὠλόλυζον",1872,129],["ἐν",4,1],["ταῖς",1,70],["κοίταις",704,71],["αὐτῶν",3,41],["ἐπὶ",9,1],["σίτῳ",665,113],["καὶ",2,8],["οἴνῳ",261,113],["κατετέμνοντο",4264,131]],"And their hearts did not cry to me, but they howled on their beds: they pined for oil and wine."],["15",[["Ἐπαιδεύθησαν",643,94],["ἐν",4,1],["ἐμοὶ",6,49],["κᾀγὼ",613,105],["κατίσχυσα",628,147],["τοὺς",1,56],["βραχίονας",618,58],["αὐτῶν",3,41],["καὶ",2,8],["εἰς",8,1],["ἐμὲ",6,82],["ἐλογίσαντο",495,430],["πονηρά",164,15]],"They were instructed by me, and I strengthened their arms; and they devised evils against me."],["16",[["Ἀπεστράφησαν",130,94],["εἰς",8,1],["οὐδὲν",228,29],["ἐγένοντο",30,184],["ὡς",36,8],["τόξον",711,20],["ἐντεταμένον",1991,326],["πεσοῦνται",154,127],["ἐν",4,1],["ῥομφαίᾳ",248,2],["οἱ",1,128],["ἄρχοντες",96,51],["αὐτῶν",3,41],["διʼ",56,1],["ἀπαιδευσίαν",4518,10],["γλώσσης",388,19],["αὐτῶν",3,41],["οὗτος",16,112],["ὁ",1,4],["φαυλισμὸς",5119,5],["αὐτῶν",3,41],["ἐν",4,1],["γῇ",26,2],["Αἰγύπτῳ",93,2]],"They turned aside to that which is not, they became as a bent bow: their princes shall fall by the sword, by reason of the unbridled state of their tongue: this is their setting at nought in the land of Egypt."]]