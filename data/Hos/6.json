[["1",[["πορευθῶμεν",49,282],["καὶ",2,8],["ἐπιστρέψωμεν",117,75],["πρὸς",15,1],["Κύριον",7,7],["τὸν",1,6],["Θεὸν",20,7],["ἡμῶν",6,41],["ὅτι",19,8],["αὐτὸς",3,158],["ἥρπακε",1214,165],["καὶ",2,8],["ἰάσεται",797,394],["ἡμᾶς",6,60],["πατάξει",145,120]],"Let us go, and return to the Lord our God; for he has torn, and will heal us; he will smite, and bind us up."],["2",[["καὶ",2,8],["μοτώσει",7707,120],["ἡμᾶς",6,60],["ὑγιάσει",2851,120],["ἡμᾶς",6,60],["μετὰ",29,1],["δύο",104,57],["ἡμέρας",28,19],["ἐν",4,1],["τῇ",1,95],["ἡμέρᾳ",28,2],["τῇ",1,95],["τρίτῃ",357,96],["ἐξαναστησόμεθα",1292,132]],"After two days he will heal us: in the third day we shall arise,",{"s":"r"}],["3",[["καὶ",2,8],["ζησόμεθα",107,132],["ἐνώπιον",115,1],["αὐτοῦ",3,48],["καὶ",2,8],["γνωσόμεθα",79,132],["διώξωμεν",533,75],["τοῦ",1,30],["γνῶναι",79,100],["τὸν",1,6],["Κύριον",7,7],["ὡς",36,8],["ὄρθρον",1434,7],["ἕτοιμον",904,59],["εὑρήσομεν",101,269],["αὐτὸν",3,82],["καὶ",2,8],["ἥξει",260,120],["ὡς",36,8],["ὑετὸς",676,5],["ἡμῖν",6,142],["πρώϊμος",3124,16],["καὶ",2,8],["ὄψιμος",3476,16],["γῇ",26,2]],"and live before him, and shall know [him]: let us follow on to know the Lord: we shall find him ready as the morning, and he will come to us as the early and latter rain to the earth.",{"s":"r"}],["4",[["Τί",39,119],["σοι",5,151],["ποιήσω",23,227],["Ἐφραίμ",308,105],["τί",39,119],["σοι",5,151],["ποιήσω",23,227],["Ἰούδα",62,21],["τὸ",1,32],["δὲ",14,12],["ἔλεος",183,33],["ὑμῶν",5,136],["ὡς",36,8],["νεφέλη",444,13],["πρωϊνὴ",2621,15],["καὶ",2,8],["ὡς",36,8],["δρόσος",1135,13],["ὀρθρινὴ",4641,15],["πορευομένη",49,204]],"What shall I do unto thee, Ephraim? What shall I do to thee, Juda? whereas your mercy is as a morning cloud, and as the early dew that goes away."],["5",[["Διὰ",56,1],["τοῦτο",16,122],["ἀπεθέρισα",9002,147],["τοὺς",1,56],["προφήτας",176,31],["ὑμῶν",5,136],["ἀπέκτεινα",300,147],["αὐτοὺς",3,60],["ἐν",4,1],["ῥήματι",116,53],["στόματός",123,24],["μου",6,48],["καὶ",2,8],["τὸ",1,32],["κρίμα",267,33],["μου",6,48],["ὡς",36,8],["φῶς",380,20],["ἐξελεύσεται",82,89]],"Therefore have I mown down your prophets; I have slain them with the word of my mouth: and my judgment shall go forth as the light."],["6",[["Διότι",177,8],["ἔλεος",183,33],["θέλω",612,149],["ἢ",61,8],["θυσίαν",156,10],["καὶ",2,8],["ἐπίγνωσιν",3449,10],["Θεοῦ",20,21],["ἢ",61,8],["ὁλοκαυτώματα",318,43]],"For I will [have] mercy rather than sacrifice, and the knowledge of God rather than whole-burnt-offerings."],["7",[["Αὐτοὶ",3,195],["δέ",14,12],["εἰσιν",10,191],["ὡς",36,8],["ἄνθρωπος",43,5],["παραβαίνων",788,67],["διαθήκην",169,10],["ἐκεῖ",76,17],["κατεφρόνησέ",1677,3],["μου",6,48],["Γαλαὰδ",11550,0],["πόλις",41,13]],"But they are as a man transgressing a covenant: there the city Galaad despised me,",{"s":"r"}],["8",[["ἐργαζομένη",467,204],["μάταια",654,74],["ταράσσουσα",508,183],["ὕδωρ",85,33]],"working vanity, troubling water.",{"s":"r"}],["9",[["καὶ",2,8],["ἡ",1,11],["ἰσχύς",181,13],["σου",5,146],["ἀνδρὸς",38,21],["πειρατοῦ",4968,21],["ἔκρυψαν",372,141],["ἱερεῖς",65,31],["ὁδόν",68,10],["ἐφόνευσαν",970,141],["Σίκιμα",2965,105],["ὅτι",19,8],["ἀνομίαν",275,10],["ἐποίησαν",23,141],["ἐν",4,1],["τῷ",1,110],["οἴκῳ",34,113],["τοῦ",1,30],["Ἰσραήλ",27,105],["εἶδον",53,147],["φρικώδη",8632,74],["ἐκεῖ",76,17]],"And thy strength [is that] of a robber: the priests have hid the way, they have murdered [the people of] Sicima; for they have wrought iniquity in the house of Israel."],["10",[["πορνείαν",1003,10],["τοῦ",1,30],["Ἐφραίμ",308,105],["ἐμιάνθη",468,38],["Ἰσραὴλ",27,105],["καὶ",2,8],["Ἰούδα",62,21],["ἄρχου",320,355],["τρυγᾷν",2295,54],["σεαυτῷ",255,49]],"I have seen horrible [things] there, [even] the fornication of Ephraim: Israel and Juda are defiled; begin to gather grapes for thyself,",{"s":"r"}],["11",[["ἐν",4,1],["τῷ",1,110],["ἐπιστρέφειν",117,54],["με",6,98],["τὴν",1,9],["αἰχμαλωσίαν",461,10],["τοῦ",1,30],["λαοῦ",35,21],["μου",6,48]],"when I turn the captivity of my people.",{"s":"r"}]]