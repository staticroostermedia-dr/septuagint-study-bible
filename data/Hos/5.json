],["οἱ",1,128],["ἄρχοντες",96,51],["Ἰούδα",61,21],["ὡς",36,8],["μετατιθέντες",2033,137],["ὅρια",234,43],["ἐπʼ",9,1],["αὐτοὺς",3,60],["ἐκχεῶ",435,157],["ὡς",36,8],["ὕδωρ",85,33],["τὸ",1,32],["ὅρμημά",2863,33],["μου",6,48]],"The princes of Juda became as they that removed the bounds: I will pour out upon them my fury as water."],["11",[["Κατεδυνάστευσεν",1323,3],["Ἐφραὶμ",307,105],["τὸν",1,6],["ἀντίδικον",3173,7],["αὐτοῦ",3,48],["κατεπάτησε",1205,3],["τὸ",1,32],["κρίμα",266,33],["ὅτι",19,8],["ἤρξατο",319,26],["πορεύεσθαι",49,104],["ὀπίσω",166,17],["τῶν",1,76],["ματαίων",648,163]],"Ephraim altogether prevailed against his adversary, he trod judgment under foot, for he began to go after vanities."],["12",[["Καὶ",2,8],["ἐγὼ",6,178],["ὡς",36,8],["ταραχὴ",1562,13],["τῷ",1,110],["Ἐφραὶμ",307,105],["καὶ",2,8],["ὡς",36,8],["κέντρον",3885,20],["τῷ",1,110],["οἴκῳ",34,113],["Ἰούδα",61,21]],"Therefore I [will be] as consternation to Ephraim, and as a goad to the house of Juda."],["13",[["Καὶ",2,8],["εἶδεν",73,3],["Ἐφραὶμ",307,105],["τὴν",1,9],["νόσον",2940,10],["αὐτοῦ",3,48],["καὶ",2,8],["Ἰούδας",61,5],["τὴν",1,9],["ὀδύνην",771,10],["αὐτοῦ",3,48],["καὶ",2,8],["ἐπορεύθη",49,38],["Ἐφραὶμ",307,105],["πρὸς",15,1],["Ἀσσυρίους",414,58],["καὶ",2,8],["ἀπέστειλε",83,3],["πρέσβεις",1419,51],["πρὸς",15,1],["βασιλέα",22,7],["Ἰαρείμ",0,0],["καὶ",2,8],["οὗτος",16,112],["οὐκ",12,17],["ἠδυνάσθη",0,0],["ἰάσασθαι",794,394],["ὑμᾶς",5,209],["καὶ",2,8],["οὐ",12,17],["μὴ",25,8],["διαπαύσῃ",5588,116],["ἐξ",21,1],["ὑμῶν",5,136],["ὀδύνη",771,13]],"And Ephraim saw his disease, and Judas his pain; then Ephraim went to the Assyrians, and sent ambassadors to king Jarim: but he could not heal you, and your pain shall in nowise cease from you."],["14",[["Διότι",176,8],["ἐγώ",6,158],["εἰμι",10,149],["ὡς",36,8],["πανθὴρ",6054,5],["τῷ",1,110],["Ἐφραὶμ",307,105],["καὶ",2,8],["ὡς",36,8],["λέων",421,5],["τῷ",1,110],["οἴκῳ",34,113],["Ἰούδα",61,21],["καὶ",2,8],["ἐγὼ",6,158],["ἁρπῶμαι",1219,176],["καὶ",2,8],["πορεύσομα