,184],["οἱ",1,128],["ἄρχοντες",96,51],["Ἰούδα",62,21],["ὡς",36,8],["μετατιθέντες",2027,137],["ὅρια",236,43],["ἐπʼ",9,1],["αὐτοὺς",3,60],["ἐκχεῶ",436,157],["ὡς",36,8],["ὕδωρ",85,33],["τὸ",1,32],["ὅρμημά",2849,33],["μου",6,48]],"The princes of Juda became as they that removed the bounds: I will pour out upon them my fury as water."],["11",[["Κατεδυνάστευσεν",1305,3],["Ἐφραὶμ",308,105],["τὸν",1,6],["ἀντίδικον",3166,7],["αὐτοῦ",3,48],["κατεπάτησε",1117,3],["τὸ",1,32],["κρίμα",267,33],["ὅτι",19,8],["ἤρξατο",320,26],["πορεύεσθαι",49,104],["ὀπίσω",167,17],["τῶν",1,76],["ματαίων",654,163]],"Ephraim altogether prevailed against his adversary, he trod judgment under foot, for he began to go after vanities."],["12",[["Καὶ",2,8],["ἐγὼ",6,179],["ὡς",36,8],["ταραχὴ",1562,13],["τῷ",1,110],["Ἐφραὶμ",308,105],["καὶ",2,8],["ὡς",36,8],["κέντρον",3875,20],["τῷ",1,110],["οἴκῳ",34,113],["Ἰούδα",62,21]],"Therefore I [will be] as consternation to Ephraim, and as a goad to the house of Juda."],["13",[["Καὶ",2,8],["εἶδεν",53,3],["Ἐφραὶμ",308,105],["τὴν",1,9],["νόσον",2927,10],["αὐτοῦ",3,48],["καὶ",2,8],["Ἰούδας",62,5],["τὴν",1,9],["ὀδύνην",774,10],["αὐτοῦ",3,48],["καὶ",2,8],["ἐπορεύθη",49,38],["Ἐφραὶμ",308,105],["πρὸς",15,1],["Ἀσσυρίους",11614,58],["καὶ",2,8],["ἀπέστειλε",84,3],["πρέσβεις",1419,51],["πρὸς",15,1],["βασιλέα",22,7],["Ἰαρείμ",12479,0],["καὶ",2,8],["οὗτος",16,112],["οὐκ",12,17],["ἠδυνάσθη",0,0],["ἰάσασθαι",797,389],["ὑμᾶς",5,209],["καὶ",2,8],["οὐ",12,17],["μὴ",25,8],["διαπαύσῃ",5557,116],["ἐξ",21,1],["ὑμῶν",5,136],["ὀδύνη",774,13]],"And Ephraim saw his disease, and Judas his pain; then Ephraim went to the Assyrians, and sent ambassadors to king Jarim: but he could not heal you, and your pain shall in nowise cease from you."],["14",[["Διότι",177,8],["ἐγώ",6,158],["εἰμι",10,149],["ὡς",36,8],["πανθὴρ",6026,5],["τῷ",1,110],["Ἐφραὶμ",308,105],["καὶ",2,8],["ὡς",36,8],["λέων",424,5],["τῷ",1,110],["οἴκῳ",34,113],["Ἰούδα",62,21],["καὶ",2,8],["ἐγὼ",6,158],["ἁρπῶμαι",1214,177],["καὶ",2,8],["πορεύσομαι",49,177],["καὶ",2,8],["λήψομαι",46,177],["καὶ",2,8],["οὐκ",12,17],["ἔσται",10,89],["ὁ",1,4],["ἐξαιρούμενος",413,114]],"Wherefore I am as a panther to Ephraim, and as a lion to the house of Juda: and I will tear, and go away; and I will take, and there shall be none to deliver."],["15",[["Πορεύσομαι",49,177],["καὶ",2,8],["ἐπιστρέψω",117,157],["εἰς",8,1],["τὸν",1,6],["τόπον",99,7],["μου",6,48],["ἕως",42,8],["οὗ",120,17],["ἀφανισθῶσι",623,266],["καὶ",2,8],["ζητήσουσι",191,207],["τὸ",1,32],["πρόσωπόν",47,33],["μου",6,48],["Ἐν",4,1],["θλίψει",438,2],["αὐτῶν",3,41],["ὀρθριοῦσι",931,207],["πρὸς",15,1],["μὲ",6,82],["λέγοντες",31,137]],"I will go and return to my place, until they are brought to nought, and [then] shall they seek my face. In their affliction they will seek me early, saying,"]]