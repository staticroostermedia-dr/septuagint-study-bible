],["13",[["Ἐξαποστείλατε",220,69],["δρέπανα",2448,63],["ὅτι",19,8],["παρέστηκεν",595,165],["ὁ",1,4],["τρυγητός",2504,5],["εἰσπορεύεσθε",376,68],["πατεῖτε",2033,84],["διότι",177,8],["πλήρης",490,16],["ἡ",1,11],["ληνός",1769,5],["ὑπερεκχεῖτε",6637,339],["τὰ",1,42],["ὑπολήνια",4657,43],["ὅτι",19,8],["πεπλήθυνται",316,182],["τὰ",1,42],["κακὰ",161,65],["αὐτῶν",3,41]],"Bring forth the sickles, for the vintage is come: go in, tread [the grapes], for the press is full: cause the vats to overflow; for their wickedness is multiplied."],["14",[["Ἦχοι",1803,51],["ἐξήχησαν",5319,141],["ἐν",4,1],["τῇ",1,95],["κοιλάδι",1058,2],["τῆς",1,18],["δίκης",1219,19],["ὅτι",19,8],["ἐγγὺς",1026,17],["ἡμέρα",28,13],["Κυρίου",7,21],["ἐν",4,1],["τῇ",1,95],["κοιλάδι",1058,2],["τῆς",1,18],["δίκης",1219,19]],"Noises have resounded in the valley of judgment: for the day of the Lord is near in the valley of judgment."],["15",[["Ὁ",1,4],["ἥλιος",323,5],["καὶ",2,8],["ἡ",1,11],["σελήνη",1207,13],["συσκοτάσουσι",2500,207],["καὶ",2,8],["οἱ",1,128],["ἀστέρες",1699,51],["δύσουσι",2169,207],["φέγγος",1644,33],["αὐτῶν",3,41]],"The sun and the moon shall be darkened, and the stars shall withdraw their light."],["16",[["Ὁ",1,4],["δὲ",14,12],["Κύριος",7,5],["ἐκ",21,1],["Σιὼν",334,2],["ἀνακεκράξεται",2306,89],["καὶ",2,8],["ἐξ",21,1],["Ἱερουσαλὴμ",70,20],["δώσει",33,120],["φωνὴν",95,10],["αὐτοῦ",3,48],["καὶ",2,8],["σεισθήσεται",1282,125],["ὁ",1,4],["οὐρανὸς",94,5],["καὶ",2,8],["ἡ",1,11],["γῆ",26,13],["ὁ",1,4],["δὲ",14,12],["Κύριος",7,5],["φείσεται",610,89],["τοῦ",1,30],["λαοῦ",35,21],["αὐτοῦ",3,48],["καὶ",2,8],["ἐνισχύσει",987,120],["τοὺς",1,56],["υἱοὺς",13,31],["Ἰσραήλ",27,105]],"And the Lord shall cry out of Sion, and shall utter his voice from Jerusalem; and the heaven and the earth shall be shaken, but the Lord shall spare his people, and shall strengthen the children of Israel."],["17",[["Καὶ",2,8],["ἐπιγνώσεσθε",431,117],["διότι",177,8],["ἐγὼ",6,158],["Κύριος",7,5],["ὁ",1,4],["Θεὸς",20,5],["ὑμῶν",5,136],["ὁ