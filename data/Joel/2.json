[["1",[["Σαλπίσατε",845,69],["σάλπιγγι",580,2],["ἐν",4,1],["Σιὼν",334,2],["κηρύξατε",1438,69],["ἐν",4,1],["ὄρει",87,53],["ἁγίῳ",75,34],["μου",6,48],["καὶ",2,8],["συγχυθήτωσαν",2114,50],["πάντες",11,130],["οἱ",1,128],["κατοικοῦντες",89,137],["τὴν",1,9],["γῆν",26,10],["διότι",177,8],["πάρεστιν",899,87],["ἡμέρα",28,13],["Κυρίου",7,21],["ὅτι",19,8],["ἐγγὺς",1026,17]],"Sound the trumpet in Sion, make a proclamation in my holy mountain, and let all the inhabitants of the land be confounded: for the day of the Lord is near;"],["2",[["ἡμέρα",28,13],["σκότους",506,31],["καὶ",2,8],["γνόφου",1504,21],["ἡμέρα",28,13],["νεφέλης",444,19],["καὶ",2,8],["ὁμίχλης",2846,19],["ὡς",36,8],["ὄρθρος",1434,5],["χυθήσεται",2800,125],["ἐπὶ",9,1],["τὰ",1,42],["ὄρη",87,43],["λαὸς",35,5],["πολὺς",74,16],["καὶ",2,8],["ἰσχυρὸς",401,16],["ὅμοιος",657,16],["αὐτῷ",3,49],["οὐ",12,17],["γέγονεν",30,165],["ἀπὸ",17,1],["τοῦ",1,30],["αἰῶνος",100,21],["καὶ",2,8],["μετʼ",29,1],["αὐτὸν",3,82],["οὐ",12,17],["προστεθήσεται",201,125],["ἕως",42,8],["ἐτῶν",81,45],["εἰς",8,1],["γενεὰς",286,40],["γενεῶν",286,61]],"for a day of darkness and gloominess is near, a day of cloud and mist: a numerous and strong people shall be spread upon the mountains as the morning; there has not been from the beginning one like it, and after it there shall not be again even to the years of many generations."],["3",[["Τὰ",1,42],["ἔμπροσθεν",390,17],["αὐτοῦ",3,48],["πῦρ",118,33],["ἀναλίσκον",1849,47],["καὶ",2,8],["τὰ",1,42],["ὀπίσω",167,17],["αὐτοῦ",3,48],["ἀναπτομένη",1796,204],["φλόξ",983,13],["ὡς",36,8],["παράδεισος",1121,5],["τρυφῆς",1643,19],["ἡ",1,11],["γῆ",26,13],["πρὸ",238,1],["προσώπου",47,24],["αὐτοῦ",3,144],["καὶ",2,8],["τὰ",1,42],["ὄπισθεν",1196,17],["αὐτοῦ",3,48],["πεδίον",349,20],["ἀφανισμοῦ",879,21],["καὶ",2,8],["ἀνασωζόμενος",1568,114],["οὐκ",12,17],["ἔσται",10,89],["αὐτῷ",3,49]],"Before them is a consuming fire, and behind them is a flame kindled: the land before them is as a paradise of delight, and behind them a desolate plain: and there shall none of them escape."],["4",[["Ὡς",36,8],["ὅρασις",509,13],["ἵππων",309,77],["ἡ",1,11],["ὅρασις",509,13],["αὐτῶν",3,41],["καὶ",2,8],["ὡς",36,8],["ἱππεῖς",763,31],["οὕτως",71,17],["καταδιώξονται",621,127]],"Their appearance is as the appearance of horses; and as horsemen, so shall they pursue."],["5",[["Ὡς",36,8],["φωνὴ",95,13],["ἁρμάτων",359,45],["ἐπὶ",9,1],["τὰς",1,39],["κορυφὰς",977,40],["τῶν",1,44],["ὀρέων",87,45],["ἐξαλοῦνται",3739,127],["καὶ",2,8],["ὡς",36,8],["φωνὴ",95,13],["φλογὸς",983,19],["πυρὸς",118,24],["κατεσθιούσης",407,212],["καλάμην",2018,10],["καὶ",2,8],["ὡς",36,8],["λαὸς",35,5],["πολὺς",74,16],["καὶ",2,8],["ἰσχυρὸς",401,16],["παρατασσόμενος",718,114],["εἰς",8,1],["πόλεμον",163,7]],"As the sound of chariots on the tops of mountains shall they leap, and as the sound of a flame of fire devouring stubble, and as a numerous and strong people setting themselves in array for battle."],["6",[["Ἀπὸ",17,1],["προσώπου",47,24],["αὐτοῦ",3,144],["συντριβήσονται",268,135],["λαοὶ",35,51],["πᾶν",11,29],["πρόσωπον",47,33],["ὡς",36,8],["πρόσκαυμα",6013,33],["χύτρας",3388,40]],"Before them shall the people be crushed: every face [shall be] as the blackness of a caldron."],["7",[["Ὡς",36,8],["μαχηταὶ",1771,51],["δραμοῦνται",820,127],["καὶ",2,8],["ὡς",36,8],["ἄνδρες",38,51],["πολεμισταὶ",968,51],["ἀναβήσονται",88,127],["ἐπὶ",9,1],["τὰ",1,42],["τείχη",325,43],["καὶ",2,8],["ἕκαστος",171,16],["ἐν",4,1],["τῇ",1,95],["ὁδῷ",68,2],["αὐτοῦ",3,48],["πορεύσεται",49,89],["καὶ",2,8],["οὐ",12,17],["μὴ",25,8],["ἐκκλίνωσι",394,224],["τὰς",1,39],["τρίβους",745,40],["αὐτῶν",3,41]],"As warriors shall they run, and as men of war shall they mount on the walls; and each shall move in his [right] path, and they shall not turn aside from their tracks:"],["8",[["καὶ",2,8],["ἕκαστος",171,16],["ἀπὸ",17,1],["τοῦ",1,30],["ἀδελφοῦ",67,21],["αὐτοῦ",3,48],["οὐκ",12,17],["ἀφέξεται",1255,89],["καταβαρυνόμενοι",4819,351],["ἐν",4,1],["τοῖς",1,91],["ὅπλοις",764,92],["αὐτῶν",3,41]