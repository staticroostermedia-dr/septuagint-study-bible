ῶν",3,41],["καὶ",2,8],["οὐ",12,17],["δώσω",33,157],["ὑμᾶς",5,209],["οὐκ",12,17],["ἔτι",111,17],["εἰς",8,1],["ὀνειδισμὸν",733,7],["ἐν",4,1],["τοῖς",1,91],["ἔθνεσι",60,92]],"And the Lord answered and said to his people, Behold, I [will] send you corn, and wine, and oil, and ye shall be satisfied with them: and I will no longer make you a reproach among the Gentiles."],["20",[["Καὶ",2,8],["τὸν",1,6],["ἀπὸ",17,1],["Βοῤῥᾶ",387,5],["ἐκδιώξω",2220,157],["ἀφʼ",17,1],["ὑμῶν",5,136],["καὶ",2,8],["ἐξώσω",1575,157],["αὐτὸν",3,82],["εἰς",8,1],["γῆν",26,10],["ἄνυδρον",1701,37],["καὶ",2,8],["ἀφανιῶ",623,157],["τὸ",1,32],["πρόσωπον",47,33],["αὐτοῦ",3,48],["εἰς",8,1],["τὴν",1,9],["θάλασσαν",137,10],["τὴν",1,9],["πρώτην",315,37],["καὶ",2,8],["τὰ",1,42],["ὀπίσω",167,17],["αὐτοῦ",3,48],["εἰς",8,1],["τὴν",1,9],["θάλασσαν",137,10],["τὴν",1,9],["ἐσχάτην",410,37],["καὶ",2,8],["ἀναβήσεται",88,89],["ἡ",1,11],["σαπρία",2953,13],["αὐτοῦ",3,48],["καὶ",2,8],["ἀναβήσεται",88,89],["ὁ",1,4],["βρόμος",4174,5],["αὐτοῦ",3,48],["ὅτι",19,8],["ἐμεγάλυνε",604,14],["τὰ",1,42],["ἔργα",105,43],["αὐτοῦ",3,48]],"And I will chase away from you the northern [adversary], and will drive him away into a dry land, and I will sink his face in the former sea, and his back parts in the latter sea, and his ill savour shall come up, and his stink shall come up, because he has wrought great things."],["21",[["Θάρσει",1302,239],["γῆ",26,13],["χαῖρε",698,239],["καὶ",2,8],["εὐφραίνου",244,249],["ὅτι",19,8],["ἐμεγάλυνε",604,14],["Κύριος",7,5],["τοῦ",1,30],["ποιῆσαι",23,100]],"Be of good courage, O land; rejoice and be glad: for the Lord has done great things."],["22",[["Θαρσεῖτε",1302,84],["κτήνη",223,43],["τοῦ",1,23],["πεδίου",349,24],["ὅτι",19,8],["βεβλάστηκε",2700,165],["τὰ",1,42],["πεδία",349,43],["τῆς",1,18],["ἐρήμου",160,78],["ὅτι",19,8],["ξύλον",196,33],["ἤνεγκεν",199,3],["τὸν",1,6],["καρπὸν",448,7],["αὐτοῦ",3,48],["συκῆ",1561,13],["καὶ",2,8],["ἄμπελος",812,13],["ἔδωκαν",33,141],["τὴν",1,9],["ἰσχὺν",181,10],["αὐτῶν",3,41]],"Be of good courage, ye beasts of the plain, for the plains of the wilderness have budded, for the trees have borne their fruit, the fig-tree and the vine have yielded their strength."],["23",[["Καὶ",2,8],["τὰ",1,42],["τέκνα",192,43],["Σιὼν",334,2],["χαίρετε",698,307],["καὶ",2,8],["εὐφραίνεσθε",244,382],["ἐπὶ",9,1],["τῷ",1,110],["Κυρίῳ",7,113],["Θεῷ",20,113],["ὑμῶν",5,136],["διότι",177,8],["ἔδωκεν",33,3],["ὑμῖν",5,86],["τὰ",1,42],["βρώματα",714,43],["εἰς",8,1],["δικαιοσύνην",187,10],["καὶ",2,8],["βρέξει",2163,120],["ὑμῖν",5,86],["ὑετὸν",676,7],["πρώϊμον",3124,59],["καὶ",2,8],["ὄψιμον",3476,59],["καθὼς",221,17],["ἔμπροσθεν",390,17]],"Rejoice then and be glad, ye children of Sion, in the Lord your God: for he has given you food fully, and he will rain on you the early and the latter rain, as before."],["24",[["καὶ",2,8],["πλησθήσονται",924,135],["αἱ",1,185],["ἅλωνες",1654,180],["σίτου",665,21],["καὶ",2,8],["ὑπερχυθήσονται",6641,135],["αἱ",1,185],["ληνοὶ",1769,51],["οἴνου",261,21],["καὶ",2,8],["ἐλαίου",313,24]],"And the floors shall be filled with corn, and the presses shall overflow with wine and oil."],["25",[["Καὶ",2,8],["ἀνταποδώσε",9146,3],["ὑμῖν",5,86],["ἀντὶ",158,1],["τῶν",1,44],["ἐτῶν",81,45],["ὧν",24,97],["κατέφαγεν",407,3],["ἡ",1,11],["ἀκρὶς",1361,13],["καὶ",2,8],["ὁ",1,4],["βροῦχος",3037,105],["καὶ",2,8],["ἡ",1,11],["ἐρυσίβη",4103,13],["καὶ",2,8],["ἡ",1,11],["κάμπη",3873,13],["ἡ",1,11],["δύναμίς",98,13],["μου",6,48],["ἡ",1,11],["μεγάλη",66,15],["ἣν",24,124],["ἐξαπέστειλα",220,147],["εἰς",8,1],["ὑμᾶς",5,209]],"And I will recompense you for the years which the locust, and the caterpillar, and the palmerworm, and the cankerworm have eaten, [even] my great army, which I sent against you."],["26",[["Καὶ",2,8],["φάγεσθε",147,117],["ἐσθίοντες",147,137],["καὶ",2,8],["ἐμπλησθήσεσθε",427,258],["καὶ",2,8],["αἰνέσετε",402,348],["τὸ",1,32],["ὄνομα",57,33],["Κυρίου",7,21],["τοῦ",1,30],["Θεοῦ",20,21],["ὑμῶν",5,136],["ἃ",1,11],["ἐποίησε",23,3],["μεθʼ",29,1],["ὑμῶν",5,136],["εἰς",8,1],["θαυμάσια",884,65],["καὶ",2,8],["οὐ",12,17],["μὴ",25,8],["καταισχυνθῇ",696,333],["ὁ",1,4],["λαός",35,5],["μου",6,48],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7]],"And ye shall eat abundantly, and be satisfied, and shall praise the name of the Lord your God [for the things] which he has wrought wonderfully with you: and my people shall not be ashamed for ever."],["27",[["Καὶ",2,8],["ἐπιγνώσεσθε",431,117],["ὅτι",19,8],["ἐν",4,1],["μέσῳ",113,34],["τοῦ",1,30],["Ἰσραὴλ",27,105],["ἐγώ",6,158],["εἰμι",10,149],["καὶ",2,8],["ἐγὼ",6,158],["Κύριος",7,5],["ὁ",1,4],["Θεὸς",20,5],["ὑμῶν",5,136],["καὶ",2,8],["οὐκ",12,17],["ἕστιν",10,0],["ἔτι",111,17],["πλὴν",257,1],["ἐμοῦ",6,48],["καὶ",2,8],["οὐ",12,17],["μὴ",25,8],["καταισχυνθῶσιν",696,266],["ἔτι",111,17],["ὁ",1,4],["λαός",35,5],["μου",6,48],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7]],"And ye shall know that I am in the midst of Israel, and [that] I am the Lord your God, and [that] there is none else beside me; and my people shall no more be ashamed for ever."]]