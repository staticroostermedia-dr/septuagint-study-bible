[["1",[["Οἱ",1,128],["δὲ",14,12],["πορευόμενοι",49,351],["τὴν",1,9],["ὁδὸν",68,10],["ἦλθον",55,141],["ἑσπέρας",488,19],["ἐπὶ",9,1],["τὸν",1,6],["Τίγριν",12357,7],["ποταμόν",249,7],["καὶ",2,8],["ηὐλίζοντο",990,131],["ἐκεῖ",76,17]],"And as they went on their journey, they came in the evening to the river Tigris, and they lodged there."],["2",[["Τὸ",1,32],["δὲ",14,12],["παιδάριον",304,33],["κατέβη",175,3],["περικλύσασθαι",5928,103],["καὶ",2,8],["ἀνεπήδησεν",3690,3],["ἰχθὺς",1372,5],["ἀπὸ",17,1],["τοῦ",1,30],["ποταμοῦ",249,21],["καὶ",2,8],["ἐβουλήθη",463,38],["καταπιεῖν",1183,100],["τὸ",1,32],["παιδάριον",304,33]],"And when the young man went down to wash himself, a fish leaped out of the river, and would have devoured him."],["3",[["Ὁ",1,4],["δὲ",14,12],["ἄγγελος",208,5],["εἶπεν",18,3],["αὐτῷ",3,49],["ἐπιλαβοῦ",1086,275],["τοῦ",1,30],["ἰχθύος",1372,21],["καὶ",2,8],["ἐκράτησε",385,3],["τὸν",1,6],["ἰχθῦν",1372,7],["τὸ",1,32],["παιδάριον",304,33],["καὶ",2,8],["ἀνέβαλεν",3397,3],["αὐτὸν",3,82],["ἐπὶ",9,1],["τὴν",1,9],["γῆν",26,10]],"Then the angel said unto him, Take the fish. And the young man laid hold of the fish, and drew it to land."],["4",[["Καὶ",2,8],["εἶπεν",18,3],["αὐτῷ",3,49],["ὁ",1,4],["ἄγγελος",208,5],["ἀνάτεμε",8871,198],["τὸν",1,6],["ἰχθύν",1372,7],["καὶ",2,8],["λαβὼν",46,155],["τὴν",1,9],["καρδίαν",64,10],["καὶ",2,8],["τὸ",1,32],["ἧπαρ",1871,33],["καὶ",2,8],["τὴν",1,9],["χολὴν",2129,10],["θὲς",110,198],["ἀσφαλῶς",4050,17]],"To whom the angel said, Open the fish, and take the heart and the liver and the gall, and put them up safely."],["5",[["Καὶ",2,8],["ἐποίησε",23,3],["τὸ",1,32],["παιδάριον",304,33],["ὡς",36,8],["εἶπεν",18,3],["αὐτῷ",3,49],["ὁ",1,4],["ἄγγελος",208,5],["τὸν",1,6],["δὲ",14,12],["ἰχθῦν",1372,7],["ὀπτήσαντες",3218,190],["ἔφαγον",269,141],["καὶ",2,8],["ὥδευον",9821,129],["ἀμφότεροι",459,130],["ἕως",42,8],["οὗ",120,17],["ἤγγισαν",455,141],["ἐν",4,1],["Ἐκβατάνοις",2841,92]],"So the young man did as the angel commanded him; and when they had roasted the fish, they did eat it: then they both went on their way, till they drew near to Ecbatane."],["6",[["Καὶ",2,8],["εἶπε",18,3],["τὸ",1,32],["παιδάριον",304,33],["τῷ",1,110],["ἀγγέλῳ",208,113],["Ἀζαρία",15483,0],["ἀδελφὲ",67,250],["τί",39,119],["ἐστιν",10,87],["ἡ",1,11],["καρδία",64,13],["καὶ",2,8],["τὸ",1,32],["ἧπαρ",1871,33],["καὶ",2,8],["ἡ",1,11],["χολὴ",2129,13],["τοῦ",1,30],["ἰχθύος",1372,21]],"Then the young man said to the angel, Brother Azarias, to what use is the heart and the liver and the gall of the fish?"],["7",[["Καὶ",2,8],["εἶπεν",18,3],["αὐτῷ",3,49],["ἡ",1,11],["καρδία",64,13],["καὶ",2,8],["τὸ",1,32],["ἧπαρ",1871,33],["ἐάν",45,8],["τινα",39,365],["ὀχλῇ",5405,166],["δαιμόνιον",2013,33],["ἢ",61,8],["πνεῦμα",168,33],["πονηρὸν",164,29],["ταῦτα",16,248],["δεῖ",1158,14],["καπνίσαι",2580,100],["ἐνώπιον",115,1],["ἀνθρώπου",43,21],["ἢ",61,8],["γυναικὸς",59,19],["καὶ",2,8],["μηκέτι",2366,17],["ὀχληθῇ",5405,333]],"And he said unto him, Touching the heart and the liver, if a devil or an evil spirit trouble any, we must make a smoke thereof before the man or the woman, and the party shall be no more vexed."],["8",[["Ἡ",1,11],["δὲ",14,12],["χολὴ",2129,13],["ἔγχρισαι",5283,275],["ἄνθρωπον",43,7],["ὃς",24,246],["ἔχει",124,87],["λευκώματα",3881,63],["ἐν",4,1],["τοῖς",1,138],["ὀφθαλμοῖς",91,139],["καὶ",2,8],["ἰαθήσεται",797,394]],"As for the gall, [it is good] to anoint a man that hath whiteness in his eyes, and he shall be healed."],["9",[["Ὡς",36,8],["δὲ",14,12],["προσήγγισαν",2375,141],["τῇ",1,95],["Ῥάγῃ",1178,333]],"And when they were come near to Rages,"],["10",[["εἶπεν",18,3],["ὁ",1,4],["ἄγγελος",208,5],["τῷ",1,52],["παιδαρίῳ",304,53],["ἀδελφὲ",67,250],["σήμερον",205,17],["αὐλισθησόμεθα",990,349],["παρὰ",73,1],["Ῥαγουὴλ",14975,0],["καὶ",2,8],["αὐτὸς",3,158],["συγγενής",1741,16],["σου",5,146],["ἐστὶ",10,87],["καὶ",2,8],["ἔστιν",10,87],["αὐτῷ",3,233],["θυγατηρ",97,13],["ὀνόματι",57,53],["Σάῤῥα",999,13],["λαλήσω",50,157],["περὶ",72,1],["αὐτῆς",3,83],["τοῦ",1,30],