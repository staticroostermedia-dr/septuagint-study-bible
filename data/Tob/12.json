[["1",[["Καὶ",2,8],["ἐκάλεσε",128,3],["Τωβὶτ",0,0],["Τωβίαν",0,0],["τὸν",1,6],["υἱὸν",13,7],["αὐτοῦ",3,48],["καὶ",2,8],["εἶπεν",18,3],["αὐτῷ",3,49],["ὅρα",111,239],["τέκνον",192,20],["μισθὸν",814,7],["τῷ",1,110],["ἀνθρώπῳ",43,113],["τῷ",1,110],["συνελθόντι",1917,359],["σοι",5,151],["καὶ",2,8],["προσθεῖναι",200,100],["αὐτῷ",3,49],["δεῖ",1161,14]],"Then Tobit called his son Tobias, and said unto him, My son, see that the man have his wages, which went with thee, and thou must give him more."],["2",[["Καὶ",2,8],["εἶπε",18,3],["πάτερ",44,251],["οὐ",12,17],["βλάπτομαι",3256,252],["δοὺς",33,155],["αὐτῷ",3,49],["τὸ",1,32],["ἥμισυ",442,29],["ὧν",24,97],["ἐνήνοχα",201,85]],"And Tobias said unto him, O father, it is no harm to me to give him half of those things which I have brought:"],["3",[["ὅτι",19,8],["με",6,82],["ἀγήοχέ",227,165],["σοι",5,151],["ὑγιῆ",2866,37],["καὶ",2,8],["τὴν",1,9],["γυναῖκά",58,10],["μου",6,48],["ἐθεράπευσε",1677,3],["καὶ",2,8],["τὸ",1,32],["ἀργύριόν",150,33],["μου",6,48],["ἤνεγκε",201,3],["καὶ",2,8],["σὲ",5,161],["ὁμοίως",1754,17],["ἐθεράπευσε",1677,3]],"for he hath brought me again to thee in safety, and made whole my wife, and brought me the money, and likewise healed thee."],["4",[["Καὶ",2,8],["εἶπεν",18,3],["ὁ",1,4],["πρεσβύτης",1097,5],["δικαιοῦται",1134,108],["αὐτῷ",3,49]],"Then the old man said, It is due unto him."],["5",[["Καὶ",2,8],["ἐκάλεσε",128,3],["τὸν",1,6],["ἄγγελον",206,7],["καὶ",2,8],["εἶπεν",18,3],["αὐτῷ",3,49],["λάβε",46,198],["τὸ",1,32],["ἥμισυ",442,29],["πάντων",11,163],["ὧν",24,307],["ἐνηνόχατε",201,334],["καὶ",2,8],["ὕπαγε",6696,239],["ὑγιαίνων",1716,67]],"So he called the angel, and he said unto him, Take half of all that ye have brought, and go away in safety."],["6",[["Τότε",250,17],["καλέσας",128,155],["τοὺς",1,56],["δύο",103,57],["κρυπτῶς",1824,17],["εἶπεν",18,3],["αὐτοῖς",3,142],["εὐλογεῖτε",147,311],["τὸν",1,6],["Θεὸν",20,7],["καὶ",2,8],["αὐτῷ",3,49],["ἐξομολογεῖσθε",478,386],["καὶ",2,8],["μεγαλωσύνην",1474,10],["δίδοτε",33,311],["αὐτῷ",3,49],["καὶ",2,8],["ἐξομολογεῖσθε",478,386],["αὐτῷ",3,49],["ἐνώπιον",114,1],["πάντων",11,163],["τῶν",1,76],["ζώντων",117,164],["περὶ",71,1],["ὧν",24,307],["ἐποίησε",23,3],["μεθʼ",29,1],["ὑμῶν",5,136],["ἀγαθὸν",113,29],["τὸ",1,32],["εὐλογεῖν",147,54],["τὸν",1,6],["Θεὸν",20,7],["καὶ",2,8],["ὑψοῦν",327,36],["τὸ",1,27],["ὄνομα",55,20],["αὐτοῦ",3,48],["τοὺς",1,56],["λόγους",48,31],["τῶν",1,44],["ἔργων",104,45],["τοῦ",1,30],["Θεοῦ",20,21],["ἐντίμως",1335,17],["ὑποδεικνύοντες",1241,137],["καὶ",2,8],["μὴ",25,8],["ὀκνεῖτε",3474,84],["ἐξομολογεῖσθαι",478,104],["αὐτῷ",3,49]],"Then he took them both apart, and said unto them, Bless God, praise him, and magnify him, and praise him for the things which he hath done unto you in the sight of all that live. It is good to praise God, and exalt his name, and honourably to shew forth the works of God; therefore be not slack to praise him."],["7",[["Μυστήριον",1773,33],["βασιλέως",22,21],["καλὸν",264,29],["κρύψαι",378,296],["τὰ",1,42],["δὲ",14,12],["ἔργα",104,43],["τοῦ",1,30],["Θεοῦ",20,21],["ἀνακαλύπτειν",1991,54],["ἐνδόξως",731,17],["ἀγαθὸν",113,29],["ποιήσατε",23,69],["καὶ",2,8],["κακὸν",161,29],["οὐχ",12,17],["εὑρήσει",106,120],["ὑμᾶς",5,209]],"It is good to keep close the secret of a king, but it is honourable to reveal the works of God. Do that which is good, and no evil shall touch you."],["8",[["Ἀγαθὸν",113,29],["προσευχὴ",549,13],["μετὰ",29,1],["νηστείας",1416,19],["καὶ",2,8],["ἐλεημοσύνης",943,19],["καὶ",2,8],["δικαιοσύνης",185,19],["ἀγαθὸν",113,29],["τὸ",1,32],["ὀλίγον",554,29],["μετὰ",29,1],["δικαιοσύνης",185,19],["ἢ",60,8],["πολὺ",74,29],["μετὰ",29,1],["ἀδικίας",288,19],["καλὸν",264,28],["ποιῆσαι",23,100],["ἐλεημοσύνην",943,10],["ἢ",60,8],["θησαυρίσαι",2461,100],["χρυσίον",202,20]],"Prayer is good with fasting and alms and righteousness. A little with righteousness is better than much with unrighteousness. It is better to give alms than to lay up gold:"],["9",[["Ἐλεημοσύνη",943,13],["γὰρ",40,12],["ἐκ",21,1],["θανάτου",169,21],["ῥύεται",335,108],["καὶ",2,8],["αὕτη",16,101],["ἀποκαθαριεῖ",6334,120],["πᾶσαν",11,37],["ἁμαρτίαν",119,10],["οἱ",1,128],["ποιοῦντες",23,137],["ἐλεημοσύνας",943,40],["καὶ",2,8],["δικαιοσύνας",185,40],["πλησθήσονται",924,135],["ζωῆς",212,19]],"for alms doth deliver from death, and shall purge away all sin. Those that exercise alms and righteousness shall be filled with life:"],["10",[["Οἱ",1,128],["δὲ",14,12],["ἁμαρτάνοντες",244,137],["πολέμιοί",1121,130],["εἰσι",10,189],["τῆς",1,18],["ἑαυτῶν",92,41],["ζωῆς",212,19]],"but they that sin are enemies to their own life."],["11",[["Οὐ",12,17],["μὴ",25,8],["κρύψω",378,157],["ἀφʼ",17,1],["ὑμῶν",5,136],["πᾶν",11,29],["ῥῆμα",115,33],["εἴρηκα",1173,85],["δὴ",193,12],["μυστήριον",1773,33],["βασιλέως",22,21],["κρύψαι",378,296],["καλὸν",264,28],["τὰ",1,42],["δὲ",14,12],["ἔργα",104,43],["τοῦ",1,30],["Θεοῦ",20,21],["ἀνακαλύπτειν",1991,54],["ἐνδόξως",731,17]],"Surely I will keep close nothing from you. For I said, It was good to keep close the secret of a king, but that it was honourable to reveal the works of God."],["12",[["Καὶ",2,8],["νῦν",89,17],["ὅτε",430,8],["προσηύξω",550,169],["σὺ",5,156],["καὶ",2,8],["ἡ",1,11],["νύμφη",1060,13],["σου",5,146],["Σάῤῥα",999,13],["ἐγὼ",6,178],["προσήγαγον",352,141],["τὸ",1,32],["μνημόσυνον",717,33],["τῆς",1,18],["προσευχῆς",549,19],["ὑμῶν",5,136],["ἐνώπιον",114,1],["τοῦ",1,30],["ἁγίου",75,153],["καὶ",2,8],["ὅτε",430,8],["ἔθαπτες",390,216],["τοὺς",1,56],["νεκροὺς",653,58],["ὡσαύτως",1242,17],["συμπαρήγμην",8429,252],["σοι",5,151]],"Now therefore, when thou didst pray, and Sara thy daughter in law, I did bring the remembrance of your prayers before the Holy One: and when thou didst bury the dead, I was with thee likewise."],["13",[["Καὶ",2,8],["ὅτε",430,8],["οὐκ",12,17],["ὤκνησας",3474,154],["ἀναστῆναι",121,100],["καὶ",2,8],["καταλιπεῖν",255,100],["τὸ",1,32],["ἄριστόν",3002,33],["σου",5,146],["ὅπως",236,8],["ἀπελθὼν",305,155],["περιστείλῃς",4370,170],["τὸν",1,6],["νεκρὸν",653,59],["οὐκ",12,17],["ἔλαθές",1768,154],["με",6,82],["ἀγαθοποιῶν",4016,67],["ἀλλὰ",107,17],["σὺν",309,1],["σοὶ",5,151],["ἤμην",10,435]],"And when thou didst not delay to rise up, and leave thy dinner, to go and cover the dead, thy good deed was not hid from me: but I was with thee."],["14",[["Καὶ",2,8],["νῦν",89,17],["ἀπέστειλέ",83,3],["με",6,82],["ὁ",1,4],["Θεὸς",20,5],["ἰάσασθαί",794,394],["σε",5,161],["καὶ",2,8],["τὴν",1,9],["νύμφην",1060,10],["σου",5,146],["Σάῤῥαν",999,10]],"And now God hath sent me to heal thee and Sara thy daughter in law."],["15",[["Ἐγώ",6,158],["εἰμι",10,149],["Ῥαφαήλ",0,0],["εἷς",57,16],["ἐκ",21,1],["τῶν",1,76],["ἑπτὰ",179,57],["ἁγίων",75,163],["ἀγγέλων",206,77],["οἳ",1,128],["προσαναφέρουσι",5037,189],["τὰς",1,39],["προσευχὰς",549,40],["τῶν",1,76],["ἁγίων",75,163],["καὶ",2,8],["εἰσπορεύονται",380,303],["ἐνώπιον",114,1],["τῆς",1,18],["δόξης",141,19],["τοῦ",1,30],["ἁγίου",75,153]],"I am Raphael, one of the seven holy angels, which present the prayers of the saints, and which go in and out before the glory of the Holy One."],["16",[["Καὶ",2,8],["ἐταράχθησαν",508,94],["οἱ",1,128],["δύο",103,57],["καὶ",2,8],["ἔπεσον",154,141],["ἐπὶ",9,1],["πρόσωπον",47,33],["ὅτι",19,8],["ἐφοβήθησαν",134,94]],"Then they were both troubled, and fell upon their faces: for they feared."],["17",[["Καὶ",2,8],["εἶπεν",18,3],["αὐτοῖς",3,142],["μὴ",25,8],["φοβεῖσθε",134,386],["εἰρήνη",210,13],["ὑμῖν",5,86],["ἔσται",10,89],["τὸν",1,6],["δὲ",14,12],["Θεὸν",20,7],["εὐλογεῖτε",147,311],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7]],"But he said unto them, Fear not, for it shall go well with you; praise God therefore."],["18",[["ὅτι",19,8],["οὐ",12,17],["τῇ",1,95],["ἐμαυτοῦ",891,48],["χάριτι",366,2],["ἀλλὰ",107,17],["τῇ",1,95],["θελήσει",837,120],["τοῦ",1,30],["Θεοῦ",20,21],["ἡμῶν",6,41],["ἦλθον",56,141],["ὅθεν",1154,17],["εὐλογεῖτε",147,311],["αὐτὸν",3,82],["εἰς",8,1],["τὸν",1,6],["αἰῶνα",100,7]],"For not of any favour of mine, but by the will of our God I came; wherefore praise him for ever."],["19",[["Πάσας",11,109],["τὰς",1,39],["ἡμέρας",28,19],["ὠπτανόμην",5434,637],["ὑμῖν",5,86],["καὶ",2,8],["οὐκ",12,17],["ἔφαγον",268,141],["οὐδὲ",105,12],["ἔπιον",215,141],["ἀλλὰ",107,17],["ὅρασιν",505,10],["ὑμεῖς",5,208],["ἐθεωρεῖτε",898,343]],"All these days I did appear unto you; but I did neither eat nor drink, but ye did see a vision."],["20",[["Καὶ",2,8],["νῦν",89,17],["ἐξομολογεῖσθε",478,386],["τῷ",1,110],["Θεῷ",20,113],["διότι",176,8],["ἀναβαίνω",87,149],["πρὸς",15,1],["τὸν",1,6],["ἀποστείλαντά",83,485],["με",6,82],["καὶ",2,8],["γράψατε",186,69],["πάντα",11,65],["τὰ",1,42],["συντελεσθέντα",316,330],["εἰς",8,1],["βιβλίον",337,33]],"Now therefore give God thanks: for I go up to him that sent me; but write all things which are done in a book."],["21",[["Καὶ",2,8],["ἀνέστησαν",121,141],["καὶ",2,8],["οὐκ",12,17],["ἔτι",110,17],["εἶδον",73,147],["αὐτόν",3,82]],"And when they arose, they saw him no more."],["22",[["Καὶ",2,8],["ἐξωμολογοῦντο",478,131],["τὰ",1,42],["ἔργα",104,43],["τὰ",1,42],["μεγάλα",65,65],["καὶ",2,8],["θαυμαστὰ",1074,65],["αὐτοῦ",3,48],["ὡς",36,8],["ὤφθη",111,38],["αὐτοῖς",3,142],["ὁ",1,4],["ἄγγελος",206,5],["Κυρίου",7,21]],"Then they confessed the great and wonderful works of God, and how the angel of the Lord had appeared unto them."]]